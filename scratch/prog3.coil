(module scratch.prog3)
(import "scratch.rep" :use *)
(defsum Shape
  (Circle [(r f64)])
  (Rect [(w f64) (h f64)]))
(defstruct Boxed [(v i64)])

(defn area [(s Shape)] (-> f64)
  (match s
    (Circle [rad] (* rad rad))
    (Rect [w h] (* w h))))

(defn count-down [(n i64)] (-> i64)
  (let [(mut acc) 0
        (mut i) n]
    (loop (if (<= (load i) 0)
              (break acc)
              (do
                (set! acc (+ acc (load i)))
                (set! i (- (load i) 1))
                (continue))))))

(defn use-box [(b Boxed)] (-> i64) (.v b))

(defn main [] (-> :i64)
  (let [b (Boxed :v 3)
        x (use-box b)
        c (area (Circle 2.0))]
    (+ x (cast i64 c))))
