(module scratch.rep)
(import "coil.primitive" :as primitive)

; safe type renderer: builds a string from any type Code
(defn rt [(t Code)] (-> (slice u8))
  (if (primitive/code-list? t)
      (rt-list t 0 (primitive/code-count t) "(")
      (if (primitive/code-sym? t)
          (primitive/code-str "" t)
          (if (primitive/code-int? t)
              (primitive/int->str (primitive/code-int t))
              "_"))))
(defn rt-list [(t Code) (i i64) (n i64) (acc (slice u8))] (-> (slice u8))
  (if (>= i n)
      (primitive/code-str acc ")")
      (let [el (primitive/code-nth t i)
            s (rt el)]
        (if (= i 0)
            (rt-list t (+ i 1) n (primitive/code-str acc s))
            (rt-list t (+ i 1) n (primitive/code-str acc " " s))))))

(defn show [(node Code)] (-> i64)
  (let [h (primitive/code-nth node 0)
        t (primitive/type-of node)]
    (do (let [_w (primitive/report node (primitive/code-str "N: " h " ty=" (rt t)))] 0))))

(defn rn [(f Code)] (-> i64)
  (if (primitive/code-list? f)
      (let [n (primitive/code-count f)]
        (if (> n 0)
            (do
              (if (and (primitive/code-sym? (primitive/code-nth f 0))
                       (primitive/code-eq (primitive/code-nth f 0) `defn))
                  (do (let [_w (primitive/report f (rt f))] 0))
                  0)
              (show f)
              (rk f 0 n))
            0))
      (if (primitive/code-sym? f)
          (let [bid (primitive/binding-of f)]
            (if (> bid 0)
                (do (let [_w (primitive/report f (primitive/code-str "SYM " f " bid=" (primitive/int->str bid) " ty=" (rt (primitive/type-of f))))] 0))
                0))
          0)))
(defn rk [(f Code) (i i64) (n i64)] (-> i64)
  (if (>= i n) 0 (do (rn (primitive/code-nth f i)) (rk f (+ i 1) n))))
(defn rm [(m Code)] (-> i64) (rf m 1 (primitive/code-count m)))
(defn rf [(m Code) (i i64) (n i64)] (-> i64)
  (if (>= i n) 0 (do (rn (primitive/code-nth m i)) (rf m (+ i 1) n))))
(defn rmods [(ms Code)] (-> Code)
  (do (rm-loop ms 0 (primitive/code-count ms)) `0))
(defn rm-loop [(ms Code) (i i64) (n i64)] (-> i64)
  (if (>= i n)
      0
      (let [m (primitive/code-nth ms i)]
        (if (> (primitive/code-count m) 1)
            (if (and (primitive/code-from-user? (primitive/code-nth m 1))
                     (not (primitive/code-eq (primitive/code-nth m 0) `scratch.rep)))
                (do (rm m) (rm-loop ms (+ i 1) n))
                (rm-loop ms (+ i 1) n))
            (rm-loop ms (+ i 1) n)))))
(checker rmods)
