(module experiments.ohm-demo.main)

(import "coil.io" :as io)
(import "coil.debug" :use [debugln])
(import "experiments.ohm.runtime" :as ohm)
(import "experiments.ohm-demo.arithmetic" :as arithmetic)

(defn main [] (-> i64)
  (let [input "12+34+56"
        (mut result) (arithmetic/parse-tree input)
        ok (ohm/match-succeeded? (load result))]
    (io/print-str (io/stdout) "input: ")
    (io/write-line (io/stdout) input)
    (io/print-str (io/stdout) "grammar: ")
    (io/write-line (io/stdout) (ohm/match-grammar-name (load result)))
    (io/write-line (io/stdout) "parse tree:")
    (debugln (load result))
    (if (not ok)
        (do
          (io/write-line (io/stdout) (ohm/match-message (load result)))
          0)
        0)
    (ohm/free-match! (mut result))
    (if ok 0 1)))
