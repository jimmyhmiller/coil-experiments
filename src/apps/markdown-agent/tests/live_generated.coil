(module experiments.markdown-agent.live-generated)

(export sum-to)

(defn sum-to [(n i64)] (-> i64)
  (if (< n 0)
      0
      (let [(mut total) 0
            (mut current) 0]
        (loop (if (> (load current) n)
                  (break)
                  (do
                    (set! total (+ (load total) (load current)))
                    (set! current (+ (load current) 1)))))
        (load total))))

(defn main [] (-> i64)
  0)
