(module experiments.raylib-demo.main)
(import "coil.primitive" :use *)
(import "experiments.raylib-demo.raylib" :as raylib)

(defn main [] (-> i32)
  (let [background
          (load (raylib/Color
                  :r 17
                  :g 34
                  :b 51
                  :a 255))
        foreground
          (load (raylib/Color
                  :r 240
                  :g 230
                  :b 140
                  :a 255))
        center (load (raylib/Vector2 :x 160.0 :y 100.0))]
    (raylib/initialize-c-library)
    (raylib/InitWindow 320 200 c"raylib 5.5: C source imported by Coil")
    (raylib/SetTargetFPS 60)
    (loop (if (!= (raylib/WindowShouldClose) (cast u8 0))
              (break)
              (do
                (raylib/BeginDrawing)
                (raylib/ClearBackground background)
                (raylib/DrawCircleV center 48.0 foreground)
                (raylib/DrawText c"raylib imported from C source" 43 166 18 foreground)
                (raylib/EndDrawing))))
    (raylib/CloseWindow)
    0))
