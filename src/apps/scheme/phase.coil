(module experiments.scheme.phase)

;; Runtime bindings available to natively compiled Scheme transformer
;; procedures (staged metacompilation). This deliberately does not import the
;; reader, source dialect, lint, or lowering metaprograms: phase source has
;; already passed through those transformations before its isolated program is
;; compiled. It DOES include experiments.scheme.syntax, whose mixed Code/value
;; signatures only compile inside a metaprogram — which is exactly where phase
;; programs live.
(import "coil.primitive" :use [fnptr-of] :reexport)
(import "experiments.scheme.core" :use * :reexport)
(import "experiments.scheme.closure" :use * :reexport)
;; The runtime half of the lambda module: lifted transformer bodies call
;; closure-fnptrN/make-closure support that lives beside the lifting pass.
(import "experiments.scheme.lambda" :use * :reexport)
(import "experiments.scheme.derived" :use * :reexport)
(import "experiments.scheme.derived2" :use * :reexport)
(import "experiments.scheme.numeric" :use * :reexport)
(import "experiments.scheme.stdproc" :use * :reexport)
(import "experiments.scheme.port" :use * :reexport)
(import "experiments.scheme.value" :use * :reexport)
(import "experiments.scheme.heap" :use * :reexport)
(import "experiments.scheme.symbol" :use * :reexport)
(import "experiments.scheme.syntax" :use * :reexport)
(import "experiments.scheme.forms" :use * :reexport)
