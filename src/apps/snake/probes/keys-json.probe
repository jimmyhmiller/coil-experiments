# coil-module: snake.probes.keys-json
# The same thing as a machine-readable stream: one JSON object per key press in
# keys.jsonl, and the aggregations as JSON, rewritten every 500ms, in keys-stats.json.
#
#   coil run --use snake.probes.keys-json
#   tail -f keys.jsonl        (in another terminal)
import snake.probes.keynames;
report every 500ms as json to "keys-stats.json";

point key = call apply-input { name = { (key-name code) }; }

key {
  record { key: name, code, wall, site } to "keys.jsonl";
  count by name;
}

span input-lag = enter apply-input .. call game-step!;
input-lag { time; }
