# coil-module: snake.probes.keys
# Watch the snake game's key presses while you play.
#
#   coil run --use snake.probes.keys
#
# Every press prints the moment it happens; the tables refresh once a second.
import snake.probes.keynames;
report every 1s;

# Every key press. `code` is apply-input's real parameter name; the point gives
# it a readable one by calling an ordinary Coil function.
point key = call apply-input { name = { (key-name code) }; }

key {
  print("key {name}");
  count by name;
}

# Steering requests by direction, as the engine's own (dx, dy). This counts what was
# ASKED: a reversal straight back onto the neck is still a call, even though the
# engine ignores it.
call game-steer! { count by dx, dy; }

# From a key press to the tick that acts on it: the input lag you can feel.
span input-lag = enter apply-input .. call game-step!;
input-lag { time; }

# What a frame costs, and how much of it is drawing.
call game-step! { time; }
call render     { time; }
