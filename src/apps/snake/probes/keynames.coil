(module snake.probes.keynames)

; A helper for the probes, not for the game: the game deals in input codes, and a
; person reading a probe wants names. Probes call this from a `{ coil }` escape.

;;; The name of an input code from `snake.main` (the INPUT-* constants).
(defn key-name [(code i64)] (-> (slice u8))
  (case code
    1 "quit"
    2 "up"
    3 "down"
    4 "left"
    5 "right"
    6 "restart"
    "none"))
