(module experiments.dataflow.demo)
(import "experiments.dataflow.lang" :use *)

(extern printf :cc c [(ptr i8) ...] (-> i32))

(defn main [] (-> i64)
  (oz [quantity unit-price subtotal tax-rate tax before-shipping shipping total]
    (thread (= subtotal (* quantity unit-price)))
    (thread (= tax (/ (* subtotal tax-rate) 100)))
    (thread (= before-shipping (+ subtotal tax)))
    (thread (= total (+ before-shipping shipping)))
    ;; Like Oz, `=` unifies and ordinary variable use waits transparently.
    (= shipping 1200)
    (= tax-rate 8)
    (= unit-price 2500)
    (= quantity 3)
    (let [answer total]
      (printf c"quote subtotal=%ld tax=%ld total=%ld\n"
              subtotal tax answer)
      (let [conflict-ok
              (match (= quantity 4)
                (Conflict [_ _] true)
                (Bound [] false)
                (AlreadyBound [] false))]
        (if (and (= answer 9300) conflict-ok) 0 1)))))
