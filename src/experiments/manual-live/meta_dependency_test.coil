(module experiments.manual-live.meta-dependency-test)

(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "experiments.manual-live.runtime" :as live)
(import "experiments.manual-live.meta" :use [live-function])

(live-function generated-node-value 2 [1] []
  [(value i64)] (-> i64)
  value)

(live-function generated-cycle-total 3 [] [2]
  [(left i64) (right i64)] (-> i64)
  (+ (generated-node-value left) (generated-node-value right)))

(defn main [] (-> i64)
  (let [a (alloc/malloc-allocator)
        generated (primitive/alloc-stack live/Runtime)
        manual (primitive/alloc-stack live/Runtime)
        generated-marks (primitive/alloc-stack (array bool 64))
        manual-marks (primitive/alloc-stack (array bool 64))]
    (live/runtime-init! generated a)
    (live/runtime-init! manual a)
    (cond (!= (generated-node-value--register-dependencies! generated) 0) 1
          (!= (generated-cycle-total--register-dependencies! generated) 0) 2
          (< (live/register-dependency! manual 2 1 2) 0) 3
          (< (live/register-dependency! manual 3 2 1) 0) 4
          (!= (.dependency-count generated) (.dependency-count manual)) 5
          (!= (live/dependency-closure! generated 1 generated-marks) 3) 6
          (!= (live/dependency-closure! manual 1 manual-marks) 3) 7
          (not (load (primitive/index generated-marks 1))) 8
          (not (load (primitive/index generated-marks 2))) 9
          (not (load (primitive/index generated-marks 3))) 10
          (!= (generated-cycle-total 10 20) 30) 11
          :else 0)))
