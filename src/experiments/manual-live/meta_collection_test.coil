(module experiments.manual-live.meta-collection-test)

(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as arraylist)
(import "coil.slice" :as slice)
(import "experiments.manual-live.runtime" :as live)
(import "experiments.manual-live.meta" :use [live-struct-auto live-transition-auto])

(defn valid [(raw (ptr i8))] (-> i64)
  (primitive/cast i64 raw)
  0)

(defn reject [(raw (ptr i8))] (-> i64)
  (primitive/cast i64 raw)
  73)

(defn user-destroy [(raw (ptr i8))] (-> i64)
  (primitive/cast i64 raw)
  0)

(live-struct-auto CollectionV1 41 1
  [(values (arraylist/ArrayList i64)) (view (slice i64)) (tag i64)] valid user-destroy)
(live-struct-auto CollectionBad 41 2
  [(values (arraylist/ArrayList i64)) (view (slice i64)) (tag i64) (bad i64 :default 1)]
  reject user-destroy)
(live-struct-auto CollectionV2 41 3
  [(values (arraylist/ArrayList i64)) (view (slice i64)) (tag i64) (bonus i64 :default 9)]
  valid user-destroy)

(live-transition-auto collection-v1-to-bad CollectionV1 CollectionBad
  [(values (arraylist/ArrayList i64)) (view (slice i64)) (tag i64)]
  [(values (arraylist/ArrayList i64)) (view (slice i64)) (tag i64) (bad i64 :default 1)])
(live-transition-auto collection-v1-to-v2 CollectionV1 CollectionV2
  [(values (arraylist/ArrayList i64)) (view (slice i64)) (tag i64)]
  [(values (arraylist/ArrayList i64)) (view (slice i64)) (tag i64) (bonus i64 :default 9)])

(defn main [] (-> i64)
  (let [allocator (alloc/malloc-allocator)
        rt (primitive/alloc-stack live/Runtime)]
    (live/runtime-init! rt allocator)
    (let [v1 (CollectionV1--register-schema! rt)
          bad (CollectionBad--register-schema! rt)
          v2 (CollectionV2--register-schema! rt)]
      (cond (< v1 0) 1
            (< bad 0) 2
            (< v2 0) 3
            (< (collection-v1-to-bad--register-transition! rt v1 bad) 0) 4
            (< (collection-v1-to-v2--register-transition! rt v1 v2) 0) 5
            :else
              (let [handle (live/handle-new! rt 41 v1)]
                (if (= (primitive/cast i64 handle) 0) 6
                    (let [old (primitive/cast (ptr CollectionV1) (.payload handle))]
                      (set! (.values old) (arraylist/al-new [i64] allocator))
                      (arraylist/al-push! [i64] (field old values) 10)
                      (arraylist/al-push! [i64] (field old values) 20)
                      (arraylist/al-push! [i64] (field old values) 30)
                      (set! (.view old)
                        (slice/slice-new [i64]
                          (primitive/index (load (field (field old values) data)) 1) 2))
                      (set! (.tag old) 7)
                      (let [old-data (load (field (field old values) data))
                            failed (live/migrate-type! rt 41 bad)]
                        (let [pre-status
                                (cond (!= failed 73) 7
                                      (!= (.schema-id handle) v1) 8
                                      (!= (primitive/cast i64
                                            (load (field (field old values) data)))
                                          (primitive/cast i64 old-data)) 9
                                      (!= (arraylist/al-get [i64] (.values old) 0) 10) 10
                                      (!= (arraylist/al-get [i64] (.values old) 1) 20) 11
                                      (!= (primitive/cast i64 (slice/slice-data (.view old)))
                                          (primitive/cast i64
                                            (primitive/index
                                              (load (field (field old values) data)) 1))) 12
                                      (!= (slice/slice-get [i64] (.view old) 0) 20) 13
                                      :else 0)]
                          (if (!= pre-status 0) pre-status
                              (do
                                ; A borrowed range beyond the owning list's logical
                                ; allocation must reject the whole transaction.
                                (set! (.view old)
                                  (slice/slice-new [i64]
                                    (primitive/index
                                      (load (field (field old values) data)) 2) 2))
                                (let [bounds-status (live/migrate-type! rt 41 v2)]
                                  (if (!= bounds-status -33) 14
                                      (do
                                        (set! (.view old)
                                          (slice/slice-new [i64]
                                            (primitive/index
                                              (load (field (field old values) data)) 1) 2))
                                        (if (!= (live/migrate-type! rt 41 v2) 0) 15
                                            (let [new
                                                    (primitive/cast
                                                      (ptr CollectionV2) (.payload handle))
                                                  new-data
                                                    (load (field (field new values) data))]
                                              (cond
                                                (= (primitive/cast i64 new-data)
                                                   (primitive/cast i64 old-data)) 16
                                                (!= (arraylist/al-get [i64] (.values new) 0) 10) 17
                                                (!= (arraylist/al-get [i64] (.values new) 1) 20) 18
                                                (!= (primitive/cast i64
                                                      (slice/slice-data (.view new)))
                                                    (primitive/cast i64
                                                      (primitive/index new-data 1))) 19
                                                (!= (slice/slice-len [i64] (.view new)) 2) 20
                                                (!= (slice/slice-get [i64] (.view new) 0) 20) 21
                                                (!= (slice/slice-get [i64] (.view new) 1) 30) 22
                                                (!= (.tag new) 7) 23
                                                (!= (.bonus new) 9) 24
                                                :else
                                                  (do (live/runtime-destroy! rt) 0))))))))))))))))))
