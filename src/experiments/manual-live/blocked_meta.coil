(module experiments.manual-live.blocked-meta)

(import "coil.primitive" :as primitive)
(import "experiments.manual-live.blocked" :as blocked)

(defn blockable-name [(name Code) (suffix Code)] (-> Code)
  (primitive/syntax->datum (primitive/code-symbol name suffix)))

(defn blockable-param-types [(params Code)] (-> Code)
  (let [out (primitive/code-list-new)]
    (for [i 0 (primitive/code-count params)]
      (primitive/code-list-push! out
        (primitive/code-nth (primitive/code-nth params i) 1)))
    (primitive/code-list-done out)))

(defn blockable-param-names [(params Code)] (-> Code)
  (let [out (primitive/code-list-new)]
    (for [i 0 (primitive/code-count params)]
      (primitive/code-list-push! out
        (primitive/code-nth (primitive/code-nth params i) 0)))
    (primitive/code-list-done out)))

;;; Generate one permanent typed function boundary. The header itself must be
;;; checked; the implementation body may be absent/invalid and represented by
;;; `name--block!` until a same-ABI native address reaches `name--publish!`.
(defn live-blockable-function [(name Code) (params Code) (returns Code)] (-> Code)
  (let [cell-name (blockable-name name `--blocked-cell)
        init-name (blockable-name name `--blocked-init!)
        block-name (blockable-name name `--block!)
        publish-name (blockable-name name `--publish!)
        types (blockable-param-types params)
        names (blockable-param-names params)
        return-type (primitive/code-nth returns 1)
        raw (primitive/fresh-identifier "implementation")]
    (if (primitive/code-eq return-type `void)
        (primitive/error "live-blockable-function: void return is not implemented yet")
        `(do
           (defn ~cell-name [] (-> (ptr blocked/BlockedFunction))
             (primitive/alloc-static blocked/BlockedFunction))
           (defn ~init-name [] (-> i64)
             (blocked/blocked-i64-init! (~cell-name)))
           (defn ~block-name [(diagnostic-id i64)] (-> i64)
             (blocked/blocked-i64-block! (~cell-name) diagnostic-id))
           (defn ~publish-name [(~raw (ptr i8))] (-> i64)
             (blocked/blocked-i64-publish! (~cell-name) ~raw))
           (defn ~name ~params ~returns
             (let [~raw (blocked/blocked-wait-implementation (~cell-name))]
               (primitive/call-ptr
                 (primitive/cast (fnptr c [~@types] ~return-type) ~raw)
                 ~@names)))))))
