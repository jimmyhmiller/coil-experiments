(module experiments.manual-live.meta-migration-test)

(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "experiments.manual-live.runtime" :as live)
(import "experiments.manual-live.meta" :use [live-struct live-transition])

(defn valid-old [(payload (ptr i8))] (-> i64)
  (primitive/cast i64 payload)
  0)
(defn valid-new [(payload (ptr i8))] (-> i64)
  (let [node (primitive/cast (ptr GeneratedNodeV2) payload)]
    (if (and (!= (primitive/cast i64 (.next node)) 0) (= (.bonus node) 1)) 0 71)))
(defn no-destroy [(payload (ptr i8))] (-> i64)
  (primitive/cast i64 payload)
  0)

(live-struct GeneratedNodeV1 1 1
  [(value i64) (next (ptr GeneratedNodeV1))]
  [] valid-old no-destroy)

(live-struct GeneratedNodeV2 1 2
  [(value i64) (next (ptr GeneratedNodeV2)) (bonus i64)]
  [[next 1]] valid-new no-destroy)

(live-transition generated-node-v1-to-v2 GeneratedNodeV1 GeneratedNodeV2
  [[value value]] [[next next]] [[bonus 1]])

(defn main [] (-> i64)
  (let [a (alloc/malloc-allocator)
        rt (primitive/alloc-stack live/Runtime)]
    (live/runtime-init! rt a)
    (let [v1 (GeneratedNodeV1--register-schema! rt)
          v2 (GeneratedNodeV2--register-schema! rt)]
      (cond (!= v1 0) 1
            (!= v2 1) 2
            (< (generated-node-v1-to-v2--register-transition! rt v1 v2) 0) 3
            :else
              (let [a-handle (live/handle-new! rt 1 v1)
                    b-handle (live/handle-new! rt 1 v1)]
                (if (or (= (primitive/cast i64 a-handle) 0)
                        (= (primitive/cast i64 b-handle) 0)) 4
                    (let [a-old (primitive/cast (ptr GeneratedNodeV1) (.payload a-handle))
                          b-old (primitive/cast (ptr GeneratedNodeV1) (.payload b-handle))
                          a-identity (primitive/cast i64 a-handle)
                          b-identity (primitive/cast i64 b-handle)]
                      (set! (.value a-old) 10)
                      (set! (.value b-old) 20)
                      (set! (.next a-old) b-old)
                      (set! (.next b-old) a-old)
                      (let [status (live/migrate-type! rt 1 v2)]
                        (if (!= status 0) 5
                            (let [a-new (primitive/cast (ptr GeneratedNodeV2) (.payload a-handle))
                                  b-new (primitive/cast (ptr GeneratedNodeV2) (.payload b-handle))]
                              (cond (!= (primitive/cast i64 a-handle) a-identity) 6
                                    (!= (primitive/cast i64 b-handle) b-identity) 7
                                    (!= (.value a-new) 10) 8
                                    (!= (.value b-new) 20) 9
                                    (!= (.bonus a-new) 1) 10
                                    (!= (primitive/cast i64 (.next a-new))
                                        (primitive/cast i64 b-new)) 11
                                    (!= (primitive/cast i64 (.next b-new))
                                        (primitive/cast i64 a-new)) 12
                                    :else (do (live/runtime-destroy! rt) 0))))))))))))
