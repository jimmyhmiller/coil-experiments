(module experiments.manual-live.meta-schema-test)

(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "experiments.manual-live.runtime" :as live)
(import "experiments.manual-live.meta" :use [live-struct])

(defn validate-node [(payload (ptr i8))] (-> i64)
  (primitive/cast i64 payload)
  0)

(defn destroy-node [(payload (ptr i8))] (-> i64)
  (primitive/cast i64 payload)
  0)

(live-struct GeneratedNode 101 1
  [(value i64) (next (ptr GeneratedNode))]
  [[next 101]] validate-node destroy-node)

(defstruct ManualNode [(value i64) (next (ptr ManualNode))])

(defn main [] (-> i64)
  (let [a (alloc/malloc-allocator)
        generated (primitive/alloc-stack live/Runtime)
        manual (primitive/alloc-stack live/Runtime)]
    (live/runtime-init! generated a)
    (live/runtime-init! manual a)
    (let [generated-schema (GeneratedNode--register-schema! generated)
          manual-schema
            (live/register-schema! manual 101 1
              (primitive/sizeof ManualNode) (primitive/alignof ManualNode)
              (primitive/fnptr-of validate-node)
              (primitive/fnptr-of destroy-node))]
      (if (< (live/register-reference! manual manual-schema
                (primitive/offsetof ManualNode next) 101) 0) 1
          (let [gs (live/schema-at generated generated-schema)
                ms (live/schema-at manual manual-schema)
                gr (primitive/index (field generated references) 0)
                mr (primitive/index (field manual references) 0)]
            (cond (!= generated-schema 0) 2
                  (!= manual-schema 0) 3
                  (!= (.schema-count generated) (.schema-count manual)) 4
                  (!= (.reference-count generated) (.reference-count manual)) 5
                  (!= (.logical-id gs) (.logical-id ms)) 6
                  (!= (.version gs) (.version ms)) 7
                  (!= (.size gs) (.size ms)) 8
                  (!= (.alignment gs) (.alignment ms)) 9
                  (!= (.offset gr) (.offset mr)) 10
                  (!= (.target-logical-id gr) (.target-logical-id mr)) 11
                  :else 0))))))
