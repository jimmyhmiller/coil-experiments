(module experiments.manual-live.meta-policy-test)

(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "experiments.manual-live.runtime" :as live)
(import "experiments.manual-live.meta"
  :use [live-struct-auto live-transition-auto])

(defn valid-v1 [(raw (ptr i8))] (-> i64) (primitive/cast i64 raw) 0)
(defn valid-v2 [(raw (ptr i8))] (-> i64)
  (let [node (primitive/cast (ptr PolicyNodeV2) raw)]
    (if (= (.bonus node) 7) 0 81)))
(defn no-destroy [(raw (ptr i8))] (-> i64) (primitive/cast i64 raw) 0)

(live-struct-auto PolicyNodeV1 1 1
  [(value i64) (next (ptr PolicyNodeV1))]
  valid-v1 no-destroy)

(live-struct-auto PolicyNodeV2 1 2
  [(value i64) (next (ptr PolicyNodeV2)) (bonus i64 :default 7)]
  valid-v2 no-destroy)

(live-transition-auto policy-v1-to-v2 PolicyNodeV1 PolicyNodeV2
  [(value i64) (next (ptr PolicyNodeV1))]
  [(value i64) (next (ptr PolicyNodeV2)) (bonus i64 :default 7)])

(defn main [] (-> i64)
  (let [a (alloc/malloc-allocator) rt (primitive/alloc-stack live/Runtime)]
    (live/runtime-init! rt a)
    (let [v1 (PolicyNodeV1--register-schema! rt)
          v2 (PolicyNodeV2--register-schema! rt)]
      (cond (!= v1 0) 1
            (!= v2 1) 2
            (!= (.reference-count rt) 2) 3
            (< (policy-v1-to-v2--register-transition! rt v1 v2) 0) 4
            :else
              (let [left (live/handle-new! rt 1 v1)
                    right (live/handle-new! rt 1 v1)
                    lp (primitive/cast (ptr PolicyNodeV1) (.payload left))
                    rp (primitive/cast (ptr PolicyNodeV1) (.payload right))]
                (set! (.value lp) 10)
                (set! (.value rp) 20)
                (set! (.next lp) rp)
                (set! (.next rp) lp)
                (let [status (live/migrate-type! rt 1 v2)
                      migrated (primitive/cast (ptr PolicyNodeV2) (.payload left))]
                  (cond (!= status 0) 5
                        (!= (.value migrated) 10) 6
                        (!= (.bonus migrated) 7) 7
                        (!= (primitive/cast i64 (.next migrated))
                            (primitive/cast i64 (.payload right))) 8
                        :else (do (live/runtime-destroy! rt) 0))))))))
