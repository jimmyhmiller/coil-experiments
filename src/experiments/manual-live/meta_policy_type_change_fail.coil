(module experiments.manual-live.meta-policy-type-change-fail)

(import "coil.primitive" :as primitive)
(import "experiments.manual-live.meta"
  :use [live-struct-auto live-transition-auto])

(defn validate [(raw (ptr i8))] (-> i64) (primitive/cast i64 raw) 0)
(defn destroy [(raw (ptr i8))] (-> i64) (primitive/cast i64 raw) 0)

(live-struct-auto ChangedV1 1 1 [(value i64)] validate destroy)
(live-struct-auto ChangedV2 1 2 [(value bool)] validate destroy)

; Same field identity but incompatible checked types requires user policy.
(live-transition-auto rejected-change ChangedV1 ChangedV2
  [(value i64)] [(value bool)])
