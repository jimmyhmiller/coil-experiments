(module experiments.manual-live.meta-policy-owning-fail)

(import "coil.primitive" :as primitive)
(import "experiments.manual-live.meta" :use [live-struct-auto])

(defn validate [(raw (ptr i8))] (-> i64) (primitive/cast i64 raw) 0)
(defn destroy [(raw (ptr i8))] (-> i64) (primitive/cast i64 raw) 0)

; Fixed arrays do not yet have a recursive LiveValue instance. The generated
; destructor therefore fails exact trait resolution instead of copying blindly.
(live-struct-auto RejectedOwner 1 1 [(values (array i64 2))] validate destroy)
