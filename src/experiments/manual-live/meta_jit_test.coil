(module experiments.manual-live.meta-jit-test)

(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.jit" :as jit)
(import "experiments.manual-live.runtime" :as live)

(defstruct HostNodeV1 [(value i64) (next (ptr HostNodeV1))])

(defn runtime [] (-> (ptr live/Runtime)) (primitive/alloc-static live/Runtime))
(defn handle-a [] (-> (ptr (ptr live/Handle)))
  (primitive/alloc-static (ptr live/Handle)))
(defn handle-b [] (-> (ptr (ptr live/Handle)))
  (primitive/alloc-static (ptr live/Handle)))
(defn current-schema [] (-> (ptr i64)) (primitive/alloc-static i64))
(defn observed [] (-> (ptr i64)) (primitive/alloc-static i64))

; One exact lease per native address stored outside the JIT session. A schema
; contributes validate+destroy, a transition contributes apply, and publication
; contributes the callable slot. Keeping distinct tokens makes the ownership
; auditable even when several artifacts share one generation.
(defstruct ArtifactLeases [(tokens (array i64 16)) (count i64)])
(defn artifact-leases [] (-> (ptr ArtifactLeases))
  (primitive/alloc-static ArtifactLeases))
(defn retain-artifacts! [(session (ptr jit/JitSession)) (count i64)] (-> i64)
  (let [leases (artifact-leases)]
    (if (> (+ (.count leases) count) 16) -1
        (let [(mut status) 0]
          (for [i 0 count]
            (let [token (jit/jit-generation-retain-current! session)]
              (if (<= token 0) (set! status -2)
                  (do
                    (store! (primitive/index (field leases tokens) (.count leases)) token)
                    (set! (.count leases) (+ (.count leases) 1))))))
          (load status)))))
(defn release-artifacts! [(session (ptr jit/JitSession))] (-> i64)
  (let [leases (artifact-leases)]
    (for [i 0 (.count leases)]
      (jit/jit-generation-release-token! session
        (load (primitive/index (field leases tokens) i))))
    (set! (.count leases) 0)
    0))

(defn meta-runtime [] (-> (ptr i8))
  (primitive/cast (ptr i8) (runtime)))

(defn meta-install-v1 [(schema i64)] (-> i64)
  (let [a (live/handle-new! (runtime) 1 schema)
        b (live/handle-new! (runtime) 1 schema)]
    (if (or (= (primitive/cast i64 a) 0) (= (primitive/cast i64 b) 0)) -1
        (let [ap (primitive/cast (ptr HostNodeV1) (.payload a))
              bp (primitive/cast (ptr HostNodeV1) (.payload b))]
          (set! (.value ap) 10)
          (set! (.value bp) 20)
          (set! (.next ap) bp)
          (set! (.next bp) ap)
          (store! (handle-a) a)
          (store! (handle-b) b)
          (store! (current-schema) schema)
          0))))

(defn meta-handle-a [] (-> (ptr i8))
  (primitive/cast (ptr i8) (load (handle-a))))
(defn meta-handle-b [] (-> (ptr i8))
  (primitive/cast (ptr i8) (load (handle-b))))
(defn meta-payload [(raw (ptr i8))] (-> (ptr i8))
  (.payload (primitive/cast (ptr live/Handle) raw)))
(defn meta-migrate [(schema i64)] (-> i64)
  (let [status (live/migrate-type! (runtime) 1 schema)]
    (if (= status 0) (store! (current-schema) schema) 0)
    status))
(defn meta-publish [(fn-raw (ptr i8))] (-> i64)
  (let [result (primitive/call-ptr (primitive/cast (fnptr c [] i64) fn-raw))]
    (store! (observed) result)
    0))

(export-c [meta-runtime :as "meta_live_runtime"]
          [meta-install-v1 :as "meta_live_install_v1"]
          [meta-handle-a :as "meta_live_handle_a"]
          [meta-handle-b :as "meta_live_handle_b"]
          [meta-payload :as "meta_live_payload"]
          [meta-migrate :as "meta_live_migrate"]
          [meta-publish :as "meta_live_publish"])

(defn candidate-v1 [] (-> (slice u8))
  "(import \"coil.primitive\" :as primitive)
   (import \"experiments.manual-live.runtime\" :as live)
   (import \"experiments.manual-live.meta\" :use [live-struct-auto live-function-versioned])
   (import \"experiments.manual-live.semantic-policy\" :use [semantic-catalog])
   (import \"experiments.manual-live.semantic-transform\" :use *)
   (extern meta_live_runtime :cc c [] (-> (ptr i8)))
   (extern meta_live_install_v1 :cc c [i64] (-> i64))
   (extern meta_live_handle_a :cc c [] (-> (ptr i8)))
   (extern meta_live_handle_b :cc c [] (-> (ptr i8)))
   (extern meta_live_payload :cc c [(ptr i8)] (-> (ptr i8)))
   (extern meta_live_publish :cc c [(ptr i8)] (-> i64))
   (defn valid-v1 [(raw (ptr i8))] (-> i64) (primitive/cast i64 raw) 0)
   (defn no-destroy-v1 [(raw (ptr i8))] (-> i64) (primitive/cast i64 raw) 0)
   (live-struct-auto MetaJitNodeV1 1 1
     [(value i64) (next (ptr MetaJitNodeV1))]
     valid-v1 no-destroy-v1)
   (live-function-versioned meta-cycle 1 3 [1] [] [] (-> i64)
     (let [a (primitive/cast (ptr MetaJitNodeV1) (meta_live_payload (meta_live_handle_a)))
           b (primitive/cast (ptr MetaJitNodeV1) (meta_live_payload (meta_live_handle_b)))]
       (if (and (= (primitive/cast i64 (.next a)) (primitive/cast i64 b))
                (= (primitive/cast i64 (.next b)) (primitive/cast i64 a)))
           (+ (.value a) (.value b)) -1000)))
   (semantic-catalog register-semantic-v1 [[1 MetaJitNodeV1]] [[3 meta-cycle--v1]])")

(defn candidate-v2 [] (-> (slice u8))
  "(import \"coil.primitive\" :as primitive)
   (import \"experiments.manual-live.runtime\" :as live)
   (import \"experiments.manual-live.meta\" :use [live-struct-auto live-function-versioned live-transition-auto])
   (import \"experiments.manual-live.semantic-policy\" :use [semantic-catalog])
   (import \"experiments.manual-live.semantic-transform\" :use *)
   (extern meta_live_runtime :cc c [] (-> (ptr i8)))
   (extern meta_live_handle_a :cc c [] (-> (ptr i8)))
   (extern meta_live_handle_b :cc c [] (-> (ptr i8)))
   (extern meta_live_payload :cc c [(ptr i8)] (-> (ptr i8)))
   (extern meta_live_migrate :cc c [i64] (-> i64))
   (extern meta_live_publish :cc c [(ptr i8)] (-> i64))
   (defn valid-v2 [(raw (ptr i8))] (-> i64)
     (let [node (primitive/cast (ptr MetaJitNodeV2) raw)]
       (if (= (.bonus node) 1) 0 91)))
   (defn no-destroy-v2 [(raw (ptr i8))] (-> i64) (primitive/cast i64 raw) 0)
   (live-struct-auto MetaJitNodeV2 1 2
     [(value i64) (next (ptr MetaJitNodeV2)) (bonus i64 :default 1)]
     valid-v2 no-destroy-v2)
   (live-transition-auto meta-jit-v1-to-v2 MetaJitNodeV1 MetaJitNodeV2
     [(value i64) (next (ptr MetaJitNodeV1))]
     [(value i64) (next (ptr MetaJitNodeV2)) (bonus i64 :default 1)])
   (live-function-versioned meta-cycle 2 3 [1] [] [] (-> i64)
     (let [a (primitive/cast (ptr MetaJitNodeV2) (meta_live_payload (meta_live_handle_a)))
           b (primitive/cast (ptr MetaJitNodeV2) (meta_live_payload (meta_live_handle_b)))]
       (if (and (= (primitive/cast i64 (.next a)) (primitive/cast i64 b))
                (= (primitive/cast i64 (.next b)) (primitive/cast i64 a)))
           (+ (+ (.value a) (.value b)) (+ (.bonus a) (.bonus b))) -1000)))
   (semantic-catalog register-semantic-v2 [[1 MetaJitNodeV2]] [[3 meta-cycle--v2]])")

(defn main [] (-> i64)
  (block :done
    (let [allocator (alloc/malloc-allocator)
          (mut session) (jit/jit-session-new allocator)]
      (live/runtime-init! (runtime) allocator)
      (when (!= (jit/jit-session-set-legacy-reload! (mut session) false) 0)
        (break :done 1))
      (when (!= (jit/jit-prepare-replace-with-entry! (mut session) (candidate-v1)
                  "(let [rt (primitive/cast (ptr live/Runtime) (meta_live_runtime)) schema (MetaJitNodeV1--register-schema! rt)] (if (or (< schema 0) (!= (register-semantic-v1 rt) 0)) -1 (let [status (meta_live_install_v1 schema)] (if (= status 0) (meta_live_publish (meta-cycle--v1--candidate-address)) status))))") 0)
        (break :done 2))
      (when (!= (jit/jit-commit-prepared! (mut session)) 0) (break :done 3))
      ; V1 stores validate, destroy, and the published function address.
      (when (!= (retain-artifacts! (mut session) 3) 0) (break :done 9))
      (when (!= (load (observed)) 30) (break :done 4))
      (when (!= (jit/jit-prepare-replace-with-entry! (mut session) (candidate-v2)
                  "(let [rt (primitive/cast (ptr live/Runtime) (meta_live_runtime)) schema (MetaJitNodeV2--register-schema! rt)] (if (or (< schema 0) (or (< (meta-jit-v1-to-v2--register-transition! rt 0 schema) 0) (!= (register-semantic-v2 rt) 0))) -1 (let [status (meta_live_migrate schema)] (if (= status 0) (meta_live_publish (meta-cycle--v2--candidate-address)) status))))") 0)
        (break :done 5))
      (when (!= (jit/jit-commit-prepared! (mut session)) 0) (break :done 6))
      ; V2 stores validate, destroy, transition apply, and its function address.
      (when (!= (retain-artifacts! (mut session) 4) 0) (break :done 10))
      (when (!= (load (observed)) 32) (break :done 7))
      (when (!= (.dependency-count (runtime)) 2) (break :done 8))
      (when (!= (jit/jit-generation-token-leases (mut session)) 7)
        (break :done 11))
      ; Runtime destruction is the point at which no schema/transition callback
      ; can be invoked again. Only then may all exact image leases be released.
      (live/runtime-destroy! (runtime))
      (release-artifacts! (mut session))
      (when (!= (jit/jit-generation-token-leases (mut session)) 0)
        (break :done 12))
      (jit/jit-reclaim-retired! (mut session))
      0)))
