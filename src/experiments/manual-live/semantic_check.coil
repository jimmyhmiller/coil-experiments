(module experiments.manual-live.semantic-check)

(import "coil.primitive" :as primitive)

(defn dependency-call? [(form Code)] (-> bool)
  (if (and (primitive/code-list? form) (> (primitive/code-count form) 0))
      (let [decl (primitive/code-decl (primitive/code-nth form 0))]
        (and (primitive/code-list? decl)
             (and (>= (primitive/code-count decl) 4)
                  (and (primitive/code-eq (primitive/code-nth decl 1)
                         `experiments.manual-live.runtime)
                       (primitive/code-eq (primitive/code-nth decl 3)
                         `experiments.manual-live.runtime.register-dependency!)))))
      false))

(defn count-dependency-calls [(form Code)] (-> i64)
  (if (not (primitive/code-list? form)) 0
      (let [(mut count) (if (dependency-call? form) 1 0)]
        (for [i 0 (primitive/code-count form)]
          (set! count (+ (load count)
            (count-dependency-calls (primitive/code-nth form i)))))
        (load count))))

(defn semantic-proof-check [(modules Code)] (-> Code)
  (let [(mut found) false (mut count) 0]
    (for [mi 0 (primitive/code-count modules)]
      (let [module (primitive/code-nth modules mi)]
        (if (primitive/code-eq (primitive/code-nth module 0)
              `experiments.manual-live-semantic.registry)
            (do
              (set! found true)
              (set! count (count-dependency-calls module))) 0)))
    (if (and (load found) (!= (load count) 3))
        (primitive/error
          "semantic live proof: expected exactly three derived dependency edges")
        0)
    `0))

(checker semantic-proof-check)
