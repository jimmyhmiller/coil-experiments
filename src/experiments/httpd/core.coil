(module experiments.httpd.core)

(import "coil.primitive" :as primitive :use *)
(import "coil.arraylist" :as arraylist)
(import "coil.str" :as str)
(import "coil.alloc" :as alloc)
(import "coil.control" :use *)

(defstruct Handler [(function (fnptr c [Request] Response))])
(defstruct Middleware [(function (fnptr c [Request] (Option Response)))])

(defstruct Response
  [(status i64)
   (content-type (slice u8))
   (body (slice u8))])

(defstruct Request
  [(method (slice u8))
   (path (slice u8))
   (query (slice u8))
   (body (slice u8))])

(defstruct Route
  [(method (slice u8))
   (path (slice u8))
   (handler Handler)])

(defstruct App
  [(routes (arraylist/ArrayList Route))
   (middleware (arraylist/ArrayList Middleware))])

(defn response-ok [(body (slice u8))] (-> Response)
  (Response :status 200
            :content-type "text/plain; charset=utf-8"
            :body body))

(defn response-html [(body (slice u8))] (-> Response)
  (Response :status 200
            :content-type "text/html; charset=utf-8"
            :body body))

(defn response-json [(body (slice u8))] (-> Response)
  (Response :status 200
            :content-type "application/json"
            :body body))

(defn response-not-found [] (-> Response)
  (Response :status 404
            :content-type "text/plain; charset=utf-8"
            :body "not found\n"))

(defn response-method-not-allowed [] (-> Response)
  (Response :status 405
            :content-type "text/plain; charset=utf-8"
            :body "method not allowed\n"))

(defn response-status [(status i64) (body (slice u8))] (-> Response)
  (Response :status status
            :content-type "text/plain; charset=utf-8"
            :body body))

(defn app-new [(a (dyn alloc/Allocator))] (-> App)
  (App :routes (arraylist/al-new [Route] a)
       :middleware (arraylist/al-new [Middleware] a)))

(defn handler-of [(function (fnptr c [Request] Response))] (-> Handler)
  (Handler :function function))

(defn route! [(app (mut App)) (method (slice u8)) (path (slice u8)) (handler Handler)] (-> i64)
  (arraylist/al-push!
    [Route]
    (mut (field app routes))
    (Route :method method :path path :handler handler)))

(defn get! [(app (mut App)) (path (slice u8)) (handler Handler)] (-> i64)
  (route! (mut app) "GET" path handler))

(defn post! [(app (mut App)) (path (slice u8)) (handler Handler)] (-> i64)
  (route! (mut app) "POST" path handler))

(defn put! [(app (mut App)) (path (slice u8)) (handler Handler)] (-> i64)
  (route! (mut app) "PUT" path handler))

(defn delete! [(app (mut App)) (path (slice u8)) (handler Handler)] (-> i64)
  (route! (mut app) "DELETE" path handler))

(defn use! [(app (mut App)) (middleware Middleware)] (-> i64)
  (arraylist/al-push!
    [Middleware]
    (mut (field app middleware))
    middleware))

;; A middleware returns Some response to stop the chain, or None to continue.
;; The request argument is immutable, so middleware can inspect and rewrite the
;; response but cannot accidentally invalidate route dispatch.
(defn handle-request [(app (mut App)) (request Request)] (-> Response)
  (let [(mut result) (response-not-found)
        (mut matched-path) false
        (mut handled) false]
    (arraylist/al-for [middleware (field app middleware)]
                      (when (not (load handled))
                        (let [action (.function
                                       (load (arraylist/al-elem
                                               [Middleware]
                                               (mut (field app middleware))
                                               0)))]
                          (match (primitive/call-ptr action request)
                            (None [] 0)
                            (Some [response]
                                  (do
                                    (set! result response)
                                    (set! handled true)))))))
    (when (not (load handled))
      (arraylist/al-for [route (field app routes)]
                        (when (and (not (load handled))
                                   (str/str-eq (.path route) (.path request)))
                          (do
                            (set! matched-path true)
                            (when (and (not (load handled))
                                       (str/str-eq (.method route) (.method request)))
                              (do
                                (set! result (primitive/call-ptr
                                               (load (.function
                                                       (load (.handler route))))
                                               request))
                                (set! handled true)))))))
    (if (and (load matched-path) (not (load handled)))
        (response-method-not-allowed)
        (load result))))

(defn route-count [(app App)] (-> i64)
  (arraylist/al-len (field app routes)))

(defn middleware-count [(app App)] (-> i64)
  (arraylist/al-len (field app middleware)))
