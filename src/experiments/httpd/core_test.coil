(module experiments.httpd.core-test)

(import "coil.assert" :use *)
(import "coil.alloc" :as alloc)
(import "coil.str" :use [str-eq])
(import "coil.primitive" :as primitive)
(import "experiments.httpd.core" :use *)

(defn hello [(request Request)] (-> Response)
  (response-ok "hello\n"))

(defn echo-method [(request Request)] (-> Response)
  (response-ok (.method request)))

(defn block-post [(request Request)] (-> (Option Response))
  (if (str-eq (.method request) "POST")
      (Some (response-status 403 "blocked\n"))
      (None)))

(deftest registers-routes-and-dispatches-exact-method-and-path
         (let [app (app-new (alloc/malloc-allocator))]
           (let [(mut app) app]
             (assert-eq (get! app "/hello" (handler-of (primitive/fnptr-of hello))) 0)
             (assert-eq (post! app "/echo" (handler-of (primitive/fnptr-of echo-method))) 1)
             (assert-eq (route-count app) 2)
             (let [hello-request (Request "GET" "/hello" "" "")
                   missing-request (Request "GET" "/nope" "" "")
                   wrong-method (Request "GET" "/echo" "" "")]
               (assert-eq (.status (handle-request app hello-request)) 200)
               (assert (str-eq (.body (handle-request app hello-request)) "hello\n"))
               (assert-eq (.status (handle-request app missing-request)) 404)
               (assert-eq (.status (handle-request app wrong-method)) 404)))))

(deftest middleware-can-short-circuit-before-routing
         (let [app (app-new (alloc/malloc-allocator))]
             (assert-eq (use! app (Middleware :function (primitive/fnptr-of block-post))) 0)
             (assert-eq (middleware-count app) 1)
             (let [post (Request "POST" "/anything" "" "data")
                   get (Request "GET" "/anything" "" "")]
               (assert-eq (.status (handle-request app post)) 403)
               (assert-eq (.status (handle-request app get)) 404)))))
