(module experiments.httpd.core-test)

(import "coil.assert" :use *)
(import "coil.alloc" :as alloc)
(import "coil.str" :use [str-eq])
(import "coil.primitive" :as primitive)
(import "experiments.httpd.core" :use *)

(defn hello [(request (ref Request))] (-> Response)
  (response-ok "hello\n"))

(defn echo-method [(request (ref Request))] (-> Response)
  (response-ok (.method request)))

(defn block-post [(request (ref Request))] (-> (Option Response))
  (if (str-eq (.method request) "POST")
      (Some (response-status 403 "blocked\n"))
      (None)))

(deftest registers-routes-and-dispatches-exact-method-and-path
         (let [app (app-new (alloc/malloc-allocator))]
           (let [(mut mutable-app) (app-new (alloc/malloc-allocator))]
             (assert-eq (get! (mut mutable-app) "/hello" (handler-of (primitive/fnptr-of hello))) 0)
             (assert-eq (post! (mut mutable-app) "/echo" (handler-of (primitive/fnptr-of echo-method))) 1)
             (assert-eq (route-count mutable-app) 2)
              (let [hello-request (Request :method "GET" :path "/hello" :query "" :body "")
                   missing-request (Request :method "GET" :path "/nope" :query "" :body "")
                   wrong-method (Request :method "GET" :path "/echo" :query "" :body "")]
               (let [ok (handle-request (mut mutable-app) hello-request)
                     missing (handle-request (mut mutable-app) missing-request)
                     wrong-method-response (handle-request (mut mutable-app) wrong-method)]
                 (assert-eq (.status ok) 200)
                 (assert (str-eq (.body ok) "hello\n"))
                 (assert-eq (.status missing) 404)
                 (assert-eq (.status wrong-method-response) 404)))))

(deftest middleware-can-short-circuit-before-routing
         (let [app (app-new (alloc/malloc-allocator))]
            (let [(mut mutable-app) (app-new (alloc/malloc-allocator))]
             (assert-eq (use! (mut mutable-app) (Middleware :function (primitive/fnptr-of block-post))) 0)
             (assert-eq (middleware-count mutable-app) 1)
              (let [post (Request :method "POST" :path "/anything" :query "" :body "data")
                   get (Request :method "GET" :path "/anything" :query "" :body "")]
               (let [blocked (handle-request (mut mutable-app) post)
                     missing-route (handle-request (mut mutable-app) get)]
                 (assert-eq (.status blocked) 403)
                 (assert-eq (.status missing-route) 404)))))
