(module experiments.httpd.selfcheck)

(import "coil.fmt" :as fmt)
(import "coil.str" :as str)
(import "coil.socket" :as socket)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "experiments.httpd.core" :as core)
(import "experiments.httpd.server" :as server)

(defn health [(request core/Request)] (-> core/Response)
  (core/response-json "{\"status\":\"ok\"}"))

(defn echo [(request core/Request)] (-> core/Response)
  (core/response-ok (.path request)))

(defn main [] (-> i64)
  (let [app (core/app-new (alloc/malloc-allocator))]
    (core/get! app "/health" (core/Handler (primitive/fnptr-of health)))
    (core/post! app "/echo" (core/Handler (primitive/fnptr-of echo)))
    (match (server/listen! "127.0.0.1" 0 app)
      (Err [e] 1)
      (Ok [running]
          (match (server/listener-port running)
            (Err [e] 1)
            (Ok [port]
                (do
                  (fmt/print (stderr) "PORT=")
                  (fmt/print-i (stderr) port)
                  (fmt/print (stderr) "\n")
                  (server/serve-one! running)
                  (server/close! running)
                  0)))))))
