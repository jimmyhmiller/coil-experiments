(module experiments.httpd.demo)

(import "coil.fmt" :as fmt)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "experiments.httpd.core" :as core)
(import "experiments.httpd.server" :as server)

(defn hello [(request (ref core/Request))] (-> core/Response)
  (core/response-html "<h1>Hello from Coil</h1>"))

(defn health [(request (ref core/Request))] (-> core/Response)
  (core/response-json "{\"status\":\"ok\"}"))

(defn require-token [(request (ref core/Request))] (-> (Option core/Response))
  (None))

(defn main [] (-> i64)
  (let [(mut app) (core/app-new (alloc/malloc-allocator))]
    (core/get! (mut app) "/" (core/handler-of (primitive/fnptr-of hello)))
    (core/get! (mut app) "/health" (core/handler-of (primitive/fnptr-of health)))
    (match (server/listen! "127.0.0.1" 8080 app)
      (Err [e] (do (fmt/println (stderr) "could not start HTTP server") 1))
      (Ok [running]
          (do
            (fmt/println (stderr) "HTTP server on http://127.0.0.1:8080")
            (server/serve! running))))))
