(module experiments.httpd.demo)

(import "coil.fmt" :as fmt)
(import "experiments.httpd.core" :as core)
(import "experiments.httpd.server" :as server)

(defn hello [(request core/Request)] (-> core/Response)
  (core/response-html "<h1>Hello from Coil</h1>"))

(defn health [(request core/Request)] (-> core/Response)
  (core/response-json "{\"status\":\"ok\"}"))

(defn require-token [(request core/Request)] (-> (Option core/Response))
  (None))

(defn main [] (-> i64)
  (let [app (core/app-new (alloc/malloc-allocator))]
    (core/get! app "/" (Handler (primitive/fnptr-of hello)))
    (core/get! app "/health" (Handler (primitive/fnptr-of health)))
    (match (server/listen! "127.0.0.1" 8080 app)
      (Err [e] (do (fmt/println (stderr) "could not start HTTP server") 1))
      (Ok [running]
          (do (fmt/println (stderr) "HTTP server on http://127.0.0.1:8080")
              (server/serve! running)))))
