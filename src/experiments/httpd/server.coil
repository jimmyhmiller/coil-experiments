(module experiments.httpd.server)

(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.slice" :as slice)
(import "coil.socket" :as socket)
(import "coil.str" :as str)
(import "coil.http.server" :as http)
(import "coil.http.parser" :as parser)
(import "experiments.httpd.core" :as core)

(const REQUEST_BUFFER_BYTES 16384)
(const INCOMPLETE_REQUEST 14)

(defstruct Server
  [(listener socket/TcpListener)
   (app core/App)])

(defn status-text [(status i64)] (-> (slice u8))
  (cond (= status 200) "200 OK"
        (= status 201) "201 Created"
        (= status 204) "204 No Content"
        (= status 400) "400 Bad Request"
        (= status 403) "403 Forbidden"
        (= status 404) "404 Not Found"
        (= status 405) "405 Method Not Allowed"
        (= status 500) "500 Internal Server Error"
        :else "200 OK"))

(defn split-target [(method (slice u8)) (target (slice u8)) (body (slice u8))] (-> core/Request)
  (match (str/str-find target "?")
    (None [] (core/Request :method method :path target :query "" :body body))
    (Some [at]
          (core/Request :method method
                        :path (slice/subslice [u8] target 0 at)
                        :query (slice/subslice [u8] target (+ at 1) (slice/slice-len target))
                        :body body))))

(defn request-from-http [(parsed http/Request)] (-> core/Request)
  (split-target (http/method parsed)
                (http/target parsed)
                (http/body parsed)))

(defn write-all! [(connection (ptr socket/TcpConnection)) (bytes (slice u8))] (-> i64)
  (let [(mut at) 0
        (mut failed) false]
    (loop (if (or (load failed) (>= (load at) (slice/slice-len bytes)))
              (break)
              (match (socket/tcp-write connection
                                       (primitive/cast (ptr i8)
                                                       (slice/slice-data (slice/subslice [u8]
                                                                                         bytes
                                                                                         (load at)
                                                                                         (slice/slice-len bytes))))
                                       (- (slice/slice-len bytes) (load at)))
                (Err [e] (set! failed true))
                (Ok [count]
                    (if (<= count 0)
                        (set! failed true)
                        (set! at (+ (load at) count)))))))
    (if (load failed) 1 0)))

(defn append-response! [(sb (mut str/StrBuf)) (response core/Response)] (-> i64)
  (do
    (str/sb-push-str! (mut sb) "HTTP/1.1 ")
    (str/sb-push-str! (mut sb) (status-text (.status response)))
    (str/sb-push-str! (mut sb) "\r\nContent-Type: ")
    (str/sb-push-str! (mut sb) (.content-type response))
    (str/sb-push-str! (mut sb) "\r\nContent-Length: ")
    (str/sb-push-i64! (mut sb) (slice/slice-len (.body response)))
    (str/sb-push-str! (mut sb) "\r\nConnection: close\r\n\r\n")
    (str/sb-push-str! (mut sb) (.body response))
    0))

(defn send-response! [(connection (ptr socket/TcpConnection)) (response core/Response)] (-> i64)
  (let [sb (primitive/alloc-stack str/StrBuf)]
    (set! sb (str/sb-new (alloc/malloc-allocator)))
    (append-response! (mut sb) response)
    (write-all! connection (str/sb-str (load sb)))
    (str/sb-free! (mut sb))
    0))

;; Complete a request before returning its borrowed byte view. The stdlib parser
;; reports invalid EOF for a truncated request, so we feed more bytes instead of
;; treating the first TCP segment as the whole message.
(defn read-request! [(connection (ptr socket/TcpConnection))] (-> (Result (slice u8) i64))
  (let [buffer (primitive/alloc-stack (array u8 16384))
        (mut received) 0
        (mut error) 0
        (mut complete) false]
    (loop (if (or (not (= (load error) 0))
                  (or (load complete)
                      (>= (load received) REQUEST_BUFFER_BYTES)))
              (break)
              (do
                (match (http/parse-request (alloc/malloc-allocator)
                                           (slice/slice-new [u8]
                                                            (primitive/index buffer 0)
                                                            (load received)))
                  (Ok [parsed]
                      (do
                        (http/request-free parsed)
                        (if (> (load received) 0)
                            (set! complete true)
                            0)))
                  (Err [failure]
                       (if (= (http/error-code failure) INCOMPLETE_REQUEST)
                           0
                           (set! error (http/error-code failure)))))
                (if (or (load complete) (not (= (load error) 0)))
                    0
                    (match (socket/tcp-read connection
                                            (primitive/cast (ptr i8)
                                                            (primitive/index buffer
                                                                             (load received)))
                                            (- REQUEST_BUFFER_BYTES (load received)))
                      (Err [e] (set! error 1))
                      (Ok [count]
                          (if (<= count 0)
                              (do
                                (if (= (load received) 0) (set! error 1) 0)
                                (set! complete (> (load received) 0)))
                              (set! received (+ (load received) count)))))))))
    (cond (not (= (load error) 0)) (Err (load error))
          (load complete)
            (Ok (slice/slice-new [u8]
                                 (primitive/index buffer 0)
                                 (load received)))
          :else (Err 1))))

(defn serve-one! [(server (mut Server))] (-> i64)
  (let [connection (primitive/alloc-stack socket/TcpConnection)]
    (match (socket/tcp-accept (field server listener) connection)
      (Err [e] 1)
      (Ok [_]
          (let [outcome (read-request! connection)]
            (match outcome
              (Err [e]
                   (do
                     (send-response! connection
                                     (core/response-status 400 "bad request\n"))
                     (socket/tcp-connection-close! connection)
                     1))
              (Ok [source]
                  (match (http/parse-request (alloc/malloc-allocator) source)
                    (Err [e]
                         (do
                           (send-response! connection
                                           (core/response-status 400 "bad request\n"))
                           (socket/tcp-connection-close! connection)
                           1))
                    (Ok [parsed]
                        (let [request (request-from-http parsed)]
                          (send-response! connection
                                          (core/handle-request (mut (field server app)) request))
                          (http/request-free parsed)
                          (socket/tcp-connection-close! connection)
                          0))))))))))

(defn serve! [(server (mut Server))] (-> i64)
  (let [(mut failures) 0]
    (loop true
      (set! failures (+ (load failures) (serve-one! (mut server)))))
    (load failures)))

(defn listener-port [(server (ptr Server))] (-> (Result i64 i64))
  (match (socket/tcp-listener-port (.listener server))
    (Err [e] (Err -1))
    (Ok [port] (Ok port))))

(defn close! [(server (mut Server))] (-> i64)
  (socket/tcp-listener-close! (field server listener)))

(defn listen! [(host (slice u8)) (port i64) (app core/App)] (-> (Result (ptr Server) i64))
  (let [server (primitive/alloc-static Server)]
    (set! (.app server) app)
    (match (socket/tcp-listen (alloc/malloc-allocator)
                              (.listener server)
                              host port true 16)
      (Err [e] (Err 1))
      (Ok [_] (Ok (load server))))))
