(module experiments.httpd.server)

(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.mem" :as mem)
(import "coil.slice" :as slice)
(import "coil.socket" :as socket)
(import "coil.str" :as str)
(import "coil.fmt" :as fmt)
(import "coil.io" :as io)
(import "coil.http.server" :as http)
(import "coil.http.parser" :as parser)
(import "coil.arraylist" :as arraylist)
(import "experiments.httpd.core" :as core)

(const REQUEST_BUFFER_BYTES 16384)

(defstruct Server
  [(listener socket/TcpListener)
   (app core/App)])

(defn status-text [(status i64)] (-> (slice u8))
  (cond (= status 200) "200 OK"
        (= status 201) "201 Created"
        (= status 204) "204 No Content"
        (= status 400) "400 Bad Request"
        (= status 403) "403 Forbidden"
        (= status 404) "404 Not Found"
        (= status 405) "405 Method Not Allowed"
        (= status 500) "500 Internal Server Error"
        :else "200 OK"))

(defn split-target [(method (slice u8)) (target (slice u8)) (body (slice u8))] (-> core/Request)
  (match (str/str-find target "?")
    (None []
          (core/Request
            :method method
            :path target
            :query ""
            :body body))
    (Some [at]
          (core/Request
            :method method
            :path (slice/subslice [u8] target 0 at)
            :query (slice/subslice [u8] target (+ at 1) (slice/slice-len target))
            :body body))))

(defn owned-copy [(bytes (slice u8))] (-> (Result (slice u8) i64))
  (let [(mut memory) (primitive/zeroed (Option (slice u8)))]
    (match (alloc/alloc-bytes (alloc/malloc-allocator) (slice/slice-len bytes) 1)
      (None [] (Err 1))
      (Some [copy]
            (do
              (mem/mem-copy [u8]
                            (slice/slice-data copy)
                            (slice/slice-data bytes)
                            (slice/slice-len bytes))
              (Ok copy))))))

(defn request-from-http [(parsed http/Request)] (-> core/Request)
  (match (owned-copy (http/method parsed))
    (Err [_] (split-target "" "" (http/body parsed)))
    (Ok [method]
        (match (owned-copy (http/target parsed))
          (Err [_] (split-target "" "" (http/body parsed)))
          (Ok [target]
              (split-target method target (http/body parsed)))))))

(defn write-all! [(connection (ptr socket/TcpConnection)) (bytes (slice u8))] (-> i64)
  (let [(mut at) 0
        (mut failed) false]
    (loop (if (or (load failed) (>= (load at) (slice/slice-len bytes)))
              (break)
              (match (socket/tcp-write connection
                                       (primitive/cast (ptr i8)
                                                       (slice/slice-data (slice/subslice [u8]
                                                                                         bytes
                                                                                         (load at)
                                                                                         (- (slice/slice-len bytes)
                                                                                            (load at)))))
                                       (- (slice/slice-len bytes) (load at)))
                (Err [e] (set! failed true))
                (Ok [count]
                    (if (<= count 0)
                        (set! failed true)
                        (set! at (+ (load at) count)))))))
    (if (load failed) 1 0)))

(defn append-response! [(sb (mut str/StrBuf)) (response core/Response)] (-> i64)
  (do
    (str/sb-push-str! (mut sb) "HTTP/1.1 ")
    (str/sb-push-str! (mut sb) (status-text (.status response)))
    (str/sb-push-str! (mut sb) "\r\nContent-Type: ")
    (str/sb-push-str! (mut sb) (.content-type response))
    (str/sb-push-str! (mut sb) "\r\nContent-Length: ")
    (str/sb-push-i64! (mut sb) (slice/slice-len (.body response)))
    (str/sb-push-str! (mut sb) "\r\nConnection: close\r\n\r\n")
    (str/sb-push-str! (mut sb) (.body response))
    0))

(defn send-response! [(connection (ptr socket/TcpConnection)) (response core/Response)] (-> i64)
  (let [sb (primitive/alloc-stack str/StrBuf)]
    (set! sb (str/sb-new (alloc/malloc-allocator)))
    (append-response! (mut sb) response)
    (write-all! connection (str/sb-str (load sb)))
    (str/sb-free! (mut sb))
    0))

(defn respond! [(connection (ptr socket/TcpConnection))
                (app (mut core/App))
                (request http/Request)] (-> i64)
  (let [core-request (request-from-http request)
        status
          (send-response! connection
                          (core/handle-request (mut app) core-request))]
    (http/request-free request)
    status))

;; Read one complete HTTP/1.1 request into a fixed buffer and parse it with the
;; standard library's whole-message parser.
(defn read-request! [(connection (ptr socket/TcpConnection))] (-> (Result http/Request i64))
  (let [chunk (primitive/alloc-stack (array u8 16384))
        buffer (primitive/alloc-stack str/StrBuf)
        (mut failure-code) 0
        (mut complete) false
        (mut received) 0
        (mut parsed) (primitive/zeroed http/Request)]
    (set! buffer (str/sb-new (alloc/malloc-allocator)))
    (loop (if (or (not (= (load failure-code) 0)) (load complete))
              (break)
              (do
                (match (socket/tcp-read connection
                                        (primitive/cast (ptr i8)
                                                        chunk)
                                        REQUEST_BUFFER_BYTES)
                  (Err [e] (set! failure-code 1))
                  (Ok [count]
                      (let [input
                              (if (> count 0)
                                  (do
                                    (let [(mut index) 0]
                                      (loop (if (>= (load index) count)
                                                (break)
                                                (do
                                                  (str/sb-push-byte! (mut buffer)
                                                                     (load (primitive/index chunk (load index))))
                                                  (set! index (+ (load index) 1))))))
                                    (str/sb-str (load buffer)))
                                  (str/sb-str (load buffer)))]
                        ;; A one-packet client that waits for the response is valid
                        ;; HTTP. The whole-message parser pauses on EOF; remember a
                        ;; zero-byte read so its partial result can be returned.
                        (if (< count 0)
                            (set! failure-code 1)
                            (do
                              (set! received (+ (load received) count))
                              (match (http/parse-request (alloc/malloc-allocator) input)
                                (Ok [request]
                                    (do
                                      (set! parsed request)
                                      (set! complete true)))
                                (Err [failure]
                                     (do
                                       (when (= (http/error-code failure) 14)
                                         (set! received (- 0 1)))
                                       (when (!= (http/error-code failure) 14)
                                         (set! failure-code (http/error-code failure)))))))))))
                0)))
    (cond (not (= (load failure-code) 0)) (Err (load failure-code))
          (> (load received) 0) (Ok (load parsed))
          :else (Err 1))))

(defn arraylist-free-context! [(request http/Request)] (-> i64)
  (http/request-free request))

(defn serve-one! [(server (mut Server))] (-> i64)
  (let [connection (primitive/alloc-stack socket/TcpConnection)]
    (match (socket/tcp-accept (field server listener) connection)
      (Err [e] 1)
      (Ok [_]
          (let [outcome (read-request! connection)]
            (match outcome
              (Err [e]
                   (do
                     (send-response! connection
                                     (core/response-status 400 "bad request\n"))
                     (socket/tcp-connection-close! connection)
                     1))
              (Ok [parsed]
                  (do
                    (respond! connection (mut (field server app)) parsed)
                    (socket/tcp-connection-close! connection)
                    0))))))))

(defn serve! [(server (mut Server))] (-> i64)
  (let [(mut failures) 0]
    (loop true
      (set! failures (+ (load failures) (serve-one! (mut server)))))
    (load failures)))

(defn listener-port [(server (ptr Server))] (-> (Result i64 i64))
  (match (socket/tcp-listener-port (field server listener))
    (Err [e] (Err -1))
    (Ok [port] (Ok port))))

(defn close! [(server (mut Server))] (-> i64)
  (socket/tcp-listener-close! (field server listener)))

(defn listen! [(host (slice u8)) (port i64) (app core/App)] (-> (Result (ptr Server) i64))
  (let [server (primitive/alloc-static Server)]
    (set! (.app server) app)
    (match (socket/tcp-listen (alloc/malloc-allocator)
                              (field server listener)
                              host
                              port
                              true
                              16)
      (Err [e] (Err 1))
      (Ok [_] (Ok server)))))
