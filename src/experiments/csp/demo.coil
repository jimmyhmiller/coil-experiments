(module experiments.csp.demo)
(import "coil.primitive" :as primitive)
(import "experiments.csp.lang" :use *)

(extern printf :cc c [(ptr i8) ...] (-> i32))

(defstruct Producer [(orders (ptr Channel)) (next i64)])
(defstruct Worker [(orders (ptr Channel)) (completed (ptr Channel)) (value i64)])
(defstruct Collector [(completed (ptr Channel)) (value i64) (count i64) (total i64)])

(defprocess produce [(p (ptr Producer))]
  (0 (branch (> (.next p) 20) 3 1))
  (1 (send (.orders p) (.next p) 2 4))
  (2 (set (.next p) (+ (.next p) 1) 0))
  (3 (close (.orders p) 4))
  (4 (done)))

(defprocess work [(w (ptr Worker))]
  (0 (receive (.orders w) (field w value) 1 4))
  (1 (send (.completed w) (* (.value w) (.value w)) 0 4))
  (4 (done)))

(defprocess collect [(c (ptr Collector))]
  (0 (receive (.completed c) (field c value) 1 4))
  (1 (set (.total c) (+ (.total c) (.value c)) 2))
  (2 (set (.count c) (+ (.count c) 1) 3))
  (3 (branch (= (.count c) 20) 4 0))
  (4 (close (.completed c) 5))
  (5 (done)))

(defn main [] (-> i64)
  (let [scheduler (primitive/alloc-stack Scheduler)
        orders (channel-new 2) completed (channel-new 2)
        producer (primitive/alloc-stack Producer)
        workers (primitive/alloc-stack (array Worker 12))
        collector (primitive/alloc-stack Collector)
        tasks (primitive/alloc-stack (array Task 14))
        (mut i) 0]
    (scheduler-init! scheduler)
    (set! (.orders producer) orders) (set! (.next producer) 1)
    (go scheduler (primitive/index tasks 0) produce producer)
    (loop (if (>= (load i) 12) (break)
              (do (set! (.orders (primitive/index workers (load i))) orders)
                  (set! (.completed (primitive/index workers (load i))) completed)
                  (set! (.value (primitive/index workers (load i))) 0)
                  (go scheduler (primitive/index tasks (+ (load i) 1)) work
                      (primitive/index workers (load i)))
                  (set! i (+ (load i) 1)))))
    (set! (.completed collector) completed) (set! (.value collector) 0)
    (set! (.count collector) 0) (set! (.total collector) 0)
    (go scheduler (primitive/index tasks 13) collect collector)
    (let [finished (scheduler-run! scheduler)
          parked (+ (+ (.send-parks orders) (.receive-parks orders))
                    (+ (.send-parks completed) (.receive-parks completed)))
          wakes (+ (.wakes orders) (.wakes completed))]
      (printf c"fulfilled=%ld total=%ld\n" (.count collector) (.total collector))
      (let [ok (and finished (and (= (.count collector) 20)
                  (and (= (.total collector) 2870)
                  (and (> parked 0) (and (> wakes 0) (= (.live scheduler) 0))))))]
        (channel-destroy! completed) (channel-destroy! orders)
        (if ok 0 1)))))
