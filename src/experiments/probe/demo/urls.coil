(module experiments.probe.demo.urls)
(import "coil.primitive" :as primitive)
(import "coil.slice" :use *)

;;; The host of a URL: what sits between `://` and the next `/` (or the end).
(defn url-host [(url (slice u8))] (-> (slice u8))
  (let [n (slice-len url)
        (mut start) 0
        (mut i) 0]
    (while (< (+ (load i) 2) n)
      (if (and (= (primitive/cast i64 (slice-get url (load i))) 58)
               (and (= (primitive/cast i64 (slice-get url (+ (load i) 1))) 47)
                    (and (= (primitive/cast i64 (slice-get url (+ (load i) 2)))
                            47)
                         (= (load start) 0))))
          (set! start (+ (load i) 3))
          0)
      (set! i (+ (load i) 1)))
    (let [(mut end) (load start)]
      (while (and (< (load end) n)
                  (!= (primitive/cast i64 (slice-get url (load end))) 47))
        (set! end (+ (load end) 1)))
      (subslice url (load start) (load end)))))
