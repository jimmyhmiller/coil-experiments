(module experiments.probe.demo.util)
(import "coil.primitive" :as primitive)

; Shared by the demo modules. `usleep` is declared once, here.
(extern usleep :cc c [u32] (-> i32))

;;; Sleep for `us` microseconds.
(defn nap-us [(us i64)] (-> i64)
  (primitive/cast i64 (usleep (primitive/cast u32 us))))
