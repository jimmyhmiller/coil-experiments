(module experiments.probe.demo.db)
(import "coil.primitive" :as primitive)

; A pretend database: each query takes as long as its text says it should.
(import "coil.slice" :use *)
(import "experiments.probe.demo.util" :as util)

;;; Run a query. Returns the number of rows.
(defn query [(sql (slice u8))] (-> i64)
  (let [n (slice-len sql)]
    ; Long statements are the slow ones.
    (util/nap-us (if (> n 40) 9000 (* n 40)))
    (% n 7)))

(defn load-user [(id i64)] (-> i64)
  (query "SELECT * FROM users WHERE id = ?"))

(defn load-report [(id i64)] (-> i64)
  (query "SELECT u.*, o.* FROM users u JOIN orders o ON o.user_id = u.id WHERE u.id = ? ORDER BY o.created_at"))
