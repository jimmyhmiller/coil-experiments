(module experiments.probe.demo.parser)

; A tiny recursive-descent arithmetic evaluator: expr := term (+|- term)*,
; term := factor (*|/ factor)*, factor := number | '(' expr ')'.
(import "coil.primitive" :as primitive)
(import "coil.slice" :use *)

(defstruct Cursor [(src (slice u8)) (pos i64)])

(defn peek [(c (ptr Cursor))] (-> i64)
  (if (< (.pos c) (slice-len (.src c)))
      (primitive/cast i64 (slice-get (.src c) (.pos c)))
      0))

(defn skip-spaces! [(c (ptr Cursor))] (-> i64)
  (do
    (while (= (peek c) 32) (set! (.pos c) (+ (.pos c) 1)))
    0))

(defn parse-factor [(c (ptr Cursor))] (-> i64)
  (do
    (skip-spaces! c)
    (if (= (peek c) 40)
        (do
          (set! (.pos c) (+ (.pos c) 1))
          (let [v (parse-expr c)]
            (skip-spaces! c)
            (set! (.pos c) (+ (.pos c) 1))
            v))
        (let [(mut v) 0]
          (while (and (>= (peek c) 48) (<= (peek c) 57))
            (set! v (+ (* (load v) 10) (- (peek c) 48)))
            (set! (.pos c) (+ (.pos c) 1)))
          (load v)))))

(defn parse-term [(c (ptr Cursor))] (-> i64)
  (let [(mut v) (parse-factor c)
        (mut going) true]
    (while (load going)
      (skip-spaces! c)
      (cond (= (peek c) 42)
              (do
                (set! (.pos c) (+ (.pos c) 1))
                (set! v (* (load v) (parse-factor c))))
            (= (peek c) 47)
              (do
                (set! (.pos c) (+ (.pos c) 1))
                (let [d (parse-factor c)]
                  (set! v (if (= d 0) 0 (/ (load v) d)))))
            :else (set! going false)))
    (load v)))

(defn parse-expr [(c (ptr Cursor))] (-> i64)
  (let [(mut v) (parse-term c)
        (mut going) true]
    (while (load going)
      (skip-spaces! c)
      (cond (= (peek c) 43)
              (do
                (set! (.pos c) (+ (.pos c) 1))
                (set! v (+ (load v) (parse-term c))))
            (= (peek c) 45)
              (do
                (set! (.pos c) (+ (.pos c) 1))
                (set! v (- (load v) (parse-term c))))
            :else (set! going false)))
    (load v)))

;;; Evaluate an arithmetic expression.
(defn evaluate [(src (slice u8))] (-> i64)
  (let [(mut c) (primitive/zeroed Cursor)]
    (set! (.src c) src)
    (parse-expr (mut c))))
