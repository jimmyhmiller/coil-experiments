(module experiments.probe.demo.server)
(import "coil.primitive" :as primitive)

; A pretend server: a request's life runs from accept-conn to send-response, which
; is not any one function's duration.
(import "experiments.probe.demo.util" :as util)
(import "experiments.probe.demo.db" :as db)
(import "experiments.probe.demo.cache" :as cache)

(defstruct Conn [(fd i64) (path (slice u8))])

(defn accept-conn [(conn Conn)] (-> i64)
  (do (util/nap-us 200) (.fd conn)))

(defn handle [(conn Conn)] (-> i64)
  (let [cached (cache/query (.path conn))]
    (if (>= cached 0)
        cached
        (if (= (% (.fd conn) 3) 0)
            (db/load-report (.fd conn))
            (db/load-user (.fd conn))))))

(defn send-response [(conn Conn) (status i64)] (-> i64)
  (do (util/nap-us 150) status))

;;; Serve `n` connections, two at a time, so spans for different keys overlap.
(defn serve [(n i64)] (-> i64)
  (let [(mut i) 0]
    (while (< (load i) n)
      (let [a (Conn :fd (+ 10 (load i)) :path "/users")
            b (Conn :fd (+ 11 (load i)) :path "/reports")]
        (accept-conn a)
        (accept-conn b)
        (handle a)
        (handle b)
        (send-response b 200)
        (send-response a (if (= (% (load i) 4) 0) 500 200)))
      (set! i (+ (load i) 2)))
    n))
