(module experiments.probe.demo.errors)
(import "coil.primitive" :as primitive)

; Functions that return a Result, some of which fail.
(defsum JobError
  (Timeout [(after-ms i64)])
  (Refused)
  (BadInput [(field (slice u8))]))

(defn validate [(n i64)] (-> (Result i64 JobError))
  (if (= (% n 5) 0) (Err (BadInput "quantity")) (Ok n)))

(defn submit [(n i64)] (-> (Result i64 JobError))
  (cond (= (% n 7) 0) (Err (Timeout (* n 100)))
        (= (% n 11) 0) (Err (Refused))
        :else (Ok (* n 2))))

;;; Not a Result: `call * /failed/` must leave this one alone.
(defn tally [(n i64)] (-> i64)
  (+ n 1))

(defn run-jobs [(count i64)] (-> i64)
  (let [(mut i) 1
        (mut ok) 0]
    (while (<= (load i) count)
      (match (validate (load i))
        (Ok [v]
            (match (submit v)
              (Ok [r] (set! ok (tally (load ok))))
              (Err [e] 0)))
        (Err [e] 0))
      (set! i (+ (load i) 1)))
    (load ok)))
