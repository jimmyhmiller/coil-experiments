(module experiments.probe.demo.main)

; The probe demo. It imports nothing probe-related (the one exception is gfx's
; hand-placed marks) and is built the same way with or without a probe:
;
;   coil run -- parse                                         # no probe
;   coil run --use experiments.probe.demo.stats -- parse      # with one
;
; argv[1] picks a scenario; `http` takes a base URL as argv[2].
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.io" :use *)
(import "experiments.probe.demo.util" :as util)
(import "experiments.probe.demo.parser" :as parser)
(import "experiments.probe.demo.db" :as db)
(import "experiments.probe.demo.gfx" :as gfx)
(import "experiments.probe.demo.server" :as server)
(import "experiments.probe.demo.files" :as files)
(import "experiments.probe.demo.net" :as net)
(import "experiments.probe.demo.errors" :as errors)

(defn run-parse [] (-> i64)
  (let [(mut i) 0
        (mut total) 0]
    (while (< (load i) 2000)
      (set! total
            (+ (load total)
               (parser/evaluate "1 + 2 * (3 + 4) - 10 / (2 + 3) * 7")))
      (set! i (+ (load i) 1)))
    (load total)))

(defn run-db [] (-> i64)
  (let [(mut i) 0]
    (while (< (load i) 12)
      (db/load-user (load i))
      (if (= (% (load i) 4) 0) (db/load-report (load i)) 0)
      (set! i (+ (load i) 1)))
    0))

;;; Renders for about three seconds, so an interval report has something to show
;;; long before the program ends.
(defn run-frames [] (-> i64)
  (let [(mut n) 0]
    (gfx/load-assets)
    (while (< (load n) 180)
      (gfx/render-frame (load n))
      (util/nap-us 12000)
      (set! n (+ (load n) 1)))
    (load n)))

(defn join [(a (dyn alloc/Allocator)) (base (slice u8)) (path (slice u8))] (-> (slice u8))
  (match (str-concat a base path) (None [] base) (Some [s] s)))

(defn run-http [(a (dyn alloc/Allocator)) (base (slice u8))] (-> i64)
  (do
    (println "GET  /hello   -> {d}" (net/get-status a (join a base "/hello")))
    (println "POST /echo    -> {d}"
             (net/post-echo a (join a base "/echo") "hello from coil"))
    (println "GET  /missing -> {d}" (net/get-status a (join a base "/missing")))
    (println "GET  /boom    -> {d}" (net/get-status a (join a base "/boom")))
    (println "GET  /hello streamed -> {d} bytes"
             (net/stream-count a (join a base "/hello")))
    (println "GET  refused  -> {d}"
             (net/get-status a "http://127.0.0.1:1/nope"))
    0))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [a (malloc-allocator)
        what
          (if (> (primitive/cast i64 argc) 1)
              (cstr->str (load (primitive/index argv 1)))
              "parse")]
    (cond (str-eq what "parse") (do (println "parsed: {d}" (run-parse)) 0)
          (str-eq what "db") (run-db)
          (str-eq what "frames") (do (println "frames: {d}" (run-frames)) 0)
          (str-eq what "server")
            (do (println "served: {d}" (server/serve 12)) 0)
          (str-eq what "files")
            (do
              (println "config bytes: {d}" (files/load-config a))
              (println "missing: {d}" (files/load-missing a))
              0)
          (str-eq what "http")
            (run-http a
                      (if (> (primitive/cast i64 argc) 2)
                          (cstr->str (load (primitive/index argv 2)))
                          "http://example.com"))
          (str-eq what "errors")
            (do (println "jobs ok: {d}" (errors/run-jobs 40)) 0)
          :else (do (println "unknown scenario") 1))))
