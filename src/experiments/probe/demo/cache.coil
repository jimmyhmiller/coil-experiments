(module experiments.probe.demo.cache)

; A pretend cache in front of the database. It has its own `query`, which is why a
; probe says `db/query`: a bare `query` would be ambiguous, and the engine says so.
(import "coil.primitive" :as primitive)
(import "coil.slice" :use *)

;;; Look a key up. Returns the cached row count, or -1 on a miss.
(defn query [(key (slice u8))] (-> i64)
  (if (= (% (slice-len key) 4) 0) 3 -1))
