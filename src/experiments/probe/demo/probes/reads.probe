# coil-module: experiments.probe.demo.reads
# 4. All file reads.
use files-points;

file-read {
  print("{site} {path} {bytes}b {elapsed}");
  sum bytes by path;
}
file-read /failed/ { print("{site} could not read {path}: {result.err}"); }

# Every open, including the ones buried inside the stdlib under read-file.
file-open { count by caller; print("open {path} from {module}/{caller}"); }
