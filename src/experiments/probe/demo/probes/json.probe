# coil-module: experiments.probe.demo.json
# JSON output: every line on the stream is one object — a print, a report, or a
# record — so a tool can consume it. `PROBE_JSON=1 ./app` does the same to any
# probe without touching its file.
report every 200ms as json;

call db/query {
  time by caller;
  count by caller, fn;
  print("{caller} ran a query in {elapsed}");
}
