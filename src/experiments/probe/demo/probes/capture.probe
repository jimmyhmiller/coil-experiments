# coil-module: experiments.probe.demo.capture
# 5. Capture all HTTP calls, entirely in the DSL. Each request is one JSON line,
# written the moment the call returns.
call coil.http.client/request {
  record {
    site, caller, wall, elapsed,
    method:   req.method,
    url:      req.url,
    sent:     req.headers,
    status:   result.ok.status,
    received: result.ok.headers,
    body:     result.ok.body[..64kb],
    error:    result.err
  } to "http.jsonl";
}
