# coil-module: experiments.probe.demo.http-errors
# 5b. Only the requests that went wrong.
use http;

# `module` is a compile-time fact, so the client library's own internal call sites
# are not instrumented at all: `request` is implemented on top of `request-stream`.
http /(failed or status >= 500) and not module in coil.http.client/ {
  print("{site} {method} {url} -> {status} {result.err}");
}
