(module experiments.probe.demo.files)
(import "coil.primitive" :as primitive)

; File reads, some direct and some buried under a helper.
(import "coil.alloc" :as alloc)
(import "coil.fs" :as fs)
(import "coil.slice" :use *)

(defn size-of [(a (dyn alloc/Allocator)) (path (slice u8))] (-> i64)
  (match (fs/read-file a path)
    (Ok [bytes] (slice-len bytes))
    (Err [e] -1)))

(defn load-config [(a (dyn alloc/Allocator))] (-> i64)
  (+ (size-of a "Coil.toml") (size-of a "lang.coil")))

(defn load-missing [(a (dyn alloc/Allocator))] (-> i64)
  (size-of a "no-such-file.txt"))
