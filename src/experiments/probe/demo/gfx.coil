(module experiments.probe.demo.gfx)
(import "coil.primitive" :as primitive)

; A pretend renderer, for profiling a span.
(import "experiments.probe.demo.util" :as util)
(import "experiments.probe.marks" :as probe)

(defn draw-sprites [(count i64)] (-> i64)
  (do (util/nap-us (* count 30)) count))

(defn draw-text [(lines i64)] (-> i64)
  (do (util/nap-us (* lines 80)) lines))

(defn decode-chunk [(size i64)] (-> i64)
  (do (util/nap-us (/ size 4)) size))

(defn present [] (-> i64)
  (util/nap-us 300))

;;; One frame. The decode is not its own function's whole body, so it is marked by
;;; hand; without a probe naming "decode" the mark compiles to `(decode-chunk …)`.
(defn render-frame [(n i64)] (-> i64)
  (do
    (draw-sprites (+ 20 (% n 7)))
    (draw-text (+ 3 (% n 3)))
    (probe/span "decode" (decode-chunk (* 512 (+ 1 (% n 4)))))
    (if (= (% n 10) 0) (probe/mark "vsync-miss" n) 0)
    (present)))

;;; Work that happens outside any frame; `during frame` must not see it.
(defn load-assets [] (-> i64)
  (draw-text 12))
