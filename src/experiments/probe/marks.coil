(module experiments.probe.marks)

; Static probe points you place by hand, for when the interesting region is not a
; function. Without a probe that names them they are an inlined identity and a
; constant: nothing is measured and nothing is kept. With one, the engine rewrites
; the call.
;
;   (import "experiments.probe.marks" :as probe)
;   (probe/span "decode" (decode-chunk buf))     ; mark "decode" { time; }
;   (probe/mark "cache-miss" key)                ; mark "cache-miss" { count by value; }

;;; Name the evaluation of `value` as a span. Yields `value`.
(defn span-region :inline (Always) [T] [(name (slice u8)) (value T)] (-> T)
  value)

;;; Name a moment, carrying `value`. Yields 0.
(defn mark-point :inline (Always) [T] [(name (slice u8)) (value T)] (-> i64)
  0)

(defn span [(name Code) (body Code)] (-> Code)
  `(experiments.probe.marks.span-region ~name ~body))

(defn mark [(name Code) (value Code)] (-> Code)
  `(experiments.probe.marks.mark-point ~name ~value))
