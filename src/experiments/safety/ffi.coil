(module experiments.safety.ffi)
(import "coil.alloc" :as alloc)
(import "coil.primitive" :as primitive)

(extern printf :cc c [(ptr i8) ...] (-> i32))

(const I64-MAX 9223372036854775807)

(defn ffi-trap [(message (ptr i8))] (-> i64)
  (printf c"safety trap: FFI contract violated: %s\n" message)
  (alloc/abort))

(defn checked-nonnull [T] [(data (ptr T))] (-> (ptr T))
  (if (= (primitive/cast i64 data) 0)
      (do (ffi-trap c"nonnull pointer was null") data)
      data))

(defn checked-buffer [T] [(data (ptr T)) (length i64)] (-> (ptr T))
  (if (< length 0)
      (do (ffi-trap c"buffer length was negative") data)
      (let [size (primitive/sizeof T)
            alignment (primitive/alignof T)
            address (primitive/cast i64 data)]
        (if (and (> length 0) (= address 0))
            (do (ffi-trap c"nonempty buffer had null data") data)
            (if (and (> alignment 1) (!= (% address alignment) 0))
                (do (ffi-trap c"buffer data was misaligned") data)
                (if (and (> size 0) (> length (/ I64-MAX size)))
                    (do (ffi-trap c"buffer byte size overflowed") data)
                    data))))))

(defn checked-count-bytes [T] [(count i64)] (-> i64)
  (if (< count 0)
      (ffi-trap c"element count was negative")
      (let [size (primitive/sizeof T)]
        (if (and (> size 0) (> count (/ I64-MAX size)))
            (ffi-trap c"element count times size overflowed")
            (* count size)))))

(defn checked-cstr-length [(data (ptr i8)) (maximum i64)] (-> i64)
  (checked-buffer data maximum)
  (let [(mut i) 0
        (mut found) -1]
    (loop (if (>= (load i) maximum)
              (break)
              (if (= (load (primitive/index data (load i))) 0)
                  (do (set! found (load i)) (break))
                  (set! i (+ (load i) 1)))))
    (if (>= (load found) 0)
        (load found)
        (ffi-trap c"C string had no terminator within its declared bound"))))

(defn checked-nonoverlap [(left (ptr i8))
                          (left-bytes i64)
                          (right (ptr i8))
                          (right-bytes i64)] (-> i64)
  (checked-buffer left left-bytes)
  (checked-buffer right right-bytes)
  (let [a (primitive/cast u64 left)
        b (primitive/cast u64 right)
        an (primitive/cast u64 left-bytes)
        bn (primitive/cast u64 right-bytes)]
    (if (or (and (<= a b) (< (- b a) an))
            (and (< b a) (< (- a b) bn)))
        (ffi-trap c"buffers overlap but the operation requires disjoint ranges")
        0)))
