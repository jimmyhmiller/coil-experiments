(module experiments.safety.demo)
(import "coil.primitive" :as primitive)
(import "experiments.safety.safety" :use *)

(extern printf :cc c [(ptr i8) ...] (-> i32))

(defn main [] (-> i64)
  (let [xs (primitive/alloc-stack (array i64 4))]
    (for [i 0 4]
      (set! (primitive/index xs i) (* i 10)))
    (printf c"xs[3] = %lld\n" (load (primitive/index xs 3)))
    0))
