(module experiments.safety.ffi-test)
(import "coil.assert" :use *)
(import "coil.primitive" :as primitive)
(import "experiments.safety.ffi" :use *)

(deftest valid-ffi-contracts
         (let [data (primitive/alloc-stack (array i64 4))]
           (assert-eq (primitive/cast i64 (checked-buffer data 4)) (primitive/cast i64 data))
           (assert-eq (checked-count-bytes [i64] 4) 32))
         (assert-eq (checked-cstr-length (primitive/cast (ptr i8) c"coil") 5) 4))
