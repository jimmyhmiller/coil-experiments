(module experiments.safety.unsafe)
(import "coil.mem" :as mem)
(import "coil.primitive" :as primitive)
(import "experiments.safety.runtime" :as runtime)

;; Explicit and searchable escape hatches. Their bodies live in this excluded
;; module, so the whole-program transform does not instrument the raw operation.
(defn unsafe [T] [(value T)] (-> T) value)

(defn unchecked-index [T] [(base (ptr T)) (index i64)] (-> (ptr T))
  (primitive/index base index))

(defn unchecked-load [T] [(address (ptr T))] (-> T)
  (load address))

(defn unchecked-store! [T] [(address (ptr T)) (value T)] (-> i64)
  (store! address value))

(defn allowzero-pointer [T] [(address i64)] (-> (ptr T))
  (primitive/cast (ptr T) address))

(defn unaligned-load [T] [(address (ptr i8))] (-> T)
  (let [out (primitive/alloc-stack T)]
    (mem/memcpy (primitive/cast (ptr i8) out) address (primitive/sizeof T))
    (load out)))

(defn unaligned-store! [T] [(address (ptr i8)) (value T)] (-> i64)
  (let [source (primitive/alloc-stack T)]
    (store! source value)
    (mem/memcpy address
                (primitive/cast (ptr i8) source)
                (primitive/sizeof T))
    0))

(defn truncating-i64-to-i8 [(value i64)] (-> i8)
  (primitive/cast i8 value))
(defn truncating-i64-to-u8 [(value i64)] (-> u8)
  (primitive/cast u8 value))
(defn truncating-i64-to-i16 [(value i64)] (-> i16)
  (primitive/cast i16 value))
(defn truncating-i64-to-u16 [(value i64)] (-> u16)
  (primitive/cast u16 value))
(defn truncating-i64-to-i32 [(value i64)] (-> i32)
  (primitive/cast i32 value))
(defn truncating-i64-to-u32 [(value i64)] (-> u32)
  (primitive/cast u32 value))
(defn truncating-u64-to-i8 [(value u64)] (-> i8)
  (primitive/cast i8 value))
(defn truncating-u64-to-u8 [(value u64)] (-> u8)
  (primitive/cast u8 value))
(defn truncating-u64-to-i16 [(value u64)] (-> i16)
  (primitive/cast i16 value))
(defn truncating-u64-to-u16 [(value u64)] (-> u16)
  (primitive/cast u16 value))
(defn truncating-u64-to-i32 [(value u64)] (-> i32)
  (primitive/cast i32 value))
(defn truncating-u64-to-u32 [(value u64)] (-> u32)
  (primitive/cast u32 value))

(defn unreachable [] (-> i64)
  (runtime/safety-abort c"reached unreachable code"))

;; Compatibility spelling retained for existing callers.
(defn safety-unreachable [] (-> i64)
  (unreachable))
