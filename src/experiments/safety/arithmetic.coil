(module experiments.safety.arithmetic)
(import "coil.alloc" :as alloc)
(import "coil.primitive" :as primitive)

(extern printf :cc c [(ptr i8) ...] (-> i32))

(const I64-MIN -9223372036854775808)
(const I64-MAX 9223372036854775807)

(defn arithmetic-trap [(operation (ptr i8))] (-> i64)
  (printf c"safety trap: integer %s overflow\n" operation)
  (alloc/abort))

(defn checked-neg-i64 [(value i64)] (-> i64)
  (if (= value I64-MIN) (arithmetic-trap c"negation") (- 0 value)))

(defn checked-abs-i64 [(value i64)] (-> i64)
  (if (< value 0) (checked-neg-i64 value) value))

(defn checked-range-signed [(value i64) (minimum i64) (maximum i64)] (-> i64)
  (if (or (< value minimum) (> value maximum))
      (arithmetic-trap c"conversion")
      value))

(defn checked-neg-signed [(value i64) (minimum i64)] (-> i64)
  (if (= value minimum) (arithmetic-trap c"negation") (- 0 value)))

(defn checked-abs-signed [(value i64) (minimum i64)] (-> i64)
  (if (< value 0) (checked-neg-signed value minimum) value))

(defn checked-add-i64 [(a i64) (b i64)] (-> i64)
  (if (or (and (> b 0) (> a (- I64-MAX b)))
          (and (< b 0) (< a (- I64-MIN b))))
      (arithmetic-trap c"addition")
      (+ a b)))

(defn checked-sub-i64 [(a i64) (b i64)] (-> i64)
  (if (or (and (> b 0) (< a (+ I64-MIN b)))
          (and (< b 0) (> a (+ I64-MAX b))))
      (arithmetic-trap c"subtraction")
      (- a b)))

(defn checked-mul-i64 [(a i64) (b i64)] (-> i64)
  (if (or (and (= a I64-MIN) (= b -1))
          (or (and (= b I64-MIN) (= a -1))
              (or (and (> a 0)
                       (or (and (> b 0) (> a (/ I64-MAX b)))
                           (and (< b 0) (< b (/ I64-MIN a)))))
                  (and (< a 0)
                       (or (and (> b 0) (< a (/ I64-MIN b)))
                           (and (< b 0) (< a (/ I64-MAX b))))))))
      (arithmetic-trap c"multiplication")
      (* a b)))

(defn checked-add-u64 [(a u64) (b u64)] (-> u64)
  (let [maximum (- (primitive/cast u64 0) (primitive/cast u64 1))]
    (if (> a (- maximum b))
        (primitive/cast u64 (arithmetic-trap c"addition"))
        (+ a b))))

(defn checked-sub-u64 [(a u64) (b u64)] (-> u64)
  (if (< a b)
      (primitive/cast u64 (arithmetic-trap c"subtraction"))
      (- a b)))

(defn checked-mul-u64 [(a u64) (b u64)] (-> u64)
  (let [maximum (- (primitive/cast u64 0) (primitive/cast u64 1))]
    (if (and (!= b (primitive/cast u64 0)) (> a (/ maximum b)))
        (primitive/cast u64 (arithmetic-trap c"multiplication"))
        (* a b))))

(defn checked-add-signed [(a i64) (b i64) (minimum i64) (maximum i64)] (-> i64)
  (checked-range-signed (checked-add-i64 a b) minimum maximum))
(defn checked-sub-signed [(a i64) (b i64) (minimum i64) (maximum i64)] (-> i64)
  (checked-range-signed (checked-sub-i64 a b) minimum maximum))
(defn checked-mul-signed [(a i64) (b i64) (minimum i64) (maximum i64)] (-> i64)
  (checked-range-signed (checked-mul-i64 a b) minimum maximum))

(defn checked-range-unsigned [(value u64) (maximum u64) (operation (ptr i8))] (-> u64)
  (if (> value maximum)
      (primitive/cast u64 (arithmetic-trap operation))
      value))

(defn checked-div-i64 [(a i64) (b i64)] (-> i64)
  (if (= b 0)
      (do (printf c"safety trap: division by zero\n") (alloc/abort))
      (if (and (= a I64-MIN) (= b -1)) (arithmetic-trap c"division") (/ a b))))

(defn checked-rem-i64 [(a i64) (b i64)] (-> i64)
  (if (= b 0)
      (do (printf c"safety trap: remainder by zero\n") (alloc/abort))
      (if (and (= a I64-MIN) (= b -1)) (arithmetic-trap c"remainder") (% a b))))

(defn checked-div-u64 [(a u64) (b u64)] (-> u64)
  (if (= b (primitive/cast u64 0))
      (do (printf c"safety trap: division by zero\n") (primitive/cast u64 (alloc/abort)))
      (/ a b)))

(defn checked-rem-u64 [(a u64) (b u64)] (-> u64)
  (if (= b (primitive/cast u64 0))
      (do (printf c"safety trap: remainder by zero\n") (primitive/cast u64 (alloc/abort)))
      (% a b)))

(defn wrapping-add-i64 [(a i64) (b i64)] (-> i64)
  (primitive/cast i64 (+ (primitive/cast u64 a) (primitive/cast u64 b))))

(defn wrapping-sub-i64 [(a i64) (b i64)] (-> i64)
  (primitive/cast i64 (- (primitive/cast u64 a) (primitive/cast u64 b))))

(defn wrapping-mul-i64 [(a i64) (b i64)] (-> i64)
  (primitive/cast i64 (* (primitive/cast u64 a) (primitive/cast u64 b))))

(defn saturating-add-i64 [(a i64) (b i64)] (-> i64)
  (if (and (> b 0) (> a (- I64-MAX b)))
      I64-MAX
      (if (and (< b 0) (< a (- I64-MIN b))) I64-MIN (+ a b))))

(defn saturating-sub-i64 [(a i64) (b i64)] (-> i64)
  (if (and (> b 0) (< a (+ I64-MIN b)))
      I64-MIN
      (if (and (< b 0) (> a (+ I64-MAX b))) I64-MAX (- a b))))

(defn exact-div-i64 [(a i64) (b i64)] (-> i64)
  (if (= b 0)
      (do
        (printf c"safety trap: exact division by zero\n")
        (alloc/abort))
      (if (and (= a I64-MIN) (= b -1))
          (arithmetic-trap c"division")
          (if (!= (% a b) 0)
              (do
                (printf c"safety trap: exact division has a remainder\n")
                (alloc/abort))
              (/ a b)))))

(defn checked-shl-signed [(value i64)
                          (amount i64)
                          (width i64)
                          (minimum i64)
                          (maximum i64)] (-> i64)
  (if (or (< amount 0) (>= amount width))
      (do
        (printf c"safety trap: invalid shift amount %lld\n" amount)
        (alloc/abort))
      (if (and (= width 64) (= amount 63))
          (if (or (= value 0) (= value -1))
              (<< value amount)
              (arithmetic-trap c"left shift"))
          (let [result
                  (checked-mul-i64 value
                                   (primitive/cast i64
                                                   (<< (primitive/cast u64 1)
                                                       (primitive/cast u64 amount))))]
            (if (or (< result minimum) (> result maximum))
                (arithmetic-trap c"left shift")
                result)))))

(defn checked-shr-signed [(value i64) (amount i64) (width i64)] (-> i64)
  (if (or (< amount 0) (>= amount width))
      (do
        (printf c"safety trap: invalid shift amount %lld\n" amount)
        (alloc/abort))
      (if (= amount 0)
          value
          (let [mask (- (<< (primitive/cast u64 1) (primitive/cast u64 amount)) 1)]
            (if (!= (primitive/iand (primitive/cast u64 value) mask)
                    (primitive/cast u64 0))
                (do
                  (printf c"safety trap: exact right shift discards nonzero bits\n")
                  (alloc/abort))
                (>> value amount))))))

(defn checked-shl-unsigned [(value u64)
                            (amount i64)
                            (width i64)
                            (maximum u64)] (-> u64)
  (if (or (< amount 0) (>= amount width))
      (do
        (printf c"safety trap: invalid shift amount %lld\n" amount)
        (primitive/cast u64 (alloc/abort)))
      (if (> value (>> maximum (primitive/cast u64 amount)))
          (do
            (arithmetic-trap c"left shift")
            (primitive/cast u64 0))
          (<< value (primitive/cast u64 amount)))))

(defn checked-shr-unsigned [(value u64) (amount i64) (width i64)] (-> u64)
  (if (or (< amount 0) (>= amount width))
      (do
        (printf c"safety trap: invalid shift amount %lld\n" amount)
        (primitive/cast u64 (alloc/abort)))
      (if (= amount 0)
          value
          (let [mask (- (<< (primitive/cast u64 1) (primitive/cast u64 amount)) 1)]
            (if (!= (primitive/iand value mask) (primitive/cast u64 0))
                (do
                  (printf c"safety trap: exact right shift discards nonzero bits\n")
                  (primitive/cast u64 (alloc/abort)))
                (>> value (primitive/cast u64 amount)))))))

(defn checked-shr-signed-normal [(value i64) (amount i64) (width i64)] (-> i64)
  (if (or (< amount 0) (>= amount width))
      (do
        (printf c"safety trap: invalid shift amount %lld\n" amount)
        (alloc/abort))
      (>> value amount)))

(defn checked-shr-unsigned-normal [(value u64) (amount i64) (width i64)] (-> u64)
  (if (or (< amount 0) (>= amount width))
      (do
        (printf c"safety trap: invalid shift amount %lld\n" amount)
        (primitive/cast u64 (alloc/abort)))
      (>> value (primitive/cast u64 amount))))

(defn exact-div-u64 [(a u64) (b u64)] (-> u64)
  (if (= b (primitive/cast u64 0))
      (do
        (printf c"safety trap: exact division by zero\n")
        (primitive/cast u64 (alloc/abort)))
      (if (!= (% a b) (primitive/cast u64 0))
          (do
            (printf c"safety trap: exact division has a remainder\n")
            (primitive/cast u64 (alloc/abort)))
          (/ a b))))

(defn checked-shl-i64 [(value i64) (amount i64)] (-> i64)
  (checked-shl-signed value amount 64 I64-MIN I64-MAX))
(defn checked-shr-i64 [(value i64) (amount i64)] (-> i64)
  (checked-shr-signed value amount 64))
(defn checked-shl-u64 [(value u64) (amount i64)] (-> u64)
  (checked-shl-unsigned value amount 64 (- (primitive/cast u64 0) (primitive/cast u64 1))))
(defn checked-shr-u64 [(value u64) (amount i64)] (-> u64)
  (checked-shr-unsigned value amount 64))

(defn exact-div-i8 [(a i8) (b i8)] (-> i8)
  (primitive/cast i8
                  (checked-range-signed (exact-div-i64 (primitive/cast i64 a) (primitive/cast i64 b))
                                        -128
                                        127)))
(defn exact-div-i16 [(a i16) (b i16)] (-> i16)
  (primitive/cast i16
                  (checked-range-signed (exact-div-i64 (primitive/cast i64 a) (primitive/cast i64 b))
                                        -32768
                                        32767)))
(defn exact-div-i32 [(a i32) (b i32)] (-> i32)
  (primitive/cast i32
                  (checked-range-signed (exact-div-i64 (primitive/cast i64 a) (primitive/cast i64 b))
                                        -2147483648
                                        2147483647)))
(defn exact-div-u8 [(a u8) (b u8)] (-> u8)
  (primitive/cast u8 (exact-div-u64 (primitive/cast u64 a) (primitive/cast u64 b))))
(defn exact-div-u16 [(a u16) (b u16)] (-> u16)
  (primitive/cast u16 (exact-div-u64 (primitive/cast u64 a) (primitive/cast u64 b))))
(defn exact-div-u32 [(a u32) (b u32)] (-> u32)
  (primitive/cast u32 (exact-div-u64 (primitive/cast u64 a) (primitive/cast u64 b))))

(defn checked-shl-i8 [(value i8) (amount i64)] (-> i8)
  (primitive/cast i8 (checked-shl-signed (primitive/cast i64 value) amount 8 -128 127)))
(defn checked-shl-i16 [(value i16) (amount i64)] (-> i16)
  (primitive/cast i16 (checked-shl-signed (primitive/cast i64 value) amount 16 -32768 32767)))
(defn checked-shl-i32 [(value i32) (amount i64)] (-> i32)
  (primitive/cast i32
                  (checked-shl-signed (primitive/cast i64 value) amount 32 -2147483648 2147483647)))
(defn checked-shr-i8 [(value i8) (amount i64)] (-> i8)
  (primitive/cast i8 (checked-shr-signed (primitive/cast i64 value) amount 8)))
(defn checked-shr-i16 [(value i16) (amount i64)] (-> i16)
  (primitive/cast i16 (checked-shr-signed (primitive/cast i64 value) amount 16)))
(defn checked-shr-i32 [(value i32) (amount i64)] (-> i32)
  (primitive/cast i32 (checked-shr-signed (primitive/cast i64 value) amount 32)))

(defn checked-shl-u8 [(value u8) (amount i64)] (-> u8)
  (primitive/cast u8 (checked-shl-unsigned (primitive/cast u64 value) amount 8 255)))
(defn checked-shl-u16 [(value u16) (amount i64)] (-> u16)
  (primitive/cast u16 (checked-shl-unsigned (primitive/cast u64 value) amount 16 65535)))
(defn checked-shl-u32 [(value u32) (amount i64)] (-> u32)
  (primitive/cast u32 (checked-shl-unsigned (primitive/cast u64 value) amount 32 4294967295)))
(defn checked-shr-u8 [(value u8) (amount i64)] (-> u8)
  (primitive/cast u8 (checked-shr-unsigned (primitive/cast u64 value) amount 8)))
(defn checked-shr-u16 [(value u16) (amount i64)] (-> u16)
  (primitive/cast u16 (checked-shr-unsigned (primitive/cast u64 value) amount 16)))
(defn checked-shr-u32 [(value u32) (amount i64)] (-> u32)
  (primitive/cast u32 (checked-shr-unsigned (primitive/cast u64 value) amount 32)))

(defn checked-neg-i8 [(value i8)] (-> i8)
  (primitive/cast i8 (checked-neg-signed (primitive/cast i64 value) -128)))
(defn checked-neg-i16 [(value i16)] (-> i16)
  (primitive/cast i16 (checked-neg-signed (primitive/cast i64 value) -32768)))
(defn checked-neg-i32 [(value i32)] (-> i32)
  (primitive/cast i32 (checked-neg-signed (primitive/cast i64 value) -2147483648)))
(defn checked-abs-i8 [(value i8)] (-> i8)
  (primitive/cast i8 (checked-abs-signed (primitive/cast i64 value) -128)))
(defn checked-abs-i16 [(value i16)] (-> i16)
  (primitive/cast i16 (checked-abs-signed (primitive/cast i64 value) -32768)))
(defn checked-abs-i32 [(value i32)] (-> i32)
  (primitive/cast i32 (checked-abs-signed (primitive/cast i64 value) -2147483648)))

;; Standard-width entry points used by the whole-program operator rewrite.
(defn checked-add-i8 [(a i8) (b i8)] (-> i8)
  (primitive/cast i8 (checked-add-signed (primitive/cast i64 a) (primitive/cast i64 b) -128 127)))
(defn checked-add-i16 [(a i16) (b i16)] (-> i16)
  (primitive/cast i16 (checked-add-signed (primitive/cast i64 a) (primitive/cast i64 b) -32768 32767)))
(defn checked-add-i32 [(a i32) (b i32)] (-> i32)
  (primitive/cast i32 (checked-add-signed (primitive/cast i64 a) (primitive/cast i64 b) -2147483648 2147483647)))
(defn checked-sub-i8 [(a i8) (b i8)] (-> i8)
  (primitive/cast i8 (checked-sub-signed (primitive/cast i64 a) (primitive/cast i64 b) -128 127)))
(defn checked-sub-i16 [(a i16) (b i16)] (-> i16)
  (primitive/cast i16 (checked-sub-signed (primitive/cast i64 a) (primitive/cast i64 b) -32768 32767)))
(defn checked-sub-i32 [(a i32) (b i32)] (-> i32)
  (primitive/cast i32 (checked-sub-signed (primitive/cast i64 a) (primitive/cast i64 b) -2147483648 2147483647)))
(defn checked-mul-i8 [(a i8) (b i8)] (-> i8)
  (primitive/cast i8 (checked-mul-signed (primitive/cast i64 a) (primitive/cast i64 b) -128 127)))
(defn checked-mul-i16 [(a i16) (b i16)] (-> i16)
  (primitive/cast i16 (checked-mul-signed (primitive/cast i64 a) (primitive/cast i64 b) -32768 32767)))
(defn checked-mul-i32 [(a i32) (b i32)] (-> i32)
  (primitive/cast i32 (checked-mul-signed (primitive/cast i64 a) (primitive/cast i64 b) -2147483648 2147483647)))

(defn checked-add-u8 [(a u8) (b u8)] (-> u8)
  (primitive/cast u8
                  (checked-range-unsigned (checked-add-u64 (primitive/cast u64 a) (primitive/cast u64 b))
                                          255
                                          c"addition")))
(defn checked-add-u16 [(a u16) (b u16)] (-> u16)
  (primitive/cast u16
                  (checked-range-unsigned (checked-add-u64 (primitive/cast u64 a) (primitive/cast u64 b))
                                          65535
                                          c"addition")))
(defn checked-add-u32 [(a u32) (b u32)] (-> u32)
  (primitive/cast u32
                  (checked-range-unsigned (checked-add-u64 (primitive/cast u64 a) (primitive/cast u64 b))
                                          4294967295
                                          c"addition")))
(defn checked-sub-u8 [(a u8) (b u8)] (-> u8)
  (primitive/cast u8 (checked-sub-u64 (primitive/cast u64 a) (primitive/cast u64 b))))
(defn checked-sub-u16 [(a u16) (b u16)] (-> u16)
  (primitive/cast u16 (checked-sub-u64 (primitive/cast u64 a) (primitive/cast u64 b))))
(defn checked-sub-u32 [(a u32) (b u32)] (-> u32)
  (primitive/cast u32 (checked-sub-u64 (primitive/cast u64 a) (primitive/cast u64 b))))
(defn checked-mul-u8 [(a u8) (b u8)] (-> u8)
  (primitive/cast u8
                  (checked-range-unsigned (checked-mul-u64 (primitive/cast u64 a) (primitive/cast u64 b))
                                          255
                                          c"multiplication")))
(defn checked-mul-u16 [(a u16) (b u16)] (-> u16)
  (primitive/cast u16
                  (checked-range-unsigned (checked-mul-u64 (primitive/cast u64 a) (primitive/cast u64 b))
                                          65535
                                          c"multiplication")))
(defn checked-mul-u32 [(a u32) (b u32)] (-> u32)
  (primitive/cast u32
                  (checked-range-unsigned (checked-mul-u64 (primitive/cast u64 a) (primitive/cast u64 b))
                                          4294967295
                                          c"multiplication")))

(defn checked-div-i8 [(a i8) (b i8)] (-> i8)
  (primitive/cast i8 (checked-range-signed (checked-div-i64 (primitive/cast i64 a) (primitive/cast i64 b)) -128 127)))
(defn checked-div-i16 [(a i16) (b i16)] (-> i16)
  (primitive/cast i16
                  (checked-range-signed (checked-div-i64 (primitive/cast i64 a) (primitive/cast i64 b)) -32768 32767)))
(defn checked-div-i32 [(a i32) (b i32)] (-> i32)
  (primitive/cast i32
                  (checked-range-signed (checked-div-i64 (primitive/cast i64 a) (primitive/cast i64 b))
                                        -2147483648
                                        2147483647)))
(defn checked-rem-i8 [(a i8) (b i8)] (-> i8)
  (primitive/cast i8 (checked-rem-i64 (primitive/cast i64 a) (primitive/cast i64 b))))
(defn checked-rem-i16 [(a i16) (b i16)] (-> i16)
  (primitive/cast i16 (checked-rem-i64 (primitive/cast i64 a) (primitive/cast i64 b))))
(defn checked-rem-i32 [(a i32) (b i32)] (-> i32)
  (primitive/cast i32 (checked-rem-i64 (primitive/cast i64 a) (primitive/cast i64 b))))

(defn checked-div-u8 [(a u8) (b u8)] (-> u8)
  (primitive/cast u8 (checked-div-u64 (primitive/cast u64 a) (primitive/cast u64 b))))
(defn checked-div-u16 [(a u16) (b u16)] (-> u16)
  (primitive/cast u16 (checked-div-u64 (primitive/cast u64 a) (primitive/cast u64 b))))
(defn checked-div-u32 [(a u32) (b u32)] (-> u32)
  (primitive/cast u32 (checked-div-u64 (primitive/cast u64 a) (primitive/cast u64 b))))
(defn checked-rem-u8 [(a u8) (b u8)] (-> u8)
  (primitive/cast u8 (checked-rem-u64 (primitive/cast u64 a) (primitive/cast u64 b))))
(defn checked-rem-u16 [(a u16) (b u16)] (-> u16)
  (primitive/cast u16 (checked-rem-u64 (primitive/cast u64 a) (primitive/cast u64 b))))
(defn checked-rem-u32 [(a u32) (b u32)] (-> u32)
  (primitive/cast u32 (checked-rem-u64 (primitive/cast u64 a) (primitive/cast u64 b))))

(defn checked-shift-right-i8 [(value i8) (amount i64)] (-> i8)
  (primitive/cast i8 (checked-shr-signed-normal (primitive/cast i64 value) amount 8)))
(defn checked-shift-right-i16 [(value i16) (amount i64)] (-> i16)
  (primitive/cast i16 (checked-shr-signed-normal (primitive/cast i64 value) amount 16)))
(defn checked-shift-right-i32 [(value i32) (amount i64)] (-> i32)
  (primitive/cast i32 (checked-shr-signed-normal (primitive/cast i64 value) amount 32)))
(defn checked-shift-right-i64 [(value i64) (amount i64)] (-> i64)
  (checked-shr-signed-normal value amount 64))
(defn checked-shift-right-u8 [(value u8) (amount i64)] (-> u8)
  (primitive/cast u8 (checked-shr-unsigned-normal (primitive/cast u64 value) amount 8)))
(defn checked-shift-right-u16 [(value u16) (amount i64)] (-> u16)
  (primitive/cast u16 (checked-shr-unsigned-normal (primitive/cast u64 value) amount 16)))
(defn checked-shift-right-u32 [(value u32) (amount i64)] (-> u32)
  (primitive/cast u32 (checked-shr-unsigned-normal (primitive/cast u64 value) amount 32)))
(defn checked-shift-right-u64 [(value u64) (amount i64)] (-> u64)
  (checked-shr-unsigned-normal value amount 64))
