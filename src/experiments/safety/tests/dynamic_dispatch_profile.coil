(module experiments.safety.tests.dynamic-dispatch-profile)
(import "coil.primitive" :as primitive)
(import "experiments.safety.safety" :use *)

(deftrait Value [Self]
  (value [(self (ptr Self))] (-> i64)))

(defstruct BoxedValue [(contents i64)])

(impl Value BoxedValue
  (value [(self (ptr BoxedValue))]
         (-> i64)
         (load (field self contents))))

(defn read-value [(item (dyn Value))] (-> i64)
  (value item))

(defn main [] (-> i64)
  (let [item (primitive/alloc-stack BoxedValue)]
    (store! (field item contents) 42)
    (- (read-value item) 42)))
