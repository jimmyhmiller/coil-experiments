(module experiments.safety.tests.ffi-unterminated-trap)
(import "coil.primitive" :as primitive)
(import "experiments.safety.ffi" :use *)

(defn main [] (-> i64)
  (let [data (primitive/alloc-stack (array i8 3))]
    (set! (primitive/index data 0) 65)
    (set! (primitive/index data 1) 66)
    (set! (primitive/index data 2) 67)
    (checked-cstr-length (primitive/index data 0) 3)))
