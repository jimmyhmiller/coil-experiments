(module experiments.safety.tests.volatile-store-alignment-trap)
(import "coil.primitive" :as primitive)
(import "experiments.safety.safety" :use *)

(defn main [] (-> i64)
  (let [bytes (primitive/alloc-stack (array u8 16))]
    (primitive/volatile-store!
      (primitive/cast (ptr i64) (primitive/index bytes 1))
      42)))
