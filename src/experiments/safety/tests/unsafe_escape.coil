(module experiments.safety.tests.unsafe-escape)
(import "coil.primitive" :as primitive)
(import "experiments.safety.safety" :use *)
(import "experiments.safety.unsafe" :use [unsafe])

(defn main [] (-> i64)
  (let [slot (primitive/alloc-stack i64)
        heap (primitive/alloc-heap i64)]
    (unsafe (primitive/alias-store! slot 42))
    (store! heap 1)
    (unsafe (primitive/free heap))
    (unsafe (primitive/llvm-ir i64 [] "ret i64 0"))
    (unsafe (primitive/cast i64 (primitive/index (primitive/cast (ptr i64) 8) 1)))
    (unsafe (primitive/cast i64 (primitive/cast u5 7)))
    (unsafe (primitive/cast i64 (primitive/cast (ptr i64) 0)))
    (- (unsafe (primitive/alias-load i64 slot)) 42)))
