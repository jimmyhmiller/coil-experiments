(module experiments.safety.tests.debug-subslice-trap)
(import "coil.primitive" :as primitive)
(import "coil.slice" :use *)
(import "experiments.safety.safety" :use *)

(defn main [] (-> i64)
  (let [xs (primitive/alloc-stack (array i64 2))
        s (slice-of xs 2)]
    (slice-len (subslice s 2 1))))
