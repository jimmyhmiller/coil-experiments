(module experiments.safety.tests.volatile-alignment-trap)
(import "coil.primitive" :as primitive)
(import "experiments.safety.safety" :use *)

(defn main [] (-> i64)
  (let [bytes (primitive/alloc-stack (array u8 16))]
    (primitive/cast i64
      (primitive/volatile-load i64
        (primitive/cast (ptr i64) (primitive/index bytes 1))))))
