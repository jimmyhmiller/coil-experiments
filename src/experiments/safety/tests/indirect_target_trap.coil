(module experiments.safety.tests.indirect-target-trap)
(import "coil.primitive" :as primitive)
(import "experiments.safety.safety" :use *)

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (primitive/call-ptr (primitive/cast (fnptr c [i64] i64)
                                      (primitive/cast (ptr i8) (primitive/cast i64 (+ argc 1))))
                      42))
