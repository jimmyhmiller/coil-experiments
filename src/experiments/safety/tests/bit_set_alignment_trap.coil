(module experiments.safety.tests.bit-set-alignment-trap)
(import "coil.primitive" :as primitive)
(import "experiments.safety.safety" :use *)
(import "experiments.safety.unsafe" :use [unsafe])

(defstruct Bits :layout bits :backing i16 [(value :bits 16)])

(defn main [] (-> i64)
  (let [bytes (primitive/alloc-stack (array u8 16))
        p (primitive/cast (ptr Bits) (primitive/index bytes 1))]
    (primitive/cast i64
      (primitive/bit-set! p value (unsafe (primitive/cast u16 42))))))
