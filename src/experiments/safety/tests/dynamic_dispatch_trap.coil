(module experiments.safety.tests.dynamic-dispatch-trap)
(import "coil.primitive" :as primitive)
(import "experiments.safety.safety" :use *)
(import "experiments.safety.unsafe" :use [unsafe])

(deftrait Value [Self]
  (value [(self (ptr Self))] (-> i64)))

(defn read-value [(item (dyn Value))] (-> i64)
  (value item))

(defn main [] (-> i64)
  (read-value (unsafe (primitive/zeroed (dyn Value)))))
