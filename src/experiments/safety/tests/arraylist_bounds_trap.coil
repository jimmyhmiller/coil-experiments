(module experiments.safety.tests.arraylist-bounds-trap)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [al-get al-new al-push!])
(import "experiments.safety.safety" :use *)

(defn main [] (-> i64)
  (let [(mut items) (al-new [i64] (malloc-allocator))]
    (al-push! [i64] (mut items) 42)
    (al-get [i64] (load items) 1)))
