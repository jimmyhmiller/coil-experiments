(module experiments.safety.sums)
(import "coil.primitive" :as primitive)
(import "coil.result" :use *)
(import "experiments.safety.runtime" :as runtime)

;;; The zeroed expression is statically unreachable because safety-abort terminates
;;; the process. It exists only because Coil currently has no `noreturn` type with
;;; which to type the failure arm of a generic match.
(defn expect-some [T] [(o (Option T))] (-> T)
  (match o
    (Some [value] value)
    (None []
          (do
            (runtime/safety-abort c"attempted to unwrap None")
            (primitive/zeroed T)))))

(defn expect-ok [T E] [(r (Result T E))] (-> T)
  (match r
    (Ok [value] value)
    (Err [_]
         (do
           (runtime/safety-abort c"attempted to unwrap Err as Ok")
           (primitive/zeroed T)))))

(defn expect-err [T E] [(r (Result T E))] (-> E)
  (match r
    (Err [error] error)
    (Ok [_]
        (do
          (runtime/safety-abort c"attempted to unwrap Ok as Err")
          (primitive/zeroed E)))))
