(module experiments.safety.unsafe-test)
(import "coil.assert" :use *)
(import "coil.primitive" :as primitive)
(import "experiments.safety.unsafe" :use *)

(deftest explicit-allowzero-pointer
         (assert-eq (primitive/cast i64 (allowzero-pointer [i64] 0)) 0))

(deftest explicit-unaligned-access
         (let [bytes (primitive/alloc-stack (array i8 16))
               address (primitive/index bytes 1)]
           (unaligned-store! [i64] address 42)
           (assert-eq (unaligned-load [i64] address) 42)))
