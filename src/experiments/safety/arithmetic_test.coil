(module experiments.safety.arithmetic-test)
(import "coil.assert" :use *)
(import "experiments.safety.arithmetic" :use *)

(deftest checked-arithmetic
         (assert-eq (checked-add-i64 20 22) 42)
         (assert-eq (checked-sub-i64 50 8) 42)
         (assert-eq (checked-mul-i64 6 7) 42)
         (assert-eq (exact-div-i64 84 2) 42)
         (assert-eq (checked-shl-i64 21 1) 42)
         (assert-eq (checked-shr-i64 84 1) 42))

(deftest checked-standard-width-arithmetic
         (assert-eq (exact-div-i8 84 2) 42)
         (assert-eq (exact-div-i16 84 2) 42)
         (assert-eq (exact-div-i32 84 2) 42)
         (assert-eq (exact-div-u8 84 2) 42)
         (assert-eq (exact-div-u16 84 2) 42)
         (assert-eq (exact-div-u32 84 2) 42)
         (assert-eq (exact-div-u64 84 2) 42)
         (assert-eq (checked-shl-i8 21 1) 42)
         (assert-eq (checked-shl-i16 21 1) 42)
         (assert-eq (checked-shl-i32 21 1) 42)
         (assert-eq (checked-shl-u8 21 1) 42)
         (assert-eq (checked-shl-u16 21 1) 42)
         (assert-eq (checked-shl-u32 21 1) 42)
         (assert-eq (checked-shl-u64 21 1) 42)
         (assert-eq (checked-shr-i8 84 1) 42)
         (assert-eq (checked-shr-i16 84 1) 42)
         (assert-eq (checked-shr-i32 84 1) 42)
         (assert-eq (checked-shr-u8 84 1) 42)
         (assert-eq (checked-shr-u16 84 1) 42)
         (assert-eq (checked-shr-u32 84 1) 42)
         (assert-eq (checked-shr-u64 84 1) 42)
         (assert-eq (checked-neg-i8 -42) 42)
         (assert-eq (checked-neg-i16 -42) 42)
         (assert-eq (checked-neg-i32 -42) 42)
         (assert-eq (checked-neg-i64 -42) 42)
         (assert-eq (checked-abs-i8 -42) 42)
         (assert-eq (checked-abs-i16 -42) 42)
         (assert-eq (checked-abs-i32 -42) 42)
         (assert-eq (checked-abs-i64 -42) 42))

(deftest wrapping-arithmetic
         (assert-eq (wrapping-add-i64 9223372036854775807 1) -9223372036854775808)
         (assert-eq (wrapping-sub-i64 -9223372036854775808 1) 9223372036854775807))

(deftest saturating-arithmetic
         (assert-eq (saturating-add-i64 9223372036854775807 1) 9223372036854775807)
         (assert-eq (saturating-add-i64 -9223372036854775808 -1) -9223372036854775808)
         (assert-eq (saturating-sub-i64 -9223372036854775808 1) -9223372036854775808)
         (assert-eq (saturating-sub-i64 9223372036854775807 -1) 9223372036854775807))
