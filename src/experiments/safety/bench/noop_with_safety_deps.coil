(module experiments.safety.bench.noop-with-safety-deps)
(import "experiments.safety.arithmetic" :use *)
(import "experiments.safety.runtime" :use *)
(import "experiments.safety.unsafe" :use *)

(defn noop-with-safety-deps-transform [(modules Code)] (-> Code) `(do ~@modules))

(transform noop-with-safety-deps-transform)
