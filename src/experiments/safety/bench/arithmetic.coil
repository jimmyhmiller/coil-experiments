(module experiments.safety.bench.arithmetic)
(import "coil.primitive" :as primitive)

(extern printf :cc c [(ptr i8) ...] (-> i32))

;;; Checked integer arithmetic without memory traffic dominating the result.
(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [(mut i) 0
        (mut state) (+ 1 (primitive/cast i64 argc))
        (mut checksum) 0]
    (loop (if (>= (load i) 200000000)
              (break)
              (do
                (set! state (% (+ (* (load state) 48271) 1) 2147483647))
                (set! checksum (% (+ (load checksum) (load state)) 1000000007))
                (set! i (+ (load i) 1)))))
    (printf c"%ld\n" (load checksum))
    0))
