(module experiments.safety.bench.dynamic-dispatch)
(import "coil.primitive" :as primitive)

(extern printf :cc c [(ptr i8) ...] (-> i32))

(deftrait Value [Self]
  (value [(self (ptr Self))] (-> i64)))

(defstruct Box [(contents i64)])

(impl Value Box
  (value [(self (ptr Box))] (-> i64)
    (load (field self contents))))

(defn read-value [(item (dyn Value))] (-> i64)
  (value item))

;; Dynamic object validation is intentionally exercised on every call boundary.
(defn main [] (-> i64)
  (let [box (primitive/alloc-stack Box)
        (mut i) 0
        (mut checksum) 0]
    (store! (field box contents) 7)
    (loop (if (>= (load i) 1000000)
              (break)
              (do
                (set! checksum (+ (load checksum) (read-value box)))
                (set! i (+ (load i) 1)))))
    (printf c"%ld\n" (load checksum))
    0))
