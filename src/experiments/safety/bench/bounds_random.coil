(module experiments.safety.bench.bounds-random)
(import "coil.primitive" :as primitive)

(extern printf :cc c [(ptr i8) ...] (-> i32))

;;; Data-dependent fixed-array access. The optimizer cannot remove the safety
;;; check by proving a simple induction-variable bound.
(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [values (primitive/alloc-stack (array i64 4096))
        (mut i) 0
        (mut state) (+ 1 (primitive/cast i64 argc))
        (mut checksum) 0]
    (loop (if (>= (load i) 4096)
              (break)
              (do
                (store! (primitive/index values (load i)) (% (load i) 251))
                (set! i (+ (load i) 1)))))
    (set! i 0)
    (loop (if (>= (load i) 100000000)
              (break)
              (do
                (set! state (% (+ (* (load state) 48271) 1) 2147483647))
                (let [at (% (load state) 4096)
                      p (primitive/index values at)
                      value (load p)]
                  (set! checksum (+ (load checksum) value))
                  (store! p (% (+ value 1) 251)))
                (set! i (+ (load i) 1)))))
    (printf c"%ld\n" (load checksum))
    0))
