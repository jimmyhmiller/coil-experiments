(module experiments.safety.dialect-test)
(import "coil.assert" :use *)
(import "coil.primitive" :as primitive)
(import "experiments.safety.safety" :use *)

(defn twice [(value i64)] (-> i64)
  (* value 2))

(deftest ordinary-operators-are-rewritten
         (assert-eq (+ (primitive/cast i8 20) (primitive/cast i8 22)) (primitive/cast i8 42))
         (assert-eq (- (primitive/cast u8 50) (primitive/cast u8 8)) (primitive/cast u8 42))
         (assert-eq (* (primitive/cast i16 6) (primitive/cast i16 7)) (primitive/cast i16 42))
         (assert-eq (/ (primitive/cast u32 84) (primitive/cast u32 2)) (primitive/cast u32 42))
         (assert-eq (% (primitive/cast i64 85) (primitive/cast i64 43)) 42)
         (assert-eq (<< (primitive/cast u8 21) (primitive/cast u8 1)) (primitive/cast u8 42))
         (assert-eq (>> (primitive/cast i64 3) (primitive/cast i64 1)) 1)
         (assert-eq (- 0 (primitive/cast i32 -42)) (primitive/cast i32 42))
         (assert-eq (primitive/iadd 20 22) 42)
         (assert-eq (primitive/isub 50 8) 42)
         (assert-eq (primitive/imul 6 7) 42)
         (assert-eq (primitive/idiv 84 2) 42)
         (assert-eq (primitive/irem 85 43) 42)
         (assert-eq (primitive/udiv (primitive/cast u64 84) (primitive/cast u64 2))
                    (primitive/cast u64 42))
         (assert-eq (primitive/urem (primitive/cast u64 85) (primitive/cast u64 43))
                    (primitive/cast u64 42))
         (assert-eq (primitive/ishl (primitive/cast u8 21) 1) (primitive/cast u8 42))
         (assert-eq (primitive/ishr (primitive/cast u64 84) 1) (primitive/cast u64 42))
         (assert-eq (primitive/call-ptr (primitive/fnptr-of twice) 21) 42))
