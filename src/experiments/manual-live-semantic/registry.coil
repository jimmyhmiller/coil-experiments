(module experiments.manual-live-semantic.registry)

(import "coil.primitive" :as primitive)
(import "experiments.manual-live.runtime" :as live)
(import "experiments.manual-live.semantic-policy"
  :use [semantic-function! semantic-type! semantic-autowire!])

(defstruct SemanticNode [(value i64)])

(defn semantic-value [(node (ptr SemanticNode))] (-> i64) (.value node))
(defn semantic-total [(node (ptr SemanticNode))] (-> i64)
  (+ (semantic-value node) 1))

(defn register-semantic! [(rt (ptr live/Runtime))] (-> i64)
  (semantic-type! rt 1 (primitive/sizeof SemanticNode))
  (semantic-function! rt 2
    (primitive/cast (ptr i8) (primitive/fnptr-of semantic-value)))
  (semantic-function! rt 3
    (primitive/cast (ptr i8) (primitive/fnptr-of semantic-total)))
  (semantic-autowire! rt))
