(module experiments.manual-live-semantic.main)

(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "experiments.manual-live.runtime" :as live)
(import "experiments.manual-live-semantic.registry" :as registry)

(defn main [] (-> i64)
  (let [a (alloc/malloc-allocator)
        rt (primitive/alloc-stack live/Runtime)
        marks (primitive/alloc-stack (array bool 64))]
    (live/runtime-init! rt a)
    (registry/register-semantic! rt)
    (cond (!= (.dependency-count rt) 3) 1
          (!= (live/dependency-closure! rt 1 marks) 3) 2
          :else (do (live/runtime-destroy! rt) 0))))
