(module experiments.live-repl.main)

;;; The standalone nREPL server:
;;;
;;;     coil build src/experiments/live-repl/main.coil -o build/coil-live-nrepl
;;;
;;; It lives apart from experiments.live-repl.server so a program can embed the
;;; server (experiments.live.host does) without also inheriting this `main`.
(import "experiments.heap-inspector.controller" :as controller)
(import "experiments.live-repl.server" :as server)

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (controller/live-controller-init!)
  (server/serve!))
