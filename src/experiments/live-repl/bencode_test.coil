(module experiments.live-repl.bencode-test)

(import "coil.alloc" :as alloc)
(import "coil.assert" :use *)
(import "coil.primitive" :as primitive)
(import "coil.slice" :use [slice-len])
(import "experiments.live-repl.bencode" :use *)

(deftest decodes-a-complete-nrepl-request
  (let [input "d4:code7:(+ 1 2)2:id2:422:ns4:user2:op4:evale"
        request (primitive/alloc-stack Request)
        consumed (bdecode-request input request)]
    (assert-eq consumed (slice-len input))
    (assert-eq (.op request) "eval")
    (assert-eq (.id request) "42")
    (assert-eq (.ns request) "user")
    (assert-eq (.code request) "(+ 1 2)")))

(deftest distinguishes-incomplete-and-malformed-input
  (let [request (primitive/alloc-stack Request)]
    (assert-eq (bdecode-request "d2:op4:eval" request) 0)
    (assert-eq (bdecode-request "x2:op4:evale" request) -1)))

(deftest emits-nrepl-dictionaries-and-status-lists
  (let [a (alloc/malloc-allocator)
        response (primitive/alloc-stack Response)]
    (store! response (response-new a))
    (response-string! response "id" "7")
    (response-string! response "value" "ok")
    (response-status! response "done")
    (assert-eq (response-finish! response)
               "d2:id1:75:value2:ok6:statusl4:doneee")))
