(module experiments.live-repl.protocol)

(import "coil.alloc" :as alloc)
(import "coil.primitive" :as primitive)
(import "coil.slice" :use [slice-len slice-get])
(import "experiments.live-repl.bencode" :use *)
(import "experiments.heap-inspector.controller" :as controller)

(export dispatch-request)

(defn text=? [(a (slice u8)) (b (slice u8))] (-> bool)
  (if (!= (slice-len a) (slice-len b)) false
      (block :same
        (for [i 0 (slice-len a)]
          (if (!= (slice-get a i) (slice-get b i))
              (return-from :same false) 0))
        true)))

(defn response-base! [(response (ptr Response)) (request (ptr Request))] (-> i64)
  (if (> (slice-len (.id request)) 0)
      (response-string! response "id" (.id request)) 0)
  (if (> (slice-len (.session request)) 0)
      (response-string! response "session" (.session request)) 0)
  0)

(defn done [(a (dyn alloc/Allocator)) (request (ptr Request))] (-> (slice u8))
  (let [response (primitive/alloc-stack Response)]
    (store! response (response-new a))
    (response-base! response request)
    (response-status! response "done")
    (response-finish! response)))

(defn value [(a (dyn alloc/Allocator)) (request (ptr Request)) (v (slice u8))] (-> (slice u8))
  (let [response (primitive/alloc-stack Response)]
    (store! response (response-new a))
    (response-base! response request)
    (response-string! response "ns" "replsession")
    (response-string! response "value" v)
    (response-status! response "done")
    (response-finish! response)))

(defn failure [(a (dyn alloc/Allocator)) (request (ptr Request))] (-> (slice u8))
  (let [response (primitive/alloc-stack Response)
        diagnostic (controller/live-controller-diagnostic)]
    (store! response (response-new a))
    (response-base! response request)
    (response-string! response "err" diagnostic)
    (response-string! response "ex" "coil.compiler/diagnostic")
    (response-string! response "root-ex" "coil.compiler/diagnostic")
    (response-status! response "eval-error")
    (response-finish! response)))

(defn submit [(a (dyn alloc/Allocator)) (request (ptr Request)) (source (slice u8))] (-> (slice u8))
  (let [status (controller/live-controller-edit-source! source)]
    (if (= status 0)
        (value a request (controller/live-controller-snapshot))
        (failure a request))))

(defn describe [(a (dyn alloc/Allocator)) (request (ptr Request))] (-> (slice u8))
  (let [response (primitive/alloc-stack Response)]
    (store! response (response-new a))
    (response-base! response request)
    (response-dict-start! response "ops")
    (response-dict-entry-start! response "clone") (response-container-end! response)
    (response-dict-entry-start! response "describe") (response-container-end! response)
    (response-dict-entry-start! response "eval") (response-container-end! response)
    (response-dict-entry-start! response "load-file") (response-container-end! response)
    (response-dict-entry-start! response "ls-sessions") (response-container-end! response)
    (response-dict-entry-start! response "coil/state") (response-container-end! response)
    (response-dict-entry-start! response "coil/source") (response-container-end! response)
    (response-dict-entry-start! response "coil/pending") (response-container-end! response)
    (response-container-end! response)
    (response-dict-start! response "versions")
    (response-dict-entry-start! response "nrepl")
    (response-string! response "version-string" "0.9")
    (response-string! response "major" "0")
    (response-string! response "minor" "9")
    (response-container-end! response)
    (response-dict-entry-start! response "coil")
    (response-string! response "version-string" "0.1")
    (response-container-end! response)
    (response-container-end! response)
    (response-string! response "aux" "Coil retained native live session")
    (response-status! response "done")
    (response-finish! response)))

;;; One durable compiler/live-runtime session backs the server. nREPL session
;;; ids are views onto that same world, not independent copies of application
;;; state. This is intentional and is reported by `describe`.
(defn dispatch-request [(a (dyn alloc/Allocator)) (request (ptr Request))] (-> (slice u8))
  (let [op (.op request)]
    (cond
      (text=? op "describe") (describe a request)
      (text=? op "clone")
        (let [response (primitive/alloc-stack Response)]
          (store! response (response-new a))
          (response-base! response request)
          (response-string! response "new-session" "coil-live")
          (response-status! response "done")
          (response-finish! response))
      (text=? op "ls-sessions")
        (let [response (primitive/alloc-stack Response)]
          (store! response (response-new a))
          (response-base! response request)
          (response-list-string! response "sessions" "coil-live")
          (response-status! response "done")
          (response-finish! response))
      (text=? op "eval") (submit a request (.code request))
      (text=? op "load-file") (submit a request (.file request))
      (text=? op "coil/state") (value a request (controller/live-controller-snapshot))
      (text=? op "coil/source") (value a request (controller/live-controller-source))
      (text=? op "coil/pending") (value a request (controller/live-controller-pending))
      (text=? op "close") (done a request)
      :else
        (let [response (primitive/alloc-stack Response)]
          (store! response (response-new a))
          (response-base! response request)
          (response-string! response "err" "unknown nREPL operation")
          (response-status! response "unknown-op")
          (response-finish! response)))))
