(module experiments.coil_gpui.inspector)
(import "experiments.coil_gpui.ui" :as ui)
(import "coil.arraylist" :as al)
(import "coil.primitive" :as primitive)

(export InspectorSnapshot
        InspectorState
        inspector-new
        inspector-enabled?
        inspector-toggle!
        inspector-pick!
        inspector-snapshot
        inspector-paint!)

(defstruct InspectorSnapshot
  [(selected-id i32)
   (parent-id i32)
   (bounds ui/Rect)
   (depth i64)
   (candidate-count i64)
   (primitive-count i64)
   (text-count i64)
   (path-count i64)
   (hitbox-count i64)
   (focusable bool)
   (occludes bool)
   (valid bool)])

(defstruct InspectorState
  [(enabled bool)
   (pointer-x f32)
   (pointer-y f32)
   (cycle i64)
   (snapshot InspectorSnapshot)])

(defn empty-snapshot [] (-> InspectorSnapshot)
  (InspectorSnapshot
    :selected-id -1
    :parent-id -1
    :bounds (ui/rect 0.0 0.0 0.0 0.0)
    :depth 0
    :candidate-count 0
    :primitive-count 0
    :text-count 0
    :path-count 0
    :hitbox-count 0
    :focusable false
    :occludes false
    :valid false))

(defn inspector-new [] (-> InspectorState)
  (InspectorState
    :enabled false
    :pointer-x 0.0
    :pointer-y 0.0
    :cycle 0
    :snapshot (empty-snapshot)))

(defn inspector-enabled? [(inspector InspectorState)] (-> bool)
  (load (field inspector enabled)))

(defn inspector-toggle! [(inspector (mut InspectorState))] (-> bool)
  (let [next (not (load (field inspector enabled)))]
    (do
      (set! (.enabled inspector) next)
      (set! (.cycle inspector) 0)
      (if (not next) (set! (.snapshot inspector) (empty-snapshot)) 0)
      next)))

(defn hitbox-contains? [(hitbox ui/Hitbox)
                        (x f32)
                        (y f32)] (-> bool)
  (let [local
          (ui/affine-transform-point (load (field hitbox inverse-transform))
                                     (ui/Point :x x :y y))]
    (and (load (field hitbox transform-valid))
         (and (ui/contains? (load (field hitbox bounds))
                            (load (field local x))
                            (load (field local y)))
              (ui/contains? (load (field hitbox clip)) x y)))))

(defn hitbox-screen-bounds [(hitbox ui/Hitbox)] (-> ui/Rect)
  (if (not (load (field hitbox transform-valid)))
      (ui/rect 0.0 0.0 0.0 0.0)
      (ui/intersect
        (ui/affine-transform-bounds
          (ui/affine-inverse (load (field hitbox inverse-transform)))
          (load (field hitbox bounds)))
        (load (field hitbox clip)))))

(defn parent-id [(scene ui/Scene) (id i32)] (-> i32)
  (let [hitboxes (load (field scene hitboxes))]
    (block :found
      (for [i 0 (al/al-len [ui/Hitbox] hitboxes)]
        (let [hitbox (primitive/index (load (field hitboxes data)) i)]
          (if (= (load (field hitbox id)) id)
              (return-from :found (load (field hitbox parent)))
              0)))
      -1)))

(defn hierarchy-depth [(scene ui/Scene) (start i32)] (-> i64)
  (let [limit (al/al-len [ui/Hitbox] (load (field scene hitboxes)))
        (mut current) start
        (mut depth) 0]
    (do
      (for [i 0 (+ limit 1)]
        (if (< (load current) 0)
            (break 0)
            (do
              (store! current (parent-id scene (load current)))
              (if (>= (load current) 0) (store! depth (+ (load depth) 1)) 0))))
      (load depth))))

(defn scene-counts [(scene ui/Scene)
                    (snapshot (mut InspectorSnapshot))] (-> i64)
  (do
    (set! (.primitive-count snapshot)
          (+ (al/al-len [ui/Primitive] (load (field scene items)))
             (al/al-len [ui/Primitive] (load (field scene shadows)))))
    (set! (.text-count snapshot)
          (al/al-len [ui/TextSprite] (load (field scene text))))
    (set! (.path-count snapshot)
          (al/al-len [ui/PathDraw] (load (field scene path-draws))))
    (set! (.hitbox-count snapshot)
          (al/al-len [ui/Hitbox] (load (field scene hitboxes))))
    0))

(defn inspector-pick! [(inspector (mut InspectorState))
                       (scene ui/Scene)
                       (x f32)
                       (y f32)
                       (cycle-delta i64)] (-> i32)
  (if (not (load (field inspector enabled)))
      -1
      (let [moved (or (< x (load (field inspector pointer-x)))
                      (or (> x (load (field inspector pointer-x)))
                          (or (< y (load (field inspector pointer-y)))
                              (> y (load (field inspector pointer-y))))))
            hitboxes (load (field scene hitboxes))
            count (al/al-len [ui/Hitbox] hitboxes)
            (mut candidates) 0]
        (do
          (if moved (set! (.cycle inspector) 0) 0)
          (set! (.pointer-x inspector) x)
          (set! (.pointer-y inspector) y)
          (for [i 0 count]
            (let [hitbox (primitive/index (load (field hitboxes data)) i)]
              (if (hitbox-contains? (load hitbox) x y)
                  (store! candidates (+ (load candidates) 1))
                  0)))
          (let [(mut snapshot) (empty-snapshot)]
            (do
              (scene-counts scene (mut snapshot))
              (store! (field snapshot candidate-count) (load candidates))
              (if (= (load candidates) 0)
                  (do
                    (set! (.cycle inspector) 0)
                    (set! (.snapshot inspector) (load snapshot))
                    -1)
                  (let [(mut next-cycle) (+ (load (field inspector cycle)) cycle-delta)]
                    (do
                      (while (< (load next-cycle) 0)
                        (store! next-cycle (+ (load next-cycle) (load candidates))))
                      (while (>= (load next-cycle) (load candidates))
                        (store! next-cycle (- (load next-cycle) (load candidates))))
                      (set! (.cycle inspector) (load next-cycle))
                      (let [(mut seen) 0
                            (mut index) (- count 1)]
                        (block :selected
                          (while (>= (load index) 0)
                            (let [hitbox
                                    (primitive/index (load (field hitboxes data)) (load index))]
                              (if (hitbox-contains? (load hitbox) x y)
                                  (if (= (load seen) (load next-cycle))
                                      (do
                                        (store! (field snapshot selected-id)
                                                (load (field hitbox id)))
                                        (store! (field snapshot parent-id)
                                                (load (field hitbox parent)))
                                        (store! (field snapshot bounds)
                                                (hitbox-screen-bounds (load hitbox)))
                                        (store! (field snapshot depth)
                                                (hierarchy-depth scene
                                                                 (load (field hitbox id))))
                                        (store! (field snapshot focusable)
                                                (load (field hitbox focusable)))
                                        (store! (field snapshot occludes)
                                                (load (field hitbox occludes)))
                                        (store! (field snapshot valid) true)
                                        (set! (.snapshot inspector) (load snapshot))
                                        (break :selected (load (field hitbox id))))
                                      (store! seen (+ (load seen) 1)))
                                  0)
                              (store! index (- (load index) 1))))
                          -1)))))))))))

(defn inspector-snapshot [(inspector InspectorState)] (-> InspectorSnapshot)
  (load (field inspector snapshot)))

(defn parent-screen-bounds [(scene ui/Scene) (id i32)] (-> ui/Rect)
  (let [hitboxes (load (field scene hitboxes))]
    (block :found
      (for [i 0 (al/al-len [ui/Hitbox] hitboxes)]
        (let [hitbox (primitive/index (load (field hitboxes data)) i)]
          (if (= (load (field hitbox id)) id)
              (return-from :found (hitbox-screen-bounds (load hitbox)))
              0)))
      (ui/rect 0.0 0.0 0.0 0.0))))

(defn inspector-paint! [(inspector InspectorState)
                        (scene (mut ui/Scene))
                        (viewport ui/Rect)] (-> i64)
  (let [snapshot (load (field inspector snapshot))]
    (if (or (not (load (field inspector enabled)))
            (not (load (field snapshot valid))))
        0
        (let [bounds (load (field snapshot bounds))
              parent (load (field snapshot parent-id))]
          (do
            (if (>= parent 0)
                (ui/scene-rounded-rect! (mut scene)
                                        (parent-screen-bounds (load scene) parent)
                                        (ui/rgba 1.0 0.72 0.12 0.08)
                                        2.0
                                        1.0
                                        (ui/rgba 1.0 0.72 0.12 0.80)
                                        -9002)
                0)
            (ui/scene-rounded-rect! (mut scene)
                                    bounds
                                    (ui/rgba 0.20 0.62 1.0 0.14)
                                    2.0
                                    2.0
                                    (ui/rgba 0.32 0.78 1.0 0.95)
                                    -9001)
            (ui/scene-rect! (mut scene)
                            (ui/rect (- (load (field inspector pointer-x)) 7.0)
                                     (load (field inspector pointer-y))
                                     14.0
                                     1.0)
                            (ui/rgba 1.0 0.88 0.30 0.95)
                            -9003)
            (ui/scene-rect! (mut scene)
                            (ui/rect (load (field inspector pointer-x))
                                     (- (load (field inspector pointer-y)) 7.0)
                                     1.0
                                     14.0)
                            (ui/rgba 1.0 0.88 0.30 0.95)
                            -9004)
            ;; A compact GPU-only diagnostic meter: primitives, text sprites,
            ;; paths, and hitboxes are normalized to the panel width.
            (let [panel-x (- (+ (load (field viewport x))
                                (load (field viewport w)))
                             196.0)
                  panel-y (+ (load (field viewport y)) 12.0)
                  max-width (primitive/cast f32 164.0)]
              (do
                (ui/scene-rounded-rect! (mut scene)
                                        (ui/rect panel-x panel-y 184.0 58.0)
                                        (ui/rgba 0.04 0.05 0.08 0.92)
                                        7.0
                                        1.0
                                        (ui/rgba 0.32 0.78 1.0 0.65)
                                        -9010)
                (ui/scene-rect! (mut scene)
                                (ui/rect (+ panel-x 10.0) (+ panel-y 10.0)
                                         (* max-width
                                            (/ (primitive/cast f32
                                                 (load (field snapshot primitive-count)))
                                               (+ (primitive/cast f32
                                                    (load (field snapshot primitive-count)))
                                                  100.0)))
                                         6.0)
                                (ui/rgb 0.34 0.68 1.0)
                                -9011)
                (ui/scene-rect! (mut scene)
                                (ui/rect (+ panel-x 10.0) (+ panel-y 22.0)
                                         (* max-width
                                            (/ (primitive/cast f32
                                                 (load (field snapshot text-count)))
                                               (+ (primitive/cast f32
                                                    (load (field snapshot text-count)))
                                                  50.0)))
                                         6.0)
                                (ui/rgb 0.68 0.46 1.0)
                                -9012)
                (ui/scene-rect! (mut scene)
                                (ui/rect (+ panel-x 10.0) (+ panel-y 34.0)
                                         (* max-width
                                            (/ (primitive/cast f32
                                                 (+ (load (field snapshot path-count))
                                                    (load (field snapshot hitbox-count))))
                                               (+ (primitive/cast f32
                                                    (+ (load (field snapshot path-count))
                                                       (load (field snapshot hitbox-count))))
                                                  10.0)))
                                         6.0)
                                (ui/rgb 1.0 0.72 0.24)
                                -9013)))
            1)))))
