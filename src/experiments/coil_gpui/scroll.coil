(module experiments.coil_gpui.scroll)
(import "experiments.coil_gpui.ui" :as ui)
(import "coil.primitive" :as primitive)

(export ScrollState
        scroll-new
        scroll-configure!
        scroll-by!
        scroll-to!
        scroll-max-offset
        visible-first
        visible-last
        visible-count
        item-rect
        scroll-begin!
        scroll-end!
        scrollbar!)

;;; Retained state for a uniform virtual list. The transient scene receives only
;;; `[visible-first, visible-last)`, with a bounded overscan margin. Offset is
;;; always clamped after content or viewport changes, including at the bottom.
(defstruct ScrollState
  [(viewport ui/Rect)
   (offset f32)
   (content-height f32)
   (item-height f32)
   (item-count i64)
   (overscan i64)])

(defn scroll-new [(item-count i64) (item-height f32) (overscan i64)] (-> ScrollState)
  (ScrollState
    :viewport (ui/rect 0.0 0.0 0.0 0.0)
    :offset 0.0
    :content-height (* (primitive/cast f32 item-count) item-height)
    :item-height item-height
    :item-count item-count
    :overscan (if (< overscan 0) 0 overscan)))

(defn scroll-max-offset [(state ScrollState)] (-> f32)
  (let [maximum
          (- (load (field state content-height))
             (load (field (field state viewport) h)))]
    (if (> maximum 0.0) maximum 0.0)))

(defn scroll-to! [(state (mut ScrollState)) (offset f32)] (-> f32)
  (let [maximum (scroll-max-offset (load state))
        clamped (cond (< offset 0.0) 0.0 (> offset maximum) maximum :else offset)]
    (do (set! (.offset state) clamped) clamped)))

(defn scroll-configure! [(state (mut ScrollState))
                         (viewport ui/Rect)
                         (item-count i64)
                         (item-height f32)] (-> i64)
  (do
    (set! (.viewport state) viewport)
    (set! (.item-count state) (if (< item-count 0) 0 item-count))
    (set! (.item-height state) (if (> item-height 0.0) item-height 1.0))
    (set! (.content-height state)
          (* (primitive/cast f32 (load (field state item-count)))
             (load (field state item-height))))
    (scroll-to! (mut state) (load (field state offset)))
    0))

(defn scroll-by! [(state (mut ScrollState)) (delta f32)] (-> f32)
  (scroll-to! (mut state) (+ (load (field state offset)) delta)))

(defn visible-first [(state ScrollState)] (-> i64)
  (let [raw
          (primitive/cast i64
                          (/ (load (field state offset))
                             (load (field state item-height))))
        first (- raw (load (field state overscan)))]
    (if (> first 0) first 0)))

(defn visible-last [(state ScrollState)] (-> i64)
  (let [bottom
          (+ (load (field state offset))
             (load (field (field state viewport) h)))
        raw (+ (primitive/cast i64 (/ bottom (load (field state item-height)))) 1)
        last (+ raw (load (field state overscan)))
        count (load (field state item-count))]
    (if (< last count) last count)))

(defn visible-count [(state ScrollState)] (-> i64)
  (- (visible-last state) (visible-first state)))

(defn item-rect [(state ScrollState) (index i64)] (-> ui/Rect)
  (let [viewport (load (field state viewport))]
    (ui/rect (load (field viewport x))
             (+ (load (field viewport y))
                (- (* (primitive/cast f32 index) (load (field state item-height)))
                   (load (field state offset))))
             (load (field viewport w))
             (load (field state item-height)))))

;;; Begin a clipped scroll viewport and register one non-focusable hitbox used by
;;; wheel routing. Return the prior clip so callers can close the scope exactly.
(defn scroll-begin! [(scene (mut ui/Scene)) (state ScrollState) (id i32)] (-> ui/Rect)
  (let [viewport (load (field state viewport))
        prior (ui/scene-push-clip! (mut scene) viewport)]
    (do
      (ui/scene-hitbox! (mut scene) viewport id -1 false false)
      prior)))

(defn scroll-end! [(scene (mut ui/Scene)) (prior ui/Rect)] (-> i64)
  (ui/scene-pop-clip! (mut scene) prior))

;;; Paint a stable vertical scrollbar. The thumb remains pinned to the bottom at
;;; max offset and never disappears when content/viewport dimensions coincide.
(defn scrollbar! [(scene (mut ui/Scene)) (state ScrollState) (id i32)] (-> i64)
  (let [viewport (load (field state viewport))
        content (load (field state content-height))
        viewport-height (load (field viewport h))
        maximum (scroll-max-offset state)
        track
          (ui/rect (- (+ (load (field viewport x)) (load (field viewport w))) 6.0)
                   (+ (load (field viewport y)) 2.0)
                   4.0
                   (- viewport-height 4.0))
        track-height (load (field track h))
        raw-thumb (if (> content 0.0) (* track-height (/ viewport-height content)) track-height)
        thumb-height (cond (< raw-thumb 24.0) 24.0 (> raw-thumb track-height) track-height :else raw-thumb)
        fraction (if (> maximum 0.0) (/ (load (field state offset)) maximum) 0.0)
        thumb-y (+ (load (field track y)) (* (- track-height thumb-height) fraction))]
    (do
      (ui/scene-rounded-rect! (mut scene)
                              track
                              (ui/rgba 1.0 1.0 1.0 0.07)
                              2.0
                              0.0
                              (ui/rgba 0.0 0.0 0.0 0.0)
                              id)
      (ui/scene-rounded-rect! (mut scene)
                              (ui/rect (load (field track x)) thumb-y 4.0 thumb-height)
                              (ui/rgba 0.62 0.72 0.96 0.72)
                              2.0
                              0.0
                              (ui/rgba 0.0 0.0 0.0 0.0)
                              id))))
