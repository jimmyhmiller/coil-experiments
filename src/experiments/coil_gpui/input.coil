(module experiments.coil_gpui.input)
(import "experiments.coil_gpui.ui" :as ui)
(import "coil.arraylist" :as al)
(import "coil.alloc" :as alloc)
(import "coil.primitive" :as primitive)

(export Router
        ActionEvent
        DispatchPath
        DispatchStep
        DispatchPlan
        Listener
        ListenerRegistry
        Invocation
        DispatchCursor
        router-new
        router-pointer-move!
        router-pointer-down!
        router-pointer-up!
        router-key!
        dispatch-path
        dispatch-path-free!
        dispatch-plan
        dispatch-plan-free!
        listener-registry-new
        listener-register!
        listener-registry-free!
        resolve-listeners
        dispatch-cursor-new
        dispatch-cursor-has-next?
        dispatch-cursor-token
        dispatch-cursor-target
        dispatch-cursor-phase
        dispatch-cursor-advance!
        dispatch-cursor-stop!
        dispatch-cursor-free!
        focus-next
        action-none
        action-activate
        action-decrement
        action-increment)

(const action-none i32 0)

(const action-activate i32 1)

(const action-decrement i32 2)

(const action-increment i32 3)

(defstruct ActionEvent [(action i32) (target i32)])

(defstruct DispatchPath [(ids (al/ArrayList i32)) (valid bool)])

(defstruct DispatchStep [(target i32) (phase i32)])

(defstruct DispatchPlan [(steps (al/ArrayList DispatchStep)) (valid bool)])

(defstruct Listener [(target i32) (phase i32) (token i32)])

(defstruct ListenerRegistry [(listeners (al/ArrayList Listener))])

(defstruct Invocation [(token i32) (target i32) (phase i32)])

(defstruct DispatchCursor
  [(invocations (al/ArrayList Invocation)) (index i64) (stopped bool)])

(defstruct Router [(hovered i32) (pressed i32) (focused i32) (keyboard bool)])

(defn router-new [] (-> Router)
  (Router
    :hovered -1
    :pressed -1
    :focused -1
    :keyboard false))

(defn none-event [] (-> ActionEvent)
  (ActionEvent :action action-none :target -1))

(defn focusable-id? [(scene ui/Scene) (id i32)] (-> bool)
  (let [hitboxes (load (field scene hitboxes))
        count (al/al-len [ui/Hitbox] hitboxes)]
    (block :found
           (for [i 0 count]
             (let [hitbox (al/al-get [ui/Hitbox] hitboxes i)]
               (if (and (= (load (field hitbox id)) id) (load (field hitbox focusable)))
                   (return-from :found true)
                   0)))
           false)))

(defn hitbox-parent [(scene ui/Scene) (id i32)] (-> i32)
  (let [hitboxes (load (field scene hitboxes))]
    (block :found
           (for [i 0 (al/al-len [ui/Hitbox] hitboxes)]
             (let [hitbox (al/al-get [ui/Hitbox] hitboxes i)]
               (if (= (load (field hitbox id)) id)
                   (return-from :found (load (field hitbox parent)))
                   0)))
           -1)))

(defn dispatch-path [(scene ui/Scene) (target i32)] (-> DispatchPath)
  (let [(mut ids) (al/al-new [i32] (alloc/malloc-allocator))
        limit (al/al-len [ui/Hitbox] (load (field scene hitboxes)))
        (mut current) target
        (mut valid) (>= target 0)]
    (do
      (for [depth 0 (+ limit 1)]
        (if (< (load current) 0)
            (break 0)
            (do
              (al/al-push! [i32] (mut ids) (load current))
              (store! current (hitbox-parent scene (load current))))))
      (if (>= (load current) 0) (store! valid false) 0)
      ;; Parent discovery is target-to-root; dispatch order is root-to-target.
      (let [count (al/al-len [i32] (load ids))]
        (for [i 0 (/ count 2)]
          (let [j (- (- count 1) i)
                a (al/al-get [i32] (load ids) i)]
            (do
              (al/al-set! [i32] (mut ids) i (al/al-get [i32] (load ids) j))
              (al/al-set! [i32] (mut ids) j a)))))
      (DispatchPath :ids (load ids) :valid (load valid)))))

(defn dispatch-path-free! [(path (mut DispatchPath))] (-> i64)
  (al/al-free! [i32] (mut (.ids path))))

;;; Phase values: 0 capture, 1 target, 2 bubble.
(defn dispatch-plan [(scene ui/Scene) (target i32)] (-> DispatchPlan)
  (let [(mut path) (dispatch-path scene target)
        (mut steps) (al/al-new [DispatchStep] (alloc/malloc-allocator))
        ids (load (field path ids))
        count (al/al-len [i32] ids)]
    (do
      (if (load (field path valid))
          (do
            (for [i 0 (if (> count 0) (- count 1) 0)]
              (al/al-push! [DispatchStep]
                           (mut steps)
                           (DispatchStep :target (al/al-get [i32] ids i) :phase 0)))
            (if (> count 0)
                (al/al-push! [DispatchStep]
                             (mut steps)
                             (DispatchStep :target (al/al-get [i32] ids (- count 1)) :phase 1))
                0)
            (let [(mut i) (- count 2)]
              (while (>= (load i) 0)
                (do
                  (al/al-push! [DispatchStep]
                               (mut steps)
                               (DispatchStep :target (al/al-get [i32] ids (load i)) :phase 2))
                  (store! i (- (load i) 1))))))
          0)
      (let [valid (load (field path valid))]
        (do
          (dispatch-path-free! (mut path))
          (DispatchPlan :steps (load steps) :valid valid))))))

(defn dispatch-plan-free! [(plan (mut DispatchPlan))] (-> i64)
  (al/al-free! [DispatchStep] (mut (.steps plan))))

(defn listener-registry-new [] (-> ListenerRegistry)
  (ListenerRegistry :listeners (al/al-new [Listener] (alloc/malloc-allocator))))

(defn listener-register! [(registry (mut ListenerRegistry))
                          (target i32)
                          (phase i32)
                          (token i32)] (-> i64)
  (let [(mut listener) (primitive/zeroed Listener)]
    (do
      ;; Initialize the live slot after growth. This also avoids borrowing a slot
      ;; across a possible ArrayList reallocation.
      (al/al-push! [Listener] (mut (.listeners registry)) (load listener))
      (let [listeners (load (field registry listeners))
            item
              (primitive/index (load (field listeners data))
                               (- (al/al-len [Listener] listeners) 1))]
        (do
          (store! (field item target) target)
          (store! (field item phase) phase)
          (store! (field item token) token)
          (al/al-len [Listener] listeners))))))

(defn resolve-listeners [(registry ListenerRegistry)
                         (plan DispatchPlan)] (-> (al/ArrayList Invocation))
  (let [(mut invocations) (al/al-new [Invocation] (alloc/malloc-allocator))
        steps (load (field plan steps))
        listeners (load (field registry listeners))
        step-data (load (field steps data))
        listener-data (load (field listeners data))]
    (do
      (if (load (field plan valid))
          (for [i 0 (al/al-len [DispatchStep] steps)]
            (let [step (primitive/index step-data i)]
              (for [j 0 (al/al-len [Listener] listeners)]
                (let [listener (primitive/index listener-data j)]
                  (if (and (= (load (field listener target)) (load (field step target)))
                           (= (load (field listener phase)) (load (field step phase))))
                      (let [(mut invocation) (primitive/zeroed Invocation)]
                        (do
                          (al/al-push! [Invocation]
                                       (mut invocations)
                                       (load invocation))
                          (let [item
                                  (primitive/index (load (field invocations data))
                                                   (- (al/al-len [Invocation] (load invocations)) 1))]
                            (do
                              (store! (field item token) (load (field listener token)))
                              (store! (field item target) (load (field step target)))
                              (store! (field item phase) (load (field step phase)))))))
                      0)))))
          0)
      (load invocations))))

(defn listener-registry-free! [(registry (mut ListenerRegistry))] (-> i64)
  (al/al-free! [Listener] (mut (.listeners registry))))

(defn dispatch-cursor-new [(registry ListenerRegistry)
                           (plan DispatchPlan)] (-> DispatchCursor)
  (let [(mut cursor) (primitive/zeroed DispatchCursor)]
    (do
      (store! (field cursor invocations) (resolve-listeners registry plan))
      (store! (field cursor index) 0)
      (store! (field cursor stopped) false)
      (load cursor))))

(defn dispatch-cursor-has-next? [(cursor DispatchCursor)] (-> bool)
  (and (not (load (field cursor stopped)))
       (< (load (field cursor index))
          (al/al-len [Invocation] (load (field cursor invocations))))))

(defn dispatch-cursor-current [(cursor (mut DispatchCursor))] (-> (ptr Invocation))
  (let [invocations (load (field cursor invocations))]
    (primitive/index (load (field invocations data)) (load (field cursor index)))))

(defn dispatch-cursor-token [(cursor (mut DispatchCursor))] (-> i32)
  (load (field (dispatch-cursor-current (mut cursor)) token)))

(defn dispatch-cursor-target [(cursor (mut DispatchCursor))] (-> i32)
  (load (field (dispatch-cursor-current (mut cursor)) target)))

(defn dispatch-cursor-phase [(cursor (mut DispatchCursor))] (-> i32)
  (load (field (dispatch-cursor-current (mut cursor)) phase)))

(defn dispatch-cursor-advance! [(cursor (mut DispatchCursor))] (-> i64)
  (do
    (if (dispatch-cursor-has-next? (load cursor))
        (set! (.index cursor) (+ (load (field cursor index)) 1))
        0)
    (load (field cursor index))))

(defn dispatch-cursor-stop! [(cursor (mut DispatchCursor))] (-> i64)
  (do
    (set! (.stopped cursor) true)
    (load (field cursor index))))

(defn dispatch-cursor-free! [(cursor (mut DispatchCursor))] (-> i64)
  (al/al-free! [Invocation] (mut (.invocations cursor))))

(defn focus-next [(scene ui/Scene) (current i32) (direction i64)] (-> i32)
  (let [hitboxes (load (field scene hitboxes))
        count (al/al-len [ui/Hitbox] hitboxes)
        (mut start) -1]
    (do
      (for [i 0 count]
        (let [hitbox (al/al-get [ui/Hitbox] hitboxes i)]
          (if (= (load (field hitbox id)) current) (store! start i) 0)))
      (block :found
             (for [step 1 (+ count 1)]
               (let [raw (+ (load start) (* step direction))
                     (mut wrapped) raw]
                 (do
                   (while (< (load wrapped) 0) (store! wrapped (+ (load wrapped) count)))
                   (while (>= (load wrapped) count) (store! wrapped (- (load wrapped) count)))
                   (let [hitbox (al/al-get [ui/Hitbox] hitboxes (load wrapped))]
                     (if (load (field hitbox focusable))
                         (return-from :found (load (field hitbox id)))
                         0)))))
             -1))))

(defn router-pointer-move! [(router (mut Router)) (scene ui/Scene) (x f32) (y f32)] (-> i32)
  (let [target (ui/topmost-hit scene x y)]
    (do
      (set! (.hovered router) target)
      (set! (.keyboard router) false)
      target)))

(defn router-pointer-down! [(router (mut Router)) (scene ui/Scene) (x f32) (y f32)] (-> i32)
  (let [target (router-pointer-move! (mut router) scene x y)]
    (do
      (set! (.pressed router) target)
      (if (focusable-id? scene target) (set! (.focused router) target) 0)
      target)))

(defn router-pointer-up! [(router (mut Router)) (scene ui/Scene) (x f32) (y f32)] (-> ActionEvent)
  (let [target (router-pointer-move! (mut router) scene x y)
        pressed (load (field router pressed))]
    (do
      (set! (.pressed router) -1)
      (if (and (>= pressed 0) (= pressed target))
          (ActionEvent :action action-activate :target target)
          (none-event)))))

;;; Translate platform key codes into logical actions. Tab changes focus in
;;; paint order; Return/Space activates; arrows are semantic adjustments.
(defn router-key! [(router (mut Router)) (scene ui/Scene) (key i64) (shift bool)] (-> ActionEvent)
  (do
    (set! (.keyboard router) true)
    (cond (= key 48)
            (do
              (set! (.focused router)
                    (focus-next scene (load (field router focused)) (if shift -1 1)))
              (none-event))
          (or (= key 36) (= key 49))
            (if (>= (load (field router focused)) 0)
                (ActionEvent :action action-activate :target (load (field router focused)))
                (none-event))
          (= key 123) (ActionEvent :action action-decrement :target (load (field router focused)))
          (= key 124) (ActionEvent :action action-increment :target (load (field router focused)))
          :else (none-event))))
