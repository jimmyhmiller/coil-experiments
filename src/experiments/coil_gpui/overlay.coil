(module experiments.coil_gpui.overlay)
(import "coil.primitive" :as primitive)
(import "experiments.coil_gpui.ui" :as ui)

(export Placement
        PopoverState
        SideBelow
        SideAbove
        SideRight
        SideLeft
        PopoverNext
        PopoverPrevious
        PopoverAccept
        PopoverDismiss
        anchored-place
        popover-new
        popover-open!
        popover-close!
        popover-open?
        popover-selected
        popover-paint-menu!
        popover-pointer-target!
        popover-key!)

(defn SideBelow [] (-> i32) (primitive/cast i32 0))
(defn SideAbove [] (-> i32) (primitive/cast i32 1))
(defn SideRight [] (-> i32) (primitive/cast i32 2))
(defn SideLeft [] (-> i32) (primitive/cast i32 3))

(defn PopoverNext [] (-> i32) (primitive/cast i32 0))
(defn PopoverPrevious [] (-> i32) (primitive/cast i32 1))
(defn PopoverAccept [] (-> i32) (primitive/cast i32 2))
(defn PopoverDismiss [] (-> i32) (primitive/cast i32 3))

(defstruct Placement [(bounds ui/Rect) (side i32) (arrow-offset f32)])

(defstruct PopoverState
  [(open bool)
   (modal bool)
   (anchor ui/Rect)
   (placement Placement)
   (selected i64)])

(defn clamp [(value f32) (minimum f32) (maximum f32)] (-> f32)
  (cond (< value minimum) minimum (> value maximum) maximum :else value))

;;; Place a floating rectangle against an anchor. Preferred vertical placement
;;; flips when it cannot fit, then clamps inside the viewport margin. If neither
;;; side fits, the side with more available area wins and content height shrinks.
(defn anchored-place [(anchor ui/Rect)
                      (content-width f32)
                      (content-height f32)
                      (viewport ui/Rect)
                      (gap f32)
                      (margin f32)
                      (preferred-side i32)] (-> Placement)
  (let [safe-margin (if (> margin 0.0) margin 0.0)
        left (+ (load (field viewport x)) safe-margin)
        top (+ (load (field viewport y)) safe-margin)
        right (- (+ (load (field viewport x)) (load (field viewport w))) safe-margin)
        bottom (- (+ (load (field viewport y)) (load (field viewport h))) safe-margin)
        available-width (if (> (- right left) 0.0) (- right left) 0.0)
        available-height (if (> (- bottom top) 0.0) (- bottom top) 0.0)
        width (clamp content-width 0.0 available-width)
        height (clamp content-height 0.0 available-height)
        below-y (+ (+ (load (field anchor y)) (load (field anchor h))) gap)
        above-y (- (- (load (field anchor y)) gap) height)
        right-x (+ (+ (load (field anchor x)) (load (field anchor w))) gap)
        left-x (- (- (load (field anchor x)) gap) width)
        below-space (- bottom below-y)
        above-space (- (- (load (field anchor y)) gap) top)
        right-space (- right right-x)
        left-space (- (- (load (field anchor x)) gap) left)
        vertical-preference (or (= preferred-side (SideBelow)) (= preferred-side (SideAbove)))
        side
          (if vertical-preference
              (cond (and (= preferred-side (SideBelow)) (>= below-space height)) (SideBelow)
                    (and (= preferred-side (SideAbove)) (>= above-space height)) (SideAbove)
                    (>= below-space height) (SideBelow)
                    (>= above-space height) (SideAbove)
                    (> below-space above-space) (SideBelow)
                    :else (SideAbove))
              (cond (and (= preferred-side (SideRight)) (>= right-space width)) (SideRight)
                    (and (= preferred-side (SideLeft)) (>= left-space width)) (SideLeft)
                    (>= right-space width) (SideRight)
                    (>= left-space width) (SideLeft)
                    (> right-space left-space) (SideRight)
                    :else (SideLeft)))
        resolved-width
          (if (or (= side (SideRight)) (= side (SideLeft)))
              (clamp width 0.0 (if (= side (SideRight)) right-space left-space))
              width)
        resolved-height
          (if (or (= side (SideBelow)) (= side (SideAbove)))
              (clamp height 0.0 (if (= side (SideBelow)) below-space above-space))
              height)
        x
          (cond (= side (SideRight)) right-x
                (= side (SideLeft)) (- (- (load (field anchor x)) gap) resolved-width)
                :else
                  (clamp (load (field anchor x)) left (- right resolved-width)))
        y
          (cond (= side (SideBelow)) below-y
                (= side (SideAbove)) (- (- (load (field anchor y)) gap) resolved-height)
                :else
                  (clamp (load (field anchor y)) top (- bottom resolved-height)))
        anchor-center-x (+ (load (field anchor x)) (* (load (field anchor w)) 0.5))
        anchor-center-y (+ (load (field anchor y)) (* (load (field anchor h)) 0.5))
        arrow-offset
          (if vertical-preference
              (clamp (- anchor-center-x x) 8.0 (- resolved-width 8.0))
              (clamp (- anchor-center-y y) 8.0 (- resolved-height 8.0)))]
    (Placement :bounds (ui/rect x y resolved-width resolved-height)
      :side side
      :arrow-offset arrow-offset)))

(defn popover-new [(modal bool)] (-> PopoverState)
  (PopoverState
    :open false
    :modal modal
    :anchor (ui/rect 0.0 0.0 0.0 0.0)
    :placement (Placement :bounds (ui/rect 0.0 0.0 0.0 0.0) :side (SideBelow) :arrow-offset 0.0)
    :selected 0))

(defn popover-open! [(state (mut PopoverState)) (anchor ui/Rect) (selected i64)] (-> i64)
  (do
    (set! (.open state) true)
    (set! (.anchor state) anchor)
    (set! (.selected state) (if (> selected 0) selected 0))
    0))

(defn popover-close! [(state (mut PopoverState))] (-> i64)
  (do (set! (.open state) false) 0))

(defn popover-open? [(state PopoverState)] (-> bool)
  (load (field state open)))

(defn popover-selected [(state PopoverState)] (-> i64)
  (load (field state selected)))

;;; Paint a GPU menu into a reusable deferred scene. A modal full-viewport
;;; hitbox is registered first, so later row hitboxes win inside the menu while
;;; clicks anywhere else resolve to the dismiss target.
(defn popover-paint-menu! [(deferred (mut ui/Scene))
                           (state (mut PopoverState))
                           (viewport ui/Rect)
                           (item-count i64)
                           (content-width f32)
                           (row-height f32)
                           (id-base i32)] (-> ui/Rect)
  (do
    (ui/scene-clear! (mut deferred))
    (if (or (not (load (field state open))) (<= item-count 0))
        (ui/rect 0.0 0.0 0.0 0.0)
        (let [height (+ (primitive/cast f32 12.0)
                        (* (primitive/cast f32 item-count) row-height))
              placement
                (anchored-place (load (field state anchor))
                                content-width
                                height
                                viewport
                                6.0
                                8.0
                                (SideBelow))
              bounds (load (field placement bounds))]
          (do
            (set! (.placement state) placement)
            (if (load (field state modal))
                (ui/scene-hitbox! (mut deferred) viewport id-base -1 false true)
                0)
            (ui/scene-rounded-rect! (mut deferred)
                                    bounds
                                    (ui/rgba 0.075 0.085 0.12 0.98)
                                    8.0
                                    1.0
                                    (ui/rgba 0.35 0.42 0.58 0.85)
                                    (+ id-base 1))
            (for [i 0 item-count]
              (let [row
                      (ui/rect (+ (load (field bounds x)) 6.0)
                               (+ (+ (load (field bounds y)) 6.0)
                                  (* (primitive/cast f32 i) row-height))
                               (- (load (field bounds w)) 12.0)
                               row-height)]
                (do
                  (if (= i (load (field state selected)))
                      (ui/scene-rounded-rect! (mut deferred)
                                              row
                                              (ui/rgba 0.20 0.48 0.92 0.72)
                                              5.0
                                              0.0
                                              (ui/rgba 0.0 0.0 0.0 0.0)
                                              (primitive/cast i32
                                                              (+ (primitive/cast i64 id-base)
                                                                 (+ 2 i))))
                      0)
                  (ui/scene-hitbox! (mut deferred)
                                    row
                                    (primitive/cast i32
                                                    (+ (primitive/cast i64 id-base) (+ 2 i)))
                                    -1
                                    true
                                    true))))
            bounds)))))

;;; Returns a selected item index, or -1 when no item was accepted. Outside
;;; modal clicks dismiss through `id-base`; menu item IDs begin at `id-base + 2`.
(defn popover-pointer-target! [(state (mut PopoverState))
                               (target i32)
                               (id-base i32)
                               (item-count i64)] (-> i64)
  (if (not (load (field state open)))
      -1
      (let [index (- (primitive/cast i64 target) (+ (primitive/cast i64 id-base) 2))]
        (cond (= target id-base) (do (popover-close! (mut state)) -1)
              (and (>= index 0) (< index item-count))
                (do (set! (.selected state) index) (popover-close! (mut state)) index)
              :else -1))))

;;; Keyboard navigation wraps. Accept returns the selected index and dismisses;
;;; Escape-style dismissal returns -1 without changing selection.
(defn popover-key! [(state (mut PopoverState)) (action i32) (item-count i64)] (-> i64)
  (if (or (not (load (field state open))) (<= item-count 0))
      -1
      (cond (= action (PopoverNext))
              (do
                (set! (.selected state) (% (+ (load (field state selected)) 1) item-count))
                -1)
            (= action (PopoverPrevious))
              (do
                (set! (.selected state)
                      (if (= (load (field state selected)) 0)
                          (- item-count 1)
                          (- (load (field state selected)) 1)))
                -1)
            (= action (PopoverAccept))
              (let [selected (load (field state selected))]
                (do (popover-close! (mut state)) selected))
            (= action (PopoverDismiss)) (do (popover-close! (mut state)) -1)
            :else -1)))
