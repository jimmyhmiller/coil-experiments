(module experiments.coil_gpui.editable)
(import "experiments.coil_gpui.ui" :as ui)
(import "experiments.coil_gpui.text" :as text)
(import "experiments.coil_gpui.objc" :use *)
(import "coil.arraylist" :as al)
(import "coil.alloc" :as alloc)
(import "coil.primitive" :as primitive)

(export TextField
        TextArea
        text-field-new
        text-field-free!
        text-field-bytes
        text-field-length
        text-field-caret
        text-field-revision
        text-field-has-marked?
        text-field-marked-start
        text-field-marked-end
        text-field-selection-start
        text-field-selection-end
        text-field-select!
        text-field-previous-grapheme
        text-field-next-grapheme
        text-field-collapse!
        text-field-insert!
        text-field-set-marked!
        text-field-unmark!
        text-field-commit!
        text-field-backspace!
        text-field-delete-forward!
        text-field-move-left!
        text-field-move-right!
        text-field-set-caret-from-x!
        text-field-paint!
        text-area-new
        text-area-free!
        text-area-field
        text-area-field-ptr
        text-area-reset-preferred-x!
        text-area-move-left!
        text-area-move-right!
        text-area-move-up!
        text-area-move-down!
        text-area-set-caret-from-point!
        text-area-paint!)

(extern strlen :cc c [(ptr i8)] (-> i64))

(extern memmove :cc c [(ptr i8) (ptr i8) i64] (-> (ptr i8)))

(extern memcpy :cc c [(ptr i8) (ptr i8) i64] (-> (ptr i8)))

(defstruct NSRange [(location u64) (length u64)])

;;; bytes always contains one trailing NUL, while caret and anchor are UTF-8
;;; byte boundaries in the content before it.
(defstruct TextField
  [(bytes (al/ArrayList u8))
   (caret i64)
   (anchor i64)
   (revision i64)
   (marked-start i64)
   (marked-end i64)
   (marked-active bool)
   (focused bool)])

;;; Multiline editing state is deliberately independent from shaping. The
;;; caller retains a ShapedParagraph and replaces it when the field revision or
;;; available width changes; this keeps layout work out of the frame hot path.
(defstruct TextArea
  [(field TextField)
   (preferred-x f32)
   (preferred-x-valid bool)
   (preferred-revision i64)])

(defn text-field-new [(initial (ptr i8))] (-> TextField)
  (let [(mut field) (primitive/zeroed TextField)
        length (strlen initial)]
    (do
      (store! (field field bytes) (al/al-new [u8] (alloc/malloc-allocator)))
      (al/al-reserve! [u8] (mut (.bytes field)) (+ length 1))
      (let [bytes (load (field field bytes))
            data (load (field bytes data))]
        (do
          (if (> length 0)
              (do
                (memcpy (primitive/cast (ptr i8) data) initial length)
                0)
              0)
          (store! (primitive/index data length) (primitive/cast u8 0))))
      (set! (.len (.bytes field)) (+ length 1))
      (store! (field field caret) length)
      (store! (field field anchor) length)
      (store! (field field revision) 0)
      (store! (field field marked-start) 0)
      (store! (field field marked-end) 0)
      (store! (field field marked-active) false)
      (store! (field field focused) false)
      (load field))))

(defn text-field-free! [(field (mut TextField))] (-> i64)
  (al/al-free! [u8] (mut (.bytes field))))

(defn text-field-bytes [(field TextField)] (-> (ptr i8))
  (let [bytes (load (field field bytes))]
    (primitive/cast (ptr i8) (load (field bytes data)))))

(defn text-field-length [(field TextField)] (-> i64)
  (let [length (al/al-len [u8] (load (field field bytes)))]
    (if (> length 0) (- length 1) 0)))

(defn text-field-caret [(field TextField)] (-> i64)
  (load (field field caret)))

(defn text-field-revision [(field TextField)] (-> i64)
  (load (field field revision)))

(defn text-field-has-marked? [(field TextField)] (-> bool)
  (load (field field marked-active)))

(defn text-field-marked-start [(field TextField)] (-> i64)
  (load (field field marked-start)))

(defn text-field-marked-end [(field TextField)] (-> i64)
  (load (field field marked-end)))

(defn text-field-selection-start [(field TextField)] (-> i64)
  (let [caret (load (field field caret))
        anchor (load (field field anchor))]
    (if (< caret anchor) caret anchor)))

(defn text-field-selection-end [(field TextField)] (-> i64)
  (let [caret (load (field field caret))
        anchor (load (field field anchor))]
    (if (> caret anchor) caret anchor)))

(defn clamp-index [(field TextField) (index i64)] (-> i64)
  (let [length (text-field-length field)]
    (cond (< index 0) 0 (> index length) length :else index)))

(defn text-field-select! [(field (mut TextField))
                          (anchor i64)
                          (caret i64)] (-> i64)
  (do
    (set! (.anchor field) (clamp-index (load field) anchor))
    (set! (.caret field) (clamp-index (load field) caret))
    (load (field field caret))))

(defn text-field-collapse! [(field (mut TextField)) (index i64)] (-> i64)
  (let [clamped (clamp-index (load field) index)]
    (do
      (set! (.anchor field) clamped)
      (set! (.caret field) clamped)
      clamped)))

(defn delete-selection! [(field (mut TextField))] (-> bool)
  (let [start (text-field-selection-start (load field))
        end (text-field-selection-end (load field))]
    (if (= start end)
        false
        (let [length (text-field-length (load field))
              bytes (load (field field bytes))
              data (load (field bytes data))
              removed (- end start)]
          (do
            ;; Include the trailing NUL in the overlapping move.
            (memmove (primitive/cast (ptr i8) (primitive/index data start))
                     (primitive/cast (ptr i8) (primitive/index data end))
                     (+ (- length end) 1))
            (set! (.len (.bytes field)) (- (al/al-len [u8] (load (field field bytes))) removed))
            (text-field-collapse! (mut field) start)
            (set! (.revision field) (+ (load (field field revision)) 1))
            true)))))

(defn text-field-insert! [(field (mut TextField))
                          (utf8 (ptr i8))] (-> i64)
  (let [insert-length (strlen utf8)]
    (do
      (delete-selection! (mut field))
      (if (= insert-length 0)
          (load (field field caret))
          (let [caret (load (field field caret))
                length (text-field-length (load field))
                required (+ (+ length insert-length) 1)]
            (do
              (if (> required (al/al-cap [u8] (load (field field bytes))))
                  (al/al-reserve! [u8]
                                  (mut (.bytes field))
                                  (let [capacity (al/al-cap [u8] (load (field field bytes)))]
                                    (if (> (* capacity 2) required) (* capacity 2) required)))
                  0)
              (let [bytes (load (field field bytes))
                    data (load (field bytes data))]
                (do
                  (memmove (primitive/cast (ptr i8) (primitive/index data (+ caret insert-length)))
                           (primitive/cast (ptr i8) (primitive/index data caret))
                           (+ (- length caret) 1))
                  (memcpy (primitive/cast (ptr i8) (primitive/index data caret))
                          utf8
                          insert-length)))
              (set! (.len (.bytes field)) required)
              (set! (.revision field) (+ (load (field field revision)) 1))
              (text-field-collapse! (mut field) (+ caret insert-length))))))))

(defn text-field-set-marked! [(field (mut TextField))
                              (utf8 (ptr i8))
                              (selected-location i64)
                              (selected-length i64)] (-> i64)
  (let [replace-start
          (if (load (field field marked-active))
              (load (field field marked-start))
              (text-field-selection-start (load field)))]
    (do
      (if (load (field field marked-active))
          (text-field-select! (mut field)
                              (load (field field marked-start))
                              (load (field field marked-end)))
          0)
      (text-field-insert! (mut field) utf8)
      (let [marked-length (strlen utf8)
            selected-start (+ replace-start (text/utf16-index-to-utf8 utf8 selected-location))
            selected-end
              (+ replace-start
                 (text/utf16-index-to-utf8 utf8 (+ selected-location selected-length)))]
        (do
          (set! (.marked-start field) replace-start)
          (set! (.marked-end field) (+ replace-start marked-length))
          (set! (.marked-active field) true)
          (text-field-select! (mut field) selected-start selected-end))))))

(defn text-field-unmark! [(field (mut TextField))] (-> i64)
  (do
    (set! (.marked-active field) false)
    (set! (.marked-start field) 0)
    (set! (.marked-end field) 0)
    (load (field field caret))))

(defn text-field-commit! [(field (mut TextField))
                          (utf8 (ptr i8))] (-> i64)
  (do
    (if (load (field field marked-active))
        (text-field-select! (mut field)
                            (load (field field marked-start))
                            (load (field field marked-end)))
        0)
    (text-field-unmark! (mut field))
    (text-field-insert! (mut field) utf8)))

(defn text-field-previous-grapheme [(field TextField) (index i64)] (-> i64)
  (if (<= index 0)
      0
      (let [utf8 (text-field-bytes field)
            utf16 (text/utf8-index-to-utf16 utf8 (clamp-index field index))
            string (msg (ptr i8) (class c"NSString") (sel c"stringWithUTF8String:")
                        [(ptr i8)] utf8)
            range (msg NSRange string (sel c"rangeOfComposedCharacterSequenceAtIndex:")
                       [u64] (primitive/cast u64 (- utf16 1)))]
        (text/utf16-index-to-utf8 utf8 (primitive/cast i64 (load (field range location)))))))

(defn text-field-next-grapheme [(field TextField) (index i64)] (-> i64)
  (let [length (text-field-length field)]
    (if (>= index length)
        length
        (let [utf8 (text-field-bytes field)
              utf16 (text/utf8-index-to-utf16 utf8 (clamp-index field index))
              string (msg (ptr i8) (class c"NSString") (sel c"stringWithUTF8String:")
                          [(ptr i8)] utf8)
              range (msg NSRange string (sel c"rangeOfComposedCharacterSequenceAtIndex:")
                         [u64] (primitive/cast u64 utf16))
              end (+ (load (field range location)) (load (field range length)))]
          (text/utf16-index-to-utf8 utf8 (primitive/cast i64 end))))))

(defn text-field-backspace! [(field (mut TextField))] (-> bool)
  (if (delete-selection! (mut field))
      true
      (let [caret (load (field field caret))]
        (if (= caret 0)
            false
            (do
              (text-field-select! (mut field)
                                  (text-field-previous-grapheme (load field) caret)
                                  caret)
              (delete-selection! (mut field)))))))

(defn text-field-delete-forward! [(field (mut TextField))] (-> bool)
  (if (delete-selection! (mut field))
      true
      (let [caret (load (field field caret))
            next (text-field-next-grapheme (load field) caret)]
        (if (= caret next)
            false
            (do
              (text-field-select! (mut field) caret next)
              (delete-selection! (mut field)))))))

(defn text-field-move-left! [(field (mut TextField)) (extend bool)] (-> i64)
  (let [next
          (if (and (not extend)
                   (!= (load (field field caret)) (load (field field anchor))))
              (text-field-selection-start (load field))
              (text-field-previous-grapheme (load field) (load (field field caret))))]
    (if extend
        (do (set! (.caret field) next) next)
        (text-field-collapse! (mut field) next))))

(defn text-field-move-right! [(field (mut TextField)) (extend bool)] (-> i64)
  (let [next
          (if (and (not extend)
                   (!= (load (field field caret)) (load (field field anchor))))
              (text-field-selection-end (load field))
              (text-field-next-grapheme (load field) (load (field field caret))))]
    (if extend
        (do (set! (.caret field) next) next)
        (text-field-collapse! (mut field) next))))

(defn text-field-set-caret-from-x! [(field (mut TextField))
                                    (line text/ShapedLine)
                                    (x f32)
                                    (extend bool)] (-> i64)
  (let [index (text/shaped-line-index-for-x line x)]
    (if extend
        (do (set! (.caret field) index) index)
        (text-field-collapse! (mut field) index))))

(defn text-field-paint! [(scene (mut ui/Scene))
                         (field TextField)
                         (line text/ShapedLine)
                         (bounds ui/Rect)
                         (id i32)] (-> i64)
  (let [text-x (+ (load (field bounds x)) 10.0)
        line-height (+ (load (field line ascent)) (load (field line descent)))
        text-y (+ (load (field bounds y)) (/ (- (load (field bounds h)) line-height) 2.0))
        selection-start (text-field-selection-start field)
        selection-end (text-field-selection-end field)]
    (do
      (ui/scene-rounded-rect! (mut scene)
                              bounds
                              (ui/rgb 0.10 0.12 0.17)
                              6.0
                              (if (load (field field focused)) 2.0 1.0)
                              (if (load (field field focused))
                                  (ui/rgb 0.40 0.63 1.0)
                                  (ui/rgb 0.30 0.33 0.40))
                              id)
      (if (!= selection-start selection-end)
          (ui/scene-rect! (mut scene)
                          (text/shaped-line-selection-bounds line
                                                             selection-start
                                                             selection-end
                                                             text-x
                                                             text-y)
                          (ui/rgba 0.24 0.48 0.92 0.55)
                          (+ id 1))
          0)
      (if (load (field field marked-active))
          (let [marked
                  (text/shaped-line-selection-bounds line
                                                     (load (field field marked-start))
                                                     (load (field field marked-end))
                                                     text-x
                                                     text-y)]
            (ui/scene-rect! (mut scene)
                            (ui/rect (load (field marked x))
                                     (+ (load (field marked y)) (- (load (field marked h)) 2.0))
                                     (load (field marked w))
                                     2.0)
                            (ui/rgb 0.50 0.72 1.0)
                            (+ id 3)))
          0)
      (text/paint-shaped-line! (mut scene)
                               line
                               text-x
                               text-y
                               (ui/rgb 0.93 0.95 0.98)
                               (+ id 10))
      (if (and (load (field field focused)) (= selection-start selection-end))
          (ui/scene-rect! (mut scene)
                          (ui/rect (+ text-x (text/shaped-line-x-for-index line selection-end))
                                   text-y
                                   1.5
                                   line-height)
                          (ui/rgb 0.88 0.92 1.0)
                          (+ id 2))
          0)
      (ui/scene-hitbox! (mut scene) bounds id -1 true true))))

(defn text-area-new [(initial (ptr i8))] (-> TextArea)
  (TextArea
    :field (text-field-new initial)
    :preferred-x 0.0
    :preferred-x-valid false
    :preferred-revision 0))

(defn text-area-free! [(area (mut TextArea))] (-> i64)
  (text-field-free! (mut (.field area))))

(defn text-area-field [(area TextArea)] (-> TextField)
  (load (field area field)))

(defn text-area-field-ptr [(area (mut TextArea))] (-> (mut TextField))
  (mut (.field area)))

(defn text-area-reset-preferred-x! [(area (mut TextArea))] (-> i64)
  (do
    (set! (.preferred-x-valid area) false)
    (set! (.preferred-revision area)
          (text-field-revision (load (field area field))))
    0))

(defn text-area-move-left! [(area (mut TextArea)) (extend bool)] (-> i64)
  (do
    (text-area-reset-preferred-x! (mut area))
    (text-field-move-left! (mut (.field area)) extend)))

(defn text-area-move-right! [(area (mut TextArea)) (extend bool)] (-> i64)
  (do
    (text-area-reset-preferred-x! (mut area))
    (text-field-move-right! (mut (.field area)) extend)))

(defn text-area-move-vertical! [(area (mut TextArea))
                                (paragraph text/ShapedParagraph)
                                (direction f32)
                                (extend bool)] (-> i64)
  (let [field-value (load (field area field))
        caret (text-field-caret field-value)
        position (text/shaped-paragraph-position-for-index paragraph caret)
        preferred
          (if (and (load (field area preferred-x-valid))
                   (= (load (field area preferred-revision))
                      (text-field-revision field-value)))
              (load (field area preferred-x))
              (load (field position x)))
        target-y
          (+ (+ (load (field position y))
                (* direction (load (field position height))))
             (* (load (field position height)) 0.5))
        next (text/shaped-paragraph-index-for-point paragraph preferred target-y)]
    (do
      (set! (.preferred-x area) preferred)
      (set! (.preferred-x-valid area) true)
      (set! (.preferred-revision area) (text-field-revision field-value))
      (if extend
          (do (set! (.caret (.field area)) next) next)
          (text-field-collapse! (mut (.field area)) next)))))

(defn text-area-move-up! [(area (mut TextArea))
                          (paragraph text/ShapedParagraph)
                          (extend bool)] (-> i64)
  (text-area-move-vertical! (mut area) paragraph -1.0 extend))

(defn text-area-move-down! [(area (mut TextArea))
                            (paragraph text/ShapedParagraph)
                            (extend bool)] (-> i64)
  (text-area-move-vertical! (mut area) paragraph 1.0 extend))

(defn text-area-set-caret-from-point! [(area (mut TextArea))
                                       (paragraph text/ShapedParagraph)
                                       (x f32)
                                       (y f32)
                                       (extend bool)] (-> i64)
  (let [index (text/shaped-paragraph-index-for-point paragraph x y)]
    (do
      (text-area-reset-preferred-x! (mut area))
      (if extend
          (do (set! (.caret (.field area)) index) index)
          (text-field-collapse! (mut (.field area)) index)))))

(defn text-area-paint-range! [(scene (mut ui/Scene))
                              (paragraph text/ShapedParagraph)
                              (start i64)
                              (end i64)
                              (text-x f32)
                              (text-y f32)
                              (color ui/Color)
                              (id i32)
                              (underline bool)] (-> i64)
  (let [lines (load (field paragraph lines))
        count (al/al-len [text/ParagraphLine] lines)
        (mut painted) 0]
    (do
      (for [i 0 count]
        (let [item (primitive/index (load (field lines data)) i)
              line-start (load (field item byte-start))
              line-content-end (load (field item byte-content-end))
              line-end (load (field item byte-end))
              overlap-start (if (> start line-start) start line-start)
              overlap-end (if (< end line-content-end) end line-content-end)
              includes-break (and (> line-end line-content-end)
                                  (> end line-content-end)
                                  (<= start line-content-end))]
          (if (or (< overlap-start overlap-end) includes-break)
              (let [bounds
                      (text/shaped-line-selection-bounds
                        (load (field item line))
                        (- overlap-start line-start)
                        (- overlap-end line-start)
                        text-x
                        (+ text-y (load (field item y))))
                    width
                      (+ (load (field bounds w))
                         (if includes-break
                             (* (load (field paragraph line-height)) 0.5)
                             0.0))
                    draw-bounds
                      (if underline
                          (ui/rect (load (field bounds x))
                                   (+ (load (field bounds y))
                                      (- (load (field paragraph line-height)) 2.0))
                                   width
                                   2.0)
                          (ui/rect (load (field bounds x))
                                   (load (field bounds y))
                                   width
                                   (load (field paragraph line-height))))]
                (do
                  (ui/scene-rect! (mut scene)
                                  draw-bounds
                                  color
                                  (primitive/cast i32 (+ (primitive/cast i64 id) i)))
                  (store! painted (+ (load painted) 1))))
              0)))
      (load painted))))

(defn text-area-paint! [(scene (mut ui/Scene))
                        (area TextArea)
                        (paragraph text/ShapedParagraph)
                        (bounds ui/Rect)
                        (id i32)] (-> i64)
  (let [field-value (load (field area field))
        text-x (+ (load (field bounds x)) 10.0)
        text-y (+ (load (field bounds y)) 8.0)
        selection-start (text-field-selection-start field-value)
        selection-end (text-field-selection-end field-value)
        caret-position
          (text/shaped-paragraph-position-for-index paragraph
                                                    (text-field-caret field-value))]
    (do
      (ui/scene-rounded-rect! (mut scene)
                              bounds
                              (ui/rgb 0.10 0.12 0.17)
                              6.0
                              (if (load (field field-value focused)) 2.0 1.0)
                              (if (load (field field-value focused))
                                  (ui/rgb 0.40 0.63 1.0)
                                  (ui/rgb 0.30 0.33 0.40))
                              id)
      (if (!= selection-start selection-end)
          (text-area-paint-range! (mut scene)
                                  paragraph
                                  selection-start
                                  selection-end
                                  text-x
                                  text-y
                                  (ui/rgba 0.24 0.48 0.92 0.55)
                                  (+ id 1)
                                  false)
          0)
      (if (load (field field-value marked-active))
          (text-area-paint-range! (mut scene)
                                  paragraph
                                  (load (field field-value marked-start))
                                  (load (field field-value marked-end))
                                  text-x
                                  text-y
                                  (ui/rgb 0.50 0.72 1.0)
                                  (+ id 100)
                                  true)
          0)
      (text/paint-shaped-paragraph! (mut scene)
                                    paragraph
                                    text-x
                                    text-y
                                    (ui/rgb 0.93 0.95 0.98)
                                    (+ id 1000))
      (if (and (load (field field-value focused))
               (= selection-start selection-end))
          (ui/scene-rect! (mut scene)
                          (ui/rect (+ text-x (load (field caret-position x)))
                                   (+ text-y (load (field caret-position y)))
                                   1.5
                                   (load (field caret-position height)))
                          (ui/rgb 0.88 0.92 1.0)
                          (+ id 2))
          0)
      (ui/scene-hitbox! (mut scene) bounds id -1 true true))))
