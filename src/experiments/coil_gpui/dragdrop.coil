(module experiments.coil_gpui.dragdrop)
(import "experiments.coil_gpui.objc" :use *)
(import "experiments.coil_gpui.ui" :as ui)
(import "coil.primitive" :as primitive)
(import "coil.arraylist" :as al)
(import "coil.alloc" :as alloc)

(export ClipboardText
        DropItem
        DragPayload
        DragFrame
        DropState
        DropText
        DropFile
        clipboard-text-new
        clipboard-text-bytes
        clipboard-text-free!
        pasteboard-new-unique
        pasteboard-write-text!
        pasteboard-write-payload!
        pasteboard-read-text!
        clipboard-write-text!
        clipboard-read-text!
        drop-state-new
        drop-state-bytes
        drop-state-length
        drop-state-hovered?
        drop-state-x
        drop-state-y
        drop-state-revision
        drop-state-item-count
        drop-state-item-kind
        drop-state-item-bytes
        drop-state-item-length
        drag-payload-new
        drag-payload-add-text!
        drag-payload-add-file!
        drag-payload-free!
        drag-source-begin!
        drag-source-active?
        drag-source-operation
        drag-source-revision
        drop-target!
        drop-state-accept-pasteboard!
        drop-state-attach!
        drop-state-free!)

(extern malloc :cc c [i64] (-> (ptr i8)))

(extern realloc :cc c [(ptr i8) i64] (-> (ptr i8)))

(extern free :cc c [(ptr i8)] (-> void))

(extern strlen :cc c [(ptr i8)] (-> i64))

(extern memcpy :cc c [(ptr i8) (ptr i8) i64] (-> (ptr i8)))

(extern object_getClass :cc c [(ptr i8)] (-> (ptr i8)))

(extern class_getInstanceVariable :cc c [(ptr i8) (ptr i8)] (-> (ptr i8)))

(extern ivar_getOffset :cc c [(ptr i8)] (-> i64))

(extern class_addMethod :cc c [(ptr i8) (ptr i8) (ptr i8) (ptr i8)] (-> i8))

(defstruct NSPoint [(x f64) (y f64)])

(defstruct NSRect [(x f64) (y f64) (w f64) (h f64)])

(defstruct ClipboardText [(bytes (ptr i8)) (length i64)])

(const DropText i32 1)
(const DropFile i32 2)

(defstruct DropItem [(kind i32) (bytes (ptr i8)) (length i64)])

(defstruct DragPayload [(items (al/ArrayList DropItem))])

(defstruct DragFrame [(x f64) (y f64) (width f64) (height f64)])

(defstruct DropState
  [(view (ptr i8))
   (bytes (ptr i8))
   (length i64)
   (capacity i64)
   (hovered bool)
   (x f64)
   (y f64)
   (bounds ui/Rect)
   (items (al/ArrayList DropItem))
   (revision i64)
   (source-active bool)
   (source-operation u64)
   (source-revision i64)])

(defn nsstr [(bytes (ptr i8))] (-> (ptr i8))
  (msg (ptr i8)
       (class c"NSString")
       (sel c"stringWithUTF8String:")
       [(ptr i8)]
       bytes))

(defn clipboard-text-new [] (-> ClipboardText)
  (let [(mut text) (primitive/zeroed ClipboardText)
        bytes (malloc 1)]
    (do
      (store! bytes (primitive/cast i8 0))
      (store! (field text bytes) bytes)
      (load text))))

(defn clipboard-text-bytes [(text ClipboardText)] (-> (ptr i8))
  (load (field text bytes)))

(defn clipboard-text-free! [(text (mut ClipboardText))] (-> i64)
  (do
    (if (!= (primitive/cast i64 (load (field text bytes))) 0)
        (do (free (load (field text bytes))) 0)
        0)
    (store! (field text bytes) (primitive/cast (ptr i8) 0))
    (store! (field text length) 0)
    0))

(defn drop-item-new [(kind i32) (utf8 (ptr i8))] (-> DropItem)
  (let [length (strlen utf8)
        bytes (malloc (+ length 1))]
    (do
      (memcpy bytes utf8 (+ length 1))
      (DropItem :kind kind :bytes bytes :length length))))

(defn drop-item-free! [(item (mut DropItem))] (-> i64)
  (do
    (if (!= (primitive/cast i64 (load (field item bytes))) 0)
        (do (free (load (field item bytes))) 0) 0)
    (set! (.bytes item) (primitive/cast (ptr i8) 0))
    (set! (.length item) 0)
    0))

(defn drop-items-clear! [(items (mut (al/ArrayList DropItem)))] (-> i64)
  (do
    (for [i 0 (al/al-len [DropItem] (load items))]
      (let [(mut item) (al/al-get [DropItem] (load items) i)]
        (drop-item-free! (mut item))))
    (al/al-clear! [DropItem] (mut items))))

(defn drag-payload-new [] (-> DragPayload)
  (DragPayload :items (al/al-new [DropItem] (alloc/malloc-allocator))))

(defn drag-payload-add! [(payload (mut DragPayload))
                         (kind i32) (utf8 (ptr i8))] (-> i64)
  (al/al-push! [DropItem] (mut (.items payload)) (drop-item-new kind utf8)))

(defn drag-payload-add-text! [(payload (mut DragPayload)) (utf8 (ptr i8))] (-> i64)
  (drag-payload-add! (mut payload) (primitive/cast i32 DropText) utf8))

(defn drag-payload-add-file! [(payload (mut DragPayload)) (path (ptr i8))] (-> i64)
  (drag-payload-add! (mut payload) (primitive/cast i32 DropFile) path))

(defn drag-payload-free! [(payload (mut DragPayload))] (-> i64)
  (do
    (drop-items-clear! (mut (.items payload)))
    (al/al-free! [DropItem] (mut (.items payload)))))

(defn pasteboard-new-unique [] (-> (ptr i8))
  (msg (ptr i8) (class c"NSPasteboard") (sel c"pasteboardWithUniqueName") []))

(defn pasteboard-write-text! [(pasteboard (ptr i8)) (utf8 (ptr i8))] (-> bool)
  (let [string (nsstr utf8)
        objects
          (msg (ptr i8)
               (class c"NSArray")
               (sel c"arrayWithObject:")
               [(ptr i8)]
               string)]
    (do
      (msg i64 pasteboard (sel c"clearContents") [])
      (!= (msg i8 pasteboard (sel c"writeObjects:") [(ptr i8)] objects)
          (primitive/cast i8 0)))))

(defn pasteboard-write-payload! [(pasteboard (ptr i8))
                                 (payload DragPayload)] (-> bool)
  (let [objects (msg (ptr i8) (class c"NSMutableArray") (sel c"new") [])
        items (load (field payload items))]
    (do
      (for [i 0 (al/al-len [DropItem] items)]
        (let [item (al/al-get [DropItem] items i)
              object
                (if (= (load (field item kind)) (primitive/cast i32 DropFile))
                    (msg (ptr i8) (class c"NSURL") (sel c"fileURLWithPath:")
                         [(ptr i8)] (nsstr (load (field item bytes))))
                    (nsstr (load (field item bytes))))]
          (msg i64 objects (sel c"addObject:") [(ptr i8)] object)))
      (msg i64 pasteboard (sel c"clearContents") [])
      (let [written (!= (msg i8 pasteboard (sel c"writeObjects:") [(ptr i8)] objects)
                         (primitive/cast i8 0))]
        (do (msg i64 objects (sel c"release") []) written)))))

(defn pasteboard-string [(pasteboard (ptr i8))] (-> (ptr i8))
  (let [modern (msg (ptr i8) pasteboard (sel c"stringForType:") [(ptr i8)] (nsstr c"public.utf8-plain-text"))]
    (if (!= (primitive/cast i64 modern) 0)
        modern
        (msg (ptr i8) pasteboard (sel c"stringForType:") [(ptr i8)] (nsstr c"NSStringPboardType")))))

(defn pasteboard-read-text! [(pasteboard (ptr i8))
                             (text (mut ClipboardText))] (-> bool)
  (let [string (pasteboard-string pasteboard)]
    (if (= (primitive/cast i64 string) 0)
        false
        (let [utf8 (msg (ptr i8) string (sel c"UTF8String") [])
              length (strlen utf8)
              bytes (realloc (load (field text bytes)) (+ length 1))]
          (do
            (memcpy bytes utf8 (+ length 1))
            (store! (field text bytes) bytes)
            (store! (field text length) length)
            true)))))

(defn clipboard-write-text! [(utf8 (ptr i8))] (-> bool)
  (pasteboard-write-text! (msg (ptr i8) (class c"NSPasteboard") (sel c"generalPasteboard") [])
                          utf8))

(defn clipboard-read-text! [(text (mut ClipboardText))] (-> bool)
  (pasteboard-read-text! (msg (ptr i8) (class c"NSPasteboard") (sel c"generalPasteboard") [])
                         (mut text)))

(defn drop-state-new [] (-> DropState)
  (let [(mut state) (primitive/zeroed DropState)
        bytes (malloc 1)]
    (do
      (store! bytes (primitive/cast i8 0))
      (store! (field state bytes) bytes)
      (store! (field state capacity) 1)
      (store! (field state items) (al/al-new [DropItem] (alloc/malloc-allocator)))
      (load state))))

(defn drop-state-bytes [(state DropState)] (-> (ptr i8))
  (load (field state bytes)))

(defn drop-state-length [(state DropState)] (-> i64)
  (load (field state length)))

(defn drop-state-hovered? [(state DropState)] (-> bool)
  (load (field state hovered)))

(defn drop-state-x [(state DropState)] (-> f64)
  (load (field state x)))

(defn drop-state-y [(state DropState)] (-> f64)
  (load (field state y)))

(defn drop-state-revision [(state DropState)] (-> i64)
  (load (field state revision)))

(defn drop-state-item-count [(state DropState)] (-> i64)
  (al/al-len [DropItem] (load (field state items))))

(defn drop-state-item-kind [(state DropState) (index i64)] (-> i32)
  (if (or (< index 0) (>= index (drop-state-item-count state)))
      (primitive/cast i32 0)
      (let [item (al/al-get [DropItem] (load (field state items)) index)]
        (load (field item kind)))))

(defn drop-state-item-bytes [(state DropState) (index i64)] (-> (ptr i8))
  (if (or (< index 0) (>= index (drop-state-item-count state)))
      (primitive/cast (ptr i8) 0)
      (let [item (al/al-get [DropItem] (load (field state items)) index)]
        (load (field item bytes)))))

(defn drop-state-item-length [(state DropState) (index i64)] (-> i64)
  (if (or (< index 0) (>= index (drop-state-item-count state)))
      0
      (let [item (al/al-get [DropItem] (load (field state items)) index)]
        (load (field item length)))))

(defn drop-target! [(scene (mut ui/Scene))
                    (state (mut DropState))
                    (bounds ui/Rect)
                    (id i32)] (-> i64)
  (let [hovered (drop-state-hovered? (load state))
        has-payload (> (drop-state-length (load state)) 0)
        fill
          (cond hovered (ui/rgba 0.24 0.48 0.92 0.34)
                has-payload (ui/rgba 0.18 0.52 0.34 0.24)
                :else (ui/rgba 0.12 0.15 0.22 0.86))
        border
          (cond hovered (ui/rgba 0.50 0.72 1.0 1.0)
                has-payload (ui/rgba 0.35 0.82 0.55 0.9)
                :else (ui/rgba 0.40 0.46 0.58 0.72))]
    (do
      (store! (field state bounds) bounds)
      (ui/scene-rounded-rect! (mut scene) bounds fill 8.0 1.5 border id)
      (ui/scene-hitbox! (mut scene) bounds id -1 false true)
      (if has-payload
          (ui/scene-rounded-rect! (mut scene)
                                  (ui/rect (+ (load (field bounds x)) 10.0)
                                           (+ (load (field bounds y)) (- (load (field bounds h)) 7.0))
                                           (- (load (field bounds w)) 20.0)
                                           3.0)
                                  (ui/rgba 0.35 0.82 0.55 0.92)
                                  1.5
                                  0.0
                                  (ui/rgba 0.0 0.0 0.0 0.0)
                                  (+ id 1))
          0)
      0)))

(defn ensure-capacity! [(state (mut DropState)) (required i64)] (-> i64)
  (if (>= (load (field state capacity)) required)
      (load (field state capacity))
      (let [(mut capacity) (load (field state capacity))]
        (do
          (while (< (load capacity) required)
            (store! capacity (* (load capacity) 2)))
          (store! (field state bytes)
                  (realloc (load (field state bytes)) (load capacity)))
          (store! (field state capacity) (load capacity))
          (load capacity)))))

(defn copy-payload! [(state (mut DropState)) (utf8 (ptr i8))] (-> i64)
  (let [length (strlen utf8)]
    (do
      (ensure-capacity! (mut state) (+ length 1))
      (memcpy (load (field state bytes)) utf8 (+ length 1))
      (store! (field state length) length)
      length)))

(defn pasteboard-file-path [(pasteboard (ptr i8))] (-> (ptr i8))
  (let [classes
          (msg (ptr i8)
               (class c"NSArray")
               (sel c"arrayWithObject:")
               [(ptr i8)]
               (class c"NSURL"))
        options
          (msg (ptr i8)
               (class c"NSDictionary")
               (sel c"dictionaryWithObject:forKey:")
               [(ptr i8) (ptr i8)]
               (msg (ptr i8) (class c"NSNumber") (sel c"numberWithBool:") [i8] (primitive/cast i8 1))
               (nsstr c"NSPasteboardURLReadingFileURLsOnlyKey"))
        urls
          (msg (ptr i8)
               pasteboard
               (sel c"readObjectsForClasses:options:")
               [(ptr i8) (ptr i8)]
               classes
               options)]
    (if (= (msg u64 urls (sel c"count") []) 0)
        (primitive/cast (ptr i8) 0)
        (let [url (msg (ptr i8) urls (sel c"objectAtIndex:") [u64] 0)
              path (msg (ptr i8) url (sel c"path") [])]
          (msg (ptr i8) path (sel c"UTF8String") [])))))

(defn pasteboard-item-file-path [(item (ptr i8))] (-> (ptr i8))
  (let [value (msg (ptr i8) item (sel c"stringForType:")
                   [(ptr i8)] (nsstr c"public.file-url"))]
    (if (= (primitive/cast i64 value) 0)
        (primitive/cast (ptr i8) 0)
        (let [url (msg (ptr i8) (class c"NSURL") (sel c"URLWithString:")
                       [(ptr i8)] value)
              path (msg (ptr i8) url (sel c"path") [])]
          (if (= (primitive/cast i64 path) 0)
              (primitive/cast (ptr i8) 0)
              (msg (ptr i8) path (sel c"UTF8String") []))))))

(defn pasteboard-item-text [(item (ptr i8))] (-> (ptr i8))
  (let [value (msg (ptr i8) item (sel c"stringForType:")
                   [(ptr i8)] (nsstr c"public.utf8-plain-text"))]
    (if (= (primitive/cast i64 value) 0)
        (primitive/cast (ptr i8) 0)
        (msg (ptr i8) value (sel c"UTF8String") []))))

(defn drop-state-accept-pasteboard! [(state (mut DropState))
                                     (pasteboard (ptr i8))] (-> bool)
  (let [pasteboard-items (msg (ptr i8) pasteboard (sel c"pasteboardItems") [])
        count (msg u64 pasteboard-items (sel c"count") [])]
    (do
      (drop-items-clear! (mut (.items state)))
      (for [i 0 (primitive/cast i64 count)]
        (let [item (msg (ptr i8) pasteboard-items (sel c"objectAtIndex:")
                        [u64] (primitive/cast u64 i))
              file (pasteboard-item-file-path item)]
          (if (!= (primitive/cast i64 file) 0)
              (al/al-push! [DropItem] (mut (.items state))
                           (drop-item-new (primitive/cast i32 DropFile) file))
              (let [text (pasteboard-item-text item)]
                (if (!= (primitive/cast i64 text) 0)
                    (al/al-push! [DropItem] (mut (.items state))
                                 (drop-item-new (primitive/cast i32 DropText) text))
                    0)))))
      ; Some legacy pasteboards expose type-level data without pasteboardItems.
      (if (= (drop-state-item-count (load state)) 0)
          (let [file (pasteboard-file-path pasteboard)]
            (if (!= (primitive/cast i64 file) 0)
                (al/al-push! [DropItem] (mut (.items state))
                             (drop-item-new (primitive/cast i32 DropFile) file))
                (let [string (pasteboard-string pasteboard)]
                  (if (!= (primitive/cast i64 string) 0)
                      (al/al-push! [DropItem] (mut (.items state))
                                   (drop-item-new
                                     (primitive/cast i32 DropText)
                                     (msg (ptr i8) string (sel c"UTF8String") [])))
                      0))))
          0)
      (if (> (drop-state-item-count (load state)) 0)
          (let [first (al/al-get [DropItem] (load (field state items)) 0)]
            (do
              (copy-payload! (mut state) (load (field first bytes)))
              (set! (.revision state) (+ (load (field state revision)) 1))
              true))
          (do
            (ensure-capacity! (mut state) 1)
            (store! (load (field state bytes)) (primitive/cast i8 0))
            (set! (.length state) 0)
            false)))))

(defn view-drop-state [(self (ptr i8))] (-> (ptr DropState))
  (let [ivar (class_getInstanceVariable (object_getClass self) c"_coilDropState")
        slot
          (primitive/cast (ptr (ptr DropState))
                          (+ (primitive/cast i64 self) (ivar_getOffset ivar)))]
    (load slot)))

(defn update-location! [(self (ptr i8)) (sender (ptr i8))] (-> i64)
  (let [state (view-drop-state self)
        point (msg NSPoint sender (sel c"draggingLocation") [])
        bounds (msg NSRect self (sel c"bounds") [])]
    (do
      (store! (field state x) (load (field point x)))
      (store! (field state y) (- (load (field bounds h)) (load (field point y))))
      0)))

(defn sender-supported? [(sender (ptr i8))] (-> bool)
  (let [pasteboard (msg (ptr i8) sender (sel c"draggingPasteboard") [])]
    (or (!= (primitive/cast i64 (pasteboard-file-path pasteboard)) 0)
        (!= (primitive/cast i64 (pasteboard-string pasteboard)) 0))))

(defn drop-inside? [(state (ptr DropState))] (-> bool)
  (let [bounds (load (field state bounds))
        x (primitive/cast f32 (load (field state x)))
        y (primitive/cast f32 (load (field state y)))]
    (ui/contains? bounds x y)))

(defn dragging-entered [(self (ptr i8))
                        (command (ptr i8))
                        (sender (ptr i8))] (-> u64)
  (let [state (view-drop-state self)]
    (do
      (update-location! self sender)
      (store! (field state hovered) (and (sender-supported? sender) (drop-inside? state)))
      (if (load (field state hovered)) 1 0))))

(defn dragging-updated [(self (ptr i8))
                        (command (ptr i8))
                        (sender (ptr i8))] (-> u64)
  (do
    (update-location! self sender)
    (let [state (view-drop-state self)]
      (store! (field state hovered) (and (sender-supported? sender) (drop-inside? state))))
    (if (load (field (view-drop-state self) hovered)) 1 0)))

(defn dragging-exited [(self (ptr i8))
                       (command (ptr i8))
                       (sender (ptr i8))] (-> void)
  (do
    (store! (field (view-drop-state self) hovered) false)
    0))

(defn perform-drag-operation [(self (ptr i8))
                              (command (ptr i8))
                              (sender (ptr i8))] (-> i8)
  (let [state (view-drop-state self)
        pasteboard (msg (ptr i8) sender (sel c"draggingPasteboard") [])
        accepted
          (if (drop-inside? state)
              (drop-state-accept-pasteboard! (mut state) pasteboard)
              false)]
    (do
      (store! (field state hovered) false)
      (if accepted (primitive/cast i8 1) (primitive/cast i8 0)))))

(defn add-method! [(class-object (ptr i8))
                   (name (ptr i8))
                   (implementation (ptr i8))
                   (encoding (ptr i8))] (-> i64)
  (do
    (class_addMethod class-object (sel name) implementation encoding)
    0))

(defn state-pointer [(state (ptr DropState))] (-> (ptr DropState))
  state)

(defn drag-source-active? [(state DropState)] (-> bool)
  (load (field state source-active)))

(defn drag-source-operation [(state DropState)] (-> u64)
  (load (field state source-operation)))

(defn drag-source-revision [(state DropState)] (-> i64)
  (load (field state source-revision)))

(defn dragging-source-operation-mask [(self (ptr i8))
                                      (command (ptr i8))
                                      (session (ptr i8))
                                      (context i64)] (-> u64)
  (primitive/cast u64 1))

(defn dragging-source-ended [(self (ptr i8))
                             (command (ptr i8))
                             (session (ptr i8))
                             (point NSPoint)
                             (operation u64)] (-> void)
  (let [state (view-drop-state self)]
    (do
      (if (!= (primitive/cast i64 state) 0)
          (do
            (store! (field state source-active) false)
            (store! (field state source-operation) operation)
            (set! (field state source-revision)
                  (+ (load (field state source-revision)) 1))
            0)
          0)
      0)))

(defn drag-source-begin! [(state (mut DropState))
                          (event (ptr i8))
                          (payload DragPayload)
                          (frame DragFrame)] (-> bool)
  (if (or (load (field state source-active))
          (or (= (primitive/cast i64 (load (field state view))) 0)
              (or (= (primitive/cast i64 event) 0)
                  (= (al/al-len [DropItem] (load (field payload items))) 0))))
      false
      (let [dragging-items (msg (ptr i8) (class c"NSMutableArray") (sel c"new") [])
            items (load (field payload items))]
        (do
          (for [i 0 (al/al-len [DropItem] items)]
            (let [item (al/al-get [DropItem] items i)
                  writer
                    (if (= (load (field item kind)) (primitive/cast i32 DropFile))
                        (msg (ptr i8) (class c"NSURL") (sel c"fileURLWithPath:")
                             [(ptr i8)] (nsstr (load (field item bytes))))
                        (nsstr (load (field item bytes))))
                  dragging-item
                    (msg (ptr i8)
                         (msg (ptr i8) (class c"NSDraggingItem") (sel c"alloc") [])
                         (sel c"initWithPasteboardWriter:") [(ptr i8)] writer)]
              (do
                (msg i64 dragging-item (sel c"setDraggingFrame:contents:")
                     [NSRect (ptr i8)]
                     (NSRect :x (load (field frame x)) :y (load (field frame y))
                             :w (load (field frame width)) :h (load (field frame height)))
                     writer)
                (msg i64 dragging-items (sel c"addObject:") [(ptr i8)] dragging-item)
                (msg i64 dragging-item (sel c"release") []))))
          (let [session
                  (msg (ptr i8) (load (field state view))
                       (sel c"beginDraggingSessionWithItems:event:source:")
                       [(ptr i8) (ptr i8) (ptr i8)]
                       dragging-items event (load (field state view)))]
            (do
              (msg i64 dragging-items (sel c"release") [])
              (if (= (primitive/cast i64 session) 0)
                  false
                  (do
                    (set! (.source-active state) true)
                    (set! (.source-operation state) (primitive/cast u64 0))
                    true))))))))

(defn drop-state-attach! [(state (mut DropState)) (view (ptr i8))] (-> i64)
  (let [view-class (object_getClass view)
        ivar (class_getInstanceVariable view-class c"_coilDropState")
        slot
          (primitive/cast (ptr (ptr DropState))
                          (+ (primitive/cast i64 view) (ivar_getOffset ivar)))
        types (msg (ptr i8) (class c"NSMutableArray") (sel c"new") [])]
    (do
      (store! (field state view) view)
      (store! slot (state-pointer (mut state)))
      (add-method! view-class
                   c"draggingEntered:"
                   (primitive/cast (ptr i8) (primitive/fnptr-of dragging-entered))
                   c"Q@:@")
      (add-method! view-class
                   c"draggingUpdated:"
                   (primitive/cast (ptr i8) (primitive/fnptr-of dragging-updated))
                   c"Q@:@")
      (add-method! view-class c"draggingExited:" (primitive/cast (ptr i8) (primitive/fnptr-of dragging-exited)) c"v@:@")
      (add-method! view-class
                   c"performDragOperation:"
                   (primitive/cast (ptr i8) (primitive/fnptr-of perform-drag-operation))
                   c"c@:@")
      (add-method! view-class
                   c"draggingSession:sourceOperationMaskForDraggingContext:"
                   (primitive/cast (ptr i8) (primitive/fnptr-of dragging-source-operation-mask))
                   c"Q@:@q")
      (add-method! view-class
                   c"draggingSession:endedAtPoint:operation:"
                   (primitive/cast (ptr i8) (primitive/fnptr-of dragging-source-ended))
                   c"v@:@{CGPoint=dd}Q")
      (msg i64 types (sel c"addObject:") [(ptr i8)] (nsstr c"public.file-url"))
      (msg i64 types (sel c"addObject:") [(ptr i8)] (nsstr c"public.utf8-plain-text"))
      (msg i64 view (sel c"registerForDraggedTypes:") [(ptr i8)] types)
      (msg i64 types (sel c"release") [])
      0)))

(defn drop-state-free! [(state (mut DropState))] (-> i64)
  (do
    (if (!= (primitive/cast i64 (load (field state view))) 0)
        (do
          (msg i64 (load (field state view)) (sel c"unregisterDraggedTypes") [])
          (let [view (load (field state view))
                ivar (class_getInstanceVariable (object_getClass view) c"_coilDropState")
                slot
                  (primitive/cast (ptr (ptr DropState))
                                  (+ (primitive/cast i64 view) (ivar_getOffset ivar)))]
            (store! slot (primitive/cast (ptr DropState) 0))))
        0)
    (free (load (field state bytes)))
    (drop-items-clear! (mut (.items state)))
    (al/al-free! [DropItem] (mut (.items state)))
    (store! (field state bytes) (primitive/cast (ptr i8) 0))
    0))
