(module experiments.coil_gpui.ime)
(import "experiments.coil_gpui.objc" :use *)
(import "experiments.coil_gpui.editable" :as editable)
(import "experiments.coil_gpui.text" :as text)
(import "coil.primitive" :as primitive)

(export NSRange
        TextInputBridge
        text-input-bridge-new
        text-input-view-new
        text-input-handle-event!
        text-input-set-first-rect!)

(extern objc_lookUpClass :cc c [(ptr i8)] (-> (ptr i8)))

(extern objc_allocateClassPair :cc c [(ptr i8) (ptr i8) i64] (-> (ptr i8)))

(extern objc_registerClassPair :cc c [(ptr i8)] (-> void))

(extern class_addIvar :cc c [(ptr i8) (ptr i8) i64 u8 (ptr i8)] (-> i8))

(extern class_addMethod :cc c [(ptr i8) (ptr i8) (ptr i8) (ptr i8)] (-> i8))

(extern class_addProtocol :cc c [(ptr i8) (ptr i8)] (-> i8))

(extern objc_getProtocol :cc c [(ptr i8)] (-> (ptr i8)))

(extern object_getClass :cc c [(ptr i8)] (-> (ptr i8)))

(extern class_getInstanceVariable :cc c [(ptr i8) (ptr i8)] (-> (ptr i8)))

(extern ivar_getOffset :cc c [(ptr i8)] (-> i64))

(defstruct NSRange [(location u64) (length u64)])

(defstruct NSRect [(x f64) (y f64) (w f64) (h f64)])

(defstruct NSPoint [(x f64) (y f64)])

(defstruct TextInputBridge [(editor (ptr editable/TextField)) (first-rect NSRect)])

(defn text-input-bridge-new [(editor (ptr editable/TextField))] (-> TextInputBridge)
  (let [(mut bridge) (primitive/zeroed TextInputBridge)]
    (do
      (store! (field bridge editor) editor)
      (store! (field bridge first-rect)
              (NSRect
                :x 0.0
                :y 0.0
                :w 1.0
                :h 1.0))
      (load bridge))))

(defn bridge-state [(self (ptr i8))] (-> (ptr TextInputBridge))
  (let [ivar (class_getInstanceVariable (object_getClass self) c"_coilInputState")
        slot
          (primitive/cast (ptr (ptr TextInputBridge))
                          (+ (primitive/cast i64 self) (ivar_getOffset ivar)))]
    (load slot)))

(defn utf8-byte-to-utf16 [(utf8 (ptr i8)) (byte-target i64)] (-> i64)
  (let [bytes (primitive/cast (ptr u8) utf8)
        (mut byte-index) 0
        (mut utf16-index) 0]
    (do
      (while (< (load byte-index) byte-target)
        (let [lead (load (primitive/index bytes (load byte-index)))
              step
                (cond (= (& lead 240) 240) 4
                      (= (& lead 224) 224) 3
                      (= (& lead 192) 192) 2
                      :else 1)]
          (do
            (store! byte-index (+ (load byte-index) step))
            (store! utf16-index (+ (load utf16-index) (if (= step 4) 2 1))))))
      (load utf16-index))))

(defn editor-range [(editor (ptr editable/TextField))
                    (start i64)
                    (end i64)] (-> NSRange)
  (let [utf8 (editable/text-field-bytes (load editor))
        location (utf8-byte-to-utf16 utf8 start)
        finish (utf8-byte-to-utf16 utf8 end)]
    (NSRange :location (primitive/cast u64 location)
      :length (primitive/cast u64 (- finish location)))))

(defn string-value [(value (ptr i8))] (-> (ptr i8))
  (if (!= (msg i8
               value
               (sel c"isKindOfClass:")
               [(ptr i8)]
               (class c"NSAttributedString"))
          (primitive/cast i8 0))
      (msg (ptr i8) value (sel c"string") [])
      value))

(defn string-utf8 [(value (ptr i8))] (-> (ptr i8))
  (msg (ptr i8) (string-value value) (sel c"UTF8String") []))

(defn apply-replacement! [(editor (ptr editable/TextField))
                          (range NSRange)] (-> i64)
  (if (= (load (field range location)) (primitive/cast u64 -1))
      0
      (let [utf8 (editable/text-field-bytes (load editor))
            start
              (text/utf16-index-to-utf8 utf8
                                        (primitive/cast i64 (load (field range location))))
            end
              (text/utf16-index-to-utf8 utf8
                                        (+ (primitive/cast i64 (load (field range location)))
                                           (primitive/cast i64 (load (field range length)))))]
        (editable/text-field-select! (mut editor) start end))))

(defn ime-valid-attributes [(self (ptr i8)) (command (ptr i8))] (-> (ptr i8))
  (msg (ptr i8) (class c"NSArray") (sel c"array") []))

(defn ime-has-marked [(self (ptr i8)) (command (ptr i8))] (-> i8)
  (let [state (bridge-state self)
        editor (load (field state editor))]
    (if (editable/text-field-has-marked? (load editor))
        (primitive/cast i8 1)
        (primitive/cast i8 0))))

(defn ime-marked-range [(self (ptr i8)) (command (ptr i8))] (-> NSRange)
  (let [state (bridge-state self)
        editor (load (field state editor))]
    (if (editable/text-field-has-marked? (load editor))
        (editor-range editor
                      (editable/text-field-marked-start (load editor))
                      (editable/text-field-marked-end (load editor)))
        (NSRange :location (primitive/cast u64 -1) :length 0))))

(defn ime-selected-range [(self (ptr i8)) (command (ptr i8))] (-> NSRange)
  (let [state (bridge-state self)
        editor (load (field state editor))]
    (editor-range editor
                  (editable/text-field-selection-start (load editor))
                  (editable/text-field-selection-end (load editor)))))

(defn ime-first-rect [(self (ptr i8))
                      (command (ptr i8))
                      (range-location u64)
                      (range-length u64)
                      (actual-range (ptr NSRange))] (-> NSRect)
  (let [state (bridge-state self)]
    (do
      (if (!= (primitive/cast i64 actual-range) 0)
          (store! actual-range (ime-selected-range self command))
          0)
      (let [window (msg (ptr i8) self (sel c"window") [])]
        (if (!= (primitive/cast i64 window) 0)
            (msg NSRect
                 window
                 (sel c"convertRectToScreen:")
                 [NSRect]
                 (load (field state first-rect)))
            (load (field state first-rect)))))))

(defn ime-insert-text [(self (ptr i8))
                       (command (ptr i8))
                       (value (ptr i8))
                       (replacement-location u64)
                       (replacement-length u64)] (-> void)
  (let [state (bridge-state self)
        editor (load (field state editor))
        replacement (NSRange :location replacement-location :length replacement-length)]
    (do
      (if (!= (load (field replacement location)) (primitive/cast u64 -1))
          (do
            (editable/text-field-unmark! (mut editor))
            (apply-replacement! editor replacement))
          0)
      (editable/text-field-commit! (mut editor) (string-utf8 value))
      0)))

(defn ime-set-marked [(self (ptr i8))
                      (command (ptr i8))
                      (value (ptr i8))
                      (selected-location u64)
                      (selected-length u64)
                      (replacement-location u64)
                      (replacement-length u64)] (-> void)
  (let [state (bridge-state self)
        editor (load (field state editor))
        selected (NSRange :location selected-location :length selected-length)
        replacement (NSRange :location replacement-location :length replacement-length)]
    (do
      (if (!= (load (field replacement location)) (primitive/cast u64 -1))
          (do
            (editable/text-field-unmark! (mut editor))
            (apply-replacement! editor replacement))
          0)
      (editable/text-field-set-marked! (mut editor)
                                       (string-utf8 value)
                                       (primitive/cast i64 (load (field selected location)))
                                       (primitive/cast i64 (load (field selected length))))
      0)))

(defn ime-unmark [(self (ptr i8)) (command (ptr i8))] (-> void)
  (let [state (bridge-state self)
        editor (load (field state editor))]
    (do
      (editable/text-field-unmark! (mut editor))
      0)))

(defn ime-attributed-substring [(self (ptr i8))
                                (command (ptr i8))
                                (range-location u64)
                                (range-length u64)
                                (actual-range (ptr NSRange))] (-> (ptr i8))
  (if (= range-location (primitive/cast u64 -1))
      (primitive/cast (ptr i8) 0)
      (let [state (bridge-state self)
            editor (load (field state editor))
            full
              (msg (ptr i8)
                   (class c"NSString")
                   (sel c"stringWithUTF8String:")
                   [(ptr i8)]
                   (editable/text-field-bytes (load editor)))
            total (msg u64 full (sel c"length") [])
            location (if (> range-location total) total range-location)
            available (- total location)
            length (if (> range-length available) available range-length)
            range (NSRange :location location :length length)
            substring
              (msg (ptr i8)
                   full
                   (sel c"substringWithRange:")
                   [NSRange]
                   range)
            attributed
              (msg (ptr i8)
                   (msg (ptr i8) (class c"NSAttributedString") (sel c"alloc") [])
                   (sel c"initWithString:")
                   [(ptr i8)]
                   substring)]
        (do
          (if (!= (primitive/cast i64 actual-range) 0)
              (store! actual-range range)
              0)
          (msg (ptr i8) attributed (sel c"autorelease") [])))))

(defn ime-character-index [(self (ptr i8))
                           (command (ptr i8))
                           (point-x f64)
                           (point-y f64)] (-> u64)
  (let [state (bridge-state self)
        editor (load (field state editor))]
    (primitive/cast u64
                    (utf8-byte-to-utf16 (editable/text-field-bytes (load editor))
                                        (editable/text-field-caret (load editor))))))

(defn ime-do-command [(self (ptr i8))
                      (command (ptr i8))
                      (selector (ptr i8))] (-> void)
  (let [state (bridge-state self)
        editor (load (field state editor))]
    (do
      (cond (= (primitive/cast i64 selector)
               (primitive/cast i64 (sel c"deleteBackward:")))
              (do (editable/text-field-backspace! (mut editor)) 0)
            (= (primitive/cast i64 selector)
               (primitive/cast i64 (sel c"deleteForward:")))
              (do (editable/text-field-delete-forward! (mut editor)) 0)
            (= (primitive/cast i64 selector) (primitive/cast i64 (sel c"moveLeft:")))
              (do (editable/text-field-move-left! (mut editor) false) 0)
            (= (primitive/cast i64 selector) (primitive/cast i64 (sel c"moveRight:")))
              (do (editable/text-field-move-right! (mut editor) false) 0)
            (= (primitive/cast i64 selector)
               (primitive/cast i64 (sel c"moveLeftAndModifySelection:")))
              (do (editable/text-field-move-left! (mut editor) true) 0)
            (= (primitive/cast i64 selector)
               (primitive/cast i64 (sel c"moveRightAndModifySelection:")))
              (do (editable/text-field-move-right! (mut editor) true) 0)
            :else 0)
      0)))

(defn ime-accepts-first-responder [(self (ptr i8)) (command (ptr i8))] (-> i8)
  (primitive/cast i8 1))

(defn add-method! [(class-object (ptr i8))
                   (name (ptr i8))
                   (implementation (ptr i8))
                   (encoding (ptr i8))] (-> i64)
  (do
    (class_addMethod class-object (sel name) implementation encoding)
    0))

(defn input-view-class [] (-> (ptr i8))
  (let [existing (objc_lookUpClass c"CoilGPUTextInputView")]
    (if (!= (primitive/cast i64 existing) 0)
        existing
        (let [view-class (objc_allocateClassPair (class c"NSView") c"CoilGPUTextInputView" 0)]
          (do
            (class_addIvar view-class c"_coilInputState" 8 3 c"^v")
            (class_addProtocol view-class (objc_getProtocol c"NSTextInputClient"))
            (add-method! view-class
                         c"validAttributesForMarkedText"
                         (primitive/cast (ptr i8) (primitive/fnptr-of ime-valid-attributes))
                         c"@@:")
            (add-method! view-class
                         c"hasMarkedText"
                         (primitive/cast (ptr i8) (primitive/fnptr-of ime-has-marked))
                         c"c@:")
            (add-method! view-class
                         c"markedRange"
                         (primitive/cast (ptr i8) (primitive/fnptr-of ime-marked-range))
                         c"{_NSRange=QQ}@:")
            (add-method! view-class
                         c"selectedRange"
                         (primitive/cast (ptr i8) (primitive/fnptr-of ime-selected-range))
                         c"{_NSRange=QQ}@:")
            (add-method! view-class
                         c"firstRectForCharacterRange:actualRange:"
                         (primitive/cast (ptr i8) (primitive/fnptr-of ime-first-rect))
                         c"{CGRect={CGPoint=dd}{CGSize=dd}}@:{_NSRange=QQ}^{_NSRange=QQ}")
            (add-method! view-class
                         c"insertText:replacementRange:"
                         (primitive/cast (ptr i8) (primitive/fnptr-of ime-insert-text))
                         c"v@:@{_NSRange=QQ}")
            (add-method! view-class
                         c"setMarkedText:selectedRange:replacementRange:"
                         (primitive/cast (ptr i8) (primitive/fnptr-of ime-set-marked))
                         c"v@:@{_NSRange=QQ}{_NSRange=QQ}")
            (add-method! view-class
                         c"unmarkText"
                         (primitive/cast (ptr i8) (primitive/fnptr-of ime-unmark))
                         c"v@:")
            (add-method! view-class
                         c"attributedSubstringForProposedRange:actualRange:"
                         (primitive/cast (ptr i8) (primitive/fnptr-of ime-attributed-substring))
                         c"@@:{_NSRange=QQ}^{_NSRange=QQ}")
            (add-method! view-class
                         c"characterIndexForPoint:"
                         (primitive/cast (ptr i8) (primitive/fnptr-of ime-character-index))
                         c"Q@:{CGPoint=dd}")
            (add-method! view-class
                         c"doCommandBySelector:"
                         (primitive/cast (ptr i8) (primitive/fnptr-of ime-do-command))
                         c"v@::")
            (add-method! view-class
                         c"acceptsFirstResponder"
                         (primitive/cast (ptr i8) (primitive/fnptr-of ime-accepts-first-responder))
                         c"c@:")
            (objc_registerClassPair view-class)
            view-class)))))

(defn text-input-view-new [(bridge (ptr TextInputBridge))
                           (width f64)
                           (height f64)] (-> (ptr i8))
  (let [view
          (msg (ptr i8)
               (msg (ptr i8) (input-view-class) (sel c"alloc") [])
               (sel c"initWithFrame:")
               [NSRect]
               (NSRect
                 :x 0.0
                 :y 0.0
                 :w width
                 :h height))
        ivar (class_getInstanceVariable (object_getClass view) c"_coilInputState")]
    (do
      (let [slot
              (primitive/cast (ptr (ptr TextInputBridge))
                              (+ (primitive/cast i64 view) (ivar_getOffset ivar)))]
        (store! slot bridge))
      (msg i64 view (sel c"setWantsLayer:") [i8] (primitive/cast i8 1))
      (msg i64 view (sel c"setAutoresizingMask:") [u64] 18)
      view)))

(defn text-input-handle-event! [(view (ptr i8))
                                (event (ptr i8))] (-> bool)
  (let [context (msg (ptr i8) view (sel c"inputContext") [])]
    (!= (msg i8 context (sel c"handleEvent:") [(ptr i8)] event) (primitive/cast i8 0))))

(defn text-input-set-first-rect! [(bridge (mut TextInputBridge))
                                  (x f64)
                                  (y f64)
                                  (width f64)
                                  (height f64)] (-> i64)
  (do
    (set! (.first-rect bridge)
          (NSRect
            :x x
            :y y
            :w width
            :h height))
    0))
