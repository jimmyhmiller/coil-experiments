(extern printf :cc c [(ptr i8) ...] (-> i32))

(defstruct CGRect [(x f64) (y f64) (w f64) (h f64)])

(defstruct CGSize [(w f64) (h f64)])

(defstruct NSPoint [(x f64) (y f64)])

(defstruct DemoState
  [(checked bool)
   (slider f32)
   (progress f32)
   (async-ready bool)
   (async-result i64)])

(defn demo-background-work [(raw (ptr i8)) (cancel (ptr i64))] (-> i64)
  (let [iterations (load (primitive/cast (ptr i64) raw))
        (mut checksum) 1469598103934665603
        (mut i) 0]
    (do
      (while (and (< (load i) iterations)
                  (not (scheduler/scheduler-cancel-requested? cancel)))
        (do
          (set! checksum (primitive/imul (^ (load checksum) (load i)) 1099511628211))
          (set! i (+ (load i) 1))))
      (load checksum))))

(defn demo-background-complete [(raw (ptr i8)) (result i64) (cancelled i64)] (-> i64)
  (let [state (primitive/cast (ptr DemoState) raw)]
    (do
      (when (= cancelled 0)
        (do
          (set! (field state async-result) result)
          (set! (field state async-ready) true)
          0))
      0)))

(defstruct Labels
  [(title text/ShapedLine)
   (primary text/TextTexture)
   (disabled text/TextTexture)
   (checkbox text/TextTexture)
   (slider text/TextTexture)
   (progress text/TextTexture)
   (drop text/TextTexture)
   (inspector text/TextTexture)
   (icon assets/AssetId)])

(defn nsstr [(s (ptr i8))] (-> (ptr i8))
  (msg (ptr i8) (class c"NSString") (sel c"stringWithUTF8String:") [(ptr i8)] s))

(defn make-window [(width f64) (height f64)] (-> (ptr i8))
  (let [window (msg (ptr i8) (class c"NSWindow") (sel c"alloc") [])]
    (do
      (msg (ptr i8)
           window
           (sel c"initWithContentRect:styleMask:backing:defer:")
           [CGRect i64 i64 i8]
           (CGRect
             :x 180.0
             :y 140.0
             :w width
             :h height)
           15
           2
           (primitive/cast i8 0))
      (msg i64 window (sel c"setTitle:") [(ptr i8)] (nsstr c"Coil GPU UI — Metal components"))
      (msg i64
           window
           (sel c"setMinSize:")
           [CGSize]
           (CGSize :w 640.0 :h 480.0))
      window)))

(defn view-rect-to-screen [(window (ptr i8))
                           (view (ptr i8))
                           (rect CGRect)] (-> CGRect)
  (let [window-rect
          (msg CGRect
               view
               (sel c"convertRect:toView:")
               [CGRect (ptr i8)]
               rect
               (primitive/cast (ptr i8) 0))]
    (msg CGRect window (sel c"convertRectToScreen:") [CGRect] window-rect)))

(defn rebuild! [(scene (mut ui/Scene))
                (state DemoState)
                (router input/Router)
                (grid-layout (mut grid/GridLayout))
                (scroll-state (mut scroll/VariableScrollState))
                (labels Labels)
                (asset-cache (mut assets/ImageAssetCache))
                (inspect inspector/InspectorState)
                (editor editable/TextArea)
                (editor-paragraph text/ShapedParagraph)
                (drop-state (mut drag/DropState))
                (canvas path/Tessellation)
                (canvas-stroke path/Tessellation)
                (vector-icon svg/SvgVector)
                (animation-phase f32)
                (width f32)
                (height f32)] (-> i64)
  (do
    (ui/scene-clear! (mut scene))
    (ui/panel! (mut scene)
               (ui/rect 28.0 28.0 (- width 56.0) (- height 56.0))
               (ui/PanelState :elevated true)
               100)
    ;; A 1,024-instance background grid keeps the demo beyond Metal's inline
    ;; byte ceiling and continuously exercises the growable shared-buffer ring.
    (for [i 0 1024]
      (let [column (% i 64)
            row (/ i 64)
            x
              (+ (primitive/cast f32 42.0)
                 (* (primitive/cast f32 column) (/ (- width 84.0) 63.0)))
            y
              (+ (primitive/cast f32 42.0)
                 (* (primitive/cast f32 row) (/ (- height 84.0) 15.0)))]
        (ui/scene-rounded-rect! (mut scene)
                                (ui/rect x y 1.5 1.5)
                                (ui/rgba 0.55 0.68 1.0 0.10)
                                0.75
                                0.0
                                (ui/rgba 0.0 0.0 0.0 0.0)
                                -100)))
    (ui/scene-linear-gradient! (mut scene)
                               (ui/rect 56.0 58.0 (- width 112.0) 72.0)
                               (ui/rgb 0.12 0.16 0.26)
                               (ui/rgb 0.24 0.18 0.36)
                               105.0
                               10.0
                               101)
    (ui/scene-slash-pattern! (mut scene)
                             (ui/rect 56.0 58.0 (- width 112.0) 72.0)
                             (ui/rgba 0.82 0.88 1.0 0.10)
                             4.5
                             7.5
                             10.0
                             204)
    (let [drop-bounds (ui/rect (- width 300.0) 72.0 170.0 44.0)]
      (do
        (drag/drop-target! (mut scene) (mut drop-state) drop-bounds 8)
        (text/paint-text! (mut scene)
                          (load (field labels drop))
                          (+ (load (field drop-bounds x)) 14.0)
                          (+ (load (field drop-bounds y)) 10.0)
                          (ui/rgb 0.88 0.92 1.0)
                          209)))
    ;; A concave vector mark exercises Coil ear clipping and the ordered Metal
    ;; triangle pipeline between ordinary scene primitives.
    (ui/scene-path-fill! (mut scene) canvas (ui/rgb 0.98 0.74 0.24) 207)
    (ui/scene-path-fill! (mut scene) canvas-stroke (ui/rgba 0.50 0.72 1.0 0.9) 208)
    (let [center-x (- width 90.0)
          center-y (primitive/cast f32 92.0)
          rotation (* (load (field state progress)) 360.0)
          transform
            (ui/affine-multiply (ui/affine-translate center-x center-y)
                                (ui/affine-multiply (ui/affine-rotate rotation)
                                                    (ui/affine-translate (- (primitive/cast f32 0.0) center-x)
                                                                         (- (primitive/cast f32 0.0) center-y))))
          prior-transform (ui/scene-push-transform! (mut scene) transform)]
      (do
        (let [prior-opacity (ui/scene-push-opacity! (mut scene) 0.82)]
          (do
            (assets/image-asset-cache-paint-fit-rounded! (mut asset-cache)
                                                         (mut scene)
                                                         (load (field labels icon))
                                                         (ui/rect (- width 128.0) 66.0 76.0 52.0)
                                                         (image/FitCover)
                                                         (ui/rgb 1.0 1.0 1.0)
                                                         (not (load (field state async-ready)))
                                                         10.0
                                                         206)
            (ui/scene-pop-opacity! (mut scene) prior-opacity)))
        (ui/scene-pop-transform! (mut scene) prior-transform)))
    (grid/grid-clear! (mut grid-layout))
    (grid/grid-fraction-track! (mut grid-layout) true 140.0 1.0 0.0)
    (grid/grid-fraction-track! (mut grid-layout) true 140.0 1.0 0.0)
    (grid/grid-fixed-track! (mut grid-layout) false 44.0)
    (grid/grid-place! (mut grid-layout) 0 0 1 1)
    (grid/grid-place! (mut grid-layout) 1 0 1 1)
    (grid/grid-compute! (mut grid-layout)
                        (ui/rect 56.0 158.0 (- width 112.0) 44.0)
                        16.0
                        0.0
                        (ui/EdgeInsets
                          :top 0.0
                          :right 0.0
                          :bottom 0.0
                          :left 0.0))
    (ui/button! (mut scene)
                (grid/grid-rect (load grid-layout) 0)
                (ui/ButtonState
                  :hovered (= (load (field router hovered)) 1)
                  :pressed (= (load (field router pressed)) 1)
                  :focused (= (load (field router focused)) 1)
                  :disabled false)
                1)
    (ui/button! (mut scene)
                (grid/grid-rect (load grid-layout) 1)
                (ui/ButtonState
                  :hovered (= (load (field router hovered)) 2)
                  :pressed (= (load (field router pressed)) 2)
                  :focused (= (load (field router focused)) 2)
                  :disabled true)
                2)
    (ui/checkbox! (mut scene)
                  (ui/rect 56.0 232.0 28.0 28.0)
                  (ui/CheckboxState
                    :checked (load (field state checked))
                    :hovered (= (load (field router hovered)) 3)
                    :focused (= (load (field router focused)) 3)
                    :disabled false)
                  3)
    (ui/slider! (mut scene)
                (ui/rect 56.0 294.0 (- (/ width 2.0) 80.0) 32.0)
                (ui/SliderState
                  :value (load (field state slider))
                  :minimum 0.0
                  :maximum 1.0
                  :hovered (= (load (field router hovered)) 4)
                  :focused (= (load (field router focused)) 4))
                4)
    (ui/progress! (mut scene)
                  (ui/rect 56.0 354.0 (- (/ width 2.0) 80.0) 12.0)
                  (ui/ProgressState :value (load (field state progress)))
                  5)
    ;; This GPU badge is driven by a real Coil pthread task whose completion is
    ;; delivered by the owner-thread scheduler. It turns green after the joined
    ;; worker publishes its checksum.
    (ui/scene-rounded-rect! (mut scene)
                            (ui/rect (- (/ width 2.0) 10.0) 350.0 12.0 20.0)
                            (if (load (field state async-ready))
                                (ui/rgb 0.28 0.90 0.58)
                                (ui/rgb 0.96 0.68 0.24))
                            6.0
                            0.0
                            (ui/rgba 0.0 0.0 0.0 0.0)
                            205)
    (ui/divider! (mut scene)
                 (ui/rect 56.0 398.0 (- (/ width 2.0) 80.0) 1.0)
                 (ui/DividerState :vertical false)
                 6)
    (editable/text-area-paint! (mut scene)
                               editor
                               editor-paragraph
                               (ui/rect 56.0 414.0 (- (/ width 2.0) 80.0) 116.0)
                               7)
    (text/paint-shaped-line! (mut scene)
                             (load (field labels title))
                             64.0
                             74.0
                             (ui/rgb 0.95 0.97 1.0)
                             2000)
    (let [center-x (primitive/cast f32 382.0)
          center-y (primitive/cast f32 85.0)
          animated-transform
            (ui/affine-multiply
              (ui/affine-translate center-x center-y)
              (ui/affine-multiply
                (ui/affine-rotate (* animation-phase 360.0))
                (ui/affine-translate (- (primitive/cast f32 0.0) center-x)
                                     (- (primitive/cast f32 0.0) center-y))))
          prior-animation
            (ui/scene-push-transform! (mut scene) animated-transform)]
      (do
        (svg/svg-vector-paint! (mut scene)
                               vector-icon
                               (ui/rect 365.0 68.0 34.0 34.0)
                               (ui/rgb 0.35 0.82 1.0)
                               2100)
        (ui/scene-pop-transform! (mut scene) prior-animation)))
    (text/paint-text! (mut scene) (load (field labels primary)) 84.0 168.0 (ui/rgb 1.0 1.0 1.0) 201)
    (text/paint-text! (mut scene) (load (field labels disabled)) 278.0 168.0 (ui/rgba 1.0 1.0 1.0 0.55) 202)
    (text/paint-text! (mut scene) (load (field labels checkbox)) 96.0 234.0 (ui/rgb 0.88 0.90 0.95) 203)
    (text/paint-text! (mut scene) (load (field labels slider)) 56.0 274.0 (ui/rgb 0.70 0.74 0.82) 204)
    (text/paint-text! (mut scene) (load (field labels progress)) 56.0 334.0 (ui/rgb 0.70 0.74 0.82) 205)
    (scroll/variable-scroll-configure! (mut scroll-state)
                                       (ui/rect (+ (/ width 2.0) 20.0)
                                                220.0
                                                (- (/ width 2.0) 76.0)
                                                (- height 264.0)))
    (let [prior (scroll/variable-scroll-begin! (mut scene) (load scroll-state) 900)
          first (scroll/variable-visible-first (load scroll-state))
          last (scroll/variable-visible-last (load scroll-state))]
      (do
        (for [index first last]
          (let [measured-height
                  (+ (primitive/cast f32 22.0)
                     (primitive/cast f32 (* (% index 5) 4)))]
            (do
              (scroll/variable-scroll-measure! (mut scroll-state) index measured-height)
              (let [row (scroll/variable-item-rect (load scroll-state) index)
                    inner
                      (ui/inset row
                                (ui/EdgeInsets
                                  :top 2.0
                                  :right 10.0
                                  :bottom 2.0
                                  :left 4.0))
                    tone
                      (if (= (% index 2) 0)
                          (ui/rgba 0.18 0.22 0.30 0.78)
                          (ui/rgba 0.14 0.17 0.23 0.78))
                    bar-width
                      (+ (primitive/cast f32 28.0)
                         (primitive/cast f32 (% (* index 37) 180)))]
                (do
                  (ui/scene-rounded-rect! (mut scene)
                                          inner
                                          tone
                                          4.0
                                          0.0
                                          (ui/rgba 0.0 0.0 0.0 0.0)
                                          (primitive/cast i32 (+ 10000 index)))
                  (ui/scene-rounded-rect! (mut scene)
                                          (ui/rect (+ (load (field inner x)) 8.0)
                                                   (+ (load (field inner y)) 8.0)
                                                   bar-width
                                                   6.0)
                                          (ui/rgba 0.48 0.63 0.96 0.72)
                                          3.0
                                          0.0
                                          (ui/rgba 0.0 0.0 0.0 0.0)
                                          (primitive/cast i32 (+ 20000 index))))))))
        (scroll/variable-scroll-end! (mut scene) prior)))
    (scroll/variable-scrollbar! (mut scene) (load scroll-state) 901)
    (inspector/inspector-paint! inspect
                                (mut scene)
                                (ui/rect 0.0 0.0 width height))
    (if (inspector/inspector-enabled? inspect)
        (text/paint-text! (mut scene)
                          (load (field labels inspector))
                          (- width 184.0)
                          18.0
                          (ui/rgb 0.78 0.90 1.0)
                          -9020)
        0)
    0))

(defn apply-action! [(state (mut DemoState)) (event input/ActionEvent)] (-> i64)
  (let [action (load (field event action))
        target (load (field event target))]
    (do
      (if (and (= action (primitive/cast i32 input/action-activate)) (= target 3))
          (set! (.checked state) (not (load (field state checked))))
          0)
      (if (and (= action (primitive/cast i32 input/action-activate)) (= target 1))
          (set! (.progress state) 0.0)
          0)
      (if (and (= action (primitive/cast i32 input/action-decrement)) (= target 4))
          (set! (.slider state)
                (let [value (- (load (field state slider)) 0.05)] (if (< value 0.0) 0.0 value)))
          0)
      (if (and (= action (primitive/cast i32 input/action-increment)) (= target 4))
          (set! (.slider state)
                (let [value (+ (load (field state slider)) 0.05)] (if (> value 1.0) 1.0 value)))
          0)
      0)))

(defn apply-access-action! [(state (mut DemoState)) (packed i64)] (-> i64)
  (let [action (primitive/cast i32 (& packed 4294967295))
        target (primitive/cast i32 (>> packed 32))
        mapped
          (cond (= action (access/ActionPress)) (primitive/cast i32 input/action-activate)
                (= action (access/ActionIncrement)) (primitive/cast i32 input/action-increment)
                (= action (access/ActionDecrement)) (primitive/cast i32 input/action-decrement)
                :else 0)]
    (if (= mapped 0)
        0
        (apply-action! (mut state) (input/ActionEvent :action mapped :target target)))))

(defn sync-accessibility! [(tree (mut access/AccessTree))
                           (state DemoState)
                           (router input/Router)
                           (grid-layout grid/GridLayout)
                           (editor editable/TextField)
                           (width f32)] (-> i64)
  (let [primary (access/access-tree-node (mut tree) 0)
        disabled (access/access-tree-node (mut tree) 1)
        checkbox (access/access-tree-node (mut tree) 2)
        slider (access/access-tree-node (mut tree) 3)
        progress (access/access-tree-node (mut tree) 4)
        field (access/access-tree-node (mut tree) 5)]
    (do
      (store! (field primary bounds) (grid/grid-rect grid-layout 0))
      (access/access-node-set-focused! primary (= (load (field router focused)) 1))
      (store! (field disabled bounds) (grid/grid-rect grid-layout 1))
      (store! (field disabled enabled) false)
      (access/access-node-set-focused! disabled (= (load (field router focused)) 2))
      (store! (field checkbox bounds) (ui/rect 56.0 232.0 28.0 28.0))
      (access/access-node-set-value! checkbox (if (load (field state checked)) 1.0 0.0))
      (access/access-node-set-focused! checkbox (= (load (field router focused)) 3))
      (store! (field slider bounds) (ui/rect 56.0 294.0 (- (/ width 2.0) 80.0) 32.0))
      (access/access-node-set-value! slider (primitive/cast f64 (load (field state slider))))
      (access/access-node-set-focused! slider (= (load (field router focused)) 4))
      (store! (field progress bounds) (ui/rect 56.0 354.0 (- (/ width 2.0) 80.0) 12.0))
      (store! (field progress value) (primitive/cast f64 (load (field state progress))))
      (store! (field field bounds) (ui/rect 56.0 414.0 (- (/ width 2.0) 80.0) 116.0))
      (access/access-node-set-text! field
                                    (editable/text-field-bytes editor)
                                    (editable/text-field-revision editor))
      (access/access-node-set-focused! field (load (field editor focused)))
      0)))

(defn platform-modifiers [(flags i64)] (-> i32)
  (let [(mut modifiers) (primitive/cast i32 0)]
    (do
      (if (!= (& flags 131072) 0)
          (store! modifiers (| (load modifiers) (primitive/cast i32 keymap/modifier-shift)))
          0)
      (if (!= (& flags 262144) 0)
          (store! modifiers (| (load modifiers) (primitive/cast i32 keymap/modifier-control)))
          0)
      (if (!= (& flags 524288) 0)
          (store! modifiers (| (load modifiers) (primitive/cast i32 keymap/modifier-alt)))
          0)
      (if (!= (& flags 1048576) 0)
          (store! modifiers (| (load modifiers) (primitive/cast i32 keymap/modifier-command)))
          0)
      (load modifiers))))

(defn ensure-editor-layout! [(editor editable/TextArea)
                             (paragraph (mut text/ShapedParagraph))
                             (atlas (mut text/TextAtlas))
                             (revision (mut i64))
                             (retained-width (mut f32))
                             (layout-width f32)] (-> bool)
  (let [field-value (editable/text-area-field editor)]
    (if (or (!= (editable/text-field-revision field-value) (load revision))
            (or (< layout-width (load retained-width))
                (> layout-width (load retained-width))))
        (do
          (text/shaped-paragraph-free! (mut paragraph))
          (store! paragraph
                  (text/text-shape-paragraph! (mut atlas)
                                              (editable/text-field-bytes field-value)
                                              16.0
                                              layout-width
                                              20.0
                                              0))
          (store! revision (editable/text-field-revision field-value))
          (store! retained-width layout-width)
          true)
        false)))

(defn pump! [(app (ptr i8))
             (window (ptr i8))
             (view (ptr i8))
             (mode (ptr i8))
             (scene ui/Scene)
             (state (ptr DemoState))
             (router (mut input/Router))
             (key-map (mut keymap/Keymap))
             (key-dispatcher (mut keymap/KeyDispatcher))
             (editor (mut editable/TextArea))
             (editor-paragraph (mut text/ShapedParagraph))
             (text-atlas (mut text/TextAtlas))
             (editor-revision (mut i64))
             (editor-layout-width (mut f32))
             (inspect (mut inspector/InspectorState))
             (scroll-state (mut scroll/VariableScrollState))
             (width f32)
             (height f32)] (-> i64)
  (while 1
    (let [event
            (msg (ptr i8)
                 app
                 (sel c"nextEventMatchingMask:untilDate:inMode:dequeue:")
                 [i64 (ptr i8) (ptr i8) i8]
                 -1
                 (primitive/cast (ptr i8) 0)
                 mode
                 (primitive/cast i8 1))]
      (if (= (primitive/cast i64 event) 0)
          (break 0)
          (let [kind (msg i64 event (sel c"type") [])
                (mut dispatch-to-app) true]
            (do
              (if (or (= kind 1) (or (= kind 2) (or (= kind 5) (= kind 6))))
                  (let [point (msg NSPoint event (sel c"locationInWindow") [])
                        x (primitive/cast f32 (load (field point x)))
                        y (- height (primitive/cast f32 (load (field point y))))]
                    (do
                      (if (inspector/inspector-enabled? (load inspect))
                          (do
                            (inspector/inspector-pick! (mut inspect) scene x y 0)
                            (if (or (= kind 1) (= kind 2))
                                (store! dispatch-to-app false)
                                0)
                            0)
                          0)
                      (if (and (= kind 1)
                               (not (inspector/inspector-enabled? (load inspect))))
                          (let [target (input/router-pointer-down! (mut router) scene x y)]
                            (do
                              (set! (.focused (.field editor)) (= target 7))
                              (if (= target 7)
                                  (do
                                    (msg i64 window (sel c"makeFirstResponder:") [(ptr i8)] view)
                                    (editable/text-area-set-caret-from-point! (mut editor)
                                                                              (load editor-paragraph)
                                                                              (- x 66.0)
                                                                              (- y 422.0)
                                                                              false))
                                  0)))
                          0)
                      (if (and (or (= kind 5) (= kind 6))
                               (not (inspector/inspector-enabled? (load inspect))))
                          (input/router-pointer-move! (mut router) scene x y)
                          0)
                      (if (and (= kind 2)
                               (not (inspector/inspector-enabled? (load inspect))))
                          (apply-action! (mut state) (input/router-pointer-up! (mut router) scene x y))
                          0)
                      (if (and (not (inspector/inspector-enabled? (load inspect)))
                               (and (= (load (field router pressed)) 4)
                                    (or (= kind 1) (= kind 6))))
                          (let [v (/ (- x 56.0) (- width 112.0))]
                            (set! (.slider state) (cond (< v 0.0) 0.0 (> v 1.0) 1.0 :else v)))
                          0)
                      0))
                  0)
              (if (= kind 10)
                  (let [key (msg i64 event (sel c"keyCode") [])
                        modifiers (platform-modifiers (msg i64 event (sel c"modifierFlags") []))
                        shift
                          (!= (& modifiers (primitive/cast i32 keymap/modifier-shift))
                              (primitive/cast i32 0))]
                    (if (and (= key 34)
                             (!= (& modifiers (primitive/cast i32 keymap/modifier-command))
                                 (primitive/cast i32 0)))
                        (do
                          (inspector/inspector-toggle! (mut inspect))
                          (store! dispatch-to-app false)
                          1)
                        (if (load (field (field editor field) focused))
                        (if (ime/text-input-handle-event! view event)
                            (do (store! dispatch-to-app false) 1)
                            (cond (= key 51) (if (editable/text-field-backspace! (mut (.field editor))) 1 0)
                                  (= key 117) (if (editable/text-field-delete-forward! (mut (.field editor))) 1 0)
                                  (= key 123) (editable/text-area-move-left! (mut editor) shift)
                                  (= key 124) (editable/text-area-move-right! (mut editor) shift)
                                  (= key 125) (editable/text-area-move-down! (mut editor) (load editor-paragraph) shift)
                                  (= key 126) (editable/text-area-move-up! (mut editor) (load editor-paragraph) shift)
                                  (or (= key 36) (or (= key 48) (= key 53))) 0
                                  (!= (& modifiers
                                         (| (primitive/cast i32 keymap/modifier-command)
                                            (primitive/cast i32 keymap/modifier-control)))
                                      (primitive/cast i32 0))
                                    0
                                  :else
                                    (let [characters (msg (ptr i8) event (sel c"characters") [])
                                          utf8 (msg (ptr i8) characters (sel c"UTF8String") [])]
                                      (editable/text-field-insert! (mut (.field editor)) utf8))))
                        (let [resolution
                                (keymap/key-dispatcher-push! (mut key-dispatcher)
                                                             (load key-map)
                                                             key
                                                             modifiers
                                                             (primitive/cast (ptr i32) 0)
                                                             0)]
                          (apply-action! (mut state)
                                         (input/router-keymap! (mut router) scene resolution))))))
                  0)
              (if (= kind 22)
                  (let [point (msg NSPoint event (sel c"locationInWindow") [])
                        x (primitive/cast f32 (load (field point x)))
                        y (- height (primitive/cast f32 (load (field point y))))
                        delta (primitive/cast f32 (msg f64 event (sel c"scrollingDeltaY") []))]
                    (if (inspector/inspector-enabled? (load inspect))
                        (do
                          (inspector/inspector-pick! (mut inspect)
                                                     scene
                                                     x
                                                     y
                                                     (if (> delta 0.0) 1 -1))
                          (store! dispatch-to-app false)
                          1)
                        (if (ui/contains? (load (field scroll-state viewport)) x y)
                            (do
                              (scroll/variable-scroll-by! (mut scroll-state)
                                                          (- (primitive/cast f32 0.0) delta))
                              1)
                            0)))
                  0)
              (if (load dispatch-to-app)
                  (msg i64 app (sel c"sendEvent:") [(ptr i8)] event)
                  0)
              (ensure-editor-layout! (load editor)
                                     (mut editor-paragraph)
                                     (mut text-atlas)
                                     (mut editor-revision)
                                     (mut editor-layout-width)
                                     (- (/ width 2.0) 100.0))
              0))))))

(defn main [] (-> i64)
  (let [pool (msg (ptr i8) (msg (ptr i8) (class c"NSAutoreleasePool") (sel c"alloc") []) (sel c"init") [])
        app (msg (ptr i8) (class c"NSApplication") (sel c"sharedApplication") [])
        window (make-window 820.0 600.0)
        (mut view) (primitive/cast (ptr i8) 0)
        mode (nsstr c"kCFRunLoopDefaultMode")
        scale (primitive/cast f32 (msg f64 window (sel c"backingScaleFactor") []))
        (mut renderer) (primitive/zeroed metal/Renderer)
        (mut scene) (primitive/zeroed ui/Scene)
        (mut state-store) (primitive/zeroed (retained/EntityStore DemoState))
        (mut state-id) (primitive/zeroed retained/EntityId)
        (mut reactive-graph) (primitive/zeroed reactive/ReactiveGraph)
        (mut scene-consumer) (primitive/zeroed reactive/ConsumerId)
        (mut inspect) (primitive/zeroed inspector/InspectorState)
        (mut router) (primitive/zeroed input/Router)
        (mut key-map) (primitive/zeroed keymap/Keymap)
        (mut key-dispatcher) (primitive/zeroed keymap/KeyDispatcher)
        (mut grid-layout) (primitive/zeroed grid/GridLayout)
        (mut scroll-state) (primitive/zeroed scroll/VariableScrollState)
        (mut labels) (primitive/zeroed Labels)
        (mut asset-cache) (primitive/zeroed assets/ImageAssetCache)
        (mut text-atlas) (primitive/zeroed text/TextAtlas)
        (mut editor) (primitive/zeroed editable/TextArea)
        (mut input-bridge) (primitive/zeroed ime/TextInputBridge)
        (mut access-tree) (primitive/zeroed access/AccessTree)
        (mut drop-state) (primitive/zeroed drag/DropState)
        (mut frame-clock) (primitive/zeroed clock/FrameClock)
        (mut task-scheduler) (primitive/zeroed scheduler/Scheduler)
        (mut demo-task-scope) (primitive/zeroed scheduler/TaskScope)
        async-input (primitive/alloc-stack i64)
        (mut editor-paragraph) (primitive/zeroed text/ShapedParagraph)
        (mut editor-revision) 0
        (mut editor-layout-width) (primitive/cast f32 0.0)
        (mut canvas-path) (primitive/zeroed path/Path)
        (mut canvas) (primitive/zeroed path/Tessellation)
        (mut stroke-path) (primitive/zeroed path/Path)
        (mut canvas-stroke) (primitive/zeroed path/Tessellation)
        (mut vector-icon) (primitive/zeroed svg/SvgVector)
        (mut icon-animation) (primitive/zeroed animation/Animation)
        (mut dash-pattern) (primitive/zeroed (al/ArrayList f32))
        (mut damage-tracker) (primitive/zeroed ui/DamageTracker)
        (mut width) (primitive/cast f32 820.0)
        (mut height) (primitive/cast f32 600.0)]
    (do
      (store! scene (ui/scene-new))
      (store! frame-clock (clock/frame-clock-new))
      (store! task-scheduler (scheduler/scheduler-new))
      (store! demo-task-scope (scheduler/task-scope-new))
      (scheduler/scheduler-set-wake! (mut task-scheduler)
                                     (primitive/fnptr-of clock/frame-clock-wake!)
                                     (clock/frame-clock-wake-context frame-clock))
      (store! async-input 4000000)
      (store! damage-tracker (ui/damage-tracker-new))
      (store! vector-icon
              (svg/svg-vector-new
                c"M12 0 L24 0 L17 10 H27 L8 32 L13 17 H3 Z"
                0.15))
      (store! icon-animation
              (animation/animation-repeat
                (animation/animation-new (animation/animation-now)
                                         0.0
                                         2.0
                                         (animation/easing-ease-in-out))
                0
                false))
      (store! router (input/router-new))
      (store! reactive-graph (reactive/reactive-graph-new))
      (store! scene-consumer (reactive/reactive-register-consumer! (mut reactive-graph)))
      (store! inspect (inspector/inspector-new))
      (store! state-store (retained/entity-store-new [DemoState]))
      (let [(mut initial-state) (primitive/zeroed DemoState)]
        (store! state-id
                (retained/entity-store-create! [DemoState]
                                               (mut state-store)
                                               (load initial-state))))
      (store! key-map (keymap/keymap-new))
      (store! key-dispatcher (keymap/key-dispatcher-new))
      (keymap/keymap-bind! (mut key-map)
                           48
                           0
                           -1
                           (primitive/cast i32 input/action-focus-next))
      (keymap/keymap-bind! (mut key-map)
                           48
                           (primitive/cast i32 keymap/modifier-shift)
                           -1
                           (primitive/cast i32 input/action-focus-previous))
      (keymap/keymap-bind! (mut key-map)
                           36
                           0
                           -1
                           (primitive/cast i32 input/action-activate))
      (keymap/keymap-bind! (mut key-map)
                           49
                           0
                           -1
                           (primitive/cast i32 input/action-activate))
      (keymap/keymap-bind! (mut key-map)
                           123
                           0
                           -1
                           (primitive/cast i32 input/action-decrement))
      (keymap/keymap-bind! (mut key-map)
                           124
                           0
                           -1
                           (primitive/cast i32 input/action-increment))
      (store! grid-layout (grid/grid-new))
      (store! scroll-state (scroll/variable-scroll-new 100000 30.0 3))
      (store! editor
              (editable/text-area-new
                c"Edit GPU text across multiple lines. CoreText shapes Unicode; Metal composites every cached glyph.\nTry emoji 😀, selection, IME, and vertical arrows."))
      (store! input-bridge
              (ime/text-input-bridge-new (editable/text-area-field-ptr (mut editor))))
      (store! view (ime/text-input-view-new (mut input-bridge) 820.0 600.0))
      (msg i64 window (sel c"setContentView:") [(ptr i8)] (load view))
      (store! drop-state (drag/drop-state-new))
      (drag/drop-state-attach! (mut drop-state) (load view))
      (store! access-tree (access/access-tree-new 6))
      (access/access-tree-add! (mut access-tree)
                               1
                               (access/RoleButton)
                               (ui/rect 0.0 0.0 0.0 0.0)
                               c"Primary action"
                               c"primary-action")
      (access/access-tree-add! (mut access-tree)
                               2
                               (access/RoleButton)
                               (ui/rect 0.0 0.0 0.0 0.0)
                               c"Disabled"
                               c"disabled-action")
      (access/access-tree-add! (mut access-tree)
                               3
                               (access/RoleCheckbox)
                               (ui/rect 0.0 0.0 0.0 0.0)
                               c"GPU-rendered controls"
                               c"gpu-controls")
      (access/access-tree-add! (mut access-tree)
                               4
                               (access/RoleSlider)
                               (ui/rect 0.0 0.0 0.0 0.0)
                               c"Interactive slider"
                               c"interactive-slider")
      (access/access-tree-add! (mut access-tree)
                               5
                               (access/RoleProgress)
                               (ui/rect 0.0 0.0 0.0 0.0)
                               c"Animated progress"
                               c"animated-progress")
      (access/access-tree-add! (mut access-tree)
                               7
                               (access/RoleTextField)
                               (ui/rect 0.0 0.0 0.0 0.0)
                               c"GPU multiline text editor"
                               c"gpu-text-area")
      (access/access-tree-attach! (mut access-tree) (load view))
      (store! renderer (metal/renderer-new (load view) 820.0 600.0 scale))
      (store! text-atlas (text/text-atlas-new (load (field renderer device)) 2048 1024 2 scale))
      (store! asset-cache
              (assets/image-asset-cache-new (load (field renderer device)) 67108864))
      (store! editor-layout-width (- (/ (load width) 2.0) 100.0))
      (store! editor-paragraph
              (text/text-shape-paragraph! (mut text-atlas)
                                          (editable/text-field-bytes (editable/text-area-field editor))
                                          16.0
                                          (load editor-layout-width)
                                          20.0
                                          0))
      (ime/text-input-bridge-set-text-area! (mut input-bridge)
                                             (mut editor)
                                             (mut editor-paragraph))
      (store! editor-revision
              (editable/text-field-revision (editable/text-area-field editor)))
      (store! canvas-path (path/path-new))
      (path/path-move-to! (mut canvas-path) 70.0 72.0)
      (path/path-line-to! (mut canvas-path) 88.0 72.0)
      (path/path-line-to! (mut canvas-path) 80.0 88.0)
      (path/path-line-to! (mut canvas-path) 96.0 88.0)
      (path/path-line-to! (mut canvas-path) 72.0 116.0)
      (path/path-line-to! (mut canvas-path) 78.0 94.0)
      (path/path-line-to! (mut canvas-path) 64.0 94.0)
      (path/path-close! (mut canvas-path))
      (store! canvas (path/path-tessellate canvas-path))
      (store! stroke-path (path/path-new))
      (path/path-move-to! (mut stroke-path) 108.0 108.0)
      (path/path-cubic-to! (mut stroke-path) 126.0 62.0 152.0 136.0 172.0 82.0 0.2)
      (path/path-quadratic-to! (mut stroke-path) 188.0 56.0 204.0 90.0 0.2)
      (path/path-arc! (mut stroke-path) 204.0 105.0 15.0 15.0 -90.0 270.0 0.2)
      (store! dash-pattern (al/al-new [f32] (alloc/malloc-allocator)))
      (al/al-push! [f32] (mut dash-pattern) 8.0)
      (al/al-push! [f32] (mut dash-pattern) 4.0)
      (store! canvas-stroke
              (path/path-dashed-stroke-tessellate stroke-path
                                                  dash-pattern
                                                  2.0
                                                  3.0
                                                  4.0
                                                  (path/RoundCap)
                                                  (path/RoundJoin)
                                                  0.15))
      (let [(mut full-title)
              (text/text-shape-line! (mut text-atlas)
                                     c"COIL GPU UI — affine components"
                                     26.0)]
        (do
          (set! (.title labels)
                (text/text-truncate-line-end! (mut text-atlas) full-title 26.0 286.0))
          (text/shaped-line-free! (mut full-title))))
      (set! (.primary labels)
            (text/text-atlas-add! (mut text-atlas) c"Primary action" 150 28 15.0))
      (set! (.disabled labels)
            (text/text-atlas-add! (mut text-atlas) c"Disabled" 120 28 15.0))
      (set! (.checkbox labels)
            (text/text-atlas-add! (mut text-atlas) c"GPU-rendered controls" 250 28 16.0))
      (set! (.slider labels)
            (text/text-atlas-add! (mut text-atlas) c"Interactive slider" 180 24 14.0))
      (set! (.progress labels)
            (text/text-atlas-add! (mut text-atlas) c"Animated progress" 180 24 14.0))
      (set! (.drop labels)
            (text/text-atlas-add! (mut text-atlas) c"Drop text or file" 150 24 14.0))
      (set! (.inspector labels)
            (text/text-atlas-add! (mut text-atlas) c"INSPECT · scroll layers · ⌘I" 174 20 11.0))
      (set! (.icon labels)
            (assets/image-asset-cache-load!
              (mut asset-cache)
              c"/System/Library/CoreServices/CoreTypes.bundle/Contents/Resources/GenericApplicationIcon.icns"))
      (let [state (retained/entity-store-get [DemoState] (mut state-store) (load state-id))]
        (do
          (set! (.checked state) true)
          (set! (.slider state) 0.62)
          (scheduler/task-scope-spawn! (mut demo-task-scope)
                                       (mut task-scheduler)
                                       (primitive/fnptr-of demo-background-work)
                                       (primitive/fnptr-of demo-background-complete)
                                       (primitive/cast (ptr i8) async-input)
                                       (primitive/cast (ptr i8) state))))
      (if (not (metal/renderer-valid? renderer))
          (do (printf c"coil-gpui: Metal pipeline creation failed\n") 1)
          (do
            (msg i64 app (sel c"setActivationPolicy:") [i64] 0)
            (msg i64 window (sel c"makeKeyAndOrderFront:") [(ptr i8)] (primitive/cast (ptr i8) 0))
            (msg i64 app (sel c"activateIgnoringOtherApps:") [i8] (primitive/cast i8 1))
            (msg i64 app (sel c"finishLaunching") [])
            (let [state
                    (retained/entity-store-get [DemoState]
                                               (mut state-store)
                                               (load state-id))]
              (do
                (assets/image-asset-cache-begin-frame! (mut asset-cache))
                (reactive/reactive-begin! (mut reactive-graph) scene-consumer)
                (reactive/reactive-observe!
                  (mut reactive-graph)
                  (reactive/dependency-key (load (field state-id type-id))
                                           (load (field state-id slot))
                                           (load (field state-id generation))))
                (rebuild! (mut scene)
                          (load state)
                          router
                          (mut grid-layout)
                          (mut scroll-state)
                          labels
                          (mut asset-cache)
                          inspect
                          editor
                          editor-paragraph
                          (mut drop-state)
                          canvas
                          canvas-stroke
                          vector-icon
                          0.0
                          (load width)
                          (load height))
                (reactive/reactive-end! (mut reactive-graph) scene-consumer)
                (reactive/reactive-clear-dirty! (mut reactive-graph))
                (sync-accessibility! (mut access-tree)
                                     (load state)
                                     router
                                     grid-layout
                                     (editable/text-area-field editor)
                                     (load width))))
            (ui/damage-tracker-advance! (mut damage-tracker)
                                        scene
                                        (ui/rect 0.0 0.0 (load width) (load height)))
            (clock/frame-clock-set-active! (mut frame-clock)
                                           (!= (& (msg u64 window (sel c"occlusionState") [])
                                                  (primitive/cast u64 2))
                                               (primitive/cast u64 0)))
            (while (!= (msg i64 window (sel c"isVisible") []) 0)
              (let [frame-pool
                      (msg (ptr i8) (msg (ptr i8) (class c"NSAutoreleasePool") (sel c"alloc") []) (sel c"init") [])
                    bounds (msg CGRect (load view) (sel c"bounds") [])
                    state
                      (retained/entity-store-get [DemoState]
                                                 (mut state-store)
                                                 (load state-id))]
                (do
                  (scheduler/scheduler-poll! (mut task-scheduler))
                  (set! width (primitive/cast f32 (load (field bounds w))))
                  (set! height (primitive/cast f32 (load (field bounds h))))
                  (metal/renderer-resize! (mut renderer) (load width) (load height) scale)
                  (pump! app
                         window
                         (load view)
                         mode
                         scene
                         state
                         (mut router)
                         (mut key-map)
                         (mut key-dispatcher)
                         (mut editor)
                         (mut editor-paragraph)
                         (mut text-atlas)
                         (mut editor-revision)
                         (mut editor-layout-width)
                         (mut inspect)
                         (mut scroll-state)
                         (load width)
                         (load height))
                  (let [visible
                          (!= (& (msg u64 window (sel c"occlusionState") [])
                                 (primitive/cast u64 2))
                              (primitive/cast u64 0))]
                    (clock/frame-clock-set-active! (mut frame-clock) visible))
                  (apply-access-action! (mut state)
                                        (access/access-tree-take-action! (mut access-tree)))
                  (if (clock/frame-clock-active? frame-clock)
                      (do
                        (ensure-editor-layout! editor
                                               (mut editor-paragraph)
                                               (mut text-atlas)
                                               (mut editor-revision)
                                               (mut editor-layout-width)
                                               (- (/ (load width) 2.0) 100.0))
                        (let [field-value (editable/text-area-field editor)
                              caret-position
                                (text/shaped-paragraph-position-for-index
                                  editor-paragraph
                                  (editable/text-field-caret field-value))
                              caret-height
                                (primitive/cast f64 (load (field caret-position height)))
                              local-caret
                                (CGRect
                                  :x (+ 66.0
                                        (primitive/cast f64 (load (field caret-position x))))
                                  :y (- (primitive/cast f64 (load height))
                                        (+ 422.0
                                           (+ (primitive/cast f64
                                                (load (field caret-position y)))
                                              caret-height)))
                                  :w 1.0
                                  :h caret-height)
                              screen-caret
                                (view-rect-to-screen window (load view) local-caret)
                              screen-origin
                                (view-rect-to-screen
                                  window
                                  (load view)
                                  (CGRect
                                    :x 66.0
                                    :y (- (primitive/cast f64 (load height)) 422.0)
                                    :w 0.0
                                    :h 0.0))]
                          (do
                            (ime/text-input-set-first-rect! (mut input-bridge)
                                                            (load (field screen-caret x))
                                                            (load (field screen-caret y))
                                                            (load (field screen-caret w))
                                                            (load (field screen-caret h)))
                            (ime/text-input-set-layout-origin! (mut input-bridge)
                                                               (load (field screen-origin x))
                                                               (load (field screen-origin y)))))
                        (set! (.progress state) (+ (load (field state progress)) 0.0025))
                        (if (> (load (field state progress)) 1.0) (set! (.progress state) 0.0) 0)
                        (reactive/reactive-notify!
                          (mut reactive-graph)
                          (reactive/dependency-key (load (field state-id type-id))
                                                   (load (field state-id slot))
                                                   (load (field state-id generation))))
                        (assets/image-asset-cache-begin-frame! (mut asset-cache))
                        (reactive/reactive-begin! (mut reactive-graph) scene-consumer)
                        (reactive/reactive-observe!
                          (mut reactive-graph)
                          (reactive/dependency-key (load (field state-id type-id))
                                                   (load (field state-id slot))
                                                   (load (field state-id generation))))
                        (let [icon-sample
                                (animation/animation-sample icon-animation
                                                            (animation/animation-now))]
                          (rebuild! (mut scene)
                                    (load state)
                                    router
                                    (mut grid-layout)
                                    (mut scroll-state)
                                    labels
                                    (mut asset-cache)
                                    inspect
                                    editor
                                    editor-paragraph
                                    (mut drop-state)
                                    canvas
                                    canvas-stroke
                                    vector-icon
                                    (load (field icon-sample value))
                                    (load width)
                                    (load height)))
                        (reactive/reactive-end! (mut reactive-graph) scene-consumer)
                        (reactive/reactive-clear-dirty! (mut reactive-graph))
                        (sync-accessibility! (mut access-tree)
                                             (load state)
                                             router
                                             grid-layout
                                             (editable/text-area-field editor)
                                             (load width))
                        (ui/damage-tracker-advance! (mut damage-tracker)
                                                    scene
                                                    (ui/rect 0.0 0.0 (load width) (load height)))
                        (metal/renderer-draw! (mut renderer) scene))
                      0)
                  (msg i64 frame-pool (sel c"drain") [])
                  (clock/frame-clock-wait! frame-clock))))
            0))
      (text/shaped-line-free! (mut (.title labels)))
      (text/shaped-paragraph-free! (mut editor-paragraph))
      (editable/text-area-free! (mut editor))
      (drag/drop-state-free! (mut drop-state))
      (access/access-tree-free! (mut access-tree))
      (text/text-texture-free! (mut (.primary labels)))
      (text/text-texture-free! (mut (.disabled labels)))
      (text/text-texture-free! (mut (.checkbox labels)))
      (text/text-texture-free! (mut (.slider labels)))
      (text/text-texture-free! (mut (.progress labels)))
      (text/text-texture-free! (mut (.drop labels)))
      (text/text-texture-free! (mut (.inspector labels)))
      (text/text-atlas-free! (mut text-atlas))
      (assets/image-asset-cache-free! (mut asset-cache))
      (path/tessellation-free! (mut canvas))
      (path/path-free! (mut canvas-path))
      (path/tessellation-free! (mut canvas-stroke))
      (svg/svg-vector-free! (mut vector-icon))
      (path/path-free! (mut stroke-path))
      (al/al-free! [f32] (mut dash-pattern))
      (ui/scene-free! (mut scene))
      (grid/grid-free! (mut grid-layout))
      (scroll/variable-scroll-free! (mut scroll-state))
      (keymap/keymap-free! (mut key-map))
      (keymap/key-dispatcher-free! (mut key-dispatcher))
      (reactive/reactive-graph-free! (mut reactive-graph))
      (scheduler/task-scope-free! (mut demo-task-scope) (mut task-scheduler))
      (scheduler/scheduler-free! (mut task-scheduler))
      (retained/entity-store-free! [DemoState] (mut state-store))
      (clock/frame-clock-free! (mut frame-clock))
      (metal/renderer-free! (mut renderer))
      (msg i64 pool (sel c"drain") [])
      0)))
