      (store! input-bridge
              (ime/text-input-bridge-new (editable/text-area-field-ptr (mut editor))))
      (store! view (ime/text-input-view-new (mut input-bridge) 820.0 600.0))
      (msg i64 window (sel c"setContentView:") [(ptr i8)] (load view))
      (store! drop-state (drag/drop-state-new))
      (drag/drop-state-attach! (mut drop-state) (load view))
      (store! access-tree (access/access-tree-new 6))
