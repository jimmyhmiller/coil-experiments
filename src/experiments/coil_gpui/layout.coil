(module experiments.coil_gpui.layout)
(import "experiments.coil_gpui.ui" :as ui)
(import "experiments.coil_gpui.measure" :as measure)
(import "coil.arraylist" :as al)
(import "coil.alloc" :as alloc)
(import "coil.primitive" :as primitive)

(export FlexItem FlexLayout flex-new flex-clear! flex-free! flex-push!
        flex-push-intrinsic! flex-compute!)

;;; Per-child flex inputs. `basis` is the preferred main-axis size, `cross` is
;;; the preferred cross-axis size (zero means stretch), and min/max are hard
;;; clamps. A zero max means unbounded. Grow distributes positive free space;
;;; shrink distributes overflow weighted by basis, matching CSS flex behavior.
(defstruct FlexItem
  [(basis f32)
   (cross f32)
   (grow f32)
   (shrink f32)
   (min-main f32)
   (max-main f32)
   (min-cross f32)
   (max-cross f32)
   (resolved-main f32)
   (frozen bool)])

(defstruct FlexLayout
  [(items (al/ArrayList FlexItem))
   (rects (al/ArrayList ui/Rect))])

(defn flex-new [] (-> FlexLayout)
  (let [allocator (alloc/malloc-allocator)]
    (FlexLayout :items (al/al-new [FlexItem] allocator)
      :rects (al/al-new [ui/Rect] allocator))))

(defn flex-clear! [(layout (mut FlexLayout))] (-> i64)
  (do
    (al/al-clear! [FlexItem] (mut (.items layout)))
    (al/al-clear! [ui/Rect] (mut (.rects layout)))))

(defn flex-free! [(layout (mut FlexLayout))] (-> i64)
  (do
    (al/al-free! [FlexItem] (mut (.items layout)))
    (al/al-free! [ui/Rect] (mut (.rects layout)))))

(defn flex-push! [(layout (mut FlexLayout))
                  (basis f32)
                  (cross f32)
                  (grow f32)
                  (shrink f32)] (-> i64)
  (al/al-push! [FlexItem]
               (mut (.items layout))
               (FlexItem
                 :basis basis
                 :cross cross
                 :grow grow
                 :shrink shrink
                 :min-main 0.0
                 :max-main 0.0
                 :min-cross 0.0
                 :max-cross 0.0
                 :resolved-main basis
                 :frozen false)))

(defn flex-push-intrinsic! [(layout (mut FlexLayout))
                            (intrinsic measure/IntrinsicSize)
                            (axis ui/Axis)
                            (grow f32)
                            (shrink f32)] (-> i64)
  (let [horizontal (match axis (ui/Horizontal [] true) (ui/Vertical [] false))]
    (al/al-push! [FlexItem]
                 (mut (.items layout))
                 (FlexItem
                   :basis (if horizontal
                              (load (field intrinsic preferred-width))
                              (load (field intrinsic preferred-height)))
                   :cross (if horizontal
                              (load (field intrinsic preferred-height))
                              (load (field intrinsic preferred-width)))
                   :grow grow :shrink shrink
                   :min-main (if horizontal
                                 (load (field intrinsic min-width))
                                 (load (field intrinsic min-height)))
                   :max-main 0.0
                   :min-cross (if horizontal
                                  (load (field intrinsic min-height))
                                  (load (field intrinsic min-width)))
                   :max-cross 0.0
                   :resolved-main (if horizontal
                                      (load (field intrinsic preferred-width))
                                      (load (field intrinsic preferred-height)))
                   :frozen false))))

(defn clamp-dimension [(value f32) (minimum f32) (maximum f32)] (-> f32)
  (let [lowered (if (< value minimum) minimum value)]
    (if (and (> maximum 0.0) (> lowered maximum)) maximum lowered)))

(defn item-main [(item FlexItem)] (-> f32)
  (clamp-dimension (load (field item basis))
                   (load (field item min-main))
                   (load (field item max-main))))

(defn compute-totals [(layout FlexLayout) (gap f32)] (-> ui/Rect)
  (let [items (load (field layout items))
        count (al/al-len [FlexItem] items)
        (mut basis) (primitive/cast f32 0.0)
        (mut grow) (primitive/cast f32 0.0)
        (mut shrink-weight) (primitive/cast f32 0.0)]
    (do
      (for [i 0 count]
        (let [item (al/al-get [FlexItem] items i)
              main (item-main item)]
          (do
            (store! basis (+ (load basis) main))
            (store! grow (+ (load grow) (load (field item grow))))
            (store! shrink-weight
                    (+ (load shrink-weight) (* (load (field item shrink)) main))))))
      (ui/rect (+ (load basis) (* gap (primitive/cast f32 (if (> count 0) (- count 1) 0))))
               (load grow)
               (load shrink-weight)
               (primitive/cast f32 count)))))

(defn flex-resolve-main! [(layout (mut FlexLayout))
                          (available f32)
                          (gap f32)] (-> f32)
  (let [count (al/al-len [FlexItem] (load (field layout items)))
        content-space (- available (* gap (primitive/cast f32
                                            (if (> count 0) (- count 1) 0))))
        (mut solving) true]
    (do
      (for [i 0 count]
        (let [(mut item) (al/al-get [FlexItem] (load (field layout items)) i)]
          (do
            (set! (.resolved-main item) (item-main (load item)))
            (set! (.frozen item) false)
            (al/al-set! [FlexItem] (mut (.items layout)) i (load item)))))
      (while (load solving)
        (let [(mut frozen-total) (primitive/cast f32 0.0)
              (mut active-basis) (primitive/cast f32 0.0)
              (mut factor-total) (primitive/cast f32 0.0)]
          (do
            (for [i 0 count]
              (let [item (al/al-get [FlexItem] (load (field layout items)) i)
                    base (item-main item)]
                (if (load (field item frozen))
                    (store! frozen-total (+ (load frozen-total)
                                            (load (field item resolved-main))))
                    (do
                      (store! active-basis (+ (load active-basis) base))
                      0))))
            (let [free (- content-space (+ (load frozen-total) (load active-basis)))]
              (do
                (for [i 0 count]
                  (let [item (al/al-get [FlexItem] (load (field layout items)) i)]
                    (if (not (load (field item frozen)))
                        (store! factor-total
                                (+ (load factor-total)
                                   (if (> free 0.0)
                                       (load (field item grow))
                                       (* (load (field item shrink)) (item-main item)))))
                        0)))
                (let [(mut froze-any) false]
                  (do
                    (for [i 0 count]
                      (let [(mut item) (al/al-get [FlexItem] (load (field layout items)) i)]
                        (if (not (load (field item frozen)))
                            (let [base (item-main (load item))
                                  factor (if (> free 0.0)
                                             (load (field item grow))
                                             (* (load (field item shrink)) base))
                                  proposed (if (> (load factor-total) 0.0)
                                               (+ base (* free (/ factor (load factor-total))))
                                               base)
                                  clamped (clamp-dimension proposed
                                                           (load (field item min-main))
                                                           (load (field item max-main)))
                                  hit-limit (or (< clamped (- proposed 0.0001))
                                                (> clamped (+ proposed 0.0001)))]
                              (do
                                (set! (.resolved-main item) clamped)
                                (if hit-limit
                                    (do (set! (.frozen item) true)
                                        (store! froze-any true))
                                    0)
                                (al/al-set! [FlexItem] (mut (.items layout)) i (load item))))
                            0)))
                    (if (not (load froze-any)) (store! solving false) 0))))))))
      (let [(mut used) (* gap (primitive/cast f32 (if (> count 0) (- count 1) 0)))]
        (do
          (for [i 0 count]
            (let [item (al/al-get [FlexItem] (load (field layout items)) i)]
              (store! used (+ (load used) (load (field item resolved-main))))))
          (load used))))))

(defn flex-compute! [(layout (mut FlexLayout))
                     (bounds ui/Rect)
                     (axis ui/Axis)
                     (gap f32)
                     (padding ui/EdgeInsets)
                     (align ui/Align)
                     (justify ui/Justify)] (-> i64)
  (let [inner (ui/inset bounds padding)
        horizontal (match axis (ui/Horizontal [] true) (ui/Vertical [] false))
        main-size (if horizontal (load (field inner w)) (load (field inner h)))
        cross-size (if horizontal (load (field inner h)) (load (field inner w)))
        main-origin (if horizontal (load (field inner x)) (load (field inner y)))
        cross-origin (if horizontal (load (field inner y)) (load (field inner x)))
        count (al/al-len [FlexItem] (load (field layout items)))
        used (flex-resolve-main! (mut layout) main-size gap)
        leftover (let [free (- main-size used)] (if (> free 0.0) free 0.0))
        justify-offset
          (match justify
            (ui/Leading [] 0.0)
            (ui/Middle [] (/ leftover 2.0))
            (ui/Trailing [] leftover)
            (ui/SpaceBetween [] 0.0))
        distributed-gap
          (match justify
            (ui/SpaceBetween []
                             (if (> count 1) (+ gap (/ leftover (primitive/cast f32 (- count 1)))) gap))
            (_ gap))
        (mut cursor) (+ main-origin justify-offset)]
    (do
      (al/al-clear! [ui/Rect] (mut (.rects layout)))
      (for [i 0 count]
        (let [item (al/al-get [FlexItem] (load (field layout items)) i)
              main (load (field item resolved-main))
              requested-cross (load (field item cross))
              stretched
                (or (match align (ui/Stretch [] true) (_ false))
                    (<= requested-cross 0.0))
              child-cross
                (clamp-dimension (if stretched cross-size requested-cross)
                                 (load (field item min-cross))
                                 (load (field item max-cross)))
              cross-offset
                (match align
                  (ui/Start [] 0.0)
                  (ui/Center [] (/ (- cross-size child-cross) 2.0))
                  (ui/End [] (- cross-size child-cross))
                  (ui/Stretch [] 0.0))
              child
                (if horizontal
                    (ui/rect (load cursor) (+ cross-origin cross-offset) main child-cross)
                    (ui/rect (+ cross-origin cross-offset) (load cursor) child-cross main))]
          (do
            (al/al-push! [ui/Rect] (mut (.rects layout)) child)
            (store! cursor (+ (load cursor) (+ main distributed-gap))))))
      count)))
