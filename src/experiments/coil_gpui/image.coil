(module experiments.coil_gpui.image)
(import "experiments.coil_gpui.objc" :use *)
(import "experiments.coil_gpui.ui" :as ui)
(import "experiments.coil_gpui.measure" :as measure)
(import "coil.primitive" :as primitive)

(export ImageTexture
        ObjectFit
        FitFill
        FitContain
        FitCover
        ImagePlacement
        image-load
        image-valid?
        image-free!
        image-placement
        image-intrinsic-size
        paint-image!
        paint-image-fit!
        paint-image-fit-rounded!)

(extern strlen :cc c [(ptr i8)] (-> i64))

(extern malloc :cc c [i64] (-> (ptr i8)))

(extern free :cc c [(ptr i8)] (-> void))

(extern memset :cc c [(ptr i8) i32 i64] (-> (ptr i8)))

(extern CFURLCreateFromFileSystemRepresentation :cc c [(ptr i8) (ptr i8) i64 i8] (-> (ptr i8)))

(extern CFRelease :cc c [(ptr i8)] (-> void))

(extern CGImageSourceCreateWithURL :cc c [(ptr i8) (ptr i8)] (-> (ptr i8)))

(extern CGImageSourceCreateImageAtIndex :cc c [(ptr i8) i64 (ptr i8)] (-> (ptr i8)))

(extern CGImageGetWidth :cc c [(ptr i8)] (-> i64))

(extern CGImageGetHeight :cc c [(ptr i8)] (-> i64))

(extern CGImageRelease :cc c [(ptr i8)] (-> void))

(extern CGColorSpaceCreateDeviceRGB :cc c [] (-> (ptr i8)))

(extern CGColorSpaceRelease :cc c [(ptr i8)] (-> void))

(extern CGBitmapContextCreate :cc c [(ptr i8) i64 i64 i64 i64 (ptr i8) u32] (-> (ptr i8)))

(extern CGContextDrawImage :cc c [(ptr i8) CGRect (ptr i8)] (-> void))

(extern CGContextRelease :cc c [(ptr i8)] (-> void))

(defstruct CGRect [(x f64) (y f64) (w f64) (h f64)])

(defstruct MTLOrigin [(x u64) (y u64) (z u64)])

(defstruct MTLSize [(w u64) (h u64) (d u64)])

(defstruct MTLRegion [(origin MTLOrigin) (size MTLSize)])

;;; An owned Metal BGRA texture decoded by ImageIO. The original encoded file
;;; and temporary CPU bitmap are not retained after upload.
(defstruct ImageTexture [(texture (ptr i8)) (width i64) (height i64)])

(defsum ObjectFit (FitFill) (FitContain) (FitCover))

(defstruct ImagePlacement [(bounds ui/Rect) (uv ui/Rect) (valid bool)])

(defn empty-image [] (-> ImageTexture)
  (ImageTexture
    :texture (primitive/cast (ptr i8) 0)
    :width 0
    :height 0))

(defn image-valid? [(image ImageTexture)] (-> bool)
  (!= (primitive/cast i64 (load (field image texture))) 0))

(defn image-intrinsic-size [(image ImageTexture) (scale f32)] (-> measure/IntrinsicSize)
  (let [safe-scale (if (> scale 0.0) scale 1.0)
        width (/ (primitive/cast f32 (load (field image width))) safe-scale)
        height (/ (primitive/cast f32 (load (field image height))) safe-scale)
        ratio (if (> height 0.0) (/ width height) 0.0)]
    (measure/intrinsic-size 0.0 0.0 width height ratio)))

(defn invalid-placement [] (-> ImagePlacement)
  (ImagePlacement
    :bounds (ui/rect 0.0 0.0 0.0 0.0)
    :uv (ui/rect 0.0 0.0 0.0 0.0)
    :valid false))

;;; Compute centered CSS/GPUI-style object-fit geometry. Cover retains the
;;; destination quad and crops normalized source UVs, so no oversized geometry
;;; or extra clip state reaches the GPU.
(defn image-placement [(source-width i64)
                       (source-height i64)
                       (destination ui/Rect)
                       (fit ObjectFit)] (-> ImagePlacement)
  (let [dw (load (field destination w))
        dh (load (field destination h))]
    (if (or (<= source-width 0)
            (or (<= source-height 0) (or (<= dw 0.0) (<= dh 0.0))))
        (invalid-placement)
        (let [sw (primitive/cast f32 source-width)
              sh (primitive/cast f32 source-height)]
          (match fit
            (FitFill []
              (ImagePlacement
                :bounds destination
                :uv (ui/rect 0.0 0.0 1.0 1.0)
                :valid true))
            (FitContain []
              (let [scale-x (/ dw sw)
                    scale-y (/ dh sh)
                    scale (if (< scale-x scale-y) scale-x scale-y)
                    width (* sw scale)
                    height (* sh scale)]
                (ImagePlacement
                  :bounds (ui/rect (+ (load (field destination x)) (/ (- dw width) 2.0))
                                   (+ (load (field destination y)) (/ (- dh height) 2.0))
                                   width
                                   height)
                  :uv (ui/rect 0.0 0.0 1.0 1.0)
                  :valid true)))
            (FitCover []
              (let [scale-x (/ dw sw)
                    scale-y (/ dh sh)
                    scale (if (> scale-x scale-y) scale-x scale-y)
                    visible-width (/ dw (* sw scale))
                    visible-height (/ dh (* sh scale))
                    one (primitive/cast f32 1.0)
                    two (primitive/cast f32 2.0)]
                (ImagePlacement
                  :bounds destination
                  :uv (ui/rect (/ (- one visible-width) two)
                               (/ (- one visible-height) two)
                               visible-width
                               visible-height)
                  :valid true))))))))

(defn upload-image [(device (ptr i8)) (cg-image (ptr i8))] (-> ImageTexture)
  (let [width (CGImageGetWidth cg-image)
        height (CGImageGetHeight cg-image)
        row-bytes (* width 4)
        byte-count (* row-bytes height)
        pixels (malloc byte-count)
        colorspace (CGColorSpaceCreateDeviceRGB)
        context (CGBitmapContextCreate pixels width height 8 row-bytes colorspace 8194)]
    (if (or (= (primitive/cast i64 pixels) 0)
            (= (primitive/cast i64 colorspace) 0)
            (= (primitive/cast i64 context) 0))
        (do
          (if (!= (primitive/cast i64 context) 0) (do (CGContextRelease context) 0) 0)
          (if (!= (primitive/cast i64 colorspace) 0) (do (CGColorSpaceRelease colorspace) 0) 0)
          (if (!= (primitive/cast i64 pixels) 0) (do (free pixels) 0) 0)
          (empty-image))
        (do
          (memset pixels 0 byte-count)
          (CGContextDrawImage context
                              (CGRect
                                :x 0.0
                                :y 0.0
                                :w (primitive/cast f64 width)
                                :h (primitive/cast f64 height))
                              cg-image)
          (let [descriptor
                  (msg (ptr i8)
                       (class c"MTLTextureDescriptor")
                       (sel c"texture2DDescriptorWithPixelFormat:width:height:mipmapped:")
                       [i64 i64 i64 i8]
                       80
                       width
                       height
                       (primitive/cast i8 0))
                texture (msg (ptr i8) device (sel c"newTextureWithDescriptor:") [(ptr i8)] descriptor)]
            (do
              (if (!= (primitive/cast i64 texture) 0)
                  (msg i64
                       texture
                       (sel c"replaceRegion:mipmapLevel:withBytes:bytesPerRow:")
                       [MTLRegion i64 (ptr i8) i64]
                       (MTLRegion
                         :origin
                           (MTLOrigin
                             :x 0
                             :y 0
                             :z 0)
                         :size
                           (MTLSize
                             :w (primitive/cast u64 width)
                             :h (primitive/cast u64 height)
                             :d 1))
                       0
                       pixels
                       row-bytes)
                  0)
              (CGContextRelease context)
              (CGColorSpaceRelease colorspace)
              (free pixels)
              (ImageTexture
                :texture texture
                :width width
                :height height)))))))

(defn image-load [(device (ptr i8)) (path (ptr i8))] (-> ImageTexture)
  (let [url
          (CFURLCreateFromFileSystemRepresentation (primitive/cast (ptr i8) 0)
                                                   path
                                                   (strlen path)
                                                   (primitive/cast i8 0))]
    (if (= (primitive/cast i64 url) 0)
        (empty-image)
        (let [source (CGImageSourceCreateWithURL url (primitive/cast (ptr i8) 0))]
          (do
            (CFRelease url)
            (if (= (primitive/cast i64 source) 0)
                (empty-image)
                (let [cg-image (CGImageSourceCreateImageAtIndex source 0 (primitive/cast (ptr i8) 0))]
                  (do
                    (CFRelease source)
                    (if (= (primitive/cast i64 cg-image) 0)
                        (empty-image)
                        (let [result (upload-image device cg-image)]
                          (do (CGImageRelease cg-image) result)))))))))))

(defn image-free! [(image (mut ImageTexture))] (-> i64)
  (do
    (if (image-valid? (load image))
        (msg i64 (load (field image texture)) (sel c"release") [])
        0)
    (set! (.texture image) (primitive/cast (ptr i8) 0))
    0))

(defn paint-image! [(scene (mut ui/Scene))
                    (image ImageTexture)
                    (bounds ui/Rect)
                    (tint ui/Color)
                    (id i32)] (-> i64)
  (if (image-valid? image)
      (ui/scene-image! (mut scene) bounds tint (load (field image texture)) id)
      0))

(defn paint-image-fit! [(scene (mut ui/Scene))
                        (image ImageTexture)
                        (bounds ui/Rect)
                        (fit ObjectFit)
                        (tint ui/Color)
                        (grayscale bool)
                        (id i32)] (-> i64)
  (paint-image-fit-rounded! (mut scene) image bounds fit tint grayscale 0.0 id))

(defn paint-image-fit-rounded! [(scene (mut ui/Scene))
                                (image ImageTexture)
                                (bounds ui/Rect)
                                (fit ObjectFit)
                                (tint ui/Color)
                                (grayscale bool)
                                (radius f32)
                                (id i32)] (-> i64)
  (if (not (image-valid? image))
      0
      (let [placement (image-placement (load (field image width))
                                       (load (field image height))
                                       bounds
                                       fit)]
        (if (not (load (field placement valid)))
            0
            (ui/scene-image-region-rounded! (mut scene)
                                            (load (field placement bounds))
                                            tint
                                            (load (field placement uv))
                                            (load (field image texture))
                                            grayscale
                                            radius
                                            id)))))
