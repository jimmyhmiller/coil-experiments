(module experiments.coil_gpui.variable-scroll-bench)
(import "experiments.coil_gpui.variable_scroll" :as variable)
(import "experiments.coil_gpui.ui" :as ui)
(import "coil.primitive" :as primitive)

(extern clock_gettime :cc c [i32 (ptr Timespec)] (-> i32))

(extern printf :cc c [(ptr i8) ...] (-> i32))

(defstruct Timespec [(seconds i64) (nanos i64)])

(defn monotonic-nanos [] (-> i64)
  (let [time (primitive/alloc-stack Timespec)]
    (do
      (clock_gettime 6 time)
      (+ (* (load (field time seconds)) 1000000000)
         (load (field time nanos))))))

(defn main [] (-> i64)
  (let [(mut state) (primitive/zeroed variable/VariableScrollState)
        operations 100000
        (mut checksum) 0]
    (do
      (store! state (variable/variable-scroll-new 1000000 24.0 2))
      (variable/variable-scroll-configure! (mut state) (ui/rect 0.0 0.0 320.0 480.0))
      (let [start (monotonic-nanos)]
        (do
          (for [i 0 operations]
            (let [index (% (* i 7919) 1000000)
                  offset (primitive/cast f32 (% (* i 104729) 23999520))]
              (do
                (variable/variable-scroll-measure! (mut state)
                                                   index
                                                   (+ (primitive/cast f32 18.0) (primitive/cast f32 (% index 19))))
                (store! checksum
                        (+ (load checksum)
                           (variable/variable-scroll-index-at (load state) offset))))))
          (let [elapsed (- (monotonic-nanos) start)]
            (printf c"coil-gpui variable-list benchmark: %lld ns/update+lookup, %lld rows, %lld operations, checksum %lld\n"
                    (/ elapsed operations)
                    (load (field state item-count))
                    operations
                    (load checksum)))))
      (variable/variable-scroll-free! (mut state))
      0)))
