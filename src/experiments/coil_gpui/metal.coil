(module experiments.coil_gpui.metal)
(import "experiments.coil_gpui.objc" :use *)
(import "experiments.coil_gpui.ui" :as ui)
(import "coil.arraylist" :as al)
(import "coil.primitive" :as primitive)

(export Renderer renderer-new renderer-resize! renderer-draw! renderer-valid?)

(extern MTLCreateSystemDefaultDevice :cc c [] (-> (ptr i8)))

(extern printf :cc c [(ptr i8) ...] (-> i32))

(defstruct CGSize [(w f64) (h f64)])

(defstruct CGRect [(x f64) (y f64) (w f64) (h f64)])

(defstruct MTLClearColor [(r f64) (g f64) (b f64) (a f64)])

(defstruct Renderer
  [(device (ptr i8))
   (queue (ptr i8))
   (pipeline (ptr i8))
   (layer (ptr i8))
   (width f32)
   (height f32)
   (scale f32)
   (frames i64)
   (draw-calls i64)])

(defn nsstr [(s (ptr i8))] (-> (ptr i8))
  (msg (ptr i8) (class c"NSString") (sel c"stringWithUTF8String:") [(ptr i8)] s))

;;; One shader invocation expands one UI primitive. Rounded corners, borders,
;;; clipping, and alpha compositing stay on the GPU; the CPU emits no vertices.
(defn shader-source [] (-> (ptr i8))
  c"#include <metal_stdlib>\nusing namespace metal;\nstruct Rect { float x,y,w,h; };\nstruct Color { float r,g,b,a; };\nstruct Primitive { Rect bounds; Color color; float radius; float borderWidth; Color borderColor; Rect clip; int kind; int id; };\nstruct Frame { float2 viewport; float2 pad; };\nstruct VOut { float4 position [[position]]; float2 local; float2 size; float4 color; float radius; float borderWidth; float4 borderColor; };\nvertex VOut ui_vertex(uint vid [[vertex_id]], uint iid [[instance_id]], constant Primitive* ps [[buffer(0)]], constant Frame& frame [[buffer(1)]]) { constexpr float2 q[6] = {float2(0,0),float2(1,0),float2(0,1),float2(0,1),float2(1,0),float2(1,1)}; Primitive p=ps[iid]; float2 pixel=float2(p.bounds.x,p.bounds.y)+q[vid]*float2(p.bounds.w,p.bounds.h); VOut o; o.position=float4(pixel.x/frame.viewport.x*2.0-1.0,1.0-pixel.y/frame.viewport.y*2.0,0,1); o.local=q[vid]*float2(p.bounds.w,p.bounds.h); o.size=float2(p.bounds.w,p.bounds.h); o.color=float4(p.color.r,p.color.g,p.color.b,p.color.a); o.radius=p.radius; o.borderWidth=p.borderWidth; o.borderColor=float4(p.borderColor.r,p.borderColor.g,p.borderColor.b,p.borderColor.a); return o; }\nfragment float4 ui_fragment(VOut in [[stage_in]]) { float2 halfSize=in.size*0.5; float2 d=abs(in.local-halfSize)-(halfSize-in.radius); float sd=length(max(d,0.0))+min(max(d.x,d.y),0.0)-in.radius; float aa=max(fwidth(sd),0.75); float coverage=1.0-smoothstep(-aa,aa,sd); float border=smoothstep(-in.borderWidth-aa,-in.borderWidth+aa,sd); float4 color=mix(in.color,in.borderColor,border); return float4(color.rgb,color.a*coverage); }\n")

(defn renderer-valid? [(renderer Renderer)] (-> bool)
  (and (!= (primitive/cast i64 (load (field renderer device))) 0)
       (!= (primitive/cast i64 (load (field renderer pipeline))) 0)))

(defn configure-blending! [(attachment (ptr i8))] (-> i64)
  (do
    (msg i64 attachment (sel c"setBlendingEnabled:") [i8] (primitive/cast i8 1))
    (msg i64 attachment (sel c"setRgbBlendOperation:") [i64] 0)
    (msg i64 attachment (sel c"setAlphaBlendOperation:") [i64] 0)
    (msg i64 attachment (sel c"setSourceRGBBlendFactor:") [i64] 4)
    (msg i64 attachment (sel c"setDestinationRGBBlendFactor:") [i64] 5)
    (msg i64 attachment (sel c"setSourceAlphaBlendFactor:") [i64] 1)
    (msg i64 attachment (sel c"setDestinationAlphaBlendFactor:") [i64] 5)
    0))

(defn renderer-new [(view (ptr i8)) (width f32) (height f32) (scale f32)] (-> Renderer)
  (let [device (MTLCreateSystemDefaultDevice)
        queue (msg (ptr i8) device (sel c"newCommandQueue") [])
        source (nsstr (shader-source))
        library
          (msg (ptr i8)
               device
               (sel c"newLibraryWithSource:options:error:")
               [(ptr i8) (ptr i8) (ptr (ptr i8))]
               source
               (primitive/cast (ptr i8) 0)
               (primitive/cast (ptr (ptr i8)) 0))
        vertex (msg (ptr i8) library (sel c"newFunctionWithName:") [(ptr i8)] (nsstr c"ui_vertex"))
        fragment (msg (ptr i8) library (sel c"newFunctionWithName:") [(ptr i8)] (nsstr c"ui_fragment"))
        descriptor (msg (ptr i8) (class c"MTLRenderPipelineDescriptor") (sel c"new") [])
        attachments (msg (ptr i8) descriptor (sel c"colorAttachments") [])
        attachment (msg (ptr i8) attachments (sel c"objectAtIndexedSubscript:") [i64] 0)]
    (do
      (msg i64 descriptor (sel c"setVertexFunction:") [(ptr i8)] vertex)
      (msg i64 descriptor (sel c"setFragmentFunction:") [(ptr i8)] fragment)
      (msg i64 attachment (sel c"setPixelFormat:") [i64] 80)
      (configure-blending! attachment)
      (let [pipeline
              (msg (ptr i8)
                   device
                   (sel c"newRenderPipelineStateWithDescriptor:error:")
                   [(ptr i8) (ptr (ptr i8))]
                   descriptor
                   (primitive/cast (ptr (ptr i8)) 0))
            layer (msg (ptr i8) (class c"CAMetalLayer") (sel c"layer") [])]
        (do
          (msg i64 layer (sel c"setDevice:") [(ptr i8)] device)
          (msg i64 layer (sel c"setPixelFormat:") [i64] 80)
          (msg i64 layer (sel c"setFramebufferOnly:") [i8] (primitive/cast i8 1))
          (msg i64 layer (sel c"setMaximumDrawableCount:") [i64] 3)
          (msg i64 layer (sel c"setDisplaySyncEnabled:") [i8] (primitive/cast i8 1))
          (msg i64 view (sel c"setWantsLayer:") [i8] (primitive/cast i8 1))
          (msg i64 view (sel c"setLayer:") [(ptr i8)] layer)
          (let [(mut renderer) (primitive/zeroed Renderer)]
            (do
              (set! (.device renderer) device)
              (set! (.queue renderer) queue)
              (set! (.pipeline renderer) pipeline)
              (set! (.layer renderer) layer)
              (renderer-resize! (mut renderer) width height scale)
              (load renderer))))))))

(defn renderer-resize! [(renderer (mut Renderer)) (width f32) (height f32) (scale f32)] (-> i64)
  (do
    (set! (.width renderer) width)
    (set! (.height renderer) height)
    (set! (.scale renderer) scale)
    (msg i64
         (load (field renderer layer))
         (sel c"setFrame:")
         [CGRect]
         (CGRect
           :x 0.0
           :y 0.0
           :w (primitive/cast f64 width)
           :h (primitive/cast f64 height)))
    (msg i64
         (load (field renderer layer))
         (sel c"setDrawableSize:")
         [CGSize]
         (CGSize :w (primitive/cast f64 (* width scale)) :h (primitive/cast f64 (* height scale))))
    0))

(defn renderer-draw! [(renderer (mut Renderer)) (scene ui/Scene)] (-> i64)
  (let [items (load (field scene items))
        count (al/al-len [ui/Primitive] items)]
    (if (or (= count 0) (not (renderer-valid? (load renderer))))
        0
        (let [drawable (msg (ptr i8) (load (field renderer layer)) (sel c"nextDrawable") [])]
          (if (= (primitive/cast i64 drawable) 0)
              0
              (let [texture (msg (ptr i8) drawable (sel c"texture") [])
                    pass (msg (ptr i8) (class c"MTLRenderPassDescriptor") (sel c"renderPassDescriptor") [])
                    colors (msg (ptr i8) pass (sel c"colorAttachments") [])
                    color0 (msg (ptr i8) colors (sel c"objectAtIndexedSubscript:") [i64] 0)
                    command (msg (ptr i8) (load (field renderer queue)) (sel c"commandBuffer") [])]
                (do
                  (msg i64 color0 (sel c"setTexture:") [(ptr i8)] texture)
                  (msg i64 color0 (sel c"setLoadAction:") [i64] 2)
                  (msg i64 color0 (sel c"setStoreAction:") [i64] 1)
                  (msg i64
                       color0
                       (sel c"setClearColor:")
                       [MTLClearColor]
                       (MTLClearColor
                         :r 0.055
                         :g 0.063
                         :b 0.082
                         :a 1.0))
                  (let [encoder (msg (ptr i8) command (sel c"renderCommandEncoderWithDescriptor:") [(ptr i8)] pass)
                        frame (primitive/alloc-stack (array f32 4))]
                    (do
                      (store! (primitive/index frame 0) (load (field renderer width)))
                      (store! (primitive/index frame 1) (load (field renderer height)))
                      (store! (primitive/index frame 2) 0.0)
                      (store! (primitive/index frame 3) 0.0)
                      (msg i64 encoder (sel c"setRenderPipelineState:") [(ptr i8)] (load (field renderer pipeline)))
                      (msg i64
                           encoder
                           (sel c"setVertexBytes:length:atIndex:")
                           [(ptr i8) i64 i64]
                           (primitive/cast (ptr i8) (load (field items data)))
                           (* count (primitive/sizeof ui/Primitive))
                           0)
                      (msg i64
                           encoder
                           (sel c"setVertexBytes:length:atIndex:")
                           [(ptr i8) i64 i64]
                           (primitive/cast (ptr i8) frame)
                           16
                           1)
                      (msg i64
                           encoder
                           (sel c"drawPrimitives:vertexStart:vertexCount:instanceCount:")
                           [i64 i64 i64 i64]
                           3
                           0
                           6
                           count)
                      (msg i64 encoder (sel c"endEncoding") [])
                      (msg i64 command (sel c"presentDrawable:") [(ptr i8)] drawable)
                      (msg i64 command (sel c"commit") [])
                      (set! (.frames renderer) (+ (load (field renderer frames)) 1))
                      (set! (.draw-calls renderer) (+ (load (field renderer draw-calls)) 1))
                      1)))))))))
