(module experiments.coil_gpui.metal)
(import "experiments.coil_gpui.objc" :use *)
(import "experiments.coil_gpui.ui" :as ui)
(import "experiments.coil_gpui.path" :as path)
(import "coil.arraylist" :as al)
(import "coil.primitive" :as primitive)

(export Renderer
        PixelBuffer
        renderer-new
        renderer-resize!
        renderer-draw!
        renderer-draw-damage!
        renderer-render-offscreen!
        pixel-buffer-valid?
        pixel-buffer-byte
        pixel-buffer-free!
        renderer-valid?
        renderer-free!
        next-buffer-capacity
        sprite-run-end
        visible-sprite-run-end
        paint-run-end
        visible-paint-run-end
        visible-primitive-count
        compact-visible-primitives!)

(extern MTLCreateSystemDefaultDevice :cc c [] (-> (ptr i8)))

(extern printf :cc c [(ptr i8) ...] (-> i32))

(extern memcpy :cc c [(ptr i8) (ptr i8) i64] (-> (ptr i8)))
(extern floorf :cc c [f32] (-> f32))
(extern ceilf :cc c [f32] (-> f32))

(defstruct CGSize [(w f64) (h f64)])

(defstruct CGRect [(x f64) (y f64) (w f64) (h f64)])

(defstruct MTLClearColor [(r f64) (g f64) (b f64) (a f64)])
(defstruct MTLScissorRect [(x i64) (y i64) (width i64) (height i64)])
(defstruct MTLOrigin [(x u64) (y u64) (z u64)])
(defstruct MTLSize [(width u64) (height u64) (depth u64)])

;;; A completed BGRA8 readback. Metal owns `bytes` through `buffer`; callers
;;; release that ownership explicitly with `pixel-buffer-free!`.
(defstruct PixelBuffer
  [(buffer (ptr i8)) (bytes (ptr u8))
   (width i64) (height i64) (row-bytes i64)])

(defstruct Renderer
  [(device (ptr i8))
   (queue (ptr i8))
   (pipeline (ptr i8))
   (shadow-pipeline (ptr i8))
   (path-pipeline (ptr i8))
   (text-pipeline (ptr i8))
   (image-pipeline (ptr i8))
   (grayscale-image-pipeline (ptr i8))
   (presentation-pipeline (ptr i8))
   (primitive-buffer-0 (ptr i8))
   (primitive-buffer-1 (ptr i8))
   (primitive-buffer-2 (ptr i8))
   (primitive-capacity i64)
   (layer (ptr i8))
   (backing-texture (ptr i8))
   (backing-width i64)
   (backing-height i64)
   (backing-valid bool)
   (width f32)
   (height f32)
   (scale f32)
   (frames i64)
   (draw-calls i64)])

(defstruct PathUniform
  [(color ui/Color) (clip ui/Rect) (transform ui/Affine) (opacity f32) (padding i32)])

(defn next-buffer-capacity [(current i64) (required i64)] (-> i64)
  (let [(mut capacity) (if (< current 65536) 65536 current)]
    (do
      (while (< (load capacity) required)
        (store! capacity (* (load capacity) 2)))
      (load capacity))))

;;; Return the exclusive end of an adjacent sprite run that can share one
;;; pipeline and texture binding without changing paint order.
(defn sprite-run-end [(sprites (al/ArrayList ui/TextSprite))
                      (start i64)
                      (count i64)] (-> i64)
  (if (or (< start 0) (>= start count))
      start
      (let [first (primitive/index (load (field sprites data)) start)
            texture (primitive/cast i64 (load (field first texture)))
            mode (load (field first mode))
            (mut end) (+ start 1)]
        (do
          (while (< (load end) count)
            (let [candidate (primitive/index (load (field sprites data)) (load end))]
              (if (and (= (primitive/cast i64 (load (field candidate texture))) texture)
                       (= (load (field candidate mode)) mode))
                  (store! end (+ (load end) 1))
                  (break 0))))
          (load end)))))

(defn visible-sprite-run-end [(sprites (al/ArrayList ui/TextSprite))
                              (start i64)
                              (count i64)
                              (viewport ui/Rect)] (-> i64)
  (let [base-end (sprite-run-end sprites start count)
        (mut end) start]
    (do
      (while (< (load end) base-end)
        (let [sprite (al/al-get [ui/TextSprite] sprites (load end))]
          (if (ui/sprite-visible? sprite viewport)
              (store! end (+ (load end) 1))
              (break 0))))
      (load end))))

;;; Find an adjacent run of ordinary primitive commands. A path command ends
;;; the run, as does a non-consecutive primitive index.
(defn paint-run-end [(commands (al/ArrayList ui/PaintCommand))
                     (start i64)
                     (count i64)] (-> i64)
  (if (or (< start 0) (>= start count))
      start
      (let [first (al/al-get [ui/PaintCommand] commands start)
            (mut end) (+ start 1)]
        (if (!= (load (field first kind)) (primitive/cast i32 0))
            (load end)
            (do
              (while (< (load end) count)
                (let [candidate (al/al-get [ui/PaintCommand] commands (load end))]
                  (if (and (= (load (field candidate kind)) 0)
                           (= (load (field candidate index))
                              (+ (load (field first index))
                                 (primitive/cast i32 (- (load end) start)))))
                      (store! end (+ (load end) 1))
                      (break 0))))
              (load end))))))

(defn visible-paint-run-end [(commands (al/ArrayList ui/PaintCommand))
                             (items (al/ArrayList ui/Primitive))
                             (start i64)
                             (count i64)
                             (viewport ui/Rect)] (-> i64)
  (let [base-end (paint-run-end commands start count)
        (mut end) start]
    (do
      (while (< (load end) base-end)
        (let [command (al/al-get [ui/PaintCommand] commands (load end))
              item
                (al/al-get [ui/Primitive]
                           items
                           (primitive/cast i64 (load (field command index))))]
          (if (ui/primitive-visible? item viewport)
              (store! end (+ (load end) 1))
              (break 0))))
      (load end))))

(defn visible-primitive-count [(items (al/ArrayList ui/Primitive))
                               (viewport ui/Rect)] (-> i64)
  (let [count (al/al-len [ui/Primitive] items)
        (mut visible) 0]
    (do
      (for [i 0 count]
        (if (ui/primitive-visible? (al/al-get [ui/Primitive] items i) viewport)
            (store! visible (+ (load visible) 1))
            0))
      (load visible))))

(defn compact-visible-primitives! [(destination (ptr i8))
                                   (items (al/ArrayList ui/Primitive))
                                   (viewport ui/Rect)] (-> i64)
  (let [count (al/al-len [ui/Primitive] items)
        size (primitive/sizeof ui/Primitive)
        (mut written) 0]
    (do
      (for [i 0 count]
        (let [item (primitive/index (load (field items data)) i)]
          (if (ui/primitive-visible? (load item) viewport)
              (do
                (memcpy (primitive/cast (ptr i8)
                                        (+ (primitive/cast i64 destination) (* (load written) size)))
                        (primitive/cast (ptr i8) item)
                        size)
                (store! written (+ (load written) 1)))
              0)))
      (load written))))

(defn renderer-ensure-capacity! [(renderer (mut Renderer)) (required i64)] (-> i64)
  (if (<= required (load (field renderer primitive-capacity)))
      0
      (let [capacity (next-buffer-capacity (load (field renderer primitive-capacity)) required)
            device (load (field renderer device))
            buffer-0 (msg (ptr i8) device (sel c"newBufferWithLength:options:") [i64 i64] capacity 0)
            buffer-1 (msg (ptr i8) device (sel c"newBufferWithLength:options:") [i64 i64] capacity 0)
            buffer-2 (msg (ptr i8) device (sel c"newBufferWithLength:options:") [i64 i64] capacity 0)]
        (if (or (= (primitive/cast i64 buffer-0) 0)
                (or (= (primitive/cast i64 buffer-1) 0)
                    (= (primitive/cast i64 buffer-2) 0)))
            -1
            (do
              (if (!= (primitive/cast i64 (load (field renderer primitive-buffer-0))) 0)
                  (msg i64 (load (field renderer primitive-buffer-0)) (sel c"release") [])
                  0)
              (if (!= (primitive/cast i64 (load (field renderer primitive-buffer-1))) 0)
                  (msg i64 (load (field renderer primitive-buffer-1)) (sel c"release") [])
                  0)
              (if (!= (primitive/cast i64 (load (field renderer primitive-buffer-2))) 0)
                  (msg i64 (load (field renderer primitive-buffer-2)) (sel c"release") [])
                  0)
              (set! (.primitive-buffer-0 renderer) buffer-0)
              (set! (.primitive-buffer-1 renderer) buffer-1)
              (set! (.primitive-buffer-2 renderer) buffer-2)
              (set! (.primitive-capacity renderer) capacity)
              1)))))

(defn renderer-frame-buffer [(renderer Renderer)] (-> (ptr i8))
  (let [slot (% (load (field renderer frames)) 3)]
    (cond (= slot 0) (load (field renderer primitive-buffer-0))
          (= slot 1) (load (field renderer primitive-buffer-1))
          :else (load (field renderer primitive-buffer-2)))))

(defn nsstr [(s (ptr i8))] (-> (ptr i8))
  (msg (ptr i8) (class c"NSString") (sel c"stringWithUTF8String:") [(ptr i8)] s))

;;; One shader invocation expands one UI primitive. Rounded corners, borders,
;;; clipping, and alpha compositing stay on the GPU; the CPU emits no vertices.
(defn shader-source [] (-> (ptr i8))
  c"#include <metal_stdlib>\nusing namespace metal;\nstruct Rect { float x,y,w,h; };\nstruct Color { float r,g,b,a; };\nstruct Primitive { Rect bounds; Color color; float radius; float borderWidth; Color borderColor; Rect clip; int kind; int id; };\nstruct Sprite { Rect bounds; Color color; Rect clip; };\nstruct Frame { float2 viewport; float2 pad; };\nstruct VOut { float4 position [[position]]; float2 pixel; float2 local; float2 size; float4 clip; float4 color; float radius; float borderWidth; float4 borderColor; };\nstruct SpriteOut { float4 position [[position]]; float2 pixel; float2 uv; float4 clip; float4 color; };\nvertex VOut ui_vertex(uint vid [[vertex_id]], uint iid [[instance_id]], constant Primitive* ps [[buffer(0)]], constant Frame& frame [[buffer(1)]]) { constexpr float2 q[6] = {float2(0,0),float2(1,0),float2(0,1),float2(0,1),float2(1,0),float2(1,1)}; Primitive p=ps[iid]; float2 pixel=float2(p.bounds.x,p.bounds.y)+q[vid]*float2(p.bounds.w,p.bounds.h); VOut o; o.position=float4(pixel.x/frame.viewport.x*2.0-1.0,1.0-pixel.y/frame.viewport.y*2.0,0,1); o.pixel=pixel; o.local=q[vid]*float2(p.bounds.w,p.bounds.h); o.size=float2(p.bounds.w,p.bounds.h); o.clip=float4(p.clip.x,p.clip.y,p.clip.w,p.clip.h); o.color=float4(p.color.r,p.color.g,p.color.b,p.color.a); o.radius=p.radius; o.borderWidth=p.borderWidth; o.borderColor=float4(p.borderColor.r,p.borderColor.g,p.borderColor.b,p.borderColor.a); return o; }\nfragment float4 ui_fragment(VOut in [[stage_in]]) { if (in.pixel.x<in.clip.x || in.pixel.y<in.clip.y || in.pixel.x>=in.clip.x+in.clip.z || in.pixel.y>=in.clip.y+in.clip.w) discard_fragment(); float2 halfSize=in.size*0.5; float2 d=abs(in.local-halfSize)-(halfSize-in.radius); float sd=length(max(d,0.0))+min(max(d.x,d.y),0.0)-in.radius; float aa=max(fwidth(sd),0.75); float coverage=1.0-smoothstep(-aa,aa,sd); float border=smoothstep(-in.borderWidth-aa,-in.borderWidth+aa,sd); float4 color=mix(in.color,in.borderColor,border); return float4(color.rgb,color.a*coverage); }\nvertex SpriteOut text_vertex(uint vid [[vertex_id]], constant Sprite& sprite [[buffer(0)]], constant Frame& frame [[buffer(1)]]) { constexpr float2 q[6] = {float2(0,0),float2(1,0),float2(0,1),float2(0,1),float2(1,0),float2(1,1)}; float2 pixel=float2(sprite.bounds.x,sprite.bounds.y)+q[vid]*float2(sprite.bounds.w,sprite.bounds.h); SpriteOut o; o.position=float4(pixel.x/frame.viewport.x*2.0-1.0,1.0-pixel.y/frame.viewport.y*2.0,0,1); o.pixel=pixel; o.uv=q[vid]; o.clip=float4(sprite.clip.x,sprite.clip.y,sprite.clip.w,sprite.clip.h); o.color=float4(sprite.color.r,sprite.color.g,sprite.color.b,sprite.color.a); return o; }\nfragment float4 text_fragment(SpriteOut in [[stage_in]], texture2d<float> mask [[texture(0)]]) { if (in.pixel.x<in.clip.x || in.pixel.y<in.clip.y || in.pixel.x>=in.clip.x+in.clip.z || in.pixel.y>=in.clip.y+in.clip.w) discard_fragment(); constexpr sampler s(coord::normalized, address::clamp_to_edge, filter::linear); float alpha=mask.sample(s,in.uv).a; return float4(in.color.rgb,in.color.a*alpha); }\n")

(defn image-shader-source [] (-> (ptr i8))
  c"#include <metal_stdlib>\nusing namespace metal;\nstruct SpriteOut { float4 position [[position]]; float2 pixel; float2 uv; float4 clip; float4 color; };\nfragment float4 image_fragment(SpriteOut in [[stage_in]], texture2d<float> image [[texture(0)]]) { if (in.pixel.x<in.clip.x || in.pixel.y<in.clip.y || in.pixel.x>=in.clip.x+in.clip.z || in.pixel.y>=in.clip.y+in.clip.w) discard_fragment(); constexpr sampler s(coord::normalized, address::clamp_to_edge, filter::linear); return image.sample(s,in.uv)*in.color; }\n")

(defn shadow-shader-source [] (-> (ptr i8))
  c"#include <metal_stdlib>\nusing namespace metal;\nstruct VOut { float4 position [[position]]; float2 pixel; float2 local; float2 size; float4 clip; float4 color; float radius; float borderWidth; float4 borderColor; float kind; float opacity; };\nfragment float4 shadow_fragment(VOut in [[stage_in]]) { if (in.pixel.x<in.clip.x || in.pixel.y<in.clip.y || in.pixel.x>=in.clip.x+in.clip.z || in.pixel.y>=in.clip.y+in.clip.w) discard_fragment(); float inset=in.borderColor.r; float2 halfSize=in.size*0.5; float2 innerHalf=max(halfSize-inset,float2(0.5)); float2 d=abs(in.local-halfSize)-(innerHalf-in.radius); float sd=length(max(d,0.0))+min(max(d.x,d.y),0.0)-in.radius; float sigma=max(in.borderWidth,0.5); float outside=max(sd,0.0); float alpha=exp(-0.5*(outside/sigma)*(outside/sigma)); float aa=max(fwidth(sd),0.75); alpha*=1.0-smoothstep(inset-aa,inset+aa,sd); return float4(in.color.rgb,in.color.a*alpha*in.opacity); }\n")

(defn paint-shader-source [] (-> (ptr i8))
  c"#include <metal_stdlib>\nusing namespace metal;\nstruct Rect { float x,y,w,h; };\nstruct Color { float r,g,b,a; };\nstruct Primitive { Rect bounds; Color color; float radius; float borderWidth; Color borderColor; Rect clip; int kind; int id; };\nstruct Frame { float2 viewport; float2 pad; };\nstruct VOut { float4 position [[position]]; float2 pixel; float2 local; float2 size; float4 clip; float4 color; float radius; float borderWidth; float4 borderColor; float kind; };\nvertex VOut paint_vertex(uint vid [[vertex_id]], uint iid [[instance_id]], constant Primitive* ps [[buffer(0)]], constant Frame& frame [[buffer(1)]]) { constexpr float2 q[6] = {float2(0,0),float2(1,0),float2(0,1),float2(0,1),float2(1,0),float2(1,1)}; Primitive p=ps[iid]; float2 pixel=float2(p.bounds.x,p.bounds.y)+q[vid]*float2(p.bounds.w,p.bounds.h); VOut o; o.position=float4(pixel.x/frame.viewport.x*2.0-1.0,1.0-pixel.y/frame.viewport.y*2.0,0,1); o.pixel=pixel; o.local=q[vid]*float2(p.bounds.w,p.bounds.h); o.size=float2(p.bounds.w,p.bounds.h); o.clip=float4(p.clip.x,p.clip.y,p.clip.w,p.clip.h); o.color=float4(p.color.r,p.color.g,p.color.b,p.color.a); o.radius=p.radius; o.borderWidth=p.borderWidth; o.borderColor=float4(p.borderColor.r,p.borderColor.g,p.borderColor.b,p.borderColor.a); o.kind=float(p.kind); return o; }\nfragment float4 paint_fragment(VOut in [[stage_in]]) { if (in.pixel.x<in.clip.x || in.pixel.y<in.clip.y || in.pixel.x>=in.clip.x+in.clip.z || in.pixel.y>=in.clip.y+in.clip.w) discard_fragment(); float2 halfSize=in.size*0.5; float2 d=abs(in.local-halfSize)-(halfSize-in.radius); float sd=length(max(d,0.0))+min(max(d.x,d.y),0.0)-in.radius; float aa=max(fwidth(sd),0.75); float coverage=1.0-smoothstep(-aa,aa,sd); if (in.kind>1.5) { float radians=in.borderWidth*0.017453292519943295; float2 direction=float2(sin(radians),-cos(radians)); float2 uv=in.local/max(in.size,float2(0.0001)); float denominator=max(abs(direction.x)+abs(direction.y),0.0001); float t=clamp(dot(uv-0.5,direction)/denominator+0.5,0.0,1.0); float4 color=mix(in.color,in.borderColor,t); return float4(color.rgb,color.a*coverage); } float border=smoothstep(-in.borderWidth-aa,-in.borderWidth+aa,sd); float4 color=mix(in.color,in.borderColor,border); return float4(color.rgb,color.a*coverage); }\n")

(defn affine-paint-shader-source [] (-> (ptr i8))
  c"#include <metal_stdlib>\nusing namespace metal;\nstruct Rect { float x,y,w,h; };\nstruct Color { float r,g,b,a; };\nstruct Affine { float m11,m12,m21,m22,tx,ty; };\nstruct Primitive { Rect bounds; Color color; float radius; float borderWidth; Color borderColor; Rect clip; Affine transform; int kind; int id; float opacity; int padding; };\nstruct Frame { float2 viewport; float2 pad; };\nstruct VOut { float4 position [[position]]; float2 pixel; float2 local; float2 size; float4 clip; float4 color; float radius; float borderWidth; float4 borderColor; float kind; float opacity; };\nfloat2 apply_affine(Affine t,float2 p) { return float2(t.m11*p.x+t.m21*p.y+t.tx,t.m12*p.x+t.m22*p.y+t.ty); }\nvertex VOut paint_vertex(uint vid [[vertex_id]], uint iid [[instance_id]], constant Primitive* ps [[buffer(0)]], constant Frame& frame [[buffer(1)]]) { constexpr float2 q[6] = {float2(0,0),float2(1,0),float2(0,1),float2(0,1),float2(1,0),float2(1,1)}; Primitive p=ps[iid]; float2 localPoint=float2(p.bounds.x,p.bounds.y)+q[vid]*float2(p.bounds.w,p.bounds.h); float2 pixel=apply_affine(p.transform,localPoint); VOut o; o.position=float4(pixel.x/frame.viewport.x*2.0-1.0,1.0-pixel.y/frame.viewport.y*2.0,0,1); o.pixel=pixel; o.local=q[vid]*float2(p.bounds.w,p.bounds.h); o.size=float2(p.bounds.w,p.bounds.h); o.clip=float4(p.clip.x,p.clip.y,p.clip.w,p.clip.h); o.color=float4(p.color.r,p.color.g,p.color.b,p.color.a); o.radius=p.radius; o.borderWidth=p.borderWidth; o.borderColor=float4(p.borderColor.r,p.borderColor.g,p.borderColor.b,p.borderColor.a); o.kind=float(p.kind); o.opacity=p.opacity; return o; }\nfragment float4 paint_fragment(VOut in [[stage_in]]) { if (in.pixel.x<in.clip.x || in.pixel.y<in.clip.y || in.pixel.x>=in.clip.x+in.clip.z || in.pixel.y>=in.clip.y+in.clip.w) discard_fragment(); float2 halfSize=in.size*0.5; float2 d=abs(in.local-halfSize)-(halfSize-in.radius); float sd=length(max(d,0.0))+min(max(d.x,d.y),0.0)-in.radius; float aa=max(fwidth(sd),0.75); float coverage=1.0-smoothstep(-aa,aa,sd); if (in.kind>2.5) { float lineWidth=max(in.borderWidth,0.25); float period=max(lineWidth+max(in.borderColor.r,0.0),0.25); float diagonal=(in.local.x+in.local.y)*0.70710678118; float phase=diagonal-floor(diagonal/period)*period; float stripeDistance=abs(phase-lineWidth*0.5)-lineWidth*0.5; float stripe=1.0-smoothstep(-aa,aa,stripeDistance); return float4(in.color.rgb,in.color.a*coverage*stripe*in.opacity); } if (in.kind>1.5) { float radians=in.borderWidth*0.017453292519943295; float2 direction=float2(sin(radians),-cos(radians)); float2 uv=in.local/max(in.size,float2(0.0001)); float denominator=max(abs(direction.x)+abs(direction.y),0.0001); float t=clamp(dot(uv-0.5,direction)/denominator+0.5,0.0,1.0); float4 color=mix(in.color,in.borderColor,t); return float4(color.rgb,color.a*coverage*in.opacity); } float border=smoothstep(-in.borderWidth-aa,-in.borderWidth+aa,sd); float4 color=mix(in.color,in.borderColor,border); return float4(color.rgb,color.a*coverage*in.opacity); }\n")

(defn texture-shader-source [] (-> (ptr i8))
  c"#include <metal_stdlib>\nusing namespace metal;\nstruct Rect { float x,y,w,h; };\nstruct Color { float r,g,b,a; };\nstruct Affine { float m11,m12,m21,m22,tx,ty; };\nstruct Sprite { Rect bounds; Color color; Rect clip; Affine transform; };\nstruct Frame { float2 viewport; float2 pad; };\nstruct SpriteOut { float4 position [[position]]; float2 pixel; float2 uv; float4 clip; float4 color; };\nfloat2 apply_affine(Affine t,float2 p) { return float2(t.m11*p.x+t.m21*p.y+t.tx,t.m12*p.x+t.m22*p.y+t.ty); }\nvertex SpriteOut texture_vertex(uint vid [[vertex_id]], constant Sprite& sprite [[buffer(0)]], constant Frame& frame [[buffer(1)]]) { constexpr float2 q[6] = {float2(0,0),float2(1,0),float2(0,1),float2(0,1),float2(1,0),float2(1,1)}; float2 localPoint=float2(sprite.bounds.x,sprite.bounds.y)+q[vid]*float2(sprite.bounds.w,sprite.bounds.h); float2 pixel=apply_affine(sprite.transform,localPoint); SpriteOut o; o.position=float4(pixel.x/frame.viewport.x*2.0-1.0,1.0-pixel.y/frame.viewport.y*2.0,0,1); o.pixel=pixel; o.uv=q[vid]; o.clip=float4(sprite.clip.x,sprite.clip.y,sprite.clip.w,sprite.clip.h); o.color=float4(sprite.color.r,sprite.color.g,sprite.color.b,sprite.color.a); return o; }\nfragment float4 text_fragment(SpriteOut in [[stage_in]], texture2d<float> mask [[texture(0)]]) { if (in.pixel.x<in.clip.x || in.pixel.y<in.clip.y || in.pixel.x>=in.clip.x+in.clip.z || in.pixel.y>=in.clip.y+in.clip.w) discard_fragment(); constexpr sampler s(coord::normalized,address::clamp_to_edge,filter::linear); float alpha=mask.sample(s,in.uv).a; return float4(in.color.rgb,in.color.a*alpha); }\nfragment float4 image_fragment(SpriteOut in [[stage_in]], texture2d<float> image [[texture(0)]]) { if (in.pixel.x<in.clip.x || in.pixel.y<in.clip.y || in.pixel.x>=in.clip.x+in.clip.z || in.pixel.y>=in.clip.y+in.clip.w) discard_fragment(); constexpr sampler s(coord::normalized,address::clamp_to_edge,filter::linear); return image.sample(s,in.uv)*in.color; }\n")

(defn batched-texture-shader-source [] (-> (ptr i8))
  c"#include <metal_stdlib>\nusing namespace metal;\nstruct Rect { float x,y,w,h; };\nstruct Color { float r,g,b,a; };\nstruct Affine { float m11,m12,m21,m22,tx,ty; };\nstruct Sprite { Rect bounds; Color color; Rect clip; Affine transform; ulong texture; int id; int mode; };\nstruct Frame { float2 viewport; float2 pad; };\nstruct SpriteOut { float4 position [[position]]; float2 pixel; float2 uv; float4 clip; float4 color; };\nfloat2 apply_affine(Affine t,float2 p) { return float2(t.m11*p.x+t.m21*p.y+t.tx,t.m12*p.x+t.m22*p.y+t.ty); }\nvertex SpriteOut texture_vertex(uint vid [[vertex_id]],uint iid [[instance_id]],constant Sprite* sprites [[buffer(0)]],constant Frame& frame [[buffer(1)]]) { constexpr float2 q[6]={float2(0,0),float2(1,0),float2(0,1),float2(0,1),float2(1,0),float2(1,1)}; Sprite sprite=sprites[iid]; float2 localPoint=float2(sprite.bounds.x,sprite.bounds.y)+q[vid]*float2(sprite.bounds.w,sprite.bounds.h); float2 pixel=apply_affine(sprite.transform,localPoint); SpriteOut o; o.position=float4(pixel.x/frame.viewport.x*2.0-1.0,1.0-pixel.y/frame.viewport.y*2.0,0,1); o.pixel=pixel; o.uv=q[vid]; o.clip=float4(sprite.clip.x,sprite.clip.y,sprite.clip.w,sprite.clip.h); o.color=float4(sprite.color.r,sprite.color.g,sprite.color.b,sprite.color.a); return o; }\nfragment float4 text_fragment(SpriteOut in [[stage_in]],texture2d<float> mask [[texture(0)]]) { if(in.pixel.x<in.clip.x||in.pixel.y<in.clip.y||in.pixel.x>=in.clip.x+in.clip.z||in.pixel.y>=in.clip.y+in.clip.w) discard_fragment(); constexpr sampler s(coord::normalized,address::clamp_to_edge,filter::linear); float alpha=mask.sample(s,in.uv).a; return float4(in.color.rgb,in.color.a*alpha); }\nfragment float4 image_fragment(SpriteOut in [[stage_in]],texture2d<float> image [[texture(0)]]) { if(in.pixel.x<in.clip.x||in.pixel.y<in.clip.y||in.pixel.x>=in.clip.x+in.clip.z||in.pixel.y>=in.clip.y+in.clip.w) discard_fragment(); constexpr sampler s(coord::normalized,address::clamp_to_edge,filter::linear); return image.sample(s,in.uv)*in.color; }\n")

(defn atlas-texture-shader-source [] (-> (ptr i8))
  c"#include <metal_stdlib>\nusing namespace metal;\nstruct Rect { float x,y,w,h; };\nstruct Color { float r,g,b,a; };\nstruct Affine { float m11,m12,m21,m22,tx,ty; };\nstruct Sprite { Rect bounds; Color color; Rect clip; Rect uv; Affine transform; ulong texture; int id; int mode; float radius; float opacity; };\nstruct Frame { float2 viewport; float2 pad; };\nstruct SpriteOut { float4 position [[position]]; float2 pixel; float2 local; float2 size; float2 uv; float4 clip; float4 color; float radius; float opacity; };\nfloat2 apply_affine(Affine t,float2 p) { return float2(t.m11*p.x+t.m21*p.y+t.tx,t.m12*p.x+t.m22*p.y+t.ty); }\nfloat rounded_coverage(float2 local,float2 size,float radius) { if(radius<=0.0) return 1.0; float2 halfSize=size*0.5; float2 d=abs(local-halfSize)-(halfSize-radius); float sd=length(max(d,0.0))+min(max(d.x,d.y),0.0)-radius; float aa=max(fwidth(sd),0.75); return 1.0-smoothstep(-aa,aa,sd); }\nvertex SpriteOut texture_vertex(uint vid [[vertex_id]],uint iid [[instance_id]],constant Sprite* sprites [[buffer(0)]],constant Frame& frame [[buffer(1)]]) { constexpr float2 q[6]={float2(0,0),float2(1,0),float2(0,1),float2(0,1),float2(1,0),float2(1,1)}; Sprite sprite=sprites[iid]; float2 size=float2(sprite.bounds.w,sprite.bounds.h); float2 local=q[vid]*size; float2 localPoint=float2(sprite.bounds.x,sprite.bounds.y)+local; float2 pixel=apply_affine(sprite.transform,localPoint); SpriteOut o; o.position=float4(pixel.x/frame.viewport.x*2.0-1.0,1.0-pixel.y/frame.viewport.y*2.0,0,1); o.pixel=pixel; o.local=local; o.size=size; o.uv=float2(sprite.uv.x,sprite.uv.y)+q[vid]*float2(sprite.uv.w,sprite.uv.h); o.clip=float4(sprite.clip.x,sprite.clip.y,sprite.clip.w,sprite.clip.h); o.color=float4(sprite.color.r,sprite.color.g,sprite.color.b,sprite.color.a); o.radius=sprite.radius; o.opacity=sprite.opacity; return o; }\nfragment float4 text_fragment(SpriteOut in [[stage_in]],texture2d<float> mask [[texture(0)]]) { if(in.pixel.x<in.clip.x||in.pixel.y<in.clip.y||in.pixel.x>=in.clip.x+in.clip.z||in.pixel.y>=in.clip.y+in.clip.w) discard_fragment(); constexpr sampler s(coord::normalized,address::clamp_to_edge,filter::linear); float alpha=mask.sample(s,in.uv).a; return float4(in.color.rgb,in.color.a*alpha*in.opacity); }\nfragment float4 image_fragment(SpriteOut in [[stage_in]],texture2d<float> image [[texture(0)]]) { if(in.pixel.x<in.clip.x||in.pixel.y<in.clip.y||in.pixel.x>=in.clip.x+in.clip.z||in.pixel.y>=in.clip.y+in.clip.w) discard_fragment(); constexpr sampler s(coord::normalized,address::clamp_to_edge,filter::linear); float4 color=image.sample(s,in.uv)*in.color; color.a*=rounded_coverage(in.local,in.size,in.radius)*in.opacity; return color; }\nfragment float4 grayscale_image_fragment(SpriteOut in [[stage_in]],texture2d<float> image [[texture(0)]]) { if(in.pixel.x<in.clip.x||in.pixel.y<in.clip.y||in.pixel.x>=in.clip.x+in.clip.z||in.pixel.y>=in.clip.y+in.clip.w) discard_fragment(); constexpr sampler s(coord::normalized,address::clamp_to_edge,filter::linear); float4 color=image.sample(s,in.uv)*in.color; float luminance=dot(color.rgb,float3(0.2126,0.7152,0.0722)); return float4(luminance,luminance,luminance,color.a*rounded_coverage(in.local,in.size,in.radius)*in.opacity); }\n")

(defn path-shader-source [] (-> (ptr i8))
  c"#include <metal_stdlib>\nusing namespace metal;\nstruct Point { float x,y; };\nstruct Color { float r,g,b,a; };\nstruct Rect { float x,y,w,h; };\nstruct Affine { float m11,m12,m21,m22,tx,ty; };\nstruct Frame { float2 viewport; float2 pad; };\nstruct Uniform { Color color; Rect clip; Affine transform; float opacity; int padding; };\nstruct Out { float4 position [[position]]; float2 pixel; float4 color; float4 clip; float opacity; };\nvertex Out path_vertex(uint vid [[vertex_id]],constant Point* points [[buffer(0)]],constant Frame& frame [[buffer(1)]],constant Uniform& u [[buffer(2)]]) { Point p=points[vid]; float2 pixel=float2(u.transform.m11*p.x+u.transform.m21*p.y+u.transform.tx,u.transform.m12*p.x+u.transform.m22*p.y+u.transform.ty); Out o; o.position=float4(pixel.x/frame.viewport.x*2.0-1.0,1.0-pixel.y/frame.viewport.y*2.0,0,1); o.pixel=pixel; o.color=float4(u.color.r,u.color.g,u.color.b,u.color.a); o.clip=float4(u.clip.x,u.clip.y,u.clip.w,u.clip.h); o.opacity=u.opacity; return o; }\nfragment float4 path_fragment(Out in [[stage_in]]) { if(in.pixel.x<in.clip.x||in.pixel.y<in.clip.y||in.pixel.x>=in.clip.x+in.clip.z||in.pixel.y>=in.clip.y+in.clip.w) discard_fragment(); return float4(in.color.rgb,in.color.a*in.opacity); }\n")

(defn presentation-shader-source [] (-> (ptr i8))
  c"#include <metal_stdlib>\nusing namespace metal;\nstruct PresentOut { float4 position [[position]]; float2 uv; };\nvertex PresentOut present_vertex(uint vid [[vertex_id]]) { constexpr float2 positions[3]={float2(-1.0,1.0),float2(-1.0,-3.0),float2(3.0,1.0)}; constexpr float2 uvs[3]={float2(0.0,0.0),float2(0.0,2.0),float2(2.0,0.0)}; PresentOut o; o.position=float4(positions[vid],0.0,1.0); o.uv=uvs[vid]; return o; }\nfragment float4 present_fragment(PresentOut in [[stage_in]],texture2d<float> backing [[texture(0)]]) { constexpr sampler s(coord::normalized,address::clamp_to_edge,filter::nearest); return backing.sample(s,in.uv); }\n")

(defn presentation-pipeline-new [(device (ptr i8))] (-> (ptr i8))
  (let [library (msg (ptr i8) device (sel c"newLibraryWithSource:options:error:")
                     [(ptr i8) (ptr i8) (ptr (ptr i8))]
                     (nsstr (presentation-shader-source))
                     (primitive/cast (ptr i8) 0)
                     (primitive/cast (ptr (ptr i8)) 0))
        vertex (msg (ptr i8) library (sel c"newFunctionWithName:") [(ptr i8)] (nsstr c"present_vertex"))
        fragment (msg (ptr i8) library (sel c"newFunctionWithName:") [(ptr i8)] (nsstr c"present_fragment"))
        descriptor (msg (ptr i8) (class c"MTLRenderPipelineDescriptor") (sel c"new") [])
        colors (msg (ptr i8) descriptor (sel c"colorAttachments") [])
        color0 (msg (ptr i8) colors (sel c"objectAtIndexedSubscript:") [i64] 0)]
    (do
      (msg i64 descriptor (sel c"setVertexFunction:") [(ptr i8)] vertex)
      (msg i64 descriptor (sel c"setFragmentFunction:") [(ptr i8)] fragment)
      (msg i64 color0 (sel c"setPixelFormat:") [i64] 80)
      (let [pipeline (msg (ptr i8) device (sel c"newRenderPipelineStateWithDescriptor:error:")
                          [(ptr i8) (ptr (ptr i8))]
                          descriptor (primitive/cast (ptr (ptr i8)) 0))]
        (do
          (msg i64 vertex (sel c"release") [])
          (msg i64 fragment (sel c"release") [])
          (msg i64 library (sel c"release") [])
          (msg i64 descriptor (sel c"release") [])
          pipeline)))))

(defn renderer-valid? [(renderer Renderer)] (-> bool)
  (and (!= (primitive/cast i64 (load (field renderer device))) 0)
       (!= (primitive/cast i64 (load (field renderer pipeline))) 0)
       (!= (primitive/cast i64 (load (field renderer shadow-pipeline))) 0)
       (!= (primitive/cast i64 (load (field renderer path-pipeline))) 0)
       (!= (primitive/cast i64 (load (field renderer text-pipeline))) 0)
       (!= (primitive/cast i64 (load (field renderer image-pipeline))) 0)
       (!= (primitive/cast i64 (load (field renderer grayscale-image-pipeline))) 0)))

(defn configure-blending! [(attachment (ptr i8))] (-> i64)
  (do
    (msg i64 attachment (sel c"setBlendingEnabled:") [i8] (primitive/cast i8 1))
    (msg i64 attachment (sel c"setRgbBlendOperation:") [i64] 0)
    (msg i64 attachment (sel c"setAlphaBlendOperation:") [i64] 0)
    (msg i64 attachment (sel c"setSourceRGBBlendFactor:") [i64] 4)
    (msg i64 attachment (sel c"setDestinationRGBBlendFactor:") [i64] 5)
    (msg i64 attachment (sel c"setSourceAlphaBlendFactor:") [i64] 1)
    (msg i64 attachment (sel c"setDestinationAlphaBlendFactor:") [i64] 5)
    0))

(defn renderer-new [(view (ptr i8)) (width f32) (height f32) (scale f32)] (-> Renderer)
  (let [device (MTLCreateSystemDefaultDevice)
        queue (msg (ptr i8) device (sel c"newCommandQueue") [])
        source (nsstr (atlas-texture-shader-source))
        library
          (msg (ptr i8)
               device
               (sel c"newLibraryWithSource:options:error:")
               [(ptr i8) (ptr i8) (ptr (ptr i8))]
               source
               (primitive/cast (ptr i8) 0)
               (primitive/cast (ptr (ptr i8)) 0))
        paint-library
          (msg (ptr i8)
               device
               (sel c"newLibraryWithSource:options:error:")
               [(ptr i8) (ptr i8) (ptr (ptr i8))]
               (nsstr (affine-paint-shader-source))
               (primitive/cast (ptr i8) 0)
               (primitive/cast (ptr (ptr i8)) 0))
        shadow-library
          (msg (ptr i8)
               device
               (sel c"newLibraryWithSource:options:error:")
               [(ptr i8) (ptr i8) (ptr (ptr i8))]
               (nsstr (shadow-shader-source))
               (primitive/cast (ptr i8) 0)
               (primitive/cast (ptr (ptr i8)) 0))
        path-library
          (msg (ptr i8)
               device
               (sel c"newLibraryWithSource:options:error:")
               [(ptr i8) (ptr i8) (ptr (ptr i8))]
               (nsstr (path-shader-source))
               (primitive/cast (ptr i8) 0)
               (primitive/cast (ptr (ptr i8)) 0))
        vertex (msg (ptr i8) paint-library (sel c"newFunctionWithName:") [(ptr i8)] (nsstr c"paint_vertex"))
        fragment (msg (ptr i8) paint-library (sel c"newFunctionWithName:") [(ptr i8)] (nsstr c"paint_fragment"))
        text-vertex (msg (ptr i8) library (sel c"newFunctionWithName:") [(ptr i8)] (nsstr c"texture_vertex"))
        text-fragment (msg (ptr i8) library (sel c"newFunctionWithName:") [(ptr i8)] (nsstr c"text_fragment"))
        image-fragment (msg (ptr i8) library (sel c"newFunctionWithName:") [(ptr i8)] (nsstr c"image_fragment"))
        grayscale-image-fragment
          (msg (ptr i8)
               library
               (sel c"newFunctionWithName:")
               [(ptr i8)]
               (nsstr c"grayscale_image_fragment"))
        shadow-fragment
          (msg (ptr i8) shadow-library (sel c"newFunctionWithName:") [(ptr i8)] (nsstr c"shadow_fragment"))
        path-vertex (msg (ptr i8) path-library (sel c"newFunctionWithName:") [(ptr i8)] (nsstr c"path_vertex"))
        path-fragment (msg (ptr i8) path-library (sel c"newFunctionWithName:") [(ptr i8)] (nsstr c"path_fragment"))
        descriptor (msg (ptr i8) (class c"MTLRenderPipelineDescriptor") (sel c"new") [])
        attachments (msg (ptr i8) descriptor (sel c"colorAttachments") [])
        attachment (msg (ptr i8) attachments (sel c"objectAtIndexedSubscript:") [i64] 0)]
    (do
      (msg i64 descriptor (sel c"setVertexFunction:") [(ptr i8)] vertex)
      (msg i64 descriptor (sel c"setFragmentFunction:") [(ptr i8)] fragment)
      (msg i64 attachment (sel c"setPixelFormat:") [i64] 80)
      (configure-blending! attachment)
      (let [pipeline
              (msg (ptr i8)
                   device
                   (sel c"newRenderPipelineStateWithDescriptor:error:")
                   [(ptr i8) (ptr (ptr i8))]
                   descriptor
                   (primitive/cast (ptr (ptr i8)) 0))]
        (do
          (msg i64 descriptor (sel c"setFragmentFunction:") [(ptr i8)] shadow-fragment)
          (let [shadow-pipeline
                  (msg (ptr i8)
                       device
                       (sel c"newRenderPipelineStateWithDescriptor:error:")
                       [(ptr i8) (ptr (ptr i8))]
                       descriptor
                       (primitive/cast (ptr (ptr i8)) 0))]
            (do
              (msg i64 descriptor (sel c"setVertexFunction:") [(ptr i8)] text-vertex)
              (msg i64 descriptor (sel c"setFragmentFunction:") [(ptr i8)] text-fragment)
              (let [text-pipeline
                      (msg (ptr i8)
                           device
                           (sel c"newRenderPipelineStateWithDescriptor:error:")
                           [(ptr i8) (ptr (ptr i8))]
                           descriptor
                           (primitive/cast (ptr (ptr i8)) 0))
                    image-pipeline
                      (do
                        (msg i64 descriptor (sel c"setFragmentFunction:") [(ptr i8)] image-fragment)
                        (msg (ptr i8)
                             device
                             (sel c"newRenderPipelineStateWithDescriptor:error:")
                             [(ptr i8) (ptr (ptr i8))]
                             descriptor
                             (primitive/cast (ptr (ptr i8)) 0)))
                    grayscale-image-pipeline
                      (do
                        (msg i64
                             descriptor
                             (sel c"setFragmentFunction:")
                             [(ptr i8)]
                             grayscale-image-fragment)
                        (msg (ptr i8)
                             device
                             (sel c"newRenderPipelineStateWithDescriptor:error:")
                             [(ptr i8) (ptr (ptr i8))]
                             descriptor
                             (primitive/cast (ptr (ptr i8)) 0)))
                    path-pipeline
                      (do
                        (msg i64 descriptor (sel c"setVertexFunction:") [(ptr i8)] path-vertex)
                        (msg i64 descriptor (sel c"setFragmentFunction:") [(ptr i8)] path-fragment)
                        (msg (ptr i8)
                             device
                             (sel c"newRenderPipelineStateWithDescriptor:error:")
                             [(ptr i8) (ptr (ptr i8))]
                             descriptor
                             (primitive/cast (ptr (ptr i8)) 0)))
                    layer (msg (ptr i8) (class c"CAMetalLayer") (sel c"layer") [])
                    presentation-pipeline (presentation-pipeline-new device)]
                (do
                  (msg i64 layer (sel c"setDevice:") [(ptr i8)] device)
                  (msg i64 layer (sel c"setPixelFormat:") [i64] 80)
                  (msg i64 layer (sel c"setFramebufferOnly:") [i8] (primitive/cast i8 1))
                  (msg i64 layer (sel c"setMaximumDrawableCount:") [i64] 3)
                  (msg i64 layer (sel c"setDisplaySyncEnabled:") [i8] (primitive/cast i8 1))
                  (msg i64 view (sel c"setWantsLayer:") [i8] (primitive/cast i8 1))
                  (msg i64 view (sel c"setLayer:") [(ptr i8)] layer)
                  (let [(mut renderer) (primitive/zeroed Renderer)]
                    (do
                      (set! (.device renderer) device)
                      (set! (.queue renderer) queue)
                      (set! (.pipeline renderer) pipeline)
                      (set! (.shadow-pipeline renderer) shadow-pipeline)
                      (set! (.text-pipeline renderer) text-pipeline)
                      (set! (.image-pipeline renderer) image-pipeline)
                      (set! (.grayscale-image-pipeline renderer) grayscale-image-pipeline)
                      (set! (.presentation-pipeline renderer) presentation-pipeline)
                      (set! (.path-pipeline renderer) path-pipeline)
                      (set! (.layer renderer) layer)
                      (renderer-ensure-capacity! (mut renderer) 65536)
                      (renderer-resize! (mut renderer) width height scale)
                      (load renderer))))))))))))

(defn renderer-ensure-backing! [(renderer (mut Renderer))
                                (pixel-width i64)
                                (pixel-height i64)] (-> bool)
  (if (and (= (load (field renderer backing-width)) pixel-width)
           (and (= (load (field renderer backing-height)) pixel-height)
                (!= (primitive/cast i64 (load (field renderer backing-texture))) 0)))
      true
      (do
        (release-object! (load (field renderer backing-texture)))
        (set! (.backing-texture renderer) (primitive/cast (ptr i8) 0))
        (set! (.backing-valid renderer) false)
        (if (or (<= pixel-width 0) (<= pixel-height 0))
            false
            (let [descriptor
                    (msg (ptr i8)
                         (class c"MTLTextureDescriptor")
                         (sel c"texture2DDescriptorWithPixelFormat:width:height:mipmapped:")
                         [i64 i64 i64 i8]
                         80 pixel-width pixel-height (primitive/cast i8 0))]
              (do
                (msg i64 descriptor (sel c"setUsage:") [u64] (primitive/cast u64 5))
                (msg i64 descriptor (sel c"setStorageMode:") [u64] (primitive/cast u64 2))
                (let [texture
                        (msg (ptr i8)
                             (load (field renderer device))
                             (sel c"newTextureWithDescriptor:")
                             [(ptr i8)] descriptor)]
                  (do
                    (set! (.backing-texture renderer) texture)
                    (set! (.backing-width renderer) pixel-width)
                    (set! (.backing-height renderer) pixel-height)
                    (!= (primitive/cast i64 texture) 0)))))))))

(defn renderer-resize! [(renderer (mut Renderer)) (width f32) (height f32) (scale f32)] (-> i64)
  (do
    (set! (.width renderer) width)
    (set! (.height renderer) height)
    (set! (.scale renderer) scale)
    (msg i64
         (load (field renderer layer))
         (sel c"setFrame:")
         [CGRect]
         (CGRect
           :x 0.0
           :y 0.0
           :w (primitive/cast f64 width)
           :h (primitive/cast f64 height)))
    (msg i64
         (load (field renderer layer))
         (sel c"setDrawableSize:")
         [CGSize]
         (CGSize :w (primitive/cast f64 (* width scale)) :h (primitive/cast f64 (* height scale))))
    (renderer-ensure-backing! (mut renderer)
                              (primitive/cast i64 (* width scale))
                              (primitive/cast i64 (* height scale)))
    0))

(defn renderer-draw-damage-internal! [(renderer (mut Renderer))
                                      (scene ui/Scene)
                                      (damage ui/DamageRegion)
                                      (present bool)] (-> i64)
  (let [items (load (field scene items))
        shadows (load (field scene shadows))
        text-items (load (field scene text))
        path-vertices (load (field scene path-vertices))
        path-draws (load (field scene path-draws))
        paint-commands (load (field scene paint-commands))
        count (al/al-len [ui/Primitive] items)
        shadow-count (al/al-len [ui/Primitive] shadows)
        full-viewport (ui/rect 0.0 0.0
                               (load (field renderer width))
                               (load (field renderer height)))
        viewport (if (load (field renderer backing-valid))
                     (ui/intersect (load full-viewport) (load (field damage bounds)))
                     (load full-viewport))
        visible-shadow-count (visible-primitive-count shadows viewport)
        text-count (al/al-len [ui/TextSprite] text-items)
        path-vertex-count (al/al-len [path/PathPoint] path-vertices)
        path-draw-count (al/al-len [ui/PathDraw] path-draws)
        command-count (al/al-len [ui/PaintCommand] paint-commands)
        shadow-bytes (* visible-shadow-count (primitive/sizeof ui/Primitive))
        primitive-bytes (* count (primitive/sizeof ui/Primitive))
        sprite-offset (+ shadow-bytes primitive-bytes)
        sprite-bytes (* text-count (primitive/sizeof ui/TextSprite))
        path-offset (+ sprite-offset sprite-bytes)
        path-bytes (* path-vertex-count (primitive/sizeof path/PathPoint))
        total-bytes (+ path-offset path-bytes)]
    (if (or (and (load (field renderer backing-valid))
                 (not (load (field damage valid))))
            (or (<= (load (field viewport w)) 0.0)
                (or (<= (load (field viewport h)) 0.0)
                    (not (renderer-valid? (load renderer))))))
        0
        (if (< (renderer-ensure-capacity! (mut renderer) total-bytes) 0)
            0
            (let [drawable (if present
                               (msg (ptr i8) (load (field renderer layer)) (sel c"nextDrawable") [])
                               (primitive/cast (ptr i8) 0))]
              (if (and present (= (primitive/cast i64 drawable) 0))
                  0
                  (let [drawable-texture (if present
                                             (msg (ptr i8) drawable (sel c"texture") [])
                                             (primitive/cast (ptr i8) 0))
                        texture (load (field renderer backing-texture))
                        pass (msg (ptr i8) (class c"MTLRenderPassDescriptor") (sel c"renderPassDescriptor") [])
                        colors (msg (ptr i8) pass (sel c"colorAttachments") [])
                        color0 (msg (ptr i8) colors (sel c"objectAtIndexedSubscript:") [i64] 0)
                        command (msg (ptr i8) (load (field renderer queue)) (sel c"commandBuffer") [])]
                    (do
                      (msg i64 color0 (sel c"setTexture:") [(ptr i8)] texture)
                      (msg i64 color0 (sel c"setLoadAction:") [i64]
                           (if (load (field renderer backing-valid)) 1 2))
                      (msg i64 color0 (sel c"setStoreAction:") [i64] 1)
                      (msg i64
                           color0
                           (sel c"setClearColor:")
                           [MTLClearColor]
                           (MTLClearColor
                             :r 0.055
                             :g 0.063
                             :b 0.082
                             :a 1.0))
                      (let [encoder (msg (ptr i8) command (sel c"renderCommandEncoderWithDescriptor:") [(ptr i8)] pass)
                            frame (primitive/alloc-stack (array f32 4))
                            clear-item (primitive/alloc-stack ui/Primitive)
                            primitive-buffer (renderer-frame-buffer (load renderer))
                            (mut texture-runs) 0
                            (mut paint-runs) 0]
                        (do
                          (store! (primitive/index frame 0) (load (field renderer width)))
                          (store! (primitive/index frame 1) (load (field renderer height)))
                          (store! (primitive/index frame 2) 0.0)
                          (store! (primitive/index frame 3) 0.0)
                          (let [pixel-left (primitive/cast i64
                                                          (floorf (* (load (field viewport x))
                                                                     (load (field renderer scale)))))
                                pixel-top (primitive/cast i64
                                                         (floorf (* (load (field viewport y))
                                                                    (load (field renderer scale)))))
                                pixel-right (primitive/cast i64
                                                           (ceilf (* (+ (load (field viewport x))
                                                                        (load (field viewport w)))
                                                                     (load (field renderer scale)))))
                                pixel-bottom (primitive/cast i64
                                                            (ceilf (* (+ (load (field viewport y))
                                                                         (load (field viewport h)))
                                                                      (load (field renderer scale)))))]
                            (msg i64 encoder (sel c"setScissorRect:") [MTLScissorRect]
                                 (MTLScissorRect :x pixel-left :y pixel-top
                                                 :width (- pixel-right pixel-left)
                                                 :height (- pixel-bottom pixel-top))))
                          (msg i64
                               encoder
                               (sel c"setVertexBytes:length:atIndex:")
                               [(ptr i8) i64 i64]
                               (primitive/cast (ptr i8) frame)
                               16
                               1)
                          ; Repaint the damaged pixels to the window clear color
                          ; before replaying intersecting scene records. The
                          ; scissor keeps this full-viewport quad damage-local.
                          (store! clear-item
                                  (ui/Primitive
                                    :bounds (ui/rect 0.0 0.0
                                                     (load (field renderer width))
                                                     (load (field renderer height)))
                                    :color (ui/rgba 0.055 0.063 0.082 1.0)
                                    :radius 0.0 :border-width 0.0
                                    :border-color (ui/rgba 0.0 0.0 0.0 0.0)
                                    :clip (ui/rect 0.0 0.0
                                                   (load (field renderer width))
                                                   (load (field renderer height)))
                                    :transform (ui/affine-identity)
                                    :kind 0 :id -1 :opacity 1.0 :padding 0))
                          (msg i64 encoder (sel c"setRenderPipelineState:") [(ptr i8)]
                               (load (field renderer pipeline)))
                          (msg i64 encoder (sel c"setVertexBytes:length:atIndex:")
                               [(ptr i8) i64 i64]
                               (primitive/cast (ptr i8) clear-item)
                               (primitive/sizeof ui/Primitive)
                               0)
                          (msg i64 encoder
                               (sel c"drawPrimitives:vertexStart:vertexCount:instanceCount:")
                               [i64 i64 i64 i64] 3 0 6 1)
                          (if (> visible-shadow-count 0)
                              (do
                                (compact-visible-primitives! (msg (ptr i8) primitive-buffer (sel c"contents") [])
                                                             shadows
                                                             viewport)
                                (msg i64
                                     encoder
                                     (sel c"setRenderPipelineState:")
                                     [(ptr i8)]
                                     (load (field renderer shadow-pipeline)))
                                (msg i64
                                     encoder
                                     (sel c"setVertexBuffer:offset:atIndex:")
                                     [(ptr i8) i64 i64]
                                     primitive-buffer
                                     0
                                     0)
                                (msg i64
                                     encoder
                                     (sel c"drawPrimitives:vertexStart:vertexCount:instanceCount:")
                                     [i64 i64 i64 i64]
                                     3
                                     0
                                     6
                                     visible-shadow-count))
                              0)
                          (if (> count 0)
                              (do
                                (memcpy (primitive/cast (ptr i8)
                                                        (+ (primitive/cast i64
                                                                           (msg (ptr i8)
                                                                                primitive-buffer
                                                                                (sel c"contents")
                                                                                []))
                                                           shadow-bytes))
                                        (primitive/cast (ptr i8) (load (field items data)))
                                        primitive-bytes)
                                0)
                              0)
                          (if (> path-vertex-count 0)
                              (memcpy (primitive/cast (ptr i8)
                                                      (+ (primitive/cast i64
                                                                         (msg (ptr i8)
                                                                              primitive-buffer
                                                                              (sel c"contents")
                                                                              []))
                                                         path-offset))
                                      (primitive/cast (ptr i8) (load (field path-vertices data)))
                                      path-bytes)
                              (primitive/cast (ptr i8) 0))
                          (let [(mut command-index) 0]
                            (while (< (load command-index) command-count)
                              (let [paint-command (al/al-get [ui/PaintCommand] paint-commands (load command-index))]
                                (if (= (load (field paint-command kind)) 0)
                                    (let [viewport
                                            (ui/rect 0.0
                                                     0.0
                                                     (load (field renderer width))
                                                     (load (field renderer height)))
                                          item
                                            (al/al-get [ui/Primitive]
                                                       items
                                                       (primitive/cast i64
                                                                       (load (field paint-command index))))
                                          run-end
                                            (visible-paint-run-end paint-commands
                                                                   items
                                                                   (load command-index)
                                                                   command-count
                                                                   viewport)
                                          run-count (- run-end (load command-index))]
                                      (if (ui/primitive-visible? item viewport)
                                          (do
                                            (msg i64
                                                 encoder
                                                 (sel c"setRenderPipelineState:")
                                                 [(ptr i8)]
                                                 (load (field renderer pipeline)))
                                            (msg i64
                                                 encoder
                                                 (sel c"setVertexBuffer:offset:atIndex:")
                                                 [(ptr i8) i64 i64]
                                                 primitive-buffer
                                                 (+ shadow-bytes
                                                    (* (primitive/cast i64 (load (field paint-command index)))
                                                       (primitive/sizeof ui/Primitive)))
                                                 0)
                                            (msg i64
                                                 encoder
                                                 (sel c"drawPrimitives:vertexStart:vertexCount:instanceCount:")
                                                 [i64 i64 i64 i64]
                                                 3
                                                 0
                                                 6
                                                 run-count)
                                            (store! paint-runs (+ (load paint-runs) 1))
                                            (store! command-index run-end))
                                          (store! command-index (+ (load command-index) 1))))
                                    (let [draw
                                            (al/al-get [ui/PathDraw]
                                                       path-draws
                                                       (primitive/cast i64 (load (field paint-command index))))
                                          uniform (primitive/alloc-stack PathUniform)
                                          viewport
                                            (ui/rect 0.0
                                                     0.0
                                                     (load (field renderer width))
                                                     (load (field renderer height)))]
                                      (do
                                        (if (ui/path-draw-visible? draw viewport)
                                            (do
                                              (store! uniform
                                                      (PathUniform
                                                        :color (load (field draw color))
                                                        :clip (load (field draw clip))
                                                        :transform (load (field draw transform))
                                                        :opacity (load (field draw opacity))
                                                        :padding 0))
                                              (msg i64
                                                   encoder
                                                   (sel c"setRenderPipelineState:")
                                                   [(ptr i8)]
                                                   (load (field renderer path-pipeline)))
                                              (msg i64
                                                   encoder
                                                   (sel c"setVertexBuffer:offset:atIndex:")
                                                   [(ptr i8) i64 i64]
                                                   primitive-buffer
                                                   (+ path-offset
                                                      (* (load (field draw vertex-start))
                                                         (primitive/sizeof path/PathPoint)))
                                                   0)
                                              (msg i64
                                                   encoder
                                                   (sel c"setVertexBytes:length:atIndex:")
                                                   [(ptr i8) i64 i64]
                                                   (primitive/cast (ptr i8) uniform)
                                                   (primitive/sizeof PathUniform)
                                                   2)
                                              (msg i64
                                                   encoder
                                                   (sel c"drawPrimitives:vertexStart:vertexCount:")
                                                   [i64 i64 i64]
                                                   3
                                                   0
                                                   (load (field draw vertex-count)))
                                              (store! paint-runs (+ (load paint-runs) 1)))
                                            0)
                                        (store! command-index (+ (load command-index) 1))))))))
                          (if (> text-count 0)
                              (do
                                (memcpy (primitive/cast (ptr i8)
                                                        (+ (primitive/cast i64
                                                                           (msg (ptr i8)
                                                                                primitive-buffer
                                                                                (sel c"contents")
                                                                                []))
                                                           sprite-offset))
                                        (primitive/cast (ptr i8) (load (field text-items data)))
                                        sprite-bytes)
                                (let [(mut i) 0]
                                  (while (< (load i) text-count)
                                    (let [sprite (primitive/index (load (field text-items data)) (load i))
                                          viewport
                                            (ui/rect 0.0
                                                     0.0
                                                     (load (field renderer width))
                                                     (load (field renderer height)))
                                          run-end
                                            (visible-sprite-run-end text-items
                                                                    (load i)
                                                                    text-count
                                                                    viewport)
                                          run-count (- run-end (load i))]
                                      (if (ui/sprite-visible? (load sprite) viewport)
                                          (do
                                            (msg i64
                                                 encoder
                                                 (sel c"setRenderPipelineState:")
                                                 [(ptr i8)]
                                                 (cond
                                                   (= (load (field sprite mode)) 1)
                                                     (load (field renderer image-pipeline))
                                                   (= (load (field sprite mode)) 2)
                                                     (load (field renderer grayscale-image-pipeline))
                                                   :else
                                                     (load (field renderer text-pipeline))))
                                            (msg i64
                                                 encoder
                                                 (sel c"setVertexBuffer:offset:atIndex:")
                                                 [(ptr i8) i64 i64]
                                                 primitive-buffer
                                                 (+ sprite-offset
                                                    (* (load i) (primitive/sizeof ui/TextSprite)))
                                                 0)
                                            (msg i64
                                                 encoder
                                                 (sel c"setFragmentTexture:atIndex:")
                                                 [(ptr i8) i64]
                                                 (load (field sprite texture))
                                                 0)
                                            (msg i64
                                                 encoder
                                                 (sel c"drawPrimitives:vertexStart:vertexCount:instanceCount:")
                                                 [i64 i64 i64 i64]
                                                 3
                                                 0
                                                 6
                                                 run-count)
                                            (store! texture-runs (+ (load texture-runs) 1))
                                            (store! i run-end))
                                          (store! i (+ (load i) 1))))))
                                0)
                              0)
                          (msg i64 encoder (sel c"endEncoding") [])
                          ; Present through a fullscreen render pass. CAMetalLayer
                          ; remains framebuffer-only, allowing the driver to keep
                          ; its optimal drawable allocation while the private
                          ; backing texture remains sampleable and persistent.
                          (if present
                           (let [present-pass
                                  (msg (ptr i8) (class c"MTLRenderPassDescriptor")
                                       (sel c"renderPassDescriptor") [])
                                present-colors
                                  (msg (ptr i8) present-pass (sel c"colorAttachments") [])
                                present-color0
                                  (msg (ptr i8) present-colors
                                       (sel c"objectAtIndexedSubscript:") [i64] 0)]
                            (do
                              (msg i64 present-color0 (sel c"setTexture:") [(ptr i8)] drawable-texture)
                              (msg i64 present-color0 (sel c"setLoadAction:") [i64] 0)
                              (msg i64 present-color0 (sel c"setStoreAction:") [i64] 1)
                              (let [present-encoder
                                      (msg (ptr i8) command
                                           (sel c"renderCommandEncoderWithDescriptor:")
                                           [(ptr i8)] present-pass)]
                                (do
                                  (msg i64 present-encoder (sel c"setRenderPipelineState:")
                                       [(ptr i8)] (load (field renderer presentation-pipeline)))
                                  (msg i64 present-encoder (sel c"setFragmentTexture:atIndex:")
                                       [(ptr i8) i64] texture 0)
                                  (msg i64 present-encoder
                                       (sel c"drawPrimitives:vertexStart:vertexCount:")
                                       [i64 i64 i64] 3 0 3)
                                  (msg i64 present-encoder (sel c"endEncoding") [])))))
                           0)
                          (if present
                              (msg i64 command (sel c"presentDrawable:") [(ptr i8)] drawable)
                              0)
                          (msg i64 command (sel c"commit") [])
                          (set! (.frames renderer) (+ (load (field renderer frames)) 1))
                          (set! (.backing-valid renderer) true)
                          (set! (.draw-calls renderer)
                                (+ (load (field renderer draw-calls))
                                   (+ 1
                                      (+ (+ (if (> visible-shadow-count 0) 1 0)
                                            (load paint-runs))
                                         (load texture-runs)))))
                          1))))))))))

(defn renderer-draw-damage! [(renderer (mut Renderer))
                             (scene ui/Scene)
                             (damage ui/DamageRegion)] (-> i64)
  (renderer-draw-damage-internal! (mut renderer) scene damage true))

(defn renderer-render-offscreen! [(renderer (mut Renderer))
                                  (scene ui/Scene)
                                  (damage ui/DamageRegion)] (-> PixelBuffer)
  (let [(mut result) (primitive/zeroed PixelBuffer)
        width (load (field renderer backing-width))
        height (load (field renderer backing-height))]
    (if (or (<= width 0)
            (or (<= height 0)
                (= (renderer-draw-damage-internal! (mut renderer) scene damage false) 0)))
        (load result)
        (let [row-bytes (* (/ (+ (* width 4) 255) 256) 256)
              byte-count (* row-bytes height)
              buffer (msg (ptr i8) (load (field renderer device))
                          (sel c"newBufferWithLength:options:") [i64 u64]
                          byte-count (primitive/cast u64 0))
              command (msg (ptr i8) (load (field renderer queue)) (sel c"commandBuffer") [])
              blit (msg (ptr i8) command (sel c"blitCommandEncoder") [])]
          (if (or (= (primitive/cast i64 buffer) 0)
                  (= (primitive/cast i64 blit) 0))
              (do (release-object! buffer) (load result))
              (do
                (msg i64 blit
                     (sel c"copyFromTexture:sourceSlice:sourceLevel:sourceOrigin:sourceSize:toBuffer:destinationOffset:destinationBytesPerRow:destinationBytesPerImage:")
                     [(ptr i8) u64 u64 MTLOrigin MTLSize (ptr i8) u64 u64 u64]
                     (load (field renderer backing-texture))
                     (primitive/cast u64 0) (primitive/cast u64 0)
                     (MTLOrigin :x 0 :y 0 :z 0)
                     (MTLSize :width (primitive/cast u64 width)
                              :height (primitive/cast u64 height) :depth 1)
                     buffer (primitive/cast u64 0)
                     (primitive/cast u64 row-bytes)
                     (primitive/cast u64 byte-count))
                (msg i64 blit (sel c"endEncoding") [])
                (msg i64 command (sel c"commit") [])
                (msg i64 command (sel c"waitUntilCompleted") [])
                (set! (.buffer result) buffer)
                (set! (.bytes result) (primitive/cast (ptr u8)
                                      (msg (ptr i8) buffer (sel c"contents") [])))
                (set! (.width result) width)
                (set! (.height result) height)
                (set! (.row-bytes result) row-bytes)
                (load result)))))))

(defn pixel-buffer-valid? [(pixels PixelBuffer)] (-> bool)
  (!= (primitive/cast i64 (load (field pixels buffer))) 0))

(defn pixel-buffer-byte [(pixels PixelBuffer) (x i64) (y i64) (channel i64)] (-> u8)
  (if (or (< x 0) (or (>= x (load (field pixels width)))
      (or (< y 0) (or (>= y (load (field pixels height)))
      (or (< channel 0) (>= channel 4))))))
      (primitive/cast u8 0)
      (load (primitive/index (load (field pixels bytes))
                             (+ (* y (load (field pixels row-bytes)))
                                (+ (* x 4) channel))))))

(defn pixel-buffer-free! [(pixels (mut PixelBuffer))] (-> i64)
  (do
    (release-object! (load (field pixels buffer)))
    (set! (.buffer pixels) (primitive/cast (ptr i8) 0))
    (set! (.bytes pixels) (primitive/cast (ptr u8) 0))
    0))

(defn renderer-draw! [(renderer (mut Renderer)) (scene ui/Scene)] (-> i64)
  (renderer-draw-damage!
    (mut renderer)
    scene
    (ui/DamageRegion
      :bounds (ui/rect 0.0 0.0 (load (field renderer width)) (load (field renderer height)))
      :valid true)))

(defn release-object! [(object (ptr i8))] (-> i64)
  (if (!= (primitive/cast i64 object) 0)
      (do (msg i64 object (sel c"release") []) 1)
      0))

(defn renderer-free! [(renderer (mut Renderer))] (-> i64)
  (do
    (release-object! (load (field renderer primitive-buffer-0)))
    (release-object! (load (field renderer primitive-buffer-1)))
    (release-object! (load (field renderer primitive-buffer-2)))
    (release-object! (load (field renderer backing-texture)))
    (release-object! (load (field renderer pipeline)))
    (release-object! (load (field renderer shadow-pipeline)))
    (release-object! (load (field renderer path-pipeline)))
    (release-object! (load (field renderer text-pipeline)))
    (release-object! (load (field renderer image-pipeline)))
    (release-object! (load (field renderer grayscale-image-pipeline)))
    (release-object! (load (field renderer presentation-pipeline)))
    (release-object! (load (field renderer queue)))
    (set! (.primitive-buffer-0 renderer) (primitive/cast (ptr i8) 0))
    (set! (.primitive-buffer-1 renderer) (primitive/cast (ptr i8) 0))
    (set! (.primitive-buffer-2 renderer) (primitive/cast (ptr i8) 0))
    (set! (.backing-texture renderer) (primitive/cast (ptr i8) 0))
    (set! (.backing-valid renderer) false)
    (set! (.pipeline renderer) (primitive/cast (ptr i8) 0))
    (set! (.shadow-pipeline renderer) (primitive/cast (ptr i8) 0))
    (set! (.path-pipeline renderer) (primitive/cast (ptr i8) 0))
    (set! (.text-pipeline renderer) (primitive/cast (ptr i8) 0))
    (set! (.image-pipeline renderer) (primitive/cast (ptr i8) 0))
    (set! (.grayscale-image-pipeline renderer) (primitive/cast (ptr i8) 0))
    (set! (.presentation-pipeline renderer) (primitive/cast (ptr i8) 0))
    (set! (.queue renderer) (primitive/cast (ptr i8) 0))
    0))
