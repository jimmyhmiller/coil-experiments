(module experiments.coil_gpui.measure)
(import "experiments.coil_gpui.ui" :as ui)

(export IntrinsicSize
        Constraints
        intrinsic-size
        constraints
        unconstrained
        resolve-size)

;;; Content reports both its irreducible minimum and preferred dimensions.
;;; An optional aspect ratio derives a missing axis before hard constraints are
;;; applied. Zero maximum values mean unbounded, consistently with flex/grid.
(defstruct IntrinsicSize
  [(min-width f32) (min-height f32)
   (preferred-width f32) (preferred-height f32)
   (aspect-ratio f32)])

(defstruct Constraints
  [(min-width f32) (min-height f32) (max-width f32) (max-height f32)])

(defn nonnegative [(value f32)] (-> f32)
  (if (> value 0.0) value 0.0))

(defn intrinsic-size [(min-width f32) (min-height f32)
                      (preferred-width f32) (preferred-height f32)
                      (aspect-ratio f32)] (-> IntrinsicSize)
  (let [mw (nonnegative min-width)
        mh (nonnegative min-height)]
    (IntrinsicSize
      :min-width mw
      :min-height mh
      :preferred-width (let [v (nonnegative preferred-width)] (if (< v mw) mw v))
      :preferred-height (let [v (nonnegative preferred-height)] (if (< v mh) mh v))
      :aspect-ratio (nonnegative aspect-ratio))))

(defn constraints [(min-width f32) (min-height f32)
                   (max-width f32) (max-height f32)] (-> Constraints)
  (Constraints
    :min-width (nonnegative min-width)
    :min-height (nonnegative min-height)
    :max-width (nonnegative max-width)
    :max-height (nonnegative max-height)))

(defn unconstrained [] (-> Constraints)
  (constraints 0.0 0.0 0.0 0.0))

(defn clamp-axis [(value f32) (minimum f32) (maximum f32)] (-> f32)
  (let [low (if (< value minimum) minimum value)]
    (if (and (> maximum 0.0) (> low maximum)) maximum low)))

(defn resolve-size [(intrinsic IntrinsicSize) (limits Constraints)] (-> ui/Rect)
  (let [ratio (load (field intrinsic aspect-ratio))
        preferred-width (load (field intrinsic preferred-width))
        preferred-height (load (field intrinsic preferred-height))
        initial-width
          (if (and (> ratio 0.0) (<= preferred-width 0.0))
              (* preferred-height ratio)
              preferred-width)
        initial-height
          (if (and (> ratio 0.0) (<= preferred-height 0.0))
              (/ initial-width ratio)
              preferred-height)
        min-width (let [a (load (field intrinsic min-width))
                        b (load (field limits min-width))] (if (> a b) a b))
        min-height (let [a (load (field intrinsic min-height))
                         b (load (field limits min-height))] (if (> a b) a b))
        width (clamp-axis initial-width min-width (load (field limits max-width)))
        height (clamp-axis initial-height min-height (load (field limits max-height)))
        ratio-height (if (> ratio 0.0) (/ width ratio) height)
        final-height (clamp-axis ratio-height min-height (load (field limits max-height)))
        ratio-width (if (> ratio 0.0) (* final-height ratio) width)
        final-width (clamp-axis ratio-width min-width (load (field limits max-width)))]
    (ui/rect 0.0 0.0 final-width final-height)))
