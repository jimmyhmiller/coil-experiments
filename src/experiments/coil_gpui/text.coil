(defstruct CGRect [(x f64) (y f64) (w f64) (h f64)])

(defstruct CGPoint [(x f64) (y f64)])

(defstruct CGSize [(w f64) (h f64)])

(defstruct CFRange [(location i64) (length i64)])

(defstruct MTLOrigin [(x u64) (y u64) (z u64)])

(defstruct MTLSize [(w u64) (h u64) (d u64)])

(defstruct MTLRegion [(origin MTLOrigin) (size MTLSize)])

;;; A persistent Metal alpha-mask texture. AppKit/CoreText performs Unicode
;;; shaping and glyph rasterization once; each frame Metal applies color and
;;; composites the cached mask. The texture is owned and explicitly released.
(defstruct TextTexture
  [(texture (ptr i8)) (width i64) (height i64) (scale f32) (uv ui/Rect) (owned bool)])

(defstruct AtlasPage
  [(texture (ptr i8))
   (cursor-x i64) (cursor-y i64) (row-height i64)
   (last-used i64) (generation i64)])

(defstruct TextAtlas
  [(texture (ptr i8))
   (device (ptr i8))
   (width i64)
   (height i64)
   (cursor-x i64)
   (cursor-y i64)
   (row-height i64)
   (padding i64)
   (scale f32)
   (pages (al/ArrayList AtlasPage))
   (active-page i64)
   (max-pages i64)
   (epoch i64)
   (evictions i64)
   (glyphs (al/ArrayList GlyphEntry))])

(defstruct GlyphEntry
  [(font (ptr i8))
   (texture (ptr i8))
   (page i64)
   (glyph u16)
   (subpixel-x i32)
   (subpixel-y i32)
   (pixel-width i64)
   (pixel-height i64)
   (bearing-x f32)
   (bearing-top f32)
   (advance f32)
   (uv ui/Rect)])

(defstruct ShapedGlyph
  [(texture TextTexture)
   (x f32)
   (y f32)
   (pen-x f32)
   (advance f32)
   (string-index i64)
   (glyph u16)])

(defstruct ShapedLine
  [(glyphs (al/ArrayList ShapedGlyph))
   (width f32)
   (ascent f32)
   (descent f32)
   (length i64)
   (valid bool)])

(defstruct ParagraphLine
  [(line ShapedLine)
   (byte-start i64)
   (byte-content-end i64)
   (byte-end i64)
   (y f32)])

(defstruct ShapedParagraph
  [(lines (al/ArrayList ParagraphLine))
   (width f32)
   (height f32)
   (line-height f32)
   (length i64)
   (valid bool)])

(defstruct TextPosition [(x f32) (y f32) (height f32)])

(defn shaped-line-intrinsic-size [(line ShapedLine)] (-> measure/IntrinsicSize)
  (let [height (+ (load (field line ascent)) (load (field line descent)))]
    (measure/intrinsic-size (load (field line width)) height
                            (load (field line width)) height 0.0)))

(defn shaped-paragraph-intrinsic-size [(paragraph ShapedParagraph)] (-> measure/IntrinsicSize)
  (let [lines (load (field paragraph lines))
        (mut widest-line) (primitive/cast f32 0.0)]
    (do
      (for [i 0 (al/al-len [ParagraphLine] lines)]
        (let [entry (al/al-get [ParagraphLine] lines i)
              width (load (field (field entry line) width))]
          (if (> width (load widest-line)) (store! widest-line width) 0)))
      (measure/intrinsic-size (load widest-line)
                              (load (field paragraph line-height))
                              (load (field paragraph width))
                              (load (field paragraph height))
                              0.0))))

(defstruct AtlasRegion [(x i64) (y i64) (w i64) (h i64) (valid bool)])

(defn nsstr [(value (ptr i8))] (-> (ptr i8))
  (msg (ptr i8) (class c"NSString") (sel c"stringWithUTF8String:") [(ptr i8)] value))

(defn text-texture-valid? [(text TextTexture)] (-> bool)
  (!= (primitive/cast i64 (load (field text texture))) 0))

(defn text-texture-intrinsic-size [(text TextTexture)] (-> measure/IntrinsicSize)
  (let [scale (let [value (load (field text scale))] (if (> value 0.0) value 1.0))
        width (/ (primitive/cast f32 (load (field text width))) scale)
        height (/ (primitive/cast f32 (load (field text height))) scale)]
    (measure/intrinsic-size width height width height 0.0)))

(defn text-atlas-valid? [(atlas TextAtlas)] (-> bool)
  (!= (primitive/cast i64 (load (field atlas texture))) 0))

(defn empty-atlas [(device (ptr i8)) (scale f32) (max-pages i64)] (-> TextAtlas)
  (TextAtlas
    :texture (primitive/cast (ptr i8) 0)
    :device device
    :width 0
    :height 0
    :cursor-x 0
    :cursor-y 0
    :row-height 0
    :padding 0
    :scale scale
    :pages (al/al-new [AtlasPage] (alloc/malloc-allocator))
    :active-page -1
    :max-pages (if (< max-pages 1) 1 max-pages)
    :epoch 0
    :evictions 0
    :glyphs (al/al-new [GlyphEntry] (alloc/malloc-allocator))))

(defn text-atlas-new-bounded [(device (ptr i8))
                              (width i64)
                              (height i64)
                              (padding i64)
                              (scale f32)
                              (max-pages i64)] (-> TextAtlas)
  (if (or (<= width 0) (<= height 0))
      (empty-atlas device scale max-pages)
      (let [descriptor
              (msg (ptr i8)
                   (class c"MTLTextureDescriptor")
                   (sel c"texture2DDescriptorWithPixelFormat:width:height:mipmapped:")
                   [i64 i64 i64 i8]
                   80
                   width
                   height
                   (primitive/cast i8 0))
            texture (msg (ptr i8) device (sel c"newTextureWithDescriptor:") [(ptr i8)] descriptor)
            row-bytes (* width 4)
            byte-count (* row-bytes height)
            pixels (malloc byte-count)]
        (if (or (= (primitive/cast i64 texture) 0) (= (primitive/cast i64 pixels) 0))
            (do
              (if (!= (primitive/cast i64 texture) 0)
                  (msg i64 texture (sel c"release") [])
                  0)
              (if (!= (primitive/cast i64 pixels) 0) (do (free pixels) 0) 0)
              (empty-atlas device scale max-pages))
            (do
              (memset pixels 0 byte-count)
              (msg i64
                   texture
                   (sel c"replaceRegion:mipmapLevel:withBytes:bytesPerRow:")
                   [MTLRegion i64 (ptr i8) i64]
                   (MTLRegion
                     :origin
                       (MTLOrigin
                         :x 0
                         :y 0
                         :z 0)
                     :size
                       (MTLSize
                         :w (primitive/cast u64 width)
                         :h (primitive/cast u64 height)
                         :d 1))
                   0
                   pixels
                   row-bytes)
              (free pixels)
              (let [gap (if (< padding 1) 1 padding)
                    (mut pages) (al/al-new [AtlasPage] (alloc/malloc-allocator))]
                (do
                  (al/al-push! [AtlasPage] (mut pages)
                               (AtlasPage :texture texture
                                          :cursor-x gap :cursor-y gap :row-height 0
                                          :last-used 0 :generation 1))
                  (TextAtlas
                    :texture texture
                    :device device
                    :width width
                    :height height
                    :cursor-x gap
                    :cursor-y gap
                    :row-height 0
                    :padding gap
                    :scale scale
                    :pages (load pages)
                    :active-page 0
                    :max-pages (if (< max-pages 1) 1 max-pages)
                    :epoch 1
                    :evictions 0
                    :glyphs (al/al-new [GlyphEntry] (alloc/malloc-allocator))))))))))

(defn text-atlas-new [(device (ptr i8))
                      (width i64)
                      (height i64)
                      (padding i64)
                      (scale f32)] (-> TextAtlas)
  (text-atlas-new-bounded device width height padding scale 4))

(defn atlas-page-texture-new [(atlas TextAtlas)] (-> (ptr i8))
  (let [width (load (field atlas width))
        height (load (field atlas height))
        descriptor
          (msg (ptr i8) (class c"MTLTextureDescriptor")
               (sel c"texture2DDescriptorWithPixelFormat:width:height:mipmapped:")
               [i64 i64 i64 i8] 80 width height (primitive/cast i8 0))
        texture (msg (ptr i8) (load (field atlas device))
                     (sel c"newTextureWithDescriptor:") [(ptr i8)] descriptor)
        row-bytes (* width 4)
        byte-count (* row-bytes height)
        pixels (malloc byte-count)]
    (if (or (= (primitive/cast i64 texture) 0)
            (= (primitive/cast i64 pixels) 0))
        (do
          (if (!= (primitive/cast i64 texture) 0) (msg i64 texture (sel c"release") []) 0)
          (if (!= (primitive/cast i64 pixels) 0) (do (free pixels) 0) 0)
          (primitive/cast (ptr i8) 0))
        (do
          (memset pixels 0 byte-count)
          (msg i64 texture (sel c"replaceRegion:mipmapLevel:withBytes:bytesPerRow:")
               [MTLRegion i64 (ptr i8) i64]
               (MTLRegion :origin (MTLOrigin :x 0 :y 0 :z 0)
                          :size (MTLSize :w (primitive/cast u64 width)
                                        :h (primitive/cast u64 height) :d 1))
               0 pixels row-bytes)
          (free pixels)
          texture))))

(defn text-atlas-sync-active! [(atlas (mut TextAtlas))] (-> i64)
  (let [index (load (field atlas active-page))
        pages (load (field atlas pages))]
    (if (or (< index 0) (>= index (al/al-len [AtlasPage] pages)))
        0
        (let [page (primitive/index (load (field pages data)) index)]
          (do
            (store! (field page cursor-x) (load (field atlas cursor-x)))
            (store! (field page cursor-y) (load (field atlas cursor-y)))
            (store! (field page row-height) (load (field atlas row-height)))
            1)))))

(defn text-atlas-activate-page! [(atlas (mut TextAtlas)) (index i64)] (-> bool)
  (let [pages (load (field atlas pages))]
    (if (or (< index 0) (>= index (al/al-len [AtlasPage] pages)))
        false
        (do
          (text-atlas-sync-active! (mut atlas))
          (let [page (primitive/index (load (field pages data)) index)
                next-epoch (+ (load (field atlas epoch)) 1)]
            (do
              (set! (.active-page atlas) index)
              (set! (.texture atlas) (load (field page texture)))
              (set! (.cursor-x atlas) (load (field page cursor-x)))
              (set! (.cursor-y atlas) (load (field page cursor-y)))
              (set! (.row-height atlas) (load (field page row-height)))
              (set! (.epoch atlas) next-epoch)
              (store! (field page last-used) next-epoch)
              true))))))

(defn text-atlas-drop-page-glyphs! [(atlas (mut TextAtlas)) (page-index i64)] (-> i64)
  (let [(mut glyphs) (load (field atlas glyphs))
        count (al/al-len [GlyphEntry] glyphs)
        (mut write) 0
        (mut removed) 0]
    (do
      (for [i 0 count]
        (let [entry (primitive/index (load (field glyphs data)) i)]
          (if (= (load (field entry page)) page-index)
              (do
                (if (!= (primitive/cast i64 (load (field entry font))) 0)
                    (msg i64 (load (field entry font)) (sel c"release") []) 0)
                (set! removed (+ (load removed) 1)))
              (do
                (if (!= (load write) i)
                    (store! (primitive/index (load (field glyphs data)) (load write)) (load entry))
                    0)
                (set! write (+ (load write) 1))))))
      (set! (.len (.glyphs atlas)) (load write))
      (load removed))))

;;; Select another page after a shelf miss. New pages are added up to the hard
;;; cap; afterwards the least-recently-used page is replaced. Existing shaped
;;; glyphs retain their texture independently, so cache eviction cannot create a
;;; dangling GPU resource.
(defn text-atlas-next-page! [(atlas (mut TextAtlas))] (-> bool)
  (let [pages (load (field atlas pages))
        count (al/al-len [AtlasPage] pages)
        gap (load (field atlas padding))]
    (if (< count (load (field atlas max-pages)))
        (let [texture (atlas-page-texture-new (load atlas))]
          (if (= (primitive/cast i64 texture) 0)
              false
              (do
                (text-atlas-sync-active! (mut atlas))
                (al/al-push! [AtlasPage] (mut (field atlas pages))
                             (AtlasPage :texture texture :cursor-x gap :cursor-y gap
                                        :row-height 0 :last-used 0 :generation 1))
                (text-atlas-activate-page! (mut atlas) count))))
        (let [(mut victim) 0
              (mut oldest) (load (field (primitive/index (load (field pages data)) 0) last-used))]
          (do
            (for [i 1 count]
              (let [page (primitive/index (load (field pages data)) i)]
                (if (< (load (field page last-used)) (load oldest))
                    (do (set! victim i) (set! oldest (load (field page last-used))))
                    0)))
            (let [texture (atlas-page-texture-new (load atlas))]
              (if (= (primitive/cast i64 texture) 0)
                  false
                  (let [page (primitive/index (load (field pages data)) (load victim))]
                    (do
                      (text-atlas-sync-active! (mut atlas))
                      (text-atlas-drop-page-glyphs! (mut atlas) (load victim))
                      (msg i64 (load (field page texture)) (sel c"release") [])
                      (store! (field page texture) texture)
                      (store! (field page cursor-x) gap)
                      (store! (field page cursor-y) gap)
                      (store! (field page row-height) 0)
                      (store! (field page generation) (+ (load (field page generation)) 1))
                      (set! (.evictions atlas) (+ (load (field atlas evictions)) 1))
                      (text-atlas-activate-page! (mut atlas) (load victim)))))))))))

(defn invalid-region [] (-> AtlasRegion)
  (AtlasRegion
    :x 0
    :y 0
    :w 0
    :h 0
    :valid false))

;;; Bounded shelf allocation. Failure is explicit and leaves allocator state
;;; unchanged, allowing the caller to create/evict an atlas page deliberately.
(defn text-atlas-reserve! [(atlas (mut TextAtlas)) (width i64) (height i64)] (-> AtlasRegion)
  (if (or (<= width 0)
          (<= height 0)
          (> (+ width (* (load (field atlas padding)) 2)) (load (field atlas width)))
          (> (+ height (* (load (field atlas padding)) 2)) (load (field atlas height))))
      (invalid-region)
      (let [gap (load (field atlas padding))
            current-x (load (field atlas cursor-x))
            needs-row (> (+ (+ current-x width) gap) (load (field atlas width)))
            x (if needs-row gap current-x)
            y
              (if needs-row
                  (+ (+ (load (field atlas cursor-y)) (load (field atlas row-height))) gap)
                  (load (field atlas cursor-y)))
            prior-row-height (if needs-row 0 (load (field atlas row-height)))]
        (if (> (+ (+ y height) gap) (load (field atlas height)))
            (invalid-region)
            (do
              (set! (.cursor-x atlas) (+ (+ x width) gap))
              (set! (.cursor-y atlas) y)
              (set! (.row-height atlas) (if (> height prior-row-height) height prior-row-height))
              (AtlasRegion
                :x x
                :y y
                :w width
                :h height
                :valid true))))))

(defn empty-text-texture [(scale f32)] (-> TextTexture)
  (TextTexture
    :texture (primitive/cast (ptr i8) 0)
    :width 0
    :height 0
    :scale scale
    :uv (ui/rect 0.0 0.0 1.0 1.0)
    :owned false))

(defn text-atlas-add! [(atlas (mut TextAtlas))
                       (utf8 (ptr i8))
                       (width i64)
                       (height i64)
                       (font-size f64)] (-> TextTexture)
  (let [scale (load (field atlas scale))
        pixel-width (primitive/cast i64 (* (primitive/cast f32 width) scale))
        pixel-height (primitive/cast i64 (* (primitive/cast f32 height) scale))
        prior-x (load (field atlas cursor-x))
        prior-y (load (field atlas cursor-y))
        prior-row-height (load (field atlas row-height))
        region
          (if (text-atlas-valid? (load atlas))
              (text-atlas-reserve! (mut atlas) pixel-width pixel-height)
              (invalid-region))]
    (if (or (not (text-atlas-valid? (load atlas))) (not (load (field region valid))))
        (if (and (text-atlas-valid? (load atlas))
                 (and (<= (+ pixel-width (* (load (field atlas padding)) 2))
                          (load (field atlas width)))
                      (and (<= (+ pixel-height (* (load (field atlas padding)) 2))
                               (load (field atlas height)))
                           (text-atlas-next-page! (mut atlas)))))
            (text-atlas-add! (mut atlas) utf8 width height font-size)
            (empty-text-texture scale))
        (let [row-bytes (* pixel-width 4)
              byte-count (* row-bytes pixel-height)
              pixels (malloc byte-count)
              colorspace (CGColorSpaceCreateDeviceRGB)
              context (CGBitmapContextCreate pixels pixel-width pixel-height 8 row-bytes colorspace 8194)]
          (if (or (= (primitive/cast i64 pixels) 0)
                  (= (primitive/cast i64 colorspace) 0)
                  (= (primitive/cast i64 context) 0))
              (do
                (set! (.cursor-x atlas) prior-x)
                (set! (.cursor-y atlas) prior-y)
                (set! (.row-height atlas) prior-row-height)
                (if (!= (primitive/cast i64 context) 0) (do (CGContextRelease context) 0) 0)
                (if (!= (primitive/cast i64 colorspace) 0) (do (CGColorSpaceRelease colorspace) 0) 0)
                (if (!= (primitive/cast i64 pixels) 0) (do (free pixels) 0) 0)
                (empty-text-texture scale))
              (do
                (memset pixels 0 byte-count)
                (let [graphics
                        (msg (ptr i8)
                             (class c"NSGraphicsContext")
                             (sel c"graphicsContextWithCGContext:flipped:")
                             [(ptr i8) i8]
                             context
                             (primitive/cast i8 1))
                      font
                        (msg (ptr i8)
                             (class c"NSFont")
                             (sel c"systemFontOfSize:weight:")
                             [f64 f64]
                             (* font-size (primitive/cast f64 scale))
                             0.0)
                      attributes
                        (msg (ptr i8)
                             (class c"NSDictionary")
                             (sel c"dictionaryWithObject:forKey:")
                             [(ptr i8) (ptr i8)]
                             font
                             (nsstr c"NSFont"))
                      string (nsstr utf8)]
                  (do
                    (msg i64 (class c"NSGraphicsContext") (sel c"saveGraphicsState") [])
                    (msg i64 (class c"NSGraphicsContext") (sel c"setCurrentContext:") [(ptr i8)] graphics)
                    (msg i64
                         string
                         (sel c"drawInRect:withAttributes:")
                         [CGRect (ptr i8)]
                         (CGRect
                           :x 0.0
                           :y 0.0
                           :w (primitive/cast f64 pixel-width)
                           :h (primitive/cast f64 pixel-height))
                         attributes)
                    (msg i64 (class c"NSGraphicsContext") (sel c"restoreGraphicsState") [])
                    (msg i64
                         (load (field atlas texture))
                         (sel c"replaceRegion:mipmapLevel:withBytes:bytesPerRow:")
                         [MTLRegion i64 (ptr i8) i64]
                         (MTLRegion
                           :origin
                             (MTLOrigin
                               :x (primitive/cast u64 (load (field region x)))
                               :y (primitive/cast u64 (load (field region y)))
                               :z 0)
                           :size
                             (MTLSize
                               :w (primitive/cast u64 pixel-width)
                               :h (primitive/cast u64 pixel-height)
                               :d 1))
                         0
                         pixels
                         row-bytes)
                    (CGContextRelease context)
                    (CGColorSpaceRelease colorspace)
                    (free pixels)
                    (let [texture (load (field atlas texture))]
                      (do
                        (msg i64 texture (sel c"retain") [])
                        (TextTexture
                          :texture texture
                          :width width
                          :height height
                          :scale scale
                          :uv
                            (ui/rect (/ (primitive/cast f32 (load (field region x)))
                                        (primitive/cast f32 (load (field atlas width))))
                                     (/ (primitive/cast f32 (load (field region y)))
                                        (primitive/cast f32 (load (field atlas height))))
                                     (/ (primitive/cast f32 pixel-width)
                                        (primitive/cast f32 (load (field atlas width))))
                                     (/ (primitive/cast f32 pixel-height)
                                        (primitive/cast f32 (load (field atlas height)))))
                          :owned true)))))))))))

(defn glyph-subpixel [(value f64) (variants i32)] (-> i32)
  (let [whole (primitive/cast i64 value)
        fraction (- value (primitive/cast f64 whole))
        normalized (if (< fraction 0.0) (+ fraction 1.0) fraction)
        variant (primitive/cast i32 (* normalized (primitive/cast f64 variants)))]
    (cond (< variant 0) 0
          (>= variant variants) (- variants 1)
          :else variant)))

(defn find-glyph [(atlas (mut TextAtlas))
                  (font (ptr i8))
                  (glyph u16)
                  (subpixel-x i32)
                  (subpixel-y i32)] (-> (ptr GlyphEntry))
  (let [glyphs (load (field atlas glyphs))]
    (block :found
           (for [i 0 (al/al-len [GlyphEntry] glyphs)]
             (let [entry (primitive/index (load (field glyphs data)) i)]
               (if (and (!= (primitive/cast i64 (load (field entry font))) 0)
                        (and (!= (msg i8
                                      (load (field entry font))
                                      (sel c"isEqual:")
                                      [(ptr i8)]
                                      font)
                                 (primitive/cast i8 0))
                             (and (= (load (field entry glyph)) glyph)
                                  (and (= (load (field entry subpixel-x)) subpixel-x)
                                       (= (load (field entry subpixel-y)) subpixel-y)))))
                   (do
                     (let [page-index (load (field entry page))
                           pages (load (field atlas pages))
                           next-epoch (+ (load (field atlas epoch)) 1)]
                       (do
                         (set! (.epoch atlas) next-epoch)
                         (if (and (>= page-index 0)
                                  (< page-index (al/al-len [AtlasPage] pages)))
                             (store! (field (primitive/index (load (field pages data)) page-index)
                                            last-used)
                                     next-epoch)
                             0)))
                     (return-from :found entry))
                   0)))
           (primitive/cast (ptr GlyphEntry) 0))))

(defn push-glyph-entry! [(atlas (mut TextAtlas))
                         (font (ptr i8))
                         (glyph u16)
                         (subpixel-x i32)
                         (subpixel-y i32)
                         (pixel-width i64)
                         (pixel-height i64)
                         (bearing-x f32)
                         (bearing-top f32)
                         (advance f32)
                         (uv ui/Rect)] (-> (ptr GlyphEntry))
  (let [(mut zero) (primitive/zeroed GlyphEntry)]
    (do
      (al/al-push! [GlyphEntry] (mut (.glyphs atlas)) (load zero))
      (let [glyphs (load (field atlas glyphs))
            entry
              (primitive/index (load (field glyphs data))
                               (- (al/al-len [GlyphEntry] glyphs) 1))]
        (do
          (store! (field entry font) font)
          (store! (field entry texture) (load (field atlas texture)))
          (store! (field entry page) (load (field atlas active-page)))
          (store! (field entry glyph) glyph)
          (store! (field entry subpixel-x) subpixel-x)
          (store! (field entry subpixel-y) subpixel-y)
          (store! (field entry pixel-width) pixel-width)
          (store! (field entry pixel-height) pixel-height)
          (store! (field entry bearing-x) bearing-x)
          (store! (field entry bearing-top) bearing-top)
          (store! (field entry advance) advance)
          (store! (field entry uv) uv)
          (if (!= (primitive/cast i64 font) 0) (msg i64 font (sel c"retain") []) 0)
          entry)))))

(defn cache-run-glyph! [(atlas (mut TextAtlas))
                        (run (ptr i8))
                        (font (ptr i8))
                        (glyph u16)
                        (position CGPoint)
                        (range CFRange)
                        (advance f64)] (-> (ptr GlyphEntry))
  (let [subpixel-x (glyph-subpixel (load (field position x)) 4)
        subpixel-y (glyph-subpixel (load (field position y)) 2)
        cached (find-glyph (mut atlas) font glyph subpixel-x subpixel-y)]
    (if (!= (primitive/cast i64 cached) 0)
        cached
        (let [glyph-address (primitive/alloc-stack u16)
              glyph-bounds (primitive/alloc-stack CGRect)
              (mut bounds) (primitive/zeroed CGRect)
              scale (load (field atlas scale))
              image-width (do
                            (store! glyph-address glyph)
                            (store! glyph-bounds (primitive/zeroed CGRect))
                            (store! bounds
                                    (CTFontGetBoundingRectsForGlyphs
                                      font 0 glyph-address glyph-bounds 1))
                            (load (field bounds w)))
              image-height (load (field bounds h))]
          (if (or (<= image-width 0.0) (<= image-height 0.0))
              (push-glyph-entry! (mut atlas)
                                 font
                                 glyph
                                 subpixel-x
                                 subpixel-y
                                 0
                                 0
                                 0.0
                                 0.0
                                 (primitive/cast f32 (/ advance (primitive/cast f64 scale)))
                                 (ui/rect 0.0 0.0 0.0 0.0))
              (let [pixel-width (+ (primitive/cast i64 image-width) 3)
                    pixel-height (+ (primitive/cast i64 image-height) 3)
                    prior-x (load (field atlas cursor-x))
                    prior-y (load (field atlas cursor-y))
                    prior-row-height (load (field atlas row-height))
                    region (text-atlas-reserve! (mut atlas) pixel-width pixel-height)]
                (if (not (load (field region valid)))
                    (if (and (<= (+ pixel-width (* (load (field atlas padding)) 2))
                                 (load (field atlas width)))
                             (and (<= (+ pixel-height (* (load (field atlas padding)) 2))
                                      (load (field atlas height)))
                                  (text-atlas-next-page! (mut atlas))))
                        (cache-run-glyph! (mut atlas) run font glyph position range advance)
                        (primitive/cast (ptr GlyphEntry) 0))
                    (let [row-bytes (* pixel-width 4)
                          byte-count (* row-bytes pixel-height)
                          pixels (malloc byte-count)
                          colorspace (CGColorSpaceCreateDeviceRGB)
                          context
                            (CGBitmapContextCreate pixels
                                                   pixel-width
                                                   pixel-height
                                                   8
                                                   row-bytes
                                                   colorspace
                                                   8194)]
                      (if (or (= (primitive/cast i64 pixels) 0)
                              (or (= (primitive/cast i64 colorspace) 0)
                                  (= (primitive/cast i64 context) 0)))
                          (do
                            (set! (.cursor-x atlas) prior-x)
                            (set! (.cursor-y atlas) prior-y)
                            (set! (.row-height atlas) prior-row-height)
                            (if (!= (primitive/cast i64 context) 0)
                                (do (CGContextRelease context) 0)
                                0)
                            (if (!= (primitive/cast i64 colorspace) 0)
                                (do (CGColorSpaceRelease colorspace) 0)
                                0)
                            (if (!= (primitive/cast i64 pixels) 0) (do (free pixels) 0) 0)
                            (primitive/cast (ptr GlyphEntry) 0))
                          (do
                            (memset pixels 0 byte-count)
                            (CGContextTranslateCTM context
                                                   (- 1.0 (load (field bounds x)))
                                                   (- 1.0 (load (field bounds y))))
                            (CTRunDraw run context range)
                            (msg i64
                                 (load (field atlas texture))
                                 (sel c"replaceRegion:mipmapLevel:withBytes:bytesPerRow:")
                                 [MTLRegion i64 (ptr i8) i64]
                                 (MTLRegion
                                   :origin
                                     (MTLOrigin
                                       :x (primitive/cast u64 (load (field region x)))
                                       :y (primitive/cast u64 (load (field region y)))
                                       :z 0)
                                   :size
                                     (MTLSize
                                       :w (primitive/cast u64 pixel-width)
                                       :h (primitive/cast u64 pixel-height)
                                       :d 1))
                                 0
                                 pixels
                                 row-bytes)
                            (CGContextRelease context)
                            (CGColorSpaceRelease colorspace)
                            (free pixels)
                            (push-glyph-entry! (mut atlas)
                                               font
                                               glyph
                                               subpixel-x
                                               subpixel-y
                                               pixel-width
                                               pixel-height
                                               (primitive/cast f32
                                                               (/ (- (load (field bounds x)) 1.0)
                                                                  (primitive/cast f64 scale)))
                                               (primitive/cast f32
                                                               (/ (- (- 0.0
                                                                        (+ (load (field bounds y))
                                                                           (load (field bounds h))))
                                                                     1.0)
                                                                  (primitive/cast f64 scale)))
                                               (primitive/cast f32 (/ advance (primitive/cast f64 scale)))
                                               (ui/rect (/ (primitive/cast f32 (load (field region x)))
                                                           (primitive/cast f32 (load (field atlas width))))
                                                        (/ (primitive/cast f32 (load (field region y)))
                                                           (primitive/cast f32 (load (field atlas height))))
                                                        (/ (primitive/cast f32 pixel-width)
                                                           (primitive/cast f32 (load (field atlas width))))
                                                        (/ (primitive/cast f32 pixel-height)
                                                           (primitive/cast f32 (load (field atlas height))))))))))))))))

;;; CoreText cluster indices address UTF-16 code units. Public layout APIs use
;;; UTF-8 byte offsets, matching Coil strings and GPUI's LineLayout contract.
(defn utf8-index-to-utf16 [(utf8 (ptr i8)) (target i64)] (-> i64)
  (let [bytes (primitive/cast (ptr u8) utf8)
        length (strlen utf8)
        limit (cond (< target 0) 0 (> target length) length :else target)
        (mut byte-index) 0
        (mut utf16-index) 0]
    (do
      (while (< (load byte-index) limit)
        (let [lead (load (primitive/index bytes (load byte-index)))
              step
                (cond (= (& lead 240) 240) 4
                      (= (& lead 224) 224) 3
                      (= (& lead 192) 192) 2
                      :else 1)
              next (+ (load byte-index) step)]
          (do
            (store! byte-index (if (> next limit) limit next))
            (store! utf16-index (+ (load utf16-index) (if (= step 4) 2 1))))))
      (load utf16-index))))

(defn utf16-index-to-utf8 [(utf8 (ptr i8)) (target i64)] (-> i64)
  (let [bytes (primitive/cast (ptr u8) utf8)
        length (strlen utf8)
        (mut byte-index) 0
        (mut utf16-index) 0]
    (do
      (while (and (< (load byte-index) length) (< (load utf16-index) target))
        (let [lead (load (primitive/index bytes (load byte-index)))
              step
                (cond (= (& lead 240) 240) 4
                      (= (& lead 224) 224) 3
                      (= (& lead 192) 192) 2
                      :else 1)]
          (do
            (store! byte-index
                    (let [next (+ (load byte-index) step)] (if (> next length) length next)))
            (store! utf16-index (+ (load utf16-index) (if (= step 4) 2 1))))))
      (load byte-index))))

(defn push-shaped-glyph! [(line (mut ShapedLine))
                          (atlas (mut TextAtlas))
                          (entry (ptr GlyphEntry))
                          (position CGPoint)
                          (string-index i64)
                          (glyph u16)] (-> i64)
  (let [(mut zero) (primitive/zeroed ShapedGlyph)]
    (do
      (al/al-push! [ShapedGlyph] (mut (.glyphs line)) (load zero))
      (let [glyphs (load (field line glyphs))
            item
              (primitive/index (load (field glyphs data))
                               (- (al/al-len [ShapedGlyph] glyphs) 1))
            texture (field item texture)
            scale (load (field atlas scale))]
        (do
          (store! (field texture texture) (load (field entry texture)))
          (store! (field texture width)
                  (primitive/cast i64
                                  (/ (primitive/cast f32 (load (field entry pixel-width))) scale)))
          (store! (field texture height)
                  (primitive/cast i64
                                  (/ (primitive/cast f32 (load (field entry pixel-height))) scale)))
          (store! (field texture scale) scale)
          (store! (field texture uv) (load (field entry uv)))
          (store! (field texture owned) true)
          (msg i64 (load (field entry texture)) (sel c"retain") [])
          (store! (field item x)
                  (+ (primitive/cast f32
                                     (/ (load (field position x)) (primitive/cast f64 scale)))
                     (load (field entry bearing-x))))
          (store! (field item y) (+ (load (field line ascent)) (load (field entry bearing-top))))
          (store! (field item pen-x)
                  (primitive/cast f32
                                  (/ (load (field position x)) (primitive/cast f64 scale))))
          (store! (field item advance) (load (field entry advance)))
          (store! (field item string-index) string-index)
          (store! (field item glyph) glyph)
          (al/al-len [ShapedGlyph] glyphs))))))

(defn invalid-shaped-line [] (-> ShapedLine)
  (let [(mut line) (primitive/zeroed ShapedLine)]
    (do
      (store! (field line glyphs) (al/al-new [ShapedGlyph] (alloc/malloc-allocator)))
      (store! (field line valid) false)
      (load line))))

(defn text-shape-line! [(atlas (mut TextAtlas))
                        (utf8 (ptr i8))
                        (font-size f64)] (-> ShapedLine)
  (if (or (not (text-atlas-valid? (load atlas))) (<= font-size 0.0))
      (invalid-shaped-line)
      (let [scale (load (field atlas scale))
            font
              (msg (ptr i8)
                   (class c"NSFont")
                   (sel c"systemFontOfSize:weight:")
                   [f64 f64]
                   (* font-size (primitive/cast f64 scale))
                   0.0)
            attributes
              (msg (ptr i8)
                   (class c"NSDictionary")
                   (sel c"dictionaryWithObject:forKey:")
                   [(ptr i8) (ptr i8)]
                   font
                   (nsstr c"NSFont"))
            attributed
              (msg (ptr i8)
                   (msg (ptr i8) (class c"NSAttributedString") (sel c"alloc") [])
                   (sel c"initWithString:attributes:")
                   [(ptr i8) (ptr i8)]
                   (nsstr utf8)
                   attributes)
            ct-line (CTLineCreateWithAttributedString attributed)]
        (if (= (primitive/cast i64 ct-line) 0)
            (do
              (if (!= (primitive/cast i64 attributed) 0)
                  (msg i64 attributed (sel c"release") [])
                  0)
              (invalid-shaped-line))
            (let [(mut shaped) (invalid-shaped-line)
                  ascent (primitive/alloc-stack f64)
                  descent (primitive/alloc-stack f64)
                  leading (primitive/alloc-stack f64)]
              (do
                (store! ascent 0.0)
                (store! descent 0.0)
                (store! leading 0.0)
                (let [width (CTLineGetTypographicBounds ct-line ascent descent leading)
                      runs (CTLineGetGlyphRuns ct-line)]
                  (do
                    (set! (.width shaped)
                          (primitive/cast f32 (/ width (primitive/cast f64 scale))))
                    (set! (.ascent shaped)
                          (primitive/cast f32 (/ (load ascent) (primitive/cast f64 scale))))
                    (set! (.descent shaped)
                          (primitive/cast f32 (/ (load descent) (primitive/cast f64 scale))))
                    (set! (.length shaped) (strlen utf8))
                    (set! (.valid shaped) true)
                    (for [run-index 0 (CFArrayGetCount runs)]
                      (let [run (CFArrayGetValueAtIndex runs run-index)
                            run-attributes (CTRunGetAttributes run)
                            run-font (CFDictionaryGetValue run-attributes (nsstr c"NSFont"))
                            effective-font (if (= (primitive/cast i64 run-font) 0) font run-font)
                            glyph-count (CTRunGetGlyphCount run)
                            direct-glyphs (CTRunGetGlyphsPtr run)
                            direct-positions (CTRunGetPositionsPtr run)
                            direct-indices (CTRunGetStringIndicesPtr run)
                            direct-advances (CTRunGetAdvancesPtr run)
                            glyphs
                              (if (= (primitive/cast i64 direct-glyphs) 0)
                                  (primitive/cast (ptr u16)
                                                  (malloc (* glyph-count (primitive/sizeof u16))))
                                  direct-glyphs)
                            positions
                              (if (= (primitive/cast i64 direct-positions) 0)
                                  (primitive/cast (ptr CGPoint)
                                                  (malloc (* glyph-count (primitive/sizeof CGPoint))))
                                  direct-positions)
                            indices
                              (if (= (primitive/cast i64 direct-indices) 0)
                                  (primitive/cast (ptr i64)
                                                  (malloc (* glyph-count (primitive/sizeof i64))))
                                  direct-indices)
                            advances
                              (if (= (primitive/cast i64 direct-advances) 0)
                                  (primitive/cast (ptr CGSize)
                                                  (malloc (* glyph-count (primitive/sizeof CGSize))))
                                  direct-advances)
                            full-range (CFRange :location 0 :length glyph-count)]
                        (do
                          (if (= (primitive/cast i64 direct-glyphs) 0)
                              (if (!= (primitive/cast i64 glyphs) 0)
                                  (do
                                    (memset (primitive/cast (ptr i8) glyphs) 0
                                            (* glyph-count (primitive/sizeof u16)))
                                    (CTRunGetGlyphs run full-range glyphs)
                                    0)
                                  0)
                              0)
                          (if (= (primitive/cast i64 direct-positions) 0)
                              (if (!= (primitive/cast i64 positions) 0)
                                  (do
                                    (memset (primitive/cast (ptr i8) positions) 0
                                            (* glyph-count (primitive/sizeof CGPoint)))
                                    (CTRunGetPositions run full-range positions)
                                    0)
                                  0)
                              0)
                          (if (= (primitive/cast i64 direct-indices) 0)
                              (if (!= (primitive/cast i64 indices) 0)
                                  (do
                                    (memset (primitive/cast (ptr i8) indices) 0
                                            (* glyph-count (primitive/sizeof i64)))
                                    (CTRunGetStringIndices run full-range indices)
                                    0)
                                  0)
                              0)
                          (if (= (primitive/cast i64 direct-advances) 0)
                              (if (!= (primitive/cast i64 advances) 0)
                                  (do
                                    (memset (primitive/cast (ptr i8) advances) 0
                                            (* glyph-count (primitive/sizeof CGSize)))
                                    (CTRunGetAdvances run full-range advances)
                                    0)
                                  0)
                              0)
                          (if (and (!= (primitive/cast i64 glyphs) 0)
                                   (and (!= (primitive/cast i64 positions) 0)
                                        (and (!= (primitive/cast i64 indices) 0)
                                             (!= (primitive/cast i64 advances) 0))))
                              (for [glyph-index 0 glyph-count]
                                (let [glyph (load (primitive/index glyphs glyph-index))
                                      position (load (primitive/index positions glyph-index))
                                      string-index (load (primitive/index indices glyph-index))
                                      advance-size (load (primitive/index advances glyph-index))
                                      range (CFRange :location glyph-index :length 1)
                                      entry
                                        (cache-run-glyph! (mut atlas) run effective-font glyph
                                                          position range
                                                          (load (field advance-size w)))]
                                  (if (!= (primitive/cast i64 entry) 0)
                                      (push-shaped-glyph! (mut shaped) (mut atlas) entry position
                                                          (utf16-index-to-utf8 utf8 string-index)
                                                          glyph)
                                      0)))
                              0)
                          (if (= (primitive/cast i64 direct-glyphs) 0)
                              (do (free glyphs) 0) 0)
                          (if (= (primitive/cast i64 direct-positions) 0)
                              (do (free positions) 0) 0)
                          (if (= (primitive/cast i64 direct-indices) 0)
                              (do (free indices) 0) 0)
                          (if (= (primitive/cast i64 direct-advances) 0)
                              (do (free advances) 0) 0)))))
                  (CFRelease ct-line)
                  (msg i64 attributed (sel c"release") [])
                  (load shaped))))))))

;;; Return an independently owned shaped line, truncating whole shaped glyphs
;;; and appending a cached ellipsis when the requested width is exceeded. The
;;; source line remains untouched so width-dependent layout probes cannot poison
;;; retained shaping state.
(defn shaped-line-push-copy! [(line (mut ShapedLine)) (glyph ShapedGlyph)] (-> i64)
  (do
    (let [texture (load (field glyph texture))]
      (if (and (load (field texture owned))
               (!= (primitive/cast i64 (load (field texture texture))) 0))
          (msg i64 (load (field texture texture)) (sel c"retain") [])
          0))
    (al/al-push! [ShapedGlyph] (mut (field line glyphs)) glyph)))

(defn truncate-line-end-impl! [(atlas (mut TextAtlas))
                               (line ShapedLine)
                               (font-size f64)
                               (max-width f32)
                               (force-ellipsis bool)] (-> ShapedLine)
  (let [(mut result) (invalid-shaped-line)
        limit (if (< max-width 0.0) 0.0 max-width)
        source-glyphs (load (field line glyphs))]
    (do
      (set! (.ascent result) (load (field line ascent)))
      (set! (.descent result) (load (field line descent)))
      (set! (.length result) (load (field line length)))
      (set! (.valid result) (load (field line valid)))
      (if (or (not (load (field line valid)))
              (and (not force-ellipsis) (<= (load (field line width)) limit)))
          (do
            (for [i 0 (al/al-len [ShapedGlyph] source-glyphs)]
              (shaped-line-push-copy!
                (mut result)
                (load (primitive/index (load (field source-glyphs data)) i))))
            (set! (.width result) (load (field line width))))
          (let [(mut suffix) (text-shape-line! (mut atlas) c"…" font-size)
                suffix-width (load (field suffix width))
                available (if (> limit suffix-width) (- limit suffix-width) 0.0)
                (mut kept-width) (primitive/cast f32 0.0)]
            (do
              (for [i 0 (al/al-len [ShapedGlyph] source-glyphs)]
                (let [glyph (primitive/index (load (field source-glyphs data)) i)
                      edge (+ (load (field glyph pen-x)) (load (field glyph advance)))]
                  (if (<= edge available)
                      (do
                        (shaped-line-push-copy! (mut result) (load glyph))
                        (store! kept-width edge))
                      0)))
              (if (and (load (field suffix valid)) (<= suffix-width limit))
                  (let [suffix-glyphs (load (field suffix glyphs))]
                    (for [i 0 (al/al-len [ShapedGlyph] suffix-glyphs)]
                      (let [(mut glyph)
                              (load (primitive/index (load (field suffix-glyphs data)) i))]
                        (do
                          (set! (.x glyph) (+ (load kept-width) (load (field glyph x))))
                          (set! (.pen-x glyph)
                                (+ (load kept-width) (load (field glyph pen-x))))
                          (set! (.string-index glyph) (load (field line length)))
                          (shaped-line-push-copy! (mut result) (load glyph))))))
                  0)
              (set! (.width result)
                    (if (and (load (field suffix valid)) (<= suffix-width limit))
                        (+ (load kept-width) suffix-width)
                        0.0))
              (if (> (load (field suffix ascent)) (load (field result ascent)))
                  (set! (.ascent result) (load (field suffix ascent)))
                  0)
              (if (> (load (field suffix descent)) (load (field result descent)))
                  (set! (.descent result) (load (field suffix descent)))
                  0)
              (shaped-line-free! (mut suffix)))))
      (load result))))

(defn text-truncate-line-end! [(atlas (mut TextAtlas))
                               (line ShapedLine)
                               (font-size f64)
                               (max-width f32)] (-> ShapedLine)
  (truncate-line-end-impl! (mut atlas) line font-size max-width false))

;;; Preserve the end of an overflowing shaped line, placing the ellipsis at x=0.
;;; This is useful for paths and identifiers whose distinguishing suffix matters.
(defn text-truncate-line-start! [(atlas (mut TextAtlas))
                                 (line ShapedLine)
                                 (font-size f64)
                                 (max-width f32)] (-> ShapedLine)
  (let [(mut result) (invalid-shaped-line)
        limit (if (< max-width 0.0) 0.0 max-width)
        source-glyphs (load (field line glyphs))]
    (do
      (set! (.ascent result) (load (field line ascent)))
      (set! (.descent result) (load (field line descent)))
      (set! (.length result) (load (field line length)))
      (set! (.valid result) (load (field line valid)))
      (if (or (not (load (field line valid)))
              (<= (load (field line width)) limit))
          (do
            (for [i 0 (al/al-len [ShapedGlyph] source-glyphs)]
              (shaped-line-push-copy!
                (mut result)
                (load (primitive/index (load (field source-glyphs data)) i))))
            (set! (.width result) (load (field line width))))
          (let [(mut ellipsis) (text-shape-line! (mut atlas) c"…" font-size)
                ellipsis-width (load (field ellipsis width))
                available (if (> limit ellipsis-width) (- limit ellipsis-width) 0.0)
                count (al/al-len [ShapedGlyph] source-glyphs)
                (mut first) count
                (mut tail-width) (primitive/cast f32 0.0)]
            (do
              (for [offset 0 count]
                (let [index (- (- count 1) offset)
                      glyph (primitive/index (load (field source-glyphs data)) index)
                      candidate (- (load (field line width)) (load (field glyph pen-x)))]
                  (if (<= candidate available)
                      (do (store! first index) (store! tail-width candidate))
                      0)))
              (if (and (load (field ellipsis valid)) (<= ellipsis-width limit))
                  (let [ellipsis-glyphs (load (field ellipsis glyphs))]
                    (for [i 0 (al/al-len [ShapedGlyph] ellipsis-glyphs)]
                      (let [(mut glyph)
                              (load (primitive/index (load (field ellipsis-glyphs data)) i))]
                        (do
                          (set! (.string-index glyph) 0)
                          (shaped-line-push-copy! (mut result) (load glyph))))))
                  0)
              (if (< (load first) count)
                  (let [origin
                          (load (field (primitive/index (load (field source-glyphs data))
                                                        (load first))
                                       pen-x))]
                    (for [i (load first) count]
                      (let [(mut glyph)
                              (load (primitive/index (load (field source-glyphs data)) i))]
                        (do
                          (set! (.x glyph) (+ ellipsis-width (- (load (field glyph x)) origin)))
                          (set! (.pen-x glyph)
                                (+ ellipsis-width (- (load (field glyph pen-x)) origin)))
                          (shaped-line-push-copy! (mut result) (load glyph))))))
                  0)
              (set! (.width result)
                    (if (and (load (field ellipsis valid)) (<= ellipsis-width limit))
                        (+ ellipsis-width (load tail-width))
                        0.0))
              (shaped-line-free! (mut ellipsis)))))
      (load result))))

;;; Preserve both ends of an overflowing line. Space after the ellipsis is
;;; offered to the suffix after reserving half of the available content width
;;; for the prefix; selections always contain whole CoreText-shaped glyphs.
(defn text-truncate-line-middle! [(atlas (mut TextAtlas))
                                  (line ShapedLine)
                                  (font-size f64)
                                  (max-width f32)] (-> ShapedLine)
  (let [(mut result) (invalid-shaped-line)
        limit (if (< max-width 0.0) 0.0 max-width)
        source-glyphs (load (field line glyphs))]
    (do
      (set! (.ascent result) (load (field line ascent)))
      (set! (.descent result) (load (field line descent)))
      (set! (.length result) (load (field line length)))
      (set! (.valid result) (load (field line valid)))
      (if (or (not (load (field line valid)))
              (<= (load (field line width)) limit))
          (do
            (for [i 0 (al/al-len [ShapedGlyph] source-glyphs)]
              (shaped-line-push-copy!
                (mut result)
                (load (primitive/index (load (field source-glyphs data)) i))))
            (set! (.width result) (load (field line width))))
          (let [(mut ellipsis) (text-shape-line! (mut atlas) c"…" font-size)
                ellipsis-width (load (field ellipsis width))
                available (if (> limit ellipsis-width) (- limit ellipsis-width) 0.0)
                prefix-limit (* available (primitive/cast f32 0.5))
                count (al/al-len [ShapedGlyph] source-glyphs)
                (mut prefix-count) 0
                (mut prefix-width) (primitive/cast f32 0.0)
                (mut suffix-first) count
                (mut suffix-width) (primitive/cast f32 0.0)]
            (do
              (for [i 0 count]
                (let [glyph (primitive/index (load (field source-glyphs data)) i)
                      edge (+ (load (field glyph pen-x)) (load (field glyph advance)))]
                  (if (<= edge prefix-limit)
                      (do (store! prefix-count (+ i 1)) (store! prefix-width edge))
                      0)))
              (for [offset 0 count]
                (let [index (- (- count 1) offset)
                      glyph (primitive/index (load (field source-glyphs data)) index)
                      candidate (- (load (field line width)) (load (field glyph pen-x)))]
                  (if (and (>= index (load prefix-count))
                           (<= candidate (- available (load prefix-width))))
                      (do (store! suffix-first index) (store! suffix-width candidate))
                      0)))
              (for [i 0 (load prefix-count)]
                (shaped-line-push-copy!
                  (mut result)
                  (load (primitive/index (load (field source-glyphs data)) i))))
              (if (and (load (field ellipsis valid)) (<= ellipsis-width limit))
                  (let [ellipsis-glyphs (load (field ellipsis glyphs))]
                    (for [i 0 (al/al-len [ShapedGlyph] ellipsis-glyphs)]
                      (let [(mut glyph)
                              (load (primitive/index (load (field ellipsis-glyphs data)) i))]
                        (do
                          (set! (.x glyph) (+ (load prefix-width) (load (field glyph x))))
                          (set! (.pen-x glyph)
                                (+ (load prefix-width) (load (field glyph pen-x))))
                          (set! (.string-index glyph)
                                (if (< (load prefix-count) count)
                                    (load (field (primitive/index
                                                  (load (field source-glyphs data))
                                                  (load prefix-count))
                                                 string-index))
                                    (load (field line length))))
                          (shaped-line-push-copy! (mut result) (load glyph))))))
                  0)
              (if (< (load suffix-first) count)
                  (let [origin
                          (load (field (primitive/index (load (field source-glyphs data))
                                                        (load suffix-first))
                                       pen-x))
                        destination (+ (load prefix-width) ellipsis-width)]
                    (for [i (load suffix-first) count]
                      (let [(mut glyph)
                              (load (primitive/index (load (field source-glyphs data)) i))]
                        (do
                          (set! (.x glyph) (+ destination (- (load (field glyph x)) origin)))
                          (set! (.pen-x glyph)
                                (+ destination (- (load (field glyph pen-x)) origin)))
                          (shaped-line-push-copy! (mut result) (load glyph))))))
                  0)
              (set! (.width result)
                    (if (and (load (field ellipsis valid)) (<= ellipsis-width limit))
                        (+ (+ (load prefix-width) ellipsis-width) (load suffix-width))
                        0.0))
              (shaped-line-free! (mut ellipsis)))))
      (load result))))

(defn push-paragraph-line! [(paragraph (mut ShapedParagraph))
                            (line ShapedLine)
                            (byte-start i64)
                            (byte-content-end i64)
                            (byte-end i64)] (-> i64)
  (let [(mut zero) (primitive/zeroed ParagraphLine)]
    (do
      (al/al-push! [ParagraphLine] (mut (.lines paragraph)) (load zero))
      (let [lines (load (field paragraph lines))
            index (- (al/al-len [ParagraphLine] lines) 1)
            item (primitive/index (load (field lines data)) index)]
        (do
          (store! (field item line) line)
          (store! (field item byte-start) byte-start)
          (store! (field item byte-content-end) byte-content-end)
          (store! (field item byte-end) byte-end)
          (store! (field item y)
                  (* (primitive/cast f32 index) (load (field paragraph line-height))))
          index)))))

(defn text-shape-paragraph! [(atlas (mut TextAtlas))
                             (utf8 (ptr i8))
                             (font-size f64)
                             (width f32)
                             (line-height f32)
                             (max-lines i64)] (-> ShapedParagraph)
  (let [(mut paragraph) (primitive/zeroed ShapedParagraph)
        effective-line-height
          (if (> line-height 0.0)
              line-height
              (primitive/cast f32 (* font-size 1.2)))]
    (do
      (store! (field paragraph lines)
              (al/al-new [ParagraphLine] (alloc/malloc-allocator)))
      (store! (field paragraph width) width)
      (store! (field paragraph line-height) effective-line-height)
      (store! (field paragraph length) (strlen utf8))
      (if (or (not (text-atlas-valid? (load atlas)))
              (or (<= font-size 0.0) (<= width 0.0)))
          (load paragraph)
          (let [scale (load (field atlas scale))
                font
                  (msg (ptr i8)
                       (class c"NSFont")
                       (sel c"systemFontOfSize:weight:")
                       [f64 f64]
                       (* font-size (primitive/cast f64 scale))
                       0.0)
                attributes
                  (msg (ptr i8)
                       (class c"NSDictionary")
                       (sel c"dictionaryWithObject:forKey:")
                       [(ptr i8) (ptr i8)]
                       font
                       (nsstr c"NSFont"))
                string (nsstr utf8)
                attributed
                  (msg (ptr i8)
                       (msg (ptr i8) (class c"NSAttributedString") (sel c"alloc") [])
                       (sel c"initWithString:attributes:")
                       [(ptr i8) (ptr i8)]
                       string
                       attributes)
                typesetter (CTTypesetterCreateWithAttributedString attributed)
                utf16-length (primitive/cast i64 (msg u64 string (sel c"length") []))
                (mut start) 0]
            (do
              (if (= (primitive/cast i64 typesetter) 0)
                  0
                  (if (= utf16-length 0)
                      (push-paragraph-line! (mut paragraph)
                                            (text-shape-line! (mut atlas) c"" font-size)
                                            0
                                            0
                                            0)
                      (while (and (< (load start) utf16-length)
                                  (or (<= max-lines 0)
                                      (< (al/al-len [ParagraphLine]
                                                    (load (field paragraph lines)))
                                         max-lines)))
                        (let [suggested
                                (CTTypesetterSuggestLineBreak typesetter
                                                              (load start)
                                                              (* (primitive/cast f64 width)
                                                                 (primitive/cast f64 scale)))
                              fallback
                                (if (> suggested 0)
                                    suggested
                                    (CTTypesetterSuggestClusterBreak typesetter
                                                                     (load start)
                                                                     (* (primitive/cast f64 width)
                                                                        (primitive/cast f64 scale))))
                              consumed (if (> fallback 0) fallback 1)
                              remaining (- utf16-length (load start))
                              count (if (> consumed remaining) remaining consumed)
                              end (+ (load start) count)
                              (mut content-end) end]
                          (do
                            (while (> (load content-end) (load start))
                              (let [character
                                      (msg u16
                                           string
                                           (sel c"characterAtIndex:")
                                           [u64]
                                           (primitive/cast u64 (- (load content-end) 1)))]
                                (if (or (= character (primitive/cast u16 10))
                                        (= character (primitive/cast u16 13)))
                                    (store! content-end (- (load content-end) 1))
                                    (break 0))))
                            (let [substring
                                    (msg (ptr i8)
                                         string
                                         (sel c"substringWithRange:")
                                         [CFRange]
                                         (CFRange :location (load start)
                                           :length (- (load content-end) (load start))))
                                  line-utf8 (msg (ptr i8) substring (sel c"UTF8String") [])
                                  byte-start (utf16-index-to-utf8 utf8 (load start))
                                  byte-content-end (utf16-index-to-utf8 utf8 (load content-end))
                                  byte-end (utf16-index-to-utf8 utf8 end)]
                              (push-paragraph-line! (mut paragraph)
                                                    (text-shape-line! (mut atlas)
                                                                      line-utf8
                                                                      font-size)
                                                    byte-start
                                                    byte-content-end
                                                    byte-end))
                            (store! start end))))))
              ;; A positive line clamp represents hidden remaining content with
              ;; an ellipsis on the final visible line. Replacing the owned line
              ;; avoids mutating either CoreText state or a reusable source shape.
              (if (and (> max-lines 0)
                       (< (load start) utf16-length)
                       (> (al/al-len [ParagraphLine] (load (field paragraph lines))) 0))
                  (let [lines (load (field paragraph lines))
                        last
                          (primitive/index
                            (load (field lines data))
                            (- (al/al-len [ParagraphLine] lines) 1))
                        (mut replacement)
                          (truncate-line-end-impl! (mut atlas)
                                                   (load (field last line))
                                                   font-size
                                                   width
                                                   true)]
                    (do
                      (shaped-line-free! (mut (field last line)))
                      (store! (field last line) (load replacement))
                      (store! (field last byte-end) (load (field paragraph length)))))
                  0)
              (store! (field paragraph height)
                      (* effective-line-height
                         (primitive/cast f32
                                         (al/al-len [ParagraphLine]
                                                    (load (field paragraph lines))))))
              (store! (field paragraph valid)
                      (!= (primitive/cast i64 typesetter) 0))
              (if (!= (primitive/cast i64 typesetter) 0) (do (CFRelease typesetter) 0) 0)
              (msg i64 attributed (sel c"release") [])
              (load paragraph)))))))

(defn shaped-line-free! [(line (mut ShapedLine))] (-> i64)
  (do
    (let [glyphs (load (field line glyphs))]
      (for [i 0 (al/al-len [ShapedGlyph] glyphs)]
        (text-texture-free!
          (mut (field (primitive/index (load (field glyphs data)) i) texture)))))
    (al/al-free! [ShapedGlyph] (mut (.glyphs line)))))

(defn shaped-paragraph-free! [(paragraph (mut ShapedParagraph))] (-> i64)
  (do
    (let [lines (load (field paragraph lines))]
      (for [i 0 (al/al-len [ParagraphLine] lines)]
        (let [item (primitive/index (load (field lines data)) i)]
          (shaped-line-free! (mut (field item line))))))
    (al/al-free! [ParagraphLine] (mut (.lines paragraph)))
    (store! (field paragraph valid) false)
    0))

(defn shaped-paragraph-line-count [(paragraph ShapedParagraph)] (-> i64)
  (al/al-len [ParagraphLine] (load (field paragraph lines))))

(defn shaped-paragraph-index-for-point [(paragraph ShapedParagraph)
                                        (x f32)
                                        (y f32)] (-> i64)
  (let [count (shaped-paragraph-line-count paragraph)]
    (if (<= count 0)
        0
        (let [raw (primitive/cast i64 (/ y (load (field paragraph line-height))))
              index (cond (< raw 0) 0 (>= raw count) (- count 1) :else raw)
              lines (load (field paragraph lines))
              item (primitive/index (load (field lines data)) index)
              line (load (field item line))
              local (shaped-line-index-for-x line x)
              result (+ (load (field item byte-start)) local)
              content-end (load (field item byte-content-end))]
          (if (> result content-end) content-end result)))))

(defn shaped-paragraph-position-for-index [(paragraph ShapedParagraph)
                                           (index i64)] (-> TextPosition)
  (let [lines (load (field paragraph lines))
        count (al/al-len [ParagraphLine] lines)]
    (if (<= count 0)
        (TextPosition
          :x 0.0
          :y 0.0
          :height (load (field paragraph line-height)))
        (block :found
               (for [i 0 count]
                 (let [item (primitive/index (load (field lines data)) i)
                       is-last (= i (- count 1))]
                   (if (or (< index (load (field item byte-end))) is-last)
                       (let [local
                               (cond (<= index (load (field item byte-start))) 0
                                     (>= index (load (field item byte-content-end)))
                                       (- (load (field item byte-content-end))
                                          (load (field item byte-start)))
                                     :else (- index (load (field item byte-start))))]
                         (return-from
                           :found
                             (TextPosition
                               :x
                                 (shaped-line-x-for-index (load (field item line))
                                                          local)
                               :y (load (field item y))
                               :height (load (field paragraph line-height)))))
                       0)))
               (TextPosition
                 :x 0.0
                 :y 0.0
                 :height (load (field paragraph line-height)))))))

(defn shaped-line-x-for-index [(line ShapedLine) (index i64)] (-> f32)
  (let [glyphs (load (field line glyphs))]
    (block :found
           (for [i 0 (al/al-len [ShapedGlyph] glyphs)]
             (let [glyph (primitive/index (load (field glyphs data)) i)]
               (if (>= (load (field glyph string-index)) index)
                   (return-from :found (load (field glyph pen-x)))
                   0)))
           (load (field line width)))))

(defn shaped-line-index-for-x [(line ShapedLine) (x f32)] (-> i64)
  (let [glyphs (load (field line glyphs))
        (mut previous-index) 0
        (mut previous-x) (primitive/cast f32 0.0)]
    (block :found
           (for [i 0 (al/al-len [ShapedGlyph] glyphs)]
             (let [glyph (primitive/index (load (field glyphs data)) i)
                   glyph-x (load (field glyph pen-x))]
               (if (>= glyph-x x)
                   (return-from :found
                                  (if (< (- glyph-x x) (- x (load previous-x)))
                                      (load (field glyph string-index))
                                      (load previous-index)))
                   (do
                     (store! previous-index (load (field glyph string-index)))
                     (store! previous-x glyph-x)))))
           (load (field line length)))))

(defn shaped-line-selection-bounds [(line ShapedLine)
                                    (start i64)
                                    (end i64)
                                    (x f32)
                                    (y f32)] (-> ui/Rect)
  (let [start-x (shaped-line-x-for-index line start)
        end-x (shaped-line-x-for-index line end)
        left (if (< start-x end-x) start-x end-x)
        right (if (> start-x end-x) start-x end-x)]
    (ui/rect (+ x left)
             y
             (- right left)
             (+ (load (field line ascent)) (load (field line descent))))))

(defn paint-shaped-line! [(scene (mut ui/Scene))
                          (line ShapedLine)
                          (x f32)
                          (y f32)
                          (color ui/Color)
                          (id i32)] (-> i64)
  (let [glyphs (load (field line glyphs))]
    (do
      (for [i 0 (al/al-len [ShapedGlyph] glyphs)]
        (let [glyph (primitive/index (load (field glyphs data)) i)
              texture (field glyph texture)]
          (if (and (> (load (field texture width)) 0) (> (load (field texture height)) 0))
              (ui/scene-texture-region! (mut scene)
                                        (ui/rect (+ x (load (field glyph x)))
                                                 (+ y (load (field glyph y)))
                                                 (primitive/cast f32 (load (field texture width)))
                                                 (primitive/cast f32 (load (field texture height))))
                                        color
                                        (load (field texture uv))
                                        (load (field texture texture))
                                        (primitive/cast i32 (+ (primitive/cast i64 id) i)))
              0)))
      (al/al-len [ShapedGlyph] glyphs))))

(defn paint-shaped-paragraph! [(scene (mut ui/Scene))
                               (paragraph ShapedParagraph)
                               (x f32)
                               (y f32)
                               (color ui/Color)
                               (id i32)] (-> i64)
  (let [lines (load (field paragraph lines))
        (mut glyph-offset) 0]
    (do
      (for [i 0 (al/al-len [ParagraphLine] lines)]
        (let [item (primitive/index (load (field lines data)) i)
              painted
                (paint-shaped-line! (mut scene)
                                    (load (field item line))
                                    x
                                    (+ y (load (field item y)))
                                    color
                                    (primitive/cast i32
                                                    (+ (primitive/cast i64 id)
                                                       (load glyph-offset))))]
          (store! glyph-offset (+ (load glyph-offset) painted))))
      (load glyph-offset))))

(defn text-atlas-glyph-count [(atlas TextAtlas)] (-> i64)
  (al/al-len [GlyphEntry] (load (field atlas glyphs))))

(defn text-atlas-page-count [(atlas TextAtlas)] (-> i64)
  (al/al-len [AtlasPage] (load (field atlas pages))))

(defn text-atlas-eviction-count [(atlas TextAtlas)] (-> i64)
  (load (field atlas evictions)))

(defn text-atlas-free! [(atlas (mut TextAtlas))] (-> i64)
  (do
    (let [glyphs (load (field atlas glyphs))]
      (for [i 0 (al/al-len [GlyphEntry] glyphs)]
        (let [entry (primitive/index (load (field glyphs data)) i)]
          (if (!= (primitive/cast i64 (load (field entry font))) 0)
              (msg i64 (load (field entry font)) (sel c"release") [])
              0))))
    (al/al-free! [GlyphEntry] (mut (.glyphs atlas)))
    (let [pages (load (field atlas pages))]
      (for [i 0 (al/al-len [AtlasPage] pages)]
        (let [page (primitive/index (load (field pages data)) i)]
          (if (!= (primitive/cast i64 (load (field page texture))) 0)
              (msg i64 (load (field page texture)) (sel c"release") []) 0))))
    (al/al-free! [AtlasPage] (mut (.pages atlas)))
    (set! (.texture atlas) (primitive/cast (ptr i8) 0))
    0))

(defn text-texture-new [(device (ptr i8))
                        (utf8 (ptr i8))
                        (width i64)
                        (height i64)
                        (font-size f64)
                        (scale f32)] (-> TextTexture)
  (let [pixel-width (primitive/cast i64 (* (primitive/cast f32 width) scale))
        pixel-height (primitive/cast i64 (* (primitive/cast f32 height) scale))
        row-bytes (* pixel-width 4)
        byte-count (* row-bytes pixel-height)
        pixels (malloc byte-count)
        colorspace (CGColorSpaceCreateDeviceRGB)
        context (CGBitmapContextCreate pixels pixel-width pixel-height 8 row-bytes colorspace 8194)]
    (if (or (= (primitive/cast i64 pixels) 0) (= (primitive/cast i64 context) 0))
        (do
          (if (!= (primitive/cast i64 context) 0) (do (CGContextRelease context) 0) 0)
          (if (!= (primitive/cast i64 colorspace) 0) (do (CGColorSpaceRelease colorspace) 0) 0)
          (if (!= (primitive/cast i64 pixels) 0) (do (free pixels) 0) 0)
          (TextTexture
            :texture (primitive/cast (ptr i8) 0)
            :width 0
            :height 0
            :scale scale
            :uv (ui/rect 0.0 0.0 1.0 1.0)
            :owned false))
        (do
          (memset pixels 0 byte-count)
          (let [graphics
                  (msg (ptr i8)
                       (class c"NSGraphicsContext")
                       (sel c"graphicsContextWithCGContext:flipped:")
                       [(ptr i8) i8]
                       context
                       (primitive/cast i8 1))
                font
                  (msg (ptr i8)
                       (class c"NSFont")
                       (sel c"systemFontOfSize:weight:")
                       [f64 f64]
                       (* font-size (primitive/cast f64 scale))
                       0.0)
                attributes
                  (msg (ptr i8)
                       (class c"NSDictionary")
                       (sel c"dictionaryWithObject:forKey:")
                       [(ptr i8) (ptr i8)]
                       font
                       (nsstr c"NSFont"))
                string (nsstr utf8)]
            (do
              (msg i64 (class c"NSGraphicsContext") (sel c"saveGraphicsState") [])
              (msg i64 (class c"NSGraphicsContext") (sel c"setCurrentContext:") [(ptr i8)] graphics)
              (msg i64
                   string
                   (sel c"drawInRect:withAttributes:")
                   [CGRect (ptr i8)]
                   (CGRect
                     :x 0.0
                     :y 0.0
                     :w (primitive/cast f64 pixel-width)
                     :h (primitive/cast f64 pixel-height))
                   attributes)
              (msg i64 (class c"NSGraphicsContext") (sel c"restoreGraphicsState") [])
              (let [descriptor
                      (msg (ptr i8)
                           (class c"MTLTextureDescriptor")
                           (sel c"texture2DDescriptorWithPixelFormat:width:height:mipmapped:")
                           [i64 i64 i64 i8]
                           80
                           pixel-width
                           pixel-height
                           (primitive/cast i8 0))
                    texture (msg (ptr i8) device (sel c"newTextureWithDescriptor:") [(ptr i8)] descriptor)]
                (do
                  (if (!= (primitive/cast i64 texture) 0)
                      (msg i64
                           texture
                           (sel c"replaceRegion:mipmapLevel:withBytes:bytesPerRow:")
                           [MTLRegion i64 (ptr i8) i64]
                           (MTLRegion
                             :origin
                               (MTLOrigin
                                 :x 0
                                 :y 0
                                 :z 0)
                             :size
                               (MTLSize
                                 :w (primitive/cast u64 pixel-width)
                                 :h (primitive/cast u64 pixel-height)
                                 :d 1))
                           0
                           pixels
                           row-bytes)
                      0)
                  (CGContextRelease context)
                  (CGColorSpaceRelease colorspace)
                  (free pixels)
                  (TextTexture
                    :texture texture
                    :width width
                    :height height
                    :scale scale
                    :uv (ui/rect 0.0 0.0 1.0 1.0)
                    :owned true)))))))))

(defn text-texture-free! [(text (mut TextTexture))] (-> i64)
  (do
    (if (and (load (field text owned))
             (!= (primitive/cast i64 (load (field text texture))) 0))
        (msg i64 (load (field text texture)) (sel c"release") [])
        0)
    (set! (.texture text) (primitive/cast (ptr i8) 0))
    (set! (.owned text) false)
    0))

(defn paint-text! [(scene (mut ui/Scene))
                   (text TextTexture)
                   (x f32)
                   (y f32)
                   (color ui/Color)
                   (id i32)] (-> i64)
  (if (text-texture-valid? text)
      (ui/scene-texture-region! (mut scene)
                                (ui/rect x
                                         y
                                         (primitive/cast f32 (load (field text width)))
                                         (primitive/cast f32 (load (field text height))))
                                color
                                (load (field text uv))
                                (load (field text texture))
                                id)
      0))
