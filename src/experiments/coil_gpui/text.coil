(extern malloc :cc c [i64] (-> (ptr i8)))

(extern free :cc c [(ptr i8)] (-> void))

(extern memset :cc c [(ptr i8) i32 i64] (-> (ptr i8)))

(extern strlen :cc c [(ptr i8)] (-> i64))

(extern CGColorSpaceCreateDeviceRGB :cc c [] (-> (ptr i8)))

(extern CGColorSpaceRelease :cc c [(ptr i8)] (-> void))

(extern CGBitmapContextCreate
        :cc
        c
        [(ptr i8) i64 i64 i64 i64 (ptr i8) u32]
        (-> (ptr i8)))

(extern CGContextRelease :cc c [(ptr i8)] (-> void))

(extern CGContextTranslateCTM :cc c [(ptr i8) f64 f64] (-> void))

(extern CFRelease :cc c [(ptr i8)] (-> void))

(extern CFArrayGetCount :cc c [(ptr i8)] (-> i64))

(extern CFArrayGetValueAtIndex :cc c [(ptr i8) i64] (-> (ptr i8)))

(extern CFDictionaryGetValue :cc c [(ptr i8) (ptr i8)] (-> (ptr i8)))

(extern CTLineCreateWithAttributedString :cc c [(ptr i8)] (-> (ptr i8)))

(extern CTTypesetterCreateWithAttributedString :cc c [(ptr i8)] (-> (ptr i8)))

(extern CTTypesetterSuggestLineBreak :cc c [(ptr i8) i64 f64] (-> i64))

(extern CTTypesetterSuggestClusterBreak :cc c [(ptr i8) i64 f64] (-> i64))

(extern CTLineGetGlyphRuns :cc c [(ptr i8)] (-> (ptr i8)))

(extern CTLineGetTypographicBounds
        :cc
        c
        [(ptr i8) (ptr f64) (ptr f64) (ptr f64)]
        (-> f64))

(extern CTRunGetGlyphCount :cc c [(ptr i8)] (-> i64))

(extern CTRunGetGlyphs :cc c [(ptr i8) CFRange (ptr u16)] (-> void))
(extern CTRunGetGlyphsPtr :cc c [(ptr i8)] (-> (ptr u16)))

(extern CTRunGetPositions :cc c [(ptr i8) CFRange (ptr CGPoint)] (-> void))
(extern CTRunGetPositionsPtr :cc c [(ptr i8)] (-> (ptr CGPoint)))

(extern CTRunGetStringIndices :cc c [(ptr i8) CFRange (ptr i64)] (-> void))
(extern CTRunGetStringIndicesPtr :cc c [(ptr i8)] (-> (ptr i64)))

