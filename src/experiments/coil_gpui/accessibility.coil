(module experiments.coil_gpui.accessibility)
(import "experiments.coil_gpui.objc" :use *)
(import "experiments.coil_gpui.ui" :as ui)
(import "coil.arraylist" :as al)
(import "coil.alloc" :as alloc)
(import "coil.primitive" :as primitive)

(export AccessTree
        AccessNode
        RoleButton
        RoleCheckbox
        RoleSlider
        RoleProgress
        RoleTextField
        ActionNone
        ActionPress
        ActionIncrement
        ActionDecrement
        access-tree-new
        access-tree-add!
        access-tree-attach!
        access-tree-node
        access-node-set-value!
        access-node-set-text!
        access-node-set-focused!
        access-tree-take-action!
        access-tree-free!)

(extern objc_lookUpClass :cc c [(ptr i8)] (-> (ptr i8)))

(extern objc_allocateClassPair :cc c [(ptr i8) (ptr i8) i64] (-> (ptr i8)))

(extern objc_registerClassPair :cc c [(ptr i8)] (-> void))

(extern class_addIvar :cc c [(ptr i8) (ptr i8) i64 u8 (ptr i8)] (-> i8))

(extern class_addMethod :cc c [(ptr i8) (ptr i8) (ptr i8) (ptr i8)] (-> i8))

(extern object_getClass :cc c [(ptr i8)] (-> (ptr i8)))

(extern class_getInstanceVariable :cc c [(ptr i8) (ptr i8)] (-> (ptr i8)))

(extern ivar_getOffset :cc c [(ptr i8)] (-> i64))

(extern NSAccessibilityPostNotification :cc c [(ptr i8) (ptr i8)] (-> void))

(defstruct NSRect [(x f64) (y f64) (w f64) (h f64)])

(defn RoleButton [] (-> i32)
  1)

(defn RoleCheckbox [] (-> i32)
  2)

(defn RoleSlider [] (-> i32)
  3)

(defn RoleProgress [] (-> i32)
  4)

(defn RoleTextField [] (-> i32)
  5)

(defn ActionNone [] (-> i32)
  0)

(defn ActionPress [] (-> i32)
  1)

(defn ActionIncrement [] (-> i32)
  2)

(defn ActionDecrement [] (-> i32)
  3)

(defstruct AccessTree
  [(view (ptr i8))
   (children (ptr i8))
   (nodes (al/ArrayList AccessNode))
   (action i32)
   (action-target i32)])

(defstruct AccessNode
  [(tree (ptr AccessTree))
   (element (ptr i8))
   (id i32)
   (role i32)
   (bounds ui/Rect)
   (label (ptr i8))
   (identifier (ptr i8))
   (value-text (ptr i8))
   (revision i64)
   (value f64)
   (minimum f64)
   (maximum f64)
   (enabled bool)
   (focused bool)])

(defn nsstr [(bytes (ptr i8))] (-> (ptr i8))
  (if (= (primitive/cast i64 bytes) 0)
      (primitive/cast (ptr i8) 0)
      (msg (ptr i8)
           (class c"NSString")
           (sel c"stringWithUTF8String:")
           [(ptr i8)]
           bytes)))

(defn node-state [(self (ptr i8))] (-> (ptr AccessNode))
  (let [ivar (class_getInstanceVariable (object_getClass self) c"_coilAccessNode")
        slot
          (primitive/cast (ptr (ptr AccessNode))
                          (+ (primitive/cast i64 self) (ivar_getOffset ivar)))]
    (load slot)))

(defn node-role [(self (ptr i8)) (command (ptr i8))] (-> (ptr i8))
  (let [role (load (field (node-state self) role))]
    (nsstr (cond (= role (primitive/cast i32 (RoleButton))) c"AXButton"
                 (= role (primitive/cast i32 (RoleCheckbox))) c"AXCheckBox"
                 (= role (primitive/cast i32 (RoleSlider))) c"AXSlider"
                 (= role (primitive/cast i32 (RoleProgress))) c"AXProgressIndicator"
                 (= role (primitive/cast i32 (RoleTextField))) c"AXTextField"
                 :else c"AXGroup"))))

(defn node-label [(self (ptr i8)) (command (ptr i8))] (-> (ptr i8))
  (nsstr (load (field (node-state self) label))))

(defn node-identifier [(self (ptr i8)) (command (ptr i8))] (-> (ptr i8))
  (nsstr (load (field (node-state self) identifier))))

(defn node-value [(self (ptr i8)) (command (ptr i8))] (-> (ptr i8))
  (let [node (node-state self)
        role (load (field node role))
        value-text (load (field node value-text))]
    (if (!= (primitive/cast i64 value-text) 0)
        (nsstr value-text)
        (if (= role (primitive/cast i32 (RoleCheckbox)))
            (msg (ptr i8)
                 (class c"NSNumber")
                 (sel c"numberWithBool:")
                 [i8]
                 (if (> (load (field node value)) 0.5)
                     (primitive/cast i8 1)
                     (primitive/cast i8 0)))
            (msg (ptr i8)
                 (class c"NSNumber")
                 (sel c"numberWithDouble:")
                 [f64]
                 (load (field node value)))))))

(defn node-min-value [(self (ptr i8)) (command (ptr i8))] (-> (ptr i8))
  (msg (ptr i8)
       (class c"NSNumber")
       (sel c"numberWithDouble:")
       [f64]
       (load (field (node-state self) minimum))))

(defn node-max-value [(self (ptr i8)) (command (ptr i8))] (-> (ptr i8))
  (msg (ptr i8)
       (class c"NSNumber")
       (sel c"numberWithDouble:")
       [f64]
       (load (field (node-state self) maximum))))

(defn node-enabled [(self (ptr i8)) (command (ptr i8))] (-> i8)
  (if (load (field (node-state self) enabled))
      (primitive/cast i8 1)
      (primitive/cast i8 0)))

(defn node-focused [(self (ptr i8)) (command (ptr i8))] (-> i8)
  (if (load (field (node-state self) focused))
      (primitive/cast i8 1)
      (primitive/cast i8 0)))

(defn node-parent [(self (ptr i8)) (command (ptr i8))] (-> (ptr i8))
  (load (field (load (field (node-state self) tree)) view)))

(defn node-frame [(self (ptr i8)) (command (ptr i8))] (-> NSRect)
  (let [node (node-state self)
        tree (load (field node tree))
        view (load (field tree view))
        bounds (msg NSRect view (sel c"bounds") [])
        rect (load (field node bounds))
        local
          (NSRect
            :x (primitive/cast f64 (load (field rect x)))
            :y
              (- (load (field bounds h))
                 (primitive/cast f64 (+ (load (field rect y)) (load (field rect h)))))
            :w (primitive/cast f64 (load (field rect w)))
            :h (primitive/cast f64 (load (field rect h))))
        window (msg (ptr i8) view (sel c"window") [])]
    (if (= (primitive/cast i64 window) 0)
        local
        (msg NSRect window (sel c"convertRectToScreen:") [NSRect] local))))

(defn queue-action! [(node (ptr AccessNode)) (action i32)] (-> i64)
  (let [tree (load (field node tree))]
    (do
      (store! (field tree action) action)
      (store! (field tree action-target) (load (field node id)))
      0)))

(defn node-perform-press [(self (ptr i8)) (command (ptr i8))] (-> i8)
  (let [node (node-state self)]
    (if (load (field node enabled))
        (do (queue-action! node (primitive/cast i32 (ActionPress))) (primitive/cast i8 1))
        (primitive/cast i8 0))))

(defn node-perform-increment [(self (ptr i8)) (command (ptr i8))] (-> void)
  (do (queue-action! (node-state self) (primitive/cast i32 (ActionIncrement))) 0))

(defn node-perform-decrement [(self (ptr i8)) (command (ptr i8))] (-> void)
  (do (queue-action! (node-state self) (primitive/cast i32 (ActionDecrement))) 0))

(defn add-method! [(class-object (ptr i8))
                   (name (ptr i8))
                   (implementation (ptr i8))
                   (encoding (ptr i8))] (-> i64)
  (do
    (class_addMethod class-object (sel name) implementation encoding)
    0))

(defn access-element-class [] (-> (ptr i8))
  (let [existing (objc_lookUpClass c"CoilGPUAccessibilityElement")]
    (if (!= (primitive/cast i64 existing) 0)
        existing
        (let [element-class
                (objc_allocateClassPair (class c"NSAccessibilityElement")
                                        c"CoilGPUAccessibilityElement"
                                        0)]
          (do
            (class_addIvar element-class c"_coilAccessNode" 8 3 c"^v")
            (add-method! element-class
                         c"accessibilityRole"
                         (primitive/cast (ptr i8) (primitive/fnptr-of node-role))
                         c"@@:")
            (add-method! element-class
                         c"accessibilityLabel"
                         (primitive/cast (ptr i8) (primitive/fnptr-of node-label))
                         c"@@:")
            (add-method! element-class
                         c"accessibilityIdentifier"
                         (primitive/cast (ptr i8) (primitive/fnptr-of node-identifier))
                         c"@@:")
            (add-method! element-class
                         c"accessibilityValue"
                         (primitive/cast (ptr i8) (primitive/fnptr-of node-value))
                         c"@@:")
            (add-method! element-class
                         c"accessibilityMinValue"
                         (primitive/cast (ptr i8) (primitive/fnptr-of node-min-value))
                         c"@@:")
            (add-method! element-class
                         c"accessibilityMaxValue"
                         (primitive/cast (ptr i8) (primitive/fnptr-of node-max-value))
                         c"@@:")
            (add-method! element-class
                         c"isAccessibilityEnabled"
                         (primitive/cast (ptr i8) (primitive/fnptr-of node-enabled))
                         c"c@:")
            (add-method! element-class
                         c"isAccessibilityFocused"
                         (primitive/cast (ptr i8) (primitive/fnptr-of node-focused))
                         c"c@:")
            (add-method! element-class
                         c"accessibilityParent"
                         (primitive/cast (ptr i8) (primitive/fnptr-of node-parent))
                         c"@@:")
            (add-method! element-class
                         c"accessibilityFrame"
                         (primitive/cast (ptr i8) (primitive/fnptr-of node-frame))
                         c"{CGRect={CGPoint=dd}{CGSize=dd}}@:")
            (add-method! element-class
                         c"accessibilityPerformPress"
                         (primitive/cast (ptr i8) (primitive/fnptr-of node-perform-press))
                         c"c@:")
            (add-method! element-class
                         c"accessibilityPerformIncrement"
                         (primitive/cast (ptr i8) (primitive/fnptr-of node-perform-increment))
                         c"v@:")
            (add-method! element-class
                         c"accessibilityPerformDecrement"
                         (primitive/cast (ptr i8) (primitive/fnptr-of node-perform-decrement))
                         c"v@:")
            (objc_registerClassPair element-class)
            element-class)))))

(defn view-tree [(self (ptr i8))] (-> (ptr AccessTree))
  (let [ivar (class_getInstanceVariable (object_getClass self) c"_coilAccessibilityTree")
        slot
          (primitive/cast (ptr (ptr AccessTree))
                          (+ (primitive/cast i64 self) (ivar_getOffset ivar)))]
    (load slot)))

(defn view-accessibility-children [(self (ptr i8)) (command (ptr i8))] (-> (ptr i8))
  (let [tree (view-tree self)]
    (if (= (primitive/cast i64 tree) 0)
        (msg (ptr i8) (class c"NSArray") (sel c"array") [])
        (load (field tree children)))))

(defn view-is-accessibility-element [(self (ptr i8)) (command (ptr i8))] (-> i8)
  (primitive/cast i8 0))

(defn install-view-methods! [(view (ptr i8))] (-> i64)
  (let [view-class (object_getClass view)]
    (do
      (add-method! view-class
                   c"accessibilityChildren"
                   (primitive/cast (ptr i8) (primitive/fnptr-of view-accessibility-children))
                   c"@@:")
      (add-method! view-class
                   c"isAccessibilityElement"
                   (primitive/cast (ptr i8) (primitive/fnptr-of view-is-accessibility-element))
                   c"c@:")
      0)))

(defn access-tree-new [(capacity i64)] (-> AccessTree)
  (let [(mut tree) (primitive/zeroed AccessTree)
        (mut nodes) (al/al-new [AccessNode] (alloc/malloc-allocator))]
    (do
      (al/al-reserve! [AccessNode] (mut nodes) capacity)
      (store! (field tree nodes) (load nodes))
      (store! (field tree action) (primitive/cast i32 (ActionNone)))
      (load tree))))

(defn tree-pointer [(tree (ptr AccessTree))] (-> (ptr AccessTree))
  tree)

(defn access-tree-add! [(tree (mut AccessTree))
                        (id i32)
                        (role i32)
                        (bounds ui/Rect)
                        (label (ptr i8))
                        (identifier (ptr i8))] (-> i64)
  (let [(mut zero) (primitive/zeroed AccessNode)]
    (do
      (al/al-push! [AccessNode] (mut (field tree nodes)) (load zero))
      (let [index (- (al/al-len [AccessNode] (load (field tree nodes))) 1)
            node (primitive/index (load (field (field tree nodes) data)) index)]
        (do
          (store! (field node tree) (tree-pointer (mut tree)))
          (store! (field node id) id)
          (store! (field node role) role)
          (store! (field node bounds) bounds)
          (store! (field node label) label)
          (store! (field node identifier) identifier)
          (store! (field node enabled) true)
          (store! (field node revision) -1)
          (store! (field node minimum) 0.0)
          (store! (field node maximum) 1.0)
          index)))))

(defn access-tree-node [(tree (mut AccessTree)) (index i64)] (-> (ptr AccessNode))
  (primitive/index (load (field (field tree nodes) data)) index))

(defn notify! [(node (ptr AccessNode)) (name (ptr i8))] (-> i64)
  (let [element (load (field node element))]
    (do
      (if (!= (primitive/cast i64 element) 0)
          (do (NSAccessibilityPostNotification element (nsstr name)) 0)
          0)
      0)))

(defn access-node-set-value! [(node (ptr AccessNode)) (value f64)] (-> i64)
  (if (or (< (load (field node value)) value) (> (load (field node value)) value))
      (do
        (store! (field node value) value)
        (notify! node c"AXValueChanged"))
      0))

(defn access-node-set-text! [(node (ptr AccessNode))
                             (value (ptr i8))
                             (revision i64)] (-> i64)
  (do
    (store! (field node value-text) value)
    (if (= (load (field node revision)) revision)
        0
        (do
          (store! (field node revision) revision)
          (notify! node c"AXValueChanged")))))

(defn access-node-set-focused! [(node (ptr AccessNode)) (focused bool)] (-> i64)
  (if (= (load (field node focused)) focused)
      0
      (do
        (store! (field node focused) focused)
        (if focused (notify! node c"AXFocusedUIElementChanged") 0))))

(defn access-tree-attach! [(tree (mut AccessTree)) (view (ptr i8))] (-> i64)
  (let [children (msg (ptr i8) (class c"NSMutableArray") (sel c"new") [])]
    (do
      (store! (field tree view) view)
      (store! (field tree children) children)
      (install-view-methods! view)
      (let [ivar (class_getInstanceVariable (object_getClass view) c"_coilAccessibilityTree")
            slot
              (primitive/cast (ptr (ptr AccessTree))
                              (+ (primitive/cast i64 view) (ivar_getOffset ivar)))]
        (store! slot (tree-pointer (mut tree))))
      (for [i 0 (al/al-len [AccessNode] (load (field tree nodes)))]
        (let [node (primitive/index (load (field (field tree nodes) data)) i)
              element
                (msg (ptr i8)
                     (msg (ptr i8) (access-element-class) (sel c"alloc") [])
                     (sel c"init")
                     [])
              ivar (class_getInstanceVariable (object_getClass element) c"_coilAccessNode")
              slot
                (primitive/cast (ptr (ptr AccessNode))
                                (+ (primitive/cast i64 element) (ivar_getOffset ivar)))]
          (do
            (store! slot node)
            (store! (field node element) element)
            (msg i64 children (sel c"addObject:") [(ptr i8)] element)
            (msg i64 element (sel c"release") []))))
      0)))

(defn access-tree-take-action! [(tree (mut AccessTree))] (-> i64)
  (let [packed
          (| (primitive/cast i64 (load (field tree action)))
             (<< (primitive/cast i64 (load (field tree action-target))) 32))]
    (do
      (store! (field tree action) (primitive/cast i32 (ActionNone)))
      (store! (field tree action-target) 0)
      packed)))

(defn access-tree-free! [(tree (mut AccessTree))] (-> i64)
  (do
    (if (!= (primitive/cast i64 (load (field tree view))) 0)
        (let [view (load (field tree view))
              ivar (class_getInstanceVariable (object_getClass view) c"_coilAccessibilityTree")
              slot
                (primitive/cast (ptr (ptr AccessTree))
                                (+ (primitive/cast i64 view) (ivar_getOffset ivar)))]
          (store! slot (primitive/cast (ptr AccessTree) 0)))
        0)
    (if (!= (primitive/cast i64 (load (field tree children))) 0)
        (msg i64 (load (field tree children)) (sel c"release") [])
        0)
    (al/al-free! [AccessNode] (mut (field tree nodes)))
    0))
