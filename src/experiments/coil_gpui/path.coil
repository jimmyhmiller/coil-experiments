(module experiments.coil_gpui.path)
(import "coil.arraylist" :as al)
(import "coil.alloc" :as alloc)
(import "coil.primitive" :as primitive)

(export PathPoint
        PathBounds
        Path
        Tessellation
        ButtCap
        SquareCap
        RoundCap
        MiterJoin
        BevelJoin
        RoundJoin
        DashState
        DashedPath
        path-new
        path-clear!
        path-free!
        path-move-to!
        path-line-to!
        path-quadratic-to!
        path-cubic-to!
        path-arc!
        path-svg-arc-to!
        path-close!
        path-point-count
        path-length
        path-bounds
        tessellation-bounds
        path-point-at-distance
        dash-pattern-valid?
        dash-pattern-length
        dash-phase-normalize
        dash-state-at-phase
        path-dash-runs
        path-dashed-stroke-tessellate
        dashed-path-free!
        path-signed-area
        path-simple?
        path-tessellate
        path-stroke-tessellate
        path-stroke-tessellate-cap
        path-stroke-tessellate-style
        tessellation-free!)

(extern sqrtf :cc c [f32] (-> f32))

(extern sinf :cc c [f32] (-> f32))

(extern cosf :cc c [f32] (-> f32))

(extern atan2f :cc c [f32 f32] (-> f32))

(extern acosf :cc c [f32] (-> f32))

(extern ceilf :cc c [f32] (-> f32))

(extern fabsf :cc c [f32] (-> f32))

(defn ButtCap [] (-> i32)
  (primitive/cast i32 0))

(defn SquareCap [] (-> i32)
  (primitive/cast i32 1))

(defn RoundCap [] (-> i32)
  (primitive/cast i32 2))

(defn MiterJoin [] (-> i32)
  (primitive/cast i32 0))

(defn BevelJoin [] (-> i32)
  (primitive/cast i32 1))

(defn RoundJoin [] (-> i32)
  (primitive/cast i32 2))

(defstruct PathPoint [(x f32) (y f32)])

(defstruct PathBounds [(x f32) (y f32) (w f32) (h f32) (valid bool)])

(defstruct Path [(points (al/ArrayList PathPoint)) (closed bool)])

;;; Vertices are emitted as a triangle list. Invalid input returns an empty,
;;; owned list with `valid = false`, so callers never render partial geometry.
(defstruct Tessellation [(vertices (al/ArrayList PathPoint)) (valid bool)])

(defstruct StrokePair [(left PathPoint) (right PathPoint) (valid bool)])

(defstruct DashState [(index i64) (remaining f32) (visible bool) (valid bool)])

(defstruct DashedPath [(runs (al/ArrayList Path)) (valid bool)])

(defn path-new [] (-> Path)
  (Path :points (al/al-new [PathPoint] (alloc/malloc-allocator)) :closed false))

(defn path-clear! [(path (mut Path))] (-> i64)
  (do
    (al/al-clear! [PathPoint] (mut (.points path)))
    (set! (.closed path) false)
    0))

(defn path-free! [(path (mut Path))] (-> i64)
  (al/al-free! [PathPoint] (mut (.points path))))

(defn path-move-to! [(path (mut Path)) (x f32) (y f32)] (-> i64)
  (do
    (path-clear! (mut path))
    (al/al-push! [PathPoint] (mut (.points path)) (PathPoint :x x :y y))))

(defn path-line-to! [(path (mut Path)) (x f32) (y f32)] (-> i64)
  (if (load (field path closed))
      0
      (al/al-push! [PathPoint] (mut (.points path)) (PathPoint :x x :y y))))

(defn midpoint [(a PathPoint) (b PathPoint)] (-> PathPoint)
  (PathPoint :x (* (+ (load (field a x)) (load (field b x))) 0.5)
    :y (* (+ (load (field a y)) (load (field b y))) 0.5)))

(defn point-line-flat? [(p PathPoint) (a PathPoint) (b PathPoint) (tolerance f32)] (-> bool)
  (let [dx (- (load (field b x)) (load (field a x)))
        dy (- (load (field b y)) (load (field a y)))
        length-squared (+ (* dx dx) (* dy dy))
        area
          (- (* dx (- (load (field p y)) (load (field a y))))
             (* dy (- (load (field p x)) (load (field a x)))))
        px (- (load (field p x)) (load (field a x)))
        py (- (load (field p y)) (load (field a y)))
        projection (+ (* px dx) (* py dy))
        tolerance-squared (* tolerance tolerance)]
    (if (> length-squared 0.000001)
        (and (>= projection 0.0)
             (and (<= projection length-squared)
                  (<= (* area area) (* tolerance-squared length-squared))))
        (<= (+ (* px px) (* py py)) tolerance-squared))))

(defn flatten-quadratic! [(path (mut Path))
                          (a PathPoint)
                          (control PathPoint)
                          (b PathPoint)
                          (tolerance f32)
                          (depth i32)] (-> i64)
  (if (or (>= depth 16) (point-line-flat? control a b tolerance))
      (al/al-push! [PathPoint] (mut (.points path)) b)
      (let [ac (midpoint a control)
            cb (midpoint control b)
            center (midpoint ac cb)]
        (do
          (flatten-quadratic! (mut path) a ac center tolerance (+ depth 1))
          (flatten-quadratic! (mut path) center cb b tolerance (+ depth 1))))))

(defn path-quadratic-to! [(path (mut Path))
                          (control-x f32)
                          (control-y f32)
                          (x f32)
                          (y f32)
                          (tolerance f32)] (-> i64)
  (let [points (load (field path points))
        count (al/al-len [PathPoint] points)]
    (if (or (load (field path closed)) (= count 0))
        0
        (flatten-quadratic! (mut path)
                            (al/al-get [PathPoint] points (- count 1))
                            (PathPoint :x control-x :y control-y)
                            (PathPoint :x x :y y)
                            (if (> tolerance 0.0) tolerance 0.25)
                            0))))

(defn flatten-cubic! [(path (mut Path))
                      (a PathPoint)
                      (control-a PathPoint)
                      (control-b PathPoint)
                      (b PathPoint)
                      (tolerance f32)
                      (depth i32)] (-> i64)
  (if (or (>= depth 16)
          (and (point-line-flat? control-a a b tolerance)
               (point-line-flat? control-b a b tolerance)))
      (al/al-push! [PathPoint] (mut (.points path)) b)
      (let [ab (midpoint a control-a)
            bc (midpoint control-a control-b)
            cd (midpoint control-b b)
            abc (midpoint ab bc)
            bcd (midpoint bc cd)
            center (midpoint abc bcd)]
        (do
          (flatten-cubic! (mut path) a ab abc center tolerance (+ depth 1))
          (flatten-cubic! (mut path) center bcd cd b tolerance (+ depth 1))))))

(defn path-cubic-to! [(path (mut Path))
                      (control-a-x f32)
                      (control-a-y f32)
                      (control-b-x f32)
                      (control-b-y f32)
                      (x f32)
                      (y f32)
                      (tolerance f32)] (-> i64)
  (let [points (load (field path points))
        count (al/al-len [PathPoint] points)]
    (if (or (load (field path closed)) (= count 0))
        0
        (flatten-cubic! (mut path)
                        (al/al-get [PathPoint] points (- count 1))
                        (PathPoint :x control-a-x :y control-a-y)
                        (PathPoint :x control-b-x :y control-b-y)
                        (PathPoint :x x :y y)
                        (if (> tolerance 0.0) tolerance 0.25)
                        0))))

(defn ellipse-point [(center-x f32)
                     (center-y f32)
                     (radius-x f32)
                     (radius-y f32)
                     (angle f32)] (-> PathPoint)
  (PathPoint :x (+ center-x (* (cosf angle) radius-x))
    :y (+ center-y (* (sinf angle) radius-y))))

(defn flatten-arc! [(path (mut Path))
                    (center-x f32)
                    (center-y f32)
                    (radius-x f32)
                    (radius-y f32)
                    (start-angle f32)
                    (end-angle f32)
                    (start-point PathPoint)
                    (end-point PathPoint)
                    (tolerance f32)
                    (depth i32)] (-> i64)
  (let [middle-angle (* (+ start-angle end-angle) 0.5)
        middle-point (ellipse-point center-x center-y radius-x radius-y middle-angle)]
    (if (or (>= depth 18) (point-line-flat? middle-point start-point end-point tolerance))
        (al/al-push! [PathPoint] (mut (.points path)) end-point)
        (do
          (flatten-arc! (mut path)
                        center-x
                        center-y
                        radius-x
                        radius-y
                        start-angle
                        middle-angle
                        start-point
                        middle-point
                        tolerance
                        (+ depth 1))
          (flatten-arc! (mut path)
                        center-x
                        center-y
                        radius-x
                        radius-y
                        middle-angle
                        end-angle
                        middle-point
                        end-point
                        tolerance
                        (+ depth 1))))))

;;; Append a center-parameterized elliptical arc. Angles are degrees and sweep
;;; may be positive or negative. A disconnected arc inserts a straight segment
;;; to its start point, matching the rest of the single-contour path builder.
(defn path-arc! [(path (mut Path))
                 (center-x f32)
                 (center-y f32)
                 (radius-x f32)
                 (radius-y f32)
                 (start-degrees f32)
                 (sweep-degrees f32)
                 (tolerance f32)] (-> i64)
  (if (or (load (field path closed))
          (or (<= radius-x 0.0)
              (or (<= radius-y 0.0)
                  (and (>= sweep-degrees -0.000001) (<= sweep-degrees 0.000001)))))
      0
      (let [radians-per-degree (primitive/cast f32 0.017453292519943295)
            start-angle (* start-degrees radians-per-degree)
            end-angle (* (+ start-degrees sweep-degrees) radians-per-degree)
            start-point (ellipse-point center-x center-y radius-x radius-y start-angle)
            end-point (ellipse-point center-x center-y radius-x radius-y end-angle)
            points (load (field path points))
            count (al/al-len [PathPoint] points)
            curve-tolerance (if (> tolerance 0.0) tolerance 0.25)]
        (do
          (if (= count 0)
              (al/al-push! [PathPoint] (mut (.points path)) start-point)
              (let [current (al/al-get [PathPoint] points (- count 1))
                    dx (- (load (field current x)) (load (field start-point x)))
                    dy (- (load (field current y)) (load (field start-point y)))]
                (if (> (+ (* dx dx) (* dy dy)) 0.000001)
                    (al/al-push! [PathPoint] (mut (.points path)) start-point)
                    0)))
          (flatten-arc! (mut path)
                        center-x
                        center-y
                        radius-x
                        radius-y
                        start-angle
                        end-angle
                        start-point
                        end-point
                        curve-tolerance
                        0)))))

(defn rotated-ellipse-point [(center-x f32)
                             (center-y f32)
                             (radius-x f32)
                             (radius-y f32)
                             (cos-rotation f32)
                             (sin-rotation f32)
                             (angle f32)] (-> PathPoint)
  (let [ellipse-x (* radius-x (cosf angle))
        ellipse-y (* radius-y (sinf angle))]
    (PathPoint :x (+ center-x (- (* cos-rotation ellipse-x) (* sin-rotation ellipse-y)))
      :y (+ center-y (+ (* sin-rotation ellipse-x) (* cos-rotation ellipse-y))))))

;;; Append an SVG endpoint-parameterized elliptical arc (`A`/`a`). Radii are
;;; corrected per the SVG implementation notes, x-axis rotation is in degrees,
;;; and flattening derives a segment angle from a geometric error tolerance.
(defn path-svg-arc-to! [(path (mut Path))
                        (radius-x-input f32)
                        (radius-y-input f32)
                        (x-axis-rotation f32)
                        (large-arc bool)
                        (sweep bool)
                        (x f32)
                        (y f32)
                        (tolerance f32)] (-> i64)
  (let [points (load (field path points))
        count (al/al-len [PathPoint] points)]
    (if (or (load (field path closed)) (= count 0))
        0
        (let [start (al/al-get [PathPoint] points (- count 1))
              start-x (load (field start x))
              start-y (load (field start y))
              dx (- start-x x)
              dy (- start-y y)
              radii-degenerate (or (<= (fabsf radius-x-input) 0.000001)
                                    (<= (fabsf radius-y-input) 0.000001))]
          (cond
            (and (<= (fabsf dx) 0.000001) (<= (fabsf dy) 0.000001)) 0
            radii-degenerate (path-line-to! (mut path) x y)
            :else
              (let [radians-per-degree (primitive/cast f32 0.017453292519943295)
                    rotation (* x-axis-rotation radians-per-degree)
                    cos-rotation (cosf rotation)
                    sin-rotation (sinf rotation)
                    half-dx (* dx 0.5)
                    half-dy (* dy 0.5)
                    prime-x (+ (* cos-rotation half-dx) (* sin-rotation half-dy))
                    prime-y
                      (+ (* (- (primitive/cast f32 0.0) sin-rotation) half-dx)
                         (* cos-rotation half-dy))
                    raw-radius-x (fabsf radius-x-input)
                    raw-radius-y (fabsf radius-y-input)
                    lambda (+ (/ (* prime-x prime-x) (* raw-radius-x raw-radius-x))
                              (/ (* prime-y prime-y) (* raw-radius-y raw-radius-y)))
                    radius-scale (if (> lambda 1.0) (sqrtf lambda) 1.0)
                    radius-x (* raw-radius-x radius-scale)
                    radius-y (* raw-radius-y radius-scale)
                    radius-x-squared (* radius-x radius-x)
                    radius-y-squared (* radius-y radius-y)
                    prime-x-squared (* prime-x prime-x)
                    prime-y-squared (* prime-y prime-y)
                    numerator
                      (- (- (* radius-x-squared radius-y-squared)
                            (* radius-x-squared prime-y-squared))
                         (* radius-y-squared prime-x-squared))
                    denominator
                      (+ (* radius-x-squared prime-y-squared)
                         (* radius-y-squared prime-x-squared))
                    coefficient-base
                      (if (or (<= numerator 0.0) (<= denominator 0.000001))
                          0.0
                          (sqrtf (/ numerator denominator)))
                    coefficient (if (= large-arc sweep)
                                    (- (primitive/cast f32 0.0) coefficient-base)
                                    coefficient-base)
                    center-prime-x (* coefficient (/ (* radius-x prime-y) radius-y))
                    center-prime-y
                      (* coefficient
                         (/ (* (- (primitive/cast f32 0.0) radius-y) prime-x) radius-x))
                    midpoint-x (* (+ start-x x) 0.5)
                    midpoint-y (* (+ start-y y) 0.5)
                    center-x
                      (+ midpoint-x
                         (- (* cos-rotation center-prime-x)
                            (* sin-rotation center-prime-y)))
                    center-y
                      (+ midpoint-y
                         (+ (* sin-rotation center-prime-x)
                            (* cos-rotation center-prime-y)))
                    unit-start-x (/ (- prime-x center-prime-x) radius-x)
                    unit-start-y (/ (- prime-y center-prime-y) radius-y)
                    unit-end-x
                      (/ (- (- (primitive/cast f32 0.0) prime-x) center-prime-x) radius-x)
                    unit-end-y
                      (/ (- (- (primitive/cast f32 0.0) prime-y) center-prime-y) radius-y)
                    start-angle (atan2f unit-start-y unit-start-x)
                    raw-sweep
                      (atan2f (- (* unit-start-x unit-end-y)
                                 (* unit-start-y unit-end-x))
                              (+ (* unit-start-x unit-end-x)
                                 (* unit-start-y unit-end-y)))
                    two-pi (primitive/cast f32 6.283185307179586)
                    sweep-angle
                      (cond (and (not sweep) (> raw-sweep 0.0)) (- raw-sweep two-pi)
                            (and sweep (< raw-sweep 0.0)) (+ raw-sweep two-pi)
                            :else raw-sweep)
                    curve-tolerance (if (> tolerance 0.0) tolerance 0.25)
                    max-radius (if (> radius-x radius-y) radius-x radius-y)
                    error-ratio (if (>= curve-tolerance max-radius)
                                    0.0
                                    (- (primitive/cast f32 1.0)
                                       (/ curve-tolerance max-radius)))
                    max-angle (* (primitive/cast f32 2.0) (acosf error-ratio))
                    safe-angle (if (> max-angle 0.0001) max-angle 0.0001)
                    segments
                      (let [needed
                              (primitive/cast i64
                                              (ceilf (/ (fabsf sweep-angle) safe-angle)))]
                        (if (< needed 1) 1 needed))]
                (do
                  (for [i 1 (+ segments 1)]
                    (let [ratio (/ (primitive/cast f32 i) (primitive/cast f32 segments))
                          angle (+ start-angle (* sweep-angle ratio))]
                      (if (= i segments)
                          (al/al-push! [PathPoint]
                                       (mut (.points path))
                                       (PathPoint :x x :y y))
                          (al/al-push! [PathPoint]
                                       (mut (.points path))
                                       (rotated-ellipse-point center-x
                                                              center-y
                                                              radius-x
                                                              radius-y
                                                              cos-rotation
                                                              sin-rotation
                                                              angle)))))
                  segments)))))))

(defn path-close! [(path (mut Path))] (-> i64)
  (do (set! (.closed path) true) 0))

(defn path-point-count [(path Path)] (-> i64)
  (al/al-len [PathPoint] (load (field path points))))

(defn point-distance [(a PathPoint) (b PathPoint)] (-> f32)
  (let [dx (- (load (field b x)) (load (field a x)))
        dy (- (load (field b y)) (load (field a y)))]
    (sqrtf (+ (* dx dx) (* dy dy)))))

(defn path-length [(path Path)] (-> f32)
  (let [points (load (field path points))
        count (al/al-len [PathPoint] points)
        segment-count (if (load (field path closed)) count (if (> count 0) (- count 1) 0))
        (mut total) (primitive/cast f32 0.0)]
    (do
      (for [i 0 segment-count]
        (store! total
                (+ (load total)
                   (point-distance (al/al-get [PathPoint] points i)
                                   (al/al-get [PathPoint] points (% (+ i 1) count))))))
      (load total))))

(defn path-bounds [(path Path)] (-> PathBounds)
  (let [points (load (field path points))
        count (al/al-len [PathPoint] points)]
    (if (= count 0)
        (PathBounds
          :x 0.0
          :y 0.0
          :w 0.0
          :h 0.0
          :valid false)
        (let [first (al/al-get [PathPoint] points 0)
              (mut min-x) (load (field first x))
              (mut min-y) (load (field first y))
              (mut max-x) (load (field first x))
              (mut max-y) (load (field first y))]
          (do
            (for [i 1 count]
              (let [point (al/al-get [PathPoint] points i)
                    x (load (field point x))
                    y (load (field point y))]
                (do
                  (if (< x (load min-x)) (store! min-x x) 0)
                  (if (< y (load min-y)) (store! min-y y) 0)
                  (if (> x (load max-x)) (store! max-x x) 0)
                  (if (> y (load max-y)) (store! max-y y) 0))))
            (PathBounds
              :x (load min-x)
              :y (load min-y)
              :w (- (load max-x) (load min-x))
              :h (- (load max-y) (load min-y))
              :valid true))))))

(defn tessellation-bounds [(tessellation Tessellation)] (-> PathBounds)
  (let [vertices (load (field tessellation vertices))
        count (al/al-len [PathPoint] vertices)]
    (if (or (not (load (field tessellation valid))) (= count 0))
        (PathBounds
          :x 0.0
          :y 0.0
          :w 0.0
          :h 0.0
          :valid false)
        (let [first (al/al-get [PathPoint] vertices 0)
              (mut min-x) (load (field first x))
              (mut min-y) (load (field first y))
              (mut max-x) (load (field first x))
              (mut max-y) (load (field first y))]
          (do
            (for [i 1 count]
              (let [point (al/al-get [PathPoint] vertices i)
                    x (load (field point x))
                    y (load (field point y))]
                (do
                  (if (< x (load min-x)) (store! min-x x) 0)
                  (if (< y (load min-y)) (store! min-y y) 0)
                  (if (> x (load max-x)) (store! max-x x) 0)
                  (if (> y (load max-y)) (store! max-y y) 0))))
            (PathBounds
              :x (load min-x)
              :y (load min-y)
              :w (- (load max-x) (load min-x))
              :h (- (load max-y) (load min-y))
              :valid true))))))

(defn path-point-at-distance [(path Path) (distance f32)] (-> PathPoint)
  (let [points (load (field path points))
        count (al/al-len [PathPoint] points)]
    (if (= count 0)
        (PathPoint :x 0.0 :y 0.0)
        (let [segment-count (if (load (field path closed)) count (- count 1))
              target (if (> distance 0.0) distance 0.0)
              (mut traversed) (primitive/cast f32 0.0)]
          (block :found
                 (for [i 0 segment-count]
                   (let [a (al/al-get [PathPoint] points i)
                         b (al/al-get [PathPoint] points (% (+ i 1) count))
                         length (point-distance a b)]
                     (if (and (> length 0.000001) (<= target (+ (load traversed) length)))
                         (let [t (/ (- target (load traversed)) length)]
                           (return-from
                             :found
                               (PathPoint :x (+ (load (field a x)) (* (- (load (field b x)) (load (field a x))) t))
                                 :y (+ (load (field a y)) (* (- (load (field b y)) (load (field a y))) t)))))
                         (store! traversed (+ (load traversed) length)))))
                 (al/al-get [PathPoint] points (if (load (field path closed)) 0 (- count 1))))))))

(defn dash-pattern-valid? [(pattern (al/ArrayList f32))] (-> bool)
  (let [count (al/al-len [f32] pattern)]
    (if (= count 0)
        false
        (block :valid
               (for [i 0 count]
                 (if (<= (al/al-get [f32] pattern i) 0.0)
                     (return-from :valid false)
                     0))
               true))))

(defn dash-pattern-length [(pattern (al/ArrayList f32))] (-> f32)
  (let [count (al/al-len [f32] pattern)
        repetitions (if (= (% count 2) 0) 1 2)
        (mut total) (primitive/cast f32 0.0)]
    (do
      (for [repeat 0 repetitions]
        (for [i 0 count]
          (store! total (+ (load total) (al/al-get [f32] pattern i)))))
      (load total))))

(defn dash-phase-normalize [(pattern (al/ArrayList f32)) (phase f32)] (-> f32)
  (let [length (dash-pattern-length pattern)]
    (if (<= length 0.0)
        (primitive/cast f32 0.0)
        (let [(mut normalized) phase]
          (do
            (while (< (load normalized) 0.0) (store! normalized (+ (load normalized) length)))
            (while (>= (load normalized) length) (store! normalized (- (load normalized) length)))
            (load normalized))))))

(defn dash-state-at-phase [(pattern (al/ArrayList f32)) (phase f32)] (-> DashState)
  (if (not (dash-pattern-valid? pattern))
      (DashState
        :index 0
        :remaining 0.0
        :visible false
        :valid false)
      (let [count (al/al-len [f32] pattern)
            virtual-count (if (= (% count 2) 0) count (* count 2))
            (mut offset) (dash-phase-normalize pattern phase)
            (mut index) 0]
        (do
          (while (>= (load offset) (al/al-get [f32] pattern (% (load index) count)))
            (do
              (store! offset (- (load offset) (al/al-get [f32] pattern (% (load index) count))))
              (store! index (% (+ (load index) 1) virtual-count))))
          (DashState
            :index (load index)
            :remaining (- (al/al-get [f32] pattern (% (load index) count)) (load offset))
            :visible (= (% (load index) 2) 0)
            :valid true)))))

(defn path-dash-runs [(path Path) (pattern (al/ArrayList f32)) (phase f32)] (-> DashedPath)
  (let [(mut runs) (al/al-new [Path] (alloc/malloc-allocator))
        points (load (field path points))
        count (al/al-len [PathPoint] points)]
    (if (or (load (field path closed))
            (or (< count 2) (not (dash-pattern-valid? pattern))))
        (DashedPath :runs (load runs) :valid false)
        (let [pattern-count (al/al-len [f32] pattern)
              virtual-count (if (= (% pattern-count 2) 0) pattern-count (* pattern-count 2))
              initial (dash-state-at-phase pattern phase)
              (mut pattern-index) (load (field initial index))
              (mut dash-remaining) (load (field initial remaining))
              (mut visible) (load (field initial visible))
              (mut run) (path-new)]
          (do
            (for [segment 0 (- count 1)]
              (let [a (al/al-get [PathPoint] points segment)
                    b (al/al-get [PathPoint] points (+ segment 1))
                    length (point-distance a b)
                    (mut consumed) (primitive/cast f32 0.0)]
                (while (< (load consumed) (- length 0.000001))
                  (let [available (- length (load consumed))
                        step (if (< available (load dash-remaining)) available (load dash-remaining))
                        start-t (/ (load consumed) length)
                        end-t (/ (+ (load consumed) step) length)
                        start
                          (PathPoint :x (+ (load (field a x)) (* (- (load (field b x)) (load (field a x))) start-t))
                            :y (+ (load (field a y)) (* (- (load (field b y)) (load (field a y))) start-t)))
                        end
                          (PathPoint :x (+ (load (field a x)) (* (- (load (field b x)) (load (field a x))) end-t))
                            :y (+ (load (field a y)) (* (- (load (field b y)) (load (field a y))) end-t)))]
                    (do
                      (if (load visible)
                          (do
                            (if (= (path-point-count (load run)) 0)
                                (path-move-to! (mut run) (load (field start x)) (load (field start y)))
                                0)
                            (path-line-to! (mut run) (load (field end x)) (load (field end y))))
                          0)
                      (store! consumed (+ (load consumed) step))
                      (store! dash-remaining (- (load dash-remaining) step))
                      (if (<= (load dash-remaining) 0.000001)
                          (do
                            (if (and (load visible) (> (path-point-count (load run)) 1))
                                (do
                                  (al/al-push! [Path] (mut runs) (load run))
                                  (store! run (path-new)))
                                0)
                            (store! pattern-index (% (+ (load pattern-index) 1) virtual-count))
                            (store! visible (= (% (load pattern-index) 2) 0))
                            (store! dash-remaining
                                    (al/al-get [f32] pattern (% (load pattern-index) pattern-count))))
                          0))))))
            (if (and (load visible) (> (path-point-count (load run)) 1))
                (al/al-push! [Path] (mut runs) (load run))
                (path-free! (mut run)))
            (DashedPath :runs (load runs) :valid true))))))

(defn dashed-path-free! [(dashed (mut DashedPath))] (-> i64)
  (let [runs (load (field dashed runs))]
    (do
      (for [i 0 (al/al-len [Path] runs)]
        (path-free! (mut (primitive/index (load (field runs data)) i))))
      (al/al-free! [Path] (mut (.runs dashed))))))

(defn path-dashed-stroke-tessellate [(path Path)
                                     (pattern (al/ArrayList f32))
                                     (phase f32)
                                     (width f32)
                                     (miter-limit f32)
                                     (cap i32)
                                     (join i32)
                                     (tolerance f32)] (-> Tessellation)
  (let [(mut dashed) (path-dash-runs path pattern phase)
        (mut vertices) (al/al-new [PathPoint] (alloc/malloc-allocator))]
    (if (not (load (field dashed valid)))
        (do
          (dashed-path-free! (mut dashed))
          (Tessellation :vertices (load vertices) :valid false))
        (let [runs (load (field dashed runs))]
          (do
            (for [i 0 (al/al-len [Path] runs)]
              (let [(mut mesh)
                      (path-stroke-tessellate-style (al/al-get [Path] runs i)
                                                    width
                                                    miter-limit
                                                    cap
                                                    join
                                                    tolerance)
                    mesh-vertices (load (field mesh vertices))]
                (do
                  (if (load (field mesh valid))
                      (for [j 0 (al/al-len [PathPoint] mesh-vertices)]
                        (al/al-push! [PathPoint]
                                     (mut vertices)
                                     (al/al-get [PathPoint] mesh-vertices j)))
                      0)
                  (tessellation-free! (mut mesh)))))
            (dashed-path-free! (mut dashed))
            (Tessellation :vertices (load vertices) :valid true))))))

(defn cross [(a PathPoint) (b PathPoint) (c PathPoint)] (-> f32)
  (- (* (- (load (field b x)) (load (field a x)))
        (- (load (field c y)) (load (field a y))))
     (* (- (load (field b y)) (load (field a y)))
        (- (load (field c x)) (load (field a x))))))

(defn path-signed-area [(path Path)] (-> f32)
  (let [points (load (field path points))
        count (al/al-len [PathPoint] points)
        (mut twice-area) (primitive/cast f32 0.0)]
    (do
      (for [i 0 count]
        (let [a (al/al-get [PathPoint] points i)
              b (al/al-get [PathPoint] points (% (+ i 1) count))]
          (store! twice-area
                  (+ (load twice-area)
                     (- (* (load (field a x)) (load (field b y)))
                        (* (load (field b x)) (load (field a y))))))))
      (/ (load twice-area) 2.0))))

(defn orientation [(a PathPoint) (b PathPoint) (c PathPoint)] (-> i32)
  (let [value (cross a b c)]
    (cond (> value 0.00001) 1 (< value -0.00001) -1 :else 0)))

(defn on-segment? [(a PathPoint) (b PathPoint) (p PathPoint)] (-> bool)
  (and (<= (if (< (load (field a x)) (load (field b x)))
               (load (field a x))
               (load (field b x)))
           (load (field p x)))
       (and (<= (load (field p x))
                (if (> (load (field a x)) (load (field b x)))
                    (load (field a x))
                    (load (field b x))))
            (and (<= (if (< (load (field a y)) (load (field b y)))
                         (load (field a y))
                         (load (field b y)))
                     (load (field p y)))
                 (<= (load (field p y))
                     (if (> (load (field a y)) (load (field b y)))
                         (load (field a y))
                         (load (field b y))))))))

(defn segments-intersect? [(a PathPoint) (b PathPoint) (c PathPoint) (d PathPoint)] (-> bool)
  (let [o1 (orientation a b c)
        o2 (orientation a b d)
        o3 (orientation c d a)
        o4 (orientation c d b)]
    (or (and (!= o1 o2) (!= o3 o4))
        (or (and (= o1 0) (on-segment? a b c))
            (or (and (= o2 0) (on-segment? a b d))
                (or (and (= o3 0) (on-segment? c d a))
                    (and (= o4 0) (on-segment? c d b))))))))

(defn edges-adjacent? [(a i64) (b i64) (count i64)] (-> bool)
  (or (= a b) (or (= (% (+ a 1) count) b) (= (% (+ b 1) count) a))))

(defn path-simple? [(path Path)] (-> bool)
  (let [points (load (field path points))
        count (al/al-len [PathPoint] points)]
    (if (or (not (load (field path closed))) (< count 3))
        false
        (block :result
               (for [i 0 count]
                 (let [a (al/al-get [PathPoint] points i)
                       b (al/al-get [PathPoint] points (% (+ i 1) count))]
                   (for [j (+ i 1) count]
                     (if (not (edges-adjacent? i j count))
                         (let [c (al/al-get [PathPoint] points j)
                               d (al/al-get [PathPoint] points (% (+ j 1) count))]
                           (if (segments-intersect? a b c d)
                               (return-from :result false)
                               0))
                         0))))
               (let [area (path-signed-area path)]
                 (or (> area 0.0001) (< area -0.0001)))))))

(defn point-in-triangle? [(p PathPoint)
                          (a PathPoint)
                          (b PathPoint)
                          (c PathPoint)
                          (winding f32)] (-> bool)
  (and (>= (* (cross a b p) winding) -0.00001)
       (and (>= (* (cross b c p) winding) -0.00001)
            (>= (* (cross c a p) winding) -0.00001))))

(defn index-remove! [(indices (mut (al/ArrayList i64))) (index i64)] (-> i64)
  (let [count (al/al-len [i64] (load indices))]
    (do
      (for [i index (- count 1)]
        (al/al-set! [i64] (mut indices) i (al/al-get [i64] (load indices) (+ i 1))))
      (al/al-pop! [i64] (mut indices))
      0)))

(defn invalid-tessellation [] (-> Tessellation)
  (Tessellation :vertices (al/al-new [PathPoint] (alloc/malloc-allocator)) :valid false))

(defn path-tessellate [(path Path)] (-> Tessellation)
  (if (not (path-simple? path))
      (invalid-tessellation)
      (let [allocator (alloc/malloc-allocator)
            (mut vertices) (al/al-new [PathPoint] allocator)
            (mut indices) (al/al-new [i64] allocator)
            points (load (field path points))
            count (al/al-len [PathPoint] points)
            winding
              (if (> (path-signed-area path) 0.0)
                  (primitive/cast f32 1.0)
                  (primitive/cast f32 -1.0))
            (mut failed) false]
        (do
          (for [i 0 count] (al/al-push! [i64] (mut indices) i))
          (while (and (> (al/al-len [i64] (load indices)) 3) (not (load failed)))
            (let [remaining (al/al-len [i64] (load indices))
                  (mut found-ear) false]
              (do
                (block :ear
                       (for [slot 0 remaining]
                         (let [prev-slot (% (+ slot (- remaining 1)) remaining)
                               next-slot (% (+ slot 1) remaining)
                               ia (al/al-get [i64] (load indices) prev-slot)
                               ib (al/al-get [i64] (load indices) slot)
                               ic (al/al-get [i64] (load indices) next-slot)
                               a (al/al-get [PathPoint] points ia)
                               b (al/al-get [PathPoint] points ib)
                               c (al/al-get [PathPoint] points ic)]
                           (if (> (* (cross a b c) winding) 0.00001)
                               (let [(mut contains-point) false]
                                 (do
                                   (for [other-slot 0 remaining]
                                     (let [other (al/al-get [i64] (load indices) other-slot)]
                                       (if (and (!= other ia) (and (!= other ib) (!= other ic)))
                                           (let [p (al/al-get [PathPoint] points other)]
                                             (if (point-in-triangle? p a b c winding)
                                                 (store! contains-point true)
                                                 0))
                                           0)))
                                   (if (not (load contains-point))
                                       (do
                                         (al/al-push! [PathPoint] (mut vertices) a)
                                         (al/al-push! [PathPoint] (mut vertices) b)
                                         (al/al-push! [PathPoint] (mut vertices) c)
                                         (index-remove! (mut indices) slot)
                                         (store! found-ear true)
                                         (return-from :ear 0))
                                       0)))
                               0)))
                       (if (not (load found-ear)) (store! failed true) 0)))))
          (if (not (load failed))
              (let [a (al/al-get [PathPoint] points (al/al-get [i64] (load indices) 0))
                    b (al/al-get [PathPoint] points (al/al-get [i64] (load indices) 1))
                    c (al/al-get [PathPoint] points (al/al-get [i64] (load indices) 2))]
                (do
                  (al/al-push! [PathPoint] (mut vertices) a)
                  (al/al-push! [PathPoint] (mut vertices) b)
                  (al/al-push! [PathPoint] (mut vertices) c)))
              (al/al-clear! [PathPoint] (mut vertices)))
          (al/al-free! [i64] (mut indices))
          (Tessellation :vertices (load vertices) :valid (not (load failed)))))))

(defn unit-normal [(a PathPoint) (b PathPoint)] (-> StrokePair)
  (let [dx (- (load (field b x)) (load (field a x)))
        dy (- (load (field b y)) (load (field a y)))
        length (sqrtf (+ (* dx dx) (* dy dy)))]
    (if (<= length 0.00001)
        (StrokePair
          :left (PathPoint :x 0.0 :y 0.0)
          :right (PathPoint :x 0.0 :y 0.0)
          :valid false)
        (let [nx (/ (- (primitive/cast f32 0.0) dy) length)
              ny (/ dx length)]
          (StrokePair
            :left (PathPoint :x nx :y ny)
            :right
              (PathPoint :x (- (primitive/cast f32 0.0) nx)
                :y (- (primitive/cast f32 0.0) ny))
            :valid true)))))

(defn stroke-pair [(points (al/ArrayList PathPoint))
                   (index i64)
                   (count i64)
                   (closed bool)
                   (half-width f32)
                   (miter-limit f32)] (-> StrokePair)
  (let [point (al/al-get [PathPoint] points index)
        has-prev (or closed (> index 0))
        has-next (or closed (< index (- count 1)))
        prev-index (if (> index 0) (- index 1) (- count 1))
        next-index (if (< index (- count 1)) (+ index 1) 0)
        prev-normal
          (if has-prev
              (unit-normal (al/al-get [PathPoint] points prev-index) point)
              (unit-normal point (al/al-get [PathPoint] points next-index)))
        next-normal
          (if has-next
              (unit-normal point (al/al-get [PathPoint] points next-index))
              (load prev-normal))]
    (if (or (not (load (field prev-normal valid))) (not (load (field next-normal valid))))
        (StrokePair
          :left point
          :right point
          :valid false)
        (let [prev (load (field prev-normal left))
              next (load (field next-normal left))
              sum-x (+ (load (field prev x)) (load (field next x)))
              sum-y (+ (load (field prev y)) (load (field next y)))
              sum-length (sqrtf (+ (* sum-x sum-x) (* sum-y sum-y)))
              join-x (if (> sum-length 0.00001) (/ sum-x sum-length) (load (field next x)))
              join-y (if (> sum-length 0.00001) (/ sum-y sum-length) (load (field next y)))
              denominator (+ (* join-x (load (field next x))) (* join-y (load (field next y))))
              raw-distance (if (> denominator 0.00001) (/ half-width denominator) half-width)
              limit (* half-width (if (> miter-limit 1.0) miter-limit 1.0))
              distance (if (> raw-distance limit) limit raw-distance)
              offset-x (* join-x distance)
              offset-y (* join-y distance)]
          (StrokePair
            :left
              (PathPoint :x (+ (load (field point x)) offset-x)
                :y (+ (load (field point y)) offset-y))
            :right
              (PathPoint :x (- (load (field point x)) offset-x)
                :y (- (load (field point y)) offset-y))
            :valid true)))))

(defn translate-pair [(pair StrokePair) (x f32) (y f32)] (-> StrokePair)
  (let [left (load (field pair left))
        right (load (field pair right))]
    (StrokePair
      :left (PathPoint :x (+ (load (field left x)) x) :y (+ (load (field left y)) y))
      :right (PathPoint :x (+ (load (field right x)) x) :y (+ (load (field right y)) y))
      :valid (load (field pair valid)))))

(defn append-round-fan! [(vertices (mut (al/ArrayList PathPoint)))
                         (center PathPoint)
                         (radius f32)
                         (start-angle f32)
                         (end-angle f32)
                         (start-point PathPoint)
                         (end-point PathPoint)
                         (tolerance f32)
                         (depth i32)] (-> i64)
  (let [middle-angle (* (+ start-angle end-angle) 0.5)
        middle-point
          (ellipse-point (load (field center x))
                         (load (field center y))
                         radius
                         radius
                         middle-angle)]
    (if (or (>= depth 16) (point-line-flat? middle-point start-point end-point tolerance))
        (do
          (al/al-push! [PathPoint] (mut vertices) center)
          (al/al-push! [PathPoint] (mut vertices) start-point)
          (al/al-push! [PathPoint] (mut vertices) end-point))
        (do
          (append-round-fan! (mut vertices)
                             center
                             radius
                             start-angle
                             middle-angle
                             start-point
                             middle-point
                             tolerance
                             (+ depth 1))
          (append-round-fan! (mut vertices)
                             center
                             radius
                             middle-angle
                             end-angle
                             middle-point
                             end-point
                             tolerance
                             (+ depth 1))))))

;;; Tessellate a polyline with bounded miter joins and configurable end caps.
(defn legacy-stroke-tessellate [(path Path)
                                (width f32)
                                (miter-limit f32)
                                (cap i32)
                                (tolerance f32)] (-> Tessellation)
  (let [points (load (field path points))
        count (al/al-len [PathPoint] points)
        closed (load (field path closed))]
    (if (or (< count 2) (<= width 0.0))
        (invalid-tessellation)
        (let [(mut vertices) (al/al-new [PathPoint] (alloc/malloc-allocator))
              segment-count (if closed count (- count 1))
              half-width (* width 0.5)
              (mut valid) true]
          (do
            (for [i 0 segment-count]
              (let [next (% (+ i 1) count)
                    raw-a (stroke-pair points i count closed half-width miter-limit)
                    raw-b (stroke-pair points next count closed half-width miter-limit)
                    segment-a (al/al-get [PathPoint] points i)
                    segment-b (al/al-get [PathPoint] points next)
                    dx (- (load (field segment-b x)) (load (field segment-a x)))
                    dy (- (load (field segment-b y)) (load (field segment-a y)))
                    length (sqrtf (+ (* dx dx) (* dy dy)))
                    extend-a (and (not closed) (and (= cap (SquareCap)) (= i 0)))
                    extend-b (and (not closed) (and (= cap (SquareCap)) (= next (- count 1))))
                    a
                      (if extend-a
                          (translate-pair raw-a
                                          (* (/ dx length) (- (primitive/cast f32 0.0) half-width))
                                          (* (/ dy length) (- (primitive/cast f32 0.0) half-width)))
                          (load raw-a))
                    b
                      (if extend-b
                          (translate-pair raw-b (* (/ dx length) half-width) (* (/ dy length) half-width))
                          (load raw-b))]
                (if (and (load (field a valid)) (load (field b valid)))
                    (do
                      (al/al-push! [PathPoint] (mut vertices) (load (field a left)))
                      (al/al-push! [PathPoint] (mut vertices) (load (field a right)))
                      (al/al-push! [PathPoint] (mut vertices) (load (field b left)))
                      (al/al-push! [PathPoint] (mut vertices) (load (field b left)))
                      (al/al-push! [PathPoint] (mut vertices) (load (field a right)))
                      (al/al-push! [PathPoint] (mut vertices) (load (field b right))))
                    (store! valid false))))
            (if (and (load valid) (and (not closed) (= cap (RoundCap))))
                (let [first (al/al-get [PathPoint] points 0)
                      second (al/al-get [PathPoint] points 1)
                      before-last (al/al-get [PathPoint] points (- count 2))
                      last (al/al-get [PathPoint] points (- count 1))
                      start-angle
                        (atan2f (- (load (field second y)) (load (field first y)))
                                (- (load (field second x)) (load (field first x))))
                      end-angle
                        (atan2f (- (load (field last y)) (load (field before-last y)))
                                (- (load (field last x)) (load (field before-last x))))
                      half-pi (primitive/cast f32 1.5707963267948966)
                      pi (primitive/cast f32 3.141592653589793)
                      cap-tolerance (if (> tolerance 0.0) tolerance 0.25)
                      start-left
                        (ellipse-point (load (field first x))
                                       (load (field first y))
                                       half-width
                                       half-width
                                       (+ start-angle half-pi))
                      start-right
                        (ellipse-point (load (field first x))
                                       (load (field first y))
                                       half-width
                                       half-width
                                       (+ (+ start-angle half-pi) pi))
                      end-right
                        (ellipse-point (load (field last x))
                                       (load (field last y))
                                       half-width
                                       half-width
                                       (- end-angle half-pi))
                      end-left
                        (ellipse-point (load (field last x))
                                       (load (field last y))
                                       half-width
                                       half-width
                                       (+ end-angle half-pi))]
                  (do
                    (append-round-fan! (mut vertices)
                                       first
                                       half-width
                                       (+ start-angle half-pi)
                                       (+ (+ start-angle half-pi) pi)
                                       start-left
                                       start-right
                                       cap-tolerance
                                       0)
                    (append-round-fan! (mut vertices)
                                       last
                                       half-width
                                       (- end-angle half-pi)
                                       (+ end-angle half-pi)
                                       end-right
                                       end-left
                                       cap-tolerance
                                       0)))
                0)
            (if (not (load valid)) (al/al-clear! [PathPoint] (mut vertices)) 0)
            (Tessellation :vertices (load vertices) :valid (load valid)))))))

(defn offset-point [(point PathPoint) (normal PathPoint) (distance f32)] (-> PathPoint)
  (PathPoint :x (+ (load (field point x)) (* (load (field normal x)) distance))
    :y (+ (load (field point y)) (* (load (field normal y)) distance))))

(defn append-triangle! [(vertices (mut (al/ArrayList PathPoint)))
                        (a PathPoint)
                        (b PathPoint)
                        (c PathPoint)] (-> i64)
  (do
    (al/al-push! [PathPoint] (mut vertices) a)
    (al/al-push! [PathPoint] (mut vertices) b)
    (al/al-push! [PathPoint] (mut vertices) c)))

(defn append-stroke-join! [(vertices (mut (al/ArrayList PathPoint)))
                           (center PathPoint)
                           (previous-normal PathPoint)
                           (next-normal PathPoint)
                           (half-width f32)
                           (miter-limit f32)
                           (join i32)
                           (tolerance f32)] (-> i64)
  (let [turn
          (- (* (load (field previous-normal x)) (load (field next-normal y)))
             (* (load (field previous-normal y)) (load (field next-normal x))))]
    (if (and (> turn -0.00001) (< turn 0.00001))
        0
        (let [side (if (> turn 0.0) (primitive/cast f32 1.0) (primitive/cast f32 -1.0))
              prev-x (* (load (field previous-normal x)) side)
              prev-y (* (load (field previous-normal y)) side)
              next-x (* (load (field next-normal x)) side)
              next-y (* (load (field next-normal y)) side)
              previous-outer
                (PathPoint :x (+ (load (field center x)) (* prev-x half-width))
                  :y (+ (load (field center y)) (* prev-y half-width)))
              next-outer
                (PathPoint :x (+ (load (field center x)) (* next-x half-width))
                  :y (+ (load (field center y)) (* next-y half-width)))]
          (if (= join (RoundJoin))
              (let [two-pi (primitive/cast f32 6.283185307179586)
                    start (atan2f prev-y prev-x)
                    raw-end (atan2f next-y next-x)
                    end
                      (if (> turn 0.0)
                          (if (< raw-end start) (+ raw-end two-pi) raw-end)
                          (if (> raw-end start) (- raw-end two-pi) raw-end))]
                (append-round-fan! (mut vertices)
                                   center
                                   half-width
                                   start
                                   end
                                   previous-outer
                                   next-outer
                                   (if (> tolerance 0.0) tolerance 0.25)
                                   0))
              (if (= join (MiterJoin))
                  (let [sum-x (+ prev-x next-x)
                        sum-y (+ prev-y next-y)
                        sum-length (sqrtf (+ (* sum-x sum-x) (* sum-y sum-y)))
                        miter-x (if (> sum-length 0.00001) (/ sum-x sum-length) next-x)
                        miter-y (if (> sum-length 0.00001) (/ sum-y sum-length) next-y)
                        denominator (+ (* miter-x next-x) (* miter-y next-y))
                        distance (if (> denominator 0.00001) (/ half-width denominator) 1000000.0)
                        limit (* half-width (if (> miter-limit 1.0) miter-limit 1.0))]
                    (if (<= distance limit)
                        (append-triangle! (mut vertices)
                                          previous-outer
                                          (PathPoint :x (+ (load (field center x)) (* miter-x distance))
                                            :y (+ (load (field center y)) (* miter-y distance)))
                                          next-outer)
                        (append-triangle! (mut vertices) center previous-outer next-outer)))
                  (append-triangle! (mut vertices) center previous-outer next-outer)))))))

(defn path-stroke-tessellate-style [(path Path)
                                    (width f32)
                                    (miter-limit f32)
                                    (cap i32)
                                    (join i32)
                                    (tolerance f32)] (-> Tessellation)
  (let [points (load (field path points))
        count (al/al-len [PathPoint] points)
        closed (load (field path closed))]
    (if (or (< count 2) (<= width 0.0))
        (invalid-tessellation)
        (let [(mut vertices) (al/al-new [PathPoint] (alloc/malloc-allocator))
              segment-count (if closed count (- count 1))
              half-width (* width 0.5)
              (mut valid) true]
          (do
            (for [i 0 segment-count]
              (let [next (% (+ i 1) count)
                    a (al/al-get [PathPoint] points i)
                    b (al/al-get [PathPoint] points next)
                    normal-pair (unit-normal a b)]
                (if (not (load (field normal-pair valid)))
                    (store! valid false)
                    (let [normal (load (field normal-pair left))
                          dx (- (load (field b x)) (load (field a x)))
                          dy (- (load (field b y)) (load (field a y)))
                          length (sqrtf (+ (* dx dx) (* dy dy)))
                          start-extension
                            (if (and (not closed) (and (= cap (SquareCap)) (= i 0)))
                                (- (primitive/cast f32 0.0) half-width)
                                (primitive/cast f32 0.0))
                          end-extension
                            (if (and (not closed)
                                     (and (= cap (SquareCap)) (= next (- count 1))))
                                half-width
                                (primitive/cast f32 0.0))
                          start
                            (PathPoint :x (+ (load (field a x)) (* (/ dx length) start-extension))
                              :y (+ (load (field a y)) (* (/ dy length) start-extension)))
                          end
                            (PathPoint :x (+ (load (field b x)) (* (/ dx length) end-extension))
                              :y (+ (load (field b y)) (* (/ dy length) end-extension)))
                          start-left (offset-point start normal half-width)
                          start-right (offset-point start normal (- (primitive/cast f32 0.0) half-width))
                          end-left (offset-point end normal half-width)
                          end-right (offset-point end normal (- (primitive/cast f32 0.0) half-width))]
                      (do
                        (append-triangle! (mut vertices) start-left start-right end-left)
                        (append-triangle! (mut vertices) end-left start-right end-right))))))
            (let [join-start (if closed 0 1)
                  join-end (if closed count (- count 1))]
              (for [i join-start join-end]
                (let [previous (% (+ i (- count 1)) count)
                      next (% (+ i 1) count)
                      center (al/al-get [PathPoint] points i)
                      prev-pair (unit-normal (al/al-get [PathPoint] points previous) center)
                      next-pair (unit-normal center (al/al-get [PathPoint] points next))]
                  (if (and (load (field prev-pair valid)) (load (field next-pair valid)))
                      (append-stroke-join! (mut vertices)
                                           center
                                           (load (field prev-pair left))
                                           (load (field next-pair left))
                                           half-width
                                           miter-limit
                                           join
                                           tolerance)
                      (store! valid false)))))
            ;; Reuse the proven adaptive cap fan generation from the legacy core.
            (if (and (load valid) (and (not closed) (= cap (RoundCap))))
                (let [(mut caps) (legacy-stroke-tessellate path width miter-limit cap tolerance)
                      cap-vertices (load (field caps vertices))
                      cap-count (al/al-len [PathPoint] cap-vertices)
                      body-count (* segment-count 6)]
                  (do
                    (for [i body-count cap-count]
                      (al/al-push! [PathPoint] (mut vertices) (al/al-get [PathPoint] cap-vertices i)))
                    (tessellation-free! (mut caps))))
                0)
            (if (not (load valid)) (al/al-clear! [PathPoint] (mut vertices)) 0)
            (Tessellation :vertices (load vertices) :valid (load valid)))))))

(defn path-stroke-tessellate-cap [(path Path)
                                  (width f32)
                                  (miter-limit f32)
                                  (cap i32)
                                  (tolerance f32)] (-> Tessellation)
  (path-stroke-tessellate-style path width miter-limit cap (MiterJoin) tolerance))

(defn path-stroke-tessellate [(path Path) (width f32) (miter-limit f32)] (-> Tessellation)
  (path-stroke-tessellate-style path width miter-limit (ButtCap) (MiterJoin) 0.25))

(defn tessellation-free! [(tessellation (mut Tessellation))] (-> i64)
  (al/al-free! [PathPoint] (mut (.vertices tessellation))))
