(module experiments.coil_gpui.svg-document)
(import "coil.arraylist" :as al)
(import "coil.alloc" :as alloc)
(import "coil.primitive" :as primitive)
(import "experiments.coil_gpui.path" :as path)
(import "experiments.coil_gpui.svg" :as svg)
(import "experiments.coil_gpui.ui" :as ui)

(export SvgDocument
        svg-document-new
        svg-document-valid?
        svg-document-shape-count
        svg-document-paint!
        svg-document-free!)

(extern strlen :cc c [(ptr i8)] (-> i64))
(extern strtod :cc c [(ptr i8) (ptr (ptr i8))] (-> f64))
(extern malloc :cc c [i64] (-> (ptr i8)))
(extern free :cc c [(ptr i8)] (-> void))
(extern memcpy :cc c [(ptr i8) (ptr i8) i64] (-> (ptr i8)))

(defstruct XmlReader [(cursor (ptr u8)) (valid bool)])
(defstruct XmlSlice [(start (ptr u8)) (length i64)])
(defstruct SvgStyle
  [(fill ui/Color)
   (fill-opacity f32)
   (fill-rule i32)
   (fill-enabled bool)
   (stroke ui/Color)
   (stroke-opacity f32)
   (stroke-width f32)
   (stroke-enabled bool)
   (stroke-cap i32)
   (stroke-join i32)
   (stroke-miter-limit f32)
   (transform ui/Affine)])
(defstruct SvgDocumentShape
  [(vector svg/SvgVector) (fill ui/Color) (transform ui/Affine)])
(defstruct SvgDocument
  [(shapes (al/ArrayList SvgDocumentShape))
   (bounds path/PathBounds)
   (valid bool)])

(defstruct SvgGeometry
  [(x f32) (y f32) (width f32) (height f32)
   (rx f32) (ry f32) (have-rx bool) (have-ry bool)
   (cx f32) (cy f32) (r f32)
   (x1 f32) (y1 f32) (x2 f32) (y2 f32)
   (points (ptr i8))])

(defn byte-at [(pointer (ptr u8)) (index i64)] (-> u8)
  (load (primitive/index pointer index)))

(defn reader-byte [(reader XmlReader)] (-> u8)
  (if (= (primitive/cast i64 (load (field reader cursor))) 0)
      (primitive/cast u8 0)
      (load (load (field reader cursor)))))

(defn reader-advance! [(reader (mut XmlReader))] (-> i64)
  (do
    (set! (.cursor reader)
          (primitive/cast (ptr u8)
                          (+ (primitive/cast i64 (load (field reader cursor))) 1)))
    0))

(defn xml-space? [(byte u8)] (-> bool)
  (or (= byte (primitive/cast u8 32))
      (or (= byte (primitive/cast u8 9))
          (or (= byte (primitive/cast u8 10)) (= byte (primitive/cast u8 13))))))

(defn skip-space! [(reader (mut XmlReader))] (-> i64)
  (do
    (while (xml-space? (reader-byte (load reader))) (reader-advance! (mut reader)))
    0))

(defn name-byte? [(byte u8)] (-> bool)
  (or (and (>= byte (primitive/cast u8 65)) (<= byte (primitive/cast u8 90)))
      (or (and (>= byte (primitive/cast u8 97)) (<= byte (primitive/cast u8 122)))
          (or (and (>= byte (primitive/cast u8 48)) (<= byte (primitive/cast u8 57)))
              (or (= byte (primitive/cast u8 45))
                  (or (= byte (primitive/cast u8 95)) (= byte (primitive/cast u8 58))))))))

(defn read-name! [(reader (mut XmlReader))] (-> XmlSlice)
  (let [start (load (field reader cursor)) (mut length) (primitive/cast i64 0)]
    (do
      (while (name-byte? (reader-byte (load reader)))
        (do (reader-advance! (mut reader)) (store! length (+ (load length) 1))))
      (if (= (load length) 0) (set! (.valid reader) false) 0)
      (XmlSlice :start start :length (load length)))))

(defn slice-equals? [(slice XmlSlice) (literal (ptr i8))] (-> bool)
  (let [length (strlen literal)]
    (if (!= (load (field slice length)) length)
        false
        (block :result
          (for [i 0 length]
            (if (!= (byte-at (load (field slice start)) i)
                    (byte-at (primitive/cast (ptr u8) literal) i))
                (return-from :result false)
                0))
          true))))

(defn slice-copy [(slice XmlSlice)] (-> (ptr i8))
  (let [length (load (field slice length)) copy (malloc (+ length 1))]
    (if (= (primitive/cast i64 copy) 0)
        (primitive/cast (ptr i8) 0)
        (do
          (memcpy copy (primitive/cast (ptr i8) (load (field slice start))) length)
          (store! (primitive/index (primitive/cast (ptr u8) copy) length) (primitive/cast u8 0))
          copy))))

(defn read-value! [(reader (mut XmlReader))] (-> XmlSlice)
  (do
    (skip-space! (mut reader))
    (if (!= (reader-byte (load reader)) (primitive/cast u8 61))
        (do
          (set! (.valid reader) false)
          (XmlSlice :start (load (field reader cursor)) :length 0))
        (do
          (reader-advance! (mut reader))
          (skip-space! (mut reader))
          (let [quote (reader-byte (load reader))]
            (if (not (or (= quote (primitive/cast u8 34)) (= quote (primitive/cast u8 39))))
                (do
                  (set! (.valid reader) false)
                  (XmlSlice :start (load (field reader cursor)) :length 0))
                (do
                  (reader-advance! (mut reader))
                  (let [start (load (field reader cursor)) (mut length) (primitive/cast i64 0)]
                    (do
                      (while (and (!= (reader-byte (load reader)) quote)
                                  (!= (reader-byte (load reader)) (primitive/cast u8 0)))
                        (do
                          (reader-advance! (mut reader))
                          (store! length (+ (load length) 1))))
                      (if (= (reader-byte (load reader)) quote)
                          (reader-advance! (mut reader))
                          (set! (.valid reader) false))
                      (XmlSlice :start start :length (load length)))))))))))

(defn hex-digit [(byte u8)] (-> i32)
  (cond
    (and (>= byte (primitive/cast u8 48)) (<= byte (primitive/cast u8 57)))
      (primitive/cast i32 (- byte (primitive/cast u8 48)))
    (and (>= byte (primitive/cast u8 65)) (<= byte (primitive/cast u8 70)))
      (+ (primitive/cast i32 (- byte (primitive/cast u8 65))) 10)
    (and (>= byte (primitive/cast u8 97)) (<= byte (primitive/cast u8 102)))
      (+ (primitive/cast i32 (- byte (primitive/cast u8 97))) 10)
    :else -1))

(defn byte-color [(value i32)] (-> f32)
  (/ (primitive/cast f32 value) 255.0))

(defn parse-color! [(style (mut SvgStyle)) (value XmlSlice)] (-> i64)
  (let [length (load (field value length)) start (load (field value start))]
    (cond
      (slice-equals? value c"none") (set! (.fill-enabled style) false)
      (slice-equals? value c"black")
        (do (set! (.fill style) (ui/rgb 0.0 0.0 0.0)) (set! (.fill-enabled style) true))
      (slice-equals? value c"white")
        (do (set! (.fill style) (ui/rgb 1.0 1.0 1.0)) (set! (.fill-enabled style) true))
      (and (= length 7) (= (byte-at start 0) (primitive/cast u8 35)))
        (let [r0 (hex-digit (byte-at start 1)) r1 (hex-digit (byte-at start 2))
              g0 (hex-digit (byte-at start 3)) g1 (hex-digit (byte-at start 4))
              b0 (hex-digit (byte-at start 5)) b1 (hex-digit (byte-at start 6))]
          (if (or (< r0 0) (or (< r1 0) (or (< g0 0) (or (< g1 0) (or (< b0 0) (< b1 0))))))
              -1
              (do
                (set! (.fill style)
                      (ui/rgb (byte-color (+ (* r0 16) r1))
                              (byte-color (+ (* g0 16) g1))
                              (byte-color (+ (* b0 16) b1))))
                (set! (.fill-enabled style) true))))
      :else -1)))

(defn numeric-separator? [(byte u8)] (-> bool)
  (or (xml-space? byte) (= byte (primitive/cast u8 44))))

(defn number-skip! [(cursor (mut (ptr u8)))] (-> i64)
  (do
    (while (numeric-separator? (load (load cursor)))
      (store! cursor (primitive/index (load cursor) 1)))
    0))

(defn number-read! [(cursor (mut (ptr u8))) (valid (mut bool))] (-> f32)
  (do
    (number-skip! (mut cursor))
    (let [end (primitive/alloc-stack (ptr i8)) start (load cursor)]
      (do
        (store! end (primitive/cast (ptr i8) 0))
        (let [value (strtod (primitive/cast (ptr i8) start) end)
              finish (primitive/cast (ptr u8) (load end))]
          (if (= (primitive/cast i64 finish) (primitive/cast i64 start))
              (do (store! valid false) 0.0)
              (do (store! cursor finish) (primitive/cast f32 value))))))))

(defn prefix-at? [(cursor (ptr u8)) (literal (ptr i8))] (-> bool)
  (let [length (strlen literal)]
    (block :result
      (for [i 0 length]
        (if (!= (byte-at cursor i) (byte-at (primitive/cast (ptr u8) literal) i))
            (return-from :result false)
            0))
      true)))

(defn skip-processing-instruction! [(reader (mut XmlReader))] (-> i64)
  (do
    (reader-advance! (mut reader))
    (reader-advance! (mut reader))
    (while (and (!= (reader-byte (load reader)) (primitive/cast u8 0))
                (not (and (= (reader-byte (load reader)) (primitive/cast u8 63))
                          (= (byte-at (load (field reader cursor)) 1)
                             (primitive/cast u8 62)))))
      (reader-advance! (mut reader)))
    (if (= (reader-byte (load reader)) (primitive/cast u8 0))
        (set! (.valid reader) false)
        (do (reader-advance! (mut reader)) (reader-advance! (mut reader)) 0))))

(defn skip-declaration! [(reader (mut XmlReader))] (-> i64)
  (do
    (reader-advance! (mut reader))
    (reader-advance! (mut reader))
    (while (and (!= (reader-byte (load reader)) (primitive/cast u8 0))
                (!= (reader-byte (load reader)) (primitive/cast u8 62)))
      (reader-advance! (mut reader)))
    (if (= (reader-byte (load reader)) (primitive/cast u8 0))
        (set! (.valid reader) false)
        (reader-advance! (mut reader)))))

(defn parse-transform [(value XmlSlice)] (-> ui/Affine)
  (let [copy (slice-copy value)
        (mut cursor) (primitive/cast (ptr u8) copy)
        (mut valid) (!= (primitive/cast i64 copy) 0)
        (mut result) (ui/affine-identity)]
    (do
      (while (and (load valid) (!= (load (load cursor)) (primitive/cast u8 0)))
        (do
          (number-skip! (mut cursor))
          (let [(mut operation) (ui/affine-identity)]
            (cond
              (prefix-at? (load cursor) c"translate(")
                (do
                  (store! cursor (primitive/index (load cursor) 10))
                  (let [x (number-read! (mut cursor) (mut valid))]
                    (do
                      (number-skip! (mut cursor))
                      (let [y (if (= (load (load cursor)) (primitive/cast u8 41))
                                  0.0
                                  (number-read! (mut cursor) (mut valid)))]
                        (store! operation (ui/affine-translate x y))))))
              (prefix-at? (load cursor) c"scale(")
                (do
                  (store! cursor (primitive/index (load cursor) 6))
                  (let [x (number-read! (mut cursor) (mut valid))]
                    (do
                      (number-skip! (mut cursor))
                      (let [y (if (= (load (load cursor)) (primitive/cast u8 41))
                                  x
                                  (number-read! (mut cursor) (mut valid)))]
                        (store! operation (ui/affine-scale x y))))))
              (prefix-at? (load cursor) c"rotate(")
                (do
                  (store! cursor (primitive/index (load cursor) 7))
                  (store! operation
                          (ui/affine-rotate (number-read! (mut cursor) (mut valid)))))
              (prefix-at? (load cursor) c"matrix(")
                (do
                  (store! cursor (primitive/index (load cursor) 7))
                  (let [a (number-read! (mut cursor) (mut valid))
                        b (number-read! (mut cursor) (mut valid))
                        c (number-read! (mut cursor) (mut valid))
                        d (number-read! (mut cursor) (mut valid))
                        e (number-read! (mut cursor) (mut valid))
                        f (number-read! (mut cursor) (mut valid))]
                    (store! operation (ui/Affine :m11 a :m12 b :m21 c :m22 d :tx e :ty f))))
              :else (store! valid false))
            (number-skip! (mut cursor))
            (if (= (load (load cursor)) (primitive/cast u8 41))
                (store! cursor (primitive/index (load cursor) 1))
                (store! valid false))
            (store! result (ui/affine-multiply (load result) (load operation))))))
      (if (!= (primitive/cast i64 copy) 0) (do (free copy) 0) 0)
      (if (load valid) (load result) (ui/Affine :m11 0.0 :m12 0.0 :m21 0.0 :m22 0.0 :tx 0.0 :ty 0.0)))))

(defn default-style [] (-> SvgStyle)
  (SvgStyle :fill (ui/rgb 0.0 0.0 0.0)
            :fill-opacity 1.0
            :fill-rule (svg/FillRuleNonzero)
            :fill-enabled true
            :stroke (ui/rgb 0.0 0.0 0.0)
            :stroke-opacity 1.0
            :stroke-width 1.0
            :stroke-enabled false
            :stroke-cap (path/ButtCap)
            :stroke-join (path/MiterJoin)
            :stroke-miter-limit 4.0
            :transform (ui/affine-identity)))

(defn parse-unit-number [(value XmlSlice)] (-> f32)
  (let [copy (slice-copy value)
        (mut cursor) (primitive/cast (ptr u8) copy)
        (mut valid) (!= (primitive/cast i64 copy) 0)
        number (number-read! (mut cursor) (mut valid))]
    (do
      (number-skip! (mut cursor))
      (if (not (= (load (load cursor)) (primitive/cast u8 0))) (store! valid false) 0)
      (if (!= (primitive/cast i64 copy) 0) (do (free copy) 0) 0)
      (if (and (load valid) (>= number 0.0))
          (if (> number 1.0) 1.0 number)
          -1.0))))

(defn parse-positive-number [(value XmlSlice)] (-> f32)
  (let [copy (slice-copy value)
        (mut cursor) (primitive/cast (ptr u8) copy)
        (mut valid) (!= (primitive/cast i64 copy) 0)
        number (number-read! (mut cursor) (mut valid))]
    (do
      (number-skip! (mut cursor))
      (if (not (= (load (load cursor)) (primitive/cast u8 0))) (store! valid false) 0)
      (if (!= (primitive/cast i64 copy) 0) (do (free copy) 0) 0)
      (if (and (load valid) (> number 0.0)) number -1.0))))

(defn parse-number-value [(value XmlSlice) (valid (mut bool))] (-> f32)
  (let [copy (slice-copy value)
        (mut cursor) (primitive/cast (ptr u8) copy)
        (mut parsed-valid) (!= (primitive/cast i64 copy) 0)
        number (number-read! (mut cursor) (mut parsed-valid))]
    (do
      (number-skip! (mut cursor))
      (if (not (= (load (load cursor)) (primitive/cast u8 0)))
          (store! parsed-valid false)
          0)
      (if (not (load parsed-valid)) (store! valid false) 0)
      (if (!= (primitive/cast i64 copy) 0) (do (free copy) 0) 0)
      number)))

(defn parse-stroke-color! [(style (mut SvgStyle)) (value XmlSlice)] (-> bool)
  (let [(mut parsed) (primitive/zeroed SvgStyle)]
    (do
      (store! parsed (default-style))
      (if (< (parse-color! (mut parsed) value) 0)
          false
          (do
            (set! (.stroke style) (load (field parsed fill)))
            (set! (.stroke-enabled style) (load (field parsed fill-enabled)))
            true)))))

(defn trim-slice [(value XmlSlice)] (-> XmlSlice)
  (let [(mut start) (load (field value start))
        (mut length) (load (field value length))]
    (do
      (while (and (> (load length) 0) (xml-space? (load (load start))))
        (do (store! start (primitive/index (load start) 1))
            (store! length (- (load length) 1))))
      (while (and (> (load length) 0)
                  (xml-space? (byte-at (load start) (- (load length) 1))))
        (store! length (- (load length) 1)))
      (XmlSlice :start (load start) :length (load length)))))

(defn apply-attribute! [(style (mut SvgStyle)) (name XmlSlice) (value XmlSlice)] (-> bool)
  (cond
    (slice-equals? name c"fill") (>= (parse-color! (mut style) value) 0)
    (slice-equals? name c"fill-rule")
      (cond
        (slice-equals? value c"nonzero") (do (set! (.fill-rule style) (svg/FillRuleNonzero)) true)
        (slice-equals? value c"evenodd") (do (set! (.fill-rule style) (svg/FillRuleEvenodd)) true)
        :else false)
    (slice-equals? name c"fill-opacity")
      (let [opacity (parse-unit-number value)]
        (if (< opacity 0.0) false (do (set! (.fill-opacity style) opacity) true)))
    (slice-equals? name c"stroke") (parse-stroke-color! (mut style) value)
    (slice-equals? name c"stroke-opacity")
      (let [opacity (parse-unit-number value)]
        (if (< opacity 0.0) false (do (set! (.stroke-opacity style) opacity) true)))
    (slice-equals? name c"stroke-width")
      (let [width (parse-positive-number value)]
        (if (< width 0.0) false (do (set! (.stroke-width style) width) true)))
    (slice-equals? name c"stroke-miterlimit")
      (let [limit (parse-positive-number value)]
        (if (< limit 1.0) false (do (set! (.stroke-miter-limit style) limit) true)))
    (slice-equals? name c"stroke-linecap")
      (cond
        (slice-equals? value c"butt") (do (set! (.stroke-cap style) (path/ButtCap)) true)
        (slice-equals? value c"square") (do (set! (.stroke-cap style) (path/SquareCap)) true)
        (slice-equals? value c"round") (do (set! (.stroke-cap style) (path/RoundCap)) true)
        :else false)
    (slice-equals? name c"stroke-linejoin")
      (cond
        (slice-equals? value c"miter") (do (set! (.stroke-join style) (path/MiterJoin)) true)
        (slice-equals? value c"bevel") (do (set! (.stroke-join style) (path/BevelJoin)) true)
        (slice-equals? value c"round") (do (set! (.stroke-join style) (path/RoundJoin)) true)
        :else false)
    (slice-equals? name c"transform")
      (let [transform (parse-transform value)]
        (if (ui/affine-invertible? transform)
            (do
              (set! (.transform style)
                    (ui/affine-multiply (load (field style transform)) transform))
              true)
            false))
    (slice-equals? name c"style")
      (let [(mut offset) (primitive/cast i64 0)
            length (load (field value length))
            start (load (field value start))
            (mut valid) true]
        (do
          (while (and (load valid) (< (load offset) length))
            (let [declaration-start (load offset) (mut colon) (primitive/cast i64 -1)]
              (do
                (while (and (< (load offset) length)
                            (!= (byte-at start (load offset)) (primitive/cast u8 59)))
                  (do
                    (if (= (byte-at start (load offset)) (primitive/cast u8 58))
                        (if (= (load colon) -1) (store! colon (load offset)) 0)
                        0)
                    (store! offset (+ (load offset) 1))))
                (if (> (load offset) declaration-start)
                    (if (> (load colon) declaration-start)
                        (let [property (trim-slice
                                         (XmlSlice :start (primitive/index start declaration-start)
                                                   :length (- (load colon) declaration-start)))
                              property-value (trim-slice
                                               (XmlSlice
                                                 :start (primitive/index start (+ (load colon) 1))
                                                 :length (- (load offset) (+ (load colon) 1))))]
                          (if (or (slice-equals? property c"fill")
                                  (or (slice-equals? property c"fill-rule")
                                      (or (slice-equals? property c"fill-opacity")
                                          (or (slice-equals? property c"stroke")
                                              (or (slice-equals? property c"stroke-opacity")
                                                  (or (slice-equals? property c"stroke-width")
                                                      (or (slice-equals? property c"stroke-miterlimit")
                                                          (or (slice-equals? property c"stroke-linecap")
                                                              (slice-equals? property c"stroke-linejoin")))))))))
                              (if (not (apply-attribute! (mut style) property property-value))
                                  (store! valid false)
                                  0)
                              0))
                        (store! valid false))
                    0)
                (if (< (load offset) length) (store! offset (+ (load offset) 1)) 0))))
          (load valid)))
    :else true))

(defn parse-view-box [(value XmlSlice)] (-> path/PathBounds)
  (let [copy (slice-copy value)
        (mut cursor) (primitive/cast (ptr u8) copy)
        (mut valid) (!= (primitive/cast i64 copy) 0)
        x (number-read! (mut cursor) (mut valid))
        y (number-read! (mut cursor) (mut valid))
        width (number-read! (mut cursor) (mut valid))
        height (number-read! (mut cursor) (mut valid))]
    (do
      (number-skip! (mut cursor))
      (if (!= (primitive/cast i64 copy) 0) (do (free copy) 0) 0)
      (path/PathBounds :x x :y y :w width :h height
                       :valid (and (load valid) (and (> width 0.0) (> height 0.0)))))))

(defn svg-document-empty [] (-> SvgDocument)
  (SvgDocument :shapes (al/al-new [SvgDocumentShape] (alloc/malloc-allocator))
               :bounds (path/PathBounds :x 0.0 :y 0.0 :w 0.0 :h 0.0 :valid false)
               :valid false))

(defn svg-document-valid? [(document SvgDocument)] (-> bool)
  (load (field document valid)))

(defn svg-document-shape-count [(document SvgDocument)] (-> i64)
  (al/al-len [SvgDocumentShape] (load (field document shapes))))

(defn extend-document-bounds! [(document (mut SvgDocument))
                               (bounds path/PathBounds)
                               (transform ui/Affine)] (-> i64)
  (let [rect (ui/affine-transform-bounds
               transform
               (ui/rect (load (field bounds x)) (load (field bounds y))
                        (load (field bounds w)) (load (field bounds h))))]
    (if (load (field (field document bounds) valid))
        (let [old (load (field document bounds))
              x0 (if (< (load (field rect x)) (load (field old x)))
                     (load (field rect x)) (load (field old x)))
              y0 (if (< (load (field rect y)) (load (field old y)))
                     (load (field rect y)) (load (field old y)))
              x1 (if (> (+ (load (field rect x)) (load (field rect w)))
                         (+ (load (field old x)) (load (field old w))))
                     (+ (load (field rect x)) (load (field rect w)))
                     (+ (load (field old x)) (load (field old w))))
              y1 (if (> (+ (load (field rect y)) (load (field rect h)))
                         (+ (load (field old y)) (load (field old h))))
                     (+ (load (field rect y)) (load (field rect h)))
                     (+ (load (field old y)) (load (field old h))))]
          (set! (.bounds document)
                (path/PathBounds :x x0 :y y0 :w (- x1 x0) :h (- y1 y0) :valid true)))
        (set! (.bounds document)
              (path/PathBounds :x (load (field rect x)) :y (load (field rect y))
                               :w (load (field rect w)) :h (load (field rect h))
                               :valid true)))))

(defn svg-document-free! [(document (mut SvgDocument))] (-> i64)
  (do
    (let [shapes (load (field document shapes))]
      (for [i 0 (al/al-len [SvgDocumentShape] shapes)]
        (svg/svg-vector-free! (mut (field (primitive/index (load (field shapes data)) i) vector)))))
    (al/al-free! [SvgDocumentShape] (mut (.shapes document)))
    (set! (.valid document) false)
    0))

(defn style-fill-color [(style SvgStyle)] (-> ui/Color)
  (ui/rgba (load (field (field style fill) r))
           (load (field (field style fill) g))
           (load (field (field style fill) b))
           (* (load (field (field style fill) a)) (load (field style fill-opacity)))))

(defn style-stroke-color [(style SvgStyle)] (-> ui/Color)
  (ui/rgba (load (field (field style stroke) r))
           (load (field (field style stroke) g))
           (load (field (field style stroke) b))
           (* (load (field (field style stroke) a)) (load (field style stroke-opacity)))))

(defn append-painted-vector! [(document (mut SvgDocument))
                              (vector svg/SvgVector)
                              (color ui/Color)
                              (transform ui/Affine)] (-> i64)
  (do
    (al/al-push! [SvgDocumentShape]
                 (mut (.shapes document))
                 (SvgDocumentShape :vector vector :fill color :transform transform))
    (extend-document-bounds! (mut document) (load (field vector bounds)) transform)))

(defn document-add-path-data! [(document (mut SvgDocument))
                               (source (ptr i8))
                               (style SvgStyle)
                               (tolerance f32)] (-> bool)
  (let [(mut valid) true]
    (do
      (if (load (field style fill-enabled))
          (let [(mut vector) (svg/svg-vector-new-with-fill-rule
                               source tolerance (load (field style fill-rule)))]
            (if (svg/svg-vector-valid? vector)
                (append-painted-vector! (mut document)
                                        (load vector)
                                        (style-fill-color style)
                                        (load (field style transform)))
                (do (svg/svg-vector-free! (mut vector)) (store! valid false))))
          0)
      (if (and (load valid) (load (field style stroke-enabled)))
          (let [(mut vector) (svg/svg-stroke-vector-new
                               source tolerance
                               (load (field style stroke-width))
                               (load (field style stroke-miter-limit))
                               (load (field style stroke-cap))
                               (load (field style stroke-join)))]
            (if (svg/svg-vector-valid? vector)
                (append-painted-vector! (mut document)
                                        (load vector)
                                        (style-stroke-color style)
                                        (load (field style transform)))
                (do (svg/svg-vector-free! (mut vector)) (store! valid false))))
          0)
      (load valid))))

(defn document-add-path! [(document (mut SvgDocument))
                          (source path/Path)
                          (style SvgStyle)
                          (tolerance f32)] (-> bool)
  (let [(mut valid) true]
    (do
      (if (and (load (field source closed)) (load (field style fill-enabled)))
          (let [(mut vector) (svg/svg-vector-new-from-path source (load (field style fill-rule)))]
            (if (svg/svg-vector-valid? vector)
                (append-painted-vector! (mut document)
                                        (load vector)
                                        (style-fill-color style)
                                        (load (field style transform)))
                (do (svg/svg-vector-free! (mut vector)) (store! valid false))))
          0)
      (if (and (load valid) (load (field style stroke-enabled)))
          (let [(mut vector) (svg/svg-stroke-vector-new-from-path
                               source tolerance
                               (load (field style stroke-width))
                               (load (field style stroke-miter-limit))
                               (load (field style stroke-cap))
                               (load (field style stroke-join)))]
            (if (svg/svg-vector-valid? vector)
                (append-painted-vector! (mut document)
                                        (load vector)
                                        (style-stroke-color style)
                                        (load (field style transform)))
                (do (svg/svg-vector-free! (mut vector)) (store! valid false))))
          0)
      (load valid))))

(defn close-generated-path! [(value (mut path/Path))] (-> i64)
  (let [points (load (field value points)) count (al/al-len [path/PathPoint] points)]
    (do
      (if (> count 1)
          (let [first (al/al-get [path/PathPoint] points 0)
                last (al/al-get [path/PathPoint] points (- count 1))
                dx (- (load (field last x)) (load (field first x)))
                dy (- (load (field last y)) (load (field first y)))]
            (if (< (+ (* dx dx) (* dy dy)) 0.000001)
                (do (al/al-pop! [path/PathPoint] (mut (.points value))) 0)
                0))
          0)
      (path/path-close! (mut value)))))

(defn geometry-path [(kind i32) (geometry SvgGeometry) (tolerance f32)] (-> path/Path)
  (let [(mut result) (path/path-new)]
    (do
      (cond
        (= kind (primitive/cast i32 4))
          (let [x (load (field geometry x)) y (load (field geometry y))
                width (load (field geometry width)) height (load (field geometry height))
                raw-rx (if (load (field geometry have-rx))
                           (load (field geometry rx)) (load (field geometry ry)))
                raw-ry (if (load (field geometry have-ry))
                           (load (field geometry ry)) (load (field geometry rx)))
                rx (if (> raw-rx (* width 0.5)) (* width 0.5) raw-rx)
                ry (if (> raw-ry (* height 0.5)) (* height 0.5) raw-ry)]
            (if (and (> width 0.0) (> height 0.0))
                (if (and (> rx 0.0) (> ry 0.0))
                    (do
                      (path/path-move-to! (mut result) (+ x rx) y)
                      (path/path-line-to! (mut result) (+ x (- width rx)) y)
                      (path/path-svg-arc-to! (mut result) rx ry 0.0 false true
                                             (+ x width) (+ y ry) tolerance)
                      (path/path-line-to! (mut result) (+ x width) (+ y (- height ry)))
                      (path/path-svg-arc-to! (mut result) rx ry 0.0 false true
                                             (+ x (- width rx)) (+ y height) tolerance)
                      (path/path-line-to! (mut result) (+ x rx) (+ y height))
                      (path/path-svg-arc-to! (mut result) rx ry 0.0 false true
                                             x (+ y (- height ry)) tolerance)
                      (path/path-line-to! (mut result) x (+ y ry))
                      (path/path-svg-arc-to! (mut result) rx ry 0.0 false true
                                             (+ x rx) y tolerance)
                      (close-generated-path! (mut result)))
                    (do
                      (path/path-move-to! (mut result) x y)
                      (path/path-line-to! (mut result) (+ x width) y)
                      (path/path-line-to! (mut result) (+ x width) (+ y height))
                      (path/path-line-to! (mut result) x (+ y height))
                      (close-generated-path! (mut result))))
                0))
        (= kind (primitive/cast i32 5))
          (if (> (load (field geometry r)) 0.0)
              (do
                (path/path-arc! (mut result)
                                (load (field geometry cx)) (load (field geometry cy))
                                (load (field geometry r)) (load (field geometry r))
                                0.0 360.0 tolerance)
                (close-generated-path! (mut result)))
              0)
        (= kind (primitive/cast i32 6))
          (if (and (> (load (field geometry rx)) 0.0) (> (load (field geometry ry)) 0.0))
              (do
                (path/path-arc! (mut result)
                                (load (field geometry cx)) (load (field geometry cy))
                                (load (field geometry rx)) (load (field geometry ry))
                                0.0 360.0 tolerance)
                (close-generated-path! (mut result)))
              0)
        (= kind (primitive/cast i32 7))
          (do
            (path/path-move-to! (mut result) (load (field geometry x1)) (load (field geometry y1)))
            (path/path-line-to! (mut result) (load (field geometry x2)) (load (field geometry y2))))
        :else
          (let [copy (load (field geometry points))
                (mut cursor) (primitive/cast (ptr u8) copy)
                (mut valid) (!= (primitive/cast i64 copy) 0)
                (mut first) true]
            (do
              (number-skip! (mut cursor))
              (while (and (load valid) (!= (load (load cursor)) (primitive/cast u8 0)))
                (let [x (number-read! (mut cursor) (mut valid))
                      y (number-read! (mut cursor) (mut valid))]
                  (do
                    (if (load first)
                        (do (path/path-move-to! (mut result) x y) (store! first false))
                        (path/path-line-to! (mut result) x y))
                    (number-skip! (mut cursor)))))
              (if (and (load valid) (= kind (primitive/cast i32 8)))
                  (close-generated-path! (mut result))
                  0))))
      (load result))))

(defn element-kind [(name XmlSlice)] (-> i32)
  (cond
    (slice-equals? name c"svg") (primitive/cast i32 1)
    (slice-equals? name c"g") (primitive/cast i32 2)
    (slice-equals? name c"path") (primitive/cast i32 3)
    (slice-equals? name c"rect") (primitive/cast i32 4)
    (slice-equals? name c"circle") (primitive/cast i32 5)
    (slice-equals? name c"ellipse") (primitive/cast i32 6)
    (slice-equals? name c"line") (primitive/cast i32 7)
    (slice-equals? name c"polygon") (primitive/cast i32 8)
    (slice-equals? name c"polyline") (primitive/cast i32 9)
    :else (primitive/cast i32 0)))

(defn geometry-attribute? [(name XmlSlice)] (-> bool)
  (or (slice-equals? name c"x")
      (or (slice-equals? name c"y")
          (or (slice-equals? name c"width")
              (or (slice-equals? name c"height")
                  (or (slice-equals? name c"rx")
                      (or (slice-equals? name c"ry")
                          (or (slice-equals? name c"cx")
                              (or (slice-equals? name c"cy")
                                  (or (slice-equals? name c"r")
                                      (or (slice-equals? name c"x1")
                                          (or (slice-equals? name c"y1")
                                              (or (slice-equals? name c"x2")
                                                  (or (slice-equals? name c"y2")
                                                      (slice-equals? name c"points")))))))))))))))

(defn apply-geometry-attribute! [(geometry (mut SvgGeometry))
                                 (name XmlSlice)
                                 (value XmlSlice)
                                 (valid (mut bool))] (-> i64)
  (cond
    (slice-equals? name c"x")
      (set! (.x geometry) (parse-number-value value (mut valid)))
    (slice-equals? name c"y")
      (set! (.y geometry) (parse-number-value value (mut valid)))
    (slice-equals? name c"width")
      (set! (.width geometry) (parse-number-value value (mut valid)))
    (slice-equals? name c"height")
      (set! (.height geometry) (parse-number-value value (mut valid)))
    (slice-equals? name c"rx")
      (do
        (set! (.rx geometry) (parse-number-value value (mut valid)))
        (set! (.have-rx geometry) true))
    (slice-equals? name c"ry")
      (do
        (set! (.ry geometry) (parse-number-value value (mut valid)))
        (set! (.have-ry geometry) true))
    (slice-equals? name c"cx")
      (set! (.cx geometry) (parse-number-value value (mut valid)))
    (slice-equals? name c"cy")
      (set! (.cy geometry) (parse-number-value value (mut valid)))
    (slice-equals? name c"r")
      (set! (.r geometry) (parse-number-value value (mut valid)))
    (slice-equals? name c"x1")
      (set! (.x1 geometry) (parse-number-value value (mut valid)))
    (slice-equals? name c"y1")
      (set! (.y1 geometry) (parse-number-value value (mut valid)))
    (slice-equals? name c"x2")
      (set! (.x2 geometry) (parse-number-value value (mut valid)))
    (slice-equals? name c"y2")
      (set! (.y2 geometry) (parse-number-value value (mut valid)))
    (slice-equals? name c"points")
      (if (= (primitive/cast i64 (load (field geometry points))) 0)
          (let [copy (slice-copy value)]
            (do
              (set! (.points geometry) copy)
              (if (= (primitive/cast i64 copy) 0) (store! valid false) 0)))
          (store! valid false))
    :else 0))

;;; Parse the structural SVG subset used by UI assets: nested svg/g containers
;;; and path elements with inherited fill, fill-rule, and affine transforms.
(defn svg-document-new [(source (ptr i8)) (tolerance f32)] (-> SvgDocument)
  (let [(mut document) (svg-document-empty)
        (mut reader) (primitive/zeroed XmlReader)
        (mut styles) (al/al-new [SvgStyle] (alloc/malloc-allocator))
        (mut tags) (al/al-new [i32] (alloc/malloc-allocator))
        (mut declared-bounds) (primitive/zeroed path/PathBounds)]
    (do
      (store! reader (XmlReader :cursor (primitive/cast (ptr u8) source) :valid true))
      (al/al-push! [SvgStyle] (mut styles) (default-style))
      (while (and (load (field reader valid))
                  (!= (reader-byte (load reader)) (primitive/cast u8 0)))
        (cond
          (prefix-at? (load (field reader cursor)) c"<?")
            (skip-processing-instruction! (mut reader))
          (prefix-at? (load (field reader cursor)) c"<!")
            (skip-declaration! (mut reader))
          (!= (reader-byte (load reader)) (primitive/cast u8 60))
            (reader-advance! (mut reader))
          :else
            (do
              (reader-advance! (mut reader))
              (if (= (reader-byte (load reader)) (primitive/cast u8 47))
                  (do
                    (reader-advance! (mut reader))
                    (let [name (read-name! (mut reader))]
                      (do
                        (skip-space! (mut reader))
                        (if (!= (reader-byte (load reader)) (primitive/cast u8 62))
                            (set! (.valid reader) false)
                            (reader-advance! (mut reader)))
                        (if (> (al/al-len [i32] (load tags)) 0)
                            (let [expected (al/al-get [i32] (load tags)
                                                      (- (al/al-len [i32] (load tags)) 1))
                                  actual (element-kind name)]
                              (if (= expected actual)
                                  (do
                                    (al/al-pop! [i32] (mut tags))
                                    (al/al-pop! [SvgStyle] (mut styles))
                                    0)
                                  (set! (.valid reader) false)))
                            (set! (.valid reader) false)))))
                  (let [name (read-name! (mut reader))
                        kind (element-kind name)
                        parent (al/al-get [SvgStyle] (load styles)
                                          (- (al/al-len [SvgStyle] (load styles)) 1))
                        (mut style) (primitive/zeroed SvgStyle)
                        (mut geometry) (primitive/zeroed SvgGeometry)
                        (mut geometry-valid) true
                        (mut path-data) (primitive/cast (ptr i8) 0)
                        (mut self-closing) false]
                    (do
                      (store! style parent)
                      (if (= kind 0) (set! (.valid reader) false) 0)
                      (while (and (load (field reader valid))
                                  (not (or (= (reader-byte (load reader)) (primitive/cast u8 62))
                                           (= (reader-byte (load reader)) (primitive/cast u8 47)))))
                        (do
                          (skip-space! (mut reader))
                          (if (or (= (reader-byte (load reader)) (primitive/cast u8 62))
                                  (= (reader-byte (load reader)) (primitive/cast u8 47)))
                              0
                              (let [attribute-name (read-name! (mut reader))
                                    attribute-value (read-value! (mut reader))]
                                (if (and (= kind 3) (slice-equals? attribute-name c"d"))
                                    (store! path-data (slice-copy attribute-value))
                                    (if (and (>= kind (primitive/cast i32 4))
                                             (geometry-attribute? attribute-name))
                                        (do
                                          (apply-geometry-attribute! (mut geometry)
                                                                     attribute-name
                                                                     attribute-value
                                                                     (mut geometry-valid))
                                          (if (not (load geometry-valid))
                                              (set! (.valid reader) false)
                                              0))
                                        (if (and (= kind (primitive/cast i32 1))
                                                 (slice-equals? attribute-name c"viewBox"))
                                            (do
                                              (store! declared-bounds (parse-view-box attribute-value))
                                              (if (not (load (field declared-bounds valid)))
                                                  (set! (.valid reader) false)
                                                  0))
                                            (if (not (apply-attribute! (mut style)
                                                                       attribute-name
                                                                       attribute-value))
                                                (set! (.valid reader) false)
                                                0))))))))
                      (skip-space! (mut reader))
                      (if (= (reader-byte (load reader)) (primitive/cast u8 47))
                          (do (store! self-closing true) (reader-advance! (mut reader))) 0)
                      (if (= (reader-byte (load reader)) (primitive/cast u8 62))
                          (reader-advance! (mut reader))
                          (set! (.valid reader) false))
                      (if (= kind (primitive/cast i32 3))
                          (if (!= (primitive/cast i64 (load path-data)) 0)
                              (if (not (document-add-path-data! (mut document)
                                                                 (load path-data)
                                                                 (load style)
                                                                 tolerance))
                                  (set! (.valid reader) false)
                                  0)
                              (set! (.valid reader) false))
                          0)
                      (if (and (>= kind (primitive/cast i32 4))
                               (<= kind (primitive/cast i32 9)))
                          (let [(mut generated) (geometry-path kind (load geometry) tolerance)
                                count (path/path-point-count (load generated))
                                minimum (if (= kind (primitive/cast i32 7))
                                            (primitive/cast i64 2)
                                            (if (= kind (primitive/cast i32 9))
                                                (primitive/cast i64 2)
                                                (primitive/cast i64 3)))]
                            (do
                              (if (or (< count minimum)
                                      (not (document-add-path! (mut document)
                                                               (load generated)
                                                               (load style)
                                                               tolerance)))
                                  (set! (.valid reader) false)
                                  0)
                              (path/path-free! (mut generated))))
                          0)
                      (if (not (load self-closing))
                          (do
                            (al/al-push! [SvgStyle] (mut styles) (load style))
                            (al/al-push! [i32] (mut tags) kind))
                          0)
                      (if (!= (primitive/cast i64 (load path-data)) 0)
                          (do (free (load path-data)) 0)
                          0)
                      (if (!= (primitive/cast i64 (load (field geometry points))) 0)
                          (do (free (load (field geometry points))) 0)
                          0)))))))
      (if (or (not (load (field reader valid)))
              (or (!= (al/al-len [i32] (load tags)) 0)
                  (= (svg-document-shape-count (load document)) 0)))
          (svg-document-free! (mut document))
          (do
            (if (load (field declared-bounds valid))
                (set! (.bounds document) (load declared-bounds))
                0)
            (set! (.valid document) true)))
      (al/al-free! [i32] (mut tags))
      (al/al-free! [SvgStyle] (mut styles))
      (load document))))

(defn svg-document-paint! [(scene (mut ui/Scene))
                           (document SvgDocument)
                           (bounds ui/Rect)
                           (id i32)] (-> i64)
  (if (or (not (load (field document valid)))
          (or (<= (load (field bounds w)) 0.0) (<= (load (field bounds h)) 0.0)))
      0
      (let [source (load (field document bounds))
            scale-x (/ (load (field bounds w)) (load (field source w)))
            scale-y (/ (load (field bounds h)) (load (field source h)))
            scale (if (< scale-x scale-y) scale-x scale-y)
            width (* (load (field source w)) scale)
            height (* (load (field source h)) scale)
            fit (ui/Affine
                  :m11 scale :m12 0.0 :m21 0.0 :m22 scale
                  :tx (- (+ (load (field bounds x)) (* (- (load (field bounds w)) width) 0.5))
                         (* (load (field source x)) scale))
                  :ty (- (+ (load (field bounds y)) (* (- (load (field bounds h)) height) 0.5))
                         (* (load (field source y)) scale)))
            fit-prior (ui/scene-push-transform! (mut scene) fit)
            shapes (load (field document shapes))
            (mut draws) (primitive/cast i64 0)]
        (do
          (for [i 0 (al/al-len [SvgDocumentShape] shapes)]
            (let [shape (al/al-get [SvgDocumentShape] shapes i)
                  prior (ui/scene-push-transform! (mut scene) (load (field shape transform)))]
              (do
                (store! draws
                        (+ (load draws)
                           (svg/svg-vector-paint-local! (mut scene)
                                                       (load (field shape vector))
                                                       (load (field shape fill))
                                                       (primitive/cast i32
                                                         (+ (primitive/cast i64 id) i)))))
                (ui/scene-pop-transform! (mut scene) prior))))
          (ui/scene-pop-transform! (mut scene) fit-prior)
          (load draws)))))
