(module experiments.coil_gpui.ui-test)
(import "experiments.coil_gpui.ui" :use *)
(import "coil.arraylist" :as al)
(import "coil.primitive" :as primitive)
(import "experiments.coil_gpui.metal" :as metal)
(import "experiments.coil_gpui.layout" :as layout)
(import "experiments.coil_gpui.grid" :as grid)
(import "experiments.coil_gpui.input" :as input)
(import "experiments.coil_gpui.scroll" :as scroll)
(import "experiments.coil_gpui.variable_scroll" :as variable)
(import "experiments.coil_gpui.text" :as text)
(import "experiments.coil_gpui.path" :as path)

(deftest metal-buffer-capacity-grows-by-powers-of-two
         (assert-eq (metal/next-buffer-capacity 0 1) 65536)
         (assert-eq (metal/next-buffer-capacity 65536 65536) 65536)
         (assert-eq (metal/next-buffer-capacity 65536 65537) 131072)
         (assert-eq (metal/next-buffer-capacity 131072 1000000) 1048576))

(deftest metal-instance-abi-is-stable
         ;; Must match Metal exactly: original 80-byte payload + six-float affine.
         (assert-eq (primitive/sizeof Primitive) 104))

(deftest metal-text-sprite-abi-is-stable
         ;; bounds + color + clip + UV + affine + retained texture pointer + id/mode.
         (assert-eq (primitive/sizeof TextSprite) 104))

(deftest metal-path-abis-are-stable
         (assert-eq (primitive/sizeof path/PathPoint) 8)
         (assert-eq (primitive/sizeof PathDraw) 80)
         (assert-eq (primitive/sizeof PaintCommand) 8))

(deftest paths-preserve-paint-order-and-scene-ownership
         (let [(mut polygon) (path/path-new)
               (mut scene) (scene-new)]
           (path/path-move-to! (mut polygon) 0.0 0.0)
           (path/path-line-to! (mut polygon) 40.0 0.0)
           (path/path-line-to! (mut polygon) 20.0 30.0)
           (path/path-close! (mut polygon))
           (let [(mut tessellation) (path/path-tessellate polygon)]
             (scene-rect! (mut scene) (rect 0.0 0.0 10.0 10.0) (rgb 1.0 0.0 0.0) 1)
             (scene-path-fill! (mut scene) tessellation (rgb 0.0 1.0 0.0) 2)
             (scene-linear-gradient! (mut scene)
                                     (rect 0.0 0.0 10.0 10.0)
                                     (rgb 0.0 0.0 0.0)
                                     (rgb 1.0 1.0 1.0)
                                     90.0
                                     0.0
                                     3)
             (assert-eq (al/al-len [path/PathPoint] (load (field scene path-vertices))) 3)
             (assert-eq (al/al-len [PathDraw] (load (field scene path-draws))) 1)
             (let [commands (load (field scene paint-commands))]
               (assert-eq (al/al-len [PaintCommand] commands) 3)
               (let [first (al/al-get [PaintCommand] commands 0)
                     second (al/al-get [PaintCommand] commands 1)
                     third (al/al-get [PaintCommand] commands 2)]
                 (assert-eq (load (field first kind)) 0)
                 (assert-eq (load (field second kind)) 1)
                 (assert-eq (load (field third kind)) 0))
               (assert-eq (metal/paint-run-end commands 0 3) 1))
             (path/tessellation-free! (mut tessellation)))
           (path/path-free! (mut polygon))
           (scene-free! (mut scene))))

(deftest text-atlas-shelf-allocation-wraps-and-fails-atomically
         (let [(mut atlas) (primitive/zeroed text/TextAtlas)]
           (store! atlas
                   (text/TextAtlas
                     :texture (primitive/cast (ptr i8) 0)
                     :width 64
                     :height 40
                     :cursor-x 2
                     :cursor-y 2
                     :row-height 0
                     :padding 2
                     :scale 1.0))
           (let [first (text/text-atlas-reserve! (mut atlas) 20 10)
                 second (text/text-atlas-reserve! (mut atlas) 20 12)
                 third (text/text-atlas-reserve! (mut atlas) 20 8)]
             (assert (load (field first valid)))
             (assert-eq (load (field first x)) 2)
             (assert-eq (load (field second x)) 24)
             (assert-eq (load (field third x)) 2)
             (assert-eq (load (field third y)) 16)
             (let [prior-x (load (field atlas cursor-x))
                   prior-y (load (field atlas cursor-y))
                   failed (text/text-atlas-reserve! (mut atlas) 80 8)]
               (assert (not (load (field failed valid))))
               (assert-eq (load (field atlas cursor-x)) prior-x)
               (assert-eq (load (field atlas cursor-y)) prior-y)))))

(deftest atlas-uv-regions-survive-scene-recording
         (let [(mut scene) (scene-new)]
           (scene-texture-region! (mut scene)
                                  (rect 4.0 8.0 100.0 20.0)
                                  (rgb 1.0 1.0 1.0)
                                  (rect 0.25 0.125 0.5 0.25)
                                  (primitive/cast (ptr i8) 500)
                                  55)
           (let [sprite (al/al-get [TextSprite] (load (field scene text)) 0)
                 uv (load (field sprite uv))]
             (assert (and (> (load (field uv x)) 0.249)
                          (< (load (field uv x)) 0.251)
                          (> (load (field uv w)) 0.499)
                          (< (load (field uv w)) 0.501))))
           (scene-free! (mut scene))))

(deftest affine-composition-inverse-and-transformed-hit-testing
         (let [transform
                 (affine-multiply (affine-translate 100.0 50.0)
                                  (affine-multiply (affine-rotate 90.0)
                                                   (affine-scale 2.0 1.5)))
               point (Point :x 3.0 :y 4.0)
               screen (affine-transform-point transform point)
               round-trip (affine-transform-point (affine-inverse transform) screen)]
           (assert (and (> (load (field round-trip x)) 2.999)
                        (< (load (field round-trip x)) 3.001)
                        (> (load (field round-trip y)) 3.999)
                        (< (load (field round-trip y)) 4.001)))
           (let [(mut scene) (scene-new)
                 prior (scene-push-transform! (mut scene) transform)]
             (scene-hitbox! (mut scene) (rect 0.0 0.0 20.0 10.0) 700 -1 true true)
             (scene-rounded-rect! (mut scene)
                                  (rect 0.0 0.0 20.0 10.0)
                                  (rgb 1.0 0.0 0.0)
                                  3.0
                                  0.0
                                  (rgba 0.0 0.0 0.0 0.0)
                                  700)
             (let [inside (affine-transform-point transform (Point :x 10.0 :y 5.0))
                   outside (affine-transform-point transform (Point :x 25.0 :y 5.0))
                   primitive (al/al-get [Primitive] (load (field scene items)) 0)]
               (assert-eq (topmost-hit scene (load (field inside x)) (load (field inside y))) 700)
               (assert-eq (topmost-hit scene (load (field outside x)) (load (field outside y))) -1)
               (assert (hit-test primitive (load (field inside x)) (load (field inside y)))))
             (scene-pop-transform! (mut scene) prior)
             (scene-free! (mut scene)))))

(deftest singular-transforms-never-produce-interactive-hitboxes
         (let [(mut scene) (scene-new)
               prior (scene-push-transform! (mut scene) (affine-scale 0.0 1.0))]
           (scene-hitbox! (mut scene) (rect 0.0 0.0 100.0 100.0) 701 -1 true true)
           (assert-eq (topmost-hit scene 0.0 50.0) -1)
           (scene-pop-transform! (mut scene) prior)
           (scene-free! (mut scene))))

(deftest image-sprites-select-polychrome-pipeline-and-preserve-clips
         (let [(mut scene) (scene-new)
               prior (scene-push-clip! (mut scene) (rect 4.0 5.0 40.0 30.0))]
           (scene-image! (mut scene)
                         (rect 0.0 0.0 100.0 80.0)
                         (rgba 1.0 1.0 1.0 0.8)
                         (primitive/cast (ptr i8) 123)
                         88)
           (let [sprite (al/al-get [TextSprite] (load (field scene text)) 0)]
             (assert-eq (load (field sprite mode)) 1)
             (assert (contains? (load (field sprite clip)) 10.0 10.0))
             (assert (not (contains? (load (field sprite clip)) 2.0 2.0))))
           (scene-pop-clip! (mut scene) prior)
           (scene-free! (mut scene))))

(deftest texture-sprite-runs-batch-only-adjacent-compatible-records
         (let [(mut scene) (scene-new)
               texture-a (primitive/cast (ptr i8) 100)
               texture-b (primitive/cast (ptr i8) 200)]
           (scene-texture! (mut scene) (rect 0.0 0.0 10.0 10.0) (rgb 1.0 1.0 1.0) texture-a 1)
           (scene-texture! (mut scene) (rect 10.0 0.0 10.0 10.0) (rgb 1.0 1.0 1.0) texture-a 2)
           (scene-texture! (mut scene) (rect 20.0 0.0 10.0 10.0) (rgb 1.0 1.0 1.0) texture-b 3)
           ;; Same texture but a different pipeline must begin a new run.
           (scene-image! (mut scene) (rect 30.0 0.0 10.0 10.0) (rgb 1.0 1.0 1.0) texture-b 4)
           (scene-image! (mut scene) (rect 40.0 0.0 10.0 10.0) (rgb 1.0 1.0 1.0) texture-b 5)
           (let [sprites (load (field scene text))]
             (assert-eq (metal/sprite-run-end sprites 0 5) 2)
             (assert-eq (metal/sprite-run-end sprites 2 5) 3)
             (assert-eq (metal/sprite-run-end sprites 3 5) 5))
           (scene-free! (mut scene))))

(deftest shadows-are-batched-behind-shapes-and-preserve-clips
         (let [(mut scene) (scene-new)
               prior (scene-push-clip! (mut scene) (rect 10.0 12.0 80.0 60.0))]
           (scene-shadow! (mut scene)
                          (rect 20.0 24.0 40.0 30.0)
                          2.0
                          4.0
                          6.0
                          1.0
                          8.0
                          (rgba 0.0 0.0 0.0 0.5)
                          91)
           (scene-rounded-rect! (mut scene)
                                (rect 20.0 24.0 40.0 30.0)
                                (rgb 1.0 1.0 1.0)
                                8.0
                                0.0
                                (rgba 0.0 0.0 0.0 0.0)
                                91)
           (assert-eq (al/al-len [Primitive] (load (field scene shadows))) 1)
           (assert-eq (al/al-len [Primitive] (load (field scene items))) 1)
           (let [shadow (al/al-get [Primitive] (load (field scene shadows)) 0)
                 bounds (load (field shadow bounds))]
             (assert-eq (load (field shadow kind)) 1)
             (assert (and (> (load (field bounds w)) 77.9)
                          (< (load (field bounds w)) 78.1)))
             (assert (contains? (load (field shadow clip)) 20.0 24.0)))
           (scene-pop-clip! (mut scene) prior)
           (scene-clear! (mut scene))
           (assert-eq (al/al-len [Primitive] (load (field scene shadows))) 0)
           (scene-free! (mut scene))))

(deftest gradients-preserve-scene-order-clips-and-primitive-abi
         (let [(mut scene) (scene-new)
               prior (scene-push-clip! (mut scene) (rect 5.0 6.0 90.0 70.0))]
           (scene-rect! (mut scene) (rect 0.0 0.0 100.0 80.0) (rgb 0.0 0.0 0.0) 1)
           (scene-linear-gradient! (mut scene)
                                   (rect 10.0 12.0 60.0 40.0)
                                   (rgb 1.0 0.0 0.0)
                                   (rgb 0.0 0.0 1.0)
                                   90.0
                                   8.0
                                   2)
           (scene-rect! (mut scene) (rect 20.0 20.0 10.0 10.0) (rgb 1.0 1.0 1.0) 3)
           (assert-eq (al/al-len [Primitive] (load (field scene items))) 3)
           (let [gradient (al/al-get [Primitive] (load (field scene items)) 1)]
             (assert-eq (load (field gradient kind)) 2)
             (assert (and (> (load (field gradient border-width)) 89.9)
                          (< (load (field gradient border-width)) 90.1)))
             (assert (contains? (load (field gradient clip)) 10.0 12.0)))
           (scene-pop-clip! (mut scene) prior)
           (scene-free! (mut scene))))

(deftest geometry-and-insets
         (let [r
                 (inset (rect 10.0 20.0 100.0 80.0)
                        (EdgeInsets
                          :top 2.0
                          :right 3.0
                          :bottom 4.0
                          :left 5.0))]
           (assert (contains? r 15.0 22.0))
           (assert (not (contains? r 14.0 22.0)))
           (assert (contains? r 101.0 95.0))
           (assert (not (contains? r 102.0 96.0)))))

(deftest scene-order-controls-hit-testing
         (let [(mut scene) (scene-new)]
           (scene-rect! (mut scene) (rect 0.0 0.0 100.0 100.0) (rgb 1.0 0.0 0.0) 1)
           (scene-hitbox! (mut scene) (rect 0.0 0.0 100.0 100.0) 1 -1 true true)
           (scene-rect! (mut scene) (rect 25.0 25.0 50.0 50.0) (rgb 0.0 1.0 0.0) 2)
           (scene-hitbox! (mut scene) (rect 25.0 25.0 50.0 50.0) 2 -1 true true)
           (assert-eq (al/al-len [Primitive] (load (field scene items))) 2)
           (assert-eq (topmost-hit scene 30.0 30.0) 2)
           (assert-eq (topmost-hit scene 10.0 10.0) 1)
           (assert-eq (topmost-hit scene 200.0 200.0) -1)
           (scene-free! (mut scene))))

(deftest nested-clips-affect-paint-records-and-hit-testing
         (let [(mut scene) (scene-new)
               prior (scene-push-clip! (mut scene) (rect 20.0 20.0 40.0 40.0))]
           (button! (mut scene)
                    (rect 0.0 0.0 100.0 100.0)
                    (ButtonState
                      :hovered false
                      :pressed false
                      :focused false
                      :disabled false)
                    9)
           (assert-eq (topmost-hit scene 30.0 30.0) 9)
           (assert-eq (topmost-hit scene 10.0 10.0) -1)
           (let [primitive (al/al-get [Primitive] (load (field scene items)) 0)]
             (assert (contains? (load (field primitive clip)) 30.0 30.0))
             (assert (not (contains? (load (field primitive clip)) 10.0 10.0))))
           (scene-pop-clip! (mut scene) prior)
           (scene-free! (mut scene))))

(deftest flex-grow-shrink-align-and-justify
         (let [(mut flex) (primitive/zeroed layout/FlexLayout)]
           (store! flex (layout/flex-new))
           (layout/flex-push! (mut flex) 50.0 20.0 1.0 1.0)
           (layout/flex-push! (mut flex) 50.0 30.0 3.0 1.0)
           (layout/flex-compute! (mut flex)
                                 (rect 0.0 0.0 220.0 60.0)
                                 (Horizontal)
                                 20.0
                                 (EdgeInsets
                                   :top 0.0
                                   :right 0.0
                                   :bottom 0.0
                                   :left 0.0)
                                 (Center)
                                 (Leading))
           (let [a (al/al-get [Rect] (load (field flex rects)) 0)
                 b (al/al-get [Rect] (load (field flex rects)) 1)]
             (assert (and (> (load (field a w)) 74.9) (< (load (field a w)) 75.1)))
             (assert (and (> (load (field b w)) 124.9) (< (load (field b w)) 125.1)))
             (assert (and (> (load (field a y)) 19.9) (< (load (field a y)) 20.1)))
             (assert (and (> (load (field b x)) 94.9) (< (load (field b x)) 95.1))))
           (layout/flex-compute! (mut flex)
                                 (rect 0.0 0.0 80.0 60.0)
                                 (Horizontal)
                                 0.0
                                 (EdgeInsets
                                   :top 0.0
                                   :right 0.0
                                   :bottom 0.0
                                   :left 0.0)
                                 (Stretch)
                                 (Leading))
           (let [a (al/al-get [Rect] (load (field flex rects)) 0)
                 b (al/al-get [Rect] (load (field flex rects)) 1)]
             (assert (and (> (load (field a w)) 39.9) (< (load (field a w)) 40.1)))
             (assert (and (> (load (field b w)) 39.9) (< (load (field b w)) 40.1)))
             (assert (and (> (load (field a h)) 59.9) (< (load (field a h)) 60.1))))
           (layout/flex-free! (mut flex))))

(deftest grid-fraction-tracks-freeze-at-max-and-redistribute
         (let [(mut layout) (primitive/zeroed grid/GridLayout)]
           (store! layout (grid/grid-new))
           (grid/grid-fixed-track! (mut layout) true 50.0)
           (grid/grid-fraction-track! (mut layout) true 20.0 1.0 60.0)
           (grid/grid-fraction-track! (mut layout) true 20.0 2.0 0.0)
           (grid/grid-fixed-track! (mut layout) false 40.0)
           (grid/grid-fraction-track! (mut layout) false 20.0 1.0 0.0)
           (grid/grid-place! (mut layout) 0 0 1 1)
           (grid/grid-place! (mut layout) 1 0 2 1)
           (grid/grid-place! (mut layout) 0 1 3 1)
           (grid/grid-compute! (mut layout)
                               (rect 10.0 20.0 300.0 120.0)
                               10.0
                               8.0
                               (EdgeInsets
                                 :top 0.0
                                 :right 0.0
                                 :bottom 0.0
                                 :left 0.0))
           (let [column0 (al/al-get [grid/GridTrack] (load (field layout columns)) 0)
                 column1 (al/al-get [grid/GridTrack] (load (field layout columns)) 1)
                 column2 (al/al-get [grid/GridTrack] (load (field layout columns)) 2)
                 spanning (grid/grid-rect (load layout) 1)
                 full-row (grid/grid-rect (load layout) 2)]
             (assert (and (> (load (field column0 size)) 49.9)
                          (< (load (field column0 size)) 50.1)))
             (assert (and (> (load (field column1 size)) 59.9)
                          (< (load (field column1 size)) 60.1)))
             (assert (and (> (load (field column2 size)) 169.9)
                          (< (load (field column2 size)) 170.1)))
             (assert (and (> (load (field spanning w)) 239.9)
                          (< (load (field spanning w)) 240.1)))
             (assert (and (> (load (field full-row w)) 299.9)
                          (< (load (field full-row w)) 300.1))))
           (grid/grid-free! (mut layout))))

(deftest grid-invalid-placement-is-empty-and-storage-is-reused
         (let [(mut layout) (primitive/zeroed grid/GridLayout)]
           (store! layout (grid/grid-new))
           (grid/grid-fraction-track! (mut layout) true 10.0 1.0 0.0)
           (grid/grid-fraction-track! (mut layout) false 10.0 1.0 0.0)
           (grid/grid-place! (mut layout) 4 9 1 1)
           (grid/grid-compute! (mut layout)
                               (rect 0.0 0.0 100.0 100.0)
                               0.0
                               0.0
                               (EdgeInsets
                                 :top 0.0
                                 :right 0.0
                                 :bottom 0.0
                                 :left 0.0))
           (let [empty (grid/grid-rect (load layout) 0)
                 capacity (al/al-cap [Rect] (load (field layout rects)))]
             (assert (and (< (load (field empty w)) 0.001)
                          (< (load (field empty h)) 0.001)))
             (grid/grid-compute! (mut layout)
                                 (rect 0.0 0.0 80.0 60.0)
                                 0.0
                                 0.0
                                 (EdgeInsets
                                   :top 0.0
                                   :right 0.0
                                   :bottom 0.0
                                   :left 0.0))
             (assert-eq (al/al-cap [Rect] (load (field layout rects))) capacity))
           (grid/grid-free! (mut layout))))

(deftest concave-paths-tessellate-in-both-windings
         (let [(mut clockwise) (primitive/zeroed path/Path)
               (mut counterclockwise) (primitive/zeroed path/Path)]
           (store! clockwise (path/path-new))
           (path/path-move-to! (mut clockwise) 0.0 0.0)
           (path/path-line-to! (mut clockwise) 40.0 0.0)
           (path/path-line-to! (mut clockwise) 20.0 18.0)
           (path/path-line-to! (mut clockwise) 40.0 40.0)
           (path/path-line-to! (mut clockwise) 0.0 40.0)
           (path/path-close! (mut clockwise))
           (store! counterclockwise (path/path-new))
           (path/path-move-to! (mut counterclockwise) 0.0 40.0)
           (path/path-line-to! (mut counterclockwise) 40.0 40.0)
           (path/path-line-to! (mut counterclockwise) 20.0 18.0)
           (path/path-line-to! (mut counterclockwise) 40.0 0.0)
           (path/path-line-to! (mut counterclockwise) 0.0 0.0)
           (path/path-close! (mut counterclockwise))
           (let [(mut a) (path/path-tessellate (load clockwise))
                 (mut b) (path/path-tessellate (load counterclockwise))]
             (assert (load (field a valid)))
             (assert (load (field b valid)))
             (assert-eq (al/al-len [path/PathPoint] (load (field a vertices))) 9)
             (assert-eq (al/al-len [path/PathPoint] (load (field b vertices))) 9)
             (path/tessellation-free! (mut a))
             (path/tessellation-free! (mut b)))
           (path/path-free! (mut clockwise))
           (path/path-free! (mut counterclockwise))))

(deftest path-tessellation-rejects-open-degenerate-and-self-intersecting-input
         (let [(mut candidate) (primitive/zeroed path/Path)]
           (store! candidate (path/path-new))
           (path/path-move-to! (mut candidate) 0.0 0.0)
           (path/path-line-to! (mut candidate) 40.0 40.0)
           (path/path-line-to! (mut candidate) 0.0 40.0)
           (path/path-line-to! (mut candidate) 40.0 0.0)
           (let [(mut open-result) (path/path-tessellate (load candidate))]
             (assert (not (load (field open-result valid))))
             (path/tessellation-free! (mut open-result)))
           (path/path-close! (mut candidate))
           (let [(mut crossed-result) (path/path-tessellate (load candidate))]
             (assert (not (load (field crossed-result valid))))
             (assert-eq (al/al-len [path/PathPoint] (load (field crossed-result vertices))) 0)
             (path/tessellation-free! (mut crossed-result)))
           (path/path-clear! (mut candidate))
           (path/path-move-to! (mut candidate) 0.0 0.0)
           (path/path-line-to! (mut candidate) 10.0 0.0)
           (path/path-line-to! (mut candidate) 20.0 0.0)
           (path/path-close! (mut candidate))
           (let [(mut degenerate) (path/path-tessellate (load candidate))]
             (assert (not (load (field degenerate valid))))
             (path/tessellation-free! (mut degenerate)))
           (path/path-free! (mut candidate))))

(deftest focus-and-actions-survive-transient-scenes
         (let [(mut scene) (scene-new)
               (mut router) (input/router-new)]
           (button! (mut scene)
                    (rect 0.0 0.0 100.0 30.0)
                    (ButtonState
                      :hovered false
                      :pressed false
                      :focused false
                      :disabled false)
                    10)
           (button! (mut scene)
                    (rect 0.0 40.0 100.0 30.0)
                    (ButtonState
                      :hovered false
                      :pressed false
                      :focused false
                      :disabled true)
                    11)
           (checkbox! (mut scene)
                      (rect 0.0 80.0 24.0 24.0)
                      (CheckboxState
                        :checked false
                        :hovered false
                        :focused false
                        :disabled false)
                      12)
           (assert-eq (input/focus-next scene -1 1) 10)
           (assert-eq (input/focus-next scene 10 1) 12)
           (assert-eq (input/focus-next scene 10 -1) 12)
           (input/router-pointer-down! (mut router) scene 10.0 10.0)
           (let [event (input/router-pointer-up! (mut router) scene 10.0 10.0)]
             (assert-eq (load (field event action)) (primitive/cast i32 input/action-activate))
             (assert-eq (load (field event target)) 10))
           (let [tab (input/router-key! (mut router) scene 48 false)
                 activate (input/router-key! (mut router) scene 49 false)]
             (assert-eq (load (field tab action)) (primitive/cast i32 input/action-none))
             (assert-eq (load (field activate action)) (primitive/cast i32 input/action-activate))
             (assert-eq (load (field activate target)) 12))
           (scene-free! (mut scene))))

(deftest virtual-list-bounds-work-is-independent-of-item-count
         (let [(mut state) (primitive/zeroed scroll/ScrollState)]
           (store! state (scroll/scroll-new 1000000 24.0 2))
           (scroll/scroll-configure! (mut state) (rect 10.0 20.0 300.0 240.0) 1000000 24.0)
           (assert-eq (scroll/visible-first state) 0)
           (assert-eq (scroll/visible-last state) 13)
           (assert-eq (scroll/visible-count state) 13)
           (scroll/scroll-to! (mut state) 12000.0)
           (assert-eq (scroll/visible-first state) 498)
           (assert-eq (scroll/visible-last state) 513)
           (assert-eq (scroll/visible-count state) 15)))

(deftest virtual-list-clamps-bottom-and-keeps-scrollbar-thumb
         (let [(mut scene) (scene-new)
               (mut state) (primitive/zeroed scroll/ScrollState)]
           (store! state (scroll/scroll-new 10000 20.0 1))
           (scroll/scroll-configure! (mut state) (rect 0.0 0.0 200.0 100.0) 10000 20.0)
           (scroll/scroll-to! (mut state) 1000000.0)
           (assert (and (> (load (field state offset)) 199899.0)
                        (< (load (field state offset)) 199901.0)))
           (assert-eq (scroll/visible-last state) 10000)
           (scroll/scrollbar! (mut scene) state 77)
           (assert-eq (al/al-len [Primitive] (load (field scene items))) 2)
           (let [track (al/al-get [Primitive] (load (field scene items)) 0)
                 thumb (al/al-get [Primitive] (load (field scene items)) 1)
                 track-bounds (load (field track bounds))
                 thumb-bounds (load (field thumb bounds))]
             (assert (> (load (field thumb-bounds h)) 0.0))
             (assert (<= (+ (load (field thumb-bounds y)) (load (field thumb-bounds h)))
                         (+ (load (field track-bounds y)) (load (field track-bounds h))))))
           (scene-free! (mut scene))))

(deftest variable-list-prefix-lookup-measurement-and-anchoring
         (let [(mut state) (primitive/zeroed variable/VariableScrollState)]
           (store! state (variable/variable-scroll-new 6 10.0 1))
           (variable/variable-scroll-configure! (mut state) (rect 0.0 0.0 200.0 25.0))
           (variable/variable-scroll-measure! (mut state) 1 20.0)
           (variable/variable-scroll-measure! (mut state) 2 30.0)
           (assert (and (> (variable/variable-scroll-prefix state 3) 59.9)
                        (< (variable/variable-scroll-prefix state 3) 60.1)))
           (assert-eq (variable/variable-scroll-index-at state 0.0) 0)
           (assert-eq (variable/variable-scroll-index-at state 9.9) 0)
           (assert-eq (variable/variable-scroll-index-at state 10.0) 1)
           (assert-eq (variable/variable-scroll-index-at state 35.0) 2)
           (variable/variable-scroll-to! (mut state) 35.0)
           ;; Replacing an estimate above the viewport preserves the same
           ;; visible content by advancing the pixel offset by the delta.
           (variable/variable-scroll-measure! (mut state) 0 15.0)
           (assert (and (> (load (field state offset)) 39.9)
                        (< (load (field state offset)) 40.1)))
           (let [row (variable/variable-item-rect state 2)]
             (assert (and (> (load (field row y)) -5.1)
                          (< (load (field row y)) -4.9)
                          (> (load (field row h)) 29.9)))
             (assert-eq (variable/variable-visible-first state) 1)
             (assert-eq (variable/variable-visible-last state) 5)
             (variable/variable-scroll-free! (mut state)))))

(deftest variable-list-million-row-range-remains-bounded
         (let [(mut state) (primitive/zeroed variable/VariableScrollState)]
           (store! state (variable/variable-scroll-new 1000000 24.0 2))
           (variable/variable-scroll-configure! (mut state) (rect 0.0 0.0 300.0 240.0))
           (variable/variable-scroll-to! (mut state) 12000000.0)
           (assert (<= (variable/variable-visible-count state) 16))
           (assert-eq (variable/variable-scroll-index-at state 12000000.0) 500000)
           (variable/variable-scroll-measure! (mut state) 499999 48.0)
           (assert (and (> (load (field state offset)) 12000023.0)
                        (< (load (field state offset)) 12000025.0)))
           (variable/variable-scroll-free! (mut state))))

(deftest components-produce-batched-primitives
         (let [(mut scene) (scene-new)]
           (button! (mut scene)
                    (rect 0.0 0.0 100.0 36.0)
                    (ButtonState
                      :hovered false
                      :pressed false
                      :focused false
                      :disabled false)
                    10)
           (checkbox! (mut scene)
                      (rect 0.0 50.0 24.0 24.0)
                      (CheckboxState
                        :checked true
                        :hovered false
                        :focused false
                        :disabled false)
                      11)
           (slider! (mut scene)
                    (rect 0.0 90.0 180.0 28.0)
                    (SliderState
                      :value 0.5
                      :minimum 0.0
                      :maximum 1.0
                      :hovered false
                      :focused false)
                    12)
           (progress! (mut scene) (rect 0.0 130.0 180.0 8.0) (ProgressState :value 0.75) 13)
           (assert-eq (al/al-len [Primitive] (load (field scene items))) 9)
           (scene-free! (mut scene))))

(deftest scene-buffer-is-reused-between-frames
         (let [(mut scene) (primitive/zeroed Scene)]
           (store! scene (scene-new))
           (for [i 0 4096]
             (scene-rect! (mut scene)
                          (rect (primitive/cast f32 i) 0.0 1.0 1.0)
                          (rgb 1.0 1.0 1.0)
                          (primitive/cast i32 i)))
           (let [first-cap (al/al-cap [Primitive] (load (field scene items)))]
             (scene-clear! (mut scene))
             (for [i 0 4096]
               (scene-rect! (mut scene)
                            (rect (primitive/cast f32 i) 0.0 1.0 1.0)
                            (rgb 1.0 1.0 1.0)
                            (primitive/cast i32 i)))
             (assert-eq (al/al-cap [Primitive] (load (field scene items))) first-cap))
           (scene-free! (mut scene))))

(deftest text-sprites-are-transient-and-reuse-storage
         (let [(mut scene) (primitive/zeroed Scene)]
           (store! scene (scene-new))
           (scene-texture! (mut scene)
                           (rect 10.0 20.0 140.0 24.0)
                           (rgb 1.0 1.0 1.0)
                           (primitive/cast (ptr i8) 123)
                           40)
           (assert-eq (al/al-len [TextSprite] (load (field scene text))) 1)
           (let [capacity (al/al-cap [TextSprite] (load (field scene text)))]
             (scene-clear! (mut scene))
             (assert-eq (al/al-len [TextSprite] (load (field scene text))) 0)
             (assert-eq (al/al-cap [TextSprite] (load (field scene text))) capacity))
           (scene-free! (mut scene))))
