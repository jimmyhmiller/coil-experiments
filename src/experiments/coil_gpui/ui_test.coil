(extern MTLCreateSystemDefaultDevice :cc c [] (-> (ptr i8)))

(extern objc_getProtocol :cc c [(ptr i8)] (-> (ptr i8)))

(extern usleep :cc c [i64] (-> i32))

(defstruct AccessRect64 [(x f64) (y f64) (w f64) (h f64)])

(defstruct AccessRange64 [(location u64) (length u64)])

(defstruct WindowTestRect [(x f64) (y f64) (w f64) (h f64)])

(defstruct SchedulerProbe [(calls i64) (result i64) (cancelled i64)])

(defstruct SchedulerBatchProbe [(completed i64) (sum i64)])

(defstruct SchedulerPriorityProbe
  [(gate i64) (started i64) (next i64) (order (ptr i64))])

(defstruct SchedulerPriorityJob [(probe (ptr SchedulerPriorityProbe)) (id i64)])

(defstruct FutureOwnedResult [(drops (ptr i64)) (value i64)])

(defstruct FutureWorkerInput [(drops (ptr i64)) (value i64) (wait-cancel bool)])

(impl Drop FutureOwnedResult
  (drop [(self (mut FutureOwnedResult))]
        (-> void)
        (let [drops (load (field self drops))]
          (store! drops (+ (load drops) 1)))))

(defn build-replay-component-scene! [(scene (mut Scene))
                                     (router input/Router)
                                     (checked bool)] (-> i64)
  (do
    (button! (mut scene)
             (rect 8.0 8.0 36.0 28.0)
             (ButtonState
               :hovered (= (load (field router hovered)) 10)
               :pressed (= (load (field router pressed)) 10)
               :focused (= (load (field router focused)) 10)
               :disabled false)
             10)
    (checkbox! (mut scene)
               (rect 60.0 10.0 24.0 24.0)
               (CheckboxState
                 :checked checked
                 :hovered (= (load (field router hovered)) 11)
                 :focused (= (load (field router focused)) 11)
                 :disabled false)
               11)))

(defn scheduler-test-foreground [(raw (ptr i8))] (-> i64)
  (let [probe (primitive/cast (ptr SchedulerProbe) raw)]
    (do
      (set! (field probe calls) (+ (load (field probe calls)) 1))
      0)))

(defn scheduler-test-background [(raw (ptr i8)) (cancel (ptr i64))] (-> i64)
  (let [input (primitive/cast (ptr i64) raw)]
    (if (scheduler/scheduler-cancel-requested? cancel) -1 (* (load input) 7))))

(defn scheduler-test-cancellable [(raw (ptr i8)) (cancel (ptr i64))] (-> i64)
  (do
    (while (not (scheduler/scheduler-cancel-requested? cancel)) 0)
    9))

(defn scheduler-test-completion [(raw (ptr i8)) (result i64) (cancelled i64)] (-> i64)
  (let [probe (primitive/cast (ptr SchedulerProbe) raw)]
    (do
      (set! (field probe calls) (+ (load (field probe calls)) 1))
      (set! (field probe result) result)
      (set! (field probe cancelled) cancelled)
      0)))

(defn scheduler-test-wake [(raw (ptr i8))] (-> i64)
  (atomic/atomic-add (primitive/cast (ptr i64) raw) 1))

(defn scheduler-test-pool-worker [(raw (ptr i8)) (cancel (ptr i64))] (-> i64)
  (atomic/atomic-add (primitive/cast (ptr i64) raw) 1))

(defn scheduler-test-pool-completion [(raw (ptr i8)) (result i64) (cancelled i64)] (-> i64)
  (let [probe (primitive/cast (ptr SchedulerBatchProbe) raw)]
    (do
      (set! (field probe completed) (+ (load (field probe completed)) 1))
      (set! (field probe sum) (+ (load (field probe sum)) result))
      0)))

(defn scheduler-test-priority-worker [(raw (ptr i8)) (cancel (ptr i64))] (-> i64)
  (let [job (primitive/cast (ptr SchedulerPriorityJob) raw)
        probe (load (field job probe))
        id (load (field job id))]
    (if (< id 0)
        (do
          (atomic/atomic-store (field probe started) 1)
          (while (= (atomic/atomic-load (field probe gate)) 0) 0)
          id)
        (let [index (atomic/atomic-add (field probe next) 1)]
          (do
            (store! (primitive/index (load (field probe order)) index) id)
            id)))))

(defn scheduler-test-priority-completion [(raw (ptr i8)) (result i64) (cancelled i64)] (-> i64)
  0)

(defn future-test-worker [(raw (ptr i8)) (cancel (ptr i64))] (-> i64)
  (let [input (primitive/cast (ptr FutureWorkerInput) raw)]
    (do
      (when (load (field input wait-cancel))
        (while (not (scheduler/scheduler-cancel-requested? cancel)) 0))
      (match (alloc/alloc [FutureOwnedResult] (alloc/malloc-allocator) 1)
        (None [] 0)
        (Some [memory]
              (let [value (alloc/alloc-slice-data memory)]
                (do
                  (store! value
                          (FutureOwnedResult :drops (load (field input drops))
                            :value (load (field input value))))
                  (primitive/cast i64 value))))))))

(defn future-test-destroy [(raw (ptr i8))] (-> i64)
  (let [value (primitive/cast (ptr FutureOwnedResult) raw)
        owned (take! [FutureOwnedResult] value)]
    (alloc/free [FutureOwnedResult]
                (alloc/malloc-allocator)
                (alloc/alloc-slice-new value 1))))

(deftest scheduler-orders-owner-thread-work-and-rejects-stale-handles
         (let [(mut executor) (scheduler/scheduler-new)
               probe (primitive/alloc-stack SchedulerProbe)
               immediate
                 (scheduler/scheduler-dispatch! (mut executor)
                                                (primitive/fnptr-of scheduler-test-foreground)
                                                (primitive/cast (ptr i8) probe))
               future
                 (scheduler/scheduler-at! (mut executor)
                                          200
                                          (primitive/fnptr-of scheduler-test-foreground)
                                          (primitive/cast (ptr i8) probe))]
           (store! probe (primitive/zeroed SchedulerProbe))
           (assert-eq (scheduler/scheduler-active-count (load executor)) 2)
           (assert-eq (scheduler/scheduler-poll-at! (mut executor) 100) 1)
           (assert-eq (load (field probe calls)) 1)
           (assert (not (scheduler/scheduler-cancel! (mut executor) immediate)))
           (assert (scheduler/scheduler-cancel! (mut executor) future))
           (assert-eq (scheduler/scheduler-active-count (load executor)) 0)
           ;; Reusing the slot increments its generation, so the old handle can
           ;; never cancel an unrelated successor.
           (let [successor
                   (scheduler/scheduler-dispatch! (mut executor)
                                                  (primitive/fnptr-of scheduler-test-foreground)
                                                  (primitive/cast (ptr i8) probe))]
             (assert (not (scheduler/scheduler-cancel! (mut executor) future)))
             (assert (scheduler/scheduler-cancel! (mut executor) successor)))
           (scheduler/scheduler-free! (mut executor))))

(deftest scheduler-joins-background-work-before-owner-thread-completion
         (let [(mut executor) (scheduler/scheduler-new)
               input (primitive/alloc-stack i64)
               probe (primitive/alloc-stack SchedulerProbe)
               wakes (primitive/alloc-stack i64)]
           (do
             (store! input 6)
             (store! probe (primitive/zeroed SchedulerProbe))
             (atomic/atomic-store wakes 0)
             (scheduler/scheduler-set-wake! (mut executor)
                                            (primitive/fnptr-of scheduler-test-wake)
                                            (primitive/cast (ptr i8) wakes))
             (let [handle
                     (scheduler/scheduler-spawn! (mut executor)
                                                 (primitive/fnptr-of scheduler-test-background)
                                                 (primitive/fnptr-of scheduler-test-completion)
                                                 (primitive/cast (ptr i8) input)
                                                 (primitive/cast (ptr i8) probe))
                   (mut attempts) 0]
               (do
                 (assert (>= (load (field handle slot)) 0))
                 ;; The worker is real pthread work. Polling delivers its result on
                 ;; this owner thread, and the scheduler joins it before the callback.
                 (while (and (= (load (field probe calls)) 0) (< (load attempts) 1000))
                   (do
                     (scheduler/scheduler-poll-at! (mut executor) 0)
                     (usleep 1000)
                     (set! attempts (+ (load attempts) 1))))
                 (assert-eq (load (field probe calls)) 1)
                 (assert-eq (load (field probe result)) 42)
                 (assert-eq (load (field probe cancelled)) 0)
                 (assert-eq (atomic/atomic-load wakes) 1)
                 (assert-eq (scheduler/scheduler-active-count (load executor)) 0)
                 (scheduler/scheduler-free! (mut executor)))))))

(deftest scheduler-cancellation-is-cooperative-and-completion-is-owner-delivered
         (let [(mut executor) (scheduler/scheduler-new)
               probe (primitive/alloc-stack SchedulerProbe)]
           (do
             (store! probe (primitive/zeroed SchedulerProbe))
             (let [handle
                     (scheduler/scheduler-spawn! (mut executor)
                                                 (primitive/fnptr-of scheduler-test-cancellable)
                                                 (primitive/fnptr-of scheduler-test-completion)
                                                 (primitive/cast (ptr i8) 0)
                                                 (primitive/cast (ptr i8) probe))
                   (mut attempts) 0]
               (do
                 (assert (scheduler/scheduler-cancel! (mut executor) handle))
                 (while (and (= (load (field probe calls)) 0) (< (load attempts) 1000))
                   (do
                     (scheduler/scheduler-poll-at! (mut executor) 0)
                     (usleep 1000)
                     (set! attempts (+ (load attempts) 1))))
                 (assert-eq (load (field probe calls)) 1)
                 (assert-eq (load (field probe result)) 9)
                 (assert-eq (load (field probe cancelled)) 1)
                 (assert-eq (scheduler/scheduler-active-count (load executor)) 0)
                 (scheduler/scheduler-free! (mut executor)))))))

(deftest scheduler-bounded-pool-reuses-workers-and-delivers-every-result
         (let [(mut executor) (scheduler/scheduler-new-with-workers 2)
               sequence (primitive/alloc-stack i64)
               probe (primitive/alloc-stack SchedulerBatchProbe)
               (mut attempts) 0]
           (do
             (atomic/atomic-store sequence 0)
             (store! probe (primitive/zeroed SchedulerBatchProbe))
             (assert-eq (scheduler/scheduler-worker-count executor) 2)
             (for [i 0 64]
               (let [handle
                       (scheduler/scheduler-spawn! (mut executor)
                                                   (primitive/fnptr-of scheduler-test-pool-worker)
                                                   (primitive/fnptr-of scheduler-test-pool-completion)
                                                   (primitive/cast (ptr i8) sequence)
                                                   (primitive/cast (ptr i8) probe))]
                 (assert (>= (load (field handle slot)) 0))))
             (while (and (< (load (field probe completed)) 64) (< (load attempts) 2000))
               (do
                 (scheduler/scheduler-poll-at! (mut executor) 0)
                 (usleep 1000)
                 (set! attempts (+ (load attempts) 1))))
             (assert-eq (load (field probe completed)) 64)
             (assert-eq (load (field probe sum)) 2016)
             (assert-eq (atomic/atomic-load sequence) 64)
             (assert-eq (scheduler/scheduler-active-count executor) 0)
             (scheduler/scheduler-free! (mut executor)))))

(deftest scheduler-priority-lanes-preserve-fifo-and-bound-low-starvation
         (let [(mut executor) (scheduler/scheduler-new-with-workers 1)
               (mut order) (al/al-new [i64] (alloc/malloc-allocator))
               (mut jobs) (al/al-new [SchedulerPriorityJob] (alloc/malloc-allocator))
               probe (primitive/alloc-stack SchedulerPriorityProbe)]
           (for [i 0 16] (al/al-push! [i64] (mut order) -1))
           (al/al-reserve! [SchedulerPriorityJob] (mut jobs) 7)
           (store! probe
                   (SchedulerPriorityProbe
                     :gate 0
                     :started 0
                     :next 0
                     :order (load (field order data))))
           (al/al-push! [SchedulerPriorityJob]
                        (mut jobs)
                        (SchedulerPriorityJob :probe probe :id -1))
           (scheduler/scheduler-spawn-priority! (mut executor)
                                                scheduler/priority-medium
                                                (primitive/fnptr-of scheduler-test-priority-worker)
                                                (primitive/fnptr-of scheduler-test-priority-completion)
                                                (primitive/cast (ptr i8)
                                                                (al/al-elem [SchedulerPriorityJob] (mut jobs) 0))
                                                (primitive/cast (ptr i8) 0))
           (while (= (atomic/atomic-load (field probe started)) 0) 0)
           ;; Queue low first to prove priority, while retaining FIFO in each lane.
           (for [id 0 2]
             (do
               (al/al-push! [SchedulerPriorityJob]
                            (mut jobs)
                            (SchedulerPriorityJob :probe probe :id (+ 300 id)))
               (scheduler/scheduler-spawn-priority! (mut executor)
                                                    scheduler/priority-low
                                                    (primitive/fnptr-of scheduler-test-priority-worker)
                                                    (primitive/fnptr-of scheduler-test-priority-completion)
                                                    (primitive/cast (ptr i8)
                                                                    (al/al-elem [SchedulerPriorityJob]
                                                                                (mut jobs)
                                                                                (+ id 1)))
                                                    (primitive/cast (ptr i8) 0))))
           (for [id 0 2]
             (do
               (al/al-push! [SchedulerPriorityJob]
                            (mut jobs)
                            (SchedulerPriorityJob :probe probe :id (+ 200 id)))
               (scheduler/scheduler-spawn-priority! (mut executor)
                                                    scheduler/priority-medium
                                                    (primitive/fnptr-of scheduler-test-priority-worker)
                                                    (primitive/fnptr-of scheduler-test-priority-completion)
                                                    (primitive/cast (ptr i8)
                                                                    (al/al-elem [SchedulerPriorityJob]
                                                                                (mut jobs)
                                                                                (+ id 3)))
                                                    (primitive/cast (ptr i8) 0))))
           (for [id 0 2]
             (do
               (al/al-push! [SchedulerPriorityJob]
                            (mut jobs)
                            (SchedulerPriorityJob :probe probe :id (+ 100 id)))
               (scheduler/scheduler-spawn-priority! (mut executor)
                                                    scheduler/priority-high
                                                    (primitive/fnptr-of scheduler-test-priority-worker)
                                                    (primitive/fnptr-of scheduler-test-priority-completion)
                                                    (primitive/cast (ptr i8)
                                                                    (al/al-elem [SchedulerPriorityJob]
                                                                                (mut jobs)
                                                                                (+ id 5)))
                                                    (primitive/cast (ptr i8) 0))))
           (atomic/atomic-store (field probe gate) 1)
           (while (> (scheduler/scheduler-active-count executor) 0)
             (scheduler/scheduler-poll-at! (mut executor) 0))
           (assert-eq (al/al-get [i64] order 0) 100)
           (assert-eq (al/al-get [i64] order 1) 101)
           (assert-eq (al/al-get [i64] order 2) 200)
           (assert-eq (al/al-get [i64] order 3) 201)
           (assert-eq (al/al-get [i64] order 4) 300)
           (assert-eq (al/al-get [i64] order 5) 301)
           (scheduler/scheduler-free! (mut executor))
           (al/al-free! [SchedulerPriorityJob] (mut jobs))
           (al/al-free! [i64] (mut order))))

(deftest typed-futures-transfer-owned-values-and-destroy-abandoned-results
         (let [(mut executor) (scheduler/scheduler-new-with-workers 1)
               drops (primitive/alloc-stack i64)
               first-input (primitive/alloc-stack FutureWorkerInput)
               second-input (primitive/alloc-stack FutureWorkerInput)
               cancelled-input (primitive/alloc-stack FutureWorkerInput)]
           (store! drops 0)
           (store! first-input
                   (FutureWorkerInput
                     :drops drops
                     :value 41
                     :wait-cancel false))
           (store! second-input
                   (FutureWorkerInput
                     :drops drops
                     :value 52
                     :wait-cancel false))
           (store! cancelled-input
                   (FutureWorkerInput
                     :drops drops
                     :value 63
                     :wait-cancel true))
           (let [(mut first)
                   (future/future-spawn! [FutureOwnedResult]
                                         (mut executor)
                                         scheduler/priority-high
                                         (primitive/fnptr-of future-test-worker)
                                         (primitive/cast (ptr i8) first-input)
                                         (primitive/fnptr-of future-test-destroy))]
             (while (not (future/future-ready? [FutureOwnedResult] first))
               (scheduler/scheduler-poll-at! (mut executor) 0))
             (let [value (future/future-take! [FutureOwnedResult] (mut first))]
               (do
                 (assert (!= (primitive/cast i64 value) 0))
                 (assert-eq (load (field value value)) 41)
                 (future-test-destroy (primitive/cast (ptr i8) value))))
             (assert-eq (load drops) 1))
           (let [(mut abandoned)
                   (future/future-spawn! [FutureOwnedResult]
                                         (mut executor)
                                         scheduler/priority-medium
                                         (primitive/fnptr-of future-test-worker)
                                         (primitive/cast (ptr i8) second-input)
                                         (primitive/fnptr-of future-test-destroy))]
             (while (not (future/future-ready? [FutureOwnedResult] abandoned))
               (scheduler/scheduler-poll-at! (mut executor) 0))
             (future/future-free! [FutureOwnedResult] (mut executor) (mut abandoned))
             (assert-eq (load drops) 2))
           (let [implicit-input (primitive/alloc-stack FutureWorkerInput)]
             (store! implicit-input
                     (FutureWorkerInput
                       :drops drops
                       :value 57
                       :wait-cancel false))
             (let [(mut implicit)
                     (future/future-spawn! [FutureOwnedResult]
                                           (mut executor)
                                           scheduler/priority-medium
                                           (primitive/fnptr-of future-test-worker)
                                           (primitive/cast (ptr i8) implicit-input)
                                           (primitive/fnptr-of future-test-destroy))]
               (while (not (future/future-ready? [FutureOwnedResult] implicit))
                 (scheduler/scheduler-poll-at! (mut executor) 0))))
           (assert-eq (load drops) 3)
           (let [(mut cancelled)
                   (future/future-spawn! [FutureOwnedResult]
                                         (mut executor)
                                         scheduler/priority-low
                                         (primitive/fnptr-of future-test-worker)
                                         (primitive/cast (ptr i8) cancelled-input)
                                         (primitive/fnptr-of future-test-destroy))]
             (assert (future/future-cancel! [FutureOwnedResult] (mut executor) (mut cancelled)))
             (while (> (scheduler/scheduler-active-count executor) 0)
               (scheduler/scheduler-poll-at! (mut executor) 0))
             (assert (future/future-cancelled? [FutureOwnedResult] cancelled))
             (future/future-free! [FutureOwnedResult] (mut executor) (mut cancelled))
             (assert-eq (load drops) 4))
           (scheduler/scheduler-free! (mut executor))))

(deftest scheduler-pool-shutdown-cancels-running-and-queued-work-before-join
         (let [(mut executor) (scheduler/scheduler-new-with-workers 1)
               probe (primitive/alloc-stack SchedulerProbe)]
           (do
             (store! probe (primitive/zeroed SchedulerProbe))
             (for [i 0 2]
               (let [handle
                       (scheduler/scheduler-spawn! (mut executor)
                                                   (primitive/fnptr-of scheduler-test-cancellable)
                                                   (primitive/fnptr-of scheduler-test-completion)
                                                   (primitive/cast (ptr i8) 0)
                                                   (primitive/cast (ptr i8) probe))]
                 (assert (>= (load (field handle slot)) 0))))
             ;; Teardown requests cancellation for both the running and queued
             ;; blocks, drains the queue, and joins the sole reusable worker.
             (scheduler/scheduler-free! (mut executor))
             (assert-eq (load (field probe calls)) 0)
             (assert-eq (scheduler/scheduler-active-count executor) 0))))

(deftest task-scope-prunes-completed-work-and-cancels-the-remainder
         (let [(mut executor) (scheduler/scheduler-new-with-workers 1)
               (mut scope) (scheduler/task-scope-new)
               probe (primitive/alloc-stack SchedulerProbe)
               (mut attempts) 0]
           (do
             (store! probe (primitive/zeroed SchedulerProbe))
             (scheduler/task-scope-dispatch! (mut scope)
                                             (mut executor)
                                             (primitive/fnptr-of scheduler-test-foreground)
                                             (primitive/cast (ptr i8) probe))
             (scheduler/task-scope-after! (mut scope)
                                          (mut executor)
                                          1000000
                                          (primitive/fnptr-of scheduler-test-foreground)
                                          (primitive/cast (ptr i8) probe))
             (scheduler/task-scope-spawn! (mut scope)
                                          (mut executor)
                                          (primitive/fnptr-of scheduler-test-cancellable)
                                          (primitive/fnptr-of scheduler-test-completion)
                                          (primitive/cast (ptr i8) 0)
                                          (primitive/cast (ptr i8) probe))
             (scheduler/scheduler-poll-at! (mut executor) 0)
             (assert-eq (load (field probe calls)) 1)
             (assert-eq (scheduler/task-scope-active-count (mut scope) (mut executor)) 2)
             (assert-eq (scheduler/task-scope-cancel! (mut scope) (mut executor)) 2)
             (assert (scheduler/task-scope-closed? scope))
             (let [rejected
                     (scheduler/task-scope-dispatch! (mut scope)
                                                     (mut executor)
                                                     (primitive/fnptr-of scheduler-test-foreground)
                                                     (primitive/cast (ptr i8) probe))]
               (assert-eq (load (field rejected slot)) -1))
             (while (and (> (scheduler/scheduler-active-count executor) 0)
                         (< (load attempts) 1000))
               (do
                 (scheduler/scheduler-poll-at! (mut executor) 0)
                 (usleep 1000)
                 (set! attempts (+ (load attempts) 1))))
             (assert-eq (load (field probe calls)) 2)
             (assert-eq (load (field probe cancelled)) 1)
             (assert-eq (scheduler/scheduler-active-count executor) 0)
             (scheduler/task-scope-free! (mut scope) (mut executor))
             (scheduler/scheduler-free! (mut executor)))))

(defn test-keystroke-push! [(strokes (mut (al/ArrayList keymap/KeyStroke)))
                            (key i64)
                            (modifiers i32)] (-> i64)
  (let [(mut zero) (primitive/zeroed keymap/KeyStroke)]
    (do
      (al/al-push! [keymap/KeyStroke] (mut strokes) (load zero))
      (let [item
              (primitive/index (load (field strokes data))
                               (- (al/al-len [keymap/KeyStroke] (load strokes)) 1))]
        (do
          (store! (field item key) key)
          (store! (field item modifiers) modifiers)
          (al/al-len [keymap/KeyStroke] (load strokes)))))))

(defstruct RetainedDropProbe [(counter (ptr i64)) (value i64)])

(defstruct ObservationCallbackProbe
  [(hub (ptr retained/ObservationHub))
   (calls i64)
   (received-token i32)
   (cancel retained/Subscription)
   (cancel-other bool)])

(defn retained-observation-callback [(raw (ptr i8))
                                     (type-id i64)
                                     (slot i64)
                                     (generation i64)
                                     (token i32)] (-> i64)
  (let [probe (primitive/cast (ptr ObservationCallbackProbe) raw)]
    (do
      (set! (field probe calls) (+ (load (field probe calls)) 1))
      (set! (field probe received-token) token)
      (when (load (field probe cancel-other))
        (if (retained/observation-unsubscribe! (load (field probe hub))
                                               (load (field probe cancel)))
            0
            0))
      0)))

(impl Drop RetainedDropProbe
  (drop [(self (mut RetainedDropProbe))]
        (-> void)
        (let [counter (load (field self counter))]
          (store! counter (+ (load counter) 1)))))

(defn make-expired-entity-weak [(map (ref (entity/EntityMap RetainedDropProbe)))
                                (drops (ptr i64))] (-> (entity/WeakEntity RetainedDropProbe))
  (let [owner
          (entity/entity-map-create! [RetainedDropProbe]
                                     map
                                     (RetainedDropProbe :counter drops :value 77))
        weak (entity/entity-downgrade [RetainedDropProbe] owner)]
    weak))

(deftest metal-buffer-capacity-grows-by-powers-of-two
         (assert-eq (metal/next-buffer-capacity 0 1) 65536)
         (assert-eq (metal/next-buffer-capacity 65536 65536) 65536)
         (assert-eq (metal/next-buffer-capacity 65536 65537) 131072)
         (assert-eq (metal/next-buffer-capacity 131072 1000000) 1048576))

(deftest metal-instance-abi-is-stable
         ;; Must match Metal exactly: base payload + affine + opacity/padding.
         (assert-eq (primitive/sizeof Primitive) 112))

(deftest metal-text-sprite-abi-is-stable
         ;; bounds + color + clip + UV + affine + texture + id/mode + radius/opacity.
         (assert-eq (primitive/sizeof TextSprite) 112))

(deftest metal-path-abis-are-stable
         (assert-eq (primitive/sizeof path/PathPoint) 8)
         (assert-eq (primitive/sizeof PathDraw) 96)
         (assert-eq (primitive/sizeof PaintCommand) 8))

(deftest transformed-path-culling-respects-clip-and-viewport
         (let [base
                 (PathDraw
                   :vertex-start 0
                   :vertex-count 3
                   :bounds (rect 0.0 0.0 20.0 20.0)
                   :color (rgb 1.0 1.0 1.0)
                   :clip (rect 0.0 0.0 100.0 100.0)
                   :transform (affine-translate 40.0 30.0)
                   :id 1
                   :opacity 1.0)
               clipped
                 (PathDraw
                   :vertex-start 0
                   :vertex-count 3
                   :bounds (rect 0.0 0.0 20.0 20.0)
                   :color (rgb 1.0 1.0 1.0)
                   :clip (rect 0.0 0.0 10.0 10.0)
                   :transform (affine-translate 40.0 30.0)
                   :id 2
                   :opacity 1.0)]
           (assert (path-draw-visible? base (rect 0.0 0.0 80.0 80.0)))
           (assert (not (path-draw-visible? base (rect 0.0 0.0 30.0 30.0))))
           (assert (not (path-draw-visible? clipped (rect 0.0 0.0 80.0 80.0))))))

(deftest transformed-box-and-sprite-culling-share-clip-semantics
         (let [item
                 (Primitive
                   :bounds (rect 0.0 0.0 20.0 10.0)
                   :color (rgb 1.0 1.0 1.0)
                   :radius 0.0
                   :border-width 0.0
                   :border-color (rgba 0.0 0.0 0.0 0.0)
                   :clip (rect 0.0 0.0 100.0 100.0)
                   :transform (affine-translate 50.0 40.0)
                   :kind 0
                   :id 1
                   :opacity 1.0
                   :padding 0)
               sprite
                 (TextSprite
                   :bounds (rect 0.0 0.0 20.0 10.0)
                   :color (rgb 1.0 1.0 1.0)
                   :clip (rect 0.0 0.0 100.0 100.0)
                   :uv (rect 0.0 0.0 1.0 1.0)
                   :transform (affine-translate 50.0 40.0)
                   :texture (primitive/cast (ptr i8) 1)
                   :id 2
                   :mode 0
                   :radius 0.0
                   :opacity 1.0)]
           (assert (primitive-visible? item (rect 0.0 0.0 80.0 80.0)))
           (assert (sprite-visible? sprite (rect 0.0 0.0 80.0 80.0)))
           (assert (not (primitive-visible? item (rect 0.0 0.0 40.0 40.0))))
           (assert (not (sprite-visible? sprite (rect 0.0 0.0 40.0 40.0))))))

(deftest scene-damage-unions-old-and-new-frame-regions
         (let [(mut scene) (scene-new)
               viewport (rect 0.0 0.0 200.0 100.0)]
           (scene-rect! (mut scene) (rect 10.0 10.0 20.0 20.0) (rgb 1.0 1.0 1.0) 1)
           (let [old-region (scene-visual-bounds scene viewport)]
             (scene-clear! (mut scene))
             (let [prior (scene-push-transform! (mut scene) (affine-translate 100.0 0.0))]
               (do
                 (scene-rect! (mut scene) (rect 10.0 10.0 20.0 20.0) (rgb 1.0 1.0 1.0) 1)
                 (scene-pop-transform! (mut scene) prior)))
             (let [new-region (scene-visual-bounds scene viewport)
                   damage (damage-union old-region new-region)
                   bounds (load (field damage bounds))]
               (assert (load (field damage valid)))
               (assert (and (> (load (field bounds x)) 9.99)
                            (and (< (load (field bounds x)) 10.01)
                                 (and (> (load (field bounds w)) 119.99)
                                      (< (load (field bounds w)) 120.01)))))))
           (scene-free! (mut scene))))

(deftest retained-damage-tracker-invalidates-disappearing-content
         (let [(mut scene) (scene-new)
               (mut tracker) (damage-tracker-new)
               viewport (rect 0.0 0.0 200.0 100.0)]
           (scene-rect! (mut scene) (rect 20.0 10.0 30.0 20.0) (rgb 1.0 1.0 1.0) 1)
           (let [first (damage-tracker-advance! (mut tracker) scene viewport)]
             (assert (load (field first valid))))
           (scene-clear! (mut scene))
           (let [removed (damage-tracker-advance! (mut tracker) scene viewport)
                 bounds (load (field removed bounds))]
             (assert (load (field removed valid)))
             (assert (and (> (load (field bounds x)) 19.99)
                          (and (> (load (field bounds w)) 29.99)
                               (> (load (field bounds h)) 19.99)))))
           (let [empty (damage-tracker-advance! (mut tracker) scene viewport)]
             (assert (not (load (field empty valid)))))
           (damage-tracker-free! (mut tracker))
           (scene-free! (mut scene))))

(deftest retained-damage-tracker-skips-identical-records-and-catches-paint-only-changes
         (let [(mut scene) (scene-new)
               (mut tracker) (damage-tracker-new)
               viewport (rect 0.0 0.0 400.0 300.0)]
           (scene-rect! (mut scene) (rect 20.0 30.0 50.0 40.0) (rgb 1.0 0.0 0.0) 71)
           (let [first (damage-tracker-advance! (mut tracker) scene viewport)
                 bounds (load (field first bounds))]
             (assert (load (field first valid)))
             (assert (and (> (load (field bounds w)) 399.9)
                          (> (load (field bounds h)) 299.9))))
           ; Rebuilding the same transient scene reuses the backing pixels.
           (scene-clear! (mut scene))
           (scene-rect! (mut scene) (rect 20.0 30.0 50.0 40.0) (rgb 1.0 0.0 0.0) 71)
           (let [unchanged (damage-tracker-advance! (mut tracker) scene viewport)]
             (assert (not (load (field unchanged valid)))))
           ; A color-only change must repaint even though geometry is identical.
           (scene-clear! (mut scene))
           (scene-rect! (mut scene) (rect 20.0 30.0 50.0 40.0) (rgb 0.0 0.0 1.0) 71)
           (let [changed (damage-tracker-advance! (mut tracker) scene viewport)
                 bounds (load (field changed bounds))]
             (assert (load (field changed valid)))
             (assert (and (> (load (field bounds x)) 19.9)
                          (and (< (load (field bounds x)) 20.1)
                               (and (> (load (field bounds w)) 49.9)
                                    (< (load (field bounds w)) 50.1))))))
           (damage-tracker-free! (mut tracker))
           (scene-free! (mut scene))))

(deftest visible-sprite-runs-stop-at-culled-compatible-records
         (let [(mut scene) (scene-new)
               texture (primitive/cast (ptr i8) 55)]
           (scene-texture! (mut scene)
                           (rect 0.0 0.0 10.0 10.0)
                           (rgb 1.0 1.0 1.0)
                           texture
                           1)
           (scene-texture! (mut scene)
                           (rect 200.0 0.0 10.0 10.0)
                           (rgb 1.0 1.0 1.0)
                           texture
                           2)
           (scene-texture! (mut scene)
                           (rect 20.0 0.0 10.0 10.0)
                           (rgb 1.0 1.0 1.0)
                           texture
                           3)
           (let [sprites (load (field scene text))
                 viewport (rect 0.0 0.0 100.0 100.0)]
             (assert-eq (metal/visible-sprite-run-end sprites 0 3 viewport) 1)
             (assert-eq (metal/visible-sprite-run-end sprites 2 3 viewport) 3))
           (scene-free! (mut scene))))

(deftest visible-shadow-compaction-preserves-order
         (let [(mut scene) (scene-new)
               viewport (rect 0.0 0.0 100.0 100.0)
               output (primitive/alloc-stack (array Primitive 3))]
           (scene-shadow! (mut scene)
                          (rect 10.0 10.0 10.0 10.0)
                          0.0
                          0.0
                          2.0
                          0.0
                          0.0
                          (rgba 0.0 0.0 0.0 0.5)
                          11)
           (scene-shadow! (mut scene)
                          (rect 300.0 10.0 10.0 10.0)
                          0.0
                          0.0
                          2.0
                          0.0
                          0.0
                          (rgba 0.0 0.0 0.0 0.5)
                          22)
           (scene-shadow! (mut scene)
                          (rect 40.0 10.0 10.0 10.0)
                          0.0
                          0.0
                          2.0
                          0.0
                          0.0
                          (rgba 0.0 0.0 0.0 0.5)
                          33)
           (let [shadows (load (field scene shadows))]
             (assert-eq (metal/visible-primitive-count shadows viewport) 2)
             (assert-eq (metal/compact-visible-primitives! (primitive/cast (ptr i8) output)
                                                           shadows
                                                           viewport)
                        2)
             (assert-eq (load (field (primitive/index output 0) id)) 11)
             (assert-eq (load (field (primitive/index output 1) id)) 33))
           (scene-free! (mut scene))))

(deftest paths-preserve-paint-order-and-scene-ownership
         (let [(mut polygon) (path/path-new)
               (mut scene) (scene-new)]
           (path/path-move-to! (mut polygon) 0.0 0.0)
           (path/path-line-to! (mut polygon) 40.0 0.0)
           (path/path-line-to! (mut polygon) 20.0 30.0)
           (path/path-close! (mut polygon))
           (let [(mut tessellation) (path/path-tessellate polygon)]
             (scene-rect! (mut scene) (rect 0.0 0.0 10.0 10.0) (rgb 1.0 0.0 0.0) 1)
             (scene-path-fill! (mut scene) tessellation (rgb 0.0 1.0 0.0) 2)
             (scene-linear-gradient! (mut scene)
                                     (rect 0.0 0.0 10.0 10.0)
                                     (rgb 0.0 0.0 0.0)
                                     (rgb 1.0 1.0 1.0)
                                     90.0
                                     0.0
                                     3)
             (assert-eq (al/al-len [path/PathPoint] (load (field scene path-vertices))) 3)
             (assert-eq (al/al-len [PathDraw] (load (field scene path-draws))) 1)
             (let [commands (load (field scene paint-commands))]
               (assert-eq (al/al-len [PaintCommand] commands) 3)
               (let [first (al/al-get [PaintCommand] commands 0)
                     second (al/al-get [PaintCommand] commands 1)
                     third (al/al-get [PaintCommand] commands 2)]
                 (assert-eq (load (field first kind)) 0)
                 (assert-eq (load (field second kind)) 1)
                 (assert-eq (load (field third kind)) 0))
               (assert-eq (metal/paint-run-end commands 0 3) 1))
             (path/tessellation-free! (mut tessellation)))
           (path/path-free! (mut polygon))
           (scene-free! (mut scene))))

(deftest text-atlas-shelf-allocation-wraps-and-fails-atomically
         (let [(mut atlas) (primitive/zeroed text/TextAtlas)]
           (store! atlas
                   (text/TextAtlas
                     :texture (primitive/cast (ptr i8) 0)
                     :device (primitive/cast (ptr i8) 0)
                     :width 64
                     :height 40
                     :cursor-x 2
                     :cursor-y 2
                     :row-height 0
                     :padding 2
                     :scale 1.0
                     :pages (al/al-new [text/AtlasPage] (alloc/malloc-allocator))
                     :active-page -1
                     :max-pages 1
                     :epoch 0
                     :evictions 0
                     :glyphs (al/al-new [text/GlyphEntry] (alloc/malloc-allocator))))
           (let [first (text/text-atlas-reserve! (mut atlas) 20 10)
                 second (text/text-atlas-reserve! (mut atlas) 20 12)
                 third (text/text-atlas-reserve! (mut atlas) 20 8)]
             (assert (load (field first valid)))
             (assert-eq (load (field first x)) 2)
             (assert-eq (load (field second x)) 24)
             (assert-eq (load (field third x)) 2)
             (assert-eq (load (field third y)) 16)
             (let [prior-x (load (field atlas cursor-x))
                   prior-y (load (field atlas cursor-y))
                   failed (text/text-atlas-reserve! (mut atlas) 80 8)]
               (assert (not (load (field failed valid))))
               (assert-eq (load (field atlas cursor-x)) prior-x)
               (assert-eq (load (field atlas cursor-y)) prior-y)))
           (text/text-atlas-free! (mut atlas))))

(deftest shaped-glyph-runs-cache-and-emit-metal-atlas-sprites
         (let [device (MTLCreateSystemDefaultDevice)
               (mut atlas) (text/text-atlas-new device 512 256 2 1.0)
               (mut first) (text/text-shape-line! (mut atlas) c"office affine" 18.0)]
           (assert (text/text-atlas-valid? atlas))
           (assert (load (field first valid)))
           (assert (> (load (field first width)) 0.0))
           (assert (> (al/al-len [text/ShapedGlyph] (load (field first glyphs))) 0))
           (assert-eq (load (field first length)) 13)
           (assert (> (text/shaped-line-x-for-index first 6) 0.0))
           (assert-eq (text/shaped-line-index-for-x first (+ (load (field first width)) 10.0)) 13)
           (let [selection (text/shaped-line-selection-bounds first 6 0 10.0 12.0)]
             (assert (> (load (field selection w)) 0.0))
             (assert (> (load (field selection h)) 0.0)))
           (let [cached (text/text-atlas-glyph-count atlas)
                 (mut second) (text/text-shape-line! (mut atlas) c"office affine" 18.0)
                 (mut scene) (scene-new)]
             (assert (> cached 0))
             (assert-eq (text/text-atlas-glyph-count atlas) cached)
             (let [(mut unicode) (text/text-shape-line! (mut atlas) c"a😀b" 18.0)]
               (do
                 (assert-eq (load (field unicode length)) 6)
                 (let [glyphs (load (field unicode glyphs))
                       (mut saw-after-emoji) false]
                   (do
                     (for [i 0 (al/al-len [text/ShapedGlyph] glyphs)]
                       (let [glyph (primitive/index (load (field glyphs data)) i)]
                         (if (= (load (field glyph string-index)) 5)
                             (store! saw-after-emoji true)
                             0)))
                     (assert (load saw-after-emoji))))
                 (text/shaped-line-free! (mut unicode))))
             (text/paint-shaped-line! (mut scene) second 10.0 12.0 (rgb 1.0 1.0 1.0) 400)
             (assert (> (al/al-len [TextSprite] (load (field scene text))) 0))
             (scene-free! (mut scene))
             (text/shaped-line-free! (mut second)))
           (text/shaped-line-free! (mut first))
           (text/text-atlas-free! (mut atlas))))

(deftest bounded-glyph-atlas-rolls-pages-evicts-lru-and-keeps-shaped-lines-alive
         (let [device (MTLCreateSystemDefaultDevice)
               (mut atlas) (text/text-atlas-new-bounded device 96 96 2 1.0 2)
               (mut line)
                 (text/text-shape-line! (mut atlas)
                                        c"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
                                        24.0)
               (mut scene) (scene-new)]
           (assert (load (field line valid)))
           (assert-eq (text/text-atlas-page-count atlas) 2)
           (assert (> (text/text-atlas-eviction-count atlas) 0))
           ; The cache is compacted when a page is reused instead of retaining
           ; stale keys forever.
           (assert (< (text/text-atlas-glyph-count atlas)
                      (al/al-len [text/ShapedGlyph] (load (field line glyphs)))))
           ; Atlas ownership can disappear before a retained layout: every
           ; shaped glyph independently keeps its referenced page alive.
           (text/text-atlas-free! (mut atlas))
           (assert (> (text/paint-shaped-line! (mut scene)
                                               line
                                               4.0
                                               4.0
                                               (rgb 1.0 1.0 1.0)
                                               8800)
                      0))
           (let [sprites (load (field scene text))]
             (assert (> (al/al-len [TextSprite] sprites) 0))
             (for [i 0 (al/al-len [TextSprite] sprites)]
               (assert (!= (primitive/cast i64
                                           (load (field (primitive/index (load (field sprites data))
                                                                         i)
                                                        texture)))
                           0))))
           (scene-free! (mut scene))
           (text/shaped-line-free! (mut line))))

(deftest shaped-line-end-truncation-is-width-dependent-and-source-preserving
         (let [device (MTLCreateSystemDefaultDevice)
               (mut atlas) (text/text-atlas-new device 512 256 2 1.0)
               (mut source) (text/text-shape-line! (mut atlas) c"configuration.json" 18.0)
               source-count (al/al-len [text/ShapedGlyph] (load (field source glyphs)))
               source-width (load (field source width))
               (mut narrow) (text/text-truncate-line-end! (mut atlas) source 18.0 (* source-width 0.55))
               (mut start) (text/text-truncate-line-start! (mut atlas) source 18.0 (* source-width 0.55))
               (mut middle) (text/text-truncate-line-middle! (mut atlas) source 18.0 (* source-width 0.55))
               (mut wide) (text/text-truncate-line-end! (mut atlas) source 18.0 (+ source-width 10.0))]
           (do
             (assert (load (field narrow valid)))
             (assert (< (load (field narrow width)) (* source-width 0.56)))
             (assert (< (al/al-len [text/ShapedGlyph] (load (field narrow glyphs))) source-count))
             (let [glyphs (load (field narrow glyphs))
                   last
                     (primitive/index (load (field glyphs data))
                                      (- (al/al-len [text/ShapedGlyph] glyphs) 1))]
               (assert-eq (load (field last string-index)) (load (field source length))))
             (let [glyphs (load (field start glyphs))
                   count (al/al-len [text/ShapedGlyph] glyphs)
                   first (primitive/index (load (field glyphs data)) 0)
                   last (primitive/index (load (field glyphs data)) (- count 1))]
               (do
                 (assert (< (load (field start width)) (* source-width 0.56)))
                 (assert-eq (load (field first string-index)) 0)
                 (assert (> (load (field last string-index)) 8))))
             (let [glyphs (load (field middle glyphs))
                   count (al/al-len [text/ShapedGlyph] glyphs)
                   first (primitive/index (load (field glyphs data)) 0)
                   last (primitive/index (load (field glyphs data)) (- count 1))
                   (mut previous-x) (primitive/cast f32 -1.0)]
               (do
                 (assert (< (load (field middle width)) (* source-width 0.56)))
                 (assert-eq (load (field first string-index)) 0)
                 (assert (> (load (field last string-index)) 8))
                 (for [i 0 count]
                   (let [glyph (primitive/index (load (field glyphs data)) i)]
                     (do
                       (assert (>= (load (field glyph pen-x)) (load previous-x)))
                       (store! previous-x (load (field glyph pen-x))))))))
             ;; A later, wider layout starts from the immutable source shape.
             (assert-eq (al/al-len [text/ShapedGlyph] (load (field source glyphs))) source-count)
             (assert-eq (al/al-len [text/ShapedGlyph] (load (field wide glyphs))) source-count)
             (assert (and (> (load (field wide width)) (- source-width 0.001))
                          (< (load (field wide width)) (+ source-width 0.001))))
             (text/shaped-line-free! (mut wide))
             (text/shaped-line-free! (mut middle))
             (text/shaped-line-free! (mut start))
             (text/shaped-line-free! (mut narrow))
             (text/shaped-line-free! (mut source))
             (text/text-atlas-free! (mut atlas)))))

(deftest shaped-paragraph-wraps-unicode-newlines-and-maps-points
         (let [device (MTLCreateSystemDefaultDevice)
               (mut atlas) (text/text-atlas-new device 1024 512 2 1.0)
               content c"alpha beta 😀 gamma\nsecond line wraps"
               (mut paragraph) (text/text-shape-paragraph! (mut atlas) content 16.0 92.0 22.0 0)
               (mut clamped) (text/text-shape-paragraph! (mut atlas) content 16.0 92.0 22.0 2)
               (mut scene) (scene-new)]
           (do
             (assert (>= (text/shaped-paragraph-line-count paragraph) 3))
             (assert-eq (text/shaped-paragraph-line-count clamped) 2)
             (assert (> (load (field paragraph height)) 60.0))
             (let [lines (load (field paragraph lines))]
               (for [i 0 (al/al-len [text/ParagraphLine] lines)]
                 (let [item (primitive/index (load (field lines data)) i)]
                   (assert (<= (load (field (field item line) width)) 93.0)))))
             (let [lines (load (field clamped lines))
                   last-line
                     (primitive/index (load (field lines data))
                                      (- (al/al-len [text/ParagraphLine] lines) 1))
                   glyphs (load (field (field last-line line) glyphs))
                   last-glyph
                     (primitive/index (load (field glyphs data))
                                      (- (al/al-len [text/ShapedGlyph] glyphs) 1))]
               (do
                 ;; The final visible line owns an ellipsis and maps hidden input
                 ;; through the paragraph end without adding another visual line.
                 (assert-eq (load (field last-line byte-end))
                            (load (field clamped length)))
                 (assert-eq (load (field last-glyph string-index))
                            (load (field (field last-line line) length)))
                 (assert (<= (load (field (field last-line line) width)) 93.0))))
             (let [second-index (text/shaped-paragraph-index-for-point paragraph 0.0 23.0)
                   end-position
                     (text/shaped-paragraph-position-for-index paragraph
                                                               (load (field paragraph length)))
                   before-newline (text/shaped-paragraph-position-for-index paragraph 20)
                   after-newline (text/shaped-paragraph-position-for-index paragraph 22)]
               (do
                 (assert (> second-index 0))
                 (assert (> (load (field end-position y)) 20.0))
                 (assert (> (load (field after-newline y))
                            (load (field before-newline y))))))
             (text/paint-shaped-paragraph! (mut scene)
                                           paragraph
                                           10.0
                                           12.0
                                           (rgb 1.0 1.0 1.0)
                                           6000)
             (assert (> (al/al-len [TextSprite] (load (field scene text))) 0))
             (let [cached (text/text-atlas-glyph-count atlas)
                   (mut repeated) (text/text-shape-paragraph! (mut atlas) content 16.0 92.0 22.0 0)]
               (do
                 (assert-eq (text/text-atlas-glyph-count atlas) cached)
                 (text/shaped-paragraph-free! (mut repeated))))
             (scene-free! (mut scene))
             (text/shaped-paragraph-free! (mut clamped))
             (text/shaped-paragraph-free! (mut paragraph))
             (text/text-atlas-free! (mut atlas)))))

(deftest editable-text-preserves-utf8-boundaries-and-replaces-selection
         (let [(mut field) (editable/text-field-new c"a😀b")]
           (assert-eq (editable/text-field-length field) 6)
           (assert-eq (editable/text-field-move-left! (mut field) false) 5)
           (assert (editable/text-field-backspace! (mut field)))
           (assert-eq (editable/text-field-length field) 2)
           (assert-eq (editable/text-field-caret field) 1)
           (let [bytes (primitive/cast (ptr u8) (editable/text-field-bytes field))]
             (assert-eq (load (primitive/index bytes 0)) 97)
             (assert-eq (load (primitive/index bytes 1)) 98)
             (assert-eq (load (primitive/index bytes 2)) 0))
           (editable/text-field-select! (mut field) 0 2)
           (editable/text-field-insert! (mut field) c"coil")
           (assert-eq (editable/text-field-length field) 4)
           (assert-eq (editable/text-field-caret field) 4)
           (let [bytes (primitive/cast (ptr u8) (editable/text-field-bytes field))]
             (assert-eq (load (primitive/index bytes 0)) 99)
             (assert-eq (load (primitive/index bytes 3)) 108)
             (assert-eq (load (primitive/index bytes 4)) 0))
           (editable/text-field-free! (mut field))))

(deftest editable-navigation-and-deletion-preserve-extended-grapheme-clusters
         ; Boundaries: A | e+acute | family ZWJ sequence | US flag | Z
         ; UTF-8:      0 1       4                    29      37 38
         (let [(mut field) (editable/text-field-new c"Aé👨‍👩‍👧‍👦🇺🇸Z")]
           (assert-eq (editable/text-field-length field) 38)
           (assert-eq (text/utf8-index-to-utf16 (editable/text-field-bytes field) 29) 14)
           (assert-eq (text/utf16-index-to-utf8 (editable/text-field-bytes field) 14) 29)
           (assert-eq (editable/text-field-move-left! (mut field) false) 37)
           (assert-eq (editable/text-field-move-left! (mut field) false) 29)
           (assert-eq (editable/text-field-move-left! (mut field) false) 4)
           (assert-eq (editable/text-field-move-left! (mut field) false) 1)
           (assert-eq (editable/text-field-move-left! (mut field) false) 0)
           (assert-eq (editable/text-field-move-right! (mut field) false) 1)
           (assert-eq (editable/text-field-move-right! (mut field) false) 4)
           (assert-eq (editable/text-field-move-right! (mut field) false) 29)
           ; Backspace removes all seven code points in the family at once.
           (assert (editable/text-field-backspace! (mut field)))
           (assert-eq (editable/text-field-caret field) 4)
           (assert-eq (editable/text-field-length field) 13)
           ; Forward delete removes both regional indicators in the flag.
           (assert (editable/text-field-delete-forward! (mut field)))
           (assert-eq (editable/text-field-caret field) 4)
           (assert-eq (editable/text-field-length field) 5)
           ; The decomposed e + acute remains one navigation/deletion unit.
           (assert (editable/text-field-backspace! (mut field)))
           (assert-eq (editable/text-field-caret field) 1)
           (assert-eq (editable/text-field-length field) 2)
           (editable/text-field-free! (mut field))))

(deftest editable-marked-text-replaces-composition-and-commits-utf8
         (let [(mut field) (editable/text-field-new c"ab")]
           (editable/text-field-collapse! (mut field) 1)
           (editable/text-field-set-marked! (mut field) c"😀" 2 0)
           (assert (editable/text-field-has-marked? field))
           (assert-eq (editable/text-field-marked-start field) 1)
           (assert-eq (editable/text-field-marked-end field) 5)
           (assert-eq (editable/text-field-caret field) 5)
           ;; A subsequent composition update replaces the previous marked span.
           (editable/text-field-set-marked! (mut field) c"é" 1 0)
           (assert-eq (editable/text-field-marked-start field) 1)
           (assert-eq (editable/text-field-marked-end field) 3)
           (editable/text-field-commit! (mut field) c"好")
           (assert (not (editable/text-field-has-marked? field)))
           (assert-eq (editable/text-field-length field) 5)
           (assert-eq (editable/text-field-caret field) 4)
           (let [bytes (primitive/cast (ptr u8) (editable/text-field-bytes field))]
             (assert-eq (load (primitive/index bytes 0)) 97)
             (assert-eq (load (primitive/index bytes 1)) 229)
             (assert-eq (load (primitive/index bytes 4)) 98)
             (assert-eq (load (primitive/index bytes 5)) 0))
           (editable/text-field-free! (mut field))))

(deftest native-text-input-view-implements-composition-protocol
         (let [(mut field) (editable/text-field-new c"ab")
               (mut bridge) (ime/text-input-bridge-new (mut field))
               view (ime/text-input-view-new (mut bridge) 320.0 80.0)
               protocol (objc_getProtocol c"NSTextInputClient")]
           (do
             (assert (!= (msg i8 view (sel c"conformsToProtocol:") [(ptr i8)] protocol)
                         (primitive/cast i8 0)))
             (assert (!= (msg i8 view (sel c"respondsToSelector:") [(ptr i8)] (sel c"copy:"))
                         (primitive/cast i8 0)))
             (let [actual (primitive/alloc-static ime/NSRange)
                   attributed
                     (msg (ptr i8)
                          view
                          (sel c"attributedSubstringForProposedRange:actualRange:")
                          [ime/NSRange (ptr ime/NSRange)]
                          (ime/NSRange :location 1 :length 1)
                          actual)
                   substring (msg (ptr i8) attributed (sel c"string") [])
                   bytes (primitive/cast (ptr u8) (msg (ptr i8) substring (sel c"UTF8String") []))]
               (do
                 (assert-eq (load (field actual location)) 1)
                 (assert-eq (load (field actual length)) 1)
                 (assert-eq (load bytes) 98)))
             (editable/text-field-collapse! (mut field) 1)
             (msg i64
                  view
                  (sel c"setMarkedText:selectedRange:replacementRange:")
                  [(ptr i8) ime/NSRange ime/NSRange]
                  (msg (ptr i8)
                       (class c"NSString")
                       (sel c"stringWithUTF8String:")
                       [(ptr i8)]
                       c"😀")
                  (ime/NSRange :location 2 :length 0)
                  (ime/NSRange :location (primitive/cast u64 -1) :length 0))
             (assert (editable/text-field-has-marked? field))
             (assert-eq (editable/text-field-marked-start field) 1)
             (assert-eq (editable/text-field-marked-end field) 5)
             (msg i64
                  view
                  (sel c"insertText:replacementRange:")
                  [(ptr i8) ime/NSRange]
                  (msg (ptr i8)
                       (class c"NSString")
                       (sel c"stringWithUTF8String:")
                       [(ptr i8)]
                       c"好")
                  (ime/NSRange :location (primitive/cast u64 -1) :length 0))
             (assert (not (editable/text-field-has-marked? field)))
             (assert-eq (editable/text-field-length field) 5)
             (assert-eq (editable/text-field-caret field) 4)
             (msg i64 view (sel c"release") [])
             (editable/text-field-free! (mut field)))))

(deftest native-accessibility-tree-exposes-semantics-and-actions
         (let [(mut field) (editable/text-field-new c"field")
               (mut bridge) (ime/text-input-bridge-new (mut field))
               view (ime/text-input-view-new (mut bridge) 320.0 80.0)
               (mut tree) (access/access-tree-new 2)]
           (do
             (assert-eq (access/access-tree-add! (mut tree)
                                                 42
                                                 (access/RoleButton)
                                                 (rect 10.0 12.0 100.0 30.0)
                                                 c"Primary action"
                                                 c"primary-action")
                        0)
             (let [node (access/access-tree-node (mut tree) 0)]
               (do
                 (store! (field node enabled) true)
                 (store! (field node focused) true)))
             (access/access-tree-attach! (mut tree) view)
             (let [children (msg (ptr i8) view (sel c"accessibilityChildren") [])
                   child (msg (ptr i8) children (sel c"objectAtIndex:") [u64] 0)
                   role (msg (ptr i8) child (sel c"accessibilityRole") [])
                   label (msg (ptr i8) child (sel c"accessibilityLabel") [])
                   identifier (msg (ptr i8) child (sel c"accessibilityIdentifier") [])
                   role-bytes (primitive/cast (ptr u8) (msg (ptr i8) role (sel c"UTF8String") []))
                   label-bytes (primitive/cast (ptr u8) (msg (ptr i8) label (sel c"UTF8String") []))
                   id-bytes (primitive/cast (ptr u8) (msg (ptr i8) identifier (sel c"UTF8String") []))
                   frame (msg AccessRect64 child (sel c"accessibilityFrame") [])]
               (do
                 (assert-eq (msg u64 children (sel c"count") []) 1)
                 (assert-eq (load role-bytes) 65)
                 (assert-eq (load label-bytes) 80)
                 (assert-eq (load id-bytes) 112)
                 (assert (> (load (field frame w)) 99.9))
                 (assert (!= (msg i8 child (sel c"isAccessibilityFocused") [])
                             (primitive/cast i8 0)))
                 (assert (!= (msg i8 child (sel c"accessibilityPerformPress") [])
                             (primitive/cast i8 0)))))
             (assert-eq (access/access-tree-take-action! (mut tree))
                        (| (primitive/cast i64 (access/ActionPress))
                           (<< (primitive/cast i64 42) 32)))
             (assert-eq (access/access-tree-take-action! (mut tree)) 0)
             (access/access-tree-free! (mut tree))
             (msg i64 view (sel c"release") [])
             (editable/text-field-free! (mut field)))))

(deftest native-accessibility-text-uses-utf16-selection-and-layout-geometry
         (let [device (MTLCreateSystemDefaultDevice)
               (mut atlas) (text/text-atlas-new device 256 256 2 1.0)
               (mut field) (editable/text-field-new c"A😀\nBC")
               (mut paragraph)
                 (text/text-shape-paragraph! (mut atlas)
                                             (editable/text-field-bytes field)
                                             16.0
                                             80.0
                                             20.0
                                             0)
               (mut bridge) (ime/text-input-bridge-new (mut field))
               view (ime/text-input-view-new (mut bridge) 160.0 100.0)
               (mut tree) (access/access-tree-new 1)]
           (do
             (access/access-tree-add! (mut tree)
                                      7
                                      (access/RoleTextField)
                                      (rect 8.0 8.0 120.0 70.0)
                                      c"Unicode editor"
                                      c"unicode-editor")
             (let [node (access/access-tree-node (mut tree) 0)]
               (do
                 (access/access-node-bind-editable-text! node
                                                         (mut field)
                                                         (mut paragraph)
                                                         12.0
                                                         12.0)
                 (access/access-node-set-text! node
                                               (editable/text-field-bytes field)
                                               (editable/text-field-revision field))))
             (access/access-tree-attach! (mut tree) view)
             (let [children (msg (ptr i8) view (sel c"accessibilityChildren") [])
                   child (msg (ptr i8) children (sel c"objectAtIndex:") [u64] 0)]
               (do
                 (assert-eq (msg i64 child (sel c"accessibilityNumberOfCharacters") []) 6)
                 ; Select the surrogate-pair emoji through an NSRange expressed
                 ; in UTF-16, then observe UTF-8 byte offsets in the Coil editor.
                 (msg i64
                      child
                      (sel c"setAccessibilitySelectedTextRange:")
                      [AccessRange64]
                      (AccessRange64 :location 1 :length 2))
                 (assert-eq (editable/text-field-selection-start field) 1)
                 (assert-eq (editable/text-field-selection-end field) 5)
                 (let [selected (msg (ptr i8) child (sel c"accessibilitySelectedText") [])
                       selected-bytes
                         (primitive/cast (ptr u8)
                                         (msg (ptr i8) selected (sel c"UTF8String") []))
                       suffix
                         (msg (ptr i8)
                              child
                              (sel c"accessibilityStringForRange:")
                              [AccessRange64]
                              (AccessRange64 :location 4 :length 2))
                       suffix-bytes
                         (primitive/cast (ptr u8)
                                         (msg (ptr i8) suffix (sel c"UTF8String") []))
                       attributed
                         (msg (ptr i8)
                              child
                              (sel c"accessibilityAttributedStringForRange:")
                              [AccessRange64]
                              (AccessRange64 :location 4 :length 2))
                       multi-line-frame
                         (msg AccessRect64
                              child
                              (sel c"accessibilityFrameForRange:")
                              [AccessRange64]
                              (AccessRange64 :location 1 :length 4))]
                   (do
                     (assert-eq (load selected-bytes) 240)
                     (assert-eq (load suffix-bytes) 66)
                     (assert-eq (load (primitive/index suffix-bytes 1)) 67)
                     (assert-eq (msg u64 attributed (sel c"length") []) 2)
                     (assert (> (load (field multi-line-frame h)) 39.9))))
                 (assert (!= (msg i8
                                  child
                                  (sel c"respondsToSelector:")
                                  [(ptr i8)]
                                  (sel c"accessibilityRangeForPosition:"))
                             (primitive/cast i8 0)))))
             (access/access-tree-free! (mut tree))
             (msg i64 view (sel c"release") [])
             (text/shaped-paragraph-free! (mut paragraph))
             (text/text-atlas-free! (mut atlas))
             (editable/text-field-free! (mut field)))))

(deftest pasteboard-and-drop-state-own-utf8-payloads
         (let [pasteboard (drag/pasteboard-new-unique)
               (mut clipboard) (drag/clipboard-text-new)
               (mut payload) (drag/drag-payload-new)
               (mut drop) (drag/drop-state-new)
               (mut field) (editable/text-field-new c"field")
               (mut bridge) (ime/text-input-bridge-new (mut field))
               view (ime/text-input-view-new (mut bridge) 320.0 80.0)]
           (do
             (assert (drag/pasteboard-write-text! pasteboard c"Coil 😀 drop"))
             (assert (drag/pasteboard-read-text! pasteboard (mut clipboard)))
             (let [bytes (primitive/cast (ptr u8) (drag/clipboard-text-bytes clipboard))]
               (do
                 (assert-eq (load bytes) 67)
                 (assert-eq (load (primitive/index bytes 5)) 240)))
             (drag/drag-payload-add-text! (mut payload) c"Coil 😀 drop")
             (drag/drag-payload-add-file! (mut payload) c"/tmp/coil drag item.txt")
             (assert (drag/pasteboard-write-payload! pasteboard payload))
             (assert (drag/drop-state-accept-pasteboard! (mut drop) pasteboard))
             (assert-eq (drag/drop-state-revision drop) 1)
             (assert-eq (drag/drop-state-length drop) 14)
             (assert-eq (drag/drop-state-item-count drop) 2)
             (assert-eq (drag/drop-state-item-kind drop 0)
                        (primitive/cast i32 drag/DropText))
             (assert-eq (drag/drop-state-item-kind drop 1)
                        (primitive/cast i32 drag/DropFile))
             (assert-eq (drag/drop-state-item-length drop 1) 23)
             (let [bytes (primitive/cast (ptr u8) (drag/drop-state-bytes drop))]
               (assert-eq (load (primitive/index bytes 5)) 240))
             (let [file-bytes (primitive/cast (ptr u8) (drag/drop-state-item-bytes drop 1))]
               (assert-eq (load file-bytes) 47))
             (drag/drop-state-attach! (mut drop) view)
             (assert (!= (msg i8
                              view
                              (sel c"respondsToSelector:")
                              [(ptr i8)]
                              (sel c"performDragOperation:"))
                         (primitive/cast i8 0)))
             (assert (!= (msg i8
                              view
                              (sel c"respondsToSelector:")
                              [(ptr i8)]
                              (sel c"draggingSession:sourceOperationMaskForDraggingContext:"))
                         (primitive/cast i8 0)))
             (assert (not (drag/drag-source-begin! (mut drop)
                                                   (primitive/cast (ptr i8) 0)
                                                   payload
                                                   (drag/DragFrame
                                                     :x 0.0
                                                     :y 0.0
                                                     :width 80.0
                                                     :height 24.0))))
             (assert (not (drag/drag-source-active? drop)))
             (drag/drop-state-free! (mut drop))
             (drag/drag-payload-free! (mut payload))
             (drag/clipboard-text-free! (mut clipboard))
             (msg i64 view (sel c"release") [])
             (editable/text-field-free! (mut field)))))

(deftest display-clock-starts-signals-and-stops-safely
         (let [(mut frame-clock) (clock/frame-clock-new)]
           (do
             (if (clock/frame-clock-available? frame-clock)
                 (do
                   (assert (clock/frame-clock-set-active! (mut frame-clock) true))
                   (assert (clock/frame-clock-active? frame-clock))
                   (assert (clock/frame-clock-wait! frame-clock))
                   (assert (not (clock/frame-clock-set-active! (mut frame-clock) false)))
                   (assert (not (clock/frame-clock-active? frame-clock))))
                 ;; Headless/locked-screen environments take the bounded fallback.
                 (assert (not (clock/frame-clock-wait! frame-clock))))
             (clock/frame-clock-free! (mut frame-clock)))))

(deftest animation-timelines-ease-repeat-autoreverse-and-finish-exactly
         (let [ease (animation/easing-ease-in-out)
               base (animation/animation-new 10.0 0.5 2.0 ease)
               repeated (animation/animation-repeat base 2 true)
               before (animation/animation-sample repeated 10.25)
               quarter (animation/animation-sample repeated 11.0)
               turn (animation/animation-sample repeated 12.5)
               reverse-quarter (animation/animation-sample repeated 13.0)
               done (animation/animation-sample repeated 14.5)]
           (do
             (assert (< (load (field before value)) 0.0001))
             (assert (and (> (load (field quarter value)) 0.12)
                          (< (load (field quarter value)) 0.13)))
             (assert (> (load (field turn value)) 0.9999))
             (assert (and (> (load (field reverse-quarter value)) 0.87)
                          (< (load (field reverse-quarter value)) 0.88)))
             (assert (load (field done finished)))
             (assert (< (load (field done value)) 0.0001))
             (assert-eq (load (field done cycle)) 1)
             ;; Arbitrary cubic curves remain bounded and monotonic for CSS x controls.
             (let [custom (animation/easing-cubic-bezier 0.1 0.8 0.9 0.2)
                   (mut previous) 0.0]
               (for [i 0 101]
                 (let [value
                         (animation/easing-sample custom
                                                  (/ (primitive/cast f64 i) 100.0))]
                   (do
                     (assert (>= value (load previous)))
                     (assert (and (>= value 0.0) (<= value 1.0)))
                     (store! previous value))))))))

(deftest redirectable-springs-preserve-momentum-and-converge-with-irregular-ticks
         (let [config (animation/spring-config 170.0 14.0 1.0 0.0005)
               (mut spring) (animation/spring-new 0.0 1.0 config)]
           (do
             (for [i 0 12] (animation/spring-step! (mut spring) 0.016))
             (let [before (animation/spring-value spring)
                   velocity (load (field spring velocity))]
               (do
                 (assert (> before 0.5))
                 (assert (or (> velocity 0.01) (< velocity -0.01)))))
             (animation/spring-retarget! (mut spring) -0.5)
             ;; A long visibility pause is bounded internally to 100 ms.
             (animation/spring-step! (mut spring) 2.0)
             (for [i 0 1200]
               (animation/spring-step! (mut spring)
                                       (if (= (% i 3) 0) 0.005 0.011)))
             (assert (not (animation/spring-active? spring)))
             (assert (and (> (animation/spring-value spring) -0.5001)
                          (< (animation/spring-value spring) -0.4999))))))

(deftest editable-text-field-paints-selection-caret-and-hitbox
         (let [device (MTLCreateSystemDefaultDevice)
               (mut atlas) (text/text-atlas-new device 512 256 2 1.0)
               (mut field) (editable/text-field-new c"editable")
               (mut line)
                 (text/text-shape-line! (mut atlas)
                                        (editable/text-field-bytes field)
                                        16.0)
               (mut scene) (scene-new)]
           (set! (.focused field) true)
           (editable/text-field-select! (mut field) 1 5)
           (editable/text-field-paint! (mut scene)
                                       field
                                       line
                                       (rect 8.0 12.0 220.0 36.0)
                                       700)
           (assert (>= (al/al-len [Primitive] (load (field scene items))) 2))
           (assert (> (al/al-len [TextSprite] (load (field scene text))) 0))
           (assert-eq (al/al-len [Hitbox] (load (field scene hitboxes))) 1)
           (scene-clear! (mut scene))
           (editable/text-field-collapse! (mut field) 4)
           (editable/text-field-paint! (mut scene)
                                       field
                                       line
                                       (rect 8.0 12.0 220.0 36.0)
                                       700)
           ;; Background plus caret when the selection is collapsed.
           (assert (>= (al/al-len [Primitive] (load (field scene items))) 2))
           (scene-free! (mut scene))
           (text/shaped-line-free! (mut line))
           (editable/text-field-free! (mut field))
           (text/text-atlas-free! (mut atlas))))

(deftest editable-text-area-navigates-and-paints-retained-lines
         (let [device (MTLCreateSystemDefaultDevice)
               (mut atlas) (text/text-atlas-new device 1024 512 2 1.0)
               (mut area) (editable/text-area-new c"first line with width\nsecond 😀 line is longer\nthird line")
               field-value (editable/text-area-field area)
               (mut paragraph)
                 (text/text-shape-paragraph! (mut atlas)
                                             (editable/text-field-bytes field-value)
                                             16.0
                                             150.0
                                             20.0
                                             0)
               (mut scene) (scene-new)]
           (assert (>= (text/shaped-paragraph-line-count paragraph) 3))
           (editable/text-field-collapse! (mut (.field area)) 4)
           (let [before
                   (text/shaped-paragraph-position-for-index paragraph
                                                             (editable/text-field-caret (editable/text-area-field area)))]
             (editable/text-area-move-down! (mut area) paragraph false)
             (let [after
                     (text/shaped-paragraph-position-for-index paragraph
                                                               (editable/text-field-caret (editable/text-area-field area)))]
               (assert (> (load (field after y)) (load (field before y))))))
           (let [down-index (editable/text-field-caret (editable/text-area-field area))]
             (editable/text-area-move-up! (mut area) paragraph false)
             (assert (< (editable/text-field-caret (editable/text-area-field area)) down-index)))
           (editable/text-area-set-caret-from-point! (mut area) paragraph 12.0 45.0 false)
           (let [position
                   (text/shaped-paragraph-position-for-index paragraph
                                                             (editable/text-field-caret (editable/text-area-field area)))]
             (assert (>= (load (field position y)) 40.0)))
           (set! (.focused (.field area)) true)
           (editable/text-field-select! (mut (.field area)) 3 39)
           (editable/text-area-paint! (mut scene)
                                      area
                                      paragraph
                                      (rect 8.0 12.0 170.0 120.0)
                                      750)
           ;; Background plus one selection primitive for every intersected line.
           (assert (>= (al/al-len [Primitive] (load (field scene items))) 3))
           (assert (> (al/al-len [TextSprite] (load (field scene text))) 0))
           (assert-eq (al/al-len [Hitbox] (load (field scene hitboxes))) 1)
           (scene-free! (mut scene))
           (text/shaped-paragraph-free! (mut paragraph))
           (editable/text-area-free! (mut area))
           (text/text-atlas-free! (mut atlas))))

(deftest atlas-uv-regions-survive-scene-recording
         (let [(mut scene) (scene-new)]
           (scene-texture-region! (mut scene)
                                  (rect 4.0 8.0 100.0 20.0)
                                  (rgb 1.0 1.0 1.0)
                                  (rect 0.25 0.125 0.5 0.25)
                                  (primitive/cast (ptr i8) 500)
                                  55)
           (let [sprite (al/al-get [TextSprite] (load (field scene text)) 0)
                 uv (load (field sprite uv))]
             (assert (and (> (load (field uv x)) 0.249)
                          (< (load (field uv x)) 0.251)
                          (> (load (field uv w)) 0.499)
                          (< (load (field uv w)) 0.501))))
           (scene-free! (mut scene))))

(deftest affine-composition-inverse-and-transformed-hit-testing
         (let [transform
                 (affine-multiply (affine-translate 100.0 50.0)
                                  (affine-multiply (affine-rotate 90.0)
                                                   (affine-scale 2.0 1.5)))
               point (Point :x 3.0 :y 4.0)
               screen (affine-transform-point transform point)
               round-trip (affine-transform-point (affine-inverse transform) screen)]
           (assert (and (> (load (field round-trip x)) 2.999)
                        (< (load (field round-trip x)) 3.001)
                        (> (load (field round-trip y)) 3.999)
                        (< (load (field round-trip y)) 4.001)))
           (let [(mut scene) (scene-new)
                 prior (scene-push-transform! (mut scene) transform)]
             (scene-hitbox! (mut scene) (rect 0.0 0.0 20.0 10.0) 700 -1 true true)
             (scene-rounded-rect! (mut scene)
                                  (rect 0.0 0.0 20.0 10.0)
                                  (rgb 1.0 0.0 0.0)
                                  3.0
                                  0.0
                                  (rgba 0.0 0.0 0.0 0.0)
                                  700)
             (let [inside (affine-transform-point transform (Point :x 10.0 :y 5.0))
                   outside (affine-transform-point transform (Point :x 25.0 :y 5.0))
                   primitive (al/al-get [Primitive] (load (field scene items)) 0)]
               (assert-eq (topmost-hit scene (load (field inside x)) (load (field inside y))) 700)
               (assert-eq (topmost-hit scene (load (field outside x)) (load (field outside y))) -1)
               (assert (hit-test primitive (load (field inside x)) (load (field inside y)))))
             (scene-pop-transform! (mut scene) prior)
             (scene-free! (mut scene)))))

(deftest singular-transforms-never-produce-interactive-hitboxes
         (let [(mut scene) (scene-new)
               prior (scene-push-transform! (mut scene) (affine-scale 0.0 1.0))]
           (scene-hitbox! (mut scene) (rect 0.0 0.0 100.0 100.0) 701 -1 true true)
           (assert-eq (topmost-hit scene 0.0 50.0) -1)
           (scene-pop-transform! (mut scene) prior)
           (scene-free! (mut scene))))

(deftest inspector-picks-cycles-hierarchy-and-paints-gpu-overlays
         (let [(mut scene) (scene-new)
               (mut state) (inspector/inspector-new)]
           (scene-hitbox! (mut scene) (rect 0.0 0.0 120.0 120.0) 800 -1 false true)
           (scene-hitbox! (mut scene) (rect 20.0 20.0 80.0 80.0) 801 800 true true)
           (let [prior (scene-push-transform! (mut scene) (affine-translate 10.0 5.0))]
             (do
               (scene-hitbox! (mut scene) (rect 25.0 25.0 40.0 40.0) 802 801 true false)
               (scene-pop-transform! (mut scene) prior)))
           (assert (inspector/inspector-toggle! (mut state)))
           (assert-eq (inspector/inspector-pick! (mut state) scene 40.0 40.0 0) 802)
           (let [top (inspector/inspector-snapshot state)]
             (do
               (assert (load (field top valid)))
               (assert-eq (load (field top parent-id)) 801)
               (assert-eq (load (field top depth)) 2)
               (assert-eq (load (field top candidate-count)) 3)
               (assert (load (field top focusable)))
               (assert (not (load (field top occludes))))))
           (assert-eq (inspector/inspector-pick! (mut state) scene 40.0 40.0 1) 801)
           (assert-eq (inspector/inspector-pick! (mut state) scene 40.0 40.0 1) 800)
           (assert-eq (inspector/inspector-pick! (mut state) scene 40.0 40.0 1) 802)
           ;; Moving the pointer resets occlusion cycling to the topmost match.
           (assert-eq (inspector/inspector-pick! (mut state) scene 50.0 50.0 0) 802)
           (let [before (al/al-len [Primitive] (load (field scene items)))]
             (do
               (assert-eq (inspector/inspector-paint! state
                                                      (mut scene)
                                                      (rect 0.0 0.0 400.0 300.0))
                          1)
               (assert (>= (- (al/al-len [Primitive] (load (field scene items))) before) 7))))
           (scene-free! (mut scene))))

(deftest image-sprites-select-polychrome-pipeline-and-preserve-clips
         (let [(mut scene) (scene-new)
               prior (scene-push-clip! (mut scene) (rect 4.0 5.0 40.0 30.0))]
           (scene-image! (mut scene)
                         (rect 0.0 0.0 100.0 80.0)
                         (rgba 1.0 1.0 1.0 0.8)
                         (primitive/cast (ptr i8) 123)
                         88)
           (let [sprite (al/al-get [TextSprite] (load (field scene text)) 0)]
             (assert-eq (load (field sprite mode)) 1)
             (assert (contains? (load (field sprite clip)) 10.0 10.0))
             (assert (not (contains? (load (field sprite clip)) 2.0 2.0))))
           (scene-pop-clip! (mut scene) prior)
           (scene-free! (mut scene))))

(deftest image-object-fit-contain-and-cover-preserve-aspect-ratio
         (let [destination (rect 10.0 20.0 100.0 100.0)
               fill (image/image-placement 200 100 destination (image/FitFill))
               contain (image/image-placement 200 100 destination (image/FitContain))
               cover (image/image-placement 200 100 destination (image/FitCover))
               invalid (image/image-placement 0 100 destination (image/FitCover))
               contained (field contain bounds)
               cropped (field cover uv)]
           (assert (load (field fill valid)))
           (assert (and (> (load (field (field fill bounds) w)) 99.99)
                        (< (load (field (field fill bounds) w)) 100.01)))
           (assert (and (> (load (field contained y)) 44.99)
                        (and (< (load (field contained y)) 45.01)
                             (and (> (load (field contained w)) 99.99)
                                  (and (< (load (field contained w)) 100.01)
                                       (and (> (load (field contained h)) 49.99)
                                            (< (load (field contained h)) 50.01)))))))
           (assert (and (> (load (field cropped x)) 0.249)
                        (and (< (load (field cropped x)) 0.251)
                             (and (> (load (field cropped w)) 0.499)
                                  (and (< (load (field cropped w)) 0.501)
                                       (and (< (load (field cropped y)) 0.001)
                                            (and (> (load (field cropped h)) 0.999)
                                                 (< (load (field cropped h)) 1.001))))))))
           (assert (not (load (field invalid valid))))))

(deftest fitted-grayscale-images-record-cropped-gpu-sprites
         (let [(mut scene) (scene-new)
               texture
                 (image/ImageTexture
                   :texture (primitive/cast (ptr i8) 77)
                   :width 200
                   :height 100)]
           (image/paint-image-fit-rounded! (mut scene)
                                           texture
                                           (rect 0.0 0.0 100.0 100.0)
                                           (image/FitCover)
                                           (rgb 1.0 1.0 1.0)
                                           true
                                           80.0
                                           90)
           (assert-eq (al/al-len [TextSprite] (load (field scene text))) 1)
           (let [sprite (al/al-elem [TextSprite] (field scene text) 0)]
             (assert-eq (load (field sprite mode)) 2)
             ;; Radius clamps to half the smaller fitted dimension.
             (assert (and (> (load (field sprite radius)) 49.99)
                          (< (load (field sprite radius)) 50.01)))
             (assert (and (> (load (field (field sprite uv) x)) 0.249)
                          (< (load (field (field sprite uv) x)) 0.251))))
           (scene-free! (mut scene))))

(deftest image-asset-cache-deduplicates-evicts-and-rejects-stale-ids
         (let [device (MTLCreateSystemDefaultDevice)
               (mut cache) (assets/image-asset-cache-new device 134217728)
               first-path
                 c"/System/Library/CoreServices/CoreTypes.bundle/Contents/Resources/GenericApplicationIcon.icns"
               second-path c"/System/Library/CoreServices/CoreTypes.bundle/Contents/Resources/TrashIcon.icns"
               first (assets/image-asset-cache-load! (mut cache) first-path)
               duplicate (assets/image-asset-cache-load! (mut cache) first-path)]
           (assert (assets/image-asset-cache-valid? cache first))
           (assert-eq (load (field first slot)) (load (field duplicate slot)))
           (assert-eq (load (field first generation)) (load (field duplicate generation)))
           (assert-eq (assets/image-asset-cache-resident-count cache) 1)
           (let [one-image-bytes (assets/image-asset-cache-resident-bytes cache)]
             (do
               ;; Permit exactly one same-sized system icon, then unpin the
               ;; first frame so the second source must evict it.
               (set! (.budget-bytes cache) one-image-bytes)
               (assets/image-asset-cache-begin-frame! (mut cache))
               (let [second (assets/image-asset-cache-load! (mut cache) second-path)]
                 (do
                   (assert (assets/image-asset-cache-valid? cache second))
                   (assert (not (assets/image-asset-cache-valid? cache first)))
                   (assert-eq (load (field second slot)) (load (field first slot)))
                   (assert (!= (load (field second generation))
                               (load (field first generation))))
                   (assert-eq (assets/image-asset-cache-resident-count cache) 1)
                   (assert (<= (assets/image-asset-cache-resident-bytes cache) one-image-bytes))
                   (let [(mut scene) (scene-new)]
                     (do
                       (assert-eq (assets/image-asset-cache-paint! (mut cache)
                                                                   (mut scene)
                                                                   second
                                                                   (rect 0.0 0.0 32.0 32.0)
                                                                   (rgb 1.0 1.0 1.0)
                                                                   902)
                                  1)
                       (assert-eq (al/al-len [TextSprite] (load (field scene text))) 1)
                       (scene-free! (mut scene))))
                   (assert (not (assets/image-asset-cache-invalidate! (mut cache) second)))
                   (assets/image-asset-cache-begin-frame! (mut cache))
                   (assert (assets/image-asset-cache-invalidate! (mut cache) second))
                   (assert-eq (assets/image-asset-cache-resident-count cache) 0)))))
           (assets/image-asset-cache-free! (mut cache))))

(deftest texture-sprite-runs-batch-only-adjacent-compatible-records
         (let [(mut scene) (scene-new)
               texture-a (primitive/cast (ptr i8) 100)
               texture-b (primitive/cast (ptr i8) 200)]
           (scene-texture! (mut scene) (rect 0.0 0.0 10.0 10.0) (rgb 1.0 1.0 1.0) texture-a 1)
           (scene-texture! (mut scene) (rect 10.0 0.0 10.0 10.0) (rgb 1.0 1.0 1.0) texture-a 2)
           (scene-texture! (mut scene) (rect 20.0 0.0 10.0 10.0) (rgb 1.0 1.0 1.0) texture-b 3)
           ;; Same texture but a different pipeline must begin a new run.
           (scene-image! (mut scene) (rect 30.0 0.0 10.0 10.0) (rgb 1.0 1.0 1.0) texture-b 4)
           (scene-image! (mut scene) (rect 40.0 0.0 10.0 10.0) (rgb 1.0 1.0 1.0) texture-b 5)
           (let [sprites (load (field scene text))]
             (assert-eq (metal/sprite-run-end sprites 0 5) 2)
             (assert-eq (metal/sprite-run-end sprites 2 5) 3)
             (assert-eq (metal/sprite-run-end sprites 3 5) 5))
           (scene-free! (mut scene))))

(deftest shadows-are-batched-behind-shapes-and-preserve-clips
         (let [(mut scene) (scene-new)
               prior (scene-push-clip! (mut scene) (rect 10.0 12.0 80.0 60.0))]
           (scene-shadow! (mut scene)
                          (rect 20.0 24.0 40.0 30.0)
                          2.0
                          4.0
                          6.0
                          1.0
                          8.0
                          (rgba 0.0 0.0 0.0 0.5)
                          91)
           (scene-rounded-rect! (mut scene)
                                (rect 20.0 24.0 40.0 30.0)
                                (rgb 1.0 1.0 1.0)
                                8.0
                                0.0
                                (rgba 0.0 0.0 0.0 0.0)
                                91)
           (assert-eq (al/al-len [Primitive] (load (field scene shadows))) 1)
           (assert-eq (al/al-len [Primitive] (load (field scene items))) 1)
           (let [shadow (al/al-get [Primitive] (load (field scene shadows)) 0)
                 bounds (load (field shadow bounds))]
             (assert-eq (load (field shadow kind)) 1)
             (assert (and (> (load (field bounds w)) 77.9)
                          (< (load (field bounds w)) 78.1)))
             (assert (contains? (load (field shadow clip)) 20.0 24.0)))
           (scene-pop-clip! (mut scene) prior)
           (scene-clear! (mut scene))
           (assert-eq (al/al-len [Primitive] (load (field scene shadows))) 0)
           (scene-free! (mut scene))))

(deftest gradients-preserve-scene-order-clips-and-primitive-abi
         (let [(mut scene) (scene-new)
               prior (scene-push-clip! (mut scene) (rect 5.0 6.0 90.0 70.0))]
           (scene-rect! (mut scene) (rect 0.0 0.0 100.0 80.0) (rgb 0.0 0.0 0.0) 1)
           (scene-linear-gradient! (mut scene)
                                   (rect 10.0 12.0 60.0 40.0)
                                   (rgb 1.0 0.0 0.0)
                                   (rgb 0.0 0.0 1.0)
                                   90.0
                                   8.0
                                   2)
           (scene-rect! (mut scene) (rect 20.0 20.0 10.0 10.0) (rgb 1.0 1.0 1.0) 3)
           (assert-eq (al/al-len [Primitive] (load (field scene items))) 3)
           (let [gradient (al/al-get [Primitive] (load (field scene items)) 1)]
             (assert-eq (load (field gradient kind)) 2)
             (assert (and (> (load (field gradient border-width)) 89.9)
                          (< (load (field gradient border-width)) 90.1)))
             (assert (contains? (load (field gradient clip)) 10.0 12.0)))
           (scene-pop-clip! (mut scene) prior)
           (scene-free! (mut scene))))

(deftest slash-patterns-record-clamped-analytic-instance-parameters
         (let [(mut scene) (scene-new)]
           (scene-slash-pattern! (mut scene)
                                 (rect 10.0 20.0 120.0 40.0)
                                 (rgba 1.0 0.2 0.1 0.5)
                                 0.0
                                 -3.0
                                 -2.0
                                 71)
           (assert-eq (al/al-len [Primitive] (load (field scene items))) 1)
           (assert-eq (al/al-len [PaintCommand] (load (field scene paint-commands))) 1)
           (let [pattern (al/al-elem [Primitive] (field scene items) 0)]
             (assert-eq (load (field pattern kind)) 3)
             (assert (and (> (load (field pattern border-width)) 0.249)
                          (< (load (field pattern border-width)) 0.251)))
             (assert (< (load (field (field pattern border-color) r)) 0.001))
             (assert (< (load (field pattern radius)) 0.001))
             (assert-eq (load (field pattern id)) 71))
           (scene-free! (mut scene))))

(deftest nested-opacity-multiplies-every-paint-record-and-restores-state
         (let [(mut scene) (scene-new)
               (mut shape) (path/path-new)]
           (path/path-move-to! (mut shape) 0.0 0.0)
           (path/path-line-to! (mut shape) 10.0 0.0)
           (path/path-line-to! (mut shape) 0.0 10.0)
           (path/path-close! (mut shape))
           (let [(mut mesh) (path/path-tessellate shape)
                 outer (scene-push-opacity! (mut scene) 0.5)
                 inner (scene-push-opacity! (mut scene) 0.4)]
             (do
               (scene-rounded-rect! (mut scene)
                                    (rect 0.0 0.0 10.0 10.0)
                                    (rgba 1.0 0.0 0.0 0.8)
                                    2.0
                                    1.0
                                    (rgba 0.0 1.0 0.0 0.5)
                                    1)
               (scene-shadow! (mut scene)
                              (rect 0.0 0.0 10.0 10.0)
                              0.0
                              0.0
                              2.0
                              0.0
                              2.0
                              (rgba 0.0 0.0 0.0 0.5)
                              2)
               (scene-linear-gradient! (mut scene)
                                       (rect 0.0 0.0 10.0 10.0)
                                       (rgb 1.0 0.0 0.0)
                                       (rgba 0.0 0.0 1.0 0.5)
                                       90.0
                                       0.0
                                       3)
               (scene-slash-pattern! (mut scene)
                                     (rect 0.0 0.0 10.0 10.0)
                                     (rgba 1.0 1.0 1.0 0.4)
                                     2.0
                                     3.0
                                     0.0
                                     4)
               (scene-path-fill! (mut scene) mesh (rgba 1.0 1.0 0.0 0.75) 5)
               (scene-texture! (mut scene)
                               (rect 0.0 0.0 10.0 10.0)
                               (rgb 1.0 1.0 1.0)
                               (primitive/cast (ptr i8) 10)
                               6)
               (scene-image! (mut scene)
                             (rect 0.0 0.0 10.0 10.0)
                             (rgba 1.0 1.0 1.0 0.5)
                             (primitive/cast (ptr i8) 11)
                             7)
               (let [solid (al/al-elem [Primitive] (field scene items) 0)
                     gradient (al/al-elem [Primitive] (field scene items) 1)
                     pattern (al/al-elem [Primitive] (field scene items) 2)
                     shadow (al/al-elem [Primitive] (field scene shadows) 0)
                     draw (al/al-elem [PathDraw] (field scene path-draws) 0)
                     glyph (al/al-elem [TextSprite] (field scene text) 0)
                     image-sprite (al/al-elem [TextSprite] (field scene text) 1)]
                 (do
                   ;; Source colors remain untouched; one GPU scalar carries group opacity.
                   (assert (and (> (load (field (field solid color) a)) 0.799)
                                (< (load (field (field solid color) a)) 0.801)))
                   (assert (and (> (load (field (field solid border-color) a)) 0.499)
                                (< (load (field (field solid border-color) a)) 0.501)))
                   (assert (and (> (load (field (field shadow color) a)) 0.499)
                                (< (load (field (field shadow color) a)) 0.501)))
                   (assert (> (load (field (field gradient color) a)) 0.999))
                   (assert (and (> (load (field (field gradient border-color) a)) 0.499)
                                (< (load (field (field gradient border-color) a)) 0.501)))
                   (assert (and (> (load (field (field pattern color) a)) 0.399)
                                (< (load (field (field pattern color) a)) 0.401)))
                   (assert (and (> (load (field solid opacity)) 0.199)
                                (< (load (field solid opacity)) 0.201)))
                   (assert (and (> (load (field shadow opacity)) 0.199)
                                (< (load (field shadow opacity)) 0.201)))
                   (assert (and (> (load (field gradient opacity)) 0.199)
                                (< (load (field gradient opacity)) 0.201)))
                   (assert (and (> (load (field pattern opacity)) 0.199)
                                (< (load (field pattern opacity)) 0.201)))
                   (assert (and (> (load (field draw opacity)) 0.199)
                                (< (load (field draw opacity)) 0.201)))
                   (assert (and (> (load (field glyph opacity)) 0.199)
                                (< (load (field glyph opacity)) 0.201)))
                   (assert (and (> (load (field image-sprite opacity)) 0.199)
                                (< (load (field image-sprite opacity)) 0.201)))
                   ;; Packed pattern gap and shadow inset remain geometry.
                   (assert (and (> (load (field (field pattern border-color) r)) 2.99)
                                (< (load (field (field pattern border-color) r)) 3.01)))
                   (assert (and (> (load (field (field shadow border-color) r)) 5.999)
                                (< (load (field (field shadow border-color) r)) 6.001)))))
               (scene-pop-opacity! (mut scene) inner)
               (scene-rect! (mut scene) (rect 0.0 0.0 1.0 1.0) (rgb 1.0 1.0 1.0) 8)
               (assert (and (> (load (field (al/al-elem [Primitive] (field scene items) 3) opacity)) 0.499)
                            (< (load (field (al/al-elem [Primitive] (field scene items) 3) opacity)) 0.501)))
               (scene-pop-opacity! (mut scene) outer)
               (scene-clear! (mut scene))
               (scene-rect! (mut scene) (rect 0.0 0.0 1.0 1.0) (rgb 1.0 1.0 1.0) 9)
               (assert (> (load (field (al/al-elem [Primitive] (field scene items) 0) opacity)) 0.999))
               (path/tessellation-free! (mut mesh))))
           (path/path-free! (mut shape))
           (scene-free! (mut scene))))

(deftest geometry-and-insets
         (let [r
                 (inset (rect 10.0 20.0 100.0 80.0)
                        (EdgeInsets
                          :top 2.0
                          :right 3.0
                          :bottom 4.0
                          :left 5.0))]
           (assert (contains? r 15.0 22.0))
           (assert (not (contains? r 14.0 22.0)))
           (assert (contains? r 101.0 95.0))
           (assert (not (contains? r 102.0 96.0)))))

(deftest scene-order-controls-hit-testing
         (let [(mut scene) (scene-new)]
           (scene-rect! (mut scene) (rect 0.0 0.0 100.0 100.0) (rgb 1.0 0.0 0.0) 1)
           (scene-hitbox! (mut scene) (rect 0.0 0.0 100.0 100.0) 1 -1 true true)
           (scene-rect! (mut scene) (rect 25.0 25.0 50.0 50.0) (rgb 0.0 1.0 0.0) 2)
           (scene-hitbox! (mut scene) (rect 25.0 25.0 50.0 50.0) 2 -1 true true)
           (assert-eq (al/al-len [Primitive] (load (field scene items))) 2)
           (assert-eq (topmost-hit scene 30.0 30.0) 2)
           (assert-eq (topmost-hit scene 10.0 10.0) 1)
           (assert-eq (topmost-hit scene 200.0 200.0) -1)
           (scene-free! (mut scene))))

(deftest deferred-scenes-rebase-geometry-and-remain-topmost-for-input
         (let [(mut scene) (scene-new)
               (mut deferred) (scene-new)
               (mut triangle) (path/path-new)
               (mut router) (input/router-new)]
           (path/path-move-to! (mut triangle) 0.0 0.0)
           (path/path-line-to! (mut triangle) 10.0 0.0)
           (path/path-line-to! (mut triangle) 0.0 10.0)
           (path/path-close! (mut triangle))
           (let [(mut mesh) (path/path-tessellate triangle)]
             (do
               (scene-rect! (mut scene) (rect 0.0 0.0 40.0 40.0) (rgb 1.0 0.0 0.0) 1)
               (scene-path-fill! (mut scene) mesh (rgb 1.0 1.0 1.0) 2)
               (scene-hitbox! (mut scene) (rect 0.0 0.0 100.0 100.0) 10 -1 false true)
               (scene-rect! (mut deferred) (rect 5.0 5.0 30.0 30.0) (rgb 0.0 0.0 1.0) 3)
               (scene-path-fill! (mut deferred) mesh (rgb 0.0 1.0 0.0) 4)
               (scene-texture! (mut deferred)
                               (rect 8.0 8.0 12.0 12.0)
                               (rgb 1.0 1.0 1.0)
                               (primitive/cast (ptr i8) 77)
                               5)
               (scene-hitbox! (mut deferred) (rect 10.0 10.0 20.0 20.0) 20 -1 true true)
               (assert-eq (scene-append! (mut scene) deferred) 3)
               (assert-eq (al/al-len [Primitive] (load (field scene items))) 2)
               (assert-eq (al/al-len [PathDraw] (load (field scene path-draws))) 2)
               (assert-eq (al/al-len [TextSprite] (load (field scene text))) 1)
               (assert-eq (al/al-len [PaintCommand] (load (field scene paint-commands))) 4)
               (let [commands (load (field scene paint-commands))
                     deferred-box (al/al-get [PaintCommand] commands 2)
                     deferred-path (al/al-get [PaintCommand] commands 3)
                     draws (load (field scene path-draws))
                     second-draw (al/al-get [PathDraw] draws 1)]
                 (do
                   (assert-eq (load (field deferred-box kind)) 0)
                   (assert-eq (load (field deferred-box index)) 1)
                   (assert-eq (load (field deferred-path kind)) 1)
                   (assert-eq (load (field deferred-path index)) 1)
                   (assert-eq (load (field second-draw vertex-start)) 3)))
               (assert-eq (input/router-pointer-down! (mut router) scene 15.0 15.0) 20)
               (path/tessellation-free! (mut mesh))))
           (path/path-free! (mut triangle))
           (scene-free! (mut deferred))
           (scene-free! (mut scene))))

(deftest anchored-popovers-flip-clamp-dismiss-and-wrap-keyboard-selection
         (let [viewport (rect 0.0 0.0 300.0 200.0)
               below
                 (overlay/anchored-place (rect 20.0 20.0 40.0 20.0)
                                         120.0
                                         80.0
                                         viewport
                                         6.0
                                         8.0
                                         (overlay/SideBelow))
               flipped
                 (overlay/anchored-place (rect 250.0 178.0 30.0 16.0)
                                         120.0
                                         90.0
                                         viewport
                                         6.0
                                         8.0
                                         (overlay/SideBelow))
               horizontal
                 (overlay/anchored-place (rect 270.0 80.0 20.0 20.0)
                                         100.0
                                         60.0
                                         viewport
                                         4.0
                                         8.0
                                         (overlay/SideRight))
               oversized
                 (overlay/anchored-place (rect 140.0 90.0 20.0 20.0)
                                         900.0
                                         800.0
                                         viewport
                                         6.0
                                         8.0
                                         (overlay/SideBelow))
               (mut state) (overlay/popover-new true)
               (mut deferred) (scene-new)
               (mut scene) (scene-new)
               (mut router) (input/router-new)]
           (do
             (assert-eq (load (field below side)) (overlay/SideBelow))
             (assert-eq (load (field flipped side)) (overlay/SideAbove))
             (assert-eq (load (field horizontal side)) (overlay/SideLeft))
             (assert (<= (load (field (field oversized bounds) w)) 284.0))
             (assert (<= (load (field (field oversized bounds) h)) 184.0))
             (overlay/popover-open! (mut state) (rect 250.0 178.0 30.0 16.0) 1)
             (let [menu
                     (overlay/popover-paint-menu! (mut deferred)
                                                  (mut state)
                                                  viewport
                                                  3
                                                  120.0
                                                  24.0
                                                  9000)]
               (do
                 (scene-hitbox! (mut scene) viewport 50 -1 false true)
                 (scene-append! (mut scene) deferred)
                 (assert-eq (input/router-pointer-down! (mut router)
                                                        scene
                                                        (+ (load (field menu x)) 12.0)
                                                        (+ (load (field menu y)) 42.0))
                            9003)
                 (assert-eq (overlay/popover-pointer-target! (mut state) 9003 9000 3) 1)
                 (assert (not (overlay/popover-open? state)))))
             (overlay/popover-open! (mut state) (rect 10.0 10.0 20.0 20.0) 0)
             (assert-eq (overlay/popover-key! (mut state) (overlay/PopoverPrevious) 3) -1)
             (assert-eq (overlay/popover-selected state) 2)
             (assert-eq (overlay/popover-key! (mut state) (overlay/PopoverNext) 3) -1)
             (assert-eq (overlay/popover-selected state) 0)
             (assert-eq (overlay/popover-key! (mut state) (overlay/PopoverAccept) 3) 0)
             (overlay/popover-open! (mut state) (rect 10.0 10.0 20.0 20.0) 0)
             (assert-eq (overlay/popover-pointer-target! (mut state) 9000 9000 3) -1)
             (assert (not (overlay/popover-open? state)))
             (scene-free! (mut scene))
             (scene-free! (mut deferred)))))

(deftest nested-clips-affect-paint-records-and-hit-testing
         (let [(mut scene) (scene-new)
               prior (scene-push-clip! (mut scene) (rect 20.0 20.0 40.0 40.0))]
           (button! (mut scene)
                    (rect 0.0 0.0 100.0 100.0)
                    (ButtonState
                      :hovered false
                      :pressed false
                      :focused false
                      :disabled false)
                    9)
           (assert-eq (topmost-hit scene 30.0 30.0) 9)
           (assert-eq (topmost-hit scene 10.0 10.0) -1)
           (let [primitive (al/al-get [Primitive] (load (field scene items)) 0)]
             (assert (contains? (load (field primitive clip)) 30.0 30.0))
             (assert (not (contains? (load (field primitive clip)) 10.0 10.0))))
           (scene-pop-clip! (mut scene) prior)
           (scene-free! (mut scene))))

(deftest flex-grow-shrink-align-and-justify
         (let [(mut flex) (primitive/zeroed layout/FlexLayout)]
           (store! flex (layout/flex-new))
           (layout/flex-push! (mut flex) 50.0 20.0 1.0 1.0)
           (layout/flex-push! (mut flex) 50.0 30.0 3.0 1.0)
           (layout/flex-compute! (mut flex)
                                 (rect 0.0 0.0 220.0 60.0)
                                 (Horizontal)
                                 20.0
                                 (EdgeInsets
                                   :top 0.0
                                   :right 0.0
                                   :bottom 0.0
                                   :left 0.0)
                                 (Center)
                                 (Leading))
           (let [a (al/al-get [Rect] (load (field flex rects)) 0)
                 b (al/al-get [Rect] (load (field flex rects)) 1)]
             (assert (and (> (load (field a w)) 74.9) (< (load (field a w)) 75.1)))
             (assert (and (> (load (field b w)) 124.9) (< (load (field b w)) 125.1)))
             (assert (and (> (load (field a y)) 19.9) (< (load (field a y)) 20.1)))
             (assert (and (> (load (field b x)) 94.9) (< (load (field b x)) 95.1))))
           (layout/flex-compute! (mut flex)
                                 (rect 0.0 0.0 80.0 60.0)
                                 (Horizontal)
                                 0.0
                                 (EdgeInsets
                                   :top 0.0
                                   :right 0.0
                                   :bottom 0.0
                                   :left 0.0)
                                 (Stretch)
                                 (Leading))
           (let [a (al/al-get [Rect] (load (field flex rects)) 0)
                 b (al/al-get [Rect] (load (field flex rects)) 1)]
             (assert (and (> (load (field a w)) 39.9) (< (load (field a w)) 40.1)))
             (assert (and (> (load (field b w)) 39.9) (< (load (field b w)) 40.1)))
             (assert (and (> (load (field a h)) 59.9) (< (load (field a h)) 60.1))))
           (layout/flex-free! (mut flex))))

(deftest intrinsic-measurements-resolve-aspect-and-feed-flex
         (let [photo
                 (image/ImageTexture
                   :texture (primitive/cast (ptr i8) 0)
                   :width 400
                   :height 200)
               photo-size (image/image-intrinsic-size photo 2.0)
               resolved
                 (measure/resolve-size photo-size
                                       (measure/constraints 0.0 0.0 100.0 0.0))
               (mut line) (primitive/zeroed text/ShapedLine)
               (mut flex) (layout/flex-new)]
           (do
             (assert (and (> (load (field resolved w)) 99.9)
                          (< (load (field resolved w)) 100.1)))
             (assert (and (> (load (field resolved h)) 49.9)
                          (< (load (field resolved h)) 50.1)))
             (set! (.width line) 80.0)
             (set! (.ascent line) 14.0)
             (set! (.descent line) 4.0)
             (let [line-size (text/shaped-line-intrinsic-size (load line))]
               (do
                 (layout/flex-push-intrinsic! (mut flex) line-size (Horizontal) 0.0 1.0)
                 (layout/flex-push-intrinsic! (mut flex) photo-size (Horizontal) 0.0 1.0)))
             (layout/flex-compute! (mut flex)
                                   (rect 0.0 0.0 140.0 60.0)
                                   (Horizontal)
                                   0.0
                                   (EdgeInsets
                                     :top 0.0
                                     :right 0.0
                                     :bottom 0.0
                                     :left 0.0)
                                   (Start)
                                   (Leading))
             (let [label (al/al-get [Rect] (load (field flex rects)) 0)
                   image-rect (al/al-get [Rect] (load (field flex rects)) 1)]
               (do
                 ; The unbreakable shaped line freezes at its 80px minimum;
                 ; the remaining deficit is redistributed to the image.
                 (assert (and (> (load (field label w)) 79.9)
                              (< (load (field label w)) 80.1)))
                 (assert (and (> (load (field image-rect w)) 59.9)
                              (< (load (field image-rect w)) 60.1)))
                 (assert (and (> (load (field label h)) 17.9)
                              (< (load (field label h)) 18.1)))))
             (layout/flex-free! (mut flex)))))

(deftest measured-grid-content-tracks-grow-spans-and-honor-maxima
         (let [(mut layout) (grid/grid-new)
               content (measure/intrinsic-size 30.0 20.0 130.0 36.0 0.0)]
           (do
             (grid/grid-content-track! (mut layout) true 10.0 40.0)
             (grid/grid-content-track! (mut layout) true 10.0 0.0)
             (grid/grid-content-track! (mut layout) false 8.0 0.0)
             (grid/grid-place-measured! (mut layout) 0 0 2 1 content)
             (grid/grid-compute! (mut layout)
                                 (rect 5.0 7.0 240.0 100.0)
                                 10.0
                                 0.0
                                 (EdgeInsets
                                   :top 0.0
                                   :right 0.0
                                   :bottom 0.0
                                   :left 0.0))
             (let [first (al/al-get [grid/GridTrack] (load (field layout columns)) 0)
                   second (al/al-get [grid/GridTrack] (load (field layout columns)) 1)
                   row (al/al-get [grid/GridTrack] (load (field layout rows)) 0)
                   child (grid/grid-rect (load layout) 0)]
               (do
                 ; The first content track freezes at 40; remaining intrinsic
                 ; width is redistributed into the unbounded second track.
                 (assert (and (> (load (field first size)) 39.9)
                              (< (load (field first size)) 40.1)))
                 (assert (and (> (load (field second size)) 79.9)
                              (< (load (field second size)) 80.1)))
                 (assert (and (> (load (field row size)) 35.9)
                              (< (load (field row size)) 36.1)))
                 (assert (and (> (load (field child w)) 129.9)
                              (< (load (field child w)) 130.1)))))
             (grid/grid-free! (mut layout)))))

(deftest grid-fraction-tracks-freeze-at-max-and-redistribute
         (let [(mut layout) (primitive/zeroed grid/GridLayout)]
           (store! layout (grid/grid-new))
           (grid/grid-fixed-track! (mut layout) true 50.0)
           (grid/grid-fraction-track! (mut layout) true 20.0 1.0 60.0)
           (grid/grid-fraction-track! (mut layout) true 20.0 2.0 0.0)
           (grid/grid-fixed-track! (mut layout) false 40.0)
           (grid/grid-fraction-track! (mut layout) false 20.0 1.0 0.0)
           (grid/grid-place! (mut layout) 0 0 1 1)
           (grid/grid-place! (mut layout) 1 0 2 1)
           (grid/grid-place! (mut layout) 0 1 3 1)
           (grid/grid-compute! (mut layout)
                               (rect 10.0 20.0 300.0 120.0)
                               10.0
                               8.0
                               (EdgeInsets
                                 :top 0.0
                                 :right 0.0
                                 :bottom 0.0
                                 :left 0.0))
           (let [column0 (al/al-get [grid/GridTrack] (load (field layout columns)) 0)
                 column1 (al/al-get [grid/GridTrack] (load (field layout columns)) 1)
                 column2 (al/al-get [grid/GridTrack] (load (field layout columns)) 2)
                 spanning (grid/grid-rect (load layout) 1)
                 full-row (grid/grid-rect (load layout) 2)]
             (assert (and (> (load (field column0 size)) 49.9)
                          (< (load (field column0 size)) 50.1)))
             (assert (and (> (load (field column1 size)) 59.9)
                          (< (load (field column1 size)) 60.1)))
             (assert (and (> (load (field column2 size)) 169.9)
                          (< (load (field column2 size)) 170.1)))
             (assert (and (> (load (field spanning w)) 239.9)
                          (< (load (field spanning w)) 240.1)))
             (assert (and (> (load (field full-row w)) 299.9)
                          (< (load (field full-row w)) 300.1))))
           (grid/grid-free! (mut layout))))

(deftest grid-invalid-placement-is-empty-and-storage-is-reused
         (let [(mut layout) (primitive/zeroed grid/GridLayout)]
           (store! layout (grid/grid-new))
           (grid/grid-fraction-track! (mut layout) true 10.0 1.0 0.0)
           (grid/grid-fraction-track! (mut layout) false 10.0 1.0 0.0)
           (grid/grid-place! (mut layout) 4 9 1 1)
           (grid/grid-compute! (mut layout)
                               (rect 0.0 0.0 100.0 100.0)
                               0.0
                               0.0
                               (EdgeInsets
                                 :top 0.0
                                 :right 0.0
                                 :bottom 0.0
                                 :left 0.0))
           (let [empty (grid/grid-rect (load layout) 0)
                 capacity (al/al-cap [Rect] (load (field layout rects)))]
             (assert (and (< (load (field empty w)) 0.001)
                          (< (load (field empty h)) 0.001)))
             (grid/grid-compute! (mut layout)
                                 (rect 0.0 0.0 80.0 60.0)
                                 0.0
                                 0.0
                                 (EdgeInsets
                                   :top 0.0
                                   :right 0.0
                                   :bottom 0.0
                                   :left 0.0))
             (assert-eq (al/al-cap [Rect] (load (field layout rects))) capacity))
           (grid/grid-free! (mut layout))))

(deftest concave-paths-tessellate-in-both-windings
         (let [(mut clockwise) (primitive/zeroed path/Path)
               (mut counterclockwise) (primitive/zeroed path/Path)]
           (store! clockwise (path/path-new))
           (path/path-move-to! (mut clockwise) 0.0 0.0)
           (path/path-line-to! (mut clockwise) 40.0 0.0)
           (path/path-line-to! (mut clockwise) 20.0 18.0)
           (path/path-line-to! (mut clockwise) 40.0 40.0)
           (path/path-line-to! (mut clockwise) 0.0 40.0)
           (path/path-close! (mut clockwise))
           (store! counterclockwise (path/path-new))
           (path/path-move-to! (mut counterclockwise) 0.0 40.0)
           (path/path-line-to! (mut counterclockwise) 40.0 40.0)
           (path/path-line-to! (mut counterclockwise) 20.0 18.0)
           (path/path-line-to! (mut counterclockwise) 40.0 0.0)
           (path/path-line-to! (mut counterclockwise) 0.0 0.0)
           (path/path-close! (mut counterclockwise))
           (let [(mut a) (path/path-tessellate (load clockwise))
                 (mut b) (path/path-tessellate (load counterclockwise))]
             (assert (load (field a valid)))
             (assert (load (field b valid)))
             (assert-eq (al/al-len [path/PathPoint] (load (field a vertices))) 9)
             (assert-eq (al/al-len [path/PathPoint] (load (field b vertices))) 9)
             (path/tessellation-free! (mut a))
             (path/tessellation-free! (mut b)))
           (path/path-free! (mut clockwise))
           (path/path-free! (mut counterclockwise))))

(deftest path-tessellation-rejects-open-degenerate-and-self-intersecting-input
         (let [(mut candidate) (primitive/zeroed path/Path)]
           (store! candidate (path/path-new))
           (path/path-move-to! (mut candidate) 0.0 0.0)
           (path/path-line-to! (mut candidate) 40.0 40.0)
           (path/path-line-to! (mut candidate) 0.0 40.0)
           (path/path-line-to! (mut candidate) 40.0 0.0)
           (let [(mut open-result) (path/path-tessellate (load candidate))]
             (assert (not (load (field open-result valid))))
             (path/tessellation-free! (mut open-result)))
           (path/path-close! (mut candidate))
           (let [(mut crossed-result) (path/path-tessellate (load candidate))]
             (assert (not (load (field crossed-result valid))))
             (assert-eq (al/al-len [path/PathPoint] (load (field crossed-result vertices))) 0)
             (path/tessellation-free! (mut crossed-result)))
           (path/path-clear! (mut candidate))
           (path/path-move-to! (mut candidate) 0.0 0.0)
           (path/path-line-to! (mut candidate) 10.0 0.0)
           (path/path-line-to! (mut candidate) 20.0 0.0)
           (path/path-close! (mut candidate))
           (let [(mut degenerate) (path/path-tessellate (load candidate))]
             (assert (not (load (field degenerate valid))))
             (path/tessellation-free! (mut degenerate)))
           (path/path-free! (mut candidate))))

(deftest quadratic-and-cubic-curves-flatten-adaptively
         (let [(mut curve) (path/path-new)]
           (path/path-move-to! (mut curve) 0.0 0.0)
           (path/path-quadratic-to! (mut curve) 50.0 100.0 100.0 0.0 0.25)
           (let [quadratic-count (path/path-point-count curve)]
             (assert (> quadratic-count 8))
             (path/path-cubic-to! (mut curve) 125.0 -50.0 175.0 50.0 200.0 0.0 0.25)
             (assert (> (path/path-point-count curve) quadratic-count))
             (let [points (load (field curve points))
                   last (al/al-get [path/PathPoint] points (- (path/path-point-count curve) 1))]
               (assert (and (> (load (field last x)) 199.99)
                            (and (< (load (field last x)) 200.01)
                                 (and (> (load (field last y)) -0.01)
                                      (< (load (field last y)) 0.01)))))))
           (path/path-free! (mut curve))))

(deftest path-distance-metrics-interpolate-across-segments
         (let [(mut route) (path/path-new)]
           (path/path-move-to! (mut route) 0.0 0.0)
           (path/path-line-to! (mut route) 30.0 0.0)
           (path/path-line-to! (mut route) 30.0 40.0)
           (assert (and (> (path/path-length route) 69.99) (< (path/path-length route) 70.01)))
           (let [sample (path/path-point-at-distance route 50.0)]
             (assert (and (> (load (field sample x)) 29.99)
                          (and (< (load (field sample x)) 30.01)
                               (and (> (load (field sample y)) 19.99)
                                    (< (load (field sample y)) 20.01))))))
           (path/path-free! (mut route))))

(deftest path-bounds-cover-empty-negative-and-curved-geometry
         (let [(mut shape) (path/path-new)]
           (let [empty (path/path-bounds shape)]
             (assert (not (load (field empty valid)))))
           (path/path-move-to! (mut shape) -20.0 -10.0)
           (path/path-line-to! (mut shape) 30.0 -5.0)
           (path/path-quadratic-to! (mut shape) 40.0 50.0 10.0 20.0 0.1)
           (let [bounds (path/path-bounds shape)]
             (assert (load (field bounds valid)))
             (assert (and (> (load (field bounds x)) -20.01)
                          (and (< (load (field bounds x)) -19.99)
                               (and (> (load (field bounds w)) 49.99)
                                    (and (> (load (field bounds h)) 29.99)
                                         (< (load (field bounds h)) 60.01)))))))
           (path/path-free! (mut shape))))

(deftest dash-patterns-normalize-phase-and-repeat-odd-arrays
         (let [(mut pattern) (al/al-new [f32] (alloc/malloc-allocator))]
           (al/al-push! [f32] (mut pattern) 10.0)
           (al/al-push! [f32] (mut pattern) 5.0)
           (al/al-push! [f32] (mut pattern) 2.0)
           (assert (path/dash-pattern-valid? pattern))
           (assert (and (> (path/dash-pattern-length pattern) 33.99)
                        (< (path/dash-pattern-length pattern) 34.01)))
           (assert (and (> (path/dash-phase-normalize pattern -2.0) 31.99)
                        (< (path/dash-phase-normalize pattern -2.0) 32.01)))
           (let [state (path/dash-state-at-phase pattern 12.0)]
             (assert (load (field state valid)))
             (assert (not (load (field state visible))))
             (assert-eq (load (field state index)) 1)
             (assert (and (> (load (field state remaining)) 2.99)
                          (< (load (field state remaining)) 3.01))))
           (al/al-set! [f32] (mut pattern) 1 0.0)
           (assert (not (path/dash-pattern-valid? pattern)))
           (let [invalid (path/dash-state-at-phase pattern 0.0)]
             (assert (not (load (field invalid valid))))
             (al/al-free! [f32] (mut pattern)))))

(deftest dashed-runs-preserve-exact-boundaries-and-tessellate
         (let [(mut line) (path/path-new)
               (mut pattern) (al/al-new [f32] (alloc/malloc-allocator))]
           (path/path-move-to! (mut line) 0.0 0.0)
           (path/path-line-to! (mut line) 30.0 0.0)
           (al/al-push! [f32] (mut pattern) 10.0)
           (al/al-push! [f32] (mut pattern) 5.0)
           (let [(mut dashed) (path/path-dash-runs line pattern 0.0)
                 runs (load (field dashed runs))]
             (assert (load (field dashed valid)))
             (assert-eq (al/al-len [path/Path] runs) 2)
             (let [first (al/al-get [path/Path] runs 0)
                   second (al/al-get [path/Path] runs 1)]
               (assert (and (> (path/path-length first) 9.99) (< (path/path-length first) 10.01)))
               (assert (and (> (path/path-length second) 9.99) (< (path/path-length second) 10.01))))
             (path/dashed-path-free! (mut dashed)))
           (let [(mut mesh)
                   (path/path-dashed-stroke-tessellate line
                                                       pattern
                                                       0.0
                                                       4.0
                                                       4.0
                                                       (path/ButtCap)
                                                       (path/MiterJoin)
                                                       0.2)]
             (assert (load (field mesh valid)))
             (assert-eq (al/al-len [path/PathPoint] (load (field mesh vertices))) 12)
             (path/tessellation-free! (mut mesh)))
           (al/al-free! [f32] (mut pattern))
           (path/path-free! (mut line))))

(deftest curve-tolerance-controls-density-and-collinear-reversals-subdivide
         (let [(mut coarse) (path/path-new)
               (mut fine) (path/path-new)
               (mut reversal) (path/path-new)]
           (path/path-move-to! (mut coarse) 0.0 0.0)
           (path/path-quadratic-to! (mut coarse) 50.0 100.0 100.0 0.0 8.0)
           (path/path-move-to! (mut fine) 0.0 0.0)
           (path/path-quadratic-to! (mut fine) 50.0 100.0 100.0 0.0 0.1)
           (assert (> (path/path-point-count fine) (path/path-point-count coarse)))
           (path/path-move-to! (mut reversal) 0.0 0.0)
           (path/path-quadratic-to! (mut reversal) -50.0 0.0 100.0 0.0 0.25)
           (assert (> (path/path-point-count reversal) 2))
           (path/path-free! (mut coarse))
           (path/path-free! (mut fine))
           (path/path-free! (mut reversal))))

(deftest open-and-closed-strokes-produce-bounded-triangle-meshes
         (let [(mut line) (path/path-new)]
           (path/path-move-to! (mut line) 0.0 0.0)
           (path/path-line-to! (mut line) 50.0 0.0)
           (path/path-line-to! (mut line) 50.0 50.0)
           (let [(mut open-stroke) (path/path-stroke-tessellate line 10.0 4.0)]
             (assert (load (field open-stroke valid)))
             ;; Two independent segment quads plus one explicit miter wedge.
             (assert-eq (al/al-len [path/PathPoint] (load (field open-stroke vertices))) 15)
             (path/tessellation-free! (mut open-stroke)))
           (path/path-close! (mut line))
           (let [(mut closed-stroke) (path/path-stroke-tessellate line 10.0 4.0)]
             (assert (load (field closed-stroke valid)))
             (assert-eq (al/al-len [path/PathPoint] (load (field closed-stroke vertices))) 27)
             (path/tessellation-free! (mut closed-stroke)))
           (path/path-free! (mut line))))

(deftest elliptical-arcs-support-full-and-negative-sweeps
         (let [(mut circle) (path/path-new)
               (mut coarse-circle) (path/path-new)
               (mut reverse) (path/path-new)]
           (path/path-arc! (mut circle) 50.0 40.0 30.0 20.0 0.0 360.0 0.2)
           (path/path-arc! (mut coarse-circle) 50.0 40.0 30.0 20.0 0.0 360.0 5.0)
           (assert (> (path/path-point-count circle) 4))
           (assert (> (path/path-point-count circle) (path/path-point-count coarse-circle)))
           (let [points (load (field circle points))
                 first (al/al-get [path/PathPoint] points 0)
                 last (al/al-get [path/PathPoint] points (- (path/path-point-count circle) 1))]
             (assert (and (> (load (field first x)) 79.99)
                          (and (< (load (field first x)) 80.01)
                               (and (> (load (field last x)) 79.99)
                                    (< (load (field last x)) 80.01))))))
           (path/path-arc! (mut reverse) 0.0 0.0 20.0 10.0 90.0 -180.0 0.25)
           (assert (> (path/path-point-count reverse) 3))
           (let [points (load (field reverse points))
                 last (al/al-get [path/PathPoint] points (- (path/path-point-count reverse) 1))]
             (assert (and (> (load (field last y)) -10.01) (< (load (field last y)) -9.99))))
           (path/path-free! (mut circle))
           (path/path-free! (mut coarse-circle))
           (path/path-free! (mut reverse))))

(deftest svg-endpoint-arcs-correct-radii-rotate-and-honor-flags
         (let [(mut fine) (path/path-new)
               (mut coarse) (path/path-new)
               (mut large) (path/path-new)
               (mut degenerate) (path/path-new)]
           (path/path-move-to! (mut fine) 0.0 0.0)
           (path/path-move-to! (mut coarse) 0.0 0.0)
           (path/path-move-to! (mut large) 0.0 0.0)
           (path/path-svg-arc-to! (mut fine) 80.0 40.0 32.0 false true 100.0 20.0 0.1)
           (path/path-svg-arc-to! (mut coarse) 80.0 40.0 32.0 false true 100.0 20.0 4.0)
           (path/path-svg-arc-to! (mut large) 80.0 40.0 32.0 true true 100.0 20.0 0.1)
           (assert (> (path/path-point-count fine) (path/path-point-count coarse)))
           (assert (> (path/path-point-count large) (path/path-point-count fine)))
           (let [points (load (field fine points))
                 last (al/al-get [path/PathPoint] points (- (path/path-point-count fine) 1))
                 bounds (path/path-bounds fine)]
             (do
               (assert (and (> (load (field last x)) 99.999)
                            (< (load (field last x)) 100.001)))
               (assert (and (> (load (field last y)) 19.999)
                            (< (load (field last y)) 20.001)))
               (assert (> (load (field bounds h)) 20.0))))
           ;; SVG specifies zero radii as a straight line to the endpoint.
           (path/path-move-to! (mut degenerate) 2.0 3.0)
           (path/path-svg-arc-to! (mut degenerate) 0.0 10.0 0.0 false false 8.0 9.0 0.2)
           (assert-eq (path/path-point-count degenerate) 2)
           (path/path-free! (mut fine))
           (path/path-free! (mut coarse))
           (path/path-free! (mut large))
           (path/path-free! (mut degenerate))))

(deftest svg-path-data-parses-all-command-families-and-rejects-invalid-input
         (let [(mut data)
                 (svg/svg-path-data-parse c"M10 10 20 10 20 20 H10 V10 z m30 0 c10 0 10 10 20 10 s10 10 20 0 q10 -10 20 0 t20 0 a10 5 30 0 1 20 10 z  "
                                          0.2)
               (mut compact) (svg/svg-path-data-parse c"M1e1-5L20.5.5l-5+4z" 0.2)
               (mut bad-flag) (svg/svg-path-data-parse c"M0 0 A10 10 0 2 0 20 0" 0.2)
               (mut missing) (svg/svg-path-data-parse c"M0 0 C10 10 20" 0.2)
               (mut unknown) (svg/svg-path-data-parse c"M0 0 X10 10" 0.2)]
           (do
             (assert (svg/svg-path-data-valid? data))
             (assert-eq (svg/svg-path-data-contour-count data) 2)
             (let [first (svg/svg-path-data-contour data 0)
                   second (svg/svg-path-data-contour data 1)]
               (do
                 (assert (load (field first closed)))
                 (assert (load (field second closed)))
                 (assert-eq (path/path-point-count first) 5)
                 (assert (> (path/path-point-count second) 20))))
             (assert (svg/svg-path-data-valid? compact))
             (let [contour (svg/svg-path-data-contour compact 0)
                   points (load (field contour points))
                   first (al/al-get [path/PathPoint] points 0)
                   last (al/al-get [path/PathPoint] points (- (path/path-point-count contour) 1))]
               (do
                 (assert (and (> (load (field first x)) 9.999)
                              (< (load (field first x)) 10.001)))
                 (assert (and (> (load (field first y)) -5.001)
                              (< (load (field first y)) -4.999)))
                 (assert (and (> (load (field last x)) 15.499)
                              (< (load (field last x)) 15.501)))
                 (assert (and (> (load (field last y)) 4.499)
                              (< (load (field last y)) 4.501)))))
             (assert (not (svg/svg-path-data-valid? bad-flag)))
             (assert (not (svg/svg-path-data-valid? missing)))
             (assert (not (svg/svg-path-data-valid? unknown)))
             (svg/svg-path-data-free! (mut unknown))
             (svg/svg-path-data-free! (mut missing))
             (svg/svg-path-data-free! (mut bad-flag))
             (svg/svg-path-data-free! (mut compact))
             (svg/svg-path-data-free! (mut data)))))

(deftest retained-svg-vectors-tessellate-once-and-paint-contained-metal-paths
         (let [(mut vector)
                 (svg/svg-vector-new c"M0 0 L20 0 L20 10 L0 10 z M30 0 L40 0 L40 10 L30 10 z"
                                     0.2)
               (mut invalid) (svg/svg-vector-new c"M0 0 L10 0" 0.2)
               (mut scene) (scene-new)]
           (do
             (assert (svg/svg-vector-valid? vector))
             (assert (not (svg/svg-vector-valid? invalid)))
             (assert-eq (svg/svg-vector-paint! (mut scene)
                                               vector
                                               (rect 0.0 0.0 100.0 100.0)
                                               (rgb 0.2 0.8 1.0)
                                               8100)
                        1)
             (assert-eq (al/al-len [PathDraw] (load (field scene path-draws))) 1)
             (assert-eq (al/al-len [PaintCommand] (load (field scene paint-commands))) 1)
             (let [first (al/al-elem [PathDraw] (field scene path-draws) 0)]
               (do
                 (assert (and (> (load (field (field first transform) m11)) 2.499)
                              (< (load (field (field first transform) m11)) 2.501)))
                 (assert (and (> (load (field (field first transform) ty)) 37.499)
                              (< (load (field (field first transform) ty)) 37.501)))
                 (assert-eq (load (field first id)) 8100)))
             ;; Painting reuses retained tessellations while scene storage remains transient.
             (scene-clear! (mut scene))
             (assert-eq (svg/svg-vector-paint! (mut scene)
                                               vector
                                               (rect 10.0 20.0 80.0 40.0)
                                               (rgb 1.0 1.0 1.0)
                                               8200)
                        1)
             (scene-free! (mut scene))
             (svg/svg-vector-free! (mut invalid))
             (svg/svg-vector-free! (mut vector)))))

(defn svg-vector-triangle-area [(vector svg/SvgVector)] (-> f32)
  (let [mesh (al/al-get [path/Tessellation] (load (field vector meshes)) 0)
        vertices (load (field mesh vertices))
        (mut area) (primitive/cast f32 0.0)
        (mut i) (primitive/cast i64 0)]
    (do
      (while (< (load i) (al/al-len [path/PathPoint] vertices))
        (let [a (al/al-get [path/PathPoint] vertices (load i))
              b (al/al-get [path/PathPoint] vertices (+ (load i) 1))
              c (al/al-get [path/PathPoint] vertices (+ (load i) 2))]
          (do
            (store! area
                    (+ (load area)
                       (* (- (* (- (load (field b x)) (load (field a x)))
                                  (- (load (field c y)) (load (field a y))))
                               (* (- (load (field b y)) (load (field a y)))
                                  (- (load (field c x)) (load (field a x)))))
                          0.5)))
            (store! i (+ (load i) 3)))))
      (load area))))

(deftest compound-svg-fill-rules-preserve-holes-islands-and-winding
  (let [(mut nonzero-same)
          (svg/svg-vector-new-with-fill-rule
            c"M0 0 H100 V100 H0 Z M25 25 H75 V75 H25 Z"
            0.1
            (svg/FillRuleNonzero))
        (mut evenodd-same)
          (svg/svg-vector-new-with-fill-rule
            c"M0 0 H100 V100 H0 Z M25 25 H75 V75 H25 Z"
            0.1
            (svg/FillRuleEvenodd))
        (mut nonzero-opposite)
          (svg/svg-vector-new-with-fill-rule
            c"M0 0 H100 V100 H0 Z M25 25 V75 H75 V25 Z"
            0.1
            (svg/FillRuleNonzero))
        (mut intersecting)
          (svg/svg-vector-new-with-fill-rule
            c"M0 0 H60 V60 H0 Z M40 40 H100 V100 H40 Z"
            0.1
            (svg/FillRuleEvenodd))]
    (do
      (assert (svg/svg-vector-valid? nonzero-same))
      (assert (svg/svg-vector-valid? evenodd-same))
      (assert (svg/svg-vector-valid? nonzero-opposite))
      (assert (not (svg/svg-vector-valid? intersecting)))
      (assert (> (svg-vector-triangle-area nonzero-same) 9999.9))
      (assert (< (svg-vector-triangle-area nonzero-same) 10000.1))
      (assert (> (svg-vector-triangle-area evenodd-same) 7499.9))
      (assert (< (svg-vector-triangle-area evenodd-same) 7500.1))
      (assert (> (svg-vector-triangle-area nonzero-opposite) 7499.9))
      (assert (< (svg-vector-triangle-area nonzero-opposite) 7500.1))
      (svg/svg-vector-free! (mut intersecting))
      (svg/svg-vector-free! (mut nonzero-opposite))
      (svg/svg-vector-free! (mut evenodd-same))
      (svg/svg-vector-free! (mut nonzero-same)))))

(deftest stroke-caps-produce-square-extensions-and-adaptive-round-fans
         (let [(mut line) (path/path-new)]
           (path/path-move-to! (mut line) 10.0 20.0)
           (path/path-line-to! (mut line) 50.0 20.0)
           (let [(mut butt) (path/path-stroke-tessellate-cap line 10.0 4.0 (path/ButtCap) 0.2)
                 (mut square) (path/path-stroke-tessellate-cap line 10.0 4.0 (path/SquareCap) 0.2)
                 (mut round) (path/path-stroke-tessellate-cap line 10.0 4.0 (path/RoundCap) 0.2)]
             (assert-eq (al/al-len [path/PathPoint] (load (field butt vertices))) 6)
             (assert-eq (al/al-len [path/PathPoint] (load (field square vertices))) 6)
             (assert (> (al/al-len [path/PathPoint] (load (field round vertices))) 12))
             (let [square-points (load (field square vertices))
                   first (al/al-get [path/PathPoint] square-points 0)
                   last (al/al-get [path/PathPoint] square-points 5)]
               (assert (and (> (load (field first x)) 4.99)
                            (and (< (load (field first x)) 5.01)
                                 (and (> (load (field last x)) 54.99)
                                      (< (load (field last x)) 55.01))))))
             (path/tessellation-free! (mut butt))
             (path/tessellation-free! (mut square))
             (path/tessellation-free! (mut round)))
           (path/path-free! (mut line))))

(deftest stroke-join-styles-emit-explicit-wedges-and-miter-fallbacks
         (let [(mut corner) (path/path-new)]
           (path/path-move-to! (mut corner) 0.0 20.0)
           (path/path-line-to! (mut corner) 20.0 20.0)
           (path/path-line-to! (mut corner) 21.0 0.0)
           (let [(mut bevel)
                   (path/path-stroke-tessellate-style corner
                                                      8.0
                                                      4.0
                                                      (path/ButtCap)
                                                      (path/BevelJoin)
                                                      0.2)
                 (mut limited-miter)
                   (path/path-stroke-tessellate-style corner
                                                      8.0
                                                      1.0
                                                      (path/ButtCap)
                                                      (path/MiterJoin)
                                                      0.2)
                 (mut round)
                   (path/path-stroke-tessellate-style corner
                                                      8.0
                                                      4.0
                                                      (path/ButtCap)
                                                      (path/RoundJoin)
                                                      0.1)]
             (assert-eq (al/al-len [path/PathPoint] (load (field bevel vertices))) 15)
             ;; A miter beyond its limit falls back to the same bevel wedge.
             (assert-eq (al/al-len [path/PathPoint] (load (field limited-miter vertices))) 15)
             (assert (> (al/al-len [path/PathPoint] (load (field round vertices))) 15))
             (path/tessellation-free! (mut bevel))
             (path/tessellation-free! (mut limited-miter))
             (path/tessellation-free! (mut round)))
           (path/path-free! (mut corner))))

(deftest hierarchical-dispatch-orders-capture-target-and-bubble
         (let [(mut scene) (scene-new)]
           (scene-hitbox! (mut scene) (rect 0.0 0.0 100.0 100.0) 10 -1 false true)
           (scene-hitbox! (mut scene) (rect 10.0 10.0 80.0 80.0) 20 10 false true)
           (scene-hitbox! (mut scene) (rect 20.0 20.0 40.0 40.0) 30 20 true true)
           (let [(mut plan) (input/dispatch-plan scene 30)
                 steps (load (field plan steps))]
             (assert (load (field plan valid)))
             (assert-eq (al/al-len [input/DispatchStep] steps) 5)
             (let [data (load (field steps data))]
               (assert-eq (load (field (primitive/index data 0) target)) 10)
               (assert-eq (load (field (primitive/index data 0) phase)) 0)
               (assert-eq (load (field (primitive/index data 1) target)) 20)
               (assert-eq (load (field (primitive/index data 2) target)) 30)
               (assert-eq (load (field (primitive/index data 2) phase)) 1)
               (assert-eq (load (field (primitive/index data 3) target)) 20)
               (assert-eq (load (field (primitive/index data 3) phase)) 2)
               (assert-eq (load (field (primitive/index data 4) target)) 10))
             (input/dispatch-plan-free! (mut plan)))
           (scene-free! (mut scene))))

(deftest hierarchical-listeners-resolve-in-phase-and-registration-order
         (let [(mut scene) (scene-new)
               (mut registry) (input/listener-registry-new)]
           (scene-hitbox! (mut scene) (rect 0.0 0.0 100.0 100.0) 10 -1 false true)
           (scene-hitbox! (mut scene) (rect 10.0 10.0 80.0 80.0) 20 10 true true)
           (input/listener-register! (mut registry) 10 0 101)
           (input/listener-register! (mut registry) 10 0 102)
           (input/listener-register! (mut registry) 20 1 201)
           (input/listener-register! (mut registry) 10 2 301)
           (let [listeners (load (field registry listeners))
                 data (load (field listeners data))]
             (assert-eq (primitive/sizeof input/Listener) 12)
             (assert-eq (load (field (primitive/index data 0) target)) 10)
             (assert-eq (load (field (primitive/index data 0) phase)) 0)
             (assert-eq (load (field (primitive/index data 0) token)) 101)
             (assert-eq (load (field (primitive/index data 2) phase)) 1)
             (assert-eq (load (field (primitive/index data 2) token)) 201))
           (let [(mut plan) (input/dispatch-plan scene 20)
                 (mut invocations) (input/resolve-listeners registry plan)]
             (assert-eq (al/al-len [input/Invocation] invocations) 4)
             (let [data (load (field invocations data))]
               (assert-eq (load (field (primitive/index data 0) token)) 101)
               (assert-eq (load (field (primitive/index data 1) token)) 102)
               (assert-eq (load (field (primitive/index data 2) token)) 201)
               (assert-eq (load (field (primitive/index data 3) token)) 301))
             (al/al-free! [input/Invocation] (mut invocations))
             (input/dispatch-plan-free! (mut plan)))
           (input/listener-registry-free! (mut registry))
           (scene-free! (mut scene))))

(deftest dispatch-cursor-stops-before-target-and-bubble-listeners
         (let [(mut scene) (scene-new)
               (mut registry) (input/listener-registry-new)]
           (scene-hitbox! (mut scene) (rect 0.0 0.0 100.0 100.0) 10 -1 false true)
           (scene-hitbox! (mut scene) (rect 10.0 10.0 80.0 80.0) 20 10 true true)
           (input/listener-register! (mut registry) 10 0 101)
           (input/listener-register! (mut registry) 20 1 201)
           (input/listener-register! (mut registry) 10 2 301)
           (let [(mut plan) (input/dispatch-plan scene 20)
                 (mut cursor) (input/dispatch-cursor-new registry plan)]
             (assert (input/dispatch-cursor-has-next? cursor))
             (assert-eq (input/dispatch-cursor-token (mut cursor)) 101)
             (assert-eq (input/dispatch-cursor-target (mut cursor)) 10)
             (assert-eq (input/dispatch-cursor-phase (mut cursor)) 0)
             (input/dispatch-cursor-stop! (mut cursor))
             (assert (not (input/dispatch-cursor-has-next? cursor)))
             ;; Stopping is terminal even if a caller tries to advance afterward.
             (assert-eq (input/dispatch-cursor-advance! (mut cursor)) 0)
             (assert (not (input/dispatch-cursor-has-next? cursor)))
             (input/dispatch-cursor-free! (mut cursor))
             (input/dispatch-plan-free! (mut plan)))
           (input/listener-registry-free! (mut registry))
           (scene-free! (mut scene))))

(deftest preventing-default-does-not-stop-event-propagation
         (let [(mut scene) (scene-new)
               (mut registry) (input/listener-registry-new)]
           (scene-hitbox! (mut scene) (rect 0.0 0.0 100.0 100.0) 10 -1 false true)
           (scene-hitbox! (mut scene) (rect 10.0 10.0 80.0 80.0) 20 10 true true)
           (input/listener-register! (mut registry) 10 0 101)
           (input/listener-register! (mut registry) 20 1 201)
           (input/listener-register! (mut registry) 10 2 301)
           (let [(mut plan) (input/dispatch-plan scene 20)
                 (mut cursor) (input/dispatch-cursor-new registry plan)]
             (assert (not (input/dispatch-cursor-default-prevented? cursor)))
             (input/dispatch-cursor-prevent-default! (mut cursor))
             (assert (input/dispatch-cursor-default-prevented? cursor))
             (input/dispatch-cursor-advance! (mut cursor))
             (assert (input/dispatch-cursor-has-next? cursor))
             (assert-eq (input/dispatch-cursor-token (mut cursor)) 201)
             (input/dispatch-cursor-advance! (mut cursor))
             (assert-eq (input/dispatch-cursor-token (mut cursor)) 301)
             (input/dispatch-cursor-advance! (mut cursor))
             (assert (not (input/dispatch-cursor-has-next? cursor)))
             (assert (input/dispatch-cursor-default-prevented? cursor))
             (input/dispatch-cursor-free! (mut cursor))
             (input/dispatch-plan-free! (mut plan)))
           (input/listener-registry-free! (mut registry))
           (scene-free! (mut scene))))

(deftest keymap-prefers-deepest-context-then-latest-binding
         (let [(mut map) (keymap/keymap-new)
               (mut contexts) (al/al-new [i32] (alloc/malloc-allocator))]
           (keymap/keymap-bind! (mut map) 15 8 -1 100)
           (keymap/keymap-bind! (mut map) 15 8 10 200)
           (keymap/keymap-bind! (mut map) 15 8 20 300)
           (keymap/keymap-bind! (mut map) 15 8 20 301)
           (al/al-push! [i32] (mut contexts) 10)
           (al/al-push! [i32] (mut contexts) 20)
           (let [(mut input-strokes) (al/al-new [keymap/KeyStroke] (alloc/malloc-allocator))]
             (test-keystroke-push! (mut input-strokes) 15 8)
             (let [resolution
                     (keymap/keymap-resolve map
                                            (load (field input-strokes data))
                                            1
                                            (load (field contexts data))
                                            2)]
               (assert (load (field resolution matched)))
               (assert-eq (load (field resolution action)) 301)
               (assert-eq (load (field resolution depth)) 2)
               (assert (not (load (field resolution pending)))))
             (al/al-free! [keymap/KeyStroke] (mut input-strokes)))
           (assert-eq (keymap/keymap-version map) 4)
           (al/al-free! [i32] (mut contexts))
           (keymap/keymap-free! (mut map))))

(deftest keymap-disabled-binding-shadows-weaker-context
         (let [(mut map) (keymap/keymap-new)
               (mut contexts) (al/al-new [i32] (alloc/malloc-allocator))
               (mut input-strokes) (al/al-new [keymap/KeyStroke] (alloc/malloc-allocator))]
           (keymap/keymap-bind! (mut map) 48 0 -1 100)
           (keymap/keymap-disable! (mut map) 48 0 20)
           (al/al-push! [i32] (mut contexts) 10)
           (al/al-push! [i32] (mut contexts) 20)
           (test-keystroke-push! (mut input-strokes) 48 0)
           (let [resolution
                   (keymap/keymap-resolve map
                                          (load (field input-strokes data))
                                          1
                                          (load (field contexts data))
                                          2)]
             (assert (not (load (field resolution matched))))
             (assert-eq (load (field resolution depth)) 2)
             (assert-eq (load (field resolution binding-index)) 1))
           (al/al-free! [keymap/KeyStroke] (mut input-strokes))
           (al/al-free! [i32] (mut contexts))
           (keymap/keymap-free! (mut map))))

(deftest keymap-multi-stroke-prefix-reports-pending-then-matches
         (let [(mut map) (keymap/keymap-new)
               (mut sequence) (al/al-new [keymap/KeyStroke] (alloc/malloc-allocator))]
           (test-keystroke-push! (mut sequence) 7 8)
           (test-keystroke-push! (mut sequence) 13 0)
           (keymap/keymap-bind-sequence! (mut map)
                                         (load (field sequence data))
                                         2
                                         -1
                                         700)
           (let [prefix
                   (keymap/keymap-resolve map
                                          (load (field sequence data))
                                          1
                                          (primitive/cast (ptr i32) 0)
                                          0)
                 exact
                   (keymap/keymap-resolve map
                                          (load (field sequence data))
                                          2
                                          (primitive/cast (ptr i32) 0)
                                          0)]
             (assert (not (load (field prefix matched))))
             (assert (load (field prefix pending)))
             (assert (load (field exact matched)))
             (assert-eq (load (field exact action)) 700)
             (assert (not (load (field exact pending)))))
           (al/al-free! [keymap/KeyStroke] (mut sequence))
           (keymap/keymap-free! (mut map))))

(deftest key-dispatcher-retains-chords-and-retries-failed-final-keys
         (let [(mut map) (keymap/keymap-new)
               (mut dispatcher) (keymap/key-dispatcher-new)
               (mut sequence) (al/al-new [keymap/KeyStroke] (alloc/malloc-allocator))]
           (test-keystroke-push! (mut sequence) 7 (primitive/cast i32 keymap/modifier-command))
           (test-keystroke-push! (mut sequence) 13 0)
           (keymap/keymap-bind-sequence! (mut map)
                                         (load (field sequence data))
                                         2
                                         -1
                                         700)
           (keymap/keymap-bind! (mut map) 14 0 -1 800)
           (let [prefix
                   (keymap/key-dispatcher-push! (mut dispatcher)
                                                map
                                                7
                                                (primitive/cast i32 keymap/modifier-command)
                                                (primitive/cast (ptr i32) 0)
                                                0)]
             (assert (load (field prefix pending)))
             (assert (not (load (field prefix matched)))))
           (let [exact
                   (keymap/key-dispatcher-push! (mut dispatcher)
                                                map
                                                13
                                                0
                                                (primitive/cast (ptr i32) 0)
                                                0)]
             (assert (load (field exact matched)))
             (assert-eq (load (field exact action)) 700))
           (keymap/key-dispatcher-push! (mut dispatcher)
                                        map
                                        7
                                        (primitive/cast i32 keymap/modifier-command)
                                        (primitive/cast (ptr i32) 0)
                                        0)
           (let [retried
                   (keymap/key-dispatcher-push! (mut dispatcher)
                                                map
                                                14
                                                0
                                                (primitive/cast (ptr i32) 0)
                                                0)]
             (assert (load (field retried matched)))
             (assert-eq (load (field retried action)) 800))
           (al/al-free! [keymap/KeyStroke] (mut sequence))
           (keymap/key-dispatcher-free! (mut dispatcher))
           (keymap/keymap-free! (mut map))))

(deftest key-context-predicates-support-attributes-boolean-logic-and-ancestry
         (let [(mut stack) (key-context/context-stack-new)
               (mut predicate)
                 (key-context/context-predicate-parse "os == macos > Editor && mode == full && !read_only")]
           (key-context/context-stack-push-layer! (mut stack))
           (key-context/context-stack-add! (mut stack) "Workspace")
           (key-context/context-stack-set! (mut stack) "os" "macos")
           (key-context/context-stack-push-layer! (mut stack))
           (key-context/context-stack-add! (mut stack) "Pane")
           (key-context/context-stack-push-layer! (mut stack))
           (key-context/context-stack-add! (mut stack) "Editor")
           (key-context/context-stack-set! (mut stack) "mode" "full")
           (assert (key-context/context-predicate-valid? (load predicate)))
           (assert-eq (key-context/context-predicate-depth (load predicate) (load stack)) 3)
           (key-context/context-stack-add! (mut stack) "read_only")
           (assert-eq (key-context/context-predicate-depth (load predicate) (load stack)) -1)
           (key-context/context-predicate-free! (mut predicate))
           (let [(mut unequal) (key-context/context-predicate-parse "mode != full")
                 (mut absent) (key-context/context-predicate-parse "missing != value")]
             ;; `!=` is true when the key is absent, matching GPUI: the Editor
             ;; layer is rejected but the predicate matches the Pane layer.
             (assert-eq (key-context/context-predicate-depth (load unequal) (load stack)) 2)
             (assert-eq (key-context/context-predicate-depth (load absent) (load stack)) 3)
             (key-context/context-predicate-free! (mut unequal))
             (key-context/context-predicate-free! (mut absent)))
           (key-context/context-stack-free! (mut stack))))

(deftest keymap-context-resolution-reports-winning-source-and-shadowed-candidates
         (let [(mut map) (keymap/keymap-new)
               (mut stack) (key-context/context-stack-new)
               (mut strokes) (al/al-new [keymap/KeyStroke] (alloc/malloc-allocator))]
           (key-context/context-stack-push-layer! (mut stack))
           (key-context/context-stack-add! (mut stack) "Workspace")
           (key-context/context-stack-push-layer! (mut stack))
           (key-context/context-stack-add! (mut stack) "Editor")
           (key-context/context-stack-set! (mut stack) "mode" "full")
           (assert (> (keymap/keymap-bind-context! (mut map) 15 8 "Workspace" 100 3 700 4 9) 0))
           (assert (> (keymap/keymap-bind-context! (mut map) 15 8 "Editor && mode == full" 200 0 900 12 5) 0))
           (test-keystroke-push! (mut strokes) 15 8)
           (let [resolution
                   (keymap/keymap-resolve-contexts map
                                                   (load (field strokes data))
                                                   1
                                                   (load stack))]
             (assert (load (field resolution matched)))
             (assert-eq (load (field resolution action)) 200)
             (assert-eq (load (field resolution depth)) 2)
             (assert-eq (load (field resolution source-kind)) 0)
             (assert-eq (load (field resolution source-id)) 900)
             (assert-eq (load (field resolution source-line)) 12)
             (assert-eq (load (field resolution source-column)) 5)
             (assert-eq (load (field resolution candidate-count)) 2)
             (assert-eq (load (field resolution shadowed-count)) 1)
             (assert-eq (load (field resolution context-rejected-count)) 0))
           (let [bad (keymap/keymap-bind-context! (mut map) 16 0 "Editor && )" 300 1 4 1 1)]
             (assert (< bad 0))
             (assert-eq (keymap/keymap-version map) 2))
           (al/al-free! [keymap/KeyStroke] (mut strokes))
           (key-context/context-stack-free! (mut stack))
           (keymap/keymap-free! (mut map))))

(deftest retained-entity-generations-reject-stale-reused-handles
         (let [drops (primitive/alloc-stack i64)
               (mut store) (retained/entity-store-new [RetainedDropProbe])
               first
                 (retained/entity-store-create! [RetainedDropProbe]
                                                (mut store)
                                                (RetainedDropProbe :counter drops
                                                  :value 11))]
           (store! drops 0)
           (assert (retained/entity-store-alive? [RetainedDropProbe] store first))
           (let [value (retained/entity-store-get [RetainedDropProbe] (mut store) first)]
             (assert (!= (primitive/cast i64 value) 0))
             (assert-eq (load (field value value)) 11))
           (assert (retained/entity-store-remove! [RetainedDropProbe] (mut store) first))
           (assert-eq (load drops) 1)
           (assert (not (retained/entity-store-alive? [RetainedDropProbe] store first)))
           (let [second
                   (retained/entity-store-create! [RetainedDropProbe]
                                                  (mut store)
                                                  (RetainedDropProbe :counter drops
                                                    :value 22))]
             (assert-eq (load (field first slot)) (load (field second slot)))
             (assert (!= (load (field first generation)) (load (field second generation))))
             (assert (= (primitive/cast i64
                                        (retained/entity-store-get [RetainedDropProbe]
                                                                   (mut store)
                                                                   first))
                        0))
             (let [value (retained/entity-store-get [RetainedDropProbe] (mut store) second)]
               (assert-eq (load (field value value)) 22)))
           (retained/entity-store-free! [RetainedDropProbe] (mut store))
           (assert-eq (load drops) 2)))

(deftest typed-entities-clone-downgrade-upgrade-and-drop-exactly-once
         (let [drops (primitive/alloc-stack i64)]
           (store! drops 0)
           (match (entity/entity-map-new [RetainedDropProbe])
             (None [] (assert false))
             (Some [map]
                   (let [owner
                           (entity/entity-map-create! [RetainedDropProbe]
                                                      map
                                                      (RetainedDropProbe :counter drops
                                                        :value 41))
                         weak (entity/entity-downgrade [RetainedDropProbe] owner)]
                     (do
                       (assert-eq (entity/entity-map-alive-count [RetainedDropProbe] map) 1)
                       (assert-eq (entity/entity-strong-count [RetainedDropProbe] owner) 1)
                       (let [duplicate (clone owner)]
                         (do
                           (assert-eq (entity/entity-strong-count [RetainedDropProbe] owner) 2)
                           (let [value (entity/entity-read [RetainedDropProbe] duplicate)]
                             (assert-eq (load (field value value)) 41))))
                       (assert-eq (entity/entity-strong-count [RetainedDropProbe] owner) 1)
                       (match (entity/weak-entity-upgrade [RetainedDropProbe] weak)
                         (None [] (assert false))
                         (Some [upgraded]
                               (assert-eq (entity/entity-strong-count [RetainedDropProbe] upgraded) 2)))
                       (assert-eq (entity/entity-strong-count [RetainedDropProbe] owner) 1)
                       (assert-eq (load drops) 0)))))
           ;; The map, owner, upgraded clone, and weak handle are all out of
           ;; scope; only the entity value contributes to this counter.
           (assert-eq (load drops) 1)))

(deftest weak-entities-expire-and-generation-check-reused-slots
         (let [drops (primitive/alloc-stack i64)]
           (store! drops 0)
           (match (entity/entity-map-new [RetainedDropProbe])
             (None [] (assert false))
             (Some [map]
                   (let [expired (make-expired-entity-weak map drops)
                         old-id (load (field expired id))]
                     (do
                       (assert-eq (load drops) 1)
                       (assert (not (entity/weak-entity-alive? [RetainedDropProbe] expired)))
                       (match (entity/weak-entity-upgrade [RetainedDropProbe] expired)
                         (None [] (assert true))
                         (Some [unexpected] (assert false)))
                       (let [replacement
                               (entity/entity-map-create! [RetainedDropProbe]
                                                          map
                                                          (RetainedDropProbe :counter drops
                                                            :value 99))
                             new-id (entity/entity-id [RetainedDropProbe] replacement)]
                         (do
                           (assert-eq (load (field old-id slot)) (load (field new-id slot)))
                           (assert (!= (load (field old-id generation))
                                       (load (field new-id generation))))
                           (assert (not (entity/weak-entity-alive? [RetainedDropProbe] expired)))
                           (assert-eq (entity/entity-map-alive-count [RetainedDropProbe] map) 1)))))))
           (assert-eq (load drops) 2)))

(deftest reactive-dependencies-deduplicate-prune-and-reuse-consumers-safely
         (let [(mut graph) (reactive/reactive-graph-new)
               first (reactive/reactive-register-consumer! (mut graph))
               second (reactive/reactive-register-consumer! (mut graph))
               state-a (reactive/dependency-key 1 10 1)
               state-b (reactive/dependency-key 1 20 1)]
           (assert (reactive/reactive-begin! (mut graph) first))
           (assert (reactive/reactive-observe! (mut graph) state-a))
           (assert (not (reactive/reactive-observe! (mut graph) state-a)))
           (assert (reactive/reactive-end! (mut graph) first))
           (assert (reactive/reactive-begin! (mut graph) second))
           (assert (reactive/reactive-observe! (mut graph) state-b))
           (assert (reactive/reactive-end! (mut graph) second))
           (assert-eq (reactive/reactive-edge-count graph) 2)
           (assert-eq (reactive/reactive-notify! (mut graph) state-a) 1)
           ;; A second notification is coalesced while the consumer is dirty.
           (assert-eq (reactive/reactive-notify! (mut graph) state-a) 0)
           (assert-eq (reactive/reactive-dirty-count graph) 1)
           (reactive/reactive-clear-dirty! (mut graph))
           ;; Recapturing first without state-a dynamically removes that edge.
           (assert (reactive/reactive-begin! (mut graph) first))
           (assert (reactive/reactive-observe! (mut graph) state-b))
           (assert (reactive/reactive-end! (mut graph) first))
           (assert-eq (reactive/reactive-edge-count graph) 2)
           (assert-eq (reactive/reactive-notify! (mut graph) state-a) 0)
           (assert-eq (reactive/reactive-notify! (mut graph) state-b) 2)
           (reactive/reactive-clear-dirty! (mut graph))
           (assert (reactive/reactive-unregister-consumer! (mut graph) second))
           (let [replacement (reactive/reactive-register-consumer! (mut graph))]
             (do
               (assert-eq (load (field replacement slot)) (load (field second slot)))
               (assert (!= (load (field replacement generation))
                           (load (field second generation))))
               ;; The stale edge for second must not dirty its slot replacement.
               (assert-eq (reactive/reactive-notify! (mut graph) state-b) 1)
               (assert-eq (reactive/reactive-dirty-count graph) 1)))
           (reactive/reactive-graph-free! (mut graph))))

(deftest reactive-entity-keys-connect-typed-entities-to-consumers
         (match (entity/entity-map-new [i64])
           (None [] (assert false))
           (Some [map]
                 (let [state (entity/entity-map-create! [i64] map 12)
                       id (entity/entity-id [i64] state)
                       (mut graph) (reactive/reactive-graph-new)
                       consumer (reactive/reactive-register-consumer! (mut graph))]
                   (do
                     (assert (reactive/reactive-begin! (mut graph) consumer))
                     (assert (reactive/reactive-observe-entity! (mut graph) id))
                     (assert (reactive/reactive-end! (mut graph) consumer))
                     (assert-eq (reactive/reactive-notify-entity! (mut graph) id) 1)
                     (assert-eq (reactive/reactive-dirty-count graph) 1)
                     (reactive/reactive-graph-free! (mut graph)))))))

(deftest retained-observers-queue-in-order-and-unsubscribe-by-generation
         (let [(mut store) (retained/entity-store-new [i64])
               subject (retained/entity-store-create! [i64] (mut store) 42)
               (mut hub) (retained/observation-hub-new)
               first (retained/observation-subscribe! (mut hub) subject 101)
               second (retained/observation-subscribe! (mut hub) subject 102)]
           (assert-eq (retained/observation-notify! (mut hub) subject) 2)
           (assert-eq (load (field (retained/observation-at (mut hub) 0) token)) 101)
           (assert-eq (load (field (retained/observation-at (mut hub) 1) token)) 102)
           (retained/observation-clear! (mut hub))
           (assert (retained/observation-unsubscribe! (mut hub) first))
           (let [replacement (retained/observation-subscribe! (mut hub) subject 103)]
             (assert (not (retained/observation-unsubscribe! (mut hub) first)))
             (assert-eq (retained/observation-notify! (mut hub) subject) 2)
             ;; The surviving old subscription keeps registration-slot order;
             ;; the reused slot follows it during the observer scan.
             (assert-eq (load (field (retained/observation-at (mut hub) 0) token)) 103)
             (assert-eq (load (field (retained/observation-at (mut hub) 1) token)) 102)
             (assert (retained/observation-unsubscribe! (mut hub) replacement)))
           (assert (retained/observation-unsubscribe! (mut hub) second))
           (retained/observation-hub-free! (mut hub))
           (retained/entity-store-free! [i64] (mut store))))

(deftest retained-callback-observers-use-snapshot-order-and-generation-cancellation
         (let [(mut store) (retained/entity-store-new [i64])
               subject (retained/entity-store-create! [i64] (mut store) 42)
               hub (primitive/alloc-stack retained/ObservationHub)
               first-probe (primitive/alloc-stack ObservationCallbackProbe)
               second-probe (primitive/alloc-stack ObservationCallbackProbe)]
           (do
             (store! hub (retained/observation-hub-new))
             (store! first-probe (primitive/zeroed ObservationCallbackProbe))
             (store! second-probe (primitive/zeroed ObservationCallbackProbe))
             (store! (field first-probe hub) hub)
             (store! (field second-probe hub) hub)
             (retained/observation-subscribe-callback! hub
                                                       subject
                                                       201
                                                       (primitive/fnptr-of retained-observation-callback)
                                                       (primitive/cast (ptr i8) first-probe))
             (let [second
                     (retained/observation-subscribe-callback! hub
                                                               subject
                                                               202
                                                               (primitive/fnptr-of retained-observation-callback)
                                                               (primitive/cast (ptr i8) second-probe))]
               (do
                 (store! (field first-probe cancel) second)
                 (store! (field first-probe cancel-other) true)
                 ;; Dispatch snapshots registration order. The first callback may
                 ;; unsubscribe the second safely; the current snapshot still runs
                 ;; both, while later notifications only invoke the survivor.
                 (assert-eq (retained/observation-notify! hub subject) 2)
                 (assert-eq (load (field first-probe calls)) 1)
                 (assert-eq (load (field second-probe calls)) 1)
                 (assert-eq (load (field first-probe received-token)) 201)
                 (assert-eq (load (field second-probe received-token)) 202)
                 (assert-eq (retained/observation-notify! hub subject) 3)
                 (assert-eq (load (field first-probe calls)) 2)
                 (assert-eq (load (field second-probe calls)) 1)))
             (retained/observation-hub-free! hub)
             (retained/entity-store-free! [i64] (mut store)))))

(deftest focus-and-actions-survive-transient-scenes
         (let [(mut scene) (scene-new)
               (mut router) (input/router-new)]
           (button! (mut scene)
                    (rect 0.0 0.0 100.0 30.0)
                    (ButtonState
                      :hovered false
                      :pressed false
                      :focused false
                      :disabled false)
                    10)
           (button! (mut scene)
                    (rect 0.0 40.0 100.0 30.0)
                    (ButtonState
                      :hovered false
                      :pressed false
                      :focused false
                      :disabled true)
                    11)
           (checkbox! (mut scene)
                      (rect 0.0 80.0 24.0 24.0)
                      (CheckboxState
                        :checked false
                        :hovered false
                        :focused false
                        :disabled false)
                      12)
           (assert-eq (input/focus-next scene -1 1) 10)
           (assert-eq (input/focus-next scene 10 1) 12)
           (assert-eq (input/focus-next scene 10 -1) 12)
           (input/router-pointer-down! (mut router) scene 10.0 10.0)
           (let [event (input/router-pointer-up! (mut router) scene 10.0 10.0)]
             (assert-eq (load (field event action)) (primitive/cast i32 input/action-activate))
             (assert-eq (load (field event target)) 10))
           (let [tab (input/router-key! (mut router) scene 48 false)
                 activate (input/router-key! (mut router) scene 49 false)]
             (assert-eq (load (field tab action)) (primitive/cast i32 input/action-none))
             (assert-eq (load (field activate action)) (primitive/cast i32 input/action-activate))
             (assert-eq (load (field activate target)) 12))
           (scene-free! (mut scene))))

(deftest virtual-list-bounds-work-is-independent-of-item-count
         (let [(mut state) (primitive/zeroed scroll/ScrollState)]
           (store! state (scroll/scroll-new 1000000 24.0 2))
           (scroll/scroll-configure! (mut state) (rect 10.0 20.0 300.0 240.0) 1000000 24.0)
           (assert-eq (scroll/visible-first state) 0)
           (assert-eq (scroll/visible-last state) 13)
           (assert-eq (scroll/visible-count state) 13)
           (scroll/scroll-to! (mut state) 12000.0)
           (assert-eq (scroll/visible-first state) 498)
           (assert-eq (scroll/visible-last state) 513)
           (assert-eq (scroll/visible-count state) 15)))

(deftest virtual-list-clamps-bottom-and-keeps-scrollbar-thumb
         (let [(mut scene) (scene-new)
               (mut state) (primitive/zeroed scroll/ScrollState)]
           (store! state (scroll/scroll-new 10000 20.0 1))
           (scroll/scroll-configure! (mut state) (rect 0.0 0.0 200.0 100.0) 10000 20.0)
           (scroll/scroll-to! (mut state) 1000000.0)
           (assert (and (> (load (field state offset)) 199899.0)
                        (< (load (field state offset)) 199901.0)))
           (assert-eq (scroll/visible-last state) 10000)
           (scroll/scrollbar! (mut scene) state 77)
           (assert-eq (al/al-len [Primitive] (load (field scene items))) 2)
           (let [track (al/al-get [Primitive] (load (field scene items)) 0)
                 thumb (al/al-get [Primitive] (load (field scene items)) 1)
                 track-bounds (load (field track bounds))
                 thumb-bounds (load (field thumb bounds))]
             (assert (> (load (field thumb-bounds h)) 0.0))
             (assert (<= (+ (load (field thumb-bounds y)) (load (field thumb-bounds h)))
                         (+ (load (field track-bounds y)) (load (field track-bounds h))))))
           (scene-free! (mut scene))))

(deftest variable-list-prefix-lookup-measurement-and-anchoring
         (let [(mut state) (primitive/zeroed variable/VariableScrollState)]
           (store! state (variable/variable-scroll-new 6 10.0 1))
           (variable/variable-scroll-configure! (mut state) (rect 0.0 0.0 200.0 25.0))
           (variable/variable-scroll-measure! (mut state) 1 20.0)
           (variable/variable-scroll-measure! (mut state) 2 30.0)
           (assert (and (> (variable/variable-scroll-prefix state 3) 59.9)
                        (< (variable/variable-scroll-prefix state 3) 60.1)))
           (assert-eq (variable/variable-scroll-index-at state 0.0) 0)
           (assert-eq (variable/variable-scroll-index-at state 9.9) 0)
           (assert-eq (variable/variable-scroll-index-at state 10.0) 1)
           (assert-eq (variable/variable-scroll-index-at state 35.0) 2)
           (variable/variable-scroll-to! (mut state) 35.0)
           ;; Replacing an estimate above the viewport preserves the same
           ;; visible content by advancing the pixel offset by the delta.
           (variable/variable-scroll-measure! (mut state) 0 15.0)
           (assert (and (> (load (field state offset)) 39.9)
                        (< (load (field state offset)) 40.1)))
           (let [row (variable/variable-item-rect state 2)]
             (assert (and (> (load (field row y)) -5.1)
                          (< (load (field row y)) -4.9)
                          (> (load (field row h)) 29.9)))
             (assert-eq (variable/variable-visible-first state) 1)
             (assert-eq (variable/variable-visible-last state) 5)
             (variable/variable-scroll-free! (mut state)))))

(deftest variable-list-million-row-range-remains-bounded
         (let [(mut state) (primitive/zeroed variable/VariableScrollState)]
           (store! state (variable/variable-scroll-new 1000000 24.0 2))
           (variable/variable-scroll-configure! (mut state) (rect 0.0 0.0 300.0 240.0))
           (variable/variable-scroll-to! (mut state) 12000000.0)
           (assert (<= (variable/variable-visible-count state) 16))
           (assert-eq (variable/variable-scroll-index-at state 12000000.0) 500000)
           (variable/variable-scroll-measure! (mut state) 499999 48.0)
           (assert (and (> (load (field state offset)) 12000023.0)
                        (< (load (field state offset)) 12000025.0)))
           (variable/variable-scroll-free! (mut state))))

(deftest components-produce-batched-primitives
         (let [(mut scene) (scene-new)]
           (button! (mut scene)
                    (rect 0.0 0.0 100.0 36.0)
                    (ButtonState
                      :hovered false
                      :pressed false
                      :focused false
                      :disabled false)
