(deftest scene-buffer-is-reused-between-frames
         (let [(mut scene) (primitive/zeroed Scene)]
           (store! scene (scene-new))
           (for [i 0 4096]
             (scene-rect! (mut scene)
                          (rect (primitive/cast f32 i) 0.0 1.0 1.0)
                          (rgb 1.0 1.0 1.0)
                          (primitive/cast i32 i)))
           (let [first-cap (al/al-cap [Primitive] (load (field scene items)))]
             (scene-clear! (mut scene))
             (for [i 0 4096]
               (scene-rect! (mut scene)
                            (rect (primitive/cast f32 i) 0.0 1.0 1.0)
                            (rgb 1.0 1.0 1.0)
                            (primitive/cast i32 i)))
             (assert-eq (al/al-cap [Primitive] (load (field scene items))) first-cap))
           (scene-free! (mut scene))))

(deftest text-sprites-are-transient-and-reuse-storage
         (let [(mut scene) (primitive/zeroed Scene)]
           (store! scene (scene-new))
           (scene-texture! (mut scene)
                           (rect 10.0 20.0 140.0 24.0)
                           (rgb 1.0 1.0 1.0)
                           (primitive/cast (ptr i8) 123)
                           40)
           (assert-eq (al/al-len [TextSprite] (load (field scene text))) 1)
           (let [capacity (al/al-cap [TextSprite] (load (field scene text)))]
             (scene-clear! (mut scene))
             (assert-eq (al/al-len [TextSprite] (load (field scene text))) 0)
             (assert-eq (al/al-cap [TextSprite] (load (field scene text))) capacity))
           (scene-free! (mut scene))))

(deftest independent-window-hosts-isolate-scenes-renderers-and-lifetimes
         (let [app (msg (ptr i8) (class c"NSApplication") (sel c"sharedApplication") [])
               (mut first-options) (window/window-options c"First GPU window" 320.0 240.0)
               (mut second-options) (window/window-options c"Second GPU window" 480.0 300.0)
               (mut first) (primitive/zeroed window/WindowHost)
               (mut second) (primitive/zeroed window/WindowHost)]
           (do
             (set! (.x second-options) 540.0)
             (set! (.y second-options) 220.0)
             (store! first (window/window-host-new first-options))
             (store! second (window/window-host-new second-options))
             (assert (window/window-host-valid? first))
             (assert (window/window-host-valid? second))
             (assert (!= (primitive/cast i64 (load (field first window)))
                         (primitive/cast i64 (load (field second window)))))
             (let [first-renderer (load (field first renderer))
                   second-renderer (load (field second renderer))]
               (assert (!= (primitive/cast i64 (load (field first-renderer layer)))
                           (primitive/cast i64 (load (field second-renderer layer))))))
             (scene-rect! (mut (field first scene)) (rect 0.0 0.0 40.0 40.0) (rgb 1.0 0.0 0.0) 1)
             (scene-rect! (mut (field second scene)) (rect 0.0 0.0 40.0 40.0) (rgb 0.0 1.0 0.0) 2)
             (scene-rect! (mut (field second scene)) (rect 50.0 0.0 40.0 40.0) (rgb 0.0 0.0 1.0) 3)
             (let [first-scene (load (field first scene))
                   second-scene (load (field second scene))]
               (do
                 (assert-eq (al/al-len [Primitive] (load (field first-scene items))) 1)
                 (assert-eq (al/al-len [Primitive] (load (field second-scene items))) 2)))
             (msg i64
                  (load (field first view))
                  (sel c"setFrame:")
                  [WindowTestRect]
                  (WindowTestRect
                    :x 0.0
                    :y 0.0
                    :w 360.0
                    :h 260.0))
             (window/window-host-sync! (mut first))
             (assert (and (> (load (field first width)) 359.9)
                          (< (load (field first width)) 360.1)))
             (assert (and (> (load (field second width)) 479.9)
                          (< (load (field second width)) 480.1)))
             (window/window-host-free! (mut first))
             (assert (load (field first closed)))
             (assert (window/window-host-valid? second))
             (let [second-scene (load (field second scene))]
               (assert-eq (al/al-len [Primitive] (load (field second-scene items))) 2))
             (window/window-host-free! (mut second)))))

(deftest offscreen-metal-readback-renders-and-preserves-undamaged-pixels
         (let [app (msg (ptr i8) (class c"NSApplication") (sel c"sharedApplication") [])
               options (window/window-options c"Offscreen pixel test" 64.0 48.0)
               (mut host) (window/window-host-new options)]
           (do
             (scene-rect! (mut (field host scene))
                          (rect 4.0 4.0 20.0 20.0)
                          (rgb 1.0 0.0 0.0)
                          1)
             (scene-rect! (mut (field host scene))
                          (rect 32.0 4.0 20.0 20.0)
                          (rgb 0.0 0.0 1.0)
                          2)
             (let [full (DamageRegion :bounds (rect 0.0 0.0 64.0 48.0) :valid true)
                   (mut first)
                     (metal/renderer-render-offscreen! (mut (field host renderer))
                                                       (load (field host scene))
                                                       full)
                   scale (primitive/cast i64 (load (field host scale)))
                   left-x (* 12 scale)
                   right-x (* 40 scale)
                   sample-y (* 12 scale)]
               (do
                 (assert (metal/pixel-buffer-valid? first))
                 ; BGRA8: opaque red and blue centers prove the production
                 ; paint pipeline reached a CPU-readable Metal buffer.
                 (assert (> (primitive/cast i64 (metal/pixel-buffer-byte first left-x sample-y 2)) 245))
                 (assert (< (primitive/cast i64 (metal/pixel-buffer-byte first left-x sample-y 0)) 10))
                 (assert (> (primitive/cast i64 (metal/pixel-buffer-byte first right-x sample-y 0)) 245))
                 (assert (< (primitive/cast i64 (metal/pixel-buffer-byte first right-x sample-y 2)) 10))
                 (scene-clear! (mut (field host scene)))
                 (scene-rect! (mut (field host scene))
                              (rect 4.0 4.0 20.0 20.0)
                              (rgb 0.0 1.0 0.0)
                              1)
                 (scene-rect! (mut (field host scene))
                              (rect 32.0 4.0 20.0 20.0)
                              (rgb 0.0 0.0 1.0)
                              2)
                 (let [left-only (DamageRegion :bounds (rect 4.0 4.0 20.0 20.0) :valid true)
                       (mut second)
                         (metal/renderer-render-offscreen! (mut (field host renderer))
                                                           (load (field host scene))
                                                           left-only)]
                   (do
                     (assert (metal/pixel-buffer-valid? second))
                     (assert (> (primitive/cast i64 (metal/pixel-buffer-byte second left-x sample-y 1)) 245))
                     (assert (< (primitive/cast i64 (metal/pixel-buffer-byte second left-x sample-y 2)) 10))
                     ; The private backing texture retains pixels beyond the
                     ; damage scissor instead of clearing the whole frame.
                     (assert-eq (metal/pixel-buffer-byte second right-x sample-y 0)
                                (metal/pixel-buffer-byte first right-x sample-y 0))
                     (assert-eq (metal/pixel-buffer-byte second right-x sample-y 2)
                                (metal/pixel-buffer-byte first right-x sample-y 2))
                     (metal/pixel-buffer-free! (mut second))))
                 (metal/pixel-buffer-free! (mut first))))
             (window/window-host-free! (mut host)))))

(deftest offscreen-metal-pixels-cover-rounding-clipping-and-alpha-blending
         (let [app (msg (ptr i8) (class c"NSApplication") (sel c"sharedApplication") [])
               options (window/window-options c"Offscreen effects test" 64.0 52.0)
               (mut host) (window/window-host-new options)]
           (do
             (scene-rounded-rect! (mut (field host scene))
                                  (rect 4.0 4.0 20.0 20.0)
                                  (rgb 0.0 1.0 0.0)
                                  8.0
                                  0.0
                                  (rgba 0.0 0.0 0.0 0.0)
                                  1)
             (let [prior (scene-push-clip! (mut (field host scene)) (rect 32.0 4.0 10.0 20.0))]
               (do
                 (scene-rect! (mut (field host scene))
                              (rect 28.0 4.0 20.0 20.0)
                              (rgb 1.0 0.0 0.0)
                              2)
                 (scene-pop-clip! (mut (field host scene)) prior)))
             (scene-rect! (mut (field host scene))
                          (rect 4.0 30.0 20.0 18.0)
                          (rgb 0.0 0.0 1.0)
                          3)
             (scene-rect! (mut (field host scene))
                          (rect 4.0 30.0 20.0 18.0)
                          (rgba 1.0 0.0 0.0 0.5)
                          4)
             (let [full (DamageRegion :bounds (rect 0.0 0.0 64.0 52.0) :valid true)
                   (mut pixels)
                     (metal/renderer-render-offscreen! (mut (field host renderer))
                                                       (load (field host scene))
                                                       full)
                   scale (primitive/cast i64 (load (field host scale)))
                   corner (* 5 scale)
                   rounded-center (* 14 scale)
                   clipped-inside (* 36 scale)
                   clipped-outside (* 46 scale)
                   upper-y (* 14 scale)
                   blend-x (* 14 scale)
                   blend-y (* 38 scale)]
               (do
                 (assert (metal/pixel-buffer-valid? pixels))
                 ; The analytic corner lies outside the rounded SDF, while its center is green.
                 (assert (< (primitive/cast i64 (metal/pixel-buffer-byte pixels corner corner 1)) 40))
                 (assert (> (primitive/cast i64
                                            (metal/pixel-buffer-byte pixels rounded-center upper-y 1))
                            245))
                 ; A larger red primitive is visible only inside the nested clip.
                 (assert (> (primitive/cast i64
                                            (metal/pixel-buffer-byte pixels clipped-inside upper-y 2))
                            245))
                 (assert (< (primitive/cast i64
                                            (metal/pixel-buffer-byte pixels clipped-outside upper-y 2))
                            40))
                 ; Half-alpha red over blue leaves substantial red and blue channels.
                 (let [blue
                         (primitive/cast i64
                                         (metal/pixel-buffer-byte pixels blend-x blend-y 0))
                       red
                         (primitive/cast i64
                                         (metal/pixel-buffer-byte pixels blend-x blend-y 2))]
                   (do
                     (assert (and (> blue 110) (< blue 145)))
                     (assert (and (> red 110) (< red 145)))))
                 (metal/pixel-buffer-free! (mut pixels))))
             (window/window-host-free! (mut host)))))

(deftest deterministic-event-replay-drives-components-and-offscreen-frames
         (let [app (msg (ptr i8) (class c"NSApplication") (sel c"sharedApplication") [])
               options (window/window-options c"Event replay test" 96.0 48.0)
               (mut host) (window/window-host-new options)
               (mut script) (event-test/event-script-new)
               (mut replay) (primitive/zeroed event-test/ReplayContext)
               (mut checked) false
               (mut button-activations) 0]
           (do
             ; Mouse-focus and activate the checkbox, then move focus in paint
             ; order and activate the button from the keyboard.
             (event-test/event-script-click! (mut script) 72.0 22.0 5000000)
             (event-test/event-script-key! (mut script) 48 false 2000000)
             (event-test/event-script-key! (mut script) 49 false 1000000)
             (store! replay (event-test/replay-context-new script))
             (build-replay-component-scene! (mut (field host scene))
                                            (load (field replay router))
                                            (load checked))
             (let [full (DamageRegion :bounds (rect 0.0 0.0 96.0 48.0) :valid true)
                   (mut before)
                     (metal/renderer-render-offscreen! (mut (field host renderer))
                                                       (load (field host scene))
                                                       full)
                   scale (primitive/cast i64 (load (field host scale)))
                   checkbox-x (* 72 scale)
                   checkbox-y (* 22 scale)
                   before-red
                     (primitive/cast i64
                                     (metal/pixel-buffer-byte before checkbox-x checkbox-y 2))
                   (mut last-time) (primitive/cast u64 0)]
               (do
                 (assert (metal/pixel-buffer-valid? before))
                 (while (event-test/replay-has-next? (load replay))
                   (let [frame
                           (event-test/replay-step! (mut replay)
                                                    (load (field host scene)))]
                     (do
                       (assert (load (field frame valid)))
                       (assert (>= (load (field frame time-ns)) (load last-time)))
                       (store! last-time (load (field frame time-ns)))
                       (if (and (= (load (field frame action))
                                   (primitive/cast i32 input/action-activate))
                                (= (load (field frame action-target)) 11))
                           (store! checked (not (load checked)))
                           0)
                       (if (and (= (load (field frame action))
                                   (primitive/cast i32 input/action-activate))
                                (= (load (field frame action-target)) 10))
                           (store! button-activations (+ (load button-activations) 1))
                           0)
                       ; Rebuild after every event exactly as a production frame
                       ; does; subsequent events hit-test the newly painted state.
                       (scene-clear! (mut (field host scene)))
                       (build-replay-component-scene! (mut (field host scene))
                                                      (load (field replay router))
                                                      (load checked)))))
                 (let [(mut after)
                         (metal/renderer-render-offscreen! (mut (field host renderer))
                                                           (load (field host scene))
                                                           full)]
                   (do
                     (assert (load checked))
                     (assert-eq (load button-activations) 1)
                     (assert-eq (load (field (field replay router) focused)) 10)
                     (assert (load (field (field replay router) keyboard)))
                     (assert-eq (load last-time) (primitive/cast u64 8000000))
                     ; The replayed checkbox action changes a real GPU frame from
                     ; its dark track to the checked white inset.
                     (assert (> (primitive/cast i64
                                                (metal/pixel-buffer-byte after checkbox-x checkbox-y 2))
                                (+ before-red 120)))
                     (metal/pixel-buffer-free! (mut after))))
                 (metal/pixel-buffer-free! (mut before))))
             (event-test/replay-context-free! (mut replay))
             (event-test/event-script-free! (mut script))
             (window/window-host-free! (mut host)))))
