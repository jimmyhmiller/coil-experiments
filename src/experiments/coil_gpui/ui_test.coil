           (checkbox! (mut scene)
                      (rect 0.0 50.0 24.0 24.0)
                      (CheckboxState
                        :checked true
                        :hovered false
                        :focused false
                        :disabled false)
                      11)
           (slider! (mut scene)
                    (rect 0.0 90.0 180.0 28.0)
                    (SliderState
                      :value 0.5
                      :minimum 0.0
