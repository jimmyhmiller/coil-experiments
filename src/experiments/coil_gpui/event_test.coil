(module experiments.coil_gpui.event-test)
(import "experiments.coil_gpui.ui" :as ui)
(import "experiments.coil_gpui.input" :as input)
(import "coil.arraylist" :as al)
(import "coil.alloc" :as alloc)
(import "coil.primitive" :as primitive)

(export EventScript
        ReplayContext
        ReplayFrame
        event-script-new
        event-script-move!
        event-script-down!
        event-script-up!
        event-script-click!
        event-script-key!
        event-script-free!
        replay-context-new
        replay-has-next?
        replay-step!
        replay-reset!
        replay-context-free!
        EventMove
        EventDown
        EventUp
        EventKey)

(const EventMove i32 0)
(const EventDown i32 1)
(const EventUp i32 2)
(const EventKey i32 3)

;;; Timestamps are logical nanoseconds. Replays never consult the wall clock,
;;; making delayed gestures and animation sampling repeatable under any load.
(defstruct ScriptEvent
  [(kind i32) (x f32) (y f32) (key i64) (shift bool) (time-ns u64)])

(defstruct EventScript
  [(events (al/ArrayList ScriptEvent)) (duration-ns u64)])

(defstruct ReplayContext
  [(script EventScript) (router input/Router) (cursor i64) (now-ns u64)])

(defstruct ReplayFrame
  [(event-index i64) (time-ns u64) (kind i32)
   (pointer-target i32) (action i32) (action-target i32)
   (hovered i32) (pressed i32) (focused i32) (keyboard bool)
   (valid bool)])

(defn event-script-new [] (-> EventScript)
  (EventScript :events (al/al-new [ScriptEvent] (alloc/malloc-allocator))
               :duration-ns 0))

(defn event-script-push! [(script (mut EventScript))
                          (kind i32)
                          (x f32)
                          (y f32)
                          (key i64)
                          (shift bool)
                          (delay-ns u64)] (-> i64)
  (let [time (+ (load (field script duration-ns)) delay-ns)]
    (do
      (set! (.duration-ns script) time)
      (al/al-push! [ScriptEvent]
                   (mut (.events script))
                   (ScriptEvent :kind kind :x x :y y :key key
                                :shift shift :time-ns time)))))

(defn event-script-move! [(script (mut EventScript))
                          (x f32) (y f32) (delay-ns u64)] (-> i64)
  (event-script-push! (mut script) (primitive/cast i32 EventMove) x y 0 false delay-ns))

(defn event-script-down! [(script (mut EventScript))
                          (x f32) (y f32) (delay-ns u64)] (-> i64)
  (event-script-push! (mut script) (primitive/cast i32 EventDown) x y 0 false delay-ns))

(defn event-script-up! [(script (mut EventScript))
                        (x f32) (y f32) (delay-ns u64)] (-> i64)
  (event-script-push! (mut script) (primitive/cast i32 EventUp) x y 0 false delay-ns))

(defn event-script-click! [(script (mut EventScript))
                           (x f32) (y f32) (hold-ns u64)] (-> i64)
  (do
    (event-script-move! (mut script) x y 0)
    (event-script-down! (mut script) x y 0)
    (event-script-up! (mut script) x y hold-ns)))

(defn event-script-key! [(script (mut EventScript))
                         (key i64) (shift bool) (delay-ns u64)] (-> i64)
  (event-script-push! (mut script) (primitive/cast i32 EventKey) 0.0 0.0 key shift delay-ns))

(defn event-script-free! [(script (mut EventScript))] (-> i64)
  (al/al-free! [ScriptEvent] (mut (.events script))))

(defn replay-context-new [(script EventScript)] (-> ReplayContext)
  (ReplayContext :script script :router (input/router-new) :cursor 0 :now-ns 0))

(defn replay-has-next? [(replay ReplayContext)] (-> bool)
  (< (load (field replay cursor))
     (al/al-len [ScriptEvent] (load (field (field replay script) events)))))

(defn replay-step! [(replay (mut ReplayContext)) (scene ui/Scene)] (-> ReplayFrame)
  (if (not (replay-has-next? (load replay)))
      (primitive/zeroed ReplayFrame)
      (let [index (load (field replay cursor))
            event (al/al-get [ScriptEvent]
                             (load (field (field replay script) events)) index)
            kind (load (field event kind))
            (mut pointer-target) (primitive/cast i32 -1)
            (mut action) (primitive/zeroed input/ActionEvent)]
        (do
          (store! action (input/ActionEvent :action input/action-none :target -1))
          (set! (.now-ns replay) (load (field event time-ns)))
          (cond (= kind (primitive/cast i32 EventMove))
                  (store! pointer-target
                          (input/router-pointer-move! (mut (field replay router)) scene
                                                      (load (field event x))
                                                      (load (field event y))))
                (= kind (primitive/cast i32 EventDown))
                  (store! pointer-target
                          (input/router-pointer-down! (mut (field replay router)) scene
                                                      (load (field event x))
                                                      (load (field event y))))
                (= kind (primitive/cast i32 EventUp))
                  (do
                    (store! action
                            (input/router-pointer-up! (mut (field replay router)) scene
                                                      (load (field event x))
                                                      (load (field event y))))
                    (store! pointer-target (load (field action target))))
                (= kind (primitive/cast i32 EventKey))
                  (store! action
                          (input/router-key! (mut (field replay router)) scene
                                             (load (field event key))
                                             (load (field event shift))))
                :else 0)
          (set! (.cursor replay) (+ index 1))
          (ReplayFrame
            :event-index index
            :time-ns (load (field replay now-ns))
            :kind kind
            :pointer-target (load pointer-target)
            :action (load (field action action))
            :action-target (load (field action target))
            :hovered (load (field (field replay router) hovered))
            :pressed (load (field (field replay router) pressed))
            :focused (load (field (field replay router) focused))
            :keyboard (load (field (field replay router) keyboard))
            :valid true)))))

(defn replay-reset! [(replay (mut ReplayContext))] (-> i64)
  (do
    (set! (.router replay) (input/router-new))
    (set! (.cursor replay) 0)
    (set! (.now-ns replay) 0)
    0))

;;; The script remains caller-owned and can be replayed repeatedly or shared
;;; by sequential contexts; freeing a context therefore never frees the script.
(defn replay-context-free! [(replay (mut ReplayContext))] (-> i64)
  (do
    (set! (.cursor replay) 0)
    (set! (.now-ns replay) 0)
    0))
