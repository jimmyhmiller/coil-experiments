(module experiments.coil_gpui.tree)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "coil.primitive" :as primitive)
(import "experiments.coil_gpui.ui" :as ui)
(import "experiments.coil_gpui.scroll" :as scroll)

(export TreeNode
        TreeState
        TreeAction
        TreeNone
        TreeSelect
        TreeToggle
        TreeUp
        TreeDown
        TreeLeft
        TreeRight
        TreeHome
        TreeEnd
        tree-new
        tree-add-node!
        tree-configure!
        tree-rebuild!
        tree-free!
        tree-node-count
        tree-visible-count
        tree-visible-first
        tree-visible-last
        tree-visible-node
        tree-selected
        tree-node-expanded?
        tree-toggle!
        tree-scroll-by!
        tree-row-rect
        tree-content-rect
        tree-pointer-down!
        tree-key!
        tree-paint!)

(defn TreeNone [] (-> i32) (primitive/cast i32 0))
(defn TreeSelect [] (-> i32) (primitive/cast i32 1))
(defn TreeToggle [] (-> i32) (primitive/cast i32 2))
(defn TreeUp [] (-> i32) (primitive/cast i32 0))
(defn TreeDown [] (-> i32) (primitive/cast i32 1))
(defn TreeLeft [] (-> i32) (primitive/cast i32 2))
(defn TreeRight [] (-> i32) (primitive/cast i32 3))
(defn TreeHome [] (-> i32) (primitive/cast i32 4))
(defn TreeEnd [] (-> i32) (primitive/cast i32 5))

(defstruct TreeNode
  [(parent i64)
   (depth i64)
   (expanded bool)
   (has-children bool)
   (visible bool)])

(defstruct TreeAction [(kind i32) (node i64)])

(defstruct TreeState
  [(nodes (al/ArrayList TreeNode))
   (visible (al/ArrayList i64))
   (scroll scroll/ScrollState)
   (bounds ui/Rect)
   (row-height f32)
   (indent f32)
   (selected i64)
   (dirty bool)])

(defn no-tree-action [] (-> TreeAction)
  (TreeAction :kind (TreeNone) :node -1))

(defn tree-new [(row-height f32) (indent f32)] (-> TreeState)
  (let [height (if (> row-height 0.0) row-height 1.0)]
    (TreeState
      :nodes (al/al-new [TreeNode] (alloc/malloc-allocator))
      :visible (al/al-new [i64] (alloc/malloc-allocator))
      :scroll (scroll/scroll-new 0 height 2)
      :bounds (ui/rect 0.0 0.0 0.0 0.0)
      :row-height height
      :indent (if (> indent 0.0) indent 1.0)
      :selected -1
      :dirty false)))

(defn tree-node-count [(tree TreeState)] (-> i64)
  (al/al-len [TreeNode] (load (field tree nodes))))

(defn tree-visible-count [(tree TreeState)] (-> i64)
  (al/al-len [i64] (load (field tree visible))))

(defn tree-visible-first [(tree TreeState)] (-> i64)
  (scroll/visible-first (load (field tree scroll))))

(defn tree-visible-last [(tree TreeState)] (-> i64)
  (scroll/visible-last (load (field tree scroll))))

(defn tree-visible-node [(tree TreeState) (visible-index i64)] (-> i64)
  (if (or (< visible-index 0) (>= visible-index (tree-visible-count tree)))
      -1
      (al/al-get [i64] (load (field tree visible)) visible-index)))

(defn tree-selected [(tree TreeState)] (-> i64)
  (load (field tree selected)))

(defn tree-node-expanded? [(tree TreeState) (node i64)] (-> bool)
  (if (or (< node 0) (>= node (tree-node-count tree)))
      false
      (let [item (al/al-get [TreeNode] (load (field tree nodes)) node)]
        (load (field item expanded)))))

(defn tree-add-node! [(tree (mut TreeState)) (parent i64) (expanded bool)] (-> i64)
  (let [count (tree-node-count (load tree))]
    (if (or (< parent -1) (>= parent count))
        -1
        (let [depth
                (if (< parent 0)
                    0
                    (let [parent-node
                            (al/al-get [TreeNode] (load (field tree nodes)) parent)]
                      (+ (load (field parent-node depth)) 1)))]
          (do
            (when (>= parent 0)
              (let [(mut parent-node)
                      (al/al-get [TreeNode] (load (field tree nodes)) parent)]
                (do
                  (set! (.has-children parent-node) true)
                  (al/al-set! [TreeNode] (mut (.nodes tree)) parent parent-node))))
            (al/al-push! [TreeNode]
                         (mut (.nodes tree))
                         (TreeNode :parent parent :depth depth :expanded expanded
                                   :has-children false :visible false))
            (set! (.dirty tree) true)
            count)))))

;;; Parent-before-child insertion lets visibility propagate in one linear pass.
;;; No recursion or per-frame hierarchy allocation is required.
(defn tree-rebuild! [(tree (mut TreeState))] (-> i64)
  (let [count (tree-node-count (load tree))]
    (do
      (al/al-clear! [i64] (mut (.visible tree)))
      (for [index 0 count]
        (let [(mut node) (al/al-get [TreeNode] (load (field tree nodes)) index)
              parent (load (field node parent))
              visible
                (if (< parent 0)
                    true
                    (let [parent-node
                            (al/al-get [TreeNode] (load (field tree nodes)) parent)]
                      (and (load (field parent-node visible))
                           (load (field parent-node expanded)))))]
          (do
            (set! (.visible node) visible)
            (al/al-set! [TreeNode] (mut (.nodes tree)) index node)
            (when visible (al/al-push! [i64] (mut (.visible tree)) index)))))
      (scroll/scroll-configure! (mut (.scroll tree))
                                (load (field tree bounds))
                                (tree-visible-count (load tree))
                                (load (field tree row-height)))
      (set! (.dirty tree) false)
      (tree-visible-count (load tree)))))

(defn tree-configure! [(tree (mut TreeState)) (bounds ui/Rect)] (-> i64)
  (do
    (set! (.bounds tree) bounds)
    (if (load (field tree dirty))
        (tree-rebuild! (mut tree))
        (scroll/scroll-configure! (mut (.scroll tree)) bounds
                                  (tree-visible-count (load tree))
                                  (load (field tree row-height))))
    0))

(defn tree-free! [(tree (mut TreeState))] (-> i64)
  (do
    (al/al-free! [i64] (mut (.visible tree)))
    (al/al-free! [TreeNode] (mut (.nodes tree)))
    (set! (.selected tree) -1)
    0))

(defn tree-visible-index-of [(tree TreeState) (node i64)] (-> i64)
  (block :found
    (for [index 0 (tree-visible-count tree)]
      (when (= (tree-visible-node tree index) node)
        (return-from :found index)))
    -1))

(defn tree-descendant-of? [(tree TreeState) (node i64) (ancestor i64)] (-> bool)
  (let [(mut current) node]
    (block :found
      (while (>= (load current) 0)
        (if (= (load current) ancestor)
            (return-from :found true)
            (let [item (al/al-get [TreeNode] (load (field tree nodes)) (load current))]
              (store! current (load (field item parent))))))
      false)))

(defn tree-ensure-selected-visible! [(tree (mut TreeState))] (-> f32)
  (let [visible-index (tree-visible-index-of (load tree) (load (field tree selected)))]
    (if (< visible-index 0)
        (load (field (field tree scroll) offset))
        (let [top (* (primitive/cast f32 visible-index) (load (field tree row-height)))
              bottom (+ top (load (field tree row-height)))
              offset (load (field (field tree scroll) offset))
              height (load (field (field tree bounds) h))]
          (cond (< top offset) (scroll/scroll-to! (mut (.scroll tree)) top)
                (> bottom (+ offset height))
                  (scroll/scroll-to! (mut (.scroll tree)) (- bottom height))
                :else offset)))))

(defn tree-toggle! [(tree (mut TreeState)) (node-index i64)] (-> bool)
  (if (or (< node-index 0) (>= node-index (tree-node-count (load tree))))
      false
      (let [(mut node) (al/al-get [TreeNode] (load (field tree nodes)) node-index)]
        (if (not (load (field node has-children)))
            false
            (let [next (not (load (field node expanded)))]
              (do
                (set! (.expanded node) next)
                (al/al-set! [TreeNode] (mut (.nodes tree)) node-index node)
                (when (and (not next)
                           (tree-descendant-of? (load tree)
                                                (load (field tree selected)) node-index))
                  (set! (.selected tree) node-index))
                (tree-rebuild! (mut tree))
                next))))))

(defn tree-scroll-by! [(tree (mut TreeState)) (delta f32)] (-> f32)
  (scroll/scroll-by! (mut (.scroll tree)) delta))

(defn tree-row-rect [(tree TreeState) (visible-index i64)] (-> ui/Rect)
  (scroll/item-rect (load (field tree scroll)) visible-index))

(defn tree-content-rect [(tree TreeState) (visible-index i64)] (-> ui/Rect)
  (let [node-index (tree-visible-node tree visible-index)
        node (al/al-get [TreeNode] (load (field tree nodes)) node-index)
        row (tree-row-rect tree visible-index)
        inset (+ (primitive/cast f32 22.0)
                 (* (primitive/cast f32 (load (field node depth)))
                    (load (field tree indent))))]
    (ui/rect (+ (load (field row x)) inset) (load (field row y))
             (if (> (load (field row w)) inset) (- (load (field row w)) inset) 0.0)
             (load (field row h)))))

(defn tree-select-visible-index! [(tree (mut TreeState)) (visible-index i64)] (-> i64)
  (let [count (tree-visible-count (load tree))
        clamped (cond (= count 0) -1 (< visible-index 0) 0
                      (>= visible-index count) (- count 1) :else visible-index)
        node (if (< clamped 0) -1 (tree-visible-node (load tree) clamped))]
    (do
      (set! (.selected tree) node)
      (tree-ensure-selected-visible! (mut tree))
      node)))

(defn tree-pointer-down! [(tree (mut TreeState)) (x f32) (y f32)] (-> TreeAction)
  (let [bounds (load (field tree bounds))]
    (if (not (ui/contains? bounds x y))
        (no-tree-action)
        (let [content-y (+ (- y (load (field bounds y)))
                           (load (field (field tree scroll) offset)))
              visible-index (primitive/cast i64 (/ content-y (load (field tree row-height))))
              node-index (tree-visible-node (load tree) visible-index)]
          (if (< node-index 0)
              (no-tree-action)
              (let [node (al/al-get [TreeNode] (load (field tree nodes)) node-index)
                    disclosure-x (+ (+ (load (field bounds x)) 8.0)
                                    (* (primitive/cast f32 (load (field node depth)))
                                       (load (field tree indent))))]
                (do
                  (set! (.selected tree) node-index)
                  (if (and (load (field node has-children))
                           (<= x (+ disclosure-x 14.0)))
                      (do
                        (tree-toggle! (mut tree) node-index)
                        (TreeAction :kind (TreeToggle) :node node-index))
                      (TreeAction :kind (TreeSelect) :node node-index)))))))))

(defn tree-key! [(tree (mut TreeState)) (action i32)] (-> TreeAction)
  (let [selected (load (field tree selected))
        visible-index (tree-visible-index-of (load tree) selected)]
    (cond (= action (TreeUp))
            (let [node (tree-select-visible-index! (mut tree) (- visible-index 1))]
              (TreeAction :kind (TreeSelect) :node node))
          (= action (TreeDown))
            (let [node (tree-select-visible-index! (mut tree) (+ visible-index 1))]
              (TreeAction :kind (TreeSelect) :node node))
          (= action (TreeHome))
            (let [node (tree-select-visible-index! (mut tree) 0)]
              (TreeAction :kind (TreeSelect) :node node))
          (= action (TreeEnd))
            (let [node (tree-select-visible-index! (mut tree)
                                                   (- (tree-visible-count (load tree)) 1))]
              (TreeAction :kind (TreeSelect) :node node))
          (= action (TreeLeft))
            (if (< selected 0)
                (no-tree-action)
                (let [node (al/al-get [TreeNode] (load (field tree nodes)) selected)]
                  (if (and (load (field node has-children)) (load (field node expanded)))
                      (do (tree-toggle! (mut tree) selected)
                          (TreeAction :kind (TreeToggle) :node selected))
                      (let [parent (load (field node parent))]
                        (do
                          (when (>= parent 0)
                            (do
                              (set! (.selected tree) parent)
                              (tree-ensure-selected-visible! (mut tree))
                              0))
                          (TreeAction :kind (TreeSelect) :node (load (field tree selected))))))))
          (= action (TreeRight))
            (if (< selected 0)
                (no-tree-action)
                (let [node (al/al-get [TreeNode] (load (field tree nodes)) selected)]
                  (cond (and (load (field node has-children))
                             (not (load (field node expanded))))
                          (do (tree-toggle! (mut tree) selected)
                              (TreeAction :kind (TreeToggle) :node selected))
                        (load (field node has-children))
                          (let [next (+ (tree-visible-index-of (load tree) selected) 1)
                                child (tree-visible-node (load tree) next)]
                            (do
                              (when (>= child 0)
                                (let [child-node (al/al-get [TreeNode]
                                                            (load (field tree nodes)) child)]
                                  (when (= (load (field child-node parent)) selected)
                                    (set! (.selected tree) child))))
                              (tree-ensure-selected-visible! (mut tree))
                              (TreeAction :kind (TreeSelect) :node (load (field tree selected)))))
                        :else (TreeAction :kind (TreeSelect) :node selected))))
          :else (no-tree-action))))

;;; Paint only visible rows plus scroll overscan. Callers paint labels or icons
;;; into `tree-content-rect`; hierarchy state owns disclosure geometry and input.
(defn tree-paint! [(scene (mut ui/Scene)) (tree TreeState) (base-id i32)] (-> i64)
  (let [first (scroll/visible-first (load (field tree scroll)))
        last (scroll/visible-last (load (field tree scroll)))
        bounds (load (field tree bounds))
        prior (ui/scene-push-clip! (mut scene) bounds)]
    (do
      (ui/scene-rounded-rect! (mut scene) bounds (ui/rgba 0.045 0.055 0.085 1.0)
                              7.0 1.0 (ui/rgba 0.30 0.36 0.52 0.80) base-id)
      (for [visible-index first last]
        (let [node-index (tree-visible-node tree visible-index)
              node (al/al-get [TreeNode] (load (field tree nodes)) node-index)
              row (tree-row-rect tree visible-index)
              depth (load (field node depth))
              disclosure-x (+ (+ (load (field row x)) 8.0)
                              (* (primitive/cast f32 depth) (load (field tree indent))))]
          (do
            (when (= node-index (load (field tree selected)))
              (ui/scene-rounded-rect! (mut scene)
                                      (ui/rect (+ (load (field row x)) 2.0)
                                               (+ (load (field row y)) 2.0)
                                               (- (load (field row w)) 4.0)
                                               (- (load (field row h)) 4.0))
                                      (ui/rgba 0.14 0.42 0.75 0.72)
                                      4.0 0.0 (ui/rgba 0.0 0.0 0.0 0.0) (+ base-id 1)))
            (for [guide 0 depth]
              (ui/scene-rect! (mut scene)
                              (ui/rect (+ (+ (load (field row x)) 14.0)
                                          (* (primitive/cast f32 guide)
                                             (load (field tree indent))))
                                       (load (field row y)) 1.0 (load (field row h)))
                              (ui/rgba 0.34 0.40 0.56 0.32) (+ base-id 2)))
            (when (load (field node has-children))
              (ui/scene-rounded-rect! (mut scene)
                                      (ui/rect disclosure-x
                                               (+ (load (field row y))
                                                  (if (load (field node expanded)) 9.0 7.0))
                                               (if (load (field node expanded)) 10.0 7.0)
                                               (if (load (field node expanded)) 4.0 8.0))
                                      (ui/rgba 0.68 0.78 0.98 0.92)
                                      2.0 0.0 (ui/rgba 0.0 0.0 0.0 0.0) (+ base-id 3)))
            (ui/scene-hitbox! (mut scene) (ui/intersect row bounds)
                              (+ base-id (primitive/cast i32 (+ node-index 1000)))
                              -1 true false))))
      (scroll/scrollbar! (mut scene) (load (field tree scroll)) (+ base-id 4))
      (ui/scene-pop-clip! (mut scene) prior)
      (- last first))))
