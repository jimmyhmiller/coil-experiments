(module experiments.coil_gpui.scheduler)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "coil.atomic" :as atomic)
(import "coil.primitive" :as primitive)
(import "coil.sync" :as sync)
(import "coil.thread" :as thread)
(import "coil.time" :as time)

(export Scheduler
        JobHandle
        TaskScope
        scheduler-new
        scheduler-new-with-workers
        scheduler-worker-count
        scheduler-set-wake!
        scheduler-dispatch!
        scheduler-at!
        scheduler-after!
        scheduler-spawn!
        scheduler-spawn-priority!
        scheduler-cancel!
        scheduler-handle-active?
        scheduler-cancel-requested?
        scheduler-poll!
        scheduler-poll-at!
        scheduler-active-count
        scheduler-free!
        task-scope-new
        task-scope-dispatch!
        task-scope-after!
        task-scope-spawn!
        task-scope-spawn-priority!
        task-scope-prune!
        task-scope-cancel!
        task-scope-active-count
        task-scope-closed?
        task-scope-free!
        priority-high
        priority-medium
        priority-low)

(extern malloc :cc c [u64] (-> (ptr i8)))

(extern free :cc c [(ptr i8)] (-> void))

;; Foreground jobs are invoked only by scheduler-poll! on the scheduler's owner
;; thread. Background work receives a stable pointer to its atomic cancellation
;; flag. Completion is likewise delivered only while polling on the owner thread.
(defstruct JobHandle [(slot i64) (generation i64)])

(defstruct TaskScope [(handles (al/ArrayList JobHandle)) (closed bool)])

(const priority-high i64 0)

(const priority-medium i64 1)

(const priority-low i64 2)

(defstruct BackgroundWork
  [(worker (fnptr c [(ptr i8) (ptr i64)] i64))
   (completion (fnptr c [(ptr i8) i64 i64] i64))
   (worker-context (ptr i8))
   (completion-context (ptr i8))
   (wake (fnptr c [(ptr i8)] i64))
   (wake-context (ptr i8))
   (wake-enabled bool)
   (priority i64)
   (result i64)
   (cancel-requested i64)
   (done i64)
   (next (ptr BackgroundWork))])

(defstruct WorkerPool
  [(mutex sync/Mutex)
   (available sync/Condition)
   (high-head (ptr BackgroundWork))
   (high-tail (ptr BackgroundWork))
   (medium-head (ptr BackgroundWork))
   (medium-tail (ptr BackgroundWork))
   (low-head (ptr BackgroundWork))
   (low-tail (ptr BackgroundWork))
   (service-ticket i64)
   (shutdown bool)
   (initialized bool)])

(defstruct ScheduledJob
  [(generation i64)
   (kind i64)
   (deadline-ms i64)
   (callback (fnptr c [(ptr i8)] i64))
   (context (ptr i8))
   (background (ptr BackgroundWork))])

(defstruct Scheduler
  [(jobs (al/ArrayList ScheduledJob))
   (active i64)
   (wake (fnptr c [(ptr i8)] i64))
   (wake-context (ptr i8))
   (wake-enabled bool)
   (pool (ptr WorkerPool))
   (workers (al/ArrayList thread/Thread))])

(defn null-work [] (-> (ptr BackgroundWork))
  (primitive/cast (ptr BackgroundWork) 0))

(defn null-context [] (-> (ptr i8))
  (primitive/cast (ptr i8) 0))

(defn null-pool [] (-> (ptr WorkerPool))
  (primitive/cast (ptr WorkerPool) 0))

(defn empty-job [(generation i64)] (-> ScheduledJob)
  (let [(mut job) (primitive/zeroed ScheduledJob)]
    (do
      (store! (field job generation) generation)
      (load job))))

(defn pool-lane-head [(pool (ptr WorkerPool)) (priority i64)] (-> (ptr BackgroundWork))
  (cond (= priority priority-high) (load (field pool high-head))
        (= priority priority-low) (load (field pool low-head))
        :else (load (field pool medium-head))))

(defn pool-pop-lane! [(pool (ptr WorkerPool)) (priority i64)] (-> (ptr BackgroundWork))
  (let [head (pool-lane-head pool priority)]
    (if (= (primitive/cast i64 head) 0)
        head
        (let [next (load (field head next))]
          (do
            (cond (= priority priority-high)
                    (do
                      (store! (field pool high-head) next)
                      (when (= (primitive/cast i64 next) 0)
                        (store! (field pool high-tail) (null-work))))
                  (= priority priority-low)
                    (do
                      (store! (field pool low-head) next)
                      (when (= (primitive/cast i64 next) 0)
                        (store! (field pool low-tail) (null-work))))
                  :else
                    (do
                      (store! (field pool medium-head) next)
                      (when (= (primitive/cast i64 next) 0)
                        (store! (field pool medium-tail) (null-work)))))
            (store! (field head next) (null-work))
            head)))))

(defn pool-empty? [(pool (ptr WorkerPool))] (-> bool)
  (and (= (primitive/cast i64 (load (field pool high-head))) 0)
       (and (= (primitive/cast i64 (load (field pool medium-head))) 0)
            (= (primitive/cast i64 (load (field pool low-head))) 0))))

(defn pool-pop-weighted! [(pool (ptr WorkerPool))] (-> (ptr BackgroundWork))
  ;; Thirteen deterministic service slots: 8 high, 4 medium, 1 low. Empty
  ;; desired lanes fall back immediately, while a continuously nonempty low
  ;; lane is guaranteed service once per cycle.
  (let [ticket (load (field pool service-ticket))
        desired
          (cond (< ticket 8) priority-high
                (< ticket 12) priority-medium
                :else priority-low)
        (mut work) (pool-pop-lane! pool desired)]
    (do
      (store! (field pool service-ticket) (% (+ ticket 1) 13))
      (when (= (primitive/cast i64 (load work)) 0)
        (store! work (pool-pop-lane! pool priority-high)))
      (when (= (primitive/cast i64 (load work)) 0)
        (store! work (pool-pop-lane! pool priority-medium)))
      (when (= (primitive/cast i64 (load work)) 0)
        (store! work (pool-pop-lane! pool priority-low)))
      (load work))))

(defn pool-take! [(pool (ptr WorkerPool))] (-> (ptr BackgroundWork))
  (match (sync/mutex-lock! (field pool mutex))
    (Err [_] (null-work))
    (Ok [_]
        (block :taken
                 (loop (let [head (pool-pop-weighted! pool)]
                         (cond (!= (primitive/cast i64 head) 0)
                                 (do
                                   (sync/mutex-unlock! (field pool mutex))
                                   (return-from :taken head))
                               (load (field pool shutdown))
                                 (do
                                   (sync/mutex-unlock! (field pool mutex))
                                   (return-from :taken (null-work)))
                               :else
                                 (match (sync/condition-wait! (field pool available) (field pool mutex))
                                   (Err [_]
                                        (do
                                          (sync/mutex-unlock! (field pool mutex))
                                          (return-from :taken (null-work))))
                                   (Ok [_] 0)))))))))

(defn pool-worker-entry [(raw (ptr i8))] (-> (ptr i8))
  (let [pool (primitive/cast (ptr WorkerPool) raw)]
    (block :stopped
             (loop (let [work (pool-take! pool)]
                     (if (= (primitive/cast i64 work) 0)
                         (return-from :stopped (null-context))
                         (let [result
                                 (primitive/call-ptr (load (field work worker))
                                                     (load (field work worker-context))
                                                     (field work cancel-requested))]
                           (do
                             (atomic/atomic-store (field work result) result)
                             (when (load (field work wake-enabled))
                               (primitive/call-ptr (load (field work wake))
                                                   (load (field work wake-context))))
                             ;; Publish last: after this store the owner may reclaim work.
                             (atomic/atomic-store (field work done) 1)))))))))

(defn pool-enqueue! [(pool (ptr WorkerPool)) (work (ptr BackgroundWork))] (-> bool)
  (match (sync/mutex-lock! (field pool mutex))
    (Err [_] false)
    (Ok [_]
        (if (load (field pool shutdown))
            (do (sync/mutex-unlock! (field pool mutex)) false)
            (do
              (let [priority (load (field work priority))]
                (cond (= priority priority-high)
                        (do
                          (if (= (primitive/cast i64 (load (field pool high-tail))) 0)
                              (store! (field pool high-head) work)
                              (store! (field (load (field pool high-tail)) next) work))
                          (store! (field pool high-tail) work))
                      (= priority priority-low)
                        (do
                          (if (= (primitive/cast i64 (load (field pool low-tail))) 0)
                              (store! (field pool low-head) work)
                              (store! (field (load (field pool low-tail)) next) work))
                          (store! (field pool low-tail) work))
                      :else
                        (do
                          (if (= (primitive/cast i64 (load (field pool medium-tail))) 0)
                              (store! (field pool medium-head) work)
                              (store! (field (load (field pool medium-tail)) next) work))
                          (store! (field pool medium-tail) work))))
              (sync/condition-notify-one! (field pool available))
              (sync/mutex-unlock! (field pool mutex))
              true)))))

(defn scheduler-new-with-workers [(worker-count i64)] (-> Scheduler)
  (let [(mut scheduler) (primitive/zeroed Scheduler)]
    (do
      (store! (field scheduler jobs) (al/al-new [ScheduledJob] (alloc/malloc-allocator)))
      (store! (field scheduler workers) (al/al-new [thread/Thread] (alloc/malloc-allocator)))
      (let [memory (malloc (primitive/cast u64 (primitive/sizeof WorkerPool)))]
        (when (!= (primitive/cast i64 memory) 0)
          (let [pool (primitive/cast (ptr WorkerPool) memory)]
            (do
              (store! pool (primitive/zeroed WorkerPool))
              (match (sync/mutex-init (field pool mutex))
                (Err [_] (do (free memory) 0))
                (Ok [_]
                    (match (sync/condition-init (field pool available))
                      (Err [_]
                           (do
                             (sync/mutex-destroy! (field pool mutex))
                             (free memory)
                             0))
                      (Ok [_]
                          (do
                            (store! (field pool initialized) true)
                            (store! (field scheduler pool) pool)
                            (for [i 0 (if (< worker-count 1) 1 worker-count)]
                              (let [handle (primitive/alloc-stack thread/Thread)
                                    status
                                      (thread/thread-spawn handle
                                                           (primitive/fnptr-of pool-worker-entry)
                                                           memory)]
                                (when (= status 0)
                                  (al/al-push! [thread/Thread]
                                               (mut (field scheduler workers))
                                               (load handle)))))
                            0))))))))
        (load scheduler)))))

(defn scheduler-new [] (-> Scheduler)
  (scheduler-new-with-workers 4))

(defn scheduler-worker-count [(scheduler Scheduler)] (-> i64)
  (al/al-len [thread/Thread] (load (field scheduler workers))))

;; The wake callback must be thread-safe: background workers call it only after
;; atomically publishing completion. A dispatch semaphore signal is an ideal UI
;; implementation because it does not touch owner-thread application state.
(defn scheduler-set-wake! [(scheduler (mut Scheduler))
                           (wake (fnptr c [(ptr i8)] i64))
                           (context (ptr i8))] (-> i64)
  (do
    (store! (field scheduler wake) wake)
    (store! (field scheduler wake-context) context)
    (store! (field scheduler wake-enabled) true)
    0))

(defn scheduler-slot! [(scheduler (mut Scheduler))] (-> JobHandle)
  (block :found
           (do
             (for [i 0 (al/al-len [ScheduledJob] (load (field scheduler jobs)))]
               (let [job (al/al-elem [ScheduledJob] (field scheduler jobs) i)]
                 (when (= (load (field job kind)) 0)
                   (let [generation (+ (load (field job generation)) 1)]
                     (do
                       (store! job (empty-job generation))
                       (return-from
                         :found (JobHandle :slot i :generation generation)))))))
             (let [slot (al/al-len [ScheduledJob] (load (field scheduler jobs)))]
               (do
                 (al/al-push! [ScheduledJob] (mut (field scheduler jobs)) (empty-job 1))
                 (JobHandle :slot slot :generation 1))))))

(defn scheduler-job [(scheduler (mut Scheduler)) (handle JobHandle)] (-> (ptr ScheduledJob))
  (let [slot (load (field handle slot))]
    (if (or (< slot 0) (>= slot (al/al-len [ScheduledJob] (load (field scheduler jobs)))))
        (primitive/cast (ptr ScheduledJob) 0)
        (let [job (al/al-elem [ScheduledJob] (field scheduler jobs) slot)]
          (if (and (!= (load (field job kind)) 0)
                   (= (load (field job generation)) (load (field handle generation))))
              job
              (primitive/cast (ptr ScheduledJob) 0))))))

(defn scheduler-activate! [(scheduler (mut Scheduler))
                           (kind i64)
                           (deadline-ms i64)
                           (callback (fnptr c [(ptr i8)] i64))
                           (context (ptr i8))] (-> JobHandle)
  (let [handle (scheduler-slot! (mut scheduler))
        job (al/al-elem [ScheduledJob] (field scheduler jobs) (load (field handle slot)))]
    (do
      (store! (field job kind) kind)
      (store! (field job deadline-ms) deadline-ms)
      (store! (field job callback) callback)
      (store! (field job context) context)
      (set! (field scheduler active) (+ (load (field scheduler active)) 1))
      handle)))

(defn scheduler-dispatch! [(scheduler (mut Scheduler))
                           (callback (fnptr c [(ptr i8)] i64))
                           (context (ptr i8))] (-> JobHandle)
  (scheduler-activate! (mut scheduler) 1 0 callback context))

(defn scheduler-after! [(scheduler (mut Scheduler))
                        (delay-ms i64)
                        (callback (fnptr c [(ptr i8)] i64))
                        (context (ptr i8))] (-> JobHandle)
  (let [now (match (time/monotonic-now-ms) (Ok [value] value) (Err [_] 0))
        delay (if (< delay-ms 0) 0 delay-ms)]
    (scheduler-activate! (mut scheduler) 2 (+ now delay) callback context)))

(defn scheduler-at! [(scheduler (mut Scheduler))
                     (deadline-ms i64)
                     (callback (fnptr c [(ptr i8)] i64))
                     (context (ptr i8))] (-> JobHandle)
  (scheduler-activate! (mut scheduler) 2 deadline-ms callback context))

(defn scheduler-spawn-priority! [(scheduler (mut Scheduler))
                                 (priority i64)
                                 (worker (fnptr c [(ptr i8) (ptr i64)] i64))
                                 (completion (fnptr c [(ptr i8) i64 i64] i64))
                                 (worker-context (ptr i8))
                                 (completion-context (ptr i8))] (-> JobHandle)
  (let [memory (malloc (primitive/cast u64 (primitive/sizeof BackgroundWork)))
        pool (load (field scheduler pool))]
    (if (or (= (primitive/cast i64 memory) 0)
            (or (= (primitive/cast i64 pool) 0)
                (= (al/al-len [thread/Thread] (load (field scheduler workers))) 0)))
        (do
          (when (!= (primitive/cast i64 memory) 0) (do (free memory) 0))
          (JobHandle :slot -1 :generation 0))
        (let [work (primitive/cast (ptr BackgroundWork) memory)
              handle (scheduler-slot! (mut scheduler))
              job (al/al-elem [ScheduledJob] (field scheduler jobs) (load (field handle slot)))]
          (do
            (store! work (primitive/zeroed BackgroundWork))
            (store! (field work worker) worker)
            (store! (field work completion) completion)
            (store! (field work worker-context) worker-context)
            (store! (field work completion-context) completion-context)
            (store! (field work wake) (load (field scheduler wake)))
            (store! (field work wake-context) (load (field scheduler wake-context)))
            (store! (field work wake-enabled) (load (field scheduler wake-enabled)))
            (store! (field work priority)
                    (cond (= priority priority-high) priority-high
                          (= priority priority-low) priority-low
                          :else priority-medium))
            (atomic/atomic-store (field work result) 0)
            (atomic/atomic-store (field work cancel-requested) 0)
            (atomic/atomic-store (field work done) 0)
            (store! (field work next) (null-work))
            (store! (field job kind) 3)
            (store! (field job background) work)
            (set! (field scheduler active) (+ (load (field scheduler active)) 1))
            (if (pool-enqueue! pool work)
                handle
                (do
                  (set! (field scheduler active) (- (load (field scheduler active)) 1))
                  (store! job (empty-job (load (field handle generation))))
                  (free memory)
                  (JobHandle :slot -1 :generation 0))))))))

(defn scheduler-spawn! [(scheduler (mut Scheduler))
                        (worker (fnptr c [(ptr i8) (ptr i64)] i64))
                        (completion (fnptr c [(ptr i8) i64 i64] i64))
                        (worker-context (ptr i8))
                        (completion-context (ptr i8))] (-> JobHandle)
  (scheduler-spawn-priority! (mut scheduler)
                             priority-medium
                             worker
                             completion
                             worker-context
                             completion-context))

(defn scheduler-cancel-requested? [(flag (ptr i64))] (-> bool)
  (!= (atomic/atomic-load flag) 0))

(defn scheduler-cancel! [(scheduler (mut Scheduler)) (handle JobHandle)] (-> bool)
  (let [job (scheduler-job (mut scheduler) handle)]
    (if (= (primitive/cast i64 job) 0)
        false
        (if (= (load (field job kind)) 3)
            (do
              (atomic/atomic-store (field (load (field job background)) cancel-requested) 1)
              true)
            (do
              (store! job (empty-job (load (field job generation))))
              (set! (field scheduler active) (- (load (field scheduler active)) 1))
              true)))))

(defn scheduler-handle-active? [(scheduler (mut Scheduler)) (handle JobHandle)] (-> bool)
  (!= (primitive/cast i64 (scheduler-job (mut scheduler) handle)) 0))

(defn scheduler-complete-job! [(scheduler (mut Scheduler)) (job (ptr ScheduledJob))] (-> i64)
  (let [generation (load (field job generation))]
    (do
      (store! job (empty-job generation))
      (set! (field scheduler active) (- (load (field scheduler active)) 1))
      0)))

(defn scheduler-poll-at! [(scheduler (mut Scheduler)) (now-ms i64)] (-> i64)
  (let [(mut completed) 0]
    (do
      (for [i 0 (al/al-len [ScheduledJob] (load (field scheduler jobs)))]
        (let [job (al/al-elem [ScheduledJob] (field scheduler jobs) i)
              kind (load (field job kind))]
          (cond (= kind 1)
                  (let [callback (load (field job callback))
                        context (load (field job context))]
                    (do
                      (scheduler-complete-job! (mut scheduler) job)
                      (primitive/call-ptr callback context)
                      (set! completed (+ (load completed) 1))))
                (and (= kind 2) (>= now-ms (load (field job deadline-ms))))
                  (let [callback (load (field job callback))
                        context (load (field job context))]
                    (do
                      (scheduler-complete-job! (mut scheduler) job)
                      (primitive/call-ptr callback context)
                      (set! completed (+ (load completed) 1))))
                (= kind 3)
                  (let [work (load (field job background))]
                    (when (!= (atomic/atomic-load (field work done)) 0)
                      (let [completion (load (field work completion))
                            context (load (field work completion-context))
                            result (atomic/atomic-load (field work result))
                            cancelled (atomic/atomic-load (field work cancel-requested))]
                        (do
                          (scheduler-complete-job! (mut scheduler) job)
                          (primitive/call-ptr completion context result cancelled)
                          (free (primitive/cast (ptr i8) work))
                          (set! completed (+ (load completed) 1))))))
                :else 0)))
      (load completed))))

(defn scheduler-poll! [(scheduler (mut Scheduler))] (-> i64)
  (match (time/monotonic-now-ms)
    (Ok [now] (scheduler-poll-at! (mut scheduler) now))
    (Err [_] (scheduler-poll-at! (mut scheduler) 0))))

(defn scheduler-active-count [(scheduler Scheduler)] (-> i64)
  (load (field scheduler active)))

(defn scheduler-free! [(scheduler (mut Scheduler))] (-> i64)
  (do
    (for [i 0 (al/al-len [ScheduledJob] (load (field scheduler jobs)))]
      (let [job (al/al-elem [ScheduledJob] (field scheduler jobs) i)]
        (when (= (load (field job kind)) 3)
          (let [work (load (field job background))]
            (do
              (atomic/atomic-store (field work cancel-requested) 1)
              0)))))
    (let [pool (load (field scheduler pool))]
      (when (!= (primitive/cast i64 pool) 0)
        (do
          (match (sync/mutex-lock! (field pool mutex))
            (Err [_] 0)
            (Ok [_]
                (do
                  (store! (field pool shutdown) true)
                  (sync/condition-notify-all! (field pool available))
                  (sync/mutex-unlock! (field pool mutex))
                  0)))
          (for [i 0 (al/al-len [thread/Thread] (load (field scheduler workers)))]
            (thread/thread-join (al/al-elem [thread/Thread] (field scheduler workers) i)))
          (for [i 0 (al/al-len [ScheduledJob] (load (field scheduler jobs)))]
            (let [job (al/al-elem [ScheduledJob] (field scheduler jobs) i)]
              (when (= (load (field job kind)) 3)
                (do
                  (free (primitive/cast (ptr i8) (load (field job background))))
                  0))))
          (sync/condition-destroy! (field pool available))
          (sync/mutex-destroy! (field pool mutex))
          (free (primitive/cast (ptr i8) pool))
          (store! (field scheduler pool) (null-pool))
          0)))
    (al/al-free! [thread/Thread] (mut (field scheduler workers)))
    (al/al-free! [ScheduledJob] (mut (field scheduler jobs)))
    (store! (field scheduler active) 0)
    0))

(defn task-scope-new [] (-> TaskScope)
  (TaskScope :handles (al/al-new [JobHandle] (alloc/malloc-allocator)) :closed false))

(defn invalid-handle [] (-> JobHandle)
  (JobHandle :slot -1 :generation 0))

(defn task-scope-track! [(scope (mut TaskScope)) (handle JobHandle)] (-> JobHandle)
  (do
    (when (>= (load (field handle slot)) 0)
      (al/al-push! [JobHandle] (mut (field scope handles)) handle))
    handle))

(defn task-scope-dispatch! [(scope (mut TaskScope))
                            (scheduler (mut Scheduler))
                            (callback (fnptr c [(ptr i8)] i64))
                            (context (ptr i8))] (-> JobHandle)
  (if (load (field scope closed))
      (invalid-handle)
      (task-scope-track! (mut scope)
                         (scheduler-dispatch! (mut scheduler) callback context))))

(defn task-scope-after! [(scope (mut TaskScope))
                         (scheduler (mut Scheduler))
                         (delay-ms i64)
                         (callback (fnptr c [(ptr i8)] i64))
                         (context (ptr i8))] (-> JobHandle)
  (if (load (field scope closed))
      (invalid-handle)
      (task-scope-track! (mut scope)
                         (scheduler-after! (mut scheduler) delay-ms callback context))))

(defn task-scope-spawn! [(scope (mut TaskScope))
                         (scheduler (mut Scheduler))
                         (worker (fnptr c [(ptr i8) (ptr i64)] i64))
                         (completion (fnptr c [(ptr i8) i64 i64] i64))
                         (worker-context (ptr i8))
                         (completion-context (ptr i8))] (-> JobHandle)
  (if (load (field scope closed))
      (invalid-handle)
      (task-scope-track! (mut scope)
                         (scheduler-spawn! (mut scheduler)
                                           worker
                                           completion
                                           worker-context
                                           completion-context))))

(defn task-scope-spawn-priority! [(scope (mut TaskScope))
                                  (scheduler (mut Scheduler))
                                  (priority i64)
                                  (worker (fnptr c [(ptr i8) (ptr i64)] i64))
                                  (completion (fnptr c [(ptr i8) i64 i64] i64))
                                  (worker-context (ptr i8))
                                  (completion-context (ptr i8))] (-> JobHandle)
  (if (load (field scope closed))
      (invalid-handle)
      (task-scope-track! (mut scope)
                         (scheduler-spawn-priority! (mut scheduler)
                                                    priority
                                                    worker
                                                    completion
                                                    worker-context
                                                    completion-context))))

(defn task-scope-prune! [(scope (mut TaskScope)) (scheduler (mut Scheduler))] (-> i64)
  (let [(mut write) 0
        count (al/al-len [JobHandle] (load (field scope handles)))]
    (do
      (for [read 0 count]
        (let [handle (al/al-get [JobHandle] (load (field scope handles)) read)]
          (when (scheduler-handle-active? (mut scheduler) handle)
            (do
              (when (!= (load write) read)
                (al/al-set! [JobHandle] (mut (field scope handles)) (load write) handle))
              (set! write (+ (load write) 1))))))
      (store! (field (field scope handles) len) (load write))
      (load write))))

(defn task-scope-cancel! [(scope (mut TaskScope)) (scheduler (mut Scheduler))] (-> i64)
  (let [(mut cancelled) 0]
    (do
      (store! (field scope closed) true)
      (for [i 0 (al/al-len [JobHandle] (load (field scope handles)))]
        (when (scheduler-cancel! (mut scheduler)
                                 (al/al-get [JobHandle] (load (field scope handles)) i))
          (set! cancelled (+ (load cancelled) 1))))
      (al/al-clear! [JobHandle] (mut (field scope handles)))
      (load cancelled))))

(defn task-scope-active-count [(scope (mut TaskScope))
                               (scheduler (mut Scheduler))] (-> i64)
  (task-scope-prune! (mut scope) (mut scheduler)))

(defn task-scope-closed? [(scope TaskScope)] (-> bool)
  (load (field scope closed)))

(defn task-scope-free! [(scope (mut TaskScope)) (scheduler (mut Scheduler))] (-> i64)
  (do
    (task-scope-cancel! (mut scope) (mut scheduler))
    (al/al-free! [JobHandle] (mut (field scope handles)))
    0))
