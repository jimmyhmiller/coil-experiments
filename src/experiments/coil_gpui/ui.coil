(module experiments.coil_gpui.ui)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "coil.primitive" :as primitive)

(export Color
        Rect
        EdgeInsets
        Primitive
        TextSprite
        Scene
        scene-new
        scene-clear!
        scene-free!
        rgba
        rgb
        rect
        contains?
        inset
        scene-rect!
        scene-rounded-rect!
        scene-texture!
        Axis
        Align
        Justify
        Style
        Layout
        layout-row!
        layout-column!
        ButtonState
        button!
        CheckboxState
        checkbox!
        SliderState
        slider!
        ProgressState
        progress!
        DividerState
        divider!
        PanelState
        panel!
        hit-test
        topmost-hit)

(defstruct Color [(r f32) (g f32) (b f32) (a f32)])

(defstruct Rect [(x f32) (y f32) (w f32) (h f32)])

(defstruct EdgeInsets [(top f32) (right f32) (bottom f32) (left f32)])

;;; GPU instance payload. The Metal vertex shader expands each instance into
;;; six vertices, so the CPU submits a single compact record per visual box.
(defstruct Primitive
  [(bounds Rect)
   (color Color)
   (radius f32)
   (border-width f32)
   (border-color Color)
   (clip Rect)
   (kind i32)
   (id i32)])

(defstruct TextSprite [(bounds Rect) (color Color) (texture (ptr i8)) (id i32) (padding i32)])

(defstruct Scene [(items (al/ArrayList Primitive)) (text (al/ArrayList TextSprite))])

(defn rgba [(r f32) (g f32) (b f32) (a f32)] (-> Color)
  (Color
    :r r
    :g g
    :b b
    :a a))

(defn rgb [(r f32) (g f32) (b f32)] (-> Color)
  (rgba r g b 1.0))

(defn rect [(x f32) (y f32) (w f32) (h f32)] (-> Rect)
  (Rect
    :x x
    :y y
    :w w
    :h h))

(defn contains? [(r Rect) (px f32) (py f32)] (-> bool)
  (and (>= px (load (field r x)))
       (>= py (load (field r y)))
       (< px (+ (load (field r x)) (load (field r w))))
       (< py (+ (load (field r y)) (load (field r h))))))

(defn inset [(r Rect) (e EdgeInsets)] (-> Rect)
  (rect (+ (load (field r x)) (load (field e left)))
        (+ (load (field r y)) (load (field e top)))
        (- (load (field r w)) (+ (load (field e left)) (load (field e right))))
        (- (load (field r h)) (+ (load (field e top)) (load (field e bottom))))))

(defn scene-new [] (-> Scene)
  (let [allocator (alloc/malloc-allocator)]
    (Scene :items (al/al-new [Primitive] allocator)
      :text (al/al-new [TextSprite] allocator))))

(defn scene-clear! [(scene (mut Scene))] (-> i64)
  (do
    (al/al-clear! [Primitive] (mut (.items scene)))
    (al/al-clear! [TextSprite] (mut (.text scene)))))

(defn scene-free! [(scene (mut Scene))] (-> i64)
  (do
    (al/al-free! [Primitive] (mut (.items scene)))
    (al/al-free! [TextSprite] (mut (.text scene)))))

(defn scene-rect! [(scene (mut Scene)) (bounds Rect) (color Color) (id i32)] (-> i64)
  (scene-rounded-rect! (mut scene) bounds color 0.0 0.0 (rgba 0.0 0.0 0.0 0.0) id))

(defn scene-rounded-rect! [(scene (mut Scene))
                           (bounds Rect)
                           (color Color)
                           (radius f32)
                           (border-width f32)
                           (border-color Color)
                           (id i32)] (-> i64)
  (al/al-push! [Primitive]
               (mut (.items scene))
               (Primitive
                 :bounds bounds
                 :color color
                 :radius radius
                 :border-width border-width
                 :border-color border-color
                 :clip (rect -100000.0 -100000.0 200000.0 200000.0)
                 :kind 0
                 :id id)))

;;; Queue a cached alpha-mask texture for GPU compositing. Texture ownership
;;; remains with the renderer/text cache; the transient scene only borrows it.
(defn scene-texture! [(scene (mut Scene))
                      (bounds Rect)
                      (color Color)
                      (texture (ptr i8))
                      (id i32)] (-> i64)
  (al/al-push! [TextSprite]
               (mut (.text scene))
               (TextSprite
                 :bounds bounds
                 :color color
                 :texture texture
                 :id id
                 :padding 0)))

(defsum Axis (Horizontal) (Vertical))

(defsum Align (Start) (Center) (End) (Stretch))

(defsum Justify (Leading) (Middle) (Trailing) (SpaceBetween))

(defstruct Style [(gap f32) (padding EdgeInsets) (align Align) (justify Justify)])

(defstruct Layout [(cursor f32) (cross f32) (available f32) (count i64) (index i64)])

(defn layout-row! [(bounds Rect) (style Style) (count i64)] (-> Layout)
  (let [inner (inset bounds (load (field style padding)))]
    (Layout
      :cursor (load (field inner x))
      :cross (load (field inner y))
      :available (load (field inner w))
      :count count
      :index 0)))

(defn layout-column! [(bounds Rect) (style Style) (count i64)] (-> Layout)
  (let [inner (inset bounds (load (field style padding)))]
    (Layout
      :cursor (load (field inner y))
      :cross (load (field inner x))
      :available (load (field inner h))
      :count count
      :index 0)))

(defstruct ButtonState [(hovered bool) (pressed bool) (disabled bool)])

(defstruct CheckboxState [(checked bool) (hovered bool) (disabled bool)])

(defstruct SliderState [(value f32) (minimum f32) (maximum f32) (hovered bool)])

(defstruct ProgressState [(value f32)])

(defstruct DividerState [(vertical bool)])

(defstruct PanelState [(elevated bool)])

(defn button! [(scene (mut Scene)) (bounds Rect) (state ButtonState) (id i32)] (-> i64)
  (let [color
          (cond (load (field state disabled)) (rgb 0.25 0.27 0.31)
                (load (field state pressed)) (rgb 0.18 0.42 0.92)
                (load (field state hovered)) (rgb 0.32 0.56 1.0)
                :else (rgb 0.25 0.49 0.96))]
    (scene-rounded-rect! (mut scene) bounds color 8.0 1.0 (rgba 1.0 1.0 1.0 0.18) id)))

(defn checkbox! [(scene (mut Scene)) (bounds Rect) (state CheckboxState) (id i32)] (-> i64)
  (let [track (if (load (field state checked)) (rgb 0.25 0.49 0.96) (rgb 0.20 0.22 0.27))]
    (do
      (scene-rounded-rect! (mut scene) bounds track 5.0 1.0 (rgb 0.40 0.43 0.50) id)
      (if (load (field state checked))
          (scene-rounded-rect! (mut scene)
                               (inset bounds
                                      (EdgeInsets
                                        :top 5.0
                                        :right 5.0
                                        :bottom 5.0
                                        :left 5.0))
                               (rgb 0.95 0.97 1.0)
                               3.0
                               0.0
                               (rgba 0.0 0.0 0.0 0.0)
                               id)
          0))))

(defn slider! [(scene (mut Scene)) (bounds Rect) (state SliderState) (id i32)] (-> i64)
  (let [span (- (load (field state maximum)) (load (field state minimum)))
        t
          (if (and (<= span 0.000001) (>= span -0.000001))
              0.0
              (/ (- (load (field state value)) (load (field state minimum))) span))
        cy (+ (load (field bounds y)) (/ (load (field bounds h)) 2.0))
        fill (* (load (field bounds w)) t)]
    (do
      (scene-rounded-rect! (mut scene)
                           (rect (load (field bounds x)) (- cy 2.0) (load (field bounds w)) 4.0)
                           (rgb 0.25 0.27 0.32)
                           2.0
                           0.0
                           (rgba 0.0 0.0 0.0 0.0)
                           id)
      (scene-rounded-rect! (mut scene)
                           (rect (load (field bounds x)) (- cy 2.0) fill 4.0)
                           (rgb 0.35 0.60 1.0)
                           2.0
                           0.0
                           (rgba 0.0 0.0 0.0 0.0)
                           id)
      (scene-rounded-rect! (mut scene)
                           (rect (- (+ (load (field bounds x)) fill) 7.0) (- cy 7.0) 14.0 14.0)
                           (rgb 0.96 0.97 1.0)
                           7.0
                           1.0
                           (rgb 0.35 0.60 1.0)
                           id))))

(defn progress! [(scene (mut Scene)) (bounds Rect) (state ProgressState) (id i32)] (-> i64)
  (let [v (load (field state value))
        t (cond (< v 0.0) 0.0 (> v 1.0) 1.0 :else v)]
    (do
      (scene-rounded-rect! (mut scene)
                           bounds
                           (rgb 0.20 0.22 0.27)
                           (/ (load (field bounds h)) 2.0)
                           0.0
                           (rgba 0.0 0.0 0.0 0.0)
                           id)
      (scene-rounded-rect! (mut scene)
                           (rect (load (field bounds x))
                                 (load (field bounds y))
                                 (* (load (field bounds w)) t)
                                 (load (field bounds h)))
                           (rgb 0.26 0.74 0.55)
                           (/ (load (field bounds h)) 2.0)
                           0.0
                           (rgba 0.0 0.0 0.0 0.0)
                           id))))

(defn divider! [(scene (mut Scene)) (bounds Rect) (state DividerState) (id i32)] (-> i64)
  (scene-rect! (mut scene) bounds (rgba 1.0 1.0 1.0 0.10) id))

(defn panel! [(scene (mut Scene)) (bounds Rect) (state PanelState) (id i32)] (-> i64)
  (scene-rounded-rect! (mut scene)
                       bounds
                       (if (load (field state elevated)) (rgb 0.13 0.15 0.19) (rgb 0.10 0.11 0.14))
                       12.0
                       1.0
                       (rgba 1.0 1.0 1.0 0.08)
                       id))

(defn hit-test [(primitive Primitive) (x f32) (y f32)] (-> bool)
  (contains? (load (field primitive bounds)) x y))

(defn topmost-hit [(scene Scene) (x f32) (y f32)] (-> i32)
  (let [(mut i) (- (al/al-len [Primitive] (load (field scene items))) 1)]
    (block :found
           (while (>= (load i) 0)
             (let [p (al/al-get [Primitive] (load (field scene items)) (load i))]
               (if (hit-test p x y)
                   (return-from :found (load (field p id)))
                   (store! i (- (load i) 1)))))
           -1)))
