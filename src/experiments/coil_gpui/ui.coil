(module experiments.coil_gpui.ui)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "coil.primitive" :as primitive)
(import "experiments.coil_gpui.path" :as path)

(extern sinf :cc c [f32] (-> f32))

(extern cosf :cc c [f32] (-> f32))

(export Color
        Rect
        Point
        Affine
        EdgeInsets
        Primitive
        TextSprite
        PathDraw
        PaintCommand
        Hitbox
        Scene
        DamageRegion
        scene-new
        scene-clear!
        scene-free!
        rgba
        rgb
        rect
        contains?
        inset
        intersect
        affine-identity
        affine-translate
        affine-scale
        affine-rotate
        affine-multiply
        affine-invertible?
        affine-inverse
        affine-transform-point
        affine-transform-bounds
        scene-rect!
        scene-rounded-rect!
        scene-shadow!
        scene-linear-gradient!
        scene-path-fill!
        path-draw-visible?
        primitive-visible?
        sprite-visible?
        scene-visual-bounds
        damage-union
        scene-texture!
        scene-texture-region!
        scene-image!
        scene-hitbox!
        scene-push-clip!
        scene-pop-clip!
        scene-push-transform!
        scene-pop-transform!
        Axis
        Horizontal
        Vertical
        Align
        Start
        Center
        End
        Stretch
        Justify
        Leading
        Middle
        Trailing
        SpaceBetween
        Style
        Layout
        layout-row!
        layout-column!
        ButtonState
        button!
        CheckboxState
        checkbox!
        SliderState
        slider!
        ProgressState
        progress!
        DividerState
        divider!
        PanelState
        panel!
        hit-test
        topmost-hit)

(defstruct Color [(r f32) (g f32) (b f32) (a f32)])

(defstruct Rect [(x f32) (y f32) (w f32) (h f32)])

(defstruct Point [(x f32) (y f32)])

(defstruct Affine [(m11 f32) (m12 f32) (m21 f32) (m22 f32) (tx f32) (ty f32)])

(defstruct EdgeInsets [(top f32) (right f32) (bottom f32) (left f32)])

;;; GPU instance payload. The Metal vertex shader expands each instance into
;;; six vertices, so the CPU submits a single compact record per visual box.
(defstruct Primitive
  [(bounds Rect)
   (color Color)
   (radius f32)
   (border-width f32)
   (border-color Color)
   (clip Rect)
   (transform Affine)
   (kind i32)
   (id i32)])

(defstruct TextSprite
  [(bounds Rect)
   (color Color)
   (clip Rect)
   (uv Rect)
   (transform Affine)
   (texture (ptr i8))
   (id i32)
   (mode i32)])

(defstruct PathDraw
  [(vertex-start i64)
   (vertex-count i64)
   (bounds Rect)
   (color Color)
   (clip Rect)
   (transform Affine)
   (id i32)
   (padding i32)])

;;; Paint commands retain submission order while allowing adjacent box runs
;;; to remain instanced. Kind 0 indexes `items`; kind 1 indexes `path-draws`.
(defstruct PaintCommand [(kind i32) (index i32)])

(defstruct DamageRegion [(bounds Rect) (valid bool)])

(defstruct Hitbox
  [(bounds Rect)
   (clip Rect)
   (inverse-transform Affine)
   (id i32)
   (parent i32)
   (focusable bool)
   (occludes bool)
   (transform-valid bool)])

(defstruct Scene
  [(items (al/ArrayList Primitive))
   (shadows (al/ArrayList Primitive))
   (text (al/ArrayList TextSprite))
   (path-vertices (al/ArrayList path/PathPoint))
   (path-draws (al/ArrayList PathDraw))
   (paint-commands (al/ArrayList PaintCommand))
   (hitboxes (al/ArrayList Hitbox))
   (current-clip Rect)
   (current-transform Affine)])

(defn rgba [(r f32) (g f32) (b f32) (a f32)] (-> Color)
  (Color
    :r r
    :g g
    :b b
    :a a))

(defn rgb [(r f32) (g f32) (b f32)] (-> Color)
  (rgba r g b 1.0))

(defn rect [(x f32) (y f32) (w f32) (h f32)] (-> Rect)
  (Rect
    :x x
    :y y
    :w w
    :h h))

(defn affine-identity [] (-> Affine)
  (Affine
    :m11 1.0
    :m12 0.0
    :m21 0.0
    :m22 1.0
    :tx 0.0
    :ty 0.0))

(defn affine-translate [(x f32) (y f32)] (-> Affine)
  (Affine
    :m11 1.0
    :m12 0.0
    :m21 0.0
    :m22 1.0
    :tx x
    :ty y))

(defn affine-scale [(x f32) (y f32)] (-> Affine)
  (Affine
    :m11 x
    :m12 0.0
    :m21 0.0
    :m22 y
    :tx 0.0
    :ty 0.0))

(defn affine-rotate [(degrees f32)] (-> Affine)
  (let [radians (* degrees 0.017453292519943295)
        cosine (cosf radians)
        sine (sinf radians)]
    (Affine
      :m11 cosine
      :m12 sine
      :m21 (- (primitive/cast f32 0.0) sine)
      :m22 cosine
      :tx 0.0
      :ty 0.0)))

;;; Composition `a * b`: apply b first, then a.
(defn affine-multiply [(a Affine) (b Affine)] (-> Affine)
  (Affine
    :m11
      (+ (* (load (field a m11)) (load (field b m11)))
         (* (load (field a m21)) (load (field b m12))))
    :m12
      (+ (* (load (field a m12)) (load (field b m11)))
         (* (load (field a m22)) (load (field b m12))))
    :m21
      (+ (* (load (field a m11)) (load (field b m21)))
         (* (load (field a m21)) (load (field b m22))))
    :m22
      (+ (* (load (field a m12)) (load (field b m21)))
         (* (load (field a m22)) (load (field b m22))))
    :tx
      (+ (+ (* (load (field a m11)) (load (field b tx)))
            (* (load (field a m21)) (load (field b ty))))
         (load (field a tx)))
    :ty
      (+ (+ (* (load (field a m12)) (load (field b tx)))
            (* (load (field a m22)) (load (field b ty))))
         (load (field a ty)))))

(defn affine-determinant [(transform Affine)] (-> f32)
  (- (* (load (field transform m11)) (load (field transform m22)))
     (* (load (field transform m12)) (load (field transform m21)))))

(defn affine-invertible? [(transform Affine)] (-> bool)
  (let [determinant (affine-determinant transform)]
    (or (> determinant 0.000001) (< determinant -0.000001))))

(defn affine-inverse [(transform Affine)] (-> Affine)
  (let [determinant (affine-determinant transform)]
    (if (not (affine-invertible? transform))
        (affine-identity)
        (let [inverse-det (/ (primitive/cast f32 1.0) determinant)
              m11 (* (load (field transform m22)) inverse-det)
              m12 (* (- (primitive/cast f32 0.0) (load (field transform m12))) inverse-det)
              m21 (* (- (primitive/cast f32 0.0) (load (field transform m21))) inverse-det)
              m22 (* (load (field transform m11)) inverse-det)
              tx
                (- (primitive/cast f32 0.0)
                   (+ (* m11 (load (field transform tx)))
                      (* m21 (load (field transform ty)))))
              ty
                (- (primitive/cast f32 0.0)
                   (+ (* m12 (load (field transform tx)))
                      (* m22 (load (field transform ty)))))]
          (Affine
            :m11 m11
            :m12 m12
            :m21 m21
            :m22 m22
            :tx tx
            :ty ty)))))

(defn affine-transform-point [(transform Affine) (point Point)] (-> Point)
  (Point :x
           (+ (+ (* (load (field transform m11)) (load (field point x)))
                 (* (load (field transform m21)) (load (field point y))))
              (load (field transform tx)))
    :y
      (+ (+ (* (load (field transform m12)) (load (field point x)))
            (* (load (field transform m22)) (load (field point y))))
         (load (field transform ty)))))

(defn affine-transform-bounds [(transform Affine) (bounds Rect)] (-> Rect)
  (let [x (load (field bounds x))
        y (load (field bounds y))
        right (+ x (load (field bounds w)))
        bottom (+ y (load (field bounds h)))
        p0 (affine-transform-point transform (Point :x x :y y))
        p1 (affine-transform-point transform (Point :x right :y y))
        p2 (affine-transform-point transform (Point :x x :y bottom))
        p3 (affine-transform-point transform (Point :x right :y bottom))
        min-x
          (let [a
                  (if (< (load (field p0 x)) (load (field p1 x)))
                      (load (field p0 x))
                      (load (field p1 x)))
                b
                  (if (< (load (field p2 x)) (load (field p3 x)))
                      (load (field p2 x))
                      (load (field p3 x)))]
            (if (< a b) a b))
        max-x
          (let [a
                  (if (> (load (field p0 x)) (load (field p1 x)))
                      (load (field p0 x))
                      (load (field p1 x)))
                b
                  (if (> (load (field p2 x)) (load (field p3 x)))
                      (load (field p2 x))
                      (load (field p3 x)))]
            (if (> a b) a b))
        min-y
          (let [a
                  (if (< (load (field p0 y)) (load (field p1 y)))
                      (load (field p0 y))
                      (load (field p1 y)))
                b
                  (if (< (load (field p2 y)) (load (field p3 y)))
                      (load (field p2 y))
                      (load (field p3 y)))]
            (if (< a b) a b))
        max-y
          (let [a
                  (if (> (load (field p0 y)) (load (field p1 y)))
                      (load (field p0 y))
                      (load (field p1 y)))
                b
                  (if (> (load (field p2 y)) (load (field p3 y)))
                      (load (field p2 y))
                      (load (field p3 y)))]
            (if (> a b) a b))]
    (rect min-x min-y (- max-x min-x) (- max-y min-y))))

(defn contains? [(r Rect) (px f32) (py f32)] (-> bool)
  (and (>= px (load (field r x)))
       (>= py (load (field r y)))
       (< px (+ (load (field r x)) (load (field r w))))
       (< py (+ (load (field r y)) (load (field r h))))))

(defn inset [(r Rect) (e EdgeInsets)] (-> Rect)
  (rect (+ (load (field r x)) (load (field e left)))
        (+ (load (field r y)) (load (field e top)))
        (- (load (field r w)) (+ (load (field e left)) (load (field e right))))
        (- (load (field r h)) (+ (load (field e top)) (load (field e bottom))))))

(defn intersect [(a Rect) (b Rect)] (-> Rect)
  (let [left (if (> (load (field a x)) (load (field b x))) (load (field a x)) (load (field b x)))
        top (if (> (load (field a y)) (load (field b y))) (load (field a y)) (load (field b y)))
        ar (+ (load (field a x)) (load (field a w)))
        br (+ (load (field b x)) (load (field b w)))
        ab (+ (load (field a y)) (load (field a h)))
        bb (+ (load (field b y)) (load (field b h)))
        right (if (< ar br) ar br)
        bottom (if (< ab bb) ab bb)]
    (rect left
          top
          (if (> right left) (- right left) 0.0)
          (if (> bottom top) (- bottom top) 0.0))))

(defn scene-new [] (-> Scene)
  (let [allocator (alloc/malloc-allocator)]
    (Scene
      :items (al/al-new [Primitive] allocator)
      :shadows (al/al-new [Primitive] allocator)
      :text (al/al-new [TextSprite] allocator)
      :path-vertices (al/al-new [path/PathPoint] allocator)
      :path-draws (al/al-new [PathDraw] allocator)
      :paint-commands (al/al-new [PaintCommand] allocator)
      :hitboxes (al/al-new [Hitbox] allocator)
      :current-clip (rect -100000.0 -100000.0 200000.0 200000.0)
      :current-transform (affine-identity))))

(defn scene-clear! [(scene (mut Scene))] (-> i64)
  (do
    (al/al-clear! [Primitive] (mut (.items scene)))
    (al/al-clear! [Primitive] (mut (.shadows scene)))
    (al/al-clear! [TextSprite] (mut (.text scene)))
    (al/al-clear! [path/PathPoint] (mut (.path-vertices scene)))
    (al/al-clear! [PathDraw] (mut (.path-draws scene)))
    (al/al-clear! [PaintCommand] (mut (.paint-commands scene)))
    (al/al-clear! [Hitbox] (mut (.hitboxes scene)))
    (set! (.current-clip scene) (rect -100000.0 -100000.0 200000.0 200000.0))
    (set! (.current-transform scene) (affine-identity))
    0))

(defn scene-free! [(scene (mut Scene))] (-> i64)
  (do
    (al/al-free! [Primitive] (mut (.items scene)))
    (al/al-free! [Primitive] (mut (.shadows scene)))
    (al/al-free! [TextSprite] (mut (.text scene)))
    (al/al-free! [path/PathPoint] (mut (.path-vertices scene)))
    (al/al-free! [PathDraw] (mut (.path-draws scene)))
    (al/al-free! [PaintCommand] (mut (.paint-commands scene)))
    (al/al-free! [Hitbox] (mut (.hitboxes scene)))))

(defn scene-rect! [(scene (mut Scene)) (bounds Rect) (color Color) (id i32)] (-> i64)
  (scene-rounded-rect! (mut scene) bounds color 0.0 0.0 (rgba 0.0 0.0 0.0 0.0) id))

(defn scene-rounded-rect! [(scene (mut Scene))
                           (bounds Rect)
                           (color Color)
                           (radius f32)
                           (border-width f32)
                           (border-color Color)
                           (id i32)] (-> i64)
  (let [index (al/al-len [Primitive] (load (field scene items)))]
    (do
      (al/al-push! [Primitive]
                   (mut (.items scene))
                   (Primitive
                     :bounds bounds
                     :color color
                     :radius radius
                     :border-width border-width
                     :border-color border-color
                     :clip (load (field scene current-clip))
                     :transform (load (field scene current-transform))
                     :kind 0
                     :id id))
      (al/al-push! [PaintCommand]
                   (mut (.paint-commands scene))
                   (PaintCommand :kind 0 :index (primitive/cast i32 index))))))

;;; Queue one analytically blurred rounded-rectangle shadow. `blur` is the
;;; Gaussian sigma in logical pixels; the quad extends to three sigma, where
;;; remaining opacity is negligible. Shadows have their own GPU batch and are
;;; painted behind ordinary primitives without CPU blur kernels or textures.
(defn scene-shadow! [(scene (mut Scene))
                     (bounds Rect)
                     (offset-x f32)
                     (offset-y f32)
                     (blur f32)
                     (spread f32)
                     (radius f32)
                     (color Color)
                     (id i32)] (-> i64)
  (let [sigma (if (< blur 0.5) 0.5 blur)
        extent (+ (* sigma 3.0) (if (> spread 0.0) spread 0.0))]
    (al/al-push! [Primitive]
                 (mut (.shadows scene))
                 (Primitive :bounds
                            (rect (- (+ (load (field bounds x)) offset-x) extent)
                                  (- (+ (load (field bounds y)) offset-y) extent)
                                  (+ (load (field bounds w)) (* extent 2.0))
                                  (+ (load (field bounds h)) (* extent 2.0)))
                            :color
                            color
                            :radius
                            (+ radius spread)
                            :border-width
                            sigma
                            ;; The red channel carries the expanded-quad inset to the
                            ;; shadow shader; shadow color remains in `color`.
                            :border-color
                            (rgba extent 0.0 0.0 0.0)
                            :clip
                            (load (field scene current-clip))
                            :transform
                            (load (field scene current-transform))
                            :kind
                            1
                            :id
                            id))))

;;; Queue a two-stop linear gradient. CSS-compatible degrees are measured
;;; clockwise from the upward direction, so 90 degrees runs left-to-right.
;;; The shared primitive ABI carries start/end colors, radius, angle, affine,
;;; clip, and identity; gradients remain a single instanced GPU batch.
(defn scene-linear-gradient! [(scene (mut Scene))
                              (bounds Rect)
                              (start-color Color)
                              (end-color Color)
                              (angle-degrees f32)
                              (radius f32)
                              (id i32)] (-> i64)
  (let [index (al/al-len [Primitive] (load (field scene items)))]
    (do
      (al/al-push! [Primitive]
                   (mut (.items scene))
                   (Primitive
                     :bounds bounds
                     :color start-color
                     :radius radius
                     :border-width angle-degrees
                     :border-color end-color
                     :clip (load (field scene current-clip))
                     :transform (load (field scene current-transform))
                     :kind 2
                     :id id))
      (al/al-push! [PaintCommand]
                   (mut (.paint-commands scene))
                   (PaintCommand :kind 0 :index (primitive/cast i32 index))))))

(defn scene-path-fill! [(scene (mut Scene))
                        (tessellation path/Tessellation)
                        (color Color)
                        (id i32)] (-> i64)
  (let [vertices (load (field tessellation vertices))
        count (al/al-len [path/PathPoint] vertices)]
    (if (or (not (load (field tessellation valid))) (= count 0))
        0
        (let [start (al/al-len [path/PathPoint] (load (field scene path-vertices)))
              draw-index (al/al-len [PathDraw] (load (field scene path-draws)))
              mesh-bounds (path/tessellation-bounds tessellation)]
          (do
            (for [i 0 count]
              (al/al-push! [path/PathPoint]
                           (mut (.path-vertices scene))
                           (al/al-get [path/PathPoint] vertices i)))
            (al/al-push! [PathDraw]
                         (mut (.path-draws scene))
                         (PathDraw
                           :vertex-start start
                           :vertex-count count
                           :bounds
                             (rect (load (field mesh-bounds x))
                                   (load (field mesh-bounds y))
                                   (load (field mesh-bounds w))
                                   (load (field mesh-bounds h)))
                           :color color
                           :clip (load (field scene current-clip))
                           :transform (load (field scene current-transform))
                           :id id
                           :padding 0))
            (al/al-push! [PaintCommand]
                         (mut (.paint-commands scene))
                         (PaintCommand :kind 1 :index (primitive/cast i32 draw-index))))))))

(defn path-draw-visible? [(draw PathDraw) (viewport Rect)] (-> bool)
  (let [transformed
          (affine-transform-bounds (load (field draw transform))
                                   (load (field draw bounds)))
        clipped (intersect transformed (load (field draw clip)))
        visible (intersect clipped viewport)]
    (and (> (load (field visible w)) 0.0) (> (load (field visible h)) 0.0))))

(defn transformed-bounds-visible? [(bounds Rect)
                                   (clip Rect)
                                   (transform Affine)
                                   (viewport Rect)] (-> bool)
  (let [transformed (affine-transform-bounds transform bounds)
        clipped (intersect transformed clip)
        visible (intersect clipped viewport)]
    (and (> (load (field visible w)) 0.0) (> (load (field visible h)) 0.0))))

(defn primitive-visible? [(item Primitive) (viewport Rect)] (-> bool)
  (transformed-bounds-visible? (load (field item bounds))
                               (load (field item clip))
                               (load (field item transform))
                               viewport))

(defn sprite-visible? [(sprite TextSprite) (viewport Rect)] (-> bool)
  (transformed-bounds-visible? (load (field sprite bounds))
                               (load (field sprite clip))
                               (load (field sprite transform))
                               viewport))

(defn rect-union [(a Rect) (b Rect)] (-> Rect)
  (let [left (if (< (load (field a x)) (load (field b x))) (load (field a x)) (load (field b x)))
        top (if (< (load (field a y)) (load (field b y))) (load (field a y)) (load (field b y)))
        ar (+ (load (field a x)) (load (field a w)))
        br (+ (load (field b x)) (load (field b w)))
        ab (+ (load (field a y)) (load (field a h)))
        bb (+ (load (field b y)) (load (field b h)))
        right (if (> ar br) ar br)
        bottom (if (> ab bb) ab bb)]
    (rect left top (- right left) (- bottom top))))

(defn damage-add! [(damage (mut DamageRegion)) (bounds Rect)] (-> i64)
  (if (or (<= (load (field bounds w)) 0.0) (<= (load (field bounds h)) 0.0))
      0
      (do
        (if (load (field damage valid))
            (set! (.bounds damage) (rect-union (load (field damage bounds)) bounds))
            (do (set! (.bounds damage) bounds) (set! (.valid damage) true)))
        1)))

(defn scene-visual-bounds [(scene Scene) (viewport Rect)] (-> DamageRegion)
  (let [(mut damage) (primitive/zeroed DamageRegion)
        items (load (field scene items))
        shadows (load (field scene shadows))
        sprites (load (field scene text))
        paths (load (field scene path-draws))]
    (do
      (for [i 0 (al/al-len [Primitive] items)]
        (let [item (al/al-get [Primitive] items i)]
          (if (primitive-visible? item viewport)
              (damage-add! (mut damage)
                           (intersect viewport
                                      (intersect (affine-transform-bounds (load (field item transform))
                                                                          (load (field item bounds)))
                                                 (load (field item clip)))))
              0)))
      (for [i 0 (al/al-len [Primitive] shadows)]
        (let [item (al/al-get [Primitive] shadows i)]
          (if (primitive-visible? item viewport)
              (damage-add! (mut damage)
                           (intersect viewport
                                      (affine-transform-bounds (load (field item transform))
                                                               (load (field item bounds)))))
              0)))
      (for [i 0 (al/al-len [TextSprite] sprites)]
        (let [sprite (al/al-get [TextSprite] sprites i)]
          (if (sprite-visible? sprite viewport)
              (damage-add! (mut damage)
                           (intersect viewport
                                      (affine-transform-bounds (load (field sprite transform))
                                                               (load (field sprite bounds)))))
              0)))
      (for [i 0 (al/al-len [PathDraw] paths)]
        (let [draw (al/al-get [PathDraw] paths i)]
          (if (path-draw-visible? draw viewport)
              (damage-add! (mut damage)
                           (intersect viewport
                                      (affine-transform-bounds (load (field draw transform))
                                                               (load (field draw bounds)))))
              0)))
      (load damage))))

(defn damage-union [(previous DamageRegion) (current DamageRegion)] (-> DamageRegion)
  (cond (and (load (field previous valid)) (load (field current valid)))
          (DamageRegion :bounds
                          (rect-union (load (field previous bounds))
                                      (load (field current bounds)))
            :valid true)
        (load (field previous valid)) previous
        (load (field current valid)) current
        :else (DamageRegion :bounds (rect 0.0 0.0 0.0 0.0) :valid false)))

;;; Queue a cached alpha-mask texture for GPU compositing. Texture ownership
;;; remains with the renderer/text cache; the transient scene only borrows it.
(defn scene-texture! [(scene (mut Scene))
                      (bounds Rect)
                      (color Color)
                      (texture (ptr i8))
                      (id i32)] (-> i64)
  (scene-texture-region! (mut scene) bounds color (rect 0.0 0.0 1.0 1.0) texture id))

(defn scene-texture-region! [(scene (mut Scene))
                             (bounds Rect)
                             (color Color)
                             (uv Rect)
                             (texture (ptr i8))
                             (id i32)] (-> i64)
  (al/al-push! [TextSprite]
               (mut (.text scene))
               (TextSprite
                 :bounds bounds
                 :color color
                 :clip (load (field scene current-clip))
                 :uv uv
                 :transform (load (field scene current-transform))
                 :texture texture
                 :id id
                 :mode 0)))

;;; Queue a cached BGRA image texture. Images share geometry and clipping with
;;; text sprites but use the polychrome fragment pipeline (`mode = 1`).
(defn scene-image! [(scene (mut Scene))
                    (bounds Rect)
                    (tint Color)
                    (texture (ptr i8))
                    (id i32)] (-> i64)
  (al/al-push! [TextSprite]
               (mut (.text scene))
               (TextSprite
                 :bounds bounds
                 :color tint
                 :clip (load (field scene current-clip))
                 :uv (rect 0.0 0.0 1.0 1.0)
                 :transform (load (field scene current-transform))
                 :texture texture
                 :id id
                 :mode 1)))

(defn scene-hitbox! [(scene (mut Scene))
                     (bounds Rect)
                     (id i32)
                     (parent i32)
                     (focusable bool)
                     (occludes bool)] (-> i64)
  (al/al-push! [Hitbox]
               (mut (.hitboxes scene))
               (Hitbox
                 :bounds bounds
                 :clip (load (field scene current-clip))
                 :inverse-transform (affine-inverse (load (field scene current-transform)))
                 :id id
                 :parent parent
                 :focusable focusable
                 :occludes occludes
                 :transform-valid (affine-invertible? (load (field scene current-transform))))))

(defn scene-push-clip! [(scene (mut Scene)) (clip Rect)] (-> Rect)
  (let [prior (load (field scene current-clip))
        transformed (affine-transform-bounds (load (field scene current-transform)) clip)]
    (do
      (set! (.current-clip scene) (intersect prior transformed))
      prior)))

(defn scene-pop-clip! [(scene (mut Scene)) (prior Rect)] (-> i64)
  (do (set! (.current-clip scene) prior) 0))

(defn scene-push-transform! [(scene (mut Scene)) (transform Affine)] (-> Affine)
  (let [prior (load (field scene current-transform))]
    (do
      (set! (.current-transform scene) (affine-multiply prior transform))
      prior)))

(defn scene-pop-transform! [(scene (mut Scene)) (prior Affine)] (-> i64)
  (do (set! (.current-transform scene) prior) 0))

(defsum Axis (Horizontal) (Vertical))

(defsum Align (Start) (Center) (End) (Stretch))

(defsum Justify (Leading) (Middle) (Trailing) (SpaceBetween))

(defstruct Style [(gap f32) (padding EdgeInsets) (align Align) (justify Justify)])

(defstruct Layout [(cursor f32) (cross f32) (available f32) (count i64) (index i64)])

(defn layout-row! [(bounds Rect) (style Style) (count i64)] (-> Layout)
  (let [inner (inset bounds (load (field style padding)))]
    (Layout
      :cursor (load (field inner x))
      :cross (load (field inner y))
      :available (load (field inner w))
      :count count
      :index 0)))

(defn layout-column! [(bounds Rect) (style Style) (count i64)] (-> Layout)
  (let [inner (inset bounds (load (field style padding)))]
    (Layout
      :cursor (load (field inner y))
      :cross (load (field inner x))
      :available (load (field inner h))
      :count count
      :index 0)))

(defstruct ButtonState [(hovered bool) (pressed bool) (focused bool) (disabled bool)])

(defstruct CheckboxState [(checked bool) (hovered bool) (focused bool) (disabled bool)])

(defstruct SliderState [(value f32) (minimum f32) (maximum f32) (hovered bool) (focused bool)])

(defstruct ProgressState [(value f32)])

(defstruct DividerState [(vertical bool)])

(defstruct PanelState [(elevated bool)])

(defn button! [(scene (mut Scene)) (bounds Rect) (state ButtonState) (id i32)] (-> i64)
  (let [start-color
          (cond (load (field state disabled)) (rgb 0.25 0.27 0.31)
                (load (field state pressed)) (rgb 0.14 0.35 0.84)
                (load (field state hovered)) (rgb 0.42 0.65 1.0)
                :else (rgb 0.34 0.58 1.0))
        end-color
          (cond (load (field state disabled)) (rgb 0.20 0.22 0.26)
                (load (field state pressed)) (rgb 0.28 0.50 0.98)
                (load (field state hovered)) (rgb 0.22 0.47 0.96)
                :else (rgb 0.18 0.40 0.91))]
    (do
      (scene-linear-gradient! (mut scene) bounds start-color end-color 135.0 8.0 id)
      (scene-rounded-rect! (mut scene)
                           bounds
                           (rgba 0.0 0.0 0.0 0.0)
                           8.0
                           (if (load (field state focused)) 2.0 1.0)
                           (if (load (field state focused))
                               (rgb 0.72 0.82 1.0)
                               (rgba 1.0 1.0 1.0 0.18))
                           id)
      (if (load (field state disabled))
          0
          (scene-hitbox! (mut scene) bounds id -1 true true)))))

(defn checkbox! [(scene (mut Scene)) (bounds Rect) (state CheckboxState) (id i32)] (-> i64)
  (let [track (if (load (field state checked)) (rgb 0.25 0.49 0.96) (rgb 0.20 0.22 0.27))]
    (do
      (scene-rounded-rect! (mut scene)
                           bounds
                           track
                           5.0
                           (if (load (field state focused)) 2.0 1.0)
                           (if (load (field state focused))
                               (rgb 0.72 0.82 1.0)
                               (rgb 0.40 0.43 0.50))
                           id)
      (if (load (field state checked))
          (scene-rounded-rect! (mut scene)
                               (inset bounds
                                      (EdgeInsets
                                        :top 5.0
                                        :right 5.0
                                        :bottom 5.0
                                        :left 5.0))
                               (rgb 0.95 0.97 1.0)
                               3.0
                               0.0
                               (rgba 0.0 0.0 0.0 0.0)
                               id)
          0)
      (if (load (field state disabled))
          0
          (scene-hitbox! (mut scene) bounds id -1 true true)))))

(defn slider! [(scene (mut Scene)) (bounds Rect) (state SliderState) (id i32)] (-> i64)
  (let [span (- (load (field state maximum)) (load (field state minimum)))
        t
          (if (and (<= span 0.000001) (>= span -0.000001))
              0.0
              (/ (- (load (field state value)) (load (field state minimum))) span))
        cy (+ (load (field bounds y)) (/ (load (field bounds h)) 2.0))
        fill (* (load (field bounds w)) t)]
    (do
      (scene-rounded-rect! (mut scene)
                           (rect (load (field bounds x)) (- cy 2.0) (load (field bounds w)) 4.0)
                           (rgb 0.25 0.27 0.32)
                           2.0
                           0.0
                           (rgba 0.0 0.0 0.0 0.0)
                           id)
      (scene-rounded-rect! (mut scene)
                           (rect (load (field bounds x)) (- cy 2.0) fill 4.0)
                           (rgb 0.35 0.60 1.0)
                           2.0
                           0.0
                           (rgba 0.0 0.0 0.0 0.0)
                           id)
      (scene-rounded-rect! (mut scene)
                           (rect (- (+ (load (field bounds x)) fill) 7.0) (- cy 7.0) 14.0 14.0)
                           (rgb 0.96 0.97 1.0)
                           7.0
                           (if (load (field state focused)) 2.0 1.0)
                           (if (load (field state focused))
                               (rgb 0.72 0.82 1.0)
                               (rgb 0.35 0.60 1.0))
                           id)
      (scene-hitbox! (mut scene) bounds id -1 true true))))

(defn progress! [(scene (mut Scene)) (bounds Rect) (state ProgressState) (id i32)] (-> i64)
  (let [v (load (field state value))
        t (cond (< v 0.0) 0.0 (> v 1.0) 1.0 :else v)]
    (do
      (scene-rounded-rect! (mut scene)
                           bounds
                           (rgb 0.20 0.22 0.27)
                           (/ (load (field bounds h)) 2.0)
                           0.0
                           (rgba 0.0 0.0 0.0 0.0)
                           id)
      (scene-rounded-rect! (mut scene)
                           (rect (load (field bounds x))
                                 (load (field bounds y))
                                 (* (load (field bounds w)) t)
                                 (load (field bounds h)))
                           (rgb 0.26 0.74 0.55)
                           (/ (load (field bounds h)) 2.0)
                           0.0
                           (rgba 0.0 0.0 0.0 0.0)
                           id))))

(defn divider! [(scene (mut Scene)) (bounds Rect) (state DividerState) (id i32)] (-> i64)
  (scene-rect! (mut scene) bounds (rgba 1.0 1.0 1.0 0.10) id))

(defn panel! [(scene (mut Scene)) (bounds Rect) (state PanelState) (id i32)] (-> i64)
  (do
    (if (load (field state elevated))
        (scene-shadow! (mut scene) bounds 0.0 8.0 12.0 0.0 12.0 (rgba 0.0 0.0 0.0 0.42) id)
        0)
    (scene-rounded-rect! (mut scene)
                         bounds
                         (if (load (field state elevated)) (rgb 0.13 0.15 0.19) (rgb 0.10 0.11 0.14))
                         12.0
                         1.0
                         (rgba 1.0 1.0 1.0 0.08)
                         id)))

(defn hit-test [(primitive Primitive) (x f32) (y f32)] (-> bool)
  (let [local
          (affine-transform-point (affine-inverse (load (field primitive transform)))
                                  (Point :x x :y y))]
    (and (affine-invertible? (load (field primitive transform)))
         (contains? (load (field primitive bounds))
                    (load (field local x))
                    (load (field local y)))
         (contains? (load (field primitive clip)) x y))))

(defn topmost-hit [(scene Scene) (x f32) (y f32)] (-> i32)
  (let [(mut i) (- (al/al-len [Hitbox] (load (field scene hitboxes))) 1)]
    (block :found
           (while (>= (load i) 0)
             (let [hitbox (al/al-get [Hitbox] (load (field scene hitboxes)) (load i))]
               (let [local
                       (affine-transform-point (load (field hitbox inverse-transform))
                                               (Point :x x :y y))]
                 (if (and (load (field hitbox transform-valid))
                          (contains? (load (field hitbox bounds))
                                     (load (field local x))
                                     (load (field local y)))
                          (contains? (load (field hitbox clip)) x y))
                     (return-from :found (load (field hitbox id)))
                     (store! i (- (load i) 1))))))
           -1)))
