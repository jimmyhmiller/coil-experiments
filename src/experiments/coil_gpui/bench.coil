(module experiments.coil_gpui.bench)
(import "experiments.coil_gpui.ui" :as ui)
(import "experiments.coil_gpui.scroll" :as scroll)
(import "coil.arraylist" :as al)
(import "coil.primitive" :as primitive)

(extern clock_gettime :cc c [i32 (ptr Timespec)] (-> i32))

(extern printf :cc c [(ptr i8) ...] (-> i32))

(defstruct Timespec [(seconds i64) (nanos i64)])

(defn monotonic-nanos [] (-> i64)
  (let [time (primitive/alloc-stack Timespec)]
    (do
      (clock_gettime 6 time)
      (+ (* (load (field time seconds)) 1000000000)
         (load (field time nanos))))))

(defn build-frame! [(scene (mut ui/Scene)) (state (mut scroll/ScrollState)) (frame i64)] (-> i64)
  (do
    (ui/scene-clear! (mut scene))
    (for [i 0 1024]
      (ui/scene-rounded-rect! (mut scene)
                              (ui/rect (primitive/cast f32 (% i 64))
                                       (primitive/cast f32 (/ i 64))
                                       1.5
                                       1.5)
                              (ui/rgba 0.5 0.6 1.0 0.1)
                              0.75
                              0.0
                              (ui/rgba 0.0 0.0 0.0 0.0)
                              -1))
    (scroll/scroll-configure! (mut state) (ui/rect 0.0 0.0 320.0 480.0) 100000 26.0)
    (scroll/scroll-to! (mut state) (primitive/cast f32 (% (* frame 13) 2000000)))
    (let [first (scroll/visible-first (load state))
          last (scroll/visible-last (load state))]
      (for [index first last]
        (ui/scene-rounded-rect! (mut scene)
                                (scroll/item-rect (load state) index)
                                (ui/rgba 0.15 0.18 0.24 1.0)
                                4.0
                                0.0
                                (ui/rgba 0.0 0.0 0.0 0.0)
                                (primitive/cast i32 index))))
    (al/al-len [ui/Primitive] (load (field scene items)))))

(defn main [] (-> i64)
  (let [(mut scene) (primitive/zeroed ui/Scene)
        (mut state) (primitive/zeroed scroll/ScrollState)
        frames 5000
        (mut final-count) 0]
    (do
      (store! scene (ui/scene-new))
      (store! state (scroll/scroll-new 100000 26.0 3))
      (let [start (monotonic-nanos)]
        (do
          (for [frame 0 frames]
            (store! final-count (build-frame! (mut scene) (mut state) frame)))
          (let [elapsed (- (monotonic-nanos) start)
                nanos-per-frame (/ elapsed frames)]
            (printf c"coil-gpui scene benchmark: %lld ns/frame, %lld primitives/frame, %lld frames\n"
                    nanos-per-frame
                    (load final-count)
                    frames))))
      (ui/scene-free! (mut scene))
      0)))
