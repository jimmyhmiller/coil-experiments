(module experiments.coil_gpui.data-table)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "coil.primitive" :as primitive)
(import "experiments.coil_gpui.ui" :as ui)
(import "experiments.coil_gpui.scroll" :as scroll)

(export TableColumn
        TableAction
        DataTable
        table-action-none
        table-action-select
        table-action-sort
        table-action-resize
        data-table-new
        data-table-add-column!
        data-table-configure!
        data-table-free!
        data-table-visible-first
        data-table-visible-last
        data-table-visible-count
        data-table-header-rect
        data-table-row-rect
        data-table-cell-rect
        data-table-total-width
        data-table-scroll-vertical!
        data-table-scroll-horizontal!
        data-table-pointer-down!
        data-table-pointer-move!
        data-table-pointer-up!
        data-table-select-by!
        data-table-select-home!
        data-table-select-end!
        data-table-paint!)

(const table-action-none i32 0)
(const table-action-select i32 1)
(const table-action-sort i32 2)
(const table-action-resize i32 3)

(defstruct TableColumn
  [(width f32) (min-width f32) (max-width f32) (sortable bool)])

(defstruct TableAction [(kind i32) (index i64) (direction i32)])

(defstruct DataTable
  [(columns (al/ArrayList TableColumn))
   (vertical scroll/ScrollState)
   (bounds ui/Rect)
   (row-viewport ui/Rect)
   (horizontal-offset f32)
   (total-width f32)
   (row-count i64)
   (row-height f32)
   (header-height f32)
   (selected-row i64)
   (sort-column i64)
   (sort-direction i32)
   (resizing-column i64)
   (resize-anchor-x f32)
   (resize-anchor-width f32)])

(defn no-table-action [] (-> TableAction)
  (TableAction :kind table-action-none :index -1 :direction 0))

(defn clamp-f32 [(value f32) (minimum f32) (maximum f32)] (-> f32)
  (cond (< value minimum) minimum (> value maximum) maximum :else value))

(defn data-table-new [(row-count i64) (row-height f32) (header-height f32)] (-> DataTable)
  (let [rows (if (> row-count 0) row-count 0)
        height (if (> row-height 0.0) row-height 1.0)]
    (DataTable
      :columns (al/al-new [TableColumn] (alloc/malloc-allocator))
      :vertical (scroll/scroll-new rows height 2)
      :bounds (ui/rect 0.0 0.0 0.0 0.0)
      :row-viewport (ui/rect 0.0 0.0 0.0 0.0)
      :horizontal-offset 0.0 :total-width 0.0
      :row-count rows :row-height height
      :header-height (if (> header-height 0.0) header-height 1.0)
      :selected-row -1 :sort-column -1 :sort-direction 0
      :resizing-column -1 :resize-anchor-x 0.0 :resize-anchor-width 0.0)))

(defn data-table-add-column! [(table (mut DataTable))
                              (width f32)
                              (minimum f32)
                              (maximum f32)
                              (sortable bool)] (-> i64)
  (let [min-width (if (> minimum 0.0) minimum 1.0)
        max-width (if (>= maximum min-width) maximum min-width)
        actual (clamp-f32 width min-width max-width)]
    (do
      (al/al-push! [TableColumn]
                   (mut (.columns table))
                   (TableColumn :width actual :min-width min-width
                                :max-width max-width :sortable sortable))
      (set! (.total-width table) (+ (load (field table total-width)) actual))
      (- (al/al-len [TableColumn] (load (field table columns))) 1))))

(defn data-table-max-horizontal-offset [(table DataTable)] (-> f32)
  (let [maximum (- (load (field table total-width)) (load (field (field table bounds) w)))]
    (if (> maximum 0.0) maximum 0.0)))

(defn data-table-scroll-horizontal! [(table (mut DataTable)) (delta f32)] (-> f32)
  (let [next (+ (load (field table horizontal-offset)) delta)
        maximum (data-table-max-horizontal-offset (load table))
        clamped (clamp-f32 next 0.0 maximum)]
    (do (set! (.horizontal-offset table) clamped) clamped)))

(defn data-table-configure! [(table (mut DataTable))
                             (bounds ui/Rect)
                             (row-count i64)] (-> i64)
  (let [rows (if (> row-count 0) row-count 0)
        header (load (field table header-height))
        row-viewport
          (ui/rect (load (field bounds x))
                   (+ (load (field bounds y)) header)
                   (load (field bounds w))
                   (if (> (load (field bounds h)) header)
                       (- (load (field bounds h)) header)
                       0.0))]
    (do
      (set! (.bounds table) bounds)
      (set! (.row-viewport table) row-viewport)
      (set! (.row-count table) rows)
      (when (>= (load (field table selected-row)) rows)
        (set! (.selected-row table) (if (> rows 0) (- rows 1) -1)))
      (scroll/scroll-configure! (mut (.vertical table))
                                row-viewport rows (load (field table row-height)))
      (data-table-scroll-horizontal! (mut table) 0.0)
      0)))

(defn data-table-free! [(table (mut DataTable))] (-> i64)
  (do
    (al/al-free! [TableColumn] (mut (.columns table)))
    (set! (.row-count table) 0)
    0))

(defn data-table-visible-first [(table DataTable)] (-> i64)
  (scroll/visible-first (load (field table vertical))))

(defn data-table-visible-last [(table DataTable)] (-> i64)
  (scroll/visible-last (load (field table vertical))))

(defn data-table-visible-count [(table DataTable)] (-> i64)
  (- (data-table-visible-last table) (data-table-visible-first table)))

(defn data-table-column-left [(table DataTable) (column i64)] (-> f32)
  (let [(mut x) (- (load (field (field table bounds) x))
                    (load (field table horizontal-offset)))]
    (do
      (for [i 0 column]
        (let [item (al/al-get [TableColumn] (load (field table columns)) i)]
          (store! x (+ (load x) (load (field item width))))))
      (load x))))

(defn data-table-header-rect [(table DataTable) (column i64)] (-> ui/Rect)
  (if (or (< column 0) (>= column (al/al-len [TableColumn] (load (field table columns)))))
      (ui/rect 0.0 0.0 0.0 0.0)
      (let [item (al/al-get [TableColumn] (load (field table columns)) column)]
        (ui/rect (data-table-column-left table column)
                 (load (field (field table bounds) y))
                 (load (field item width))
                 (load (field table header-height))))))

(defn data-table-row-rect [(table DataTable) (row i64)] (-> ui/Rect)
  (let [raw (scroll/item-rect (load (field table vertical)) row)]
    (ui/rect (- (load (field raw x)) (load (field table horizontal-offset)))
             (load (field raw y))
             (if (> (load (field table total-width)) (load (field raw w)))
                 (load (field table total-width))
                 (load (field raw w)))
             (load (field raw h)))))

(defn data-table-cell-rect [(table DataTable) (row i64) (column i64)] (-> ui/Rect)
  (let [header (data-table-header-rect table column)
        row-rect (data-table-row-rect table row)]
    (ui/rect (load (field header x)) (load (field row-rect y))
             (load (field header w)) (load (field row-rect h)))))

(defn data-table-total-width [(table DataTable)] (-> f32)
  (load (field table total-width)))

(defn data-table-scroll-vertical! [(table (mut DataTable)) (delta f32)] (-> f32)
  (scroll/scroll-by! (mut (.vertical table)) delta))

(defn data-table-column-at [(table DataTable) (x f32)] (-> i64)
  (block :found
    (for [column 0 (al/al-len [TableColumn] (load (field table columns)))]
      (let [bounds (data-table-header-rect table column)]
        (when (and (>= x (load (field bounds x)))
                   (< x (+ (load (field bounds x)) (load (field bounds w)))))
          (return-from :found column))))
    -1))

(defn data-table-resize-column-at [(table DataTable) (x f32)] (-> i64)
  (block :found
    (for [column 0 (al/al-len [TableColumn] (load (field table columns)))]
      (let [bounds (data-table-header-rect table column)
            edge (+ (load (field bounds x)) (load (field bounds w)))]
        (when (and (>= x (- edge 5.0)) (<= x (+ edge 5.0)))
          (return-from :found column))))
    -1))

(defn data-table-pointer-down! [(table (mut DataTable)) (x f32) (y f32)] (-> TableAction)
  (let [bounds (load (field table bounds))]
    (if (not (ui/contains? bounds x y))
        (no-table-action)
        (if (< y (+ (load (field bounds y)) (load (field table header-height))))
            (let [resize (data-table-resize-column-at (load table) x)]
              (if (>= resize 0)
                  (let [column (al/al-get [TableColumn] (load (field table columns)) resize)]
                    (do
                      (set! (.resizing-column table) resize)
                      (set! (.resize-anchor-x table) x)
                      (set! (.resize-anchor-width table) (load (field column width)))
                      (TableAction :kind table-action-resize :index resize :direction 0)))
                  (let [column-index (data-table-column-at (load table) x)]
                    (if (< column-index 0)
                        (no-table-action)
                        (let [column (al/al-get [TableColumn]
                                              (load (field table columns)) column-index)]
                          (if (not (load (field column sortable)))
                              (no-table-action)
                              (let [direction
                                      (primitive/cast i32
                                        (if (= (load (field table sort-column)) column-index)
                                            (if (= (load (field table sort-direction)) 1) -1 1)
                                            1))]
                                (do
                                  (set! (.sort-column table) column-index)
                                  (set! (.sort-direction table) direction)
                                  (TableAction :kind table-action-sort
                                               :index column-index :direction direction)))))))))
            (let [viewport (load (field table row-viewport))
                  content-y (+ (- y (load (field viewport y)))
                               (load (field (field table vertical) offset)))
                  row (primitive/cast i64 (/ content-y (load (field table row-height))))]
              (if (or (< row 0) (>= row (load (field table row-count))))
                  (no-table-action)
                  (do
                    (set! (.selected-row table) row)
                    (TableAction :kind table-action-select :index row :direction 0))))))))

(defn data-table-pointer-move! [(table (mut DataTable)) (x f32)] (-> TableAction)
  (let [column-index (load (field table resizing-column))]
    (if (< column-index 0)
        (no-table-action)
        (let [(mut column) (al/al-get [TableColumn] (load (field table columns)) column-index)
              old-width (load (field column width))
              width (clamp-f32 (+ (load (field table resize-anchor-width))
                                  (- x (load (field table resize-anchor-x))))
                               (load (field column min-width))
                               (load (field column max-width)))]
          (do
            (set! (.width column) width)
            (al/al-set! [TableColumn] (mut (.columns table)) column-index column)
            (set! (.total-width table) (+ (load (field table total-width)) (- width old-width)))
            (data-table-scroll-horizontal! (mut table) 0.0)
            (TableAction :kind table-action-resize :index column-index :direction 0))))))

(defn data-table-pointer-up! [(table (mut DataTable))] (-> i64)
  (let [prior (load (field table resizing-column))]
    (do (set! (.resizing-column table) -1) prior)))

(defn data-table-ensure-selection-visible! [(table (mut DataTable))] (-> f32)
  (let [row (load (field table selected-row))]
    (if (< row 0)
        (load (field (field table vertical) offset))
        (let [top (* (primitive/cast f32 row) (load (field table row-height)))
              bottom (+ top (load (field table row-height)))
              offset (load (field (field table vertical) offset))
              viewport-height (load (field (field table row-viewport) h))]
          (cond (< top offset) (scroll/scroll-to! (mut (.vertical table)) top)
                (> bottom (+ offset viewport-height))
                  (scroll/scroll-to! (mut (.vertical table)) (- bottom viewport-height))
                :else offset)))))

(defn data-table-select-by! [(table (mut DataTable)) (delta i64)] (-> i64)
  (let [count (load (field table row-count))
        current (load (field table selected-row))
        next (if (< current 0) (if (>= delta 0) 0 (- count 1)) (+ current delta))
        clamped (cond (= count 0) -1 (< next 0) 0 (>= next count) (- count 1) :else next)]
    (do
      (set! (.selected-row table) clamped)
      (data-table-ensure-selection-visible! (mut table))
      clamped)))

(defn data-table-select-home! [(table (mut DataTable))] (-> i64)
  (do
    (set! (.selected-row table) (if (> (load (field table row-count)) 0) 0 -1))
    (data-table-ensure-selection-visible! (mut table))
    (load (field table selected-row))))

(defn data-table-select-end! [(table (mut DataTable))] (-> i64)
  (do
    (set! (.selected-row table)
          (if (> (load (field table row-count)) 0) (- (load (field table row-count)) 1) -1))
    (data-table-ensure-selection-visible! (mut table))
    (load (field table selected-row))))

;;; Paint table chrome and bounded visible rows. Callers paint cell content into
;;; `data-table-cell-rect`; the component owns virtualization, selection, grid,
;;; scrolling, sorting/resizing hit targets, and stable row/header IDs.
(defn data-table-paint! [(scene (mut ui/Scene)) (table DataTable) (base-id i32)] (-> i64)
  (let [bounds (load (field table bounds))
        row-viewport (load (field table row-viewport))
        first (data-table-visible-first table)
        last (data-table-visible-last table)
        column-count (al/al-len [TableColumn] (load (field table columns)))
        prior (ui/scene-push-clip! (mut scene) bounds)]
    (do
      (ui/scene-rounded-rect! (mut scene) bounds (ui/rgba 0.045 0.055 0.085 1.0)
                              7.0 1.0 (ui/rgba 0.30 0.36 0.52 0.85) base-id)
      (ui/scene-rect! (mut scene)
                      (ui/rect (load (field bounds x)) (load (field bounds y))
                               (load (field bounds w)) (load (field table header-height)))
                      (ui/rgba 0.10 0.13 0.20 1.0) (+ base-id 1))
      (for [column 0 column-count]
        (let [header (data-table-header-rect table column)
              visible (ui/intersect header bounds)]
          (when (> (load (field visible w)) 0.0)
            (do
              (ui/scene-hitbox! (mut scene) visible
                                (+ base-id (primitive/cast i32 (+ column 10)))
                                -1 true false)
              (ui/scene-rect! (mut scene)
                              (ui/rect (- (+ (load (field header x)) (load (field header w))) 1.0)
                                       (load (field header y)) 1.0 (load (field header h)))
                              (ui/rgba 0.35 0.42 0.58 0.55) (+ base-id 2))))))
      (let [body-prior (ui/scene-push-clip! (mut scene) row-viewport)]
        (do
          (for [row first last]
            (let [row-bounds (data-table-row-rect table row)
                  selected (= row (load (field table selected-row)))]
              (do
                (ui/scene-rect! (mut scene) row-bounds
                                (if selected
                                    (ui/rgba 0.14 0.42 0.75 0.72)
                                    (if (= (% row 2) 0)
                                        (ui/rgba 0.07 0.085 0.125 1.0)
                                        (ui/rgba 0.055 0.068 0.105 1.0)))
                                (+ base-id 3))
                (ui/scene-hitbox! (mut scene) (ui/intersect row-bounds row-viewport)
                                  (+ base-id (primitive/cast i32 (+ row 1000)))
                                  -1 true false)
                (ui/scene-rect! (mut scene)
                                (ui/rect (load (field row-bounds x))
                                         (- (+ (load (field row-bounds y))
                                               (load (field row-bounds h))) 1.0)
                                         (load (field row-bounds w)) 1.0)
                                (ui/rgba 0.24 0.29 0.40 0.45) (+ base-id 4)))))
          (for [column 0 column-count]
            (let [header (data-table-header-rect table column)
                  edge (- (+ (load (field header x)) (load (field header w))) 1.0)]
              (ui/scene-rect! (mut scene)
                              (ui/rect edge (load (field row-viewport y)) 1.0
                                       (load (field row-viewport h)))
                              (ui/rgba 0.22 0.27 0.38 0.42) (+ base-id 5))))
          (ui/scene-pop-clip! (mut scene) body-prior)))
      (scroll/scrollbar! (mut scene) (load (field table vertical)) (+ base-id 6))
      (when (> (load (field table total-width)) (load (field bounds w)))
        (let [track-width (- (load (field bounds w)) 8.0)
              thumb-width (* track-width (/ (load (field bounds w))
                                             (load (field table total-width))))
              maximum (data-table-max-horizontal-offset table)
              fraction (if (> maximum 0.0)
                           (/ (load (field table horizontal-offset)) maximum) 0.0)
              x (+ (+ (load (field bounds x)) 4.0)
                   (* (- track-width thumb-width) fraction))]
          (ui/scene-rounded-rect! (mut scene)
                                  (ui/rect x (- (+ (load (field bounds y))
                                                   (load (field bounds h))) 5.0)
                                           thumb-width 3.0)
                                  (ui/rgba 0.62 0.72 0.96 0.72) 1.5 0.0
                                  (ui/rgba 0.0 0.0 0.0 0.0) (+ base-id 7))))
      (ui/scene-pop-clip! (mut scene) prior)
      (- last first))))
