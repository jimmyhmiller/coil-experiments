(module experiments.coop.scheduler)
(import "coil.primitive" :as primitive)

(defstruct Scheduler
  [(head (ptr Task))
   (tail (ptr Task))
   (live i64)
   (steps i64)])

(defstruct Task
  [(scheduler (ptr Scheduler))
   (step (fnptr c [(ptr Task)] i64))
   (context (ptr i8))
   (next (ptr Task))
   (wait-next (ptr Task))
   (state i64)
   (queued bool)
   (runnable bool)
   (done bool)])

(defstruct WaitQueue [(head (ptr Task)) (tail (ptr Task))])

(defn null-task [] (-> (ptr Task)) (primitive/cast (ptr Task) 0))
(defn task-null? [(task (ptr Task))] (-> bool)
  (= (primitive/cast i64 task) 0))

(defn scheduler-init! [(scheduler (ptr Scheduler))] (-> i64)
  (set! (.head scheduler) (null-task))
  (set! (.tail scheduler) (null-task))
  (set! (.live scheduler) 0)
  (set! (.steps scheduler) 0)
  0)

(defn wait-queue-init! [(queue (ptr WaitQueue))] (-> i64)
  (set! (.head queue) (null-task))
  (set! (.tail queue) (null-task))
  0)

(defn scheduler-enqueue! [(task (ptr Task))] (-> i64)
  (if (or (.queued task) (.done task))
      0
      (let [scheduler (.scheduler task)]
        (set! (.next task) (null-task))
        (if (task-null? (.tail scheduler))
            (set! (.head scheduler) task)
            (let [tail (.tail scheduler)]
              (set! (.next tail) task)))
        (set! (.tail scheduler) task)
        (set! (.queued task) true)
        0)))

(defn task-init! [(task (ptr Task))
                  (scheduler (ptr Scheduler))
                  (step (fnptr c [(ptr Task)] i64))
                  (context (ptr i8))] (-> i64)
  (set! (.scheduler task) scheduler)
  (set! (.step task) step)
  (set! (.context task) context)
  (set! (.next task) (null-task))
  (set! (.wait-next task) (null-task))
  (set! (.state task) 0)
  (set! (.queued task) false)
  (set! (.runnable task) true)
  (set! (.done task) false)
  (set! (.live scheduler) (+ (.live scheduler) 1))
  (scheduler-enqueue! task))

(defn task-park! [(queue (ptr WaitQueue)) (task (ptr Task))] (-> i64)
  (if (not (.runnable task))
      0
      (do
        (set! (.runnable task) false)
        (set! (.wait-next task) (null-task))
        (if (task-null? (.tail queue))
            (set! (.head queue) task)
            (let [tail (.tail queue)]
              (set! (.wait-next tail) task)))
        (set! (.tail queue) task)
        0)))

(defn task-wake! [(task (ptr Task))] (-> i64)
  (if (.done task)
      0
      (do
        (set! (.runnable task) true)
        (scheduler-enqueue! task))))

(defn wait-queue-wake-one! [(queue (ptr WaitQueue))] (-> i64)
  (let [task (.head queue)]
    (if (task-null? task)
        0
        (do
          (set! (.head queue) (.wait-next task))
          (if (task-null? (.head queue)) (set! (.tail queue) (null-task)) 0)
          (set! (.wait-next task) (null-task))
          (task-wake! task)))))

(defn wait-queue-wake-all! [(queue (ptr WaitQueue))] (-> i64)
  (loop
    (if (task-null? (.head queue))
        (break)
        (wait-queue-wake-one! queue)))
  0)

(defn task-complete! [(task (ptr Task))] (-> i64)
  (if (.done task)
      0
      (do
        (set! (.done task) true)
        (set! (.runnable task) false)
        (let [scheduler (.scheduler task)]
          (set! (.live scheduler) (- (.live scheduler) 1)))
        0)))

;; Runs until every task completes or all live tasks are parked. Returns true on
;; completion and false on deadlock. A runnable task executes one state-machine
;; transition per turn, which supplies cooperative fairness.
(defn scheduler-run! [(scheduler (ptr Scheduler))] (-> bool)
  (block :finished
    (loop
      (let [task (.head scheduler)]
        (if (task-null? task)
            (return-from :finished (= (.live scheduler) 0))
            (do
              (set! (.head scheduler) (.next task))
              (if (task-null? (.head scheduler)) (set! (.tail scheduler) (null-task)) 0)
              (set! (.next task) (null-task))
              (set! (.queued task) false)
              (set! (.steps scheduler) (+ (.steps scheduler) 1))
              (primitive/call-ptr (.step task) task)
              (if (and (.runnable task) (not (.done task)))
                  (scheduler-enqueue! task)
                  0)))))))

(export Scheduler Task WaitQueue scheduler-init! wait-queue-init! task-init!
        task-park! task-wake! wait-queue-wake-one! wait-queue-wake-all!
        task-complete! scheduler-run!)
