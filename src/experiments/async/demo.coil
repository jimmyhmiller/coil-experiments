(module experiments.async.demo)
(import "coil.primitive" :as primitive)
(import "experiments.coop.scheduler" :as coop)
(import "experiments.async.lang" :use *)

(extern printf :cc c [(ptr i8) ...] (-> i32))
(extern malloc :cc c [i64] (-> (ptr i8)))
(extern free :cc c [(ptr i8)] (-> i64))

;; A logical delay takes one scheduler turn per tick.  It demonstrates overlap
;; deterministically and never sleeps or creates a native thread.
(defasync-i64 delayed-value [(encoded i64)] [(remaining i64)] [task async_machine]
  (if (= (.state task) 0)
      (do
        (set! (.remaining async_machine) (/ (.argument async_machine) 10000))
        (set! (.state task) 1))
      0)
  (if (> (.remaining async_machine) 0)
      (set! (.remaining async_machine) (- (.remaining async_machine) 1))
      (future-complete! (field async_machine future)
                        (% (.argument async_machine) 10000)))
  0)

;; Composition is itself a generated resumable machine.  Each incomplete await
;; records the continuation state and returns after parking.
(defasync-i64 invoice [(ignored i64)]
  [(price (ptr Future)) (stock (ptr Future)) (shipping (ptr Future))
   (saved-price i64)] [task async_machine]
  (if (= (.state task) 0)
      (do
        (set! (.price async_machine) (delayed-value (.scheduler task) 41207))
        (set! (.stock async_machine) (delayed-value (.scheduler task) 20043))
        (set! (.shipping async_machine) (delayed-value (.scheduler task) 31300))
        (set! (.state task) 1))
      0)
  (if (= (.state task) 1)
      (if (future-await! (.price async_machine) task 2) 0 (return-from :async-step 0))
      0)
  (if (= (.state task) 2)
      (do (set! (.saved-price async_machine) (future-result (.price async_machine)))
          (if (future-await! (.stock async_machine) task 3) 0 (return-from :async-step 0)))
      0)
  (if (= (.state task) 3)
      (if (future-await! (.shipping async_machine) task 4) 0 (return-from :async-step 0))
      0)
  (if (= (.state task) 4)
      (let [total (+ (.saved-price async_machine) (future-result (.shipping async_machine)))]
        (printf c"invoice total=%ld stock=%ld\n" total (future-result (.stock async_machine)))
        (future-destroy! (.price async_machine))
        (future-destroy! (.stock async_machine))
        (future-destroy! (.shipping async_machine))
        (future-complete! (field async_machine future) total))
      0)
  0)

(defn main [] (-> i64)
(let [scheduler (primitive/cast (ptr coop/Scheduler) (malloc (primitive/sizeof coop/Scheduler)))
        initialized (coop/scheduler-init! scheduler)
        result (invoice scheduler 0)
        completed (coop/scheduler-run! scheduler)
        total (future-result result)
        steps (.steps scheduler)]
    (printf c"scheduler steps=%ld (overlapped logical delays)\n" steps)
    (future-destroy! result)
    (free (primitive/cast (ptr i8) scheduler))
    ;; Serial execution needs 4+2+3 delay turns plus setup/completion overhead;
    ;; this assertion pins the round-robin interleaving trace as well as result.
    (if (and completed (and (= total 2507) (= steps 14))) 0 1)))
