(module experiments.dependent.demo)

(import "experiments.dependent.lang" :use [dependent])
(import "coil.primitive" :as primitive)

(extern printf :cc c [(ptr i8) ...] (-> i32))

;; Existing ordinary Coil can be imported through a checked bridge. The emitted
;; wrapper call is subsequently verified again by Coil's own type checker.
(defn host-double [(n i64)] (-> i64) (* n 2))

;; A dependently typed program checked and normalized by the metaprogram.  The
;; first projection of a Sigma pair has type Nat; the second component's type is
;; allowed to mention that exact first component.
(dependent
  (claim id (Pi A Type (Pi x A A)))
  (define id (fn A Type (fn x A x)))

  (check (app (app id Nat) 7) Nat)
  (check Type (U 1))
  (check Nat Type)
  (check Nat (U 1))
  (check Type (U 2))

  ;; IPi arguments participate in checking and normalization but are erased
  ;; from the eventual runtime program.
  (claim erased-const (IPi A Type (Pi x A Nat)))
  (define erased-const (ifn A Type (fn x A 11)))
  (check (app (iapp erased-const Nat) 99) Nat)
  (check (auto-app erased-const 99) Nat)

  ;; `def` is the Idris-like elaborated surface: it expands to a claim plus a
  ;; checked lambda, with implicit binders becoming erased IPi/ifn pairs.
  (def surface-id [(implicit A Type) (x A)] A x)
  (check (auto-app surface-id 17) Nat)
  (emit-nat-fn specialized-dependent-id (iapp surface-id Nat))
  (def plus-three [(n Nat)] Nat (plus n 3))
  (emit-nat surface-answer (app plus-three 39))
  (foreign-nat-fn host-double-dep host-double)
  (def host-plus-one [(n Nat)] Nat (succ (app host-double-dep n)))
  (emit-nat-fn dependent-host-wrapper host-plus-one)
  (check (pair 3 refl) (Sigma n Nat (Eq Nat n 3)))
  (check (snd (ann (pair 3 refl) (Sigma n Nat (Eq Nat n 3))))
         (Eq Nat (fst (ann (pair 3 refl) (Sigma n Nat (Eq Nat n 3)))) 3))

  (claim add-two (Pi n Nat Nat))
  (define add-two (fn n Nat (plus n 2)))
  (emit-nat dependent-answer (app add-two 40))
  (emit-nat-fn dependent-add-two add-two)

  ;; Nat induction computes by its zero and successor cases. The motive is
  ;; genuinely dependent even though this example chooses the constant Nat
  ;; family.
  (emit-nat induction-answer
    (nat-elim (fn k Nat Nat)
              0
              (fn k Nat (fn ih Nat (succ ih)))
              6))
  (emit-nat match-answer
    (nat-match 4
      (fn n Nat Nat)
      10
      predecessor previous
      (succ previous)))
  (emit-nat boolean-answer
    (bool-elim (fn value Bool Nat) 23 99 true))
  (emit-nat decision-answer
    (dec-elim (Eq Nat 5 5)
      (fn decision (Dec (Eq Nat 5 5)) Nat)
      (fn proof (Eq Nat 5 5) 1)
      (fn refute (Not (Eq Nat 5 5)) 0)
      (yes (Eq Nat 5 5) refl)))

  ;; Equality elimination (J) is the primitive behind transport/substitution.
  (check
    (J Nat 4
       (fn y Nat (fn p (Eq Nat 4 y) (Eq Nat 4 y)))
       refl
       4
       refl)
    (Eq Nat 4 4))
  (check
    (transport Nat 3 3
      (fn n Nat (Vec Nat n))
      refl
      (vcons Nat 2 1 (vcons Nat 1 2 (vcons Nat 0 3 (vnil Nat)))))
    (Vec Nat 3))
  (check
    (record 3 refl)
    (Record [(length Nat) (length-is-three (Eq Nat length 3))]))

  ;; User-defined algebraic data and exhaustive dependent case analysis.
  (data Choice
    [(Left [(value Nat)])
     (Right [(value Nat)])])
  (check (ctor Left 4) Choice)
  (emit-nat algebraic-answer
    (dcase (ctor Right 9)
      (fn choice Choice Nat)
      [(Left [value] (plus value 1))
       (Right [value] value)]))
  (data NatList
    [(Nil [])
     (Cons [(head Nat) (tail NatList)])])
  (def list-length [(xs NatList)] Nat
    (dcase xs
      (fn list NatList Nat)
      [(Nil [] 0)
       (Cons [head tail] (succ (app list-length tail)))]))
  (emit-nat recursive-data-answer
    (app list-length
      (ctor Cons 4 (ctor Cons 5 (ctor Nil)))))
  (data Maybe [(A Type)]
    [(Nothing [])
     (Just [(value A)])])
  (check (ctor Just Nat 12) (app Maybe Nat))
  (emit-nat parameterized-data-answer
    (dcase (ctor Just Nat 12)
      (fn option (app Maybe Nat) Nat)
      [(Nothing [] 0)
       (Just [value] value)]))
  (data List [(A Type)]
    [(ListNil [])
     (ListCons [(head A) (tail (app List A))])])
  (def generic-length [(implicit A Type) (xs (app List A))] Nat
    (dcase xs
      (fn list (app List A) Nat)
      [(ListNil [] 0)
       (ListCons [head tail]
         (succ (app (iapp generic-length A) tail)))]))
  (emit-nat generic-data-answer
    (app (iapp generic-length Nat)
      (ctor ListCons Nat 1
        (ctor ListCons Nat 2
          (ctor ListCons Nat 3 (ctor ListNil Nat))))))

  ;; An actual inductive family: the result index of vcons is one larger than
  ;; its tail, and the eliminator refines both length and vector in each branch.
  (check (vcons Nat 1 9 (vcons Nat 0 8 (vnil Nat))) (Vec Nat 2))
  (check (fzero 0) (Fin 1))
  (check (fsucc 1 (fzero 0)) (Fin 2))
  (emit-nat safe-index-answer
    (vget Nat 2
      (vcons Nat 1 9 (vcons Nat 0 8 (vnil Nat)))
      (fsucc 1 (fzero 0))))
  (emit-nat vector-match-answer
    (vec-match Nat 2
      (vcons Nat 1 9 (vcons Nat 0 8 (vnil Nat)))
      (fn k Nat (fn xs (Vec Nat k) Nat))
      0
      k head tail recursive
      (plus head recursive)))
  (emit-nat-vector native-dependent-vector
    (vcons Nat 1 9 (vcons Nat 0 8 (vnil Nat))))
  (def inferred-vector-length
    [(implicit A Type) (implicit n Nat) (xs (Vec A n))]
    Nat
    n)
  (emit-nat multi-implicit-answer
    (auto-app inferred-vector-length
      (vcons Nat 1 9 (vcons Nat 0 8 (vnil Nat)))))
  (emit-nat vector-length-by-induction
    (vec-elim Nat
      (fn k Nat (fn xs (Vec Nat k) Nat))
      0
      (fn k Nat
        (fn x Nat
          (fn tail (Vec Nat k)
            (fn ih Nat (succ ih)))))
      2
      (vcons Nat 1 9 (vcons Nat 0 8 (vnil Nat)))))

  ;; A first-class Sigma value crosses the boundary into ordinary Coil with a
  ;; stable erased representation after the dependency has been checked.
  (emit-nat-pair runtime-dependent-pair
    (pair 3 99)
    (Sigma n Nat Nat))
  (def runtime-sigma [(n Nat)] (Sigma index Nat Nat)
    (pair (succ n) n))
  (emit-nat-pair-fn make-runtime-sigma runtime-sigma)

  ;; W is the general strictly-positive inductive family kernel. This leaf has
  ;; no children because its branching family is constantly Empty.
  (check
    (sup Nat
         (fn tag Nat Empty)
         0
         (fn impossible Empty
           (empty-elim (W Nat (fn tag Nat Empty)) impossible)))
    (W Nat (fn tag Nat Empty)))
  (emit-nat w-elimination-answer
    (w-elim Nat
      (fn tag Nat Empty)
      (fn tree (W Nat (fn tag Nat Empty)) Nat)
      (fn shape Nat
        (fn children (Pi position Empty (W Nat (fn tag Nat Empty)))
          (fn ih (Pi position Empty Nat) 7)))
      (sup Nat
           (fn tag Nat Empty)
           0
           (fn impossible Empty
             (empty-elim (W Nat (fn tag Nat Empty)) impossible))))))

(defn main [] (-> i64)
  (let [dynamic-pair (make-runtime-sigma 5)
        pair runtime-dependent-pair
        native-vector native-dependent-vector]
  (printf c"dependent answer=%ld surface=%ld erased=%ld induction=%ld match=%ld bool=%ld dec=%ld data=%ld recursive=%ld param=%ld generic=%ld vector=%ld inferred=%ld get=%ld sum=%ld w=%ld runtime-call=%ld host=%ld sigma=%ld/%ld\n"
            dependent-answer surface-answer (specialized-dependent-id 18)
            induction-answer match-answer boolean-answer decision-answer algebraic-answer recursive-data-answer
            parameterized-data-answer generic-data-answer
            vector-length-by-induction multi-implicit-answer
            safe-index-answer vector-match-answer w-elimination-answer
            (dependent-add-two 40) (dependent-host-wrapper 20)
            (.index dynamic-pair) (.value dynamic-pair))
    (if (and (= dependent-answer 42)
             (and (= surface-answer 42)
                  (and (= (specialized-dependent-id 18) 18)
                   (and (= induction-answer 6)
                       (and (= match-answer 14)
                            (and (= boolean-answer 23)
                             (and (= decision-answer 1)
                              (and (= algebraic-answer 9)
                               (and (= recursive-data-answer 2)
                                (and (= parameterized-data-answer 12)
                                 (and (= generic-data-answer 3)
                                  (and (= vector-length-by-induction 2)
                                  (and (= multi-implicit-answer 2)
                                   (and (= safe-index-answer 8)
                                  (and (= vector-match-answer 17)
                                   (and (= w-elimination-answer 7)
                                      (and (= (dependent-host-wrapper 20) 41)
                                           (and (= (.index dynamic-pair) 6)
                                                (and (= (.value dynamic-pair) 5)
                                                     (and (= (dependent-add-two 40) 42)
                                                          (and (= (.index pair) 3)
                                                               (and (= (.value pair) 99)
                                                                    (= (load (primitive/index native-vector 1)) 8)))))))))))))))))))))))
        0
        1)))
