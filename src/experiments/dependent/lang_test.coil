(module experiments.dependent.lang-test)

(import "experiments.dependent.lang" :use [dependent])
(import "coil.assert" :use *)

(dependent
  (claim test-id (Pi A Type (Pi x A A)))
  (define test-id (fn A Type (fn x A x)))
  (check (app (app test-id Nat) 12) Nat)
  (claim implicit-id (IPi A Type (Pi x A A)))
  (define implicit-id (ifn A Type (fn x A x)))
  (check (auto-app implicit-id 12) Nat)
  (claim vector-element-type (IPi A Type (Pi xs (Vec A 1) Nat)))
  (define vector-element-type (ifn A Type (fn xs (Vec A 1) 1)))
  (check (auto-app vector-element-type (vcons Nat 0 9 (vnil Nat))) Nat)
  (check (pair 2 refl) (Sigma n Nat (Eq Nat n 2)))
  (check (vcons Nat 0 5 (vnil Nat)) (Vec Nat 1))
  (emit-nat test-beta (app (app test-id Nat) 12))
  (emit-nat test-induction
    (nat-elim (fn n Nat Nat)
              0
              (fn n Nat (fn ih Nat (succ ih)))
              5)))

(deftest dependent-beta-normalization
  (assert-eq test-beta 12))

(deftest dependent-nat-induction
  (assert-eq test-induction 5))
