(module experiments.borrow-checker.borrow-checker)

;; Importing this module opts a compilation unit into the borrow-checked
;; ownership vocabulary. Coil's typed affine pass remains authoritative: it
;; runs after this ownership-phase metaprogram, sees stable binding identities
;; and monomorphic types, rejects invalid moves, and inserts Drop glue.

(import "coil.primitive" :as primitive)
(import "experiments.borrow-checker.runtime" :use * :reexport)

(defn borrow-checker-user-module? [(m Code)] (-> bool)
  (and (primitive/code-list? m)
       (> (primitive/code-count m) 1)
       (primitive/code-from-user? (primitive/code-nth m 1))))

(defn borrow-checker-validate-modules [(modules Code)] (-> Code)
  ;; This deliberately preserves the checked typed tree. Destruction and move
  ;; elaboration belong to Coil's typed ownership pass, not a surface rewrite.
  ;; Keeping a registered ownership-phase transform makes activation explicit
  ;; and gives this dialect a stable place for future policy checks.
  `(do ~@modules))

(transform borrow-checker-validate-modules :phase ownership)
