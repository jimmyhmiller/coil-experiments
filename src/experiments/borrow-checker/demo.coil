(module experiments.borrow-checker.demo)

(import "experiments.borrow-checker.borrow-checker" :use *)

(defstruct Task [(id i64) (points i64)])
(defstruct Project [(tasks (Vec (Box Task)))])

(defn make-project [] (-> (Box Project))
  (let [(mut tasks) (vec-new [(Box Task)])]
    (vec-push! (mut tasks) (box-new (Task :id 1 :points 10)))
    (vec-push! (mut tasks) (box-new (Task :id 2 :points 14)))
    (vec-push! (mut tasks) (box-new (Task :id 3 :points 18)))
    (box-new (Project :tasks tasks))))

(defn project-points [(project (ref (Box Project)))] (-> i64)
  (with-box-ref [data project]
    (let [(mut i) 0 (mut total) 0]
      (loop (if (>= (load i) (vec-len [(Box Task)] (.tasks data)))
                (break)
                (do
                  (with-vec-ref [task (.tasks data)] (load i)
                    (with-box-ref [fields Task task]
                      (set! total (+ (load total) (.points fields)))))
                  (set! i (+ (load i) 1)))))
      (load total))))

(defn run-project [] (-> i64)
  (let [project (make-project)]
    (project-points project)))

(defn main [] (-> i64)
  (let [total (run-project)]
    (println "total: {d}" total)
    (if (and (= total 42) (= (box-live-count) 0)) 0 1)))
