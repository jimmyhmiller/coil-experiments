(module experiments.borrow-checker.borrow-checker-test)

(import "coil.assert" :use *)
(import "coil.primitive" :as primitive)
(import "coil.result" :use *)
(import "experiments.borrow-checker.borrow-checker" :use *)

(defstruct Record [(id i64) (score i64)])
(defstruct Envelope
  [(primary (Box Record))
   (history (Vec (Box Record)))])
(defstruct ScoreClosureEnv [(record (Box Record)) (bonus i64)])

(defn score-closure-code [(environment (ptr ScoreClosureEnv))] (-> i64)
  (with-box-ref [record Record (.record environment)]
    (+ (.score record) (.bonus environment))))

(defn make-record [(id i64) (score i64)] (-> (Box Record))
  (box-new (Record :id id :score score)))

(defn add-score! [(record (mut (Box Record))) (delta i64)] (-> i64)
  (with-box-mut [item record]
    (set! (.score item) (+ (.score item) delta))
    (.score item)))

(deftest owned-box-borrows-and-moves
  (let [(mut record) (make-record 7 30)]
    (assert-eq (add-score! (mut record) 12) 42)
    (let [moved record]
      (with-box-ref [item moved]
        (assert-eq (.id item) 7)
        (assert-eq (.score item) 42)))))

(deftest owned-vector-manages-nested-boxes
  (do
    (let [(mut records) (vec-new [(Box Record)])]
      (vec-push! (mut records) (make-record 1 10))
      (vec-push! (mut records) (make-record 2 20))
      (vec-push! (mut records) (make-record 3 30))
      (assert-eq (vec-len [(Box Record)] records) 3)
      (with-vec-mut [second records] 1
        (with-box-mut [item Record second]
          (set! (.score item) 42)))
      (match (vec-pop! (mut records))
        (Some [last]
          (with-box-ref [item last]
            (assert-eq (.score item) 30)))
        (None [] (assert false))))
    (assert-eq (box-live-count) 0)))

(defn branch-and-loop-workload [(limit i64)] (-> i64)
  (let [(mut records) (vec-new [(Box Record)])
        (mut i) 0
        (mut total) 0]
    (loop (if (>= (load i) limit)
              (break)
              (do
                (vec-push! (mut records) (make-record (load i) (* (load i) 2)))
                (set! i (+ (load i) 1)))))
    (set! i 0)
    (loop (if (>= (load i) (vec-len [(Box Record)] records))
              (break)
              (with-vec-ref [record records] (load i)
                (with-box-ref [item Record record]
                  (set! total (+ (load total) (.score item))))
                (set! i (+ (load i) 1)))))
    (if (> (load total) 0) (load total) 0)))

(deftest sophisticated-control-flow-cleans-up
  (do
    (assert-eq (branch-and-loop-workload 7) 42)
    (assert-eq (box-live-count) 0)))

(deftest nested-user-aggregates-drop-recursively
  (do
    (let [(mut history) (vec-new [(Box Record)])]
      (vec-push! (mut history) (make-record 10 20))
      (vec-push! (mut history) (make-record 11 22))
      (let [envelope (box-new
                       (Envelope :primary (make-record 7 42)
                                 :history history))]
        (with-box-ref [outer envelope]
          (with-box-ref [primary Record (.primary outer)]
            (assert-eq (.score primary) 42)))))
    (assert-eq (box-live-count) 0)))

(deftest multiple-shared-borrows-are-valid
  (let [record (make-record 7 42)]
    (with-box-ref [first record]
      (with-box-ref [second record]
        (assert-eq (+ (.id first) (.score second)) 49)))))

(defn early-exit-workload [] (-> i64)
  (block :done
    (let [temporary (make-record 7 42)]
      (with-box-ref [view temporary]
        (if (= (.score view) 42)
            (break :done 42)
            0)))
    0))

(deftest early-exit-drops-live-owner
  (do
    (assert-eq (early-exit-workload) 42)
    (assert-eq (box-live-count) 0)))

(deftest fixed-arrays-drop-owned-elements
  (do
    (let [records [(make-record 1 10)
                   (make-record 2 20)
                   (make-record 3 12)]]
      0)
    (assert-eq (box-live-count) 0)))

(deftest options-drop-owned-elements
  (do
    (match (Some (make-record 4 42))
      (Some [record] (with-box-ref [view record] (assert-eq (.score view) 42)))
      (None [] (assert false)))
    (assert-eq (box-live-count) 0)))

(deftest first-class-closure-owns-and-drops-captures
  (do
    (let [closure (owned-closure0
                    [ScoreClosureEnv i64]
                    score-closure-code
                    (ScoreClosureEnv :record (make-record 7 40) :bonus 2))]
      (assert-eq (closure0-call [ScoreClosureEnv i64] closure) 42))
    (assert-eq (box-live-count) 0)))
