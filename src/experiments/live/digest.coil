(module experiments.live.digest)

;;; FNV-1a (64-bit) of a byte string. The live host and the `coil check` verdict
;;; checker both compute it over an entry file's bytes, so a verdict names the
;;; exact version of the file it describes.

(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.slice" :use [slice-len slice-get])
(import "coil.str" :as str)

(defn digest [(bytes (slice u8))] (-> i64)
  ; 0xcbf29ce484222325 and 0x100000001b3, the FNV-1a 64 offset basis and prime;
  ; the multiply wraps modulo 2^64 by design.
  (let [(mut h) -3750763034362895579]
    (for [i 0 (slice-len bytes)]
      (set! h (primitive/imul (primitive/ixor (load h)
                                              (primitive/cast i64 (slice-get bytes i)))
                              1099511628211)))
    (load h)))

;;; A digest as 16 lowercase hex digits.
(defn digest-hex [(a (dyn alloc/Allocator)) (h i64)] (-> (slice u8))
  (let [(mut sb) (str/sb-new a)]
    (for [k 0 16]
      (let [nib (primitive/iand (primitive/ishr h (* 4 (- 15 k))) 15)]
        (str/sb-push-byte! (mut sb)
                           (primitive/cast u8 (if (< nib 10) (+ nib 48) (+ nib 87))))
        0))
    (str/sb-finish! (mut sb))))
