(module experiments.live.host-test)

;; The live host's messages, against the controller's real diagnostics. Every
;; test runs in its own process, so each owns a fresh controller.
(import "coil.alloc" :as alloc)
(import "coil.assert" :use *)
(import "coil.str" :as str)
(import "experiments.heap-inspector.controller" :as controller)
(import "experiments.live.host" :as host)

(defn strict [(source (slice u8))] (-> i64)
  (controller/live-controller-submit! source controller/LIVE-POLICY-STRICT true false))

(defn has? [(text (slice u8)) (part (slice u8))] (-> bool)
  (match (str/str-find text part) (Some [_] true) (None [] false)))

(deftest a-missing-variant-is-named-as-the-file-names-it
  (assert-eq 0 (controller/live-controller-init!))
  (assert-eq 0
    (strict "(defsum Kind (Dot) (Ring))
             (defn kind-code [(k Kind)] (-> i64) (match k (Dot [] 0) (Ring [] 1)))"))
  (assert-eq 1
    (strict "(defsum Kind (Dot) (Ring) (Bar))
             (defn kind-code [(k Kind)] (-> i64) (match k (Dot [] 0) (Ring [] 1)))"))
  ; The controller's own words: in 'replsession.kind-code--live-impl--next--next':
  ; non-exhaustive match on 'replsession.Kind--live-payload--next':
  ; `replsession.Kind--live-payload-variant-Bar--next` not covered
  (let [clean (host/clean-diagnostic (alloc/malloc-allocator)
                                     (controller/live-controller-diagnostic))]
    (assert (has? clean "in 'kind-code': non-exhaustive match on 'Kind': `Bar` not covered"))
    (assert (not (has? clean "replsession")))
    (assert (not (has? clean "--live")))))
