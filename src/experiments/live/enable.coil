(module experiments.live.enable)

;;; Makes a program live from its Coil.toml alone:
;;;
;;;     [dependencies]
;;;     live = { path = ".../coil-experiments/src/experiments/live" }
;;;
;;;     [metaprograms]
;;;     use = ["experiments.live.enable"]
;;;
;;; The entry roots a project-wide source graph. The built binary is its host
;;; (experiments.live.host). It compiles the project with the in-process SDK,
;;; enters the application's main once on the native main thread, and watches
;;; the participating files. Each saved project snapshot checks and migrates as
;;; one transaction or leaves the accepted generation running.
;;;
;;; The build also typechecks an unstarted initial generation with that same
;;; live reader lowering. At runtime the host owns the retained generation;
;;; the checked copy does not initialize roots or enter the application's loop.
;;; The module's imports stay in the build.
;;;
;;; While the program runs, building or checking it reports what the running
;;; program did with the current project sources. Rejections and missing
;;; migrations are reported at the original file and form.
;;;
;;; This module only gathers the two halves. A metaprogram cannot load a module
;;; the program does not already import, so the host is imported here, where the
;;; manifest's `use` puts it in every build; the transform that starts it lives
;;; in experiments.live.enable-transform.
(import "experiments.live.host" :as host)
(import "experiments.live.enable-transform" :as enable-transform)
