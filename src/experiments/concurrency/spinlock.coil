(module experiments.concurrency.spinlock)
(import "coil.primitive" :as primitive)
(import "coil.atomic" :as atomic)

; A busy-wait mutual-exclusion lock built entirely from the standard library's
; sequential atomics. No pthread object, no allocation, no initialization
; failure mode: a Spinlock is a single machine word that starts unlocked.
;
; Spinlocks are the right tool when critical sections are a few instructions
; and threads do not hold locks across preemption points; anything longer wants
; coil.sync's Mutex so waiters can sleep.
(export Spinlock spinlock-init! spinlock-lock! spinlock-try-lock!
        spinlock-unlock! spinlock-locked?)

; 0 = unlocked, 1 = locked.
(defstruct Spinlock [(state i64)])

(defn spinlock-init! [(s (mut Spinlock))] (-> i64)
  (do
    (store! (.state s) 0)
    0))

;; Acquire, spinning with sched_yield backoff while the lock is held. Always
;; succeeds eventually; pair with exactly one unlock.
(defn spinlock-lock! [(s (mut Spinlock))] (-> i64)
  (block :acquired
    (let [(mut spins) 0]
      (loop
        (if (= (atomic/atomic-cas (.state s) 0 1) 0)
            (return-from :acquired 0)
            (do
              (set! spins (+ (load spins) 1))
              (when (> (load spins) 64)
                (sched_yield)
                (set! spins 0))))))))

(extern sched_yield :cc c [] (-> i32))

;; Try once. True means the caller holds the lock now; false means someone
;; else does and the caller should do something else instead of waiting.
(defn spinlock-try-lock! [(s (mut Spinlock))] (-> bool)
  (= (atomic/atomic-cas (.state s) 0 1) 0))

;; Release. Stores 0 with release semantics via seq_cst exchange, waking the
;; next spinner's CAS loop.
(defn spinlock-unlock! [(s (mut Spinlock))] (-> i64)
  (atomic/atomic-xchg (.state s) 0))

;; Snapshot check for assertions and tests: true when some thread claims to
;; hold the lock right now. Racy by nature outside a held lock.
(defn spinlock-locked? [(s (mut Spinlock))] (-> bool)
  (!= (atomic/atomic-load (.state s)) 0))
