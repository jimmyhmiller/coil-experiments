(module experiments.debug-allocator.runtime)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.slice" :use *)
(import "coil.result" :use *)
(import "experiments.heap-inspector.runtime" :as inspector)

(extern atexit :cc c [(fnptr c [] void)] (-> i32))
(extern printf :cc c [(ptr i8) ...] (-> i32))
(extern abort :cc c [] (-> void))

(defn report-at-exit [] (-> void)
  (let [snapshot (inspector/inspector-snapshot)]
    (printf c"COIL_DEBUG_ALLOCATOR_JSON=%.*s\n"
            (slice-len snapshot) (slice-data snapshot))))

(defn ensure-report [] (-> i64)
  (let [registered (primitive/alloc-static bool)]
    (inspector/lock!)
    (if (load registered)
        0
        (if (= (atexit (primitive/fnptr-of report-at-exit)) 0)
            (do (set! registered true) 0)
            (do (printf c"debug allocator: failed to register exit report\n")
                (abort)
                0)))
    (inspector/unlock!)
    0))

(defn raw-alloc [(a (dyn alloc/Allocator)) (request alloc/AllocRequest)
                 (file (slice u8)) (line i64) (column i64)] (-> (Option (ptr i8)))
  (ensure-report)
  (inspector/inspect-raw-alloc a request file line column))

(defn raw-resize [(a (dyn alloc/Allocator)) (memory (ptr i8))
                  (old alloc/AllocRequest) (new alloc/AllocRequest)] (-> bool)
  (inspector/inspect-raw-resize a memory old new))

(defn raw-remap [(a (dyn alloc/Allocator)) (memory (ptr i8))
                 (old alloc/AllocRequest) (new alloc/AllocRequest)] (-> (Option (ptr i8)))
  (inspector/inspect-raw-remap a memory old new))

(defn raw-free [(a (dyn alloc/Allocator)) (memory (ptr i8))
                (request alloc/AllocRequest)] (-> i64)
  (inspector/inspect-raw-free a memory request))

(defn mark-created-site [T] [(result (Option (ptr T)))
                             (file (slice u8)) (line i64) (column i64)] (-> (Option (ptr T)))
  (inspector/mark-created-site [T] result file line column))

(defn mark-slice-site [T] [(result (Option (slice T)))
                           (file (slice u8)) (line i64) (column i64)] (-> (Option (slice T)))
  (inspector/mark-slice-site [T] result file line column))
