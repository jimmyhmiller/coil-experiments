(module experiments.debug-allocator.smoke)
(import "coil.alloc" :as alloc)
(import "coil.result" :use *)

(defstruct Value [(number i64)])

(defn main [] (-> i64)
  (let [allocator (alloc/malloc-allocator)
        allocation (alloc/create [Value] allocator)]
    (match allocation
      (None [] 1)
      (Some [value] (do (alloc/destroy [Value] allocator value) 0)))))
