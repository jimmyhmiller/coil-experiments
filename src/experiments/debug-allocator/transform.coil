(module experiments.debug-allocator.transform)
(import "coil.primitive" :as primitive)
(import "coil.slice" :use *)
(import "experiments.debug-allocator.runtime" :as runtime)

(defn same? [(a (slice u8)) (b (slice u8))] (-> bool)
  (if (!= (slice-len a) (slice-len b))
      false
      (let [(mut i) 0 (mut equal) true]
        (loop (if (>= (load i) (slice-len a))
                  (break)
                  (do (if (!= (slice-get a (load i)) (slice-get b (load i)))
                          (set! equal false) 0)
                      (set! i (+ (load i) 1)))))
        (load equal))))

(defn operation? [(head Code) (name (slice u8))] (-> bool)
  (if (not (primitive/code-sym? head))
      false
      (let [spelling (primitive/code-str head)
            (mut start) 0]
        (for [i 0 (slice-len spelling)]
          (if (or (= (slice-get spelling i) (primitive/cast u8 #\/))
                  (= (slice-get spelling i) (primitive/cast u8 #\.)))
              (set! start (+ i 1)) 0))
        (if (not (same? (subslice spelling (load start) (slice-len spelling)) name))
            false
            (let [decl (primitive/code-decl head)]
              (and (primitive/code-list? decl)
                   (>= (primitive/code-count decl) 5)
                   (primitive/code-eq (primitive/code-nth decl 1) `coil.alloc)
                   (primitive/code-eq (primitive/code-nth decl 2) `fn)))))))

(defn marker? [(head Code)] (-> bool)
  (if (not (primitive/code-sym? head))
      false
      (let [spelling (primitive/code-str head)]
        (or (same? spelling "runtime/mark-created-site")
            (or (same? spelling "runtime/mark-slice-site")
                (or (same? spelling "experiments.debug-allocator.runtime.mark-created-site")
                    (same? spelling "experiments.debug-allocator.runtime.mark-slice-site")))))))

(defn candidate? [(form Code)] (-> bool)
  (if (not (primitive/code-list? form))
      false
      (if (= (primitive/code-count form) 0)
          false
          (let [head (primitive/code-nth form 0)]
            (or (operation? head "raw-alloc")
                (or (operation? head "raw-resize")
                    (or (operation? head "raw-remap")
                        (or (operation? head "raw-free")
                            (or (operation? head "create")
                                (operation? head "alloc"))))))))))

(defn contains-candidate? [(form Code)] (-> bool)
  (if (candidate? form)
      true
      (if (not (primitive/code-list? form))
          false
          (let [(mut found) false]
            (for [i 0 (primitive/code-count form)]
              (if (contains-candidate? (primitive/code-nth form i))
                  (set! found true) 0))
            (load found)))))

(defn rewrite [(form Code)] (-> Code)
  (if (not (or (primitive/code-list? form) (primitive/code-vector? form)))
      form
      (if (= (primitive/code-count form) 0)
          form
          (let [head (primitive/code-nth form 0)
                n (primitive/code-count form)
                file (primitive/code-file form)
                line (primitive/code-line form)
                column (primitive/code-col form)]
            (if (marker? head)
                form
            (cond
              (and (= n 3) (operation? head "raw-alloc"))
                `(runtime/raw-alloc ~(rewrite (primitive/code-nth form 1))
                                            ~(rewrite (primitive/code-nth form 2))
                                            ~file ~line ~column)
              (and (= n 5) (operation? head "raw-resize"))
                `(runtime/raw-resize ~(rewrite (primitive/code-nth form 1))
                                             ~(rewrite (primitive/code-nth form 2))
                                             ~(rewrite (primitive/code-nth form 3))
                                             ~(rewrite (primitive/code-nth form 4)))
              (and (= n 5) (operation? head "raw-remap"))
                `(runtime/raw-remap ~(rewrite (primitive/code-nth form 1))
                                            ~(rewrite (primitive/code-nth form 2))
                                            ~(rewrite (primitive/code-nth form 3))
                                            ~(rewrite (primitive/code-nth form 4)))
              (and (= n 4) (operation? head "raw-free"))
                `(runtime/raw-free ~(rewrite (primitive/code-nth form 1))
                                           ~(rewrite (primitive/code-nth form 2))
                                           ~(rewrite (primitive/code-nth form 3)))
              (and (= n 3) (operation? head "create"))
                (let [T (primitive/code-nth (primitive/code-nth form 1) 0)]
                  `(runtime/mark-created-site [~T] ~form ~file ~line ~column))
              (and (= n 4) (operation? head "alloc"))
                (let [T (primitive/code-nth (primitive/code-nth form 1) 0)]
                  `(runtime/mark-slice-site [~T] ~form ~file ~line ~column))
              :else
                (let [out (primitive/code-list-new)]
                  (for [i 0 n] (primitive/code-list-push! out (rewrite (primitive/code-nth form i))))
                  (let [done (primitive/code-list-done out)]
                    (if (primitive/code-vector? form) `[~@done] done)))))))))

(defn transform-module [(m Code)] (-> Code)
  (let [name (primitive/code-nth m 0)]
    (if (or (primitive/code-eq name `experiments.heap-inspector.runtime)
            (or (primitive/code-eq name `experiments.debug-allocator.runtime)
                (primitive/code-eq name `experiments.debug-allocator.transform)))
        m
        (let [out (primitive/code-list-new)]
          (primitive/code-list-push! out (primitive/code-nth m 0))
          (for [i 1 (primitive/code-count m)]
            (let [form (primitive/code-nth m i)]
              (primitive/code-list-push! out
                (if (contains-candidate? form) (rewrite form) form))))
          (primitive/code-list-done out)))))

(defn transform-modules [(mods Code)] (-> Code)
  (let [out (primitive/code-list-new)]
    (for [i 0 (primitive/code-count mods)]
      (primitive/code-list-push! out (transform-module (primitive/code-nth mods i))))
    `(do ~@(primitive/code-list-done out))))

(transform transform-modules)
