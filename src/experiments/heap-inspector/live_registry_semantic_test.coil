(module experiments.heap-inspector.live-registry-semantic-test)

(import "experiments.heap-inspector.live-registry" :as registry)

(transform-once registry/registry-semantic-test-transform)

(defn semantic-target [(value i64)] (-> i64) (+ value 1))

(defn semantic-caller [(value i64)] (-> i64)
  (semantic-target value))

(defn semantic-shadow [(semantic-target i64)] (-> i64)
  semantic-target)

(defn main [] (-> i64) (semantic-caller 1))
