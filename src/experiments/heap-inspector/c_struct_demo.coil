(module experiments.heap-inspector.c-struct-demo)
(import "coil.primitive" :use *)

(defstruct c_s_mobj_s :layout explicit :size 16 :align 8
  [(x i32 :at 0)
   (y i32 :at 4)
   (next (ptr c_s_mobj_s) :at 8)])

(defn c_type_hint [(name (slice u8)) (size i64) (align i64) (value (ptr i8))] (-> (ptr i8))
  value)

(extern malloc :cc c [u64] (-> (ptr i8)))
(extern free :cc c [(ptr i8)] (-> i64))

(defn main [] (-> i64)
  (let [raw (c_type_hint "mobj_s" 16 8 (malloc 16))
        value (cast (ptr c_s_mobj_s) raw)]
    (store! (field value x) 10)
    (store! (field value y) 20)
    (store! (field value next) (cast (ptr c_s_mobj_s) 0))
    (free raw)
    0))
