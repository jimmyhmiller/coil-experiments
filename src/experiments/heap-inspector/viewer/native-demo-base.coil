(defstruct Particle
  [(x i64) (y i64) (vx i64) (vy i64)])

(defstruct World
  [(p0 Particle) (p1 Particle) (p2 Particle) (p3 Particle)
   (p4 Particle) (p5 Particle) (p6 Particle) (p7 Particle)
   (p8 Particle) (p9 Particle) (p10 Particle) (p11 Particle)
   (p12 Particle) (p13 Particle) (p14 Particle) (p15 Particle)
   (p16 Particle) (p17 Particle)])

(letonce world
  (World
    :p0 (Particle :x 20 :y 20 :vx 2 :vy 2)
    :p1 (Particle :x 57 :y 73 :vx 3 :vy 3)
    :p2 (Particle :x 94 :y 126 :vx 4 :vy 4)
    :p3 (Particle :x 131 :y 179 :vx 5 :vy 5)
    :p4 (Particle :x 168 :y 232 :vx 6 :vy 6)
    :p5 (Particle :x 205 :y 285 :vx 2 :vy 7)
    :p6 (Particle :x 242 :y 338 :vx 3 :vy 8)
    :p7 (Particle :x 279 :y 31 :vx 4 :vy 2)
    :p8 (Particle :x 316 :y 84 :vx 5 :vy 3)
    :p9 (Particle :x 353 :y 137 :vx 6 :vy 4)
    :p10 (Particle :x 390 :y 190 :vx 2 :vy 5)
    :p11 (Particle :x 427 :y 243 :vx 3 :vy 6)
    :p12 (Particle :x 464 :y 296 :vx 4 :vy 7)
    :p13 (Particle :x 501 :y 349 :vx 5 :vy 8)
    :p14 (Particle :x 538 :y 42 :vx 6 :vy 2)
    :p15 (Particle :x 575 :y 95 :vx 2 :vy 3)
    :p16 (Particle :x 612 :y 148 :vx 3 :vy 4)
    :p17 (Particle :x 49 :y 201 :vx 4 :vy 5)))

(defn radius [(p Particle)] (-> i64) 14)
(defn tint [(p Particle)] (-> i64) 205)
(defn kind-code [(p Particle)] (-> i64) 0)

(defn advance [(p Particle)] (-> Particle)
  (let [(mut nx) (+ (.x p) (.vx p))
        (mut ny) (+ (.y p) (.vy p))
        (mut nvx) (.vx p)
        (mut nvy) (.vy p)]
    (when (< nx 14) (store! nx 14) (store! nvx (- 0 nvx)))
    (when (> nx 626) (store! nx 626) (store! nvx (- 0 nvx)))
    (when (< ny 14) (store! ny 14) (store! nvy (- 0 nvy)))
    (when (> ny 386) (store! ny 386) (store! nvy (- 0 nvy)))
    (Particle :x nx :y ny :vx nvx :vy nvy)))

(defn demo_tick [] (-> i64)
  (set! (.p0 world) (advance (.p0 world)))
  (set! (.p1 world) (advance (.p1 world)))
  (set! (.p2 world) (advance (.p2 world)))
  (set! (.p3 world) (advance (.p3 world)))
  (set! (.p4 world) (advance (.p4 world)))
  (set! (.p5 world) (advance (.p5 world)))
  (set! (.p6 world) (advance (.p6 world)))
  (set! (.p7 world) (advance (.p7 world)))
  (set! (.p8 world) (advance (.p8 world)))
  (set! (.p9 world) (advance (.p9 world)))
  (set! (.p10 world) (advance (.p10 world)))
  (set! (.p11 world) (advance (.p11 world)))
  (set! (.p12 world) (advance (.p12 world)))
  (set! (.p13 world) (advance (.p13 world)))
  (set! (.p14 world) (advance (.p14 world)))
  (set! (.p15 world) (advance (.p15 world)))
  (set! (.p16 world) (advance (.p16 world)))
  (set! (.p17 world) (advance (.p17 world)))
  0)

(defn particle-value [(p Particle) (field i64)] (-> i64)
  (cond
    (= field 0) (.x p)
    (= field 1) (.y p)
    (= field 2) (radius p)
    (= field 3) (tint p)
    :else (kind-code p)))

(defn demo_value [(index i64) (field i64)] (-> i64)
  (cond
    (= index 0) (particle-value (.p0 world) field)
    (= index 1) (particle-value (.p1 world) field)
    (= index 2) (particle-value (.p2 world) field)
    (= index 3) (particle-value (.p3 world) field)
    (= index 4) (particle-value (.p4 world) field)
    (= index 5) (particle-value (.p5 world) field)
    (= index 6) (particle-value (.p6 world) field)
    (= index 7) (particle-value (.p7 world) field)
    (= index 8) (particle-value (.p8 world) field)
    (= index 9) (particle-value (.p9 world) field)
    (= index 10) (particle-value (.p10 world) field)
    (= index 11) (particle-value (.p11 world) field)
    (= index 12) (particle-value (.p12 world) field)
    (= index 13) (particle-value (.p13 world) field)
    (= index 14) (particle-value (.p14 world) field)
    (= index 15) (particle-value (.p15 world) field)
    (= index 16) (particle-value (.p16 world) field)
    :else (particle-value (.p17 world) field)))
