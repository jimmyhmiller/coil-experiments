(module experiments.heap-inspector.live-publication-test)
(import "coil.primitive" :as primitive)
(import "coil.atomic" :as atomic)
(import "coil.thread" :as thread)
(import "experiments.heap-inspector.live" :as live)

(defn published [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defn publisher [(arg (ptr i8))] (-> (ptr i8))
  (assert-eq 0 (live/live-begin-affected-publication!))
  (atomic/atomic-store (published) 1)
  (live/live-end-affected-publication!)
  arg)

(deftest closed-caller-can-finish-a-nested-call-to-closed-callee
         (live/live-begin-staging-locked!)
         (assert-eq 0
                    (live/live-stage-affected! 600
                                               1
                                               (primitive/cast (ptr u8)
                                                               c"caller")
                                               6))
         (assert-eq 0
                    (live/live-stage-affected! 601
                                               1
                                               (primitive/cast (ptr u8)
                                                               c"callee")
                                               6))
         (assert-eq 0 (live/live-enter-source! 600))
         (let [worker (primitive/alloc-stack thread/Thread)]
           (assert-eq 0
                      (primitive/cast i64
                                      (thread/thread-spawn worker
                                                           (primitive/fnptr-of publisher)
                                                           (primitive/cast (ptr i8)
                                                                           0))))
           (loop (when (live/live-reload-requested?) (break)) 0)
           (assert-eq 0 (atomic/atomic-load (published)))
           (assert-eq 0 (live/live-enter-source! 601))
           (live/live-exit!)
           (assert-eq 0 (atomic/atomic-load (published)))
           (live/live-exit!)
           (thread/thread-join worker)
           (assert-eq 1 (atomic/atomic-load (published)))
           (assert-eq 0 (atomic/atomic-load (live/live-reader-count)))))
