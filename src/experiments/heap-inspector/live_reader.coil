(module experiments.heap-inspector.live-reader)

(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.slice" :use [slice-len subslice])
(import "experiments.heap-inspector.live-meta" :as meta)
(import "experiments.heap-inspector.live-registry" :as registry)
(import "experiments.heap-inspector.live-types" :use
  [LiveHandleOwner live-handle-owner-new])

(defn lr-head? [(form Code) (head Code)] (-> bool)
  (and (primitive/code-list? form)
       (and (> (primitive/code-count form) 0)
            (primitive/code-eq (primitive/code-nth form 0) head))))

(defn lr-name=? [(a Code) (b Code)] (-> bool)
  (meta/live-text=? (primitive/code-str a) (primitive/code-str b)))

(defn lr-find-struct [(forms Code) (name Code) (i i64)] (-> Code)
  (if (>= i (primitive/code-count forms))
      name
      (let [form (primitive/code-nth forms i)]
        (if (and (lr-head? form `defstruct)
                 (lr-name=? (primitive/code-nth form 1) name))
            form
            (lr-find-struct forms name (+ i 1))))))

(defn lr-find-sum [(forms Code) (name Code) (i i64)] (-> Code)
  (if (>= i (primitive/code-count forms))
      name
      (let [form (primitive/code-nth forms i)]
        (if (and (lr-head? form `defsum)
                 (lr-name=? (primitive/code-nth form 1) name))
            form
            (lr-find-sum forms name (+ i 1))))))

(defn lr-find-sum-for-variant [(forms Code) (variant-name Code)] (-> Code)
  (let [(mut found) `:missing]
    (for [i 0 (primitive/code-count forms)]
      (let [form (primitive/code-nth forms i)]
        (if (lr-head? form `defsum)
            (let [variants (meta/live-sum-variants form)]
              (for [j 0 (primitive/code-count variants)]
                (if (lr-name=?
                      (primitive/code-nth (primitive/code-nth variants j) 0)
                      variant-name)
                    (set! found form) 0))) 0)))
    (load found)))

(defn lr-find-variant [(sum-decl Code) (variant-name Code)] (-> Code)
  (let [variants (meta/live-sum-variants sum-decl) (mut found) `:missing]
    (for [i 0 (primitive/code-count variants)]
      (let [variant (primitive/code-nth variants i)]
        (if (lr-name=? (primitive/code-nth variant 0) variant-name)
            (set! found variant) 0)))
    (load found)))

(defn lr-old-name [(T Code)] (-> Code)
  (primitive/datum->syntax T
    (primitive/syntax->datum (primitive/code-symbol "__live_old_" T))))

(defn lr-push-list! [(out CodeBuilder) (forms Code)] (-> i64)
  (for [i 0 (primitive/code-count forms)]
    (primitive/code-list-push! out (primitive/code-nth forms i)))
  0)

(defn lr-field-keyword [(field Code)] (-> Code)
  (let [parsed (primitive/code-read
                 (primitive/code-str ":" (primitive/code-str field))
                 `(reader-config))]
    ; code-read returns a program-shaped `(do ...)`, even for one datum.
    (if (lr-head? parsed `do) (primitive/code-nth parsed 1) parsed)))

(defn lr-constructor-has-field? [(form Code) (field Code)] (-> bool)
  (let [keyword (lr-field-keyword field) (mut i) 1 (mut found) false]
    (loop (if (or (load found) (>= (load i) (primitive/code-count form)))
              (break)
              (if (primitive/code-eq (primitive/code-nth form (load i)) keyword)
                  (set! found true)
                  (set! i (+ (load i) 2)))))
    (load found)))

; Defaults are part of the live struct declaration, including ordinary
; constructors compiled after the edit. This keeps existing function bodies
; valid when a field is added with a default instead of forcing every
; constructor to be resubmitted in the same edit.
(defn lr-rewrite-default-constructors [(form Code) (forms Code)] (-> Code)
  (if (not (primitive/code-list? form))
      form
      (let [out (primitive/code-list-new)]
        (for [i 0 (primitive/code-count form)]
          (primitive/code-list-push! out
            (lr-rewrite-default-constructors (primitive/code-nth form i) forms)))
        (let [done (primitive/code-list-done out)]
          (if (primitive/code-vector? form)
              `[~@done]
              (if (and (> (primitive/code-count form) 0)
                       (primitive/code-sym? (primitive/code-nth form 0)))
                  (let [decl (lr-find-struct forms (primitive/code-nth form 0) 0)]
                    (if (not (lr-head? decl `defstruct))
                        done
                        (let [with-defaults (primitive/code-list-new)
                              fields (meta/live-struct-fields decl)]
                          (for [i 0 (primitive/code-count done)]
                            (primitive/code-list-push! with-defaults (primitive/code-nth done i)))
                          (for [i 0 (primitive/code-count fields)]
                            (let [field (primitive/code-nth fields i)]
                              (if (and (meta/live-raw-field-default? decl i)
                                       (not (lr-constructor-has-field? done
                                              (primitive/code-nth field 0))))
                                  (do
                                    (primitive/code-list-push! with-defaults
                                      (lr-field-keyword (primitive/code-nth field 0)))
                                    (primitive/code-list-push! with-defaults
                                      (lr-rewrite-default-constructors
                                        (meta/live-raw-field-default decl i) forms))
                                    0)
                                  0)))
                          (primitive/code-list-done with-defaults))))
                  done))))))

(defn lr-normalize-struct [(form Code)] (-> Code)
  (let [fields (primitive/code-nth form (- (primitive/code-count form) 1))
        clean (primitive/code-list-new)]
    (for [i 0 (primitive/code-count fields)]
      (let [field (primitive/code-nth fields i)]
        (primitive/code-list-push! clean
          `(~(primitive/code-nth field 0) ~(primitive/code-nth field 1)))))
    (if (= (primitive/code-count form) 3)
        `(defstruct ~(primitive/code-nth form 1) [~@(primitive/code-list-done clean)])
        `(defstruct ~(primitive/code-nth form 1) ~(primitive/code-nth form 2)
                    [~@(primitive/code-list-done clean)]))))

(defn lr-rename-struct [(form Code) (name Code)] (-> Code)
  (if (= (primitive/code-count form) 3)
      `(defstruct ~name ~(primitive/code-nth form 2))
      `(defstruct ~name ~(primitive/code-nth form 2) ~(primitive/code-nth form 3))))

(defn lr-rename-sum [(form Code) (name Code)] (-> Code)
  (let [out (primitive/code-list-new)]
    (primitive/code-list-push! out `defsum)
    (primitive/code-list-push! out name)
    (for [i 2 (primitive/code-count form)]
      (let [variant (primitive/code-nth form i)]
        (if (primitive/code-vector? variant)
            (primitive/code-list-push! out variant)
            (let [renamed (primitive/code-list-new)]
              (primitive/code-list-push! renamed
                (primitive/datum->syntax (primitive/code-nth variant 0)
                  (primitive/syntax->datum
                    (primitive/code-symbol name "--" (primitive/code-nth variant 0)))))
              (for [j 1 (primitive/code-count variant)]
                (primitive/code-list-push! renamed (primitive/code-nth variant j)))
              (primitive/code-list-push! out (primitive/code-list-done renamed))))))
    (primitive/code-list-done out)))

(defn lr-versioned-sum-decl [(form Code) (record Code)] (-> Code)
  (let [out (primitive/code-list-new)
        variants (meta/live-sum-variants form)]
    (primitive/code-list-push! out `defsum)
    (primitive/code-list-push! out
      (lr-artifact-symbol record `:versioned-payload))
    (if (and (> (primitive/code-count form) 2)
             (primitive/code-vector? (primitive/code-nth form 2)))
        (do (primitive/code-list-push! out (primitive/code-nth form 2)) 0) 0)
    (for [i 0 (primitive/code-count variants)]
      (let [variant (primitive/code-nth variants i)
            name (primitive/code-nth variant 0)
            renamed (primitive/code-list-new)]
        (primitive/code-list-push! renamed
          (lr-keyed-artifact-symbol record `:payload-variant name))
        (for [j 1 (primitive/code-count variant)]
          (primitive/code-list-push! renamed (primitive/code-nth variant j)))
        (primitive/code-list-push! out (primitive/code-list-done renamed))))
    (primitive/code-list-done out)))

(defn lr-old-variant-name [(T Code) (variant Code)] (-> Code)
  (primitive/datum->syntax variant
    (primitive/syntax->datum (primitive/code-symbol (lr-old-name T) "--" variant))))

(defn lr-rewrite-match-patterns [(body Code) (enum-T Code)] (-> Code)
  (if (not (primitive/code-list? body))
      body
      (if (and (> (primitive/code-count body) 0)
               (primitive/code-eq (primitive/code-nth body 0) `match))
          (let [out (primitive/code-list-new)]
            (primitive/code-list-push! out (primitive/code-nth body 0))
            (primitive/code-list-push! out
              (lr-rewrite-match-patterns (primitive/code-nth body 1) enum-T))
            (for [i 2 (primitive/code-count body)]
              (let [clause (primitive/code-nth body i)]
                (primitive/code-list-push! out
                  `(~(lr-old-variant-name enum-T (primitive/code-nth clause 0))
                    ~(primitive/code-nth clause 1)
                    ~(lr-rewrite-match-patterns (primitive/code-nth clause 2) enum-T)))))
            (primitive/code-list-done out))
          (let [out (primitive/code-list-new)]
            (for [i 0 (primitive/code-count body)]
              (primitive/code-list-push! out
                (lr-rewrite-match-patterns (primitive/code-nth body i) enum-T)))
            (let [done (primitive/code-list-done out)]
              (if (primitive/code-vector? body) `[~@done] done))))))

(defn lr-rewrite-marker-history [(old-forms Code) (new-forms Code) (marker Code)] (-> Code)
  (if (not (lr-marker? marker))
      marker
      (let [T (primitive/code-nth marker 1)
            field-name (primitive/code-nth marker 2)
            old-decl (lr-find-struct old-forms T 0)
            field-index (if (lr-head? old-decl `defstruct)
                            (meta/live-raw-field-index old-decl field-name) -1)]
        (if (< field-index 0)
            marker
            (let [field-type (meta/live-raw-field-type old-decl field-index)]
              (if (lr-changed-sum-type? old-forms new-forms field-type)
                  `(live-migrate-declaration ~T ~field-name
                     ~(primitive/code-nth marker 3)
                     ~(lr-rewrite-match-patterns (primitive/code-nth marker 4) field-type))
                  marker))))))

(defn lr-type-fingerprint [(forms Code) (T Code) (depth i64)] (-> i64)
  (let [base (meta/live-name-hash T)]
    (if (or (<= depth 0) (not (primitive/code-sym? T)))
        base
        (let [sum (lr-find-sum forms T 0)
              record (lr-find-struct forms T 0)]
          (if (lr-head? sum `defsum)
              (primitive/ixor base (meta/live-declaration-hash sum))
              (if (lr-head? record `defstruct)
                  (primitive/ixor base (meta/live-layout-hash record))
                  base))))))

(defn lr-struct-fingerprint [(forms Code) (decl Code)] (-> i64)
  (let [fields (meta/live-struct-fields decl) (mut h) (meta/live-layout-hash decl)]
    (for [i 0 (primitive/code-count fields)]
      (set! h (primitive/imul
                (primitive/ixor (load h)
                  (lr-type-fingerprint forms (primitive/code-nth (primitive/code-nth fields i) 1) 4))
                16777619)))
    (load h)))

(defn lr-changed-sum-type? [(old-forms Code) (new-forms Code) (T Code)] (-> bool)
  (if (not (primitive/code-sym? T))
      false
      (let [old (lr-find-sum old-forms T 0) new (lr-find-sum new-forms T 0)]
        (and (lr-head? old `defsum)
             (and (lr-head? new `defsum)
                  (!= (meta/live-declaration-hash old)
                      (meta/live-declaration-hash new)))))))

(defn lr-changed-struct-type? [(old-forms Code) (new-forms Code) (T Code)] (-> bool)
  (if (not (primitive/code-sym? T))
      false
      (let [old (lr-find-struct old-forms T 0) new (lr-find-struct new-forms T 0)]
        (and (lr-head? old `defstruct)
             (and (lr-head? new `defstruct)
                  (!= (lr-struct-fingerprint old-forms old)
                      (lr-struct-fingerprint new-forms new)))))))

(defn lr-old-field-type [(old-forms Code) (new-forms Code) (T Code)] (-> Code)
  (if (or (lr-changed-sum-type? old-forms new-forms T)
          (lr-changed-struct-type? old-forms new-forms T))
      (lr-old-name T)
      T))

(defn lr-rename-struct-history [(form Code) (name Code)
                                (old-forms Code) (new-forms Code)] (-> Code)
  (let [fields (meta/live-struct-fields form) clean (primitive/code-list-new)]
    (for [i 0 (primitive/code-count fields)]
      (let [field (primitive/code-nth fields i)]
        (primitive/code-list-push! clean
          `(~(primitive/code-nth field 0)
            ~(lr-old-field-type old-forms new-forms (primitive/code-nth field 1))))))
    (if (= (primitive/code-count form) 3)
        `(defstruct ~name [~@(primitive/code-list-done clean)])
        `(defstruct ~name ~(primitive/code-nth form 2) [~@(primitive/code-list-done clean)]))))

(defn lr-marker? [(form Code)] (-> bool)
  (lr-head? form `live-migrate-declaration))

(defn lr-letonce? [(form Code)] (-> bool)
  (lr-head? form `letonce))

(defn lr-letonces [(forms Code)] (-> Code)
  (let [out (primitive/code-list-new)]
    (for [i 0 (primitive/code-count forms)]
      (let [form (primitive/code-nth forms i)]
        (if (lr-letonce? form) (do (primitive/code-list-push! out form) 0) 0)))
    (primitive/code-list-done out)))

(defn lr-root-accessor [(name Code)] (-> Code)
  (primitive/datum->syntax name
    (primitive/syntax->datum (primitive/code-symbol name "--live-get"))))

(defn lr-root-slot [(name Code)] (-> Code)
  (primitive/datum->syntax name
    (primitive/syntax->datum (primitive/code-symbol name "--live-slot"))))

(defn lr-root-register [(name Code)] (-> Code)
  (primitive/datum->syntax name
    (primitive/syntax->datum (primitive/code-symbol name "--live-register-root"))))

(defn lr-letonce-type [(forms Code) (root Code)] (-> Code)
  (let [value (primitive/code-nth root 2)]
    (if (and (primitive/code-list? value) (> (primitive/code-count value) 0))
        (let [head (primitive/code-nth value 0)
              sum (lr-find-sum-for-variant forms head)]
          (if (lr-head? (lr-find-struct forms head 0) `defstruct)
              head
              (if (lr-head? sum `defsum)
                  (primitive/code-nth sum 1)
                  (let [(mut closure) `:missing]
                    (for [i 0 (primitive/code-count forms)]
                      (let [candidate (primitive/code-nth forms i)]
                        (if (and (lr-head? candidate `defclosure)
                                 (lr-name=? head
                                   (primitive/datum->syntax
                                     (primitive/code-nth candidate 1)
                                     (primitive/syntax->datum
                                       (primitive/code-symbol
                                         (primitive/code-nth candidate 1) "-new")))))
                            (set! closure (primitive/code-nth candidate 1)) 0)))
                    (if (not (primitive/code-eq (load closure) `:missing))
                        (load closure)
                        (primitive/error
                          (primitive/code-str "letonce '"
                            (primitive/code-str (primitive/code-nth root 1))
                            "' requires a nominal live constructor initializer")))))))
        (primitive/error
          (primitive/code-str "letonce '" (primitive/code-str (primitive/code-nth root 1))
                              "' requires a nominal live constructor initializer")))))

(defn lr-registry-constructor-type [(live-registry Code) (head Code)] (-> Code)
  (let [struct-record (registry/registry-find live-registry `:struct head)]
    (if (lr-head? struct-record `live-definition)
        head
        (let [(mut found) `:missing]
          (for [i 0 (registry/registry-record-count live-registry)]
            (let [record (registry/registry-record-at live-registry i)]
              (if (primitive/code-eq (registry/registry-record-kind record) `:sum)
                  (let [decl (registry/registry-record-form record)]
                    (if (>= (meta/live-sum-variant-index decl head) 0)
                        (set! found (registry/registry-record-name record)) 0)) 0)))
          (if (not (primitive/code-eq (load found) `:missing))
              (load found)
              (do
                (for [i 0 (registry/registry-record-count live-registry)]
                  (let [record (registry/registry-record-at live-registry i)]
                    (if (and (primitive/code-eq
                               (registry/registry-record-kind record) `:closure)
                             (lr-name=?
                               (lr-artifact-symbol record `:closure-constructor)
                               head))
                        (set! found (registry/registry-record-name record)) 0)))
                (if (not (primitive/code-eq (load found) `:missing))
                    (load found)
                    (primitive/error
                      "live root initializer must construct a live struct, sum, or closure"))))))))

(defn lr-root-for-name [(roots Code) (name Code)] (-> Code)
  (let [(mut i) 0 (mut found) name]
    (loop (if (>= (load i) (primitive/code-count roots))
              (break)
              (let [root (primitive/code-nth roots (load i))]
                (if (lr-name=? (primitive/code-nth root 1) name)
                    (do (set! found root) (break))
                    (set! i (+ (load i) 1))))))
    (load found)))

(defn lr-rewrite-root-refs [(form Code) (roots Code)] (-> Code)
  (if (primitive/code-sym? form)
      (let [root (lr-root-for-name roots form)]
        (if (primitive/code-list? root)
            `(~(lr-root-accessor (primitive/code-nth root 1)))
            form))
      (if (not (primitive/code-list? form))
          form
          (let [out (primitive/code-list-new)]
            (for [i 0 (primitive/code-count form)]
              (primitive/code-list-push! out
                (lr-rewrite-root-refs (primitive/code-nth form i) roots)))
            (let [done (primitive/code-list-done out)]
              (if (primitive/code-vector? form) `[~@done] done))))))

(defn lr-env-empty [] (-> Code) `(live-type-env))

(defn lr-env-bind [(env Code) (name Code) (T Code)] (-> Code)
  `(~@env (live-type-binding ~name ~T)))

(defn lr-env-type [(env Code) (name Code)] (-> Code)
  (let [(mut result) `:unknown]
    (for [i 1 (primitive/code-count env)]
      (let [binding (primitive/code-nth env i)]
        (if (lr-name=? (primitive/code-nth binding 1) name)
            (set! result (primitive/code-nth binding 2)) 0)))
    (load result)))

(defn lr-struct-for-field-head [(forms Code) (head Code)] (-> Code)
  (let [(mut found) `:unknown]
    (for [i 0 (primitive/code-count forms)]
      (let [decl (primitive/code-nth forms i)]
        (if (lr-head? decl `defstruct)
            (for [j 0 (primitive/code-count (meta/live-struct-fields decl))]
              (let [field (meta/live-raw-field-name decl j)
                    expected (primitive/datum->syntax field
                               (primitive/syntax->datum
                                 (primitive/code-symbol "." field)))]
                (if (lr-name=? expected head) (set! found decl) 0))) 0)))
    (load found)))

(defn lr-form-return-type [(forms Code) (name Code)] (-> Code)
  (let [(mut result) `:unknown]
    (for [i 0 (primitive/code-count forms)]
      (let [form (primitive/code-nth forms i)]
        (if (and (lr-defn? form) (lr-name=? (primitive/code-nth form 1) name))
            (let [generic? (primitive/code-vector? (primitive/code-nth form 3))
                  retform (primitive/code-nth form (if generic? 4 3))]
              (set! result (primitive/code-nth retform 1))) 0)))
    (load result)))

(defn lr-registry-root-type [(live-registry Code) (name Code)] (-> Code)
  (let [root (registry/registry-find live-registry `:root name)]
    (if (not (lr-head? root `live-definition))
        `:unknown
        (let [dependencies (registry/registry-record-type-dependencies root)]
          (if (> (primitive/code-count dependencies) 1)
              (let [dependency (primitive/code-nth dependencies 1)
                    target (registry/registry-find-by-id live-registry
                             (primitive/code-nth dependency 1))]
                (if (lr-head? target `live-definition)
                    (let [target-name (registry/registry-record-name target)]
                      (if (primitive/code-sym? target-name)
                          target-name
                          (primitive/error "live root type dependency has a non-symbol target name")))
                    `:unknown))
              `:unknown)))))

(defn lr-live-expression-type [(form Code) (env Code) (forms Code)
                               (live-registry Code)] (-> Code)
  (if (primitive/code-sym? form)
      (let [local (lr-env-type env form)
            root (lr-root-for-name (lr-letonces forms) form)
            retained-root-type (lr-registry-root-type live-registry form)
            root-type
              (if (not (primitive/code-eq retained-root-type `:unknown))
                  retained-root-type
                  (if (primitive/code-list? root)
                      (lr-letonce-type forms root)
                      `:unknown))]
        (if (not (primitive/code-eq local `:unknown)) local
            root-type))
      (if (or (not (primitive/code-list? form)) (= (primitive/code-count form) 0))
          `:unknown
          (let [head (primitive/code-nth form 0)
                struct (if (primitive/code-sym? head)
                           (lr-find-struct forms head 0) head)
                field-struct (if (primitive/code-sym? head)
                                 (lr-struct-for-field-head forms head) head)]
            (cond
              (lr-head? struct `defstruct) (primitive/code-nth struct 1)
              (lr-head? (lr-find-sum-for-variant forms head) `defsum)
                (primitive/code-nth (lr-find-sum-for-variant forms head) 1)
              (lr-head? field-struct `defstruct)
                (let [receiver-type (lr-live-expression-type
                                      (primitive/code-nth form 1) env forms live-registry)
                      expected (primitive/code-nth field-struct 1)]
                  (if (lr-name=? receiver-type expected)
                      (let [(mut result) `:unknown]
                        (for [i 0 (primitive/code-count (meta/live-struct-fields field-struct))]
                          (let [field (meta/live-raw-field-name field-struct i)
                                field-head (primitive/datum->syntax field
                                             (primitive/syntax->datum
                                               (primitive/code-symbol "." field)))]
                            (if (lr-name=? field-head head)
                                (set! result (meta/live-raw-field-type field-struct i)) 0)))
                        (load result))
                      `:unknown))
              (primitive/code-sym? head) (lr-form-return-type forms head)
              :else `:unknown)))))

(defn lr-constructor-argument [(form Code) (field Code) (decl Code)] (-> Code)
  (let [keyword (lr-field-keyword field)
        (mut i) 1
        (mut found) `:missing]
    (loop (if (>= (load i) (primitive/code-count form))
              (break)
              (if (and (< (+ (load i) 1) (primitive/code-count form))
                       (primitive/code-eq (primitive/code-nth form (load i)) keyword))
                  (do (set! found (primitive/code-nth form (+ (load i) 1))) (break))
                  (set! i (+ (load i) 2)))))
    (if (primitive/code-eq (load found) `:missing)
        (let [index (meta/live-raw-field-index decl field)]
          (if (meta/live-raw-field-default? decl index)
              (meta/live-raw-field-default decl index)
              (primitive/error
                (primitive/code-str "live constructor is missing field '"
                                    (primitive/code-str field) "'"))))
        (load found))))

(defn lr-sum-constructor-argument [(form Code) (variant Code)
                                   (field-index i64)] (-> Code)
  (let [fields (if (> (primitive/code-count variant) 1)
                   (primitive/code-nth variant 1) `[])
        field (primitive/code-nth fields field-index)]
    (if (= (primitive/code-count form) (+ (primitive/code-count fields) 1))
        (primitive/code-nth form (+ field-index 1))
        (lr-constructor-argument form (primitive/code-nth field 0)
          `(defstruct __live_variant_fields ~fields)))))

(defn lr-binding-name [(binding Code)] (-> Code)
  (if (primitive/code-list? binding)
      (primitive/code-nth binding (- (primitive/code-count binding) 1))
      binding))

(defn lr-live-clone-expression [(T Code) (value Code)
                                (live-registry Code)] (-> Code)
  (let [struct-record (registry/registry-find live-registry `:struct T)
        sum-record (registry/registry-find live-registry `:sum T)
        record (if (lr-head? struct-record `live-definition)
                   struct-record sum-record)]
    (if (lr-head? record `live-definition)
        `(~(lr-artifact-symbol record `:handle-cloner) ~value)
        `(clone ~value))))

(defn lr-rewrite-live-expr [(form Code) (env Code) (forms Code)
                            (live-registry Code)] (-> Code)
  (if (primitive/code-sym? form)
      (let [root (lr-root-for-name (lr-letonces forms) form)
            function (registry/registry-find live-registry `:function form)]
        (if (primitive/code-list? root)
            `(~(lr-root-accessor (primitive/code-nth root 1)))
            (if (lr-head? function `live-definition)
                (lr-artifact-symbol function `:public-entry)
                form)))
      (if (not (primitive/code-list? form))
          form
          (if (= (primitive/code-count form) 0)
              form
              (let [head (primitive/code-nth form 0)
                    constructor-decl
                      (if (primitive/code-sym? head) (lr-find-struct forms head 0) head)
                    sum-constructor-decl
                      (if (primitive/code-sym? head)
                          (lr-find-sum-for-variant forms head) `:missing)
                    field-decl
                      (if (primitive/code-sym? head)
                          (lr-struct-for-field-head forms head) head)]
                (cond
                  (and (primitive/code-eq head `clone)
                       (= (primitive/code-count form) 2))
                    (let [argument (primitive/code-nth form 1)
                          argument-type
                            (lr-live-expression-type argument env forms live-registry)
                          rewritten
                            (lr-rewrite-live-expr argument env forms live-registry)
                          struct-record
                            (registry/registry-find live-registry `:struct argument-type)
                          sum-record
                            (registry/registry-find live-registry `:sum argument-type)]
                      (if (or (lr-head? struct-record `live-definition)
                              (lr-head? sum-record `live-definition))
                          (lr-live-clone-expression argument-type rewritten live-registry)
                          `(clone ~rewritten)))
                  (lr-head? constructor-decl `defstruct)
                    (let [T (primitive/code-nth constructor-decl 1)
                          record (registry/registry-find live-registry `:struct T)
                          version (primitive/code-nth record 4)
                          fields (meta/live-struct-fields constructor-decl)
                          args (primitive/code-list-new)]
                      (for [i 0 (primitive/code-count fields)]
                        (let [field-type (meta/live-raw-field-type constructor-decl i)
                              argument
                                (lr-constructor-argument form
                                  (meta/live-raw-field-name constructor-decl i)
                                  constructor-decl)
                              rewritten
                                (lr-rewrite-live-expr argument env forms live-registry)
                              nested-live?
                                (or (lr-head? (lr-find-struct forms field-type 0) `defstruct)
                                    (lr-head? (lr-find-sum forms field-type 0) `defsum))
                              borrowed?
                                (or (and (primitive/code-sym? argument)
                                         (primitive/code-list?
                                           (lr-root-for-name (lr-letonces forms) argument)))
                                    (and (primitive/code-list? argument)
                                         (and (> (primitive/code-count argument) 1)
                                              (lr-head?
                                                (lr-struct-for-field-head forms
                                                  (primitive/code-nth argument 0))
                                                `defstruct))))]
                          (if (and nested-live? borrowed?)
                              (primitive/code-list-push! args
                                (lr-live-clone-expression field-type rewritten live-registry))
                              (primitive/code-list-push! args rewritten))))
                      `(~(lr-handle-constructor-name T version)
                        ~@(primitive/code-list-done args)))
                  (lr-head? sum-constructor-decl `defsum)
                    (let [T (primitive/code-nth sum-constructor-decl 1)
                          record (registry/registry-find live-registry `:sum T)
                          variant (lr-find-variant sum-constructor-decl head)
                          fields (if (> (primitive/code-count variant) 1)
                                     (primitive/code-nth variant 1) `[])
                          args (primitive/code-list-new)]
                      (for [i 0 (primitive/code-count fields)]
                        (let [field (primitive/code-nth fields i)
                              field-type (primitive/code-nth field 1)
                              argument (lr-sum-constructor-argument form variant i)
                              rewritten
                                (lr-rewrite-live-expr argument env forms live-registry)
                              nested-live?
                                (or (lr-head? (lr-find-struct forms field-type 0) `defstruct)
                                    (lr-head? (lr-find-sum forms field-type 0) `defsum))
                              borrowed?
                                (or (and (primitive/code-sym? argument)
                                         (primitive/code-list?
                                           (lr-root-for-name (lr-letonces forms) argument)))
                                    (and (primitive/code-list? argument)
                                         (and (> (primitive/code-count argument) 1)
                                              (lr-head?
                                                (lr-struct-for-field-head forms
                                                  (primitive/code-nth argument 0))
                                                `defstruct))))]
                          (if (and nested-live? borrowed?)
                              (primitive/code-list-push! args
                                (lr-live-clone-expression field-type rewritten live-registry))
                              (primitive/code-list-push! args rewritten))))
                      `(~(lr-keyed-artifact-symbol
                           record `:variant-constructor head)
                        ~@(primitive/code-list-done args)))
                  (primitive/code-eq head `match)
                    (let [scrutinee (primitive/code-nth form 1)
                          T (lr-live-expression-type scrutinee env forms live-registry)
                          sum-decl (lr-find-sum forms T 0)]
                      (if (not (lr-head? sum-decl `defsum))
                          (let [out (primitive/code-list-new)]
                            (for [i 0 (primitive/code-count form)]
                              (primitive/code-list-push! out
                                (lr-rewrite-live-expr (primitive/code-nth form i)
                                  env forms live-registry)))
                            (primitive/code-list-done out))
                          (let [record (registry/registry-find live-registry `:sum T)
                                scrutinee-owner
                                  (primitive/fresh-identifier "live_sum_scrutinee")
                                rewritten-scrutinee
                                  (lr-rewrite-live-expr scrutinee env forms live-registry)
                                out (primitive/code-list-new)]
                            (primitive/code-list-push! out `match)
                            (primitive/code-list-push! out
                              `(~(lr-artifact-symbol record `:sum-payload-accessor)
                                ~scrutinee-owner))
                            (for [i 2 (primitive/code-count form)]
                              (let [arm (primitive/code-nth form i)
                                    variant-name (primitive/code-nth arm 0)
                                    bindings (primitive/code-nth arm 1)
                                    variant (lr-find-variant sum-decl variant-name)
                                    fields (if (> (primitive/code-count variant) 1)
                                               (primitive/code-nth variant 1) `[])
                                    (mut arm-env) env
                                    rewritten-arm (primitive/code-list-new)]
                                (for [j 0 (primitive/code-count bindings)]
                                  (if (< j (primitive/code-count fields))
                                      (set! arm-env
                                        (lr-env-bind (load arm-env)
                                          (primitive/code-nth bindings j)
                                          (primitive/code-nth
                                            (primitive/code-nth fields j) 1))) 0))
                                (primitive/code-list-push! rewritten-arm
                                  (lr-keyed-artifact-symbol
                                    record `:payload-variant variant-name))
                                (primitive/code-list-push! rewritten-arm bindings)
                                (for [j 2 (primitive/code-count arm)]
                                  (primitive/code-list-push! rewritten-arm
                                    (lr-rewrite-live-expr
                                      (primitive/code-nth arm j) (load arm-env)
                                      forms live-registry)))
                                (primitive/code-list-push! out
                                  (primitive/code-list-done rewritten-arm))))
                            `(let [~scrutinee-owner ~rewritten-scrutinee]
                               ~(primitive/code-list-done out)))))
                  (and (primitive/code-eq head `set!)
                       (and (> (primitive/code-count form) 2)
                            (primitive/code-list? (primitive/code-nth form 1))))
                    (let [place (primitive/code-nth form 1)
                          place-head (primitive/code-nth place 0)
                          decl (lr-struct-for-field-head forms place-head)]
                      (if (not (lr-head? decl `defstruct))
                          `(set! ~(lr-rewrite-live-expr place env forms live-registry)
                                 ~(lr-rewrite-live-expr (primitive/code-nth form 2)
                                    env forms live-registry))
                          (let [T (primitive/code-nth decl 1)
                                record (registry/registry-find live-registry `:struct T)
                                version (primitive/code-nth record 4)
                                (mut field) `:unknown]
                            (for [i 0 (primitive/code-count (meta/live-struct-fields decl))]
                              (let [candidate (meta/live-raw-field-name decl i)
                                    expected (primitive/datum->syntax candidate
                                               (primitive/syntax->datum
                                                 (primitive/code-symbol "." candidate)))]
                                (if (lr-name=? expected place-head)
                                    (set! field candidate) 0)))
                            `(~(lr-handle-setter-name T (load field) version)
                              ~(lr-rewrite-live-expr (primitive/code-nth place 1)
                                 env forms live-registry)
                              ~(lr-rewrite-live-expr (primitive/code-nth form 2)
                                 env forms live-registry)))))
                  (lr-head? field-decl `defstruct)
                    (let [T (primitive/code-nth field-decl 1)
                          record (registry/registry-find live-registry `:struct T)
                          version (primitive/code-nth record 4)
                          (mut field) `:unknown]
                      (for [i 0 (primitive/code-count (meta/live-struct-fields field-decl))]
                        (let [candidate (meta/live-raw-field-name field-decl i)
                              expected (primitive/datum->syntax candidate
                                         (primitive/syntax->datum
                                           (primitive/code-symbol "." candidate)))]
                          (if (lr-name=? expected head) (set! field candidate) 0)))
                      `(~(lr-handle-getter-name T (load field) version)
                        ~(lr-rewrite-live-expr (primitive/code-nth form 1)
                           env forms live-registry)))
                  (primitive/code-eq head `let)
                      (let [bindings (primitive/code-nth form 1)
                          rewritten (primitive/code-list-new)
                          (mut next-env) env
                          (mut i) 0]
                      (loop (if (>= (load i) (primitive/code-count bindings))
                                (break)
                                (let [binding (primitive/code-nth bindings (load i))
                                      value (primitive/code-nth bindings (+ (load i) 1))
                                      rewritten-value
                                        (lr-rewrite-live-expr value (load next-env)
                                          forms live-registry)
                                      inferred
                                        (lr-live-expression-type value (load next-env) forms
                                          live-registry)]
                                  (primitive/code-list-push! rewritten binding)
                                  (primitive/code-list-push! rewritten rewritten-value)
                                  (if (not (primitive/code-eq inferred `:unknown))
                                      (set! next-env (lr-env-bind (load next-env)
                                                       (lr-binding-name binding) inferred)) 0)
                                  (set! i (+ (load i) 2)))))
                      (let [body (primitive/code-list-new)]
                        (for [i 2 (primitive/code-count form)]
                          (primitive/code-list-push! body
                            (lr-rewrite-live-expr (primitive/code-nth form i)
                              (load next-env) forms live-registry)))
                        `(let [~@(primitive/code-list-done rewritten)]
                           ~@(primitive/code-list-done body))))
                  :else
                    (let [out (primitive/code-list-new)]
                      (for [i 0 (primitive/code-count form)]
                        (primitive/code-list-push! out
                          (lr-rewrite-live-expr (primitive/code-nth form i)
                            env forms live-registry)))
                      (let [done (primitive/code-list-done out)]
                        (if (primitive/code-vector? form) `[~@done] done)))))))))

(defn lr-rewrite-live-function [(form Code) (forms Code)
                                (live-registry Code)] (-> Code)
  (let [generic? (primitive/code-vector? (primitive/code-nth form 3))
        params-index (if generic? 3 2)
        body-index (if generic? 5 4)
        params (primitive/code-nth form params-index)
        (mut env) (lr-env-empty)
        out (primitive/code-list-new)]
    (for [i 0 (primitive/code-count params)]
      (let [param (primitive/code-nth params i)]
        (set! env (lr-env-bind (load env) (primitive/code-nth param 0)
                    (primitive/code-nth param 1)))))
    (for [i 0 body-index]
      (if (= i params-index)
          (let [runtime-params (primitive/code-list-new)]
            (for [j 0 (primitive/code-count params)]
              (let [param (primitive/code-nth params j)
                    T (primitive/code-nth param 1)]
                (primitive/code-list-push! runtime-params
                  `(~(primitive/code-nth param 0)
                    ~(if (or (lr-head? (lr-find-struct forms T 0) `defstruct)
                             (lr-head? (lr-find-sum forms T 0) `defsum))
                         `(ref ~T)
                         T)))))
            (primitive/code-list-push! out
              `[~@(primitive/code-list-done runtime-params)]))
          (primitive/code-list-push! out (primitive/code-nth form i))))
    (for [i body-index (primitive/code-count form)]
      (primitive/code-list-push! out
        (lr-rewrite-live-expr (primitive/code-nth form i) (load env)
          forms live-registry)))
    (primitive/code-list-done out)))

(defn lr-letonce-defs [(forms Code) (root Code) (live-registry Code)] (-> Code)
  (let [name (primitive/code-nth root 1)
        value (lr-rewrite-live-expr (primitive/code-nth root 2)
                (lr-env-empty) forms live-registry)
        T (lr-letonce-type forms root)
        slot (lr-root-slot name)
        accessor (lr-root-accessor name)
        registrar (lr-root-register name)
        record (let [closure (registry/registry-find live-registry `:closure T)
                     sum (registry/registry-find live-registry `:sum T)]
                 (if (lr-head? closure `live-definition)
                     closure
                     (if (lr-head? sum `live-definition)
                         sum
                         (registry/registry-find live-registry `:struct T))))
        root-value (primitive/fresh-identifier "live_root_value")
        owned-value
          (if (primitive/code-eq
                (registry/registry-record-kind record) `:closure)
              `(do
                 (~(primitive/syntax->datum `coil_live_handle_retain)
                   (.environment ~root-value))
                 (~T :environment (.environment ~root-value)))
              `(~(lr-artifact-symbol record `:handle-cloner) ~root-value))
        initialized (primitive/datum->syntax name
                      (primitive/syntax->datum
                        (primitive/code-symbol name "--live-initialized")))
        root-handle
          (if (primitive/code-eq
                (registry/registry-record-kind record) `:closure)
              `(.environment (~accessor))
              `(~(lr-artifact-symbol record `:handle-pointer) (~accessor)))
        literal (meta/live-c-literal name)]
    `((defn ~slot [] (-> (ptr (ptr i8))) (primitive/alloc-static (ptr i8)))
      (defn ~initialized [] (-> (ptr bool)) (primitive/alloc-static bool))
      (defn ~accessor [] (-> (ptr ~T))
        (primitive/cast (ptr ~T) (load (~slot))))
      (defn ~registrar [(schema i64)] (-> i64)
        (primitive/cast i64 schema)
        (if (not (load (~initialized)))
            (let [memory (~(primitive/syntax->datum `calloc)
                           1 (primitive/cast u64 (primitive/sizeof ~T)))]
              (if (= (primitive/cast i64 memory) 0)
                  -20
                  (let [~root-value ~value]
                    ; The constructor result is an affine temporary. Persistent
                    ; root storage takes an explicit handle-level clone; nominal
                    ; live wrappers intentionally need no blanket Clone impl.
                    (store! (primitive/cast (ptr ~T) memory) ~owned-value)
                    (store! (~slot) memory)
                    (store! (~initialized) true))))
            0)
        ; Source roots and managed handles are distinct registries. The root
        ; names a stable handle; nested handles remain managed graph vertices.
        (~(primitive/syntax->datum `coil_live_register_handle_root)
          (primitive/cast (ptr u8) ~literal) ~(slice-len (primitive/code-str name))
          ~root-handle)))))

(defn lr-defn? [(form Code)] (-> bool)
  (and (lr-head? form `defn) (>= (primitive/code-count form) 5)))

(defn lr-generated-name [(context Code) (prefix Code) (suffix Code)] (-> Code)
  (primitive/datum->syntax context
    (primitive/syntax->datum (primitive/code-symbol prefix suffix))))

(defn lr-lineage-name [(name Code) (suffix (slice u8))] (-> Code)
  (primitive/datum->syntax name
    (primitive/syntax->datum (primitive/code-symbol name suffix))))

(defn lr-lineage-artifact-name [(name Code) (role (slice u8))
                                (lineage i64)] (-> Code)
  (primitive/datum->syntax name
    (primitive/syntax->datum
      (primitive/code-symbol name role lineage))))

(defn lr-abi-lineage-count [(record Code)] (-> i64)
  (let [artifacts (registry/registry-record-artifacts record) (mut count) 0]
    (for [i 1 (primitive/code-count artifacts)]
      (if (registry/registry-artifact-role?
            (primitive/code-nth artifacts i) `:abi-lineage)
          (set! count (+ (load count) 1)) 0))
    (load count)))

(defn lr-versioned-artifact-name [(name Code) (role (slice u8))
                                  (version Code)] (-> Code)
  (if (and (lr-head? version `next-version)
           (> (primitive/code-count version) 1))
      (let [prior (lr-versioned-artifact-name name role
                    (primitive/code-nth version 1))]
        (primitive/datum->syntax name
          (primitive/syntax->datum (primitive/code-symbol prior "--next"))))
      (lr-lineage-name name role)))

(defn lr-payload-name [(name Code) (version Code)] (-> Code)
  (lr-versioned-artifact-name name "--live-payload" version))

(defn lr-handle-constructor-name [(name Code) (version Code)] (-> Code)
  (lr-versioned-artifact-name name "--live-new" version))

(defn lr-schema-registrar-name [(name Code) (version Code)] (-> Code)
  (lr-versioned-artifact-name name "--live-register-schema" version))

(defn lr-schema-destructor-name [(name Code) (version Code)] (-> Code)
  (lr-versioned-artifact-name name "--live-destroy-payload" version))

(defn lr-handle-pointer-name [(name Code)] (-> Code)
  (lr-lineage-name name "--live-handle-pointer"))

(defn lr-handle-cloner-name [(name Code)] (-> Code)
  (lr-lineage-name name "--live-handle-clone"))

(defn lr-transition-adapter-name [(name Code) (version Code)] (-> Code)
  (lr-versioned-artifact-name name "--live-transition-adapter" version))

(defn lr-transition-abort-name [(name Code) (version Code)] (-> Code)
  (lr-versioned-artifact-name name "--live-transition-abort" version))

(defn lr-transition-retire-name [(name Code) (version Code)] (-> Code)
  (lr-versioned-artifact-name name "--live-transition-retire" version))

(defn lr-transition-registrar-name [(name Code) (version Code)] (-> Code)
  (lr-versioned-artifact-name name "--live-register-transition" version))

(defn lr-field-transition-name [(name Code) (field Code)
                                (version Code)] (-> Code)
  (lr-versioned-artifact-name
    (primitive/datum->syntax name
      (primitive/syntax->datum
        (primitive/code-symbol name "--live-field-transition-" field)))
    "" version))

(defn lr-sum-payload-accessor-name [(name Code) (version Code)] (-> Code)
  (lr-versioned-artifact-name name "--live-sum-payload" version))

(defn lr-sum-variant-artifact-name [(name Code) (variant Code)
                                    (role (slice u8)) (version Code)] (-> Code)
  (lr-versioned-artifact-name
    (primitive/datum->syntax name
      (primitive/syntax->datum (primitive/code-symbol name role variant)))
    "" version))

(defn lr-handle-getter-name [(name Code) (field Code) (version Code)] (-> Code)
  (lr-versioned-artifact-name
    (primitive/datum->syntax name
      (primitive/syntax->datum (primitive/code-symbol name "--live-get-" field)))
    "" version))

(defn lr-handle-setter-name [(name Code) (field Code) (version Code)] (-> Code)
  (lr-versioned-artifact-name
    (primitive/datum->syntax name
      (primitive/syntax->datum (primitive/code-symbol name "--live-set-" field)))
    "" version))

(defn lr-impl-method-artifact-name [(record Code) (role (slice u8))] (-> Code)
  (let [method (registry/registry-record-form record)
        name (registry/registry-record-name record)
        version (primitive/code-nth record 4)
        owner-fingerprint `~(meta/live-declaration-hash name)
        base
          (primitive/datum->syntax (primitive/code-nth method 0)
            (primitive/syntax->datum
              (primitive/code-symbol "__live_impl_method_"
                (primitive/code-nth method 0) "--owner--"
                owner-fingerprint)))]
    (if (or (meta/live-text=? role "--impl--")
            (meta/live-text=? role "--bind--"))
        (lr-versioned-artifact-name base role version)
        (lr-lineage-name base role))))

(defn lr-closure-name [(name Code) (suffix (slice u8))] (-> Code)
  (primitive/datum->syntax name
    (primitive/syntax->datum (primitive/code-symbol name suffix))))

(defn lr-closure-versioned-name [(name Code) (suffix (slice u8))
                                 (version Code)] (-> Code)
  (lr-versioned-artifact-name (lr-closure-name name suffix) "" version))

;;; Artifact ownership is registered at the same layer which chooses the
;;; generated spelling. Consumers resolve the descriptor stored under owner-id;
;;; they never parse this spelling to guess which source definition produced it.
(defn lr-register-definition-artifacts [(live-registry Code) (record Code)] (-> Code)
  (let [id (registry/registry-record-id record)
        kind (registry/registry-record-kind record)
        name (registry/registry-record-name record)
        version (primitive/code-nth record 4)
        (mut result) live-registry
        (mut source-token) 0]
    ; Runtime gates use a session-local integer token whose bijection to the
    ; structural source ID is retained as an owned registry artifact. It is an
    ; allocation from registry order, not a hash and not a generated linker
    ; spelling; candidate replacement preserves both record order and artifact.
    (for [i 0 (registry/registry-record-count live-registry)]
      (if (primitive/code-eq
            (registry/registry-record-id
              (registry/registry-record-at live-registry i)) id)
          (set! source-token (+ i 1)) 0))
    (if (= (load source-token) 0)
        (primitive/error "live registry: source token owner is absent") 0)
    (set! result
      (registry/registry-register-artifact (load result) id
        `(artifact :runtime-source-token ~(load source-token))))
    (cond
      (primitive/code-eq kind `:function)
        (do
          (set! result (registry/registry-register-artifact (load result) id
            `(artifact :public-entry ~name)))
          (set! result (registry/registry-register-artifact (load result) id
            `(artifact :private-implementation
               ~(lr-versioned-artifact-name name "--live-impl" version))))
          (if (primitive/code-vector?
                (primitive/code-nth (registry/registry-record-form record) 3))
              (set! result (registry/registry-register-artifact (load result) id
                `(artifact :generic-source-template
                   ~(registry/registry-function-signature
                      (registry/registry-record-form record)))))
              (do
                (set! result (registry/registry-register-artifact (load result) id
                  `(artifact :implementation-slot
                     ~(lr-lineage-name name "--live-slot-l0"))))
                (set! result (registry/registry-register-artifact (load result) id
                  `(artifact :slot-initialized
                     ~(lr-lineage-name name "--live-slot-initialized-l0"))))
                (set! result (registry/registry-register-artifact (load result) id
                  `(artifact :slot-binder
                     ~(lr-versioned-artifact-name name "--live-bind" version))))
                (set! result (registry/registry-register-artifact (load result) id
                  `(artifact :condition-entry
                     ~(lr-lineage-name name "--live-condition-l0"))))
                (set! result (registry/registry-register-artifact (load result) id
                  `(artifact :abi-lineage 0
                     ~(registry/registry-function-signature
                        (registry/registry-record-form record)))))
                0))
          0)
      (primitive/code-eq kind `:closure)
        (let [body-base (lr-closure-name name "--live-closure-body")
              env-name (lr-closure-name name "--live-closure-env")
              env-form `(defstruct ~env-name
                          ~(primitive/code-nth
                             (registry/registry-record-form record) 2))]
          (set! result (registry/registry-register-artifact (load result) id
            `(artifact :closure-handle-type ~name)))
          (set! result (registry/registry-register-artifact (load result) id
            `(artifact :closure-environment-type
               ~env-name)))
          (set! result (registry/registry-register-artifact (load result) id
            `(artifact :public-entry ~body-base)))
          (set! result (registry/registry-register-artifact (load result) id
            `(artifact :private-implementation
               ~(lr-closure-versioned-name name "--live-closure-body-impl" version))))
          (set! result (registry/registry-register-artifact (load result) id
            `(artifact :implementation-slot
               ~(lr-lineage-name body-base "--slot-l0"))))
          (set! result (registry/registry-register-artifact (load result) id
            `(artifact :slot-initialized
               ~(lr-lineage-name body-base "--initialized-l0"))))
          (set! result (registry/registry-register-artifact (load result) id
            `(artifact :slot-binder
               ~(lr-closure-versioned-name name "--live-closure-body-bind" version))))
          (set! result (registry/registry-register-artifact (load result) id
            `(artifact :condition-entry
               ~(lr-lineage-name body-base "--condition-l0"))))
          (set! result (registry/registry-register-artifact (load result) id
            `(artifact :closure-constructor ~(lr-closure-name name "-new"))))
          (set! result (registry/registry-register-artifact (load result) id
            `(artifact :closure-constructor-private
               ~(lr-closure-versioned-name name "--live-closure-new-impl" version))))
          (set! result (registry/registry-register-artifact (load result) id
            `(artifact :closure-constructor-slot
               ~(lr-lineage-name (lr-closure-name name "-new") "--slot-l0"))))
          (set! result (registry/registry-register-artifact (load result) id
            `(artifact :closure-constructor-initialized
               ~(lr-lineage-name (lr-closure-name name "-new") "--initialized-l0"))))
          (set! result (registry/registry-register-artifact (load result) id
            `(artifact :closure-constructor-binder
               ~(lr-closure-versioned-name name "--live-closure-new-bind" version))))
          ; The constructor slot is a permanent source-level ABI. Capture-schema
          ; refreshes generate adapters behind it; they must not append a second
          ; role entry whose newer source signature shadows lineage zero.
          (if (lr-head?
                (registry/registry-find-artifact record
                  `:closure-constructor-abi-lineage)
                `artifact)
              0
              (set! result (registry/registry-register-artifact (load result) id
                `(artifact :closure-constructor-abi-lineage 0
                   (closure-constructor-signature
                     ~(lr-closure-runtime-captures
                        (primitive/code-nth
                          (registry/registry-record-form record) 2)))))))
          (set! result (registry/registry-register-artifact (load result) id
            `(artifact :closure-call-adapter ~(lr-closure-name name "-call"))))
          (set! result (registry/registry-register-artifact (load result) id
            `(artifact :closure-destructor ~(lr-closure-name name "-free"))))
          (set! result (registry/registry-register-artifact (load result) id
            `(artifact :abi-lineage 0
               ~(registry/registry-closure-signature
                  (registry/registry-record-form record)))))
          ; Reuse the ordinary live-struct artifact protocol for the generated
          ; environment, but keep every artifact owned by the source closure ID.
          (set! result
            (lr-register-definition-artifacts (load result)
              `(live-definition ~id :struct ~env-name ~version ~env-form
                 (value-dependencies) (type-dependencies)
                 ~(registry/registry-record-artifacts record))))
          0)
      (primitive/code-eq kind `:impl-method)
        (do
          (set! result (registry/registry-register-artifact (load result) id
            `(artifact :public-entry
               ~(lr-impl-method-artifact-name record "--entry--"))))
          (set! result (registry/registry-register-artifact (load result) id
            `(artifact :private-implementation
               ~(lr-impl-method-artifact-name record "--impl--"))))
          (set! result (registry/registry-register-artifact (load result) id
            `(artifact :implementation-slot
               ~(lr-impl-method-artifact-name record "--slot--"))))
          (set! result (registry/registry-register-artifact (load result) id
            `(artifact :slot-initialized
               ~(lr-impl-method-artifact-name record "--initialized--"))))
          (set! result (registry/registry-register-artifact (load result) id
            `(artifact :slot-binder
               ~(lr-impl-method-artifact-name record "--bind--"))))
          (set! result (registry/registry-register-artifact (load result) id
            `(artifact :condition-entry
               ~(lr-impl-method-artifact-name record "--condition--"))))
          (set! result (registry/registry-register-artifact (load result) id
            `(artifact :abi-lineage 0
               (impl-method-signature
                 ~(primitive/code-nth (registry/registry-record-form record) 1)
                 ~(primitive/code-nth (registry/registry-record-form record) 2)))))
          0)
      (primitive/code-eq kind `:root)
        (do
          (set! result (registry/registry-register-artifact (load result) id
            `(artifact :root-slot ~(lr-root-slot name))))
          (set! result (registry/registry-register-artifact (load result) id
            `(artifact :root-accessor ~(lr-root-accessor name))))
          (set! result (registry/registry-register-artifact (load result) id
            `(artifact :root-registrar ~(lr-root-register name))))
          0)
      (or (primitive/code-eq kind `:struct) (primitive/code-eq kind `:sum))
        (do
          (if (or (primitive/code-eq kind `:struct)
                  (primitive/code-eq kind `:sum))
              (do
                (set! result (registry/registry-register-artifact (load result) id
                  `(artifact :stable-handle-type ~name)))
                (set! result (registry/registry-register-artifact (load result) id
                  `(artifact :handle-pointer ~(lr-handle-pointer-name name))))
                (set! result (registry/registry-register-artifact (load result) id
                  `(artifact :handle-cloner ~(lr-handle-cloner-name name))))
                (set! result (registry/registry-register-artifact (load result) id
                  `(artifact :versioned-payload
                     ~(lr-payload-name name version))))
                (set! result (registry/registry-register-artifact (load result) id
                  `(artifact :schema-destructor
                     ~(lr-schema-destructor-name name version))))
                (if (primitive/code-eq kind `:struct)
                    (set! result (registry/registry-register-artifact (load result) id
                      `(artifact :handle-constructor
                         ~(lr-handle-constructor-name name version))))
                    0)
                (set! result (registry/registry-register-artifact (load result) id
                  `(artifact :transition-adapter
                     ~(lr-transition-adapter-name name version))))
                (set! result (registry/registry-register-artifact (load result) id
                  `(artifact :transition-abort
                     ~(lr-transition-abort-name name version))))
                (set! result (registry/registry-register-artifact (load result) id
                  `(artifact :transition-retire
                     ~(lr-transition-retire-name name version))))
                (set! result (registry/registry-register-artifact (load result) id
                  `(artifact :transition-registrar
                     ~(lr-transition-registrar-name name version))))
                (if (primitive/code-eq kind `:sum)
                    (do
                      (set! result (registry/registry-register-artifact (load result) id
                        `(artifact :sum-payload-accessor
                           ~(lr-sum-payload-accessor-name name version))))
                      (let [variants
                              (meta/live-sum-variants
                                (registry/registry-record-form record))]
                        (for [i 0 (primitive/code-count variants)]
                          (let [variant-name
                                  (primitive/code-nth
                                    (primitive/code-nth variants i) 0)]
                            (set! result
                              (registry/registry-register-artifact (load result) id
                                `(artifact :payload-variant ~variant-name
                                   ~(lr-sum-variant-artifact-name name variant-name
                                      "--live-payload-variant-" version))))
                            (set! result
                              (registry/registry-register-artifact (load result) id
                                `(artifact :variant-constructor ~variant-name
                                   ~(lr-sum-variant-artifact-name name variant-name
                                      "--live-new-variant-" version)))))))
                      0)
                    0)
                (if (primitive/code-eq kind `:struct)
                    (let [fields
                            (meta/live-struct-fields
                              (registry/registry-record-form record))]
                      (for [i 0 (primitive/code-count fields)]
                        (let [field-name
                                (meta/live-raw-field-name
                                  (registry/registry-record-form record) i)]
                          (set! result
                            (registry/registry-register-artifact (load result) id
                              `(artifact :field-transition ~field-name
                                 ~(lr-field-transition-name name field-name version))))))
                      0)
                    0)
                0)
              0)
          (set! result (registry/registry-register-artifact (load result) id
            `(artifact :schema-registrar ~(lr-schema-registrar-name name version))))
          (set! result (registry/registry-register-artifact (load result) id
            `(artifact :schema-show
               ~(lr-versioned-artifact-name name "--live-show" version))))
          (set! result (registry/registry-register-artifact (load result) id
            `(artifact :schema-json
               ~(lr-versioned-artifact-name name "--live-json" version))))
          0)
      :else 0)
    (load result)))

(defn lr-refresh-function-artifacts [(live-registry Code) (name Code)] (-> Code)
  (let [record (registry/registry-find live-registry `:function name)
        old (registry/registry-record-artifacts record)
        kept (primitive/code-list-new)]
    (primitive/code-list-push! kept `generated-artifacts)
    (for [i 1 (primitive/code-count old)]
      (let [artifact (primitive/code-nth old i)]
        (if (or (registry/registry-artifact-role? artifact `:private-implementation)
                (registry/registry-artifact-role? artifact `:slot-binder))
            0
            (do (primitive/code-list-push! kept artifact) 0))))
    (let [without-private
            (registry/registry-replace-record live-registry
              (registry/registry-record-with-artifacts record
                (primitive/code-list-done kept)))
          id (registry/registry-record-id record)
          version (primitive/code-nth record 4)
          with-impl
            (registry/registry-register-artifact without-private id
              `(artifact :private-implementation
                 ~(lr-versioned-artifact-name name "--live-impl" version)))]
      (if (primitive/code-vector?
            (primitive/code-nth (registry/registry-record-form record) 3))
          with-impl
          (registry/registry-register-artifact with-impl id
            `(artifact :slot-binder
               ~(lr-versioned-artifact-name name "--live-bind" version)))))))

(defn lr-refresh-impl-method-artifacts [(live-registry Code)
                                        (name Code)] (-> Code)
  (let [record (registry/registry-find live-registry `:impl-method name)
        old (registry/registry-record-artifacts record)
        kept (primitive/code-list-new)]
    (primitive/code-list-push! kept `generated-artifacts)
    (for [i 1 (primitive/code-count old)]
      (let [artifact (primitive/code-nth old i)]
        (if (or (registry/registry-artifact-role? artifact `:private-implementation)
                (registry/registry-artifact-role? artifact `:slot-binder))
            0
            (do (primitive/code-list-push! kept artifact) 0))))
    (let [without-versioned
            (registry/registry-replace-record live-registry
              (registry/registry-record-with-artifacts record
                (primitive/code-list-done kept)))]
      (lr-register-definition-artifacts without-versioned
        (registry/registry-find without-versioned `:impl-method name)))))

(defn lr-refresh-impl-methods [(live-registry Code) (impl-form Code)
                               (i i64)] (-> Code)
  (if (>= i (primitive/code-count impl-form))
      live-registry
      (let [impl-name (registry/registry-definition-name impl-form)
            method (primitive/code-nth impl-form i)
            name (registry/registry-impl-method-key impl-name
                   (primitive/code-nth method 0))]
        (lr-refresh-impl-methods
          (lr-refresh-impl-method-artifacts live-registry name)
          impl-form (+ i 1)))))

(defn lr-append-function-lineage [(live-registry Code) (name Code)] (-> Code)
  (let [record (registry/registry-find live-registry `:function name)
        id (registry/registry-record-id record)
        lineage (lr-abi-lineage-count record)
        signature (registry/registry-function-signature
                    (registry/registry-record-form record))
        with-entry
          (registry/registry-register-artifact live-registry id
            `(artifact :public-entry
               ~(lr-lineage-artifact-name name "--live-entry-l" lineage)))
        with-slot
          (registry/registry-register-artifact with-entry id
            `(artifact :implementation-slot
               ~(lr-lineage-artifact-name name "--live-slot-l" lineage)))
        with-init
          (registry/registry-register-artifact with-slot id
            `(artifact :slot-initialized
               ~(lr-lineage-artifact-name name "--live-slot-initialized-l" lineage)))
        with-condition
          (registry/registry-register-artifact with-init id
            `(artifact :condition-entry
               ~(lr-lineage-artifact-name name "--live-condition-l" lineage)))]
    (registry/registry-register-artifact with-condition id
      `(artifact :abi-lineage ~lineage ~signature))))

(defn lr-append-generic-template [(live-registry Code) (name Code)] (-> Code)
  (let [record (registry/registry-find live-registry `:function name)
        id (registry/registry-record-id record)
        version (primitive/code-nth record 4)
        with-entry
          (registry/registry-register-artifact live-registry id
            `(artifact :public-entry
               ~(lr-versioned-artifact-name name "--live-generic-entry" version)))]
    (registry/registry-register-artifact with-entry id
      `(artifact :generic-source-template
         ~(registry/registry-function-signature
            (registry/registry-record-form record))))))

(defn lr-record-with-form [(record Code) (form Code)] (-> Code)
  `(live-definition
     ~(registry/registry-record-id record)
     ~(registry/registry-record-kind record)
     ~(registry/registry-record-name record)
     ~(primitive/code-nth record 4)
     ~form
     ~(registry/registry-record-value-dependencies record)
     ~(registry/registry-record-type-dependencies record)
     ~(registry/registry-record-artifacts record)))

(defn lr-versioned-schema-artifact? [(artifact Code)] (-> bool)
  (let [role (primitive/code-nth artifact 1)]
    (cond
      (primitive/code-eq role `:versioned-payload) true
      (primitive/code-eq role `:handle-pointer) true
      (primitive/code-eq role `:handle-cloner) true
      (primitive/code-eq role `:handle-constructor) true
      (primitive/code-eq role `:schema-registrar) true
      (primitive/code-eq role `:schema-destructor) true
      (primitive/code-eq role `:schema-show) true
      (primitive/code-eq role `:schema-json) true
      (primitive/code-eq role `:transition-adapter) true
      (primitive/code-eq role `:transition-abort) true
      (primitive/code-eq role `:transition-retire) true
      (primitive/code-eq role `:transition-registrar) true
      (primitive/code-eq role `:sum-payload-accessor) true
      (primitive/code-eq role `:payload-variant) true
      (primitive/code-eq role `:variant-constructor) true
      (primitive/code-eq role `:field-transition) true
      :else false)))

(defn lr-refresh-schema-artifacts [(live-registry Code) (kind Code)
                                   (name Code)] (-> Code)
  (let [record (registry/registry-find live-registry kind name)
        old (registry/registry-record-artifacts record)
        kept (primitive/code-list-new)]
    (primitive/code-list-push! kept `generated-artifacts)
    (for [i 1 (primitive/code-count old)]
      (let [artifact (primitive/code-nth old i)]
        (if (lr-versioned-schema-artifact? artifact)
            0
            (do (primitive/code-list-push! kept artifact) 0))))
    (lr-register-definition-artifacts
      (registry/registry-replace-record live-registry
        (registry/registry-record-with-artifacts record
          (primitive/code-list-done kept)))
      record)))

(defn lr-refresh-closure-body-artifacts [(live-registry Code)
                                         (name Code)] (-> Code)
  (let [record (registry/registry-find live-registry `:closure name)
        id (registry/registry-record-id record)
        version (primitive/code-nth record 4)
        old (registry/registry-record-artifacts record)
        kept (primitive/code-list-new)]
    (primitive/code-list-push! kept `generated-artifacts)
    (for [i 1 (primitive/code-count old)]
      (let [artifact (primitive/code-nth old i)
            role (primitive/code-nth artifact 1)]
        (if (or (primitive/code-eq role `:private-implementation)
                (primitive/code-eq role `:slot-binder))
            0
            (do (primitive/code-list-push! kept artifact) 0))))
    (let [without-versioned
            (registry/registry-replace-record live-registry
              (registry/registry-record-with-artifacts record
                (primitive/code-list-done kept)))
          with-impl
            (registry/registry-register-artifact without-versioned id
              `(artifact :private-implementation
                 ~(lr-closure-versioned-name name
                    "--live-closure-body-impl" version)))]
      (registry/registry-register-artifact with-impl id
        `(artifact :slot-binder
           ~(lr-closure-versioned-name name
              "--live-closure-body-bind" version))))))

(defn lr-refresh-closure-schema-artifacts [(live-registry Code)
                                           (name Code)] (-> Code)
  (let [record (registry/registry-find live-registry `:closure name)
        old (registry/registry-record-artifacts record)
        kept (primitive/code-list-new)]
    (primitive/code-list-push! kept `generated-artifacts)
    (for [i 1 (primitive/code-count old)]
      (let [artifact (primitive/code-nth old i)
            role (primitive/code-nth artifact 1)]
        (if (or (lr-versioned-schema-artifact? artifact)
                (or (primitive/code-eq role `:private-implementation)
                    (or (primitive/code-eq role `:slot-binder)
                        (or (primitive/code-eq role `:closure-constructor-private)
                            (primitive/code-eq role `:closure-constructor-binder)))))
            0
            (do (primitive/code-list-push! kept artifact) 0))))
    (let [stripped
            (registry/registry-replace-record live-registry
              (registry/registry-record-with-artifacts record
                (primitive/code-list-done kept)))]
      (lr-register-definition-artifacts stripped
        (registry/registry-find stripped `:closure name)))))

(defn lr-refresh-dirty-functions [(live-registry Code) (dirty Code)
                                  (i i64)] (-> Code)
  (if (>= i (primitive/code-count dirty))
      live-registry
      (let [id (primitive/code-nth dirty i)
            record (registry/registry-find-by-id live-registry id)]
        (if (or (not (lr-head? record `live-definition))
                (not (primitive/code-eq
                       (registry/registry-record-kind record) `:function)))
            (lr-refresh-dirty-functions live-registry dirty (+ i 1))
            (let [name (registry/registry-record-name record)
                  bumped (registry/registry-apply-form live-registry
                            (registry/registry-record-form record))
                  refreshed (lr-refresh-function-artifacts bumped name)]
              (lr-refresh-dirty-functions refreshed dirty (+ i 1)))))))

(defn lr-ensure-runtime-source-tokens [(live-registry Code)] (-> Code)
  (let [(mut result) live-registry]
    (for [i 0 (registry/registry-record-count live-registry)]
      (let [record (registry/registry-record-at (load result) i)]
        (if (lr-head?
              (registry/registry-find-artifact record `:runtime-source-token)
              `artifact)
            0
            (set! result
              (registry/registry-register-artifact (load result)
                (registry/registry-record-id record)
                `(artifact :runtime-source-token ~(+ i 1)))))))
    (load result)))

(defn lr-apply-candidate-forms [(live-registry Code) (forms Code)
                                (i i64)] (-> Code)
  (if (>= i (primitive/code-count forms))
      (lr-ensure-runtime-source-tokens live-registry)
      (let [form (primitive/code-nth forms i)
            kind (registry/registry-definition-kind form)]
        (if (or (not (registry/registry-definition? form))
                (<= (primitive/code-count form) 1))
            (lr-apply-candidate-forms live-registry forms (+ i 1))
            (let [name (registry/registry-definition-name form)
                  applied (registry/registry-apply-form live-registry form)
                  refreshed
                    (cond
                      (primitive/code-eq kind `:function)
                        (let [prior (registry/registry-find live-registry `:function name)]
                          (if (lr-head? prior `live-definition)
                              (let [refreshed (lr-refresh-function-artifacts applied name)]
                                (if (primitive/code-vector? (primitive/code-nth form 3))
                                    (let [templated (lr-append-generic-template refreshed name)
                                          seed (registry/registry-record-id
                                                 (registry/registry-find templated
                                                   `:function name))
                                          ; Generic bodies are materialized into each
                                          ; concrete consumer, so their reverse call
                                          ; edges are implementation dependencies even
                                          ; when the source signature is unchanged.
                                          plan (registry/registry-plan-edit templated seed
                                                 `:signature)]
                                      (lr-refresh-dirty-functions templated
                                        (registry/registry-plan-implementations plan) 1))
                                    (if (primitive/code-eq
                                          (registry/registry-function-signature
                                            (registry/registry-record-form prior))
                                          (registry/registry-function-signature form))
                                        refreshed
                                        (lr-append-function-lineage refreshed name))))
                              (lr-register-definition-artifacts applied
                                (registry/registry-find applied `:function name))))
                      (primitive/code-eq kind `:closure)
                        (let [prior (registry/registry-find live-registry `:closure name)
                              impact (if (lr-head? prior `live-definition)
                                         (registry/registry-classify-edit
                                           (registry/registry-record-form prior) form)
                                         `:new)]
                          (cond
                            (primitive/code-eq impact `:body)
                              (lr-refresh-closure-body-artifacts applied name)
                            (primitive/code-eq impact `:capture-schema)
                              (lr-refresh-closure-schema-artifacts applied name)
                            (primitive/code-eq impact `:new)
                              (lr-register-definition-artifacts applied
                                (registry/registry-find applied `:closure name))
                            :else applied))
                      (or (primitive/code-eq kind `:struct)
                          (primitive/code-eq kind `:sum))
                        (let [schema-refreshed
                                (lr-refresh-schema-artifacts applied kind name)
                              seed (registry/registry-record-id
                                     (registry/registry-find schema-refreshed kind name))
                              plan (registry/registry-plan-edit
                                     schema-refreshed seed `:schema)]
                          (lr-refresh-dirty-functions schema-refreshed
                            (registry/registry-plan-implementations plan) 1))
                      (primitive/code-eq kind `:root)
                        (let [prior (registry/registry-find live-registry `:root name)]
                          (if (lr-head? prior `live-definition)
                              applied
                              (lr-register-definition-artifacts applied
                                (registry/registry-find applied `:root name))))
                      (primitive/code-eq kind `:impl)
                        (lr-refresh-impl-methods applied form
                          (registry/registry-impl-method-start form))
                      :else applied)]
              (lr-apply-candidate-forms refreshed forms (+ i 1)))))))

(defn lr-build-registry [(module-id Code) (forms Code)] (-> Code)
  (let [(mut result) (registry/registry-enrich
                       (registry/registry-discover module-id forms))]
    (for [i 0 (registry/registry-record-count (load result))]
      (set! result
        (lr-register-definition-artifacts (load result)
          (registry/registry-record-at (load result) i))))
    (load result)))

(defn lr-register-callback-artifact [(live-registry Code) (function-name Code)
                                     (callback-role Code)] (-> Code)
  (let [record (registry/registry-find live-registry `:function function-name)]
    (if (not (lr-head? record `live-definition))
        (primitive/error "live registry: callback source function is missing")
        (registry/registry-register-artifact live-registry
          (registry/registry-record-id record)
          `(artifact :native-callback ~callback-role ~function-name)))))

(defn lr-registry-demo-self-check [] (-> Code)
  (let [forms `((defstruct Particle [(x i64) (y i64)])
                (defstruct World [(particle Particle)])
                (letonce world (World :particle (Particle :x 0 :y 0)))
                (defn radius [(p Particle)] (-> i64) 14)
                (defn advance [(p Particle)] (-> Particle) p)
                (defn demo_tick [] (-> i64)
                  (do (advance (.particle world)) 0))
                (defn demo_value [(index i64)] (-> i64)
                  (radius (.particle world))))
        built (lr-build-registry `native-demo forms)
        with-tick-callback (lr-register-callback-artifact built `demo_tick `:frame-tick)
        complete (lr-register-callback-artifact with-tick-callback
                   `demo_value `:frame-query)
        tick (registry/registry-find complete `:function `demo_tick)
        value (registry/registry-find complete `:function `demo_value)
        advance (registry/registry-find complete `:function `advance)
        world (registry/registry-find complete `:root `world)
        particle (registry/registry-find complete `:struct `Particle)]
    (if (not (registry/registry-tagged-contains?
               (registry/registry-record-value-dependencies tick)
               `(value-dependency ~(registry/registry-record-id advance) :call)))
        (primitive/error "live demo registry: demo_tick is not linked to advance") 0)
    (if (not (registry/registry-tagged-contains?
               (registry/registry-record-value-dependencies tick)
               `(value-dependency ~(registry/registry-record-id world) :value)))
        (primitive/error "live demo registry: demo_tick is not linked to World root") 0)
    (if (not (registry/registry-tagged-contains?
               (registry/registry-record-type-dependencies advance)
               `(type-dependency ~(registry/registry-record-id particle) :signature)))
        (primitive/error "live demo registry: advance is not linked to Particle") 0)
    (if (not (registry/registry-tagged-contains?
               (registry/registry-record-artifacts tick)
               `(artifact :native-callback :frame-tick demo_tick)))
        (primitive/error "live demo registry: tick callback has no explicit owner") 0)
    (if (not (registry/registry-tagged-contains?
               (registry/registry-record-artifacts value)
               `(artifact :native-callback :frame-query demo_value)))
        (primitive/error "live demo registry: query callback has no explicit owner") 0)
    `(do)))

(defn lr-call-args [(params Code)] (-> Code)
  (let [out (primitive/code-list-new)]
    (for [i 0 (primitive/code-count params)]
      (primitive/code-list-push! out
        (primitive/code-nth (primitive/code-nth params i) 0)))
    (primitive/code-list-done out)))

(defn lr-impl-method-defn [(record Code)] (-> Code)
  (let [method (registry/registry-record-form record)
        name (primitive/code-nth method 0)
        params (primitive/code-nth method 1)
        retform (primitive/code-nth method 2)
        body (primitive/code-list-new)]
    (for [i 3 (primitive/code-count method)]
      (primitive/code-list-push! body (primitive/code-nth method i)))
    `(defn ~name ~params ~retform ~@(primitive/code-list-done body))))

(defn lr-impl-forwarding-method [(record Code)] (-> Code)
  (let [method (registry/registry-record-form record)
        name (primitive/code-nth method 0)
        params (primitive/code-nth method 1)
        retform (primitive/code-nth method 2)
        entry (lr-artifact-symbol record `:public-entry)]
    `(~name ~params ~retform (~entry ~@(lr-call-args params)))))

(defn lr-live-impl-wrapper [(impl-form Code) (live-registry Code)] (-> Code)
  (let [wrapper (primitive/code-list-new)
        impl-name (registry/registry-definition-name impl-form)
        method-start (registry/registry-impl-method-start impl-form)]
    (primitive/code-list-push! wrapper `impl)
    (for [i 1 method-start]
      (primitive/code-list-push! wrapper (primitive/code-nth impl-form i)))
    (for [i method-start (primitive/code-count impl-form)]
      (let [method (primitive/code-nth impl-form i)
            record (registry/registry-find live-registry `:impl-method
                     (registry/registry-impl-method-key impl-name
                       (primitive/code-nth method 0)))]
        (primitive/code-list-push! wrapper
          (lr-impl-forwarding-method record))))
    (primitive/code-list-done wrapper)))

(defn lr-live-impl-defs [(forms Code) (impl-form Code)
                         (live-registry Code) (emit-wrapper bool)] (-> Code)
  (let [out (primitive/code-list-new)
        impl-name (registry/registry-definition-name impl-form)
        method-start (registry/registry-impl-method-start impl-form)]
    (for [i method-start (primitive/code-count impl-form)]
      (let [method (primitive/code-nth impl-form i)
            method-name (registry/registry-impl-method-key impl-name
                          (primitive/code-nth method 0))
            record (registry/registry-find live-registry `:impl-method method-name)
            defn-form (lr-impl-method-defn record)
            rewritten (lr-rewrite-live-function defn-form forms live-registry)]
        (lr-push-list! out
          (if emit-wrapper
              (lr-dynamic-function-defs forms
                (lr-record-with-form record rewritten))
              (lr-dynamic-function-update-defs
                (lr-record-with-form record rewritten))))))
    (if emit-wrapper
        (do
          (primitive/code-list-push! out
            (lr-live-impl-wrapper impl-form live-registry))
          0)
        0)
    (primitive/code-list-done out)))

; The public body is a permanent quiescence boundary. Returns inside user code
; occur in the private implementation, so every public exit releases its lease.
(defn lr-source-runtime-token [(record Code) (context i64)] (-> i64)
  (let [artifact (registry/registry-find-artifact record `:runtime-source-token)]
    (if (not (lr-head? artifact `artifact))
        (cond
          (primitive/code-eq (registry/registry-record-kind record) `:function)
            (primitive/error "live function source entry has no exact runtime gate token")
          (primitive/code-eq (registry/registry-record-kind record) `:closure)
            (primitive/error "live closure source entry has no exact runtime gate token")
          (primitive/code-eq (registry/registry-record-kind record) `:impl-method)
            (primitive/error "live impl-method source entry has no exact runtime gate token")
          :else
            (cond (= context 1)
                    (primitive/error "live generic source entry has no exact runtime gate token")
                  (= context 2)
                    (primitive/error "live dynamic source entry has no exact runtime gate token")
                  (= context 3)
                    (primitive/error "live closure constructor has no exact runtime gate token")
                  :else
                    (primitive/error "live source entry has no exact runtime gate token")))
        (if (!= (primitive/code-count artifact) 3)
            (primitive/error "live source runtime gate token artifact is malformed")
            (if (not (primitive/code-int? (primitive/code-nth artifact 2)))
                (primitive/error "live source runtime gate token is not an integer")
                (primitive/code-int (primitive/code-nth artifact 2)))))))

(defn lr-enter-source-form [(record Code) (context i64)] (-> Code)
  `(~(primitive/syntax->datum `coil_live_enter_source)
     ~(lr-source-runtime-token record context)))

(defn lr-wrap-live-defn [(form Code) (record Code)] (-> Code)
  (let [name (lr-artifact-symbol record `:public-entry)
        ; Generic defns have two adjacent vectors: type parameters, then value
        ; parameters. Ordinary defns have the `(-> ...)` return form at index 3.
        generic? (primitive/code-vector? (primitive/code-nth form 3))
        generics (if generic? (primitive/code-nth form 2) `[])
        params (primitive/code-nth form (if generic? 3 2))
        retform (primitive/code-nth form (if generic? 4 3))
        body-start (if generic? 5 4)
        ret (primitive/code-nth retform 1)
        impl (lr-artifact-symbol record `:private-implementation)
        args (lr-call-args params)
        result (primitive/fresh-identifier "live_result")
        body (let [b (primitive/code-list-new)]
               (for [i body-start (primitive/code-count form)]
                 (primitive/code-list-push! b (primitive/code-nth form i)))
               (primitive/code-list-done b))]
    (if (primitive/code-eq ret `void)
        (if generic?
            `((defn ~impl ~generics ~params ~retform ~@body)
              (defn ~name ~generics ~params ~retform
                ~(lr-enter-source-form record 1)
                (~impl ~@args)
                (~(primitive/syntax->datum `coil_live_exit))
                (primitive/llvm-ir void [] "ret void")))
            `((defn ~impl ~params ~retform
                ~@(let [b (primitive/code-list-new)]
                    (for [i body-start (primitive/code-count form)]
                      (primitive/code-list-push! b (primitive/code-nth form i)))
                    (primitive/code-list-done b)))
              (defn ~name ~params ~retform
                ~(lr-enter-source-form record 1)
                (~impl ~@args)
                (~(primitive/syntax->datum `coil_live_exit))
                (primitive/llvm-ir void [] "ret void"))))
        (if generic?
            `((defn ~impl ~generics ~params ~retform ~@body)
              (defn ~name ~generics ~params ~retform
                ~(lr-enter-source-form record 1)
                (let [~result (~impl ~@args)]
                  (~(primitive/syntax->datum `coil_live_exit))
                  ~result)))
            `((defn ~impl ~params ~retform ~@body)
              (defn ~name ~params ~retform
                ~(lr-enter-source-form record 1)
                (let [~result (~impl ~@args)]
                  (~(primitive/syntax->datum `coil_live_exit))
                  ~result)))))))

(defn lr-artifact-symbol [(record Code) (role Code)] (-> Code)
  (let [artifact (registry/registry-find-artifact record role)]
    (if (or (not (lr-head? artifact `artifact))
            (< (primitive/code-count artifact) 3))
        (cond
          (primitive/code-eq role `:public-entry)
            (primitive/error "live function lowering: public-entry artifact is missing")
          (primitive/code-eq role `:implementation-slot)
            (primitive/error "live function lowering: implementation-slot artifact is missing")
          (primitive/code-eq role `:private-implementation)
            (primitive/error "live function lowering: private-implementation artifact is missing")
          (primitive/code-eq role `:slot-binder)
            (primitive/error "live function lowering: slot-binder artifact is missing")
          (primitive/code-eq role `:slot-initialized)
            (primitive/error "live function lowering: slot-initialized artifact is missing")
          (primitive/code-eq role `:condition-entry)
            (primitive/error "live function lowering: condition-entry artifact is missing")
          :else
            (primitive/error "live function lowering: required artifact is missing"))
        ; Generated artifacts deliberately cross compilation generations. Their
        ; registry descriptor owns identity; their source reference must bind to
        ; the current module's checked ABI declaration, not a prior macro scope.
        (primitive/syntax->datum (primitive/code-nth artifact 2)))))

(defn lr-keyed-artifact-symbol [(record Code) (role Code) (key Code)] (-> Code)
  (let [artifacts (registry/registry-record-artifacts record)
        (mut found) `:missing]
    (for [i 1 (primitive/code-count artifacts)]
      (let [artifact (primitive/code-nth artifacts i)]
        (if (and (registry/registry-artifact-role? artifact role)
                 (and (> (primitive/code-count artifact) 3)
                      (lr-name=? (primitive/code-nth artifact 2) key)))
            (set! found (primitive/syntax->datum (primitive/code-nth artifact 3))) 0)))
    (if (primitive/code-eq (load found) `:missing)
        (primitive/error "live sum lowering: keyed artifact is missing")
        (load found))))

(defn lr-abi-param-type [(forms Code) (T Code)] (-> Code)
  ; Live nominal values cross permanent reload boundaries by stable reference.
  ; This is also the checked fnptr type of the lowered implementation; backend
  ; aggregate classification remains an implementation detail below it.
  (if (or (lr-head? (lr-find-struct forms T 0) `defstruct)
          (lr-head? (lr-find-sum forms T 0) `defsum))
      `(ref ~T)
      T))

(defn lr-abi-param-types [(forms Code) (params Code)] (-> Code)
  (let [out (primitive/code-list-new)]
    (for [i 0 (primitive/code-count params)]
      (primitive/code-list-push! out
        (lr-abi-param-type forms
          (primitive/code-nth (primitive/code-nth params i) 1))))
    (primitive/code-list-done out)))

(defn lr-dynamic-function-defs [(forms Code) (record Code)] (-> Code)
  (let [form (registry/registry-record-form record)]
    (if (not (lr-defn? form))
        (primitive/error "live function lowering: expected a defn") 0)
    (if (primitive/code-vector? (primitive/code-nth form 3))
        (lr-wrap-live-defn form record)
        (let [name (lr-artifact-symbol record `:public-entry)
          params (primitive/code-nth form 2)
          retform (primitive/code-nth form 3)
          ret (primitive/code-nth retform 1)
          impl (lr-artifact-symbol record `:private-implementation)
          slot (lr-artifact-symbol record `:implementation-slot)
          initialized (lr-artifact-symbol record `:slot-initialized)
          binder (lr-artifact-symbol record `:slot-binder)
          condition (lr-artifact-symbol record `:condition-entry)
          abi-params (lr-abi-param-types forms params)
          args (lr-call-args params)
          result (primitive/fresh-identifier "live_result")
          body (let [out (primitive/code-list-new)]
                 (for [i 4 (primitive/code-count form)]
                   (primitive/code-list-push! out (primitive/code-nth form i)))
                 (primitive/code-list-done out))]
      `((defn ~impl ~params ~retform ~@body)
        ~(if (primitive/code-eq ret `void)
             `(defn ~condition ~params ~retform
                (~(primitive/syntax->datum `coil_live_raise_condition) 2 -20)
                ; No restart boundary: release the affected source lease while
                ; parked so the repair transaction can publish, then reacquire
                ; the same exact gate before invoking the repaired slot. The
                ; permanent outer wrapper performs the matching final exit.
                (~(primitive/syntax->datum `coil_live_exit))
                (loop
                  (if (not (~(primitive/syntax->datum
                               `coil_live_condition_active)))
                      (break) 0))
                ~(lr-enter-source-form record 2)
                (let [callee (load (~slot))]
                  (primitive/call-ptr callee ~@args))
                (primitive/llvm-ir void [] "ret void"))
             `(defn ~condition ~params ~retform
                (~(primitive/syntax->datum `coil_live_raise_condition) 2 -20)
                (~(primitive/syntax->datum `coil_live_exit))
                (loop
                  (if (not (~(primitive/syntax->datum
                               `coil_live_condition_active)))
                      (break) 0))
                ~(lr-enter-source-form record 2)
                (let [callee (load (~slot))]
                  (primitive/call-ptr callee ~@args))))
        (defn ~initialized [] (-> (ptr bool))
          (primitive/alloc-static bool))
        (defn ~slot []
          (-> (ptr (fnptr c [~@abi-params] ~ret)))
          (let [cell (primitive/alloc-static (fnptr c [~@abi-params] ~ret))]
            (if (not (load (~initialized)))
                (do (store! cell (primitive/fnptr-of ~impl))
                    (store! (~initialized) true)) 0)
            cell))
        (defn ~binder [] (-> i64)
          (store! (~slot) (primitive/fnptr-of ~impl))
          (store! (~initialized) true)
          0)
        ~(if (primitive/code-eq ret `void)
             `(defn ~name ~params ~retform
                ~(lr-enter-source-form record 2)
                (if (~(primitive/syntax->datum `coil_live_source_broken)
                      ~(lr-source-runtime-token record 2))
                    (~condition ~@args)
                    (let [callee (load (~slot))]
                      (primitive/call-ptr callee ~@args)))
                (~(primitive/syntax->datum `coil_live_exit))
                (primitive/llvm-ir void [] "ret void"))
             `(defn ~name ~params ~retform
                ~(lr-enter-source-form record 2)
                (let [~result
                        (if (~(primitive/syntax->datum `coil_live_source_broken)
                              ~(lr-source-runtime-token record 2))
                            (~condition ~@args)
                            (let [callee (load (~slot))]
                              (primitive/call-ptr callee ~@args)))]
                  (~(primitive/syntax->datum `coil_live_exit))
                  ~result))))))))

(defn lr-dynamic-function-update-defs [(record Code)] (-> Code)
  (let [form (registry/registry-record-form record)
        params (primitive/code-nth form 2)
        retform (primitive/code-nth form 3)
        impl (lr-artifact-symbol record `:private-implementation)
        slot (lr-artifact-symbol record `:implementation-slot)
        initialized (lr-artifact-symbol record `:slot-initialized)
        binder (lr-artifact-symbol record `:slot-binder)
        body (let [out (primitive/code-list-new)]
               (for [i 4 (primitive/code-count form)]
                 (primitive/code-list-push! out (primitive/code-nth form i)))
               (primitive/code-list-done out))]
    `((defn ~impl ~params ~retform ~@body)
      (defn ~binder [] (-> i64)
        (store! (~slot) (primitive/fnptr-of ~impl))
        (store! (~initialized) true)
        0))))

(defn lr-forms-with [(forms Code) (form Code)] (-> Code)
  (let [out (primitive/code-list-new)]
    (for [i 0 (primitive/code-count forms)]
      (primitive/code-list-push! out (primitive/code-nth forms i)))
    (primitive/code-list-push! out form)
    (primitive/code-list-done out)))

(defn lr-closure-runtime-captures [(captures Code)] (-> Code)
  (let [out (primitive/code-list-new)]
    (for [i 0 (primitive/code-count captures)]
      (let [capture (primitive/code-nth captures i)]
        (primitive/code-list-push! out
          `(~(primitive/code-nth capture 0) ~(primitive/code-nth capture 1)))))
    (primitive/code-list-done out)))

(defn lr-closure-capture [(captures Code) (name Code)] (-> Code)
  (let [(mut found) `:missing]
    (for [i 0 (primitive/code-count captures)]
      (let [capture (primitive/code-nth captures i)]
        (if (lr-name=? (primitive/code-nth capture 0) name)
            (set! found capture) 0)))
    (load found)))

(defn lr-closure-transition-marker [(forms Code) (closure-name Code)
                                    (capture-name Code)] (-> Code)
  (let [(mut found) `:missing]
    (for [i 0 (primitive/code-count forms)]
      (let [form (primitive/code-nth forms i)]
        (if (and (lr-marker? form)
                 (and (lr-name=? (primitive/code-nth form 1) closure-name)
                      (lr-name=? (primitive/code-nth form 2) capture-name)))
            (set! found form) 0)))
    (load found)))

(defn lr-closure-environment-args [(forms Code) (live-registry Code)
                                   (closure-name Code)
                                   (accepted-captures Code)
                                   (candidate-captures Code)] (-> Code)
  (let [out (primitive/code-list-new)]
    (for [i 0 (primitive/code-count candidate-captures)]
      (let [capture (primitive/code-nth candidate-captures i)
            name (primitive/code-nth capture 0)
            prior (lr-closure-capture accepted-captures name)]
        (if (primitive/code-list? prior)
            (if (primitive/code-eq (primitive/code-nth prior 1)
                                   (primitive/code-nth capture 1))
                (primitive/code-list-push! out name)
                (let [marker
                        (lr-closure-transition-marker forms closure-name name)]
                  (if (not (primitive/code-list? marker))
                      (do
                        (meta/live-mark-needs-transition!)
                        (primitive/error
                          (primitive/code-str "live closure: capture '"
                            (primitive/code-str name)
                            "' changes type without migrate declaration")))
                      (let [binding (primitive/code-nth marker 3)
                            env (lr-env-bind (lr-env-empty) binding
                                  (primitive/code-nth prior 1))]
                        (primitive/code-list-push! out
                          `(let [~binding ~name]
                             ~(lr-rewrite-live-expr
                                (primitive/code-nth marker 4) env forms
                                live-registry)))))))
            (if (and (> (primitive/code-count capture) 3)
                     (primitive/code-eq (primitive/code-nth capture 2)
                                        `:live-default))
                (primitive/code-list-push! out (primitive/code-nth capture 3))
                (do
                  (meta/live-mark-needs-transition!)
                  (primitive/error
                    (primitive/code-str "live closure: added capture '"
                      (primitive/code-str name)
                      "' requires a default or transition")))))))
    (primitive/code-list-done out)))

(defn lr-closure-constructor-record [(record Code) (form Code)] (-> Code)
  `(live-definition
     ~(registry/registry-record-id record) :function
     ~(lr-artifact-symbol record `:closure-constructor)
     ~(primitive/code-nth record 4) ~form
     (value-dependencies) (type-dependencies)
     (generated-artifacts
       (artifact :public-entry
         ~(lr-artifact-symbol record `:closure-constructor))
       (artifact :private-implementation
         ~(lr-artifact-symbol record `:closure-constructor-private))
       (artifact :implementation-slot
         ~(lr-artifact-symbol record `:closure-constructor-slot))
       (artifact :slot-initialized
         ~(lr-artifact-symbol record `:closure-constructor-initialized))
       (artifact :slot-binder
         ~(lr-artifact-symbol record `:closure-constructor-binder)))))

(defn lr-closure-constructor-abi-captures [(record Code)] (-> Code)
  (let [artifact
          (registry/registry-find-artifact record
            `:closure-constructor-abi-lineage)]
    (if (or (not (lr-head? artifact `artifact))
            (< (primitive/code-count artifact) 4))
        (primitive/error "live closure: constructor ABI lineage is missing")
        (let [signature (primitive/code-nth artifact 3)]
          (if (or (not (lr-head? signature `closure-constructor-signature))
                  (!= (primitive/code-count signature) 2))
              (primitive/error "live closure: constructor ABI lineage is malformed")
              (primitive/code-nth signature 1))))))

(defn lr-closure-constructor-defs [(forms Code) (record Code)
                                   (name Code) (env-name Code)
                                   (captures Code) (env-args Code)
                                   (env-constructor Code)
                                   (emit-public bool)] (-> Code)
  (let [public (lr-artifact-symbol record `:closure-constructor)
        impl (lr-artifact-symbol record `:closure-constructor-private)
        slot (lr-artifact-symbol record `:closure-constructor-slot)
        initialized (lr-artifact-symbol record `:closure-constructor-initialized)
        binder (lr-artifact-symbol record `:closure-constructor-binder)
        abi-params (lr-abi-param-types forms captures)
        args (lr-call-args captures)
        environment (primitive/fresh-identifier "constructed_closure_environment")
        raw (primitive/fresh-identifier "constructed_closure_handle")]
    `((defn ~impl [~@captures] (-> (ptr i8))
        (let [~environment (~env-constructor ~@env-args)
              ~raw (~(lr-artifact-symbol record `:handle-pointer) ~environment)]
          ; Ownership crosses the permanent constructor slot as the stable raw
          ; handle, never as an affine nominal aggregate. Retain the outgoing
          ; claim before the local wrapper performs its ordinary lexical Drop.
          (~(primitive/syntax->datum `coil_live_handle_retain) ~raw)
          ~raw))
      ~@(if emit-public
            `((defn ~initialized [] (-> (ptr bool))
                (primitive/alloc-static bool))
              (defn ~slot []
                (-> (ptr (fnptr c [~@abi-params] (ptr i8))))
                (let [cell
                        (primitive/alloc-static
                          (fnptr c [~@abi-params] (ptr i8)))]
                  (if (not (load (~initialized)))
                      (do (store! cell (primitive/fnptr-of ~impl))
                          (store! (~initialized) true)) 0)
                  cell)))
            `())
      (defn ~binder [] (-> i64)
        (store! (~slot) (primitive/fnptr-of ~impl))
        (store! (~initialized) true)
        0)
      ~@(if emit-public
            `((defn ~public [~@captures] (-> ~name)
                ~(lr-enter-source-form record 3)
                (let [callee (load (~slot))
                      ~raw (primitive/call-ptr callee ~@args)]
                  (~(primitive/syntax->datum `coil_live_exit))
                  (~name :environment ~raw))))
            `()))))

(defn lr-live-closure-defs [(forms Code) (live-registry Code)
                            (form Code) (record Code) (environment-record Code)
                            (constructor-abi-record Code)
                            (emit-public bool) (emit-environment bool)
                            (emit-constructor bool)] (-> Code)
  (let [name (primitive/code-nth form 1)
        captures (primitive/code-nth form 2)
        runtime-captures (lr-closure-runtime-captures captures)
        constructor-captures
          (lr-closure-constructor-abi-captures constructor-abi-record)
        constructor-env-args
          (lr-closure-environment-args forms live-registry name
            constructor-captures
            captures)
        params (primitive/code-nth form 3)
        ret (primitive/code-nth form 4)
        env-name (lr-artifact-symbol record `:closure-environment-type)
        env-form `(defstruct ~env-name ~captures)
        closure-body (lr-artifact-symbol record `:public-entry)
        constructor (lr-artifact-symbol record `:closure-constructor)
        call-adapter (lr-artifact-symbol record `:closure-call-adapter)
        closure-destructor (lr-artifact-symbol record `:closure-destructor)
        env-constructor (lr-artifact-symbol record `:handle-constructor)
        runtime-params (primitive/code-list-new)
        call-args (primitive/code-list-new)
        capture-bindings (primitive/code-list-new)
        (mut body-env) (lr-env-empty)
        rewritten-body (primitive/code-list-new)
        self (primitive/fresh-identifier "live_closure")
        environment (primitive/fresh-identifier "live_closure_environment")]
    (primitive/code-list-push! runtime-params `(~environment (ref ~env-name)))
    (for [i 0 (primitive/code-count captures)]
      (let [capture (primitive/code-nth captures i)
            capture-name (primitive/code-nth capture 0)
            capture-type (primitive/code-nth capture 1)]
        (set! body-env (lr-env-bind (load body-env) capture-name capture-type))
        (primitive/code-list-push! capture-bindings capture-name)
        (primitive/code-list-push! capture-bindings
          `(~(lr-handle-getter-name env-name capture-name
               (primitive/code-nth environment-record 4)) ~environment))))
    (for [i 0 (primitive/code-count params)]
      (let [param (primitive/code-nth params i)
            param-name (primitive/code-nth param 0)
            param-type (primitive/code-nth param 1)]
        (set! body-env (lr-env-bind (load body-env) param-name param-type))
        (primitive/code-list-push! runtime-params
          `(~param-name ~(lr-abi-param-type forms param-type)))
        (primitive/code-list-push! call-args param-name)))
    (for [i 5 (primitive/code-count form)]
      (primitive/code-list-push! rewritten-body
        (lr-rewrite-live-expr (primitive/code-nth form i) (load body-env)
          forms live-registry)))
    (let [body-form
            `(defn ~closure-body [~@(primitive/code-list-done runtime-params)]
               (-> ~ret)
               (let [~@(primitive/code-list-done capture-bindings)]
                 ~@(primitive/code-list-done rewritten-body)))
          body-record (lr-record-with-form record body-form)
          defs (primitive/code-list-new)]
      (if emit-environment
          (lr-push-list! defs
            (lr-live-struct-defs (lr-forms-with forms env-form) live-registry
              env-form record emit-public))
          0)
      (lr-push-list! defs
        (if emit-public
            (lr-dynamic-function-defs (lr-forms-with forms env-form) body-record)
            (lr-dynamic-function-update-defs body-record)))
      (if emit-public
          (do
            (primitive/code-list-push! defs
              `(defstruct ~name [(environment (ptr i8))]))
            (lr-push-list! defs
              (lr-closure-constructor-defs forms record name env-name
                constructor-captures constructor-env-args env-constructor true))
            (primitive/code-list-push! defs
              `(defn ~call-adapter [(~self (ref ~name)) ~@params] (-> ~ret)
                 (let [borrowed-environment
                         (~env-name :live-handle
                           (live-handle-owner-new (.environment ~self)))
                       result
                         (~closure-body borrowed-environment
                           ~@(primitive/code-list-done call-args))]
                   ; This is a typed non-owning view over the closure's own
                   ; handle. The closure remains alive for the duration of the
                   ; call, so suppress destruction of the view.
                   (forget borrowed-environment)
                   result)))
            (primitive/code-list-push! defs
              `(impl Clone ~name
                 (clone [(~self (ref ~name))] (-> ~name)
                   (do
                     (~(primitive/syntax->datum `coil_live_handle_retain)
                       (.environment ~self))
                     (~name :environment (.environment ~self))))))
            (primitive/code-list-push! defs
              `(impl Drop ~name
                 (drop [(~self (mut ~name))] (-> void)
                   (forget
                     (~(primitive/syntax->datum `coil_live_handle_release)
                       (.environment ~self))))))
            (primitive/code-list-push! defs
              `(impl coil.core.Callable ~name
                 (call [(~self (ref ~name)) ~@params] (-> ~ret)
                   (~call-adapter ~self ~@(primitive/code-list-done call-args)))))
            (primitive/code-list-push! defs
              ; The argument is consuming. Callers that want early destruction
              ; transfer a mutable local with `take!`; otherwise normal lexical
              ; Drop releases the environment handle.
              `(defn ~closure-destructor [(~self ~name)] (-> i64) 0))
            0)
          0)
      (if (and (not emit-public) emit-constructor)
          (lr-push-list! defs
            (lr-closure-constructor-defs forms record name env-name
              constructor-captures constructor-env-args env-constructor false))
          0)
      (primitive/code-list-done defs))))

(defn lr-live-struct-defs [(forms Code) (live-registry Code)
                           (decl Code) (record Code)
                           (emit-public bool)] (-> Code)
  (let [T (primitive/code-nth decl 1)
        version (primitive/code-nth record 4)
        Payload (lr-payload-name T version)
        payload-decl (lr-rename-struct (lr-normalize-struct decl) Payload)
        fields (meta/live-struct-fields decl)
        constructor (lr-handle-constructor-name T version)
        registrar (lr-schema-registrar-name T version)
        destructor (lr-artifact-symbol record `:schema-destructor)
        handle-pointer (lr-artifact-symbol record `:handle-pointer)
        handle-cloner (lr-artifact-symbol record `:handle-cloner)
        params (primitive/code-list-new)
        initializers (primitive/code-list-new)
        accessors (primitive/code-list-new)
        handle-fields (primitive/code-list-new)
        payload (primitive/fresh-identifier "live_payload")
        handle (primitive/fresh-identifier "live_handle")]
    (for [i 0 (primitive/code-count fields)]
      (let [field (primitive/code-nth fields i)
            name (primitive/code-nth field 0)
            ty (primitive/code-nth field 1)
            getter (lr-handle-getter-name T name version)
            setter (lr-handle-setter-name T name version)
            nested-live?
              (or (lr-head? (lr-find-struct forms ty 0) `defstruct)
                  (lr-head? (lr-find-sum forms ty 0) `defsum))
            nested-record
              (if nested-live?
                  (registry/registry-find live-registry
                    (if (lr-head? (lr-find-sum forms ty 0) `defsum) `:sum `:struct)
                    ty)
                  `:missing)
            getter-p (primitive/fresh-identifier "live_get_payload")
            setter-p (primitive/fresh-identifier "live_set_payload")
            prior (primitive/fresh-identifier "live_prior_value")
            getter-value (primitive/fresh-identifier "live_get_value")
            setter-value (primitive/fresh-identifier "live_set_value")
            next-value (primitive/fresh-identifier "live_next_value")]
        (if nested-live?
            (do (primitive/code-list-push! handle-fields `(~name ~ty)) 0) 0)
        (primitive/code-list-push! params `(~name ~ty))
        (primitive/code-list-push! initializers
          `(set! (field (primitive/cast (ptr ~Payload) ~payload) ~name) ~name))
        (primitive/code-list-push! accessors
          `(defn ~getter [(~getter-value (ref ~T))] (-> ~ty)
             (let [~getter-p (primitive/cast (ptr ~Payload)
                               (~(primitive/syntax->datum `coil_live_handle_payload)
                                 (~handle-pointer ~getter-value) ~(meta/live-name-hash T)
                                 (~registrar)))]
               ~@(if nested-live?
                     `((~(lr-artifact-symbol nested-record `:handle-cloner)
                         (field ~getter-p ~name)))
                     `((load (field ~getter-p ~name)))))))
        (primitive/code-list-push! accessors
          `(defn ~setter [(~setter-value (mut ~T)) (~next-value ~ty)] (-> i64)
             (let [~setter-p (primitive/cast (ptr ~Payload)
                               (~(primitive/syntax->datum `coil_live_handle_payload)
                                 (~handle-pointer ~setter-value) ~(meta/live-name-hash T)
                                 (~registrar)))]
               ~@(if nested-live?
                     `((let [~prior (take! [~ty] (field ~setter-p ~name))]
                         (store! (field ~setter-p ~name) ~next-value)
                         (~(primitive/syntax->datum `coil_live_handle_release)
                           (~(lr-artifact-symbol nested-record `:handle-pointer) ~prior))
                         (forget ~prior)
                         0))
                     `((store! (field ~setter-p ~name) ~next-value)))
               0)))))
    `(~@(if emit-public
            `((defstruct ~T [(live-handle LiveHandleOwner)])
              (defn ~handle-pointer [(value (ref ~T))] (-> (ptr i8))
                (.raw (.live-handle value)))
              (defn ~handle-cloner [(value (ref ~T))] (-> ~T)
                (let [raw (~handle-pointer value)]
                  (~(primitive/syntax->datum `coil_live_handle_retain) raw)
                  (~T :live-handle
                    (live-handle-owner-new raw)))))
            `())
      ~payload-decl
      (defn ~destructor [(p (ptr i8))] (-> i64)
        (let [owned (load (primitive/cast (ptr ~Payload) p))]
          0)
        0)
      ~@(meta/live-schema-runtime-defs-for-name T payload-decl
          (lr-struct-fingerprint `(do ~decl) decl) registrar
          (lr-artifact-symbol record `:schema-show)
          (lr-artifact-symbol record `:schema-json)
          (primitive/code-list-done handle-fields) destructor)
      (defn ~constructor [~@(primitive/code-list-done params)] (-> ~T)
        (let [~payload (~(primitive/syntax->datum `calloc) 1
                         (primitive/cast u64 (primitive/sizeof ~Payload)))]
          ~@(primitive/code-list-done initializers)
          (let [~handle
                  (~(primitive/syntax->datum `coil_live_handle_new)
                    ~(meta/live-name-hash T)
                    (~registrar) ~payload)]
            (~T :live-handle
              (live-handle-owner-new ~handle)))))
      ~@(primitive/code-list-done accessors))))

(defn lr-live-sum-defs [(forms Code) (live-registry Code)
                        (decl Code) (record Code) (emit-public bool)] (-> Code)
  (let [T (primitive/code-nth decl 1)
        Payload (lr-artifact-symbol record `:versioned-payload)
        PublicT (primitive/datum->syntax Payload
                  (primitive/syntax->datum (primitive/code-nth decl 1)))
        handle-pointer (lr-artifact-symbol record `:handle-pointer)
        handle-cloner (lr-artifact-symbol record `:handle-cloner)
        payload-decl (lr-versioned-sum-decl decl record)
        registrar (lr-artifact-symbol record `:schema-registrar)
        destructor (lr-artifact-symbol record `:schema-destructor)
        accessor (lr-artifact-symbol record `:sum-payload-accessor)
        payload-cloner (lr-lineage-name accessor "--borrowed-clone")
        variants (meta/live-sum-variants decl)
        constructors (primitive/code-list-new)
        clone-arms (primitive/code-list-new)
        value (primitive/fresh-identifier "live_sum_value")
        payload (primitive/fresh-identifier "live_sum_payload")
        handle (primitive/fresh-identifier "live_sum_handle")]
    (for [i 0 (primitive/code-count variants)]
      (let [variant (primitive/code-nth variants i)
            variant-name (primitive/code-nth variant 0)
            fields (if (> (primitive/code-count variant) 1)
                       (primitive/code-nth variant 1) `[])
            params (primitive/code-list-new)
            args (primitive/code-list-new)
            clone-bindings (primitive/code-list-new)
            clone-args (primitive/code-list-new)]
        (for [j 0 (primitive/code-count fields)]
          (let [field (primitive/code-nth fields j)]
            (primitive/code-list-push! params
              `(~(primitive/code-nth field 0) ~(primitive/code-nth field 1)))
            (primitive/code-list-push! args (primitive/code-nth field 0))
            (primitive/code-list-push! clone-bindings (primitive/code-nth field 0))
            (primitive/code-list-push! clone-args
              (lr-live-clone-expression (primitive/code-nth field 1)
                (primitive/code-nth field 0) live-registry))))
        (primitive/code-list-push! clone-arms
          `(~(lr-keyed-artifact-symbol record `:payload-variant variant-name)
            [~@(primitive/code-list-done clone-bindings)]
            (~(lr-keyed-artifact-symbol record `:payload-variant variant-name)
              ~@(primitive/code-list-done clone-args))))
        (primitive/code-list-push! constructors
          `(defn ~(lr-keyed-artifact-symbol record `:variant-constructor variant-name)
             [~@(primitive/code-list-done params)] (-> ~PublicT)
             (let [~payload
                     (~(primitive/syntax->datum `calloc) 1
                       (primitive/cast u64 (primitive/sizeof ~Payload)))]
               (store! (primitive/cast (ptr ~Payload) ~payload)
                 (~(lr-keyed-artifact-symbol record `:payload-variant variant-name)
                   ~@(primitive/code-list-done args)))
               (let [~handle
                       (~(primitive/syntax->datum `coil_live_handle_new)
                         ~(meta/live-name-hash T) (~registrar) ~payload)]
                 (~PublicT :live-handle
                   (live-handle-owner-new ~handle))))))))
    `(~@(if emit-public
            `((defstruct ~PublicT [(live-handle LiveHandleOwner)])
              (defn ~handle-pointer [(value (ref ~PublicT))] (-> (ptr i8))
                (.raw (.live-handle value)))
              (defn ~handle-cloner [(value (ref ~PublicT))] (-> ~PublicT)
                (let [raw (~handle-pointer value)]
                  (~(primitive/syntax->datum `coil_live_handle_retain) raw)
                  (~PublicT :live-handle
                    (live-handle-owner-new raw)))))
            `())
      ~payload-decl
      (defn ~destructor [(p (ptr i8))] (-> i64)
        (let [owned (load (primitive/cast (ptr ~Payload) p))]
          0)
        0)
      ~@(meta/live-sum-schema-runtime-defs-for-name decl payload-decl registrar destructor
          (lr-artifact-symbol record `:schema-show)
          (lr-artifact-symbol record `:schema-json))
      (defn ~payload-cloner [(payload-value (ref ~Payload))] (-> ~Payload)
        (match payload-value
          ~@(primitive/code-list-done clone-arms)))
      (defn ~accessor [(~value (ref ~PublicT))] (-> ~Payload)
        (let [payload-p (primitive/cast (ptr ~Payload)
                          (~(primitive/syntax->datum `coil_live_handle_payload)
                            (~handle-pointer ~value)
                            ~(meta/live-name-hash T)
                            (~registrar)))]
          (~payload-cloner payload-p)))
      ~@(primitive/code-list-done constructors))))

(defn lr-dynamic-function-update-test [(Particle Code) (radius-name Code)] (-> Code)
  (let [forms `((defstruct ~Particle [(x i64)])
                (defn ~radius-name [(p ~Particle)] (-> i64) (+ (.x p) 1)))
        built (lr-build-registry `dynamic-function-test forms)
        radius (registry/registry-find built `:function radius-name)
        defs (lr-dynamic-function-update-defs radius)]
    `(do ~@defs)))

(defn lr-dynamic-function-bind-test [(radius-name Code)] (-> Code)
  `(~(lr-lineage-name radius-name "--live-bind-l0")))

(defn lr-dynamic-scalar-self-check [(function-name Code)] (-> Code)
  (let [forms `((defn ~function-name [(value i64)] (-> i64) value))
        built (lr-build-registry `dynamic-scalar-test forms)
        record (registry/registry-find built `:function function-name)]
    `(do ~@(lr-dynamic-function-defs forms record))))

(defn lr-dynamic-scalar-update-test [(function-name Code)] (-> Code)
  (let [forms `((defn ~function-name [(value i64)] (-> i64) (+ value 1)))
        built (lr-build-registry `dynamic-scalar-test forms)
        record (registry/registry-find built `:function function-name)]
    `(do ~@(lr-dynamic-function-update-defs record))))

(defn lr-dynamic-scalar-broken-test [(function-name Code)] (-> Code)
  (let [forms `((defn ~function-name [(value i64)] (-> i64) true))
        built (lr-build-registry `dynamic-scalar-test forms)
        record (registry/registry-find built `:function function-name)]
    `(do ~@(lr-dynamic-function-update-defs record))))

(defn lr-dynamic-function-self-check [(Particle Code) (radius-name Code)] (-> Code)
  (let [forms `((defstruct ~Particle [(x i64)])
                (defn ~radius-name [(p ~Particle)] (-> i64) (.x p)))
        built (lr-build-registry `dynamic-function-test forms)
        radius (registry/registry-find built `:function radius-name)
        defs (lr-dynamic-function-defs forms radius)]
    `(do
       (defstruct ~Particle [(x i64)])
       ~@defs)))

(defn lr-first-marker-for-type? [(forms Code) (T Code) (before i64)] (-> bool)
  (let [(mut i) 0 (mut first) true]
    (loop (if (>= (load i) before)
              (break)
              (let [form (primitive/code-nth forms (load i))]
                (if (and (lr-marker? form) (lr-name=? (primitive/code-nth form 1) T))
                    (do (set! first false) (break))
                    (set! i (+ (load i) 1))))))
    (load first)))

(defn lr-markers-for-type [(forms Code) (T Code)] (-> Code)
  (let [out (primitive/code-list-new)]
    (for [i 0 (primitive/code-count forms)]
      (let [form (primitive/code-nth forms i)]
        (if (and (lr-marker? form) (lr-name=? (primitive/code-nth form 1) T))
            (do (primitive/code-list-push! out form) 0)
            0)))
    (primitive/code-list-done out)))

(defn lr-rewrite-markers-for-type [(markers Code) (T Code)
                                   (old-decl Code) (forms Code)
                                   (live-registry Code)] (-> Code)
  (let [out (primitive/code-list-new)]
    (for [i 0 (primitive/code-count markers)]
      (let [marker (primitive/code-nth markers i)]
        (if (and (lr-marker? marker) (lr-name=? (primitive/code-nth marker 1) T))
            (let [field (primitive/code-nth marker 2)
                  binding (primitive/code-nth marker 3)
                  old-index (meta/live-raw-field-index old-decl field)
                  record (registry/registry-find live-registry `:struct T)
                  env (if (>= old-index 0)
                          (lr-env-bind (lr-env-empty) binding
                            (meta/live-raw-field-type old-decl old-index))
                          (lr-env-empty))]
              (primitive/code-list-push! out
                `(live-migrate-declaration ~T ~field ~binding
                   ~(lr-rewrite-live-expr (primitive/code-nth marker 4)
                      env forms live-registry)
                   ~(lr-keyed-artifact-symbol record `:field-transition field)))
              0)
            0)))
    (primitive/code-list-done out)))

(defn lr-rewrite-closure-markers [(markers Code) (closure-name Code)
                                  (env-name Code) (old-env Code)
                                  (forms Code) (live-registry Code)] (-> Code)
  (let [out (primitive/code-list-new)
        record (registry/registry-find live-registry `:closure closure-name)]
    (for [i 0 (primitive/code-count markers)]
      (let [marker (primitive/code-nth markers i)]
        (if (and (lr-marker? marker)
                 (lr-name=? (primitive/code-nth marker 1) closure-name))
            (let [field (primitive/code-nth marker 2)
                  binding (primitive/code-nth marker 3)
                  old-index (meta/live-raw-field-index old-env field)
                  env (if (>= old-index 0)
                          (lr-env-bind (lr-env-empty) binding
                            (meta/live-raw-field-type old-env old-index))
                          (lr-env-empty))]
              (primitive/code-list-push! out
                `(live-migrate-declaration ~env-name ~field ~binding
                   ~(lr-rewrite-live-expr (primitive/code-nth marker 4)
                      env forms live-registry)
                   ~(lr-keyed-artifact-symbol record `:field-transition field)))
              0)
            0)))
    (primitive/code-list-done out)))

(defn lr-rewrite-sum-transition-artifacts [(form Code) (record Code)
                                            (decl Code)] (-> Code)
  (if (not (primitive/code-list? form))
      form
      (let [out (primitive/code-list-new)]
        (for [i 0 (primitive/code-count form)]
          (let [item (primitive/code-nth form i) (mut replaced) false]
            (if (primitive/code-sym? item)
                (let [variants (meta/live-sum-variants decl)]
                  (for [j 0 (primitive/code-count variants)]
                    (let [variant-name
                            (primitive/code-nth (primitive/code-nth variants j) 0)]
                      (if (primitive/code-eq item
                            (lr-keyed-artifact-symbol record `:variant-constructor
                              variant-name))
                          (do
                            (primitive/code-list-push! out
                              (lr-keyed-artifact-symbol record `:payload-variant
                                variant-name))
                            (set! replaced true))
                          0))))
                0)
            (if (not (load replaced))
                (do
                  (primitive/code-list-push! out
                    (lr-rewrite-sum-transition-artifacts item record decl))
                  0)
                0)))
        (let [done (primitive/code-list-done out)]
          (if (primitive/code-vector? form) `[~@done] done)))))

(defn lr-sum-marker-bindings [(binding Code) (fields Code)
                               (variant-name Code)] (-> Code)
  (if (primitive/code-vector? binding)
      (if (= (primitive/code-count binding) (primitive/code-count fields))
          binding
          (primitive/error
            (primitive/code-str "live sum migration: binding count for variant '"
              (primitive/code-str variant-name) "' does not match its payload")))
      (if (= (primitive/code-count fields) 1)
          `[~binding]
          (if (and (= (primitive/code-count fields) 0)
                   (primitive/code-eq binding `_))
              `[]
              (primitive/error
                (primitive/code-str "live sum migration: variant '"
                  (primitive/code-str variant-name)
                  "' requires a binding vector matching its payload"))))))

(defn lr-rewrite-sum-markers-for-type [(markers Code) (T Code)
                                       (old-decl Code) (new-decl Code)
                                       (forms Code) (live-registry Code)] (-> Code)
  (let [out (primitive/code-list-new)
        record (registry/registry-find live-registry `:sum T)]
    (for [i 0 (primitive/code-count markers)]
      (let [marker (primitive/code-nth markers i)]
        (if (and (lr-marker? marker) (lr-name=? (primitive/code-nth marker 1) T))
            (let [variant-name (primitive/code-nth marker 2)
                  old-index (meta/live-sum-variant-index old-decl variant-name)]
              (if (< old-index 0)
                  (primitive/error
                    (primitive/code-str "live sum migration: unknown old variant '"
                      (primitive/code-str variant-name) "'"))
                  0)
              (let [variant
                      (primitive/code-nth (meta/live-sum-variants old-decl) old-index)
                    fields (if (> (primitive/code-count variant) 1)
                               (primitive/code-nth variant 1) `[])
                    bindings
                      (lr-sum-marker-bindings (primitive/code-nth marker 3)
                        fields variant-name)
                    (mut env) (lr-env-empty)]
                (for [j 0 (primitive/code-count fields)]
                  (set! env
                    (lr-env-bind (load env) (primitive/code-nth bindings j)
                      (primitive/code-nth (primitive/code-nth fields j) 1))))
                (primitive/code-list-push! out
                  `(live-migrate-declaration ~T ~variant-name ~bindings
                     ~(lr-rewrite-sum-transition-artifacts
                        (lr-rewrite-live-expr (primitive/code-nth marker 4)
                          (load env) forms live-registry)
                        record new-decl)))
                0))
            0)))
    (primitive/code-list-done out)))

(defn lr-registrar-name [(T Code)] (-> Code)
  (primitive/datum->syntax T
    (primitive/syntax->datum (primitive/code-symbol T "--live-register-edge"))))

(defn lr-old-declaration? [(forms Code) (form Code)] (-> bool)
  (let [(mut i) 0 (mut historical) false]
    (loop (if (or (load historical) (>= (load i) (primitive/code-count forms)))
              (break)
              (let [other (primitive/code-nth forms (load i))]
                (if (and (or (lr-head? other `defstruct) (lr-head? other `defsum))
                         (lr-name=? (primitive/code-nth form 1)
                                    (lr-old-name (primitive/code-nth other 1))))
                    (set! historical true)
                    (set! i (+ (load i) 1))))))
    (load historical)))

(defn lr-register-schemas [(forms Code) (live-registry Code) (i i64)] (-> Code)
  (if (>= i (primitive/code-count forms))
      (lr-commit-types forms live-registry 0)
      (let [form (primitive/code-nth forms i)]
        (if (lr-head? form `defclosure)
            (let [record (registry/registry-find live-registry `:closure
                           (primitive/code-nth form 1))
                  schema (primitive/fresh-identifier "closure_registered_schema")]
              `(let [~schema (~(lr-artifact-symbol record `:schema-registrar))]
                 (if (< ~schema 0)
                     (do (~(primitive/syntax->datum `coil_live_cancel_staged_locked))
                         (~(primitive/syntax->datum `coil_live_set_status) ~schema))
                     ~(lr-register-schemas forms live-registry (+ i 1)))))
            (if (and (or (lr-head? form `defstruct) (lr-head? form `defsum))
                 (and (not (lr-old-declaration? forms form))
                      (not (lr-head?
                             (lr-find-struct forms
                               (lr-old-name (primitive/code-nth form 1)) 0)
                             `defstruct))))
            (let [schema (primitive/fresh-identifier "registered_schema")
                  record (registry/registry-find live-registry
                           (if (lr-head? form `defstruct) `:struct `:sum)
                           (primitive/code-nth form 1))]
              `(let [~schema (~(lr-artifact-symbol record `:schema-registrar))]
                 (if (< ~schema 0)
                     (do (~(primitive/syntax->datum `coil_live_cancel_staged_locked))
                         (~(primitive/syntax->datum `coil_live_set_status) ~schema))
                     ~(lr-register-schemas forms live-registry (+ i 1)))))
                (lr-register-schemas forms live-registry (+ i 1)))))))

(defn lr-register-type-roots [(forms Code) (roots Code) (T Code)
                               (schema Code) (i i64) (next Code)] (-> Code)
  (if (>= i (primitive/code-count roots))
      next
      (let [root (primitive/code-nth roots i)]
        (if (lr-name=? (lr-letonce-type forms root) T)
            (let [status (primitive/fresh-identifier "root_status")]
              `(let [~status (~(lr-root-register (primitive/code-nth root 1)) ~schema)]
                 (if (< ~status 0)
                     (do (~(primitive/syntax->datum `coil_live_cancel_staged_locked))
                         (~(primitive/syntax->datum `coil_live_set_status) ~status))
                     ~(lr-register-type-roots forms roots T schema (+ i 1) next))))
            (lr-register-type-roots forms roots T schema (+ i 1) next)))))

(defn lr-register-all-roots [(forms Code) (live-registry Code)
                             (roots Code) (i i64) (next Code)] (-> Code)
  (if (>= i (primitive/code-count roots))
      next
      (let [root (primitive/code-nth roots i)
            T (lr-letonce-type forms root)
            closure-record (registry/registry-find live-registry `:closure T)
            schema (primitive/fresh-identifier "root_schema")
            status (primitive/fresh-identifier "root_status")]
        `(let [~schema
                ~(if (lr-head? closure-record `live-definition)
                     `(~(lr-artifact-symbol closure-record `:schema-registrar))
                     `(~(primitive/syntax->datum `coil_live_latest_schema)
                       ~(meta/live-name-hash T)))]
           (if (< ~schema 0)
               (~(primitive/syntax->datum `coil_live_set_status) -21)
               (let [~status (~(lr-root-register (primitive/code-nth root 1)) ~schema)]
                 (if (< ~status 0)
                     (~(primitive/syntax->datum `coil_live_set_status) ~status)
                     ~(lr-register-all-roots forms live-registry roots
                        (+ i 1) next))))))))

(defn lr-commit-types [(forms Code) (live-registry Code) (i i64)] (-> Code)
  (if (>= i (primitive/code-count forms))
      (lr-register-all-roots forms live-registry (lr-letonces forms) 0
        `(~(primitive/syntax->datum `coil_live_publish_staged_locked)))
      (let [form (primitive/code-nth forms i)]
        (if (and (lr-head? form `defstruct)
                 (lr-head? (lr-find-struct forms (lr-old-name (primitive/code-nth form 1)) 0)
                           `defstruct))
            (let [schema (primitive/fresh-identifier "candidate_schema")
                  staged (primitive/fresh-identifier "stage_status")
                  T (primitive/code-nth form 1)]
              `(let [~schema (~(lr-registrar-name T))]
                 (if (< ~schema 0)
                     (do (~(primitive/syntax->datum `coil_live_cancel_staged_locked))
                         (~(primitive/syntax->datum `coil_live_set_status) ~schema))
                     ~(lr-register-type-roots forms (lr-letonces forms) T schema 0
                        `(let [~staged
                                (~(primitive/syntax->datum `coil_live_stage_type_roots_locked)
                                  ~(meta/live-name-hash T) ~schema)]
                           (if (!= ~staged 0)
                               (do (~(primitive/syntax->datum `coil_live_cancel_staged_locked))
                                   (~(primitive/syntax->datum `coil_live_set_status) ~staged))
                               ~(lr-commit-types forms live-registry (+ i 1))))))))
            (lr-commit-types forms live-registry (+ i 1))))))

(defn lr-bind-live-functions [(live-registry Code) (i i64)] (-> Code)
  (if (>= i (registry/registry-record-count live-registry))
      `0
      (let [record (registry/registry-record-at live-registry i)]
        (if (or (and (primitive/code-eq
                       (registry/registry-record-kind record) `:function)
                     (not (primitive/code-vector?
                            (primitive/code-nth
                              (registry/registry-record-form record) 3))))
                (primitive/code-eq
                  (registry/registry-record-kind record) `:impl-method)
                (primitive/code-eq
                  (registry/registry-record-kind record) `:closure))
            `(do (~(lr-artifact-symbol record `:slot-binder))
                 ~@(if (primitive/code-eq
                          (registry/registry-record-kind record) `:closure)
                       `((~(lr-artifact-symbol record
                              `:closure-constructor-binder)))
                       `())
                 ~(lr-bind-live-functions live-registry (+ i 1)))
            (lr-bind-live-functions live-registry (+ i 1))))))

(defn lr-source-kind-code [(kind Code)] (-> i64)
  (cond
    (primitive/code-eq kind `:function) 1
    (primitive/code-eq kind `:struct) 2
    (primitive/code-eq kind `:sum) 3
    (primitive/code-eq kind `:root) 4
    (primitive/code-eq kind `:migration) 5
    (primitive/code-eq kind `:export) 6
    (primitive/code-eq kind `:trait) 7
    (primitive/code-eq kind `:impl) 8
    (primitive/code-eq kind `:impl-method) 9
    (primitive/code-eq kind `:closure) 10
    :else 0))

(defn lr-begin-affected-publication [(next Code)] (-> Code)
  (let [status (primitive/fresh-identifier "affected_gate_status")]
    `(let [~status
            (~(primitive/syntax->datum `coil_live_begin_affected_publication))]
       (if (!= ~status 0)
           (do
             (~(primitive/syntax->datum `coil_live_cancel_staged_locked))
             (~(primitive/syntax->datum `coil_live_set_status) ~status))
           ~next))))

(defn lr-source-runtime-name [(name Code)] (-> Code)
  (if (or (primitive/code-sym? name) (primitive/code-string? name))
      name
      (primitive/syntax->datum
        (primitive/code-symbol "live-source-"
          (meta/live-declaration-hash name)))))

(defn lr-stage-changed-source-ids [(accepted-registry Code)
                                   (candidate-registry Code) (i i64)
                                   (next Code)] (-> Code)
  (if (>= i (registry/registry-record-count candidate-registry))
      next
      (let [candidate (registry/registry-record-at candidate-registry i)
            accepted (registry/registry-find-by-id accepted-registry
                       (registry/registry-record-id candidate))
            changed (or (not (lr-head? accepted `live-definition))
                        (not (primitive/code-eq (primitive/code-nth accepted 4)
                                                (primitive/code-nth candidate 4))))]
        (if (not changed)
            (lr-stage-changed-source-ids accepted-registry candidate-registry
              (+ i 1) next)
            (let [name (registry/registry-record-name candidate)
                  identity (lr-source-runtime-token candidate 0)
                  runtime-name (lr-source-runtime-name name)
                  literal (meta/live-c-literal runtime-name)
                  status (primitive/fresh-identifier "affected_status")]
              `(let [~status
                      (~(primitive/syntax->datum `coil_live_stage_affected)
                        ~identity
                        ~(lr-source-kind-code
                           (registry/registry-record-kind candidate))
                        (primitive/cast (ptr u8) ~literal)
                        ~(slice-len (primitive/code-str runtime-name)))]
                 (if (!= ~status 0)
                     (do
                       (~(primitive/syntax->datum `coil_live_cancel_staged_locked))
                       (~(primitive/syntax->datum `coil_live_set_status) ~status))
                     ~(lr-stage-changed-source-ids accepted-registry
                        candidate-registry (+ i 1) next))))))))

(defn lr-lower [(parsed Code)] (-> Code)
  (let [forms (if (lr-head? parsed `do) (primitive/code-rest parsed) parsed)
        live-registry (lr-build-registry `replsession forms)
        out (primitive/code-list-new)]
    (primitive/code-list-push! out `(import "coil.primitive" :as primitive))
    (primitive/code-list-push! out `(import "coil.alloc" :as alloc))
    (primitive/code-list-push! out
      `(extern ~(primitive/syntax->datum `calloc) :cc c [u64 u64] (-> (ptr i8))))
    (primitive/code-list-push! out
      `(extern ~(primitive/syntax->datum `coil_live_latest_schema) :cc c [i64] (-> i64)))
    (primitive/code-list-push! out
      `(extern ~(primitive/syntax->datum `coil_live_register_type) :cc c
         [(ptr u8) i64 i64 i64 i64 i64 i64 (ptr i8) (ptr i8)] (-> i64)))
    (primitive/code-list-push! out
      `(extern ~(primitive/syntax->datum `coil_live_register_field) :cc c
         [i64 i64 (ptr u8) i64 (ptr u8) i64 i64] (-> i64)))
    (primitive/code-list-push! out
      `(extern ~(primitive/syntax->datum `coil_live_register_type_kind) :cc c
         [i64 i64] (-> i64)))
    (primitive/code-list-push! out
      `(extern ~(primitive/syntax->datum `coil_live_register_variant) :cc c
         [i64 i64 (ptr u8) i64 i64] (-> i64)))
    (primitive/code-list-push! out
      `(extern ~(primitive/syntax->datum `coil_live_register_variant_field) :cc c
         [i64 i64 (ptr u8) i64 (ptr u8) i64] (-> i64)))
    (primitive/code-list-push! out
      `(extern ~(primitive/syntax->datum `coil_live_register_transition) :cc c
         [i64 i64 i64 (ptr i8) (ptr i8) (ptr i8)] (-> i64)))
    (primitive/code-list-push! out
      `(extern ~(primitive/syntax->datum `coil_live_register_root) :cc c
         [(ptr u8) i64 i64 i64 (ptr (ptr i8))] (-> i64)))
    (primitive/code-list-push! out
      `(extern ~(primitive/syntax->datum `coil_live_register_handle_root) :cc c
         [(ptr u8) i64 (ptr i8)] (-> i64)))
    (primitive/code-list-push! out
      `(extern ~(primitive/syntax->datum `coil_live_register_reference_field) :cc c
         [i64 i64 i64 i64] (-> i64)))
    (primitive/code-list-push! out
      `(extern ~(primitive/syntax->datum `coil_live_register_schema_destructor) :cc c
         [i64 (ptr i8)] (-> i64)))
    (primitive/code-list-push! out
      `(extern ~(primitive/syntax->datum `coil_live_begin_staging_locked) :cc c [] (-> i64)))
    (primitive/code-list-push! out
      `(extern ~(primitive/syntax->datum `coil_live_stage_type_roots_locked) :cc c [i64 i64] (-> i64)))
    (primitive/code-list-push! out
      `(extern ~(primitive/syntax->datum `coil_live_publish_staged_locked) :cc c [] (-> i64)))
    (primitive/code-list-push! out
      `(extern ~(primitive/syntax->datum `coil_live_cancel_staged_locked) :cc c [] (-> i64)))
    (primitive/code-list-push! out
      `(extern ~(primitive/syntax->datum `coil_live_stage_affected) :cc c
         [i64 i64 (ptr u8) i64] (-> i64)))
    (primitive/code-list-push! out
      `(extern ~(primitive/syntax->datum `coil_live_begin_affected_publication)
         :cc c [] (-> i64)))
    (primitive/code-list-push! out
      `(extern ~(primitive/syntax->datum `coil_live_set_status) :cc c [i64] (-> i64)))
    (primitive/code-list-push! out
      `(extern ~(primitive/syntax->datum `coil_live_raise_condition) :cc c [i64 i64] (-> i64)))
    (primitive/code-list-push! out
      `(extern ~(primitive/syntax->datum `coil_live_condition_active) :cc c [] (-> bool)))
    (primitive/code-list-push! out
      `(extern ~(primitive/syntax->datum `coil_live_source_broken) :cc c [i64] (-> bool)))
    (primitive/code-list-push! out
      `(extern ~(primitive/syntax->datum `coil_live_mark_source_broken) :cc c [i64] (-> i64)))
    (primitive/code-list-push! out
      `(extern ~(primitive/syntax->datum `coil_live_clear_broken_sources) :cc c [] (-> i64)))
    (primitive/code-list-push! out
      `(extern ~(primitive/syntax->datum `coil_live_enter_source) :cc c
         [i64] (-> i64)))
    (primitive/code-list-push! out
      `(extern ~(primitive/syntax->datum `coil_live_exit) :cc c [] (-> i64)))
    (primitive/code-list-push! out
      `(extern ~(primitive/syntax->datum `coil_live_reload_requested) :cc c [] (-> bool)))
    (primitive/code-list-push! out
      `(extern ~(primitive/syntax->datum `coil_live_handle_new) :cc c
         [i64 i64 (ptr i8)] (-> (ptr i8))))
    (primitive/code-list-push! out
      `(extern ~(primitive/syntax->datum `coil_live_handle_payload) :cc c
         [(ptr i8) i64 i64] (-> (ptr i8))))
    (primitive/code-list-push! out
      `(extern ~(primitive/syntax->datum `coil_live_handle_retain) :cc c
         [(ptr i8)] (-> i64)))
    (primitive/code-list-push! out
      `(extern ~(primitive/syntax->datum `coil_live_handle_release) :cc c
         [(ptr i8)] (-> i64)))
    (primitive/code-list-push! out
      `(impl Clone LiveHandleOwner
         (clone [(self (ref LiveHandleOwner))] (-> LiveHandleOwner)
           (do
             (~(primitive/syntax->datum `coil_live_handle_retain) (.raw self))
             (live-handle-owner-new (.raw self))))))
    (primitive/code-list-push! out
      `(impl Drop LiveHandleOwner
         (drop [(self (mut LiveHandleOwner))] (-> void)
           (forget
             (~(primitive/syntax->datum `coil_live_handle_release) (.raw self))))))
    (for [i 0 (primitive/code-count forms)]
      (let [form (primitive/code-nth forms i)]
        (cond
          (lr-marker? form) 0
          (lr-letonce? form) (lr-push-list! out
                                   (lr-letonce-defs forms form live-registry))
          (lr-head? form `defsum)
            (let [T (primitive/code-nth form 1)
                  record (registry/registry-find live-registry `:sum T)]
              (lr-push-list! out
                (lr-live-sum-defs forms live-registry form record
                  (not (lr-old-declaration? forms form)))))
          (lr-head? form `defstruct)
            (let [T (primitive/code-nth form 1)
                  OldDecl (lr-find-struct forms (lr-old-name T) 0)
                  record (registry/registry-find live-registry `:struct T)]
              (lr-push-list! out
                (lr-live-struct-defs forms live-registry form record
                  (not (lr-old-declaration? forms form))))
              (if (lr-head? OldDecl `defstruct)
                  (do
                    (lr-push-list! out
                      (meta/live-migrate-edge-from-declarations-name
                        T OldDecl form (lr-markers-for-type forms T)
                        (lr-artifact-symbol record `:transition-adapter)
                        (lr-artifact-symbol record `:transition-abort)
                        (lr-artifact-symbol record `:transition-retire)))
                    (lr-push-list! out
                      (meta/live-edge-runtime-defs-name T
                        (lr-artifact-symbol record `:transition-adapter)
                        (lr-artifact-symbol record `:transition-abort)
                        (lr-artifact-symbol record `:transition-retire)
                        (lr-artifact-symbol record `:transition-registrar)
                        (lr-artifact-symbol record `:schema-registrar))))
                  0))
          (lr-head? form `defclosure)
            (let [record (registry/registry-find live-registry `:closure
                           (primitive/code-nth form 1))]
              (lr-push-list! out
                (lr-live-closure-defs forms live-registry form record record record
                  true true true)))
          (lr-head? form `impl)
            (lr-push-list! out
              (lr-live-impl-defs forms form live-registry true))
          :else
            (if (lr-defn? form)
                  (let [live-rewritten (lr-rewrite-live-function form forms live-registry)
                        record (registry/registry-find live-registry `:function
                                 (primitive/code-nth live-rewritten 1))]
                    (lr-push-list! out
                      (lr-dynamic-function-defs forms
                        `(live-definition
                           ~(registry/registry-record-id record)
                           ~(registry/registry-record-kind record)
                           ~(registry/registry-record-name record)
                           ~(primitive/code-nth record 4)
                           ~live-rewritten
                           ~(registry/registry-record-value-dependencies record)
                           ~(registry/registry-record-type-dependencies record)
                           ~(registry/registry-record-artifacts record)))))
                  (do
                    (primitive/code-list-push! out
                      (lr-rewrite-root-refs form (lr-letonces forms)))
                    0)))))
    (primitive/code-list-push! out
      `(defn ~(primitive/syntax->datum `__live_candidate_commit) [] (-> i64)
         (let [status
                 (do (~(primitive/syntax->datum `coil_live_begin_staging_locked))
                     ~(lr-stage-changed-source-ids
                        `(live-registry replsession) live-registry 0
                        (lr-begin-affected-publication
                          (lr-register-schemas forms live-registry 0))))]
           (if (= status 0)
               ~(lr-bind-live-functions live-registry 0)
               status))))
    `(do ~@(primitive/code-list-done out))))

; Normal Coil source uses the built-in s-expression reader. `migrate` is a
; reader-level declaration, just like `letonce`; neither is a runtime DSL.
(defn lr-normal-form [(form Code)] (-> Code)
  (cond
    (and (lr-head? form `migrate) (= (primitive/code-count form) 5))
      `(live-migrate-declaration ~(primitive/code-nth form 1)
                                 ~(primitive/code-nth form 2)
                                 ~(primitive/code-nth form 3)
                                 ~(primitive/code-nth form 4))
    (lr-head? form `defstruct)
      (let [fields (primitive/code-nth form (- (primitive/code-count form) 1))
            normalized (primitive/code-list-new)]
        (for [i 0 (primitive/code-count fields)]
          (let [field (primitive/code-nth fields i)]
            (primitive/code-list-push! normalized
              (if (= (primitive/code-count field) 3)
                  `(~(primitive/code-nth field 0)
                    ~(primitive/code-nth field 1)
                    :live-default
                    ~(primitive/code-nth field 2))
                  field))))
        (if (= (primitive/code-count form) 3)
            `(defstruct ~(primitive/code-nth form 1)
               [~@(primitive/code-list-done normalized)])
            `(defstruct ~(primitive/code-nth form 1) ~(primitive/code-nth form 2)
               [~@(primitive/code-list-done normalized)])))
    (lr-head? form `defclosure)
      (let [captures (primitive/code-nth form 2)
            normalized (primitive/code-list-new)
            out (primitive/code-list-new)]
        (for [i 0 (primitive/code-count captures)]
          (let [capture (primitive/code-nth captures i)]
            (primitive/code-list-push! normalized
              (if (= (primitive/code-count capture) 3)
                  `(~(primitive/code-nth capture 0)
                    ~(primitive/code-nth capture 1)
                    :live-default
                    ~(primitive/code-nth capture 2))
                  capture))))
        (primitive/code-list-push! out `defclosure)
        (primitive/code-list-push! out (primitive/code-nth form 1))
        (primitive/code-list-push! out `[~@(primitive/code-list-done normalized)])
        (for [i 3 (primitive/code-count form)]
          (primitive/code-list-push! out (primitive/code-nth form i)))
        (primitive/code-list-done out))
    :else form))

(defn lr-normal-forms [(source Code)] (-> Code)
  (let [parsed (primitive/code-read source
                 `(reader-config :unquote #\~ :alternate-unquote #\, :splice #\@))
        forms (if (lr-head? parsed `do) (primitive/code-rest parsed) parsed)
        out (primitive/code-list-new)]
    (for [i 0 (primitive/code-count forms)]
      (primitive/code-list-push! out (lr-normal-form (primitive/code-nth forms i))))
    (primitive/code-list-done out)))

(defn lr-same-definition? [(a Code) (b Code)] (-> bool)
  (if (or (not (primitive/code-list? a)) (not (primitive/code-list? b)))
      false
      (if (or (< (primitive/code-count a) 2) (< (primitive/code-count b) 2))
          false
          (let [a-kind (registry/registry-definition-kind a)
                b-kind (registry/registry-definition-kind b)]
            (and (primitive/code-eq a-kind b-kind)
                 (and (not (primitive/code-eq a-kind `:none))
                      (lr-name=? (registry/registry-definition-name a)
                                 (registry/registry-definition-name b))))))))

(defn lr-incoming-replaces? [(incoming Code) (old Code)] (-> bool)
  (let [(mut found) false]
    (for [i 0 (primitive/code-count incoming)]
      (if (lr-same-definition? (primitive/code-nth incoming i) old)
          (set! found true) 0))
    (load found)))

(defn lr-later-replaces? [(incoming Code) (at i64)] (-> bool)
  (let [(mut i) (+ at 1) (mut found) false
        current (primitive/code-nth incoming at)]
    (loop (if (or (load found) (>= (load i) (primitive/code-count incoming)))
              (break)
              (if (lr-same-definition? (primitive/code-nth incoming (load i)) current)
                  (set! found true)
                  (set! i (+ (load i) 1)))))
    (load found)))

(defn lr-validate-duplicate-migrations! [(incoming Code)] (-> i64)
  (for [i 0 (primitive/code-count incoming)]
    (let [candidate (primitive/code-nth incoming i)]
      (if (lr-head? candidate `defstruct)
          (for [field-index 0
                (primitive/code-count (meta/live-struct-fields candidate))]
            (if (and (meta/live-raw-field-default? candidate field-index)
                     (not (meta/live-pure-expr?
                            (meta/live-raw-field-default candidate field-index))))
                (primitive/error
                  (primitive/code-str "live default for field '"
                    (primitive/code-str
                      (meta/live-raw-field-name candidate field-index))
                    "' is not pure"))
                0))
          0)
      (if (lr-marker? candidate)
          (do
            (if (not (meta/live-pure-expr? (primitive/code-nth candidate 4)))
                (primitive/error
                  (primitive/code-str "live migration for '"
                    (primitive/code-str (primitive/code-nth candidate 1)) "."
                    (primitive/code-str (primitive/code-nth candidate 2))
                    "' is not pure")) 0)
            (for [j 0 i]
              (let [prior (primitive/code-nth incoming j)]
                (if (and (lr-marker? prior)
                         (and (lr-name=? (primitive/code-nth prior 1)
                                        (primitive/code-nth candidate 1))
                              (lr-name=? (primitive/code-nth prior 2)
                                        (primitive/code-nth candidate 2))))
                    (primitive/error
                      (primitive/code-str "duplicate migrate declaration for '"
                        (primitive/code-str (primitive/code-nth candidate 1)) "."
                        (primitive/code-str (primitive/code-nth candidate 2)) "'"))
                    0))))
          0)))
  0)

; Last submitted definition wins. Migration declarations are edit edges rather
; than permanent definitions, so an old edge is never carried into a later edit.
(defn lr-merge-forms [(accepted Code) (incoming Code)] (-> Code)
  (let [out (primitive/code-list-new)]
    (for [i 0 (primitive/code-count accepted)]
      (let [form (primitive/code-nth accepted i)]
        (if (or (lr-marker? form) (lr-incoming-replaces? incoming form))
            0
            (do (primitive/code-list-push! out form) 0))))
    ; A pending branch can contain several repair snippets. Collapse those too,
    ; so the newest declaration in the branch is the one the checker sees.
    (for [i 0 (primitive/code-count incoming)]
      (if (lr-later-replaces? incoming i)
          0
          (do (primitive/code-list-push! out (primitive/code-nth incoming i)) 0)))
    (primitive/code-list-done out)))

(defn lr-pending-collapse-self-check [] (-> Code)
  (let [incoming
          `((defsum Visibility (Hidden) (Visible))
            (defstruct Particle [(visible Visibility)])
            (defsum Visibility (Hidden) (Visible))
            (defstruct Particle [(visible Visibility :live-default (Visible))])
            (live-migrate-declaration Particle visible old
              (if old (Visible) (Hidden))))
        collapsed (lr-merge-forms `[] incoming)
        (mut visibility-count) 0
        (mut particle-count) 0]
    (for [i 0 (primitive/code-count collapsed)]
      (let [form (primitive/code-nth collapsed i)]
        (if (and (lr-head? form `defsum)
                 (lr-name=? (primitive/code-nth form 1) `Visibility))
            (set! visibility-count (+ (load visibility-count) 1)) 0)
        (if (and (lr-head? form `defstruct)
                 (lr-name=? (primitive/code-nth form 1) `Particle))
            (set! particle-count (+ (load particle-count) 1)) 0)))
    (if (or (!= (load visibility-count) 1) (!= (load particle-count) 1))
        (primitive/error "live pending branch did not collapse duplicate source identities") 0)
    `(do)))

(defn lr-pending-collapse-source-self-check [(source Code)] (-> Code)
  (let [collapsed (lr-merge-forms `[] (lr-normal-forms source))
        (mut visibility-count) 0
        (mut particle-count) 0]
    (for [i 0 (primitive/code-count collapsed)]
      (let [form (primitive/code-nth collapsed i)]
        (if (and (lr-head? form `defsum)
                 (lr-name=? (primitive/code-nth form 1) `Visibility))
            (set! visibility-count (+ (load visibility-count) 1)) 0)
        (if (and (lr-head? form `defstruct)
                 (lr-name=? (primitive/code-nth form 1) `Particle))
            (set! particle-count (+ (load particle-count) 1)) 0)))
    (if (or (!= (load visibility-count) 1) (!= (load particle-count) 1))
        (primitive/error
          (primitive/code-str "live parsed pending branch retained Visibility="
            (load visibility-count) " Particle=" (load particle-count))) 0)
    `(do)))

; The complete accepted source model is one immutable Code value owned by the
; compiler SDK session. It contains both the normalized original forms and the
; exact source/artifact registry derived from them. The controller never owns a
; duplicate accepted-source history and never tells this metaprogram whether a
; program has already been published.
(defn lr-program-state? [(state Code)] (-> bool)
  (lr-head? state `live-program-state))

(defn lr-program-state-forms [(state Code)] (-> Code)
  (if (lr-program-state? state)
      (primitive/code-nth state 1)
      (primitive/error "live-submit-coil: corrupt retained program state")))

(defn lr-program-state-registry [(state Code)] (-> Code)
  (if (lr-program-state? state)
      (primitive/code-nth state 2)
      (primitive/error "live-submit-coil: corrupt retained program registry")))

(defn lr-make-program-state [(forms Code)] (-> Code)
  `(live-program-state ~forms ~(lr-build-registry `replsession forms)))

(defn lr-stage-program-state! [(state Code)] (-> i64)
  (primitive/code-session-stage! state))

(defn lr-register-accepted-trait-use [(live-registry Code) (item Code)] (-> Code)
  (if (or (not (lr-head? item `trait-use))
          (< (primitive/code-count item) 6))
      live-registry
      (let [caller-artifact (primitive/code-nth item 1)
            (mut result) live-registry]
        (for [i 0 (registry/registry-record-count live-registry)]
          (let [record (registry/registry-record-at live-registry i)
                artifacts (registry/registry-record-artifacts record)]
            (for [j 1 (primitive/code-count artifacts)]
              (let [artifact (primitive/code-nth artifacts j)]
                (if (and (lr-head? artifact `artifact)
                         (and (> (primitive/code-count artifact) 2)
                              (primitive/code-sym? (primitive/code-nth artifact 2))))
                    (if (lr-name=? (primitive/code-nth artifact 2) caller-artifact)
                        (do
                          (set! result
                            (registry/registry-register-artifact (load result)
                              (registry/registry-record-id record)
                              `(artifact :trait-use
                                 ~(primitive/code-nth item 2)
                                 ~(primitive/code-nth item 3)
                                 ~(primitive/code-nth item 4)
                                 ~(primitive/code-nth item 5))))
                          0)
                        0)
                    0)))))
        (load result))))

(defn lr-register-accepted-concrete-monomorph [(live-registry Code)
                                                (item Code)] (-> Code)
  (if (or (not (lr-head? item `monomorph))
          (< (primitive/code-count item) 7))
      live-registry
      (let [source-artifact (primitive/code-nth item 2)
            (mut result) live-registry]
        (for [i 0 (registry/registry-record-count live-registry)]
          (let [record (registry/registry-record-at live-registry i)
                artifacts (registry/registry-record-artifacts record)]
            (for [j 1 (primitive/code-count artifacts)]
              (let [artifact (primitive/code-nth artifacts j)]
                (if (and (lr-head? artifact `artifact)
                         (and (> (primitive/code-count artifact) 2)
                              (primitive/code-sym? (primitive/code-nth artifact 2))))
                    (if (lr-name=? (primitive/code-nth artifact 2) source-artifact)
                        (do
                          (set! result
                            (registry/registry-register-artifact (load result)
                              (registry/registry-record-id record)
                              `(artifact :concrete-monomorph
                                 ~(primitive/code-nth item 1)
                                 ~source-artifact
                                 ~(primitive/code-nth item 3)
                                 ~(primitive/code-nth item 4)
                                 ~(primitive/code-nth item 5)
                                 ~(primitive/code-nth item 6))))
                          0)
                        0)
                    0)))))
        ; Not every compiler monomorph belongs to a live source definition:
        ; imports and compiler-generated support code are expected here. Exact
        ; artifact ownership, not a guessed spelling, decides membership.
        (load result))))

(defn lr-register-accepted-monomorphs [(live-registry Code)
                                       (report Code) (i i64)] (-> Code)
  (if (or (not (lr-head? report `monomorph-artifacts))
          (>= i (primitive/code-count report)))
      live-registry
      (let [item (primitive/code-nth report i)
            with-trait-use
              (lr-register-accepted-trait-use live-registry item)
            with-monomorph
              (lr-register-accepted-concrete-monomorph with-trait-use item)]
        (lr-register-accepted-monomorphs with-monomorph report (+ i 1)))))

(defn live-accepted-artifact-count [(role Code)] (-> Code)
  (let [state (primitive/code-session-state `:empty)]
    (if (not (lr-program-state? state))
        `0
        (let [registry (lr-register-accepted-monomorphs
                         (lr-program-state-registry state)
                         (primitive/code-session-monomorphs) 1)
              (mut count) 0]
          (for [i 0 (registry/registry-record-count registry)]
            (let [artifacts
                    (registry/registry-record-artifacts
                      (registry/registry-record-at registry i))]
              (for [j 1 (primitive/code-count artifacts)]
                (if (registry/registry-artifact-role?
                      (primitive/code-nth artifacts j) role)
                    (set! count (+ (load count) 1)) 0))))
          `~(load count)))))

; Structural observability for the compiler-to-metaprogram provenance boundary.
; This reports compiler records before registry ownership filtering, allowing
; tests and tooling to distinguish a missing compiler edge from an ownership
; mismatch without inspecting generated spellings.
(defn live-accepted-provenance-count [(role Code)] (-> Code)
  (let [report (primitive/code-session-monomorphs)
        report-head (if (primitive/code-eq role `:trait-use) `trait-use role)
        (mut count) 0]
    (if (lr-head? report `monomorph-artifacts)
        (for [i 1 (primitive/code-count report)]
          (if (lr-head? (primitive/code-nth report i) report-head)
              (set! count (+ (load count) 1))
              0))
        0)
    `~(load count)))

(defn lr-bind-changed-functions [(accepted-registry Code)
                                 (candidate-registry Code) (i i64)
                                 (next Code)] (-> Code)
  (if (>= i (registry/registry-record-count candidate-registry))
      next
      (let [candidate (registry/registry-record-at candidate-registry i)
            accepted (registry/registry-find-by-id accepted-registry
                       (registry/registry-record-id candidate))]
        (if (and (or (and (primitive/code-eq
                            (registry/registry-record-kind candidate) `:function)
                          (not (primitive/code-vector?
                                 (primitive/code-nth
                                   (registry/registry-record-form candidate) 3))))
                     (primitive/code-eq
                       (registry/registry-record-kind candidate) `:impl-method)
                     (primitive/code-eq
                       (registry/registry-record-kind candidate) `:closure))
                 (or (not (lr-head? accepted `live-definition))
                     (not (primitive/code-eq (primitive/code-nth accepted 4)
                                             (primitive/code-nth candidate 4)))))
            `(do (~(lr-artifact-symbol candidate `:slot-binder))
                 ~@(if (primitive/code-eq
                          (registry/registry-record-kind candidate) `:closure)
                       `((~(lr-artifact-symbol candidate
                              `:closure-constructor-binder)))
                       `())
                 ~(lr-bind-changed-functions accepted-registry candidate-registry
                    (+ i 1) next))
            (lr-bind-changed-functions accepted-registry candidate-registry
              (+ i 1) next)))))

(defn lr-publish-and-clear-broken [] (-> Code)
  (let [status (primitive/fresh-identifier "live_publish_status")]
    `(let [~status (~(primitive/syntax->datum `coil_live_publish_staged_locked))]
       (if (= ~status 0)
           (~(primitive/syntax->datum `coil_live_clear_broken_sources)) 0)
       ~status)))

; A rejected function body is never lowered into native code. Compute every
; changed seed, then use the registry's exact reverse call closure so callers
; raise before caller-local effects rather than reaching Broken halfway through
; a native turn.
(defn lr-broken-seed-ids [(accepted-registry Code)
                          (candidate-registry Code)] (-> Code)
  (let [ids (primitive/code-list-new)]
    (for [i 0 (registry/registry-record-count candidate-registry)]
      (let [candidate (registry/registry-record-at candidate-registry i)
            accepted (registry/registry-find-by-id accepted-registry
                       (registry/registry-record-id candidate))]
        (if (and (lr-head? accepted `live-definition)
                 (not (primitive/code-eq (primitive/code-nth accepted 4)
                                         (primitive/code-nth candidate 4))))
            (if (and (primitive/code-eq
                       (registry/registry-record-kind candidate) `:function)
                     (and (not (primitive/code-vector?
                                 (primitive/code-nth
                                   (registry/registry-record-form candidate) 3)))
                          (primitive/code-eq
                            (registry/registry-function-signature
                              (registry/registry-record-form accepted))
                            (registry/registry-function-signature
                              (registry/registry-record-form candidate)))))
                (do
                  (primitive/code-list-push! ids
                    (registry/registry-record-id candidate))
                  0)
                (primitive/error
                  "live rejected candidate cannot publish Broken for this ABI change"))
            0)))
    (primitive/code-list-done ids)))

(defn lr-bind-broken-ids [(accepted-registry Code) (ids Code) (i i64)
                          (next Code)] (-> Code)
  (if (>= i (primitive/code-count ids))
      next
      (let [accepted (registry/registry-find-by-id accepted-registry
                       (primitive/code-nth ids i))
            kind (registry/registry-record-kind accepted)
            form (registry/registry-record-form accepted)]
        (if (and (or (primitive/code-eq kind `:function)
                     (or (primitive/code-eq kind `:closure)
                         (primitive/code-eq kind `:impl-method)))
                 (not (and (primitive/code-eq kind `:function)
                           (primitive/code-vector? (primitive/code-nth form 3)))))
            `(do
               (~(primitive/syntax->datum `coil_live_mark_source_broken)
                 ~(lr-source-runtime-token accepted 0))
               ~(lr-bind-broken-ids accepted-registry ids (+ i 1) next))
            (primitive/error
              "live rejected caller closure contains a generic or unsupported ABI entry")))))

(defn lr-stage-affected-ids [(live-registry Code) (ids Code) (i i64)
                             (next Code)] (-> Code)
  (if (>= i (primitive/code-count ids)) next
      (let [record (registry/registry-find-by-id live-registry
                     (primitive/code-nth ids i))
            name (registry/registry-record-name record)
            runtime-name (lr-source-runtime-name name)
            literal (meta/live-c-literal runtime-name)
            status (primitive/fresh-identifier "broken_affected_status")]
        `(let [~status
                (~(primitive/syntax->datum `coil_live_stage_affected)
                  ~(lr-source-runtime-token record 0)
                  ~(lr-source-kind-code (registry/registry-record-kind record))
                  (primitive/cast (ptr u8) ~literal)
                  ~(slice-len (primitive/code-str runtime-name)))]
           (if (!= ~status 0)
               (do (~(primitive/syntax->datum `coil_live_cancel_staged_locked))
                   (~(primitive/syntax->datum `coil_live_set_status) ~status))
               ~(lr-stage-affected-ids live-registry ids (+ i 1) next))))))

(defn lr-incremental-commit [(incoming Code) (accepted-registry Code)
                             (candidate-registry Code) (i i64)
                             (next Code)] (-> Code)
  (if (< i 0)
      `(do
         (~(primitive/syntax->datum `coil_live_begin_staging_locked))
         ~(lr-stage-changed-source-ids accepted-registry candidate-registry 0
            (lr-begin-affected-publication next)))
      (let [form (primitive/code-nth incoming i)
            kind (registry/registry-definition-kind form)]
        (cond
          (primitive/code-eq kind `:function)
            (lr-incremental-commit incoming accepted-registry candidate-registry
              (- i 1) next)
          (primitive/code-eq kind `:closure)
            (let [name (primitive/code-nth form 1)
                  accepted (registry/registry-find accepted-registry `:closure name)
                  candidate (registry/registry-find candidate-registry `:closure name)
                  impact (registry/registry-classify-edit
                           (registry/registry-record-form accepted) form)]
              (if (primitive/code-eq impact `:capture-schema)
                  (let [env-name
                          (lr-artifact-symbol candidate `:closure-environment-type)
                        schema (primitive/fresh-identifier "closure_schema")
                        staged (primitive/fresh-identifier "closure_stage_status")]
                    (lr-incremental-commit incoming accepted-registry candidate-registry
                      (- i 1)
                      `(let [~schema
                              (~(lr-artifact-symbol candidate `:transition-registrar))]
                         (if (< ~schema 0)
                             (do
                               (~(primitive/syntax->datum `coil_live_cancel_staged_locked))
                               (~(primitive/syntax->datum `coil_live_set_status) ~schema))
                             (let [~staged
                                     (~(primitive/syntax->datum
                                         `coil_live_stage_type_roots_locked)
                                       ~(meta/live-name-hash env-name) ~schema)]
                               (if (!= ~staged 0)
                                   (do
                                     (~(primitive/syntax->datum
                                         `coil_live_cancel_staged_locked))
                                     (~(primitive/syntax->datum
                                         `coil_live_set_status) ~staged))
                                   ~next))))))
                  (lr-incremental-commit incoming accepted-registry candidate-registry
                    (- i 1) next)))
          (primitive/code-eq kind `:struct)
            (let [T (primitive/code-nth form 1)
                  accepted (registry/registry-find accepted-registry `:struct T)
                  candidate (registry/registry-find candidate-registry `:struct T)]
              (if (not (lr-head? accepted `live-definition))
                  (lr-incremental-commit incoming accepted-registry candidate-registry
                    (- i 1) next)
                  (let [schema (primitive/fresh-identifier "candidate_schema")
                        staged (primitive/fresh-identifier "stage_status")]
                    (lr-incremental-commit incoming accepted-registry candidate-registry
                      (- i 1)
                      `(let [~schema
                              (~(lr-artifact-symbol candidate `:transition-registrar))]
                         (if (< ~schema 0)
                             (do
                               (~(primitive/syntax->datum `coil_live_cancel_staged_locked))
                               (~(primitive/syntax->datum `coil_live_set_status) ~schema))
                             (let [~staged
                                     (~(primitive/syntax->datum
                                         `coil_live_stage_type_roots_locked)
                                       ~(meta/live-name-hash T) ~schema)]
                               (if (!= ~staged 0)
                                   (do
                                     (~(primitive/syntax->datum
                                         `coil_live_cancel_staged_locked))
                                     (~(primitive/syntax->datum
                                         `coil_live_set_status) ~staged))
                                   ~next))))))))
          (primitive/code-eq kind `:sum)
            (let [T (primitive/code-nth form 1)
                  accepted (registry/registry-find accepted-registry `:sum T)
                  candidate (registry/registry-find candidate-registry `:sum T)
                  schema (primitive/fresh-identifier "candidate_sum_schema")]
              (if (lr-head? accepted `live-definition)
                  (let [staged (primitive/fresh-identifier "sum_stage_status")]
                    (lr-incremental-commit incoming accepted-registry candidate-registry
                      (- i 1)
                      `(let [~schema
                              (~(lr-artifact-symbol candidate `:transition-registrar))]
                         (if (< ~schema 0)
                             (do
                               (~(primitive/syntax->datum `coil_live_cancel_staged_locked))
                               (~(primitive/syntax->datum `coil_live_set_status) ~schema))
                             (let [~staged
                                     (~(primitive/syntax->datum
                                         `coil_live_stage_type_roots_locked)
                                       ~(meta/live-name-hash T) ~schema)]
                               (if (!= ~staged 0)
                                   (do
                                     (~(primitive/syntax->datum
                                         `coil_live_cancel_staged_locked))
                                     (~(primitive/syntax->datum
                                         `coil_live_set_status) ~staged))
                                   ~next))))))
                  (lr-incremental-commit incoming accepted-registry candidate-registry
                    (- i 1)
                    `(let [~schema (~(lr-artifact-symbol candidate `:schema-registrar))]
                       (if (< ~schema 0)
                           (do
                             (~(primitive/syntax->datum `coil_live_cancel_staged_locked))
                             (~(primitive/syntax->datum `coil_live_set_status) ~schema))
                           ~next)))))
          (primitive/code-eq kind `:root)
            (let [initializer (primitive/code-nth form 2)
                  T (if (and (primitive/code-list? initializer)
                             (> (primitive/code-count initializer) 0))
                        (lr-registry-constructor-type candidate-registry
                          (primitive/code-nth initializer 0))
                        (primitive/error
                          "live root initializer must construct a live struct or sum"))
                  struct-record (registry/registry-find candidate-registry `:struct T)
                  sum-record (registry/registry-find candidate-registry `:sum T)
                  type-record (if (lr-head? struct-record `live-definition)
                                  struct-record sum-record)
                  schema (primitive/fresh-identifier "root_schema")
                  status (primitive/fresh-identifier "root_status")]
              (if (not (lr-head? type-record `live-definition))
                  (primitive/error
                    (primitive/code-str "live root '"
                      (primitive/code-str (primitive/code-nth form 1))
                      "' does not have a live struct or sum type")) 0)
              (lr-incremental-commit incoming accepted-registry candidate-registry
                (- i 1)
                `(let [~schema (~(lr-artifact-symbol type-record `:schema-registrar))
                       ~status (~(lr-root-register (primitive/code-nth form 1)) ~schema)]
                   (if (< ~status 0)
                       (do
                         (~(primitive/syntax->datum `coil_live_cancel_staged_locked))
                         (~(primitive/syntax->datum `coil_live_set_status) ~status))
                       ~next))))
          :else
            (lr-incremental-commit incoming accepted-registry candidate-registry
              (- i 1) next)))))

(defn lr-incoming-depends-on-id? [(incoming Code) (live-registry Code)
                                  (target-id Code)] (-> bool)
  (let [(mut found) false]
    (for [i 0 (primitive/code-count incoming)]
      (let [form (primitive/code-nth incoming i)]
        (if (and (lr-defn? form) (not (load found)))
            (let [record (registry/registry-find live-registry `:function
                           (primitive/code-nth form 1))
                  dependencies
                    (if (lr-head? record `live-definition)
                        (registry/registry-record-value-dependencies record)
                        `())]
              (for [j 1 (primitive/code-count dependencies)]
                (let [dependency (primitive/code-nth dependencies j)]
                  (if (and (lr-head? dependency `value-dependency)
                           (primitive/code-eq
                             (primitive/code-nth dependency 1) target-id))
                      (set! found true)
                      0))))
            0)))
    (load found)))

(defn lr-code-contains-name? [(form Code) (name Code)] (-> bool)
  (if (primitive/code-sym? form)
      (lr-name=? form name)
      (if (not (primitive/code-list? form))
          false
          (let [(mut found) false]
            (for [i 0 (primitive/code-count form)]
              (if (and (not (load found))
                       (lr-code-contains-name? (primitive/code-nth form i) name))
                  (set! found true)
                  0))
            (load found)))))

(defn lr-incoming-uses-trait? [(incoming Code) (trait-form Code)] (-> bool)
  (let [(mut used) false]
    (for [i 2 (primitive/code-count trait-form)]
      (let [method (primitive/code-nth trait-form i)]
        (if (and (primitive/code-list? method)
                 (> (primitive/code-count method) 0))
            (for [j 0 (primitive/code-count incoming)]
              (let [incoming-form (primitive/code-nth incoming j)]
                (if (and (lr-defn? incoming-form)
                         (and (not (load used))
                              (lr-code-contains-name? incoming-form
                                (primitive/code-nth method 0))))
                    (set! used true)
                    0)))
            0)))
    (load used)))

(defn lr-impl-trait-name [(impl-form Code)] (-> Code)
  (if (primitive/code-vector? (primitive/code-nth impl-form 1))
      (primitive/code-nth impl-form 2)
      (primitive/code-nth impl-form 1)))

; A new caller must be expanded with the accepted source-level trait selection
; environment. Emit the original trait declaration and the current dynamic impl
; wrappers from the registry; never infer or inspect compiler-generated method
; symbols. The wrappers route every method through its stable live slot.
(defn lr-emit-required-trait-closure! [(out CodeBuilder) (incoming Code)
                                       (live-registry Code)] (-> i64)
  (for [i 0 (registry/registry-record-count live-registry)]
    (let [trait-record (registry/registry-record-at live-registry i)]
      (if (primitive/code-eq (registry/registry-record-kind trait-record) `:trait)
          (let [trait-form (registry/registry-record-form trait-record)
                trait-name (registry/registry-record-name trait-record)]
            (if (lr-incoming-uses-trait? incoming trait-form)
                (do
                  (primitive/code-list-push! out trait-form)
                  (for [j 0 (registry/registry-record-count live-registry)]
                    (let [impl-record (registry/registry-record-at live-registry j)]
                      (if (and (primitive/code-eq
                                 (registry/registry-record-kind impl-record) `:impl)
                               (lr-name=?
                                 (lr-impl-trait-name
                                   (registry/registry-record-form impl-record))
                                 trait-name))
                          (do
                            (primitive/code-list-push! out
                              (lr-live-impl-wrapper
                                (registry/registry-record-form impl-record)
                                live-registry))
                            0)
                          0)))
                  0)
                0))
          0)))
  0)

(defn lr-incremental-lower [(old-forms Code) (new-forms Code) (incoming Code)
                            (accepted-registry Code)
                            (candidate-registry Code)] (-> Code)
  (let [out (primitive/code-list-new)]
    (lr-emit-required-trait-closure! out incoming candidate-registry)
    (for [i 0 (primitive/code-count incoming)]
      (let [form (primitive/code-nth incoming i)
            kind (registry/registry-definition-kind form)]
        (cond
          (primitive/code-eq kind `:struct)
            (let [T (primitive/code-nth form 1)
                  accepted (registry/registry-find accepted-registry `:struct T)
                  candidate (registry/registry-find candidate-registry `:struct T)]
              (if (not (lr-head? accepted `live-definition))
                  (primitive/error "live incremental schema addition is not implemented")
                  (let [old-form (registry/registry-record-form accepted)
                        old-payload
                          (lr-rename-struct old-form
                            (lr-artifact-symbol accepted `:versioned-payload))
                        new-payload
                          (lr-rename-struct form
                            (lr-artifact-symbol candidate `:versioned-payload))]
                    (lr-push-list! out
                      (lr-live-struct-defs new-forms candidate-registry form
                        candidate false))
                    (lr-push-list! out
                      (meta/live-migrate-edge-from-declarations-name
                        T old-payload new-payload
                        (lr-rewrite-markers-for-type incoming T old-form
                          new-forms candidate-registry)
                        (lr-artifact-symbol candidate `:transition-adapter)
                        (lr-artifact-symbol candidate `:transition-abort)
                        (lr-artifact-symbol candidate `:transition-retire)))
                    (lr-push-list! out
                      (meta/live-edge-runtime-defs-name T
                        (lr-artifact-symbol candidate `:transition-adapter)
                        (lr-artifact-symbol candidate `:transition-abort)
                        (lr-artifact-symbol candidate `:transition-retire)
                        (lr-artifact-symbol candidate `:transition-registrar)
                        (lr-artifact-symbol candidate `:schema-registrar))))))
          (primitive/code-eq kind `:sum)
            (let [T (primitive/code-nth form 1)
                  accepted (registry/registry-find accepted-registry `:sum T)
                  candidate (registry/registry-find candidate-registry `:sum T)]
              (if (lr-head? accepted `live-definition)
                  (let [old-form (registry/registry-record-form accepted)
                        old-payload (lr-versioned-sum-decl old-form accepted)
                        new-payload (lr-versioned-sum-decl form candidate)]
                    (lr-push-list! out
                      (lr-live-sum-defs new-forms candidate-registry form candidate false))
                    (lr-push-list! out
                      (meta/live-sum-edge-from-declarations-name
                        old-form form old-payload new-payload
                        (lr-rewrite-sum-markers-for-type incoming T old-form form
                          new-forms candidate-registry)
                        (lr-artifact-symbol candidate `:transition-adapter)
                        (lr-artifact-symbol candidate `:transition-abort)
                        (lr-artifact-symbol candidate `:transition-retire)))
                    (lr-push-list! out
                      (meta/live-edge-runtime-defs-name T
                        (lr-artifact-symbol candidate `:transition-adapter)
                        (lr-artifact-symbol candidate `:transition-abort)
                        (lr-artifact-symbol candidate `:transition-retire)
                        (lr-artifact-symbol candidate `:transition-registrar)
                        (lr-artifact-symbol candidate `:schema-registrar))))
                  (lr-push-list! out
                    (lr-live-sum-defs new-forms candidate-registry form candidate true))))
          (primitive/code-eq kind `:function) 0
          (primitive/code-eq kind `:closure)
            (let [name (primitive/code-nth form 1)
                  accepted (registry/registry-find accepted-registry `:closure name)
                  candidate (registry/registry-find candidate-registry `:closure name)
                  impact (registry/registry-classify-edit
                           (registry/registry-record-form accepted) form)]
              (if (primitive/code-eq impact `:body)
                  (lr-push-list! out
                    (lr-live-closure-defs new-forms candidate-registry form
                      candidate accepted accepted false false false))
                  (if (primitive/code-eq impact `:capture-schema)
                      (let [env-name
                              (lr-artifact-symbol candidate `:closure-environment-type)
                            old-env
                              `(defstruct ~env-name
                                 ~(primitive/code-nth
                                    (registry/registry-record-form accepted) 2))
                            new-env
                              `(defstruct ~env-name ~(primitive/code-nth form 2))
                            old-payload
                              (lr-rename-struct old-env
                                (lr-artifact-symbol accepted `:versioned-payload))
                            new-payload
                              (lr-rename-struct new-env
                                (lr-artifact-symbol candidate `:versioned-payload))]
                        (lr-push-list! out
                          (lr-live-closure-defs new-forms candidate-registry form
                            candidate candidate accepted false true true))
                        (lr-push-list! out
                          (meta/live-migrate-edge-from-declarations-name
                            env-name old-payload new-payload
                            (lr-rewrite-closure-markers incoming name env-name
                              old-env new-forms candidate-registry)
                            (lr-artifact-symbol candidate `:transition-adapter)
                            (lr-artifact-symbol candidate `:transition-abort)
                            (lr-artifact-symbol candidate `:transition-retire)))
                        (lr-push-list! out
                          (meta/live-edge-runtime-defs-name env-name
                            (lr-artifact-symbol candidate `:transition-adapter)
                            (lr-artifact-symbol candidate `:transition-abort)
                            (lr-artifact-symbol candidate `:transition-retire)
                            (lr-artifact-symbol candidate `:transition-registrar)
                            (lr-artifact-symbol candidate `:schema-registrar))))
                      (primitive/error
                        "live closure signature edit lowering is not implemented"))))
          (primitive/code-eq kind `:root)
            (lr-push-list! out (lr-letonce-defs new-forms form candidate-registry))
          (primitive/code-eq kind `:impl)
            (lr-push-list! out
              (lr-live-impl-defs new-forms form candidate-registry false))
          (primitive/code-eq kind `:trait)
            (primitive/error
              "live trait declaration edits require dependent impl rebuilding")
          (or (primitive/code-eq kind `:migration)
              (primitive/code-eq kind `:none))
            (if (primitive/code-eq kind `:none)
                ; Ordinary declarations such as `extern` are checking and
                ; native-link context owned by the submitted source batch. They
                ; are emitted verbatim; they never enter the live definition
                ; registry or acquire fabricated source identity.
                (do
                  (primitive/code-list-push! out
                    (lr-rewrite-root-refs form (lr-letonces new-forms)))
                  0)
                0)
          :else
            (primitive/error "live incremental definition kind is not implemented"))))
    (for [i 0 (registry/registry-record-count candidate-registry)]
      (let [candidate (registry/registry-record-at candidate-registry i)
            accepted (registry/registry-find-by-id accepted-registry
                       (registry/registry-record-id candidate))]
        (if (and (primitive/code-eq
                   (registry/registry-record-kind candidate) `:function)
                 (or (or (not (lr-head? accepted `live-definition))
                         (not (primitive/code-eq (primitive/code-nth accepted 4)
                                                 (primitive/code-nth candidate 4))))
                     (and (primitive/code-vector?
                            (primitive/code-nth
                              (registry/registry-record-form candidate) 3))
                          (lr-incoming-depends-on-id? incoming candidate-registry
                            (registry/registry-record-id candidate)))))
            (let [rewritten (lr-rewrite-live-function
                              (registry/registry-record-form candidate)
                              new-forms candidate-registry)]
              (lr-push-list! out
                (if (lr-head? accepted `live-definition)
                    (if (and
                          (not (primitive/code-vector?
                                 (primitive/code-nth
                                   (registry/registry-record-form candidate) 3)))
                          (primitive/code-eq
                            (registry/registry-function-signature
                              (registry/registry-record-form accepted))
                            (registry/registry-function-signature
                              (registry/registry-record-form candidate))))
                        (lr-dynamic-function-update-defs
                          (lr-record-with-form candidate rewritten))
                        (lr-dynamic-function-defs new-forms
                          (lr-record-with-form candidate rewritten)))
                    (lr-dynamic-function-defs new-forms
                      (lr-record-with-form candidate rewritten)))))
            0)))
    (let [publish
            (lr-bind-changed-functions accepted-registry candidate-registry 0
              (lr-publish-and-clear-broken))
          commit
            (lr-incremental-commit incoming accepted-registry candidate-registry
              (- (primitive/code-count incoming) 1)
              publish)]
      (primitive/code-list-push! out
        `(defn ~(primitive/syntax->datum `__live_candidate_commit) [] (-> i64)
           ~commit)))
    `(do ~@(primitive/code-list-done out))))

; One edit protocol for the native controller. Classification, identity lookup,
; candidate overlay construction, and registry publication all happen over
; original Coil syntax here. A one-defn edit emits only that private function and
; its typed binder; every other accepted form remains native and untouched.
(defn live-submit-coil [(snippet Code)] (-> Code)
  (if (not (primitive/code-string? snippet))
      (primitive/error "live-submit-coil: expected one candidate source string")
      (let [accepted-state (primitive/code-session-state `:empty)
            initialized (lr-program-state? accepted-state)
            old-forms (if initialized (lr-program-state-forms accepted-state) `[])
            accepted-registry
              (if initialized
                  (lr-register-accepted-monomorphs
                    (lr-program-state-registry accepted-state)
                    (primitive/code-session-monomorphs) 1)
                  `:empty)
            submitted-forms (lr-normal-forms snippet)
            _validated-migrations (lr-validate-duplicate-migrations! submitted-forms)
            incoming (lr-merge-forms `[] submitted-forms)
            new-forms (lr-merge-forms old-forms incoming)
            single-function
              (and initialized
                   (and (= (primitive/code-count incoming) 1)
                        (and (lr-defn? (primitive/code-nth incoming 0))
                             (and (not (primitive/code-vector?
                                        (primitive/code-nth
                                          (primitive/code-nth incoming 0) 3)))
                             (lr-head?
                               (registry/registry-find
                                 accepted-registry
                                 `:function
                                 (primitive/code-nth
                                   (primitive/code-nth incoming 0) 1))
                               `live-definition)))))
            raw-candidate-state
              (if initialized
                  `(live-program-state
                     ~new-forms
                     ~(lr-apply-candidate-forms
                        accepted-registry incoming 0))
                  (lr-make-program-state new-forms))
            candidate-state raw-candidate-state
            candidate-registry (lr-program-state-registry candidate-state)]
        (lr-stage-program-state! candidate-state)
        (if (not initialized)
            (lr-lower `(do ~@new-forms))
            (if single-function
                (let [name (primitive/code-nth (primitive/code-nth incoming 0) 1)
                      record (registry/registry-find candidate-registry `:function name)
                      rewritten (lr-rewrite-live-function
                                  (registry/registry-record-form record)
                                  new-forms candidate-registry)
                      defs (lr-dynamic-function-update-defs
                             (lr-record-with-form record rewritten))
                      binder (lr-artifact-symbol record `:slot-binder)
                      gated
                        (lr-begin-affected-publication
                          `(do (~binder) ~(lr-publish-and-clear-broken)))
                      repaired-staging
                        gated
                      commit
                        (lr-stage-changed-source-ids accepted-registry
                          candidate-registry 0 repaired-staging)]
                  `(do
                     ~@defs
                     (defn ~(primitive/syntax->datum `__live_candidate_commit)
                       [] (-> i64)
                       (do
                         (~(primitive/syntax->datum `coil_live_begin_staging_locked))
                         ~commit))))
              (lr-incremental-lower old-forms new-forms incoming
                  accepted-registry candidate-registry))))))

; Recovery compilation invoked only after ordinary checking rejected a staged
; source candidate. It reads compiler-retained original Code, never controller
; text, and emits only typed slot publication for the changed function IDs.
(defn live-submit-rejected-condition [] (-> Code)
  (let [accepted-state (primitive/code-session-state `:empty)
        rejected-state (primitive/code-session-rejected-state `:empty)]
    (if (or (not (lr-program-state? accepted-state))
            (not (lr-program-state? rejected-state)))
        (primitive/error "live rejected-condition recovery has no retained candidate")
        (let [accepted-registry (lr-program-state-registry accepted-state)
              candidate-registry (lr-program-state-registry rejected-state)
              seeds (lr-broken-seed-ids accepted-registry candidate-registry)
              affected (registry/registry-broken-caller-closure
                         candidate-registry seeds)
              marked-registry candidate-registry]
          `(do
             (defn ~(primitive/syntax->datum `__live_candidate_commit) [] (-> i64)
               (do
                 (~(primitive/syntax->datum `coil_live_begin_staging_locked))
                 ~(lr-stage-affected-ids marked-registry affected 0
                    (lr-begin-affected-publication
                      (lr-bind-broken-ids accepted-registry affected 0
                        `(~(primitive/syntax->datum
                             `coil_live_publish_staged_locked))))))))))))

; Persistent source-provider entry for an in-process compiler session. It is
; deliberately declared after both submission operations so the provider's
; later-phase dependency closure is complete when the setup graph is resolved.
(defn lr-source-request [(forms Code)] (-> Code)
  (let [(mut found) `:missing]
    (for [i 0 (primitive/code-count forms)]
      (let [form (primitive/code-nth forms i)]
        (if (lr-head? form `live-source-request) (set! found form) 0)))
    (load found)))

(defn lr-source-prefix [(forms Code)] (-> Code)
  (let [out (primitive/code-list-new) (mut done) false]
    (for [i 0 (primitive/code-count forms)]
      (let [form (primitive/code-nth forms i)]
        (if (lr-head? form `live-source-request)
            (set! done true)
            (if (not (load done))
                (do (primitive/code-list-push! out form) 0)
                0))))
    (primitive/code-list-done out)))

(defn lr-source-provider-program [(prefix Code) (generated Code) (mode Code)] (-> Code)
  (let [body (if (lr-head? generated `do) (primitive/code-rest generated) generated)]
    (if (primitive/code-eq mode `:native)
        `(do
           ~@prefix
           (import "experiments.heap-inspector.live-types" :use *)
           ~@body
           (extern ~(primitive/syntax->datum `coil_native_demo_stage_callbacks) :cc c
             [(fnptr c [] i64) (fnptr c [i64 i64] i64)] (-> i64))
           (defn ~(primitive/syntax->datum `__native_demo_candidate_commit) [] (-> i64)
             (let [status (~(primitive/syntax->datum `__live_candidate_commit))]
               (if (= status 0)
                   (~(primitive/syntax->datum `coil_native_demo_stage_callbacks)
                     (primitive/fnptr-of ~(primitive/syntax->datum `demo_tick))
                     (primitive/fnptr-of ~(primitive/syntax->datum `demo_value)))
                   status)))
           (defn ~(primitive/syntax->datum `main) [] (-> i64)
             (~(primitive/syntax->datum `__native_demo_candidate_commit)))
           (export-c [~(primitive/syntax->datum `main) :as "coil_repl_entry"]))
        `(do
           ~@prefix
           (import "experiments.heap-inspector.live-types" :use *)
           ~@body
           (defn ~(primitive/syntax->datum `main) [] (-> i64)
             (~(primitive/syntax->datum `__live_candidate_commit)))
           (export-c [~(primitive/syntax->datum `main) :as "coil_repl_entry"])))))

(defn lr-recontext [(form Code) (site Code)] (-> Code)
  (if (and (primitive/code-sym? form)
           (let [name (primitive/code-str form)]
             (and (>= (slice-len name) 10)
                  (= (subslice name 0 10) "primitive/"))))
      (primitive/datum->syntax site (primitive/syntax->datum form))
      (if (primitive/code-list? form)
          (let [out (primitive/code-list-new)]
            (for [i 0 (primitive/code-count form)]
              (primitive/code-list-push! out
                (lr-recontext (primitive/code-nth form i) site)))
            (let [done (primitive/code-list-done out)]
              (if (primitive/code-vector? form) `[~@done] done)))
          form)))

(defn lr-source-provider-program-at [(prefix Code) (generated Code) (mode Code)
                                     (site Code)] (-> Code)
  ; Reader output has no target macro-call scope. Re-anchor the complete emitted
  ; program at the request syntax so target imports, local artifact names, and
  ; fnptr-of references resolve exactly as they do for an ordinary macro call.
  (lr-recontext (lr-source-provider-program prefix generated mode) site))

(defn live-source-provider [(context Code)] (-> Code)
  (let [source (primitive/code-nth context 2)
        parsed (primitive/code-read source
                 `(reader-config :unquote #\~ :alternate-unquote #\, :splice #\@))
        forms (if (lr-head? parsed `do) (primitive/code-rest parsed) parsed)
        prefix (lr-source-prefix forms)
        request (lr-source-request forms)]
    (if (not (lr-head? request `live-source-request))
        (primitive/error "live source provider: missing live-source-request")
        (let [mode (primitive/code-nth request 2)
              generated
                (if (primitive/code-eq mode `:recovery)
                    (live-submit-rejected-condition)
                    (live-submit-coil (primitive/code-nth request 1)))]
          (lr-source-provider-program-at prefix generated mode request)))))
