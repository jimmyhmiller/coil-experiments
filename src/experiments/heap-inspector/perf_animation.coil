(module experiments.heap-inspector.perf-animation)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.result" :use *)
(import "experiments.invaders.objc" :use *)

(extern printf :cc c [(ptr i8) ...] (-> i32))
(extern snprintf :cc c [(ptr i8) i64 (ptr i8) ...] (-> i32))
(extern usleep :cc c [i64] (-> i32))
(extern CFAbsoluteTimeGetCurrent :cc c [] (-> f64))
(extern CGColorCreateGenericRGB :cc c [f64 f64 f64 f64] (-> (ptr i8)))
(extern CGColorRelease :cc c [(ptr i8)] (-> i64))

(defstruct CGRect [(x f64) (y f64) (w f64) (h f64)])
(defstruct FrameProbe [(frame i64) (dt-ms f64) (x f64) (y f64)])
(defstruct BallState [(number i64) (x f64) (y f64) (vx f64) (vy f64) (frames i64)])
(const BALL_MAX 200)

(defn rect [(x f64) (y f64) (w f64) (h f64)] (-> CGRect)
  (let [r (primitive/alloc-stack CGRect)]
    (set! (.x r) x) (set! (.y r) y) (set! (.w r) w) (set! (.h r) h)
    (load r)))

(defn pump! [(app (ptr i8)) (mode (ptr i8))] (-> i64)
  (while true
    (let [event (msg (ptr i8) app
                     (sel c"nextEventMatchingMask:untilDate:inMode:dequeue:")
                     [i64 (ptr i8) (ptr i8) i64]
                     -1 (primitive/cast (ptr i8) 0) mode 1)]
      (if (= (primitive/cast i64 event) 0)
          (break 0)
          (msg (ptr i8) app (sel c"sendEvent:") [(ptr i8)] event))))
  0)

(defn set-title! [(window (ptr i8)) (fps f64) (worst-ms f64)] (-> i64)
  (let [buffer (primitive/alloc-stack (array i8 128))]
    (snprintf (primitive/index buffer 0) 128 c"Heap inspector animation — %.1f FPS — worst %.2f ms" fps worst-ms)
    (let [title (msg (ptr i8) (class c"NSString") (sel c"stringWithUTF8String:") [(ptr i8)] (primitive/index buffer 0))]
      (msg (ptr i8) window (sel c"setTitle:") [(ptr i8)] title)))
  0)

(defn frame-allocation! [(a (dyn alloc/Allocator)) (frame i64)] (-> i64)
  (match (alloc/alloc [FrameProbe] a 1)
    (None [] 0)
    (Some [memory]
      (do
        (set! (.frame (alloc/alloc-slice-data memory)) frame)
        (set! (.dt-ms (alloc/alloc-slice-data memory)) 0.0)
        (set! (.x (alloc/alloc-slice-data memory)) 0.0)
        (set! (.y (alloc/alloc-slice-data memory)) 0.0)
        (alloc/free [FrameProbe] a memory)
        0))))

(defn create-ball! [(a (dyn alloc/Allocator))
                    (i i64)
                    (layer (ptr i8))
                    (balls (ptr (ptr i8)))
                    (colors (ptr (ptr i8)))
                    (states (ptr (ptr BallState)))] (-> i64)
  (let [ball (msg (ptr i8) (class c"CALayer") (sel c"layer") [])
        state (alloc/unwrap-ptr [BallState] (alloc/create [BallState] a))
        color (CGColorCreateGenericRGB
                (/ (primitive/cast f64 (+ 3 (% (* i 5) 7))) 10.0)
                (/ (primitive/cast f64 (+ 3 (% (* i 3) 7))) 10.0)
                (/ (primitive/cast f64 (+ 3 (% (* i 2) 7))) 10.0)
                1.0)
        x (+ 24.0 (primitive/cast f64 (% (* i 83) 640)))
        y (+ 54.0 (primitive/cast f64 (% (* i 137) 326)))]
    (set! (primitive/index balls i) ball)
    (set! (primitive/index colors i) color)
    (set! (primitive/index states i) state)
    (set! (.number state) i) (set! (.x state) x) (set! (.y state) y)
    (set! (.vx state) (* (if (= (% i 2) 0) 1.0 -1.0) (+ 125.0 (primitive/cast f64 (% (* i 13) 190)))))
    (set! (.vy state) (* (if (= (% i 3) 0) -1.0 1.0) (+ 105.0 (primitive/cast f64 (% (* i 11) 170)))))
    (set! (.frames state) 0)
    (msg (ptr i8) ball (sel c"setBackgroundColor:") [(ptr i8)] color)
    (msg (ptr i8) ball (sel c"setCornerRadius:") [f64] 16.0)
    (msg (ptr i8) ball (sel c"setFrame:") [CGRect] (rect x y 32.0 32.0))
    (msg (ptr i8) layer (sel c"addSublayer:") [(ptr i8)] ball)
    0))

(defn destroy-ball! [(a (dyn alloc/Allocator))
                     (i i64)
                     (balls (ptr (ptr i8)))
                     (colors (ptr (ptr i8)))
                     (states (ptr (ptr BallState)))] (-> i64)
  (msg (ptr i8) (load (primitive/index balls i)) (sel c"removeFromSuperlayer") [])
  (CGColorRelease (load (primitive/index colors i)))
  (alloc/destroy [BallState] a (load (primitive/index states i)))
  0)

(defn main [] (-> i64)
  (let [app (msg (ptr i8) (class c"NSApplication") (sel c"sharedApplication") [])
        window (msg (ptr i8) (class c"NSWindow") (sel c"alloc") [])
        mode (msg (ptr i8) (class c"NSString") (sel c"stringWithUTF8String:") [(ptr i8)] c"kCFRunLoopDefaultMode")
        layer (msg (ptr i8) (class c"CALayer") (sel c"layer") [])
        balls (primitive/alloc-stack (array (ptr i8) 200))
        colors (primitive/alloc-stack (array (ptr i8) 200))
        states (primitive/alloc-stack (array (ptr BallState) 200))
        dark (CGColorCreateGenericRGB 0.035 0.045 0.065 1.0)
        a (alloc/malloc-allocator)
        (mut active) 12
        pixels (match (alloc/alloc [u8] a 49152)
                 (None [] (alloc/alloc-slice-new (primitive/cast (ptr u8) 0) 0))
                 (Some [memory] memory))]
    (for [i 0 (alloc/alloc-slice-len pixels)]
      (set! (primitive/index (alloc/alloc-slice-data pixels) i) (primitive/cast u8 (% (+ i (* (/ i 4096) 37)) 256))))
    (msg (ptr i8) window (sel c"initWithContentRect:styleMask:backing:defer:") [CGRect i64 i64 i64]
         (rect 180.0 180.0 720.0 440.0) 15 2 0)
    (msg (ptr i8) app (sel c"setActivationPolicy:") [i64] 0)
    (msg (ptr i8) (msg (ptr i8) window (sel c"contentView") []) (sel c"setWantsLayer:") [i64] 1)
    (msg (ptr i8) (msg (ptr i8) window (sel c"contentView") []) (sel c"setLayer:") [(ptr i8)] layer)
    (msg (ptr i8) layer (sel c"setBackgroundColor:") [(ptr i8)] dark)
    (for [i 0 12] (create-ball! a i layer (primitive/index balls 0) (primitive/index colors 0) (primitive/index states 0)))
    (let [slider (msg (ptr i8) (class c"NSSlider") (sel c"alloc") [])]
      (msg (ptr i8) slider (sel c"initWithFrame:") [CGRect] (rect 24.0 12.0 672.0 28.0))
      (msg (ptr i8) slider (sel c"setMinValue:") [f64] 1.0)
      (msg (ptr i8) slider (sel c"setMaxValue:") [f64] 200.0)
      (msg (ptr i8) slider (sel c"setDoubleValue:") [f64] 12.0)
      (msg (ptr i8) slider (sel c"setContinuous:") [i64] 1)
      (msg (ptr i8) (msg (ptr i8) window (sel c"contentView") []) (sel c"addSubview:") [(ptr i8)] slider)
    (msg (ptr i8) window (sel c"makeKeyAndOrderFront:") [(ptr i8)] (primitive/cast (ptr i8) 0))
    (msg (ptr i8) app (sel c"activateIgnoringOtherApps:") [i64] 1)
    (msg (ptr i8) app (sel c"finishLaunching") [])
    (let [(mut frame) 0
          (mut last) (CFAbsoluteTimeGetCurrent)
          (mut report-start) (load last)
          (mut report-frames) 0
          (mut worst-ms) 0.0
          (mut deadline) (+ (load last) (/ 1.0 60.0))]
      (while (= (msg i64 window (sel c"isVisible") []) 1)
        (let [now (CFAbsoluteTimeGetCurrent) dt (- now (load last))]
          (set! last now)
          (pump! app mode)
          (let [desired (msg i64 slider (sel c"integerValue") [])]
            (while (< (load active) desired)
              (do (create-ball! a (load active) layer (primitive/index balls 0) (primitive/index colors 0) (primitive/index states 0))
                  (set! active (+ (load active) 1))))
            (while (> (load active) desired)
              (do (set! active (- (load active) 1))
                  (destroy-ball! a (load active) (primitive/index balls 0) (primitive/index colors 0) (primitive/index states 0)))))
          (msg (ptr i8) (class c"CATransaction") (sel c"begin") [])
          (msg (ptr i8) (class c"CATransaction") (sel c"setDisableActions:") [i64] 1)
          (for [i 0 (load active)]
            (let [state (load (primitive/index states i))
                  x (+ (.x state) (* (.vx state) dt))
                  y (+ (.y state) (* (.vy state) dt))]
              (set! (.x state) x)
              (set! (.y state) y)
              (set! (.frames state) (+ (.frames state) 1))
              (if (> x 664.0) (do (set! (.x state) 664.0) (set! (.vx state) (- 0.0 (.vx state)))) 0)
              (if (< x 24.0) (do (set! (.x state) 24.0) (set! (.vx state) (- 0.0 (.vx state)))) 0)
              (if (> y 384.0) (do (set! (.y state) 384.0) (set! (.vy state) (- 0.0 (.vy state)))) 0)
              (if (< y 54.0) (do (set! (.y state) 54.0) (set! (.vy state) (- 0.0 (.vy state)))) 0)
              (msg (ptr i8) (load (primitive/index balls i)) (sel c"setFrame:") [CGRect]
                   (rect (.x state) (.y state) 32.0 32.0))))
          (msg (ptr i8) (class c"CATransaction") (sel c"commit") [])
          (frame-allocation! a (load frame))
          (set! frame (+ (load frame) 1))
          (set! report-frames (+ (load report-frames) 1))
          (let [frame-ms (* dt 1000.0)] (if (> frame-ms (load worst-ms)) (set! worst-ms frame-ms) 0))
          (let [after (CFAbsoluteTimeGetCurrent) remaining (- (load deadline) after)]
            (if (> remaining 0.0) (usleep (primitive/cast i64 (* remaining 1000000.0))) 0))
          (set! deadline (+ (load deadline) (/ 1.0 60.0)))
          (let [finished (CFAbsoluteTimeGetCurrent) elapsed (- finished (load report-start))]
            (if (>= elapsed 1.0)
                (let [fps (/ (primitive/cast f64 (load report-frames)) elapsed)]
                  (printf c"animation: fps=%.2f worst_ms=%.2f frames=%ld\n" fps (load worst-ms) (load frame))
                  (set-title! window fps (load worst-ms))
                  (set! report-start finished) (set! report-frames 0) (set! worst-ms 0.0))
                0)))))
    (for [i 0 (load active)] (destroy-ball! a i (primitive/index balls 0) (primitive/index colors 0) (primitive/index states 0)))
    (alloc/free [u8] a pixels)
    (CGColorRelease dark)
    0)))
