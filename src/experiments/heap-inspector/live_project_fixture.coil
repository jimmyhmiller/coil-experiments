(module experiments.heap-inspector.live-project-fixture)
(import "experiments.heap-inspector.live-project-left" :as left)
(import "experiments.heap-inspector.live-project-right" :use [value] :rename [[value right-value]])
(defn redraw [] (-> i64) (+ (left/value) (right-value)))
(defn main [] (-> i64) (redraw))
