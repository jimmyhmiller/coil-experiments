    (assert-eq 0 (jit/jit-submit! (mut session)
      "(coil_live_function_test_observe (future-doubled))"))
    (assert-eq 21 (load (observed-value)))
    (assert-eq 1 (apply-live! (mut session) a
      "(impl LiveDouble i64
         (live-double [(value i64)] (-> i64) true))"))
    (store! (observed-value) 0)
    (assert-eq 0 (jit/jit-submit! (mut session)
      "(coil_live_function_test_observe (doubled))"))
