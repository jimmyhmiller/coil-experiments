(deftest erased-trait-vtable-keeps-the-stable-live-method-entry
  (let [a (alloc/malloc-allocator)
        (mut session) (jit/jit-session-new a)]
    (assert-eq 0 (jit/jit-session-set-legacy-reload! (mut session) false))
    (assert-eq 0 (apply-live! (mut session) a
      "(extern coil_live_function_test_observe :cc c [i64] (-> i64))
       (defstruct Model [(value i64)])
       (deftrait LiveRead [Self]
         (live-read [(self (ptr Self))] (-> i64)))
       (impl LiveRead Model
         (live-read [(self (ptr Model))] (-> i64) (.value self)))
       (letonce model (Model :value 5))
       (defn erased-result [] (-> i64)
         (let [erased-model (primitive/make-dyn LiveRead model)]
           (live-read erased-model)))"))
    (assert-eq 0 (jit/jit-submit! (mut session)
      "(coil_live_function_test_observe (erased-result))"))
    (assert-eq 5 (load (observed-value)))
    (assert-eq 0 (apply-live! (mut session) a
      "(impl LiveRead Model
         (live-read [(self (ptr Model))] (-> i64)
           (+ (.value self) 10)))"))
    (store! (observed-value) 0)
    (assert-eq 0 (jit/jit-submit! (mut session)
      "(coil_live_function_test_observe (erased-result))"))
    (assert-eq 15 (load (observed-value)))))

(deftest live-closure-uses-a-stable-body-entry-and-versioned-environment
  (let [a (alloc/malloc-allocator)
        (mut session) (jit/jit-session-new a)]
    (assert-eq 0 (jit/jit-session-set-legacy-reload! (mut session) false))
    (assert-eq 0 (apply-live! (mut session) a
      "(extern coil_live_function_test_observe :cc c [i64] (-> i64))
       (defclosure captured-adder [(base i64)] [(value i64)] i64
         (+ base value))
       (letonce saved-adder (captured-adder-new 5))
       (defn call-new-adder [] (-> i64)
         (let [(mut adder) (captured-adder-new 5)
               result (captured-adder-call adder 7)]
           (captured-adder-free (take! [captured-adder] (mut adder)))
           result))
       (defn call-saved-adder [] (-> i64)
         (captured-adder-call saved-adder 7))"))
    (store! (observed-value) 0)
    (assert-eq 0 (jit/jit-submit! (mut session)
      "(coil_live_function_test_observe (call-new-adder))"))
    (assert-eq 12 (load (observed-value)))
    (store! (observed-value) 0)
    (assert-eq 0 (jit/jit-submit! (mut session)
      "(coil_live_function_test_observe (call-saved-adder))"))
    (assert-eq 12 (load (observed-value)))
    (assert-eq 0 (apply-live! (mut session) a
      "(defclosure captured-adder [(base i64)] [(value i64)] i64
         (+ base (+ value 10)))"))
    (store! (observed-value) 0)
    (assert-eq 0 (jit/jit-submit! (mut session)
      "(coil_live_function_test_observe (call-new-adder))"))
    (assert-eq 22 (load (observed-value)))
    (store! (observed-value) 0)
    (assert-eq 0 (jit/jit-submit! (mut session)
      "(coil_live_function_test_observe (call-saved-adder))"))
    (assert-eq 22 (load (observed-value)))
    (assert-eq 0 (apply-live! (mut session) a
      "(defclosure captured-adder [(base i64) (bias i64 3)]
         [(value i64)] i64
         (+ base (+ bias value)))"))
    (store! (observed-value) 0)
    (assert-eq 0 (jit/jit-submit! (mut session)
      "(coil_live_function_test_observe (call-new-adder))"))
    (assert-eq 15 (load (observed-value)))
    (store! (observed-value) 0)
    (assert-eq 0 (jit/jit-submit! (mut session)
      "(coil_live_function_test_observe (call-saved-adder))"))
    (assert-eq 15 (load (observed-value)))
    (assert-eq 0 (apply-live! (mut session) a
      "(migrate captured-adder base old-base
         (primitive/cast f64 old-base))
       (defclosure captured-adder [(base f64) (bias i64 3)]
         [(value i64)] i64
         (+ (primitive/cast i64 base) (+ bias value)))"))
    (store! (observed-value) 0)
    (assert-eq 0 (jit/jit-submit! (mut session)
      "(coil_live_function_test_observe (call-new-adder))"))
    (assert-eq 15 (load (observed-value)))
    (store! (observed-value) 0)
    (assert-eq 0 (jit/jit-submit! (mut session)
      "(coil_live_function_test_observe (call-saved-adder))"))
    (assert-eq 15 (load (observed-value)))))

(deftest rejected-sum-candidate-does-not-pollute-accepted-abi
  (let [a (alloc/malloc-allocator)
        (mut session) (jit/jit-session-new a)]
    (assert-eq 0 (jit/jit-session-set-legacy-reload! (mut session) false))
    (assert-eq 0 (apply-live! (mut session) a
      "(extern coil_live_function_test_observe :cc c [i64] (-> i64))
       (defstruct Particle [(visible bool)])
       (letonce particle (Particle :visible true))
       (defn visible-code [] (-> i64) (if (.visible particle) 1 0))"))
    (assert-eq 1 (apply-live! (mut session) a
      "(defsum Visibility (Hidden) (Visible))
       (defstruct Particle [(visible Visibility)])"))
    (assert (not (slice-contains? (jit/jit-abi-source (mut session)) "Visibility")))
    (assert-eq 0 (apply-live! (mut session) a
      "(defsum Visibility (Hidden) (Visible))
       (defstruct Particle [(visible Visibility)])
       (defsum Visibility (Hidden) (Visible))
       (defstruct Particle [(visible Visibility (Visible))])
       (migrate Particle visible old (if old (Visible) (Hidden)))
       (defn visible-code [] (-> i64)
         (match (.visible particle) (Hidden [] 0) (Visible [] 1)))"))
    (assert-eq 0 (apply-live! (mut session) a
      "(defsum Kind (Dot) (Ring))
       (defn kind-of [] (-> Kind) (Ring))"))
    (assert-eq 0 (apply-live! (mut session) a
      "(letonce current-kind (Ring))"))
    (assert-eq 0 (apply-live! (mut session) a
      "(defn kind-code [] (-> i64)
         (match current-kind (Dot [] 0) (Ring [] 1)))"))
    (store! (observed-value) 0)
    (assert-eq 0 (jit/jit-submit! (mut session)
      "(coil_live_function_test_observe (kind-code))"))
    (assert-eq 1 (load (observed-value)))
    (assert-eq 1 (apply-live! (mut session) a
      "(defsum Kind (Dot) (Ring) (Bar))
       (defn kind-of [] (-> Kind) (Bar))"))
    (assert-eq 0 (apply-live! (mut session) a
      "(defsum Kind (Dot) (Ring) (Bar))
       (defn kind-of [] (-> Kind) (Bar))
       (defn kind-code [] (-> i64)
         (match current-kind (Dot [] 0) (Ring [] 1) (Bar [] 2)))"))
    (store! (observed-value) 0)
    (assert-eq 0 (jit/jit-submit! (mut session)
      "(coil_live_function_test_observe (kind-code))"))
    (assert-eq 1 (load (observed-value)))
    (assert-eq 1 (apply-live! (mut session) a
      "(defsum Kind (Dot) (Bar))
       (defn kind-code [] (-> i64)
         (match current-kind (Dot [] 0) (Bar [] 2)))"))
    (assert-eq 0 (apply-live! (mut session) a
      "(defsum Kind (Dot) (Bar))
       (migrate Kind Ring _ (Bar))
       (defn kind-code [] (-> i64)
         (match current-kind (Dot [] 0) (Bar [] 2)))"))
    (store! (observed-value) 0)
    (assert-eq 0 (jit/jit-submit! (mut session)
      "(coil_live_function_test_observe (kind-code))"))
    (assert-eq 2 (load (observed-value)))
    (assert-eq 1 (apply-live! (mut session) a
      "(defsum Kind (Dot) (Bar [(code i64)]))
       (defn kind-of [] (-> Kind) (Bar :code 7))
       (defn kind-code [] (-> i64)
         (match current-kind (Dot [] 0) (Bar [code] code)))"))
    (assert-eq 0 (apply-live! (mut session) a
      "(defsum Kind (Dot) (Bar [(code i64)]))
       (migrate Kind Bar _ (Bar :code 7))
       (defn kind-of [] (-> Kind) (Bar :code 7))
       (defn kind-code [] (-> i64)
         (match current-kind (Dot [] 0) (Bar [code] code)))"))
    (store! (observed-value) 0)
    (assert-eq 0 (jit/jit-submit! (mut session)
      "(coil_live_function_test_observe (kind-code))"))
    (assert-eq 7 (load (observed-value)))))
