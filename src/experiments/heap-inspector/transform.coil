(module experiments.heap-inspector.transform)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.slice" :use *)
(import "coil.result" :use *)
(import "experiments.heap-inspector.runtime" :use *)
(import "experiments.heap-inspector.viewer" :as viewer)

(defn same? [(a (slice u8)) (b (slice u8))] (-> bool)
  (if (!= (slice-len a) (slice-len b))
      false
      (let [(mut i) 0
            (mut ok) true]
        (loop (if (or (>= (load i) (slice-len a)) (not (load ok)))
                  (break)
                  (do
                    (if (= (slice-get a (load i)) (slice-get b (load i))) 0 (set! ok false))
                    (set! i (+ (load i) 1)))))
        (load ok))))
(defn last-start [(s (slice u8))] (-> i64)
  (let [(mut i) 0
        (mut at) 0]
    (loop (if (>= (load i) (slice-len s))
              (break)
              (do
                (let [c (primitive/cast i64 (slice-get s (load i)))]
                  (if (or (= c 47) (= c 46)) (set! at (+ (load i) 1)) 0))
                (set! i (+ (load i) 1)))))
    (load at)))
(defn last-name [(c Code)] (-> (slice u8))
  (let [s (primitive/code-str c)] (subslice s (last-start s) (slice-len s))))
(defn alloc-decl? [(h Code) (name (slice u8))] (-> bool)
  (if (not (primitive/code-sym? h))
      false
      (let [d (primitive/code-decl h)]
        (and (primitive/code-list? d)
             (>= (primitive/code-count d) 5)
             (primitive/code-eq (primitive/code-nth d 1) `coil.alloc)
             (primitive/code-eq (primitive/code-nth d 2) `fn)
             (same? (last-name h) name)))))
(defn arraylist-decl? [(h Code) (name (slice u8))] (-> bool)
  (if (not (primitive/code-sym? h))
      false
      (let [d (primitive/code-decl h)]
        (and (primitive/code-list? d)
             (>= (primitive/code-count d) 5)
             (primitive/code-eq (primitive/code-nth d 1) `coil.arraylist)
             (primitive/code-eq (primitive/code-nth d 2) `fn)
             (same? (last-name h) name)))))
(defn c-allocator-call? [(e Code) (h Code) (name (slice u8))] (-> bool)
  (and (primitive/code-from-user? e)
       (and (primitive/code-sym? h) (same? (last-name h) name))))
(defn c-type-hint-call? [(e Code) (h Code)] (-> bool)
  (and (primitive/code-from-user? e)
       (and (primitive/code-sym? h) (same? (last-name h) "c_type_hint"))))
(defn c-type-hint-type [(e Code) (h Code)] (-> Code)
  (if (and (c-type-hint-call? e h)
           (and (= (primitive/code-count e) 5)
                (primitive/code-string? (primitive/code-nth e 1))))
      (primitive/datum->syntax (primitive/code-nth e 1)
                               (primitive/code-symbol "c_s_"
                                                      (primitive/code-str (primitive/code-nth e 1))))
      `:unknown))
(defn c-zone-call? [(e Code) (h Code) (name (slice u8))] (-> bool)
  (and (primitive/code-from-user? e)
       (and (primitive/code-sym? h) (same? (last-name h) name))))
(defn runtime-marker? [(h Code)] (-> bool)
  (if (not (primitive/code-sym? h))
      false
      (let [d (primitive/code-decl h)
            name (last-name h)
            base (or (same? name "track-create")
                     (or (same? name "track-alloc")
                         (or (same? name "track-arraylist-push")
                             (or (same? name "track-destroy")
                                 (or (same? name "inspect-raw-alloc")
                                     (or (same? name "inspect-raw-resize")
                                         (or (same? name "inspect-raw-remap")
                                             (same? name "inspect-raw-free"))))))))
            c (or (same? name "inspect-c-malloc")
                  (or (same? name "inspect-c-calloc")
                      (or (same? name "inspect-c-realloc")
                          (or (same? name "inspect-c-free")
                              (or (same? name "track-c-type-view")
                                  (or (same? name "track-c-struct-view")
                                      (or (same? name "track-c-region")
                                          (same? name "retire-c-region"))))))))]
        (and (primitive/code-list? d)
             (>= (primitive/code-count d) 5)
             (primitive/code-eq (primitive/code-nth d 1) `experiments.heap-inspector.runtime)
             (or base c)))))
(defn struct-code? [(T Code)] (-> bool)
  (let [d (primitive/code-decl T)]
    (and (primitive/code-list? d)
         (>= (primitive/code-count d) 3)
         (primitive/code-eq (primitive/code-nth d 2) `struct))))
(defn type-display-name [(T Code)] (-> (slice u8))
  (let [d (primitive/code-decl T) raw (primitive/code-str T)]
    (if (> (last-start raw) 0)
        raw
        (if (and (primitive/code-list? d) (>= (primitive/code-count d) 2))
            (primitive/code-str (primitive/code-nth d 1) "." T)
            raw))))
(defn layout-text-hash [(s (slice u8))] (-> i64)
  (let [(mut h) 2166136261 (mut i) 0]
    (loop (if (>= (load i) (slice-len s))
              (break)
              (do
                (set! h (primitive/imul (primitive/ixor (load h)
                                                        (primitive/cast i64 (slice-get s (load i))))
                                         16777619))
                (set! i (+ (load i) 1)))))
    (load h)))
(defn layout-fingerprint [(T Code)] (-> i64)
  ; The resolved declaration includes field order, names, and checked type
  ; spellings. Size/alignment are passed separately and compared by the runtime.
  (layout-text-hash (primitive/code-str (primitive/code-decl T))))
(defn slice-u8? [(T Code)] (-> bool)
  (and (primitive/code-list? T)
       (= (primitive/code-count T) 2)
       (same? (last-name (primitive/code-nth T 0)) "slice")
       (or (primitive/code-eq (primitive/code-nth T 1) `u8)
           (primitive/code-eq (primitive/code-nth T 1) `:u8))))
(defn u8-code? [(T Code)] (-> bool)
  (or (primitive/code-eq T `u8) (primitive/code-eq T `:u8)))
(defn inspectable-type? [(T Code)] (-> bool)
  (or (struct-code? T) (or (u8-code? T) (slice-u8? T))))
(defn arraylist-element-type [(T Code)] (-> Code)
  (if (and (primitive/code-list? T)
           (= (primitive/code-count T) 2)
           (same? (last-name (primitive/code-nth T 0)) "ArrayList"))
      (primitive/code-nth T 1)
      `:unknown))
(defn collection-place-element-type [(T Code)] (-> Code)
  (let [direct (arraylist-element-type T)]
    (if (not (primitive/code-eq direct `:unknown))
        direct
        (if (and (primitive/code-list? T)
                 (= (primitive/code-count T) 2)
                 (or (same? (last-name (primitive/code-nth T 0)) "mut")
                     (or (same? (last-name (primitive/code-nth T 0)) "ptr")
                         (same? (last-name (primitive/code-nth T 0)) "ref"))))
            (collection-place-element-type (primitive/code-nth T 1))
            `:unknown))))
(defn one-generic-argument [(c Code)] (-> Code)
  (if (and (primitive/code-vector? c) (= (primitive/code-count c) 1))
      (primitive/code-nth c 0)
      c))
(defn signed-integer-code? [(T Code)] (-> bool)
  (or (primitive/code-eq T `i8)
      (or (primitive/code-eq T `i16)
          (or (primitive/code-eq T `i32)
              (primitive/code-eq T `i64)))))
(defn unsigned-integer-code? [(T Code)] (-> bool)
  (or (primitive/code-eq T `u8)
      (or (primitive/code-eq T `u16)
          (or (primitive/code-eq T `u32)
              (primitive/code-eq T `u64)))))
(defn float-code? [(T Code)] (-> bool)
  (or (primitive/code-eq T `f32) (primitive/code-eq T `f64)))
(defn integer-type-display [(T Code)] (-> (slice u8))
  (cond (primitive/code-eq T `i8) "i8"
        (primitive/code-eq T `i16) "i16"
        (primitive/code-eq T `i32) "i32"
        (primitive/code-eq T `i64) "i64"
        (primitive/code-eq T `u8) "u8"
        (primitive/code-eq T `u16) "u16"
        (primitive/code-eq T `u32) "u32"
        :else "u64"))
(defn field-type-display [(T Code) (kind i64)] (-> (slice u8))
  (cond (= kind 0) (integer-type-display T)
        (= kind 1) (if (primitive/code-eq T `f32) "f32" "f64")
        (= kind 2) "bool"
        (= kind 3) "struct"
        (= kind 4) "sum"
        (= kind 5) "(ptr _)"
        (= kind 6) "(array _ _)"
        (= kind 7) "(slice _)"
        (= kind 8) "foreign-value"
        :else "value"))
(defn field-lines [(T Code) (p Code) (i i64) (n i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut at) i]
    (loop (if (>= (load at) n)
              (break)
              (let [nm (primitive/code-field-name T (load at))
                    k (primitive/code-field-kind T (load at))
                    ft (if (or (= k 0) (= k 1))
                           (primitive/code-field-qtype T (load at))
                           `:unknown)
                    v `(load (field ~p ~nm))
                    part
                      (cond (= k 2)
                              `((print-text ~(primitive/code-str nm))
                                (printf c"=%s " (if ~v c"true" c"false")))
                            (and (= k 0) (signed-integer-code? ft))
                              `((print-text ~(primitive/code-str nm))
                                (printf c"=%lld " (primitive/cast i64 ~v)))
                            (and (= k 0) (unsigned-integer-code? ft))
                              `((print-text ~(primitive/code-str nm))
                                (printf c"=%llu " (primitive/cast u64 ~v)))
                            (= k 1)
                              `((print-text ~(primitive/code-str nm))
                                (printf c"=%g " (primitive/cast f64 ~v)))
                            (= k 5)
                              `((print-text ~(primitive/code-str nm))
                                (printf c"=ptr(0x%llx) " (primitive/cast i64 ~v)))
                            :else
                              `((print-text ~(primitive/code-str nm))
                                (printf c"=<unsupported> ")))
                    (mut j) 0]
                (loop (if (>= (load j) (primitive/code-count part))
                          (break)
                          (do
                            (primitive/code-list-push! out (primitive/code-nth part (load j)))
                            (set! j (+ (load j) 1)))))
                (set! at (+ (load at) 1)))))
    (primitive/code-list-done out)))
(defn field-registrations [(T Code) (tid Code) (i i64) (n i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut at) i]
    (loop (if (>= (load at) n)
              (break)
              (let [nm (primitive/code-field-name T (load at))
                    kind (primitive/code-field-kind T (load at))
                    ft (if (or (= kind 0) (= kind 1))
                           (primitive/code-field-qtype T (load at))
                           `:unknown)]
                (primitive/code-list-push! out
                                           `(register-field ~tid
                                                            ~(load at)
                                                            ~(primitive/code-str nm)
                                                            ~(field-type-display ft kind)
                                                            (primitive/offsetof ~T ~nm)))
                (set! at (+ (load at) 1)))))
    (primitive/code-list-done out)))
(defn json-field-lines [(T Code) (p Code) (i i64) (n i64)] (-> Code)
  (let [out (primitive/code-list-new) (mut at) i]
    (loop (if (>= (load at) n)
              (break)
              (let [nm (primitive/code-field-name T (load at))
                    k (primitive/code-field-kind T (load at))
                    ft (if (or (= k 0) (= k 1))
                           (primitive/code-field-qtype T (load at))
                           `:unknown)
                    v `(load (field ~p ~nm))
                    next-offset
                      (if (< (+ (load at) 1) n)
                          (let [next-name (primitive/code-field-name T (+ (load at) 1))]
                            `(primitive/offsetof ~T ~next-name))
                          `(primitive/sizeof ~T))
                    field-span `(- ~next-offset (primitive/offsetof ~T ~nm))
                    value
                      (cond (= k 2) `(json-text! (if ~v "true" "false"))
                            (and (= k 0) (signed-integer-code? ft))
                              `(json-int! (primitive/cast i64 ~v))
                            (and (= k 0) (unsigned-integer-code? ft))
                              `(json-u64! (primitive/cast u64 ~v))
                            (= k 1) `(json-f64! (primitive/cast f64 ~v))
                            (= k 6) `(json-bytes-value! (primitive/cast (ptr i8) (field ~p ~nm))
                                                       ~field-span)
                            (= k 7) `(json-slice-value! ~v)
                            (= k 5) `(json-pointer! (primitive/cast (ptr i8) ~v))
                            :else `(json-text! "null"))]
                (if (> (load at) i)
                    (do (primitive/code-list-push! out `(json-byte! (primitive/cast u8 #\,))) 0)
                    0)
                (primitive/code-list-push! out `(json-quoted! ~(primitive/code-str nm)))
                (primitive/code-list-push! out `(json-byte! (primitive/cast u8 #\:)))
                (primitive/code-list-push! out value)
                (set! at (+ (load at) 1)))))
    (primitive/code-list-done out)))

; A plan entry is `(TYPE SHOW-FN METADATA-FN)`. Discover first, then rewrite,
; keeping the recursive metaprogram entirely Code -> Code.
(defn plan-find [(T Code) (plan Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `:unknown
      (let [entry (primitive/code-nth plan i)]
        (if (primitive/code-eq (primitive/code-nth entry 0) T)
            entry
            (plan-find T plan (+ i 1) n)))))
(defn plan-add-type [(T Code) (plan Code)] (-> Code)
  (if (or (not (inspectable-type? T))
          (not (primitive/code-eq (plan-find T plan 0 (primitive/code-count plan)) `:unknown)))
      plan
      `(~@plan (~T ~(primitive/fresh-identifier "inspector_show")
                    ~(primitive/fresh-identifier "inspector_metadata")
                    ~(primitive/fresh-identifier "inspector_json")))))
(defn declared-struct-plan [(m Code) (i i64) (plan Code)] (-> Code)
  (if (>= i (primitive/code-count m))
      plan
      (let [form (primitive/code-nth m i)]
        (if (and (primitive/code-list? form)
                 (= (primitive/code-count form) 3)
                 (same? (last-name (primitive/code-nth form 0)) "defstruct"))
            (declared-struct-plan m (+ i 1) (plan-add-type (primitive/code-nth form 1) plan))
            (declared-struct-plan m (+ i 1) plan)))))
(defn allocator-operation-name? [(h Code)] (-> bool)
  (if (not (primitive/code-sym? h))
      false
      (let [name (last-name h)]
        (if (same? name "track-c-struct-view")
            true
            (or (same? name "al-push!")
            (or (same? name "raw-alloc")
                (or (same? name "raw-resize")
                    (or (same? name "raw-remap")
                        (or (same? name "raw-free")
                            (or (same? name "alloc")
                                (or (same? name "create")
                                    (or (same? name "destroy")
                                        (or (same? name "track-create")
                                            (or (same? name "track-alloc")
                                                (or (same? name "track-arraylist-push")
                                                    (or (same? name "track-destroy")
                                                        (or (same? name "inspect-raw-alloc")
                                                            (or (same? name "inspect-raw-resize")
                                                                (or (same? name "inspect-raw-remap")
                                                                    (or (same? name "inspect-raw-free")
                                                                        (or (same? name "malloc")
                                                                            (or (same? name "calloc")
                                                                                (or (same? name "realloc")
                                                                                    (or (same? name "free")
                                                                                        (or (same? name "inspect-c-malloc")
                                                                                            (or (same? name "inspect-c-calloc")
                                                                                                (or (same? name "inspect-c-realloc")
                                                                                                    (or (same? name "inspect-c-free")
                                                                                                        (or (same? name "c_type_hint")
                                                                                                            (or (same? name "c_fn_Z_Malloc")
                                                                                                                (or (same? name "c_fn_Z_Free")
                                                                                                                    (or (same? name "track-c-type-view")
                                                                                                                        (or (same? name "track-c-region")
                                                                                                                            (same? name "retire-c-region"))))))))))))))))))))))))))))))))))
(defn hi-discover-allocations [(e Code) (plan Code)] (-> Code)
  (if (not (primitive/code-list? e))
      plan
      (if (= (primitive/code-count e) 0)
          plan
          (let [h (primitive/code-nth e 0)
                relevant (allocator-operation-name? h)]
            (if (not relevant)
                (let [(mut i) 0 (mut found) plan]
                  (loop (if (>= (load i) (primitive/code-count e))
                            (break)
                            (do
                              (set! found (hi-discover-allocations (primitive/code-nth e (load i))
                                                                   (load found)))
                              (set! i (+ (load i) 1)))))
                  (load found))
                (let [et (primitive/type-of e)
                collection-T (arraylist-element-type et)
                pushed-T (if (and (arraylist-decl? h "al-push!")
                                  (>= (primitive/code-count e) 4))
                             (one-generic-argument (primitive/code-nth e 1))
                             `:unknown)
                T
                  (if (and (primitive/code-list? et)
                           (= (primitive/code-count et) 2)
                           (same? (last-name (primitive/code-nth et 0)) "Option"))
                      (let [p (primitive/code-nth et 1)]
                        (if (and (primitive/code-list? p)
                                 (= (primitive/code-count p) 2)
                                 (or (same? (last-name (primitive/code-nth p 0)) "ptr")
                                     (same? (last-name (primitive/code-nth p 0)) "slice"))
                                 (inspectable-type? (primitive/code-nth p 1)))
                            (primitive/code-nth p 1)
                            `:unknown))
                      `:unknown)
                hint-T (c-type-hint-type e h)
                with-collection (if (primitive/code-eq collection-T `:unknown)
                                    plan
                                    (plan-add-type collection-T plan))
                with-push (if (primitive/code-eq pushed-T `:unknown)
                              with-collection
                              (plan-add-type pushed-T with-collection))
                with-hint (if (primitive/code-eq hint-T `:unknown)
                              with-push
                              (plan-add-type hint-T with-push))
                next
                  (if (and (or (alloc-decl? h "create") (alloc-decl? h "alloc"))
                           (and (not (primitive/code-eq T `:unknown))
                                (primitive/code-eq (plan-find T with-hint 0 (primitive/code-count with-hint)) `:unknown)))
                      (plan-add-type T with-hint)
                      with-hint)]
            (if (runtime-marker? h)
                next
                (let [(mut i) 0
                      (mut found) next]
                  (loop (if (>= (load i) (primitive/code-count e))
                            (break)
                            (do
                              (set! found
                                    (hi-discover-allocations (primitive/code-nth e (load i))
                                                             (load found)))
                              (set! i (+ (load i) 1)))))
                  (load found)))))))))
(defn plan-defs [(plan Code) (i i64) (n i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut at) i]
    (loop (if (>= (load at) n)
              (break)
              (let [entry (primitive/code-nth plan (load at))
                    T (primitive/code-nth entry 0)
                    show (primitive/code-nth entry 1)
                    metadata (primitive/code-nth entry 2)
                    json (primitive/code-nth entry 3)
                    q (primitive/fresh-identifier "inspector_value")
                    tid (primitive/fresh-identifier "inspector_type")
                    structured (struct-code? T)
                    field-count (if structured (primitive/code-field-count T) 0)]
                (primitive/code-list-push! out
                                           (if structured
                                               `(defn ~show [(raw (ptr i8))] (-> i64)
                                                  (let [~q (primitive/cast (ptr ~T) raw)]
                                                    (print-text ~(type-display-name T))
                                                    (printf c" { ")
                                                    ~@(field-lines T q 0 field-count)
                                                    (printf c"}\n")
                                                    0))
                                               `(defn ~show [(raw (ptr i8))] (-> i64)
                                                  (show-raw raw))))
                (primitive/code-list-push! out
                                           (if structured
                                               `(defn ~json [(raw (ptr i8))] (-> i64)
                                                  (let [~q (primitive/cast (ptr ~T) raw)]
                                                    (json-byte! (primitive/cast u8 #\{))
                                                    ~@(json-field-lines T q 0 field-count)
                                                    (json-byte! (primitive/cast u8 #\}))
                                                    0))
                                               (if (u8-code? T)
                                                   `(defn ~json [(raw (ptr i8))] (-> i64)
                                                      (json-int! (primitive/cast i64 (load (primitive/cast (ptr u8) raw)))))
                                                   `(defn ~json [(raw (ptr i8))] (-> i64)
                                                      (json-quoted! (load (primitive/cast (ptr (slice u8)) raw)))))))
                (primitive/code-list-push! out
                                           `(defn ~metadata [] (-> i64)
                                              (let [~tid
                                                      (register-type ~(type-display-name T)
                                                                     (alloc/type-id [~T])
                                                                     ~(layout-fingerprint T)
                                                                     (primitive/sizeof ~T)
                                                                     (primitive/alignof ~T)
                                                                     ~field-count
                                                                     (primitive/fnptr-of ~show)
                                                                     (primitive/fnptr-of ~json))]
                                                ~@(if structured (field-registrations T tid 0 field-count) `())
                                                ~tid)))
                (set! at (+ (load at) 1)))))
    (primitive/code-list-done out)))
(defn rewrite [(e Code) (plan Code)] (-> Code)
  (if (not (primitive/code-list? e))
      e
      (if (= (primitive/code-count e) 0)
          e
          (let [h (primitive/code-nth e 0)
                et (primitive/type-of e)
                pushed-T (if (and (arraylist-decl? h "al-push!")
                                  (>= (primitive/code-count e) 4))
                             (one-generic-argument (primitive/code-nth e 1))
                             `:unknown)
                hint-T (c-type-hint-type e h)
                hint-entry (if (primitive/code-eq hint-T `:unknown)
                               `:unknown
                               (plan-find hint-T plan 0 (primitive/code-count plan)))
                c-rewritten
                  (if (and (c-zone-call? e h "c_fn_Z_Malloc") (= (primitive/code-count e) 4))
                      `(track-c-region ~e (primitive/cast i64 ~(primitive/code-nth e 1)))
                      (if (and (c-zone-call? e h "c_fn_Z_Free") (= (primitive/code-count e) 2))
                          (let [memory (primitive/fresh-identifier "inspector_c_region")]
                            `(let [~memory ~(rewrite (primitive/code-nth e 1) plan)]
                               (do (retire-c-region ~memory)
                                   (~h ~memory))))
                  (if (and (c-type-hint-call? e h) (= (primitive/code-count e) 5))
                      (if (primitive/code-eq hint-entry `:unknown)
                          `(track-c-type-view ~(rewrite (primitive/code-nth e 4) plan)
                                              ~(primitive/code-nth e 1)
                                              ~(primitive/code-nth e 2)
                                              ~(primitive/code-nth e 3))
                          `(track-c-struct-view [~hint-T]
                                                ~(rewrite (primitive/code-nth e 4) plan)
                                                ~(primitive/code-nth e 2)
                                                (~(primitive/code-nth hint-entry 2))
                                                (primitive/fnptr-of ~(primitive/code-nth hint-entry 1))))
                      (if (and (c-allocator-call? e h "malloc") (= (primitive/code-count e) 2))
                          `(inspect-c-malloc ~(rewrite (primitive/code-nth e 1) plan))
                          (if (and (c-allocator-call? e h "calloc") (= (primitive/code-count e) 3))
                              `(inspect-c-calloc ~(rewrite (primitive/code-nth e 1) plan)
                                                 ~(rewrite (primitive/code-nth e 2) plan))
                              (if (and (c-allocator-call? e h "realloc") (= (primitive/code-count e) 3))
                                  `(inspect-c-realloc ~(rewrite (primitive/code-nth e 1) plan)
                                                      ~(rewrite (primitive/code-nth e 2) plan))
                                  (if (and (c-allocator-call? e h "free") (= (primitive/code-count e) 2))
                                      `(inspect-c-free ~(rewrite (primitive/code-nth e 1) plan))
                                      `:unknown)))))))
                T
                  (if (and (primitive/code-list? et)
                           (= (primitive/code-count et) 2)
                           (same? (last-name (primitive/code-nth et 0)) "Option"))
                      (let [p (primitive/code-nth et 1)]
                        (if (and (primitive/code-list? p)
                                 (= (primitive/code-count p) 2)
                                 (or (same? (last-name (primitive/code-nth p 0)) "ptr")
                                     (same? (last-name (primitive/code-nth p 0)) "slice"))
                                 (inspectable-type? (primitive/code-nth p 1)))
                            (primitive/code-nth p 1)
                            `:unknown))
                      `:unknown)]
            (if (runtime-marker? h)
                e
                (if (not (primitive/code-eq c-rewritten `:unknown))
                    c-rewritten
                (if (not (primitive/code-eq pushed-T `:unknown))
                    (let [entry (plan-find pushed-T plan 0 (primitive/code-count plan))]
                      (if (primitive/code-eq entry `:unknown)
                          e
                          `(track-arraylist-push [~pushed-T]
                             ~e
                             ~(rewrite (primitive/code-nth e 2) plan)
                             (~(primitive/code-nth entry 2)))))
                (if (and (alloc-decl? h "alloc") (not (primitive/code-eq T `:unknown)))
                    (let [entry (plan-find T plan 0 (primitive/code-count plan))]
                      `(track-alloc [~T]
                                    ~e
                                    (~(primitive/code-nth entry 2))
                                    (primitive/fnptr-of ~(primitive/code-nth entry 1))))
                (if (and (alloc-decl? h "raw-alloc") (= (primitive/code-count e) 3))
                    `(inspect-raw-alloc
                       ~(rewrite (primitive/code-nth e 1) plan)
                       ~(rewrite (primitive/code-nth e 2) plan))
                (if (and (alloc-decl? h "raw-resize") (= (primitive/code-count e) 5))
                    `(inspect-raw-resize
                       ~(rewrite (primitive/code-nth e 1) plan)
                       ~(rewrite (primitive/code-nth e 2) plan)
                       ~(rewrite (primitive/code-nth e 3) plan)
                       ~(rewrite (primitive/code-nth e 4) plan))
                (if (and (alloc-decl? h "raw-remap") (= (primitive/code-count e) 5))
                    `(inspect-raw-remap
                       ~(rewrite (primitive/code-nth e 1) plan)
                       ~(rewrite (primitive/code-nth e 2) plan)
                       ~(rewrite (primitive/code-nth e 3) plan)
                       ~(rewrite (primitive/code-nth e 4) plan))
                (if (and (alloc-decl? h "raw-free") (= (primitive/code-count e) 4))
                    `(inspect-raw-free
                       ~(rewrite (primitive/code-nth e 1) plan)
                       ~(rewrite (primitive/code-nth e 2) plan)
                       ~(rewrite (primitive/code-nth e 3) plan))
                (if (and (alloc-decl? h "create") (not (primitive/code-eq T `:unknown)))
                    (let [entry (plan-find T plan 0 (primitive/code-count plan))]
                      `(track-create [~T]
                                     ~e
                                     (~(primitive/code-nth entry 2))
                                     (primitive/fnptr-of ~(primitive/code-nth entry 1))))
                    (if (and (alloc-decl? h "destroy") (= (primitive/code-count e) 3))
                        (let [pt (primitive/type-of (primitive/code-nth e 2))
                              DT
                                (if (and (primitive/code-list? pt)
                                         (= (primitive/code-count pt) 2)
                                         (same? (last-name (primitive/code-nth pt 0)) "ptr")
                                         (struct-code? (primitive/code-nth pt 1)))
                                    (primitive/code-nth pt 1)
                                    `:unknown)]
                          (if (primitive/code-eq DT `:unknown)
                              (let [out (primitive/code-list-new)
                                    (mut i) 0]
                                (loop (if (>= (load i) (primitive/code-count e))
                                          (break)
                                          (do
                                            (primitive/code-list-push! out
                                                                       (rewrite (primitive/code-nth e (load i)) plan))
                                            (set! i (+ (load i) 1)))))
                                (let [done (primitive/code-list-done out)]
                                  (if (primitive/code-vector? e) `[~@done] done)))
                              `(track-destroy [~DT]
                                              ~(rewrite (primitive/code-nth e 1) plan)
                                              ~(rewrite (primitive/code-nth e 2) plan))))
                        (let [out (primitive/code-list-new)
                              (mut i) 0]
                          (loop (if (>= (load i) (primitive/code-count e))
                                    (break)
                                    (do
                                      (primitive/code-list-push! out (rewrite (primitive/code-nth e (load i)) plan))
                                      (set! i (+ (load i) 1)))))
                          (let [done (primitive/code-list-done out)]
                            (if (primitive/code-vector? e) `[~@done] done)))))))))))))))))
(defn own? [(m Code)] (-> bool)
  (let [name (primitive/code-nth m 0)]
    (or (primitive/code-eq name `experiments.heap-inspector.runtime)
        (or (primitive/code-eq name `experiments.heap-inspector.viewer)
            (primitive/code-eq name `experiments.heap-inspector.transform)))))
(defn any-user? [(m Code)] (-> bool)
  (let [(mut i) 1
        (mut found) false]
    (loop (if (>= (load i) (primitive/code-count m))
              (break)
              (if (primitive/code-from-user? (primitive/code-nth m (load i)))
                  (do (set! found true) (break))
                  (set! i (+ (load i) 1)))))
    (load found)))
(defn allocator-boundary-module? [(m Code)] (-> bool)
  (primitive/code-eq (primitive/code-nth m 0) `coil.alloc))
(defn rewrite-candidate? [(e Code) (h Code)] (-> bool)
  (let [c-call (or (c-type-hint-call? e h)
                   (or (c-zone-call? e h "c_fn_Z_Malloc")
                       (or (c-zone-call? e h "c_fn_Z_Free")
                           (or (c-allocator-call? e h "malloc")
                               (or (c-allocator-call? e h "calloc")
                                   (or (c-allocator-call? e h "realloc")
                                       (c-allocator-call? e h "free")))))))
        typed-call (or (arraylist-decl? h "al-push!")
                       (or (alloc-decl? h "alloc")
                           (or (alloc-decl? h "create")
                               (alloc-decl? h "destroy"))))
        raw-call (or (alloc-decl? h "raw-alloc")
                     (or (alloc-decl? h "raw-resize")
                         (or (alloc-decl? h "raw-remap")
                             (alloc-decl? h "raw-free"))))]
    (or (runtime-marker? h) (or c-call (or typed-call raw-call)))))
(defn rewrite-call? [(e Code)] (-> bool)
  (if (or (not (primitive/code-list? e)) (= (primitive/code-count e) 0))
      false
      (let [h (primitive/code-nth e 0)]
        (and (allocator-operation-name? h)
             (rewrite-candidate? e h)))))
(defn contains-rewrite-call? [(e Code)] (-> bool)
  (if (rewrite-call? e)
      true
      (if (not (primitive/code-list? e))
          false
          (let [(mut i) 0 (mut found) false]
            (loop (if (or (>= (load i) (primitive/code-count e)) (load found))
                      (break)
                      (do
                        (if (contains-rewrite-call? (primitive/code-nth e (load i))) (set! found true) 0)
                        (set! i (+ (load i) 1)))))
            (load found)))))
(defn main-defn? [(f Code)] (-> bool)
  (and (primitive/code-list? f)
       (>= (primitive/code-count f) 5)
       (primitive/code-eq (primitive/code-nth f 0) `defn)
       (primitive/code-eq (primitive/code-nth f 1) `main)))
(defn boot-injected? [(f Code)] (-> bool)
  (if (not (main-defn? f))
      false
      (let [body (primitive/code-nth f 4)]
        (and (primitive/code-list? body)
             (> (primitive/code-count body) 1)
             (primitive/code-eq (primitive/code-nth body 0) `let)
             (let [bindings (primitive/code-nth body 1)]
               (and (primitive/code-list? bindings)
                    (> (primitive/code-count bindings) 0)
                    (primitive/code-eq (primitive/code-nth bindings 0) `__heap_inspector_boot__)))))))
(defn inject-boot [(f Code)] (-> Code)
  (if (or (not (main-defn? f)) (boot-injected? f))
      f
      (let [out (primitive/code-list-new) (mut i) 4]
        (loop (if (>= (load i) (primitive/code-count f))
                  (break)
                  (do (primitive/code-list-push! out (primitive/code-nth f (load i)))
                      (set! i (+ (load i) 1)))))
        `(defn ~(primitive/code-nth f 1)
           ~(primitive/code-nth f 2)
           ~(primitive/code-nth f 3)
           (let [__heap_inspector_boot__ (viewer/inspector-boot!)]
             ~@(primitive/code-list-done out))))))
(defn defn-form? [(f Code)] (-> bool)
  (and (primitive/code-list? f)
       (>= (primitive/code-count f) 5)
       (primitive/code-eq (primitive/code-nth f 0) `defn)))

(defn live-scalar-kind [(T Code)] (-> i64)
  (cond (primitive/code-eq T `i64) 1
        (primitive/code-eq T `bool) 2
        (primitive/code-eq T `f64) 3
        :else 0))
(defn live-return-kind [(r Code)] (-> i64)
  (if (and (primitive/code-list? r)
           (and (> (primitive/code-count r) 0)
                (primitive/code-eq (primitive/code-nth r 0) `->)))
      (if (= (primitive/code-count r) 1)
          4
          (if (= (primitive/code-count r) 2)
              (let [kind (live-scalar-kind (primitive/code-nth r 1))]
                (if (> kind 0) kind 5))
              0))
      0))
(defn live-concrete-params? [(ps Code) (i i64)] (-> bool)
  (if (>= i (primitive/code-count ps))
      true
      (let [p (primitive/code-nth ps i)]
        (and (primitive/code-list? p)
             (and (= (primitive/code-count p) 2)
                  (live-concrete-params? ps (+ i 1)))))))
(defn live-function? [(f Code)] (-> bool)
  (and (primitive/code-from-user? f)
       (and (defn-form? f)
            (and (not (same? (last-name (primitive/code-nth f 1)) "main"))
                 (and (primitive/code-vector? (primitive/code-nth f 2))
                      (and (> (live-return-kind (primitive/code-nth f 3)) 0)
                           (live-concrete-params? (primitive/code-nth f 2) 0)))))))
(defn live-type-name [(T Code)] (-> (slice u8))
  (cond (primitive/code-eq T `i64) "i64"
        (primitive/code-eq T `bool) "bool"
        (primitive/code-eq T `f64) "f64"
        :else (primitive/code-str T)))
(defn live-param-binding [(T Code)] (-> i64)
  (if (and (primitive/code-list? T)
           (and (= (primitive/code-count T) 2)
                (and (primitive/code-eq (primitive/code-nth T 0) `dyn)
                     (same? (last-name (primitive/code-nth T 1)) "Allocator"))))
      1
      0))
(defn live-pointer? [(T Code)] (-> bool)
  (and (primitive/code-list? T)
       (and (= (primitive/code-count T) 2)
            (primitive/code-eq (primitive/code-nth T 0) `ptr))))
(defn live-call-args [(ps Code) (args-id Code) (i i64) (body-i i64)] (-> Code)
  (let [out (primitive/code-list-new) (mut at) i (mut input-at) body-i]
    (loop (if (>= (load at) (primitive/code-count ps))
              (break)
              (let [T (primitive/code-nth (primitive/code-nth ps (load at)) 1)
                    binding (live-param-binding T)
                    pointer? (live-pointer? T)
                    pointee (if pointer? (primitive/code-nth T 1) `i8)
                    arg (cond (= binding 1) `(alloc/malloc-allocator)
                              pointer? `(call-arg-allocation-ptr [~pointee] ~args-id ~(load input-at))
                              (= (live-scalar-kind T) 1) `(call-arg-i64 ~args-id ~(load input-at))
                              (= (live-scalar-kind T) 2) `(call-arg-bool ~args-id ~(load input-at))
                              (= (live-scalar-kind T) 3) `(call-arg-f64 ~args-id ~(load input-at))
                              :else `(call-arg-raw [~T] ~args-id ~(load input-at)))]
                (primitive/code-list-push! out arg)
                (if (= binding 0) (set! input-at (+ (load input-at) 1)) 0)
                (set! at (+ (load at) 1)))))
    (primitive/code-list-done out)))
(defn live-adapter [(f Code) (wrapper Code)] (-> Code)
  (let [name (primitive/code-nth f 1)
        ps (primitive/code-nth f 2)
        r (primitive/code-nth f 3)
        rk (live-return-kind r)
        RT (if (= rk 4) `i64 (primitive/code-nth r 1))
        args-id (primitive/fresh-identifier "call_args")
        result-id (primitive/fresh-identifier "call_result")
        call `(~name ~@(live-call-args ps args-id 0 0))]
    `(defn ~wrapper [(~args-id (slice u8))] (-> i64)
       (json-reset!)
       (json-text! "{\"ok\":true,\"value\":")
       ~(cond (= rk 1) `(json-int! ~call)
              (= rk 2) `(if ~call (json-text! "true") (json-text! "false"))
              (= rk 3) `(json-f64! ~call)
              (= rk 4) `(do ~call (json-text! "null"))
              :else `(let [~result-id (primitive/alloc-stack ~RT)]
                       (set! ~result-id ~call)
                       (json-typed-bytes-value! ~(live-type-name RT)
                                                (primitive/cast (ptr i8) ~result-id)
                                                (primitive/sizeof ~RT))))
       (json-byte! (primitive/cast u8 #\}))
       0)))
(defn live-param-registration-calls [(ps Code) (id Code) (i i64)] (-> Code)
  (let [out (primitive/code-list-new) (mut at) i]
    (loop (if (>= (load at) (primitive/code-count ps))
              (break)
              (let [p (primitive/code-nth ps (load at))]
                (primitive/code-list-push!
                  out
                  `(register-function-param ~id
                                            ~(primitive/code-str (primitive/code-nth p 0))
                                            ~(live-type-name (primitive/code-nth p 1))
                                            (primitive/sizeof ~(primitive/code-nth p 1))
                                            ~(live-param-binding (primitive/code-nth p 1))))
                (set! at (+ (load at) 1)))))
    (primitive/code-list-done out)))
(defn live-function-plan [(m Code)] (-> Code)
  (let [out (primitive/code-list-new) (mut i) 1]
    (loop (if (>= (load i) (primitive/code-count m))
              (break)
              (let [f (primitive/code-nth m (load i))]
                (if (live-function? f)
                    (do (primitive/code-list-push! out
                          `(~f ~(primitive/fresh-identifier "heap_inspector_invoke")))
                        0)
                    0)
                (set! i (+ (load i) 1)))))
    (primitive/code-list-done out)))
(defn module-functions-injected? [(m Code) (i i64)] (-> bool)
  (if (>= i (primitive/code-count m))
      false
      (let [f (primitive/code-nth m i)]
        (if (and (defn-form? f)
                 (same? (last-name (primitive/code-nth f 1)) "heap_inspector_function_catalog"))
            true
            (module-functions-injected? m (+ i 1))))))
(defn live-registrar-body [(plan Code) (module-name (slice u8)) (i i64)] (-> Code)
  (if (>= i (primitive/code-count plan))
      `0
      (let [item (primitive/code-nth plan i)
            f (primitive/code-nth item 0)
            wrapper (primitive/code-nth item 1)
            ps (primitive/code-nth f 2)
            ret (primitive/code-nth f 3)
            id (primitive/fresh-identifier "function_id")]
        `(let [~id (register-function ~(primitive/code-str (primitive/code-nth f 1))
                                      ~module-name
                                      ~(if (= (live-return-kind ret) 4)
                                           "void"
                                           (live-type-name (primitive/code-nth ret 1)))
                                      ~(if (= (live-return-kind ret) 4)
                                           `0
                                           `(primitive/sizeof ~(primitive/code-nth ret 1)))
                                      (primitive/fnptr-of ~wrapper))]
           ~@(live-param-registration-calls ps id 0)
           ~(live-registrar-body plan module-name (+ i 1))))))
(defn inject-function-registrars [(f Code) (calls Code)] (-> Code)
  (if (or (not (main-defn? f)) (= (primitive/code-count calls) 0))
      f
      (let [out (primitive/code-list-new) (mut i) 4]
        (loop (if (>= (load i) (primitive/code-count f))
                  (break)
                  (do (primitive/code-list-push! out (primitive/code-nth f (load i)))
                      (set! i (+ (load i) 1)))))
        `(defn ~(primitive/code-nth f 1) ~(primitive/code-nth f 2) ~(primitive/code-nth f 3)
           (do ~@calls ~@(primitive/code-list-done out))))))
(defn type-registration-injected? [(f Code)] (-> bool)
  (if (not (defn-form? f))
      false
      (let [body (primitive/code-nth f 4)]
        (and (primitive/code-list? body)
             (> (primitive/code-count body) 1)
             (primitive/code-eq (primitive/code-nth body 0) `let)
             (let [bindings (primitive/code-nth body 1)]
               (and (primitive/code-list? bindings)
                    (> (primitive/code-count bindings) 0)
                    (primitive/code-eq (primitive/code-nth bindings 0) `__heap_inspector_types__)))))))
(defn inject-type-registration [(f Code) (registrar Code)] (-> Code)
  (if (or (not (primitive/code-from-user? f))
          (or (not (main-defn? f)) (type-registration-injected? f)))
      f
      (let [out (primitive/code-list-new) (mut i) 4]
        (loop (if (>= (load i) (primitive/code-count f))
                  (break)
                  (do (primitive/code-list-push! out (primitive/code-nth f (load i)))
                      (set! i (+ (load i) 1)))))
        `(defn ~(primitive/code-nth f 1)
           ~(primitive/code-nth f 2)
           ~(primitive/code-nth f 3)
           (let [__heap_inspector_types__ (~registrar)]
             ~@(primitive/code-list-done out))))))
(defn module-types-injected? [(m Code) (i i64)] (-> bool)
  (if (>= i (primitive/code-count m))
      false
      (let [form (primitive/code-nth m i)]
        (if (or (type-registration-injected? form)
                (and (defn-form? form)
                     (same? (last-name (primitive/code-nth form 1)) "__heap_inspector_metadata_catalog__")))
            true
            (module-types-injected? m (+ i 1))))))
(defn registration-calls [(plan Code) (i i64) (n i64)] (-> Code)
  (let [out (primitive/code-list-new) (mut at) i]
    (loop (if (>= (load at) n)
              (break)
              (do
                (primitive/code-list-push! out `(~(primitive/code-nth (primitive/code-nth plan (load at)) 2)))
                (set! at (+ (load at) 1)))))
    (primitive/code-list-done out)))
(defn xf-mod [(m Code)] (-> Code)
  (if (or (<= (primitive/code-count m) 1)
          (own? m)
          (and (not (any-user? m)) (not (allocator-boundary-module? m))))
      m
      (let [functions-done (module-functions-injected? m 1)
            plan (if (module-types-injected? m 1)
                     `()
                     (hi-discover-allocations m `()))
            function-plan (if functions-done `() (live-function-plan m))
            function-registrar (primitive/fresh-identifier "heap_inspector_function_catalog")
            calls (if (> (primitive/code-count function-plan) 0) `((~function-registrar)) `())
            registrar `__heap_inspector_metadata_catalog__]
          (let [out (primitive/code-list-new)
              (mut i) 1]
          (primitive/code-list-push! out (primitive/code-nth m 0))
          (loop (if (>= (load i) (primitive/code-count m))
                    (break)
                    (do
                      (let [with-functions (inject-function-registrars (primitive/code-nth m (load i)) calls)
                            booted (inject-boot with-functions)
                            form (if (> (primitive/code-count plan) 0)
                                     (inject-type-registration booted registrar)
                                     booted)]
                        (primitive/code-list-push! out (if (contains-rewrite-call? form) (rewrite form plan) form)))
                      (set! i (+ (load i) 1)))))
          (let [defs (plan-defs plan 0 (primitive/code-count plan))
                (mut j) 0]
            (loop (if (>= (load j) (primitive/code-count defs))
                      (break)
                      (do
                        (primitive/code-list-push! out (primitive/code-nth defs (load j)))
                        (set! j (+ (load j) 1))))))
          (if (> (primitive/code-count plan) 0)
              (do
                (primitive/code-list-push!
                  out
                  `(defn ~registrar [] (-> i64)
                     (let [done (primitive/alloc-static bool)]
                       (if (load done)
                           0
                           (do
                             (set! done true)
                             ~@(registration-calls plan 0 (primitive/code-count plan))
                             0)))))
                0)
              0)
          (for [j 0 (primitive/code-count function-plan)]
            (let [item (primitive/code-nth function-plan j)]
              (primitive/code-list-push! out
                (live-adapter (primitive/code-nth item 0) (primitive/code-nth item 1)))))
          (if (> (primitive/code-count function-plan) 0)
              (do (primitive/code-list-push!
                    out
                    `(defn ~function-registrar [] (-> i64)
                       (let [done (primitive/alloc-static bool)]
                         (if (load done)
                             0
                             (do (set! done true)
                                 ~(live-registrar-body function-plan
                                                       (primitive/code-str (primitive/code-nth m 0))
                                                       0))))))
                  0)
              0)
          (primitive/code-list-done out)))))
(defn xf-mods [(ms Code) (i i64) (n i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut at) i]
    (loop (if (>= (load at) n)
              (break)
              (do
                (primitive/code-list-push! out (xf-mod (primitive/code-nth ms (load at))))
                (set! at (+ (load at) 1)))))
    (primitive/code-list-done out)))
(defn heap-inspector-transform [(mods Code)] (-> Code)
  `(do ~@(xf-mods mods 0 (primitive/code-count mods))))
(transform heap-inspector-transform)
