(module experiments.heap-inspector.viewer-demo)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.result" :use *)
(import "coil.time" :as time)
(import "experiments.heap-inspector.runtime" :use *)
(import "experiments.heap-inspector.transform" :use *)

(defstruct Worker [(name (slice u8)) (jobs i64) (active bool) (load f64)])

(defn main [] (-> i64)
  (let [a (alloc/malloc-allocator)
        raw (match (alloc/alloc-bytes a 4 1)
              (None [] (alloc/alloc-slice-new (primitive/cast (ptr u8) 0) 0))
              (Some [memory] memory))
        workers (match (alloc/alloc [Worker] a 3)
                  (None [] (alloc/alloc-slice-new (primitive/cast (ptr Worker) 0) 0))
                  (Some [memory] memory))]
    (if (= (alloc/alloc-slice-len raw) 4)
        (do (set! (primitive/index (alloc/alloc-slice-data raw) 0) (primitive/cast u8 67))
            (set! (primitive/index (alloc/alloc-slice-data raw) 1) (primitive/cast u8 111))
            (set! (primitive/index (alloc/alloc-slice-data raw) 2) (primitive/cast u8 105))
            (set! (primitive/index (alloc/alloc-slice-data raw) 3) (primitive/cast u8 108)))
        0)
    (if (= (alloc/alloc-slice-len workers) 3)
        (do
          (set! (.name (primitive/index (alloc/alloc-slice-data workers) 0)) "researcher")
          (set! (.jobs (primitive/index (alloc/alloc-slice-data workers) 0)) 12)
          (set! (.active (primitive/index (alloc/alloc-slice-data workers) 0)) true)
          (set! (.load (primitive/index (alloc/alloc-slice-data workers) 0)) 0.75)
          (set! (.name (primitive/index (alloc/alloc-slice-data workers) 1)) "coder")
          (set! (.jobs (primitive/index (alloc/alloc-slice-data workers) 1)) 7)
          (set! (.active (primitive/index (alloc/alloc-slice-data workers) 1)) true)
          (set! (.load (primitive/index (alloc/alloc-slice-data workers) 1)) 0.5)
          (set! (.name (primitive/index (alloc/alloc-slice-data workers) 2)) "reviewer")
          (set! (.jobs (primitive/index (alloc/alloc-slice-data workers) 2)) 3)
          (set! (.active (primitive/index (alloc/alloc-slice-data workers) 2)) false)
          (set! (.load (primitive/index (alloc/alloc-slice-data workers) 2)) 0.1))
        0)
    (match (time/duration-seconds 30)
      (Err [e] 0)
      (Ok [duration] (match (time/sleep duration) (Err [e] 0) (Ok [n] n))))
    (alloc/free [Worker] a workers)
    (alloc/free-bytes a raw 1)
    0))
