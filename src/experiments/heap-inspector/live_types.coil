(module experiments.heap-inspector.live-types)

; Runtime ABI shared by generated live candidates. Keeping this nominal owner
; outside the Code metaprogram implementation lets incremental candidates load
; the type without loading or expanding the provider graph.
(defstruct LiveHandleOwner [(raw (ptr i8))])

; Ownership is part of the stable nominal type, not generated candidate code.
; The checker must see these impls when it first elaborates a function containing
; a LiveHandleOwner so temporary wrappers receive deterministic cleanup.
(extern coil_live_handle_retain :cc c [(ptr i8)] (-> i64))
(extern coil_live_handle_release :cc c [(ptr i8)] (-> i64))

(defn live-handle-owner-new [(raw (ptr i8))] (-> LiveHandleOwner)
  (LiveHandleOwner :raw raw))

(impl Clone LiveHandleOwner
  (clone [(self (ref LiveHandleOwner))] (-> LiveHandleOwner)
    (do
      (coil_live_handle_retain (.raw self))
      (live-handle-owner-new (.raw self)))))

(impl Drop LiveHandleOwner
  (drop [(self (mut LiveHandleOwner))] (-> void)
    (forget (coil_live_handle_release (.raw self)))))
