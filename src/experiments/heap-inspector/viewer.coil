(module experiments.heap-inspector.viewer)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.atomic" :as atomic)
(import "coil.fs" :as fs)
(import "coil.slice" :use *)
(import "coil.result" :use *)
(import "coil.socket" :as socket)
(import "coil.thread" :as thread)
(import "coil.sync" :as sync)
(import "experiments.heap-inspector.runtime" :use *)
(import "experiments.heap-inspector.live-api" :as live-api)
(import "experiments.heap-inspector.native-demo-api" :as demo-api)

(extern printf :cc c [(ptr i8) ...] (-> i32))
(extern getenv :cc c [(ptr i8)] (-> (ptr i8)))
(extern strlen :cc c [(ptr i8)] (-> i64))
(extern sscanf :cc c [(ptr i8) (ptr i8) ...] (-> i32))
(extern strstr :cc c [(ptr i8) (ptr i8)] (-> (ptr i8)))
(extern malloc :cc c [u64] (-> (ptr i8)))
(extern free :cc c [(ptr i8)] (-> i64))

(const VIEWER_REQUEST_CAPACITY 1048576)

(defstruct ViewerState
  [(listener socket/TcpListener)
   (connection socket/TcpConnection)
   (thread thread/Thread)
   (edit-thread thread/Thread)
   (edit-event sync/Event)
   (edit-active i64)
   (edit-started bool)
   (edit-source (ptr u8))
   (edit-source-len i64)
   (edit-result i64)
   (started bool)
   (port i64)
   (asset-root (slice u8))])

(defn viewer-state [] (-> (ptr ViewerState))
  (primitive/alloc-static ViewerState))

(defn cstr-slice [(p (ptr i8))] (-> (slice u8))
  (slice-new (primitive/cast (ptr u8) p) (strlen p)))

(defn request-prefix? [(buf (ptr i8)) (n i64) (needle (ptr i8))] (-> bool)
  (let [needed (strlen needle) (mut i) 0 (mut same) true]
    (if (< n needed)
        false
        (do
          (loop (if (>= (load i) needed)
                    (break)
                    (if (= (load (primitive/index buf (load i))) (load (primitive/index needle (load i))))
                        (set! i (+ (load i) 1))
                        (do (set! same false) (break)))))
          (load same)))))

(defn request-body [(buf (ptr i8)) (n i64)] (-> (slice u8))
  (let [(mut i) 0 (mut at) -1]
    (loop (if (> (+ (load i) 3) n)
              (break)
              (if (and (= (primitive/cast i64 (load (primitive/index buf (load i)))) 13)
                       (and (= (primitive/cast i64 (load (primitive/index buf (+ (load i) 1)))) 10)
                            (and (= (primitive/cast i64 (load (primitive/index buf (+ (load i) 2)))) 13)
                                 (= (primitive/cast i64 (load (primitive/index buf (+ (load i) 3)))) 10))))
                  (do (set! at (+ (load i) 4)) (break))
                  (set! i (+ (load i) 1)))))
    (if (< (load at) 0)
        (slice-new (primitive/cast (ptr u8) buf) 0)
        (slice-new (primitive/cast (ptr u8) (primitive/index buf (load at))) (- n (load at))))))

(defn request-header-end [(buf (ptr i8)) (n i64)] (-> i64)
  (let [(mut i) 0 (mut at) -1]
    (loop (if (> (+ (load i) 3) n)
              (break)
              (if (and (= (primitive/cast i64 (load (primitive/index buf (load i)))) 13)
                       (and (= (primitive/cast i64 (load (primitive/index buf (+ (load i) 1)))) 10)
                            (and (= (primitive/cast i64 (load (primitive/index buf (+ (load i) 2)))) 13)
                                 (= (primitive/cast i64 (load (primitive/index buf (+ (load i) 3)))) 10))))
                  (do (set! at (+ (load i) 4)) (break))
                  (set! i (+ (load i) 1)))))
    (load at)))

(defn request-content-length [(buf (ptr i8)) (header-end i64)] (-> i64)
  (primitive/cast i64 header-end)
  (let [line (strstr buf c"Content-Length:")
        result (primitive/alloc-stack i64)]
    (store! result 0)
    (if (= (primitive/cast i64 line) 0)
        0
        (if (= (sscanf line c"Content-Length: %ld" result) 1)
            (load result)
            0))))

; Read through the declared HTTP body instead of assuming headers and source
; arrive in one packet. The hard cap bounds untrusted memory consumption and is
; large enough for a complete live source snapshot.
(defn read-request! [(connection (ptr socket/TcpConnection))
                     (buf (ptr i8)) (capacity i64)] (-> i64)
  (let [(mut n) 0 (mut wanted) -1 (mut failed) false]
    (loop (if (or (load failed)
                  (and (>= (load wanted) 0) (>= (load n) (load wanted))))
              (break)
              (if (>= (load n) capacity)
                  (set! failed true)
                  (match (socket/tcp-read connection (primitive/index buf (load n))
                                          (- capacity (load n)))
                    (Err [e] (set! failed true))
                    (Ok [got]
                      (if (<= got 0)
                          (set! failed true)
                          (do
                            (set! n (+ (load n) got))
                            (set! (primitive/index buf (load n)) (primitive/cast i8 0))
                            (let [header-end (request-header-end buf (load n))]
                              (if (>= header-end 0)
                                  (let [body-len (request-content-length buf header-end)]
                                    (if (> body-len (- capacity header-end))
                                        (set! failed true)
                                        (set! wanted (+ header-end body-len))))
                                  0)))))))))
    (if (load failed) -1 (load n))))

(defn send-all! [(connection (ptr socket/TcpConnection)) (bytes (slice u8))] (-> i64)
  (let [(mut at) 0 (mut failed) false]
    (loop (if (or (load failed) (>= (load at) (slice-len bytes)))
              (break)
              (match (socket/tcp-write connection
                                       (primitive/cast (ptr i8) (primitive/index (slice-data bytes) (load at)))
                                       (- (slice-len bytes) (load at)))
                (Err [e] (set! failed true))
                (Ok [n] (if (<= n 0) (set! failed true) (set! at (+ (load at) n)))))))
    (if (load failed) 1 0)))

(defn viewer-edit-worker [(arg (ptr i8))] (-> (ptr i8))
  (let [state (primitive/cast (ptr ViewerState) arg)
        (mut observed)
          (match (sync/event-generation (field state edit-event))
            (Err [e] -1)
            (Ok [generation] generation))]
    ; One persistent compiler thread owns every edit for this JIT session.
    ; Rejected Code state is thread-local to the compiler invocation context,
    ; so destroying and recreating a pthread between a rejection and its repair
    ; loses the authoritative recovery branch.
    (loop
      (if (= (atomic/atomic-load (field state edit-active)) 2)
          (let [source (slice-new (.edit-source state) (.edit-source-len state))
                result (live-api/live-api-edit! source)]
            (set! (.edit-result state) result)
            (free (primitive/cast (ptr i8) (.edit-source state)))
            (set! (.edit-source state) (primitive/cast (ptr u8) 0))
            (set! (.edit-source-len state) 0)
            ; Release publishes both the result and all controller state before
            ; a status request observes the worker as idle.
            (atomic/atomic-store (field state edit-active) 0))
          (match (sync/event-wait! (field state edit-event) (load observed))
            (Err [e] (break))
            (Ok [wait-result]
              (match wait-result
                (sync/Timeout [] 0)
                (sync/Notified [generation] (set! observed generation)))))))
    (primitive/cast (ptr i8) 0)))

(defn viewer-start-edit-worker! [(state (ptr ViewerState))] (-> i64)
  (if (.edit-started state) 0
      (match (sync/event-init (field state edit-event))
        (Err [e] -1)
        (Ok [_]
          (let [status (thread/thread-spawn-configured
                         (field state edit-thread)
                         (primitive/fnptr-of viewer-edit-worker)
                         (primitive/cast (ptr i8) state)
                         (thread/thread-config 16777216 4096))]
            (if (= status 0)
                (do (set! (.edit-started state) true) 0)
                (do (sync/event-destroy! (field state edit-event)) -1)))))))

; Returns 0 when accepted for background compilation, -2 while another edit is
; active, and -1 on allocation/thread failure. The copied source outlives the
; request buffer and is released by the worker.
(defn viewer-submit-edit! [(state (ptr ViewerState)) (source (slice u8))] (-> i64)
  (if (!= (atomic/atomic-cas (field state edit-active) 0 1) 0)
      -2
      (do
        (if (!= (viewer-start-edit-worker! state) 0)
            (do (atomic/atomic-store (field state edit-active) 0) -1)
            (let [copy (malloc (primitive/cast u64 (if (> (slice-len source) 0)
                                                   (slice-len source) 1)))]
          (if (= (primitive/cast i64 copy) 0)
              (do (atomic/atomic-store (field state edit-active) 0) -1)
              (do
                (for [i 0 (slice-len source)]
                  (set! (primitive/index copy i) (primitive/cast i8 (slice-get source i))))
                (set! (.edit-source state) (primitive/cast (ptr u8) copy))
                (set! (.edit-source-len state) (slice-len source))
                (atomic/atomic-store (field state edit-active) 2)
                (match (sync/event-notify-all! (field state edit-event))
                  (Ok [_] 0)
                  (Err [e]
                    (do
                      (free copy)
                      (set! (.edit-source state) (primitive/cast (ptr u8) 0))
                      (set! (.edit-source-len state) 0)
                      (atomic/atomic-store (field state edit-active) 0)
                      -1))))))))))

(defn asset-path [(state (ptr ViewerState)) (name (slice u8))] (-> (slice u8))
  (let [root (.asset-root state)
        n (+ (+ (slice-len root) 1) (slice-len name))
        memory (match (alloc/alloc [u8] (alloc/malloc-allocator) n)
                 (None [] (alloc/alloc-slice-new (primitive/cast (ptr u8) 0) 0))
                 (Some [s] s))]
    (if (= (alloc/alloc-slice-len memory) n)
        (do
          (for [i 0 (slice-len root)]
            (set! (primitive/index (alloc/alloc-slice-data memory) i) (slice-get root i)))
          (set! (primitive/index (alloc/alloc-slice-data memory) (slice-len root))
                (primitive/cast u8 #\/))
          (for [i 0 (slice-len name)]
            (set! (primitive/index (alloc/alloc-slice-data memory) (+ (+ (slice-len root) 1) i))
                  (slice-get name i))))
        0)
    memory))

(defn serve-asset! [(state (ptr ViewerState)) (name (slice u8)) (content-type (slice u8))] (-> i64)
  (let [a (alloc/malloc-allocator) path (asset-path state name)]
    (match (fs/read-file a path)
      (Err [e]
        (do (send-all! (field state connection)
                       "HTTP/1.1 404 Not Found\r\nContent-Type: text/plain\r\nConnection: close\r\n\r\nnot found")
            (alloc/free [u8] a path)
            1))
      (Ok [body]
        (do
          (send-all! (field state connection) "HTTP/1.1 200 OK\r\nContent-Type: ")
          (send-all! (field state connection) content-type)
          (send-all! (field state connection) "\r\nCache-Control: no-store\r\nConnection: close\r\n\r\n")
          (send-all! (field state connection) body)
          (alloc/free [u8] a body)
          (alloc/free [u8] a path)
          0)))))

(defn serve-one! [(state (ptr ViewerState))
                  (connection (ptr socket/TcpConnection))] (-> i64)
  (let [request (malloc (primitive/cast u64 (+ VIEWER_REQUEST_CAPACITY 1)))]
    (if (= (primitive/cast i64 request) 0)
        1
        (let [n (read-request! connection request VIEWER_REQUEST_CAPACITY)]
          (if (< n 0)
              (do (free request) 1)
              (do
                (set! (primitive/index request n) (primitive/cast i8 0))
                (let [memory-id (primitive/alloc-stack i64)
              memory-offset (primitive/alloc-stack i64)
              allocation-id (primitive/alloc-stack i64)
              function-id (primitive/alloc-stack i64)]
                  (cond
          (request-prefix? (primitive/index request 0) n c"POST /api/live/edit")
            (let [status (viewer-submit-edit! state
                            (request-body (primitive/index request 0) n))]
              (send-all! (field state connection)
                         (cond (= status 0)
                                 "HTTP/1.1 202 Accepted\r\nContent-Type: application/json\r\nCache-Control: no-store\r\nConnection: close\r\n\r\n"
                               (= status -2)
                                 "HTTP/1.1 409 Conflict\r\nContent-Type: application/json\r\nCache-Control: no-store\r\nConnection: close\r\n\r\n"
                               :else
                                 "HTTP/1.1 503 Service Unavailable\r\nContent-Type: application/json\r\nCache-Control: no-store\r\nConnection: close\r\n\r\n"))
              (send-all! (field state connection) (live-api/live-api-status)))
          (request-prefix? (primitive/index request 0) n c"GET /api/live")
            (do (send-all! (field state connection)
                           "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nCache-Control: no-store\r\nConnection: close\r\n\r\n")
                (send-all! (field state connection) (live-api/live-api-status)))
          (request-prefix? (primitive/index request 0) n c"GET /api/native-demo/frame")
            (do (send-all! (field state connection)
                           "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nCache-Control: no-store\r\nConnection: close\r\n\r\n")
                (send-all! (field state connection) (demo-api/native-demo-frame-json)))
          (request-prefix? (primitive/index request 0) n c"POST /api/native-demo/run")
            (do (demo-api/native-demo-set-running! true)
                (send-all! (field state connection)
                           "HTTP/1.1 204 No Content\r\nCache-Control: no-store\r\nConnection: close\r\n\r\n"))
          (request-prefix? (primitive/index request 0) n c"POST /api/native-demo/pause")
            (do (demo-api/native-demo-set-running! false)
                (send-all! (field state connection)
                           "HTTP/1.1 204 No Content\r\nCache-Control: no-store\r\nConnection: close\r\n\r\n"))
          (request-prefix? (primitive/index request 0) n c"POST /api/native-demo/step")
            (do (demo-api/native-demo-set-running! true)
                (demo-api/native-demo-frame-json)
                (demo-api/native-demo-set-running! false)
                (send-all! (field state connection)
                           "HTTP/1.1 204 No Content\r\nCache-Control: no-store\r\nConnection: close\r\n\r\n"))
          (request-prefix? (primitive/index request 0) n c"POST /api/native-demo/focus")
            (do (demo-api/native-demo-request-focus!)
                (send-all! (field state connection)
                           "HTTP/1.1 204 No Content\r\nCache-Control: no-store\r\nConnection: close\r\n\r\n"))
          (= (sscanf (primitive/index request 0) c"GET /api/memory/%ld/%ld" memory-id memory-offset) 2)
            (do (send-all! (field state connection)
                           "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nCache-Control: no-store\r\nConnection: close\r\n\r\n")
                (send-all! (field state connection) (inspector-memory (load memory-id) (load memory-offset))))
          (= (sscanf (primitive/index request 0) c"GET /api/allocation/%ld" allocation-id) 1)
            (do (send-all! (field state connection)
                           "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nCache-Control: no-store\r\nConnection: close\r\n\r\n")
                (send-all! (field state connection) (inspector-allocation-snapshot (load allocation-id))))
          (request-prefix? (primitive/index request 0) n c"GET /api/snapshot")
            (do (send-all! (field state connection)
                           "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nCache-Control: no-store\r\nConnection: close\r\n\r\n")
                (send-all! (field state connection) (inspector-snapshot)))
          (request-prefix? (primitive/index request 0) n c"GET /api/functions")
            (do (send-all! (field state connection)
                           "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nCache-Control: no-store\r\nConnection: close\r\n\r\n")
                (send-all! (field state connection) (inspector-functions)))
          (= (sscanf (primitive/index request 0) c"POST /api/call/%ld" function-id) 1)
            (do (send-all! (field state connection)
                           "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nCache-Control: no-store\r\nConnection: close\r\n\r\n")
                (send-all! (field state connection)
                           (inspector-call (load function-id)
                                           (request-body (primitive/index request 0) n))))
          (request-prefix? (primitive/index request 0) n c"GET /app.js")
            (serve-asset! state "app.js" "application/javascript; charset=utf-8")
          (request-prefix? (primitive/index request 0) n c"GET /native-demo.js")
            (serve-asset! state "native-demo.js" "application/javascript; charset=utf-8")
          (request-prefix? (primitive/index request 0) n c"GET /native-demo.css")
            (serve-asset! state "native-demo.css" "text/css; charset=utf-8")
          (request-prefix? (primitive/index request 0) n c"GET /native-demo")
            (serve-asset! state "native-demo.html" "text/html; charset=utf-8")
          (request-prefix? (primitive/index request 0) n c"GET /style.css")
            (serve-asset! state "style.css" "text/css; charset=utf-8")
                    :else (serve-asset! state "index.html" "text/html; charset=utf-8"))
                  (free request)
                  0)))))))

(defn viewer-thread [(arg (ptr i8))] (-> (ptr i8))
  (let [state (primitive/cast (ptr ViewerState) arg) (mut running) true]
    (loop (if (not (load running))
              (break)
              (match (socket/tcp-accept (field state listener) (field state connection))
                (Err [e] (set! running false))
                (Ok [c]
                  (do (serve-one! state c)
                      (socket/tcp-connection-close! (field state connection))
                      0)))))
    (primitive/cast (ptr i8) 0)))

(defn configured-asset-root [] (-> (slice u8))
  (let [p (getenv c"COIL_HEAP_INSPECTOR_VIEWER")]
    (if (= (primitive/cast i64 p) 0)
        "src/experiments/heap-inspector/viewer"
        (cstr-slice p))))

(defn configured-port [] (-> i64)
  (let [text (getenv c"COIL_HEAP_INSPECTOR_PORT")
        value (primitive/alloc-stack i64)]
    (set! value 7391)
    (if (and (!= (primitive/cast i64 text) 0)
             (= (sscanf text c"%ld" value) 1))
        (if (and (> (load value) 0) (<= (load value) 65535))
            (load value)
            7391)
        7391)))

(defn inspector-start-viewer! [(port i64)] (-> bool)
  (let [state (viewer-state)]
    (if (.started state)
        true
        (do
          (set! (.asset-root state) (configured-asset-root))
          (match (socket/tcp-listen (alloc/malloc-allocator) (field state listener) "127.0.0.1" port true 8)
            (Err [e] false)
            (Ok [listener]
              (do
                (set! (.port state) port)
                (if (!= (primitive/cast i64
                                         (thread/thread-spawn (field state thread)
                                                              (primitive/fnptr-of viewer-thread)
                                                              (primitive/cast (ptr i8) state)))
                        0)
                    false
                    (do (set! (.started state) true)
                        (printf c"heap inspector: http://127.0.0.1:%ld\n" port)
                        true)))))))))

(defn inspector-boot! [] (-> i64)
  (let [port (configured-port)]
    (if (inspector-start-viewer! port)
        0
        (do (printf c"heap inspector: failed to bind 127.0.0.1:%ld\n" port) 1))))
