(module experiments.heap-inspector.particle-animation)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "experiments.invaders.objc" :use *)

(extern printf :cc c [(ptr i8) ...] (-> i32))
(extern usleep :cc c [i64] (-> i32))
(extern CFAbsoluteTimeGetCurrent :cc c [] (-> f64))
(extern CGColorCreateGenericRGB :cc c [f64 f64 f64 f64] (-> (ptr i8)))
(extern CGColorRelease :cc c [(ptr i8)] (-> i64))
(extern cos :cc c [f64] (-> f64))
(extern sin :cc c [f64] (-> f64))

(defstruct CGRect [(x f64) (y f64) (w f64) (h f64)])
(defstruct CGPoint [(x f64) (y f64)])
(defstruct Input [(clicked bool) (x f64) (y f64)])
(defstruct ParticleState
  [(id i64) (x f64) (y f64) (vx f64) (vy f64) (age f64) (life f64) (layer (ptr i8))])
(const PARTICLE_MAX 4096)

(defn rect [(x f64) (y f64) (w f64) (h f64)] (-> CGRect)
  (let [r (primitive/alloc-stack CGRect)]
    (set! (.x r) x) (set! (.y r) y) (set! (.w r) w) (set! (.h r) h) (load r)))

(defn pump! [(app (ptr i8)) (mode (ptr i8)) (input (ptr Input))] (-> i64)
  (set! (.clicked input) false)
  (while true
    (let [event (msg (ptr i8) app (sel c"nextEventMatchingMask:untilDate:inMode:dequeue:")
                     [i64 (ptr i8) (ptr i8) i64] -1 (primitive/cast (ptr i8) 0) mode 1)]
      (if (= (primitive/cast i64 event) 0)
          (break 0)
          (do
            (if (= (msg i64 event (sel c"type") []) 1)
                (let [point (msg CGPoint event (sel c"locationInWindow") [])]
                  (set! (.clicked input) true) (set! (.x input) (.x point)) (set! (.y input) (.y point)))
                0)
            (msg (ptr i8) app (sel c"sendEvent:") [(ptr i8)] event)))))
  0)

(defn spawn! [(a (dyn alloc/Allocator)) (root (ptr i8)) (color (ptr i8))
              (particles (ptr (ptr ParticleState))) (active (ptr i64))
              (id i64) (x f64) (y f64)] (-> i64)
  (if (>= (load active) PARTICLE_MAX)
      0
      (let [p (alloc/unwrap-ptr [ParticleState] (alloc/create [ParticleState] a))
            dot (msg (ptr i8) (class c"CALayer") (sel c"layer") [])
            angle (/ (primitive/cast f64 (% (* id 97) 628)) 100.0)
            speed (+ 65.0 (primitive/cast f64 (% (* id 53) 310)))
            size (+ 3.0 (primitive/cast f64 (% id 8)))]
        (set! (.id p) id) (set! (.x p) x) (set! (.y p) y)
        (set! (.vx p) (* (cos angle) speed))
        (set! (.vy p) (* (sin angle) speed))
        (set! (.age p) 0.0) (set! (.life p) (+ 0.7 (/ (primitive/cast f64 (% id 130)) 100.0)))
        (set! (.layer p) dot)
        (msg (ptr i8) dot (sel c"setBackgroundColor:") [(ptr i8)] color)
        (msg (ptr i8) dot (sel c"setCornerRadius:") [f64] (/ size 2.0))
        (msg (ptr i8) dot (sel c"setFrame:") [CGRect] (rect x y size size))
        (msg (ptr i8) root (sel c"addSublayer:") [(ptr i8)] dot)
        (set! (primitive/index particles (load active)) p)
        (set! active (+ (load active) 1))
        0)))

(defn remove! [(a (dyn alloc/Allocator)) (particles (ptr (ptr ParticleState)))
               (active (ptr i64)) (i i64)] (-> i64)
  (let [p (load (primitive/index particles i)) last (- (load active) 1)]
    (msg (ptr i8) (.layer p) (sel c"removeFromSuperlayer") [])
    (alloc/destroy [ParticleState] a p)
    (if (!= i last) (set! (primitive/index particles i) (load (primitive/index particles last))) 0)
    (set! active last)
    0))

(defn main [] (-> i64)
  (let [app (msg (ptr i8) (class c"NSApplication") (sel c"sharedApplication") [])
        window (msg (ptr i8) (class c"NSWindow") (sel c"alloc") [])
        mode (msg (ptr i8) (class c"NSString") (sel c"stringWithUTF8String:") [(ptr i8)] c"kCFRunLoopDefaultMode")
        root (msg (ptr i8) (class c"CALayer") (sel c"layer") [])
        particles (primitive/alloc-stack (array (ptr ParticleState) 4096))
        input (primitive/alloc-stack Input)
        active (primitive/alloc-stack i64)
        amber (CGColorCreateGenericRGB 1.0 0.52 0.16 0.92)
        dark (CGColorCreateGenericRGB 0.025 0.032 0.052 1.0)
        a (alloc/malloc-allocator)
        (mut next-id) 0]
    (msg (ptr i8) window (sel c"initWithContentRect:styleMask:backing:defer:") [CGRect i64 i64 i64]
         (rect 160.0 140.0 800.0 560.0) 15 2 0)
    (msg (ptr i8) window (sel c"setTitle:") [(ptr i8)]
         (msg (ptr i8) (class c"NSString") (sel c"stringWithUTF8String:") [(ptr i8)] c"Allocation storm — click for 180 particles"))
    (msg (ptr i8) app (sel c"setActivationPolicy:") [i64] 0)
    (msg (ptr i8) (msg (ptr i8) window (sel c"contentView") []) (sel c"setWantsLayer:") [i64] 1)
    (msg (ptr i8) (msg (ptr i8) window (sel c"contentView") []) (sel c"setLayer:") [(ptr i8)] root)
    (msg (ptr i8) root (sel c"setBackgroundColor:") [(ptr i8)] dark)
    (msg (ptr i8) window (sel c"makeKeyAndOrderFront:") [(ptr i8)] (primitive/cast (ptr i8) 0))
    (msg (ptr i8) app (sel c"activateIgnoringOtherApps:") [i64] 1)
    (msg (ptr i8) app (sel c"finishLaunching") [])
    (let [(mut last) (CFAbsoluteTimeGetCurrent) (mut deadline) (+ (load last) (/ 1.0 60.0))
          (mut frames) 0 (mut report-start) (load last) (mut worst) 0.0]
      (while (= (msg i64 window (sel c"isVisible") []) 1)
        (let [now (CFAbsoluteTimeGetCurrent) dt (- now (load last))]
          (set! last now) (pump! app mode input)
          ; Continuous allocation pressure: three separately allocated particles every frame.
          (for [n 0 3]
            (do (spawn! a root amber (primitive/index particles 0) active (load next-id)
                        (+ 385.0 (primitive/cast f64 (* n 12))) 52.0)
                (set! next-id (+ (load next-id) 1))))
          (if (.clicked input)
              (for [n 0 180]
                (do (spawn! a root amber (primitive/index particles 0) active (load next-id) (.x input) (.y input))
                    (set! next-id (+ (load next-id) 1))))
              0)
          (msg (ptr i8) (class c"CATransaction") (sel c"begin") [])
          (msg (ptr i8) (class c"CATransaction") (sel c"setDisableActions:") [i64] 1)
          (let [(mut i) 0]
            (while (< (load i) (load active))
              (let [p (load (primitive/index particles (load i)))]
                (set! (.age p) (+ (.age p) dt))
                (if (>= (.age p) (.life p))
                    (remove! a (primitive/index particles 0) active (load i))
                    (do
                      (set! (.vy p) (- (.vy p) (* 190.0 dt)))
                      (set! (.x p) (+ (.x p) (* (.vx p) dt)))
                      (set! (.y p) (+ (.y p) (* (.vy p) dt)))
                      (msg (ptr i8) (.layer p) (sel c"setFrame:") [CGRect] (rect (.x p) (.y p) 7.0 7.0))
                      (set! i (+ (load i) 1)))))))
          (msg (ptr i8) (class c"CATransaction") (sel c"commit") [])
          (set! frames (+ (load frames) 1))
          (if (> (* dt 1000.0) (load worst)) (set! worst (* dt 1000.0)) 0)
          (let [after (CFAbsoluteTimeGetCurrent) remaining (- (load deadline) after)]
            (if (> remaining 0.0) (usleep (primitive/cast i64 (* remaining 1000000.0))) 0))
          (set! deadline (+ (load deadline) (/ 1.0 60.0)))
          (let [finished (CFAbsoluteTimeGetCurrent) elapsed (- finished (load report-start))]
            (if (>= elapsed 1.0)
                (do (printf c"particles: fps=%.2f worst_ms=%.2f live=%ld total=%ld\n"
                            (/ (primitive/cast f64 (load frames)) elapsed) (load worst) (load active) (load next-id))
                    (set! frames 0) (set! worst 0.0) (set! report-start finished))
                0)))))
    (while (> (load active) 0) (remove! a (primitive/index particles 0) active 0))
    (CGColorRelease amber) (CGColorRelease dark)
    0))
