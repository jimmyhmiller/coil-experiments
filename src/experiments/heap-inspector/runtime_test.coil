(module experiments.heap-inspector.runtime-test)

(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.assert" :use *)
(import "experiments.heap-inspector.runtime" :use *)

(defn test-show [(p (ptr i8))] (-> i64)
  (primitive/cast i64 p)
  0)

(defn test-json [(p (ptr i8))] (-> i64)
  (primitive/cast i64 p)
  0)

(defstruct TrackedThing [(value i64)])

(deftest changed-layout-gets-a-new-schema-version
  (let [runtime-id 77001
        first (register-type "LiveThing"
                             runtime-id
                             101
                             8
                             8
                             1
                             (primitive/fnptr-of test-show)
                             (primitive/fnptr-of test-json))
        same (register-type "LiveThing"
                            runtime-id
                            101
                            8
                            8
                            1
                            (primitive/fnptr-of test-show)
                            (primitive/fnptr-of test-json))
        changed (register-type "LiveThing"
                               runtime-id
                               202
                               16
                               8
                               2
                               (primitive/fnptr-of test-show)
                               (primitive/fnptr-of test-json))
        reverted (register-type "LiveThing"
                                runtime-id
                                101
                                8
                                8
                                1
                                (primitive/fnptr-of test-show)
                                (primitive/fnptr-of test-json))
        reverted-again (register-type "LiveThing"
                                      runtime-id
                                      101
                                      8
                                      8
                                      1
                                      (primitive/fnptr-of test-show)
                                      (primitive/fnptr-of test-json))]
    (assert-eq first same)
    (assert (!= first changed))
    (assert-eq 1 (.version (primitive/index (types) first)))
    (assert-eq 2 (.version (primitive/index (types) changed)))
    (assert (!= first reverted))
    (assert-eq reverted reverted-again)
    (assert-eq 3 (.version (primitive/index (types) reverted)))
    (assert-eq 101 (.fingerprint (primitive/index (types) first)))
    (assert-eq 202 (.fingerprint (primitive/index (types) changed)))))

(deftest allocation-is-stamped-with-its-creating-schema
  (let [a (alloc/malloc-allocator)
        schema (register-type "TrackedThing"
                              (alloc/type-id [TrackedThing])
                              303
                              (primitive/sizeof TrackedThing)
                              (primitive/alignof TrackedThing)
                              1
                              (primitive/fnptr-of test-show)
                              (primitive/fnptr-of test-json))]
    (match (alloc/create [TrackedThing] a)
      (None [] (assert false))
      (Some [p]
        (do
          ; The raw allocation tracker runs beneath the generated typed marker.
          (register-allocation (primitive/cast (ptr i8) p)
                               (match (alloc/request [TrackedThing] 1)
                                 (Some [request] request)
                                 (None [] (alloc/AllocRequest :type-id 0 :count 0 :bytes 0 :align 0)))
                               (primitive/fnptr-of test-show))
          (track-create [TrackedThing]
                        (Some p)
                        schema
                        (primitive/fnptr-of test-show))
          (let [entry (find-live-entry (primitive/cast (ptr i8) p))]
            (assert (!= (primitive/cast i64 entry) 0))
            (assert-eq schema (.schema-id entry))
            (assert-eq (alloc/type-id [TrackedThing]) (.type-id entry)))
          (unregister-instance (primitive/cast (ptr i8) p))
          (alloc/destroy [TrackedThing] a p))))))

(deftest enum-schema-retains-variant-and-payload-metadata
  (let [schema (register-type "Visibility" 77002 404 16 8 0
                              (primitive/fnptr-of test-show)
                              (primitive/fnptr-of test-json))]
    (assert-eq schema (register-type-kind schema 2))
    (let [hidden (register-variant schema 0 "Hidden" 0)
          colored (register-variant schema 1 "Colored" 1)
          payload (register-variant-field colored 0 "hue" "i64")]
      (assert (>= hidden 0))
      (assert (>= colored 0))
      (assert (>= payload 0))
      (assert-eq 2 (.kind (primitive/index (types) schema)))
      (assert-eq schema (.schema-id (primitive/index (variants) colored)))
      (assert-eq "Colored" (.name (primitive/index (variants) colored)))
      (assert-eq "hue" (.name (primitive/index (variant-fields) payload)))
      (assert-eq "i64" (.type-name (primitive/index (variant-fields) payload))))))
