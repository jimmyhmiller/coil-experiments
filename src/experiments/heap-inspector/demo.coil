(module experiments.heap-inspector.demo)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use [unwrap-ptr create box!])
(import "coil.result" :use *)
(import "experiments.heap-inspector.runtime" :use *)
(import "experiments.heap-inspector.transform" :use *)

(extern printf :cc c [(ptr i8) ...] (-> i32))
(defstruct Point [(x i64) (y i64) (visible bool) (weight f64) (label (slice u8))])
(defstruct Link [(value i64) (next (ptr Point))])
(defstruct Box [T] [(value T)])

(defn main [] (-> i64)
  (let [a (alloc/malloc-allocator)
        p (alloc/unwrap-ptr [Point] (alloc/create [Point] a))
        q (alloc/unwrap-ptr [Link] (alloc/create [Link] a))
        b (alloc/unwrap-ptr [(Box i64)] (alloc/create [(Box i64)] a))]
    (set! (.x p) 10)
    (set! (.y p) 20)
    (set! (.visible p) true)
    (set! (.weight p) 3.5)
    (set! (.label p) "origin")
    (set! (.value q) 99)
    (set! (.next q) p)
    (set! (.value b) 123)
    (inspector-list-types)
    (inspector-list-instances)
    (inspector-inspect 1)
    (inspector-inspect 2)
    (inspector-inspect 3)
    (printf c"-- destroy Point --\n")
    (alloc/destroy a p)
    (inspector-list-instances)
    (inspector-inspect 1)
    (alloc/destroy a q)
    (alloc/destroy a b)
    0))
