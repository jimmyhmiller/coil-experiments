(module experiments.heap-inspector.live-latency-test)

(import "coil.alloc" :as alloc)
(import "coil.assert" :use *)
(import "coil.fs" :as fs)
(import "coil.result" :use *)
(import "coil.time" :as time)
(import "coil.jit" :as jit)
(import "experiments.heap-inspector.controller" :as controller)

(extern dprintf :cc c [i32 (ptr i8) ...] (-> i32))

(defn now-ms [] (-> i64)
  (match (time/monotonic-now-ms)
    (Ok [value] value)
    (Err [e] -1)))

(defn timed-edit [(source (slice u8))] (-> i64)
  (let [start (now-ms)
        status (controller/live-controller-edit-source! source)
        elapsed (- (now-ms) start)]
    (dprintf 2 c"live body edit: %lld ms\n" elapsed)
    (dprintf 2 c"live generations: %lld reclaimed: %lld\n"
      (jit/jit-generation-count (field (controller/live-controller) session))
      (.last-reclaimed (controller/live-controller)))
    status))

(deftest definition-sized-body-edit-latency-is-measured
  (assert-eq 0 (controller/live-controller-enable-native-coil-demo!))
  (match (fs/read-file (alloc/malloc-allocator)
                       "src/experiments/heap-inspector/viewer/native-demo-base.coil")
    (Err [e] (assert false))
    (Ok [base] (assert-eq 0 (controller/live-controller-edit-source! base))))
  (assert-eq 0 (timed-edit "(defn radius [(p Particle)] (-> i64) 15)"))
  (assert-eq 0 (timed-edit "(defn radius [(p Particle)] (-> i64) 16)"))
  (assert-eq 2
    (jit/jit-generation-count (field (controller/live-controller) session)))
  (assert-eq 1 (.last-reclaimed (controller/live-controller)))
  (assert-eq 0 (timed-edit "(defn radius [(p Particle)] (-> i64) 17)"))
  ; One explicitly leased initial callback image plus the current implementation
  ; image is the bounded steady state. ABI declarations alone retain no image.
  (assert-eq 2
    (jit/jit-generation-count (field (controller/live-controller) session)))
  (assert-eq 1 (.last-reclaimed (controller/live-controller))))
