(module experiments.heap-inspector.native-demo-window)

(import "coil.primitive" :as primitive)
(import "experiments.invaders.objc" :use *)
(import "experiments.heap-inspector.native-demo-api" :as demo)

(extern usleep :cc c [i64] (-> i32))
(extern sin :cc c [f64] (-> f64))
(extern CGColorCreateGenericRGB :cc c [f64 f64 f64 f64] (-> (ptr i8)))
(extern CGColorRelease :cc c [(ptr i8)] (-> i64))

(defstruct DemoRect [(x f64) (y f64) (w f64) (h f64)])

(defn demo-rect [(x f64) (y f64) (w f64) (h f64)] (-> DemoRect)
  (let [r (primitive/alloc-stack DemoRect)]
    (set! (.x r) x) (set! (.y r) y) (set! (.w r) w) (set! (.h r) h)
    (load r)))

(defn demo-pump! [(app (ptr i8)) (mode (ptr i8))] (-> i64)
  (while true
    (let [event (msg (ptr i8) app (sel c"nextEventMatchingMask:untilDate:inMode:dequeue:")
                     [i64 (ptr i8) (ptr i8) i64]
                     -1 (primitive/cast (ptr i8) 0) mode 1)]
      (if (= (primitive/cast i64 event) 0)
          (break 0)
          (msg (ptr i8) app (sel c"sendEvent:") [(ptr i8)] event))))
  0)

(defn demo-color [(tint i64)] (-> (ptr i8))
  (let [angle (* (primitive/cast f64 (% tint 360)) 0.017453292519943295)
        r (+ 0.5 (* 0.5 (sin angle)))
        g (+ 0.5 (* 0.5 (sin (+ angle 2.0943951023931953))))
        b (+ 0.5 (* 0.5 (sin (+ angle 4.1887902047863905))))]
    (CGColorCreateGenericRGB r g b 0.96)))

(defn demo-update-layer! [(layer (ptr i8))
                           (p (ptr demo/NativeDemoParticle))
                           (clear (ptr i8))] (-> i64)
  (let [radius (primitive/cast f64 (.radius p))
        x (primitive/cast f64 (.x p))
        y (primitive/cast f64 (.y p))
        color (demo-color (.tint p))]
    (cond
      (= (.kind p) 1)
        (let [outer (+ radius 6.0)]
          (msg (ptr i8) layer (sel c"setFrame:") [DemoRect]
               (demo-rect (- x outer) (- y outer) (* outer 2.0) (* outer 2.0)))
          (msg (ptr i8) layer (sel c"setCornerRadius:") [f64] outer)
          (msg (ptr i8) layer (sel c"setBackgroundColor:") [(ptr i8)] clear)
          (msg (ptr i8) layer (sel c"setBorderColor:") [(ptr i8)] color)
          (msg (ptr i8) layer (sel c"setBorderWidth:") [f64] 3.0))
      (= (.kind p) 2)
        (do
          (msg (ptr i8) layer (sel c"setFrame:") [DemoRect]
               (demo-rect (- x (* radius 1.5)) (- y (/ radius 2.0))
                          (* radius 3.0) radius))
          (msg (ptr i8) layer (sel c"setCornerRadius:") [f64] 2.0)
          (msg (ptr i8) layer (sel c"setBorderWidth:") [f64] 0.0)
          (msg (ptr i8) layer (sel c"setBackgroundColor:") [(ptr i8)] color))
      :else
        (do
          (msg (ptr i8) layer (sel c"setFrame:") [DemoRect]
               (demo-rect (- x radius) (- y radius) (* radius 2.0) (* radius 2.0)))
          (msg (ptr i8) layer (sel c"setCornerRadius:") [f64] radius)
          (msg (ptr i8) layer (sel c"setBorderWidth:") [f64] 0.0)
          (msg (ptr i8) layer (sel c"setBackgroundColor:") [(ptr i8)] color)))
    (CGColorRelease color)
    0))

(defn native-demo-window-run! [] (-> i64)
  (let [app (msg (ptr i8) (class c"NSApplication") (sel c"sharedApplication") [])
        window (msg (ptr i8) (class c"NSWindow") (sel c"alloc") [])
        mode (msg (ptr i8) (class c"NSString") (sel c"stringWithUTF8String:")
                  [(ptr i8)] c"kCFRunLoopDefaultMode")
        root (msg (ptr i8) (class c"CALayer") (sel c"layer") [])
        layers (primitive/alloc-stack (array (ptr i8) 18))
        particles (primitive/alloc-stack (array demo/NativeDemoParticle 18))
        background (CGColorCreateGenericRGB 0.025 0.032 0.052 1.0)
        clear (CGColorCreateGenericRGB 0.0 0.0 0.0 0.0)]
    (msg (ptr i8) window (sel c"initWithContentRect:styleMask:backing:defer:")
         [DemoRect i64 i64 i64] (demo-rect 120.0 140.0 640.0 400.0) 15 2 0)
    (msg (ptr i8) window (sel c"setTitle:") [(ptr i8)]
         (msg (ptr i8) (class c"NSString") (sel c"stringWithUTF8String:")
              [(ptr i8)] c"Coil — Typed But Live (native window)"))
    (msg (ptr i8) app (sel c"setActivationPolicy:") [i64] 0)
    (msg (ptr i8) (msg (ptr i8) window (sel c"contentView") [])
         (sel c"setWantsLayer:") [i64] 1)
    ; Give the detached root an explicit geometry before installing it. AppKit's
    ; layer-hosting view does not promise to infer the frame of a caller-supplied
    ; root layer, and a zero-sized root clips every otherwise-correct sublayer.
    (msg (ptr i8) root (sel c"setFrame:") [DemoRect]
         (demo-rect 0.0 0.0 640.0 400.0))
    (msg (ptr i8) root (sel c"setMasksToBounds:") [i64] 1)
    (msg (ptr i8) root (sel c"setBackgroundColor:") [(ptr i8)] background)
    (for [i 0 18]
      (let [layer (msg (ptr i8) (class c"CALayer") (sel c"layer") [])
            initial (demo-color (* i 20))]
        (set! (primitive/index layers i) layer)
        ; Establish visible geometry before the first JIT frame. Besides avoiding
        ; a transient empty window, this keeps the renderer independently
        ; inspectable if publication ever fails.
        (msg (ptr i8) layer (sel c"setFrame:") [DemoRect]
             (demo-rect (+ 24.0 (primitive/cast f64 (* (% i 9) 68)))
                        (+ 70.0 (primitive/cast f64 (* (/ i 9) 180)))
                        28.0 28.0))
        (msg (ptr i8) layer (sel c"setCornerRadius:") [f64] 14.0)
        (msg (ptr i8) layer (sel c"setBackgroundColor:") [(ptr i8)] initial)
        (msg (ptr i8) root (sel c"addSublayer:") [(ptr i8)] layer)
        (CGColorRelease initial)))
    (msg (ptr i8) (msg (ptr i8) window (sel c"contentView") [])
         (sel c"setLayer:") [(ptr i8)] root)
    (msg (ptr i8) window (sel c"makeKeyAndOrderFront:") [(ptr i8)] (primitive/cast (ptr i8) 0))
    (msg (ptr i8) app (sel c"activateIgnoringOtherApps:") [i64] 1)
    (msg (ptr i8) app (sel c"finishLaunching") [])
    (while (= (msg i64 window (sel c"isVisible") []) 1)
      (demo-pump! app mode)
      (if (demo/native-demo-take-focus-request!)
          (do (msg (ptr i8) window (sel c"makeKeyAndOrderFront:")
                   [(ptr i8)] (primitive/cast (ptr i8) 0))
              (msg (ptr i8) app (sel c"activateIgnoringOtherApps:") [i64] 1)
              0)
          0)
      (if (= (demo/native-demo-read-frame! (primitive/index particles 0)) 0)
          (do
            (msg (ptr i8) (class c"CATransaction") (sel c"begin") [])
            (msg (ptr i8) (class c"CATransaction") (sel c"setDisableActions:") [i64] 1)
            (for [i 0 18]
              (demo-update-layer! (load (primitive/index layers i))
                                  (primitive/index particles i) clear))
            (msg (ptr i8) (class c"CATransaction") (sel c"commit") [])
            ; NSApplication is being pumped manually instead of entering
            ; -run. Commit updates the layer model; flush plus updateWindows
            ; drives those commits through the presentation tree immediately.
            (msg (ptr i8) (class c"CATransaction") (sel c"flush") [])
            (msg (ptr i8) app (sel c"updateWindows") [])
            0)
          0)
      (usleep 16667))
    (CGColorRelease clear)
    (CGColorRelease background)
    0))
