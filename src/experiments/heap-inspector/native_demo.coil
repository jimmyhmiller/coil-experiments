(module experiments.heap-inspector.native-demo)

(import "coil.alloc" :as alloc)
(import "coil.fs" :as fs)
(import "coil.primitive" :as primitive)
(import "coil.result" :use *)
(import "experiments.heap-inspector.controller" :as controller)
(import "experiments.heap-inspector.viewer" :as viewer)
(import "experiments.heap-inspector.native-demo-window" :as native-window)

(extern printf :cc c [(ptr i8) ...] (-> i32))
(extern usleep :cc c [i32] (-> i32))
(extern getenv :cc c [(ptr i8)] (-> (ptr i8)))
(extern atoi :cc c [(ptr i8)] (-> i32))

(defn native-demo-port [] (-> i64)
  (let [configured (getenv c"COIL_LIVE_DEMO_PORT")]
    (if (= (primitive/cast i64 configured) 0)
        7391
        (let [port (primitive/cast i64 (atoi configured))]
          (if (and (> port 0) (<= port 65535)) port 7391)))))

(defn main [] (-> i64)
  (let [init-status (controller/live-controller-enable-native-coil-demo!)]
    (if (!= init-status 0)
        (do (printf c"native live demo: controller initialization failed\n") init-status)
        (match (fs/read-file (alloc/malloc-allocator)
                             "src/experiments/heap-inspector/viewer/native-demo-base.coil")
          (Err [e] (do (printf c"native live demo: could not read initial source\n") 1))
          (Ok [source]
            (let [status (controller/live-controller-edit-source! source)
                  port (native-demo-port)]
              (if (!= status 0)
                  (do (printf c"native live demo: initial source was rejected\n") status)
                  (if (not (viewer/inspector-start-viewer! port))
                      1
                      (do
                        (printf c"native live demo editor: http://127.0.0.1:%lld/native-demo\n" port)
                        (native-window/native-demo-window-run!))))))))))
