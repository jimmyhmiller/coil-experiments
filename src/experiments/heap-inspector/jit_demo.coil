(module experiments.heap-inspector.jit-demo)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.jit" :use *)
(import "experiments.heap-inspector.runtime" :use *)
(import "experiments.heap-inspector.transform" :use *)

(extern printf :cc c [(ptr i8) ...] (-> i32))
(defstruct LivePoint [(x i64) (y i64)])

(defn main [] (-> i64)
  (let [a (alloc/malloc-allocator)
        p (alloc/box! a LivePoint (primitive/zeroed LivePoint))]
    (set! (.x p) 40)
    (set! (.y p) 2)
    (if (jit-supported?)
        (let [(mut session) (jit-session-new a)]
          ; Imports would compile a second runtime with different static cells.
          ; Externs resolve the host's exported query ABI through RTLD_DEFAULT.
          (jit-submit! (mut session) "(extern coil_inspector_list_types :cc c [] (-> i64))")
          (jit-submit! (mut session) "(extern coil_inspector_list_instances :cc c [] (-> i64))")
          (jit-submit! (mut session) "(extern coil_inspector_inspect :cc c [i64] (-> i64))")
          (jit-submit! (mut session) "(coil_inspector_list_types)")
          (jit-submit! (mut session) "(coil_inspector_list_instances)")
          (jit-submit! (mut session) "(coil_inspector_inspect 1)"))
        (do (printf c"JIT unsupported on this platform\n") 0))
    (alloc/destroy a p)
    0))
