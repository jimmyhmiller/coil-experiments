(module experiments.heap-inspector.live-api)

(import "coil.primitive" :as primitive)

; The viewer is included by every heap-inspected program, while the compiler/JIT
; controller is opt-in. These callbacks keep the ordinary inspector free of a
; compiler dependency and make live capability explicit at runtime.
(defstruct LiveApi
  [(registered bool)
   (status (fnptr c [] (slice u8)))
   (edit (fnptr c [(slice u8)] i64))
   (track-object (fnptr c [(ptr i8) i64 i64 i64 i64 i64] i64))
   (untrack-object (fnptr c [(ptr i8)] i64))])

(defn live-api [] (-> (ptr LiveApi))
  (primitive/alloc-static LiveApi))

(defn live-api-register! [(status (fnptr c [] (slice u8)))
                           (edit (fnptr c [(slice u8)] i64))
                           (track-object (fnptr c [(ptr i8) i64 i64 i64 i64 i64] i64))
                           (untrack-object (fnptr c [(ptr i8)] i64))] (-> i64)
  (let [api (live-api)]
    (set! (.status api) status)
    (set! (.edit api) edit)
    (set! (.track-object api) track-object)
    (set! (.untrack-object api) untrack-object)
    (set! (.registered api) true)
    0))

(defn live-api-supported? [] (-> bool)
  (.registered (live-api)))

(defn live-api-status [] (-> (slice u8))
  (if (live-api-supported?)
      (primitive/call-ptr (.status (live-api)))
      "{\"supported\":false,\"state\":\"Unavailable\",\"diagnostic\":\"This program did not install the live compiler controller.\"}"))

(defn live-api-edit! [(source (slice u8))] (-> i64)
  (if (live-api-supported?)
      (primitive/call-ptr (.edit (live-api)) source)
      -1))

(defn live-api-track-object! [(address (ptr i8)) (runtime-id i64) (schema-id i64)
                              (bytes i64) (align i64) (count i64)] (-> i64)
  (if (live-api-supported?)
      (primitive/call-ptr (.track-object (live-api))
                          address runtime-id schema-id bytes align count)
      0))

(defn live-api-untrack-object! [(address (ptr i8))] (-> i64)
  (if (live-api-supported?)
      (primitive/call-ptr (.untrack-object (live-api)) address)
      0))
