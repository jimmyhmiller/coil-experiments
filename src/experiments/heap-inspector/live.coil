(module experiments.heap-inspector.live)

(import "coil.primitive" :as primitive)
(import "coil.atomic" :as atomic)
(import "coil.slice" :use [slice-new slice-len slice-get slice-data])
(import "experiments.heap-inspector.runtime" :as inspector)

(extern malloc :cc c [u64] (-> (ptr i8)))
(extern calloc :cc c [u64 u64] (-> (ptr i8)))
(extern free :cc c [(ptr i8)] (-> i64))
(extern pthread_key_create :cc c [(ptr u64) (ptr i8)] (-> i32))
(extern pthread_getspecific :cc c [u64] (-> (ptr i8)))
(extern pthread_setspecific :cc c [u64 (ptr i8)] (-> i32))
(extern _longjmp :cc c [(ptr i8) i32] (-> void))

; A native, checked edge between two exact schema versions. `apply` writes a
; fully initialized destination without mutating the source. `abort` cleans a
; partially initialized destination after apply reports failure. `retire`
; destroys an old value after the root batch has committed.
(defstruct LiveTransition
  [(runtime-id i64)
   (from-schema i64)
   (to-schema i64)
   (apply (fnptr c [(ptr i8) (ptr i8)] i64))
   (abort (fnptr c [(ptr i8)] i64))
   (retire (fnptr c [(ptr i8)] i64))])

; Stable object identity for every opted-in live nominal value. User-visible
; wrapper structs contain only a pointer to this header; version-specific native
; layout lives behind `payload`. The header is never relocated or exposed as a
; typed payload pointer across a live safe point.
(defstruct LiveHandle
  [(id i64)
   (refs i64)
   (runtime-id i64)
   (schema-id i64)
   (payload (ptr i8))
   (root-id i64)
   (borrows i64)
   (ffi-retains i64)
   (pins i64)
   (live bool)
   (next (ptr LiveHandle))])

; `slot` is the persistent indirection cell generated for a letonce/live root.
; Native clients load through the slot; publication replaces every slot only
; after the complete shadow batch succeeds.
(defstruct LiveRoot
  [(id i64)
   (name (slice u8))
   (runtime-id i64)
   (schema-id i64)
   (slot (ptr (ptr i8)))
   ; Non-null for a stable live object handle. Publication updates the payload
   ; slot and schema field together while the world gate is closed.
   (handle (ptr LiveHandle))
   (aliases i64)
   (live bool)])

(defstruct StagedRoot
  [(root-index i64)
   (old-value (ptr i8))
   (new-value (ptr i8))
   (old-schema i64)
   (new-schema i64)
   ; Only the first staged root for a shared object owns cleanup/retirement.
   (owner bool)
   (abort (fnptr c [(ptr i8)] i64))
   ; The final edge owns destruction of `old-value` after commit.
   (retire (fnptr c [(ptr i8)] i64))])

; A handle is a managed graph vertex, not a source root. It has its own staged
; publication record so nested values migrate without appearing in LiveRoot.
(defstruct StagedHandle
  [(handle (ptr LiveHandle))
   (old-value (ptr i8))
   (new-value (ptr i8))
   (old-schema i64)
   (new-schema i64)
   (owner bool)
   (abort (fnptr c [(ptr i8)] i64))
   (retire (fnptr c [(ptr i8)] i64))])

(defstruct LiveForward
  [(old-value (ptr i8))
   (new-value (ptr i8))
   (runtime-id i64)
   (new-schema i64)
   (abort (fnptr c [(ptr i8)] i64))
   (retire (fnptr c [(ptr i8)] i64))])

(defstruct LiveReferenceField
  [(schema-id i64)
   (offset i64)
   (target-runtime-id i64)
   ; 1 = direct tracked pointer. Slice/interior rules are registered separately.
   (kind i64)])

(defstruct LiveSchemaDestructor
  [(schema-id i64)
   (destroy (fnptr c [(ptr i8)] i64))])

; Source identities emitted by the metaprogram for one accepted transaction.
; Names are copied into host-owned storage because candidate syntax and JIT
; literals may disappear when their compiler arena or native image retires.
(defstruct LiveAffected
  [(identity i64)
   (kind i64)
   (name (slice u8))
   (next (ptr LiveAffected))])

; Permanent runtime gate for one structural source identity. The identity text
; is the canonical `(live-def-id module kind name)` emitted by the metaprogram;
; hashes are deliberately not used as identity. Gate records have session
; lifetime so generated entries can cache no reclaimable runtime address.
(defstruct LiveSourceGate
  [(identity i64)
   (active i64)
   (closed i64)
   ; Broken is source state, independent of the implementation slot. Keeping
   ; it here means rejected publication never destroys the last healthy fnptr.
   (broken i64)
   ; Exact JIT generation token owning the implementation currently stored in
   ; this source identity's permanent slot. The controller transfers this
   ; lease only after the replacement image becomes current.
   (generation-token i64)])

; Structured runtime condition observed at explicit native restart boundaries.
; Source diagnostics remain compiler-owned; this record is the stable control
; protocol that pauses and resumes native work without inspecting error text.
(defstruct LiveCondition
  [(active i64)
   ; 1 = NeedsTransition, 2 = Broken, 3 = Blocked.
   (kind i64)
   (status i64)
   (raised-epoch i64)
   (serial i64)])

; Per-thread call depth and nearest explicit restart boundary. Only the
; outermost live call contributes to the global quiescence reader count; nested
; wrappers are represented by depth so non-local condition recovery can restore
; accounting exactly instead of leaking reader leases.
(defstruct LiveRestartBoundary
  [(buffer (array i64 32))
   (previous (ptr LiveRestartBoundary))
   (saved-depth i64)])

(defstruct LiveThreadState
  [(depth i64)
   (gates (array i64 256))
   ; Only the publication owner may execute candidate constructors/defaults
   ; behind closed affected gates while building the unpublished shadow graph.
   (publishing i64)
   (boundary (ptr LiveRestartBoundary))])

; Heap-inspector allocations become graph vertices when a live controller is
; installed. Their allocator is not assumed to be libc: without explicit
; relocation hooks they are enumerable references but block a layout migration.
(defstruct LiveManagedObject
  [(address (ptr i8))
   (runtime-id i64)
   (schema-id i64)
   (bytes i64)
   (align i64)
   (count i64)
   (borrows i64)
   (ffi-retains i64)
   (movable bool)
   (allocate (fnptr c [i64 i64] (ptr i8)))
   (release (fnptr c [(ptr i8) i64 i64] i64))
   (migrating bool)
   (live bool)])

(defstruct StagedManagedObject
  [(object-index i64)
   (old-value (ptr i8))
   (new-value (ptr i8))
   (old-schema i64)
   (new-schema i64)
   (old-bytes i64)
   (new-bytes i64)
   (align i64)
   (count i64)
   (abort (fnptr c [(ptr i8)] i64))
   (retire (fnptr c [(ptr i8)] i64))
   (release (fnptr c [(ptr i8) i64 i64] i64))])

(defn live-transitions [] (-> (ptr (array LiveTransition 512)))
  (primitive/alloc-static (array LiveTransition 512)))
(defn live-transition-count [] (-> (ptr i64)) (primitive/alloc-static i64))
(defn live-roots [] (-> (ptr (array LiveRoot 512)))
  (primitive/alloc-static (array LiveRoot 512)))
(defn live-root-count [] (-> (ptr i64)) (primitive/alloc-static i64))
(defn live-handle-head [] (-> (ptr (ptr LiveHandle)))
  (primitive/alloc-static (ptr LiveHandle)))
(defn live-handle-count [] (-> (ptr i64)) (primitive/alloc-static i64))
(defn live-staged [] (-> (ptr (array StagedRoot 512)))
  (primitive/alloc-static (array StagedRoot 512)))
(defn live-staged-count [] (-> (ptr i64)) (primitive/alloc-static i64))
(defn live-staged-handles [] (-> (ptr (array StagedHandle 4096)))
  (primitive/alloc-static (array StagedHandle 4096)))
(defn live-staged-handle-count [] (-> (ptr i64)) (primitive/alloc-static i64))
(defn live-forwards [] (-> (ptr (array LiveForward 1024)))
  (primitive/alloc-static (array LiveForward 1024)))
(defn live-forward-count [] (-> (ptr i64)) (primitive/alloc-static i64))
(defn live-reference-fields [] (-> (ptr (array LiveReferenceField 4096)))
  (primitive/alloc-static (array LiveReferenceField 4096)))
(defn live-reference-field-count [] (-> (ptr i64)) (primitive/alloc-static i64))
(defn live-schema-destructors [] (-> (ptr (array LiveSchemaDestructor 4096)))
  (primitive/alloc-static (array LiveSchemaDestructor 4096)))
(defn live-schema-destructor-count [] (-> (ptr i64)) (primitive/alloc-static i64))
(defn live-managed-objects [] (-> (ptr (array LiveManagedObject 4096)))
  (primitive/alloc-static (array LiveManagedObject 4096)))
(defn live-managed-object-count [] (-> (ptr i64)) (primitive/alloc-static i64))
(defn live-staged-managed [] (-> (ptr (array StagedManagedObject 4096)))
  (primitive/alloc-static (array StagedManagedObject 4096)))
(defn live-staged-managed-count [] (-> (ptr i64)) (primitive/alloc-static i64))
(defn live-blocker-kind [] (-> (ptr i64)) (primitive/alloc-static i64))
(defn live-blocker-index [] (-> (ptr i64)) (primitive/alloc-static i64))
(defn live-blocker-schema [] (-> (ptr i64)) (primitive/alloc-static i64))
(defn live-blocker-address [] (-> (ptr i64)) (primitive/alloc-static i64))
(defn live-affected-head [] (-> (ptr (ptr LiveAffected)))
  (primitive/alloc-static (ptr LiveAffected)))
(defn live-staged-affected-head [] (-> (ptr (ptr LiveAffected)))
  (primitive/alloc-static (ptr LiveAffected)))
(defn live-affected-count [] (-> (ptr i64)) (primitive/alloc-static i64))
(defn live-staged-affected-count [] (-> (ptr i64)) (primitive/alloc-static i64))
(defn live-source-gates [] (-> (ptr (array LiveSourceGate 4096)))
  (primitive/alloc-static (array LiveSourceGate 4096)))
(defn live-source-gate-count [] (-> (ptr i64)) (primitive/alloc-static i64))
(defn live-staged-code-owners [] (-> (ptr (array i64 4096)))
  (primitive/alloc-static (array i64 4096)))
(defn live-staged-code-owner-count [] (-> (ptr i64)) (primitive/alloc-static i64))
(defn live-source-gate-lock [] (-> (ptr i64)) (primitive/alloc-static i64))
(defn live-publication-lock [] (-> (ptr i64)) (primitive/alloc-static i64))
(defn live-affected-publication-active [] (-> (ptr i64)) (primitive/alloc-static i64))

(defn live-condition [] (-> (ptr LiveCondition))
  (primitive/alloc-static LiveCondition))
(defn live-condition-lock-cell [] (-> (ptr i64)) (primitive/alloc-static i64))

(defn live-condition-lock! [] (-> i64)
  (loop (if (= (atomic/atomic-cas (live-condition-lock-cell) 0 1) 0) (break) 0)) 0)
(defn live-condition-unlock! [] (-> i64)
  (atomic/atomic-store (live-condition-lock-cell) 0))

(defn live-thread-key [] (-> (ptr u64)) (primitive/alloc-static u64))
(defn live-thread-key-ready [] (-> (ptr i64)) (primitive/alloc-static i64))
(defn live-thread-key-lock [] (-> (ptr i64)) (primitive/alloc-static i64))

(defn live-thread-key-init! [] (-> i64)
  (if (= (atomic/atomic-load (live-thread-key-ready)) 0)
      (do
        (loop (if (= (atomic/atomic-cas (live-thread-key-lock) 0 1) 0) (break) 0))
        (if (= (atomic/atomic-load (live-thread-key-ready)) 0)
            (if (= (pthread_key_create (live-thread-key)
                     (primitive/cast (ptr i8) 0)) 0)
                (atomic/atomic-store (live-thread-key-ready) 1)
                0)
            0)
        (atomic/atomic-store (live-thread-key-lock) 0))
      0)
  (if (= (atomic/atomic-load (live-thread-key-ready)) 1) 0 -1))

(defn live-thread-state [] (-> (ptr LiveThreadState))
  (if (!= (live-thread-key-init!) 0)
      (primitive/cast (ptr LiveThreadState) 0)
      (let [existing (pthread_getspecific (load (live-thread-key)))]
        (if (!= (primitive/cast i64 existing) 0)
            (primitive/cast (ptr LiveThreadState) existing)
            (let [created (primitive/cast (ptr LiveThreadState)
                            (calloc 1 (primitive/cast u64
                                        (primitive/sizeof LiveThreadState))))]
              (if (= (primitive/cast i64 created) 0)
                  created
                  (if (= (pthread_setspecific (load (live-thread-key))
                           (primitive/cast (ptr i8) created)) 0)
                      created
                      (do (free (primitive/cast (ptr i8) created))
                          (primitive/cast (ptr LiveThreadState) 0)))))))))

(defn live-restart-boundary-push! [(boundary (ptr LiveRestartBoundary))] (-> i64)
  (let [thread (live-thread-state)]
    (if (= (primitive/cast i64 thread) 0)
        -1
        (do
          (set! (.previous boundary) (.boundary thread))
          (set! (.saved-depth boundary) (.depth thread))
          (set! (.boundary thread) boundary)
          0))))

(defn live-restart-boundary-pop! [(boundary (ptr LiveRestartBoundary))] (-> i64)
  (let [thread (live-thread-state)]
    (if (or (= (primitive/cast i64 thread) 0)
            (!= (primitive/cast i64 (.boundary thread))
                (primitive/cast i64 boundary)))
        -1
        (do (set! (.boundary thread) (.previous boundary)) 0))))

(defn live-restart-boundary-recover! [(boundary (ptr LiveRestartBoundary))] (-> i64)
  (let [thread (live-thread-state)]
    (if (= (primitive/cast i64 thread) 0)
        -1
        (do
          ; Non-local recovery releases every exact source gate entered after
          ; the boundary. This is per-frame rather than outermost-only because
          ; a nested affected callee must be drainable without parking its
          ; unrelated caller.
          (for [i (.saved-depth boundary) (.depth thread)]
            (let [gate-index (load (primitive/index (field thread gates) i))]
              (if (and (>= gate-index 0)
                       (< gate-index (load (live-source-gate-count))))
                  (do
                    (atomic/atomic-add
                      (field (primitive/index (live-source-gates) gate-index) active)
                      -1)
                    (atomic/atomic-add (live-reader-count) -1))
                  0)))
          (set! (.depth thread) (.saved-depth boundary))
          (set! (.boundary thread) (.previous boundary))
          0))))

(defn live-condition-raise! [(kind i64) (status i64)] (-> i64)
  (live-condition-lock!)
  (let [condition (live-condition)]
    (set! (.kind condition) kind)
    (set! (.status condition) status)
    (set! (.raised-epoch condition) (load (live-epoch-cell)))
    (set! (.serial condition) (+ (.serial condition) 1))
    ; Publish active last so a boundary never observes a partially written
    ; condition record.
    (atomic/atomic-store (field condition active) 1)
    (let [serial (.serial condition)]
      (live-condition-unlock!)
      serial)))

(defn live-condition-clear! [] (-> i64)
  (live-condition-lock!)
  (let [condition (live-condition)]
    (atomic/atomic-store (field condition active) 0)
    (set! (.kind condition) 0)
    (set! (.status condition) 0)
    (set! (.serial condition) (+ (.serial condition) 1))
    (let [serial (.serial condition)]
      (live-condition-unlock!)
      serial)))

(defn live-condition-active? [] (-> bool)
  (!= (atomic/atomic-load (field (live-condition) active)) 0))

(defn live-condition-kind [] (-> i64)
  (live-condition-lock!)
  (let [kind (if (live-condition-active?) (.kind (live-condition)) 0)]
    (live-condition-unlock!)
    kind))

(defn live-condition-serial [] (-> i64)
  (live-condition-lock!)
  (let [serial (.serial (live-condition))]
    (live-condition-unlock!)
    serial))

(defn live-condition-raise-c [(kind i64) (status i64)] (-> i64)
  (let [serial (live-condition-raise! kind status)
        thread (live-thread-state)]
    (if (and (!= (primitive/cast i64 thread) 0)
             (!= (primitive/cast i64 (.boundary thread)) 0))
        (do
          (_longjmp (primitive/cast (ptr i8)
                      (field (.boundary thread) buffer))
                    (primitive/cast i32 1))
          0)
        0)
    serial))

(defn live-affected-clear! [(head (ptr (ptr LiveAffected)))
                            (count (ptr i64))] (-> i64)
  (let [(mut node) (load head)]
    (loop (if (= (primitive/cast i64 (load node)) 0)
              (break)
              (let [next (.next (load node))
                    name (.name (load node))]
                (if (> (slice-len name) 0)
                    (free (primitive/cast (ptr i8) (slice-data name))) 0)
                (free (primitive/cast (ptr i8) (load node)))
                (set! node next)))))
  (store! head (primitive/cast (ptr LiveAffected) 0))
  (store! count 0)
  0)

(defn live-copy-bytes [(source (ptr u8)) (len i64)] (-> (ptr u8))
  (let [owned (primitive/cast (ptr u8)
                (malloc (primitive/cast u64 (if (= len 0) 1 len))))]
    (if (!= (primitive/cast i64 owned) 0)
        (for [i 0 len]
          (store! (primitive/index owned i) (load (primitive/index source i)))) 0)
    owned))

(defn live-stage-affected! [(identity i64) (kind i64) (name-p (ptr u8))
                            (name-len i64)] (-> i64)
  (if (or (<= identity 0) (< name-len 0))
      -1
      (let [owned-name (live-copy-bytes name-p name-len)
            node (primitive/cast (ptr LiveAffected)
                   (malloc (primitive/cast u64 (primitive/sizeof LiveAffected))))]
        (if (or (= (primitive/cast i64 owned-name) 0)
                (= (primitive/cast i64 node) 0))
            (do
              (if (!= (primitive/cast i64 owned-name) 0)
                  (free (primitive/cast (ptr i8) owned-name)) 0)
              (if (!= (primitive/cast i64 node) 0)
                  (free (primitive/cast (ptr i8) node)) 0)
              -2)
            (do
              (set! (.identity node) identity)
              (set! (.kind node) kind)
              (set! (.name node) (slice-new owned-name name-len))
              (set! (.next node) (load (live-staged-affected-head)))
              (store! (live-staged-affected-head) node)
              (store! (live-staged-affected-count)
                (+ (load (live-staged-affected-count)) 1))
              0)))))

(defn live-record-blocker! [(kind i64) (index i64) (schema i64)
                            (address (ptr i8))] (-> i64)
  (set! (live-blocker-kind) kind)
  (set! (live-blocker-index) index)
  (set! (live-blocker-schema) schema)
  (set! (live-blocker-address) (primitive/cast i64 address))
  0)
(defn live-managed-lock-cell [] (-> (ptr i64)) (primitive/alloc-static i64))
(defn live-last-status [] (-> (ptr i64)) (primitive/alloc-static i64))
(defn live-epoch-cell [] (-> (ptr i64)) (primitive/alloc-static i64))
(defn live-writer-cell [] (-> (ptr i64)) (primitive/alloc-static i64))
(defn live-reader-count [] (-> (ptr i64)) (primitive/alloc-static i64))

; Status values are a stable API for the inspector. 0 success; negative values
; leave every accepted root untouched.
(defn live-status [] (-> i64) (load (live-last-status)))
(defn live-set-status! [(status i64)] (-> i64)
  (set! (live-last-status) status)
  status)
(defn live-epoch [] (-> i64) (load (live-epoch-cell)))

; Gate registry mutation is rare (the first call of each source definition and
; publication planning). Entry counters remain atomic after exact identity
; lookup. Holding this lock while closing gates makes lookup/increment linearize
; before or after publication, never through it.
(defn live-source-gate-lock! [] (-> i64)
  (loop (if (= (atomic/atomic-cas (live-source-gate-lock) 0 1) 0) (break) 0)) 0)
(defn live-source-gate-unlock! [] (-> i64)
  (atomic/atomic-store (live-source-gate-lock) 0))

(defn live-source-gate-index-locked! [(identity i64)] (-> i64)
  (let [(mut found) -1]
    (for [i 0 (load (live-source-gate-count))]
      (if (and (= (load found) -1)
               (= (.identity (primitive/index (live-source-gates) i)) identity))
          (set! found i) 0))
    (if (!= (load found) -1) (load found)
        (let [i (load (live-source-gate-count))]
          (if (>= i 4096) -2
              (do
                (set! (.identity (primitive/index (live-source-gates) i)) identity)
                (set! (.active (primitive/index (live-source-gates) i)) 0)
                (set! (.closed (primitive/index (live-source-gates) i)) 0)
                (set! (.broken (primitive/index (live-source-gates) i)) 0)
                (set! (.generation-token (primitive/index (live-source-gates) i)) 0)
                (set! (live-source-gate-count) (+ i 1))
                i))))))

; Candidate binders record every permanent implementation slot they update.
; The candidate cannot retain its own image while it is still being loaded, so
; the host controller consumes this set immediately after commit makes that
; image current and before any retired image is reclaimed.
(defn live-clear-staged-code-owners! [] (-> i64)
  (set! (live-staged-code-owner-count) 0))

(defn live-stage-code-owner! [(identity i64)] (-> i64)
  (let [(mut found) false]
    (for [i 0 (load (live-staged-code-owner-count))]
      (if (= (load (primitive/index (live-staged-code-owners) i)) identity)
          (set! found true) 0))
    (if (load found) 0
        (let [i (load (live-staged-code-owner-count))]
          (if (>= i 4096) -2
              (do
                (store! (primitive/index (live-staged-code-owners) i) identity)
                (set! (live-staged-code-owner-count) (+ i 1))
                0))))))

(defn live-source-generation-token-swap! [(identity i64) (token i64)] (-> i64)
  (live-source-gate-lock!)
  (let [index (live-source-gate-index-locked! identity)
        (mut old) -1]
    (if (>= index 0)
        (do
          (set! old (.generation-token (primitive/index (live-source-gates) index)))
          (set! (.generation-token (primitive/index (live-source-gates) index)) token))
        0)
    (live-source-gate-unlock!)
    (load old)))

(defn live-source-broken? [(identity i64)] (-> bool)
  (live-source-gate-lock!)
  (let [index (live-source-gate-index-locked! identity)
        result (and (>= index 0)
                    (!= (atomic/atomic-load
                          (field (primitive/index (live-source-gates) index)
                                 broken)) 0))]
    (live-source-gate-unlock!)
    result))

(defn live-mark-source-broken! [(identity i64)] (-> i64)
  (live-source-gate-lock!)
  (let [index (live-source-gate-index-locked! identity)]
    (if (>= index 0)
        (atomic/atomic-store
          (field (primitive/index (live-source-gates) index) broken) 1) 0)
    (live-source-gate-unlock!)
    index))

(defn live-clear-broken-sources! [] (-> i64)
  (live-source-gate-lock!)
  (for [i 0 (load (live-source-gate-count))]
    (atomic/atomic-store
      (field (primitive/index (live-source-gates) i) broken) 0))
  (live-source-gate-unlock!))

(defn live-enter-source! [(identity i64)] (-> i64)
  (let [thread (live-thread-state) (mut entered) false (mut failure) 0]
    (if (= (primitive/cast i64 thread) 0) (set! failure -1)
        (if (>= (.depth thread) 256) (set! failure -4)
            (loop
              (live-source-gate-lock!)
              (let [gate-index
                      (live-source-gate-index-locked! identity)]
                (if (< gate-index 0)
                    (do (set! failure gate-index)
                        (live-source-gate-unlock!)
                        (break))
                    (let [gate (primitive/index (live-source-gates) gate-index)]
                      (if (or (!= (.publishing thread) 0)
                              (and (= (atomic/atomic-load (live-writer-cell)) 0)
                                   (= (atomic/atomic-load (field gate closed)) 0)))
                          (do
                            (atomic/atomic-add (field gate active) 1)
                            (atomic/atomic-add (live-reader-count) 1)
                            (store! (primitive/index (field thread gates)
                                      (.depth thread)) gate-index)
                            (set! (.depth thread) (+ (.depth thread) 1))
                            (set! entered true)
                            (live-source-gate-unlock!)
                            (break))
                          (live-source-gate-unlock!))))))))
    (if (load entered) (live-epoch) (load failure))))

; Runtime unit tests and non-transformed internal helpers use one explicit
; source identity. Production live entries always receive their structural ID
; from the metaprogram-generated wrapper.
(defn live-enter! [] (-> i64)
  (live-enter-source! 9223372036854775806))

(defn live-exit! [] (-> i64)
  (let [thread (live-thread-state)]
    (if (or (= (primitive/cast i64 thread) 0) (<= (.depth thread) 0))
        -1
        (do
          (set! (.depth thread) (- (.depth thread) 1))
          (let [gate-index
                  (load (primitive/index (field thread gates) (.depth thread)))]
