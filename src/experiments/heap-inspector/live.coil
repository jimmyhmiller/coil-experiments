    (loop (if (or (!= (load failure) 0) (>= (load i) (load (live-root-count))))
              (break)
              (let [root (primitive/index (live-roots) (load i))]
                (if (and (.live root)
                         (and (= (primitive/cast i64 (.handle root)) 0)
                         (and (= (.runtime-id root) runtime-id)
                              (!= (.schema-id root) target-schema))))
                    (let [rc (live-stage-root! (load i) target-schema)]
                      (if (!= rc 0) (set! failure rc) 0))
                    0)
                (set! i (+ (load i) 1)))))
    (if (!= (load failure) 0)
        (do
          (live-abort-staged!)
          (set! (live-last-status) (load failure))
          (load failure))
        0)))

(defn live-stage-roots-locked! [(runtime-id i64) (target-schema i64)] (-> i64)
  (live-begin-staging-locked!)
  (live-stage-type-roots-locked! runtime-id target-schema))

(defn live-forward-by-address [(old-value (ptr i8)) (target-runtime-id i64)] (-> i64)
  (let [(mut i) 0 (mut found) -1]
    (loop (if (>= (load i) (load (live-forward-count)))
              (break)
              (let [forward (primitive/index (live-forwards) (load i))]
                (if (and (= (primitive/cast i64 (.old-value forward))
                            (primitive/cast i64 old-value))
                         (= (.runtime-id forward) target-runtime-id))
                    (do (set! found (load i)) (break))
                    (set! i (+ (load i) 1))))))
    (load found)))

(defn live-root-address-known? [(address (ptr i8)) (target-runtime-id i64)] (-> bool)
  (let [(mut i) 0 (mut found) false]
    (loop (if (or (load found) (>= (load i) (load (live-root-count))))
              (break)
              (let [root (primitive/index (live-roots) (load i))]
                (if (and (.live root)
                         (and (= (.runtime-id root) target-runtime-id)
                              (= (primitive/cast i64 (load (.slot root)))
                                 (primitive/cast i64 address))))
                    (set! found true)
                    (set! i (+ (load i) 1))))))
    (if (load found)
        true
        (do
          (live-managed-lock!)
          (let [object-index (live-managed-object-by-address address)
                known (and (>= object-index 0)
                           (= (.runtime-id
                                (primitive/index (live-managed-objects) object-index))
                              target-runtime-id))]
            (live-managed-unlock!)
            known)))))

(defn live-resolve-forward! [(address (ptr i8)) (target-runtime-id i64)
                             (length i64) (out (ptr (ptr i8)))] (-> i64)
  (let [(mut i) 0 (mut result) -1]
    (loop (if (or (!= (load result) -1)
                  (>= (load i) (load (live-staged-managed-count))))
              (break)
              (let [staged (primitive/index (live-staged-managed) (load i))
                    object (primitive/index (live-managed-objects) (.object-index staged))
                    base (primitive/cast i64 (.old-value staged))
                    at (primitive/cast i64 address)]
                (if (and (= (.runtime-id object) target-runtime-id)
                         (and (>= at base) (< at (+ base (.old-bytes staged)))))
                    (let [old-size (live-schema-size (.old-schema staged))
                          new-size (live-schema-size (.new-schema staged))
                          delta (- at base)]
                      (if (or (<= old-size 0)
                              (or (!= (% delta old-size) 0)
                                  (> (+ (/ delta old-size) length) (.count staged))))
                          (set! result -11)
                          (do
                            (store! out (primitive/index (.new-value staged)
                                          (* (/ delta old-size) new-size)))
                            (set! result 0))))
                    (set! i (+ (load i) 1))))))
    (if (= (load result) -1)
        (let [forward-id (live-forward-by-address address target-runtime-id)]
          (if (>= forward-id 0)
              (do (store! out (.new-value (primitive/index (live-forwards) forward-id))) 0)
              -1))
        (load result))))

(defn live-rewrite-reference! [(base (ptr i8)) (rule (ptr LiveReferenceField))] (-> i64)
  (let [place (primitive/cast (ptr (ptr i8)) (primitive/index base (.offset rule)))
        old-target (load place)
        length (if (= (.kind rule) 2)
                   (load (primitive/cast (ptr i64)
                           (primitive/index base (+ (.offset rule) 8))))
                   1)
        rewritten (primitive/alloc-stack (ptr i8))]
    (if (= (primitive/cast i64 old-target) 0)
        (if (= length 0) 0 -11)
        (let [status (live-resolve-forward! old-target (.target-runtime-id rule)
                                             length rewritten)]
          (cond (= status 0) (do (store! place (load rewritten)) 0)
                (= status -11)
                  (do (live-record-blocker! 6 -1 (.schema-id rule) old-target) -11)
                (live-root-address-known? old-target (.target-runtime-id rule)) 0
                :else (do (live-record-blocker! 5 -1 (.schema-id rule) old-target) -10))))))

; All roots have been staged before this pass. Rewriting through the complete
; forwarding table preserves sharing and cycles without recursively descending
; before a cycle's destination exists. A non-null unregistered pointer blocks
; publication instead of leaving an old-layout address reachable from new code.
(defn live-rewrite-staged-references! [] (-> i64)
  (let [(mut failure) 0]
    (for [i 0 (load (live-staged-count))]
      (let [staged (primitive/index (live-staged) i)]
        (if (.owner staged)
            (for [j 0 (load (live-reference-field-count))]
              (let [rule (primitive/index (live-reference-fields) j)]
                (if (and (= (.schema-id rule) (.new-schema staged))
                         (or (= (.kind rule) 1) (= (.kind rule) 2)))
                    (let [status (live-rewrite-reference! (.new-value staged) rule)]
                      (if (!= status 0) (set! failure status) 0))
                    0)))
            0)))
    (for [i 0 (load (live-staged-managed-count))]
      (let [staged (primitive/index (live-staged-managed) i)
            element-size (live-schema-size (.new-schema staged))]
        (for [element 0 (.count staged)]
          (for [j 0 (load (live-reference-field-count))]
            (let [rule (primitive/index (live-reference-fields) j)]
              (if (and (= (.schema-id rule) (.new-schema staged))
                       (or (= (.kind rule) 1) (= (.kind rule) 2)))
                  (let [status (live-rewrite-reference!
                                 (primitive/index (.new-value staged)
                                   (* element element-size)) rule)]
                    (if (!= status 0) (set! failure status) 0))
                  0))))))
    (for [i 0 (load (live-staged-handle-count))]
      (let [staged (primitive/index (live-staged-handles) i)]
        (if (.owner staged)
            (for [j 0 (load (live-reference-field-count))]
              (let [rule (primitive/index (live-reference-fields) j)]
                (if (and (= (.schema-id rule) (.new-schema staged))
                         (or (= (.kind rule) 1) (= (.kind rule) 2)))
                    (let [status (live-rewrite-reference! (.new-value staged) rule)]
                      (if (!= status 0) (set! failure status) 0))
                    0)))
            0)))
    (load failure)))

; After successful staging, publication and retirement are bounded and cannot
; fail. The caller must still hold the writer gate.
(defn live-publish-staged-locked! [] (-> i64)
  (let [reference-status (live-rewrite-staged-references!)]
  (if (!= reference-status 0)
      (do (live-abort-staged!)
          (set! (live-last-status) reference-status)
          reference-status)
  (do
  (for [j 0 (load (live-staged-count))]
    (let [staged (primitive/index (live-staged) j)
          root (primitive/index (live-roots) (.root-index staged))]
      (store! (.slot root) (.new-value staged))
      (set! (.schema-id root) (.new-schema staged))
      (let [handle (.handle root)]
        (if (!= (primitive/cast i64 handle) 0)
            (set! (.schema-id handle) (.new-schema staged)) 0))))
  ; Handles publish independently of source roots. Every alias observes the
  ; new payload because the stable header address never changes.
  (for [j 0 (load (live-staged-handle-count))]
    (let [staged (primitive/index (live-staged-handles) j)
          handle (.handle staged)]
      (set! (.payload handle) (.new-value staged))
      (set! (.schema-id handle) (.new-schema staged))))
  ; Publish every allocator-owned vertex before retiring any of its old storage.
  ; References were already rewritten through the complete forwarding map.
  (live-managed-lock!)
  (for [j 0 (load (live-staged-managed-count))]
    (let [staged (primitive/index (live-staged-managed) j)
          object (primitive/index (live-managed-objects) (.object-index staged))]
      (set! (.address object) (.new-value staged))
      (set! (.schema-id object) (.new-schema staged))
      (set! (.bytes object) (.new-bytes staged))
      (set! (.migrating object) false)))
  (live-managed-unlock!)
  (for [j 0 (load (live-staged-count))]
    (let [staged (primitive/index (live-staged) j)]
      (if (.owner staged)
          (do (primitive/call-ptr (.retire staged) (.old-value staged))
              (free (.old-value staged)))
          0)))
  (for [j 0 (load (live-staged-handle-count))]
    (let [staged (primitive/index (live-staged-handles) j)]
      (if (.owner staged)
          (do (primitive/call-ptr (.retire staged) (.old-value staged))
              (free (.old-value staged)))
          0)))
  (for [j 0 (load (live-staged-managed-count))]
    (let [staged (primitive/index (live-staged-managed) j)
          old-element-size (live-schema-size (.old-schema staged))]
      (for [element 0 (.count staged)]
        (primitive/call-ptr (.retire staged)
          (primitive/index (.old-value staged) (* element old-element-size))))
      (primitive/call-ptr (.release staged) (.old-value staged)
                          (.old-bytes staged) (.align staged))))
  (set! (live-staged-count) 0)
  (set! (live-staged-handle-count) 0)
  (set! (live-staged-managed-count) 0)
  (set! (live-forward-count) 0)
  (live-affected-clear! (live-affected-head) (live-affected-count))
  (store! (live-affected-head) (load (live-staged-affected-head)))
  (store! (live-affected-count) (load (live-staged-affected-count)))
  (store! (live-staged-affected-head) (primitive/cast (ptr LiveAffected) 0))
  (store! (live-staged-affected-count) 0)
  (set! (live-epoch-cell) (+ (load (live-epoch-cell)) 1))
  0))))

(defn live-cancel-staged-locked! [] (-> i64)
  (live-abort-staged!))

(defn live-migrate-roots! [(runtime-id i64) (target-schema i64)] (-> i64)
  (live-begin-publication!)
  (let [(mut status) (live-stage-roots-locked! runtime-id target-schema)]
    (if (= (load status) 0)
        (set! status (live-publish-staged-locked!)) 0)
    (live-end-publication!)
    (load status)))

(defn live-register-transition-c [(runtime-id i64)
                                   (from-schema i64)
                                   (to-schema i64)
                                   (apply (ptr i8))
                                   (abort (ptr i8))
                                   (retire (ptr i8))] (-> i64)
  (live-register-transition
    runtime-id from-schema to-schema
    (primitive/llvm-ir (fnptr c [(ptr i8) (ptr i8)] i64) [apply] "ret ptr $0")
    (primitive/llvm-ir (fnptr c [(ptr i8)] i64) [abort] "ret ptr $0")
    (primitive/llvm-ir (fnptr c [(ptr i8)] i64) [retire] "ret ptr $0")))

; Candidate generations declare these as externs. They must share this host
; registry rather than importing a second copy of its alloc-static cells.
(export-c [live-register-transition-c :as "coil_live_register_transition"]
          [live-handle-new-c :as "coil_live_handle_new"]
          [live-handle-payload-c :as "coil_live_handle_payload"]
          [live-handle-borrow-payload-c :as "coil_live_handle_borrow_payload"]
          [live-handle-release-borrow-c :as "coil_live_handle_release_borrow"]
          [live-handle-ffi-retain-c :as "coil_live_handle_ffi_retain"]
          [live-handle-ffi-release-c :as "coil_live_handle_ffi_release"]
          [live-handle-pin-c :as "coil_live_handle_pin"]
          [live-handle-unpin-c :as "coil_live_handle_unpin"]
          [live-handle-retain-c :as "coil_live_handle_retain"]
          [live-handle-release-c :as "coil_live_handle_release"]
          [live-register-schema-destructor-c :as "coil_live_register_schema_destructor"]
          [live-register-root-c :as "coil_live_register_root"]
          [live-register-handle-root-c :as "coil_live_register_handle_root"]
          [live-register-reference-field :as "coil_live_register_reference_field"]
          [live-begin-staging-locked! :as "coil_live_begin_staging_locked"]
          [live-stage-type-roots-locked! :as "coil_live_stage_type_roots_locked"]
          [live-stage-roots-locked! :as "coil_live_stage_roots_locked"]
          [live-publish-staged-locked! :as "coil_live_publish_staged_locked"]
          [live-cancel-staged-locked! :as "coil_live_cancel_staged_locked"]
          [live-stage-affected! :as "coil_live_stage_affected"]
          [live-stage-code-owner! :as "coil_live_stage_code_owner"]
          [live-begin-affected-publication! :as "coil_live_begin_affected_publication"]
          [live-end-affected-publication! :as "coil_live_end_affected_publication"]
          [live-set-status! :as "coil_live_set_status"]
          [live-condition-raise-c :as "coil_live_raise_condition"]
          [live-condition-active? :as "coil_live_condition_active"]
          [live-source-broken? :as "coil_live_source_broken"]
          [live-mark-source-broken! :as "coil_live_mark_source_broken"]
          [live-clear-broken-sources! :as "coil_live_clear_broken_sources"]
          [live-enter-source! :as "coil_live_enter_source"]
          [live-exit! :as "coil_live_exit"]
          [live-reload-requested? :as "coil_live_reload_requested"])
