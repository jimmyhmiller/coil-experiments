(module experiments.heap-inspector.native-tutorial-test)

(import "coil.alloc" :as alloc)
(import "coil.assert" :use *)
(import "coil.fs" :as fs)
(import "coil.primitive" :as primitive)
(import "coil.result" :use *)
(import "experiments.heap-inspector.controller" :as controller)
(import "experiments.heap-inspector.live" :as live)
(import "experiments.heap-inspector.native-demo-api" :as demo)


(defn apply! [(source (slice u8))] (-> i64)
  (controller/live-controller-edit-source! source))

(defn read-frame! [(frame (ptr (array demo/NativeDemoParticle 18)))] (-> i64)
  (demo/native-demo-read-frame!
    (primitive/cast (ptr demo/NativeDemoParticle) frame)))

(defn assert-position [(frame (ptr (array demo/NativeDemoParticle 18)))
                       (x i64) (y i64)] (-> void)
  (assert-eq x (.x (primitive/index frame 0)))
  (assert-eq y (.y (primitive/index frame 0))))

(deftest complete-seven-step-native-tutorial-preserves-world-and-repairs
  (assert-eq 0 (controller/live-controller-enable-native-coil-demo!))
  (match (fs/read-file (alloc/malloc-allocator)
                       "src/experiments/heap-inspector/viewer/native-demo-base.coil")
    (Err [e] (assert false))
    (Ok [base]
      (assert-eq 0 (apply! base))))
  (let [frame (primitive/alloc-stack (array demo/NativeDemoParticle 18))]
    (assert-eq 0 (read-frame! frame))
    (demo/native-demo-set-running! false)
    (let [x (.x (primitive/index frame 0))
          y (.y (primitive/index frame 0))]
      ; 1. One ordinary function body, not a complete program replay.
      (assert-eq 0 (apply! "(defn radius [(p Particle)] (-> i64) 14)"))
      (assert-eq 0 (read-frame! frame))
      (assert-position frame x y)
      (assert-eq 14 (.radius (primitive/index frame 0)))

      ; 2. Add defaulted fields and behavior over the migrated payload.
      (assert-eq 0
        (apply!
          "(defstruct Particle
             [(x i64) (y i64) (vx i64) (vy i64)
              (hue i64 20) (visible bool true)])
           (defn tint [(p Particle)] (-> i64)
             (if (.visible p) (+ (.hue p) (/ (.x p) 3)) 0))"))
      (assert-eq 0 (read-frame! frame))
      (assert-position frame x y)
      (assert-eq (+ 20 (/ x 3)) (.tint (primitive/index frame 0)))

      ; 3. A non-preserving field change remains pending and publishes nothing.
      (assert-eq 1
        (apply!
          "(defsum Visibility (Hidden) (Visible))
           (defstruct Particle
             [(x i64) (y i64) (vx i64) (vy i64)
              (hue i64 20) (visible Visibility)])"))
      (assert-eq 9 (controller/live-controller-phase))
      (assert (live/live-condition-active?))
      (assert-eq 1 (live/live-condition-kind))
      (assert-position frame x y)

      ; 4. The transition, new default, stale readers, and constructor are one
      ; checked batch. The same native payload graph is migrated and resumed.
      (assert-eq 0
        (apply!
          "(defsum Visibility (Hidden) (Visible))
           (defstruct Particle
             [(x i64) (y i64) (vx i64) (vy i64)
              (hue i64 20) (visible Visibility (Visible))])
           (migrate Particle visible old
             (if old (Visible) (Hidden)))
           (defn tint [(p Particle)] (-> i64)
             (match (.visible p)
               (Hidden [] 0)
               (Visible [] (+ (.hue p) (/ (.x p) 3)))))
           (defn advance [(p Particle)] (-> Particle)
             (let [(mut nx) (+ (.x p) (.vx p))
                   (mut ny) (+ (.y p) (.vy p))
                   (mut nvx) (.vx p) (mut nvy) (.vy p)]
               (when (< nx 14) (store! nx 14) (store! nvx (- 0 nvx)))
               (when (> nx 626) (store! nx 626) (store! nvx (- 0 nvx)))
               (when (< ny 14) (store! ny 14) (store! nvy (- 0 nvy)))
               (when (> ny 386) (store! ny 386) (store! nvy (- 0 nvy)))
               (Particle :x nx :y ny :vx nvx :vy nvy
                         :hue (.hue p) :visible (.visible p))))"))
      (assert (not (live/live-condition-active?)))
      (assert-eq 0 (read-frame! frame))
      (assert-position frame x y)

      ; 5. Add enum-directed native drawing.
      (assert-eq 0
        (apply!
          "(defsum Kind (Dot) (Ring))
           (defn kind-of [(p Particle)] (-> Kind)
             (if (> (.x p) 320) (Ring) (Dot)))
           (defn kind-code [(p Particle)] (-> i64)
             (match (kind-of p) (Dot [] 0) (Ring [] 1)))"))
      (let [handles-before (load (live/live-handle-count))]
        (for [_ 0 16]
          (assert-eq 0 (read-frame! frame)))
        (assert-eq handles-before (load (live/live-handle-count))))
      (assert-position frame x y)

      ; 6. Growing the enum makes the complete candidate non-exhaustive. No
      ; candidate ABI can publish, so the controller raises Broken globally and
      ; the native frame API keeps returning the last committed frame.
      (assert-eq 1
        (apply!
          "(defsum Kind (Dot) (Ring) (Bar))
           (defn kind-of [(p Particle)] (-> Kind)
             (if (> (.x p) 430) (Bar)
                 (if (> (.x p) 320) (Ring) (Dot))))
           (defn kind-code [(p Particle)] (-> i64)
             (match (kind-of p) (Dot [] 0) (Ring [] 1)))"))
      (assert-eq 15 (controller/live-controller-phase))
      (assert (live/live-condition-active?))
      (assert-eq 2 (live/live-condition-kind))
      (let [status (controller/live-controller-snapshot)]
        (assert (controller/live-controller-contains?
                  status "\"requiredRepairs\":[{\"module\":\"replsession\",\"kind\":\"function\",\"name\":\"kind-code\""))
        (assert (controller/live-controller-contains?
                  status "non-exhaustive match"))
        (assert (not (controller/live-controller-contains?
                       status "\"name\":\"kind-of\",\"compilerFunction\""))))
      (let [handles-before (load (live/live-handle-count))]
        (for [_ 0 128]
          (assert-eq 0 (read-frame! frame)))
        (assert-eq handles-before (load (live/live-handle-count))))
      (assert-position frame x y)

      ; 7. Submit only the stale match. Pending source supplies the rejected
      ; enum branch; successful publication clears Broken and resumes in place.
      (assert-eq 0
        (apply!
          "(defn kind-code [(p Particle)] (-> i64)
             (match (kind-of p)
               (Dot [] 0) (Ring [] 1) (Bar [] 2)))"))
      (assert (not (live/live-condition-active?)))
      (let [handles-before (load (live/live-handle-count))]
        (for [_ 0 128]
          (assert-eq 0 (read-frame! frame)))
        (assert-eq handles-before (load (live/live-handle-count))))
      (assert-position frame x y))))
