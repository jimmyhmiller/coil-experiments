(meta (registry/registry-phase-a-self-check))
(meta (reader/lr-registry-demo-self-check))
(meta (reader/lr-pending-collapse-self-check))
(reader/lr-pending-collapse-source-self-check
  "(defsum Visibility (Hidden) (Visible))
   (defstruct Particle [(visible Visibility)])
   (defsum Visibility (Hidden) (Visible))
   (defstruct Particle [(visible Visibility (Visible))])
   (migrate Particle visible old (if old (Visible) (Hidden)))")

(defn main [] (-> i64) 0)
