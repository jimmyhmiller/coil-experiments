(module experiments.heap-inspector.live-app-api)

(import "coil.primitive" :as primitive)
(import "coil.atomic" :as atomic)
(import "experiments.heap-inspector.live" :as live)

(defstruct LiveAppApi
  [(published bool) (staged bool)
   (start (fnptr c [] i64)) (redraw (fnptr c [] i64))
   (staged-start (fnptr c [] i64)) (staged-redraw (fnptr c [] i64))])

(defn live-app-api [] (-> (ptr LiveAppApi)) (primitive/alloc-static LiveAppApi))
(defn live-app-lock-cell [] (-> (ptr i64)) (primitive/alloc-static i64))
(defn live-app-lock! [] (-> i64)
  (loop (if (= (atomic/atomic-cas (live-app-lock-cell) 0 1) 0) (break) 0)) 0)
(defn live-app-unlock! [] (-> i64) (atomic/atomic-store (live-app-lock-cell) 0))

;;; The whole application runtime lives in the JIT world. START enters its UI
;;; loop on the native main thread; REDRAW invalidates that same runtime after a
;;; successful nREPL edit without duplicating its global state in the host.
(defn live-app-stage-callbacks! [(start (fnptr c [] i64))
                                 (redraw (fnptr c [] i64))] (-> i64)
  (let [api (live-app-api)]
    (set! (.staged-start api) start)
    (set! (.staged-redraw api) redraw)
    (set! (.staged api) true) 0))

(defn live-app-publish-staged! [] (-> i64)
  (let [api (live-app-api)]
    (when (.staged api)
      (live-app-lock!)
      (set! (.start api) (.staged-start api))
      (set! (.redraw api) (.staged-redraw api))
      (set! (.published api) true)
      (set! (.staged api) false)
      (live-app-unlock!)) 0))

(defn live-app-abort-staged! [] (-> i64) (set! (.staged (live-app-api)) false) 0)
(defn live-app-ready? [] (-> bool) (.published (live-app-api)))

(defn live-app-call [(callback (fnptr c [] i64))] (-> i64)
  (live/live-enter!)
  (let [result (primitive/call-ptr callback)] (live/live-exit!) result))

(defn live-app-run! [] (-> i64)
  (let [api (live-app-api)]
    (live-app-lock!)
    (let [ready (.published api) callback (.start api)]
      (live-app-unlock!)
      ; START is a retained one-shot private implementation. Its event loop is
      ; intentionally outside the reader gate so edits can publish while the
      ; application remains open.
      (if ready (primitive/call-ptr callback) -1))))

(defn live-app-request-redraw! [] (-> i64)
  (let [api (live-app-api)]
    (live-app-lock!)
    (let [ready (.published api) callback (.redraw api)]
      (live-app-unlock!)
      (if ready (live-app-call callback) 0))))

(export-c [live-app-stage-callbacks! :as "coil_live_app_stage_callbacks"])
