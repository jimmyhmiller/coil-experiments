(module experiments.image.api)

; The image inspector surface: a JSON status document describing the ledger, the
; pending candidate, and the last save/load blocker. The heap-inspector viewer
; can serve this at /api/image and drive a save from /api/image/save; the JSON
; builder here is the reusable core, independently testable.

(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.slice" :use *)
(import "coil.arraylist" :use *)
(import "coil.str" :as str)
(import "experiments.image.format" :use *)
(import "experiments.image.runtime" :use [ImageBlocker image-blocker-name])
(import "experiments.image.ledger" :as ledger)
(import "experiments.image.live-bridge" :as bridge)
(import "experiments.image.image" :as image)

(defn kind-name [(kind i64)] (-> (slice u8))
  (cond (= kind IMAGE-LEDGER-BASE) "base"
        (= kind IMAGE-LEDGER-EDIT) "edit"
        (= kind IMAGE-LEDGER-RECOVERY) "recovery"
        :else "unknown"))

(defn status-name [(status i64)] (-> (slice u8))
  (cond (= status IMAGE-LEDGER-ACCEPTED) "accepted"
        (= status IMAGE-LEDGER-OVERRIDDEN) "overridden-by-base"
        :else "unknown"))

(defn json-str! [(sb (mut str/StrBuf)) (s (slice u8))] (-> i64)
  (str/sb-push-byte! (mut sb) (primitive/cast u8 34))
  (for [i 0 (slice-len s)]
    (let [c (primitive/cast i64 (slice-get s i))]
      (cond
        (= c 34) (str/sb-push-str! (mut sb) "\\\"")
        (= c 92) (str/sb-push-str! (mut sb) "\\\\")
        (= c 10) (str/sb-push-str! (mut sb) "\\n")
        (= c 13) (str/sb-push-str! (mut sb) "\\r")
        (= c 9) (str/sb-push-str! (mut sb) "\\t")
        :else (str/sb-push-byte! (mut sb) (slice-get s i)))))
  (str/sb-push-byte! (mut sb) (primitive/cast u8 34)))

;;; Build the image status JSON. Owned by `a`.
(defn image-status-json [(a (dyn alloc/Allocator))] (-> (slice u8))
  (let [(mut sb) (str/sb-new a)
        blocker (bridge/bridge-blocker)]
    (str/sb-push-str! (mut sb) "{\"supported\":true,\"format\":")
    (str/sb-push-i64! (mut sb) IMAGE-FORMAT-VERSION)
    (str/sb-push-str! (mut sb) ",\"ledger\":[")
    (for [i 0 (ledger/ledger-count)]
      (let [e (ledger/ledger-entry i)]
        (if (> i 0) (str/sb-push-byte! (mut sb) (primitive/cast u8 44)) 0)
        (str/sb-push-str! (mut sb) "{\"serial\":")
        (str/sb-push-i64! (mut sb) (.serial e))
        (str/sb-push-str! (mut sb) ",\"kind\":")
        (json-str! (mut sb) (kind-name (.kind e)))
        (str/sb-push-str! (mut sb) ",\"status\":")
        (json-str! (mut sb) (status-name (.status e)))
        (str/sb-push-str! (mut sb) ",\"name\":")
        (json-str! (mut sb) (ledger/ledger-defined-name (.source e)))
        (str/sb-push-byte! (mut sb) (primitive/cast u8 125))))
    (str/sb-push-str! (mut sb) "],\"pendingCount\":")
    (str/sb-push-i64! (mut sb) (if (.pending-present (ledger/ledger-state)) 1 0))
    (str/sb-push-str! (mut sb) ",\"lastBlocker\":")
    (json-str! (mut sb) (image-blocker-name (.kind blocker)))
    (str/sb-push-str! (mut sb) ",\"blockerAddress\":")
    (str/sb-push-i64! (mut sb) (.address blocker))
    (str/sb-push-byte! (mut sb) (primitive/cast u8 125))
    (str/sb-finish! (mut sb))))

;;; A POST /api/image/save handler: save the live world and report the outcome
;;; as JSON. `mode` is IMAGE-MODE-CONTINUE for an in-place snapshot.
(defn image-save-json [(a (dyn alloc/Allocator)) (path (slice u8)) (mode i64)] (-> (slice u8))
  (let [status (image/image-save! path mode)
        (mut sb) (str/sb-new a)]
    (str/sb-push-str! (mut sb) "{\"saved\":")
    (str/sb-push-str! (mut sb) (if (= status 0) "true" "false"))
    (str/sb-push-str! (mut sb) ",\"status\":")
    (str/sb-push-i64! (mut sb) status)
    (str/sb-push-str! (mut sb) ",\"error\":")
    (json-str! (mut sb) (image/image-error-name status))
    (str/sb-push-byte! (mut sb) (primitive/cast u8 125))
    (str/sb-finish! (mut sb))))
