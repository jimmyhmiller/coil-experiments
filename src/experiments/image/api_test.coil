(module experiments.image.api-test)

; The inspector status JSON: it reflects the ledger, kinds, statuses, and names.
; Fast — no JIT, no live world required.

(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.assert" :use *)
(import "coil.slice" :use *)
(import "experiments.image.format" :use *)
(import "experiments.image.ledger" :as ledger)
(import "experiments.image.api" :as api)

(defn contains? [(text (slice u8)) (needle (slice u8))] (-> bool)
  (let [(mut at) 0 (mut found) false]
    (loop (if (or (load found) (> (+ (load at) (slice-len needle)) (slice-len text))) (break)
              (let [(mut i) 0 (mut same) true]
                (loop (if (or (not (load same)) (>= (load i) (slice-len needle))) (break)
                          (if (= (slice-get text (+ (load at) (load i))) (slice-get needle (load i)))
                              (set! i (+ (load i) 1)) (set! same false))))
                (if (load same) (set! found true) (set! at (+ (load at) 1))))))
    (load found)))

(deftest status-json-reflects-the-ledger
  (ledger/ledger-record! "(defstruct Cell [(a i64)])" IMAGE-LEDGER-BASE)
  (ledger/ledger-record! "(defn value [(c Cell)] (-> i64) (.a c))" IMAGE-LEDGER-EDIT)
  (ledger/ledger-mark-conflicts! "(defn value [(c Cell)] (-> i64) 0)")
  (let [json (api/image-status-json (alloc/malloc-allocator))]
    (assert (contains? json "\"supported\":true"))
    (assert (contains? json "\"format\":1"))
    (assert (contains? json "\"kind\":\"base\""))
    (assert (contains? json "\"kind\":\"edit\""))
    (assert (contains? json "\"status\":\"accepted\""))
    (assert (contains? json "\"status\":\"overridden-by-base\""))
    (assert (contains? json "\"name\":\"Cell\""))
    (assert (contains? json "\"name\":\"value\""))
    (assert (contains? json "\"serial\":1"))
    (assert (contains? json "\"lastBlocker\":\"none\""))))

(deftest save-json-reports-the-outcome
  ; An empty live world saves an empty image successfully.
  (let [json (api/image-save-json (alloc/malloc-allocator) "build/image-api-save.coilimage" IMAGE-MODE-CONTINUE)]
    (assert (contains? json "\"saved\":true"))
    (assert (contains? json "\"error\":\"ok\""))))
