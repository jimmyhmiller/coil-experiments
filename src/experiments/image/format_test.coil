(module experiments.image.format-test)

; The container envelope: every section survives an encode/decode, and every
; way a file can be wrong is reported as the specific error, never decoded.

(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.assert" :use *)
(import "coil.slice" :use *)
(import "coil.arraylist" :use *)
(import "experiments.image.format" :use *)

(defn sample-image [(a (dyn alloc/Allocator))] (-> Image)
  (let [(mut img) (image-new a)
        (mut entry) (primitive/zeroed ImageLedgerEntry)
        (mut schema) (primitive/zeroed ImageSchema)
        (mut obj) (primitive/zeroed ImageObject)]
    (set! (.live-fingerprint (.header img)) 1234)
    (set! (.base-fingerprint (.header img)) 5678)
    (set! (.epoch (.header img)) 3)
    (set! (.serial (.header img)) 2)
    (set! (.mode (.header img)) IMAGE-MODE-CONTINUE)
    (set! (.serial entry) 1)
    (set! (.source entry) "(defn radius [(p Particle)] (-> i64) 14)")
    (set! (.fingerprint entry) 99)
    (set! (.kind entry) IMAGE-LEDGER-EDIT)
    (set! (.status entry) IMAGE-LEDGER-ACCEPTED)
    (set! (.affected entry) (al-new [(slice u8)] a))
    (al-push! (mut (.affected entry)) "(live-def-id demo :function radius)")
    (set! (.schemas entry) (al-new [i64] a))
    (al-push! (mut (.schemas entry)) 4242)
    (al-push! (mut (.ledger img)) (load entry))
    (set! (.present (.pending img)) true)
    (set! (.source (.pending img)) "(defstruct Particle [(x i64)])")
    (set! (.diagnostic (.pending img)) "needs transition")
    (set! (.condition (.pending img)) 1)
    (set! (.runtime-id schema) 77)
    (set! (.name schema) "Particle")
    (set! (.version schema) 2)
    (set! (.fingerprint schema) 4242)
    (set! (.kind schema) IMAGE-KIND-STRUCT)
    (set! (.size schema) 16)
    (set! (.align schema) 8)
    (set! (.stride schema) 16)
    (set! (.declaration schema) "(defstruct Particle [(x i64) (y i64)])")
    (set! (.fields schema) (al-new [ImageField] a))
    (al-push! (mut (.fields schema))
      (ImageField :name "x" :type-text "i64" :offset 0 :size 8 :policy IMAGE-POLICY-DEFAULT))
    (set! (.variants schema) (al-new [ImageVariant] a))
    (set! (.references schema) (al-new [ImageReference] a))
    (al-push! (mut (.references schema))
      (ImageReference :offset 8 :kind IMAGE-REF-OBJECT :target 77))
    (set! (.edges schema) (al-new [i64] a))
    (al-push! (mut (.edges schema)) 1)
    (al-push! (mut (.schemas img)) (load schema))
    (set! (.id obj) 1)
    (set! (.runtime-id obj) 77)
    (set! (.fingerprint obj) 4242)
    (set! (.kind obj) IMAGE-KIND-STRUCT)
    (set! (.count obj) 1)
    (set! (.stride obj) 16)
    (set! (.bytes obj) 16)
    (set! (.align obj) 8)
    (match (alloc/alloc-bytes a 16 8)
      (None [] (fail))
      (Some [payload]
        (do
          (for [i 0 16] (store! (primitive/index (slice-data payload) i) (primitive/cast u8 (+ 200 i))))
          (set! (.payload obj) (ImageBytes :data payload))
          0)))
    (set! (.relocations obj) (al-new [ImageRelocation] a))
    (al-push! (mut (.relocations obj))
      (ImageRelocation :offset 8 :kind IMAGE-REF-SLICE :target 1 :interior 4 :length 3))
    (set! (.functions obj) (al-new [ImageFunctionValue] a))
    (al-push! (mut (.functions obj))
      (ImageFunctionValue :offset 0 :stable-id "(live-def-id demo :function tick)" :lineage 2))
    (set! (.transient obj) (al-new [i64] a))
    (al-push! (mut (.transient obj)) 8)
    (al-push! (mut (.objects img)) (load obj))
    (al-push! (mut (.handles img)) (ImageHandle :id 1 :object 1 :refs 2 :root 1))
    (al-push! (mut (.roots img))
      (ImageRoot :name "world" :runtime-id 77 :fingerprint 4242 :handle 1 :object 1))
    (al-push! (mut (.hooks img)) "(live-def-id demo :function reopen-window!)")
    (set! (.unreachable (.census img)) 1)
    (set! (.untracked (.census img)) 9)
    (load img)))

(defn fail [] (-> i64) (assert false) 0)

(defn assert-error [(r (Result Image ImageFormatError)) (name (slice u8))] (-> i64)
  (match r
    (Ok [_] (fail))
    (Err [e] (do (assert (image-bytes=? name (image-format-error-name e))) 0))))

(deftest every-section-survives-encode-and-decode
  (let [a (alloc/malloc-allocator)
        img (primitive/alloc-stack Image)]
    (store! img (sample-image a))
    (match (image-encode a img)
      (Err [e] (do (println "encode failed: {s}" (image-format-error-name e)) (fail)))
      (Ok [bytes]
        (do
          (assert (image-bytes=? IMAGE-MAGIC (subslice bytes 0 8)))
          (match (image-decode a bytes)
            (Err [e] (do (println "decode failed: {s}" (image-format-error-name e)) (fail)))
            (Ok [back]
              (let [bp (primitive/alloc-stack Image)]
                (store! bp back)
                (assert-eq 1234 (.live-fingerprint (field bp header)))
                (assert-eq 5678 (.base-fingerprint (field bp header)))
                (assert-eq 3 (.epoch (field bp header)))
                (assert-eq IMAGE-MODE-CONTINUE (.mode (field bp header)))
                (assert (image-bytes=? (image-target-name) (.target (field bp header))))
                (assert-eq 1 (al-len (.ledger bp)))
                (let [e (al-elem (field bp ledger) 0)]
                  (assert-eq 1 (.serial e))
                  (assert (image-bytes=? "(defn radius [(p Particle)] (-> i64) 14)" (.source e)))
                  (assert-eq IMAGE-LEDGER-EDIT (.kind e))
                  (assert-eq 1 (al-len (.affected e)))
                  (assert (image-bytes=? "(live-def-id demo :function radius)" (al-get (.affected e) 0)))
                  (assert-eq 4242 (al-get (.schemas e) 0)))
                (assert (.present (field bp pending)))
                (assert (image-bytes=? "needs transition" (.diagnostic (field bp pending))))
                (assert-eq 1 (al-len (.schemas bp)))
                (let [s (al-elem (field bp schemas) 0)]
                  (assert (image-bytes=? "Particle" (.name s)))
                  (assert-eq 2 (.version s))
                  (assert-eq 16 (.stride s))
                  (assert (image-bytes=? "x" (.name (al-elem (field s fields) 0))))
                  (assert-eq IMAGE-REF-OBJECT (.kind (al-elem (field s references) 0)))
                  (assert-eq 1 (al-get (.edges s) 0)))
                (assert-eq 1 (al-len (.objects bp)))
                (let [o (al-elem (field bp objects) 0)]
                  (assert-eq 16 (.bytes o))
                  (assert-eq 16 (slice-len (.data (field o payload))))
                  (assert-eq 205 (primitive/cast i64 (slice-get (.data (field o payload)) 5)))
                  (let [rel (al-elem (field o relocations) 0)]
                    (assert-eq IMAGE-REF-SLICE (.kind rel))
                    (assert-eq 4 (.interior rel))
                    (assert-eq 3 (.length rel)))
                  (let [fv (al-elem (field o functions) 0)]
                    (assert-eq 2 (.lineage fv))
                    (assert (image-bytes=? "(live-def-id demo :function tick)" (.stable-id fv))))
                  (assert-eq 8 (al-get (.transient o) 0)))
                (assert-eq 2 (.refs (al-elem (field bp handles) 0)))
                (assert (image-bytes=? "world" (.name (al-elem (field bp roots) 0))))
                (assert (image-bytes=? "(live-def-id demo :function reopen-window!)" (al-get (.hooks bp) 0)))
                (assert-eq 9 (.untracked (field bp census)))
                0))))))))

(deftest damaged-containers-are-refused
  (let [a (alloc/malloc-allocator)
        img (primitive/alloc-stack Image)]
    (store! img (sample-image a))
    (match (image-encode a img)
      (Err [_] (fail))
      (Ok [bytes]
        (do
          (assert-error (image-decode a (subslice bytes 0 10)) "truncated")
          ; a flipped magic byte
          (store! (primitive/index (slice-data bytes) 0) (primitive/cast u8 \X))
          (assert-error (image-decode a bytes) "bad-magic")
          (store! (primitive/index (slice-data bytes) 0) (primitive/cast u8 \C))
          ; a flipped payload byte breaks the hash
          (let [i 40 old (slice-get bytes i)]
            (store! (primitive/index (slice-data bytes) i)
                    (primitive/cast u8 (primitive/ixor (primitive/cast i64 old) 1)))
            (assert-error (image-decode a bytes) "bad-hash")
            (store! (primitive/index (slice-data bytes) i) old))
          ; a wrong recorded length
          (let [len-at (- (slice-len bytes) 16) old (slice-get bytes len-at)]
            (store! (primitive/index (slice-data bytes) len-at)
                    (primitive/cast u8 (primitive/ixor (primitive/cast i64 old) 1)))
            (assert-error (image-decode a bytes) "bad-length")
            (store! (primitive/index (slice-data bytes) len-at) old))
          ; still decodes once restored
          (match (image-decode a bytes)
            (Err [_] (fail))
            (Ok [_] 0)))))))

(deftest a-future-format-version-is-refused
  (let [a (alloc/malloc-allocator)
        img (primitive/alloc-stack Image)]
    (store! img (sample-image a))
    (set! (.format-version (field img header)) (+ IMAGE-FORMAT-VERSION 1))
    (match (image-encode a img)
      (Err [_] (fail))
      (Ok [bytes] (assert-error (image-decode a bytes) "bad-version")))
    (set! (.format-version (field img header)) IMAGE-FORMAT-VERSION)
    (set! (.pointer-width (field img header)) 4)
    (match (image-encode a img)
      (Err [_] (fail))
      (Ok [bytes] (assert-error (image-decode a bytes) "bad-pointer-width")))))

(deftest name-hash-matches-the-live-runtime-formula
  ; FNV-1a 32-bit constants over the name, masked positive: the same function
  ; the heap-inspector runtime uses for `live-type-id`.
  (assert-eq 2166136261 (image-name-hash ""))
  (assert (> (image-name-hash "Particle") 0))
  (assert (!= (image-name-hash "Particle") (image-name-hash "particle"))))
