(module experiments.live-demo.window)

;;; The bouncing-ball demo's window: a Cocoa window with one round CALayer per
;;; ball. It keeps no program state. The live program owns the world and, every
;;; frame, says where each ball is and how it looks.
;;;
;;; This module is not live: the program compiles it in when it starts, and an
;;; edit to it takes a restart.
(import "coil.primitive" :as primitive)
(import "experiments.invaders.objc" :use *)

(export BALLS window-open! window-open? window-begin-frame! window-ball! window-end-frame!)

(extern usleep :cc c [i32] (-> i32))
(extern sin :cc c [f64] (-> f64))
(extern CGColorCreateGenericRGB :cc c [f64 f64 f64 f64] (-> (ptr i8)))
(extern CGColorRelease :cc c [(ptr i8)] (-> i64))

(const BALLS 18)

(defstruct Rect [(x f64) (y f64) (w f64) (h f64)])

(defn rect [(x f64) (y f64) (w f64) (h f64)] (-> Rect)
  (let [r (primitive/alloc-stack Rect)]
    (set! (.x r) x) (set! (.y r) y) (set! (.w r) w) (set! (.h r) h)
    (load r)))

(defstruct WindowState
  [(app (ptr i8))
   (window (ptr i8))
   (mode (ptr i8))
   (background (ptr i8))
   (clear (ptr i8))])

(defn state [] (-> (ptr WindowState)) (primitive/alloc-static WindowState))

(defn layers [] (-> (ptr (array (ptr i8) 18))) (primitive/alloc-static (array (ptr i8) 18)))

(defn ns-string [(s (ptr i8))] (-> (ptr i8))
  (msg (ptr i8) (class c"NSString") (sel c"stringWithUTF8String:") [(ptr i8)] s))

; A hue wheel: TINT is an angle in degrees.
(defn color [(tint i64)] (-> (ptr i8))
  (let [angle (* (primitive/cast f64 (% tint 360)) 0.017453292519943295)
        r (+ 0.5 (* 0.5 (sin angle)))
        g (+ 0.5 (* 0.5 (sin (+ angle 2.0943951023931953))))
        b (+ 0.5 (* 0.5 (sin (+ angle 4.1887902047863905))))]
    (CGColorCreateGenericRGB r g b 0.96)))

;;; Open the 640x400 window. Call once, on the main thread, before the rest.
(defn window-open! [] (-> i64)
  (let [st (state)
        app (msg (ptr i8) (class c"NSApplication") (sel c"sharedApplication") [])
        window (msg (ptr i8) (class c"NSWindow") (sel c"alloc") [])
        root (msg (ptr i8) (class c"CALayer") (sel c"layer") [])]
    (set! (.app st) app)
    (set! (.window st) window)
    (set! (.mode st) (ns-string c"kCFRunLoopDefaultMode"))
    (set! (.background st) (CGColorCreateGenericRGB 0.025 0.032 0.052 1.0))
    (set! (.clear st) (CGColorCreateGenericRGB 0.0 0.0 0.0 0.0))
    (msg (ptr i8) window (sel c"initWithContentRect:styleMask:backing:defer:")
         [Rect i64 i64 i64] (rect 120.0 140.0 640.0 400.0) 15 2 0)
    (msg (ptr i8) window (sel c"setTitle:") [(ptr i8)] (ns-string c"Coil live: bouncing balls"))
    (msg (ptr i8) app (sel c"setActivationPolicy:") [i64] 0)
    (msg (ptr i8) (msg (ptr i8) window (sel c"contentView") [])
         (sel c"setWantsLayer:") [i64] 1)
    ; AppKit's layer-hosting view does not infer the frame of a caller-supplied
    ; root layer, and a zero-sized root clips every sublayer.
    (msg (ptr i8) root (sel c"setFrame:") [Rect] (rect 0.0 0.0 640.0 400.0))
    (msg (ptr i8) root (sel c"setMasksToBounds:") [i64] 1)
    (msg (ptr i8) root (sel c"setBackgroundColor:") [(ptr i8)] (.background st))
    (for [i 0 BALLS]
      (let [layer (msg (ptr i8) (class c"CALayer") (sel c"layer") [])]
        (set! (primitive/index (layers) i) layer)
        (msg (ptr i8) root (sel c"addSublayer:") [(ptr i8)] layer)
        0))
    (msg (ptr i8) (msg (ptr i8) window (sel c"contentView") [])
         (sel c"setLayer:") [(ptr i8)] root)
    (msg (ptr i8) window (sel c"makeKeyAndOrderFront:") [(ptr i8)] (primitive/cast (ptr i8) 0))
    (msg (ptr i8) app (sel c"activateIgnoringOtherApps:") [i64] 1)
    (msg (ptr i8) app (sel c"finishLaunching") [])
    0))

;;; Until the window is closed.
(defn window-open? [] (-> bool)
  (let [st (state)]
    (= (msg i64 (.window st) (sel c"isVisible") []) 1)))

;;; Handle the window's pending events and start a frame.
(defn window-begin-frame! [] (-> i64)
  (let [st (state)
        app (.app st)
        mode (.mode st)]
    (while true
      (let [event (msg (ptr i8) app (sel c"nextEventMatchingMask:untilDate:inMode:dequeue:")
                       [i64 (ptr i8) (ptr i8) i64]
                       -1 (primitive/cast (ptr i8) 0) mode 1)]
        (if (= (primitive/cast i64 event) 0)
            (break 0)
            (msg (ptr i8) app (sel c"sendEvent:") [(ptr i8)] event))))
    (msg (ptr i8) (class c"CATransaction") (sel c"begin") [])
    (msg (ptr i8) (class c"CATransaction") (sel c"setDisableActions:") [i64] 1)
    0))

;;; Draw ball I (0 to BALLS - 1) this frame: centered at X, Y (from the
;;; bottom left), RADIUS, its color an angle TINT on the hue wheel, and KIND 0
;;; a dot, 1 a ring, 2 a bar. Returns 1, drawing nothing, for an I out of range.
(defn window-ball! [(i i64) (x i64) (y i64) (radius i64) (tint i64) (kind i64)] (-> i64)
  (if (or (< i 0) (>= i BALLS))
      1
      (let [st (state)
            layer (load (primitive/index (layers) i))
            r (primitive/cast f64 radius)
            fx (primitive/cast f64 x)
            fy (primitive/cast f64 y)
            c (color tint)]
        (cond
          (= kind 1)
            (let [outer (+ r 6.0)]
              (msg (ptr i8) layer (sel c"setFrame:") [Rect]
                   (rect (- fx outer) (- fy outer) (* outer 2.0) (* outer 2.0)))
              (msg (ptr i8) layer (sel c"setCornerRadius:") [f64] outer)
              (msg (ptr i8) layer (sel c"setBackgroundColor:") [(ptr i8)] (.clear st))
              (msg (ptr i8) layer (sel c"setBorderColor:") [(ptr i8)] c)
              (msg (ptr i8) layer (sel c"setBorderWidth:") [f64] 3.0))
          (= kind 2)
            (do
              (msg (ptr i8) layer (sel c"setFrame:") [Rect]
                   (rect (- fx (* r 1.5)) (- fy (/ r 2.0)) (* r 3.0) r))
              (msg (ptr i8) layer (sel c"setCornerRadius:") [f64] 2.0)
              (msg (ptr i8) layer (sel c"setBorderWidth:") [f64] 0.0)
              (msg (ptr i8) layer (sel c"setBackgroundColor:") [(ptr i8)] c))
          :else
            (do
              (msg (ptr i8) layer (sel c"setFrame:") [Rect]
                   (rect (- fx r) (- fy r) (* r 2.0) (* r 2.0)))
              (msg (ptr i8) layer (sel c"setCornerRadius:") [f64] r)
              (msg (ptr i8) layer (sel c"setBorderWidth:") [f64] 0.0)
              (msg (ptr i8) layer (sel c"setBackgroundColor:") [(ptr i8)] c)))
        (CGColorRelease c)
        0)))

;;; Show the frame, then wait out the rest of a 60 Hz frame.
(defn window-end-frame! [] (-> i64)
  (let [st (state)]
    (msg (ptr i8) (class c"CATransaction") (sel c"commit") [])
    ; NSApplication is pumped by hand instead of entering -run. Commit updates
    ; the layer model; flush plus updateWindows puts it on screen now.
    (msg (ptr i8) (class c"CATransaction") (sel c"flush") [])
    (msg (ptr i8) (.app st) (sel c"updateWindows") [])
    (usleep 16667)
    0))
