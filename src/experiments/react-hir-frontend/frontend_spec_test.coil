(module experiments.react-hir-frontend.frontend-spec-test)

(import "experiments.react-hir-frontend.frontend-spec" :as spec)

(defn test-generated-terminals [] (-> i64)
  (assert-eq (spec/terminal-byte spec/lparen) (cast u8 40))
  (assert-eq (spec/terminal-byte spec/rbrace) (cast u8 125))
  (assert-eq (spec/terminal-byte 0) (cast u8 0))
  0)

(defn test-generated-operator-and-form-dispatch [] (-> i64)
  (assert-eq (spec/binary-precedence (cast u8 42) (cast u8 0) (cast u8 0)) 70)
  (assert-eq (spec/binary-precedence (cast u8 43) (cast u8 0) (cast u8 0)) 60)
  (assert-eq (spec/binary-precedence (cast u8 61) (cast u8 61) (cast u8 61)) 50)
  (assert-eq (spec/binary-width (cast u8 61) (cast u8 61) (cast u8 61)) 3)
  (assert-eq (spec/binary-precedence (cast u8 63) (cast u8 0) (cast u8 0)) 0)
  (assert-eq (spec/primary-form (cast u8 1) (cast u8 0)) spec/form-word)
  (assert-eq (spec/primary-form (cast u8 4) (cast u8 40)) spec/form-group)
  (assert-eq (spec/primary-form (cast u8 5) (cast u8 60)) spec/form-jsx)
  (assert-eq (spec/postfix-form (cast u8 4) (cast u8 40)) spec/form-call)
  (assert-eq (spec/postfix-form (cast u8 4) (cast u8 91)) spec/form-computed-member)
  0)

(defn test-generated-production-descriptors [] (-> i64)
  (assert-eq (spec/production-terminal spec/group-production 0) (cast u8 40))
  (assert-eq (spec/production-terminal spec/group-production 2) (cast u8 41))
  (assert-eq (spec/production-terminal spec/call-production 1) (cast u8 44))
  (assert-eq (spec/production-terminal spec/jsx-element-production 4) (cast u8 62))
  (assert-eq (spec/production-keyword spec/variable-production 0) "const")
  (assert-eq (spec/production-keyword spec/program-production 0) "")
  (assert-eq (spec/group-production-terminal 0) (cast u8 40))
  (assert-eq (spec/call-production-terminal 1) (cast u8 44))
  (assert-eq (spec/property-production-terminal 1) (cast u8 58))
  (assert-eq (spec/expression-statement-production-terminal 1) (cast u8 59))
  (assert-eq (spec/computed-member-production-terminal 2) (cast u8 93))
  (assert-eq (spec/jsx-element-production-terminal 4) (cast u8 62))
  (assert-eq (spec/variable-production-keyword 0) "const")
  (assert-eq (spec/let-production-keyword 0) "let")
  (assert-eq (spec/var-production-keyword 0) "var")
  0)

(defn main [] (-> i64)
  (test-generated-terminals)
  (test-generated-operator-and-form-dispatch)
  (test-generated-production-descriptors)
  0)
