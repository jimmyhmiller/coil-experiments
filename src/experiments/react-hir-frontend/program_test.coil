(module experiments.react-hir-frontend.program-test)

(import "coil.simd" :as v)
(import "coil.slice" :use [slice-data])
(import "experiments.react-hir-frontend.program"
  :use [def-classification-program])

;; Projection is decided by the metaprogram. Unselected channels become constant
;; zero and their dead classification graph is removable before machine code.
(def-classification-program classify-words-only [N bytes]
  [(alpha ascii-alpha)
   (digit ascii-digit)
   (word (or alpha digit (one-of 95 36)))
   (whitespace ascii-whitespace)
   (slash (byte 47))]
  [word])

(defn test-projection [] (-> i64)
  (let [text "a / 42"
        bytes (v/vload-partial [u8 (const 8)] (slice-data text) (len text)
                (v/vzero [u8 (const 8)]))
        classes (classify-words-only bytes (len text))]
    (assert-eq (.word classes) (cast u64 49))
    (assert-eq (.whitespace classes) (cast u64 0))
    (assert-eq (.operator classes) (cast u64 0))
    (assert-eq (.quote classes) (cast u64 0))
    (assert-eq (.single-quote classes) (cast u64 0))
    (assert-eq (.double-quote classes) (cast u64 0))
    (assert-eq (.slash classes) (cast u64 0))
    (assert-eq (.backtick classes) (cast u64 0))
    (assert-eq (.delimiter classes) (cast u64 0))
    (assert-eq (.jsx-marker classes) (cast u64 0)))
  0)

(defn main [] (-> i64)
  (test-projection)
  0)
