(module experiments.react-hir-frontend.lexical-test)

(import "coil.simd" :as v)
(import "coil.slice" :use [slice-data slice-get])
(import "experiments.react-hir-frontend.lexical" :as l)

(defn scan [N] [(text (slice u8)) (state l/LexicalState)] (-> l/LexicalChunk)
  (let [fill (v/vzero [u8 N])
        width (v/vlanes fill)
        count (cond (> (len text) width) width :else (len text))
        bytes (v/vload-partial [u8 N] (slice-data text) count fill)
        has-next (> (len text) count)
        next (if has-next (slice-get text count) (cast u8 0))]
    (l/classify-lexical bytes count next has-next state)))

(defn test-quotes-and-comments [] (-> i64)
  ;; 01234567890123456789012345678901
  ;; let s='//'; // c\nx
  (let [chunk (scan [(const 32)] "let s='//'; // c\nx" (l/lexical-initial-state))]
    (assert-eq (.string-bits chunk) (cast u64 960))
    (assert-eq (.comment-bits chunk) (cast u64 61440))
    (assert-eq (.newline-bits chunk) (cast u64 65536))
    (assert-eq (.code-bits chunk) (cast u64 199743))
    (assert-eq (.mode (.state chunk)) l/MODE-CODE))
  0)

(defn test-escaped-quote-across-chunks [] (-> i64)
  (let [first (scan [(const 4)] "\"a\\\"z\"" (l/lexical-initial-state))
        second (scan [(const 4)] "z\"" (.state first))]
    (assert-eq (.string-bits first) (cast u64 15))
    (assert-eq (.mode (.state first)) l/MODE-DOUBLE-QUOTE)
    (assert-eq (.escaped (.state first)) false)
    (assert-eq (.string-bits second) (cast u64 3))
    (assert-eq (.mode (.state second)) l/MODE-CODE))
  0)

(defn test-comment-open-and-close-boundaries [] (-> i64)
  (let [first (scan [(const 3)] "x/*a*/y" (l/lexical-initial-state))
        second (scan [(const 3)] "a*/y" (.state first))
        third (scan [(const 3)] "y" (.state second))]
    (assert-eq (.code-bits first) (cast u64 1))
    (assert-eq (.comment-bits first) (cast u64 6))
    (assert-eq (.mode (.state first)) l/MODE-BLOCK-COMMENT)
    (assert-eq (.comment-bits second) (cast u64 7))
    (assert-eq (.code-bits second) (cast u64 0))
    (assert-eq (.mode (.state second)) l/MODE-CODE)
    (assert-eq (.code-bits third) (cast u64 1)))
  0)

(defn test-slash-lookahead [] (-> i64)
  (let [chunk (scan [(const 2)] "x//tail" (l/lexical-initial-state))]
    (assert-eq (.code-bits chunk) (cast u64 1))
    (assert-eq (.comment-bits chunk) (cast u64 2))
    (assert-eq (.mode (.state chunk)) l/MODE-LINE-COMMENT))
  0)

(defn main [] (-> i64)
  (test-quotes-and-comments)
  (test-escaped-quote-across-chunks)
  (test-comment-open-and-close-boundaries)
  (test-slash-lookahead)
  0)
