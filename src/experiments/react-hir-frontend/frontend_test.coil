(module experiments.react-hir-frontend.frontend-test)

(import "coil.simd" :as v)
(import "coil.primitive" :as p)
(import "coil.slice" :use [slice-data slice-get])
(import "experiments.react-hir-frontend.frontend" :as f)
(import "experiments.react-hir-frontend.lexical" :as lex)

(defn scan [N] [(text (slice u8)) (state f/FrontendState)] (-> f/FrontendChunk)
  (let [fill (v/vzero [u8 N])
        width (v/vlanes fill)
        count (cond (> (len text) width) width :else (len text))
        bytes (v/vload-partial [u8 N] (slice-data text) count fill)
        has-next (> (len text) count)
        next (if has-next (slice-get text count) (cast u8 0))]
    (f/classify-frontend bytes count next has-next state)))

(defn test-shielding [] (-> i64)
  ;; Only x, =, ;, y are code-visible. The apparent identifier/operator inside
  ;; the string and the braces in the comment must not reach the grammar spine.
  (let [chunk (scan [(const 32)] "x='a+b';/*{}*/y" (f/frontend-initial-state))
        code (.code chunk)]
    (assert-eq (.word-bits code) (cast u64 16385))
    (assert-eq (.word-start-bits code) (cast u64 16385))
    (assert-eq (.operator-bits code) (cast u64 2))
    (assert-eq (.delimiter-bits code) (cast u64 128))
    (assert-eq (.jsx-marker-bits code) (cast u64 0))
    (assert-eq (.mode (.lexical (.state chunk))) lex/MODE-CODE))
  0)

(defn test-word-carry-ignores-comment [] (-> i64)
  (let [first (scan [(const 4)] "abc/*x*/d" (f/frontend-initial-state))
        second (scan [(const 8)] "*x*/d" (.state first))]
    (assert-eq (.previous-code-word (.state first)) false)
    (assert-eq (.word-bits (.code second)) (cast u64 16))
    (assert-eq (.word-start-bits (.code second)) (cast u64 16))
    (assert-eq (.previous-code-word (.state second)) true))
  0)

(defn test-pair32-matches-logical64 [] (-> i64)
  (let [text "const node = flag ? <X a={42}/> : 'text'; // tail\nnext"
        fill (v/vzero [u8 32])
        low (v/vload-partial [u8 32] (slice-data text) 32 fill)
        high-count (- (len text) 32)
        high (v/vload-partial [u8 32] (p/index (slice-data text) 32) high-count fill)
        pair (f/classify-frontend-pair32 low high (len text) (cast u8 0) false
               (f/frontend-initial-state))
        logical (scan [(const 64)] text (f/frontend-initial-state))]
    (assert-eq (.word-bits (.raw pair)) (.word-bits (.raw logical)))
    (assert-eq (.word-start-bits (.raw pair)) (.word-start-bits (.raw logical)))
    (assert-eq (.operator-bits (.raw pair)) (.operator-bits (.raw logical)))
    (assert-eq (.delimiter-bits (.raw pair)) (.delimiter-bits (.raw logical)))
    (assert-eq (.jsx-marker-bits (.raw pair)) (.jsx-marker-bits (.raw logical)))
    (assert-eq (.code-bits (.lexical pair)) (.code-bits (.lexical logical)))
    (assert-eq (.string-bits (.lexical pair)) (.string-bits (.lexical logical)))
    (assert-eq (.comment-bits (.lexical pair)) (.comment-bits (.lexical logical)))
    (assert-eq (.word-bits (.code pair)) (.word-bits (.code logical)))
    (assert-eq (.word-start-bits (.code pair)) (.word-start-bits (.code logical)))
    (assert-eq (.mode (.lexical (.state pair))) (.mode (.lexical (.state logical))))
    (assert-eq (.previous-code-word (.state pair))
               (.previous-code-word (.state logical))))
  0)

(defn main [] (-> i64)
  (test-shielding)
  (test-word-carry-ignores-comment)
  (test-pair32-matches-logical64)
  0)
