(module experiments.react-hir-frontend.structural)

(import "coil.simd" :as v)
(import "coil.primitive" :as p)
(import "experiments.react-hir-frontend.program"
  :use [ClassBits def-classification-program])

;; One whole classification graph. Entries may reference earlier entries, so
;; shared atoms such as slash/braces/angle brackets are compared exactly once.
(def-classification-program classify-js-classes [N bytes]
  [(alpha ascii-alpha)
   (digit ascii-digit)
   (underscore (byte 95))
   (dollar (byte 36))
   (word (or alpha digit underscore dollar))
   (whitespace ascii-whitespace)
   (slash (byte 47))
   (single-quote (byte 39))
   (double-quote (byte 34))
   (quote (or single-quote double-quote))
   (backtick (byte 96))
   (colon (byte 58))
   (less-than (byte 60))
   (greater-than (byte 62))
   (left-brace (byte 123))
   (right-brace (byte 125))
   (operator-extra (one-of 33 37 38 42 43 45 46 61 63 94 124 126))
   (operator (or operator-extra slash colon less-than greater-than))
   (delimiter-extra (one-of 40 41 44 59 91 93))
   (delimiter (or delimiter-extra colon left-brace right-brace))
   (jsx-marker (or slash less-than greater-than left-brace right-brace))]
  [word whitespace operator quote single-quote double-quote slash backtick delimiter jsx-marker])

;; This is the target-neutral structural tape input for later lexical/state
;; passes. Scalar bitmaps keep this boundary independent of vector width.
(defstruct StructuralChunk
  [(word-bits u64)
   (word-start-bits u64)
   (whitespace-bits u64)
   (punctuation-bits u64)
   (operator-bits u64)
   (operator-adjacent-bits u64)
   (quote-bits u64)
   (slash-bits u64)
   (backtick-bits u64)
   (delimiter-bits u64)
   (jsx-marker-bits u64)
   (next-word bool)])

(defn structural-from-classes
  [(classes ClassBits) (count i64) (previous-word bool)] (-> StructuralChunk)
  (let [valid (v/bits-low count)
        word (.word classes)
        whitespace (.whitespace classes)
        operator (.operator classes)
        prior (p/ior (p/ishl word (cast u64 1))
                     (if previous-word (cast u64 1) (cast u64 0)))
        word-start (p/iand word (p/iand (p/inot prior) valid))
        punctuation (p/iand valid (p/inot (p/ior word whitespace)))]
    (StructuralChunk
      :word-bits word
      :word-start-bits word-start
      :whitespace-bits whitespace
      :punctuation-bits punctuation
      :operator-bits operator
      :operator-adjacent-bits (p/iand operator (p/ishr operator (cast u64 1)))
      :quote-bits (.quote classes)
      :slash-bits (.slash classes)
      :backtick-bits (.backtick classes)
      :delimiter-bits (.delimiter classes)
      :jsx-marker-bits (.jsx-marker classes)
      :next-word (if (= count 0) previous-word
                   (!= (p/iand (p/ishr word (cast u64 (- count 1))) (cast u64 1))
                       (cast u64 0))))))

(defn classify-structural [N]
  [(bytes (vec u8 N)) (valid-count i64) (previous-word bool)] (-> StructuralChunk)
  (let [width (v/vlanes bytes)
        count (cond (< valid-count 0) 0 (> valid-count width) width :else valid-count)]
    (structural-from-classes (classify-js-classes bytes count) count previous-word)))
