(module experiments.react-hir-frontend.structural)

(import "coil.simd" :as v)
(import "coil.primitive" :as p)
(import "experiments.react-hir-frontend.dsl" :use [def-byte-class])

(def-byte-class js-word [N bytes]
  (or ascii-alpha ascii-digit (one-of 95 36)))

(def-byte-class js-operator [N bytes]
  (one-of 33 37 38 42 43 45 46 47 58 60 61 62 63 94 124 126))

(def-byte-class js-quote [N bytes] (one-of 34 39))
(def-byte-class js-slash [N bytes] (byte 47))
(def-byte-class js-backtick [N bytes] (byte 96))
(def-byte-class js-delimiter [N bytes]
  (one-of 40 41 44 58 59 91 93 123 125))
(def-byte-class js-jsx-marker [N bytes] (one-of 47 60 62 123 125))

;; This is the target-neutral structural tape input for later lexical/state
;; passes. Scalar bitmaps keep this boundary independent of vector width.
(defstruct StructuralChunk
  [(word-bits u64)
   (word-start-bits u64)
   (whitespace-bits u64)
   (punctuation-bits u64)
   (operator-bits u64)
   (operator-adjacent-bits u64)
   (quote-bits u64)
   (slash-bits u64)
   (backtick-bits u64)
   (delimiter-bits u64)
   (jsx-marker-bits u64)
   (next-word bool)])

(defn classify-structural [N]
  [(bytes (vec u8 N)) (valid-count i64) (previous-word bool)] (-> StructuralChunk)
  (let [width (v/vlanes bytes)
        count (cond (< valid-count 0) 0 (> valid-count width) width :else valid-count)
        valid (v/bits-low count)
        word-mask (js-word bytes)
        word (p/iand valid (v/mask->bits word-mask))
        whitespace (p/iand valid (v/mask->bits (v/ascii-whitespace? bytes)))
        operator (p/iand valid (v/mask->bits (js-operator bytes)))
        prior (p/ior (p/ishl word (cast u64 1))
                     (if previous-word (cast u64 1) (cast u64 0)))
        word-start (p/iand word (p/iand (p/inot prior) valid))
        punctuation (p/iand valid (p/inot (p/ior word whitespace)))]
    (StructuralChunk
      :word-bits word
      :word-start-bits word-start
      :whitespace-bits whitespace
      :punctuation-bits punctuation
      :operator-bits operator
      :operator-adjacent-bits (p/iand operator (p/ishr operator (cast u64 1)))
      :quote-bits (p/iand valid (v/mask->bits (js-quote bytes)))
      :slash-bits (p/iand valid (v/mask->bits (js-slash bytes)))
      :backtick-bits (p/iand valid (v/mask->bits (js-backtick bytes)))
      :delimiter-bits (p/iand valid (v/mask->bits (js-delimiter bytes)))
      :jsx-marker-bits (p/iand valid (v/mask->bits (js-jsx-marker bytes)))
      :next-word (if (= count 0) previous-word (v/vextract word-mask (- count 1))))))
