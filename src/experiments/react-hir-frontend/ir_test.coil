(module experiments.react-hir-frontend.ir-test)

(import "coil.primitive" :as p)
(import "coil.slice" :use [slice-data])
(import "experiments.react-hir-frontend.ir" :as ir)

(defn byte-eq? [(actual (ptr u8)) (expected (slice u8)) (count i64)] (-> bool)
  (if (!= count (len expected)) false
    (let [(mut i) 0 (mut same) true]
      (loop
        (if (or (>= (load i) count) (not (load same))) (break)
          (do
            (if (!= (load (p/index actual (load i)))
                    (load (p/index (slice-data expected) (load i))))
                (store! same false) 0)
            (set! i (+ (load i) 1)))))
      (load same))))

;; Builds an if/else diamond where %0 is the condition, %1/%2 are branch
;; results, and join block parameter %3 is the phi-equivalent.
(defn test-valid-diamond-and-printer [] (-> i64)
  (let [source "js.constjs.thenjs.else"
        region-parent (p/alloc-stack (array u32 1))
        region-first (p/alloc-stack (array u32 1))
        region-counts (p/alloc-stack (array u32 1))
        region-blocks (p/alloc-stack (array u32 4))
        block-regions (p/alloc-stack (array u32 4))
        block-first-params (p/alloc-stack (array u32 4))
        block-param-counts (p/alloc-stack (array u32 4))
        block-first-ops (p/alloc-stack (array u32 4))
        block-op-counts (p/alloc-stack (array u32 4))
        block-ops (p/alloc-stack (array u32 7))
        opcodes (p/alloc-stack (array u16 7))
        name-starts (p/alloc-stack (array u32 7))
        name-ends (p/alloc-stack (array u32 7))
        op-first-operands (p/alloc-stack (array u32 7))
        op-operand-counts (p/alloc-stack (array u32 7))
        op-first-results (p/alloc-stack (array u32 7))
        op-result-counts (p/alloc-stack (array u32 7))
        op-first-successors (p/alloc-stack (array u32 7))
        op-successor-counts (p/alloc-stack (array u32 7))
        op-first-regions (p/alloc-stack (array u32 7))
        op-region-counts (p/alloc-stack (array u32 7))
        op-regions (p/alloc-stack (array u32 1))
        op-starts (p/alloc-stack (array u32 7))
        op-ends (p/alloc-stack (array u32 7))
        op-immediates (p/alloc-stack (array u64 7))
        operands (p/alloc-stack (array u32 2))
        successor-blocks (p/alloc-stack (array u32 4))
        successor-first-args (p/alloc-stack (array u32 4))
        successor-arg-counts (p/alloc-stack (array u32 4))
        successor-args (p/alloc-stack (array u32 2))
        value-kinds (p/alloc-stack (array u8 4))
        value-defs (p/alloc-stack (array u32 4))
        empty-u32 (p/alloc-stack (array u32 1))
        arena-storage (p/alloc-stack ir/IrArena)
        dom (p/alloc-stack (array u64 4))
        scratch (p/alloc-stack ir/VerifyScratch)
        output (p/alloc-stack (array u8 1024))]
    (store! (p/index region-parent 0) ir/INVALID-ID)
    (store! (p/index region-first 0) (cast u32 0))
    (store! (p/index region-counts 0) (cast u32 4))
    (let [(mut i) 0]
      (loop
        (if (>= (load i) 4) (break)
          (do
            (store! (p/index region-blocks (load i)) (cast u32 (load i)))
            (set! i (+ (load i) 1))))))
    (let [(mut i) 0]
      (loop (if (>= (load i) 4) (break)
        (do (store! (p/index block-regions (load i)) (cast u32 0))
            (store! (p/index block-first-params (load i))
                    (if (= (load i) 3) (cast u32 3) (cast u32 0)))
            (store! (p/index block-param-counts (load i))
                    (if (= (load i) 3) (cast u32 1) (cast u32 0)))
            (set! i (+ (load i) 1))))))
    ;; block op ranges: [0,2), [2,4), [4,6), [6,7)
    (store! (p/index block-first-ops 0) (cast u32 0))
    (store! (p/index block-first-ops 1) (cast u32 2))
    (store! (p/index block-first-ops 2) (cast u32 4))
    (store! (p/index block-first-ops 3) (cast u32 6))
    (store! (p/index block-op-counts 0) (cast u32 2))
    (store! (p/index block-op-counts 1) (cast u32 2))
    (store! (p/index block-op-counts 2) (cast u32 2))
    (store! (p/index block-op-counts 3) (cast u32 1))
    ;; Physical op ids deliberately do not follow block order: block 1 uses
    ;; [2,4] and block 2 uses [3,5]. This proves nested/interleaved construction
    ;; does not depend on globally contiguous operation ids.
    (store! (p/index block-ops 0) (cast u32 0))
    (store! (p/index block-ops 1) (cast u32 1))
    (store! (p/index block-ops 2) (cast u32 2))
    (store! (p/index block-ops 3) (cast u32 4))
    (store! (p/index block-ops 4) (cast u32 3))
    (store! (p/index block-ops 5) (cast u32 5))
    (store! (p/index block-ops 6) (cast u32 6))
    ;; dialect const; cond_br; dialect then; dialect else; br; br; return
    (store! (p/index opcodes 0) ir/OP-DIALECT-BASE)
    (store! (p/index opcodes 1) ir/OP-COND-BR)
    (store! (p/index opcodes 2) ir/OP-DIALECT-BASE)
    (store! (p/index opcodes 3) ir/OP-DIALECT-BASE)
    (store! (p/index opcodes 4) ir/OP-BR)
    (store! (p/index opcodes 5) ir/OP-BR)
    (store! (p/index opcodes 6) ir/OP-RETURN)
    (let [(mut i) 0]
      (loop (if (>= (load i) 7) (break)
        (do
          (store! (p/index name-starts (load i)) (cast u32 0))
          (store! (p/index name-ends (load i)) (cast u32 8))
          (store! (p/index op-first-operands (load i)) (cast u32 0))
          (store! (p/index op-operand-counts (load i)) (cast u32 0))
          (store! (p/index op-first-results (load i)) (cast u32 0))
          (store! (p/index op-result-counts (load i)) (cast u32 0))
          (store! (p/index op-first-successors (load i)) (cast u32 0))
          (store! (p/index op-successor-counts (load i)) (cast u32 0))
          (store! (p/index op-first-regions (load i)) (cast u32 0))
          (store! (p/index op-region-counts (load i)) (cast u32 0))
          (store! (p/index op-starts (load i)) (cast u32 0))
          (store! (p/index op-ends (load i)) (cast u32 0))
          (set! i (+ (load i) 1))))))
    (store! (p/index name-starts 2) (cast u32 8))
    (store! (p/index name-ends 2) (cast u32 15))
    (store! (p/index name-starts 3) (cast u32 15))
    (store! (p/index name-ends 3) (cast u32 22))
    (store! (p/index op-first-results 0) (cast u32 0))
    (store! (p/index op-result-counts 0) (cast u32 1))
    (store! (p/index op-first-operands 1) (cast u32 0))
    (store! (p/index op-operand-counts 1) (cast u32 1))
    (store! (p/index operands 0) (cast u32 0))
    (store! (p/index op-first-successors 1) (cast u32 0))
    (store! (p/index op-successor-counts 1) (cast u32 2))
    (store! (p/index op-first-results 2) (cast u32 1))
    (store! (p/index op-result-counts 2) (cast u32 1))
    (store! (p/index op-first-successors 4) (cast u32 2))
    (store! (p/index op-successor-counts 4) (cast u32 1))
    (store! (p/index op-first-results 3) (cast u32 2))
    (store! (p/index op-result-counts 3) (cast u32 1))
    (store! (p/index op-first-successors 5) (cast u32 3))
    (store! (p/index op-successor-counts 5) (cast u32 1))
    (store! (p/index op-first-operands 6) (cast u32 1))
    (store! (p/index op-operand-counts 6) (cast u32 1))
    (store! (p/index operands 1) (cast u32 3))
    ;; cond branches carry no args; both join branches carry their result.
    (store! (p/index successor-blocks 0) (cast u32 1))
    (store! (p/index successor-blocks 1) (cast u32 2))
    (store! (p/index successor-blocks 2) (cast u32 3))
    (store! (p/index successor-blocks 3) (cast u32 3))
    (store! (p/index successor-first-args 0) (cast u32 0))
    (store! (p/index successor-first-args 1) (cast u32 0))
    (store! (p/index successor-first-args 2) (cast u32 0))
    (store! (p/index successor-first-args 3) (cast u32 1))
    (store! (p/index successor-arg-counts 0) (cast u32 0))
    (store! (p/index successor-arg-counts 1) (cast u32 0))
    (store! (p/index successor-arg-counts 2) (cast u32 1))
    (store! (p/index successor-arg-counts 3) (cast u32 1))
    (store! (p/index successor-args 0) (cast u32 1))
    (store! (p/index successor-args 1) (cast u32 2))
    ;; Dense values map to their defining op or block-parameter value index.
    (store! (p/index value-kinds 0) ir/DEF-OP-RESULT)
    (store! (p/index value-kinds 1) ir/DEF-OP-RESULT)
    (store! (p/index value-kinds 2) ir/DEF-OP-RESULT)
    (store! (p/index value-kinds 3) ir/DEF-BLOCK-PARAM)
    (store! (p/index value-defs 0) (cast u32 0))
    (store! (p/index value-defs 1) (cast u32 2))
    (store! (p/index value-defs 2) (cast u32 3))
    (store! (p/index value-defs 3) (cast u32 3))
    (store! arena-storage (ir/IrArena
      :source-size (cast u32 22)
      :region-parent-ops (p/cast (ptr u32) region-parent)
      :region-first-blocks (p/cast (ptr u32) region-first)
      :region-block-counts (p/cast (ptr u32) region-counts) :region-count (cast u32 1)
      :region-blocks (p/cast (ptr u32) region-blocks)
      :region-block-ref-count (cast u32 4)
      :block-regions (p/cast (ptr u32) block-regions)
      :block-first-params (p/cast (ptr u32) block-first-params)
      :block-param-counts (p/cast (ptr u32) block-param-counts)
      :block-first-ops (p/cast (ptr u32) block-first-ops)
      :block-op-counts (p/cast (ptr u32) block-op-counts) :block-count (cast u32 4)
      :block-ops (p/cast (ptr u32) block-ops) :block-op-ref-count (cast u32 7)
      :opcodes (p/cast (ptr u16) opcodes)
      :op-name-starts (p/cast (ptr u32) name-starts) :op-name-ends (p/cast (ptr u32) name-ends)
      :op-first-operands (p/cast (ptr u32) op-first-operands)
      :op-operand-counts (p/cast (ptr u32) op-operand-counts)
      :op-first-results (p/cast (ptr u32) op-first-results)
      :op-result-counts (p/cast (ptr u32) op-result-counts)
      :op-first-successors (p/cast (ptr u32) op-first-successors)
      :op-successor-counts (p/cast (ptr u32) op-successor-counts)
      :op-first-regions (p/cast (ptr u32) op-first-regions)
      :op-region-counts (p/cast (ptr u32) op-region-counts)
      :op-regions (p/cast (ptr u32) op-regions) :op-region-ref-count (cast u32 0)
      :op-starts (p/cast (ptr u32) op-starts) :op-ends (p/cast (ptr u32) op-ends)
      :op-immediates (p/cast (ptr u64) op-immediates)
      :op-count (cast u32 7)
      :operands (p/cast (ptr u32) operands) :operand-count (cast u32 2)
      :successor-blocks (p/cast (ptr u32) successor-blocks)
      :successor-first-args (p/cast (ptr u32) successor-first-args)
      :successor-arg-counts (p/cast (ptr u32) successor-arg-counts)
      :successor-count (cast u32 4) :successor-args (p/cast (ptr u32) successor-args)
      :successor-arg-count (cast u32 2)
      :value-def-kinds (p/cast (ptr u8) value-kinds)
      :value-def-indices (p/cast (ptr u32) value-defs) :value-count (cast u32 4)
      :scope-parents (p/cast (ptr u32) empty-u32)
      :scope-starts (p/cast (ptr u32) empty-u32) :scope-ends (p/cast (ptr u32) empty-u32)
      :scope-count (cast u32 0) :binding-scopes (p/cast (ptr u32) empty-u32)
      :binding-name-starts (p/cast (ptr u32) empty-u32)
      :binding-name-ends (p/cast (ptr u32) empty-u32) :binding-count (cast u32 0)
      :reference-bindings (p/cast (ptr u32) empty-u32)
      :reference-starts (p/cast (ptr u32) empty-u32)
      :reference-ends (p/cast (ptr u32) empty-u32) :reference-count (cast u32 0)
      :capture-scopes (p/cast (ptr u32) empty-u32)
      :capture-bindings (p/cast (ptr u32) empty-u32) :capture-count (cast u32 0)))
    (store! scratch (ir/VerifyScratch :dominators (p/cast (ptr u64) dom)
                                      :dominator-word-capacity 4))
    (let [verified (ir/verify-ir arena-storage scratch)]
      (assert-eq (.error verified) ir/VERIFY-OK))
    (let [printed (ir/print-ir! arena-storage (slice-data source)
                                (p/cast (ptr u8) output) 1024)
          expected "region 0 {\n^0():\n  %0 = js.const loc(0:0)\n  cf.cond_br %0, ^1(), ^2() loc(0:0)\n^1():\n  %1 = js.then loc(0:0)\n  cf.br ^3(%1) loc(0:0)\n^2():\n  %2 = js.else loc(0:0)\n  cf.br ^3(%2) loc(0:0)\n^3(%3):\n  js.return %3 loc(0:0)\n}\n"]
      (assert-eq (.error printed) ir/PRINT-OK)
      (assert (byte-eq? (p/cast (ptr u8) output) expected (.count printed))))
    ;; Corrupt one edge: join requires one block argument.
    (store! (p/index successor-arg-counts 2) (cast u32 0))
    (let [invalid (ir/verify-ir arena-storage scratch)]
      (assert-eq (.error invalid) ir/VERIFY-SUCCESSOR-ARITY))
    (store! (p/index successor-arg-counts 2) (cast u32 1))
    ;; Corrupt return to directly use a branch-local value that does not
    ;; dominate the join.
    (store! (p/index operands 1) (cast u32 1))
    (let [invalid (ir/verify-ir arena-storage scratch)]
      (assert-eq (.error invalid) ir/VERIFY-DOMINANCE)))
  0)

(defn main [] (-> i64)
  (test-valid-diamond-and-printer)
  0)
