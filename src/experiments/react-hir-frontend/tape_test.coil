(module experiments.react-hir-frontend.tape-test)

(import "coil.simd" :as v)
(import "coil.primitive" :as p)
(import "coil.slice" :use [slice-data])
(import "experiments.react-hir-frontend.frontend" :as frontend)
(import "experiments.react-hir-frontend.tape" :as tape)

(defn test-ordered-compaction [] (-> i64)
  (let [text "let x=42;"
        bytes (v/vload-partial [u8 (const 16)] (slice-data text) (len text)
                (v/vzero [u8 (const 16)]))
        chunk (frontend/classify-frontend bytes (len text) (cast u8 0) false
                (frontend/frontend-initial-state))
        positions (p/alloc-stack (array u32 8))
        kinds (p/alloc-stack (array u8 8))
        result (tape/write-structural-tape (.code chunk) (cast u32 100)
                 (p/cast (ptr u32) positions) (p/cast (ptr u8) kinds) 8)]
    (assert-eq (.count result) 5)
    (assert-eq (.complete result) true)
    (assert-eq (load (p/index positions 0)) (cast u32 100))
    (assert-eq (load (p/index positions 1)) (cast u32 104))
    (assert-eq (load (p/index positions 2)) (cast u32 105))
    (assert-eq (load (p/index positions 3)) (cast u32 106))
    (assert-eq (load (p/index positions 4)) (cast u32 108))
    (assert-eq (load (p/index kinds 0)) (cast u8 tape/EVENT-WORD))
    (assert-eq (load (p/index kinds 1)) (cast u8 tape/EVENT-WORD))
    (assert-eq (load (p/index kinds 2)) (cast u8 tape/EVENT-OPERATOR))
    (assert-eq (load (p/index kinds 3)) (cast u8 tape/EVENT-WORD))
    (assert-eq (load (p/index kinds 4)) (cast u8 tape/EVENT-DELIMITER)))
  0)

(defn test-capacity-is_lossless [] (-> i64)
  (let [text "a+b+c"
        bytes (v/vload-partial [u8 (const 8)] (slice-data text) (len text)
                (v/vzero [u8 (const 8)]))
        chunk (frontend/classify-frontend bytes (len text) (cast u8 0) false
                (frontend/frontend-initial-state))
        positions (p/alloc-stack (array u32 2))
        kinds (p/alloc-stack (array u8 2))
        result (tape/write-structural-tape (.code chunk) (cast u32 0)
                 (p/cast (ptr u32) positions) (p/cast (ptr u8) kinds) 2)]
    (assert-eq (.count result) 2)
    (assert-eq (.complete result) false)
    (assert (!= (.remaining result) (cast u64 0)))
    (assert-eq (load (p/index positions 0)) (cast u32 0))
    (assert-eq (load (p/index positions 1)) (cast u32 1)))
  0)

(defn main [] (-> i64)
  (test-ordered-compaction)
  (test-capacity-is_lossless)
  0)
