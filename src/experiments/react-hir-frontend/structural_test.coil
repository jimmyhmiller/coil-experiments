(module experiments.react-hir-frontend.structural-test)

(import "coil.simd" :as v)
(import "coil.primitive" :as p)
(import "coil.slice" :use [slice-data])
(import "experiments.react-hir-frontend.dsl" :use [def-byte-class])
(import "experiments.react-hir-frontend.structural" :as s)

(def-byte-class uppercase-nonspace [N bytes]
  (and (not ascii-whitespace) (range 65 90)))

;; Five entries crosses the DSL's compile-time threshold for two-table nibble
;; classification. The second half deliberately contains crossed high/low
;; nibbles that must not become false positives.
(def-byte-class sparse-five [N bytes]
  (one-of 33 50 67 84 101))

(defn classify-text [N] [(text (slice u8)) (previous-word bool)] (-> s/StructuralChunk)
  (let [fill (v/vzero [u8 N])
        bytes (v/vload-partial [u8 N] (slice-data text) (len text) fill)]
    (s/classify-structural bytes (len text) previous-word)))

(defn test-basic [] (-> i64)
  (let [chunk (classify-text [(const 16)] "let x=42;\n" false)]
    (assert-eq (.word-bits chunk) (cast u64 215))
    (assert-eq (.word-start-bits chunk) (cast u64 81))
    (assert-eq (.whitespace-bits chunk) (cast u64 520))
    (assert-eq (.punctuation-bits chunk) (cast u64 288))
    (assert-eq (.operator-bits chunk) (cast u64 32))
    (assert-eq (.operator-adjacent-bits chunk) (cast u64 0))
    (assert-eq (.delimiter-bits chunk) (cast u64 256))
    (assert-eq (.quote-bits chunk) (cast u64 0))
    (assert-eq (.slash-bits chunk) (cast u64 0))
    (assert-eq (.backtick-bits chunk) (cast u64 0))
    (assert-eq (.jsx-marker-bits chunk) (cast u64 0))
    (assert-eq (.next-word chunk) false))
  0)

(defn test-boundary-carry [] (-> i64)
  (let [chunk (classify-text [(const 3)] "abc" true)]
    (assert-eq (.word-bits chunk) (cast u64 7))
    (assert-eq (.word-start-bits chunk) (cast u64 0))
    (assert-eq (.next-word chunk) true))
  0)

(defn test-operator-runs [] (-> i64)
  (let [chunk (classify-text [(const 8)] "a===b" false)]
    (assert-eq (.operator-bits chunk) (cast u64 14))
    (assert-eq (.operator-adjacent-bits chunk) (cast u64 6)))
  0)

(defn test-dsl-composition [] (-> i64)
  (let [text "Az Z"
        bytes (v/vload-partial [u8 (const 8)] (slice-data text) (len text)
                (v/vzero [u8 (const 8)]))]
    (assert-eq (v/mask->bits (uppercase-nonspace bytes)) (cast u64 9)))
  0)

(defn test-empty-preserves-carry [] (-> i64)
  (let [chunk (classify-text [(const 16)] "" true)]
    (assert-eq (.word-bits chunk) (cast u64 0))
    (assert-eq (.word-start-bits chunk) (cast u64 0))
    (assert-eq (.next-word chunk) true))
  0)

(defn test-nibble-table-specialization [] (-> i64)
  (let [text "!2CTe\"1DSd"
        bytes (v/vload-partial [u8 (const 16)] (slice-data text) (len text)
                (v/vzero [u8 (const 16)]))]
    (assert-eq (v/mask->bits (sparse-five bytes)) (cast u64 31)))
  0)

(defn main [] (-> i64)
  (test-basic)
  (test-boundary-carry)
  (test-operator-runs)
  (test-dsl-composition)
  (test-empty-preserves-carry)
  (test-nibble-table-specialization)
  0)
