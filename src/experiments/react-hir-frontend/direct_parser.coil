   (binary-info spec/binary-info)
   (parse-property parse-property!)
   (parse-object-shorthand parse-object-shorthand!)
   (parse-member parse-member!)
   (parse-computed-member parse-computed-member!)
   (parse-non-null parse-non-null!)
   (parse-postfix-update-lookahead parse-postfix-update-lookahead!)
   (parse-postfix-update parse-postfix-update!)
   (parse-call parse-call!)
   (parse-type-arguments parse-type-arguments!)
   (parse-type-arguments-before-call parse-type-arguments-before-call!)
   (parse-arrow-lookahead parse-arrow-lookahead!)
   (parse-binding-pattern parse-binding-pattern!)
   (parse-type-binding-pattern parse-type-binding-pattern!)
   (parse-class-parameter parse-class-parameter!)
   (parse-decorated-parameter parse-decorated-parameter!)
   (parse-arrow parse-arrow!)
