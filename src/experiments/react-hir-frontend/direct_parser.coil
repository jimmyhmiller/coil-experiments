(module experiments.react-hir-frontend.direct-parser)

(import "coil.primitive" :as p)
(import "coil.slice" :use [slice-data])
(import "experiments.react-hir-frontend.tape" :as tape)
(import "experiments.react-hir-frontend.frontend-spec" :as spec)
(import "experiments.react-hir-frontend.parser-generator" :as parser-generator)
(import "experiments.react-hir-frontend.ir" :as ir)
(import "experiments.react-hir-frontend.ir-builder" :as builder)

(const DIRECT-PARSE-OK i64 0)
(const DIRECT-PARSE-UNEXPECTED i64 1)
(const DIRECT-PARSE-EXPECTED i64 2)
(const DIRECT-PARSE-BUILDER i64 3)
(const DIRECT-PARSE-AFTER-TERMINATOR i64 4)
(const DIRECT-PARSE-SCRATCH-CAPACITY i64 5)

(defstruct DirectParserScratch
  [(values (ptr u32)) (value-capacity i64) (value-count i64)])

(defstruct DirectParseState
  [(source (ptr u8)) (source-size i64)
   (events (ptr u32)) (event-count i64) (event-index i64)
   (builder (ptr builder/IrBuilder))
   (scratch (ptr DirectParserScratch))
   (block u32) (scope u32) (function-scope u32)
   (error i64) (error-offset u32) (terminated bool)])

(defstruct ExprResult [(value u32) (start u32) (end u32)])

(defstruct DirectParseResult
  [(error i64) (error-offset u32) (consumed-events i64)
   (root-region u32) (root-block u32)])

(defn event-position [(event u32)] (-> u32)
  (cast u32 (p/ishr (cast u64 event) (cast u64 3))))

(defn event-kind [(event u32)] (-> u8)
  (cast u8 (p/iand (cast u64 event) (cast u64 7))))

(defn current-event [(state (ptr DirectParseState))] (-> u32)
  (if (>= (.event-index state) (.event-count state)) (cast u32 0)
    (load (p/index (.events state) (.event-index state)))))

(defn current-position [(state (ptr DirectParseState))] (-> u32)
  (if (>= (.event-index state) (.event-count state)) (cast u32 (.source-size state))
    (event-position (current-event state))))

(defn source-byte [(state (ptr DirectParseState)) (position u32)] (-> u8)
  (if (>= (cast i64 position) (.source-size state)) (cast u8 0)
    (load (p/index (.source state) (cast i64 position)))))

(defn current-byte [(state (ptr DirectParseState))] (-> u8)
  (source-byte state (current-position state)))

(defn adjacent-event-byte [(state (ptr DirectParseState)) (distance i64)] (-> u8)
  (let [index (+ (.event-index state) distance)]
    (if (>= index (.event-count state)) (cast u8 0)
      (let [position (event-position (load (p/index (.events state) index)))]
        (if (= position (+ (current-position state) (cast u32 distance)))
            (source-byte state position) (cast u8 0))))))

(defn advance! [(state (ptr DirectParseState))] (-> i64)
  (if (< (.event-index state) (.event-count state))
      (set! (.event-index state) (+ (.event-index state) 1)) 0)
  0)

(defn advance-count! [(state (ptr DirectParseState)) (count i64)] (-> i64)
  (let [(mut i) 0]
    (loop
      (if (>= (load i) count) (break)
        (do (advance! state) (set! i (+ (load i) 1)))))
    0))

(defn fail! [(state (ptr DirectParseState)) (error i64)] (-> ExprResult)
  (if (= (.error state) DIRECT-PARSE-OK)
      (do (set! (.error state) error)
          (set! (.error-offset state) (current-position state))) 0)
  (ExprResult :value (cast u32 ir/INVALID-ID)
              :start (current-position state) :end (current-position state)))

(defn check-build! [(state (ptr DirectParseState)) (result builder/BuildResult)] (-> u32)
  (if (= (.error result) builder/BUILD-OK) (.id result)
    (do (fail! state DIRECT-PARSE-BUILDER) (cast u32 ir/INVALID-ID))))

(defn push-scratch-value! [(state (ptr DirectParseState)) (value u32)] (-> i64)
  (let [scratch (.scratch state)]
    (if (>= (.value-count scratch) (.value-capacity scratch))
        (do (fail! state DIRECT-PARSE-SCRATCH-CAPACITY) 0)
      (do
        (store! (p/index (.values scratch) (.value-count scratch)) value)
        (set! (.value-count scratch) (+ (.value-count scratch) 1)))))
  0)

(defn emit-scratch-list-op! :inline (Always)
  [(state (ptr DirectParseState)) (opcode u16)
                             (start u32) (end u32) (mark i64)] (-> ExprResult)
  (let [scratch (.scratch state) arena (.arena (.builder state))
        value (.value-count arena)
        operation-result (builder/add-op! (.builder state) (.block state)
                           opcode (cast u32 0) (cast u32 0) start end (cast u32 1))]
    (let [op (check-build! state operation-result) (mut index) mark]
      (loop
        (if (>= (load index) (.value-count scratch)) (break)
          (let [operand (builder/add-operand! (.builder state) op
                          (load (p/index (.values scratch) (load index))))]
            (check-build! state operand)
            (set! index (+ (load index) 1)))))
      (set! (.value-count scratch) mark)
      (ExprResult :value value :start start :end end))))

(parser-generator/define-frontend-parser
  [DirectParseState ExprResult current-position current-byte advance! consume-byte! fail!
   parse-expression! push-scratch-value! emit-scratch-list-op! DIRECT-PARSE-OK
   DIRECT-PARSE-EXPECTED parse-array-generated!])

(defn ascii-word? [(byte u8)] (-> bool)
  (or (and (>= byte (cast u8 48)) (<= byte (cast u8 57)))
      (and (>= byte (cast u8 65)) (<= byte (cast u8 90)))
      (and (>= byte (cast u8 97)) (<= byte (cast u8 122)))
      (= byte (cast u8 95)) (= byte (cast u8 36))))

(defn word-end [(state (ptr DirectParseState)) (start u32)] (-> u32)
  (let [(mut at) (cast i64 start)]
    (loop
      (if (or (>= (load at) (.source-size state))
              (not (ascii-word? (load (p/index (.source state) (load at))))))
          (break) (set! at (+ (load at) 1))))
    (cast u32 (load at))))

(defn span-equals? [(state (ptr DirectParseState)) (start u32) (end u32)
                    (text (slice u8))] (-> bool)
  (if (!= (- (cast i64 end) (cast i64 start)) (len text)) false
    (let [(mut i) 0 (mut same) true]
      (loop
        (if (or (>= (load i) (len text)) (not (load same))) (break)
          (do
            (if (!= (source-byte state (+ start (cast u32 (load i))))
                    (load (p/index (slice-data text) (load i))))
                (store! same false) 0)
            (set! i (+ (load i) 1)))))
      (load same))))

(defn consume-byte! [(state (ptr DirectParseState)) (expected u8)] (-> bool)
  (if (and (< (.event-index state) (.event-count state))
           (= (current-byte state) expected))
      (do (advance! state) true)
    (do (fail! state DIRECT-PARSE-EXPECTED) false)))

(defn find-binding [(state (ptr DirectParseState)) (start u32) (end u32)] (-> u32)
  (let [arena (.arena (.builder state))
        (mut index) (.binding-count arena)
        (mut found) (cast u32 ir/INVALID-ID)]
    (loop
      (if (or (= (load index) (cast u32 0))
              (!= (load found) (cast u32 ir/INVALID-ID))) (break)
        (do
          (set! index (- (load index) (cast u32 1)))
          (let [candidate-start (load (p/index (.binding-name-starts arena)
                                                (cast i64 (load index))))
                candidate-end (load (p/index (.binding-name-ends arena)
                                              (cast i64 (load index))))
                candidate-scope (load (p/index (.binding-scopes arena)
                                                (cast i64 (load index))))]
            (if (and (ir/scope-ancestor? arena candidate-scope (.scope state))
                     (= (- end start) (- candidate-end candidate-start))
                     (let [(mut i) (cast u32 0) (mut same) true]
                       (loop
                         (if (or (>= (load i) (- end start)) (not (load same))) (break)
                           (do
                             (if (!= (source-byte state (+ start (load i)))
                                     (source-byte state (+ candidate-start (load i))))
                                 (store! same false) 0)
                             (set! i (+ (load i) (cast u32 1))))))
                       (load same)))
                (store! found (load index)) 0)))))
    (load found)))

(defn ensure-capture! [(state (ptr DirectParseState)) (binding u32)] (-> i64)
  (let [arena (.arena (.builder state)) scope (.function-scope state)
        binding-scope (load (p/index (.binding-scopes arena) (cast i64 binding)))]
    (if (ir/scope-ancestor? arena scope binding-scope) 0
      (let [(mut capture) (cast u32 0) (mut found) false]
        (loop
          (if (or (>= (load capture) (.capture-count arena)) (load found)) (break)
            (do
              (if (and (= (load (p/index (.capture-scopes arena)
                                         (cast i64 (load capture)))) scope)
                       (= (load (p/index (.capture-bindings arena)
                                         (cast i64 (load capture)))) binding))
                  (store! found true) 0)
              (set! capture (+ (load capture) (cast u32 1))))))
        (if (not (load found))
            (let [result (builder/add-capture! (.builder state) scope binding)]
              (check-build! state result)) 0))))
  0)

(defn emit-value-op! [(state (ptr DirectParseState)) (opcode u16)
                      (start u32) (end u32)] (-> ExprResult)
  (let [arena (.arena (.builder state)) value (.value-count arena)
        operation (builder/add-op! (.builder state) (.block state) opcode
                                   start end start end (cast u32 1))]
    (check-build! state operation)
    (ExprResult :value value :start start :end end)))

(defn parse-word! [(state (ptr DirectParseState))] (-> ExprResult)
  (if (or (>= (.event-index state) (.event-count state))
          (!= (event-kind (current-event state)) (cast u8 tape/EVENT-WORD)))
      (fail! state DIRECT-PARSE-UNEXPECTED)
    (let [start (current-position state) end (word-end state start)
          first (source-byte state start)]
      (advance! state)
      (if (and (>= first (cast u8 48)) (<= first (cast u8 57)))
          (emit-value-op! state ir/OP-JS-NUMBER start end)
        (let [result (emit-value-op! state ir/OP-JS-IDENTIFIER start end)
              binding (find-binding state start end)]
          (if (!= binding (cast u32 ir/INVALID-ID))
              (let [reference (builder/add-reference! (.builder state) binding start end)]
                (check-build! state reference)
                (ensure-capture! state binding)) 0)
          result)))))

(defn parse-string! [(state (ptr DirectParseState))] (-> ExprResult)
  (let [start (current-position state) quote (current-byte state)
        (mut at) (+ (cast i64 start) 1) (mut escaped) false (mut closed) false]
    (loop
      (if (or (>= (load at) (.source-size state)) (load closed)) (break)
        (let [byte (load (p/index (.source state) (load at)))]
          (cond (load escaped) (store! escaped false)
                (= byte (cast u8 92)) (store! escaped true)
                (= byte quote) (store! closed true)
                :else 0)
          (set! at (+ (load at) 1)))))
    (if (not (load closed)) (fail! state DIRECT-PARSE-EXPECTED)
      (do
        (loop
          (if (or (>= (.event-index state) (.event-count state))
                  (>= (cast i64 (current-position state)) (load at))) (break)
            (advance! state)))
        (emit-value-op! state ir/OP-JS-STRING start (cast u32 (load at)))))))

(defn parse-primary! [(state (ptr DirectParseState))] (-> ExprResult)
  (if (>= (.event-index state) (.event-count state))
      (fail! state DIRECT-PARSE-UNEXPECTED)
    (let [form (spec/primary-form (event-kind (current-event state)) (current-byte state))]
      (cond
        (= form spec/form-word) (parse-word! state)
        (= form spec/form-string) (parse-string! state)
        (= form spec/form-group)
          (do
            (advance! state)
            (let [value (parse-expression! state 0)]
              (if (consume-byte! state (spec/group-production-terminal 2)) value
                (fail! state DIRECT-PARSE-EXPECTED))))
        (or (= form spec/form-unary-bang)
            (= form spec/form-unary-minus)
            (= form spec/form-unary-plus))
          (let [start (current-position state) operator (current-byte state)
                _advance (advance! state) argument (parse-expression! state 70)
                arena (.arena (.builder state)) value (.value-count arena)
                operation-result (builder/add-op! (.builder state) (.block state)
                                   ir/OP-JS-UNARY (cast u32 0) (cast u32 0)
                                   start (.end argument) (cast u32 1))]
            (let [op (check-build! state operation-result)
                  operand (builder/add-operand! (.builder state) op (.value argument))
                  immediate (builder/set-op-immediate! (.builder state) op
                                                       (cast u64 operator))]
              (check-build! state operand)
              (check-build! state immediate)
              (ExprResult :value value :start start :end (.end argument))))
        (= form spec/form-array) (parse-array-generated! state)
        (= form spec/form-object) (parse-object! state)
        :else (fail! state DIRECT-PARSE-UNEXPECTED)))))

(defn parse-property! [(state (ptr DirectParseState))] (-> ExprResult)
  (let [name-start (current-position state) name-end (word-end state name-start)]
    (if (= name-start name-end) (fail! state DIRECT-PARSE-EXPECTED)
      (do
        (advance! state)
        (if (not (consume-byte! state (spec/property-production-terminal 1)))
            (fail! state DIRECT-PARSE-EXPECTED)
          (let [property-value (parse-expression! state 0)
                arena (.arena (.builder state)) value (.value-count arena)
                operation-result (builder/add-op! (.builder state) (.block state)
                                   ir/OP-JS-PROPERTY name-start name-end
                                   name-start (.end property-value) (cast u32 1))]
            (let [op (check-build! state operation-result)
                  operand (builder/add-operand! (.builder state) op
                                                (.value property-value))]
              (check-build! state operand)
              (ExprResult :value value :start name-start :end (.end property-value)))))))))

(defn parse-object! [(state (ptr DirectParseState))] (-> ExprResult)
  (let [scratch (.scratch state) mark (.value-count scratch)
        start (current-position state) _open (advance! state)]
    (if (= (current-byte state) (spec/object-production-terminal 2)) 0
      (loop
        (let [property (parse-property! state)]
          (push-scratch-value! state (.value property))
          (if (!= (.error state) DIRECT-PARSE-OK) (break)
            (if (= (current-byte state) (spec/object-production-terminal 1))
                (advance! state) (break))))))
    (let [end-position (current-position state)]
      (if (not (consume-byte! state (spec/object-production-terminal 2)))
          (fail! state DIRECT-PARSE-EXPECTED)
        (let [arena (.arena (.builder state)) value (.value-count arena)
              operation-result (builder/add-op! (.builder state) (.block state)
                                 ir/OP-JS-OBJECT (cast u32 0) (cast u32 0)
                                 start (+ end-position (cast u32 1)) (cast u32 1))]
          (let [op (check-build! state operation-result) (mut index) mark]
            (loop
              (if (>= (load index) (.value-count scratch)) (break)
                (let [operand (builder/add-operand! (.builder state) op
                                (load (p/index (.values scratch) (load index))))]
                  (check-build! state operand)
                  (set! index (+ (load index) 1)))))
            (set! (.value-count scratch) mark)
            (ExprResult :value value :start start
                        :end (+ end-position (cast u32 1)))))))))

(defn parse-call! [(state (ptr DirectParseState)) (callee ExprResult)] (-> ExprResult)
  (let [scratch (.scratch state) mark (.value-count scratch) _open (advance! state)]
    (if (= (current-byte state) (spec/call-production-terminal 2)) 0
      (loop
        (let [argument (parse-expression! state 0)]
          (push-scratch-value! state (.value argument))
          (if (!= (.error state) DIRECT-PARSE-OK) (break)
            (if (= (current-byte state) (spec/call-production-terminal 1))
                (advance! state) (break))))))
    (let [end-position (current-position state)]
      (if (not (consume-byte! state (spec/call-production-terminal 2)))
          (fail! state DIRECT-PARSE-EXPECTED)
        (let [arena (.arena (.builder state)) value (.value-count arena)
              operation-result (builder/add-op! (.builder state) (.block state)
                                 ir/OP-JS-CALL (cast u32 0) (cast u32 0)
                                 (.start callee) (+ end-position (cast u32 1))
                                 (cast u32 1))]
          (let [op (check-build! state operation-result)
                callee-operand (builder/add-operand! (.builder state) op (.value callee))]
            (check-build! state callee-operand)
            (let [(mut index) mark]
              (loop
                (if (>= (load index) (.value-count scratch)) (break)
                  (let [operand (builder/add-operand! (.builder state) op
                                  (load (p/index (.values scratch) (load index))))]
                    (check-build! state operand)
                    (set! index (+ (load index) 1))))))
            (set! (.value-count scratch) mark)
            (ExprResult :value value :start (.start callee)
                        :end (+ end-position (cast u32 1)))))))))

(defn parse-member! [(state (ptr DirectParseState)) (object ExprResult)] (-> ExprResult)
  (let [_dot (advance! state) name-start (current-position state)
        name-end (word-end state name-start)]
    (if (= name-start name-end) (fail! state DIRECT-PARSE-EXPECTED)
      (do
        (advance! state)
        (let [arena (.arena (.builder state)) value (.value-count arena)
              operation-result (builder/add-op! (.builder state) (.block state)
                                 ir/OP-JS-MEMBER name-start name-end
                                 (.start object) name-end (cast u32 1))]
          (let [op (check-build! state operation-result)
                operand (builder/add-operand! (.builder state) op (.value object))]
            (check-build! state operand)
            (ExprResult :value value :start (.start object) :end name-end)))))))

(defn parse-postfix! [(state (ptr DirectParseState))] (-> ExprResult)
  (let [(mut value) (parse-primary! state)]
    (loop
      (let [form (spec/postfix-form
                   (if (< (.event-index state) (.event-count state))
                       (event-kind (current-event state)) (cast u8 0))
                   (current-byte state))]
        (if (!= (.error state) DIRECT-PARSE-OK) (break)
          (cond
            (= form spec/form-call) (store! value (parse-call! state (load value)))
            (= form spec/form-member) (store! value (parse-member! state (load value)))
            :else (break)))))
    (load value)))

(defn parse-expression! [(state (ptr DirectParseState)) (minimum i64)] (-> ExprResult)
  (let [(mut left) (parse-postfix! state)]
    (loop
      (let [byte0 (current-byte state)
            lookahead (spec/binary-lookahead byte0)
            byte1 (if (> lookahead 1) (adjacent-event-byte state 1) (cast u8 0))
            byte2 (if (> lookahead 2) (adjacent-event-byte state 2) (cast u8 0))
            info (if (= (.error state) DIRECT-PARSE-OK)
                     (spec/binary-info byte0 byte1 byte2) 0)
            precedence (/ info 256)]
        (if (or (= precedence 0) (< precedence minimum)) (break)
          (let [width (% info 256)
                immediate (p/ior (cast u64 byte0)
                            (p/ior (p/ishl (cast u64 byte1) (cast u64 8))
                                   (p/ishl (cast u64 byte2) (cast u64 16))))]
            (advance-count! state width)
            (let [right (parse-expression! state (+ precedence 1))
                  old-left (load left)
                  arena (.arena (.builder state)) value (.value-count arena)
                  operation (builder/add-op! (.builder state) (.block state) ir/OP-JS-BINARY
                                             (cast u32 0) (cast u32 0)
                                             (.start old-left) (.end right) (cast u32 1))]
              (let [op (check-build! state operation)
                    lhs (builder/add-operand! (.builder state) op (.value old-left))
                    rhs (builder/add-operand! (.builder state) op (.value right))
                    imm (builder/set-op-immediate! (.builder state) op immediate)]
                (check-build! state lhs)
                (check-build! state rhs)
                (check-build! state imm)
                (store! left (ExprResult :value value :start (.start old-left) :end (.end right)))))))))
    (let [completed
            (if (and (<= minimum 10) (= (.error state) DIRECT-PARSE-OK)
                     (= (current-byte state) (spec/conditional-production-terminal 0)))
                (let [condition (load left) origin (.block state)
                      arena (.arena (.builder state))
                      region (load (p/index (.block-regions arena) (cast i64 origin)))
                      _question (advance! state)
                      then-result (builder/add-block! (.builder state) region)
                      then-block (check-build! state then-result)
                      else-result (builder/add-block! (.builder state) region)
                      else-block (check-build! state else-result)
                      branch-result (builder/add-op! (.builder state) origin ir/OP-COND-BR
                                                     (cast u32 0) (cast u32 0)
                                                     (.start condition) (current-position state)
                                                     (cast u32 0))]
                  (let [branch (check-build! state branch-result)
                        operand (builder/add-operand! (.builder state) branch (.value condition))
                        then-successor (builder/add-successor! (.builder state) branch then-block)
                        else-successor (builder/add-successor! (.builder state) branch else-block)]
                    (check-build! state operand)
                    (check-build! state then-successor)
                    (check-build! state else-successor))
                  (set! (.block state) then-block)
                  (let [consequent (parse-expression! state 0) then-exit (.block state)]
                    (if (consume-byte! state (spec/conditional-production-terminal 2))
                        (do
                          (set! (.block state) else-block)
                          (let [alternate (parse-expression! state 10)
                                else-exit (.block state)
                                join-result (builder/add-block! (.builder state) region)
                                join-block (check-build! state join-result)
                                parameter-result
                                  (builder/add-block-param! (.builder state) join-block)
                                parameter (check-build! state parameter-result)]
                            (emit-branch-arg! state then-exit join-block (.value consequent))
                            (emit-branch-arg! state else-exit join-block (.value alternate))
                            (set! (.block state) join-block)
                            (let [result (p/alloc-stack ExprResult)]
                              (store! result
                                (ExprResult :value parameter :start (.start condition)
                                            :end (.end alternate)))
                              (load result))))
                      (fail! state DIRECT-PARSE-EXPECTED))))
              (load left))]
      (if (and (<= minimum 5) (= (.error state) DIRECT-PARSE-OK)
               (= (current-byte state) (spec/assignment-production-terminal 1))
               (!= (adjacent-event-byte state 1)
                   (spec/assignment-production-terminal 1)))
          (let [left-value (load completed) _equals (advance! state)
                right (parse-expression! state 0)
                arena (.arena (.builder state)) value (.value-count arena)
                operation-result (builder/add-op! (.builder state) (.block state)
                                   ir/OP-JS-ASSIGN (cast u32 0) (cast u32 0)
                                   (.start left-value) (.end right) (cast u32 1))]
            (let [op (check-build! state operation-result)
                  lhs (builder/add-operand! (.builder state) op (.value left-value))
                  rhs (builder/add-operand! (.builder state) op (.value right))
                  immediate (builder/set-op-immediate! (.builder state) op (cast u64 61))]
              (check-build! state lhs)
              (check-build! state rhs)
              (check-build! state immediate)
              (ExprResult :value value :start (.start left-value) :end (.end right))))
        (load completed)))))

(defn emit-branch-arg! [(state (ptr DirectParseState)) (block u32)
                        (target u32) (value u32)] (-> i64)
  (let [position (current-position state)
        operation (builder/add-op! (.builder state) block ir/OP-BR
                                   (cast u32 0) (cast u32 0)
                                   position position (cast u32 0))]
    (let [op (check-build! state operation)
          successor-result (builder/add-successor! (.builder state) op target)
          successor (check-build! state successor-result)
          argument (builder/add-successor-arg! (.builder state) successor value)]
      (check-build! state argument)))
  0)

(defn current-keyword? [(state (ptr DirectParseState)) (keyword (slice u8))] (-> bool)
  (if (or (>= (.event-index state) (.event-count state))
          (!= (event-kind (current-event state)) (cast u8 tape/EVENT-WORD))) false
    (let [start (current-position state)]
      (span-equals? state start (word-end state start) keyword))))

(defn parse-declaration! [(state (ptr DirectParseState))] (-> i64)
  (let [start (current-position state) keyword-end (word-end state start)
        declaration-kind
          (if (span-equals? state start keyword-end (spec/variable-production-keyword 0))
              ir/DECL-CONST
            (if (span-equals? state start keyword-end (spec/let-production-keyword 0))
                ir/DECL-LET ir/DECL-VAR))]
    (advance! state)
    (let [name-start (current-position state) name-end (word-end state name-start)]
      (if (= name-start name-end) (do (fail! state DIRECT-PARSE-EXPECTED) 0)
        (do
          (advance! state)
          (let [binding (builder/add-binding! (.builder state) (.scope state)
                                              name-start name-end)]
            (check-build! state binding))
          (if (consume-byte! state (spec/variable-production-terminal 2))
              (let [value (parse-expression! state 0) end-position (current-position state)]
                (if (consume-byte! state (spec/variable-production-terminal 4))
                    (let [operation (builder/add-op! (.builder state) (.block state)
                                      ir/OP-JS-DECLARE name-start name-end start
                                      (+ end-position (cast u32 1)) (cast u32 0))]
                      (let [op (check-build! state operation)
                            operand (builder/add-operand! (.builder state) op (.value value))
                            kind-result (builder/set-op-immediate! (.builder state) op
                                                                   declaration-kind)]
                        (check-build! state operand)
                        (check-build! state kind-result))) 0)) 0)))))
  0)

(defn parse-return! [(state (ptr DirectParseState))] (-> i64)
  (let [start (current-position state) _keyword (advance! state)
        value (parse-expression! state 0) end-position (current-position state)]
    (if (consume-byte! state (spec/return-production-terminal 2))
        (let [operation (builder/add-op! (.builder state) (.block state) ir/OP-RETURN
                                         (cast u32 0) (cast u32 0) start
                                         (+ end-position (cast u32 1)) (cast u32 0))]
          (let [op (check-build! state operation)
                operand (builder/add-operand! (.builder state) op (.value value))]
            (check-build! state operand)
            (set! (.terminated state) true))) 0))
  0)

(defn parse-expression-statement! [(state (ptr DirectParseState))] (-> i64)
  (let [value (parse-expression! state 0) end-position (current-position state)]
    (if (consume-byte! state (spec/expression-statement-production-terminal 1))
        (let [operation (builder/add-op! (.builder state) (.block state) ir/OP-JS-EXPRESSION
                                         (cast u32 0) (cast u32 0) (.start value)
                                         (+ end-position (cast u32 1)) (cast u32 0))]
          (let [op (check-build! state operation)
                operand (builder/add-operand! (.builder state) op (.value value))]
            (check-build! state operand))) 0))
  0)

(defn emit-branch! [(state (ptr DirectParseState)) (block u32) (target u32)] (-> i64)
  (let [position (current-position state)
        operation (builder/add-op! (.builder state) block ir/OP-BR
                                   (cast u32 0) (cast u32 0)
                                   position position (cast u32 0))]
    (let [op (check-build! state operation)
          successor (builder/add-successor! (.builder state) op target)]
      (check-build! state successor)))
  0)

(defn parse-block! [(state (ptr DirectParseState))] (-> i64)
  (let [start (current-position state) parent-scope (.scope state)]
    (if (consume-byte! state (spec/block-production-terminal 0))
        (let [scope-result (builder/add-scope! (.builder state) parent-scope start
                                               (cast u32 (.source-size state)))
              scope (check-build! state scope-result)]
          (set! (.scope state) scope)
          (loop
            (if (or (!= (.error state) DIRECT-PARSE-OK)
                    (>= (.event-index state) (.event-count state))
                    (= (current-byte state) (spec/block-production-terminal 2))) (break)
              (if (.terminated state)
                  (do (fail! state DIRECT-PARSE-AFTER-TERMINATOR) 0)
                (parse-statement! state))))
          (let [end-position (current-position state)]
            (if (consume-byte! state (spec/block-production-terminal 2))
                (let [ended (builder/set-scope-end! (.builder state) scope
                                                     (+ end-position (cast u32 1)))]
                  (check-build! state ended)) 0))
          (set! (.scope state) parent-scope)) 0))
  0)

(defn parse-if! [(state (ptr DirectParseState))] (-> i64)
  (let [start (current-position state) _keyword (advance! state)]
    (if (not (consume-byte! state (spec/if-production-terminal 1))) 0
      (let [condition (parse-expression! state 0)]
        (if (not (consume-byte! state (spec/if-production-terminal 3))) 0
          (let [arena (.arena (.builder state))
                origin (.block state)
                region (load (p/index (.block-regions arena) (cast i64 origin)))
                then-result (builder/add-block! (.builder state) region)
                then-block (check-build! state then-result)
                else-result (builder/add-block! (.builder state) region)
                else-block (check-build! state else-result)
                branch-result (builder/add-op! (.builder state) origin ir/OP-COND-BR
                                               (cast u32 0) (cast u32 0) start
                                               (current-position state) (cast u32 0))]
            (let [branch (check-build! state branch-result)
                  operand (builder/add-operand! (.builder state) branch (.value condition))
                  then-successor (builder/add-successor! (.builder state) branch then-block)
                  else-successor (builder/add-successor! (.builder state) branch else-block)]
              (check-build! state operand)
              (check-build! state then-successor)
              (check-build! state else-successor))
            (set! (.block state) then-block)
            (set! (.terminated state) false)
            (parse-statement! state)
            (let [then-falls (not (.terminated state))]
              (set! (.block state) else-block)
              (set! (.terminated state) false)
              (if (current-keyword? state (spec/else-clause-production-keyword 0))
                  (do (advance! state) (parse-statement! state)) 0)
              (let [else-falls (not (.terminated state))]
                (if (or then-falls else-falls)
                    (let [join-result (builder/add-block! (.builder state) region)
                          join-block (check-build! state join-result)]
                      (if then-falls (emit-branch! state then-block join-block) 0)
                      (if else-falls (emit-branch! state else-block join-block) 0)
                      (set! (.block state) join-block)
                      (set! (.terminated state) false))
                  (set! (.terminated state) true)))))))))
  0)

(defn parse-while! [(state (ptr DirectParseState))] (-> i64)
  (let [start (current-position state) _keyword (advance! state)]
    (if (not (consume-byte! state (spec/while-production-terminal 1))) 0
      (let [arena (.arena (.builder state)) origin (.block state)
            region (load (p/index (.block-regions arena) (cast i64 origin)))
            header-result (builder/add-block! (.builder state) region)
            header (check-build! state header-result)
            body-result (builder/add-block! (.builder state) region)
            body (check-build! state body-result)
            exit-result (builder/add-block! (.builder state) region)
            exit-block (check-build! state exit-result)]
        (emit-branch! state origin header)
        (set! (.block state) header)
        (set! (.terminated state) false)
        (let [condition (parse-expression! state 0)]
          (if (not (consume-byte! state (spec/while-production-terminal 3))) 0
            (let [branch-result (builder/add-op! (.builder state) header ir/OP-COND-BR
                                   (cast u32 0) (cast u32 0) start
                                   (current-position state) (cast u32 0))]
              (let [branch (check-build! state branch-result)
                    operand (builder/add-operand! (.builder state) branch
                                                  (.value condition))
                    body-successor (builder/add-successor! (.builder state) branch body)
                    exit-successor (builder/add-successor! (.builder state) branch exit-block)]
                (check-build! state operand)
                (check-build! state body-successor)
                (check-build! state exit-successor))
              (set! (.block state) body)
              (set! (.terminated state) false)
              (parse-statement! state)
              (if (not (.terminated state)) (emit-branch! state (.block state) header) 0)
              (set! (.block state) exit-block)
              (set! (.terminated state) false)))))))
  0)

(defn parse-function! [(state (ptr DirectParseState))] (-> i64)
  (let [start (current-position state) parent-block (.block state)
        parent-scope (.scope state) parent-function-scope (.function-scope state)
        parent-terminated (.terminated state) _keyword (advance! state)
        name-start (current-position state) name-end (word-end state name-start)]
    (if (= name-start name-end) (do (fail! state DIRECT-PARSE-EXPECTED) 0)
      (do
        (advance! state)
        (let [binding-result (builder/add-binding! (.builder state) parent-scope
                                                    name-start name-end)]
          (check-build! state binding-result))
        (let [function-result (builder/add-op! (.builder state) parent-block
                               ir/OP-JS-FUNCTION name-start name-end start start (cast u32 0))
              function-op (check-build! state function-result)
              region-result (builder/add-region! (.builder state) function-op)
              region (check-build! state region-result)
              attached (builder/add-op-region! (.builder state) function-op region)
              entry-result (builder/add-block! (.builder state) region)
              entry (check-build! state entry-result)
              scope-result (builder/add-scope! (.builder state) parent-scope start
                                               (cast u32 (.source-size state)))
              function-scope (check-build! state scope-result)]
          (check-build! state attached)
          (if (consume-byte! state (spec/function-production-terminal 2))
              (do
                (if (= (current-byte state) (spec/function-production-terminal 4)) 0
                  (loop
                    (let [parameter-start (current-position state)
                          parameter-end (word-end state parameter-start)]
                      (if (= parameter-start parameter-end)
                          (do (fail! state DIRECT-PARSE-EXPECTED) (break))
                        (do
                          (advance! state)
                          (let [parameter (builder/add-binding! (.builder state) function-scope
                                                               parameter-start parameter-end)]
                            (check-build! state parameter))
                          (if (= (current-byte state)
                                 (spec/function-production-terminal 3))
                              (advance! state) (break)))))))
                (if (consume-byte! state (spec/function-production-terminal 4))
                    (do
                      (set! (.block state) entry)
                      (set! (.scope state) function-scope)
                      (set! (.function-scope state) function-scope)
                      (set! (.terminated state) false)
                      (parse-block! state)
                      (let [end (current-position state)]
                        (if (and (= (.error state) DIRECT-PARSE-OK)
                                 (not (.terminated state)))
                            (let [return-result (builder/add-op! (.builder state) (.block state)
                                                  ir/OP-RETURN (cast u32 0) (cast u32 0)
                                                  end end (cast u32 0))]
                              (check-build! state return-result)) 0)
                        (let [scope-end (builder/set-scope-end! (.builder state)
                                                               function-scope end)
                              op-end (builder/set-op-span! (.builder state) function-op
                                                           start end)]
                          (check-build! state scope-end)
                          (check-build! state op-end)))
                      (set! (.block state) parent-block)
                      (set! (.scope state) parent-scope)
                      (set! (.function-scope state) parent-function-scope)
                      (set! (.terminated state) parent-terminated)) 0)) 0)))))
  0)

(defn parse-statement! [(state (ptr DirectParseState))] (-> i64)
  (cond
    (= (current-byte state) (spec/block-production-terminal 0)) (parse-block! state)
    (or (current-keyword? state (spec/variable-production-keyword 0))
        (current-keyword? state (spec/let-production-keyword 0))
        (current-keyword? state (spec/var-production-keyword 0)))
      (parse-declaration! state)
    (current-keyword? state (spec/return-production-keyword 0)) (parse-return! state)
    (current-keyword? state (spec/if-production-keyword 0)) (parse-if! state)
    (current-keyword? state (spec/while-production-keyword 0)) (parse-while! state)
    (current-keyword? state (spec/function-production-keyword 0)) (parse-function! state)
    :else (parse-expression-statement! state)))

(defn parse-direct-program!
  [(source (ptr u8)) (source-size i64) (events (ptr u32)) (event-count i64)
   (ir-builder (ptr builder/IrBuilder)) (parser-scratch (ptr DirectParserScratch))]
  (-> DirectParseResult)
  (let [root-region-result (builder/add-region! ir-builder (cast u32 ir/INVALID-ID))
        root-region (check-build-result-id root-region-result)
        root-block-result (builder/add-block! ir-builder root-region)
        root-block (check-build-result-id root-block-result)
        root-scope-result (builder/add-scope! ir-builder (cast u32 ir/INVALID-ID)
                                              (cast u32 0) (cast u32 source-size))
        root-scope (check-build-result-id root-scope-result)
        state (p/alloc-stack DirectParseState)]
    (store! state (DirectParseState :source source :source-size source-size
                   :events events :event-count event-count :event-index 0
                   :builder ir-builder :scratch parser-scratch
                   :block root-block :scope root-scope :function-scope root-scope
                   :error (if (= (.error root-scope-result) builder/BUILD-OK)
                              DIRECT-PARSE-OK DIRECT-PARSE-BUILDER)
                   :error-offset (cast u32 0) :terminated false))
    (loop
      (if (or (>= (.event-index state) (.event-count state))
              (!= (.error state) DIRECT-PARSE-OK)) (break)
        (if (.terminated state)
            (do (fail! state DIRECT-PARSE-AFTER-TERMINATOR) 0)
          (parse-statement! state))))
    (if (and (= (.error state) DIRECT-PARSE-OK) (not (.terminated state)))
        (let [unreachable (builder/add-op! ir-builder root-block ir/OP-UNREACHABLE
                                           (cast u32 0) (cast u32 0)
                                           (cast u32 source-size) (cast u32 source-size)
                                           (cast u32 0))]
          (check-build! state unreachable)) 0)
    (if (and (= (.error state) DIRECT-PARSE-OK)
             (!= (builder/finalize-membership! ir-builder) builder/BUILD-OK))
        (do (fail! state DIRECT-PARSE-BUILDER) 0) 0)
    (DirectParseResult :error (.error state) :error-offset (.error-offset state)
                       :consumed-events (.event-index state)
                       :root-region root-region :root-block root-block)))

(defn check-build-result-id [(result builder/BuildResult)] (-> u32)
  (if (= (.error result) builder/BUILD-OK) (.id result) (cast u32 ir/INVALID-ID)))
