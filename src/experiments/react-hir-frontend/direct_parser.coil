(module experiments.react-hir-frontend.direct-parser)

(import "coil.primitive" :as p)
(import "coil.slice" :use [slice-data])
(import "experiments.react-hir-frontend.tape" :as tape)
(import "experiments.react-hir-frontend.frontend-spec" :as spec)
(import "experiments.react-hir-frontend.parser-generator" :as parser-generator)
(import "experiments.react-hir-frontend.ir" :as ir)
(import "experiments.react-hir-frontend.ir-builder" :as builder)

(const DIRECT-PARSE-OK i64 0)
(const DIRECT-PARSE-UNEXPECTED i64 1)
(const DIRECT-PARSE-EXPECTED i64 2)
(const DIRECT-PARSE-BUILDER i64 3)
(const DIRECT-PARSE-AFTER-TERMINATOR i64 4)
(const DIRECT-PARSE-SCRATCH-CAPACITY i64 5)

(defstruct DirectParserScratch
  [(values (ptr u32)) (value-capacity i64) (value-count i64)])

(defstruct DirectParseState
  [(source (ptr u8)) (source-size i64)
   (events (ptr u32)) (event-count i64) (event-index i64)
   (builder (ptr builder/IrBuilder))
   (scratch (ptr DirectParserScratch))
   (block u32) (scope u32) (function-scope u32)
   (error i64) (error-offset u32) (terminated bool)])

(defstruct ExprResult [(value u32) (start u32) (end u32)])

(defstruct DirectParseResult
  [(error i64) (error-offset u32) (consumed-events i64)
   (root-region u32) (root-block u32)])

(defn event-position [(event u32)] (-> u32)
  (cast u32 (p/ishr (cast u64 event) (cast u64 3))))

(defn event-kind [(event u32)] (-> u8)
  (cast u8 (p/iand (cast u64 event) (cast u64 7))))

(defn current-event [(state (ptr DirectParseState))] (-> u32)
  (if (>= (.event-index state) (.event-count state)) (cast u32 0)
    (load (p/index (.events state) (.event-index state)))))

(defn current-position [(state (ptr DirectParseState))] (-> u32)
  (if (>= (.event-index state) (.event-count state)) (cast u32 (.source-size state))
    (event-position (current-event state))))

(defn source-byte [(state (ptr DirectParseState)) (position u32)] (-> u8)
  (if (>= (cast i64 position) (.source-size state)) (cast u8 0)
    (load (p/index (.source state) (cast i64 position)))))

(defn current-byte [(state (ptr DirectParseState))] (-> u8)
  (source-byte state (current-position state)))

(defn adjacent-event-byte [(state (ptr DirectParseState)) (distance i64)] (-> u8)
  (let [index (+ (.event-index state) distance)]
    (if (>= index (.event-count state)) (cast u8 0)
      (let [position (event-position (load (p/index (.events state) index)))]
        (if (= position (+ (current-position state) (cast u32 distance)))
            (source-byte state position) (cast u8 0))))))

(defn advance! [(state (ptr DirectParseState))] (-> i64)
  (if (< (.event-index state) (.event-count state))
      (set! (.event-index state) (+ (.event-index state) 1)) 0)
  0)

(defn advance-count! [(state (ptr DirectParseState)) (count i64)] (-> i64)
  (let [(mut i) 0]
    (loop
      (if (>= (load i) count) (break)
        (do (advance! state) (set! i (+ (load i) 1)))))
    0))

(defn fail! [(state (ptr DirectParseState)) (error i64)] (-> ExprResult)
  (if (= (.error state) DIRECT-PARSE-OK)
      (do (set! (.error state) error)
          (set! (.error-offset state) (current-position state))) 0)
  (ExprResult :value (cast u32 ir/INVALID-ID)
              :start (current-position state) :end (current-position state)))

(defn check-build! [(state (ptr DirectParseState)) (result builder/BuildResult)] (-> u32)
  (if (= (.error result) builder/BUILD-OK) (.id result)
    (do (fail! state DIRECT-PARSE-BUILDER) (cast u32 ir/INVALID-ID))))

(defn push-scratch-value! [(state (ptr DirectParseState)) (value u32)] (-> i64)
  (let [scratch (.scratch state)]
    (if (>= (.value-count scratch) (.value-capacity scratch))
        (do (fail! state DIRECT-PARSE-SCRATCH-CAPACITY) 0)
      (do
        (store! (p/index (.values scratch) (.value-count scratch)) value)
        (set! (.value-count scratch) (+ (.value-count scratch) 1)))))
  0)

(defn emit-scratch-list-op! :inline (Always)
  [(state (ptr DirectParseState)) (opcode u16)
                             (start u32) (end u32) (mark i64)] (-> ExprResult)
  (let [scratch (.scratch state) arena (.arena (.builder state))
        value (.value-count arena)
        operation-result (builder/add-op! (.builder state) (.block state)
                           opcode (cast u32 0) (cast u32 0) start end (cast u32 1))]
    (let [op (check-build! state operation-result) (mut index) mark]
      (loop
        (if (>= (load index) (.value-count scratch)) (break)
          (let [operand (builder/add-operand! (.builder state) op
                          (load (p/index (.values scratch) (load index))))]
            (check-build! state operand)
            (set! index (+ (load index) 1)))))
      (set! (.value-count scratch) mark)
      (ExprResult :value value :start start :end end))))

(defn emit-scratch-call-op! :inline (Always)
  [(state (ptr DirectParseState)) (opcode u16) (callee ExprResult)
   (end u32) (mark i64)] (-> ExprResult)
  (let [scratch (.scratch state) arena (.arena (.builder state))
        value (.value-count arena)
        operation-result (builder/add-op! (.builder state) (.block state)
                           opcode (cast u32 0) (cast u32 0) (.start callee) end
                           (cast u32 1))]
    (let [op (check-build! state operation-result)
          callee-operand (builder/add-operand! (.builder state) op (.value callee))]
      (check-build! state callee-operand)
      (let [(mut index) mark]
        (loop
          (if (>= (load index) (.value-count scratch)) (break)
            (let [operand (builder/add-operand! (.builder state) op
                            (load (p/index (.values scratch) (load index))))]
              (check-build! state operand)
              (set! index (+ (load index) 1))))))
      (set! (.value-count scratch) mark)
      (ExprResult :value value :start (.start callee) :end end))))

(parser-generator/define-frontend-parser
  [(state-type DirectParseState)
   (expression-result-type ExprResult)
   (direct-result-type DirectParseResult)
   (parser-scratch-type DirectParserScratch)
   (current-position current-position)
   (current-byte current-byte)
   (advance advance!)
   (consume-byte consume-byte!)
   (fail fail!)
   (event-kind event-kind)
   (current-event current-event)
   (word-end word-end)
   (span-equals span-equals?)
   (source-byte source-byte)
   (emit-value-op emit-value-op!)
   (find-binding find-binding)
   (check-build check-build!)
   (check-build-result-id check-build-result-id)
   (emit-branch emit-branch!)
   (ensure-capture ensure-capture!)
   (current-keyword current-keyword?)
   (parse-expression parse-expression!)
   (parse-primary parse-primary!)
   (postfix-form spec/postfix-form)
   (primary-form spec/primary-form)
   (parse-property parse-property!)
   (parse-member parse-member!)
   (parse-call parse-call!)
   (parse-postfix parse-postfix!)
   (parse-block parse-block!)
   (parse-declaration parse-declaration!)
   (parse-if parse-if!)
   (parse-while parse-while!)
   (parse-function parse-function!)
   (parse-statement parse-statement!)
   (parse-direct-program parse-direct-program!)
   (push-scratch-value push-scratch-value!)
   (emit-scratch-list-op emit-scratch-list-op!)
   (emit-scratch-call-op emit-scratch-call-op!)
   (ok-error DIRECT-PARSE-OK)
   (unexpected-error DIRECT-PARSE-UNEXPECTED)
   (expected-error DIRECT-PARSE-EXPECTED)
   (after-terminator-error DIRECT-PARSE-AFTER-TERMINATOR)
   (builder-error DIRECT-PARSE-BUILDER)
   (parse-word parse-word!)
   (parse-string parse-string!)
   (parse-array parse-array-generated!)
   (parse-object parse-object!)
   (parse-return parse-return!)
   (parse-expression-statement parse-expression-statement!)])

(defn ascii-word? [(byte u8)] (-> bool)
  (or (and (>= byte (cast u8 48)) (<= byte (cast u8 57)))
      (and (>= byte (cast u8 65)) (<= byte (cast u8 90)))
      (and (>= byte (cast u8 97)) (<= byte (cast u8 122)))
      (= byte (cast u8 95)) (= byte (cast u8 36))))

(defn word-end [(state (ptr DirectParseState)) (start u32)] (-> u32)
  (let [(mut at) (cast i64 start)]
    (loop
      (if (or (>= (load at) (.source-size state))
              (not (ascii-word? (load (p/index (.source state) (load at))))))
          (break) (set! at (+ (load at) 1))))
    (cast u32 (load at))))

(defn span-equals? [(state (ptr DirectParseState)) (start u32) (end u32)
                    (text (slice u8))] (-> bool)
  (if (!= (- (cast i64 end) (cast i64 start)) (len text)) false
    (let [(mut i) 0 (mut same) true]
      (loop
        (if (or (>= (load i) (len text)) (not (load same))) (break)
          (do
            (if (!= (source-byte state (+ start (cast u32 (load i))))
                    (load (p/index (slice-data text) (load i))))
                (store! same false) 0)
            (set! i (+ (load i) 1)))))
      (load same))))

(defn consume-byte! [(state (ptr DirectParseState)) (expected u8)] (-> bool)
  (if (and (< (.event-index state) (.event-count state))
           (= (current-byte state) expected))
      (do (advance! state) true)
    (do (fail! state DIRECT-PARSE-EXPECTED) false)))

(defn find-binding [(state (ptr DirectParseState)) (start u32) (end u32)] (-> u32)
  (let [arena (.arena (.builder state))
        (mut index) (.binding-count arena)
        (mut found) (cast u32 ir/INVALID-ID)]
    (loop
      (if (or (= (load index) (cast u32 0))
              (!= (load found) (cast u32 ir/INVALID-ID))) (break)
        (do
          (set! index (- (load index) (cast u32 1)))
          (let [candidate-start (load (p/index (.binding-name-starts arena)
                                                (cast i64 (load index))))
                candidate-end (load (p/index (.binding-name-ends arena)
                                              (cast i64 (load index))))
                candidate-scope (load (p/index (.binding-scopes arena)
                                                (cast i64 (load index))))]
            (if (and (ir/scope-ancestor? arena candidate-scope (.scope state))
                     (= (- end start) (- candidate-end candidate-start))
                     (let [(mut i) (cast u32 0) (mut same) true]
                       (loop
                         (if (or (>= (load i) (- end start)) (not (load same))) (break)
                           (do
                             (if (!= (source-byte state (+ start (load i)))
                                     (source-byte state (+ candidate-start (load i))))
                                 (store! same false) 0)
                             (set! i (+ (load i) (cast u32 1))))))
                       (load same)))
                (store! found (load index)) 0)))))
    (load found)))

(defn ensure-capture! [(state (ptr DirectParseState)) (binding u32)] (-> i64)
  (let [arena (.arena (.builder state)) scope (.function-scope state)
        binding-scope (load (p/index (.binding-scopes arena) (cast i64 binding)))]
    (if (ir/scope-ancestor? arena scope binding-scope) 0
      (let [(mut capture) (cast u32 0) (mut found) false]
        (loop
          (if (or (>= (load capture) (.capture-count arena)) (load found)) (break)
            (do
              (if (and (= (load (p/index (.capture-scopes arena)
                                         (cast i64 (load capture)))) scope)
                       (= (load (p/index (.capture-bindings arena)
                                         (cast i64 (load capture)))) binding))
                  (store! found true) 0)
              (set! capture (+ (load capture) (cast u32 1))))))
        (if (not (load found))
            (let [result (builder/add-capture! (.builder state) scope binding)]
              (check-build! state result)) 0))))
  0)

(defn emit-value-op! [(state (ptr DirectParseState)) (opcode u16)
                      (start u32) (end u32)] (-> ExprResult)
  (let [arena (.arena (.builder state)) value (.value-count arena)
        operation (builder/add-op! (.builder state) (.block state) opcode
                                   start end start end (cast u32 1))]
    (check-build! state operation)
    (ExprResult :value value :start start :end end)))

(defn parse-expression! [(state (ptr DirectParseState)) (minimum i64)] (-> ExprResult)
  (let [(mut left) (parse-postfix! state)]
    (loop
      (let [byte0 (current-byte state)
            lookahead (spec/binary-lookahead byte0)
            byte1 (if (> lookahead 1) (adjacent-event-byte state 1) (cast u8 0))
            byte2 (if (> lookahead 2) (adjacent-event-byte state 2) (cast u8 0))
            info (if (= (.error state) DIRECT-PARSE-OK)
                     (spec/binary-info byte0 byte1 byte2) 0)
            precedence (/ info 256)]
        (if (or (= precedence 0) (< precedence minimum)) (break)
          (let [width (% info 256)
                immediate (p/ior (cast u64 byte0)
                            (p/ior (p/ishl (cast u64 byte1) (cast u64 8))
                                   (p/ishl (cast u64 byte2) (cast u64 16))))]
            (advance-count! state width)
            (let [right (parse-expression! state (+ precedence 1))
                  old-left (load left)
                  arena (.arena (.builder state)) value (.value-count arena)
                  operation (builder/add-op! (.builder state) (.block state) ir/OP-JS-BINARY
                                             (cast u32 0) (cast u32 0)
                                             (.start old-left) (.end right) (cast u32 1))]
              (let [op (check-build! state operation)
                    lhs (builder/add-operand! (.builder state) op (.value old-left))
                    rhs (builder/add-operand! (.builder state) op (.value right))
                    imm (builder/set-op-immediate! (.builder state) op immediate)]
                (check-build! state lhs)
                (check-build! state rhs)
                (check-build! state imm)
                (store! left (ExprResult :value value :start (.start old-left) :end (.end right)))))))))
    (let [completed
            (if (and (<= minimum 10) (= (.error state) DIRECT-PARSE-OK)
                     (= (current-byte state) (spec/conditional-production-terminal 0)))
                (let [condition (load left) origin (.block state)
                      arena (.arena (.builder state))
                      region (load (p/index (.block-regions arena) (cast i64 origin)))
                      _question (advance! state)
                      then-result (builder/add-block! (.builder state) region)
                      then-block (check-build! state then-result)
                      else-result (builder/add-block! (.builder state) region)
                      else-block (check-build! state else-result)
                      branch-result (builder/add-op! (.builder state) origin ir/OP-COND-BR
                                                     (cast u32 0) (cast u32 0)
                                                     (.start condition) (current-position state)
                                                     (cast u32 0))]
                  (let [branch (check-build! state branch-result)
                        operand (builder/add-operand! (.builder state) branch (.value condition))
                        then-successor (builder/add-successor! (.builder state) branch then-block)
                        else-successor (builder/add-successor! (.builder state) branch else-block)]
                    (check-build! state operand)
                    (check-build! state then-successor)
                    (check-build! state else-successor))
                  (set! (.block state) then-block)
                  (let [consequent (parse-expression! state 0) then-exit (.block state)]
                    (if (consume-byte! state (spec/conditional-production-terminal 2))
                        (do
                          (set! (.block state) else-block)
                          (let [alternate (parse-expression! state 10)
                                else-exit (.block state)
                                join-result (builder/add-block! (.builder state) region)
                                join-block (check-build! state join-result)
                                parameter-result
                                  (builder/add-block-param! (.builder state) join-block)
                                parameter (check-build! state parameter-result)]
                            (emit-branch-arg! state then-exit join-block (.value consequent))
                            (emit-branch-arg! state else-exit join-block (.value alternate))
                            (set! (.block state) join-block)
                            (let [result (p/alloc-stack ExprResult)]
                              (store! result
                                (ExprResult :value parameter :start (.start condition)
                                            :end (.end alternate)))
                              (load result))))
                      (fail! state DIRECT-PARSE-EXPECTED))))
              (load left))]
      (if (and (<= minimum 5) (= (.error state) DIRECT-PARSE-OK)
               (= (current-byte state) (spec/assignment-production-terminal 1))
               (!= (adjacent-event-byte state 1)
                   (spec/assignment-production-terminal 1)))
          (let [left-value (load completed) _equals (advance! state)
                right (parse-expression! state 0)
                arena (.arena (.builder state)) value (.value-count arena)
                operation-result (builder/add-op! (.builder state) (.block state)
                                   ir/OP-JS-ASSIGN (cast u32 0) (cast u32 0)
                                   (.start left-value) (.end right) (cast u32 1))]
            (let [op (check-build! state operation-result)
                  lhs (builder/add-operand! (.builder state) op (.value left-value))
                  rhs (builder/add-operand! (.builder state) op (.value right))
                  immediate (builder/set-op-immediate! (.builder state) op (cast u64 61))]
              (check-build! state lhs)
              (check-build! state rhs)
              (check-build! state immediate)
              (ExprResult :value value :start (.start left-value) :end (.end right))))
        (load completed)))))

(defn emit-branch-arg! [(state (ptr DirectParseState)) (block u32)
                        (target u32) (value u32)] (-> i64)
  (let [position (current-position state)
        operation (builder/add-op! (.builder state) block ir/OP-BR
                                   (cast u32 0) (cast u32 0)
                                   position position (cast u32 0))]
    (let [op (check-build! state operation)
          successor-result (builder/add-successor! (.builder state) op target)
          successor (check-build! state successor-result)
          argument (builder/add-successor-arg! (.builder state) successor value)]
      (check-build! state argument)))
  0)

(defn current-keyword? [(state (ptr DirectParseState)) (keyword (slice u8))] (-> bool)
  (if (or (>= (.event-index state) (.event-count state))
          (!= (event-kind (current-event state)) (cast u8 tape/EVENT-WORD))) false
    (let [start (current-position state)]
      (span-equals? state start (word-end state start) keyword))))

(defn emit-branch! [(state (ptr DirectParseState)) (block u32) (target u32)] (-> i64)
  (let [position (current-position state)
        operation (builder/add-op! (.builder state) block ir/OP-BR
                                   (cast u32 0) (cast u32 0)
                                   position position (cast u32 0))]
    (let [op (check-build! state operation)
          successor (builder/add-successor! (.builder state) op target)]
      (check-build! state successor)))
  0)

(defn check-build-result-id [(result builder/BuildResult)] (-> u32)
  (if (= (.error result) builder/BUILD-OK) (.id result) (cast u32 ir/INVALID-ID)))
