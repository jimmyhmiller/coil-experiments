   (parse-angle-assertion-lookahead parse-angle-assertion-lookahead!)
   (parse-prefix-keyword parse-prefix-keyword!)
   (parse-template parse-template!)
   (parse-tagged-template parse-tagged-template!)
   (parse-postfix parse-postfix!)
   (parse-optional-postfix parse-optional-postfix!)
   (parse-block parse-block!)
   (parse-declaration parse-declaration!)
