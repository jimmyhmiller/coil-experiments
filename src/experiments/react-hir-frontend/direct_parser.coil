   (adjacent-event-byte adjacent-event-byte)
   (next-event-byte next-event-byte)
   (advance-count advance-count!)
   (advance advance!)
   (consume-byte consume-byte!)
   (match-byte match-byte!)
   (fail fail!)
   (event-kind event-kind)
   (current-event current-event)
   (event-position event-position)
   (word-end word-end)
   (identifier-end identifier-end!)
   (previous-token-end previous-token-end)
   (span-equals span-equals?)
   (spans-equal spans-equal?)
   (identifier-span-equals identifier-span-equals-text?)
   (push-label push-label!)
   (pop-label pop-label!)
   (clear-pending-labels clear-pending-labels!)
   (publish-loop-labels publish-loop-labels!)
   (resolve-label-target resolve-label-target!)
