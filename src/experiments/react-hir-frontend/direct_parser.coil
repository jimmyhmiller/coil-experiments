   (parse-expression-statement parse-expression-statement!)])

(defn ascii-word? [(byte u8)] (-> bool)
  (or (and (>= byte (cast u8 48)) (<= byte (cast u8 57)))
      (and (>= byte (cast u8 65)) (<= byte (cast u8 90)))
      (and (>= byte (cast u8 97)) (<= byte (cast u8 122)))
      (= byte (cast u8 95)) (= byte (cast u8 36))))

(defn utf8-continuation? [(byte u8)] (-> bool)
  (= (p/iand (cast u64 byte) (cast u64 192)) (cast u64 128)))

(defn identifier-start-codepoint? [(codepoint u32)] (-> bool)
  (if (< codepoint (cast u32 128))
      (or (= codepoint (cast u32 36)) (= codepoint (cast u32 95))
          (and (>= codepoint (cast u32 65)) (<= codepoint (cast u32 90)))
          (and (>= codepoint (cast u32 97)) (<= codepoint (cast u32 122))))
    (unicode-id/id-start? codepoint)))

(defn identifier-continue-codepoint? [(codepoint u32)] (-> bool)
  (if (< codepoint (cast u32 128))
      (or (identifier-start-codepoint? codepoint)
          (and (>= codepoint (cast u32 48)) (<= codepoint (cast u32 57))))
    (or (unicode-id/id-continue? codepoint)
        (= codepoint (cast u32 8204)) (= codepoint (cast u32 8205)))))

(defn hex-value [(byte u8)] (-> i64)
  (cond (and (>= byte (cast u8 48)) (<= byte (cast u8 57)))
          (- (cast i64 byte) 48)
        (and (>= byte (cast u8 65)) (<= byte (cast u8 70)))
          (+ (- (cast i64 byte) 65) 10)
        (and (>= byte (cast u8 97)) (<= byte (cast u8 102)))
          (+ (- (cast i64 byte) 97) 10)
        :else -1))

(defn decode-identifier-codepoint
  [(state (ptr DirectParseState)) (start u32)] (-> Utf8Decode)
  (if (!= (source-byte state start) (cast u8 92)) (decode-utf8 state start)
    (let [size (cast u32 (.source-size state)) u (+ start (cast u32 1))]
      (if (or (>= u size) (!= (source-byte state u) (cast u8 117)))
          (Utf8Decode :codepoint (cast u32 0) :end (+ start (cast u32 1)) :valid false)
        (let [digits (+ u (cast u32 1))]
          (if (and (< digits size) (= (source-byte state digits) (cast u8 123)))
              (let [(mut at) (+ digits (cast u32 1)) (mut value) (cast u32 0)
                    (mut count) 0 (mut valid) true]
                (loop
                  (if (or (>= (load at) size) (>= (load count) 6)
                          (= (source-byte state (load at)) (cast u8 125))) (break)
                    (let [digit (hex-value (source-byte state (load at)))]
                      (if (< digit 0) (do (store! valid false) (break))
                        (do
                          (store! value (+ (p/ishl (load value) (cast u32 4))
                                           (cast u32 digit)))
                          (set! count (+ (load count) 1))
                          (set! at (+ (load at) (cast u32 1))))))))
                (let [closed (and (< (load at) size)
                                   (= (source-byte state (load at)) (cast u8 125)))
                      scalar (and (> (load count) 0) (load valid) closed
                                  (<= (load value) (cast u32 1114111))
                                  (or (< (load value) (cast u32 55296))
                                      (> (load value) (cast u32 57343))))]
                  (Utf8Decode :codepoint (load value)
                    :end (if closed (+ (load at) (cast u32 1)) (load at))
                    :valid scalar)))
            (let [(mut at) digits (mut value) (cast u32 0) (mut count) 0
                  (mut valid) true]
              (loop
                (if (>= (load count) 4) (break)
                  (if (>= (load at) size) (store! valid false)
                    (let [digit (hex-value (source-byte state (load at)))]
                      (if (< digit 0) (do (store! valid false) (break))
                        (do
                          (store! value (+ (p/ishl (load value) (cast u32 4))
                                           (cast u32 digit)))
                          (set! count (+ (load count) 1))
                          (set! at (+ (load at) (cast u32 1)))))))))
              (Utf8Decode :codepoint (load value) :end (load at)
                :valid (and (load valid) (= (load count) 4)
                            (or (< (load value) (cast u32 55296))
                                (> (load value) (cast u32 57343))))))))))))

(defn decode-utf8 [(state (ptr DirectParseState)) (start u32)] (-> Utf8Decode)
  (let [size (cast u32 (.source-size state)) first (source-byte state start)]
    (cond
      (< first (cast u8 128))
        (Utf8Decode :codepoint (cast u32 first) :end (+ start (cast u32 1)) :valid true)
      (and (>= first (cast u8 194)) (<= first (cast u8 223))
           (< (+ start (cast u32 1)) size)
           (utf8-continuation? (source-byte state (+ start (cast u32 1)))))
        (let [b1 (source-byte state (+ start (cast u32 1)))]
          (Utf8Decode
            :codepoint (+ (p/ishl (cast u32 (p/iand (cast u64 first) (cast u64 31)))
                            (cast u32 6))
                          (cast u32 (p/iand (cast u64 b1) (cast u64 63))))
            :end (+ start (cast u32 2)) :valid true))
      (and (>= first (cast u8 224)) (<= first (cast u8 239))
           (< (+ start (cast u32 2)) size)
           (utf8-continuation? (source-byte state (+ start (cast u32 1))))
           (utf8-continuation? (source-byte state (+ start (cast u32 2)))))
        (let [b1 (source-byte state (+ start (cast u32 1)))
              b2 (source-byte state (+ start (cast u32 2)))
              valid (and (or (!= first (cast u8 224)) (>= b1 (cast u8 160)))
                         (or (!= first (cast u8 237)) (< b1 (cast u8 160))))]
          (Utf8Decode
            :codepoint (+ (p/ishl (cast u32 (p/iand (cast u64 first) (cast u64 15)))
                            (cast u32 12))
                          (+ (p/ishl (cast u32 (p/iand (cast u64 b1) (cast u64 63)))
                               (cast u32 6))
                             (cast u32 (p/iand (cast u64 b2) (cast u64 63)))))
            :end (+ start (cast u32 3)) :valid valid))
      (and (>= first (cast u8 240)) (<= first (cast u8 244))
           (< (+ start (cast u32 3)) size)
           (utf8-continuation? (source-byte state (+ start (cast u32 1))))
           (utf8-continuation? (source-byte state (+ start (cast u32 2))))
           (utf8-continuation? (source-byte state (+ start (cast u32 3)))))
        (let [b1 (source-byte state (+ start (cast u32 1)))
              b2 (source-byte state (+ start (cast u32 2)))
              b3 (source-byte state (+ start (cast u32 3)))
              valid (and (or (!= first (cast u8 240)) (>= b1 (cast u8 144)))
                         (or (!= first (cast u8 244)) (< b1 (cast u8 144))))]
          (Utf8Decode
            :codepoint (+ (p/ishl (cast u32 (p/iand (cast u64 first) (cast u64 7)))
                            (cast u32 18))
                          (+ (p/ishl (cast u32 (p/iand (cast u64 b1) (cast u64 63)))
                               (cast u32 12))
                             (+ (p/ishl (cast u32 (p/iand (cast u64 b2) (cast u64 63)))
                                  (cast u32 6))
                                (cast u32 (p/iand (cast u64 b3) (cast u64 63))))))
            :end (+ start (cast u32 4)) :valid valid))
      :else (Utf8Decode :codepoint (cast u32 0) :end (+ start (cast u32 1)) :valid false))))

(defn word-end [(state (ptr DirectParseState)) (start u32)] (-> u32)
  (let [(mut at) (cast i64 start)]
    (loop
      (if (>= (load at) (.source-size state)) (break)
        (let [byte (load (p/index (.source state) (load at)))]
          (if (= byte (cast u8 92))
              (let [decoded (decode-identifier-codepoint state (cast u32 (load at)))]
                (if (.valid decoded) (set! at (cast i64 (.end decoded))) (break)))
            (if (or (ascii-word? byte) (>= byte (cast u8 128)))
                (set! at (+ (load at) 1)) (break))))))
    (cast u32 (load at))))

(defn identifier-end! :inline (Always)
  [(state (ptr DirectParseState)) (start u32)] (-> u32)
  (let [first-byte (source-byte state start) (mut at) start
        (mut identifier) true (mut valid) true (mut braced-escape) false]
    (if (= first-byte (cast u8 92))
        (let [decoded (decode-identifier-codepoint state start)]
          (if (= (source-byte state (+ start (cast u32 2))) (cast u8 123))
              (store! braced-escape true) 0)
          (if (and (.valid decoded) (identifier-start-codepoint? (.codepoint decoded)))
              (store! at (.end decoded))
            (do (fail! state DIRECT-PARSE-EXPECTED) (store! valid false))))
      (if (< first-byte (cast u8 128))
        (if (or (= first-byte (cast u8 36)) (= first-byte (cast u8 95))
                (and (>= first-byte (cast u8 65)) (<= first-byte (cast u8 90)))
                (and (>= first-byte (cast u8 97)) (<= first-byte (cast u8 122))))
            (store! at (+ start (cast u32 1)))
          (store! identifier false))
      (let [decoded (decode-utf8 state start)]
        (if (and (.valid decoded) (unicode-id/id-start? (.codepoint decoded)))
            (store! at (.end decoded))
          (do
            (fail! state DIRECT-PARSE-EXPECTED)
            (store! valid false))))))
    (loop
      (if (or (not (load identifier))
              (>= (cast i64 (load at)) (.source-size state))
              (not (load valid))) (break)
        (let [byte (source-byte state (load at))]
          (cond
            (= byte (cast u8 92))
              (let [decoded (decode-identifier-codepoint state (load at))]
                (if (= (source-byte state (+ (load at) (cast u32 2))) (cast u8 123))
                    (store! braced-escape true) 0)
                (if (and (.valid decoded)
                         (identifier-continue-codepoint? (.codepoint decoded)))
                    (store! at (.end decoded))
                  (store! valid false)))
            (ascii-word? byte)
              (store! at (+ (load at) (cast u32 1)))
            (>= byte (cast u8 128))
              (let [decoded (decode-utf8 state (load at))
                    allowed (and (.valid decoded)
                                  (unicode-id/id-continue? (.codepoint decoded)))]
                (if allowed
                    (store! at (.end decoded))
                  (store! valid false)))
            :else (break)))))
    (if (not (load identifier)) (word-end state start)
      (if (not (load valid))
        (do (fail! state DIRECT-PARSE-EXPECTED) (word-end state start))
        (do
          (if (load braced-escape)
              (loop
                (let [next (+ (.event-index state) 1)]
                  (if (or (>= next (.event-count state))
                          (>= (event-position
                                (load (p/index (.events state) next))) (load at))) (break)
                    (set! (.event-index state) next)))) 0)
          (load at))))))

(defn previous-token-end [(state (ptr DirectParseState))] (-> u32)
  (if (<= (.event-index state) 0) (cast u32 0)
    (let [event (load (p/index (.events state) (- (.event-index state) 1)))
          start (event-position event)]
      (if (= (event-kind event) tape/EVENT-WORD)
          (word-end state start)
        (+ start (cast u32 1))))))

(defn span-equals? [(state (ptr DirectParseState)) (start u32) (end u32)
                    (text (slice u8))] (-> bool)
  (if (!= (- (cast i64 end) (cast i64 start)) (len text)) false
    (let [(mut i) 0 (mut same) true]
      (loop
        (if (or (>= (load i) (len text)) (not (load same))) (break)
          (do
            (if (!= (source-byte state (+ start (cast u32 (load i))))
                    (load (p/index (slice-data text) (load i))))
                (store! same false) 0)
            (set! i (+ (load i) 1)))))
      (load same))))

(defn span-hash [(state (ptr DirectParseState)) (start u32) (end u32)] (-> u64)
  (let [(mut hash) (cast u64 1469598103934665603) (mut at) start]
    (loop
      (if (>= (load at) end) (break)
        (do
          (store! hash (p/ixor (load hash) (cast u64 (source-byte state (load at)))))
          (store! hash (* (load hash) (cast u64 1099511628211)))
          (set! at (+ (load at) (cast u32 1))))))
    (load hash)))

(defn spans-equal? [(state (ptr DirectParseState)) (left-start u32) (left-end u32)
                    (right-start u32) (right-end u32)] (-> bool)
  (if (!= (- left-end left-start) (- right-end right-start)) false
    (let [(mut offset) (cast u32 0) (mut same) true]
      (loop
        (if (or (>= (load offset) (- left-end left-start)) (not (load same))) (break)
          (do
            (if (!= (source-byte state (+ left-start (load offset)))
                    (source-byte state (+ right-start (load offset))))
                (store! same false) 0)
            (set! offset (+ (load offset) (cast u32 1))))))
      (load same))))

(defn identifier-span-equals-text?
  [(state (ptr DirectParseState)) (start u32) (end u32) (text (slice u8))] (-> bool)
  (let [(mut at) start (mut index) 0 (mut same) true]
    (loop
      (if (or (>= (load at) end) (not (load same))) (break)
        (let [decoded (decode-identifier-codepoint state (load at))]
          (if (or (not (.valid decoded)) (>= (.codepoint decoded) (cast u32 128))
                  (>= (load index) (len text))
                  (!= (cast u8 (.codepoint decoded))
                      (load (p/index (slice-data text) (load index)))))
              (store! same false)
            (do
              (store! at (.end decoded))
              (set! index (+ (load index) 1)))))))
    (and (load same) (= (load at) end) (= (load index) (len text)))))

(defn identifier-spans-equal?
  [(state (ptr DirectParseState)) (left-start u32) (left-end u32)
   (right-start u32) (right-end u32)] (-> bool)
  (let [(mut fast-left) left-start (mut fast-right) right-start (mut raw-same) true]
    (loop
      (if (or (>= (load fast-left) left-end) (>= (load fast-right) right-end)
              (not (load raw-same))) (break)
        (if (= (source-byte state (load fast-left))
               (source-byte state (load fast-right)))
            (do (store! fast-left (+ (load fast-left) (cast u32 1)))
                (store! fast-right (+ (load fast-right) (cast u32 1))))
          (store! raw-same false))))
    (if (and (load raw-same) (= (load fast-left) left-end)
             (= (load fast-right) right-end)) true
      (let [(mut left) left-start (mut right) right-start (mut same) true]
    (loop
      (if (or (>= (load left) left-end) (>= (load right) right-end)
              (not (load same))) (break)
        (let [a (decode-identifier-codepoint state (load left))
              b (decode-identifier-codepoint state (load right))]
          (if (or (not (.valid a)) (not (.valid b))
                  (!= (.codepoint a) (.codepoint b)))
              (store! same false)
            (do (store! left (.end a)) (store! right (.end b)))))))
        (and (load same) (= (load left) left-end) (= (load right) right-end))))))

(defn identifier-span-hash
  [(state (ptr DirectParseState)) (start u32) (end u32)] (-> u64)
  (let [(mut hash) (cast u64 1469598103934665603) (mut at) start]
    (loop
      (if (>= (load at) end) (break)
        (if (or (= (source-byte state (load at)) (cast u8 92))
                (>= (source-byte state (load at)) (cast u8 128)))
            (let [decoded (decode-identifier-codepoint state (load at))]
              (store! hash (p/ixor (load hash) (cast u64 (.codepoint decoded))))
              (store! hash (* (load hash) (cast u64 1099511628211)))
              (store! at (.end decoded)))
          (do
            (store! hash (p/ixor (load hash)
                           (cast u64 (source-byte state (load at)))))
            (store! hash (* (load hash) (cast u64 1099511628211)))
            (store! at (+ (load at) (cast u32 1)))))))
    (load hash)))

;; Labels are parser-semantic state rather than syntax nodes waiting in an AST.
;; The fixed caller-local stack is sufficient for ordinary programs, and an
;; explicit capacity error keeps pathological nesting memory-safe.
(defn push-label! [(state (ptr DirectParseState)) (start u32) (end u32)] (-> bool)
  (let [(mut index) (.label-count state) (mut duplicate) false]
    (loop
      (if (or (<= (load index) 0) (load duplicate)) (break)
        (do
          (set! index (- (load index) 1))
          (if (and (= (load (p/index (.label-function-scopes state) (load index)))
                      (.function-scope state))
                   (identifier-spans-equal? state start end
                     (load (p/index (.label-starts state) (load index)))
                     (load (p/index (.label-ends state) (load index)))))
              (store! duplicate true) 0))))
    (if (or (load duplicate) (>= (.label-count state) (.label-capacity state)))
        (do
          (fail! state (if (load duplicate) DIRECT-PARSE-EXPECTED
                         DIRECT-PARSE-SCRATCH-CAPACITY))
          false)
      (let [slot (.label-count state)]
        (store! (p/index (.label-starts state) slot) start)
        (store! (p/index (.label-ends state) slot) end)
        (store! (p/index (.label-break-targets state) slot) (cast u32 ir/INVALID-ID))
        (store! (p/index (.label-continue-targets state) slot) (cast u32 ir/INVALID-ID))
        (store! (p/index (.label-function-scopes state) slot) (.function-scope state))
        (store! (p/index (.label-pending state) slot) (cast u8 1))
        (set! (.label-count state) (+ slot 1))
        true))))

(defn pop-label! [(state (ptr DirectParseState))] (-> i64)
  (if (> (.label-count state) 0)
      (set! (.label-count state) (- (.label-count state) 1)) 0)
  0)

(defn clear-pending-labels! [(state (ptr DirectParseState))] (-> i64)
  (let [(mut index) (.label-count state) (mut scanning) true]
    (loop
      (if (or (<= (load index) 0) (not (load scanning))) (break)
        (do
          (set! index (- (load index) 1))
          (if (and (= (load (p/index (.label-function-scopes state) (load index)))
                      (.function-scope state))
                   (!= (load (p/index (.label-pending state) (load index))) (cast u8 0)))
              (store! (p/index (.label-pending state) (load index)) (cast u8 0))
            (store! scanning false))))))
  0)

(defn publish-loop-labels! [(state (ptr DirectParseState)) (target u32)] (-> i64)
  (let [(mut index) (.label-count state) (mut scanning) true]
    (loop
      (if (or (<= (load index) 0) (not (load scanning))) (break)
        (do
          (set! index (- (load index) 1))
          (if (and (= (load (p/index (.label-function-scopes state) (load index)))
                      (.function-scope state))
                   (!= (load (p/index (.label-pending state) (load index))) (cast u8 0)))
              (do
                (store! (p/index (.label-continue-targets state) (load index)) target)
                (store! (p/index (.label-pending state) (load index)) (cast u8 0)))
            (store! scanning false))))))
  0)

(defn resolve-label-target! [(state (ptr DirectParseState)) (start u32) (end u32)
                             (continue? bool)] (-> u32)
  (let [(mut index) (.label-count state) (mut found) (cast u32 ir/INVALID-ID)]
    (loop
      (if (or (<= (load index) 0) (!= (load found) (cast u32 ir/INVALID-ID))) (break)
        (do
          (set! index (- (load index) 1))
          (if (and (= (load (p/index (.label-function-scopes state) (load index)))
                      (.function-scope state))
                   (identifier-spans-equal? state start end
                     (load (p/index (.label-starts state) (load index)))
                     (load (p/index (.label-ends state) (load index)))))
              (if continue?
                  (store! found
                    (load (p/index (.label-continue-targets state) (load index))))
                (let [existing (load (p/index (.label-break-targets state) (load index)))]
                  (if (!= existing (cast u32 ir/INVALID-ID)) (store! found existing)
                    (let [arena (.arena (.builder state))
                          region (load (p/index (.block-regions arena)
                                         (cast i64 (.block state))))
                          target (check-build! state
                                   (builder/add-block! (.builder state) region))]
                      (store! (p/index (.label-break-targets state) (load index)) target)
                      (store! found target))))) 0))))
    (load found)))

(defn consume-byte! [(state (ptr DirectParseState)) (expected u8)] (-> bool)
  (if (and (< (.event-index state) (.event-count state))
           (= (current-byte state) expected))
      (do (advance! state) true)
    (do (fail! state DIRECT-PARSE-EXPECTED) false)))

(defn match-byte! :inline (Always)
  [(state (ptr DirectParseState)) (expected u8)] (-> bool)
  (if (and (< (.event-index state) (.event-count state))
           (= (current-byte state) expected))
      (do (advance! state) true)
    false))

(defn find-binding-range [(state (ptr DirectParseState)) (start u32) (end u32)
                          (lower-bound u32)] (-> u32)
  (let [arena (.arena (.builder state))
        (mut index) (.binding-count arena)
        (mut found) (cast u32 ir/INVALID-ID)]
    (loop
      (if (or (<= (load index) lower-bound)
              (!= (load found) (cast u32 ir/INVALID-ID))) (break)
        (do
          (set! index (- (load index) (cast u32 1)))
          (let [candidate-start (load (p/index (.binding-name-starts arena)
                                                (cast i64 (load index))))
                candidate-end (load (p/index (.binding-name-ends arena)
                                              (cast i64 (load index))))
                candidate-scope (load (p/index (.binding-scopes arena)
                                                (cast i64 (load index))))]
            (if (and (ir/scope-ancestor? arena candidate-scope (.scope state))
                     (identifier-spans-equal? state start end
                       candidate-start candidate-end))
                (store! found (load index)) 0)))))
    (load found)))

(defn find-binding [(state (ptr DirectParseState)) (start u32) (end u32)] (-> u32)
  (let [arena (.arena (.builder state)) hash (identifier-span-hash state start end)
        slot (cast i64 (% hash (cast u64 (.lookup-capacity state))))
        hit (and (!= (load (p/index (.lookup-valid state) slot)) (cast u8 0))
                 (= (load (p/index (.lookup-hashes state) slot)) hash)
                 (identifier-spans-equal? state start end
                   (load (p/index (.lookup-starts state) slot))
                   (load (p/index (.lookup-ends state) slot))))
        cached (if hit (load (p/index (.lookup-bindings state) slot))
                   (cast u32 ir/INVALID-ID))
        reusable (and hit
                   (or (= cached (cast u32 ir/INVALID-ID))
                       (ir/scope-ancestor? arena
                         (load (p/index (.binding-scopes arena) (cast i64 cached)))
                         (.scope state))))
        lower-bound (if reusable (load (p/index (.lookup-counts state) slot))
                      (cast u32 0))
        newer (find-binding-range state start end lower-bound)
        found (if (!= newer (cast u32 ir/INVALID-ID)) newer
                (if reusable cached (cast u32 ir/INVALID-ID)))]
    (store! (p/index (.lookup-valid state) slot) (cast u8 1))
    (store! (p/index (.lookup-hashes state) slot) hash)
    (store! (p/index (.lookup-bindings state) slot) found)
    (store! (p/index (.lookup-counts state) slot) (.binding-count arena))
    (store! (p/index (.lookup-starts state) slot) start)
    (store! (p/index (.lookup-ends state) slot) end)
    found))

(defn ensure-capture! [(state (ptr DirectParseState)) (binding u32)] (-> i64)
  (let [arena (.arena (.builder state)) scope (.function-scope state)
        binding-scope (load (p/index (.binding-scopes arena) (cast i64 binding)))]
    (if (ir/scope-ancestor? arena scope binding-scope) 0
      (let [(mut capture) (cast u32 0) (mut found) false]
        (loop
          (if (or (>= (load capture) (.capture-count arena)) (load found)) (break)
            (do
              (if (and (= (load (p/index (.capture-scopes arena)
                                         (cast i64 (load capture)))) scope)
                       (= (load (p/index (.capture-bindings arena)
                                         (cast i64 (load capture)))) binding))
                  (store! found true) 0)
              (set! capture (+ (load capture) (cast u32 1))))))
        (if (not (load found))
            (let [result (builder/add-capture! (.builder state) scope binding)]
              (check-build! state result)) 0))))
  0)

(defn emit-value-op! [(state (ptr DirectParseState)) (opcode u16)
                      (start u32) (end u32)] (-> ExprResult)
  (let [arena (.arena (.builder state)) value (.value-count arena)
        operation (builder/add-op! (.builder state) (.block state) opcode
                                   start end start end (cast u32 1))]
    (check-build! state operation)
    (ExprResult :value value :start start :end end)))

(defn emit-branch-arg! [(state (ptr DirectParseState)) (block u32)
                        (target u32) (value u32)] (-> i64)
  (let [position (current-position state)
        operation (builder/add-op! (.builder state) block ir/OP-BR
                                   (cast u32 0) (cast u32 0)
                                   position position (cast u32 0))]
    (let [op (check-build! state operation)
          successor-result (builder/add-successor! (.builder state) op target)
          successor (check-build! state successor-result)
          argument (builder/add-successor-arg! (.builder state) successor value)]
      (check-build! state argument)))
  0)

(defn current-keyword? [(state (ptr DirectParseState)) (keyword (slice u8))] (-> bool)
  (if (or (>= (.event-index state) (.event-count state))
          (!= (event-kind (current-event state)) (cast u8 tape/EVENT-WORD))) false
    (let [start (current-position state)]
      (span-equals? state start (word-end state start) keyword))))

(defn current-keyword-fast? :inline (Always)
  [(state (ptr DirectParseState)) (keyword (slice u8))] (-> bool)
  (and (> (len keyword) 0)
       (= (current-byte state) (load (slice-data keyword)))
       (current-keyword? state keyword)))

(defn next-event-keyword? :inline (Always)
  [(state (ptr DirectParseState)) (distance i64) (keyword (slice u8))] (-> bool)
  (let [index (logical-event-index state (.event-index state) distance)]
    (if (or (< index 0) (>= index (.event-count state))) false
      (let [event (load (p/index (.events state) index))]
        (if (!= (event-kind event) (cast u8 tape/EVENT-WORD)) false
          (let [start (event-position event)]
            (span-equals? state start (word-end state start) keyword)))))))

(defn next-event-kind :inline (Always)
  [(state (ptr DirectParseState)) (distance i64)] (-> u8)
  (let [index (logical-event-index state (.event-index state) distance)]
    (if (or (< index 0) (>= index (.event-count state))) (cast u8 0)
      (event-kind (load (p/index (.events state) index))))))

(defn current-line-break? :inline (Always) [(state (ptr DirectParseState))] (-> bool)
  (and (< (.event-index state) (.event-count state))
       (event-has-leading-line-break? (current-event state))))

(defn emit-branch! [(state (ptr DirectParseState)) (block u32) (target u32)] (-> i64)
  (let [position (current-position state)
        operation (builder/add-op! (.builder state) block ir/OP-BR
                                   (cast u32 0) (cast u32 0)
                                   position position (cast u32 0))]
    (let [op (check-build! state operation)
          successor (builder/add-successor! (.builder state) op target)]
      (check-build! state successor)))
  0)

(defn check-build-result-id [(result builder/BuildResult)] (-> u32)
  (if (= (.error result) builder/BUILD-OK) (.id result) (cast u32 ir/INVALID-ID)))
