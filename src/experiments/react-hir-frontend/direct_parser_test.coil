(module experiments.react-hir-frontend.direct-parser-test)

(import "coil.primitive" :as p)
(import "coil.slice" :use [slice-data])
(import "experiments.react-hir-frontend.frontend" :as frontend)
(import "experiments.react-hir-frontend.pipeline" :as pipeline)
(import "experiments.react-hir-frontend.ir" :as ir)
(import "experiments.react-hir-frontend.ir-builder" :as builder)
(import "experiments.react-hir-frontend.ir-storage" :as storage)
(import "experiments.react-hir-frontend.direct-parser" :as parser)
(import "experiments.react-hir-frontend.js-printer" :as js)
(import "experiments.react-hir-frontend.ir-text-parser" :as ir-text)

(defn byte-eq? [(actual (ptr u8)) (expected (slice u8)) (count i64)] (-> bool)
  (if (!= count (len expected)) false
    (let [(mut i) 0 (mut same) true]
      (loop
        (if (or (>= (load i) count) (not (load same))) (break)
          (do
            (if (!= (load (p/index actual (load i)))
                    (load (p/index (slice-data expected) (load i))))
                (store! same false) 0)
            (set! i (+ (load i) 1)))))
      (load same))))

(defn ptr-byte-eq? [(left (ptr u8)) (right (ptr u8)) (count i64)] (-> bool)
  (let [(mut i) 0 (mut same) true]
    (loop
      (if (or (>= (load i) count) (not (load same))) (break)
        (do
          (if (!= (load (p/index left (load i))) (load (p/index right (load i))))
              (store! same false) 0)
          (set! i (+ (load i) 1)))))
    (load same)))

(defn opcode-count [(arena (ptr ir/IrArena)) (opcode u16)] (-> u32)
  (let [(mut op) (cast u32 0) (mut count) (cast u32 0)]
    (loop
      (if (>= (load op) (.op-count arena)) (break)
        (do
          (if (= (load (p/index (.opcodes arena) (cast i64 (load op)))) opcode)
              (set! count (+ (load count) (cast u32 1))) 0)
          (set! op (+ (load op) (cast u32 1))))))
    (load count)))

(defn first-opcode-index [(arena (ptr ir/IrArena)) (opcode u16)] (-> u32)
  (let [(mut op) (cast u32 0) (mut found) (cast u32 ir/INVALID-ID)]
    (loop
      (if (or (>= (load op) (.op-count arena))
              (!= (load found) (cast u32 ir/INVALID-ID)))
          (break)
        (do
          (if (= (load (p/index (.opcodes arena) (cast i64 (load op)))) opcode)
              (store! found (load op)) 0)
          (set! op (+ (load op) (cast u32 1))))))
    (load found)))

(defn nth-opcode-index
  [(arena (ptr ir/IrArena)) (opcode u16) (occurrence u32)] (-> u32)
  (let [(mut op) (cast u32 0) (mut seen) (cast u32 0)
        (mut found) (cast u32 ir/INVALID-ID)]
    (loop
      (if (or (>= (load op) (.op-count arena))
              (!= (load found) (cast u32 ir/INVALID-ID)))
          (break)
        (do
          (if (= (load (p/index (.opcodes arena) (cast i64 (load op)))) opcode)
              (if (= (load seen) occurrence)
                  (store! found (load op))
                (set! seen (+ (load seen) (cast u32 1)))) 0)
          (set! op (+ (load op) (cast u32 1))))))
    (load found)))

(deftest test-mapped-type-retains_structure_and_modifiers
  (let [text "type M = { readonly [K in Keys as Rename<K>]-?: Value<K> }; type P = { +readonly [P in Keys]+?: Value<P> }; type N = { -readonly [N in Keys]?: Value<N> }; type LU = | string | number; type SU = | boolean; type LI = & { left: string } & { right: number }; type SI = & object;"
        events (p/alloc-stack (array u32 128))
        memory (p/alloc-stack (array u64 4096))
        arena (p/alloc-stack ir/IrArena)
        builder-scratch (p/alloc-stack builder/BuilderScratch)
        ir-builder (p/alloc-stack builder/IrBuilder)
        parser-values (p/alloc-stack (array u32 128))
        parser-scratch (p/alloc-stack parser/DirectParserScratch)
        verify-bits (p/alloc-stack (array u64 8))
        verify-scratch (p/alloc-stack ir/VerifyScratch)
        caps (builder/BuilderCapacities
          :regions (cast u32 4) :region-block-refs (cast u32 8)
          :blocks (cast u32 8) :block-op-refs (cast u32 128)
          :ops (cast u32 128) :op-region-refs (cast u32 4)
          :values (cast u32 128) :operands (cast u32 256)
          :successors (cast u32 8) :successor-args (cast u32 8)
          :scopes (cast u32 8) :bindings (cast u32 16)
          :references (cast u32 16) :captures (cast u32 8))
        initialized (storage/initialize! arena builder-scratch ir-builder
                      (p/cast (ptr u8) memory) 32768 (cast u32 (len text)) caps)
        tape-result (pipeline/scan-source-to-parse-tape64
          (slice-data text) (len text) (cast u32 0) (p/cast (ptr u32) events)
          (frontend/frontend-initial-state))]
    (assert-eq (.error initialized) storage/STORAGE-OK)
    (store! parser-scratch (parser/DirectParserScratch
      :values (p/cast (ptr u32) parser-values) :value-capacity 128 :value-count 0))
    (let [parsed (parser/parse-direct-program! (slice-data text) (len text)
                   (p/cast (ptr u32) events) (.count tape-result)
                   ir-builder parser-scratch)]
      (assert-eq (.error parsed) parser/DIRECT-PARSE-OK)
      (assert-eq (.consumed-events parsed) (.count tape-result)))
    (assert-eq (opcode-count arena ir/OP-TS-MAPPED-TYPE) (cast u32 3))
    (assert-eq (opcode-count arena ir/OP-TS-TYPE-PARAMETER) (cast u32 3))
    (assert-eq (opcode-count arena ir/OP-TS-UNION-TYPE) (cast u32 2))
    (assert-eq (opcode-count arena ir/OP-TS-INTERSECTION-TYPE) (cast u32 2))
    (let [mapped (first-opcode-index arena ir/OP-TS-MAPPED-TYPE)]
      (assert (!= mapped (cast u32 ir/INVALID-ID)))
      (assert-eq (load (p/index (.op-operand-counts arena) (cast i64 mapped)))
                 (cast u32 3))
      (assert-eq (load (p/index (.op-immediates arena) (cast i64 mapped)))
                 (p/ior (cast u64 ir/MAPPED-MODIFIER-TRUE)
                   (p/ior
                     (p/ishl (cast u64 ir/MAPPED-MODIFIER-MINUS)
                       (cast u64 ir/MAPPED-OPTIONAL-SHIFT))
                     (p/ior (cast u64 ir/MAPPED-HAS-NAME-TYPE)
                            (cast u64 ir/MAPPED-HAS-VALUE-TYPE))))))
    (let [plus-mapped (nth-opcode-index arena ir/OP-TS-MAPPED-TYPE (cast u32 1))
          minus-mapped (nth-opcode-index arena ir/OP-TS-MAPPED-TYPE (cast u32 2))]
      (assert-eq (load (p/index (.op-immediates arena) (cast i64 plus-mapped)))
        (p/ior (cast u64 ir/MAPPED-MODIFIER-PLUS)
          (p/ior
            (p/ishl (cast u64 ir/MAPPED-MODIFIER-PLUS)
              (cast u64 ir/MAPPED-OPTIONAL-SHIFT))
            (cast u64 ir/MAPPED-HAS-VALUE-TYPE))))
      (assert-eq (load (p/index (.op-immediates arena) (cast i64 minus-mapped)))
        (p/ior (cast u64 ir/MAPPED-MODIFIER-MINUS)
          (p/ior
            (p/ishl (cast u64 ir/MAPPED-MODIFIER-TRUE)
              (cast u64 ir/MAPPED-OPTIONAL-SHIFT))
            (cast u64 ir/MAPPED-HAS-VALUE-TYPE)))))
    (let [leading-union (nth-opcode-index arena ir/OP-TS-UNION-TYPE (cast u32 0))
          single-union (nth-opcode-index arena ir/OP-TS-UNION-TYPE (cast u32 1))
          leading-intersection
            (nth-opcode-index arena ir/OP-TS-INTERSECTION-TYPE (cast u32 0))
          single-intersection
            (nth-opcode-index arena ir/OP-TS-INTERSECTION-TYPE (cast u32 1))]
      (assert-eq (load (p/index (.op-immediates arena) (cast i64 leading-union)))
                 ir/TYPE-LIST-LEADING-SEPARATOR)
      (assert-eq (load (p/index (.op-operand-counts arena) (cast i64 leading-union)))
                 (cast u32 2))
      (assert-eq (load (p/index (.op-immediates arena) (cast i64 single-union)))
                 ir/TYPE-LIST-LEADING-SEPARATOR)
      (assert-eq (load (p/index (.op-operand-counts arena) (cast i64 single-union)))
                 (cast u32 1))
      (assert-eq (load (p/index (.op-immediates arena)
                    (cast i64 leading-intersection)))
                 ir/TYPE-LIST-LEADING-SEPARATOR)
      (assert-eq (load (p/index (.op-operand-counts arena)
                    (cast i64 leading-intersection))) (cast u32 2))
      (assert-eq (load (p/index (.op-immediates arena)
                    (cast i64 single-intersection)))
                 ir/TYPE-LIST-LEADING-SEPARATOR)
      (assert-eq (load (p/index (.op-operand-counts arena)
                    (cast i64 single-intersection))) (cast u32 1)))
    (store! verify-scratch
      (ir/VerifyScratch :dominators (p/cast (ptr u64) verify-bits)
                        :dominator-word-capacity 8))
    (let [verified (ir/verify-ir arena verify-scratch)]
      (assert-eq (.error verified) ir/VERIFY-OK))
    (let [single-union (nth-opcode-index arena ir/OP-TS-UNION-TYPE (cast u32 1))]
      (store! (p/index (.op-immediates arena) (cast i64 single-union)) (cast u64 0))
      (let [invalid (ir/verify-ir arena verify-scratch)]
        (assert-eq (.error invalid) ir/VERIFY-OPCODE))
      (store! (p/index (.op-immediates arena) (cast i64 single-union))
              ir/TYPE-LIST-LEADING-SEPARATOR)
      (let [restored (ir/verify-ir arena verify-scratch)]
        (assert-eq (.error restored) ir/VERIFY-OK)))
    )
  0)

(deftest test-conditional_infer_operators_and_query_retain_structure
  (let [text "type Element<T> = T extends readonly (infer U extends PropertyKey)[] ? U : never; type Keys<T> = keyof T; type Query = typeof Namespace.runtimeValue<string>; type Brand = unique symbol; type Named = [first: string, second?: number, ...rest: boolean[]]; type Plain = [string, number?, ...boolean[]]; type Imported = import(\"pkg\", { with: { type: \"json\" } }).Foo.Bar<string, number>; type Path<A, B> = `${A}.${B}`; type Assertion = asserts x is string; type ThisAssertion = asserts this is Foo; function isString(x: unknown): x is string { return true; } type Literals = true | false | 123 | -456 | 789n | -10n | \"text\"; type PatternFn = ({ x, y: alias = 1, \"quoted\": quoted, 0: numeric, [key]: computed, ...rest }: Props, [head, , ...tail]: Tuple) => void; type PatternCtor = new ({ value }: Box) => object; type PatternMember = { method({ x }: Props): void }; type UntypedPattern = ({ value }) => void; type RestPattern = (...[head, ...tail]: [string, ...number[]]) => void;"
        events (p/alloc-stack (array u32 512))
        memory (p/alloc-stack (array u64 16384))
        arena (p/alloc-stack ir/IrArena)
        builder-scratch (p/alloc-stack builder/BuilderScratch)
        ir-builder (p/alloc-stack builder/IrBuilder)
        parser-values (p/alloc-stack (array u32 512))
        parser-scratch (p/alloc-stack parser/DirectParserScratch)
        verify-bits (p/alloc-stack (array u64 8))
        verify-scratch (p/alloc-stack ir/VerifyScratch)
        caps (builder/BuilderCapacities
          :regions (cast u32 4) :region-block-refs (cast u32 8)
          :blocks (cast u32 8) :block-op-refs (cast u32 512)
          :ops (cast u32 512) :op-region-refs (cast u32 4)
          :values (cast u32 512) :operands (cast u32 1024)
          :successors (cast u32 8) :successor-args (cast u32 8)
          :scopes (cast u32 8) :bindings (cast u32 16)
          :references (cast u32 16) :captures (cast u32 8))
        initialized (storage/initialize! arena builder-scratch ir-builder
                      (p/cast (ptr u8) memory) 131072 (cast u32 (len text)) caps)
        tape-result (pipeline/scan-source-to-parse-tape64
          (slice-data text) (len text) (cast u32 0) (p/cast (ptr u32) events)
          (frontend/frontend-initial-state))]
    (assert-eq (.error initialized) storage/STORAGE-OK)
    (store! parser-scratch (parser/DirectParserScratch
      :values (p/cast (ptr u32) parser-values) :value-capacity 512 :value-count 0))
    (let [parsed (parser/parse-direct-program! (slice-data text) (len text)
                   (p/cast (ptr u32) events) (.count tape-result)
                   ir-builder parser-scratch)]
      (assert-eq (.error parsed) parser/DIRECT-PARSE-OK)
      (assert-eq (.consumed-events parsed) (.count tape-result)))
    (assert-eq (opcode-count arena ir/OP-TS-CONDITIONAL-TYPE) (cast u32 1))
    (assert-eq (opcode-count arena ir/OP-TS-INFER-TYPE) (cast u32 1))
    (assert-eq (opcode-count arena ir/OP-TS-TYPE-OPERATOR) (cast u32 3))
    (assert-eq (opcode-count arena ir/OP-TS-TYPE-QUERY) (cast u32 1))
    (assert-eq (opcode-count arena ir/OP-TS-NAMED-TUPLE-MEMBER) (cast u32 3))
    (assert-eq (opcode-count arena ir/OP-TS-OPTIONAL-TYPE) (cast u32 1))
    (assert-eq (opcode-count arena ir/OP-TS-REST-TYPE) (cast u32 3))
    (assert-eq (opcode-count arena ir/OP-TS-IMPORT-TYPE) (cast u32 1))
    (assert-eq (opcode-count arena ir/OP-TS-TEMPLATE-LITERAL-TYPE) (cast u32 1))
    (assert-eq (opcode-count arena ir/OP-TS-TEMPLATE-ELEMENT) (cast u32 3))
    (assert-eq (opcode-count arena ir/OP-TS-TYPE-PREDICATE) (cast u32 3))
    (assert-eq (opcode-count arena ir/OP-TS-LITERAL-TYPE) (cast u32 7))
    (assert-eq (opcode-count arena ir/OP-JS-OBJECT-BINDING-PATTERN) (cast u32 4))
    (assert-eq (opcode-count arena ir/OP-JS-ARRAY-BINDING-PATTERN) (cast u32 2))
    (assert-eq (opcode-count arena ir/OP-JS-BINDING-PROPERTY) (cast u32 8))
    (assert-eq (opcode-count arena ir/OP-JS-REST-BINDING) (cast u32 3))
    (assert-eq (opcode-count arena ir/OP-JS-ASSIGNMENT-BINDING) (cast u32 1))
    (assert-eq (opcode-count arena ir/OP-JS-ELISION) (cast u32 1))
    (let [parameter
            (first-opcode-index arena ir/OP-TS-FUNCTION-TYPE-PARAMETER)
          parameter-first
            (load (p/index (.op-first-operands arena) (cast i64 parameter)))
          pattern-value
            (load (p/index (.operands arena) (cast i64 parameter-first)))
          type-value
            (load (p/index (.operands arena) (+ (cast i64 parameter-first) 1)))
          pattern-def
            (load (p/index (.value-def-indices arena) (cast i64 pattern-value)))
          type-def
            (load (p/index (.value-def-indices arena) (cast i64 type-value)))
          first-property
            (first-opcode-index arena ir/OP-JS-BINDING-PROPERTY)
          second-property
            (nth-opcode-index arena ir/OP-JS-BINDING-PROPERTY (cast u32 1))
          second-first
            (load (p/index (.op-first-operands arena) (cast i64 second-property)))
          assignment-value
            (load (p/index (.operands arena) (cast i64 second-first)))
          assignment-def
            (load (p/index (.value-def-indices arena) (cast i64 assignment-value)))]
      (assert-eq (load (p/index (.op-immediates arena) (cast i64 parameter)))
                 (p/ior ir/FUNCTION-TYPE-PARAM-PATTERN
                        ir/FUNCTION-TYPE-PARAM-HAS-TYPE))
      (assert-eq (load (p/index (.op-operand-counts arena) (cast i64 parameter)))
                 (cast u32 2))
      (assert-eq (load (p/index (.opcodes arena) (cast i64 pattern-def)))
                 ir/OP-JS-OBJECT-BINDING-PATTERN)
      (assert-eq (load (p/index (.opcodes arena) (cast i64 type-def)))
                 ir/OP-TS-TYPE-REFERENCE)
      (assert-eq (load (p/index (.op-operand-counts arena) (cast i64 pattern-def)))
                 (cast u32 6))
      (assert-eq (load (p/index (.op-immediates arena) (cast i64 first-property)))
                 ir/BINDING-PROPERTY-SHORTHAND)
      (assert-eq (load (p/index (.op-immediates arena) (cast i64 second-property)))
                 (cast u64 0))
      (assert-eq (load (p/index (.opcodes arena) (cast i64 assignment-def)))
                 ir/OP-JS-ASSIGNMENT-BINDING))
    (let [quoted
            (nth-opcode-index arena ir/OP-JS-BINDING-PROPERTY (cast u32 2))
          numeric
            (nth-opcode-index arena ir/OP-JS-BINDING-PROPERTY (cast u32 3))
          computed
            (nth-opcode-index arena ir/OP-JS-BINDING-PROPERTY (cast u32 4))
          computed-first
            (load (p/index (.op-first-operands arena) (cast i64 computed)))
          key-value
            (load (p/index (.operands arena) (cast i64 computed-first)))
          key-def
            (load (p/index (.value-def-indices arena) (cast i64 key-value)))]
      (assert-eq (- (load (p/index (.op-name-ends arena) (cast i64 quoted)))
                    (load (p/index (.op-name-starts arena) (cast i64 quoted))))
                 (cast u32 8))
      (assert-eq (- (load (p/index (.op-name-ends arena) (cast i64 numeric)))
                    (load (p/index (.op-name-starts arena) (cast i64 numeric))))
                 (cast u32 1))
      (assert-eq (load (p/index (.op-immediates arena) (cast i64 computed)))
                 ir/BINDING-PROPERTY-COMPUTED)
      (assert-eq (load (p/index (.op-operand-counts arena) (cast i64 computed)))
                 (cast u32 2))
      (assert-eq (load (p/index (.opcodes arena) (cast i64 key-def)))
                 ir/OP-JS-IDENTIFIER))
    (let [untyped
            (nth-opcode-index arena ir/OP-TS-FUNCTION-TYPE-PARAMETER (cast u32 4))
          rest-pattern
            (nth-opcode-index arena ir/OP-TS-FUNCTION-TYPE-PARAMETER (cast u32 5))]
      (assert-eq (load (p/index (.op-immediates arena) (cast i64 untyped)))
                 ir/FUNCTION-TYPE-PARAM-PATTERN)
      (assert-eq (load (p/index (.op-operand-counts arena) (cast i64 untyped)))
                 (cast u32 1))
      (assert-eq (load (p/index (.op-immediates arena) (cast i64 rest-pattern)))
                 (p/ior ir/FUNCTION-TYPE-PARAM-REST
                   (p/ior ir/FUNCTION-TYPE-PARAM-PATTERN
                          ir/FUNCTION-TYPE-PARAM-HAS-TYPE)))
      (assert-eq (load (p/index (.op-operand-counts arena) (cast i64 rest-pattern)))
                 (cast u32 2)))
    (let [conditional (first-opcode-index arena ir/OP-TS-CONDITIONAL-TYPE)
          infer (first-opcode-index arena ir/OP-TS-INFER-TYPE)
          infer-first (load (p/index (.op-first-operands arena) (cast i64 infer)))
          infer-parameter-value
            (load (p/index (.operands arena) (cast i64 infer-first)))
          infer-parameter-def
            (load (p/index (.value-def-indices arena)
                    (cast i64 infer-parameter-value)))
          infer-parameter-first
            (load (p/index (.op-first-operands arena)
                    (cast i64 infer-parameter-def)))
          infer-constraint-value
            (load (p/index (.operands arena) (cast i64 infer-parameter-first)))
          infer-constraint-def
            (load (p/index (.value-def-indices arena)
                    (cast i64 infer-constraint-value)))
          readonly (first-opcode-index arena ir/OP-TS-TYPE-OPERATOR)
          keyof (nth-opcode-index arena ir/OP-TS-TYPE-OPERATOR (cast u32 1))
          unique (nth-opcode-index arena ir/OP-TS-TYPE-OPERATOR (cast u32 2))
          query (first-opcode-index arena ir/OP-TS-TYPE-QUERY)]
      (assert-eq (load (p/index (.op-operand-counts arena) (cast i64 conditional)))
                 (cast u32 4))
      (assert-eq (load (p/index (.op-operand-counts arena) (cast i64 infer)))
                 (cast u32 1))
      (assert-eq (load (p/index (.opcodes arena) (cast i64 infer-parameter-def)))
                 ir/OP-TS-TYPE-PARAMETER)
      (assert-eq (load (p/index (.op-immediates arena)
                    (cast i64 infer-parameter-def)))
                 ir/TYPE-PARAM-HAS-CONSTRAINT)
      (assert-eq (load (p/index (.op-operand-counts arena)
                    (cast i64 infer-parameter-def)))
                 (cast u32 1))
      (assert-eq (load (p/index (.opcodes arena) (cast i64 infer-constraint-def)))
                 ir/OP-TS-TYPE-REFERENCE)
      (assert-eq (load (p/index (.op-immediates arena) (cast i64 readonly)))
                 ir/TYPE-OPERATOR-READONLY)
      (assert-eq (load (p/index (.op-immediates arena) (cast i64 keyof)))
                 ir/TYPE-OPERATOR-KEYOF)
      (assert-eq (load (p/index (.op-immediates arena) (cast i64 unique)))
                 ir/TYPE-OPERATOR-UNIQUE)
      (assert-eq (load (p/index (.op-immediates arena) (cast i64 query)))
                 (p/ior ir/TYPE-QUERY-TYPEOF ir/TYPE-QUERY-HAS-ARGUMENTS))
      (assert-eq (load (p/index (.op-operand-counts arena) (cast i64 query)))
                 (cast u32 2)))
    (let [first (nth-opcode-index arena ir/OP-TS-NAMED-TUPLE-MEMBER (cast u32 0))
          second (nth-opcode-index arena ir/OP-TS-NAMED-TUPLE-MEMBER (cast u32 1))
          rest (nth-opcode-index arena ir/OP-TS-NAMED-TUPLE-MEMBER (cast u32 2))
          rest-wrapper (nth-opcode-index arena ir/OP-TS-REST-TYPE (cast u32 0))
          rest-first-operand
            (load (p/index (.op-first-operands arena) (cast i64 rest-wrapper)))
          rest-value (load (p/index (.operands arena) (cast i64 rest-first-operand)))
          rest-value-def
            (load (p/index (.value-def-indices arena) (cast i64 rest-value)))]
      (assert-eq (load (p/index (.op-immediates arena) (cast i64 first))) (cast u64 0))
      (assert-eq (load (p/index (.op-immediates arena) (cast i64 second))) (cast u64 1))
      (assert-eq (load (p/index (.op-immediates arena) (cast i64 rest))) (cast u64 0))
      (assert-eq (load (p/index (.opcodes arena) (cast i64 rest-value-def)))
                 ir/OP-TS-NAMED-TUPLE-MEMBER))
    (let [import-type (first-opcode-index arena ir/OP-TS-IMPORT-TYPE)
          first-operand
            (load (p/index (.op-first-operands arena) (cast i64 import-type)))
          options-value (load (p/index (.operands arena) (cast i64 first-operand)))
          qualifier-value (load (p/index (.operands arena) (+ (cast i64 first-operand) 1)))
          arguments-value (load (p/index (.operands arena) (+ (cast i64 first-operand) 2)))
          options-def (load (p/index (.value-def-indices arena) (cast i64 options-value)))
          qualifier-def (load (p/index (.value-def-indices arena) (cast i64 qualifier-value)))
          arguments-def (load (p/index (.value-def-indices arena) (cast i64 arguments-value)))]
      (assert-eq (load (p/index (.op-immediates arena) (cast i64 import-type)))
                 ir/IMPORT-TYPE-FLAG-MASK)
      (assert-eq (load (p/index (.op-operand-counts arena) (cast i64 import-type)))
                 (cast u32 3))
      (assert-eq (load (p/index (.opcodes arena) (cast i64 options-def))) ir/OP-JS-OBJECT)
      (assert-eq (load (p/index (.opcodes arena) (cast i64 qualifier-def)))
                 ir/OP-TS-QUALIFIED-TYPE)
      (assert-eq (load (p/index (.opcodes arena) (cast i64 arguments-def)))
                 ir/OP-TS-TYPE-ARGUMENTS))
    (let [template (first-opcode-index arena ir/OP-TS-TEMPLATE-LITERAL-TYPE)
          first-operand (load (p/index (.op-first-operands arena) (cast i64 template)))
          quasi0-value (load (p/index (.operands arena) (cast i64 first-operand)))
          quasi1-value (load (p/index (.operands arena) (+ (cast i64 first-operand) 1)))
          quasi2-value (load (p/index (.operands arena) (+ (cast i64 first-operand) 2)))
          type0-value (load (p/index (.operands arena) (+ (cast i64 first-operand) 3)))
          quasi0-def (load (p/index (.value-def-indices arena) (cast i64 quasi0-value)))
          quasi1-def (load (p/index (.value-def-indices arena) (cast i64 quasi1-value)))
          quasi2-def (load (p/index (.value-def-indices arena) (cast i64 quasi2-value)))
          type0-def (load (p/index (.value-def-indices arena) (cast i64 type0-value)))]
      (assert-eq (load (p/index (.op-operand-counts arena) (cast i64 template)))
                 (cast u32 5))
      (assert-eq (load (p/index (.opcodes arena) (cast i64 quasi0-def)))
                 ir/OP-TS-TEMPLATE-ELEMENT)
      (assert-eq (load (p/index (.opcodes arena) (cast i64 quasi1-def)))
                 ir/OP-TS-TEMPLATE-ELEMENT)
      (assert-eq (load (p/index (.opcodes arena) (cast i64 quasi2-def)))
                 ir/OP-TS-TEMPLATE-ELEMENT)
      (assert-eq (load (p/index (.opcodes arena) (cast i64 type0-def)))
                 ir/OP-TS-TYPE-REFERENCE))
    (let [assertion (nth-opcode-index arena ir/OP-TS-TYPE-PREDICATE (cast u32 0))
          this-assertion (nth-opcode-index arena ir/OP-TS-TYPE-PREDICATE (cast u32 1))
          predicate (nth-opcode-index arena ir/OP-TS-TYPE-PREDICATE (cast u32 2))]
      (assert-eq (load (p/index (.op-immediates arena) (cast i64 assertion)))
                 (p/ior ir/TYPE-PREDICATE-ASSERTS ir/TYPE-PREDICATE-HAS-TYPE))
      (assert-eq (load (p/index (.op-immediates arena) (cast i64 this-assertion)))
                 ir/TYPE-PREDICATE-FLAG-MASK)
      (assert-eq (load (p/index (.op-immediates arena) (cast i64 predicate)))
                 ir/TYPE-PREDICATE-HAS-TYPE)
      (assert-eq (load (p/index (.op-operand-counts arena) (cast i64 predicate)))
                 (cast u32 2)))
    (store! verify-scratch
      (ir/VerifyScratch :dominators (p/cast (ptr u64) verify-bits)
                        :dominator-word-capacity 8))
    (let [verified (ir/verify-ir arena verify-scratch)]
      (assert-eq (.error verified) ir/VERIFY-OK))
    ;; Shape-only validation is not enough: a type union must not silently own
    ;; an arbitrary runtime expression value. Corrupt one child to prove the
    ;; verifier checks the semantic kind of type-tree edges.
    (let [union-op (first-opcode-index arena ir/OP-TS-UNION-TYPE)
          member-op (first-opcode-index arena ir/OP-JS-IDENTIFIER)
          union-first
            (load (p/index (.op-first-operands arena) (cast i64 union-op)))
          original (load (p/index (.operands arena) (cast i64 union-first)))
          runtime-value
            (load (p/index (.op-first-results arena) (cast i64 member-op)))]
      (store! (p/index (.operands arena) (cast i64 union-first)) runtime-value)
      (let [invalid (ir/verify-ir arena verify-scratch)]
        (assert-eq (.error invalid) ir/VERIFY-TYPE-OPERAND))
      (store! (p/index (.operands arena) (cast i64 union-first)) original)
      (let [restored (ir/verify-ir arena verify-scratch)]
        (assert-eq (.error restored) ir/VERIFY-OK))))
  0)

(deftest test-structured-types-produce_verified_tree
  (let [text "type Core<T extends A = B> = (A.B<C[]> | [string, number]) & { value?: D[E]; callback: (this: Core, x?: boolean, ...rest: number[]) => void }; type Fn = <const T extends object, U = T>(this: T, value: U, ...rest: U[]) => asserts value is U; type Ctor = new <T>(value: T) => Box<T>; type AbstractCtor = abstract new <T>(value: T) => Box<T>; type API = { readonly version?: string; <T>(value: T): T; new <T>(value: T): Box<T>; map?<T>(value: T): T; readonly [name: string]: number; [index: number]: string; 'data-value'?: string; 42: boolean; \"run\"<T>(value: T): T; [Symbol.iterator](): Iterator<number>; readonly [Symbol.dispose]?: () => void; plain; readonly optional?; \"untyped\"; 0?; [Symbol.unscopables]?; }; type IndexFirst = { readonly [key: string]: number; [token: symbol]: unknown }; type Accessors = { get value(): string; set value(next: string); get [Symbol.species](): Constructor; set \"label\"(next: string); }; type OmittedReturns = { (value: string); new (value: string); method(value: string); get value(); }; interface Derived<T> extends Base<T>, Namespace.Contract { readonly value?: T; untyped; }"
        events (p/alloc-stack (array u32 512))
        memory (p/alloc-stack (array u64 8192))
        arena (p/alloc-stack ir/IrArena)
        builder-scratch (p/alloc-stack builder/BuilderScratch)
        ir-builder (p/alloc-stack builder/IrBuilder)
        parser-values (p/alloc-stack (array u32 256))
        parser-scratch (p/alloc-stack parser/DirectParserScratch)
        verify-bits (p/alloc-stack (array u64 8))
        verify-scratch (p/alloc-stack ir/VerifyScratch)
        caps (builder/BuilderCapacities
          :regions (cast u32 4) :region-block-refs (cast u32 8)
          :blocks (cast u32 8) :block-op-refs (cast u32 256)
          :ops (cast u32 256) :op-region-refs (cast u32 4)
          :values (cast u32 256) :operands (cast u32 512)
          :successors (cast u32 8) :successor-args (cast u32 8)
          :scopes (cast u32 8) :bindings (cast u32 16)
          :references (cast u32 16) :captures (cast u32 8))
        initialized (storage/initialize! arena builder-scratch ir-builder
                      (p/cast (ptr u8) memory) 65536 (cast u32 (len text)) caps)
        tape-result (pipeline/scan-source-to-parse-tape64
          (slice-data text) (len text) (cast u32 0) (p/cast (ptr u32) events)
          (frontend/frontend-initial-state))]
    (assert-eq (.error initialized) storage/STORAGE-OK)
    (store! parser-scratch (parser/DirectParserScratch
      :values (p/cast (ptr u32) parser-values) :value-capacity 256 :value-count 0))
    (let [parsed (parser/parse-direct-program! (slice-data text) (len text)
                   (p/cast (ptr u32) events) (.count tape-result)
                   ir-builder parser-scratch)]
      (assert-eq (.error parsed) parser/DIRECT-PARSE-OK)
      (assert-eq (.consumed-events parsed) (.count tape-result)))
    (assert-eq (opcode-count arena ir/OP-TS-TYPE-ALIAS) (cast u32 8))
    (assert-eq (opcode-count arena ir/OP-TS-TYPE) (cast u32 8))
    (assert-eq (opcode-count arena ir/OP-TS-TYPE-PARAMETERS) (cast u32 9))
    (assert-eq (opcode-count arena ir/OP-TS-TYPE-PARAMETER) (cast u32 10))
    (assert-eq (opcode-count arena ir/OP-TS-UNION-TYPE) (cast u32 1))
    (assert-eq (opcode-count arena ir/OP-TS-INTERSECTION-TYPE) (cast u32 1))
    (assert-eq (opcode-count arena ir/OP-TS-ARRAY-TYPE) (cast u32 3))
    (assert-eq (opcode-count arena ir/OP-TS-TUPLE-TYPE) (cast u32 1))
    (assert-eq (opcode-count arena ir/OP-TS-QUALIFIED-TYPE) (cast u32 2))
    (assert-eq (opcode-count arena ir/OP-TS-INDEXED-ACCESS-TYPE) (cast u32 1))
    (assert-eq (opcode-count arena ir/OP-TS-FUNCTION-TYPE) (cast u32 3))
    (assert-eq (opcode-count arena ir/OP-TS-CONSTRUCTOR-TYPE) (cast u32 2))
    (assert-eq (opcode-count arena ir/OP-TS-TYPE-LITERAL) (cast u32 6))
    (assert-eq (opcode-count arena ir/OP-TS-INTERFACE) (cast u32 1))
    (assert-eq (opcode-count arena ir/OP-TS-HERITAGE) (cast u32 1))
    (assert-eq (opcode-count arena ir/OP-TS-CALL-SIGNATURE) (cast u32 2))
    (assert-eq (opcode-count arena ir/OP-TS-CONSTRUCT-SIGNATURE) (cast u32 2))
    (assert-eq (opcode-count arena ir/OP-TS-METHOD-SIGNATURE) (cast u32 9))
    (assert-eq (opcode-count arena ir/OP-TS-INDEX-SIGNATURE) (cast u32 4))
    (assert-eq (opcode-count arena ir/OP-TS-PROPERTY-SIGNATURE) (cast u32 13))
    (let [alias (first-opcode-index arena ir/OP-TS-TYPE-ALIAS)
          first-operand (load (p/index (.op-first-operands arena) (cast i64 alias)))
          parameters-value (load (p/index (.operands arena) (cast i64 first-operand)))
          body-value (load (p/index (.operands arena) (+ (cast i64 first-operand) 1)))
          parameters-def
            (load (p/index (.value-def-indices arena) (cast i64 parameters-value)))
          body-def (load (p/index (.value-def-indices arena) (cast i64 body-value)))]
      (assert-eq (load (p/index (.op-immediates arena) (cast i64 alias)))
                 ir/TYPE-DECL-HAS-TYPE-PARAMETERS)
      (assert-eq (load (p/index (.op-operand-counts arena) (cast i64 alias)))
                 (cast u32 2))
      (assert-eq (load (p/index (.opcodes arena) (cast i64 parameters-def)))
                 ir/OP-TS-TYPE-PARAMETERS)
      (assert-eq (load (p/index (.opcodes arena) (cast i64 body-def))) ir/OP-TS-TYPE))
    (let [plain-function
            (nth-opcode-index arena ir/OP-TS-FUNCTION-TYPE (cast u32 0))
          plain-first
            (load (p/index (.op-first-operands arena) (cast i64 plain-function)))
          plain-this-value
            (load (p/index (.operands arena) (cast i64 plain-first)))
          plain-optional-value
            (load (p/index (.operands arena) (+ (cast i64 plain-first) 1)))
          plain-rest-value
            (load (p/index (.operands arena) (+ (cast i64 plain-first) 2)))
          plain-this-def
            (load (p/index (.value-def-indices arena) (cast i64 plain-this-value)))
          plain-optional-def
            (load (p/index (.value-def-indices arena) (cast i64 plain-optional-value)))
          plain-rest-def
            (load (p/index (.value-def-indices arena) (cast i64 plain-rest-value)))
          function-type
            (nth-opcode-index arena ir/OP-TS-FUNCTION-TYPE (cast u32 1))
          function-first
            (load (p/index (.op-first-operands arena) (cast i64 function-type)))
          parameters-value
            (load (p/index (.operands arena) (cast i64 function-first)))
          parameters-def
            (load (p/index (.value-def-indices arena) (cast i64 parameters-value)))
          this-value
            (load (p/index (.operands arena) (+ (cast i64 function-first) 1)) )
          this-def (load (p/index (.value-def-indices arena) (cast i64 this-value)))
          rest-value
            (load (p/index (.operands arena) (+ (cast i64 function-first) 3)))
          rest-def (load (p/index (.value-def-indices arena) (cast i64 rest-value)))
          return-value
            (load (p/index (.operands arena) (+ (cast i64 function-first) 4)))
          return-def (load (p/index (.value-def-indices arena) (cast i64 return-value)))
          constructor (nth-opcode-index arena ir/OP-TS-CONSTRUCTOR-TYPE (cast u32 0))
          abstract-constructor
            (nth-opcode-index arena ir/OP-TS-CONSTRUCTOR-TYPE (cast u32 1))]
      (assert-eq (load (p/index (.op-operand-counts arena) (cast i64 plain-function)))
                 (cast u32 4))
      (assert-eq (load (p/index (.op-immediates arena) (cast i64 plain-this-def)))
                 (p/ior ir/FUNCTION-TYPE-PARAM-THIS
                        ir/FUNCTION-TYPE-PARAM-HAS-TYPE))
      (assert-eq (load (p/index (.op-immediates arena) (cast i64 plain-optional-def)))
                 (p/ior ir/FUNCTION-TYPE-PARAM-OPTIONAL
                        ir/FUNCTION-TYPE-PARAM-HAS-TYPE))
      (assert-eq (load (p/index (.op-immediates arena) (cast i64 plain-rest-def)))
                 (p/ior ir/FUNCTION-TYPE-PARAM-REST
                        ir/FUNCTION-TYPE-PARAM-HAS-TYPE))
      (assert-eq (load (p/index (.op-immediates arena) (cast i64 function-type)))
                 (p/ior ir/CALLABLE-TYPE-HAS-TYPE-PARAMETERS
                        ir/CALLABLE-TYPE-HAS-RETURN-TYPE))
      (assert-eq (load (p/index (.op-operand-counts arena) (cast i64 function-type)))
                 (cast u32 5))
      (assert-eq (load (p/index (.opcodes arena) (cast i64 parameters-def)))
                 ir/OP-TS-TYPE-PARAMETERS)
      (assert-eq (load (p/index (.op-immediates arena) (cast i64 this-def)))
                 (p/ior ir/FUNCTION-TYPE-PARAM-THIS
                        ir/FUNCTION-TYPE-PARAM-HAS-TYPE))
      (assert-eq (load (p/index (.op-immediates arena) (cast i64 rest-def)))
                 (p/ior ir/FUNCTION-TYPE-PARAM-REST
                        ir/FUNCTION-TYPE-PARAM-HAS-TYPE))
      (assert-eq (load (p/index (.opcodes arena) (cast i64 return-def)))
                 ir/OP-TS-TYPE-PREDICATE)
      (assert-eq (load (p/index (.op-immediates arena) (cast i64 constructor)))
                 (p/ior ir/CALLABLE-TYPE-HAS-TYPE-PARAMETERS
                        ir/CALLABLE-TYPE-HAS-RETURN-TYPE))
      (assert-eq (load (p/index (.op-immediates arena) (cast i64 abstract-constructor)))
                 (p/ior ir/CALLABLE-TYPE-HAS-RETURN-TYPE
                   (p/ior ir/CALLABLE-TYPE-HAS-TYPE-PARAMETERS
                          ir/CALLABLE-TYPE-ABSTRACT))))
    (let [call-signature (first-opcode-index arena ir/OP-TS-CALL-SIGNATURE)
          construct-signature
            (first-opcode-index arena ir/OP-TS-CONSTRUCT-SIGNATURE)
          omitted-call
            (nth-opcode-index arena ir/OP-TS-CALL-SIGNATURE (cast u32 1))
          omitted-construct
            (nth-opcode-index arena ir/OP-TS-CONSTRUCT-SIGNATURE (cast u32 1))]
      (assert-eq (load (p/index (.op-immediates arena) (cast i64 call-signature)))
                 (p/ior ir/CALLABLE-TYPE-HAS-TYPE-PARAMETERS
                        ir/CALLABLE-TYPE-HAS-RETURN-TYPE))
      (assert-eq (load (p/index (.op-operand-counts arena) (cast i64 call-signature)))
                 (cast u32 3))
      (assert-eq (load (p/index (.op-immediates arena) (cast i64 construct-signature)))
                 (p/ior ir/CALLABLE-TYPE-HAS-TYPE-PARAMETERS
                        ir/CALLABLE-TYPE-HAS-RETURN-TYPE))
      (assert-eq (load (p/index (.op-operand-counts arena)
                    (cast i64 construct-signature))) (cast u32 3))
      (assert-eq (load (p/index (.op-immediates arena) (cast i64 omitted-call)))
                 (cast u64 0))
      (assert-eq (load (p/index (.op-operand-counts arena) (cast i64 omitted-call)))
                 (cast u32 1))
      (assert-eq (load (p/index (.op-immediates arena) (cast i64 omitted-construct)))
                 (cast u64 0))
      (assert-eq (load (p/index (.op-operand-counts arena)
                    (cast i64 omitted-construct))) (cast u32 1)))
    (let [method (first-opcode-index arena ir/OP-TS-METHOD-SIGNATURE)
          quoted-method
            (nth-opcode-index arena ir/OP-TS-METHOD-SIGNATURE (cast u32 1))
          computed-method
            (nth-opcode-index arena ir/OP-TS-METHOD-SIGNATURE (cast u32 2))
          readonly-property
            (nth-opcode-index arena ir/OP-TS-PROPERTY-SIGNATURE (cast u32 2))
          quoted-property
            (nth-opcode-index arena ir/OP-TS-PROPERTY-SIGNATURE (cast u32 3))
          numeric-property
            (nth-opcode-index arena ir/OP-TS-PROPERTY-SIGNATURE (cast u32 4))
          computed-property
            (nth-opcode-index arena ir/OP-TS-PROPERTY-SIGNATURE (cast u32 5))
          computed-method-first
            (load (p/index (.op-first-operands arena) (cast i64 computed-method)))
          computed-method-key
            (load (p/index (.operands arena) (cast i64 computed-method-first)))
          computed-method-key-def
            (load (p/index (.value-def-indices arena) (cast i64 computed-method-key)))
          computed-property-first
            (load (p/index (.op-first-operands arena) (cast i64 computed-property)))
          computed-property-key
            (load (p/index (.operands arena) (cast i64 computed-property-first)))
          computed-property-key-def
            (load (p/index (.value-def-indices arena) (cast i64 computed-property-key)))
          readonly-index (nth-opcode-index arena ir/OP-TS-INDEX-SIGNATURE (cast u32 0))
          mutable-index (nth-opcode-index arena ir/OP-TS-INDEX-SIGNATURE (cast u32 1))
          first-operand
            (load (p/index (.op-first-operands arena) (cast i64 readonly-index)))
          parameter-value
            (load (p/index (.operands arena) (cast i64 first-operand)))
          parameter-def
            (load (p/index (.value-def-indices arena) (cast i64 parameter-value)))]
      (assert-eq (load (p/index (.op-immediates arena) (cast i64 readonly-property)))
                 (p/ior ir/TYPE-MEMBER-HAS-TYPE
                   (p/ior ir/TYPE-MEMBER-OPTIONAL ir/TYPE-MEMBER-READONLY)))
      (assert-eq (- (load (p/index (.op-name-ends arena) (cast i64 quoted-property)))
                    (load (p/index (.op-name-starts arena) (cast i64 quoted-property))))
                 (cast u32 12))
      (assert-eq (- (load (p/index (.op-name-ends arena) (cast i64 numeric-property)))
                    (load (p/index (.op-name-starts arena) (cast i64 numeric-property))))
                 (cast u32 2))
      (assert-eq (- (load (p/index (.op-name-ends arena) (cast i64 quoted-method)))
                    (load (p/index (.op-name-starts arena) (cast i64 quoted-method))))
                 (cast u32 5))
      (assert-eq (load (p/index (.op-immediates arena) (cast i64 computed-method)))
                 (p/ior ir/CALLABLE-TYPE-COMPUTED
                        ir/CALLABLE-TYPE-HAS-RETURN-TYPE))
      (assert-eq (load (p/index (.op-operand-counts arena) (cast i64 computed-method)))
                 (cast u32 2))
      (assert-eq (load (p/index (.opcodes arena) (cast i64 computed-method-key-def)))
                 ir/OP-JS-MEMBER)
      (assert-eq (load (p/index (.op-immediates arena) (cast i64 computed-property)))
                 (p/ior ir/TYPE-MEMBER-HAS-TYPE
                   (p/ior ir/TYPE-MEMBER-OPTIONAL
                     (p/ior ir/TYPE-MEMBER-READONLY ir/TYPE-MEMBER-COMPUTED))))
      (assert-eq (load (p/index (.op-operand-counts arena)
                    (cast i64 computed-property))) (cast u32 2))
      (assert-eq (load (p/index (.opcodes arena) (cast i64 computed-property-key-def)))
                 ir/OP-JS-MEMBER)
      (assert-eq (load (p/index (.op-immediates arena) (cast i64 method)))
                 (p/ior ir/CALLABLE-TYPE-HAS-RETURN-TYPE
                   (p/ior ir/CALLABLE-TYPE-HAS-TYPE-PARAMETERS
                          ir/CALLABLE-TYPE-OPTIONAL)))
      (assert-eq (load (p/index (.op-immediates arena) (cast i64 readonly-index)))
                 ir/TYPE-MEMBER-READONLY)
      (assert-eq (load (p/index (.op-immediates arena) (cast i64 mutable-index)))
                 (cast u64 0))
      (assert-eq (load (p/index (.op-operand-counts arena) (cast i64 readonly-index)))
                 (cast u32 2))
      (assert-eq (load (p/index (.opcodes arena) (cast i64 parameter-def)))
                 ir/OP-TS-FUNCTION-TYPE-PARAMETER))
    (let [plain (nth-opcode-index arena ir/OP-TS-PROPERTY-SIGNATURE (cast u32 6))
          optional (nth-opcode-index arena ir/OP-TS-PROPERTY-SIGNATURE (cast u32 7))
          quoted (nth-opcode-index arena ir/OP-TS-PROPERTY-SIGNATURE (cast u32 8))
          numeric (nth-opcode-index arena ir/OP-TS-PROPERTY-SIGNATURE (cast u32 9))
          computed (nth-opcode-index arena ir/OP-TS-PROPERTY-SIGNATURE (cast u32 10))
          interface-member
            (nth-opcode-index arena ir/OP-TS-PROPERTY-SIGNATURE (cast u32 12))]
      (assert-eq (load (p/index (.op-immediates arena) (cast i64 plain))) (cast u64 0))
      (assert-eq (load (p/index (.op-operand-counts arena) (cast i64 plain)))
                 (cast u32 0))
      (assert-eq (load (p/index (.op-immediates arena) (cast i64 optional)))
                 (p/ior ir/TYPE-MEMBER-OPTIONAL ir/TYPE-MEMBER-READONLY))
      (assert-eq (load (p/index (.op-operand-counts arena) (cast i64 optional)))
                 (cast u32 0))
      (assert-eq (- (load (p/index (.op-name-ends arena) (cast i64 quoted)))
                    (load (p/index (.op-name-starts arena) (cast i64 quoted))))
                 (cast u32 9))
      (assert-eq (- (load (p/index (.op-name-ends arena) (cast i64 numeric)))
                    (load (p/index (.op-name-starts arena) (cast i64 numeric))))
                 (cast u32 1))
      (assert-eq (load (p/index (.op-immediates arena) (cast i64 computed)))
                 (p/ior ir/TYPE-MEMBER-OPTIONAL ir/TYPE-MEMBER-COMPUTED))
      (assert-eq (load (p/index (.op-operand-counts arena) (cast i64 computed)))
                 (cast u32 1))
      (assert-eq (load (p/index (.op-operand-counts arena) (cast i64 interface-member)))
                 (cast u32 0)))
    (let [getter (nth-opcode-index arena ir/OP-TS-METHOD-SIGNATURE (cast u32 3))
          setter (nth-opcode-index arena ir/OP-TS-METHOD-SIGNATURE (cast u32 4))
          computed-getter
            (nth-opcode-index arena ir/OP-TS-METHOD-SIGNATURE (cast u32 5))
          quoted-setter
            (nth-opcode-index arena ir/OP-TS-METHOD-SIGNATURE (cast u32 6))
          omitted-method
            (nth-opcode-index arena ir/OP-TS-METHOD-SIGNATURE (cast u32 7))
          omitted-getter
            (nth-opcode-index arena ir/OP-TS-METHOD-SIGNATURE (cast u32 8))]
      (assert-eq (load (p/index (.op-immediates arena) (cast i64 getter)))
                 (p/ior ir/CALLABLE-TYPE-GETTER
                        ir/CALLABLE-TYPE-HAS-RETURN-TYPE))
      (assert-eq (load (p/index (.op-operand-counts arena) (cast i64 getter)))
                 (cast u32 1))
      (assert-eq (load (p/index (.op-immediates arena) (cast i64 setter)))
                 ir/CALLABLE-TYPE-SETTER)
      (assert-eq (load (p/index (.op-operand-counts arena) (cast i64 setter)))
                 (cast u32 1))
      (assert-eq (load (p/index (.op-immediates arena) (cast i64 computed-getter)))
                 (p/ior ir/CALLABLE-TYPE-HAS-RETURN-TYPE
                   (p/ior ir/CALLABLE-TYPE-GETTER ir/CALLABLE-TYPE-COMPUTED)))
      (assert-eq (load (p/index (.op-operand-counts arena) (cast i64 computed-getter)))
                 (cast u32 2))
      (assert-eq (load (p/index (.op-immediates arena) (cast i64 quoted-setter)))
                 ir/CALLABLE-TYPE-SETTER)
      (assert-eq (load (p/index (.op-immediates arena) (cast i64 omitted-method)))
                 (cast u64 0))
      (assert-eq (load (p/index (.op-operand-counts arena) (cast i64 omitted-method)))
                 (cast u32 1))
      (assert-eq (load (p/index (.op-immediates arena) (cast i64 omitted-getter)))
                 ir/CALLABLE-TYPE-GETTER)
      (assert-eq (load (p/index (.op-operand-counts arena) (cast i64 omitted-getter)))
                 (cast u32 0)))
    (let [interface-op (first-opcode-index arena ir/OP-TS-INTERFACE)
          first-operand
            (load (p/index (.op-first-operands arena) (cast i64 interface-op)))
          parameters-value
            (load (p/index (.operands arena) (cast i64 first-operand)))
          heritage-value
            (load (p/index (.operands arena) (+ (cast i64 first-operand) 1)))
          body-value
            (load (p/index (.operands arena) (+ (cast i64 first-operand) 2)))
          parameters-def
            (load (p/index (.value-def-indices arena) (cast i64 parameters-value)))
          heritage-def
            (load (p/index (.value-def-indices arena) (cast i64 heritage-value)))
          body-def
            (load (p/index (.value-def-indices arena) (cast i64 body-value)))]
      (assert-eq (load (p/index (.op-immediates arena) (cast i64 interface-op)))
                 (p/ior ir/INTERFACE-HAS-TYPE-PARAMETERS
                        ir/INTERFACE-HAS-HERITAGE))
      (assert-eq (load (p/index (.op-operand-counts arena) (cast i64 interface-op)))
                 (cast u32 3))
      (assert-eq (load (p/index (.opcodes arena) (cast i64 parameters-def)))
                 ir/OP-TS-TYPE-PARAMETERS)
      (assert-eq (load (p/index (.opcodes arena) (cast i64 heritage-def)))
                 ir/OP-TS-HERITAGE)
      (assert-eq (load (p/index (.op-operand-counts arena) (cast i64 heritage-def)))
                 (cast u32 2))
      (assert-eq (load (p/index (.opcodes arena) (cast i64 body-def)))
                 ir/OP-TS-TYPE-LITERAL))
    (store! verify-scratch
      (ir/VerifyScratch :dominators (p/cast (ptr u64) verify-bits)
                        :dominator-word-capacity 8))
    (let [verified (ir/verify-ir arena verify-scratch)]
      (assert-eq (.error verified) ir/VERIFY-OK))
    ;; A typed property must point to a type value. Computed keys remain runtime
    ;; expression operands, while an untyped property deliberately has no type edge.
    (let [typed-property
            (nth-opcode-index arena ir/OP-TS-PROPERTY-SIGNATURE (cast u32 0))
          typed-first
            (load (p/index (.op-first-operands arena) (cast i64 typed-property)))
          original-type
            (load (p/index (.operands arena) (cast i64 typed-first)))
          runtime-member (first-opcode-index arena ir/OP-JS-MEMBER)
          runtime-value
            (load (p/index (.op-first-results arena) (cast i64 runtime-member)))]
      (store! (p/index (.operands arena) (cast i64 typed-first)) runtime-value)
      (let [invalid (ir/verify-ir arena verify-scratch)]
        (assert-eq (.error invalid) ir/VERIFY-TYPE-OPERAND))
      (store! (p/index (.operands arena) (cast i64 typed-first)) original-type)
      (let [restored (ir/verify-ir arena verify-scratch)]
        (assert-eq (.error restored) ir/VERIFY-OK)))
    (let [typed-method (first-opcode-index arena ir/OP-TS-METHOD-SIGNATURE)
          method-first
            (load (p/index (.op-first-operands arena) (cast i64 typed-method)))
          method-count
            (load (p/index (.op-operand-counts arena) (cast i64 typed-method)))
          return-index (+ method-first (- method-count (cast u32 1)))
          original-return
            (load (p/index (.operands arena) (cast i64 return-index)))
          runtime-member (first-opcode-index arena ir/OP-JS-MEMBER)
          runtime-value
            (load (p/index (.op-first-results arena) (cast i64 runtime-member)))]
      (store! (p/index (.operands arena) (cast i64 return-index)) runtime-value)
      (let [invalid (ir/verify-ir arena verify-scratch)]
        (assert-eq (.error invalid) ir/VERIFY-TYPE-OPERAND))
      (store! (p/index (.operands arena) (cast i64 return-index)) original-return)
      (let [restored (ir/verify-ir arena verify-scratch)]
        (assert-eq (.error restored) ir/VERIFY-OK))))
  0)

(deftest test-text-directly-to-verified-ssa
  (let [text "const x = 1 + 2; return x;"
        events (p/alloc-stack (array u32 64))
        memory (p/alloc-stack (array u64 2048))
        arena (p/alloc-stack ir/IrArena)
        builder-scratch (p/alloc-stack builder/BuilderScratch)
        ir-builder (p/alloc-stack builder/IrBuilder)
        parser-values (p/alloc-stack (array u32 64))
        parser-scratch (p/alloc-stack parser/DirectParserScratch)
        verify-bits (p/alloc-stack (array u64 4))
        verify-scratch (p/alloc-stack ir/VerifyScratch)
        output (p/alloc-stack (array u8 1024))
        js-output (p/alloc-stack (array u8 1024))
        roundtrip-events (p/alloc-stack (array u32 64))
        roundtrip-memory (p/alloc-stack (array u64 2048))
        roundtrip-arena (p/alloc-stack ir/IrArena)
        roundtrip-builder-scratch (p/alloc-stack builder/BuilderScratch)
        roundtrip-builder (p/alloc-stack builder/IrBuilder)
        roundtrip-parser-values (p/alloc-stack (array u32 64))
        roundtrip-parser-scratch (p/alloc-stack parser/DirectParserScratch)
        caps (builder/BuilderCapacities
          :regions (cast u32 4) :region-block-refs (cast u32 8)
          :blocks (cast u32 8) :block-op-refs (cast u32 32)
          :ops (cast u32 32) :op-region-refs (cast u32 4)
          :values (cast u32 32) :operands (cast u32 64)
          :successors (cast u32 16) :successor-args (cast u32 16)
          :scopes (cast u32 8) :bindings (cast u32 16)
          :references (cast u32 32) :captures (cast u32 8))
        initialized (storage/initialize! arena builder-scratch ir-builder
                      (p/cast (ptr u8) memory) 16384 (cast u32 (len text)) caps)
        tape-result (pipeline/scan-source-to-parse-tape64
          (slice-data text) (len text) (cast u32 0) (p/cast (ptr u32) events)
          (frontend/frontend-initial-state))]
    (assert-eq (.error initialized) storage/STORAGE-OK)
    (store! parser-scratch (parser/DirectParserScratch
      :values (p/cast (ptr u32) parser-values) :value-capacity 64 :value-count 0))
    (assert (<= (.bytes-used initialized) (storage/required-bytes caps)))
    (let [parsed (parser/parse-direct-program!
                   (slice-data text) (len text) (p/cast (ptr u32) events)
                   (.count tape-result) ir-builder parser-scratch)]
      (assert-eq (.error parsed) parser/DIRECT-PARSE-OK)
      (assert-eq (.consumed-events parsed) (.count tape-result)))
    (assert-eq (.region-count arena) (cast u32 1))
    (assert-eq (.block-count arena) (cast u32 1))
    (assert-eq (.op-count arena) (cast u32 6))
    (assert-eq (.value-count arena) (cast u32 4))
    (assert-eq (.binding-count arena) (cast u32 1))
    (assert-eq (.reference-count arena) (cast u32 1))
    (assert-eq (load (p/index (.opcodes arena) 2)) ir/OP-JS-BINARY)
    (assert-eq (load (p/index (.op-immediates arena) 2)) (cast u64 43))
    (assert-eq (load (p/index (.reference-bindings arena) 0)) (cast u32 0))
    (store! verify-scratch
      (ir/VerifyScratch :dominators (p/cast (ptr u64) verify-bits)
                        :dominator-word-capacity 4))
    (let [verified (ir/verify-ir arena verify-scratch)]
      (assert-eq (.error verified) ir/VERIFY-OK))
    (store! (p/index (.reference-bindings arena) 0) (cast u32 99))
    (let [invalid (ir/verify-ir arena verify-scratch)]
      (assert-eq (.error invalid) ir/VERIFY-REFERENCE))
    (store! (p/index (.reference-bindings arena) 0) (cast u32 0))
    (let [printed (ir/print-ir! arena (slice-data text) (p/cast (ptr u8) output) 1024)
          expected "source_size 26\nregion 0 parent(none) {\n^0():\n  %0 = js.number loc(10:11)\n  %1 = js.number loc(14:15)\n  %2 = js.binary imm(43) %0, %1 loc(10:15)\n  js.declare kind(1) name(6:7) %2 loc(0:16)\n  %3 = js.identifier loc(24:25)\n  js.return %3 loc(17:26)\n}\nscope 0 parent(none) loc(0:26)\nbinding 0 scope(0) name(6:7)\nreference 0 binding(0) loc(24:25)\n"]
      (assert-eq (.error printed) ir/PRINT-OK)
      (assert (byte-eq? (p/cast (ptr u8) output) expected (.count printed))))
    ;; Normalize back to JavaScript, parse that text directly again, and
    ;; compare semantic planes while intentionally ignoring changed locations.
    (let [js-result (js/print-linear-program! arena (slice-data text)
                                               (p/cast (ptr u8) js-output) 1024)
          expected-js "const x = (1 + 2);\nreturn x;\n"]
      (assert-eq (.error js-result) js/JS-PRINT-OK)
      (assert (byte-eq? (p/cast (ptr u8) js-output) expected-js (.count js-result)))
      (let [roundtrip-init (storage/initialize!
                             roundtrip-arena roundtrip-builder-scratch roundtrip-builder
                             (p/cast (ptr u8) roundtrip-memory) 16384
                             (cast u32 (.count js-result)) caps)
            roundtrip-tape (pipeline/scan-source-to-parse-tape64
                             (p/cast (ptr u8) js-output) (.count js-result) (cast u32 0)
                             (p/cast (ptr u32) roundtrip-events)
                             (frontend/frontend-initial-state))]
        (assert-eq (.error roundtrip-init) storage/STORAGE-OK)
        (store! roundtrip-parser-scratch (parser/DirectParserScratch
          :values (p/cast (ptr u32) roundtrip-parser-values)
          :value-capacity 64 :value-count 0))
        (let [roundtrip (parser/parse-direct-program!
                          (p/cast (ptr u8) js-output) (.count js-result)
                          (p/cast (ptr u32) roundtrip-events) (.count roundtrip-tape)
                          roundtrip-builder roundtrip-parser-scratch)]
          (assert-eq (.error roundtrip) parser/DIRECT-PARSE-OK))
        (assert-eq (.op-count roundtrip-arena) (.op-count arena))
        (assert-eq (.value-count roundtrip-arena) (.value-count arena))
        (assert-eq (.binding-count roundtrip-arena) (.binding-count arena))
        (assert-eq (.reference-count roundtrip-arena) (.reference-count arena))
        (let [(mut op) (cast u32 0)]
          (loop
            (if (>= (load op) (.op-count arena)) (break)
              (do
                (assert-eq (load (p/index (.opcodes roundtrip-arena) (cast i64 (load op))))
                           (load (p/index (.opcodes arena) (cast i64 (load op)))))
                (assert-eq (load (p/index (.op-immediates roundtrip-arena)
                                          (cast i64 (load op))))
                           (load (p/index (.op-immediates arena) (cast i64 (load op)))))
                (assert-eq (load (p/index (.op-operand-counts roundtrip-arena)
                                          (cast i64 (load op))))
                           (load (p/index (.op-operand-counts arena) (cast i64 (load op)))))
                (set! op (+ (load op) (cast u32 1)))))))
        (let [(mut operand) (cast u32 0)]
          (loop
            (if (>= (load operand) (.operand-count arena)) (break)
              (do
                (assert-eq (load (p/index (.operands roundtrip-arena)
                                          (cast i64 (load operand))))
                           (load (p/index (.operands arena) (cast i64 (load operand)))))
                (set! operand (+ (load operand) (cast u32 1)))))))))
  0))

(deftest test-storage_capacity_is_nonwriting
  (let [memory (p/alloc-stack (array u64 1))
        arena (p/alloc-stack ir/IrArena)
        scratch (p/alloc-stack builder/BuilderScratch)
        ir-builder (p/alloc-stack builder/IrBuilder)
        caps (builder/BuilderCapacities
          :regions (cast u32 2) :region-block-refs (cast u32 2)
          :blocks (cast u32 2) :block-op-refs (cast u32 2)
          :ops (cast u32 2) :op-region-refs (cast u32 2)
          :values (cast u32 2) :operands (cast u32 2)
          :successors (cast u32 2) :successor-args (cast u32 2)
          :scopes (cast u32 2) :bindings (cast u32 2)
          :references (cast u32 2) :captures (cast u32 2))
        result (storage/initialize! arena scratch ir-builder
                 (p/cast (ptr u8) memory) 8 (cast u32 0) caps)]
    (assert-eq (.error result) storage/STORAGE-CAPACITY))
  0)

(deftest test-if-else-builds-real-cfg
  (let [text "const x = 1; if (x) { x; } else { 2; } return x;"
        events (p/alloc-stack (array u32 128))
        memory (p/alloc-stack (array u64 4096))
        arena (p/alloc-stack ir/IrArena)
        builder-scratch (p/alloc-stack builder/BuilderScratch)
        ir-builder (p/alloc-stack builder/IrBuilder)
        parser-values (p/alloc-stack (array u32 128))
        parser-scratch (p/alloc-stack parser/DirectParserScratch)
        verify-bits (p/alloc-stack (array u64 16))
        verify-scratch (p/alloc-stack ir/VerifyScratch)
        canonical-a (p/alloc-stack (array u8 4096))
        canonical-b (p/alloc-stack (array u8 4096))
        roundtrip-memory (p/alloc-stack (array u64 4096))
        roundtrip-arena (p/alloc-stack ir/IrArena)
        roundtrip-builder-scratch (p/alloc-stack builder/BuilderScratch)
        roundtrip-builder (p/alloc-stack builder/IrBuilder)
        roundtrip-verify-bits (p/alloc-stack (array u64 16))
        roundtrip-verify-scratch (p/alloc-stack ir/VerifyScratch)
        caps (builder/BuilderCapacities
          :regions (cast u32 4) :region-block-refs (cast u32 16)
          :blocks (cast u32 16) :block-op-refs (cast u32 64)
          :ops (cast u32 64) :op-region-refs (cast u32 4)
          :values (cast u32 64) :operands (cast u32 128)
          :successors (cast u32 32) :successor-args (cast u32 32)
          :scopes (cast u32 16) :bindings (cast u32 32)
          :references (cast u32 64) :captures (cast u32 16))
        initialized (storage/initialize! arena builder-scratch ir-builder
                      (p/cast (ptr u8) memory) 32768 (cast u32 (len text)) caps)
        tape-result (pipeline/scan-source-to-parse-tape64
          (slice-data text) (len text) (cast u32 0) (p/cast (ptr u32) events)
          (frontend/frontend-initial-state))]
    (assert-eq (.error initialized) storage/STORAGE-OK)
    (store! parser-scratch (parser/DirectParserScratch
      :values (p/cast (ptr u32) parser-values) :value-capacity 128 :value-count 0))
    (let [parsed (parser/parse-direct-program!
                   (slice-data text) (len text) (p/cast (ptr u32) events)
                   (.count tape-result) ir-builder parser-scratch)]
      (assert-eq (.error parsed) parser/DIRECT-PARSE-OK)
      (assert-eq (.consumed-events parsed) (.count tape-result)))
    (assert-eq (.region-count arena) (cast u32 1))
    (assert-eq (.block-count arena) (cast u32 4))
    (assert-eq (.op-count arena) (cast u32 12))
    (assert-eq (.value-count arena) (cast u32 5))
    (assert-eq (.scope-count arena) (cast u32 3))
    (assert-eq (.reference-count arena) (cast u32 3))
    (assert-eq (.successor-count arena) (cast u32 4))
    (assert-eq (load (p/index (.successor-blocks arena) 0)) (cast u32 1))
    (assert-eq (load (p/index (.successor-blocks arena) 1)) (cast u32 2))
    (assert-eq (load (p/index (.successor-blocks arena) 2)) (cast u32 3))
    (assert-eq (load (p/index (.successor-blocks arena) 3)) (cast u32 3))
    ;; Branch terminators were appended after parsing both bodies. Membership
    ;; pools retain semantic block order despite interleaved physical op ids.
    (assert-eq (ir/block-op-at arena (cast u32 1) (cast u32 2)) (cast u32 8))
    (assert-eq (ir/block-op-at arena (cast u32 2) (cast u32 2)) (cast u32 9))
    (store! verify-scratch
      (ir/VerifyScratch :dominators (p/cast (ptr u64) verify-bits)
                        :dominator-word-capacity 16))
    (let [verified (ir/verify-ir arena verify-scratch)]
      (assert-eq (.error verified) ir/VERIFY-OK))
    ;; A multi-block CFG must survive the canonical textual form exactly,
    ;; including reciprocal successor targets and lexical metadata.
    (let [first-print (ir/print-ir! arena (slice-data text)
                                     (p/cast (ptr u8) canonical-a) 4096)
          initialized-roundtrip (storage/initialize!
                                  roundtrip-arena roundtrip-builder-scratch
                                  roundtrip-builder
                                  (p/cast (ptr u8) roundtrip-memory) 32768
                                  (cast u32 0) caps)]
      (assert-eq (.error first-print) ir/PRINT-OK)
      (assert-eq (.error initialized-roundtrip) storage/STORAGE-OK)
      (let [parsed-ir (ir-text/parse-ir-text! (p/cast (ptr u8) canonical-a)
                                               (.count first-print)
                                               roundtrip-builder)]
        (assert-eq (.error parsed-ir) ir-text/IR-TEXT-OK))
      (store! roundtrip-verify-scratch
        (ir/VerifyScratch :dominators (p/cast (ptr u64) roundtrip-verify-bits)
                          :dominator-word-capacity 16))
      (let [verified-roundtrip (ir/verify-ir roundtrip-arena
                                              roundtrip-verify-scratch)]
        (assert-eq (.error verified-roundtrip) ir/VERIFY-OK))
      (let [second-print (ir/print-ir! roundtrip-arena
                           (p/cast (ptr u8) canonical-a)
                           (p/cast (ptr u8) canonical-b) 4096)]
        (assert-eq (.error second-print) ir/PRINT-OK)
        (assert-eq (.count second-print) (.count first-print))
        (assert (ptr-byte-eq? (p/cast (ptr u8) canonical-a)
                              (p/cast (ptr u8) canonical-b)
                              (.count first-print))))))
  0)

(deftest test-conditional-expression-uses-block-parameter
  ;; Leave the join block unterminated so the program-root generator must put
  ;; its fallthrough terminator on the active join, never back on the entry.
  (let [text "const x = c ? 1 : 2;"
        events (p/alloc-stack (array u32 64))
        memory (p/alloc-stack (array u64 2048))
        arena (p/alloc-stack ir/IrArena)
        builder-scratch (p/alloc-stack builder/BuilderScratch)
        ir-builder (p/alloc-stack builder/IrBuilder)
        parser-values (p/alloc-stack (array u32 64))
        parser-scratch (p/alloc-stack parser/DirectParserScratch)
        verify-bits (p/alloc-stack (array u64 16))
        verify-scratch (p/alloc-stack ir/VerifyScratch)
        caps (builder/BuilderCapacities
          :regions (cast u32 2) :region-block-refs (cast u32 8)
          :blocks (cast u32 8) :block-op-refs (cast u32 32)
          :ops (cast u32 32) :op-region-refs (cast u32 2)
          :values (cast u32 32) :operands (cast u32 32)
          :successors (cast u32 16) :successor-args (cast u32 16)
          :scopes (cast u32 4) :bindings (cast u32 4)
          :references (cast u32 8) :captures (cast u32 4))
        initialized (storage/initialize! arena builder-scratch ir-builder
                      (p/cast (ptr u8) memory) 16384 (cast u32 (len text)) caps)
        tape-result (pipeline/scan-source-to-parse-tape64
          (slice-data text) (len text) (cast u32 0) (p/cast (ptr u32) events)
          (frontend/frontend-initial-state))]
    (assert-eq (.error initialized) storage/STORAGE-OK)
    (store! parser-scratch (parser/DirectParserScratch
      :values (p/cast (ptr u32) parser-values) :value-capacity 64 :value-count 0))
    (let [parsed (parser/parse-direct-program!
                   (slice-data text) (len text) (p/cast (ptr u32) events)
                   (.count tape-result) ir-builder parser-scratch)]
      (assert-eq (.error parsed) parser/DIRECT-PARSE-OK))
    (assert-eq (.block-count arena) (cast u32 4))
    (assert-eq (.value-count arena) (cast u32 4))
    (assert-eq (.successor-count arena) (cast u32 4))
    (assert-eq (.successor-arg-count arena) (cast u32 2))
    (assert-eq (load (p/index (.block-param-counts arena) 3)) (cast u32 1))
    (let [parameter (load (p/index (.block-first-params arena) 3))]
      (assert-eq parameter (cast u32 3))
      (assert-eq (load (p/index (.value-def-kinds arena) (cast i64 parameter)))
                 ir/DEF-BLOCK-PARAM)
      (assert-eq (load (p/index (.operands arena) 1)) parameter))
    (assert-eq (load (p/index (.successor-args arena) 0)) (cast u32 1))
    (assert-eq (load (p/index (.successor-args arena) 1)) (cast u32 2))
    (store! verify-scratch
      (ir/VerifyScratch :dominators (p/cast (ptr u64) verify-bits)
                        :dominator-word-capacity 16))
    (let [verified (ir/verify-ir arena verify-scratch)]
      (assert-eq (.error verified) ir/VERIFY-OK)))
  0)

(deftest test-while-builds-cyclic-cfg
  (let [text "let x = 1; while (x) { x = x - 1; } return x;"
        events (p/alloc-stack (array u32 128))
        memory (p/alloc-stack (array u64 4096))
        arena (p/alloc-stack ir/IrArena)
        builder-scratch (p/alloc-stack builder/BuilderScratch)
        ir-builder (p/alloc-stack builder/IrBuilder)
        parser-values (p/alloc-stack (array u32 128))
        parser-scratch (p/alloc-stack parser/DirectParserScratch)
        verify-bits (p/alloc-stack (array u64 16))
        verify-scratch (p/alloc-stack ir/VerifyScratch)
        caps (builder/BuilderCapacities
          :regions (cast u32 4) :region-block-refs (cast u32 16)
          :blocks (cast u32 16) :block-op-refs (cast u32 64)
          :ops (cast u32 64) :op-region-refs (cast u32 4)
          :values (cast u32 64) :operands (cast u32 128)
          :successors (cast u32 32) :successor-args (cast u32 32)
          :scopes (cast u32 16) :bindings (cast u32 32)
          :references (cast u32 64) :captures (cast u32 16))
        initialized (storage/initialize! arena builder-scratch ir-builder
                      (p/cast (ptr u8) memory) 32768 (cast u32 (len text)) caps)
        tape-result (pipeline/scan-source-to-parse-tape64
          (slice-data text) (len text) (cast u32 0) (p/cast (ptr u32) events)
          (frontend/frontend-initial-state))]
    (assert-eq (.error initialized) storage/STORAGE-OK)
    (store! parser-scratch (parser/DirectParserScratch
      :values (p/cast (ptr u32) parser-values) :value-capacity 128 :value-count 0))
    (let [parsed (parser/parse-direct-program!
                   (slice-data text) (len text) (p/cast (ptr u32) events)
                   (.count tape-result) ir-builder parser-scratch)]
      (assert-eq (.error parsed) parser/DIRECT-PARSE-OK)
      (assert-eq (.consumed-events parsed) (.count tape-result)))
    (assert-eq (.region-count arena) (cast u32 1))
    (assert-eq (.block-count arena) (cast u32 4))
    (assert-eq (.op-count arena) (cast u32 14))
    (assert-eq (.value-count arena) (cast u32 8))
    (assert-eq (.scope-count arena) (cast u32 2))
    (assert-eq (.binding-count arena) (cast u32 1))
    (assert-eq (.reference-count arena) (cast u32 4))
    (assert-eq (.successor-count arena) (cast u32 4))
    ;; Entry → header, header → body/exit, and the body backedge → header.
    (assert-eq (load (p/index (.successor-blocks arena) 0)) (cast u32 1))
    (assert-eq (load (p/index (.successor-blocks arena) 1)) (cast u32 2))
    (assert-eq (load (p/index (.successor-blocks arena) 2)) (cast u32 3))
    (assert-eq (load (p/index (.successor-blocks arena) 3)) (cast u32 1))
    (assert-eq (load (p/index (.opcodes arena) 2)) ir/OP-BR)
    (assert-eq (load (p/index (.opcodes arena) 4)) ir/OP-COND-BR)
    (assert-eq (load (p/index (.opcodes arena) 11)) ir/OP-BR)
    (store! verify-scratch
      (ir/VerifyScratch :dominators (p/cast (ptr u64) verify-bits)
                        :dominator-word-capacity 16))
    (let [verified (ir/verify-ir arena verify-scratch)]
      (assert-eq (.error verified) ir/VERIFY-OK)))
  0)

(deftest test-canonical-ir-text-roundtrip
  (let [text "try { return c ? a.x : {item: [b.y]}; } catch (error) { throw error; }"
        events (p/alloc-stack (array u32 64))
        memory-a (p/alloc-stack (array u64 2048))
        memory-b (p/alloc-stack (array u64 2048))
        arena-a (p/alloc-stack ir/IrArena) arena-b (p/alloc-stack ir/IrArena)
        scratch-a (p/alloc-stack builder/BuilderScratch)
        scratch-b (p/alloc-stack builder/BuilderScratch)
        builder-a (p/alloc-stack builder/IrBuilder)
        builder-b (p/alloc-stack builder/IrBuilder)
        parser-values (p/alloc-stack (array u32 64))
        parser-scratch (p/alloc-stack parser/DirectParserScratch)
        printed-a (p/alloc-stack (array u8 2048))
        printed-b (p/alloc-stack (array u8 2048))
        caps (builder/BuilderCapacities
          :regions (cast u32 4) :region-block-refs (cast u32 16)
          :blocks (cast u32 16) :block-op-refs (cast u32 64)
          :ops (cast u32 64) :op-region-refs (cast u32 8)
          :values (cast u32 64) :operands (cast u32 128)
          :successors (cast u32 32) :successor-args (cast u32 32)
          :scopes (cast u32 16) :bindings (cast u32 16)
          :references (cast u32 32) :captures (cast u32 16))
        init-a (storage/initialize! arena-a scratch-a builder-a
                 (p/cast (ptr u8) memory-a) 16384 (cast u32 (len text)) caps)
        tape-result (pipeline/scan-source-to-parse-tape64
          (slice-data text) (len text) (cast u32 0) (p/cast (ptr u32) events)
          (frontend/frontend-initial-state))]
    (assert-eq (.error init-a) storage/STORAGE-OK)
    (store! parser-scratch (parser/DirectParserScratch
      :values (p/cast (ptr u32) parser-values) :value-capacity 64 :value-count 0))
    (let [parsed (parser/parse-direct-program! (slice-data text) (len text)
                   (p/cast (ptr u32) events) (.count tape-result)
                   builder-a parser-scratch)]
      (assert-eq (.error parsed) parser/DIRECT-PARSE-OK))
    (let [first-print (ir/print-ir! arena-a (slice-data text)
                                    (p/cast (ptr u8) printed-a) 2048)]
      (assert-eq (.error first-print) ir/PRINT-OK)
      (let [init-b (storage/initialize! arena-b scratch-b builder-b
                     (p/cast (ptr u8) memory-b) 16384 (cast u32 0) caps)]
        (assert-eq (.error init-b) storage/STORAGE-OK)
        (let [parsed-ir (ir-text/parse-ir-text! (p/cast (ptr u8) printed-a)
                                                (.count first-print) builder-b)]
          (assert-eq (.error parsed-ir) ir-text/IR-TEXT-OK)
          (assert-eq (.consumed parsed-ir) (.count first-print)))
        (let [second-print (ir/print-ir! arena-b (p/cast (ptr u8) printed-a)
                                         (p/cast (ptr u8) printed-b) 2048)]
          (assert-eq (.error second-print) ir/PRINT-OK)
          (assert-eq (.count second-print) (.count first-print))
          (assert (ptr-byte-eq? (p/cast (ptr u8) printed-b)
                                (p/cast (ptr u8) printed-a)
                                (.count second-print)))))))
  0)

(deftest test-unary-nested-calls-and-assignment
  (let [text "const x = -foo(1, bar(2)); x = bar(3);"
        events (p/alloc-stack (array u32 128))
        memory (p/alloc-stack (array u64 4096))
        arena (p/alloc-stack ir/IrArena)
        builder-scratch (p/alloc-stack builder/BuilderScratch)
        ir-builder (p/alloc-stack builder/IrBuilder)
        parser-values (p/alloc-stack (array u32 64))
        parser-scratch (p/alloc-stack parser/DirectParserScratch)
        verify-bits (p/alloc-stack (array u64 4))
        verify-scratch (p/alloc-stack ir/VerifyScratch)
        js-output (p/alloc-stack (array u8 256))
        caps (builder/BuilderCapacities
          :regions (cast u32 2) :region-block-refs (cast u32 4)
          :blocks (cast u32 4) :block-op-refs (cast u32 32)
          :ops (cast u32 32) :op-region-refs (cast u32 2)
          :values (cast u32 32) :operands (cast u32 64)
          :successors (cast u32 8) :successor-args (cast u32 8)
          :scopes (cast u32 4) :bindings (cast u32 8)
          :references (cast u32 16) :captures (cast u32 4))
        initialized (storage/initialize! arena builder-scratch ir-builder
                      (p/cast (ptr u8) memory) 32768 (cast u32 (len text)) caps)
        tape-result (pipeline/scan-source-to-parse-tape64
          (slice-data text) (len text) (cast u32 0) (p/cast (ptr u32) events)
          (frontend/frontend-initial-state))]
    (assert-eq (.error initialized) storage/STORAGE-OK)
    (store! parser-scratch (parser/DirectParserScratch
      :values (p/cast (ptr u32) parser-values) :value-capacity 64 :value-count 0))
    (let [parsed (parser/parse-direct-program! (slice-data text) (len text)
                   (p/cast (ptr u32) events) (.count tape-result)
                   ir-builder parser-scratch)]
      (assert-eq (.error parsed) parser/DIRECT-PARSE-OK))
    (assert-eq (.op-count arena) (cast u32 15))
    (assert-eq (.value-count arena) (cast u32 12))
    (assert-eq (.operand-count arena) (cast u32 12))
    (assert-eq (load (p/index (.opcodes arena) 4)) ir/OP-JS-CALL)
    (assert-eq (load (p/index (.opcodes arena) 5)) ir/OP-JS-CALL)
    (assert-eq (load (p/index (.opcodes arena) 6)) ir/OP-JS-UNARY)
    (assert-eq (load (p/index (.op-immediates arena) 6)) (cast u64 45))
    (assert-eq (load (p/index (.opcodes arena) 11)) ir/OP-JS-CALL)
    (assert-eq (load (p/index (.opcodes arena) 12)) ir/OP-JS-ASSIGN)
    (assert-eq (load (p/index (.op-immediates arena) 12)) (cast u64 61))
    (store! verify-scratch
      (ir/VerifyScratch :dominators (p/cast (ptr u64) verify-bits)
                        :dominator-word-capacity 4))
    (let [verified (ir/verify-ir arena verify-scratch)]
      (assert-eq (.error verified) ir/VERIFY-OK))
    (let [printed (js/print-linear-program! arena (slice-data text)
                                             (p/cast (ptr u8) js-output) 256)
          expected "const x = -foo(1, bar(2));\nx = bar(3);\n"]
      (assert-eq (.error printed) js/JS-PRINT-OK)
      (assert (byte-eq? (p/cast (ptr u8) js-output) expected (.count printed)))))
  0)

(deftest test-function-region-capture-member-and-aggregates
  (let [text "const x = 1; function f(a) { return x + a; } f({items: [2, [3, 4]]}).value;"
        events (p/alloc-stack (array u32 128))
        memory (p/alloc-stack (array u64 4096))
        arena (p/alloc-stack ir/IrArena)
        builder-scratch (p/alloc-stack builder/BuilderScratch)
        ir-builder (p/alloc-stack builder/IrBuilder)
        parser-values (p/alloc-stack (array u32 64))
        parser-scratch (p/alloc-stack parser/DirectParserScratch)
        verify-bits (p/alloc-stack (array u64 8))
        verify-scratch (p/alloc-stack ir/VerifyScratch)
        js-output (p/alloc-stack (array u8 256))
        roundtrip-events (p/alloc-stack (array u32 128))
        roundtrip-memory (p/alloc-stack (array u64 4096))
        roundtrip-arena (p/alloc-stack ir/IrArena)
        roundtrip-builder-scratch (p/alloc-stack builder/BuilderScratch)
        roundtrip-builder (p/alloc-stack builder/IrBuilder)
        roundtrip-parser-values (p/alloc-stack (array u32 64))
        roundtrip-parser-scratch (p/alloc-stack parser/DirectParserScratch)
        roundtrip-verify-bits (p/alloc-stack (array u64 8))
        roundtrip-verify-scratch (p/alloc-stack ir/VerifyScratch)
        caps (builder/BuilderCapacities
          :regions (cast u32 8) :region-block-refs (cast u32 16)
          :blocks (cast u32 16) :block-op-refs (cast u32 64)
          :ops (cast u32 64) :op-region-refs (cast u32 16)
          :values (cast u32 64) :operands (cast u32 128)
          :successors (cast u32 16) :successor-args (cast u32 16)
          :scopes (cast u32 16) :bindings (cast u32 32)
          :references (cast u32 64) :captures (cast u32 16))
        initialized (storage/initialize! arena builder-scratch ir-builder
                      (p/cast (ptr u8) memory) 32768 (cast u32 (len text)) caps)
        tape-result (pipeline/scan-source-to-parse-tape64
          (slice-data text) (len text) (cast u32 0) (p/cast (ptr u32) events)
          (frontend/frontend-initial-state))]
    (assert-eq (.error initialized) storage/STORAGE-OK)
    (store! parser-scratch (parser/DirectParserScratch
      :values (p/cast (ptr u32) parser-values) :value-capacity 64 :value-count 0))
    (let [parsed (parser/parse-direct-program! (slice-data text) (len text)
                   (p/cast (ptr u32) events) (.count tape-result)
                   ir-builder parser-scratch)]
      (assert-eq (.error parsed) parser/DIRECT-PARSE-OK))
    (assert-eq (.region-count arena) (cast u32 2))
    (assert-eq (.block-count arena) (cast u32 2))
    (assert-eq (.scope-count arena) (cast u32 3))
    (assert-eq (.binding-count arena) (cast u32 3))
    (assert-eq (.reference-count arena) (cast u32 3))
    (assert-eq (.capture-count arena) (cast u32 1))
    (assert-eq (load (p/index (.region-parent-ops arena) 1)) (cast u32 2))
    (assert-eq (load (p/index (.opcodes arena) 2)) ir/OP-JS-FUNCTION)
    (assert-eq (load (p/index (.opcodes arena) 11)) ir/OP-JS-ARRAY)
    (assert-eq (load (p/index (.op-operand-counts arena) 11)) (cast u32 2))
    (assert-eq (load (p/index (.opcodes arena) 12)) ir/OP-JS-ARRAY)
    (assert-eq (load (p/index (.op-operand-counts arena) 12)) (cast u32 2))
    (assert-eq (load (p/index (.opcodes arena) 13)) ir/OP-JS-PROPERTY)
    (assert-eq (load (p/index (.op-name-starts arena) 13)) (cast u32 48))
    (assert-eq (load (p/index (.op-name-ends arena) 13)) (cast u32 53))
    (assert-eq (load (p/index (.opcodes arena) 14)) ir/OP-JS-OBJECT)
    (assert-eq (load (p/index (.opcodes arena) 16)) ir/OP-JS-MEMBER)
    (assert-eq (load (p/index (.op-name-starts arena) 16)) (cast u32 69))
    (assert-eq (load (p/index (.op-name-ends arena) 16)) (cast u32 74))
    (assert-eq (load (p/index (.capture-scopes arena) 0)) (cast u32 1))
    (assert-eq (load (p/index (.capture-bindings arena) 0)) (cast u32 0))
    (store! verify-scratch
      (ir/VerifyScratch :dominators (p/cast (ptr u64) verify-bits)
                        :dominator-word-capacity 8))
    (let [verified (ir/verify-ir arena verify-scratch)]
      (assert-eq (.error verified) ir/VERIFY-OK))
    (let [printed (js/print-linear-program! arena (slice-data text)
                                             (p/cast (ptr u8) js-output) 256)
          expected "const x = 1;\nfunction f(a) {\nreturn (x + a);\n}\nf({items: [2, [3, 4]]}).value;\n"]
      (assert-eq (.error printed) js/JS-PRINT-OK)
      (assert (byte-eq? (p/cast (ptr u8) js-output) expected (.count printed)))
      (let [roundtrip-init (storage/initialize!
                             roundtrip-arena roundtrip-builder-scratch roundtrip-builder
                             (p/cast (ptr u8) roundtrip-memory) 32768
                             (cast u32 (.count printed)) caps)
            roundtrip-tape (pipeline/scan-source-to-parse-tape64
                             (p/cast (ptr u8) js-output) (.count printed) (cast u32 0)
                             (p/cast (ptr u32) roundtrip-events)
                             (frontend/frontend-initial-state))]
        (assert-eq (.error roundtrip-init) storage/STORAGE-OK)
        (store! roundtrip-parser-scratch (parser/DirectParserScratch
          :values (p/cast (ptr u32) roundtrip-parser-values)
          :value-capacity 64 :value-count 0))
        (let [roundtrip (parser/parse-direct-program!
                          (p/cast (ptr u8) js-output) (.count printed)
                          (p/cast (ptr u32) roundtrip-events) (.count roundtrip-tape)
                          roundtrip-builder roundtrip-parser-scratch)]
          (assert-eq (.error roundtrip) parser/DIRECT-PARSE-OK))
        (assert-eq (.region-count roundtrip-arena) (.region-count arena))
        (assert-eq (.block-count roundtrip-arena) (.block-count arena))
        (assert-eq (.op-count roundtrip-arena) (.op-count arena))
        (assert-eq (.value-count roundtrip-arena) (.value-count arena))
        (assert-eq (.scope-count roundtrip-arena) (.scope-count arena))
        (assert-eq (.binding-count roundtrip-arena) (.binding-count arena))
        (assert-eq (.reference-count roundtrip-arena) (.reference-count arena))
        (assert-eq (.capture-count roundtrip-arena) (.capture-count arena))
        (store! roundtrip-verify-scratch
          (ir/VerifyScratch :dominators (p/cast (ptr u64) roundtrip-verify-bits)
                            :dominator-word-capacity 8))
        (let [verified-roundtrip (ir/verify-ir roundtrip-arena
                                                roundtrip-verify-scratch)]
          (assert-eq (.error verified-roundtrip) ir/VERIFY-OK)))))
  0)

(deftest test-binding-cache-respects-scope-exit
  (let [text "const x = 1; function f(x) { return x; } x;"
        events (p/alloc-stack (array u32 64))
        memory (p/alloc-stack (array u64 2048))
        arena (p/alloc-stack ir/IrArena)
        builder-scratch (p/alloc-stack builder/BuilderScratch)
        ir-builder (p/alloc-stack builder/IrBuilder)
        parser-values (p/alloc-stack (array u32 64))
        parser-scratch (p/alloc-stack parser/DirectParserScratch)
        caps (builder/BuilderCapacities
          :regions (cast u32 4) :region-block-refs (cast u32 8)
          :blocks (cast u32 8) :block-op-refs (cast u32 32)
          :ops (cast u32 32) :op-region-refs (cast u32 8)
          :values (cast u32 32) :operands (cast u32 64)
          :successors (cast u32 8) :successor-args (cast u32 8)
          :scopes (cast u32 8) :bindings (cast u32 16)
          :references (cast u32 16) :captures (cast u32 8))
        initialized (storage/initialize! arena builder-scratch ir-builder
                      (p/cast (ptr u8) memory) 16384 (cast u32 (len text)) caps)
        tape-result (pipeline/scan-source-to-parse-tape64
          (slice-data text) (len text) (cast u32 0) (p/cast (ptr u32) events)
          (frontend/frontend-initial-state))]
    (assert-eq (.error initialized) storage/STORAGE-OK)
    (store! parser-scratch (parser/DirectParserScratch
      :values (p/cast (ptr u32) parser-values) :value-capacity 64 :value-count 0))
    (let [parsed (parser/parse-direct-program! (slice-data text) (len text)
                   (p/cast (ptr u32) events) (.count tape-result)
                   ir-builder parser-scratch)]
      (assert-eq (.error parsed) parser/DIRECT-PARSE-OK))
    (assert-eq (.binding-count arena) (cast u32 3))
    (assert-eq (.reference-count arena) (cast u32 2))
    ;; The reference inside f resolves to parameter x; after leaving f, the
    ;; same cached spelling must resolve to root binding x instead.
    (assert-eq (load (p/index (.reference-bindings arena) 0)) (cast u32 2))
    (assert-eq (load (p/index (.reference-bindings arena) 1)) (cast u32 0)))
  0)

(deftest test-keyword-values-have-distinct-operations
  (let [text "true; false; null; this; debugger; ;"
        events (p/alloc-stack (array u32 32))
        memory (p/alloc-stack (array u64 1024))
        arena (p/alloc-stack ir/IrArena)
        builder-scratch (p/alloc-stack builder/BuilderScratch)
        ir-builder (p/alloc-stack builder/IrBuilder)
        parser-values (p/alloc-stack (array u32 32))
        parser-scratch (p/alloc-stack parser/DirectParserScratch)
        verify-bits (p/alloc-stack (array u64 4))
        verify-scratch (p/alloc-stack ir/VerifyScratch)
        caps (builder/BuilderCapacities
          :regions (cast u32 2) :region-block-refs (cast u32 4)
          :blocks (cast u32 4) :block-op-refs (cast u32 16)
          :ops (cast u32 16) :op-region-refs (cast u32 2)
          :values (cast u32 8) :operands (cast u32 8)
          :successors (cast u32 4) :successor-args (cast u32 4)
          :scopes (cast u32 4) :bindings (cast u32 4)
          :references (cast u32 4) :captures (cast u32 4))
        initialized (storage/initialize! arena builder-scratch ir-builder
                      (p/cast (ptr u8) memory) 8192 (cast u32 (len text)) caps)
        tape-result (pipeline/scan-source-to-parse-tape64
          (slice-data text) (len text) (cast u32 0) (p/cast (ptr u32) events)
          (frontend/frontend-initial-state))]
    (assert-eq (.error initialized) storage/STORAGE-OK)
    (store! parser-scratch (parser/DirectParserScratch
      :values (p/cast (ptr u32) parser-values) :value-capacity 32 :value-count 0))
    (let [parsed (parser/parse-direct-program! (slice-data text) (len text)
                   (p/cast (ptr u32) events) (.count tape-result)
                   ir-builder parser-scratch)]
      (assert-eq (.error parsed) parser/DIRECT-PARSE-OK))
    (assert-eq (load (p/index (.opcodes arena) 0)) ir/OP-JS-BOOLEAN)
    (assert-eq (load (p/index (.opcodes arena) 2)) ir/OP-JS-BOOLEAN)
    (assert-eq (load (p/index (.opcodes arena) 4)) ir/OP-JS-NULL)
    (assert-eq (load (p/index (.opcodes arena) 6)) ir/OP-JS-THIS)
    (assert-eq (load (p/index (.opcodes arena) 8)) ir/OP-JS-DEBUGGER)
    (assert-eq (.op-count arena) (cast u32 10))
    (assert-eq (.reference-count arena) (cast u32 0))
    (store! verify-scratch
      (ir/VerifyScratch :dominators (p/cast (ptr u64) verify-bits)
                        :dominator-word-capacity 4))
    (let [verified (ir/verify-ir arena verify-scratch)]
      (assert-eq (.error verified) ir/VERIFY-OK)))
  0)

(deftest test-exponentiation-is-right-associative
  (let [text "const power = 2 ** 3 ** 2;"
        events (p/alloc-stack (array u32 32))
        memory (p/alloc-stack (array u64 1024))
        arena (p/alloc-stack ir/IrArena)
        builder-scratch (p/alloc-stack builder/BuilderScratch)
        ir-builder (p/alloc-stack builder/IrBuilder)
        parser-values (p/alloc-stack (array u32 32))
        parser-scratch (p/alloc-stack parser/DirectParserScratch)
        caps (builder/BuilderCapacities
          :regions (cast u32 2) :region-block-refs (cast u32 2)
          :blocks (cast u32 2) :block-op-refs (cast u32 16)
          :ops (cast u32 16) :op-region-refs (cast u32 2)
          :values (cast u32 8) :operands (cast u32 8)
          :successors (cast u32 2) :successor-args (cast u32 2)
          :scopes (cast u32 2) :bindings (cast u32 2)
          :references (cast u32 2) :captures (cast u32 2))
        initialized (storage/initialize! arena builder-scratch ir-builder
                      (p/cast (ptr u8) memory) 8192 (cast u32 (len text)) caps)
        tape-result (pipeline/scan-source-to-parse-tape64
          (slice-data text) (len text) (cast u32 0) (p/cast (ptr u32) events)
          (frontend/frontend-initial-state))]
    (assert-eq (.error initialized) storage/STORAGE-OK)
    (store! parser-scratch (parser/DirectParserScratch
      :values (p/cast (ptr u32) parser-values) :value-capacity 32 :value-count 0))
    (let [parsed (parser/parse-direct-program! (slice-data text) (len text)
                   (p/cast (ptr u32) events) (.count tape-result)
                   ir-builder parser-scratch)]
      (assert-eq (.error parsed) parser/DIRECT-PARSE-OK))
    ;; Values 0..2 are the literals. The first binary operation must consume
    ;; 3 and 2; the outer operation must then consume 2 and that result.
    (assert-eq (load (p/index (.opcodes arena) 3)) ir/OP-JS-BINARY)
    (assert-eq (load (p/index (.opcodes arena) 4)) ir/OP-JS-BINARY)
    (let [inner-first (load (p/index (.op-first-operands arena) 3))
          outer-first (load (p/index (.op-first-operands arena) 4))]
      (assert-eq (load (p/index (.operands arena) (cast i64 inner-first)))
                 (cast u32 1))
      (assert-eq (load (p/index (.operands arena)
                                (cast i64 (+ inner-first (cast u32 1)))))
                 (cast u32 2))
      (assert-eq (load (p/index (.operands arena) (cast i64 outer-first)))
                 (cast u32 0))
      (assert-eq (load (p/index (.operands arena)
                                (cast i64 (+ outer-first (cast u32 1)))))
                 (cast u32 3))))
  0)

(deftest test-nullish-coalescing-builds-short-circuit-cfg
  (let [text "const value = left ?? right;"
        events (p/alloc-stack (array u32 32))
        memory (p/alloc-stack (array u64 2048))
        arena (p/alloc-stack ir/IrArena)
        builder-scratch (p/alloc-stack builder/BuilderScratch)
        ir-builder (p/alloc-stack builder/IrBuilder)
        parser-values (p/alloc-stack (array u32 32))
        parser-scratch (p/alloc-stack parser/DirectParserScratch)
        verify-bits (p/alloc-stack (array u64 16))
        verify-scratch (p/alloc-stack ir/VerifyScratch)
        caps (builder/BuilderCapacities
          :regions (cast u32 2) :region-block-refs (cast u32 8)
          :blocks (cast u32 8) :block-op-refs (cast u32 24)
          :ops (cast u32 24) :op-region-refs (cast u32 2)
          :values (cast u32 16) :operands (cast u32 24)
          :successors (cast u32 8) :successor-args (cast u32 8)
          :scopes (cast u32 4) :bindings (cast u32 4)
          :references (cast u32 8) :captures (cast u32 4))
        initialized (storage/initialize! arena builder-scratch ir-builder
                      (p/cast (ptr u8) memory) 16384 (cast u32 (len text)) caps)
        tape-result (pipeline/scan-source-to-parse-tape64
          (slice-data text) (len text) (cast u32 0) (p/cast (ptr u32) events)
          (frontend/frontend-initial-state))]
    (assert-eq (.error initialized) storage/STORAGE-OK)
    (store! parser-scratch (parser/DirectParserScratch
      :values (p/cast (ptr u32) parser-values) :value-capacity 32 :value-count 0))
    (let [parsed (parser/parse-direct-program! (slice-data text) (len text)
                   (p/cast (ptr u32) events) (.count tape-result)
                   ir-builder parser-scratch)]
      (assert-eq (.error parsed) parser/DIRECT-PARSE-OK))
    (assert-eq (.block-count arena) (cast u32 3))
    (assert-eq (.value-count arena) (cast u32 4))
    (assert-eq (load (p/index (.opcodes arena) 0)) ir/OP-JS-IDENTIFIER)
    (assert-eq (load (p/index (.opcodes arena) 1)) ir/OP-JS-IS-NULLISH)
    (assert-eq (load (p/index (.opcodes arena) 2)) ir/OP-COND-BR)
    (assert-eq (load (p/index (.opcodes arena) 3)) ir/OP-JS-IDENTIFIER)
    (assert-eq (load (p/index (.opcodes arena) 4)) ir/OP-BR)
    (assert-eq (load (p/index (.block-param-counts arena) 2)) (cast u32 1))
    (let [branch-first (load (p/index (.op-first-successors arena) 2))
          rhs-branch-first (load (p/index (.op-first-successors arena) 4))]
      ;; Nullish=true evaluates the RHS; nullish=false forwards the LHS.
      (assert-eq (load (p/index (.successor-blocks arena) (cast i64 branch-first)))
                 (cast u32 1))
      (assert-eq (load (p/index (.successor-blocks arena)
                                (cast i64 (+ branch-first (cast u32 1)))))
                 (cast u32 2))
      (assert-eq (load (p/index (.successor-arg-counts arena)
                                (cast i64 (+ branch-first (cast u32 1)))))
                 (cast u32 1))
      (assert-eq (load (p/index (.successor-blocks arena) (cast i64 rhs-branch-first)))
                 (cast u32 2)))
    (store! verify-scratch
      (ir/VerifyScratch :dominators (p/cast (ptr u64) verify-bits)
                        :dominator-word-capacity 16))
    (let [verified (ir/verify-ir arena verify-scratch)]
      (assert-eq (.error verified) ir/VERIFY-OK)))
  0)

(deftest test-word-relational-operator_preserves_spelling
  (let [text "const contains = key in object;"
        events (p/alloc-stack (array u32 32))
        memory (p/alloc-stack (array u64 1024))
        arena (p/alloc-stack ir/IrArena)
        builder-scratch (p/alloc-stack builder/BuilderScratch)
        ir-builder (p/alloc-stack builder/IrBuilder)
        parser-values (p/alloc-stack (array u32 32))
        parser-scratch (p/alloc-stack parser/DirectParserScratch)
        output (p/alloc-stack (array u8 128))
        caps (builder/BuilderCapacities
          :regions (cast u32 2) :region-block-refs (cast u32 2)
          :blocks (cast u32 2) :block-op-refs (cast u32 16)
          :ops (cast u32 16) :op-region-refs (cast u32 2)
          :values (cast u32 8) :operands (cast u32 8)
          :successors (cast u32 2) :successor-args (cast u32 2)
          :scopes (cast u32 2) :bindings (cast u32 2)
          :references (cast u32 4) :captures (cast u32 2))
        initialized (storage/initialize! arena builder-scratch ir-builder
                      (p/cast (ptr u8) memory) 8192 (cast u32 (len text)) caps)
        tape-result (pipeline/scan-source-to-parse-tape64
          (slice-data text) (len text) (cast u32 0) (p/cast (ptr u32) events)
          (frontend/frontend-initial-state))]
    (assert-eq (.error initialized) storage/STORAGE-OK)
    (store! parser-scratch (parser/DirectParserScratch
      :values (p/cast (ptr u32) parser-values) :value-capacity 32 :value-count 0))
    (let [parsed (parser/parse-direct-program! (slice-data text) (len text)
                   (p/cast (ptr u32) events) (.count tape-result)
                   ir-builder parser-scratch)]
      (assert-eq (.error parsed) parser/DIRECT-PARSE-OK))
    (assert-eq (load (p/index (.opcodes arena) 2)) ir/OP-JS-BINARY)
    (assert-eq (load (p/index (.op-name-starts arena) 2)) (cast u32 21))
    (assert-eq (load (p/index (.op-name-ends arena) 2)) (cast u32 23))
    (assert-eq (load (p/index (.op-immediates arena) 2)) (cast u64 0))
    (let [printed (js/print-linear-program! arena (slice-data text)
                    (p/cast (ptr u8) output) 128)
          expected "const contains = (key in object);\n"]
      (assert-eq (.error printed) js/JS-PRINT-OK)
      (assert (byte-eq? (p/cast (ptr u8) output) expected (.count printed)))))
  0)
