(module experiments.react-hir-frontend.unicode-identifier-test)

(import "experiments.react-hir-frontend.unicode-identifier" :as unicode-id)

;; Unicode 15.1 non-ASCII scalar counts independently pin the complete
;; compressed tables. A dropped, shifted, or mistyped byte changes a count.
(deftest unicode-15-1-identifier-table-counts
  (let [(mut codepoint) (cast u32 128)
        (mut starts) 0 (mut continues) 0]
    (loop
      (if (>= (load codepoint) (cast u32 1114112)) (break)
        (do
          (if (or (< (load codepoint) (cast u32 55296))
                  (> (load codepoint) (cast u32 57343)))
              (do
                (if (unicode-id/id-start? (load codepoint))
                    (set! starts (+ (load starts) 1)) 0)
                (if (unicode-id/id-continue? (load codepoint))
                    (set! continues (+ (load continues) 1)) 0)) 0)
          (set! codepoint (+ (load codepoint) (cast u32 1))))))
    (assert-eq (load starts) 136915)
    ;; ZWNJ and ZWJ are explicit ECMAScript additions; Unicode 15.1's compact
    ;; continue table already classifies both, so the OR does not change count.
    (assert-eq (load continues) 140043)))

(deftest identifier-boundaries-and-ecmascript-additions
  (assert (unicode-id/id-start? (cast u32 960)))       ; Greek pi
  (assert (unicode-id/id-start? (cast u32 66560)))     ; Deseret
  (assert (not (unicode-id/id-start? (cast u32 128512)))) ; emoji
  (assert (unicode-id/id-continue? (cast u32 769)))    ; combining acute
  (assert (unicode-id/id-continue? (cast u32 8204)))   ; ZWNJ
  (assert (unicode-id/id-continue? (cast u32 8205))))  ; ZWJ
