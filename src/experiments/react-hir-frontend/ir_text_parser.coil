(module experiments.react-hir-frontend.ir-text-parser)

(import "coil.primitive" :as p)
(import "coil.slice" :use [slice-data])
(import "experiments.react-hir-frontend.ir" :as ir)
(import "experiments.react-hir-frontend.ir-builder" :as builder)

(const IR-TEXT-OK i64 0)
(const IR-TEXT-EXPECTED i64 1)
(const IR-TEXT-ID-MISMATCH i64 2)
(const IR-TEXT-UNKNOWN-OP i64 3)
(const IR-TEXT-BUILDER i64 4)

(defstruct TextState
  [(input (ptr u8)) (size i64) (index i64)
   (builder (ptr builder/IrBuilder)) (error i64) (error-offset i64)])

(defstruct IrTextParseResult [(error i64) (error-offset i64) (consumed i64)])

(defn fail! [(state (ptr TextState)) (error i64)] (-> i64)
  (if (= (.error state) IR-TEXT-OK)
      (do (set! (.error state) error) (set! (.error-offset state) (.index state))) 0)
  0)

(defn byte-at [(state (ptr TextState)) (index i64)] (-> u8)
  (if (or (< index 0) (>= index (.size state))) (cast u8 0)
    (load (p/index (.input state) index))))

(defn current-byte [(state (ptr TextState))] (-> u8)
  (byte-at state (.index state)))

(defn starts-with? [(state (ptr TextState)) (text (slice u8))] (-> bool)
  (if (> (+ (.index state) (len text)) (.size state)) false
    (let [(mut i) 0 (mut same) true]
      (loop
        (if (or (>= (load i) (len text)) (not (load same))) (break)
          (do
            (if (!= (byte-at state (+ (.index state) (load i)))
                    (load (p/index (slice-data text) (load i))))
                (store! same false) 0)
            (set! i (+ (load i) 1)))))
      (load same))))

(defn expect! [(state (ptr TextState)) (text (slice u8))] (-> bool)
  (if (starts-with? state text)
      (do (set! (.index state) (+ (.index state) (len text))) true)
    (do (fail! state IR-TEXT-EXPECTED) false)))

(defn skip-spaces! [(state (ptr TextState))] (-> i64)
  (loop
    (if (!= (current-byte state) (cast u8 32)) (break)
      (set! (.index state) (+ (.index state) 1))))
  0)

(defn parse-u32! [(state (ptr TextState))] (-> u32)
  (let [(mut value) (cast u64 0) (mut digits) 0]
    (loop
      (let [byte (current-byte state)]
        (if (or (< byte (cast u8 48)) (> byte (cast u8 57))) (break)
          (do
            (set! value (+ (* (load value) (cast u64 10))
                           (cast u64 (- byte (cast u8 48)))))
            (set! digits (+ (load digits) 1))
            (set! (.index state) (+ (.index state) 1))))))
    (if (= (load digits) 0) (fail! state IR-TEXT-EXPECTED) 0)
    (cast u32 (load value))))

(defn parse-id-or-none! [(state (ptr TextState))] (-> u32)
  (if (starts-with? state "none")
      (do (expect! state "none") (cast u32 ir/INVALID-ID))
    (parse-u32! state)))

(defn check-id! [(state (ptr TextState)) (result builder/BuildResult) (expected u32)]
  (-> u32)
  (if (!= (.error result) builder/BUILD-OK)
      (do (fail! state IR-TEXT-BUILDER) (cast u32 ir/INVALID-ID))
    (if (!= (.id result) expected)
        (do (fail! state IR-TEXT-ID-MISMATCH) (.id result))
      (.id result))))

(defn check-build! [(state (ptr TextState)) (result builder/BuildResult)] (-> u32)
  (if (= (.error result) builder/BUILD-OK) (.id result)
    (do (fail! state IR-TEXT-BUILDER) (cast u32 ir/INVALID-ID))))

(defn skip-line! [(state (ptr TextState))] (-> i64)
  (loop
    (if (or (>= (.index state) (.size state))
            (= (current-byte state) (cast u8 10))) (break)
      (set! (.index state) (+ (.index state) 1))))
  (if (= (current-byte state) (cast u8 10))
      (set! (.index state) (+ (.index state) 1)) 0)
  0)

(defn opcode-for-span [(state (ptr TextState)) (start i64) (end i64)] (-> u16)
  (let [saved (.index state) (mut opcode) (cast u16 ir/OP-INVALID)]
    (set! (.index state) start)
    (cond
      (and (= (- end start) 5) (starts-with? state "cf.br"))
        (store! opcode ir/OP-BR)
      (and (= (- end start) 10) (starts-with? state "cf.cond_br"))
        (store! opcode ir/OP-COND-BR)
      (and (= (- end start) 9) (starts-with? state "js.return"))
        (store! opcode ir/OP-RETURN)
      (and (= (- end start) 14) (starts-with? state "cf.unreachable"))
        (store! opcode ir/OP-UNREACHABLE)
      (and (= (- end start) 13) (starts-with? state "js.identifier"))
        (store! opcode ir/OP-JS-IDENTIFIER)
      (and (= (- end start) 9) (starts-with? state "js.number"))
        (store! opcode ir/OP-JS-NUMBER)
      (and (= (- end start) 9) (starts-with? state "js.string"))
        (store! opcode ir/OP-JS-STRING)
      (and (= (- end start) 8) (starts-with? state "js.unary"))
        (store! opcode ir/OP-JS-UNARY)
      (and (= (- end start) 9) (starts-with? state "js.binary"))
        (store! opcode ir/OP-JS-BINARY)
      (and (= (- end start) 7) (starts-with? state "js.call"))
        (store! opcode ir/OP-JS-CALL)
      (and (= (- end start) 10) (starts-with? state "js.declare"))
        (store! opcode ir/OP-JS-DECLARE)
      (and (= (- end start) 9) (starts-with? state "js.assign"))
        (store! opcode ir/OP-JS-ASSIGN)
      (and (= (- end start) 13) (starts-with? state "js.expression"))
        (store! opcode ir/OP-JS-EXPRESSION)
      (and (= (- end start) 11) (starts-with? state "js.function"))
        (store! opcode ir/OP-JS-FUNCTION)
      (and (= (- end start) 14) (starts-with? state "js.jsx_element"))
        (store! opcode ir/OP-JS-JSX-ELEMENT)
      (and (= (- end start) 9) (starts-with? state "js.member"))
        (store! opcode ir/OP-JS-MEMBER)
      (and (= (- end start) 8) (starts-with? state "js.array"))
        (store! opcode ir/OP-JS-ARRAY)
      (and (= (- end start) 11) (starts-with? state "js.property"))
        (store! opcode ir/OP-JS-PROPERTY)
      (and (= (- end start) 9) (starts-with? state "js.object"))
        (store! opcode ir/OP-JS-OBJECT)
      :else 0)
    (set! (.index state) saved)
    (load opcode)))

(defn parse-value-id! [(state (ptr TextState))] (-> u32)
  (if (expect! state "%") (parse-u32! state) (cast u32 ir/INVALID-ID)))

(defn parse-block-id! [(state (ptr TextState))] (-> u32)
  (if (expect! state "^") (parse-u32! state) (cast u32 ir/INVALID-ID)))

(defn parse-block-header! [(state (ptr TextState))] (-> u32)
  (let [block (parse-block-id! state)]
    (expect! state "(")
    (if (!= (current-byte state) (cast u8 41))
        (loop
          (let [printed (parse-value-id! state)
                parameter (builder/add-block-param! (.builder state) block)]
            (check-id! state parameter printed)
            (if (starts-with? state ", ") (expect! state ", ") (break)))) 0)
    (expect! state "):\n")
    block))

(defn parse-successor! [(state (ptr TextState)) (op u32)] (-> i64)
  (let [target (parse-block-id! state)
        successor-result (builder/add-successor! (.builder state) op target)
        successor (check-build! state successor-result)]
    (expect! state "(")
    (if (!= (current-byte state) (cast u8 41))
        (loop
          (let [value (parse-value-id! state)
                argument (builder/add-successor-arg! (.builder state) successor value)]
            (check-build! state argument)
            (if (starts-with? state ", ") (expect! state ", ") (break)))) 0)
    (expect! state ")"))
  0)

(defn parse-op! [(state (ptr TextState)) (block u32)] (-> i64)
  (expect! state "  ")
  (let [(mut result-count) (cast u32 0) (mut first-result) (cast u32 ir/INVALID-ID)]
    (if (= (current-byte state) (cast u8 37))
        (do
          (loop
            (let [value (parse-value-id! state)]
              (if (= (load result-count) (cast u32 0)) (store! first-result value) 0)
              (set! result-count (+ (load result-count) (cast u32 1)))
              (if (starts-with? state ", ") (expect! state ", ") (break))))
          (expect! state " = ")
          0) 0)
    (let [name-start (.index state) (mut name-end) (.index state)]
      (loop
        (let [byte (current-byte state)]
          (if (or (= byte (cast u8 0)) (= byte (cast u8 32)) (= byte (cast u8 10))) (break)
            (do (set! (.index state) (+ (.index state) 1))
                (store! name-end (.index state))))))
      (let [opcode (opcode-for-span state name-start (load name-end))]
        (if (= opcode (cast u16 ir/OP-INVALID)) (fail! state IR-TEXT-UNKNOWN-OP) 0)
        (let [operation-result (builder/add-op! (.builder state) block opcode
                                                (cast u32 name-start) (cast u32 (load name-end))
                                                (cast u32 0) (cast u32 0)
                                                (load result-count))
              op (check-build! state operation-result)]
          (if (> (load result-count) (cast u32 0))
              (if (!= (load first-result)
                      (load (p/index (.op-first-results (.arena (.builder state)))
                                     (cast i64 op))))
                  (fail! state IR-TEXT-ID-MISMATCH) 0) 0)
          (loop
            (cond
              (starts-with? state " imm(")
                (do
                  (expect! state " imm(")
                  (let [value (parse-u32! state)
                        set-result (builder/set-op-immediate! (.builder state) op
                                                              (cast u64 value))]
                    (check-build! state set-result))
                  (expect! state ")"))
              (starts-with? state " kind(")
                (do
                  (expect! state " kind(")
                  (let [value (parse-u32! state)
                        set-result (builder/set-op-immediate! (.builder state) op
                                                              (cast u64 value))]
                    (check-build! state set-result))
                  (expect! state ")"))
              (starts-with? state " name(")
                (do
                  (expect! state " name(")
                  (let [start (parse-u32! state) _colon (expect! state ":")
                        end (parse-u32! state)
                        set-result (builder/set-op-name-span! (.builder state) op start end)]
                    (check-build! state set-result))
                  (expect! state ")"))
              (starts-with? state " regions(")
                (do
                  ;; Child regions attach themselves when their later headers
                  ;; are parsed. Consume this reciprocal list here.
                  (expect! state " regions(")
                  (if (!= (current-byte state) (cast u8 41))
                      (loop
                        (parse-u32! state)
                        (if (= (current-byte state) (cast u8 44))
                            (do (expect! state ",") 0) (break))) 0)
                  (expect! state ")"))
              :else (break)))
          (loop
            (cond
              (starts-with? state " loc(") (break)
              (starts-with? state ", ") (do (expect! state ", ") 0)
              (= (current-byte state) (cast u8 32)) (do (expect! state " ") 0)
              (= (current-byte state) (cast u8 37))
                (let [value (parse-value-id! state)
                      operand (builder/add-operand! (.builder state) op value)]
                  (check-build! state operand)
                  0)
              (= (current-byte state) (cast u8 94)) (parse-successor! state op)
              :else (do (fail! state IR-TEXT-EXPECTED) (break))))
          (expect! state " loc(")
          (let [start (parse-u32! state) _colon (expect! state ":")
                end (parse-u32! state)
                span-result (builder/set-op-span! (.builder state) op start end)]
            (check-build! state span-result))
          (expect! state ")\n")))))
  0)

(defn predeclare-region-blocks! [(state (ptr TextState)) (region u32)
                                 (body-start i64)] (-> i64)
  (set! (.index state) body-start)
  (loop
    (if (or (>= (.index state) (.size state))
            (= (current-byte state) (cast u8 125))) (break)
      (if (= (current-byte state) (cast u8 94))
          (let [printed (parse-block-id! state)
                block (builder/add-block! (.builder state) region)]
            (check-id! state block printed)
            (skip-line! state))
        (skip-line! state))))
  0)

(defn parse-region! [(state (ptr TextState))] (-> i64)
  (expect! state "region ")
  (let [printed-region (parse-u32! state) _parent-open (expect! state " parent(")
        parent (parse-id-or-none! state) _body-open (expect! state ") {\n")
        region-result (builder/add-region! (.builder state) parent)
        region (check-id! state region-result printed-region)]
    (if (!= parent (cast u32 ir/INVALID-ID))
        (let [attached (builder/add-op-region! (.builder state) parent region)]
          (check-build! state attached)) 0)
    (let [body-start (.index state)]
      (predeclare-region-blocks! state region body-start)
      (let [body-end (.index state)]
        (set! (.index state) body-start)
        (loop
          (if (or (>= (.index state) body-end)
                  (!= (.error state) IR-TEXT-OK)) (break)
            (let [block (parse-block-header! state)]
              (loop
                (if (or (>= (.index state) body-end)
                        (= (current-byte state) (cast u8 94))
                        (= (current-byte state) (cast u8 125))
                        (!= (.error state) IR-TEXT-OK)) (break)
                  (parse-op! state block))))))
        (set! (.index state) body-end)
        (expect! state "}\n"))))
  0)

(defn parse-scope! [(state (ptr TextState))] (-> i64)
  (expect! state "scope ")
  (let [printed (parse-u32! state) _parent-open (expect! state " parent(")
        parent (parse-id-or-none! state) _loc-open (expect! state ") loc(")
        start (parse-u32! state) _colon (expect! state ":") end (parse-u32! state)
        _close (expect! state ")\n") result (builder/add-scope! (.builder state) parent start end)]
    (check-id! state result printed))
  0)

(defn parse-binding! [(state (ptr TextState))] (-> i64)
  (expect! state "binding ")
  (let [printed (parse-u32! state) _scope-open (expect! state " scope(")
        scope (parse-u32! state) _name-open (expect! state ") name(")
        start (parse-u32! state) _colon (expect! state ":") end (parse-u32! state)
        _close (expect! state ")\n")
        result (builder/add-binding! (.builder state) scope start end)]
    (check-id! state result printed))
  0)

(defn parse-reference! [(state (ptr TextState))] (-> i64)
  (expect! state "reference ")
  (let [printed (parse-u32! state) _binding-open (expect! state " binding(")
        binding (parse-u32! state) _loc-open (expect! state ") loc(")
        start (parse-u32! state) _colon (expect! state ":") end (parse-u32! state)
        _close (expect! state ")\n")
        result (builder/add-reference! (.builder state) binding start end)]
    (check-id! state result printed))
  0)

(defn parse-capture! [(state (ptr TextState))] (-> i64)
  (expect! state "capture ")
  (let [printed (parse-u32! state) _scope-open (expect! state " scope(")
        scope (parse-u32! state) _binding-open (expect! state ") binding(")
        binding (parse-u32! state) _close (expect! state ")\n")
        result (builder/add-capture! (.builder state) scope binding)]
    (check-id! state result printed))
  0)

(defn parse-ir-text! [(input (ptr u8)) (size i64)
                      (ir-builder (ptr builder/IrBuilder))] (-> IrTextParseResult)
  (let [state (p/alloc-stack TextState)]
    (store! state (TextState :input input :size size :index 0 :builder ir-builder
                             :error IR-TEXT-OK :error-offset 0))
    (expect! state "source_size ")
    (let [source-size (parse-u32! state)]
      (set! (.source-size (.arena ir-builder)) source-size))
    (expect! state "\n")
    (loop
      (cond
        (!= (.error state) IR-TEXT-OK) (break)
        (starts-with? state "region ") (parse-region! state)
        (starts-with? state "scope ") (parse-scope! state)
        (starts-with? state "binding ") (parse-binding! state)
        (starts-with? state "reference ") (parse-reference! state)
        (starts-with? state "capture ") (parse-capture! state)
        (= (.index state) (.size state)) (break)
        :else (do (fail! state IR-TEXT-EXPECTED) (break))))
    (if (and (= (.error state) IR-TEXT-OK)
             (!= (builder/finalize-membership! ir-builder) builder/BUILD-OK))
        (fail! state IR-TEXT-BUILDER) 0)
    (IrTextParseResult :error (.error state) :error-offset (.error-offset state)
                       :consumed (.index state))))
