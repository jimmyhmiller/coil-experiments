(module experiments.react-hir-frontend.ir-storage)

(import "coil.primitive" :as p)
(import "experiments.react-hir-frontend.ir" :as ir)
(import "experiments.react-hir-frontend.ir-builder" :as builder)

(const STORAGE-OK i64 0)
(const STORAGE-CAPACITY i64 1)

(defstruct StorageCursor [(data (ptr u8)) (capacity i64) (offset i64) (error i64)])
(defstruct StorageResult [(error i64) (bytes-used i64)])

;; A conservative allocation size with room for every inter-plane alignment.
;; initialize! returns the exact bytes used for accounting.
(defn required-bytes [(caps builder/BuilderCapacities)] (-> i64)
  (let [u32-count
          (+ (* (cast i64 (.regions caps)) 6)
             (+ (cast i64 (.region-block-refs caps))
             (+ (* (cast i64 (.blocks caps)) 8)
             (+ (cast i64 (.block-op-refs caps))
             (+ (* (cast i64 (.ops caps)) 15)
             (+ (cast i64 (.op-region-refs caps))
             (+ (cast i64 (.operands caps))
             (+ (* (cast i64 (.successors caps)) 3)
             (+ (cast i64 (.successor-args caps))
             (+ (cast i64 (.values caps))
             (+ (* (cast i64 (.scopes caps)) 3)
             (+ (* (cast i64 (.bindings caps)) 3)
             (+ (* (cast i64 (.references caps)) 3)
                (* (cast i64 (.captures caps)) 2))))))))))))))]
    (+ 256
       (+ (* u32-count 4)
          (+ (* (cast i64 (.ops caps)) 2)
             (+ (* (cast i64 (.ops caps)) 8)
                (cast i64 (.values caps))))))))

(defn align-offset [(offset i64) (alignment i64)] (-> i64)
  (let [mask (- alignment 1)]
    (p/iand (+ offset mask) (p/ixor mask -1))))

(defn reserve! [(cursor (ptr StorageCursor)) (count i64) (width i64)
                (alignment i64)] (-> (ptr u8))
  (let [start (align-offset (.offset cursor) alignment)
        end (+ start (* count width))]
    (if (or (< count 0) (> end (.capacity cursor)))
        (do (set! (.error cursor) STORAGE-CAPACITY) (p/cast (ptr u8) 0))
      (do
        (set! (.offset cursor) end)
        (p/index (.data cursor) start)))))

(defn take-u8! [(cursor (ptr StorageCursor)) (count u32)] (-> (ptr u8))
  (reserve! cursor (cast i64 count) 1 1))

(defn take-u16! [(cursor (ptr StorageCursor)) (count u32)] (-> (ptr u16))
  (p/cast (ptr u16) (reserve! cursor (cast i64 count) 2 2)))

(defn take-u32! [(cursor (ptr StorageCursor)) (count u32)] (-> (ptr u32))
  (p/cast (ptr u32) (reserve! cursor (cast i64 count) 4 4)))

(defn take-u64! [(cursor (ptr StorageCursor)) (count u32)] (-> (ptr u64))
  (p/cast (ptr u64) (reserve! cursor (cast i64 count) 8 8)))

(defn initialize!
  [(arena (ptr ir/IrArena)) (scratch (ptr builder/BuilderScratch))
   (ir-builder (ptr builder/IrBuilder)) (data (ptr u8)) (data-size i64)
   (source-size u32) (caps builder/BuilderCapacities)] (-> StorageResult)
  (let [cursor (p/alloc-stack StorageCursor)]
    (store! cursor (StorageCursor :data data :capacity data-size :offset 0 :error STORAGE-OK))
    (store! arena (ir/IrArena
      :source-size source-size
      :region-parent-ops (take-u32! cursor (.regions caps))
      :region-first-blocks (take-u32! cursor (.regions caps))
      :region-block-counts (take-u32! cursor (.regions caps)) :region-count (cast u32 0)
      :region-blocks (take-u32! cursor (.region-block-refs caps))
      :region-block-ref-count (cast u32 0)
      :block-regions (take-u32! cursor (.blocks caps))
      :block-first-params (take-u32! cursor (.blocks caps))
      :block-param-counts (take-u32! cursor (.blocks caps))
      :block-first-ops (take-u32! cursor (.blocks caps))
      :block-op-counts (take-u32! cursor (.blocks caps)) :block-count (cast u32 0)
      :block-ops (take-u32! cursor (.block-op-refs caps)) :block-op-ref-count (cast u32 0)
      :opcodes (take-u16! cursor (.ops caps))
      :op-name-starts (take-u32! cursor (.ops caps))
      :op-name-ends (take-u32! cursor (.ops caps))
      :op-first-operands (take-u32! cursor (.ops caps))
      :op-operand-counts (take-u32! cursor (.ops caps))
      :op-first-results (take-u32! cursor (.ops caps))
      :op-result-counts (take-u32! cursor (.ops caps))
      :op-first-successors (take-u32! cursor (.ops caps))
      :op-successor-counts (take-u32! cursor (.ops caps))
      :op-first-regions (take-u32! cursor (.ops caps))
      :op-region-counts (take-u32! cursor (.ops caps))
      :op-regions (take-u32! cursor (.op-region-refs caps))
      :op-region-ref-count (cast u32 0)
      :op-starts (take-u32! cursor (.ops caps)) :op-ends (take-u32! cursor (.ops caps))
      :op-immediates (take-u64! cursor (.ops caps)) :op-count (cast u32 0)
      :operands (take-u32! cursor (.operands caps)) :operand-count (cast u32 0)
      :successor-blocks (take-u32! cursor (.successors caps))
      :successor-first-args (take-u32! cursor (.successors caps))
      :successor-arg-counts (take-u32! cursor (.successors caps))
      :successor-count (cast u32 0)
      :successor-args (take-u32! cursor (.successor-args caps))
      :successor-arg-count (cast u32 0)
      :value-def-kinds (take-u8! cursor (.values caps))
      :value-def-indices (take-u32! cursor (.values caps)) :value-count (cast u32 0)
      :scope-parents (take-u32! cursor (.scopes caps))
      :scope-starts (take-u32! cursor (.scopes caps))
      :scope-ends (take-u32! cursor (.scopes caps)) :scope-count (cast u32 0)
      :binding-scopes (take-u32! cursor (.bindings caps))
      :binding-name-starts (take-u32! cursor (.bindings caps))
      :binding-name-ends (take-u32! cursor (.bindings caps)) :binding-count (cast u32 0)
      :reference-bindings (take-u32! cursor (.references caps))
      :reference-starts (take-u32! cursor (.references caps))
      :reference-ends (take-u32! cursor (.references caps)) :reference-count (cast u32 0)
      :capture-scopes (take-u32! cursor (.captures caps))
      :capture-bindings (take-u32! cursor (.captures caps)) :capture-count (cast u32 0)))
    (store! scratch (builder/BuilderScratch
      :region-block-heads (take-u32! cursor (.regions caps))
      :region-block-tails (take-u32! cursor (.regions caps))
      :block-next-in-region (take-u32! cursor (.blocks caps))
      :block-op-heads (take-u32! cursor (.blocks caps))
      :block-op-tails (take-u32! cursor (.blocks caps))
      :op-next-in-block (take-u32! cursor (.ops caps))
      :op-region-heads (take-u32! cursor (.ops caps))
      :op-region-tails (take-u32! cursor (.ops caps))
      :region-next-in-op (take-u32! cursor (.regions caps))))
    (if (= (.error cursor) STORAGE-OK)
        (builder/initialize-builder! ir-builder arena scratch caps) 0)
    (StorageResult :error (.error cursor) :bytes-used (.offset cursor))))

;; Reuse an initialized storage layout for another source with the same
;; capacities. No backing planes are reallocated or recomputed.
(defn reset! [(arena (ptr ir/IrArena)) (ir-builder (ptr builder/IrBuilder))
              (source-size u32)] (-> i64)
  (set! (.source-size arena) source-size)
  (builder/initialize-builder! ir-builder arena (.scratch ir-builder)
                               (.capacities ir-builder)))
