(module experiments.react-hir-frontend.dsl)

(import "coil.primitive" :as p)
(import "coil.simd" :as v)

;; Byte-class expressions are deliberately target-neutral. The metaprogram lowers
;; them to coil.simd today; another backend can consume the same syntax later.
;;
;;   (byte 47)
;;   (range 48 57)
;;   (one-of 34 39 96)
;;   (or EXPR ...)
;;   (and EXPR ...)
;;   (not EXPR)
;;   ascii-digit | ascii-alpha | ascii-hex-digit | ascii-whitespace
;;   utf8-continuation
;;   js-identifier-ascii

(defn symbol-is? [(value Code) (name (slice u8))] (-> bool)
  (and (p/code-sym? value) (= (p/code-sym value) name)))

(defn form-is? [(value Code) (name (slice u8))] (-> bool)
  (and (p/code-list? value)
       (> (p/code-count value) 0)
       (symbol-is? (p/code-nth value 0) name)))

(defn fail [(at Code) (message (slice u8))] (-> Code)
  (do (p/report at message) at))

(defn byte-literal [(at Code)] (-> Code)
  (if (p/code-int? at)
      (let [value (p/code-int at)]
        (if (and (>= value 0) (<= value 255))
            `(cast u8 ~value)
            (fail at "byte-class literal must be in [0, 255]")))
      (fail at "byte-class literal must be an integer")))

(defn compile-fold [(form Code) (width Code) (bytes Code) (op Code) (index i64)] (-> Code)
  (let [count (p/code-count form)]
    (if (>= index count)
        (fail form "byte-class boolean form requires at least one operand")
        (let [(mut result) (compile-byte-class (p/code-nth form index) width bytes)
              (mut i) (+ index 1)]
          (loop
            (if (>= (load i) count) (break)
              (do
                (store! result `(~op ~(load result)
                                      ~(compile-byte-class (p/code-nth form (load i)) width bytes)))
                (set! i (+ (load i) 1)))))
          (load result)))))

(defn compile-one-of [(form Code) (width Code) (bytes Code)] (-> Code)
  (let [count (p/code-count form)]
    (if (< count 2) (fail form "one-of requires at least one byte")
      (let [(mut result) `(v/v= ~bytes (v/vsplat [u8 ~width] ~(byte-literal (p/code-nth form 1))))
            (mut i) 2]
        (loop
          (if (>= (load i) count) (break)
            (do
              (store! result `(v/vor ~(load result)
                                     (v/v= ~bytes (v/vsplat [u8 ~width]
                                               ~(byte-literal (p/code-nth form (load i)))))))
              (set! i (+ (load i) 1)))))
        (load result)))))

(defn nibble-table-eligible? [(form Code)] (-> bool)
  (let [(mut i) 1 (mut eligible) true]
    (loop
      (if (or (>= (load i) (p/code-count form)) (not (load eligible))) (break)
        (let [item (p/code-nth form (load i))]
          (if (and (p/code-int? item)
                   (>= (p/code-int item) 0)
                   (<= (p/code-int item) 127))
              (set! i (+ (load i) 1))
              (store! eligible false)))))
    (load eligible)))

(defn low-nibble-table-value [(form Code) (low i64)] (-> i64)
  (let [(mut i) 1 (mut value) 0]
    (loop
      (if (>= (load i) (p/code-count form)) (break)
        (let [byte (p/code-int (p/code-nth form (load i)))
              high (/ byte 16)]
          (if (= (% byte 16) low)
              (store! value (p/ior (load value)
                              (cast i64 (p/ishl (cast u64 1) (cast u64 high)))))
              0)
          (set! i (+ (load i) 1)))))
    (load value)))

(defn high-nibble-table-value [(form Code) (high i64)] (-> i64)
  (let [(mut i) 1 (mut found) false]
    (loop
      (if (or (>= (load i) (p/code-count form)) (load found)) (break)
        (do
          (if (= (/ (p/code-int (p/code-nth form (load i))) 16) high)
              (store! found true)
              0)
          (set! i (+ (load i) 1)))))
    (if (load found) (cast i64 (p/ishl (cast u64 1) (cast u64 high))) 0)))

(defn compile-nibble-table [(form Code) (low? bool)] (-> Code)
  (let [(mut result) `(v/vzero [u8 16])
        (mut i) 0]
    (loop
      (if (>= (load i) 16) (break)
        (let [value (if low?
                      (low-nibble-table-value form (load i))
                      (high-nibble-table-value form (load i)))]
          (if (!= value 0)
              (store! result `(v/vinsert ~(load result) ~(load i) (cast u8 ~value)))
              0)
          (set! i (+ (load i) 1)))))
    (load result)))

(defn compile-one-of-specialized [(form Code) (width Code) (bytes Code)] (-> Code)
  (if (and (>= (- (p/code-count form) 1) 5) (nibble-table-eligible? form))
      `(v/byte-nibble-class? ~bytes
          ~(compile-nibble-table form true)
          ~(compile-nibble-table form false))
      (compile-one-of form width bytes)))

(defn high-seen-before? [(form Code) (end i64) (high i64)] (-> bool)
  (let [(mut i) 1 (mut found) false]
    (loop
      (if (or (>= (load i) end) (load found)) (break)
        (do
          (if (= (/ (p/code-int (p/code-nth form (load i))) 16) high)
              (store! found true)
              0)
          (set! i (+ (load i) 1)))))
    (load found)))

(defn one-of-group-count [(form Code)] (-> i64)
  (let [(mut i) 1 (mut count) 0]
    (loop
      (if (>= (load i) (p/code-count form)) (break)
        (let [high (/ (p/code-int (p/code-nth form (load i))) 16)]
          (if (high-seen-before? form (load i) high) 0
              (set! count (+ (load count) 1)))
          (set! i (+ (load i) 1)))))
    (load count)))

(defn high-group-rank [(form Code) (high i64)] (-> i64)
  (let [(mut i) 1 (mut rank) 0 (mut done) false]
    (loop
      (if (or (>= (load i) (p/code-count form)) (load done)) (break)
        (let [candidate (/ (p/code-int (p/code-nth form (load i))) 16)]
          (if (= candidate high)
              (store! done true)
              (if (high-seen-before? form (load i) candidate) 0
                  (set! rank (+ (load rank) 1))))
          (set! i (+ (load i) 1)))))
    (load rank)))

(defn partition-group-offset [(forms Code) (end i64)] (-> i64)
  (let [(mut i) 0 (mut offset) 0]
    (loop
      (if (>= (load i) end) (break)
        (do (set! offset (+ (load offset)
                            (one-of-group-count (p/code-nth forms (load i)))))
            (set! i (+ (load i) 1)))))
    (load offset)))

(defn partition-group-count [(forms Code)] (-> i64)
  (partition-group-offset forms (p/code-count forms)))

(defn partition-entry-mask [(forms Code) (index i64)] (-> i64)
  (let [offset (partition-group-offset forms index)
        count (one-of-group-count (p/code-nth forms index))]
    (cast i64 (p/ishl (cast u64 (- (p/ishl (cast u64 1) (cast u64 count)) 1))
                      (cast u64 offset)))))

(defn partition-table-value
  [(forms Code) (nibble i64) (low? bool)] (-> i64)
  (let [(mut form-index) 0 (mut value) 0]
    (loop
      (if (>= (load form-index) (p/code-count forms)) (break)
        (let [form (p/code-nth forms (load form-index))
              offset (partition-group-offset forms (load form-index))
              (mut item) 1]
          (loop
            (if (>= (load item) (p/code-count form)) (break)
              (let [byte (p/code-int (p/code-nth form (load item)))
                    high (/ byte 16)
                    selected (if low? (= (% byte 16) nibble) (= high nibble))
                    bit (+ offset (high-group-rank form high))]
                (if selected
                    (store! value (p/ior (load value)
                                    (cast i64 (p/ishl (cast u64 1) (cast u64 bit)))))
                    0)
                (set! item (+ (load item) 1)))))
          (set! form-index (+ (load form-index) 1)))))
    (load value)))

(defn compile-partition-table [(forms Code) (low? bool)] (-> Code)
  (let [(mut result) `(v/vzero [u8 16]) (mut i) 0]
    (loop
      (if (>= (load i) 16) (break)
        (let [value (partition-table-value forms (load i) low?)]
          (if (!= value 0)
              (store! result `(v/vinsert ~(load result) ~(load i) (cast u8 ~value)))
              0)
          (set! i (+ (load i) 1)))))
    (load result)))

(defn compile-partition-tags [(forms Code) (width Code) (bytes Code)] (-> Code)
  `(v/vand
     (v/vtable ~(compile-partition-table forms true)
               (v/vand ~bytes (v/vsplat [u8 ~width] (cast u8 15))))
     (v/vtable ~(compile-partition-table forms false)
               (v/vshr-logical ~bytes (v/vsplat [u8 ~width] (cast u8 4))))))

(defn compile-js-identifier-ascii [(width Code) (bytes Code)] (-> Code)
  (let [z `(v/vzero [u8 16])
        low0 `(v/vinsert ~z 0 (cast u8 168))
        low1 `(v/vinsert ~low0 1 (cast u8 248))
        low2 `(v/vinsert ~low1 2 (cast u8 248))
        low3 `(v/vinsert ~low2 3 (cast u8 248))
        low4 `(v/vinsert ~low3 4 (cast u8 252))
        low5 `(v/vinsert ~low4 5 (cast u8 248))
        low6 `(v/vinsert ~low5 6 (cast u8 248))
        low7 `(v/vinsert ~low6 7 (cast u8 248))
        low8 `(v/vinsert ~low7 8 (cast u8 248))
        low9 `(v/vinsert ~low8 9 (cast u8 248))
        low-a `(v/vinsert ~low9 10 (cast u8 240))
        low-b `(v/vinsert ~low-a 11 (cast u8 80))
        low-c `(v/vinsert ~low-b 12 (cast u8 80))
        low-d `(v/vinsert ~low-c 13 (cast u8 80))
        low-e `(v/vinsert ~low-d 14 (cast u8 80))
        low-f `(v/vinsert ~low-e 15 (cast u8 112))
        high2 `(v/vinsert ~z 2 (cast u8 4))
        high3 `(v/vinsert ~high2 3 (cast u8 8))
        high4 `(v/vinsert ~high3 4 (cast u8 16))
        high5 `(v/vinsert ~high4 5 (cast u8 32))
        high6 `(v/vinsert ~high5 6 (cast u8 64))
        high7 `(v/vinsert ~high6 7 (cast u8 128))]
    `(v/byte-nibble-class? ~bytes ~low-f ~high7)))

(defn compile-byte-class [(expr Code) (width Code) (bytes Code)] (-> Code)
  (cond
    (symbol-is? expr "ascii-digit") `(v/ascii-digit? ~bytes)
    (symbol-is? expr "ascii-alpha") `(v/ascii-alpha? ~bytes)
    (symbol-is? expr "ascii-hex-digit") `(v/ascii-hex-digit? ~bytes)
    (symbol-is? expr "ascii-whitespace") `(v/ascii-whitespace? ~bytes)
    (symbol-is? expr "utf8-continuation") `(v/utf8-continuation? ~bytes)
    (symbol-is? expr "js-identifier-ascii")
      (compile-js-identifier-ascii width bytes)
    (form-is? expr "byte")
      (if (= (p/code-count expr) 2)
          `(v/v= ~bytes (v/vsplat [u8 ~width] ~(byte-literal (p/code-nth expr 1))))
          (fail expr "byte expects exactly one literal"))
    (form-is? expr "range")
      (if (= (p/code-count expr) 3)
          `(v/byte-in-range? ~bytes
              ~(byte-literal (p/code-nth expr 1))
              ~(byte-literal (p/code-nth expr 2)))
          (fail expr "range expects exactly two literals"))
    (form-is? expr "one-of") (compile-one-of-specialized expr width bytes)
    (form-is? expr "or") (compile-fold expr width bytes `v/vor 1)
    (form-is? expr "and") (compile-fold expr width bytes `v/vand 1)
    (form-is? expr "not")
      (if (= (p/code-count expr) 2)
          `(v/vnot ~(compile-byte-class (p/code-nth expr 1) width bytes))
          (fail expr "not expects exactly one operand"))
    :else (fail expr "unknown byte-class expression")))

;; Defines a generic SIMD classifier. N remains a compile-time vector width.
(defn def-byte-class [(name Code) (params Code) (expr Code)] (-> Code)
  (if (and (p/code-vector? params)
           (= (p/code-count params) 2)
           (p/code-sym? (p/code-nth params 0))
           (p/code-sym? (p/code-nth params 1)))
      (let [width (p/code-nth params 0)
            bytes (p/code-nth params 1)]
        `(defn ~name [~width] [(~bytes (vec u8 ~width))] (-> (mask ~width))
           ~(compile-byte-class expr width bytes)))
      (fail params "def-byte-class expects [WIDTH BYTES]")))
