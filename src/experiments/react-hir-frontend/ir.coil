(const OP-JS-ASSIGNMENT-BINDING u16 132)
(const OP-DIALECT-BASE u16 160)

(const UPDATE-POSTFIX-FLAG u64 (p/ishl (cast u64 1) (cast u64 63)))

(const ITERATOR-IN u64 1)
(const ITERATOR-OF u64 2)
(const ITERATOR-AWAIT-OF u64 3)

(const DECL-CONST u64 1)
(const DECL-LET u64 2)
(const DECL-VAR u64 3)
(const DECL-KIND-MASK u64 255)
(const DECL-UNINITIALIZED u64 256)
(const DECL-AMBIENT u64 512)

;; TSMappedType modifier spelling is semantically observable in the AST.  Each
;; two-bit field retains all four Oxc/TypeScript states: absent, unprefixed,
;; explicit `+`, and explicit `-`.  Presence bits make the optional remap and
;; value operands unambiguous without manufacturing sentinel SSA values.
(const MAPPED-MODIFIER-NONE u64 0)
(const MAPPED-MODIFIER-TRUE u64 1)
(const MAPPED-MODIFIER-PLUS u64 2)
(const MAPPED-MODIFIER-MINUS u64 3)
(const MAPPED-READONLY-MASK u64 3)
(const MAPPED-OPTIONAL-SHIFT u64 2)
(const MAPPED-OPTIONAL-MASK u64 12)
(const MAPPED-HAS-NAME-TYPE u64 16)
(const MAPPED-HAS-VALUE-TYPE u64 32)
(const MAPPED-FLAG-MASK u64 63)

;; Class operands are `[super? implements*]`. The immediate makes the optional
;; first operand and exact number of following type operands verifiable.
(const CLASS-HAS-SUPER u64 1)
(const CLASS-IMPLEMENTS-SHIFT u64 1)

(const TYPE-PARAM-HAS-CONSTRAINT u64 1)
(const TYPE-PARAM-HAS-DEFAULT u64 2)
(const TYPE-PARAM-CONST u64 4)
(const TYPE-PARAM-IN u64 8)
(const TYPE-PARAM-OUT u64 16)
(const TYPE-PARAM-FLAG-MASK u64 31)

(const TYPE-ASSERTION-AS u64 1)
(const TYPE-ASSERTION-SATISFIES u64 2)

(const TYPE-OPERATOR-KEYOF u64 1)
(const TYPE-OPERATOR-READONLY u64 2)
(const TYPE-OPERATOR-UNIQUE u64 3)
(const TYPE-QUERY-TYPEOF u64 1)
(const TYPE-QUERY-HAS-ARGUMENTS u64 2)
(const TYPE-QUERY-FLAG-MASK u64 3)

(const IMPORT-TYPE-HAS-OPTIONS u64 1)
(const IMPORT-TYPE-HAS-QUALIFIER u64 2)
(const IMPORT-TYPE-HAS-ARGUMENTS u64 4)
(const IMPORT-TYPE-FLAG-MASK u64 7)

(const TYPE-PREDICATE-ASSERTS u64 1)
(const TYPE-PREDICATE-HAS-TYPE u64 2)
(const TYPE-PREDICATE-THIS u64 4)
(const TYPE-PREDICATE-FLAG-MASK u64 7)

(const TYPE-DECL-HAS-TYPE-PARAMETERS u64 1)
(const INTERFACE-HAS-TYPE-PARAMETERS u64 1)
(const INTERFACE-HAS-HERITAGE u64 2)
(const INTERFACE-FLAG-MASK u64 3)

(const CALLABLE-TYPE-HAS-TYPE-PARAMETERS u64 1)
(const CALLABLE-TYPE-ABSTRACT u64 2)
(const CALLABLE-TYPE-OPTIONAL u64 4)
(const CALLABLE-TYPE-COMPUTED u64 8)
(const CALLABLE-TYPE-GETTER u64 16)
(const CALLABLE-TYPE-SETTER u64 32)
(const CALLABLE-TYPE-HAS-RETURN-TYPE u64 64)
(const CALLABLE-TYPE-FLAG-MASK u64 127)

(const TYPE-MEMBER-OPTIONAL u64 1)
(const TYPE-MEMBER-READONLY u64 2)
(const TYPE-MEMBER-COMPUTED u64 4)
(const TYPE-MEMBER-HAS-TYPE u64 8)
(const TYPE-MEMBER-FLAG-MASK u64 15)

(const FUNCTION-TYPE-PARAM-OPTIONAL u64 1)
(const FUNCTION-TYPE-PARAM-REST u64 2)
(const FUNCTION-TYPE-PARAM-THIS u64 4)
(const FUNCTION-TYPE-PARAM-PATTERN u64 8)
(const FUNCTION-TYPE-PARAM-HAS-TYPE u64 16)
(const FUNCTION-TYPE-PARAM-FLAG-MASK u64 31)

(const BINDING-PROPERTY-SHORTHAND u64 1)
(const BINDING-PROPERTY-COMPUTED u64 2)
(const BINDING-PROPERTY-FLAG-MASK u64 3)

(const CLASS-MEMBER-STATIC u64 1)
(const CLASS-MEMBER-PUBLIC u64 2)
(const CLASS-MEMBER-PRIVATE u64 4)
(const CLASS-MEMBER-PROTECTED u64 8)
(const CLASS-MEMBER-READONLY u64 16)
(const CLASS-MEMBER-ABSTRACT u64 32)
(const CLASS-MEMBER-OVERRIDE u64 64)
(const CLASS-MEMBER-DECLARE u64 128)
(const CLASS-MEMBER-ACCESSOR u64 256)
(const CLASS-MEMBER-GET u64 512)
(const CLASS-MEMBER-SET u64 1024)
(const CLASS-MEMBER-ASYNC u64 2048)
(const CLASS-MEMBER-SIGNATURE u64 4096)
(const CLASS-MEMBER-GENERATOR u64 8192)
(const CLASS-MEMBER-OPTIONAL u64 16384)
(const CLASS-MEMBER-DEFINITE u64 32768)
(const CLASS-MEMBER-FLAG-MASK u64 65535)

(const VERIFY-OK i64 0)
(const VERIFY-REGION-RANGE i64 1)
(const VERIFY-BLOCK-REGION i64 2)
(const VERIFY-BLOCK-RANGE i64 3)
(const VERIFY-PARAM-RANGE i64 4)
(const VERIFY-OP-RANGE i64 5)
(const VERIFY-OPERAND-RANGE i64 6)
(const VERIFY-SUCCESSOR-RANGE i64 7)
(const VERIFY-SUCCESSOR-TARGET i64 8)
(const VERIFY-SUCCESSOR-ARITY i64 9)
(const VERIFY-TERMINATOR-MISSING i64 10)
(const VERIFY-TERMINATOR-POSITION i64 11)
(const VERIFY-NONTERMINATOR-SUCCESSOR i64 12)
(const VERIFY-VALUE-RANGE i64 13)
(const VERIFY-VALUE-DEFINITION i64 14)
(const VERIFY-DOMINANCE i64 15)
(const VERIFY-USE-BEFORE-DEFINITION i64 16)
(const VERIFY-UNREACHABLE-BLOCK i64 17)
(const VERIFY-SCRATCH-CAPACITY i64 18)
(const VERIFY-SPAN i64 19)
(const VERIFY-REGION-OWNERSHIP i64 20)
(const VERIFY-DOMINATOR-NONCONVERGENCE i64 21)
(const VERIFY-SUCCESSOR-REGION i64 22)
(const VERIFY-SCOPE i64 23)
(const VERIFY-BINDING i64 24)
(const VERIFY-REFERENCE i64 25)
(const VERIFY-CAPTURE i64 26)
(const VERIFY-BLOCK-OWNERSHIP i64 27)
(const VERIFY-OP-OWNERSHIP i64 28)
(const VERIFY-VALUE-OWNERSHIP i64 29)
(const VERIFY-OPCODE i64 30)
(const VERIFY-REGION-PARENT i64 31)
(const VERIFY-TYPE-OPERAND i64 32)

(const PRINT-OK i64 0)
(const PRINT-CAPACITY i64 1)
(const PRINT-INVALID-OPCODE i64 2)

;; Structure-of-arrays storage. Lists are contiguous ranges into their named
;; planes, making iteration predictable and avoiding per-node allocation.
(defstruct IrArena
  [(source-size u32)

   (region-parent-ops (ptr u32))
   (region-first-blocks (ptr u32))
   (region-block-counts (ptr u32))
   (region-count u32)
   (region-blocks (ptr u32))
   (region-block-ref-count u32)

   (block-regions (ptr u32))
   (block-first-params (ptr u32))
   (block-param-counts (ptr u32))
   (block-first-ops (ptr u32))
   (block-op-counts (ptr u32))
   (block-count u32)
   (block-ops (ptr u32))
   (block-op-ref-count u32)

   (opcodes (ptr u16))
   (op-name-starts (ptr u32))
   (op-name-ends (ptr u32))
   (op-first-operands (ptr u32))
   (op-operand-counts (ptr u32))
   (op-first-results (ptr u32))
   (op-result-counts (ptr u32))
   (op-first-successors (ptr u32))
   (op-successor-counts (ptr u32))
   (op-first-regions (ptr u32))
   (op-region-counts (ptr u32))
   (op-regions (ptr u32))
   (op-region-ref-count u32)
   (op-starts (ptr u32))
   (op-ends (ptr u32))
   (op-immediates (ptr u64))
   (op-count u32)

   (operands (ptr u32))
   (operand-count u32)

   (successor-blocks (ptr u32))
   (successor-first-args (ptr u32))
   (successor-arg-counts (ptr u32))
   (successor-count u32)
   (successor-args (ptr u32))
   (successor-arg-count u32)

   (value-def-kinds (ptr u8))
   (value-def-indices (ptr u32))
   (value-count u32)

   ;; Lexical semantic identities. References point at bindings; captures
   ;; explicitly connect an inner scope to an outer binding.
   (scope-parents (ptr u32))
   (scope-starts (ptr u32))
   (scope-ends (ptr u32))
   (scope-count u32)
   (binding-scopes (ptr u32))
   (binding-name-starts (ptr u32))
   (binding-name-ends (ptr u32))
   (binding-count u32)
   (reference-bindings (ptr u32))
   (reference-starts (ptr u32))
   (reference-ends (ptr u32))
   (reference-count u32)
   (capture-scopes (ptr u32))
   (capture-bindings (ptr u32))
   (capture-count u32)])

(defstruct VerifyScratch
  [(dominators (ptr u64))
   (dominator-word-capacity i64)])

(defstruct VerifyResult
  [(error i64) (region u32) (block u32) (op u32) (index u32)])

(defstruct PrintBuffer
  [(data (ptr u8)) (capacity i64) (count i64) (error i64)])

(defstruct PrintResult [(count i64) (error i64)])

(defn ok-result [] (-> VerifyResult)
  (VerifyResult :error VERIFY-OK :region (cast u32 INVALID-ID) :block (cast u32 INVALID-ID)
                :op (cast u32 INVALID-ID) :index (cast u32 INVALID-ID)))

(defn verify-error [(code i64) (region u32) (block u32) (op u32) (index u32)]
  (-> VerifyResult)
  (VerifyResult :error code :region region :block block :op op :index index))

(defn terminator? [(opcode u16)] (-> bool)
  (or (= opcode (cast u16 OP-BR)) (= opcode (cast u16 OP-COND-BR))
      (= opcode (cast u16 OP-RETURN)) (= opcode (cast u16 OP-THROW))
      (= opcode (cast u16 OP-UNREACHABLE)) (= opcode (cast u16 OP-YIELD))))

(defn range-valid? [(first u32) (count u32) (limit u32)] (-> bool)
  (and (<= first limit) (<= count (- limit first))))

(defn block-membership-count [(arena (ptr IrArena)) (wanted u32)] (-> u32)
  (let [(mut at) (cast u32 0) (mut count) (cast u32 0)]
    (loop
      (if (>= (load at) (.region-block-ref-count arena)) (break)
        (do
          (if (= (load (p/index (.region-blocks arena) (cast i64 (load at)))) wanted)
              (set! count (+ (load count) (cast u32 1))) 0)
          (set! at (+ (load at) (cast u32 1))))))
    (load count)))

(defn op-membership-count [(arena (ptr IrArena)) (wanted u32)] (-> u32)
  (let [(mut at) (cast u32 0) (mut count) (cast u32 0)]
    (loop
      (if (>= (load at) (.block-op-ref-count arena)) (break)
        (do
          (if (= (load (p/index (.block-ops arena) (cast i64 (load at)))) wanted)
              (set! count (+ (load count) (cast u32 1))) 0)
          (set! at (+ (load at) (cast u32 1))))))
    (load count)))

(defn region-child-membership-count [(arena (ptr IrArena)) (wanted u32)] (-> u32)
  (let [(mut at) (cast u32 0) (mut count) (cast u32 0)]
    (loop
      (if (>= (load at) (.op-region-ref-count arena)) (break)
        (do
          (if (= (load (p/index (.op-regions arena) (cast i64 (load at)))) wanted)
              (set! count (+ (load count) (cast u32 1))) 0)
          (set! at (+ (load at) (cast u32 1))))))
    (load count)))

(defn region-block-at [(arena (ptr IrArena)) (region u32) (index u32)] (-> u32)
  (let [first (load (p/index (.region-first-blocks arena) (cast i64 region)))]
    (load (p/index (.region-blocks arena) (cast i64 (+ first index))))))

(defn block-op-at [(arena (ptr IrArena)) (block u32) (index u32)] (-> u32)
  (let [first (load (p/index (.block-first-ops arena) (cast i64 block)))]
    (load (p/index (.block-ops arena) (cast i64 (+ first index))))))

(defn find-op-block [(arena (ptr IrArena)) (op u32)] (-> u32)
  (let [(mut block) (cast u32 0) (mut found) (cast u32 INVALID-ID)]
    (loop
      (if (or (>= (load block) (.block-count arena))
              (!= (load found) (cast u32 INVALID-ID)))
          (break)
        (let [count (load (p/index (.block-op-counts arena) (cast i64 (load block))))
              (mut i) (cast u32 0)]
          (loop
            (if (or (>= (load i) count) (!= (load found) (cast u32 INVALID-ID))) (break)
              (do
                (if (= (block-op-at arena (load block) (load i)) op)
                    (store! found (load block)) 0)
                (set! i (+ (load i) (cast u32 1))))))
          (set! block (+ (load block) (cast u32 1))))))
    (load found)))

(defn op-position-in-block [(arena (ptr IrArena)) (block u32) (op u32)] (-> u32)
  (let [count (load (p/index (.block-op-counts arena) (cast i64 block)))
        (mut i) (cast u32 0) (mut found) (cast u32 INVALID-ID)]
    (loop
      (if (or (>= (load i) count) (!= (load found) (cast u32 INVALID-ID))) (break)
        (do
          (if (= (block-op-at arena block (load i)) op) (store! found (load i)) 0)
          (set! i (+ (load i) (cast u32 1))))))
    (load found)))

(defn find-param-block [(arena (ptr IrArena)) (param u32)] (-> u32)
  (let [(mut block) (cast u32 0) (mut found) (cast u32 INVALID-ID)]
    (loop
      (if (or (>= (load block) (.block-count arena))
              (!= (load found) (cast u32 INVALID-ID)))
          (break)
        (let [first (load (p/index (.block-first-params arena) (cast i64 (load block))))
              count (load (p/index (.block-param-counts arena) (cast i64 (load block))))]
          (if (and (>= param first) (< param (+ first count)))
              (store! found (load block)) 0)
          (set! block (+ (load block) (cast u32 1))))))
    (load found)))

(defn region-of-op [(arena (ptr IrArena)) (op u32)] (-> u32)
  (let [block (find-op-block arena op)]
    (if (= block (cast u32 INVALID-ID)) (cast u32 INVALID-ID)
      (load (p/index (.block-regions arena) (cast i64 block))))))

(defn dom-offset [(words i64) (block u32) (word i64)] (-> i64)
  (+ (* (cast i64 block) words) word))

(defn dom-bit? [(scratch (ptr VerifyScratch)) (words i64)
                (block u32) (candidate u32)] (-> bool)
  (!= (p/iand
        (load (p/index (.dominators scratch)
                       (dom-offset words block (p/idiv (cast i64 candidate) 64))))
        (p/ishl (cast u64 1) (cast u64 (p/irem (cast i64 candidate) 64))))
      (cast u64 0)))

(defn same-region-predecessor? [(arena (ptr IrArena)) (region u32)
                               (candidate u32) (target u32)] (-> bool)
  (let [op-count (load (p/index (.block-op-counts arena) (cast i64 candidate)))]
    (if (= op-count (cast u32 0)) false
      (let [term (block-op-at arena candidate (- op-count (cast u32 1)))
            first-succ (load (p/index (.op-first-successors arena) (cast i64 term)))
            succ-count (load (p/index (.op-successor-counts arena) (cast i64 term)))
            (mut i) (cast u32 0) (mut found) false]
        (loop
          (if (or (>= (load i) succ-count) (load found)) (break)
            (let [succ (+ first-succ (load i))]
              (if (= (load (p/index (.successor-blocks arena) (cast i64 succ))) target)
                  (store! found true) 0)
              (set! i (+ (load i) (cast u32 1))))))
        (load found)))))

(defn update-dominator-block! [(arena (ptr IrArena))
                               (scratch (ptr VerifyScratch))
                               (words i64) (block u32)] (-> bool)
  (let [region (load (p/index (.block-regions arena) (cast i64 block)))
        entry (region-block-at arena region (cast u32 0))
        (mut changed) false (mut word) 0]
    (if (= block entry) false
      (do
        (loop
          (if (>= (load word) words) (break)
            (let [(mut intersection) (p/inot (cast u64 0))
                  (mut candidate) (cast u32 0) (mut has-predecessor) false]
              (loop
                (if (>= (load candidate) (.block-count arena)) (break)
                  (do
                    (if (and (= (load (p/index (.block-regions arena)
                                             (cast i64 (load candidate)))) region)
                             (same-region-predecessor? arena region
                                                       (load candidate) block))
                        (do
                          (store! has-predecessor true)
                          (store! intersection
                            (p/iand (load intersection)
                              (load (p/index (.dominators scratch)
                                (dom-offset words (load candidate) (load word))))))) 0)
                    (set! candidate (+ (load candidate) (cast u32 1))))))
              (if (not (load has-predecessor))
                  (store! intersection (cast u64 0)) 0)
              (let [self-word (p/idiv (cast i64 block) 64)
                    self-bit (p/irem (cast i64 block) 64)
                    next (if (= (load word) self-word)
                             (p/ior (load intersection)
                                    (p/ishl (cast u64 1) (cast u64 self-bit)))
                           (load intersection))
                    at (dom-offset words block (load word))]
                (if (!= next (load (p/index (.dominators scratch) at)))
                    (do
                      (store! (p/index (.dominators scratch) at) next)
                      (store! changed true)) 0))
              (set! word (+ (load word) 1)))))
        (load changed)))))

(defn compute-dominators! [(arena (ptr IrArena)) (scratch (ptr VerifyScratch))]
  (-> VerifyResult)
  (let [words (p/idiv (+ (cast i64 (.block-count arena)) 63) 64)
        required (* words (cast i64 (.block-count arena)))]
    (if (> required (.dominator-word-capacity scratch))
        (verify-error VERIFY-SCRATCH-CAPACITY (cast u32 INVALID-ID) (cast u32 INVALID-ID)
                      (cast u32 INVALID-ID)
                      (cast u32 required))
      (do
        ;; Initialize each region entry to itself and other blocks to the full
        ;; set of blocks in their region.
        (let [(mut block) (cast u32 0)]
          (loop
            (if (>= (load block) (.block-count arena)) (break)
              (let [region (load (p/index (.block-regions arena) (cast i64 (load block))))
                    entry (region-block-at arena region (cast u32 0))
                    region-count (load (p/index (.region-block-counts arena) (cast i64 region)))
                    (mut word) 0]
                (loop
                  (if (>= (load word) words) (break)
                    (do
                      (store! (p/index (.dominators scratch)
                                      (dom-offset words (load block) (load word)))
                              (cast u64 0))
                      (set! word (+ (load word) 1)))))
                (if (= (load block) entry)
                    (let [word (p/idiv (cast i64 entry) 64)
                          bit (p/irem (cast i64 entry) 64)]
                      (store! (p/index (.dominators scratch)
                                      (dom-offset words (load block) word))
                              (p/ishl (cast u64 1) (cast u64 bit))))
                  (let [(mut member-index) (cast u32 0)]
                    (loop
                      (if (>= (load member-index) region-count) (break)
                        (let [member (region-block-at arena region (load member-index))
                              word (p/idiv (cast i64 member) 64)
                              at (dom-offset words (load block) word)
                              bit (p/irem (cast i64 member) 64)]
                          (store! (p/index (.dominators scratch) at)
                                  (p/ior (load (p/index (.dominators scratch) at))
                                         (p/ishl (cast u64 1) (cast u64 bit))))
                          (set! member-index (+ (load member-index) (cast u32 1))))))))
                (set! block (+ (load block) (cast u32 1)))))))
        ;; Classic fixed-point predecessor intersection. Dominator sets only
        ;; shrink, so a valid graph converges in at most block-count rounds.
        (let [(mut changed) true (mut iterations) (cast u32 0)]
          (loop
            (if (not (load changed)) (break (ok-result))
              (if (> (load iterations) (.block-count arena))
                  (break (verify-error VERIFY-DOMINATOR-NONCONVERGENCE
                                       (cast u32 INVALID-ID) (cast u32 INVALID-ID)
                                       (cast u32 INVALID-ID)
                                       (load iterations)))
                (do
                  (set! iterations (+ (load iterations) (cast u32 1)))
                  (store! changed false)
                  (let [(mut block) (cast u32 0)]
                    (loop
                      (if (>= (load block) (.block-count arena)) (break)
                        (do
                          (if (update-dominator-block! arena scratch words (load block))
                              (store! changed true) 0)
                          (set! block (+ (load block) (cast u32 1))))))))))))))))

;; Reachability is checked independently of dominance. Without this phase, a
;; disconnected cycle retains the optimistic "all region members dominate me"
;; initialization and can make invalid cross-block uses appear valid.
(defn verify-reachability! [(arena (ptr IrArena)) (scratch (ptr VerifyScratch))]
  (-> VerifyResult)
  (let [words (p/idiv (+ (cast i64 (.block-count arena)) 63) 64)]
    (if (> words (.dominator-word-capacity scratch))
        (verify-error VERIFY-SCRATCH-CAPACITY (cast u32 INVALID-ID)
                      (cast u32 INVALID-ID) (cast u32 INVALID-ID) (cast u32 words))
      (do
        (let [(mut word) 0]
          (loop
            (if (>= (load word) words) (break)
              (do
                (store! (p/index (.dominators scratch) (load word)) (cast u64 0))
                (set! word (+ (load word) 1))))))
        (let [(mut region) (cast u32 0)]
          (loop
            (if (>= (load region) (.region-count arena)) (break)
              (let [entry (region-block-at arena (load region) (cast u32 0))
                    word (p/idiv (cast i64 entry) 64)
                    bit (p/irem (cast i64 entry) 64)]
                (store! (p/index (.dominators scratch) word)
                        (p/ior (load (p/index (.dominators scratch) word))
                               (p/ishl (cast u64 1) (cast u64 bit))))
                (set! region (+ (load region) (cast u32 1)))))))
        (let [(mut changed) true]
          (loop
            (if (not (load changed)) (break)
              (do
                (store! changed false)
                (let [(mut block) (cast u32 0)]
                  (loop
                    (if (>= (load block) (.block-count arena)) (break)
                      (let [word (p/idiv (cast i64 (load block)) 64)
                            bit (p/irem (cast i64 (load block)) 64)
                            reachable (!= (p/iand
                                             (load (p/index (.dominators scratch) word))
                                             (p/ishl (cast u64 1) (cast u64 bit)))
                                          (cast u64 0))]
                        (if reachable
                            (let [op-count (load (p/index (.block-op-counts arena)
                                                         (cast i64 (load block))))
                                  term (block-op-at arena (load block)
                                                    (- op-count (cast u32 1)))
                                  first (load (p/index (.op-first-successors arena)
                                                       (cast i64 term)))
                                  count (load (p/index (.op-successor-counts arena)
                                                       (cast i64 term)))
                                  (mut i) (cast u32 0)]
                              (loop
                                (if (>= (load i) count) (break)
                                  (let [target (load (p/index (.successor-blocks arena)
                                                              (cast i64 (+ first (load i)))))
                                        target-word (p/idiv (cast i64 target) 64)
                                        target-bit (p/irem (cast i64 target) 64)
                                        mask (p/ishl (cast u64 1) (cast u64 target-bit))
                                        old (load (p/index (.dominators scratch) target-word))]
                                    (if (= (p/iand old mask) (cast u64 0))
                                        (do
                                          (store! (p/index (.dominators scratch) target-word)
                                                  (p/ior old mask))
                                          (store! changed true)) 0)
                                    (set! i (+ (load i) (cast u32 1))))))) 0)
                        (set! block (+ (load block) (cast u32 1)))))))))))
        (let [(mut block) (cast u32 0) (mut result) (ok-result)]
          (loop
            (if (or (>= (load block) (.block-count arena))
                    (!= (.error result) VERIFY-OK)) (break)
              (let [word (p/idiv (cast i64 (load block)) 64)
                    bit (p/irem (cast i64 (load block)) 64)]
                (if (= (p/iand (load (p/index (.dominators scratch) word))
                               (p/ishl (cast u64 1) (cast u64 bit)))
                       (cast u64 0))
                    (store! result
                      (verify-error VERIFY-UNREACHABLE-BLOCK
                                    (load (p/index (.block-regions arena)
                                                   (cast i64 (load block))))
                                    (load block) (cast u32 INVALID-ID)
                                    (cast u32 INVALID-ID))) 0)
                (set! block (+ (load block) (cast u32 1))))))
          (load result))))))

(defn verify-value-use [(arena (ptr IrArena)) (scratch (ptr VerifyScratch))
                       (words i64) (value u32) (use-block u32) (use-op u32)
                       (use-index u32)] (-> VerifyResult)
  (if (>= value (.value-count arena))
      (verify-error VERIFY-VALUE-RANGE
                    (load (p/index (.block-regions arena) (cast i64 use-block)))
                    use-block use-op use-index)
    (let [kind (load (p/index (.value-def-kinds arena) (cast i64 value)))
          def (load (p/index (.value-def-indices arena) (cast i64 value)))
          def-block (if (= kind (cast u8 DEF-BLOCK-PARAM)) (find-param-block arena def)
                      (if (= kind (cast u8 DEF-OP-RESULT)) (find-op-block arena def)
                        (cast u32 INVALID-ID)))]
      (if (= def-block (cast u32 INVALID-ID))
          (verify-error VERIFY-VALUE-DEFINITION
                        (load (p/index (.block-regions arena) (cast i64 use-block)))
                        use-block use-op value)
        (if (= def-block use-block)
            (if (= kind (cast u8 DEF-OP-RESULT))
                (let [def-position (op-position-in-block arena use-block def)
                      use-position (op-position-in-block arena use-block use-op)]
                  (if (or (= def-position (cast u32 INVALID-ID))
                          (= use-position (cast u32 INVALID-ID))
                          (>= def-position use-position))
                      (verify-error VERIFY-USE-BEFORE-DEFINITION
                                    (load (p/index (.block-regions arena)
                                                   (cast i64 use-block)))
                                    use-block use-op value)
                    (ok-result)))
              (ok-result))
          (if (not (dom-bit? scratch words use-block def-block))
              (verify-error VERIFY-DOMINANCE
                            (load (p/index (.block-regions arena) (cast i64 use-block)))
                            use-block use-op value)
            (ok-result)))))))

(defn verify-op-owned-ranges [(arena (ptr IrArena)) (region u32) (block u32) (op u32)]
  (-> VerifyResult)
  (let [first-region (load (p/index (.op-first-regions arena) (cast i64 op)))
        region-count (load (p/index (.op-region-counts arena) (cast i64 op)))
        first-successor (load (p/index (.op-first-successors arena) (cast i64 op)))
        successor-count (load (p/index (.op-successor-counts arena) (cast i64 op)))
        (mut i) (cast u32 0)
        (mut result) (ok-result)]
    (loop
      (if (or (>= (load i) region-count) (!= (.error result) VERIFY-OK)) (break)
        (let [child (load (p/index (.op-regions arena)
                                   (cast i64 (+ first-region (load i)))))]
          (if (or (>= child (.region-count arena))
                  (!= (load (p/index (.region-parent-ops arena) (cast i64 child))) op))
              (store! result (verify-error VERIFY-REGION-OWNERSHIP region block op child)) 0)
          (set! i (+ (load i) (cast u32 1))))))
    (set! i (cast u32 0))
    (loop
      (if (or (>= (load i) successor-count) (!= (.error result) VERIFY-OK)) (break)
        (let [successor (+ first-successor (load i))
              target (load (p/index (.successor-blocks arena) (cast i64 successor)))]
          (if (and (< target (.block-count arena))
                   (!= (load (p/index (.block-regions arena) (cast i64 target))) region))
              (store! result (verify-error VERIFY-SUCCESSOR-REGION region block op successor)) 0)
          (set! i (+ (load i) (cast u32 1))))))
    (load result)))

(defn verify-value-definitions [(arena (ptr IrArena))] (-> VerifyResult)
  (let [(mut block) (cast u32 0) (mut result) (ok-result)]
    (loop
      (if (or (>= (load block) (.block-count arena))
              (!= (.error result) VERIFY-OK)) (break)
        (let [first (load (p/index (.block-first-params arena) (cast i64 (load block))))
              count (load (p/index (.block-param-counts arena) (cast i64 (load block))))
              (mut i) (cast u32 0)]
          (loop
            (if (or (>= (load i) count) (!= (.error result) VERIFY-OK)) (break)
              (let [value (+ first (load i))]
                (if (or (!= (load (p/index (.value-def-kinds arena) (cast i64 value)))
                            (cast u8 DEF-BLOCK-PARAM))
                        (!= (load (p/index (.value-def-indices arena) (cast i64 value))) value))
                    (store! result (verify-error VERIFY-VALUE-DEFINITION
                                                 (load (p/index (.block-regions arena)
                                                                (cast i64 (load block))))
                                                 (load block) (cast u32 INVALID-ID) value)) 0)
                (set! i (+ (load i) (cast u32 1))))))
          (set! block (+ (load block) (cast u32 1))))))
    (let [(mut op) (cast u32 0)]
      (loop
        (if (or (>= (load op) (.op-count arena)) (!= (.error result) VERIFY-OK)) (break)
          (let [first (load (p/index (.op-first-results arena) (cast i64 (load op))))
                count (load (p/index (.op-result-counts arena) (cast i64 (load op))))
                (mut i) (cast u32 0)]
            (loop
              (if (or (>= (load i) count) (!= (.error result) VERIFY-OK)) (break)
                (let [value (+ first (load i))]
                  (if (or (!= (load (p/index (.value-def-kinds arena) (cast i64 value)))
                              (cast u8 DEF-OP-RESULT))
                          (!= (load (p/index (.value-def-indices arena) (cast i64 value)))
                              (load op)))
                      (store! result (verify-error VERIFY-VALUE-DEFINITION
                                                   (cast u32 INVALID-ID)
                                                   (find-op-block arena (load op))
                                                   (load op) value)) 0)
                  (set! i (+ (load i) (cast u32 1))))))
            (set! op (+ (load op) (cast u32 1)))))))
    (load result)))

(defn type-value-opcode? [(opcode u16)] (-> bool)
  (cond
    (= opcode OP-TS-TYPE) true
    (= opcode OP-TS-TYPE-REFERENCE) true
    (= opcode OP-TS-KEYWORD-TYPE) true
    (= opcode OP-TS-LITERAL-TYPE) true
    (= opcode OP-TS-UNION-TYPE) true
    (= opcode OP-TS-INTERSECTION-TYPE) true
    (= opcode OP-TS-ARRAY-TYPE) true
    (= opcode OP-TS-TUPLE-TYPE) true
    (= opcode OP-TS-PARENTHESIZED-TYPE) true
    (= opcode OP-TS-QUALIFIED-TYPE) true
    (= opcode OP-TS-INDEXED-ACCESS-TYPE) true
    (= opcode OP-TS-TYPE-OPERATOR) true
    (= opcode OP-TS-TYPE-QUERY) true
    (= opcode OP-TS-FUNCTION-TYPE) true
    (= opcode OP-TS-CONSTRUCTOR-TYPE) true
    (= opcode OP-TS-TYPE-LITERAL) true
    (= opcode OP-TS-CONDITIONAL-TYPE) true
    (= opcode OP-TS-INFER-TYPE) true
    (= opcode OP-TS-MAPPED-TYPE) true
    (= opcode OP-TS-TEMPLATE-LITERAL-TYPE) true
    (= opcode OP-TS-IMPORT-TYPE) true
    (= opcode OP-TS-TYPE-PREDICATE) true
    (= opcode OP-TS-NAMED-TUPLE-MEMBER) true
    (= opcode OP-TS-OPTIONAL-TYPE) true
    (= opcode OP-TS-REST-TYPE) true
    :else false))

(defn value-defined-by-opcode?
  [(arena (ptr IrArena)) (value u32) (opcode u16)] (-> bool)
  (if (>= value (.value-count arena)) false
    (if (!= (load (p/index (.value-def-kinds arena) (cast i64 value)))
            (cast u8 DEF-OP-RESULT)) false
      (let [definition
              (load (p/index (.value-def-indices arena) (cast i64 value)))]
        (and (< definition (.op-count arena))
             (= (load (p/index (.opcodes arena) (cast i64 definition))) opcode))))))

(defn type-value? [(arena (ptr IrArena)) (value u32)] (-> bool)
  (if (>= value (.value-count arena)) false
    (if (!= (load (p/index (.value-def-kinds arena) (cast i64 value)))
            (cast u8 DEF-OP-RESULT)) false
      (let [definition
              (load (p/index (.value-def-indices arena) (cast i64 value)))]
        (and (< definition (.op-count arena))
             (type-value-opcode?
               (load (p/index (.opcodes arena) (cast i64 definition)))))))))

(defn binding-pattern-value? [(arena (ptr IrArena)) (value u32)] (-> bool)
  (if (>= value (.value-count arena)) false
    (if (!= (load (p/index (.value-def-kinds arena) (cast i64 value)))
            (cast u8 DEF-OP-RESULT)) false
      (let [definition
              (load (p/index (.value-def-indices arena) (cast i64 value)))]
        (if (>= definition (.op-count arena)) false
          (let [opcode (load (p/index (.opcodes arena) (cast i64 definition)))]
            (or (= opcode OP-JS-BINDING-IDENTIFIER)
              (or (= opcode OP-JS-OBJECT-BINDING-PATTERN)
                (or (= opcode OP-JS-ARRAY-BINDING-PATTERN)
                  (or (= opcode OP-JS-REST-BINDING)
                      (= opcode OP-JS-ASSIGNMENT-BINDING)))))))))))

(defn verify-type-operands [(arena (ptr IrArena))] (-> VerifyResult)
  (let [(mut op) (cast u32 0) (mut result) (ok-result)]
    (loop
      (if (or (>= (load op) (.op-count arena))
              (!= (.error result) VERIFY-OK)) (break)
        (let [opcode (load (p/index (.opcodes arena) (cast i64 (load op))))
              immediate (load (p/index (.op-immediates arena) (cast i64 (load op))))
              first (load (p/index (.op-first-operands arena) (cast i64 (load op))))
              count (load (p/index (.op-operand-counts arena) (cast i64 (load op))))
              all-types
                (cond
                  (= opcode OP-TS-TYPE) true
                  (= opcode OP-TS-UNION-TYPE) true
                  (= opcode OP-TS-INTERSECTION-TYPE) true
                  (= opcode OP-TS-ARRAY-TYPE) true
                  (= opcode OP-TS-TUPLE-TYPE) true
                  (= opcode OP-TS-TYPE-ARGUMENTS) true
                  (= opcode OP-TS-PARENTHESIZED-TYPE) true
                  (= opcode OP-TS-INDEXED-ACCESS-TYPE) true
                  (= opcode OP-TS-TYPE-OPERATOR) true
                  (= opcode OP-TS-CONDITIONAL-TYPE) true
                  (= opcode OP-TS-OPTIONAL-TYPE) true
                  (= opcode OP-TS-REST-TYPE) true
                  :else false)
              (mut index) (cast u32 0)]
          (if all-types
              (loop
                (if (or (>= (load index) count)
                        (!= (.error result) VERIFY-OK)) (break)
                  (let [value (load (p/index (.operands arena)
                                      (cast i64 (+ first (load index)))))]
                    (if (not (type-value? arena value))
                        (store! result
                          (verify-error VERIFY-TYPE-OPERAND (cast u32 INVALID-ID)
                            (find-op-block arena (load op)) (load op) (load index))) 0)
                    (set! index (+ (load index) (cast u32 1)))))) 0)
          (if (and (= (.error result) VERIFY-OK)
                   (= opcode OP-TS-INFER-TYPE))
              (let [value (load (p/index (.operands arena) (cast i64 first)))]
                (if (not (value-defined-by-opcode? arena value OP-TS-TYPE-PARAMETER))
                    (store! result
                      (verify-error VERIFY-TYPE-OPERAND (cast u32 INVALID-ID)
                        (find-op-block arena (load op)) (load op) (cast u32 0))) 0)) 0)
          (if (and (= (.error result) VERIFY-OK)
                   (= opcode OP-TS-TYPE-PARAMETER))
              (do
                (set! index (cast u32 0))
                (loop
                  (if (or (>= (load index) count)
                          (!= (.error result) VERIFY-OK)) (break)
                    (let [value (load (p/index (.operands arena)
                                        (cast i64 (+ first (load index)))))]
                      (if (not (type-value? arena value))
                          (store! result
                            (verify-error VERIFY-TYPE-OPERAND (cast u32 INVALID-ID)
                              (find-op-block arena (load op)) (load op) (load index))) 0)
                      (set! index (+ (load index) (cast u32 1))))))) 0)
          (if (and (= (.error result) VERIFY-OK) (= opcode OP-TS-HERITAGE))
              (do
                (set! index (cast u32 0))
                (loop
                  (if (or (>= (load index) count)
                          (!= (.error result) VERIFY-OK)) (break)
                    (let [value (load (p/index (.operands arena)
                                        (cast i64 (+ first (load index)))))]
                      (if (not (or
                                (value-defined-by-opcode? arena value
                                  OP-TS-TYPE-REFERENCE)
                                (value-defined-by-opcode? arena value
                                  OP-TS-QUALIFIED-TYPE)))
                          (store! result
                            (verify-error VERIFY-TYPE-OPERAND (cast u32 INVALID-ID)
                              (find-op-block arena (load op)) (load op) (load index))) 0)
                      (set! index (+ (load index) (cast u32 1))))))) 0)
          (if (and (= (.error result) VERIFY-OK)
                   (= opcode OP-TS-FUNCTION-TYPE-PARAMETER))
              (let [pattern
                      (!= (p/iand immediate FUNCTION-TYPE-PARAM-PATTERN)
                          (cast u64 0))
                    has-type
                      (!= (p/iand immediate FUNCTION-TYPE-PARAM-HAS-TYPE)
                          (cast u64 0))
                    type-index (if pattern (cast u32 1) (cast u32 0))]
                (if (or (and has-type
                          (not (type-value? arena
                            (load (p/index (.operands arena)
                              (cast i64 (+ first type-index)))))))
                        (and pattern
                          (not (binding-pattern-value? arena
                            (load (p/index (.operands arena) (cast i64 first)))))))
                    (store! result
                      (verify-error VERIFY-TYPE-OPERAND (cast u32 INVALID-ID)
                        (find-op-block arena (load op)) (load op) type-index)) 0)) 0)
          (if (and (= (.error result) VERIFY-OK)
                   (= opcode OP-TS-PROPERTY-SIGNATURE))
              (let [computed
                      (!= (p/iand immediate TYPE-MEMBER-COMPUTED) (cast u64 0))
                    has-type
                      (!= (p/iand immediate TYPE-MEMBER-HAS-TYPE) (cast u64 0))
                    type-index (if computed (cast u32 1) (cast u32 0))]
                (if (and has-type
                      (not (type-value? arena
                        (load (p/index (.operands arena)
                          (cast i64 (+ first type-index)))))))
                    (store! result
                      (verify-error VERIFY-TYPE-OPERAND (cast u32 INVALID-ID)
                        (find-op-block arena (load op)) (load op) type-index)) 0)) 0)
          (if (and (= (.error result) VERIFY-OK)
                   (or (= opcode OP-TS-FUNCTION-TYPE)
                     (or (= opcode OP-TS-CONSTRUCTOR-TYPE)
                       (or (= opcode OP-TS-CALL-SIGNATURE)
                         (or (= opcode OP-TS-CONSTRUCT-SIGNATURE)
                             (= opcode OP-TS-METHOD-SIGNATURE))))))
              (let [computed
                      (!= (p/iand immediate CALLABLE-TYPE-COMPUTED) (cast u64 0))
                    has-parameters
                      (!= (p/iand immediate CALLABLE-TYPE-HAS-TYPE-PARAMETERS)
                          (cast u64 0))
                    has-return
                      (!= (p/iand immediate CALLABLE-TYPE-HAS-RETURN-TYPE)
                          (cast u64 0))
                    getter (!= (p/iand immediate CALLABLE-TYPE-GETTER) (cast u64 0))
                    setter (!= (p/iand immediate CALLABLE-TYPE-SETTER) (cast u64 0))
                    prefix-count
                      (+ (if computed (cast u32 1) (cast u32 0))
                         (if has-parameters (cast u32 1) (cast u32 0)))
                    parameter-count
                      (- count (+ prefix-count
                        (if has-return (cast u32 1) (cast u32 0))))]
                (if (and has-parameters
                      (not (value-defined-by-opcode? arena
                        (load (p/index (.operands arena)
                          (cast i64 (+ first
                            (if computed (cast u32 1) (cast u32 0))))))
                        OP-TS-TYPE-PARAMETERS)))
                    (store! result
                      (verify-error VERIFY-TYPE-OPERAND (cast u32 INVALID-ID)
                        (find-op-block arena (load op)) (load op)
                        (if computed (cast u32 1) (cast u32 0)))) 0)
                (if (and (= (.error result) VERIFY-OK)
                         (or (and getter (!= parameter-count (cast u32 0)))
                             (and setter (!= parameter-count (cast u32 1)))))
                    (store! result
                      (verify-error VERIFY-TYPE-OPERAND (cast u32 INVALID-ID)
                        (find-op-block arena (load op)) (load op) parameter-count)) 0)
                (set! index (cast u32 0))
                (loop
                  (if (or (>= (load index) parameter-count)
                          (!= (.error result) VERIFY-OK)) (break)
                    (let [operand-index (+ prefix-count (load index))
                          value (load (p/index (.operands arena)
                                  (cast i64 (+ first operand-index))))]
                      (if (not (value-defined-by-opcode? arena value
                                  OP-TS-FUNCTION-TYPE-PARAMETER))
                          (store! result
                            (verify-error VERIFY-TYPE-OPERAND (cast u32 INVALID-ID)
                              (find-op-block arena (load op)) (load op)
                              operand-index)) 0)
                      (set! index (+ (load index) (cast u32 1))))))
                (if (and (= (.error result) VERIFY-OK) has-return
                      (not (type-value? arena
                        (load (p/index (.operands arena)
                          (cast i64 (+ first (- count (cast u32 1)))))))))
                    (store! result
                      (verify-error VERIFY-TYPE-OPERAND (cast u32 INVALID-ID)
                        (find-op-block arena (load op)) (load op)
                        (- count (cast u32 1)))) 0)) 0)
          (if (and (= (.error result) VERIFY-OK)
                   (or (= opcode OP-JS-BINDING-PROPERTY)
                       (= opcode OP-JS-REST-BINDING)))
              (let [target-index
                      (if (and (= opcode OP-JS-BINDING-PROPERTY)
                               (!= (p/iand immediate BINDING-PROPERTY-COMPUTED)
                                   (cast u64 0)))
                          (cast u32 1) (cast u32 0))
                    target (load (p/index (.operands arena)
                                   (cast i64 (+ first target-index))))]
                (if (not (binding-pattern-value? arena target))
                    (store! result
                      (verify-error VERIFY-TYPE-OPERAND (cast u32 INVALID-ID)
                        (find-op-block arena (load op)) (load op) target-index)) 0)) 0)
          (if (and (= (.error result) VERIFY-OK)
                   (= opcode OP-JS-ASSIGNMENT-BINDING))
              (let [target (load (p/index (.operands arena) (cast i64 first)))]
                (if (not (binding-pattern-value? arena target))
                    (store! result
                      (verify-error VERIFY-TYPE-OPERAND (cast u32 INVALID-ID)
                        (find-op-block arena (load op)) (load op) (cast u32 0))) 0)) 0)
          (if (and (= (.error result) VERIFY-OK)
                   (or (= opcode OP-JS-OBJECT-BINDING-PATTERN)
                       (= opcode OP-JS-ARRAY-BINDING-PATTERN)))
              (do
                (set! index (cast u32 0))
                (loop
                  (if (or (>= (load index) count)
                          (!= (.error result) VERIFY-OK)) (break)
                    (let [value (load (p/index (.operands arena)
                                        (cast i64 (+ first (load index)))))
                          valid
                            (if (= opcode OP-JS-OBJECT-BINDING-PATTERN)
                                (or (value-defined-by-opcode? arena value
                                      OP-JS-BINDING-PROPERTY)
                                    (value-defined-by-opcode? arena value
                                      OP-JS-REST-BINDING))
                              (or (binding-pattern-value? arena value)
                                  (value-defined-by-opcode? arena value OP-JS-ELISION)))]
                      (if (not valid)
                          (store! result
                            (verify-error VERIFY-TYPE-OPERAND (cast u32 INVALID-ID)
                              (find-op-block arena (load op)) (load op) (load index))) 0)
                      (set! index (+ (load index) (cast u32 1))))))) 0)
          (set! op (+ (load op) (cast u32 1))))))
    (load result)))

(defn value-membership-count [(arena (ptr IrArena)) (wanted u32)] (-> u32)
  (let [(mut count) (cast u32 0) (mut block) (cast u32 0)]
    (loop
      (if (>= (load block) (.block-count arena)) (break)
        (let [first (load (p/index (.block-first-params arena) (cast i64 (load block))))
              amount (load (p/index (.block-param-counts arena) (cast i64 (load block))))]
          (if (and (>= wanted first) (< wanted (+ first amount)))
              (set! count (+ (load count) (cast u32 1))) 0)
          (set! block (+ (load block) (cast u32 1))))))
    (let [(mut op) (cast u32 0)]
      (loop
        (if (>= (load op) (.op-count arena)) (break)
          (let [first (load (p/index (.op-first-results arena) (cast i64 (load op))))
                amount (load (p/index (.op-result-counts arena) (cast i64 (load op))))]
            (if (and (>= wanted first) (< wanted (+ first amount)))
                (set! count (+ (load count) (cast u32 1))) 0)
            (set! op (+ (load op) (cast u32 1)))))))
    (load count)))

(defn verify-unique-ownership [(arena (ptr IrArena))] (-> VerifyResult)
  (let [(mut result) (ok-result) (mut block) (cast u32 0)]
    (let [(mut at) (cast u32 0)]
      (loop
        (if (or (>= (load at) (.block-op-ref-count arena))
                (!= (.error result) VERIFY-OK)) (break)
          (do
            (if (>= (load (p/index (.block-ops arena) (cast i64 (load at))))
                    (.op-count arena))
                (store! result
                  (verify-error VERIFY-OP-OWNERSHIP (cast u32 INVALID-ID)
                                (cast u32 INVALID-ID)
                                (load (p/index (.block-ops arena) (cast i64 (load at))))
                                (load at))) 0)
            (set! at (+ (load at) (cast u32 1)))))))
    (loop
      (if (or (>= (load block) (.block-count arena))
              (!= (.error result) VERIFY-OK)) (break)
        (do
          (if (!= (block-membership-count arena (load block)) (cast u32 1))
              (store! result
                (verify-error VERIFY-BLOCK-OWNERSHIP
                              (load (p/index (.block-regions arena)
                                             (cast i64 (load block))))
                              (load block) (cast u32 INVALID-ID)
                              (block-membership-count arena (load block)))) 0)
          (set! block (+ (load block) (cast u32 1))))))
    (let [(mut op) (cast u32 0)]
      (loop
        (if (or (>= (load op) (.op-count arena))
                (!= (.error result) VERIFY-OK)) (break)
          (do
            (if (!= (op-membership-count arena (load op)) (cast u32 1))
                (store! result
                  (verify-error VERIFY-OP-OWNERSHIP (cast u32 INVALID-ID)
                                (cast u32 INVALID-ID) (load op)
                                (op-membership-count arena (load op)))) 0)
            (set! op (+ (load op) (cast u32 1)))))))
    (let [(mut value) (cast u32 0)]
      (loop
        (if (or (>= (load value) (.value-count arena))
                (!= (.error result) VERIFY-OK)) (break)
          (do
            (if (!= (value-membership-count arena (load value)) (cast u32 1))
                (store! result
                  (verify-error VERIFY-VALUE-OWNERSHIP (cast u32 INVALID-ID)
                                (cast u32 INVALID-ID) (cast u32 INVALID-ID)
                                (load value))) 0)
            (set! value (+ (load value) (cast u32 1)))))))
    (let [(mut region) (cast u32 0)]
      (loop
        (if (or (>= (load region) (.region-count arena))
                (!= (.error result) VERIFY-OK)) (break)
          (let [parent (load (p/index (.region-parent-ops arena)
                                      (cast i64 (load region))))
                memberships (region-child-membership-count arena (load region))]
            (if (if (= parent (cast u32 INVALID-ID))
                    (!= memberships (cast u32 0))
                  (!= memberships (cast u32 1)))
                (store! result
                  (verify-error VERIFY-REGION-PARENT (load region)
                                (cast u32 INVALID-ID) parent memberships)) 0)
          (set! region (+ (load region) (cast u32 1)))))))
    (load result)))

(defn verify-opcode-shape [(arena (ptr IrArena)) (region u32) (block u32) (op u32)]
  (-> VerifyResult)
  (let [opcode (load (p/index (.opcodes arena) (cast i64 op)))
        immediate (load (p/index (.op-immediates arena) (cast i64 op)))
        operands (load (p/index (.op-operand-counts arena) (cast i64 op)))
        results (load (p/index (.op-result-counts arena) (cast i64 op)))
        successors (load (p/index (.op-successor-counts arena) (cast i64 op)))
        regions (load (p/index (.op-region-counts arena) (cast i64 op)))]
    (if (or (= opcode (cast u16 OP-INVALID))
            (and (= opcode (cast u16 OP-BR))
                 (or (!= successors (cast u32 1)) (!= results (cast u32 0))))
            (and (= opcode (cast u16 OP-COND-BR))
                 (or (!= operands (cast u32 1)) (!= successors (cast u32 2))
                     (!= results (cast u32 0))))
            (and (= opcode (cast u16 OP-RETURN))
                 (or (> operands (cast u32 1)) (!= successors (cast u32 0))
                     (!= results (cast u32 0))))
            (and (= opcode (cast u16 OP-THROW))
                 (or (!= operands (cast u32 1)) (!= successors (cast u32 0))
                     (!= results (cast u32 0))))
            (and (= opcode (cast u16 OP-YIELD))
                 (or (!= operands (cast u32 0)) (!= successors (cast u32 0))
                     (!= results (cast u32 0))))
            (and (= opcode (cast u16 OP-JS-TRY))
                 (or (!= operands (cast u32 0)) (!= successors (cast u32 0))
                     (!= results (cast u32 0)) (< regions (cast u32 1))
                     (> regions (cast u32 3))))
            (and (= opcode (cast u16 OP-JS-CLASS))
                 (let [has-super (!= (p/iand immediate CLASS-HAS-SUPER)
                                      (cast u64 0))
                       implements-count
                         (cast u32 (p/ishr immediate (cast u64 CLASS-IMPLEMENTS-SHIFT)))
                       expected (+ (if has-super (cast u32 1) (cast u32 0))
                                   implements-count)]
                   (or (!= operands expected) (!= successors (cast u32 0))
                       (> results (cast u32 1)) (!= regions (cast u32 1)))))
            (and (= opcode (cast u16 OP-JS-CLASS-METHOD))
                 (or (!= (p/iand immediate (p/inot CLASS-MEMBER-FLAG-MASK)) (cast u64 0))
                     (> operands (cast u32 1)) (!= successors (cast u32 0))
                     (!= results (cast u32 0))
                     (!= regions (cast u32 1))))
            (and (= opcode (cast u16 OP-JS-CLASS-FIELD))
                 (or (!= (p/iand immediate (p/inot CLASS-MEMBER-FLAG-MASK)) (cast u64 0))
                     (> operands (cast u32 2)) (!= successors (cast u32 0))
                     (!= results (cast u32 0)) (!= regions (cast u32 0))))
            (and (= opcode (cast u16 OP-JS-CLASS-STATIC-BLOCK))
                 (or (!= operands (cast u32 0)) (!= successors (cast u32 0))
                     (!= results (cast u32 0)) (!= regions (cast u32 1))))
            (and (= opcode (cast u16 OP-JS-DECORATOR))
                 (or (!= operands (cast u32 1)) (!= successors (cast u32 0))
                     (!= results (cast u32 0)) (!= regions (cast u32 0))))
            (and (= opcode (cast u16 OP-TS-PARAMETER-PROPERTY))
                 (or (!= operands (cast u32 0)) (!= successors (cast u32 0))
                     (!= results (cast u32 0)) (!= regions (cast u32 0))))
            (and (= opcode (cast u16 OP-TS-CLASS-INDEX-SIGNATURE))
                 (or (!= (p/iand immediate (p/inot CLASS-MEMBER-FLAG-MASK)) (cast u64 0))
                     (!= operands (cast u32 0)) (!= successors (cast u32 0))
                     (!= results (cast u32 0)) (!= regions (cast u32 0))))
            (and (= opcode (cast u16 OP-TS-TYPE))
                 (or (!= operands (cast u32 1)) (!= successors (cast u32 0))
                     (!= results (cast u32 1)) (!= regions (cast u32 0))))
            (and (= opcode (cast u16 OP-TS-TYPE-PARAMETERS))
                 (or (< operands (cast u32 1)) (!= successors (cast u32 0))
                     (!= results (cast u32 1)) (!= regions (cast u32 0))))
            (and (= opcode (cast u16 OP-TS-TYPE-ALIAS))
                 (or (> immediate TYPE-DECL-HAS-TYPE-PARAMETERS)
                     (!= operands
                       (if (= immediate TYPE-DECL-HAS-TYPE-PARAMETERS)
                           (cast u32 2) (cast u32 1)))
                     (!= successors (cast u32 0)) (!= results (cast u32 0))
                     (!= regions (cast u32 0))))
            (and (= opcode (cast u16 OP-TS-HERITAGE))
                 (or (< operands (cast u32 1)) (!= successors (cast u32 0))
                     (!= results (cast u32 1)) (!= regions (cast u32 0))))
            (and (= opcode (cast u16 OP-TS-INTERFACE))
                 (let [has-parameters
                         (!= (p/iand immediate INTERFACE-HAS-TYPE-PARAMETERS)
                             (cast u64 0))
                       has-heritage
                         (!= (p/iand immediate INTERFACE-HAS-HERITAGE)
                             (cast u64 0))
                       expected (+ (cast u32 1)
                                  (+ (if has-parameters (cast u32 1) (cast u32 0))
                                     (if has-heritage (cast u32 1) (cast u32 0))))]
                   (or (!= (p/iand immediate (p/inot INTERFACE-FLAG-MASK))
                            (cast u64 0))
                       (!= operands expected) (!= successors (cast u32 0))
                       (!= results (cast u32 0)) (!= regions (cast u32 0)))))
            (and (= opcode (cast u16 OP-TS-MODULE))
                 (or (!= operands (cast u32 0)) (!= successors (cast u32 0))
                     (!= results (cast u32 0)) (!= regions (cast u32 0))))
            (and (= opcode (cast u16 OP-TS-INSTANTIATION))
                 (or (!= operands (cast u32 2)) (!= successors (cast u32 0))
                     (!= results (cast u32 1)) (!= regions (cast u32 0))))
            (and (= opcode (cast u16 OP-TS-TYPE-ASSERTION))
                 (or (or (< immediate TYPE-ASSERTION-AS)
                         (> immediate TYPE-ASSERTION-SATISFIES))
                     (!= operands (cast u32 2)) (!= successors (cast u32 0))
                     (!= results (cast u32 1)) (!= regions (cast u32 0))))
            (and (or (= opcode (cast u16 OP-TS-KEYWORD-TYPE))
                     (= opcode (cast u16 OP-TS-LITERAL-TYPE))
                     (= opcode (cast u16 OP-TS-TEMPLATE-ELEMENT)))
                 (or (!= operands (cast u32 0)) (!= successors (cast u32 0))
                     (!= results (cast u32 1)) (!= regions (cast u32 0))))
            (and (= opcode (cast u16 OP-TS-TYPE-REFERENCE))
                 (or (and (!= operands (cast u32 0)) (!= operands (cast u32 2)))
                     (!= successors (cast u32 0)) (!= results (cast u32 1))
                     (!= regions (cast u32 0))))
            (and (= opcode (cast u16 OP-TS-TYPE-OPERATOR))
                 (or (< immediate TYPE-OPERATOR-KEYOF)
                     (> immediate TYPE-OPERATOR-UNIQUE)))
            (and (= opcode (cast u16 OP-TS-TYPE-QUERY))
                 (or (!= (p/iand immediate TYPE-QUERY-TYPEOF) TYPE-QUERY-TYPEOF)
                     (!= (p/iand immediate (p/inot TYPE-QUERY-FLAG-MASK)) (cast u64 0))
                     (!= operands
                       (if (!= (p/iand immediate TYPE-QUERY-HAS-ARGUMENTS)
                                (cast u64 0)) (cast u32 2) (cast u32 1)))
                     (!= successors (cast u32 0)) (!= results (cast u32 1))
                     (!= regions (cast u32 0))))
            (and (= opcode (cast u16 OP-TS-INFER-TYPE))
                 (!= immediate (cast u64 0)))
            (and (or (= opcode (cast u16 OP-TS-ARRAY-TYPE))
                     (= opcode (cast u16 OP-TS-PARENTHESIZED-TYPE))
                     (= opcode (cast u16 OP-TS-QUALIFIED-TYPE))
                     (= opcode (cast u16 OP-TS-TYPE-OPERATOR))
                     (= opcode (cast u16 OP-TS-INFER-TYPE))
                     (= opcode (cast u16 OP-TS-OPTIONAL-TYPE))
                     (= opcode (cast u16 OP-TS-REST-TYPE)))
                 (or (!= operands (cast u32 1)) (!= successors (cast u32 0))
                     (!= results (cast u32 1)) (!= regions (cast u32 0))))
            (and (= opcode (cast u16 OP-TS-PROPERTY-SIGNATURE))
                 (let [computed
                         (!= (p/iand immediate TYPE-MEMBER-COMPUTED) (cast u64 0))
                       has-type
                         (!= (p/iand immediate TYPE-MEMBER-HAS-TYPE) (cast u64 0))]
                   (or (!= (p/iand immediate (p/inot TYPE-MEMBER-FLAG-MASK))
                            (cast u64 0))
                       (!= operands
                         (+ (if computed (cast u32 1) (cast u32 0))
                            (if has-type (cast u32 1) (cast u32 0))))
                       (!= successors (cast u32 0)) (!= results (cast u32 1))
                       (!= regions (cast u32 0)))))
            (and (= opcode (cast u16 OP-TS-INDEX-SIGNATURE))
                 (or (!= (p/iand immediate (p/inot TYPE-MEMBER-READONLY))
                          (cast u64 0))
                     (!= operands (cast u32 2)) (!= successors (cast u32 0))
                     (!= results (cast u32 1)) (!= regions (cast u32 0))))
            (and (= opcode (cast u16 OP-TS-TYPE-PARAMETER))
                 (let [has-constraint
                         (!= (p/iand immediate TYPE-PARAM-HAS-CONSTRAINT)
                             (cast u64 0))
                       has-default (!= (p/iand immediate TYPE-PARAM-HAS-DEFAULT)
                                        (cast u64 0))
                       expected (+ (if has-constraint (cast u32 1) (cast u32 0))
                                   (if has-default (cast u32 1) (cast u32 0)))]
                   (or (!= (p/iand immediate (p/inot TYPE-PARAM-FLAG-MASK))
                            (cast u64 0))
                       (!= operands expected) (!= successors (cast u32 0))
                       (!= results (cast u32 1)) (!= regions (cast u32 0)))))
            (and (= opcode (cast u16 OP-TS-FUNCTION-TYPE-PARAMETER))
                 (let [pattern
                         (!= (p/iand immediate FUNCTION-TYPE-PARAM-PATTERN)
                             (cast u64 0))]
                   (or (!= (p/iand immediate (p/inot FUNCTION-TYPE-PARAM-FLAG-MASK))
                            (cast u64 0))
                     (and (!= (p/iand immediate FUNCTION-TYPE-PARAM-REST)
                              (cast u64 0))
                          (!= (p/iand immediate FUNCTION-TYPE-PARAM-OPTIONAL)
                              (cast u64 0)))
                     (!= operands
                       (+ (if pattern (cast u32 1) (cast u32 0))
                          (if (!= (p/iand immediate FUNCTION-TYPE-PARAM-HAS-TYPE)
                                   (cast u64 0))
                              (cast u32 1) (cast u32 0))))
                     (!= successors (cast u32 0)) (!= results (cast u32 1))
                     (!= regions (cast u32 0)))))
            (and (= opcode (cast u16 OP-JS-BINDING-IDENTIFIER))
                 (or (!= operands (cast u32 0)) (!= successors (cast u32 0))
                     (!= results (cast u32 1)) (!= regions (cast u32 0))))
            (and (or (= opcode (cast u16 OP-JS-OBJECT-BINDING-PATTERN))
                     (= opcode (cast u16 OP-JS-ARRAY-BINDING-PATTERN)))
                 (or (!= successors (cast u32 0)) (!= results (cast u32 1))
                     (!= regions (cast u32 0))))
            (and (or (= opcode (cast u16 OP-JS-BINDING-PROPERTY))
                     (= opcode (cast u16 OP-JS-REST-BINDING)))
                 (or (and (= opcode (cast u16 OP-JS-BINDING-PROPERTY))
                          (or (!= (p/iand immediate
                                      (p/inot BINDING-PROPERTY-FLAG-MASK))
                                   (cast u64 0))
                              (!= operands
                                  (if (!= (p/iand immediate BINDING-PROPERTY-COMPUTED)
                                           (cast u64 0))
                                      (cast u32 2) (cast u32 1)))))
                     (and (= opcode (cast u16 OP-JS-REST-BINDING))
                          (!= operands (cast u32 1)))
                     (!= successors (cast u32 0))
                     (!= results (cast u32 1)) (!= regions (cast u32 0))))
            (and (= opcode (cast u16 OP-JS-ASSIGNMENT-BINDING))
                 (or (!= operands (cast u32 2)) (!= successors (cast u32 0))
                     (!= results (cast u32 1)) (!= regions (cast u32 0))))
            (and (= opcode (cast u16 OP-TS-NAMED-TUPLE-MEMBER))
                 (or (> immediate (cast u64 1)) (!= operands (cast u32 1))
                     (!= successors (cast u32 0)) (!= results (cast u32 1))
                     (!= regions (cast u32 0))))
            (and (= opcode (cast u16 OP-TS-AMBIENT-VARIABLE))
                 (or (!= operands (cast u32 0)) (!= successors (cast u32 0))
                     (!= results (cast u32 0)) (!= regions (cast u32 0))
                     (= (p/iand immediate DECL-AMBIENT) (cast u64 0))))
            (and (= opcode (cast u16 OP-TS-INDEXED-ACCESS-TYPE))
                 (or (!= operands (cast u32 2)) (!= successors (cast u32 0))
                     (!= results (cast u32 1)) (!= regions (cast u32 0))))
            (and (= opcode (cast u16 OP-TS-CONDITIONAL-TYPE))
                 (or (!= operands (cast u32 4)) (!= successors (cast u32 0))
                     (!= results (cast u32 1)) (!= regions (cast u32 0))))
            (and (= opcode (cast u16 OP-TS-TEMPLATE-LITERAL-TYPE))
                 (or (= (p/iand (cast u64 operands) (cast u64 1)) (cast u64 0))
                     (!= successors (cast u32 0)) (!= results (cast u32 1))
                     (!= regions (cast u32 0))))
            (and (= opcode (cast u16 OP-TS-IMPORT-TYPE))
                 (let [expected
                         (+ (if (!= (p/iand immediate IMPORT-TYPE-HAS-OPTIONS)
                                      (cast u64 0)) (cast u32 1) (cast u32 0))
                           (+ (if (!= (p/iand immediate IMPORT-TYPE-HAS-QUALIFIER)
                                        (cast u64 0)) (cast u32 1) (cast u32 0))
                              (if (!= (p/iand immediate IMPORT-TYPE-HAS-ARGUMENTS)
                                       (cast u64 0)) (cast u32 1) (cast u32 0))))]
                   (or (!= (p/iand immediate (p/inot IMPORT-TYPE-FLAG-MASK))
                            (cast u64 0))
                       (!= operands expected) (!= successors (cast u32 0))
                       (!= results (cast u32 1)) (!= regions (cast u32 0)))))
            (and (= opcode (cast u16 OP-TS-TYPE-PREDICATE))
                 (let [has-type
                         (!= (p/iand immediate TYPE-PREDICATE-HAS-TYPE)
                             (cast u64 0))]
                   (or (!= (p/iand immediate (p/inot TYPE-PREDICATE-FLAG-MASK))
                            (cast u64 0))
                       (!= operands (if has-type (cast u32 2) (cast u32 1)))
                       (!= successors (cast u32 0)) (!= results (cast u32 1))
                       (!= regions (cast u32 0)))))
            (and (or (= opcode (cast u16 OP-TS-UNION-TYPE))
                     (= opcode (cast u16 OP-TS-INTERSECTION-TYPE)))
                 (or (< operands (cast u32 2)) (!= successors (cast u32 0))
                     (!= results (cast u32 1)) (!= regions (cast u32 0))))
            (and (or (= opcode (cast u16 OP-TS-TUPLE-TYPE))
                     (= opcode (cast u16 OP-TS-TYPE-LITERAL)))
                 (or (!= successors (cast u32 0)) (!= results (cast u32 1))
                     (!= regions (cast u32 0))))
            (and (= opcode (cast u16 OP-TS-TYPE-ARGUMENTS))
                 (or (< operands (cast u32 1)) (!= successors (cast u32 0))
                     (!= results (cast u32 1)) (!= regions (cast u32 0))))
            (and (or (= opcode (cast u16 OP-TS-FUNCTION-TYPE))
                     (or (= opcode (cast u16 OP-TS-CONSTRUCTOR-TYPE))
                         (or (= opcode (cast u16 OP-TS-CALL-SIGNATURE))
                             (or (= opcode (cast u16 OP-TS-CONSTRUCT-SIGNATURE))
                                 (= opcode (cast u16 OP-TS-METHOD-SIGNATURE))))))
                 (let [has-parameters
                         (!= (p/iand immediate CALLABLE-TYPE-HAS-TYPE-PARAMETERS)
                             (cast u64 0))
                       computed
                         (!= (p/iand immediate CALLABLE-TYPE-COMPUTED)
                             (cast u64 0))
                       getter
                         (!= (p/iand immediate CALLABLE-TYPE-GETTER) (cast u64 0))
                       setter
                         (!= (p/iand immediate CALLABLE-TYPE-SETTER) (cast u64 0))
                       has-return
                         (!= (p/iand immediate CALLABLE-TYPE-HAS-RETURN-TYPE)
                             (cast u64 0))
                       requires-return
                         (or (= opcode (cast u16 OP-TS-FUNCTION-TYPE))
                             (= opcode (cast u16 OP-TS-CONSTRUCTOR-TYPE)))
                       accessor (or getter setter)]
                   (or (!= (p/iand immediate (p/inot CALLABLE-TYPE-FLAG-MASK))
                            (cast u64 0))
                       (and (!= opcode (cast u16 OP-TS-CONSTRUCTOR-TYPE))
                            (!= (p/iand immediate CALLABLE-TYPE-ABSTRACT)
                                (cast u64 0)))
                       (and computed (!= opcode (cast u16 OP-TS-METHOD-SIGNATURE)))
                       (and accessor
                         (or (!= opcode (cast u16 OP-TS-METHOD-SIGNATURE))
                             (and getter setter) has-parameters
                             (!= (p/iand immediate CALLABLE-TYPE-OPTIONAL)
                                 (cast u64 0))))
                       (and requires-return (not has-return))
                       (and setter has-return)
                       (if getter
                           (< operands
                             (+ (if has-return (cast u32 1) (cast u32 0))
                                (if computed (cast u32 1) (cast u32 0))))
                         (if setter
                           (< operands (+ (cast u32 1)
                             (if computed (cast u32 1) (cast u32 0))))
                         (< operands
                           (+ (if has-parameters (cast u32 1) (cast u32 0))
                              (+ (if computed (cast u32 1) (cast u32 0))
                                 (if has-return (cast u32 1) (cast u32 0)))))))
                       (!= successors (cast u32 0)) (!= results (cast u32 1))
                       (!= regions (cast u32 0)))))
            (and (= opcode (cast u16 OP-TS-MAPPED-TYPE))
                 (let [has-name (!= (p/iand immediate MAPPED-HAS-NAME-TYPE)
                                      (cast u64 0))
                       has-value (!= (p/iand immediate MAPPED-HAS-VALUE-TYPE)
                                       (cast u64 0))
                       expected (+ (cast u32 1)
                                   (+ (if has-name (cast u32 1) (cast u32 0))
                                      (if has-value (cast u32 1) (cast u32 0))))]
                   (or (!= (p/iand immediate (p/inot MAPPED-FLAG-MASK))
                            (cast u64 0))
                       (!= operands expected) (!= successors (cast u32 0))
                       (!= results (cast u32 1)) (!= regions (cast u32 0)))))
            (and (= opcode (cast u16 OP-JS-UPDATE))
                 (or (!= operands (cast u32 1)) (!= successors (cast u32 0))
                     (!= results (cast u32 1))))
            (and (= opcode (cast u16 OP-JS-ITERATOR-INIT))
                 (or (!= operands (cast u32 1)) (!= successors (cast u32 0))
                     (!= results (cast u32 1))))
            (and (= opcode (cast u16 OP-JS-ITERATOR-NEXT))
                 (or (!= operands (cast u32 1)) (!= successors (cast u32 0))
                     (!= results (cast u32 2))))
            (and (= opcode (cast u16 OP-JS-SPREAD))
                 (or (!= operands (cast u32 1)) (!= successors (cast u32 0))
                     (!= results (cast u32 1))))
            (and (= opcode (cast u16 OP-JS-ELISION))
                 (or (!= operands (cast u32 0)) (!= successors (cast u32 0))
                     (!= results (cast u32 1))))
            (and (= opcode (cast u16 OP-JS-REGEXP))
                 (or (!= operands (cast u32 0)) (!= successors (cast u32 0))
                     (!= results (cast u32 1))))
            (and (= opcode (cast u16 OP-JS-BIGINT))
                 (or (!= operands (cast u32 0)) (!= successors (cast u32 0))
                     (!= results (cast u32 1))))
            (and (= opcode (cast u16 OP-JS-IS-NULLISH))
                 (or (!= operands (cast u32 1)) (!= successors (cast u32 0))
                     (!= results (cast u32 1))))
            (and (= opcode (cast u16 OP-JS-OPTIONAL-MEMBER))
                 (or (!= operands (cast u32 1)) (!= successors (cast u32 0))
                     (!= results (cast u32 1))))
            (and (= opcode (cast u16 OP-JS-OPTIONAL-COMPUTED-MEMBER))
                 (or (!= operands (cast u32 2)) (!= successors (cast u32 0))
                     (!= results (cast u32 1))))
            (and (= opcode (cast u16 OP-JS-OPTIONAL-CALL))
                 (or (< operands (cast u32 1)) (!= successors (cast u32 0))
                     (!= results (cast u32 1))))
            (and (= opcode (cast u16 OP-UNREACHABLE))
                 (or (!= operands (cast u32 0)) (!= successors (cast u32 0))
                     (!= results (cast u32 0)))))
        (verify-error VERIFY-OPCODE region block op (cast u32 opcode))
      (ok-result))))

(defn scope-ancestor? [(arena (ptr IrArena)) (ancestor u32) (scope u32)] (-> bool)
  (let [(mut current) scope (mut found) false]
    (loop
      (if (or (= (load current) (cast u32 INVALID-ID)) (load found)) (break)
        (if (= (load current) ancestor) (store! found true)
          (set! current (load (p/index (.scope-parents arena)
                                       (cast i64 (load current))))))))
    (load found)))

(defn verify-lexical-semantics [(arena (ptr IrArena))] (-> VerifyResult)
  (let [(mut scope) (cast u32 0) (mut result) (ok-result)]
    (loop
      (if (or (>= (load scope) (.scope-count arena))
              (!= (.error result) VERIFY-OK)) (break)
        (let [parent (load (p/index (.scope-parents arena) (cast i64 (load scope))))
              start (load (p/index (.scope-starts arena) (cast i64 (load scope))))
              end (load (p/index (.scope-ends arena) (cast i64 (load scope))))]
          (if (or (> start end) (> end (.source-size arena))
                  (and (!= parent (cast u32 INVALID-ID)) (>= parent (load scope))))
              (store! result (verify-error VERIFY-SCOPE (cast u32 INVALID-ID)
                                           (cast u32 INVALID-ID) (cast u32 INVALID-ID)
                                           (load scope)))
            (if (!= parent (cast u32 INVALID-ID))
                (let [parent-start (load (p/index (.scope-starts arena) (cast i64 parent)))
                      parent-end (load (p/index (.scope-ends arena) (cast i64 parent)))]
                  (if (or (< start parent-start) (> end parent-end))
                      (store! result (verify-error VERIFY-SCOPE (cast u32 INVALID-ID)
                                                   (cast u32 INVALID-ID)
                                                   (cast u32 INVALID-ID) (load scope))) 0)) 0))
          (set! scope (+ (load scope) (cast u32 1))))))
    (let [(mut binding) (cast u32 0)]
      (loop
        (if (or (>= (load binding) (.binding-count arena))
                (!= (.error result) VERIFY-OK)) (break)
          (let [owner (load (p/index (.binding-scopes arena) (cast i64 (load binding))))
                start (load (p/index (.binding-name-starts arena) (cast i64 (load binding))))
                end (load (p/index (.binding-name-ends arena) (cast i64 (load binding))))]
            (if (or (>= owner (.scope-count arena)) (> start end) (> end (.source-size arena)))
                (store! result (verify-error VERIFY-BINDING (cast u32 INVALID-ID)
                                             (cast u32 INVALID-ID) (cast u32 INVALID-ID)
                                             (load binding)))
              (if (or (< start (load (p/index (.scope-starts arena) (cast i64 owner))))
                      (> end (load (p/index (.scope-ends arena) (cast i64 owner)))))
                  (store! result (verify-error VERIFY-BINDING (cast u32 INVALID-ID)
                                               (cast u32 INVALID-ID) (cast u32 INVALID-ID)
                                               (load binding))) 0))
            (set! binding (+ (load binding) (cast u32 1)))))))
    (let [(mut reference) (cast u32 0)]
      (loop
        (if (or (>= (load reference) (.reference-count arena))
                (!= (.error result) VERIFY-OK)) (break)
          (let [binding (load (p/index (.reference-bindings arena)
                                       (cast i64 (load reference))))
                start (load (p/index (.reference-starts arena) (cast i64 (load reference))))
                end (load (p/index (.reference-ends arena) (cast i64 (load reference))))]
            (if (or (>= binding (.binding-count arena)) (> start end)
                    (> end (.source-size arena)))
                (store! result (verify-error VERIFY-REFERENCE (cast u32 INVALID-ID)
                                             (cast u32 INVALID-ID) (cast u32 INVALID-ID)
                                             (load reference))) 0)
            (set! reference (+ (load reference) (cast u32 1)))))))
    (let [(mut capture) (cast u32 0)]
      (loop
        (if (or (>= (load capture) (.capture-count arena))
                (!= (.error result) VERIFY-OK)) (break)
          (let [scope (load (p/index (.capture-scopes arena) (cast i64 (load capture))))
                binding (load (p/index (.capture-bindings arena) (cast i64 (load capture))))]
            (if (or (>= scope (.scope-count arena)) (>= binding (.binding-count arena)))
                (store! result (verify-error VERIFY-CAPTURE (cast u32 INVALID-ID)
                                             (cast u32 INVALID-ID) (cast u32 INVALID-ID)
                                             (load capture)))
              (let [binding-scope (load (p/index (.binding-scopes arena)
                                                 (cast i64 binding)))]
                (if (or (= binding-scope scope)
                        (not (scope-ancestor? arena binding-scope scope)))
                    (store! result (verify-error VERIFY-CAPTURE (cast u32 INVALID-ID)
                                                 (cast u32 INVALID-ID)
                                                 (cast u32 INVALID-ID) (load capture))) 0)))
            (set! capture (+ (load capture) (cast u32 1)))))))
    (load result)))

(defn verify-ir [(arena (ptr IrArena)) (scratch (ptr VerifyScratch))] (-> VerifyResult)
  ;; Validate region/block ownership and all contiguous ranges first so later
  ;; verifier phases can index safely.
  (let [(mut region) (cast u32 0) (mut result) (ok-result)]
    (loop
      (if (or (>= (load region) (.region-count arena))
              (!= (.error result) VERIFY-OK)) (break)
        (let [first (load (p/index (.region-first-blocks arena) (cast i64 (load region))))
              count (load (p/index (.region-block-counts arena) (cast i64 (load region))))
              parent (load (p/index (.region-parent-ops arena) (cast i64 (load region))))]
          (if (or (= count (cast u32 0))
                  (not (range-valid? first count (.region-block-ref-count arena))))
              (store! result (verify-error VERIFY-REGION-RANGE (load region)
                                           (cast u32 INVALID-ID) (cast u32 INVALID-ID) first))
            (if (and (!= parent (cast u32 INVALID-ID)) (>= parent (.op-count arena)))
                (store! result (verify-error VERIFY-REGION-OWNERSHIP (load region)
                                             (cast u32 INVALID-ID) parent (cast u32 INVALID-ID)))
              (let [(mut block-index) (cast u32 0)]
                (loop
                  (if (>= (load block-index) count) (break)
                    (let [block (load (p/index (.region-blocks arena)
                                               (cast i64 (+ first (load block-index)))))]
                      (if (>= block (.block-count arena))
                          (store! result (verify-error VERIFY-REGION-RANGE (load region)
                                                       block (cast u32 INVALID-ID)
                                                       (load block-index)))
                        (if (!= (load (p/index (.block-regions arena)
                                               (cast i64 block))) (load region))
                            (store! result (verify-error VERIFY-BLOCK-REGION (load region)
                                                         block (cast u32 INVALID-ID)
                                                         (cast u32 INVALID-ID))) 0))
                      (set! block-index (+ (load block-index) (cast u32 1)))))))))
          (set! region (+ (load region) (cast u32 1))))))
    (if (= (.error result) VERIFY-OK)
        (store! result (verify-unique-ownership arena)) 0)
    (if (!= (.error result) VERIFY-OK) (load result)
      (let [(mut block) (cast u32 0)]
        (loop
          (if (or (>= (load block) (.block-count arena))
                  (!= (.error result) VERIFY-OK)) (break)
            (let [region-id (load (p/index (.block-regions arena) (cast i64 (load block))))
                  first-param (load (p/index (.block-first-params arena) (cast i64 (load block))))
                  param-count (load (p/index (.block-param-counts arena) (cast i64 (load block))))
                  first-op (load (p/index (.block-first-ops arena) (cast i64 (load block))))
                  op-count (load (p/index (.block-op-counts arena) (cast i64 (load block))))]
              (if (not (range-valid? first-param param-count (.value-count arena)))
                  (store! result (verify-error VERIFY-PARAM-RANGE region-id (load block)
                                               (cast u32 INVALID-ID) first-param))
                (if (or (= op-count (cast u32 0))
                        (not (range-valid? first-op op-count (.block-op-ref-count arena))))
                    (store! result (verify-error VERIFY-BLOCK-RANGE region-id (load block)
                                                 (cast u32 INVALID-ID) first-op))
                  (let [(mut op-index) (cast u32 0)]
                    (loop
                      (if (or (>= (load op-index) op-count)
                              (!= (.error result) VERIFY-OK)) (break)
                        (let [op (block-op-at arena (load block) (load op-index))
                              opcode (if (< op (.op-count arena))
                                       (load (p/index (.opcodes arena) (cast i64 op)))
                                       (cast u16 OP-INVALID))
                              operands (if (< op (.op-count arena))
                                         (load (p/index (.op-first-operands arena) (cast i64 op)))
                                         (cast u32 0))
                              operand-count (if (< op (.op-count arena))
                                             (load (p/index (.op-operand-counts arena) (cast i64 op)))
                                             (cast u32 0))
                              results (if (< op (.op-count arena))
                                       (load (p/index (.op-first-results arena) (cast i64 op)))
                                       (cast u32 0))
                              result-count (if (< op (.op-count arena))
                                           (load (p/index (.op-result-counts arena) (cast i64 op)))
                                           (cast u32 0))
                              successors (if (< op (.op-count arena))
                                          (load (p/index (.op-first-successors arena) (cast i64 op)))
                                          (cast u32 0))
                              successor-count (if (< op (.op-count arena))
                                              (load (p/index (.op-successor-counts arena) (cast i64 op)))
                                              (cast u32 0))
                              regions (if (< op (.op-count arena))
                                      (load (p/index (.op-first-regions arena) (cast i64 op)))
                                      (cast u32 0))
                              region-count (if (< op (.op-count arena))
                                          (load (p/index (.op-region-counts arena) (cast i64 op)))
                                          (cast u32 0))
                              start (if (< op (.op-count arena))
                                      (load (p/index (.op-starts arena) (cast i64 op)))
                                      (cast u32 0))
                              end (if (< op (.op-count arena))
                                    (load (p/index (.op-ends arena) (cast i64 op)))
                                    (cast u32 0))
                              last (= (+ (load op-index) (cast u32 1)) op-count)]
                          (if (or (> start end) (> end (.source-size arena)))
                              (store! result (verify-error VERIFY-SPAN region-id (load block)
                                                           op start))
                            (if (or (not (range-valid? operands operand-count (.operand-count arena)))
                                    (not (range-valid? results result-count (.value-count arena)))
                                    (not (range-valid? successors successor-count
                                                       (.successor-count arena)))
                                    (not (range-valid? regions region-count
                                                       (.op-region-ref-count arena))))
                                (store! result (verify-error VERIFY-OP-RANGE region-id (load block)
                                                             op (cast u32 INVALID-ID)))
                              (do
                                (store! result (verify-op-owned-ranges arena region-id
                                                                       (load block) op))
                                (if (= (.error result) VERIFY-OK)
                                    (store! result (verify-opcode-shape arena region-id
                                                                       (load block) op)) 0)
                                (if (= (.error result) VERIFY-OK)
                                    (if (and (terminator? opcode) (not last))
                                        (store! result (verify-error VERIFY-TERMINATOR-POSITION
                                                                     region-id (load block) op
                                                                     (cast u32 INVALID-ID)))
                                      (if (and last (not (terminator? opcode)))
                                          (store! result (verify-error VERIFY-TERMINATOR-MISSING
                                                                       region-id (load block) op
                                                                       (cast u32 INVALID-ID)))
                                        (if (and (> successor-count (cast u32 0))
                                                 (not (terminator? opcode)))
                                            (store! result
                                              (verify-error VERIFY-NONTERMINATOR-SUCCESSOR
                                                            region-id (load block) op
                                                            (cast u32 INVALID-ID))) 0))) 0))))
                          (set! op-index (+ (load op-index) (cast u32 1)))))))))
              (set! block (+ (load block) (cast u32 1))))))
        (if (!= (.error result) VERIFY-OK) (load result)
          (do
            (store! result (verify-value-definitions arena))
            (if (= (.error result) VERIFY-OK)
                (store! result (verify-type-operands arena)) 0)
            (if (= (.error result) VERIFY-OK)
                (store! result (verify-lexical-semantics arena)) 0)
            (if (!= (.error result) VERIFY-OK) (load result)
          (let [(mut successor) (cast u32 0)]
            (loop
              (if (or (>= (load successor) (.successor-count arena))
                      (!= (.error result) VERIFY-OK)) (break)
                (let [target (load (p/index (.successor-blocks arena)
                                            (cast i64 (load successor))))
                      first-arg (load (p/index (.successor-first-args arena)
                                               (cast i64 (load successor))))
                      arg-count (load (p/index (.successor-arg-counts arena)
                                               (cast i64 (load successor))))]
                  (if (>= target (.block-count arena))
                      (store! result (verify-error VERIFY-SUCCESSOR-TARGET
                                                   (cast u32 INVALID-ID) target
                                                   (cast u32 INVALID-ID) (load successor)))
                    (if (not (range-valid? first-arg arg-count (.successor-arg-count arena)))
                        (store! result (verify-error VERIFY-SUCCESSOR-RANGE
                                                     (cast u32 INVALID-ID) target
                                                     (cast u32 INVALID-ID) (load successor)))
                      (if (!= arg-count
                              (load (p/index (.block-param-counts arena) (cast i64 target))))
                          (store! result (verify-error VERIFY-SUCCESSOR-ARITY
                                                       (load (p/index (.block-regions arena)
                                                                      (cast i64 target)))
                                                       target (cast u32 INVALID-ID)
                                                       (load successor))) 0)))
                  (set! successor (+ (load successor) (cast u32 1))))))
            (if (!= (.error result) VERIFY-OK) (load result)
              (let [dom-result (compute-dominators! arena scratch)]
                (if (!= (.error dom-result) VERIFY-OK) dom-result
                  (let [words (p/idiv (+ (cast i64 (.block-count arena)) 63) 64)
                        (mut op) (cast u32 0)]
                    (loop
                      (if (or (>= (load op) (.op-count arena))
                              (!= (.error result) VERIFY-OK)) (break)
                        (let [block-id (find-op-block arena (load op))
                              first (load (p/index (.op-first-operands arena)
                                                   (cast i64 (load op))))
                              count (load (p/index (.op-operand-counts arena)
                                                   (cast i64 (load op))))
                              (mut i) (cast u32 0)]
                          (loop
                            (if (or (>= (load i) count)
                                    (!= (.error result) VERIFY-OK)) (break)
                              (let [at (+ first (load i))
                                    value (load (p/index (.operands arena) (cast i64 at)))]
                                (store! result (verify-value-use arena scratch words value block-id
                                                                 (load op) at))
                                (set! i (+ (load i) (cast u32 1))))))
                          (set! op (+ (load op) (cast u32 1))))))
                    ;; Successor arguments are uses at their owning terminator.
                    (let [(mut owner-op) (cast u32 0)]
                      (loop
                        (if (or (>= (load owner-op) (.op-count arena))
                                (!= (.error result) VERIFY-OK)) (break)
                          (let [block-id (find-op-block arena (load owner-op))
                                first-succ (load (p/index (.op-first-successors arena)
                                                        (cast i64 (load owner-op))))
                                succ-count (load (p/index (.op-successor-counts arena)
                                                        (cast i64 (load owner-op))))
                                (mut si) (cast u32 0)]
                            (loop
                              (if (or (>= (load si) succ-count)
                                      (!= (.error result) VERIFY-OK)) (break)
                                (let [succ (+ first-succ (load si))
                                      first-arg (load (p/index (.successor-first-args arena)
                                                               (cast i64 succ)))
                                      arg-count (load (p/index (.successor-arg-counts arena)
                                                               (cast i64 succ)))
                                      (mut ai) (cast u32 0)]
                                  (loop
                                    (if (or (>= (load ai) arg-count)
                                            (!= (.error result) VERIFY-OK)) (break)
                                      (let [at (+ first-arg (load ai))
                                            value (load (p/index (.successor-args arena)
                                                                 (cast i64 at)))]
                                        (store! result
                                          (verify-value-use arena scratch words value block-id
                                                            (load owner-op) at))
                                        (set! ai (+ (load ai) (cast u32 1))))))
                                  (set! si (+ (load si) (cast u32 1))))))
                            (set! owner-op (+ (load owner-op) (cast u32 1))))))
                    (load result))))))))))))))

(defn push-byte! [(buffer (ptr PrintBuffer)) (byte u8)] (-> i64)
  (if (!= (.error buffer) PRINT-OK) 0
    (if (>= (.count buffer) (.capacity buffer))
        (set! (.error buffer) PRINT-CAPACITY)
      (do (store! (p/index (.data buffer) (.count buffer)) byte)
          (set! (.count buffer) (+ (.count buffer) 1)))))
  0)

(defn push-text! [(buffer (ptr PrintBuffer)) (text (slice u8))] (-> i64)
  (let [(mut i) 0]
    (loop
      (if (or (>= (load i) (len text)) (!= (.error buffer) PRINT-OK)) (break)
        (do (push-byte! buffer (load (p/index (slice-data text) (load i))))
            (set! i (+ (load i) 1))))))
  0)

(defn push-u32! [(buffer (ptr PrintBuffer)) (value u32)] (-> i64)
  (let [digits (p/alloc-stack (array u8 10)) (mut count) 0 (mut rest) value]
    (if (= (load rest) (cast u32 0)) (push-byte! buffer (cast u8 48))
      (do
        (loop
          (if (= (load rest) (cast u32 0)) (break)
            (do
              (store! (p/index digits (load count))
                      (+ (cast u8 48) (cast u8 (p/irem (cast i64 (load rest)) 10))))
              (set! rest (cast u32 (p/idiv (cast i64 (load rest)) 10)))
              (set! count (+ (load count) 1)))))
        (loop
          (if (= (load count) 0) (break)
            (do (set! count (- (load count) 1))
                (push-byte! buffer (load (p/index digits (load count))))))))))
  0)

(defn push-value! [(buffer (ptr PrintBuffer)) (value u32)] (-> i64)
  (push-byte! buffer (cast u8 37))
  (push-u32! buffer value))

(defn push-block! [(buffer (ptr PrintBuffer)) (block u32)] (-> i64)
  (push-byte! buffer (cast u8 94))
  (push-u32! buffer block))

(defn push-id-or-none! [(buffer (ptr PrintBuffer)) (id u32)] (-> i64)
  (if (= id (cast u32 INVALID-ID)) (push-text! buffer "none")
    (push-u32! buffer id)))

(defn push-op-name! [(arena (ptr IrArena)) (source (ptr u8))
                    (buffer (ptr PrintBuffer)) (op u32)] (-> i64)
  (let [opcode (load (p/index (.opcodes arena) (cast i64 op)))]
    (cond
      (= opcode (cast u16 OP-BR)) (push-text! buffer "cf.br")
      (= opcode (cast u16 OP-COND-BR)) (push-text! buffer "cf.cond_br")
      (= opcode (cast u16 OP-RETURN)) (push-text! buffer "js.return")
      (= opcode (cast u16 OP-THROW)) (push-text! buffer "js.throw")
      (= opcode (cast u16 OP-UNREACHABLE)) (push-text! buffer "cf.unreachable")
      (= opcode (cast u16 OP-YIELD)) (push-text! buffer "js.yield")
      (= opcode (cast u16 OP-JS-IDENTIFIER)) (push-text! buffer "js.identifier")
      (= opcode (cast u16 OP-JS-NUMBER)) (push-text! buffer "js.number")
      (= opcode (cast u16 OP-JS-STRING)) (push-text! buffer "js.string")
      (= opcode (cast u16 OP-JS-UNARY)) (push-text! buffer "js.unary")
      (= opcode (cast u16 OP-JS-BINARY)) (push-text! buffer "js.binary")
      (= opcode (cast u16 OP-JS-CALL)) (push-text! buffer "js.call")
      (= opcode (cast u16 OP-JS-DECLARE)) (push-text! buffer "js.declare")
      (= opcode (cast u16 OP-JS-ASSIGN)) (push-text! buffer "js.assign")
      (= opcode (cast u16 OP-JS-EXPRESSION)) (push-text! buffer "js.expression")
      (= opcode (cast u16 OP-JS-FUNCTION)) (push-text! buffer "js.function")
      (= opcode (cast u16 OP-JS-JSX-ELEMENT)) (push-text! buffer "js.jsx_element")
      (= opcode (cast u16 OP-JS-MEMBER)) (push-text! buffer "js.member")
      (= opcode (cast u16 OP-JS-ARRAY)) (push-text! buffer "js.array")
      (= opcode (cast u16 OP-JS-PROPERTY)) (push-text! buffer "js.property")
      (= opcode (cast u16 OP-JS-OBJECT)) (push-text! buffer "js.object")
      (= opcode (cast u16 OP-JS-EXPORT)) (push-text! buffer "js.export")
      (= opcode (cast u16 OP-TS-TYPE)) (push-text! buffer "ts.type")
      (= opcode (cast u16 OP-TS-TYPE-ALIAS)) (push-text! buffer "ts.type_alias")
      (= opcode (cast u16 OP-JS-IMPORT)) (push-text! buffer "js.import")
      (= opcode (cast u16 OP-JS-IMPORT-SPECIFIER)) (push-text! buffer "js.import_specifier")
      (= opcode (cast u16 OP-TS-INSTANTIATION)) (push-text! buffer "ts.instantiation")
      (= opcode (cast u16 OP-JS-ARROW)) (push-text! buffer "js.arrow")
      (= opcode (cast u16 OP-TS-INTERFACE)) (push-text! buffer "ts.interface")
      (= opcode (cast u16 OP-JS-PREFIX-KEYWORD)) (push-text! buffer "js.prefix_keyword")
      (= opcode (cast u16 OP-JS-TEMPLATE)) (push-text! buffer "js.template")
      (= opcode (cast u16 OP-JS-BOOLEAN)) (push-text! buffer "js.boolean")
      (= opcode (cast u16 OP-JS-NULL)) (push-text! buffer "js.null")
      (= opcode (cast u16 OP-JS-THIS)) (push-text! buffer "js.this")
      (= opcode (cast u16 OP-JS-SUPER)) (push-text! buffer "js.super")
      (= opcode (cast u16 OP-JS-DEBUGGER)) (push-text! buffer "js.debugger")
      (= opcode (cast u16 OP-JS-COMPUTED-MEMBER))
        (push-text! buffer "js.computed_member")
      (= opcode (cast u16 OP-JS-UNDEFINED)) (push-text! buffer "js.undefined")
      (= opcode (cast u16 OP-JS-GROUP)) (push-text! buffer "js.group")
      (= opcode (cast u16 OP-TS-NON-NULL)) (push-text! buffer "ts.non_null")
      (= opcode (cast u16 OP-JS-UPDATE)) (push-text! buffer "js.update")
      (= opcode (cast u16 OP-JS-ITERATOR-INIT)) (push-text! buffer "js.iterator_init")
      (= opcode (cast u16 OP-JS-ITERATOR-NEXT)) (push-text! buffer "js.iterator_next")
      (= opcode (cast u16 OP-JS-SPREAD)) (push-text! buffer "js.spread")
      (= opcode (cast u16 OP-JS-ELISION)) (push-text! buffer "js.elision")
      (= opcode (cast u16 OP-JS-REGEXP)) (push-text! buffer "js.regexp")
      (= opcode (cast u16 OP-JS-BIGINT)) (push-text! buffer "js.bigint")
      (= opcode (cast u16 OP-JS-IS-NULLISH)) (push-text! buffer "js.is_nullish")
      (= opcode (cast u16 OP-JS-OPTIONAL-MEMBER))
        (push-text! buffer "js.optional_member")
      (= opcode (cast u16 OP-JS-OPTIONAL-COMPUTED-MEMBER))
        (push-text! buffer "js.optional_computed_member")
      (= opcode (cast u16 OP-JS-OPTIONAL-CALL)) (push-text! buffer "js.optional_call")
      (= opcode (cast u16 OP-JS-TRY)) (push-text! buffer "js.try")
      (= opcode (cast u16 OP-JS-ASYNC-ARROW)) (push-text! buffer "js.async_arrow")
      (= opcode (cast u16 OP-JS-ASYNC-FUNCTION)) (push-text! buffer "js.async_function")
      (= opcode (cast u16 OP-JS-GENERATOR-FUNCTION))
        (push-text! buffer "js.generator_function")
      (= opcode (cast u16 OP-JS-ASYNC-GENERATOR-FUNCTION))
        (push-text! buffer "js.async_generator_function")
      (= opcode (cast u16 OP-JS-CLASS)) (push-text! buffer "js.class")
      (= opcode (cast u16 OP-JS-CLASS-METHOD)) (push-text! buffer "js.class_method")
      (= opcode (cast u16 OP-JS-CLASS-FIELD)) (push-text! buffer "js.class_field")
      (= opcode (cast u16 OP-JS-CLASS-STATIC-BLOCK))
        (push-text! buffer "js.class_static_block")
      (= opcode (cast u16 OP-JS-DECORATOR)) (push-text! buffer "js.decorator")
      (= opcode (cast u16 OP-TS-PARAMETER-PROPERTY))
        (push-text! buffer "ts.parameter_property")
      (= opcode (cast u16 OP-TS-CLASS-INDEX-SIGNATURE))
        (push-text! buffer "ts.class_index_signature")
      (= opcode (cast u16 OP-TS-TYPE-REFERENCE)) (push-text! buffer "ts.type_reference")
      (= opcode (cast u16 OP-TS-KEYWORD-TYPE)) (push-text! buffer "ts.keyword_type")
      (= opcode (cast u16 OP-TS-LITERAL-TYPE)) (push-text! buffer "ts.literal_type")
      (= opcode (cast u16 OP-TS-UNION-TYPE)) (push-text! buffer "ts.union_type")
      (= opcode (cast u16 OP-TS-INTERSECTION-TYPE)) (push-text! buffer "ts.intersection_type")
      (= opcode (cast u16 OP-TS-ARRAY-TYPE)) (push-text! buffer "ts.array_type")
      (= opcode (cast u16 OP-TS-TUPLE-TYPE)) (push-text! buffer "ts.tuple_type")
      (= opcode (cast u16 OP-TS-PARENTHESIZED-TYPE))
        (push-text! buffer "ts.parenthesized_type")
      (= opcode (cast u16 OP-TS-TYPE-ARGUMENTS)) (push-text! buffer "ts.type_arguments")
      (= opcode (cast u16 OP-TS-QUALIFIED-TYPE)) (push-text! buffer "ts.qualified_type")
      (= opcode (cast u16 OP-TS-INDEXED-ACCESS-TYPE))
        (push-text! buffer "ts.indexed_access_type")
      (= opcode (cast u16 OP-TS-TYPE-OPERATOR)) (push-text! buffer "ts.type_operator")
      (= opcode (cast u16 OP-TS-TYPE-QUERY)) (push-text! buffer "ts.type_query")
      (= opcode (cast u16 OP-TS-FUNCTION-TYPE)) (push-text! buffer "ts.function_type")
      (= opcode (cast u16 OP-TS-CONSTRUCTOR-TYPE)) (push-text! buffer "ts.constructor_type")
      (= opcode (cast u16 OP-TS-TYPE-LITERAL)) (push-text! buffer "ts.type_literal")
      (= opcode (cast u16 OP-TS-CONDITIONAL-TYPE))
        (push-text! buffer "ts.conditional_type")
      (= opcode (cast u16 OP-TS-INFER-TYPE)) (push-text! buffer "ts.infer_type")
      (= opcode (cast u16 OP-TS-MAPPED-TYPE)) (push-text! buffer "ts.mapped_type")
      (= opcode (cast u16 OP-TS-TEMPLATE-LITERAL-TYPE))
        (push-text! buffer "ts.template_literal_type")
      (= opcode (cast u16 OP-TS-IMPORT-TYPE)) (push-text! buffer "ts.import_type")
      (= opcode (cast u16 OP-TS-TYPE-PREDICATE)) (push-text! buffer "ts.type_predicate")
      (= opcode (cast u16 OP-TS-TYPE-PARAMETER)) (push-text! buffer "ts.type_parameter")
      (= opcode (cast u16 OP-TS-PROPERTY-SIGNATURE))
        (push-text! buffer "ts.property_signature")
      (= opcode (cast u16 OP-TS-METHOD-SIGNATURE)) (push-text! buffer "ts.method_signature")
      (= opcode (cast u16 OP-TS-CALL-SIGNATURE)) (push-text! buffer "ts.call_signature")
      (= opcode (cast u16 OP-TS-CONSTRUCT-SIGNATURE))
        (push-text! buffer "ts.construct_signature")
      (= opcode (cast u16 OP-TS-INDEX-SIGNATURE)) (push-text! buffer "ts.index_signature")
      (= opcode (cast u16 OP-TS-NAMED-TUPLE-MEMBER))
        (push-text! buffer "ts.named_tuple_member")
      (= opcode (cast u16 OP-TS-OPTIONAL-TYPE)) (push-text! buffer "ts.optional_type")
      (= opcode (cast u16 OP-TS-REST-TYPE)) (push-text! buffer "ts.rest_type")
      (= opcode (cast u16 OP-TS-FUNCTION-TYPE-PARAMETER))
        (push-text! buffer "ts.function_type_parameter")
      (= opcode (cast u16 OP-TS-AMBIENT-VARIABLE))
        (push-text! buffer "ts.ambient_variable")
      (= opcode (cast u16 OP-TS-TYPE-ASSERTION))
        (push-text! buffer "ts.type_assertion")
      (= opcode (cast u16 OP-TS-TEMPLATE-ELEMENT))
        (push-text! buffer "ts.template_element")
      (= opcode (cast u16 OP-TS-TYPE-PARAMETERS))
        (push-text! buffer "ts.type_parameters")
      (= opcode (cast u16 OP-TS-HERITAGE)) (push-text! buffer "ts.heritage")
      (= opcode (cast u16 OP-TS-MODULE)) (push-text! buffer "ts.module")
      (= opcode (cast u16 OP-JS-BINDING-IDENTIFIER))
        (push-text! buffer "js.binding_identifier")
      (= opcode (cast u16 OP-JS-OBJECT-BINDING-PATTERN))
        (push-text! buffer "js.object_binding_pattern")
      (= opcode (cast u16 OP-JS-ARRAY-BINDING-PATTERN))
        (push-text! buffer "js.array_binding_pattern")
      (= opcode (cast u16 OP-JS-BINDING-PROPERTY))
        (push-text! buffer "js.binding_property")
      (= opcode (cast u16 OP-JS-REST-BINDING))
        (push-text! buffer "js.rest_binding")
      (= opcode (cast u16 OP-JS-ASSIGNMENT-BINDING))
        (push-text! buffer "js.assignment_binding")
      (>= opcode (cast u16 OP-DIALECT-BASE))
        (let [start (load (p/index (.op-name-starts arena) (cast i64 op)))
              end (load (p/index (.op-name-ends arena) (cast i64 op)))
              (mut at) start]
          (loop
            (if (>= (load at) end) (break)
              (do (push-byte! buffer (load (p/index source (cast i64 (load at)))))
                  (set! at (+ (load at) (cast u32 1)))))))
      :else (set! (.error buffer) PRINT-INVALID-OPCODE)))
  0)

;; Deterministic, lossless native syntax. Allocation capacities and physical
;; SoA offsets are omitted because they are not semantic identity.
(defn print-successor! [(arena (ptr IrArena)) (buffer (ptr PrintBuffer))
                       (successor u32)] (-> i64)
  (let [first (load (p/index (.successor-first-args arena) (cast i64 successor)))
        count (load (p/index (.successor-arg-counts arena) (cast i64 successor)))
        (mut i) (cast u32 0)]
    (push-block! buffer (load (p/index (.successor-blocks arena) (cast i64 successor))))
    (push-byte! buffer (cast u8 40))
    (loop
      (if (>= (load i) count) (break)
        (do
          (if (> (load i) (cast u32 0)) (push-text! buffer ", ") 0)
          (push-value! buffer
            (load (p/index (.successor-args arena) (cast i64 (+ first (load i))))))
          (set! i (+ (load i) (cast u32 1))))))
    (push-byte! buffer (cast u8 41))))

(defn print-op! [(arena (ptr IrArena)) (source (ptr u8))
                 (buffer (ptr PrintBuffer)) (op u32)] (-> i64)
  (let [first-result (load (p/index (.op-first-results arena) (cast i64 op)))
        result-count (load (p/index (.op-result-counts arena) (cast i64 op)))
        first-operand (load (p/index (.op-first-operands arena) (cast i64 op)))
        operand-count (load (p/index (.op-operand-counts arena) (cast i64 op)))
        first-successor (load (p/index (.op-first-successors arena) (cast i64 op)))
        successor-count (load (p/index (.op-successor-counts arena) (cast i64 op)))
        (mut i) (cast u32 0)]
    (push-text! buffer "  ")
    (loop
      (if (>= (load i) result-count) (break)
        (do
          (if (> (load i) (cast u32 0)) (push-text! buffer ", ") 0)
          (push-value! buffer (+ first-result (load i)))
          (set! i (+ (load i) (cast u32 1))))))
    (if (> result-count (cast u32 0)) (push-text! buffer " = ") 0)
    (push-op-name! arena source buffer op)
    (let [opcode (load (p/index (.opcodes arena) (cast i64 op)))]
      (if (or (= opcode (cast u16 OP-JS-UNARY))
              (= opcode (cast u16 OP-JS-BINARY))
              (= opcode (cast u16 OP-JS-ASSIGN)))
          (do
            (push-text! buffer " imm(")
            (push-u32! buffer
              (cast u32 (load (p/index (.op-immediates arena) (cast i64 op)))))
            (push-byte! buffer (cast u8 41))) 0)
      (if (= opcode (cast u16 OP-JS-DECLARE))
          (do
            (push-text! buffer " kind(")
            (push-u32! buffer
              (cast u32 (load (p/index (.op-immediates arena) (cast i64 op)))))
            (push-byte! buffer (cast u8 41))) 0)
      (if (or (= opcode (cast u16 OP-JS-DECLARE))
              (= opcode (cast u16 OP-JS-FUNCTION))
              (= opcode (cast u16 OP-JS-MEMBER))
              (= opcode (cast u16 OP-JS-OPTIONAL-MEMBER))
              (= opcode (cast u16 OP-JS-PROPERTY))
              (= opcode (cast u16 OP-JS-CLASS))
              (= opcode (cast u16 OP-JS-CLASS-METHOD))
              (= opcode (cast u16 OP-JS-CLASS-FIELD)))
          (do
            (push-text! buffer " name(")
            (push-u32! buffer (load (p/index (.op-name-starts arena) (cast i64 op))))
            (push-byte! buffer (cast u8 58))
            (push-u32! buffer (load (p/index (.op-name-ends arena) (cast i64 op))))
            (push-byte! buffer (cast u8 41))) 0)
      (if (and (= opcode (cast u16 OP-JS-BINARY))
               (> (load (p/index (.op-name-ends arena) (cast i64 op)))
                  (load (p/index (.op-name-starts arena) (cast i64 op)))))
          (do
            (push-text! buffer " name(")
            (push-u32! buffer (load (p/index (.op-name-starts arena) (cast i64 op))))
            (push-byte! buffer (cast u8 58))
            (push-u32! buffer (load (p/index (.op-name-ends arena) (cast i64 op))))
            (push-byte! buffer (cast u8 41))) 0)
      (let [first-region (load (p/index (.op-first-regions arena) (cast i64 op)))
            region-count (load (p/index (.op-region-counts arena) (cast i64 op)))
            (mut ri) (cast u32 0)]
        (if (> region-count (cast u32 0))
            (do
              (push-text! buffer " regions(")
              (loop
                (if (>= (load ri) region-count) (break)
                  (do
                    (if (> (load ri) (cast u32 0)) (push-byte! buffer (cast u8 44)) 0)
                    (push-u32! buffer
                      (load (p/index (.op-regions arena)
                                     (cast i64 (+ first-region (load ri))))))
                    (set! ri (+ (load ri) (cast u32 1))))))
              (push-byte! buffer (cast u8 41))) 0)))
    (store! i (cast u32 0))
    (loop
      (if (>= (load i) operand-count) (break)
        (do
          (if (= (load i) (cast u32 0)) (push-byte! buffer (cast u8 32))
            (push-text! buffer ", "))
          (push-value! buffer
            (load (p/index (.operands arena) (cast i64 (+ first-operand (load i))))))
          (set! i (+ (load i) (cast u32 1))))))
    (store! i (cast u32 0))
    (loop
      (if (>= (load i) successor-count) (break)
        (do
          (if (or (> operand-count (cast u32 0)) (> (load i) (cast u32 0)))
              (push-text! buffer ", ") (push-byte! buffer (cast u8 32)))
          (print-successor! arena buffer (+ first-successor (load i)))
          (set! i (+ (load i) (cast u32 1))))))
    (push-text! buffer " loc(")
    (push-u32! buffer (load (p/index (.op-starts arena) (cast i64 op))))
    (push-byte! buffer (cast u8 58))
    (push-u32! buffer (load (p/index (.op-ends arena) (cast i64 op))))
    (push-text! buffer ")\n")))

(defn print-block! [(arena (ptr IrArena)) (source (ptr u8))
                    (buffer (ptr PrintBuffer)) (block u32)] (-> i64)
  (let [first-param (load (p/index (.block-first-params arena) (cast i64 block)))
        param-count (load (p/index (.block-param-counts arena) (cast i64 block)))
        first-op (load (p/index (.block-first-ops arena) (cast i64 block)))
        op-count (load (p/index (.block-op-counts arena) (cast i64 block)))
        (mut i) (cast u32 0)]
    (push-block! buffer block)
    (push-byte! buffer (cast u8 40))
    (loop
      (if (>= (load i) param-count) (break)
        (do
          (if (> (load i) (cast u32 0)) (push-text! buffer ", ") 0)
          (push-value! buffer (+ first-param (load i)))
          (set! i (+ (load i) (cast u32 1))))))
    (push-text! buffer "):\n")
    (store! i (cast u32 0))
    (loop
      (if (>= (load i) op-count) (break)
        (do
          (print-op! arena source buffer (block-op-at arena block (load i)))
          (set! i (+ (load i) (cast u32 1))))))))

(defn print-ir! [(arena (ptr IrArena)) (source (ptr u8))
                (output (ptr u8)) (capacity i64)] (-> PrintResult)
  (let [buffer (p/alloc-stack PrintBuffer) (mut region) (cast u32 0)]
    (store! buffer (PrintBuffer :data output :capacity capacity :count 0 :error PRINT-OK))
    (push-text! buffer "source_size ")
    (push-u32! buffer (.source-size arena))
    (push-byte! buffer (cast u8 10))
    (loop
      (if (or (>= (load region) (.region-count arena))
              (!= (.error buffer) PRINT-OK)) (break)
        (let [first (load (p/index (.region-first-blocks arena) (cast i64 (load region))))
              count (load (p/index (.region-block-counts arena) (cast i64 (load region))))
              (mut i) (cast u32 0)]
          (push-text! buffer "region ")
          (push-u32! buffer (load region))
          (push-text! buffer " parent(")
          (push-id-or-none! buffer
            (load (p/index (.region-parent-ops arena) (cast i64 (load region)))))
          (push-text! buffer ") {\n")
          (loop
            (if (>= (load i) count) (break)
              (do
                (print-block! arena source buffer (region-block-at arena (load region) (load i)))
                (set! i (+ (load i) (cast u32 1))))))
          (push-text! buffer "}\n")
          (set! region (+ (load region) (cast u32 1))))))
    (let [(mut scope) (cast u32 0)]
      (loop
        (if (>= (load scope) (.scope-count arena)) (break)
          (do
            (push-text! buffer "scope ")
            (push-u32! buffer (load scope))
            (push-text! buffer " parent(")
            (push-id-or-none! buffer
              (load (p/index (.scope-parents arena) (cast i64 (load scope)))))
            (push-text! buffer ") loc(")
            (push-u32! buffer (load (p/index (.scope-starts arena) (cast i64 (load scope)))))
            (push-byte! buffer (cast u8 58))
            (push-u32! buffer (load (p/index (.scope-ends arena) (cast i64 (load scope)))))
            (push-text! buffer ")\n")
            (set! scope (+ (load scope) (cast u32 1)))))))
    (let [(mut binding) (cast u32 0)]
      (loop
        (if (>= (load binding) (.binding-count arena)) (break)
          (do
            (push-text! buffer "binding ")
            (push-u32! buffer (load binding))
            (push-text! buffer " scope(")
            (push-u32! buffer
              (load (p/index (.binding-scopes arena) (cast i64 (load binding)))))
            (push-text! buffer ") name(")
            (push-u32! buffer
              (load (p/index (.binding-name-starts arena) (cast i64 (load binding)))))
            (push-byte! buffer (cast u8 58))
            (push-u32! buffer
              (load (p/index (.binding-name-ends arena) (cast i64 (load binding)))))
            (push-text! buffer ")\n")
            (set! binding (+ (load binding) (cast u32 1)))))))
    (let [(mut reference) (cast u32 0)]
      (loop
        (if (>= (load reference) (.reference-count arena)) (break)
          (do
            (push-text! buffer "reference ")
            (push-u32! buffer (load reference))
            (push-text! buffer " binding(")
            (push-u32! buffer
              (load (p/index (.reference-bindings arena) (cast i64 (load reference)))))
            (push-text! buffer ") loc(")
            (push-u32! buffer
              (load (p/index (.reference-starts arena) (cast i64 (load reference)))))
            (push-byte! buffer (cast u8 58))
            (push-u32! buffer
              (load (p/index (.reference-ends arena) (cast i64 (load reference)))))
            (push-text! buffer ")\n")
            (set! reference (+ (load reference) (cast u32 1)))))))
    (let [(mut capture) (cast u32 0)]
      (loop
        (if (>= (load capture) (.capture-count arena)) (break)
          (do
            (push-text! buffer "capture ")
            (push-u32! buffer (load capture))
            (push-text! buffer " scope(")
            (push-u32! buffer
              (load (p/index (.capture-scopes arena) (cast i64 (load capture)))))
            (push-text! buffer ") binding(")
            (push-u32! buffer
              (load (p/index (.capture-bindings arena) (cast i64 (load capture)))))
            (push-text! buffer ")\n")
            (set! capture (+ (load capture) (cast u32 1)))))))
    (PrintResult :count (.count buffer) :error (.error buffer))))
