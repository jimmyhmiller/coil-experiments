(const OP-JS-ASYNC-GENERATOR-FUNCTION u16 81)
(const OP-JS-CLASS u16 82)
(const OP-JS-CLASS-METHOD u16 83)
(const OP-JS-CLASS-FIELD u16 84)
(const OP-JS-CLASS-STATIC-BLOCK u16 85)
(const OP-JS-DECORATOR u16 86)
(const OP-TS-PARAMETER-PROPERTY u16 87)
(const OP-TS-CLASS-INDEX-SIGNATURE u16 88)
(const OP-TS-TYPE-REFERENCE u16 89)
(const OP-TS-KEYWORD-TYPE u16 90)
(const OP-TS-LITERAL-TYPE u16 91)
(const OP-TS-UNION-TYPE u16 92)
(const OP-TS-INTERSECTION-TYPE u16 93)
(const OP-TS-ARRAY-TYPE u16 94)
(const OP-TS-TUPLE-TYPE u16 95)
(const OP-TS-PARENTHESIZED-TYPE u16 96)
(const OP-TS-TYPE-ARGUMENTS u16 97)
(const OP-TS-QUALIFIED-TYPE u16 98)
(const OP-TS-INDEXED-ACCESS-TYPE u16 99)
(const OP-TS-TYPE-OPERATOR u16 100)
(const OP-TS-TYPE-QUERY u16 101)
(const OP-TS-FUNCTION-TYPE u16 102)
(const OP-TS-CONSTRUCTOR-TYPE u16 103)
(const OP-TS-TYPE-LITERAL u16 104)
(const OP-TS-CONDITIONAL-TYPE u16 105)
(const OP-TS-INFER-TYPE u16 106)
(const OP-TS-MAPPED-TYPE u16 107)
(const OP-TS-TEMPLATE-LITERAL-TYPE u16 108)
(const OP-TS-IMPORT-TYPE u16 109)
(const OP-TS-TYPE-PREDICATE u16 110)
(const OP-TS-TYPE-PARAMETER u16 111)
(const OP-TS-PROPERTY-SIGNATURE u16 112)
(const OP-TS-METHOD-SIGNATURE u16 113)
(const OP-TS-CALL-SIGNATURE u16 114)
(const OP-TS-CONSTRUCT-SIGNATURE u16 115)
