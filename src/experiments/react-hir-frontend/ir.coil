(module experiments.react-hir-frontend.ir)

(import "coil.primitive" :as p)
(import "coil.slice" :use [slice-data])

;; All public identities are dense stable u32 indices. INVALID-ID is used only
;; for absent ownership (not as a value that can appear in a valid reference).
(const INVALID-ID u32 4294967295)

(const DEF-BLOCK-PARAM u8 1)
(const DEF-OP-RESULT u8 2)

;; The generic control-flow opcodes. Dialect operations occupy the nonzero,
;; non-terminator range and carry their printable name in opcode-names.
(const OP-INVALID u16 0)
(const OP-BR u16 1)
(const OP-COND-BR u16 2)
(const OP-RETURN u16 3)
(const OP-UNREACHABLE u16 4)
(const OP-THROW u16 5)
(const OP-YIELD u16 6)
(const OP-JS-IDENTIFIER u16 32)
(const OP-JS-NUMBER u16 33)
(const OP-JS-STRING u16 34)
(const OP-JS-UNARY u16 35)
(const OP-JS-BINARY u16 36)
(const OP-JS-CALL u16 37)
(const OP-JS-DECLARE u16 38)
(const OP-JS-ASSIGN u16 39)
(const OP-JS-EXPRESSION u16 40)
(const OP-JS-FUNCTION u16 41)
(const OP-JS-JSX-ELEMENT u16 42)
(const OP-JS-MEMBER u16 43)
(const OP-JS-ARRAY u16 44)
(const OP-JS-PROPERTY u16 45)
(const OP-JS-OBJECT u16 46)
(const OP-JS-EXPORT u16 47)
(const OP-TS-TYPE u16 48)
(const OP-TS-TYPE-ALIAS u16 49)
(const OP-JS-IMPORT u16 50)
(const OP-JS-IMPORT-SPECIFIER u16 51)
(const OP-TS-INSTANTIATION u16 52)
(const OP-JS-ARROW u16 53)
(const OP-TS-INTERFACE u16 54)
(const OP-JS-PREFIX-KEYWORD u16 55)
(const OP-JS-TEMPLATE u16 56)
(const OP-JS-BOOLEAN u16 57)
(const OP-JS-NULL u16 58)
(const OP-JS-THIS u16 59)
(const OP-JS-SUPER u16 60)
(const OP-JS-DEBUGGER u16 61)
(const OP-JS-COMPUTED-MEMBER u16 62)
(const OP-JS-UNDEFINED u16 63)
(const OP-JS-GROUP u16 64)
(const OP-TS-NON-NULL u16 65)
(const OP-JS-UPDATE u16 66)
(const OP-JS-ITERATOR-INIT u16 67)
(const OP-JS-ITERATOR-NEXT u16 68)
(const OP-JS-SPREAD u16 69)
(const OP-JS-ELISION u16 70)
(const OP-JS-REGEXP u16 71)
(const OP-JS-BIGINT u16 72)
(const OP-JS-IS-NULLISH u16 73)
(const OP-JS-OPTIONAL-MEMBER u16 74)
(const OP-JS-OPTIONAL-COMPUTED-MEMBER u16 75)
(const OP-JS-OPTIONAL-CALL u16 76)
(const OP-JS-TRY u16 77)
