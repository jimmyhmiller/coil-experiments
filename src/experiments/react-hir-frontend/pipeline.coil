(module experiments.react-hir-frontend.pipeline)

(import "coil.simd" :as v)
(import "coil.primitive" :as p)
(import "experiments.react-hir-frontend.frontend" :as frontend)
(import "experiments.react-hir-frontend.tape" :as tape)

(defstruct SourceTape
  [(count i64)
   (state frontend/FrontendState)])

(defn copy-state [(state frontend/FrontendState)] (-> frontend/FrontendState)
  (frontend/FrontendState :lexical (.lexical state)
                          :previous-code-word (.previous-code-word state)))

;; Scan one complete source buffer into caller-owned arrays. Since a source byte
;; emits at most one structural event, buffers with `size` elements are always
;; sufficient. The loop uses two physical 32-byte vectors per logical chunk;
;; only the final chunk pays for masked loads and a dynamic valid count.
(defn scan-source-to-tape64
  [(bytes (ptr u8))
   (size i64)
   (base-offset u32)
   (positions (ptr u32))
   (kinds (ptr u8))
   (initial frontend/FrontendState)] (-> SourceTape)
  (let [count (if (< size 0) 0 size)
        bulk-end (- count (% count 64))
        (mut offset) 0
        (mut written) 0
        (mut state) (copy-state initial)]
    (loop
      (if (>= (load offset) bulk-end) (break)
        (let [low (v/vloadu [u8 32] (p/index bytes (load offset)))
              high (v/vloadu [u8 32] (p/index bytes (+ (load offset) 32)))
              has-next (< (+ (load offset) 64) count)
              next (if has-next
                     (load (p/index bytes (+ (load offset) 64)))
                     (cast u8 0))
              chunk (frontend/classify-frontend-pair32
                      low high 64 next has-next (load state))
              emitted (tape/write-structural-tape-full
                       (.code chunk) (+ base-offset (cast u32 (load offset)))
                       (p/index positions (load written))
                       (p/index kinds (load written)))]
          (store! state (.state chunk))
          (set! written (+ (load written) emitted))
          (set! offset (+ (load offset) 64)))))
    (if (= bulk-end count) 0
      (let [tail-count (- count bulk-end)
            low-count (if (> tail-count 32) 32 tail-count)
            high-count (if (> tail-count 32) (- tail-count 32) 0)
            fill (v/vzero [u8 32])
            low (v/vload-partial [u8 32] (p/index bytes bulk-end) low-count fill)
            high-pointer (if (> high-count 0) (p/index bytes (+ bulk-end 32)) bytes)
            high (v/vload-partial [u8 32] high-pointer high-count fill)
            chunk (frontend/classify-frontend-pair32
                    low high tail-count (cast u8 0) false (load state))
            emitted (tape/write-structural-tape-full
                     (.code chunk) (+ base-offset (cast u32 bulk-end))
                     (p/index positions (load written))
                     (p/index kinds (load written)))]
        (store! state (.state chunk))
        (set! written (+ (load written) emitted))))
    (SourceTape :count (load written) :state (load state))))
