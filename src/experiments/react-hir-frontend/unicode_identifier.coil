(defn trie-member? :inline (Always)
  [(trie (ptr u8)) (trie-size u32) (codepoint u32)] (-> bool)
  (let [trie-index (/ codepoint (cast u32 512))]
    (if (>= trie-index trie-size) false
      (let [chunk (load (p/index trie (cast i64 trie-index)))
            offset (+ (* (cast u32 chunk) (cast u32 32))
                      (% (/ codepoint (cast u32 8)) (cast u32 64)))
            bits (load (p/index (unicode-leaf) (cast i64 offset)))]
        (!= (p/iand (p/ishr (cast u64 bits) (cast u64 (% codepoint (cast u32 8))))
                      (cast u64 1))
            (cast u64 0))))))

(defn id-start? :inline (Always) [(codepoint u32)] (-> bool)
  (trie-member? (unicode-trie-start) (cast u32 402) codepoint))

(defn id-continue? :inline (Always) [(codepoint u32)] (-> bool)
  (or (= codepoint (cast u32 8204)) (= codepoint (cast u32 8205))
      (trie-member? (unicode-trie-continue) (cast u32 1793) codepoint)))

