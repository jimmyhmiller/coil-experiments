(module experiments.react-hir-frontend.tape)

(import "coil.primitive" :as p)
(import "experiments.react-hir-frontend.structural" :as structural)

(const EVENT-WORD i64 1)
(const EVENT-PUNCTUATION i64 2)
(const EVENT-OPERATOR i64 3)
(const EVENT-DELIMITER i64 4)
(const EVENT-JSX-CANDIDATE i64 5)

(defstruct TapeWrite
  [(count i64)
   ;; Bits not written because capacity was exhausted. Resuming is lossless.
   (remaining u64)
   (complete bool)])

(defn bit-present? [(bits u64) (bit u64)] (-> bool)
  (!= (p/iand bits bit) (cast u64 0)))

(defn event-kind [(chunk structural/StructuralChunk) (bit u64)] (-> u8)
  (cond (bit-present? (.word-start-bits chunk) bit) (cast u8 EVENT-WORD)
        (bit-present? (.jsx-marker-bits chunk) bit) (cast u8 EVENT-JSX-CANDIDATE)
        (bit-present? (.delimiter-bits chunk) bit) (cast u8 EVENT-DELIMITER)
        (bit-present? (.operator-bits chunk) bit) (cast u8 EVENT-OPERATOR)
        :else (cast u8 EVENT-PUNCTUATION)))

;; Stable source-order bitmap compaction. Positions and kinds are parallel caller-
;; owned buffers, which keeps allocation policy out of the parsing kernel.
(defn write-structural-tape
  [(chunk structural/StructuralChunk)
   (base-offset u32)
   (positions (ptr u32))
   (kinds (ptr u8))
   (capacity i64)] (-> TapeWrite)
  (let [(mut bits) (p/ior (.word-start-bits chunk) (.punctuation-bits chunk))
        limit (cond (< capacity 0) 0 :else capacity)
        (mut count) 0]
    (loop
      (if (or (= (load bits) (cast u64 0)) (>= (load count) limit))
          (break)
          (let [index (cast i64 (p/ctz (load bits)))
                bit (p/ishl (cast u64 1) (cast u64 index))]
            (store! (p/index positions (load count))
                    (+ base-offset (cast u32 index)))
            (store! (p/index kinds (load count)) (event-kind chunk bit))
            (set! count (+ (load count) 1))
            (store! bits (p/iand (load bits)
                                 (p/isub (load bits) (cast u64 1)))))))
    (TapeWrite :count (load count)
               :remaining (load bits)
               :complete (= (load bits) (cast u64 0)))))
