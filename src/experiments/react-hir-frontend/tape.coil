(module experiments.react-hir-frontend.tape)

(import "coil.primitive" :as p)
(import "coil.simd" :as v)
(import "experiments.react-hir-frontend.structural" :as structural)

(const EVENT-WORD i64 1)
(const EVENT-PUNCTUATION i64 2)
(const EVENT-OPERATOR i64 3)
(const EVENT-DELIMITER i64 4)
(const EVENT-JSX-CANDIDATE i64 5)
(const EVENT-LITERAL i64 6)

(defstruct TapeWrite
  [(count i64)
   ;; Bits not written because capacity was exhausted. Resuming is lossless.
   (remaining u64)
   (complete bool)])

(defn bit-present? [(bits u64) (bit u64)] (-> bool)
  (!= (p/iand bits bit) (cast u64 0)))

(defn event-kind-from-planes :inline (Always)
  [(plane0 u64) (plane1 u64) (plane2 u64) (bit u64)] (-> u8)
  (+ (if (bit-present? plane0 bit) (cast u8 1) (cast u8 0))
     (+ (if (bit-present? plane1 bit) (cast u8 2) (cast u8 0))
        (if (bit-present? plane2 bit) (cast u8 4) (cast u8 0)))))

;; Stable source-order bitmap compaction. Positions and kinds are parallel caller-
;; owned buffers, which keeps allocation policy out of the parsing kernel.
(defn write-structural-tape
  [(chunk structural/StructuralChunk)
   (base-offset u32)
   (positions (ptr u32))
   (kinds (ptr u8))
   (capacity i64)] (-> TapeWrite)
  (let [word (.word-start-bits chunk)
        punctuation (.punctuation-bits chunk)
        jsx (p/iand punctuation (.jsx-marker-bits chunk))
        after-jsx (p/iand punctuation (p/inot jsx))
        delimiter (p/iand after-jsx (.delimiter-bits chunk))
        after-delimiter (p/iand after-jsx (p/inot delimiter))
        operator (p/iand after-delimiter (.operator-bits chunk))
        plain (p/iand after-delimiter (p/inot operator))
        plane0 (p/ior word (p/ior jsx operator))
        plane1 (p/ior operator plain)
        plane2 (p/ior jsx delimiter)
        (mut bits) (p/ior word punctuation)
        limit (cond (< capacity 0) 0 :else capacity)
        (mut count) 0]
    (loop
      (if (or (= (load bits) (cast u64 0)) (>= (load count) limit))
          (break)
          (let [index (cast i64 (p/ctz (load bits)))
                bit (p/ishl (cast u64 1) (cast u64 index))]
            (store! (p/index positions (load count))
                    (+ base-offset (cast u32 index)))
            (store! (p/index kinds (load count))
                    (event-kind-from-planes plane0 plane1 plane2 bit))
            (set! count (+ (load count) 1))
            (store! bits (p/iand (load bits)
                                 (p/isub (load bits) (cast u64 1)))))))
    (TapeWrite :count (load count)
               :remaining (load bits)
               :complete (= (load bits) (cast u64 0)))))

;; Fast path for callers that reserve one output slot per source byte. It has
;; the same source order and tag encoding as the resumable writer, but capacity
;; exhaustion is impossible and the hot loop returns only its write count.
(defn write-structural-tape-full :inline (Always)
  [(chunk structural/StructuralChunk)
   (base-offset u32)
   (positions (ptr u32))
   (kinds (ptr u8))] (-> i64)
  (let [word (.word-start-bits chunk)
        punctuation (.punctuation-bits chunk)
        jsx (p/iand punctuation (.jsx-marker-bits chunk))
        after-jsx (p/iand punctuation (p/inot jsx))
        delimiter (p/iand after-jsx (.delimiter-bits chunk))
        after-delimiter (p/iand after-jsx (p/inot delimiter))
        operator (p/iand after-delimiter (.operator-bits chunk))
        plain (p/iand after-delimiter (p/inot operator))
        plane0 (p/ior word (p/ior jsx operator))
        plane1 (p/ior operator plain)
        plane2 (p/ior jsx delimiter)
        (mut bits) (p/ior word punctuation)
        (mut count) 0]
    (loop
      (if (= (load bits) (cast u64 0)) (break)
        (let [index (cast i64 (p/ctz (load bits)))
              bit (p/ishl (cast u64 1) (cast u64 index))]
          (store! (p/index positions (load count))
                  (+ base-offset (cast u32 index)))
          (store! (p/index kinds (load count))
                  (event-kind-from-planes plane0 plane1 plane2 bit))
          (set! count (+ (load count) 1))
          (store! bits (p/iand (load bits)
                               (p/isub (load bits) (cast u64 1)))))))
    (load count)))

;; Packed variant: upper 29 bits are a file-relative source position and the
;; low three bits are EventKind. The pipeline checks the 512 MiB size limit once.
(defn write-structural-tape-packed32-full :inline (Always)
  [(chunk structural/StructuralChunk)
   (base-offset u32)
   (events (ptr u32))] (-> i64)
  (let [word (.word-start-bits chunk)
        punctuation (.punctuation-bits chunk)
        jsx (p/iand punctuation (.jsx-marker-bits chunk))
        after-jsx (p/iand punctuation (p/inot jsx))
        delimiter (p/iand after-jsx (.delimiter-bits chunk))
        after-delimiter (p/iand after-jsx (p/inot delimiter))
        operator (p/iand after-delimiter (.operator-bits chunk))
        plain (p/iand after-delimiter (p/inot operator))
        plane0 (p/ior word (p/ior jsx operator))
        plane1 (p/ior operator plain)
        plane2 (p/ior jsx delimiter)
        (mut bits) (p/ior word punctuation)
        (mut count) 0]
    (loop
      (if (= (load bits) (cast u64 0)) (break)
        (let [index (cast i64 (p/ctz (load bits)))
              bit (p/ishl (cast u64 1) (cast u64 index))
              position (+ base-offset (cast u32 index))
              kind (cast u32 (event-kind-from-planes plane0 plane1 plane2 bit))]
          (store! (p/index events (load count))
                  (cast u32 (p/ior
                    (p/ishl (cast u64 position) (cast u64 3)) (cast u64 kind))))
          (set! count (+ (load count) 1))
          (store! bits (p/iand (load bits)
                               (p/isub (load bits) (cast u64 1)))))))
    (load count)))

;; Parser tape variant. Quote boundaries are deliberately separate from code
;; punctuation: the lexical pass has already excluded quotes in comments and
;; identified the complete quoted span. The grammar lazily decodes the literal
;; from source bytes and consumes the matching closing-boundary event.
(defn write-parse-tape-packed32-with-literals :inline (Always)
  [(chunk structural/StructuralChunk) (literal-bits u64)
   (base-offset u32) (events (ptr u32))] (-> i64)
  (let [word (.word-start-bits chunk)
        punctuation (.punctuation-bits chunk)
        jsx (p/iand punctuation (.jsx-marker-bits chunk))
        after-jsx (p/iand punctuation (p/inot jsx))
        delimiter (p/iand after-jsx (.delimiter-bits chunk))
        after-delimiter (p/iand after-jsx (p/inot delimiter))
        operator (p/iand after-delimiter (.operator-bits chunk))
        plain (p/iand after-delimiter (p/inot operator))
        plane0 (p/ior word (p/ior jsx operator))
        plane1 (p/ior literal-bits (p/ior operator plain))
        plane2 (p/ior literal-bits (p/ior jsx delimiter))
        (mut bits) (p/ior literal-bits (p/ior word punctuation))
        (mut count) 0]
    (loop
      (if (= (load bits) (cast u64 0)) (break)
        (let [index (cast i64 (p/ctz (load bits)))
              bit (p/ishl (cast u64 1) (cast u64 index))
              position (+ base-offset (cast u32 index))
              kind (cast u32 (event-kind-from-planes plane0 plane1 plane2 bit))]
          (store! (p/index events (load count))
                  (cast u32 (p/ior
                    (p/ishl (cast u64 position) (cast u64 3)) (cast u64 kind))))
          (set! count (+ (load count) 1))
          (store! bits (p/iand (load bits)
                               (p/isub (load bits) (cast u64 1)))))))
    (load count)))

(defn write-parse-tape-packed32-full :inline (Always)
  [(chunk structural/StructuralChunk) (literal-bits u64)
   (base-offset u32) (events (ptr u32))] (-> i64)
  (if (= literal-bits (cast u64 0))
      (write-structural-tape-packed32-full chunk base-offset events)
      (write-parse-tape-packed32-with-literals
        chunk literal-bits base-offset events)))

;; Width-specialized hot path. When the caller has room for the chunk,
;; positions and tags are compacted with SIMD rather than one ctz/store
;; iteration per event. The scalar writer preserves the exact
;; capacity/resumption contract for short output buffers.
(defn write-structural-tape-simd :inline (Always) [N]
  [(chunk structural/StructuralChunk)
   (base-offset u32)
   (positions (ptr u32))
   (kinds (ptr u8))
   (capacity i64)] (-> TapeWrite)
  (let [width (v/vlanes (v/vzero [u8 N]))
        bits (p/iand (p/ior (.word-start-bits chunk) (.punctuation-bits chunk))
                     (v/bits-low width))
        active (v/bits->mask [N] bits)
        needed (v/mask-count active)]
    (if (< capacity needed)
        (write-structural-tape chunk base-offset positions kinds capacity)
        (let [position-values
                (v/vadd (v/viota [u32 N])
                        (v/vsplat [u32 N] base-offset))
              operator (v/bits->mask [N] (.operator-bits chunk))
              delimiter (v/bits->mask [N] (.delimiter-bits chunk))
              jsx (v/bits->mask [N] (.jsx-marker-bits chunk))
              word (v/bits->mask [N] (.word-start-bits chunk))
              tag0 (v/vsplat [u8 N] (cast u8 EVENT-PUNCTUATION))
              tag1 (v/vselect operator
                       (v/vsplat [u8 N] (cast u8 EVENT-OPERATOR)) tag0)
              tag2 (v/vselect delimiter
                       (v/vsplat [u8 N] (cast u8 EVENT-DELIMITER)) tag1)
              tag3 (v/vselect jsx
                       (v/vsplat [u8 N] (cast u8 EVENT-JSX-CANDIDATE)) tag2)
              tags (v/vselect word
                     (v/vsplat [u8 N] (cast u8 EVENT-WORD)) tag3)
              position-count (v/vcompress-store positions active position-values)
              kind-count (v/vcompress-store kinds active tags)]
          (TapeWrite :count position-count
                     :remaining (cast u64 0)
                     :complete (= position-count kind-count))))))

(defn write-structural-tape32 :inline (Always)
  [(chunk structural/StructuralChunk) (base-offset u32)
   (positions (ptr u32)) (kinds (ptr u8)) (capacity i64)] (-> TapeWrite)
  (write-structural-tape-simd [(const 32)]
    chunk base-offset positions kinds capacity))

(defn write-structural-tape64 :inline (Always)
  [(chunk structural/StructuralChunk) (base-offset u32)
   (positions (ptr u32)) (kinds (ptr u8)) (capacity i64)] (-> TapeWrite)
  (write-structural-tape-simd [(const 64)]
    chunk base-offset positions kinds capacity))
