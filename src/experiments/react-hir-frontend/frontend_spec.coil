(module experiments.react-hir-frontend.frontend-spec)

(import "experiments.react-hir-frontend.grammar" :use [def-frontend-grammar])

;; This is the complete declarative grammar for the currently implemented
;; frontend slice. Runtime parsing machinery lives in parser.coil; language
;; spelling, precedence, dispatch, and production shape live only here.
(def-frontend-grammar react-hir
  (terminals terminal-byte
    [(bang 33) (dollar 36) (percent 37) (ampersand 38) (lparen 40) (rparen 41)
     (star 42) (plus 43) (comma 44)
     (minus 45) (dot 46) (slash 47) (colon 58) (semicolon 59)
     (less-than 60) (equals 61) (greater-than 62) (question 63)
     (lbracket 91) (backslash 92) (caret 94) (rbracket 93) (backtick 96)
     (lbrace 123) (pipe 124)
     (rbrace 125) (tilde 126)])

  (events
    [(word-event 1) (literal-event 2)])

  (operators binary-precedence binary-width binary-info binary-lookahead
    [(right 80 "**")
     (left 60 plus minus)
     (left 70 star slash percent)
     (left 50 "===" "!==" "==" "!=")
     (left 55 ">>>" "<<" ">>")
     (left 40 "<=" ">=" less-than greater-than)
     (left 30 "&&")
     (left 25 "??")
     (left 37 ampersand)
     (left 36 caret)
     (left 20 "||")
     (left 35 pipe)])

  (forms primary-form
    [(event word-event form-word)
     (event literal-event form-string)
     (terminal lparen form-group)
     (terminal bang form-unary-bang)
     (terminal minus form-unary-minus)
     (terminal plus form-unary-plus)
     (terminal tilde form-unary-tilde)
     (terminal lbracket form-array)
     (terminal lbrace form-object)
     (terminal less-than form-jsx)
     (terminal slash form-regexp)
     (terminal dot form-leading-dot-number)])

  (forms postfix-form
    [(terminal lparen form-call)
     (terminal dot form-member)
     (terminal bang form-non-null)
     (terminal plus form-postfix-plus)
     (terminal minus form-postfix-minus)
     (terminal lbracket form-computed-member)
     (terminal less-than form-type-arguments)])

  (productions production-terminal production-keyword
    [(group-production
       [(terminal lparen) (rule expression) (terminal rparen)])
     (call-production
       [(terminal lparen) (separated expression comma) (terminal rparen)])
     (member-production
       [(terminal dot) (rule identifier)])
     (computed-member-production
       [(terminal lbracket) (rule expression) (terminal rbracket)])
     (spread-production
       [(terminal dot) (terminal dot) (terminal dot) (rule expression)])
     (regexp-production
       [(terminal slash) (rule regexp-pattern) (terminal slash) (rule regexp-flags)])
     (non-null-production
       [(rule expression) (terminal bang)])
     (conditional-production
       [(terminal question) (rule expression) (terminal colon) (rule expression)])
     (assignment-production
       [(rule target) (terminal equals) (rule expression)])
     (array-production
       [(terminal lbracket) (separated expression comma) (terminal rbracket)])
     (property-production
       [(rule property-name) (terminal colon) (rule expression)])
     (object-production
       [(terminal lbrace) (separated property comma) (terminal rbrace)])
     (unary-production
       [(rule unary-operator) (rule expression)])
     (jsx-attribute-production
       [(rule identifier) (terminal equals) (terminal lbrace)
        (rule expression) (terminal rbrace)])
     (jsx-string-attribute-production
       [(rule identifier) (terminal equals) (rule string)])
     (jsx-expression-child-production
       [(terminal lbrace) (rule expression) (terminal rbrace)])
     (jsx-element-production
       [(terminal less-than) (rule identifier) (repeat jsx-attribute)
        (terminal slash) (terminal greater-than)])
     (jsx-open-element-production
       [(terminal less-than) (rule identifier) (repeat jsx-attribute)
        (terminal greater-than)])
     (jsx-close-element-production
       [(terminal less-than) (terminal slash) (rule identifier)
        (terminal greater-than)])
     (variable-production
       [(keyword "const") (rule binding) (terminal equals)
        (rule expression) (terminal semicolon)])
     (let-production
       [(keyword "let") (rule binding) (terminal equals)
        (rule expression) (terminal semicolon)])
     (var-production
       [(keyword "var") (rule binding) (terminal equals)
        (rule expression) (terminal semicolon)])
     (expression-statement-production
       [(rule expression) (terminal semicolon)])
     (return-production
       [(keyword "return") (rule expression) (terminal semicolon)])
     (throw-production
       [(keyword "throw") (rule expression) (terminal semicolon)])
     (break-production
       [(keyword "break") (terminal semicolon)])
     (continue-production
       [(keyword "continue") (terminal semicolon)])
     (block-production
       [(terminal lbrace) (repeat statement) (terminal rbrace)])
     (if-production
       [(keyword "if") (terminal lparen) (rule expression) (terminal rparen)
        (rule statement)])
     (else-clause-production
       [(keyword "else") (rule statement)])
     (while-production
       [(keyword "while") (terminal lparen) (rule expression) (terminal rparen)
        (rule statement)])
     (do-while-production
       [(keyword "do") (rule statement) (keyword "while") (terminal lparen)
        (rule expression) (terminal rparen) (terminal semicolon)])
     (for-production
       [(keyword "for") (terminal lparen) (rule initializer) (terminal semicolon)
        (rule condition) (terminal semicolon) (rule update) (terminal rparen)
        (rule statement)])
     (for-in-production
       [(keyword "for") (terminal lparen) (rule assignment-target) (keyword "in")
        (rule expression) (terminal rparen) (rule statement)])
     (for-of-production
       [(keyword "for") (terminal lparen) (rule assignment-target) (keyword "of")
        (rule expression) (terminal rparen) (rule statement)])
     (for-await-of-production
       [(keyword "for") (keyword "await") (terminal lparen)
        (rule assignment-target) (keyword "of") (rule expression)
        (terminal rparen) (rule statement)])
     (switch-production
       [(keyword "switch") (terminal lparen) (rule expression) (terminal rparen)
        (terminal lbrace) (repeat switch-clause) (terminal rbrace)])
     (case-production
       [(keyword "case") (rule expression) (terminal colon) (repeat statement)])
     (default-production
       [(keyword "default") (terminal colon) (repeat statement)])
     (function-production
       [(keyword "function") (rule identifier) (terminal lparen)
        (separated binding comma) (terminal rparen) (rule block)])
     (program-production
       [(repeat statement)])]))
