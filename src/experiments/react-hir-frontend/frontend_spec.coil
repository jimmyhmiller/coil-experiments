(module experiments.react-hir-frontend.frontend-spec)

(import "experiments.react-hir-frontend.grammar" :use [def-frontend-grammar])

;; This is the complete declarative grammar for the currently implemented
;; frontend slice. Runtime parsing machinery lives in parser.coil; language
;; spelling, precedence, dispatch, and production shape live only here.
(def-frontend-grammar react-hir
  (terminals terminal-byte
    [(lparen 40) (rparen 41) (star 42) (plus 43) (comma 44)
     (minus 45) (slash 47) (colon 58) (semicolon 59)
     (less-than 60) (equals 61) (greater-than 62) (question 63)
     (lbrace 123) (rbrace 125) (percent 37)])

  (events
    [(word-event 1)])

  (operators binary-precedence
    [(left 60 star slash percent)
     (left 50 plus minus)
     (left 40 less-than greater-than)])

  (forms primary-form
    [(event word-event form-word)
     (terminal lparen form-group)
     (terminal less-than form-jsx)])

  (forms postfix-form
    [(terminal lparen form-call)])

  (productions production-terminal production-keyword
    [(group-production
       [(terminal lparen) (rule expression) (terminal rparen)])
     (call-production
       [(terminal lparen) (separated expression comma) (terminal rparen)])
     (conditional-production
       [(terminal question) (rule expression) (terminal colon) (rule expression)])
     (jsx-attribute-production
       [(rule identifier) (terminal equals) (terminal lbrace)
        (rule expression) (terminal rbrace)])
     (jsx-element-production
       [(terminal less-than) (rule identifier) (repeat jsx-attribute)
        (terminal slash) (terminal greater-than)])
     (variable-production
       [(keyword "const") (rule binding) (terminal equals)
        (rule expression) (terminal semicolon)])
     (program-production
       [(repeat variable-production)])]))
