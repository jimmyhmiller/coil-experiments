(module experiments.react-hir-frontend.grammar)

(import "coil.primitive" :as p)

;; Grammar data stays declarative. This compile-time metaprogram validates an
;; S-expression operator table and lowers it to a straight-line byte dispatch.
;; The parser therefore pays neither table initialization nor an indirect call.
;;
;;   (def-infix-precedence infix-precedence
;;     [(operator 42 60) (operator 43 50)])

(defn grammar-symbol? [(value Code) (name (slice u8))] (-> bool)
  (and (p/code-sym? value) (= (p/code-sym value) name)))

(defn grammar-fail [(at Code) (message (slice u8))] (-> Code)
  (do (p/report at message) at))

(defn operator-byte [(entry Code)] (-> i64)
  (if (and (p/code-list? entry) (= (p/code-count entry) 3)
           (grammar-symbol? (p/code-nth entry 0) "operator")
           (p/code-int? (p/code-nth entry 1)))
      (let [byte (p/code-int (p/code-nth entry 1))]
        (if (and (>= byte 0) (<= byte 255)) byte
          (do (p/report entry "operator byte must be in [0, 255]") 0)))
      (do (p/report entry "operator entry expects (operator BYTE PRECEDENCE)") 0)))

(defn operator-precedence [(entry Code)] (-> i64)
  (if (and (p/code-list? entry) (= (p/code-count entry) 3)
           (p/code-int? (p/code-nth entry 2)))
      (let [precedence (p/code-int (p/code-nth entry 2))]
        (if (> precedence 0) precedence
          (do (p/report entry "operator precedence must be positive") 0)))
      (do (p/report entry "operator precedence must be an integer") 0)))

(defn operator-seen-before? [(entries Code) (end i64) (byte i64)] (-> bool)
  (let [(mut i) 0 (mut found) false]
    (loop
      (if (or (>= (load i) end) (load found)) (break)
        (do
          (if (= (operator-byte (p/code-nth entries (load i))) byte)
              (store! found true) 0)
          (set! i (+ (load i) 1)))))
    (load found)))

(defn compile-operator-dispatch [(entries Code) (index i64) (byte Code)] (-> Code)
  (if (>= index (p/code-count entries)) `0
    (let [entry (p/code-nth entries index)
          op (operator-byte entry)
          precedence (operator-precedence entry)]
      (if (operator-seen-before? entries index op)
          (do (p/report entry "duplicate operator byte")
              (compile-operator-dispatch entries (+ index 1) byte))
          `(if (= ~byte (cast u8 ~op)) ~precedence
             ~(compile-operator-dispatch entries (+ index 1) byte))))))

(defn def-infix-precedence [(name Code) (entries Code)] (-> Code)
  (if (not (p/code-vector? entries))
      (grammar-fail entries "def-infix-precedence expects an entry vector")
      (let [byte (p/fresh-identifier "operator-byte")]
        `(defn ~name :inline (Always) [(~byte u8)] (-> i64)
           ~(compile-operator-dispatch entries 0 byte)))))
