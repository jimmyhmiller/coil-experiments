(module experiments.react-hir-frontend.frontend)

(import "coil.simd" :as v)
(import "coil.primitive" :as p)
(import "experiments.react-hir-frontend.lexical" :as lex)
(import "experiments.react-hir-frontend.structural" :as structural)

(defstruct FrontendState
  [(lexical lex/LexicalState)
   (previous-code-word bool)])

(defstruct FrontendChunk
  [;; Raw character classes remain available for literal/comment tape events.
   (raw structural/StructuralChunk)
   (lexical lex/LexicalChunk)
   ;; Every bitmap here is restricted to bytes currently visible as JS code.
   (code structural/StructuralChunk)
   (state FrontendState)])

(defn frontend-initial-state [] (-> FrontendState)
  (FrontendState :lexical (lex/lexical-initial-state)
                 :previous-code-word false))

(defn final-bit? [(bits u64) (count i64) (fallback bool)] (-> bool)
  (if (= count 0) fallback
    (!= (p/iand (p/ishr bits (cast u64 (- count 1))) (cast u64 1))
        (cast u64 0))))

;; One fused public boundary for the byte-class and lexical passes. The
;; one-byte overlap is only needed to decide a trailing `/` without backpatching.
(defn classify-frontend [N]
  [(bytes (vec u8 N))
   (valid-count i64)
   (next-byte u8)
   (has-next bool)
   (initial FrontendState)] (-> FrontendChunk)
  (let [width (v/vlanes bytes)
        count (cond (< valid-count 0) 0
                    (> valid-count width) width
                    (> valid-count 64) 64
                    :else valid-count)
        classes (structural/classify-js-classes bytes count)
        valid (v/bits-low count)
        star (p/iand valid (v/mask->bits (v/v= bytes (v/vsplat [u8 N] (cast u8 42)))))
        backslash (p/iand valid (v/mask->bits (v/v= bytes (v/vsplat [u8 N] (cast u8 92)))))
        lf (p/iand valid (v/mask->bits (v/v= bytes (v/vsplat [u8 N] (cast u8 10)))))
        cr (p/iand valid (v/mask->bits (v/v= bytes (v/vsplat [u8 N] (cast u8 13)))))
        lexical (lex/classify-lexical-events
                  count (.single-quote classes) (.double-quote classes)
                  (.backtick classes) (.slash classes) star backslash lf cr
                  next-byte has-next (.lexical initial))
        raw (structural/structural-from-classes classes count false)
        visible (.code-bits lexical)
        word (p/iand (.word-bits raw) visible)
        whitespace (p/iand (.whitespace-bits raw) visible)
        prior (p/ior (p/ishl word (cast u64 1))
                     (if (.previous-code-word initial) (cast u64 1) (cast u64 0)))
        starts (p/iand word (p/inot prior))
        code (structural/StructuralChunk
               :word-bits word
               :word-start-bits starts
               :whitespace-bits whitespace
               :punctuation-bits (p/iand (.punctuation-bits raw) visible)
               :operator-bits (p/iand (.operator-bits raw) visible)
               :operator-adjacent-bits
                 (p/iand (.operator-adjacent-bits raw) visible)
               :quote-bits (cast u64 0)
               :slash-bits (p/iand (.slash-bits raw) visible)
               :backtick-bits (cast u64 0)
               :delimiter-bits (p/iand (.delimiter-bits raw) visible)
               :jsx-marker-bits (p/iand (.jsx-marker-bits raw) visible)
               :next-word (final-bit? word count (.previous-code-word initial)))
        state (FrontendState :lexical (.state lexical)
                             :previous-code-word (.next-word code))]
    (FrontendChunk :raw raw :lexical lexical :code code :state state)))
