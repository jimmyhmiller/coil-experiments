(module experiments.react-hir-frontend.ir-builder-test)

(import "coil.primitive" :as p)
(import "coil.slice" :use [slice-data])
(import "experiments.react-hir-frontend.ir" :as ir)
(import "experiments.react-hir-frontend.ir-builder" :as b)
(import "experiments.react-hir-frontend.ir-storage" :as storage)
(import "experiments.react-hir-frontend.ir-text-parser" :as ir-text)

(defn byte-eq? [(actual (ptr u8)) (expected (slice u8)) (count i64)] (-> bool)
  (if (!= count (len expected)) false
    (let [(mut i) 0 (mut same) true]
      (loop
        (if (or (>= (load i) count) (not (load same))) (break)
          (do
            (if (!= (load (p/index actual (load i)))
                    (load (p/index (slice-data expected) (load i))))
                (store! same false) 0)
            (set! i (+ (load i) 1)))))
      (load same))))

(defn ptr-byte-eq? [(left (ptr u8)) (right (ptr u8)) (count i64)] (-> bool)
  (let [(mut i) 0 (mut same) true]
    (loop
      (if (or (>= (load i) count) (not (load same))) (break)
        (do
          (if (!= (load (p/index left (load i))) (load (p/index right (load i))))
              (store! same false) 0)
          (set! i (+ (load i) 1)))))
    (load same)))

(defn test-interleaved-nested-construction [] (-> i64)
  (let [source "custom.calljs.inner"
        u32s (p/alloc-stack (array u32 4))
        region-parent (p/alloc-stack (array u32 2))
        region-first (p/alloc-stack (array u32 2))
        region-counts (p/alloc-stack (array u32 2))
        region-blocks (p/alloc-stack (array u32 2))
        block-regions (p/alloc-stack (array u32 2))
        block-first-params (p/alloc-stack (array u32 2))
        block-param-counts (p/alloc-stack (array u32 2))
        block-first-ops (p/alloc-stack (array u32 2))
        block-op-counts (p/alloc-stack (array u32 2))
        block-ops (p/alloc-stack (array u32 3))
        opcodes (p/alloc-stack (array u16 3))
        name-starts (p/alloc-stack (array u32 3))
        name-ends (p/alloc-stack (array u32 3))
        op-first-operands (p/alloc-stack (array u32 3))
        op-operand-counts (p/alloc-stack (array u32 3))
        op-first-results (p/alloc-stack (array u32 3))
        op-result-counts (p/alloc-stack (array u32 3))
        op-first-successors (p/alloc-stack (array u32 3))
        op-successor-counts (p/alloc-stack (array u32 3))
        op-first-regions (p/alloc-stack (array u32 3))
        op-region-counts (p/alloc-stack (array u32 3))
        op-regions (p/alloc-stack (array u32 1))
        op-starts (p/alloc-stack (array u32 3))
        op-ends (p/alloc-stack (array u32 3))
        op-immediates (p/alloc-stack (array u64 3))
        operands (p/alloc-stack (array u32 1))
        successor-blocks (p/alloc-stack (array u32 1))
        successor-first-args (p/alloc-stack (array u32 1))
        successor-arg-counts (p/alloc-stack (array u32 1))
        successor-args (p/alloc-stack (array u32 1))
        value-kinds (p/alloc-stack (array u8 1))
        value-defs (p/alloc-stack (array u32 1))
        scope-parents (p/alloc-stack (array u32 2))
        scope-starts (p/alloc-stack (array u32 2))
        scope-ends (p/alloc-stack (array u32 2))
        binding-scopes (p/alloc-stack (array u32 1))
        binding-starts (p/alloc-stack (array u32 1))
        binding-ends (p/alloc-stack (array u32 1))
        reference-bindings (p/alloc-stack (array u32 1))
        reference-starts (p/alloc-stack (array u32 1))
        reference-ends (p/alloc-stack (array u32 1))
        capture-scopes (p/alloc-stack (array u32 1))
        capture-bindings (p/alloc-stack (array u32 1))
        arena (p/alloc-stack ir/IrArena)
        region-heads (p/alloc-stack (array u32 2))
        region-tails (p/alloc-stack (array u32 2))
        block-next (p/alloc-stack (array u32 2))
        block-heads (p/alloc-stack (array u32 2))
        block-tails (p/alloc-stack (array u32 2))
        op-next (p/alloc-stack (array u32 3))
        op-region-heads (p/alloc-stack (array u32 3))
        op-region-tails (p/alloc-stack (array u32 3))
        region-next-in-op (p/alloc-stack (array u32 2))
        scratch-storage (p/alloc-stack b/BuilderScratch)
        builder (p/alloc-stack b/IrBuilder)
        dom (p/alloc-stack (array u64 4))
        verify-scratch (p/alloc-stack ir/VerifyScratch)
        output (p/alloc-stack (array u8 512))
        roundtrip-memory (p/alloc-stack (array u64 2048))
        roundtrip-arena (p/alloc-stack ir/IrArena)
        roundtrip-scratch (p/alloc-stack b/BuilderScratch)
        roundtrip-builder (p/alloc-stack b/IrBuilder)
        roundtrip-dom (p/alloc-stack (array u64 4))
        roundtrip-verify (p/alloc-stack ir/VerifyScratch)
        roundtrip-output (p/alloc-stack (array u8 512))]
    (store! arena (ir/IrArena
      :source-size (cast u32 19)
      :region-parent-ops (p/cast (ptr u32) region-parent)
      :region-first-blocks (p/cast (ptr u32) region-first)
      :region-block-counts (p/cast (ptr u32) region-counts) :region-count (cast u32 0)
      :region-blocks (p/cast (ptr u32) region-blocks) :region-block-ref-count (cast u32 0)
      :block-regions (p/cast (ptr u32) block-regions)
      :block-first-params (p/cast (ptr u32) block-first-params)
      :block-param-counts (p/cast (ptr u32) block-param-counts)
      :block-first-ops (p/cast (ptr u32) block-first-ops)
      :block-op-counts (p/cast (ptr u32) block-op-counts) :block-count (cast u32 0)
      :block-ops (p/cast (ptr u32) block-ops) :block-op-ref-count (cast u32 0)
      :opcodes (p/cast (ptr u16) opcodes)
      :op-name-starts (p/cast (ptr u32) name-starts) :op-name-ends (p/cast (ptr u32) name-ends)
      :op-first-operands (p/cast (ptr u32) op-first-operands)
      :op-operand-counts (p/cast (ptr u32) op-operand-counts)
      :op-first-results (p/cast (ptr u32) op-first-results)
      :op-result-counts (p/cast (ptr u32) op-result-counts)
      :op-first-successors (p/cast (ptr u32) op-first-successors)
      :op-successor-counts (p/cast (ptr u32) op-successor-counts)
      :op-first-regions (p/cast (ptr u32) op-first-regions)
      :op-region-counts (p/cast (ptr u32) op-region-counts)
      :op-regions (p/cast (ptr u32) op-regions) :op-region-ref-count (cast u32 0)
      :op-starts (p/cast (ptr u32) op-starts) :op-ends (p/cast (ptr u32) op-ends)
      :op-immediates (p/cast (ptr u64) op-immediates)
      :op-count (cast u32 0)
      :operands (p/cast (ptr u32) operands) :operand-count (cast u32 0)
      :successor-blocks (p/cast (ptr u32) successor-blocks)
      :successor-first-args (p/cast (ptr u32) successor-first-args)
      :successor-arg-counts (p/cast (ptr u32) successor-arg-counts)
      :successor-count (cast u32 0)
      :successor-args (p/cast (ptr u32) successor-args) :successor-arg-count (cast u32 0)
      :value-def-kinds (p/cast (ptr u8) value-kinds)
      :value-def-indices (p/cast (ptr u32) value-defs) :value-count (cast u32 0)
      :scope-parents (p/cast (ptr u32) scope-parents)
      :scope-starts (p/cast (ptr u32) scope-starts) :scope-ends (p/cast (ptr u32) scope-ends)
      :scope-count (cast u32 0)
      :binding-scopes (p/cast (ptr u32) binding-scopes)
      :binding-name-starts (p/cast (ptr u32) binding-starts)
      :binding-name-ends (p/cast (ptr u32) binding-ends) :binding-count (cast u32 0)
      :reference-bindings (p/cast (ptr u32) reference-bindings)
      :reference-starts (p/cast (ptr u32) reference-starts)
      :reference-ends (p/cast (ptr u32) reference-ends) :reference-count (cast u32 0)
      :capture-scopes (p/cast (ptr u32) capture-scopes)
      :capture-bindings (p/cast (ptr u32) capture-bindings) :capture-count (cast u32 0)))
    (store! scratch-storage (b/BuilderScratch
      :region-block-heads (p/cast (ptr u32) region-heads)
      :region-block-tails (p/cast (ptr u32) region-tails)
      :block-next-in-region (p/cast (ptr u32) block-next)
      :block-op-heads (p/cast (ptr u32) block-heads)
      :block-op-tails (p/cast (ptr u32) block-tails)
      :op-next-in-block (p/cast (ptr u32) op-next)
      :op-region-heads (p/cast (ptr u32) op-region-heads)
      :op-region-tails (p/cast (ptr u32) op-region-tails)
      :region-next-in-op (p/cast (ptr u32) region-next-in-op)))
    (b/initialize-builder! builder arena scratch-storage
      (b/BuilderCapacities :regions (cast u32 2) :region-block-refs (cast u32 2)
        :blocks (cast u32 2) :block-op-refs (cast u32 3)
        :ops (cast u32 3) :op-region-refs (cast u32 1)
        :values (cast u32 1) :operands (cast u32 1)
        :successors (cast u32 1) :successor-args (cast u32 1)
        :scopes (cast u32 2) :bindings (cast u32 1)
        :references (cast u32 1) :captures (cast u32 1)))
    (let [root-region (b/add-region! builder (cast u32 ir/INVALID-ID))]
      (assert-eq (.error root-region) b/BUILD-OK)
      (let [root-block (b/add-block! builder (.id root-region))
            root-scope (b/add-scope! builder (cast u32 ir/INVALID-ID) (cast u32 0)
                                     (cast u32 19))]
        (let [function-op (b/add-op! builder (.id root-block) ir/OP-JS-FUNCTION
                                     (cast u32 0) (cast u32 11)
                                     (cast u32 0) (cast u32 19) (cast u32 1))]
          ;; Descend into the function before the parent block is finished.
          (let [child-region (b/add-region! builder (.id function-op))]
            (let [attached (b/add-op-region! builder (.id function-op) (.id child-region))]
              (assert-eq (.error attached) b/BUILD-OK))
            (let [child-block (b/add-block! builder (.id child-region))
                  child-scope (b/add-scope! builder (.id root-scope) (cast u32 11)
                                            (cast u32 19))]
              (let [child-return (b/add-op! builder (.id child-block) ir/OP-RETURN
                                             (cast u32 0) (cast u32 0)
                                             (cast u32 11) (cast u32 19) (cast u32 0))]
                (assert-eq (.error child-return) b/BUILD-OK))
              (let [binding (b/add-binding! builder (.id root-scope)
                                             (cast u32 0) (cast u32 11))
                    reference (b/add-reference! builder (.id binding)
                                                (cast u32 11) (cast u32 19))
                    capture (b/add-capture! builder (.id child-scope) (.id binding))]
                (assert-eq (.error reference) b/BUILD-OK)
                (assert-eq (.error capture) b/BUILD-OK)))
            ;; Resume the root block. Its physical operation IDs are [0,2],
            ;; while the nested block owns operation 1.
            (let [root-return (b/add-op! builder (.id root-block) ir/OP-RETURN
                                         (cast u32 0) (cast u32 0)
                                         (cast u32 19) (cast u32 19) (cast u32 0))
                  operand (b/add-operand! builder (.id root-return) (cast u32 0))]
              (assert-eq (.error operand) b/BUILD-OK))))))
    (assert-eq (b/finalize-membership! builder) b/BUILD-OK)
    (assert-eq (load (p/index block-ops 0)) (cast u32 0))
    (assert-eq (load (p/index block-ops 1)) (cast u32 2))
    (assert-eq (load (p/index block-ops 2)) (cast u32 1))
    (assert-eq (.scope-count arena) (cast u32 2))
    (assert-eq (.capture-count arena) (cast u32 1))
    (store! verify-scratch (ir/VerifyScratch :dominators (p/cast (ptr u64) dom)
                                             :dominator-word-capacity 4))
    (let [verified (ir/verify-ir arena verify-scratch)]
      (assert-eq (.error verified) ir/VERIFY-OK))
    (let [printed (ir/print-ir! arena (slice-data source) (p/cast (ptr u8) output) 512)
          expected "source_size 19\nregion 0 parent(none) {\n^0():\n  %0 = js.function name(0:11) regions(1) loc(0:19)\n  js.return %0 loc(19:19)\n}\nregion 1 parent(0) {\n^1():\n  js.return loc(11:19)\n}\nscope 0 parent(none) loc(0:19)\nscope 1 parent(0) loc(11:19)\nbinding 0 scope(0) name(0:11)\nreference 0 binding(0) loc(11:19)\ncapture 0 scope(1) binding(0)\n"]
      (assert-eq (.error printed) ir/PRINT-OK)
      (assert (byte-eq? (p/cast (ptr u8) output) expected (.count printed)))
      (let [caps (b/BuilderCapacities
                   :regions (cast u32 4) :region-block-refs (cast u32 8)
                   :blocks (cast u32 8) :block-op-refs (cast u32 16)
                   :ops (cast u32 16) :op-region-refs (cast u32 8)
                   :values (cast u32 16) :operands (cast u32 16)
                   :successors (cast u32 8) :successor-args (cast u32 8)
                   :scopes (cast u32 8) :bindings (cast u32 8)
                   :references (cast u32 8) :captures (cast u32 8))
            initialized (storage/initialize! roundtrip-arena roundtrip-scratch
                          roundtrip-builder (p/cast (ptr u8) roundtrip-memory) 16384
                          (cast u32 0) caps)]
        (assert-eq (.error initialized) storage/STORAGE-OK)
        (let [parsed (ir-text/parse-ir-text! (p/cast (ptr u8) output)
                                             (.count printed) roundtrip-builder)]
          (assert-eq (.error parsed) ir-text/IR-TEXT-OK))
        (store! roundtrip-verify
          (ir/VerifyScratch :dominators (p/cast (ptr u64) roundtrip-dom)
                            :dominator-word-capacity 4))
        (let [verified-roundtrip (ir/verify-ir roundtrip-arena roundtrip-verify)]
          (assert-eq (.error verified-roundtrip) ir/VERIFY-OK))
        (let [printed-roundtrip (ir/print-ir! roundtrip-arena
                                  (p/cast (ptr u8) output)
                                  (p/cast (ptr u8) roundtrip-output) 512)]
          (assert-eq (.error printed-roundtrip) ir/PRINT-OK)
          (assert-eq (.count printed-roundtrip) (.count printed))
          (assert (ptr-byte-eq? (p/cast (ptr u8) output)
                                (p/cast (ptr u8) roundtrip-output)
                                (.count printed))))))
    ;; Finalization is idempotent, but mutation after it is rejected.
    (assert-eq (b/finalize-membership! builder) b/BUILD-OK)
    (let [late-region (b/add-region! builder (cast u32 ir/INVALID-ID))]
      (assert-eq (.error late-region) b/BUILD-ALREADY-FINALIZED)))
  0)

(defn main [] (-> i64)
  (test-interleaved-nested-construction)
  0)
