(module experiments.react-hir-frontend.parser-test)

(import "coil.primitive" :as p)
(import "coil.slice" :use [slice-data])
(import "experiments.react-hir-frontend.frontend" :as frontend)
(import "experiments.react-hir-frontend.pipeline" :as pipeline)
(import "experiments.react-hir-frontend.parser" :as parser)
(import "experiments.react-hir-frontend.frontend-spec" :as spec)

(defn test-generated-precedence [] (-> i64)
  (assert-eq (spec/binary-precedence (cast u8 42)) 60)
  (assert-eq (spec/binary-precedence (cast u8 43)) 50)
  (assert-eq (spec/binary-precedence (cast u8 63)) 0)
  (assert-eq (spec/call-production-terminal 1) (cast u8 44))
  (assert-eq (spec/variable-production-keyword 0) "const")
  0)

(defn test-direct-hir-parse [] (-> i64)
  (let [text "const result = condition ? foo(a + b) : <Component value={x} />;"
        events-storage (p/alloc-stack (array u32 128))
        kinds (p/alloc-stack (array u8 64))
        starts (p/alloc-stack (array u32 64))
        ends (p/alloc-stack (array u32 64))
        aa (p/alloc-stack (array u32 64))
        bb (p/alloc-stack (array u32 64))
        cc (p/alloc-stack (array u32 64))
        edge-nodes (p/alloc-stack (array u32 64))
        edge-next (p/alloc-stack (array u32 64))
        arena-storage (p/alloc-stack parser/HirArena)
        tape-result (pipeline/scan-source-to-packed-tape64
                      (slice-data text) (len text) (cast u32 0)
                      (p/cast (ptr u32) events-storage)
                      (frontend/frontend-initial-state))]
    (store! arena-storage
      (parser/HirArena
        :kinds (p/cast (ptr u8) kinds)
        :starts (p/cast (ptr u32) starts) :ends (p/cast (ptr u32) ends)
        :a (p/cast (ptr u32) aa) :b (p/cast (ptr u32) bb) :c (p/cast (ptr u32) cc)
        :node-capacity 64 :node-count 0
        :edge-nodes (p/cast (ptr u32) edge-nodes)
        :edge-next (p/cast (ptr u32) edge-next)
        :edge-capacity 64 :edge-count 0))
    (let [result (parser/parse-program!
                   (slice-data text) (len text) (p/cast (ptr u32) events-storage)
                   (.count tape-result) arena-storage)]
      (assert-eq (.error result) parser/PARSE-OK)
      (assert-eq (.consumed-events result) (.count tape-result))
      (assert-eq (.node-count result) 15)
      (assert-eq (.edge-count result) 3)
      (assert-eq (load (p/index kinds (cast i64 (.root result))))
                 (cast u8 parser/HIR-PROGRAM))
      (let [declaration (load (p/index edge-nodes 2))
            conditional (load (p/index bb (cast i64 declaration)))]
        (assert-eq (load (p/index kinds (cast i64 declaration)))
                   (cast u8 parser/HIR-VARIABLE))
        (assert-eq (load (p/index kinds (cast i64 conditional)))
                   (cast u8 parser/HIR-CONDITIONAL))
        (let [call (load (p/index bb (cast i64 conditional)))
              jsx (load (p/index cc (cast i64 conditional)))]
          (assert-eq (load (p/index kinds (cast i64 call))) (cast u8 parser/HIR-CALL))
          (assert-eq (load (p/index kinds (cast i64 jsx)))
                     (cast u8 parser/HIR-JSX-ELEMENT))))))
  0)

(defn test_capacity_error_is_reported [] (-> i64)
  (let [text "const x = y;"
        events-storage (p/alloc-stack (array u32 32))
        kinds (p/alloc-stack (array u8 2)) starts (p/alloc-stack (array u32 2))
        ends (p/alloc-stack (array u32 2)) aa (p/alloc-stack (array u32 2))
        bb (p/alloc-stack (array u32 2)) cc (p/alloc-stack (array u32 2))
        edge-nodes (p/alloc-stack (array u32 4)) edge-next (p/alloc-stack (array u32 4))
        arena-storage (p/alloc-stack parser/HirArena)
        tape-result (pipeline/scan-source-to-packed-tape64
          (slice-data text) (len text) (cast u32 0) (p/cast (ptr u32) events-storage)
          (frontend/frontend-initial-state))]
    (store! arena-storage (parser/HirArena
      :kinds (p/cast (ptr u8) kinds) :starts (p/cast (ptr u32) starts)
      :ends (p/cast (ptr u32) ends) :a (p/cast (ptr u32) aa)
      :b (p/cast (ptr u32) bb) :c (p/cast (ptr u32) cc)
      :node-capacity 2 :node-count 0 :edge-nodes (p/cast (ptr u32) edge-nodes)
      :edge-next (p/cast (ptr u32) edge-next) :edge-capacity 4 :edge-count 0))
    (let [result (parser/parse-program! (slice-data text) (len text)
                   (p/cast (ptr u32) events-storage) (.count tape-result) arena-storage)]
      (assert-eq (.error result) parser/PARSE-NODE-CAPACITY)))
  0)

(defn main [] (-> i64)
  (test-generated-precedence)
  (test-direct-hir-parse)
  (test_capacity_error_is_reported)
  0)
