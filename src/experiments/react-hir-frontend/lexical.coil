(module experiments.react-hir-frontend.lexical)

(import "coil.simd" :as v)
(import "coil.primitive" :as p)

;; Modes are scalar because transitions are rare and stateful. Classification
;; remains bitmap-oriented so this can later be replaced by prefix/CLMUL kernels
;; without changing the downstream interface.
(const MODE-CODE i64 0)
(const MODE-SINGLE-QUOTE i64 1)
(const MODE-DOUBLE-QUOTE i64 2)
(const MODE-TEMPLATE i64 3)
(const MODE-LINE-COMMENT i64 4)
(const MODE-BLOCK-COMMENT i64 5)

(defstruct LexicalState
  [(mode i64)
   ;; Meaningful in a quoted/template mode. It carries an odd trailing '\\'.
   (escaped bool)
   ;; Meaningful in block comments and permits `*/` across a chunk boundary.
   (block-star bool)])

(defstruct LexicalChunk
  [(code-bits u64)
   (string-bits u64)
   (comment-bits u64)
   (newline-bits u64)
   (state LexicalState)])

(defn lexical-initial-state [] (-> LexicalState)
  (LexicalState :mode MODE-CODE :escaped false :block-star false))

(defn set-bit [(bits u64) (index i64)] (-> u64)
  (p/ior bits (p/ishl (cast u64 1) (cast u64 index))))

;; `next-byte` is a one-byte overlap. It is consulted only when the last valid
;; byte is `/`, allowing comment openers to be recognized across chunk boundaries
;; without retroactively patching an already-emitted bitmap.
(defn classify-lexical-scalar [N]
  [(bytes (vec u8 N))
   (valid-count i64)
   (next-byte u8)
   (has-next bool)
   (initial LexicalState)] (-> LexicalChunk)
  (let [width (v/vlanes bytes)
        count (cond (< valid-count 0) 0
                    (> valid-count width) width
                    (> valid-count 64) 64
                    :else valid-count)
        (mut mode) (.mode initial)
        (mut escaped) (.escaped initial)
        (mut block-star) (.block-star initial)
        (mut code) (cast u64 0)
        (mut strings) (cast u64 0)
        (mut comments) (cast u64 0)
        (mut newlines) (cast u64 0)
        (mut i) 0]
    (loop
      (if (>= (load i) count) (break)
        (let [index (load i)
              byte (v/vextract bytes index)
              next (if (< (+ index 1) count)
                       (v/vextract bytes (+ index 1))
                       next-byte)
              next-valid (or (< (+ index 1) count) has-next)]
          (if (= byte (cast u8 10))
              (store! newlines (set-bit (load newlines) index))
              0)
          (cond
            (= (load mode) MODE-CODE)
              (cond
                (= byte (cast u8 39))
                  (do (store! strings (set-bit (load strings) index))
                      (store! mode MODE-SINGLE-QUOTE)
                      (store! escaped false))
                (= byte (cast u8 34))
                  (do (store! strings (set-bit (load strings) index))
                      (store! mode MODE-DOUBLE-QUOTE)
                      (store! escaped false))
                (= byte (cast u8 96))
                  (do (store! strings (set-bit (load strings) index))
                      (store! mode MODE-TEMPLATE)
                      (store! escaped false))
                (and (= byte (cast u8 47)) next-valid (= next (cast u8 47)))
                  (do (store! comments (set-bit (load comments) index))
                      (store! mode MODE-LINE-COMMENT))
                (and (= byte (cast u8 47)) next-valid (= next (cast u8 42)))
                  (do (store! comments (set-bit (load comments) index))
                      (store! mode MODE-BLOCK-COMMENT)
                      (store! block-star false))
                :else (store! code (set-bit (load code) index)))
            (= (load mode) MODE-LINE-COMMENT)
              (if (or (= byte (cast u8 10)) (= byte (cast u8 13)))
                  (do (store! code (set-bit (load code) index))
                      (store! mode MODE-CODE))
                  (store! comments (set-bit (load comments) index)))
            (= (load mode) MODE-BLOCK-COMMENT)
              (do
                (store! comments (set-bit (load comments) index))
                (if (and (load block-star) (= byte (cast u8 47)))
                    (do (store! mode MODE-CODE) (store! block-star false))
                    (store! block-star (= byte (cast u8 42)))))
            :else
              (do
                (store! strings (set-bit (load strings) index))
                (if (load escaped)
                    (store! escaped false)
                    (cond (= byte (cast u8 92)) (store! escaped true)
                          (and (= (load mode) MODE-SINGLE-QUOTE)
                               (= byte (cast u8 39)))
                            (store! mode MODE-CODE)
                          (and (= (load mode) MODE-DOUBLE-QUOTE)
                               (= byte (cast u8 34)))
                            (store! mode MODE-CODE)
                          (and (= (load mode) MODE-TEMPLATE)
                               (= byte (cast u8 96)))
                            (store! mode MODE-CODE)
                          :else 0))))
          (set! i (+ (load i) 1)))))
    (LexicalChunk
      :code-bits (load code)
      :string-bits (load strings)
      :comment-bits (load comments)
      :newline-bits (load newlines)
      :state (LexicalState :mode (load mode)
                           :escaped (load escaped)
                           :block-star (load block-star)))))

(defn add-span [(mode i64)
                (span u64)
                (code (mut u64))
                (strings (mut u64))
                (comments (mut u64))] (-> i64)
  (cond (= mode MODE-CODE) (store! code (p/ior (load code) span))
        (or (= mode MODE-SINGLE-QUOTE)
            (= mode MODE-DOUBLE-QUOTE)
            (= mode MODE-TEMPLATE))
          (store! strings (p/ior (load strings) span))
        :else (store! comments (p/ior (load comments) span)))
  0)

(defn bit-set? [(bits u64) (bit u64)] (-> bool)
  (!= (p/iand bits bit) (cast u64 0)))

;; Optimized lexical classification visits only bytes capable of changing state.
;; All ordinary spans are assigned with one bitmap OR. The scalar implementation
;; above remains the executable specification and differential-test oracle.
(defn classify-lexical [N]
  [(bytes (vec u8 N))
   (valid-count i64)
   (next-byte u8)
   (has-next bool)
   (initial LexicalState)] (-> LexicalChunk)
  (let [width (v/vlanes bytes)
        count (cond (< valid-count 0) 0
                    (> valid-count width) width
                    (> valid-count 64) 64
                    :else valid-count)
        valid (v/bits-low count)
        single (p/iand valid (v/mask->bits (v/v= bytes (v/vsplat [u8 N] (cast u8 39)))))
        double (p/iand valid (v/mask->bits (v/v= bytes (v/vsplat [u8 N] (cast u8 34)))))
        backtick (p/iand valid (v/mask->bits (v/v= bytes (v/vsplat [u8 N] (cast u8 96)))))
        slash (p/iand valid (v/mask->bits (v/v= bytes (v/vsplat [u8 N] (cast u8 47)))))
        star (p/iand valid (v/mask->bits (v/v= bytes (v/vsplat [u8 N] (cast u8 42)))))
        backslash (p/iand valid (v/mask->bits (v/v= bytes (v/vsplat [u8 N] (cast u8 92)))))
        lf (p/iand valid (v/mask->bits (v/v= bytes (v/vsplat [u8 N] (cast u8 10)))))
        cr (p/iand valid (v/mask->bits (v/v= bytes (v/vsplat [u8 N] (cast u8 13)))))
        (mut events) (p/ior single
                       (p/ior double
                         (p/ior backtick
                           (p/ior slash
                             (p/ior star (p/ior backslash (p/ior lf cr)))))))
        (mut mode) (.mode initial)
        (mut escaped) (.escaped initial)
        (mut block-star) (.block-star initial)
        (mut code) (cast u64 0)
        (mut strings) (cast u64 0)
        (mut comments) (cast u64 0)
        (mut cursor) 0]
    (loop
      (if (= (load events) (cast u64 0)) (break)
        (let [index (cast i64 (p/ctz (load events)))
              bit (p/ishl (cast u64 1) (cast u64 index))
              span (v/bits-range (load cursor) index)]
          (add-span (load mode) span (mut code) (mut strings) (mut comments))
          ;; Ordinary bytes between special events consume a pending escape and
          ;; break adjacency with a block-comment star.
          (if (> index (load cursor))
              (do
                (if (or (= (load mode) MODE-SINGLE-QUOTE)
                        (= (load mode) MODE-DOUBLE-QUOTE)
                        (= (load mode) MODE-TEMPLATE))
                    (store! escaped false)
                    0)
                (if (= (load mode) MODE-BLOCK-COMMENT)
                    (store! block-star false)
                    0))
              0)
          (cond
            (= (load mode) MODE-CODE)
              (cond
                (bit-set? single bit)
                  (do (store! strings (p/ior (load strings) bit))
                      (store! mode MODE-SINGLE-QUOTE)
                      (store! escaped false))
                (bit-set? double bit)
                  (do (store! strings (p/ior (load strings) bit))
                      (store! mode MODE-DOUBLE-QUOTE)
                      (store! escaped false))
                (bit-set? backtick bit)
                  (do (store! strings (p/ior (load strings) bit))
                      (store! mode MODE-TEMPLATE)
                      (store! escaped false))
                (bit-set? slash bit)
                  (let [at-end (= (+ index 1) count)
                        next-bit (p/ishl bit (cast u64 1))
                        next-slash (if at-end
                                     (and has-next (= next-byte (cast u8 47)))
                                     (bit-set? slash next-bit))
                        next-star (if at-end
                                    (and has-next (= next-byte (cast u8 42)))
                                    (bit-set? star next-bit))]
                    (cond next-slash
                            (do (store! comments (p/ior (load comments) bit))
                                (store! mode MODE-LINE-COMMENT))
                          next-star
                            (do (store! comments (p/ior (load comments) bit))
                                (store! mode MODE-BLOCK-COMMENT)
                                (store! block-star false))
                          :else (store! code (p/ior (load code) bit))))
                :else (store! code (p/ior (load code) bit)))
            (= (load mode) MODE-LINE-COMMENT)
              (if (or (bit-set? lf bit) (bit-set? cr bit))
                  (do (store! code (p/ior (load code) bit))
                      (store! mode MODE-CODE))
                  (store! comments (p/ior (load comments) bit)))
            (= (load mode) MODE-BLOCK-COMMENT)
              (do
                (store! comments (p/ior (load comments) bit))
                (if (and (load block-star) (bit-set? slash bit))
                    (do (store! mode MODE-CODE) (store! block-star false))
                    (store! block-star (bit-set? star bit))))
            :else
              (do
                (store! strings (p/ior (load strings) bit))
                (if (load escaped)
                    (store! escaped false)
                    (cond (bit-set? backslash bit) (store! escaped true)
                          (and (= (load mode) MODE-SINGLE-QUOTE)
                               (bit-set? single bit))
                            (store! mode MODE-CODE)
                          (and (= (load mode) MODE-DOUBLE-QUOTE)
                               (bit-set? double bit))
                            (store! mode MODE-CODE)
                          (and (= (load mode) MODE-TEMPLATE)
                               (bit-set? backtick bit))
                            (store! mode MODE-CODE)
                          :else 0))))
          (store! cursor (+ index 1))
          (store! events (p/iand (load events)
                                 (p/isub (load events) (cast u64 1)))))))
    (let [tail (v/bits-range (load cursor) count)]
      (add-span (load mode) tail (mut code) (mut strings) (mut comments))
      (if (> count (load cursor))
          (do
            (if (or (= (load mode) MODE-SINGLE-QUOTE)
                    (= (load mode) MODE-DOUBLE-QUOTE)
                    (= (load mode) MODE-TEMPLATE))
                (store! escaped false)
                0)
            (if (= (load mode) MODE-BLOCK-COMMENT)
                (store! block-star false)
                0))
          0))
    (LexicalChunk
      :code-bits (load code)
      :string-bits (load strings)
      :comment-bits (load comments)
      :newline-bits lf
      :state (LexicalState :mode (load mode)
                           :escaped (load escaped)
                           :block-star (load block-star)))))
