(module experiments.react-hir-frontend.program)

(import "coil.primitive" :as p)
(import "coil.simd" :as v)
(import "experiments.react-hir-frontend.dsl" :as dsl)

;; Stable target-neutral boundary generated by a classification program.
(defstruct ClassBits
  [(word u64)
   (whitespace u64)
   (operator u64)
   (quote u64)
   (single-quote u64)
   (double-quote u64)
   (slash u64)
   (backtick u64)
   (delimiter u64)
   (jsx-marker u64)])

(defn program-symbol? [(value Code) (name (slice u8))] (-> bool)
  (and (p/code-sym? value) (= (p/code-sym value) name)))

(defn program-form? [(value Code) (name (slice u8))] (-> bool)
  (and (p/code-list? value)
       (> (p/code-count value) 0)
       (program-symbol? (p/code-nth value 0) name)))

(defn program-fail [(at Code) (message (slice u8))] (-> Code)
  (do (p/report at message) at))

(defn program-entry-name [(entry Code)] (-> Code)
  (if (and (p/code-list? entry)
           (= (p/code-count entry) 2)
           (p/code-sym? (p/code-nth entry 0)))
      (p/code-nth entry 0)
      (program-fail entry "classification entry expects (NAME EXPRESSION)")))

(defn program-entry-expr [(entry Code)] (-> Code)
  (if (and (p/code-list? entry) (= (p/code-count entry) 2))
      (p/code-nth entry 1)
      (program-fail entry "classification entry expects (NAME EXPRESSION)")))

(defn program-name-before? [(entries Code) (end i64) (name Code)] (-> bool)
  (let [(mut i) 0 (mut found) false]
    (loop
      (if (or (>= (load i) end) (load found)) (break)
        (do
          (if (p/free-identifier=? (program-entry-name (p/code-nth entries (load i))) name)
              (store! found true)
              0)
          (set! i (+ (load i) 1)))))
    (load found)))

(defn program-index-before [(entries Code) (end i64) (name Code)] (-> i64)
  (let [(mut i) 0 (mut found) -1]
    (loop
      (if (or (>= (load i) end) (>= (load found) 0)) (break)
        (if (p/free-identifier=? (program-entry-name (p/code-nth entries (load i))) name)
            (store! found (load i))
            (set! i (+ (load i) 1)))))
    (load found)))

(defn expr-depends-on?
  [(expr Code) (entries Code) (end i64) (target Code)] (-> bool)
  (cond (p/code-sym? expr)
          (if (p/free-identifier=? expr target) true
            (let [index (program-index-before entries end expr)]
              (if (< index 0) false
                (expr-depends-on? (program-entry-expr (p/code-nth entries index))
                                  entries index target))))
        (p/code-list? expr)
          (let [(mut i) 1 (mut found) false]
            (loop
              (if (or (>= (load i) (p/code-count expr)) (load found)) (break)
                (do (if (expr-depends-on? (p/code-nth expr (load i)) entries end target)
                        (store! found true) 0)
                    (set! i (+ (load i) 1)))))
            (load found))
        :else false))

(defn entry-needed? [(entries Code) (outputs Code) (index i64)] (-> bool)
  (let [target (program-entry-name (p/code-nth entries index))
        (mut i) 0 (mut needed) false]
    (loop
      (if (or (>= (load i) (p/code-count outputs)) (load needed)) (break)
        (let [output (p/code-nth outputs (load i))
              output-index (program-index-before entries (p/code-count entries) output)]
          (if (and (>= output-index 0)
                   (or (p/free-identifier=? output target)
                       (expr-depends-on?
                         (program-entry-expr (p/code-nth entries output-index))
                         entries output-index target)))
              (store! needed true)
              0)
          (set! i (+ (load i) 1)))))
    (load needed)))

(defn valid-output-name? [(name Code)] (-> bool)
  (or (program-symbol? name "word")
      (program-symbol? name "whitespace")
      (program-symbol? name "operator")
      (program-symbol? name "quote")
      (program-symbol? name "single-quote")
      (program-symbol? name "double-quote")
      (program-symbol? name "slash")
      (program-symbol? name "backtick")
      (program-symbol? name "delimiter")
      (program-symbol? name "jsx-marker")))

(defn builtin-class? [(expr Code)] (-> bool)
  (or (program-symbol? expr "ascii-digit")
      (program-symbol? expr "ascii-alpha")
      (program-symbol? expr "ascii-hex-digit")
      (program-symbol? expr "ascii-whitespace")
      (program-symbol? expr "utf8-continuation")))

(defn validate-program-expr [(expr Code) (entries Code) (end i64)] (-> i64)
  (cond (builtin-class? expr) 0
        (p/code-sym? expr)
          (if (program-name-before? entries end expr) 0
            (do (p/report expr "classification reference must name an earlier entry") 0))
        (or (program-form? expr "byte")
            (program-form? expr "range")
            (program-form? expr "one-of")) 0
        (or (program-form? expr "or") (program-form? expr "and"))
          (let [(mut i) 1]
            (loop
              (if (>= (load i) (p/code-count expr)) (break)
                (do (validate-program-expr (p/code-nth expr (load i)) entries end)
                    (set! i (+ (load i) 1)))))
            0)
        (program-form? expr "not")
          (if (= (p/code-count expr) 2)
              (validate-program-expr (p/code-nth expr 1) entries end)
              (do (p/report expr "not expects one operand") 0))
        :else (do (p/report expr "unknown classification-program expression") 0)))

(defn compile-program-fold
  [(expr Code) (entries Code) (end i64) (width Code) (bytes Code) (op Code)] (-> Code)
  (if (< (p/code-count expr) 2) (program-fail expr "boolean class form needs an operand")
    (let [(mut result) (compile-program-expr (p/code-nth expr 1) entries end width bytes)
          (mut i) 2]
      (loop
        (if (>= (load i) (p/code-count expr)) (break)
          (do (store! result `(~op ~(load result)
                                  ~(compile-program-expr (p/code-nth expr (load i))
                                                         entries end width bytes)))
              (set! i (+ (load i) 1)))))
      (load result))))

(defn compile-program-expr
  [(expr Code) (entries Code) (end i64) (width Code) (bytes Code)] (-> Code)
  (cond (or (builtin-class? expr)
            (program-form? expr "byte")
            (program-form? expr "range")
            (program-form? expr "one-of"))
          (dsl/compile-byte-class expr width bytes)
        (p/code-sym? expr) expr
        (program-form? expr "or")
          (compile-program-fold expr entries end width bytes `v/vor)
        (program-form? expr "and")
          (compile-program-fold expr entries end width bytes `v/vand)
        (program-form? expr "not")
          `(v/vnot ~(compile-program-expr (p/code-nth expr 1) entries end width bytes))
        :else (program-fail expr "unknown classification-program expression")))

(defn selected? [(outputs Code) (name (slice u8))] (-> bool)
  (let [(mut i) 0 (mut found) false]
    (loop
      (if (or (>= (load i) (p/code-count outputs)) (load found)) (break)
        (do (if (program-symbol? (p/code-nth outputs (load i)) name)
                (store! found true) 0)
            (set! i (+ (load i) 1)))))
    (load found)))

(defn find-program-name [(entries Code) (name (slice u8))] (-> Code)
  (let [(mut i) 0 (mut found) `false]
    (loop
      (if (>= (load i) (p/code-count entries)) (break)
        (let [entry (p/code-nth entries (load i))]
          (if (program-symbol? (program-entry-name entry) name)
              (do (store! found (program-entry-name entry)) (break))
              (set! i (+ (load i) 1))))))
    (if (program-symbol? (load found) "false")
        (program-fail entries "selected output has no classification entry")
        (load found))))

(defn output-bits
  [(entries Code) (outputs Code) (name (slice u8)) (valid Code) (zero Code)] (-> Code)
  (if (selected? outputs name)
      `(p/iand ~valid (v/mask->bits ~(find-program-name entries name)))
      zero))

;; A whole-program macro: shared entries are emitted once in source order, and
;; output selection happens while generating code rather than at runtime.
(defn def-classification-program
  [(name Code) (params Code) (entries Code) (outputs Code)] (-> Code)
  (if (not (and (p/code-vector? params) (= (p/code-count params) 2)
                (p/code-vector? entries) (p/code-vector? outputs)))
      (program-fail params "def-classification-program expects [WIDTH BYTES], entry vector, output vector")
    (let [width (p/code-nth params 0)
          bytes (p/code-nth params 1)
          bindings (p/code-list-new)
          (mut i) 0]
      (loop
        (if (>= (load i) (p/code-count entries)) (break)
          (let [entry (p/code-nth entries (load i))
                entry-name (program-entry-name entry)
                expr (program-entry-expr entry)]
            (if (program-name-before? entries (load i) entry-name)
                (do (p/report entry-name "duplicate classification entry") 0)
                0)
            (validate-program-expr expr entries (load i))
            (if (entry-needed? entries outputs (load i))
                (do
                  (p/code-list-push! bindings entry-name)
                  (p/code-list-push! bindings
                    (compile-program-expr expr entries (load i) width bytes))
                  0)
                0)
            (set! i (+ (load i) 1)))))
      (let [(mut output-index) 0]
        (loop
          (if (>= (load output-index) (p/code-count outputs)) (break)
            (let [output (p/code-nth outputs (load output-index))]
              (if (not (valid-output-name? output))
                  (do (p/report output "unknown classification output channel") 0)
                  0)
              (if (< (program-index-before entries (p/code-count entries) output) 0)
                  (do (p/report output "classification output has no entry") 0)
                  0)
              (set! output-index (+ (load output-index) 1))))))
      (let [binding-code (p/code-list-done bindings)
            valid (p/fresh-identifier "valid-bits")
            zero `(cast u64 0)]
        `(defn ~name :inline (Always) [~width]
           [(~bytes (vec u8 ~width)) (valid-count i64)] (-> ClassBits)
           (let [~@binding-code
                 ~valid (v/bits-low valid-count)]
             (ClassBits
               :word ~(output-bits entries outputs "word" valid zero)
               :whitespace ~(output-bits entries outputs "whitespace" valid zero)
               :operator ~(output-bits entries outputs "operator" valid zero)
               :quote ~(output-bits entries outputs "quote" valid zero)
               :single-quote ~(output-bits entries outputs "single-quote" valid zero)
               :double-quote ~(output-bits entries outputs "double-quote" valid zero)
               :slash ~(output-bits entries outputs "slash" valid zero)
               :backtick ~(output-bits entries outputs "backtick" valid zero)
               :delimiter ~(output-bits entries outputs "delimiter" valid zero)
               :jsx-marker ~(output-bits entries outputs "jsx-marker" valid zero))))))))
