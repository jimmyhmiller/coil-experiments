(module experiments.react-hir-frontend.parser-generator)

(import "coil.primitive" :as p)
(import "coil.slice" :use [slice-get])
(import "experiments.react-hir-frontend.frontend-spec" :as syntax)
(import "experiments.react-hir-frontend.ir" :as ir)
(import "experiments.react-hir-frontend.tape" :as tape)
(import "experiments.react-hir-frontend.ir-builder" :as builder)

(defn generator-symbol? [(value Code) (name (slice u8))] (-> bool)
  (and (p/code-sym? value) (= (p/code-sym value) name)))

(defn generator-form? [(value Code) (name (slice u8))] (-> bool)
  (and (p/code-list? value) (> (p/code-count value) 0)
       (generator-symbol? (p/code-nth value 0) name)))

(defn generator-fail [(at Code) (message (slice u8))] (-> Code)
  (do (p/report at message) at))

(defn field-value [(production Code) (name (slice u8))] (-> Code)
  (let [(mut i) 2 (mut found) `false (mut present) false]
    (loop
      (if (>= (load i) (p/code-count production)) (break)
        (let [field (p/code-nth production (load i))]
          (if (and (p/code-list? field) (= (p/code-count field) 2)
                   (generator-symbol? (p/code-nth field 0) name))
              (do (store! found (p/code-nth field 1)) (store! present true) (break))
            (set! i (+ (load i) 1))))))
    (if (not (load present))
        (generator-fail production "generated production is missing a required field")
      (load found))))

(defn backend-value [(backend Code) (name (slice u8))] (-> Code)
  (if (not (p/code-vector? backend))
      (generator-fail backend "parser backend must be a vector of (role value) bindings")
    (let [(mut i) 0 (mut found) `false (mut present) false]
      (loop
        (if (>= (load i) (p/code-count backend)) (break)
          (let [binding (p/code-nth backend (load i))]
            (if (and (p/code-list? binding) (= (p/code-count binding) 2)
                     (generator-symbol? (p/code-nth binding 0) name))
                (do (store! found (p/code-nth binding 1)) (store! present true) (break))
              (set! i (+ (load i) 1))))))
      (if (not (load present))
          (generator-fail backend (p/code-str "parser backend is missing role: " name))
        (load found)))))

;; Backend ABI is a vector of `(role value)` bindings. Compilers use named
;; roles so adding a production cannot silently shift every following slot.
;;
;; This compiler owns the repetition, separator, closing-token, scratch-lifetime,
;; and error-control algorithm. The backend supplies only primitive operations.
(defn compile-spread-value [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 5)
                (generator-form? production "spread-value")))
      (generator-fail production "invalid spread-value production")
    (let [state-type (backend-value backend "state-type")
          result-type (backend-value backend "expression-result-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          current-position-code (backend-value backend "current-position")
          advance-count-code (backend-value backend "advance-count")
          parse-expression-code (backend-value backend "parse-expression")
          check-build-code (backend-value backend "check-build")
          width (field-value production "width")
          opcode (field-value production "emit-op")
          state (p/fresh-identifier "state")]
      `(defn ~function-name [(~state (ptr ~state-type))] (-> ~result-type)
         (let [start (~current-position-code ~state)
               _dots (~advance-count-code ~state ~width)
               argument (~parse-expression-code ~state 0)
               arena (.arena (.builder ~state)) value (.value-count arena)
               operation-result (builder/add-op! (.builder ~state) (.block ~state) ~opcode
                                  (cast u32 0) (cast u32 0) start (.end argument)
                                  (cast u32 1))]
           (let [op (~check-build-code ~state operation-result)
                 operand (builder/add-operand! (.builder ~state) op (.value argument))]
             (~check-build-code ~state operand)
             (~result-type :value value :start start :end (.end argument))))))))

(defn compile-regexp-value [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 13)
                (generator-form? production "regexp-value")))
      (generator-fail production "invalid regexp-value production")
    (let [state-type (backend-value backend "state-type")
          result-type (backend-value backend "expression-result-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          current-position-code (backend-value backend "current-position")
          event-position-code (backend-value backend "event-position")
          source-byte-code (backend-value backend "source-byte")
          advance-code (backend-value backend "advance")
          emit-code (backend-value backend "emit-value-op")
          fail-code (backend-value backend "fail")
          expected-error (backend-value backend "expected-error")
          slash (field-value production "slash")
          star (field-value production "comment-star")
          backslash (field-value production "backslash")
          class-open (field-value production "class-open")
          class-close (field-value production "class-close")
          newline-a (field-value production "newline-a")
          newline-b (field-value production "newline-b")
          flags (field-value production "flags")
          incompatible-flags (field-value production "incompatible-flags")
          opcode (field-value production "emit-op")
          state (p/fresh-identifier "state") byte-id (p/fresh-identifier "byte")
          flag-mask-id (p/fresh-identifier "flag-mask")]
      `(defn ~function-name [(~state (ptr ~state-type))] (-> ~result-type)
         (let [start (~current-position-code ~state)
               second (~source-byte-code ~state (+ start (cast u32 1)))]
           (if (or (= second ~slash) (= second ~star))
               (~fail-code ~state ~expected-error)
             (let [(mut at) (+ start (cast u32 1)) (mut escaped) false
                   (mut in-class) false (mut closed) false]
               (loop
                 (if (or (>= (cast i64 (load at)) (.source-size ~state))
                         (load closed)) (break)
                   (let [~byte-id (~source-byte-code ~state (load at))]
                     (cond
                       (or (= ~byte-id ~newline-a) (= ~byte-id ~newline-b)) (break)
                       (load escaped) (store! escaped false)
                       (= ~byte-id ~backslash) (store! escaped true)
                       (and (= ~byte-id ~class-open) (not (load in-class)))
                         (store! in-class true)
                       (and (= ~byte-id ~class-close) (load in-class))
                         (store! in-class false)
                       (and (= ~byte-id ~slash) (not (load in-class)))
                         (store! closed true)
                       :else 0)
                     (set! at (+ (load at) (cast u32 1))))))
               (if (or (not (load closed)) (load escaped) (load in-class))
                   (~fail-code ~state ~expected-error)
                 (let [(mut ~flag-mask-id) (cast u64 0) (mut flags-valid) true
                       (mut scanning) true]
                   (loop
                     (if (or (not (load scanning))
                             (>= (cast i64 (load at)) (.source-size ~state))) (break)
                       (let [~byte-id (~source-byte-code ~state (load at))
                             bit
                               (cond
                                 ~@(let [clauses (p/code-list-new) (mut j) 0]
                                     (loop
                                       (if (>= (load j) (p/code-count flags)) (break)
                                         (let [entry (p/code-nth flags (load j))
                                               text (p/code-str (p/code-nth entry 0))]
                                           (p/code-list-push! clauses
                                             `(= ~byte-id
                                                 (cast u8 ~(cast i64 (slice-get text 0)))))
                                           (p/code-list-push! clauses (p/code-nth entry 1))
                                           (set! j (+ (load j) 1)))))
                                     (p/code-list-done clauses))
                                 :else (cast u64 0))]
                         (if (= bit (cast u64 0))
                             (if (or (and (>= ~byte-id (cast u8 65))
                                          (<= ~byte-id (cast u8 90)))
                                     (and (>= ~byte-id (cast u8 97))
                                          (<= ~byte-id (cast u8 122))))
                                 (do (store! flags-valid false) (store! scanning false) 0)
                               (store! scanning false))
                           (if (!= (p/iand (load ~flag-mask-id) bit) (cast u64 0))
                               (do (store! flags-valid false) (store! scanning false) 0)
                             (do
                               (store! ~flag-mask-id (p/ior (load ~flag-mask-id) bit))
                               (set! at (+ (load at) (cast u32 1)))))))))
                   (if (or (not (load flags-valid))
                           (and (!= (p/iand (load ~flag-mask-id)
                                           ~(p/code-nth incompatible-flags 0)) (cast u64 0))
                                (!= (p/iand (load ~flag-mask-id)
                                           ~(p/code-nth incompatible-flags 1)) (cast u64 0))))
                       (~fail-code ~state ~expected-error)
                     (do
                       (loop
                         (if (or (>= (.event-index ~state) (.event-count ~state))
                                 (>= (~event-position-code
                                       (load (p/index (.events ~state)
                                                      (.event-index ~state))))
                                     (load at))) (break)
                           (~advance-code ~state)))
                       (~emit-code ~state ~opcode start (load at)))))))))))))

(defn compile-separated-value [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-vector? backend)
                (p/code-list? production) (= (p/code-count production) 13)
                (generator-form? production "separated-value")
                (p/code-sym? (p/code-nth production 1))))
      (generator-fail production "invalid separated-value production")
    (let [state-type (backend-value backend "state-type")
          result-type (backend-value backend "expression-result-type")
          current-position-code (backend-value backend "current-position")
          current-byte-code (backend-value backend "current-byte")
          adjacent-byte-code (backend-value backend "adjacent-event-byte")
          advance-code (backend-value backend "advance")
          consume-code (backend-value backend "consume-byte")
          fail-code (backend-value backend "fail")
          push-value-code (backend-value backend "push-scratch-value")
          emit-list-code (backend-value backend "emit-scratch-list-op")
          emit-value-code (backend-value backend "emit-value-op")
          ok-error (backend-value backend "ok-error")
          expected-error (backend-value backend "expected-error")
          function-role (field-value production "function")
          element-form (field-value production "element")
          function-name (backend-value backend (p/code-sym function-role))
          element-role (p/code-nth element-form 0)
          element-parser (backend-value backend (p/code-sym element-role))
          spread-parser (backend-value backend
                          (p/code-sym (field-value production "spread-parser")))
          spread-byte (field-value production "spread-byte")
          allow-elisions (field-value production "allow-elisions")
          elision-op (field-value production "elision-op")
          open (field-value production "open")
          separator (field-value production "separator")
          close (field-value production "close")
          allow-trailing (field-value production "allow-trailing")
          opcode (field-value production "emit-op")
          state (p/fresh-identifier "state")
          ordinary-element-call
            (if (= (p/code-count element-form) 2)
                `(~element-parser ~state ~(p/code-nth element-form 1))
              `(~element-parser ~state))
          spread-element-call
            `(if (and (= (~current-byte-code ~state) ~spread-byte)
                      (= (~adjacent-byte-code ~state 1) ~spread-byte)
                      (= (~adjacent-byte-code ~state 2) ~spread-byte))
                 (~spread-parser ~state) ~ordinary-element-call)
          element-call
            (if (generator-symbol? allow-elisions "true")
                `(if (= (~current-byte-code ~state) ~separator)
                     (let [position (~current-position-code ~state)]
                       (~emit-value-code ~state ~elision-op position position))
                   ~spread-element-call)
              spread-element-call)]
      `(defn ~function-name [(~state (ptr ~state-type))] (-> ~result-type)
         (let [scratch (.scratch ~state) mark (.value-count scratch)
               start (~current-position-code ~state) _open (~advance-code ~state)]
           (if (= (~current-byte-code ~state) ~close) 0
             (loop
               (let [element ~element-call]
                 (~push-value-code ~state (.value element))
                 (if (!= (.error ~state) ~ok-error) (break)
                   (if (= (~current-byte-code ~state) ~separator)
                       (do
                         (~advance-code ~state)
                         (if (and ~(if (generator-symbol? allow-trailing "true") `true `false)
                                  (= (~current-byte-code ~state) ~close))
                             (break) 0))
                     (break))))))
           (let [end-position (~current-position-code ~state)]
             (if (not (~consume-code ~state ~close))
                 (~fail-code ~state ~expected-error)
               (~emit-list-code ~state ~opcode start
                 (+ end-position (cast u32 1)) mark))))))))

(defn compile-numeric-value [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 16)
                (generator-form? production "numeric-value")))
      (generator-fail production "invalid numeric-value production")
    (let [state-type (backend-value backend "state-type")
          result-type (backend-value backend "expression-result-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          digit-function (field-value production "digit-function")
          scan-function (field-value production "scan-function")
          current-position-code (backend-value backend "current-position")
          event-position-code (backend-value backend "event-position")
          source-byte-code (backend-value backend "source-byte")
          advance-code (backend-value backend "advance")
          emit-code (backend-value backend "emit-value-op")
          fail-code (backend-value backend "fail")
          expected-error (backend-value backend "expected-error")
          dot (field-value production "dot") separator (field-value production "separator")
          exponent-lower (field-value production "exponent-lower")
          exponent-upper (field-value production "exponent-upper")
          plus (field-value production "plus") minus (field-value production "minus")
          bigint (field-value production "bigint")
          prefixes (field-value production "prefixes")
          backslash (field-value production "backslash")
          opcode (field-value production "emit-op")
          bigint-opcode (field-value production "bigint-op")
          state (p/fresh-identifier "state") byte-id (p/fresh-identifier "byte")
          prefix-byte-id (p/fresh-identifier "prefix-byte")
          number-at-id (p/fresh-identifier "number-at")
          number-base-id (p/fresh-identifier "number-base")]
      `(do
         (defn ~digit-function :inline (Always) [(~byte-id u8) (base i64)] (-> i64)
           (let [value
                  (cond
                    (and (>= ~byte-id (cast u8 48)) (<= ~byte-id (cast u8 57)))
                      (- (cast i64 ~byte-id) 48)
                    (and (>= ~byte-id (cast u8 65)) (<= ~byte-id (cast u8 70)))
                      (+ (- (cast i64 ~byte-id) 65) 10)
                    (and (>= ~byte-id (cast u8 97)) (<= ~byte-id (cast u8 102)))
                      (+ (- (cast i64 ~byte-id) 97) 10)
                    :else -1)]
             (if (< value base) value -1)))
         (defn ~scan-function :inline (Always)
           [(~state (ptr ~state-type)) (initial u32) (base i64)] (-> u64)
           (let [(mut at) initial (mut count) (cast u32 0) (mut scanning) true
                 (mut used-separator) false]
             (loop
               (if (not (load scanning)) (break)
                 (let [~byte-id (~source-byte-code ~state (load at))
                       digit (~digit-function ~byte-id base)]
                   (if (>= digit 0)
                       (do
                         (set! at (+ (load at) (cast u32 1)))
                         (set! count (+ (load count) (cast u32 1))))
                     (if (and (= ~byte-id ~separator) (> (load count) (cast u32 0))
                              (>= (~digit-function
                                    (~source-byte-code ~state
                                      (+ (load at) (cast u32 1))) base) 0))
                         (do (store! used-separator true)
                             (set! at (+ (load at) (cast u32 1))) 0)
                       (store! scanning false))))))
             (p/ior (cast u64 (load at))
               (p/ior (p/ishl (cast u64 (load count)) (cast u64 32))
                 (if (load used-separator)
                     (p/ishl (cast u64 1) (cast u64 63)) (cast u64 0))))))
         (defn ~function-name [(~state (ptr ~state-type))] (-> ~result-type)
           (let [start (~current-position-code ~state) first (~source-byte-code ~state start)
                 (mut ~number-at-id) start (mut ~number-base-id) 10
                 (mut fraction) false (mut exponent) false (mut is-bigint) false
                 (mut valid) true]
             (if (= first ~dot)
                 (do (store! fraction true) (set! ~number-at-id (+ start (cast u32 1))) 0)
               (if (= first (cast u8 48))
                   (let [~prefix-byte-id (~source-byte-code ~state (+ start (cast u32 1)))]
                     (cond
                       ~@(let [clauses (p/code-list-new) (mut j) 0]
                           (loop
                             (if (>= (load j) (p/code-count prefixes)) (break)
                               (let [entry (p/code-nth prefixes (load j))]
                                 (p/code-list-push! clauses
                                   `(or (= ~prefix-byte-id ~(p/code-nth entry 0))
                                        (= ~prefix-byte-id ~(p/code-nth entry 1))))
                                 (p/code-list-push! clauses
                                   `(do (store! ~number-base-id ~(p/code-nth entry 2))
                                        (set! ~number-at-id
                                          (+ (load ~number-at-id) (cast u32 2))) 0))
                                 (set! j (+ (load j) 1)))))
                           (p/code-list-done clauses))
                       :else 0)) 0))
             (let [integer-scan (~scan-function ~state (load ~number-at-id)
                                  (load ~number-base-id))
                   integer-count (cast u32
                     (p/iand (p/ishr integer-scan (cast u64 32))
                             (cast u64 2147483647)))
                   integer-separated
                     (!= (p/iand integer-scan
                           (p/ishl (cast u64 1) (cast u64 63))) (cast u64 0))]
               (set! ~number-at-id (cast u32 integer-scan))
               (if (and (not (load fraction)) (= integer-count (cast u32 0)))
                   (store! valid false) 0)
               (if (and (= first (cast u8 48)) (= (load ~number-base-id) 10)
                        integer-separated)
                   (store! valid false) 0)
               (if (and (= (load ~number-base-id) 10)
                        (= (~source-byte-code ~state (load ~number-at-id)) ~dot)
                        (not (load fraction)))
                   (do (store! fraction true)
                       (set! ~number-at-id (+ (load ~number-at-id) (cast u32 1))) 0) 0)
               (if (load fraction)
                   (if (= first ~dot)
                       (if (= integer-count (cast u32 0)) (store! valid false) 0)
                     (let [fraction-scan (~scan-function ~state (load ~number-at-id) 10)]
                       (set! ~number-at-id (cast u32 fraction-scan)))) 0)
               (let [exponent-byte (~source-byte-code ~state (load ~number-at-id))]
                 (if (and (= (load ~number-base-id) 10)
                          (or (= exponent-byte ~exponent-lower)
                              (= exponent-byte ~exponent-upper)))
                     (do
                       (store! exponent true)
                       (set! ~number-at-id (+ (load ~number-at-id) (cast u32 1)))
                       (let [sign (~source-byte-code ~state (load ~number-at-id))]
                         (if (or (= sign ~plus) (= sign ~minus))
                             (set! ~number-at-id
                               (+ (load ~number-at-id) (cast u32 1))) 0))
                       (let [exponent-scan (~scan-function ~state (load ~number-at-id) 10)
                             exponent-count
                               (cast u32 (p/ishr exponent-scan (cast u64 32)))]
                         (set! ~number-at-id (cast u32 exponent-scan))
                         (if (= exponent-count (cast u32 0)) (store! valid false) 0))
                       0) 0))
               (if (= (~source-byte-code ~state (load ~number-at-id)) ~bigint)
                   (if (or (load fraction) (load exponent)
                           (and (= first (cast u8 48))
                                (= (load ~number-base-id) 10)
                                (> integer-count (cast u32 1))))
                       (store! valid false)
                     (do (store! is-bigint true)
                         (set! ~number-at-id
                           (+ (load ~number-at-id) (cast u32 1))) 0)) 0)
               (let [following (~source-byte-code ~state (load ~number-at-id))]
                 (if (or (and (>= following (cast u8 48)) (<= following (cast u8 57)))
                         (and (>= following (cast u8 65)) (<= following (cast u8 90)))
                         (and (>= following (cast u8 97)) (<= following (cast u8 122)))
                         (= following (cast u8 95)) (= following (cast u8 36))
                         (= following ~backslash) (>= following (cast u8 128)))
                     (store! valid false) 0))
               (if (not (load valid)) (~fail-code ~state ~expected-error)
                 (do
                   (loop
                     (if (or (>= (.event-index ~state) (.event-count ~state))
                             (>= (~event-position-code
                                   (load (p/index (.events ~state) (.event-index ~state))))
                                 (load ~number-at-id))) (break)
                       (~advance-code ~state)))
                   (~emit-code ~state (if (load is-bigint) ~bigint-opcode ~opcode)
                     start (load ~number-at-id)))))))))))

(defn keyword-dispatch-key [(keyword Code)] (-> i64)
  (let [text (p/code-str keyword)]
    (p/ior (cast i64 (slice-get text 0))
      (p/ior (p/ishl (len text) 8)
             (p/ishl (cast i64 (slice-get text 1)) 16)))))

(defn compile-word-value [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 7)
                (generator-form? production "word-value")))
      (generator-fail production "invalid word-value production")
    (let [state-type (backend-value backend "state-type")
          result-type (backend-value backend "expression-result-type")
          function-name (backend-value backend "parse-word")
          event-kind-code (backend-value backend "event-kind")
          current-event-code (backend-value backend "current-event")
          current-position-code (backend-value backend "current-position")
          word-end-code (backend-value backend "word-end")
          span-equals-code (backend-value backend "span-equals")
          source-byte-code (backend-value backend "source-byte")
          advance-code (backend-value backend "advance")
          fail-code (backend-value backend "fail")
          emit-code (backend-value backend "emit-value-op")
          find-binding-code (backend-value backend "find-binding")
          check-build-code (backend-value backend "check-build")
          ensure-capture-code (backend-value backend "ensure-capture")
          unexpected-error (backend-value backend "unexpected-error")
          word-event (field-value production "event")
          number-parser (backend-value backend
                          (p/code-sym (field-value production "number-parser")))
          identifier-op (field-value production "identifier-op")
          keyword-ops (field-value production "keyword-ops")
          invalid-keywords (field-value production "invalid-keywords")
          state (p/fresh-identifier "state") first-id (p/fresh-identifier "first")
          start-id (p/fresh-identifier "start") end-id (p/fresh-identifier "end")
          reserved-key-id (p/fresh-identifier "reserved-key")]
      `(defn ~function-name [(~state (ptr ~state-type))] (-> ~result-type)
         (if (or (>= (.event-index ~state) (.event-count ~state))
                 (!= (~event-kind-code (~current-event-code ~state))
                     (cast u8 ~word-event)))
             (~fail-code ~state ~unexpected-error)
           (let [~start-id (~current-position-code ~state)
                 ~first-id (~source-byte-code ~state ~start-id)]
             (if (and (>= ~first-id (cast u8 48)) (<= ~first-id (cast u8 57)))
                 (~number-parser ~state)
               (let [~end-id (~word-end-code ~state ~start-id)
                     ~reserved-key-id
                       (p/ior (cast i64 ~first-id)
                         (p/ior (p/ishl (- (cast i64 ~end-id) (cast i64 ~start-id)) 8)
                           (p/ishl (cast i64 (~source-byte-code ~state
                                               (+ ~start-id (cast u32 1)))) 16)))
                     opcode
                      (cond
                        ~@(let [clauses (p/code-list-new) (mut j) 0]
                            (loop
                              (if (>= (load j) (p/code-count keyword-ops)) (break)
                                (let [entry (p/code-nth keyword-ops (load j))]
                                  (if (not (and (p/code-vector? entry)
                                                (= (p/code-count entry) 2)
                                                (p/code-string? (p/code-nth entry 0))))
                                      (do
                                        (generator-fail entry
                                          "word-value keyword entry must be [string opcode]")
                                        0)
                                    (do
                                      (let [keyword-text (p/code-str (p/code-nth entry 0))]
                                        (p/code-list-push! clauses
                                          `(and (= ~first-id
                                                    (cast u8 ~(cast i64
                                                      (slice-get keyword-text 0))))
                                                (~span-equals-code ~state ~start-id ~end-id
                                                  ~(p/code-nth entry 0)))))
                                        (p/code-list-push! clauses (p/code-nth entry 1)) 0))
                                  (set! j (+ (load j) 1)))))
                            (p/code-list-done clauses))
                        :else ~identifier-op)
                     invalid-identifier
                       (and (= opcode ~identifier-op)
                            (or ~@(let [checks (p/code-list-new) (mut j) 0]
                                    (loop
                                      (if (>= (load j) (p/code-count invalid-keywords)) (break)
                                        (let [keyword (p/code-nth invalid-keywords (load j))]
                                          (p/code-list-push! checks
                                            `(and (= ~reserved-key-id
                                                     ~(keyword-dispatch-key keyword))
                                                  (~span-equals-code ~state ~start-id ~end-id
                                                    ~keyword)))
                                          (set! j (+ (load j) 1)))))
                                    (p/code-list-done checks))))]
               (if invalid-identifier (~fail-code ~state ~unexpected-error)
                 (do
                   (~advance-code ~state)
                   (let [result (~emit-code ~state opcode ~start-id ~end-id)]
                     (if (= opcode ~identifier-op)
                         (let [binding (~find-binding-code ~state ~start-id ~end-id)]
                           (if (!= binding (cast u32 ir/INVALID-ID))
                               (let [reference (builder/add-reference! (.builder ~state)
                                                                        binding ~start-id ~end-id)]
                                 (~check-build-code ~state reference)
                                 (~ensure-capture-code ~state binding)) 0)) 0)
                     result)))))))))))

(defn compile-quoted-value [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 3)
                (generator-form? production "quoted-value")))
      (generator-fail production "invalid quoted-value production")
    (let [state-type (backend-value backend "state-type")
          result-type (backend-value backend "expression-result-type")
          function-name (backend-value backend "parse-string")
          current-position-code (backend-value backend "current-position")
          current-byte-code (backend-value backend "current-byte")
          advance-code (backend-value backend "advance")
          fail-code (backend-value backend "fail")
          emit-code (backend-value backend "emit-value-op")
          expected-error (backend-value backend "expected-error")
          opcode (field-value production "emit-op")
          state (p/fresh-identifier "state")]
      `(defn ~function-name [(~state (ptr ~state-type))] (-> ~result-type)
         (let [start (~current-position-code ~state)
               quote (~current-byte-code ~state)
               (mut at) (+ (cast i64 start) 1)
               (mut escaped) false (mut closed) false]
           (loop
             (if (or (>= (load at) (.source-size ~state)) (load closed)) (break)
               (let [byte (load (p/index (.source ~state) (load at)))]
                 (cond (load escaped) (store! escaped false)
                       (= byte (cast u8 92)) (store! escaped true)
                       (= byte quote) (store! closed true)
                       :else 0)
                 (set! at (+ (load at) 1)))))
           (if (not (load closed)) (~fail-code ~state ~expected-error)
             (do
               (loop
                 (if (or (>= (.event-index ~state) (.event-count ~state))
                         (>= (cast i64 (~current-position-code ~state)) (load at)))
                     (break)
                   (~advance-code ~state)))
               (~emit-code ~state ~opcode start (cast u32 (load at))))))))))

;; A static quoted property name is syntax, not a runtime string value. Keep
;; its exact source span without materializing a dead SSA operation.
(defn compile-quoted-span [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 4)
                (generator-form? production "quoted-span")))
      (generator-fail production "invalid quoted-span production")
    (let [state-type (backend-value backend "state-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          current-position-code (backend-value backend "current-position")
          current-byte-code (backend-value backend "current-byte")
          advance-code (backend-value backend "advance")
          fail-code (backend-value backend "fail")
          expected-error (backend-value backend "expected-error")
          backslash (field-value production "backslash")
          state (p/fresh-identifier "state")]
      `(defn ~function-name :inline (Never) [(~state (ptr ~state-type))] (-> u64)
         (let [start (~current-position-code ~state)
               quote (~current-byte-code ~state)
               (mut at) (+ (cast i64 start) 1)
               (mut escaped) false (mut closed) false]
           (loop
             (if (or (>= (load at) (.source-size ~state)) (load closed)) (break)
               (let [byte (load (p/index (.source ~state) (load at)))]
                 (cond (load escaped) (store! escaped false)
                       (= byte (cast u8 ~backslash)) (store! escaped true)
                       (= byte quote) (store! closed true)
                       :else 0)
                 (set! at (+ (load at) 1)))))
           (if (not (load closed))
               (do (~fail-code ~state ~expected-error) (cast u64 0))
             (do
               (loop
                 (if (or (>= (.event-index ~state) (.event-count ~state))
                         (>= (cast i64 (~current-position-code ~state)) (load at)))
                     (break)
                   (~advance-code ~state)))
               (p/ior (cast u64 start)
                      (p/ishl (cast u64 (load at)) (cast u64 32))))))))))

;; TypeScript annotations are erased from runtime SSA but retained as checked,
;; source-backed IR markers. This generated recognizer consumes a complete type
;; span while balancing every delimiter family, so commas and closing tokens in
;; nested tuples, object types, function types, and generic arguments do not
;; terminate the outer annotation.
(defn compile-erased-type-span [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 8)
                (generator-form? production "erased-type-span")))
      (generator-fail production "invalid erased-type-span production")
    (let [state-type (backend-value backend "state-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          current-position-code (backend-value backend "current-position")
          current-byte-code (backend-value backend "current-byte")
          current-event-code (backend-value backend "current-event")
          event-kind-code (backend-value backend "event-kind")
          current-line-break-code (backend-value backend "current-line-break")
          current-keyword-code (backend-value backend "current-keyword")
          advance-code (backend-value backend "advance")
          fail-code (backend-value backend "fail")
          check-build-code (backend-value backend "check-build")
          expected-error (backend-value backend "expected-error")
          prefix (field-value production "prefix")
          word-event (field-value production "word-event")
          line-break-stop (field-value production "line-break-stop")
          continuation-keywords (field-value production "continuation-keywords")
          opcode (field-value production "emit-op")
          state (p/fresh-identifier "state") stop-a (p/fresh-identifier "stop-a")
          stop-b (p/fresh-identifier "stop-b")]
      `(defn ~function-name
         [(~state (ptr ~state-type)) (~stop-a u8) (~stop-b u8)] (-> i64)
         (let [annotation-start (~current-position-code ~state)]
           (if (!= (~current-byte-code ~state) ~prefix)
               (do (~fail-code ~state ~expected-error) 0)
             (do
               (~advance-code ~state)
               (let [type-start (~current-position-code ~state)
                     (mut consumed) false (mut parens) 0 (mut brackets) 0
                     (mut braces) 0 (mut angles) 0]
                 (loop
                   (if (>= (.event-index ~state) (.event-count ~state)) (break)
                     (let [byte (~current-byte-code ~state)
                           top (and (= (load parens) 0) (= (load brackets) 0)
                                    (= (load braces) 0) (= (load angles) 0))]
                       (if (and top (load consumed)
                                (or (= byte ~stop-a) (= byte ~stop-b)
                                    ~(if (generator-symbol? line-break-stop "true")
                                         `(and (~current-line-break-code ~state)
                                               (= (~event-kind-code
                                                    (~current-event-code ~state))
                                                  (cast u8 ~word-event))
                                               (not (or
                                                 ~@(let [checks (p/code-list-new) (mut k) 0]
                                                     (loop
                                                       (if (>= (load k)
                                                               (p/code-count continuation-keywords))
                                                           (break)
                                                         (do
                                                           (p/code-list-push! checks
                                                             `(~current-keyword-code ~state
                                                               ~(p/code-nth continuation-keywords
                                                                  (load k))))
                                                           (set! k (+ (load k) 1)))))
                                                     (p/code-list-done checks)))))
                                       `false))) (break)
                         (do
                           (cond
                             (= byte (cast u8 40)) (set! parens (+ (load parens) 1))
                             (= byte (cast u8 41))
                               (if (> (load parens) 0) (set! parens (- (load parens) 1)) 0)
                             (= byte (cast u8 91)) (set! brackets (+ (load brackets) 1))
                             (= byte (cast u8 93))
                               (if (> (load brackets) 0) (set! brackets (- (load brackets) 1)) 0)
                             (= byte (cast u8 123)) (set! braces (+ (load braces) 1))
                             (= byte (cast u8 125))
                               (if (> (load braces) 0) (set! braces (- (load braces) 1)) 0)
                             (= byte (cast u8 60)) (set! angles (+ (load angles) 1))
                             (= byte (cast u8 62))
                               (if (> (load angles) 0) (set! angles (- (load angles) 1)) 0)
                             :else 0)
                           (store! consumed true)
                           (~advance-code ~state))))))
                 (if (or (not (load consumed)) (!= (load parens) 0)
                         (!= (load brackets) 0) (!= (load braces) 0)
                         (!= (load angles) 0))
                     (do (~fail-code ~state ~expected-error) 0)
                   (let [operation (builder/add-op! (.builder ~state) (.block ~state)
                                      ~opcode type-start (~current-position-code ~state)
                                      annotation-start (~current-position-code ~state)
                                      (cast u32 0))]
                     (~check-build-code ~state operation)))))))
         0))))

(defn compile-erased-type-parameters [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 6)
                (generator-form? production "erased-type-parameters")))
      (generator-fail production "invalid erased-type-parameters production")
    (let [state-type (backend-value backend "state-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          current-position-code (backend-value backend "current-position")
          current-byte-code (backend-value backend "current-byte")
          advance-code (backend-value backend "advance")
          fail-code (backend-value backend "fail")
          check-build-code (backend-value backend "check-build")
          expected-error (backend-value backend "expected-error")
          open (field-value production "open") close (field-value production "close")
          opcode (field-value production "emit-op") state (p/fresh-identifier "state")]
      `(defn ~function-name [(~state (ptr ~state-type))] (-> i64)
         (let [start (~current-position-code ~state)]
           (if (!= (~current-byte-code ~state) ~open)
               (do (~fail-code ~state ~expected-error) 0)
             (do
               (~advance-code ~state)
               (let [(mut depth) 1]
                 (loop
                   (if (or (= (load depth) 0)
                           (>= (.event-index ~state) (.event-count ~state))) (break)
                     (let [byte (~current-byte-code ~state)]
                       (if (= byte ~open) (set! depth (+ (load depth) 1))
                         (if (= byte ~close) (set! depth (- (load depth) 1)) 0))
                       (~advance-code ~state))))
                 (if (!= (load depth) 0)
                     (do (~fail-code ~state ~expected-error) 0)
                   (let [operation (builder/add-op! (.builder ~state) (.block ~state)
                                      ~opcode (+ start (cast u32 1))
                                      (- (~current-position-code ~state) (cast u32 1))
                                      start (~current-position-code ~state) (cast u32 0))]
                     (~check-build-code ~state operation)))))))
         0))))

(defn compile-erased-declaration [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 9)
                (generator-form? production "erased-declaration")))
      (generator-fail production "invalid erased-declaration production")
    (let [state-type (backend-value backend "state-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          current-position-code (backend-value backend "current-position")
          current-byte-code (backend-value backend "current-byte")
          word-end-code (backend-value backend "word-end")
          advance-code (backend-value backend "advance")
          match-byte-code (backend-value backend "match-byte")
          fail-code (backend-value backend "fail")
          check-build-code (backend-value backend "check-build")
          type-parser (backend-value backend
                        (p/code-sym (field-value production "type-parser")))
          type-parameters-parser (backend-value backend
              (p/code-sym (field-value production "type-parameters-parser")))
          expected-error (backend-value backend "expected-error")
          prefix (field-value production "prefix")
          type-parameters-open (field-value production "type-parameters-open")
          terminator (field-value production "terminator")
          opcode (field-value production "emit-op") state (p/fresh-identifier "state")]
      `(defn ~function-name [(~state (ptr ~state-type))] (-> i64)
         (let [start (~current-position-code ~state) _keyword (~advance-code ~state)
               name-start (~current-position-code ~state)
               name-end (~word-end-code ~state name-start)]
           (if (= name-start name-end)
               (do (~fail-code ~state ~expected-error) 0)
             (do
               (~advance-code ~state)
               (if (= (~current-byte-code ~state) ~type-parameters-open)
                   (~type-parameters-parser ~state) 0)
               (let [declaration-result
                       (builder/add-op! (.builder ~state) (.block ~state)
                         ~opcode name-start name-end start start (cast u32 0))
                     declaration (~check-build-code ~state declaration-result)]
                 (~type-parser ~state ~terminator ~terminator)
                 (let [end (~current-position-code ~state)]
                   (if (~match-byte-code ~state ~terminator)
                       (let [updated (builder/set-op-span! (.builder ~state) declaration
                                       start (+ end (cast u32 1)))]
                         (~check-build-code ~state updated)) 0))))))
         0))))

(defn compile-erased-braced-declaration [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 9)
                (generator-form? production "erased-braced-declaration")))
      (generator-fail production "invalid erased braced declaration")
    (let [state-type (backend-value backend "state-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          current-position-code (backend-value backend "current-position")
          current-byte-code (backend-value backend "current-byte")
          current-event-code (backend-value backend "current-event")
          event-kind-code (backend-value backend "event-kind")
          event-position-code (backend-value backend "event-position")
          word-end-code (backend-value backend "word-end")
          advance-code (backend-value backend "advance")
          fail-code (backend-value backend "fail")
          check-build-code (backend-value backend "check-build")
          type-parameters-parser (backend-value backend
              (p/code-sym (field-value production "type-parameters-parser")))
          expected-error (backend-value backend "expected-error")
          type-parameters-open (field-value production "type-parameters-open")
          literal-event (field-value production "literal-event")
          body-open (field-value production "body-open") body-close (field-value production "body-close")
          opcode (field-value production "emit-op") state (p/fresh-identifier "state")]
      `(defn ~function-name [(~state (ptr ~state-type))] (-> i64)
         (let [start (~current-position-code ~state) _keyword (~advance-code ~state)
               name-start (~current-position-code ~state)
               word-name-end (~word-end-code ~state name-start)
               literal-name (= (~event-kind-code (~current-event-code ~state))
                               (cast u8 ~literal-event))
               name-end (if literal-name
                            (+ (~event-position-code (load (p/index (.events ~state)
                                  (+ (.event-index ~state) 1)))) (cast u32 1))
                          word-name-end)]
           (if (and (= name-start word-name-end) (not literal-name))
               (do (~fail-code ~state ~expected-error) 0)
             (do
               (if literal-name (~advance-code ~state) 0)
               (~advance-code ~state)
               (if (= (~current-byte-code ~state) ~type-parameters-open)
                   (do (~type-parameters-parser ~state) 0) 0)
               (loop
                 (if (or (>= (.event-index ~state) (.event-count ~state))
                         (= (~current-byte-code ~state) ~body-open)) (break)
                   (~advance-code ~state)))
               (if (= (~current-byte-code ~state) ~body-open)
                   (do
                     (~advance-code ~state)
                     (let [(mut depth) 1]
                       (loop
                         (if (or (= (load depth) 0)
                                 (>= (.event-index ~state) (.event-count ~state))) (break)
                           (let [byte (~current-byte-code ~state)]
                             (if (= byte ~body-open) (set! depth (+ (load depth) 1))
                               (if (= byte ~body-close) (set! depth (- (load depth) 1)) 0))
                             (~advance-code ~state))))
                       (if (= (load depth) 0)
                           (let [end (~current-position-code ~state)
                                 operation (builder/add-op! (.builder ~state) (.block ~state)
                                              ~opcode name-start name-end start end (cast u32 0))]
                             (~check-build-code ~state operation))
                         (do (~fail-code ~state ~expected-error) 0)))
                     0)
                 (do (~fail-code ~state ~expected-error) 0))))
         0)))))

(defn compile-statement-terminator [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 5)
                (generator-form? production "statement-terminator")))
      (generator-fail production "invalid statement-terminator production")
    (let [state-type (backend-value backend "state-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          current-position-code (backend-value backend "current-position")
          current-byte-code (backend-value backend "current-byte")
          source-byte-code (backend-value backend "source-byte")
          advance-code (backend-value backend "advance")
          fail-code (backend-value backend "fail")
          expected-error (backend-value backend "expected-error")
          explicit (field-value production "explicit")
          close-block (field-value production "close-block")
          state (p/fresh-identifier "state") previous-end (p/fresh-identifier "previous-end")]
      `(defn ~function-name :inline (Always)
         [(~state (ptr ~state-type)) (~previous-end u32)] (-> u32)
         (if (= (~current-byte-code ~state) ~explicit)
             (let [at (~current-position-code ~state)]
               (~advance-code ~state)
               (+ at (cast u32 1)))
           (if (or (>= (.event-index ~state) (.event-count ~state))
                   (= (~current-byte-code ~state) ~close-block))
               ~previous-end
             (let [(mut at) ~previous-end (mut newline) false
                   limit (~current-position-code ~state)]
               (loop
                 (if (or (>= (load at) limit) (load newline)) (break)
                   (let [byte (~source-byte-code ~state (load at))]
                     (if (or (= byte (cast u8 10)) (= byte (cast u8 13)))
                         (store! newline true) 0)
                     (set! at (+ (load at) (cast u32 1))))))
               (if (load newline) ~previous-end
                 (do (~fail-code ~state ~expected-error) ~previous-end)))))))))

(defn compile-import-declaration [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 13)
                (generator-form? production "import-declaration")))
      (generator-fail production "invalid import-declaration production")
    (let [state-type (backend-value backend "state-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          current-position-code (backend-value backend "current-position")
          current-byte-code (backend-value backend "current-byte")
          current-keyword-code (backend-value backend "current-keyword")
          word-end-code (backend-value backend "word-end")
          advance-code (backend-value backend "advance")
          consume-code (backend-value backend "consume-byte")
          fail-code (backend-value backend "fail")
          check-build-code (backend-value backend "check-build")
          parse-string-code (backend-value backend "parse-string")
          terminator-parser (backend-value backend
                              (p/code-sym (field-value production "terminator-parser")))
          ok-error (backend-value backend "ok-error")
          expected-error (backend-value backend "expected-error")
          from-keyword (field-value production "from-keyword")
          as-keyword (field-value production "as-keyword")
          type-keyword (field-value production "type-keyword")
          open (field-value production "open") close (field-value production "close")
          comma (field-value production "separator") star (field-value production "star")
          import-op (field-value production "emit-op")
          specifier-op (field-value production "specifier-op")
          state (p/fresh-identifier "state")]
      `(defn ~function-name [(~state (ptr ~state-type))] (-> i64)
         (let [start (~current-position-code ~state) _import (~advance-code ~state)]
           (if (!= (~current-byte-code ~state) (cast u8 34))
             (if (!= (~current-byte-code ~state) (cast u8 39))
               (do
                 ;; Default import binding.
                 (if (and (!= (~current-byte-code ~state) ~open)
                          (!= (~current-byte-code ~state) ~star))
                     (let [name-start (~current-position-code ~state)
                           name-end (~word-end-code ~state name-start)]
                       (if (= name-start name-end)
                           (do (~fail-code ~state ~expected-error) 0)
                         (do
                           (~advance-code ~state)
                           (let [binding (builder/add-binding! (.builder ~state) (.scope ~state)
                                               name-start name-end)
                                 specifier (builder/add-op! (.builder ~state) (.block ~state)
                                               ~specifier-op name-start name-end
                                               name-start name-end (cast u32 0))]
                             (~check-build-code ~state binding)
                             (~check-build-code ~state specifier))
                           (if (= (~current-byte-code ~state) ~comma)
                               (~advance-code ~state) 0)))) 0)
                 ;; Namespace import: * as local.
                 (if (= (~current-byte-code ~state) ~star)
                     (do
                       (~advance-code ~state)
                       (if (~current-keyword-code ~state ~as-keyword)
                           (~advance-code ~state)
                         (do (~fail-code ~state ~expected-error) 0))
                       (let [name-start (~current-position-code ~state)
                             name-end (~word-end-code ~state name-start)]
                         (if (= name-start name-end)
                           (do (~fail-code ~state ~expected-error) 0)
                           (do
                             (~advance-code ~state)
                             (let [binding (builder/add-binding! (.builder ~state) (.scope ~state)
                                                 name-start name-end)
                                   specifier (builder/add-op! (.builder ~state) (.block ~state)
                                                 ~specifier-op name-start name-end
                                                 name-start name-end (cast u32 0))]
                               (~check-build-code ~state binding)
                               (~check-build-code ~state specifier))))))
                   ;; Named imports, including erased `type` specifiers.
                   (if (= (~current-byte-code ~state) ~open)
                       (do
                         (~advance-code ~state)
                         (loop
                           (if (or (= (~current-byte-code ~state) ~close)
                                   (!= (.error ~state) ~ok-error)) (break)
                             (let [erased (~current-keyword-code ~state ~type-keyword)]
                               (if erased (~advance-code ~state) 0)
                               (let [imported-start (~current-position-code ~state)
                                     imported-end (~word-end-code ~state imported-start)]
                                 (if (= imported-start imported-end)
                                     (do (~fail-code ~state ~expected-error) (break))
                                   (do
                                     (~advance-code ~state)
                                     (let [(mut local-start) imported-start
                                           (mut local-end) imported-end]
                                       (if (~current-keyword-code ~state ~as-keyword)
                                           (do
                                             (~advance-code ~state)
                                             (store! local-start (~current-position-code ~state))
                                             (store! local-end
                                               (~word-end-code ~state (load local-start)))
                                             (if (= (load local-start) (load local-end))
                                                 (do (~fail-code ~state ~expected-error) 0)
                                               (~advance-code ~state))) 0)
                                       (let [specifier (builder/add-op! (.builder ~state)
                                                         (.block ~state) ~specifier-op
                                                         imported-start imported-end
                                                         imported-start (load local-end)
                                                         (cast u32 0))
                                             specifier-id (~check-build-code ~state specifier)
                                             erased-result (builder/set-op-immediate!
                                                               (.builder ~state) specifier-id
                                                               (if erased (cast u64 1)
                                                                 (cast u64 0)))]
                                         (~check-build-code ~state erased-result)
                                         (if (not erased)
                                             (let [binding (builder/add-binding! (.builder ~state)
                                                               (.scope ~state) (load local-start)
                                                               (load local-end))]
                                               (~check-build-code ~state binding)) 0))
                                       (if (= (~current-byte-code ~state) ~comma)
                                           (~advance-code ~state) (break)))))))))
                         (do (~consume-code ~state ~close) 0)) 0))
                 (if (~current-keyword-code ~state ~from-keyword)
                     (~advance-code ~state)
                   (do (~fail-code ~state ~expected-error) 0)))
               0)
             0)
           (if (= (.error ~state) ~ok-error)
               (let [module-value (~parse-string-code ~state)
                     statement-end (~terminator-parser ~state (.end module-value))]
                 (if (= (.error ~state) ~ok-error)
                     (let [operation (builder/add-op! (.builder ~state) (.block ~state)
                                       ~import-op (cast u32 0) (cast u32 0)
                                       start statement-end (cast u32 0))]
                       (let [op (~check-build-code ~state operation)
                             operand (builder/add-operand! (.builder ~state) op
                                       (.value module-value))]
                         (~check-build-code ~state operand))) 0)) 0))
         0))))

(defn compile-terminated-expression [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 10)
                (generator-form? production "terminated-expression")))
      (generator-fail production "invalid terminated-expression production")
    (let [state-type (backend-value backend "state-type")
          function-role (field-value production "function")
          function-name (backend-value backend (p/code-sym function-role))
          current-position-code (backend-value backend "current-position")
          current-byte-code (backend-value backend "current-byte")
          current-line-break-code (backend-value backend "current-line-break")
          advance-code (backend-value backend "advance")
          fail-code (backend-value backend "fail")
          expected-error (backend-value backend "expected-error")
          parse-expression-code (backend-value backend "parse-expression")
          terminator-parser (backend-value backend
                              (p/code-sym (field-value production "terminator-parser")))
          check-build-code (backend-value backend "check-build")
          ok-error (backend-value backend "ok-error")
          prefix (field-value production "prefix")
          terminator (field-value production "terminator")
          opcode (field-value production "emit-op")
          terminate (field-value production "terminate")
          optional (field-value production "optional")
          line-break (field-value production "line-break")
          state (p/fresh-identifier "state")
          start-id (p/fresh-identifier "start")
          value-id (p/fresh-identifier "value")
          end-id (p/fresh-identifier "end-position")
          line-break-id (p/fresh-identifier "has-line-break")
          prefix-action (if (generator-symbol? prefix "true")
                            `(~advance-code ~state) `0)
          operation-start (if (generator-symbol? prefix "true")
                              start-id `(.start ~value-id))
          terminate-action (if (generator-symbol? terminate "true")
                               `(set! (.terminated ~state) true) `0)]
      `(defn ~function-name [(~state (ptr ~state-type))] (-> i64)
         (let [~start-id (~current-position-code ~state)
               _prefix ~prefix-action]
           (let [~line-break-id
                   ~(if (generator-symbol? line-break "ignore") `false
                      `(~current-line-break-code ~state))]
             (if (and ~(if (generator-symbol? line-break "forbid") `true `false)
                      ~line-break-id)
                 (do (~fail-code ~state ~expected-error) 0)
           (if ~(if (generator-symbol? optional "true")
                    `(or (= (~current-byte-code ~state) ~terminator)
                         (and ~(if (generator-symbol? line-break "asi") `true `false)
                              ~line-break-id)) `false)
               (let [statement-end (~terminator-parser ~state ~start-id)]
                 (if (= (.error ~state) ~ok-error)
                     (let [operation (builder/add-op! (.builder ~state) (.block ~state)
                                       ~opcode (cast u32 0) (cast u32 0)
                                       ~start-id statement-end (cast u32 0))]
                       (~check-build-code ~state operation)
                       ~terminate-action) 0))
             (let [~value-id (~parse-expression-code ~state 0)
                   ~end-id (~current-position-code ~state)]
               (let [statement-end (~terminator-parser ~state (.end ~value-id))]
                 (if (= (.error ~state) ~ok-error)
                   (let [operation (builder/add-op! (.builder ~state) (.block ~state)
                                      ~opcode (cast u32 0) (cast u32 0)
                                      ~operation-start statement-end
                                      (cast u32 0))]
                     (let [op (~check-build-code ~state operation)
                           operand (builder/add-operand! (.builder ~state) op (.value ~value-id))]
                       (~check-build-code ~state operand)
                       ~terminate-action)) 0)))))
             ))
         0))))

(defn compile-named-property-emission
  [(state Code) (result-type Code) (check-build-code Code) (opcode Code)
   (name-start Code) (name-end Code) (property-value Code)] (-> Code)
  `(let [arena (.arena (.builder ~state)) value (.value-count arena)
         operation-result
           (builder/add-op! (.builder ~state) (.block ~state) ~opcode
             ~name-start ~name-end ~name-start (.end ~property-value) (cast u32 1))]
     (let [op (~check-build-code ~state operation-result)
           operand (builder/add-operand! (.builder ~state) op (.value ~property-value))]
       (~check-build-code ~state operand)
       (~result-type :value value :start ~name-start :end (.end ~property-value)))))

(defn compile-shorthand-value [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 5)
                (generator-form? production "shorthand-value")))
      (generator-fail production "invalid shorthand-value production")
    (let [state-type (backend-value backend "state-type")
          result-type (backend-value backend "expression-result-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          span-equals-code (backend-value backend "span-equals")
          emit-code (backend-value backend "emit-value-op")
          find-binding-code (backend-value backend "find-binding")
          ensure-capture-code (backend-value backend "ensure-capture")
          check-build-code (backend-value backend "check-build")
          fail-code (backend-value backend "fail")
          expected-error (backend-value backend "expected-error")
          invalid-keywords (field-value production "invalid-keywords")
          identifier-op (field-value production "identifier-op")
          state (p/fresh-identifier "state") start (p/fresh-identifier "start")
          end (p/fresh-identifier "end")]
      `(defn ~function-name :inline (Never)
         [(~state (ptr ~state-type)) (~start u32) (~end u32)] (-> ~result-type)
         (if (or ~@(let [checks (p/code-list-new) (mut j) 0]
                    (loop
                      (if (>= (load j) (p/code-count invalid-keywords)) (break)
                        (do
                          (p/code-list-push! checks
                            `(~span-equals-code ~state ~start ~end
                               ~(p/code-nth invalid-keywords (load j))))
                          (set! j (+ (load j) 1)))))
                    (p/code-list-done checks)))
             (~fail-code ~state ~expected-error)
           (let [result (~emit-code ~state ~identifier-op ~start ~end)
                 binding (~find-binding-code ~state ~start ~end)]
             (if (!= binding (cast u32 ir/INVALID-ID))
                 (let [reference (builder/add-reference! (.builder ~state)
                                   binding ~start ~end)]
                   (~check-build-code ~state reference)
                   (~ensure-capture-code ~state binding)) 0)
             result))))))

(defn compile-named-value [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 9)
                (generator-form? production "named-value")))
      (generator-fail production "invalid named-value production")
    (let [state-type (backend-value backend "state-type")
          result-type (backend-value backend "expression-result-type")
          function-role (field-value production "function")
          function-name (backend-value backend (p/code-sym function-role))
          current-position-code (backend-value backend "current-position")
          current-byte-code (backend-value backend "current-byte")
          word-end-code (backend-value backend "word-end")
          advance-code (backend-value backend "advance")
          fail-code (backend-value backend "fail")
          parse-expression-code (backend-value backend "parse-expression")
          shorthand-parser (backend-value backend
                             (p/code-sym (field-value production "shorthand-parser")))
          quoted-key-parser (backend-value backend
                              (p/code-sym (field-value production "quoted-key-parser")))
          match-byte-code (backend-value backend "match-byte")
          check-build-code (backend-value backend "check-build")
          expected-error (backend-value backend "expected-error")
          separator (field-value production "separator")
          opcode (field-value production "emit-op")
          allow-shorthand (field-value production "allow-shorthand")
          quoted-key-bytes (field-value production "quoted-key-bytes")
          state (p/fresh-identifier "state")
          name-start-id (p/fresh-identifier "name-start")
          name-end-id (p/fresh-identifier "name-end")
          quoted-key-id (p/fresh-identifier "quoted-key")
          quoted-id (p/fresh-identifier "quoted")
          property-id (p/fresh-identifier "property-value")]
      `(defn ~function-name [(~state (ptr ~state-type))] (-> ~result-type)
         (let [~quoted-id
                 (or ~@(let [checks (p/code-list-new) (mut q) 0]
                          (loop
                            (if (>= (load q) (p/code-count quoted-key-bytes)) (break)
                              (do
                                (p/code-list-push! checks
                                  `(= (~current-byte-code ~state)
                                      ~(p/code-nth quoted-key-bytes (load q))))
                                (set! q (+ (load q) 1)))))
                          (p/code-list-done checks)))
               ~quoted-key-id (if ~quoted-id (~quoted-key-parser ~state) (cast u64 0))
               ~name-start-id (if ~quoted-id (cast u32 ~quoted-key-id)
                                (~current-position-code ~state))
               ~name-end-id (if ~quoted-id
                              (cast u32 (p/ishr ~quoted-key-id (cast u64 32)))
                              (~word-end-code ~state ~name-start-id))]
           (if (= ~name-start-id ~name-end-id) (~fail-code ~state ~expected-error)
             (do
               (if ~quoted-id 0 (~advance-code ~state))
               (if (~match-byte-code ~state ~separator)
                   (do
                     (let [~property-id (~parse-expression-code ~state 0)]
                       ~(compile-named-property-emission state result-type check-build-code
                          opcode name-start-id name-end-id property-id)))
                 ~(if (generator-symbol? allow-shorthand "true")
                      `(let [~property-id
                              (~shorthand-parser ~state ~name-start-id ~name-end-id)]
                         ~(compile-named-property-emission state result-type check-build-code
                            opcode name-start-id name-end-id property-id))
                    `(~fail-code ~state ~expected-error))))))))))

(defn compile-postfix-name [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 6)
                (generator-form? production "postfix-name")))
      (generator-fail production "invalid postfix-name production")
    (let [state-type (backend-value backend "state-type")
          result-type (backend-value backend "expression-result-type")
          function-role (field-value production "function")
          function-name (backend-value backend (p/code-sym function-role))
          current-position-code (backend-value backend "current-position")
          source-byte-code (backend-value backend "source-byte")
          word-end-code (backend-value backend "word-end")
          advance-code (backend-value backend "advance")
          fail-code (backend-value backend "fail")
          check-build-code (backend-value backend "check-build")
          expected-error (backend-value backend "expected-error")
          opcode (field-value production "emit-op")
          start-ranges (field-value production "identifier-start-ranges")
          start-bytes (field-value production "identifier-start-bytes")
          state (p/fresh-identifier "state")
          input (p/fresh-identifier "input")
          first-byte-id (p/fresh-identifier "first-byte")
          valid-start-id (p/fresh-identifier "valid-start")]
      `(defn ~function-name [(~state (ptr ~state-type)) (~input ~result-type)]
         (-> ~result-type)
         (let [_prefix (~advance-code ~state)
               name-start (~current-position-code ~state)
               name-end (~word-end-code ~state name-start)
               ~first-byte-id (~source-byte-code ~state name-start)
               ~valid-start-id
                 (or
                   ~@(let [clauses (p/code-list-new) (mut i) 0]
                       (loop
                         (if (>= (load i) (p/code-count start-ranges)) (break)
                           (let [range (p/code-nth start-ranges (load i))]
                             (p/code-list-push! clauses
                               `(and (>= ~first-byte-id ~(p/code-nth range 0))
                                     (<= ~first-byte-id ~(p/code-nth range 1))))
                             (set! i (+ (load i) 1)))))
                       (let [(mut j) 0]
                         (loop
                           (if (>= (load j) (p/code-count start-bytes)) (break)
                             (do
                               (p/code-list-push! clauses
                                 `(= ~first-byte-id ~(p/code-nth start-bytes (load j))))
                               (set! j (+ (load j) 1))))))
                       (p/code-list-done clauses)))]
           (if (or (= name-start name-end) (not ~valid-start-id))
               (~fail-code ~state ~expected-error)
             (do
               (~advance-code ~state)
               (let [arena (.arena (.builder ~state)) value (.value-count arena)
                     operation-result
                       (builder/add-op! (.builder ~state) (.block ~state) ~opcode
                         name-start name-end (.start ~input) name-end (cast u32 1))]
                 (let [op (~check-build-code ~state operation-result)
                       operand (builder/add-operand! (.builder ~state) op (.value ~input))]
                   (~check-build-code ~state operand)
                   (~result-type :value value :start (.start ~input) :end name-end))))))))))

(defn compile-postfix-expression [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 5)
                (generator-form? production "postfix-expression")))
      (generator-fail production "invalid postfix-expression production")
    (let [state-type (backend-value backend "state-type")
          result-type (backend-value backend "expression-result-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          advance-code (backend-value backend "advance")
          consume-code (backend-value backend "consume-byte")
          parse-expression-code (backend-value backend "parse-expression")
          fail-code (backend-value backend "fail")
          check-build-code (backend-value backend "check-build")
          expected-error (backend-value backend "expected-error")
          close (field-value production "close") opcode (field-value production "emit-op")
          state (p/fresh-identifier "state") input (p/fresh-identifier "input")]
      `(defn ~function-name [(~state (ptr ~state-type)) (~input ~result-type)]
         (-> ~result-type)
         (let [_open (~advance-code ~state) property (~parse-expression-code ~state 0)]
           (if (not (~consume-code ~state ~close))
               (~fail-code ~state ~expected-error)
             (let [arena (.arena (.builder ~state)) value (.value-count arena)
                   operation-result
                     (builder/add-op! (.builder ~state) (.block ~state) ~opcode
                       (cast u32 0) (cast u32 0) (.start ~input)
                       (+ (.end property) (cast u32 1)) (cast u32 1))]
               (let [op (~check-build-code ~state operation-result)
                     object-operand (builder/add-operand! (.builder ~state) op (.value ~input))
                     property-operand (builder/add-operand! (.builder ~state) op
                                                            (.value property))]
                 (~check-build-code ~state object-operand)
                 (~check-build-code ~state property-operand)
                 (~result-type :value value :start (.start ~input)
                               :end (+ (.end property) (cast u32 1)))))))))))

(defn compile-postfix-marker [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 4)
                (generator-form? production "postfix-marker")))
      (generator-fail production "invalid postfix-marker production")
    (let [state-type (backend-value backend "state-type")
          result-type (backend-value backend "expression-result-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          current-position-code (backend-value backend "current-position")
          advance-code (backend-value backend "advance")
          check-build-code (backend-value backend "check-build")
          opcode (field-value production "emit-op")
          state (p/fresh-identifier "state") input (p/fresh-identifier "input")]
      `(defn ~function-name [(~state (ptr ~state-type)) (~input ~result-type)]
         (-> ~result-type)
         (let [_marker (~advance-code ~state) end (~current-position-code ~state)
               arena (.arena (.builder ~state)) value (.value-count arena)
               operation (builder/add-op! (.builder ~state) (.block ~state) ~opcode
                            (cast u32 0) (cast u32 0) (.start ~input) end (cast u32 1))]
           (let [op (~check-build-code ~state operation)
                 operand (builder/add-operand! (.builder ~state) op (.value ~input))]
             (~check-build-code ~state operand)
             (~result-type :value value :start (.start ~input) :end end)))))))

(defn compile-postfix-update-lookahead [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 4)
                (generator-form? production "postfix-update-lookahead")))
      (generator-fail production "invalid postfix update lookahead")
    (let [state-type (backend-value backend "state-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          current-byte-code (backend-value backend "current-byte")
          adjacent-byte-code (backend-value backend "adjacent-event-byte")
          current-line-break-code (backend-value backend "current-line-break")
          first-bytes (field-value production "first-bytes")
          state (p/fresh-identifier "state") byte-id (p/fresh-identifier "byte")]
      `(defn ~function-name :inline (Always) [(~state (ptr ~state-type))] (-> bool)
         (let [~byte-id (~current-byte-code ~state)]
           (and (not (~current-line-break-code ~state))
                (= (~adjacent-byte-code ~state 1) ~byte-id)
                (or ~@(let [checks (p/code-list-new) (mut j) 0]
                        (loop
                          (if (>= (load j) (p/code-count first-bytes)) (break)
                            (do
                              (p/code-list-push! checks
                                `(= ~byte-id ~(p/code-nth first-bytes (load j))))
                              (set! j (+ (load j) 1)))))
                        (p/code-list-done checks)))))))))

(defn compile-postfix-update [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 6)
                (generator-form? production "postfix-update")))
      (generator-fail production "invalid postfix update production")
    (let [state-type (backend-value backend "state-type")
          result-type (backend-value backend "expression-result-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          current-byte-code (backend-value backend "current-byte")
          current-position-code (backend-value backend "current-position")
          advance-count-code (backend-value backend "advance-count")
          check-build-code (backend-value backend "check-build")
          fail-code (backend-value backend "fail")
          expected-error (backend-value backend "expected-error")
          target-ops (field-value production "target-ops")
          opcode (field-value production "emit-op")
          postfix-flag (field-value production "postfix-flag")
          state (p/fresh-identifier "state") input (p/fresh-identifier "input")
          target-op-id (p/fresh-identifier "target-op")]
      `(defn ~function-name [(~state (ptr ~state-type)) (~input ~result-type)]
         (-> ~result-type)
         (let [operator (~current-byte-code ~state)
               arena (.arena (.builder ~state))
               definition-kind (load (p/index (.value-def-kinds arena)
                                               (cast i64 (.value ~input))))
               definition-index (load (p/index (.value-def-indices arena)
                                                (cast i64 (.value ~input))))
               ~target-op-id (if (= definition-kind (cast u8 ir/DEF-OP-RESULT))
                                 (load (p/index (.opcodes arena) (cast i64 definition-index)))
                               ir/OP-INVALID)]
           (if (not (or ~@(let [checks (p/code-list-new) (mut j) 0]
                            (loop
                              (if (>= (load j) (p/code-count target-ops)) (break)
                                (do
                                  (p/code-list-push! checks
                                    `(= ~target-op-id ~(p/code-nth target-ops (load j))))
                                  (set! j (+ (load j) 1)))))
                            (p/code-list-done checks))))
               (~fail-code ~state ~expected-error)
             (do
               (~advance-count-code ~state 2)
               (let [end (~current-position-code ~state) value (.value-count arena)
                     operation (builder/add-op! (.builder ~state) (.block ~state) ~opcode
                                  (cast u32 0) (cast u32 0) (.start ~input) end
                                  (cast u32 1))]
                 (let [op (~check-build-code ~state operation)
                       operand (builder/add-operand! (.builder ~state) op (.value ~input))
                       immediate (builder/set-op-immediate! (.builder ~state) op
                                   (p/ior ~postfix-flag
                                     (p/ior (cast u64 operator)
                                       (p/ishl (cast u64 operator) (cast u64 8)))))]
                   (~check-build-code ~state operand)
                   (~check-build-code ~state immediate)
                   (~result-type :value value :start (.start ~input) :end end))))))))))

(defn compile-postfix-separated [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 10)
                (generator-form? production "postfix-separated")))
      (generator-fail production "invalid postfix-separated production")
    (let [state-type (backend-value backend "state-type")
          result-type (backend-value backend "expression-result-type")
          function-role (field-value production "function")
          function-name (backend-value backend (p/code-sym function-role))
          current-position-code (backend-value backend "current-position")
          current-byte-code (backend-value backend "current-byte")
          adjacent-byte-code (backend-value backend "adjacent-event-byte")
          advance-code (backend-value backend "advance")
          consume-code (backend-value backend "consume-byte")
          fail-code (backend-value backend "fail")
          parse-expression-code (backend-value backend "parse-expression")
          push-value-code (backend-value backend "push-scratch-value")
          emit-code (backend-value backend "emit-scratch-call-op")
          ok-error (backend-value backend "ok-error")
          expected-error (backend-value backend "expected-error")
          separator (field-value production "separator")
          close (field-value production "close")
          allow-trailing (field-value production "allow-trailing")
          precedence (field-value production "element-precedence")
          spread-byte (field-value production "spread-byte")
          spread-parser (backend-value backend
                          (p/code-sym (field-value production "spread-parser")))
          opcode (field-value production "emit-op")
          state (p/fresh-identifier "state") input (p/fresh-identifier "input")]
      `(defn ~function-name [(~state (ptr ~state-type)) (~input ~result-type)]
         (-> ~result-type)
         (let [scratch (.scratch ~state) mark (.value-count scratch)
               _open (~advance-code ~state)]
           (if (= (~current-byte-code ~state) ~close) 0
             (loop
               (let [element
                      (if (and (= (~current-byte-code ~state) ~spread-byte)
                               (= (~adjacent-byte-code ~state 1) ~spread-byte)
                               (= (~adjacent-byte-code ~state 2) ~spread-byte))
                          (~spread-parser ~state)
                        (~parse-expression-code ~state ~precedence))]
                 (~push-value-code ~state (.value element))
                 (if (!= (.error ~state) ~ok-error) (break)
                   (if (= (~current-byte-code ~state) ~separator)
                       (do
                         (~advance-code ~state)
                         (if (and ~(if (generator-symbol? allow-trailing "true") `true `false)
                                  (= (~current-byte-code ~state) ~close))
                             (break) 0))
                     (break))))))
           (let [end-position (~current-position-code ~state)]
             (if (not (~consume-code ~state ~close))
                 (~fail-code ~state ~expected-error)
               (~emit-code ~state ~opcode ~input
                 (+ end-position (cast u32 1)) mark))))))))

(defn compile-postfix-type-arguments [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 5)
                (generator-form? production "postfix-type-arguments")))
      (generator-fail production "invalid postfix-type-arguments production")
    (let [state-type (backend-value backend "state-type")
          result-type (backend-value backend "expression-result-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          type-parser (backend-value backend
                        (p/code-sym (field-value production "type-parser")))
          current-position-code (backend-value backend "current-position")
          check-build-code (backend-value backend "check-build")
          opcode (field-value production "emit-op")
          state (p/fresh-identifier "state") input (p/fresh-identifier "input")]
      `(defn ~function-name [(~state (ptr ~state-type)) (~input ~result-type)]
         (-> ~result-type)
         (let [_types (~type-parser ~state)
               end (~current-position-code ~state)
               arena (.arena (.builder ~state)) value (.value-count arena)
               operation-result (builder/add-op! (.builder ~state) (.block ~state)
                                  ~opcode (cast u32 0) (cast u32 0)
                                  (.start ~input) end (cast u32 1))]
           (let [op (~check-build-code ~state operation-result)
                 operand (builder/add-operand! (.builder ~state) op (.value ~input))]
             (~check-build-code ~state operand)
             (~result-type :value value :start (.start ~input) :end end)))))))

(defn compile-postfix-lookahead [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 6)
                (generator-form? production "postfix-lookahead")))
      (generator-fail production "invalid postfix-lookahead production")
    (let [state-type (backend-value backend "state-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          event-position-code (backend-value backend "event-position")
          source-byte-code (backend-value backend "source-byte")
          open (field-value production "open") close (field-value production "close")
          follow (field-value production "follow") state (p/fresh-identifier "state")]
      `(defn ~function-name :inline (Always) [(~state (ptr ~state-type))] (-> bool)
         (let [(mut index) (.event-index ~state) (mut depth) 0 (mut closed) false]
           (loop
             (if (or (>= (load index) (.event-count ~state)) (load closed)) (break)
               (let [event (load (p/index (.events ~state) (load index)))
                     byte (~source-byte-code ~state (~event-position-code event))]
                 (if (= byte ~open) (set! depth (+ (load depth) 1))
                   (if (= byte ~close)
                       (do
                         (set! depth (- (load depth) 1))
                         (if (= (load depth) 0) (store! closed true) 0)) 0))
                 (set! index (+ (load index) 1)))))
           (if (and (load closed) (< (load index) (.event-count ~state)))
               (let [event (load (p/index (.events ~state) (load index)))]
                 (= (~source-byte-code ~state (~event-position-code event)) ~follow))
             false))))))

(defn compile-arrow-lookahead [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 11)
                (generator-form? production "arrow-lookahead")))
      (generator-fail production "invalid arrow-lookahead production")
    (let [state-type (backend-value backend "state-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          event-position-code (backend-value backend "event-position")
          event-kind-code (backend-value backend "event-kind")
          current-event-code (backend-value backend "current-event")
          source-byte-code (backend-value backend "source-byte")
          word-event (field-value production "word-event")
          open (field-value production "open") close (field-value production "close")
          generic-open (field-value production "generic-open")
          generic-close (field-value production "generic-close")
          colon (field-value production "type-prefix")
          equals (field-value production "equals") greater (field-value production "greater")
          state (p/fresh-identifier "state")]
      `(defn ~function-name :inline (Always) [(~state (ptr ~state-type))] (-> bool)
         (if (>= (.event-index ~state) (.event-count ~state)) false
           (let [first-event (~current-event-code ~state)
                 first-byte (~source-byte-code ~state (~event-position-code first-event))
                 first-word (= (~event-kind-code first-event) (cast u8 ~word-event))
                 valid-start (or first-word (= first-byte ~open)
                                 (= first-byte ~generic-open))
                 (mut index) (.event-index ~state) (mut candidate) false]
             (if (not valid-start) false
               (do
                 (if (= first-byte ~generic-open)
                     (let [(mut depth) 0 (mut closed) false]
                       (loop
                         (if (or (>= (load index) (.event-count ~state))
                                 (load closed)) (break)
                           (let [event (load (p/index (.events ~state) (load index)))
                                 byte (~source-byte-code ~state (~event-position-code event))]
                             (if (= byte ~generic-open) (set! depth (+ (load depth) 1))
                               (if (= byte ~generic-close)
                                   (do (set! depth (- (load depth) 1))
                                       (if (= (load depth) 0) (store! closed true) 0)) 0))
                             (set! index (+ (load index) 1)))))) 0)
                 (if first-word (set! index (+ (load index) 1)) 0)
                 (if (and (< (load index) (.event-count ~state))
                          (= (~source-byte-code ~state
                               (~event-position-code
                                 (load (p/index (.events ~state) (load index))))) ~open))
                     (let [(mut depth) 0 (mut closed) false]
                       (loop
                         (if (or (>= (load index) (.event-count ~state))
                                 (load closed)) (break)
                           (let [event (load (p/index (.events ~state) (load index)))
                                 byte (~source-byte-code ~state (~event-position-code event))]
                             (if (= byte ~open) (set! depth (+ (load depth) 1))
                               (if (= byte ~close)
                                   (do (set! depth (- (load depth) 1))
                                       (if (= (load depth) 0) (store! closed true) 0)) 0))
                             (set! index (+ (load index) 1)))))) 0)
                 (if (< (+ (load index) 1) (.event-count ~state))
                     (let [left (load (p/index (.events ~state) (load index)))
                           right (load (p/index (.events ~state) (+ (load index) 1)))
                           left-byte (~source-byte-code ~state (~event-position-code left))]
                       (if (and (= left-byte ~equals)
                                (= (~source-byte-code ~state (~event-position-code right))
                                   ~greater))
                           true
                         (if (= left-byte ~colon)
                             (do
                               (set! index (+ (load index) 1))
                               (loop
                                 (if (>= (+ (load index) 1) (.event-count ~state)) (break)
                                   (let [type-left
                                           (load (p/index (.events ~state) (load index)))
                                         type-right
                                           (load (p/index (.events ~state)
                                                   (+ (load index) 1)))]
                                     (if (and
                                           (= (~source-byte-code ~state
                                                (~event-position-code type-left)) ~equals)
                                           (= (~source-byte-code ~state
                                                (~event-position-code type-right)) ~greater))
                                         (do (store! candidate true) (break))
                                       (set! index (+ (load index) 1))))))
                               (load candidate))
                           false)))
                   false)))))))))

(defn compile-binding-pattern [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 16)
                (generator-form? production "binding-pattern")))
      (generator-fail production "invalid binding-pattern production")
    (let [state-type (backend-value backend "state-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          current-position-code (backend-value backend "current-position")
          current-byte-code (backend-value backend "current-byte")
          adjacent-byte-code (backend-value backend "adjacent-event-byte")
          word-end-code (backend-value backend "word-end")
          span-equals-code (backend-value backend "span-equals")
          source-byte-code (backend-value backend "source-byte")
          advance-code (backend-value backend "advance")
          advance-count-code (backend-value backend "advance-count")
          consume-code (backend-value backend "consume-byte")
          fail-code (backend-value backend "fail")
          check-build-code (backend-value backend "check-build")
          parse-expression-code (backend-value backend "parse-expression")
          parse-type-code (backend-value backend
                            (p/code-sym (field-value production "type-parser")))
          expected-error (backend-value backend "expected-error")
          object-open (field-value production "object-open")
          object-close (field-value production "object-close")
          array-open (field-value production "array-open")
          array-close (field-value production "array-close")
          comma (field-value production "separator") colon (field-value production "colon")
          equals (field-value production "equals") question (field-value production "optional")
          greater (field-value production "greater")
          dot (field-value production "rest-byte")
          parameter-close (field-value production "parameter-close")
          invalid-keywords (field-value production "invalid-keywords")
          state (p/fresh-identifier "state")
          binding-start-id (p/fresh-identifier "binding-start")
          binding-end-id (p/fresh-identifier "binding-end")
          binding-key-id (p/fresh-identifier "binding-key")
          property-start-id (p/fresh-identifier "property-start")
          property-end-id (p/fresh-identifier "property-end")
          property-key-id (p/fresh-identifier "property-key")
          property-invalid-id (p/fresh-identifier "property-invalid")]
      `(defn ~function-name
         [(~state (ptr ~state-type)) (allow-default bool) (pattern-stop-a u8) (pattern-stop-b u8)]
         (-> i64)
         (if (and (= (~current-byte-code ~state) ~dot)
                  (= (~adjacent-byte-code ~state 1) ~dot)
                  (= (~adjacent-byte-code ~state 2) ~dot))
             (do (~advance-count-code ~state 3) 0) 0)
         (let [~binding-start-id (~current-position-code ~state)
               ~binding-end-id (~word-end-code ~state ~binding-start-id)
               ~binding-key-id
                 (p/ior (cast i64 (~source-byte-code ~state ~binding-start-id))
                   (p/ior
                     (p/ishl (- (cast i64 ~binding-end-id)
                                (cast i64 ~binding-start-id)) 8)
                     (p/ishl (cast i64 (~source-byte-code ~state
                                         (+ ~binding-start-id (cast u32 1)))) 16)))]
           (if (and (!= ~binding-start-id ~binding-end-id)
                    (not (or ~@(let [checks (p/code-list-new) (mut j) 0]
                                (loop
                                  (if (>= (load j) (p/code-count invalid-keywords)) (break)
                                    (let [keyword (p/code-nth invalid-keywords (load j))]
                                      (p/code-list-push! checks
                                        `(and (= ~binding-key-id
                                                 ~(keyword-dispatch-key keyword))
                                              (~span-equals-code ~state ~binding-start-id
                                                ~binding-end-id ~keyword)))
                                      (set! j (+ (load j) 1)))))
                                (p/code-list-done checks)))))
               (do
                 (~advance-code ~state)
                 (let [binding (builder/add-binding! (.builder ~state) (.scope ~state)
                                                     ~binding-start-id ~binding-end-id)]
                   (~check-build-code ~state binding))
                 (if (= (~current-byte-code ~state) ~question)
                     (do (~advance-code ~state) 0) 0)
                 (if (= (~current-byte-code ~state) ~colon)
                     (do (~parse-type-code ~state pattern-stop-a pattern-stop-b) 0) 0)
                 (if (and allow-default (= (~current-byte-code ~state) ~equals)
                          (!= (~adjacent-byte-code ~state 1) ~greater))
                     (do (~advance-code ~state) (~parse-expression-code ~state 0) 0) 0))
             (if (= (~current-byte-code ~state) ~object-open)
                 (do
                   (~advance-code ~state)
                   (loop
                     (if (= (~current-byte-code ~state) ~object-close) (break)
                       (do
                        (if (and (= (~current-byte-code ~state) ~dot)
                                 (= (~adjacent-byte-code ~state 1) ~dot)
                                 (= (~adjacent-byte-code ~state 2) ~dot))
                             (do (~advance-count-code ~state 3) 0) 0)
                         (let [~property-start-id (~current-position-code ~state)
                               ~property-end-id (~word-end-code ~state ~property-start-id)
                               ~property-key-id
                                 (p/ior (cast i64 (~source-byte-code ~state ~property-start-id))
                                   (p/ior
                                     (p/ishl (- (cast i64 ~property-end-id)
                                                (cast i64 ~property-start-id)) 8)
                                     (p/ishl (cast i64 (~source-byte-code ~state
                                               (+ ~property-start-id (cast u32 1)))) 16)))
                               ~property-invalid-id
                                 (or ~@(let [checks (p/code-list-new) (mut j) 0]
                                          (loop
                                            (if (>= (load j)
                                                    (p/code-count invalid-keywords)) (break)
                                              (let [keyword
                                                      (p/code-nth invalid-keywords (load j))]
                                                (p/code-list-push! checks
                                                  `(and (= ~property-key-id
                                                           ~(keyword-dispatch-key keyword))
                                                        (~span-equals-code ~state
                                                          ~property-start-id ~property-end-id
                                                          ~keyword)))
                                                (set! j (+ (load j) 1)))))
                                          (p/code-list-done checks)))]
                           (if (= ~property-start-id ~property-end-id)
                               (do (~fail-code ~state ~expected-error) (break) 0)
                             (do
                               (~advance-code ~state)
                               (if (= (~current-byte-code ~state) ~colon)
                                   (do (~advance-code ~state)
                                       (~function-name ~state true ~comma ~object-close) 0)
                                 (if ~property-invalid-id
                                     (do (~fail-code ~state ~expected-error) 0)
                                   (do
                                     (let [binding (builder/add-binding! (.builder ~state)
                                                       (.scope ~state) ~property-start-id
                                                       ~property-end-id)]
                                       (~check-build-code ~state binding))
                                     0)))
                               (if (= (~current-byte-code ~state) ~equals)
                                   (do (~advance-code ~state)
                                       (~parse-expression-code ~state 0) 0) 0))))
                        (if (= (~current-byte-code ~state) ~comma)
                             (do (~advance-code ~state) 0) (break)))))
                   (~consume-code ~state ~object-close)
                   (if (= (~current-byte-code ~state) ~question)
                       (do (~advance-code ~state) 0) 0)
                   (if (= (~current-byte-code ~state) ~colon)
                       (do (~parse-type-code ~state pattern-stop-a pattern-stop-b) 0) 0)
                   (if (and allow-default (= (~current-byte-code ~state) ~equals)
                            (!= (~adjacent-byte-code ~state 1) ~greater))
                       (do (~advance-code ~state) (~parse-expression-code ~state 0) 0) 0)
                   0)
               (if (= (~current-byte-code ~state) ~array-open)
                   (do
                     (~advance-code ~state)
                     (loop
                       (if (= (~current-byte-code ~state) ~array-close) (break)
                       (if (= (~current-byte-code ~state) ~comma)
                             (do (~advance-code ~state) 0)
                           (do
                             (if (and (= (~current-byte-code ~state) ~dot)
                                      (= (~adjacent-byte-code ~state 1) ~dot)
                                      (= (~adjacent-byte-code ~state 2) ~dot))
                                 (do (~advance-count-code ~state 3) 0) 0)
                             (~function-name ~state true ~comma ~array-close)
                             (if (= (~current-byte-code ~state) ~comma)
                                 (do (~advance-code ~state) 0) (break))))))
                     (~consume-code ~state ~array-close)
                     (if (= (~current-byte-code ~state) ~question)
                         (do (~advance-code ~state) 0) 0)
                     (if (= (~current-byte-code ~state) ~colon)
                         (do (~parse-type-code ~state pattern-stop-a pattern-stop-b) 0) 0)
                     (if (and allow-default (= (~current-byte-code ~state) ~equals)
                              (!= (~adjacent-byte-code ~state 1) ~greater))
                         (do (~advance-code ~state) (~parse-expression-code ~state 0) 0) 0)
                     0)
                 (do (~fail-code ~state ~expected-error) 0)))))
         0))))

(defn compile-arrow-expression [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 16)
                (generator-form? production "arrow-expression")))
      (generator-fail production "invalid arrow-expression production")
    (let [state-type (backend-value backend "state-type")
          result-type (backend-value backend "expression-result-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          pattern-parser (backend-value backend
                           (p/code-sym (field-value production "pattern-parser")))
          type-parser (backend-value backend
                        (p/code-sym (field-value production "type-parser")))
          type-parameters-parser (backend-value backend
                                   (p/code-sym
                                     (field-value production "type-parameters-parser")))
          parse-block-code (backend-value backend "parse-block")
          parse-expression-code (backend-value backend "parse-expression")
          current-position-code (backend-value backend "current-position")
          current-byte-code (backend-value backend "current-byte")
          event-position-code (backend-value backend "event-position")
          advance-code (backend-value backend "advance")
          consume-code (backend-value backend "consume-byte")
          fail-code (backend-value backend "fail")
          check-build-code (backend-value backend "check-build")
          ok-error (backend-value backend "ok-error")
          expected-error (backend-value backend "expected-error")
          open (field-value production "open") close (field-value production "close")
          comma (field-value production "separator")
          type-prefix (field-value production "type-prefix")
          generic-open (field-value production "generic-open")
          equals (field-value production "equals") greater (field-value production "greater")
          body-open (field-value production "body-open") arrow-op (field-value production "emit-op")
          return-op (field-value production "return-op") state (p/fresh-identifier "state")]
      `(defn ~function-name [(~state (ptr ~state-type))] (-> ~result-type)
         (let [start (~current-position-code ~state) parent-block (.block ~state)
               parent-scope (.scope ~state) parent-function-scope (.function-scope ~state)
               parent-terminated (.terminated ~state)
               (mut logical-end) start
               arena (.arena (.builder ~state)) value (.value-count arena)
               arrow-result (builder/add-op! (.builder ~state) parent-block ~arrow-op
                              (cast u32 0) (cast u32 0) start start (cast u32 1))
               arrow (~check-build-code ~state arrow-result)
               region-result (builder/add-region! (.builder ~state) arrow)
               region (~check-build-code ~state region-result)
               attached (builder/add-op-region! (.builder ~state) arrow region)
               entry-result (builder/add-block! (.builder ~state) region)
               entry (~check-build-code ~state entry-result)
               scope-result (builder/add-scope! (.builder ~state) parent-scope start
                              (cast u32 (.source-size ~state)))
               function-scope (~check-build-code ~state scope-result)]
           (~check-build-code ~state attached)
           (set! (.block ~state) entry)
           (set! (.scope ~state) function-scope)
           (set! (.function-scope ~state) function-scope)
           (set! (.terminated ~state) false)
           (if (= (~current-byte-code ~state) ~generic-open)
               (~type-parameters-parser ~state) 0)
           (if (= (~current-byte-code ~state) ~open)
               (do
                 (~advance-code ~state)
                 (if (= (~current-byte-code ~state) ~close) 0
                   (loop
                     (~pattern-parser ~state true ~comma ~close)
                     (if (= (~current-byte-code ~state) ~comma)
                         (do (~advance-code ~state) 0) (break))))
                 (do (~consume-code ~state ~close) 0))
             (do (~pattern-parser ~state true ~comma ~close) 0))
           (if (= (~current-byte-code ~state) ~type-prefix)
               (~type-parser ~state ~equals ~equals) 0)
           (if (~consume-code ~state ~equals)
               (do (~consume-code ~state ~greater) 0) 0)
           (if (= (.error ~state) ~ok-error)
               (if (= (~current-byte-code ~state) ~body-open)
                 (do
                     (~parse-block-code ~state)
                     (if (> (.event-index ~state) 0)
                         (let [closed-event (load (p/index (.events ~state)
                                                   (- (.event-index ~state) 1)))]
                           (store! logical-end
                             (+ (~event-position-code closed-event) (cast u32 1)))) 0)
                     (if (and (= (.error ~state) ~ok-error) (not (.terminated ~state)))
                         (let [end (~current-position-code ~state)
                               implicit (builder/add-op! (.builder ~state) (.block ~state)
                                          ~return-op (cast u32 0) (cast u32 0)
                                          end end (cast u32 0))]
                           (~check-build-code ~state implicit)) 0)
                     0)
                 (do
                   (let [body (~parse-expression-code ~state 0)
                         returned (builder/add-op! (.builder ~state) (.block ~state)
                                    ~return-op (cast u32 0) (cast u32 0)
                                    (.start body) (.end body) (cast u32 0))]
                     (let [return-id (~check-build-code ~state returned)
                           operand (builder/add-operand! (.builder ~state) return-id (.value body))]
                       (~check-build-code ~state operand)
                       (set! (.terminated ~state) true)
                       (store! logical-end (.end body))))
                   0)) 0)
           (let [end (load logical-end)
                 scope-end (builder/set-scope-end! (.builder ~state) function-scope end)
                 arrow-end (builder/set-op-span! (.builder ~state) arrow start end)]
             (~check-build-code ~state scope-end)
             (~check-build-code ~state arrow-end)
             (set! (.block ~state) parent-block)
             (set! (.scope ~state) parent-scope)
             (set! (.function-scope ~state) parent-function-scope)
             (set! (.terminated ~state) parent-terminated)
             (~result-type :value value :start start :end end)))))))

(defn compile-jsx-element [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 13)
                (generator-form? production "jsx-element")))
      (generator-fail production "invalid jsx-element production")
    (let [state-type (backend-value backend "state-type")
          result-type (backend-value backend "expression-result-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          parse-expression-code (backend-value backend "parse-expression")
          parse-string-code (backend-value backend "parse-string")
          current-position-code (backend-value backend "current-position")
          current-byte-code (backend-value backend "current-byte")
          adjacent-byte-code (backend-value backend "adjacent-event-byte")
          word-end-code (backend-value backend "word-end")
          advance-code (backend-value backend "advance")
          advance-count-code (backend-value backend "advance-count")
          consume-code (backend-value backend "consume-byte")
          fail-code (backend-value backend "fail")
          spans-equal-code (backend-value backend "spans-equal")
          push-value-code (backend-value backend "push-scratch-value")
          emit-list-code (backend-value backend "emit-scratch-list-op")
          ok-error (backend-value backend "ok-error")
          expected-error (backend-value backend "expected-error")
          open (field-value production "open") close (field-value production "close")
          slash (field-value production "slash") dot (field-value production "dot")
          dash (field-value production "dash")
          expression-open (field-value production "expression-open")
          expression-close (field-value production "expression-close")
          equals (field-value production "equals")
          string-event (field-value production "string-event")
          event-kind-code (backend-value backend "event-kind")
          current-event-code (backend-value backend "current-event")
          opcode (field-value production "emit-op") state (p/fresh-identifier "state")]
      `(defn ~function-name [(~state (ptr ~state-type))] (-> ~result-type)
         (let [scratch (.scratch ~state) mark (.value-count scratch)
               start (~current-position-code ~state) _open (~advance-code ~state)
               (mut fragment) false (mut tag-start) (cast u32 0)
               (mut tag-end) (cast u32 0)]
           (if (= (~current-byte-code ~state) ~close)
               (store! fragment true)
             (let [name-start (~current-position-code ~state)
                   name-end (~word-end-code ~state name-start)]
               (if (= name-start name-end) (do (~fail-code ~state ~expected-error) 0)
                 (do
                   (store! tag-start name-start)
                   (store! tag-end name-end)
                   (~advance-code ~state)
                   (loop
                     (if (!= (~current-byte-code ~state) ~dot) (break)
                       (do
                         (~advance-code ~state)
                         (let [part-start (~current-position-code ~state)
                               part-end (~word-end-code ~state part-start)]
                           (if (= part-start part-end)
                               (do (~fail-code ~state ~expected-error) (break) 0)
                             (do (store! tag-end part-end) (~advance-code ~state) 0))))))))))
           (loop
             (if (or (!= (.error ~state) ~ok-error)
                     (= (~current-byte-code ~state) ~close)
                     (= (~current-byte-code ~state) ~slash)) (break)
               (if (= (~current-byte-code ~state) ~expression-open)
                   (do
                     (~advance-code ~state)
                     (if (and (= (~current-byte-code ~state) ~dot)
                              (= (~adjacent-byte-code ~state 1) ~dot)
                              (= (~adjacent-byte-code ~state 2) ~dot))
                         (~advance-count-code ~state 3) 0)
                     (let [value (~parse-expression-code ~state 0)]
                       (~push-value-code ~state (.value value)))
                     (do (~consume-code ~state ~expression-close) 0))
                 (let [attribute-start (~current-position-code ~state)
                       attribute-end (~word-end-code ~state attribute-start)]
                   (if (= attribute-start attribute-end)
                       (do (~fail-code ~state ~expected-error) (break) 0)
                     (do
                       (~advance-code ~state)
                       (loop
                         (if (!= (~current-byte-code ~state) ~dash) (break)
                           (do
                             (~advance-code ~state)
                             (let [part-start (~current-position-code ~state)]
                               (if (= part-start (~word-end-code ~state part-start))
                                   (do (~fail-code ~state ~expected-error) (break) 0)
                                 (~advance-code ~state))))))
                       (if (= (~current-byte-code ~state) ~equals)
                           (do
                             (~advance-code ~state)
                             (if (= (~current-byte-code ~state) ~expression-open)
                                 (do
                                   (~advance-code ~state)
                                   (let [value (~parse-expression-code ~state 0)]
                                     (~push-value-code ~state (.value value)))
                                   (do (~consume-code ~state ~expression-close) 0))
                               (if (= (~event-kind-code (~current-event-code ~state))
                                      (cast u8 ~string-event))
                                   (let [value (~parse-string-code ~state)]
                                     (~push-value-code ~state (.value value)))
                                 (do (~fail-code ~state ~expected-error) 0)))
                             0) 0)))))))
           (if (= (~current-byte-code ~state) ~slash)
               (do
                 (~advance-code ~state)
                 (let [end (~current-position-code ~state)]
                   (~consume-code ~state ~close)
                   (~emit-list-code ~state ~opcode start (+ end (cast u32 1)) mark)))
             (do
               (~consume-code ~state ~close)
               (loop
                 (if (or (!= (.error ~state) ~ok-error)
                         (>= (.event-index ~state) (.event-count ~state))) (break)
                   (if (and (= (~current-byte-code ~state) ~open)
                            (= (~adjacent-byte-code ~state 1) ~slash))
                       (break)
                     (if (= (~current-byte-code ~state) ~open)
                         (let [child (~function-name ~state)]
                           (~push-value-code ~state (.value child)))
                       (if (= (~current-byte-code ~state) ~expression-open)
                           (do
                             (~advance-code ~state)
                             (if (= (~current-byte-code ~state) ~expression-close)
                                 0
                               (let [child (~parse-expression-code ~state 0)]
                                 (~push-value-code ~state (.value child))))
                             (do (~consume-code ~state ~expression-close) 0))
                         (~advance-code ~state))))))
               (~advance-count-code ~state 2)
               (if (not (load fragment))
                   (let [closing-start (~current-position-code ~state)
                         (mut closing-end) (~word-end-code ~state closing-start)]
                     (if (= closing-start (load closing-end))
                         (do (~fail-code ~state ~expected-error) 0)
                       (do
                         (~advance-code ~state)
                         (loop
                           (if (!= (~current-byte-code ~state) ~dot) (break)
                             (do
                               (~advance-code ~state)
                               (let [part-start (~current-position-code ~state)
                                     part-end (~word-end-code ~state part-start)]
                                 (if (= part-start part-end)
                                     (do (~fail-code ~state ~expected-error) (break) 0)
                                   (do
                                     (store! closing-end part-end)
                                     (~advance-code ~state)
                                     0))))))
                         (if (not (~spans-equal-code ~state (load tag-start) (load tag-end)
                                    closing-start (load closing-end)))
                             (do (~fail-code ~state ~expected-error) 0) 0)))
                     0)
                 0)
               (let [end (~current-position-code ~state)]
                 (~consume-code ~state ~close)
                 (~emit-list-code ~state ~opcode start (+ end (cast u32 1)) mark)))))))))

(defn compile-postfix-type-assertion [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 17)
                (generator-form? production "postfix-type-assertion")))
      (generator-fail production "invalid postfix type assertion")
    (let [state-type (backend-value backend "state-type")
          result-type (backend-value backend "expression-result-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          current-position-code (backend-value backend "current-position")
          current-byte-code (backend-value backend "current-byte")
          word-end-code (backend-value backend "word-end")
          current-event-code (backend-value backend "current-event")
          event-kind-code (backend-value backend "event-kind")
          current-line-break-code (backend-value backend "current-line-break")
          current-keyword-code (backend-value backend "current-keyword")
          advance-code (backend-value backend "advance")
          check-build-code (backend-value backend "check-build")
          keyword (field-value production "keyword") stops (field-value production "stops")
          word-event (field-value production "word-event")
          continuation-keywords (field-value production "continuation-keywords")
          open (field-value production "open") close (field-value production "close")
          paren-open (field-value production "paren-open")
          paren-close (field-value production "paren-close")
          bracket-open (field-value production "bracket-open")
          bracket-close (field-value production "bracket-close")
          brace-open (field-value production "brace-open")
          brace-close (field-value production "brace-close")
          opcode (field-value production "emit-op") state (p/fresh-identifier "state")
          input (p/fresh-identifier "input") byte-id (p/fresh-identifier "byte")]
      `(defn ~function-name [(~state (ptr ~state-type)) (~input ~result-type)] (-> ~result-type)
         (let [assertion-start (~current-position-code ~state) _as (~advance-code ~state)
               type-start (~current-position-code ~state) (mut type-end) type-start
               (mut angles) 0 (mut parens) 0 (mut brackets) 0 (mut braces) 0
               (mut consumed) false]
           (loop
             (if (>= (.event-index ~state) (.event-count ~state)) (break)
               (let [~byte-id (~current-byte-code ~state)]
                 (if (and (= (load angles) 0) (= (load parens) 0)
                          (= (load brackets) 0) (= (load braces) 0) (load consumed)
                          (or
                            (and (~current-line-break-code ~state)
                                 (= (~event-kind-code (~current-event-code ~state))
                                    (cast u8 ~word-event))
                                 (not (or ~@(let [checks (p/code-list-new) (mut k) 0]
                                              (loop
                                                (if (>= (load k)
                                                        (p/code-count continuation-keywords))
                                                    (break)
                                                  (do
                                                    (p/code-list-push! checks
                                                      `(~current-keyword-code ~state
                                                        ~(p/code-nth continuation-keywords
                                                           (load k))))
                                                    (set! k (+ (load k) 1)))))
                                              (p/code-list-done checks)))))
                            (or ~@(let [checks (p/code-list-new) (mut j) 0]
                                  (loop
                                    (if (>= (load j) (p/code-count stops)) (break)
                                      (do (p/code-list-push! checks
                                            `(= ~byte-id ~(p/code-nth stops (load j))))
                                          (set! j (+ (load j) 1)))))
                                  (p/code-list-done checks)))))
                     (break)
                   (do
                     (store! type-end
                       (if (= (~event-kind-code (~current-event-code ~state))
                              (cast u8 ~word-event))
                           (~word-end-code ~state (~current-position-code ~state))
                         (+ (~current-position-code ~state) (cast u32 1))))
                     (cond
                       (= ~byte-id ~open) (set! angles (+ (load angles) 1))
                       (and (= ~byte-id ~close) (> (load angles) 0))
                         (set! angles (- (load angles) 1))
                       (= ~byte-id ~paren-open) (set! parens (+ (load parens) 1))
                       (and (= ~byte-id ~paren-close) (> (load parens) 0))
                         (set! parens (- (load parens) 1))
                       (= ~byte-id ~bracket-open) (set! brackets (+ (load brackets) 1))
                       (and (= ~byte-id ~bracket-close) (> (load brackets) 0))
                         (set! brackets (- (load brackets) 1))
                       (= ~byte-id ~brace-open) (set! braces (+ (load braces) 1))
                       (and (= ~byte-id ~brace-close) (> (load braces) 0))
                         (set! braces (- (load braces) 1))
                       :else 0)
                     (store! consumed true)
                     (~advance-code ~state))))))
           (let [end (load type-end) arena (.arena (.builder ~state))
                 value (.value-count arena)
                 operation (builder/add-op! (.builder ~state) (.block ~state) ~opcode
                              type-start end (.start ~input) end (cast u32 1))]
             (let [op (~check-build-code ~state operation)
                   operand (builder/add-operand! (.builder ~state) op (.value ~input))]
               (~check-build-code ~state operand)
               (~result-type :value value :start (.start ~input) :end end))))))))

(defn compile-optional-postfix [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 13)
                (generator-form? production "optional-postfix")))
      (generator-fail production "invalid optional-postfix production")
    (let [state-type (backend-value backend "state-type")
          result-type (backend-value backend "expression-result-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          current-byte-code (backend-value backend "current-byte")
          next-event-byte-code (backend-value backend "next-event-byte")
          advance-code (backend-value backend "advance")
          fail-code (backend-value backend "fail")
          expected-error (backend-value backend "expected-error")
          member-parser (backend-value backend
                          (p/code-sym (field-value production "member-parser")))
          computed-parser (backend-value backend
                            (p/code-sym (field-value production "computed-parser")))
          call-parser (backend-value backend
                        (p/code-sym (field-value production "call-parser")))
          question (field-value production "question") dot (field-value production "dot")
          computed-open (field-value production "computed-open")
          call-open (field-value production "call-open")
          member-op (field-value production "member-op")
          computed-op (field-value production "computed-op")
          call-op (field-value production "call-op")
          state (p/fresh-identifier "state") input (p/fresh-identifier "input")
          result (p/fresh-identifier "result") optional-op (p/fresh-identifier "optional-op")]
      `(defn ~function-name [(~state (ptr ~state-type)) (~input ~result-type)]
         (-> ~result-type)
         (let [_question (~advance-code ~state)]
           (if (!= (~current-byte-code ~state) ~dot)
               (~fail-code ~state ~expected-error)
             (let [next (~next-event-byte-code ~state 1)
                   ~optional-op (if (= next ~computed-open) ~computed-op
                                  (if (= next ~call-open) ~call-op ~member-op))
                   ~result
                     (if (= next ~computed-open)
                         (do (~advance-code ~state) (~computed-parser ~state ~input))
                       (if (= next ~call-open)
                           (do (~advance-code ~state) (~call-parser ~state ~input))
                         (~member-parser ~state ~input)))
                   arena (.arena (.builder ~state))
                   definition-kind
                     (load (p/index (.value-def-kinds arena) (cast i64 (.value ~result))))
                   definition-index
                     (load (p/index (.value-def-indices arena) (cast i64 (.value ~result))))]
               (if (= definition-kind (cast u8 ir/DEF-OP-RESULT))
                   (store! (p/index (.opcodes arena) (cast i64 definition-index))
                           (cast u16 ~optional-op))
                 0)
               ~result)))))))

(defn compile-postfix-chain [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 11)
                (generator-form? production "postfix-chain")))
      (generator-fail production "invalid postfix-chain production")
    (let [state-type (backend-value backend "state-type")
          result-type (backend-value backend "expression-result-type")
          function-role (field-value production "function")
          function-name (backend-value backend (p/code-sym function-role))
          primary-role (field-value production "primary")
          primary-code (backend-value backend (p/code-sym primary-role))
          dispatch-role (field-value production "dispatch")
          dispatch-code (backend-value backend (p/code-sym dispatch-role))
          current-byte-code (backend-value backend "current-byte")
          adjacent-byte-code (backend-value backend "adjacent-event-byte")
          current-event-code (backend-value backend "current-event")
          event-kind-code (backend-value backend "event-kind")
          current-keyword-code (backend-value backend "current-keyword")
          ok-error (backend-value backend "ok-error")
          forms (field-value production "forms")
          assertion-keywords (field-value production "assertion-keywords")
          assertion-parser (backend-value backend
                              (p/code-sym (field-value production "assertion-parser")))
          optional-parser (backend-value backend
                            (p/code-sym (field-value production "optional-parser")))
          optional-question (field-value production "optional-question")
          optional-dot (field-value production "optional-dot")
          state (p/fresh-identifier "state") value-id (p/fresh-identifier "value")
          form-id (p/fresh-identifier "form") event-id (p/fresh-identifier "event-kind")
          byte-id (p/fresh-identifier "byte")]
      `(defn ~function-name [(~state (ptr ~state-type))] (-> ~result-type)
         (let [(mut ~value-id) (~primary-code ~state)]
           (loop
             (let [~event-id (if (< (.event-index ~state) (.event-count ~state))
                                 (~event-kind-code (~current-event-code ~state))
                               (cast u8 0))
                   ~byte-id (~current-byte-code ~state)
                   ~form-id (~dispatch-code ~event-id ~byte-id)]
               (if (!= (.error ~state) ~ok-error) (break)
                 (if (and (= ~byte-id ~optional-question)
                          (= (~adjacent-byte-code ~state 1) ~optional-dot))
                     (store! ~value-id (~optional-parser ~state (load ~value-id)))
                 (if (or ~@(let [checks (p/code-list-new) (mut j) 0]
                             (loop
                               (if (>= (load j) (p/code-count assertion-keywords)) (break)
                                 (do
                                   (p/code-list-push! checks
                                     (let [keyword (p/code-nth assertion-keywords (load j))
                                           text (p/code-str keyword)]
                                       `(and (= ~byte-id
                                                (cast u8 ~(cast i64 (slice-get text 0))))
                                             (~current-keyword-code ~state ~keyword))))
                                   (set! j (+ (load j) 1)))))
                             (p/code-list-done checks)))
                     (store! ~value-id (~assertion-parser ~state (load ~value-id)))
                   (cond
                   ~@(let [clauses (p/code-list-new) (mut j) 0]
                       (loop
                         (if (>= (load j) (p/code-count forms)) (break)
                             (let [entry (p/code-nth forms (load j))
                                 parser-code (backend-value backend
                                               (p/code-sym (p/code-nth entry 1)))
                                 predicate (p/code-nth entry 2)
                                 predicate-code
                                   (if (generator-symbol? predicate "always") `true
                                     (let [predicate-function
                                           (backend-value backend (p/code-sym predicate))]
                                       `(~predicate-function ~state)))]
                             (p/code-list-push! clauses
                               `(and (= ~form-id ~(p/code-nth entry 0)) ~predicate-code))
                             (p/code-list-push! clauses
                               `(store! ~value-id
                                  (~parser-code ~state (load ~value-id))))
                             (set! j (+ (load j) 1)))))
                       (p/code-list-done clauses))
                   :else (break)))))))
           (load ~value-id))))))

(defn compile-named-export [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 11)
                (generator-form? production "named-export")))
      (generator-fail production "invalid named-export production")
    (let [state-type (backend-value backend "state-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          current-position-code (backend-value backend "current-position")
          current-byte-code (backend-value backend "current-byte")
          current-keyword-code (backend-value backend "current-keyword")
          word-end-code (backend-value backend "word-end")
          advance-code (backend-value backend "advance")
          consume-code (backend-value backend "consume-byte")
          fail-code (backend-value backend "fail")
          check-build-code (backend-value backend "check-build")
          parse-string-code (backend-value backend "parse-string")
          terminator-parser (backend-value backend
                              (p/code-sym (field-value production "terminator-parser")))
          expected-error (backend-value backend "expected-error")
          open (field-value production "open") close (field-value production "close")
          comma (field-value production "separator") as-keyword (field-value production "as-keyword")
          from-keyword (field-value production "from-keyword")
          type-keyword (field-value production "type-keyword") opcode (field-value production "emit-op")
          state (p/fresh-identifier "state")]
      `(defn ~function-name [(~state (ptr ~state-type))] (-> i64)
         (let [start (~current-position-code ~state) _export (~advance-code ~state)]
           (~consume-code ~state ~open)
           (loop
             (if (= (~current-byte-code ~state) ~close) (break)
               (do
                 (if (~current-keyword-code ~state ~type-keyword)
                     (do (~advance-code ~state) 0) 0)
                 (let [name-start (~current-position-code ~state)
                     name-end (~word-end-code ~state name-start)]
                 (if (= name-start name-end)
                     (do (~fail-code ~state ~expected-error) (break) 0)
                   (do
                     (~advance-code ~state)
                     (if (~current-keyword-code ~state ~as-keyword)
                         (do
                           (~advance-code ~state)
                           (let [alias-start (~current-position-code ~state)]
                             (if (= alias-start (~word-end-code ~state alias-start))
                                 (do (~fail-code ~state ~expected-error) 0)
                               (do (~advance-code ~state) 0)))
                           0) 0)
                     (if (= (~current-byte-code ~state) ~comma)
                         (do (~advance-code ~state) 0) (break))))))))
           (~consume-code ~state ~close)
           (if (~current-keyword-code ~state ~from-keyword)
               (do (~advance-code ~state) (~parse-string-code ~state) 0) 0)
           (let [end (~terminator-parser ~state (~current-position-code ~state))
                 operation (builder/add-op! (.builder ~state) (.block ~state) ~opcode
                              (cast u32 0) (cast u32 0) start end (cast u32 0))]
             (~check-build-code ~state operation)))
         0))))

(defn compile-keyword-statement [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 6)
                (generator-form? production "keyword-statement")))
      (generator-fail production "invalid keyword-statement production")
    (let [state-type (backend-value backend "state-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          current-position-code (backend-value backend "current-position")
          advance-code (backend-value backend "advance")
          terminator-parser (backend-value backend
                              (p/code-sym (field-value production "terminator-parser")))
          check-build-code (backend-value backend "check-build")
          opcode (field-value production "emit-op")
          state (p/fresh-identifier "state")]
      `(defn ~function-name [(~state (ptr ~state-type))] (-> i64)
         (let [start (~current-position-code ~state) _keyword (~advance-code ~state)
               end (~terminator-parser ~state start)
               operation (builder/add-op! (.builder ~state) (.block ~state) ~opcode
                           (cast u32 0) (cast u32 0) start end (cast u32 0))]
           (~check-build-code ~state operation))
         0))))

(defn compile-control-transfer [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 5)
                (generator-form? production "control-transfer")))
      (generator-fail production "invalid control-transfer production")
    (let [state-type (backend-value backend "state-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          current-position-code (backend-value backend "current-position")
          advance-code (backend-value backend "advance")
          terminator-parser (backend-value backend
                              (p/code-sym (field-value production "terminator-parser")))
          emit-branch-code (backend-value backend "emit-branch")
          fail-code (backend-value backend "fail")
          expected-error (backend-value backend "expected-error")
          target-kind (field-value production "target")
          state (p/fresh-identifier "state")
          target-expression (if (generator-symbol? target-kind "break")
                                `(.break-target ~state) `(.continue-target ~state))]
      `(defn ~function-name [(~state (ptr ~state-type))] (-> i64)
         (let [start (~current-position-code ~state) _keyword (~advance-code ~state)
               target ~target-expression]
           (~terminator-parser ~state start)
           (if (= target (cast u32 ir/INVALID-ID))
               (do (~fail-code ~state ~expected-error) 0)
             (do
               (~emit-branch-code ~state (.block ~state) target)
               (set! (.terminated ~state) true)
               0)))))))

(defn compile-switch-statement [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 12)
                (generator-form? production "switch-statement")))
      (generator-fail production "invalid switch-statement production")
    (let [state-type (backend-value backend "state-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          current-position-code (backend-value backend "current-position")
          current-byte-code (backend-value backend "current-byte")
          current-keyword-code (backend-value backend "current-keyword-fast")
          advance-code (backend-value backend "advance")
          consume-code (backend-value backend "consume-byte")
          parse-expression-code (backend-value backend "parse-expression")
          parse-statement-code (backend-value backend "parse-statement")
          emit-branch-code (backend-value backend "emit-branch")
          check-build-code (backend-value backend "check-build")
          fail-code (backend-value backend "fail")
          ok-error (backend-value backend "ok-error")
          expected-error (backend-value backend "expected-error")
          open (field-value production "open") close (field-value production "close")
          body-open (field-value production "body-open")
          body-close (field-value production "body-close")
          case-keyword (field-value production "case-keyword")
          default-keyword (field-value production "default-keyword")
          colon (field-value production "colon")
          branch-op (field-value production "branch-op")
          compare-op (field-value production "compare-op")
          state (p/fresh-identifier "state")]
      `(defn ~function-name [(~state (ptr ~state-type))] (-> i64)
         (let [start (~current-position-code ~state) _keyword (~advance-code ~state)]
           (~consume-code ~state ~open)
           (let [discriminant (~parse-expression-code ~state 0)]
             (~consume-code ~state ~close)
             (~consume-code ~state ~body-open)
             (if (= (.error ~state) ~ok-error)
                 (let [arena (.arena (.builder ~state))
                               origin (.block ~state)
                               region (load (p/index (.block-regions arena)
                                                     (cast i64 origin)))
                               exit-result (builder/add-block! (.builder ~state) region)
                               exit-block (~check-build-code ~state exit-result)
                               parent-scope (.scope ~state)
                               scope-result (builder/add-scope! (.builder ~state) parent-scope
                                              start (cast u32 (.source-size ~state)))
                               switch-scope (~check-build-code ~state scope-result)
                               parent-break-target (.break-target ~state)
                               (mut dispatch-block) origin
                               (mut default-block) (cast u32 ir/INVALID-ID)
                               (mut previous-block) (cast u32 ir/INVALID-ID)
                               (mut previous-falls) false]
                           (set! (.scope ~state) switch-scope)
                           (set! (.break-target ~state) exit-block)
                           (loop
                             (if (or (!= (.error ~state) ~ok-error)
                                     (>= (.event-index ~state) (.event-count ~state))
                                     (= (~current-byte-code ~state) ~body-close)) (break)
                               (let [is-case (~current-keyword-code ~state ~case-keyword)
                                     is-default (~current-keyword-code ~state ~default-keyword)]
                                 (if (not (or is-case is-default))
                                     (do (~fail-code ~state ~expected-error) (break))
                                   (let [clause-start (~current-position-code ~state)
                                         _clause-keyword (~advance-code ~state)
                                         body-result (builder/add-block! (.builder ~state) region)
                                         body-block (~check-build-code ~state body-result)]
                                     (if (and (load previous-falls)
                                              (!= (load previous-block)
                                                  (cast u32 ir/INVALID-ID)))
                                         (~emit-branch-code ~state (load previous-block) body-block)
                                       0)
                                     (if is-case
                                         (do
                                           (set! (.block ~state) (load dispatch-block))
                                           (set! (.terminated ~state) false)
                                           (let [case-value (~parse-expression-code ~state 0)]
                                             (if (~consume-code ~state ~colon)
                                                 (let [comparison-value (.value-count arena)
                                                       comparison-result
                                                         (builder/add-op! (.builder ~state)
                                                           (.block ~state) ~compare-op
                                                           (cast u32 0) (cast u32 0) clause-start
                                                           (~current-position-code ~state)
                                                           (cast u32 1))
                                                       comparison (~check-build-code ~state
                                                                    comparison-result)
                                                       left-operand
                                                         (builder/add-operand! (.builder ~state)
                                                           comparison (.value discriminant))
                                                       right-operand
                                                         (builder/add-operand! (.builder ~state)
                                                           comparison (.value case-value))
                                                       next-result
                                                         (builder/add-block! (.builder ~state) region)
                                                       next-block (~check-build-code ~state next-result)
                                                       branch-result
                                                         (builder/add-op! (.builder ~state)
                                                           (.block ~state) ~branch-op
                                                           (cast u32 0) (cast u32 0) clause-start
                                                           (~current-position-code ~state)
                                                           (cast u32 0))
                                                       branch (~check-build-code ~state branch-result)
                                                       condition-operand
                                                         (builder/add-operand! (.builder ~state)
                                                           branch comparison-value)
                                                       matched-successor
                                                         (builder/add-successor! (.builder ~state)
                                                           branch body-block)
                                                       next-successor
                                                         (builder/add-successor! (.builder ~state)
                                                           branch next-block)]
                                                   (~check-build-code ~state left-operand)
                                                   (~check-build-code ~state right-operand)
                                                   (~check-build-code ~state condition-operand)
                                                   (~check-build-code ~state matched-successor)
                                                   (~check-build-code ~state next-successor)
                                                   (store! dispatch-block next-block))
                                               0)) 0)
                                       (if (!= (load default-block) (cast u32 ir/INVALID-ID))
                                           (do (~fail-code ~state ~expected-error) 0)
                                         (if (~consume-code ~state ~colon)
                                             (store! default-block body-block) 0)))
                                     (set! (.block ~state) body-block)
                                     (set! (.terminated ~state) false)
                                     (loop
                                       (if (or (!= (.error ~state) ~ok-error)
                                               (>= (.event-index ~state)
                                                   (.event-count ~state))
                                               (= (~current-byte-code ~state) ~body-close)
                                               (~current-keyword-code ~state ~case-keyword)
                                               (~current-keyword-code ~state ~default-keyword))
                                           (break)
                                         (do
                                           (if (.terminated ~state)
                                               (let [unreachable-result
                                                       (builder/add-block! (.builder ~state) region)
                                                     unreachable-block
                                                       (~check-build-code ~state unreachable-result)]
                                                 (set! (.block ~state) unreachable-block)
                                                 (set! (.terminated ~state) false)) 0)
                                           (~parse-statement-code ~state))))
                                     (store! previous-block (.block ~state))
                                     (store! previous-falls (not (.terminated ~state))))))))
                           (if (and (load previous-falls)
                                    (!= (load previous-block) (cast u32 ir/INVALID-ID)))
                               (~emit-branch-code ~state (load previous-block) exit-block) 0)
                           (~emit-branch-code ~state (load dispatch-block)
                             (if (= (load default-block) (cast u32 ir/INVALID-ID))
                                 exit-block (load default-block)))
                           (let [end-position (~current-position-code ~state)]
                             (if (~consume-code ~state ~body-close)
                                 (let [ended (builder/set-scope-end! (.builder ~state)
                                                switch-scope
                                                (+ end-position (cast u32 1)))]
                                   (~check-build-code ~state ended)) 0))
                           (set! (.scope ~state) parent-scope)
                           (set! (.break-target ~state) parent-break-target)
                           (set! (.block ~state) exit-block)
                           (set! (.terminated ~state) false)) 0)))
         0))))

(defn compile-statement-dispatch [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 42)
                (generator-form? production "statement-dispatch")))
      (generator-fail production "invalid statement-dispatch production")
    (let [state-type (backend-value backend "state-type")
          function-role (field-value production "function")
          function-name (backend-value backend (p/code-sym function-role))
          current-byte-code (backend-value backend "current-byte")
          next-event-byte-code (backend-value backend "next-event-byte")
          current-keyword-code (backend-value backend "current-keyword-fast")
          current-position-code (backend-value backend "current-position")
          advance-code (backend-value backend "advance")
          check-build-code (backend-value backend "check-build")
          block-parser (backend-value backend (p/code-sym (field-value production "block-parser")))
          declaration-parser (backend-value backend (p/code-sym (field-value production "declaration-parser")))
          return-parser (backend-value backend (p/code-sym (field-value production "return-parser")))
          throw-parser (backend-value backend (p/code-sym (field-value production "throw-parser")))
          break-parser (backend-value backend (p/code-sym (field-value production "break-parser")))
          continue-parser (backend-value backend
                            (p/code-sym (field-value production "continue-parser")))
          if-parser (backend-value backend (p/code-sym (field-value production "if-parser")))
          while-parser (backend-value backend (p/code-sym (field-value production "while-parser")))
          do-while-parser (backend-value backend
                            (p/code-sym (field-value production "do-while-parser")))
          for-parser (backend-value backend (p/code-sym (field-value production "for-parser")))
          switch-parser (backend-value backend (p/code-sym (field-value production "switch-parser")))
          function-parser (backend-value backend (p/code-sym (field-value production "function-parser")))
          type-parser (backend-value backend (p/code-sym (field-value production "type-parser")))
          interface-parser (backend-value backend
                              (p/code-sym (field-value production "interface-parser")))
          import-parser (backend-value backend (p/code-sym (field-value production "import-parser")))
          named-export-parser (backend-value backend
                                (p/code-sym (field-value production "named-export-parser")))
          debugger-parser (backend-value backend
                            (p/code-sym (field-value production "debugger-parser")))
          fallback-parser (backend-value backend (p/code-sym (field-value production "fallback-parser")))
          block-open (field-value production "block-open")
          empty-terminal (field-value production "empty-terminal")
          declaration-keywords (field-value production "declaration-keywords")
          return-keyword (field-value production "return-keyword")
          throw-keyword (field-value production "throw-keyword")
          break-keyword (field-value production "break-keyword")
          continue-keyword (field-value production "continue-keyword")
          if-keyword (field-value production "if-keyword")
          while-keyword (field-value production "while-keyword")
          do-keyword (field-value production "do-keyword")
          for-keyword (field-value production "for-keyword")
          switch-keyword (field-value production "switch-keyword")
          function-keyword (field-value production "function-keyword")
          type-keyword (field-value production "type-keyword")
          interface-keyword (field-value production "interface-keyword")
          module-keyword (field-value production "module-keyword")
          import-keyword (field-value production "import-keyword")
          export-keyword (field-value production "export-keyword")
          debugger-keyword (field-value production "debugger-keyword")
          modifier-keywords (field-value production "modifier-keywords")
          modifier-op (field-value production "modifier-op")
          state (p/fresh-identifier "state")]
      `(defn ~function-name [(~state (ptr ~state-type))] (-> i64)
         (let [modifier-start (~current-position-code ~state) (mut modifiers) 0]
           (loop
             (if (or (and (~current-keyword-code ~state ~export-keyword)
                          (= (~next-event-byte-code ~state 1) ~block-open))
                     (not (or ~@(let [checks (p/code-list-new) (mut j) 0]
                               (loop
                                 (if (>= (load j) (p/code-count modifier-keywords)) (break)
                                   (do
                                     (p/code-list-push! checks
                                       `(~current-keyword-code ~state
                                          ~(p/code-nth modifier-keywords (load j))))
                                     (set! j (+ (load j) 1)))))
                               (p/code-list-done checks))))) (break)
               (do (~advance-code ~state) (set! modifiers (+ (load modifiers) 1)))))
           (if (> (load modifiers) 0)
               (let [operation (builder/add-op! (.builder ~state) (.block ~state)
                                  ~modifier-op (cast u32 0) (cast u32 0)
                                  modifier-start (~current-position-code ~state)
                                  (cast u32 0))]
                 (~check-build-code ~state operation)) 0)
           (cond
             (= (~current-byte-code ~state) ~empty-terminal) (~advance-code ~state)
             (and (~current-keyword-code ~state ~export-keyword)
                  (= (~next-event-byte-code ~state 1) ~block-open))
               (~named-export-parser ~state)
             (= (~current-byte-code ~state) ~block-open) (~block-parser ~state)
             (or ~@(let [checks (p/code-list-new) (mut j) 0]
                     (loop
                       (if (>= (load j) (p/code-count declaration-keywords)) (break)
                         (do
                           (p/code-list-push! checks
                             `(~current-keyword-code ~state
                                ~(p/code-nth declaration-keywords (load j))))
                           (set! j (+ (load j) 1)))))
                     (p/code-list-done checks)))
               (~declaration-parser ~state)
             (~current-keyword-code ~state ~return-keyword) (~return-parser ~state)
             (~current-keyword-code ~state ~throw-keyword) (~throw-parser ~state)
             (~current-keyword-code ~state ~break-keyword) (~break-parser ~state)
             (~current-keyword-code ~state ~continue-keyword) (~continue-parser ~state)
             (~current-keyword-code ~state ~if-keyword) (~if-parser ~state)
             (~current-keyword-code ~state ~while-keyword) (~while-parser ~state)
             (~current-keyword-code ~state ~do-keyword) (~do-while-parser ~state)
             (~current-keyword-code ~state ~for-keyword) (~for-parser ~state)
             (~current-keyword-code ~state ~switch-keyword) (~switch-parser ~state)
             (~current-keyword-code ~state ~function-keyword) (~function-parser ~state)
             (~current-keyword-code ~state ~type-keyword) (~type-parser ~state)
             (~current-keyword-code ~state ~interface-keyword) (~interface-parser ~state)
             (~current-keyword-code ~state ~module-keyword) (~interface-parser ~state)
             (~current-keyword-code ~state ~import-keyword) (~import-parser ~state)
             (~current-keyword-code ~state ~debugger-keyword) (~debugger-parser ~state)
             :else (~fallback-parser ~state)))))))

(defn compile-scoped-repeat [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 7)
                (generator-form? production "scoped-repeat")))
      (generator-fail production "invalid scoped-repeat production")
    (let [state-type (backend-value backend "state-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          current-position-code (backend-value backend "current-position")
          current-byte-code (backend-value backend "current-byte")
          consume-code (backend-value backend "consume-byte")
          fail-code (backend-value backend "fail")
          check-build-code (backend-value backend "check-build")
          element-parser (backend-value backend
                           (p/code-sym (field-value production "element-parser")))
          ok-error (backend-value backend "ok-error")
          open (field-value production "open") close (field-value production "close")
          state (p/fresh-identifier "state")]
      `(defn ~function-name [(~state (ptr ~state-type))] (-> i64)
         (let [start (~current-position-code ~state) parent-scope (.scope ~state)]
           (if (~consume-code ~state ~open)
               (let [scope-result (builder/add-scope! (.builder ~state) parent-scope start
                                      (cast u32 (.source-size ~state)))
                     scope (~check-build-code ~state scope-result)]
                 (set! (.scope ~state) scope)
                 (loop
                   (if (or (!= (.error ~state) ~ok-error)
                           (>= (.event-index ~state) (.event-count ~state))
                           (= (~current-byte-code ~state) ~close)) (break)
                     (do
                       (if (.terminated ~state)
                           (let [arena (.arena (.builder ~state))
                                 region (load (p/index (.block-regions arena)
                                                       (cast i64 (.block ~state))))
                                 block-result (builder/add-block! (.builder ~state) region)
                                 block (~check-build-code ~state block-result)]
                             (set! (.block ~state) block)
                             (set! (.terminated ~state) false)) 0)
                       (~element-parser ~state))))
                 (let [end-position (~current-position-code ~state)]
                   (if (~consume-code ~state ~close)
                       (let [ended (builder/set-scope-end! (.builder ~state) scope
                                      (+ end-position (cast u32 1)))]
                         (~check-build-code ~state ended)) 0))
                 (set! (.scope ~state) parent-scope)) 0))
         0))))

(defn compile-binding-declaration [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 15)
                (generator-form? production "binding-declaration")))
      (generator-fail production "invalid binding-declaration production")
    (let [state-type (backend-value backend "state-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          current-position-code (backend-value backend "current-position")
          current-byte-code (backend-value backend "current-byte")
          next-event-byte-code (backend-value backend "next-event-byte")
          word-end-code (backend-value backend "word-end")
          span-equals-code (backend-value backend "span-equals")
          advance-code (backend-value backend "advance")
          parse-expression-code (backend-value backend "parse-expression")
          emit-value-code (backend-value backend "emit-value-op")
          pattern-parser-code (backend-value backend
                                (p/code-sym (field-value production "pattern-parser")))
          terminator-parser (backend-value backend
                              (p/code-sym (field-value production "terminator-parser")))
          fail-code (backend-value backend "fail")
          check-build-code (backend-value backend "check-build")
          ok-error (backend-value backend "ok-error")
          expected-error (backend-value backend "expected-error")
          kinds (field-value production "kinds")
          equals (field-value production "equals")
          separator (field-value production "separator")
          requires-initializer-keyword (field-value production "requires-initializer-keyword")
          object-pattern-open (field-value production "object-pattern-open")
          array-pattern-open (field-value production "array-pattern-open")
          undefined-op (field-value production "undefined-op")
          uninitialized-flag (field-value production "uninitialized-flag")
          terminator (field-value production "terminator")
          opcode (field-value production "emit-op")
          first-kind (p/code-nth kinds 0) second-kind (p/code-nth kinds 1)
          default-kind (p/code-nth kinds 2)
          state (p/fresh-identifier "state")]
      `(defn ~function-name [(~state (ptr ~state-type))] (-> i64)
         (let [start (~current-position-code ~state)
               keyword-end (~word-end-code ~state start)
               initializer-required
                 (or (~span-equals-code ~state start keyword-end ~requires-initializer-keyword)
                     (= (~next-event-byte-code ~state 1) ~object-pattern-open)
                     (= (~next-event-byte-code ~state 1) ~array-pattern-open))
               declaration-kind
                 (if (~span-equals-code ~state start keyword-end
                       ~(p/code-nth first-kind 0))
                     ~(p/code-nth first-kind 1)
                   (if (~span-equals-code ~state start keyword-end
                         ~(p/code-nth second-kind 0))
                       ~(p/code-nth second-kind 1)
                     ~(p/code-nth default-kind 1)))]
           (~advance-code ~state)
           (let [(mut first) true (mut last-op) (cast u32 ir/INVALID-ID)
                 (mut last-end) (~current-position-code ~state)]
             (loop
               (let [name-start (~current-position-code ~state)
                     initial-name-end (~word-end-code ~state name-start)]
                 (~pattern-parser-code ~state false ~equals ~separator)
                 (let [name-end (if (= name-start initial-name-end)
                                    (~current-position-code ~state) initial-name-end)
                       operation-start (if (load first) start name-start)]
                   (if (= (~current-byte-code ~state) ~equals)
                       (let [_equals (~advance-code ~state)
                             value (~parse-expression-code ~state 0)
                             operation (builder/add-op! (.builder ~state) (.block ~state)
                                         ~opcode name-start name-end operation-start
                                         (.end value) (cast u32 0))]
                         (let [op (~check-build-code ~state operation)
                               operand (builder/add-operand! (.builder ~state) op (.value value))
                               kind-result (builder/set-op-immediate! (.builder ~state) op
                                                                      declaration-kind)]
                           (~check-build-code ~state operand)
                           (~check-build-code ~state kind-result)
                           (store! last-op op)
                           (store! last-end (.end value))))
                     (if initializer-required
                         (do (~fail-code ~state ~expected-error) 0)
                       (let [undefined-value
                              (~emit-value-code ~state ~undefined-op name-end name-end)]
                         (let [operation (builder/add-op! (.builder ~state) (.block ~state)
                                           ~opcode name-start name-end operation-start
                                           name-end (cast u32 0))]
                           (let [op (~check-build-code ~state operation)
                                 operand (builder/add-operand! (.builder ~state) op
                                                               (.value undefined-value))
                                 kind-result (builder/set-op-immediate! (.builder ~state) op
                                                (+ declaration-kind ~uninitialized-flag))]
                             (~check-build-code ~state operand)
                             (~check-build-code ~state kind-result)
                             (store! last-op op)
                             (store! last-end name-end)
                             0)))))))
               (store! first false)
               (if (or (!= (.error ~state) ~ok-error)
                       (!= (~current-byte-code ~state) ~separator)) (break)
                 (do (~advance-code ~state) 0)))
             (if (= (.error ~state) ~ok-error)
                 (let [statement-end (~terminator-parser ~state (load last-end))]
                   (if (!= (load last-op) (cast u32 ir/INVALID-ID))
                       (let [spanned (builder/set-op-span! (.builder ~state) (load last-op)
                                      (load (p/index (.op-starts (.arena (.builder ~state)))
                                                     (cast i64 (load last-op))))
                                      statement-end)]
                         (~check-build-code ~state spanned)) 0)) 0)))
         0))))

(defn compile-template-value [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 9)
                (generator-form? production "template-value")))
      (generator-fail production "invalid template value")
    (let [state-type (backend-value backend "state-type")
          result-type (backend-value backend "expression-result-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          current-position-code (backend-value backend "current-position")
          current-byte-code (backend-value backend "current-byte")
          adjacent-byte-code (backend-value backend "adjacent-event-byte")
          source-byte-code (backend-value backend "source-byte")
          advance-code (backend-value backend "advance")
          advance-count-code (backend-value backend "advance-count")
          consume-code (backend-value backend "consume-byte")
          parse-expression-code (backend-value backend "parse-expression")
          push-value-code (backend-value backend "push-scratch-value")
          emit-list-code (backend-value backend "emit-scratch-list-op")
          ok-error (backend-value backend "ok-error")
          quote (field-value production "quote") dollar (field-value production "dollar")
          open (field-value production "open") close (field-value production "close")
          backslash (field-value production "backslash") opcode (field-value production "emit-op")
          state (p/fresh-identifier "state")]
      `(defn ~function-name [(~state (ptr ~state-type))] (-> ~result-type)
         (let [scratch (.scratch ~state) mark (.value-count scratch)
               start (~current-position-code ~state) _quote (~advance-code ~state)
               (mut end) start]
           (loop
             (if (or (!= (.error ~state) ~ok-error)
                     (>= (.event-index ~state) (.event-count ~state))) (break)
               (let [position (~current-position-code ~state) byte (~current-byte-code ~state)
                     (mut cursor) position (mut slashes) 0]
                 (loop
                   (if (or (<= (load cursor) start)
                           (!= (~source-byte-code ~state (- (load cursor) (cast u32 1)))
                               ~backslash)) (break)
                     (do
                       (set! cursor (- (load cursor) (cast u32 1)))
                       (set! slashes (+ (load slashes) 1)))))
                 (let [escaped (!= (p/iand (cast u64 (load slashes)) (cast u64 1))
                                   (cast u64 0))]
                   (if (and (= byte ~quote) (not escaped))
                       (do (store! end (+ position (cast u32 1))) (break))
                     (if (and (= byte ~dollar) (not escaped)
                              (= (~adjacent-byte-code ~state 1) ~open))
                         (do
                           (~advance-count-code ~state 2)
                           (let [value (~parse-expression-code ~state 0)]
                             (~push-value-code ~state (.value value)))
                           (do (~consume-code ~state ~close) 0))
                       (~advance-code ~state)))))))
           (~consume-code ~state ~quote)
           (~emit-list-code ~state ~opcode start (load end) mark))))))

(defn compile-prefix-keyword-expression [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 5)
                (generator-form? production "prefix-keyword-expression")))
      (generator-fail production "invalid prefix keyword expression")
    (let [state-type (backend-value backend "state-type")
          result-type (backend-value backend "expression-result-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          current-position-code (backend-value backend "current-position")
          word-end-code (backend-value backend "word-end")
          advance-code (backend-value backend "advance")
          parse-expression-code (backend-value backend "parse-expression")
          check-build-code (backend-value backend "check-build")
          precedence (field-value production "precedence")
          opcode (field-value production "emit-op") state (p/fresh-identifier "state")]
      `(defn ~function-name [(~state (ptr ~state-type))] (-> ~result-type)
         (let [start (~current-position-code ~state) keyword-end (~word-end-code ~state start)
               _keyword (~advance-code ~state) argument (~parse-expression-code ~state ~precedence)
               arena (.arena (.builder ~state)) value (.value-count arena)
               operation (builder/add-op! (.builder ~state) (.block ~state) ~opcode
                            start keyword-end start (.end argument) (cast u32 1))]
           (let [op (~check-build-code ~state operation)
                 operand (builder/add-operand! (.builder ~state) op (.value argument))]
             (~check-build-code ~state operand)
             (~result-type :value value :start start :end (.end argument))))))))

(defn compile-primary-dispatch [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 24)
                (generator-form? production "primary-dispatch")))
      (generator-fail production "invalid primary-dispatch production")
    (let [state-type (backend-value backend "state-type")
          result-type (backend-value backend "expression-result-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          dispatch-code (backend-value backend
                          (p/code-sym (field-value production "dispatch")))
          current-event-code (backend-value backend "current-event")
          event-kind-code (backend-value backend "event-kind")
          current-byte-code (backend-value backend "current-byte")
          adjacent-byte-code (backend-value backend "adjacent-event-byte")
          current-position-code (backend-value backend "current-position")
          current-keyword-code (backend-value backend "current-keyword")
          advance-code (backend-value backend "advance")
          advance-count-code (backend-value backend "advance-count")
          consume-code (backend-value backend "consume-byte")
          fail-code (backend-value backend "fail")
          parse-expression-code (backend-value backend "parse-expression")
          check-build-code (backend-value backend "check-build")
          unexpected-error (backend-value backend "unexpected-error")
          expected-error (backend-value backend "expected-error")
          forms (field-value production "forms") parsers (field-value production "parsers")
          word-parser (backend-value backend (p/code-sym (p/code-nth parsers 0)))
          string-parser (backend-value backend (p/code-sym (p/code-nth parsers 1)))
          template-parser (backend-value backend
                            (p/code-sym (field-value production "template-parser")))
          template-quote (field-value production "template-quote")
          array-parser (backend-value backend (p/code-sym (p/code-nth parsers 2)))
          object-parser (backend-value backend (p/code-sym (p/code-nth parsers 3)))
          number-parser (backend-value backend (p/code-sym (p/code-nth parsers 4)))
          group-close (field-value production "group-close")
          group-op (field-value production "group-op")
          unary-forms (field-value production "unary-forms")
          unary-precedence (field-value production "unary-precedence")
          unary-op (field-value production "unary-op")
          update-forms (field-value production "update-forms")
          update-target-ops (field-value production "update-target-ops")
          update-op (field-value production "update-op")
          arrow-predicate (backend-value backend
                            (p/code-sym (field-value production "arrow-predicate")))
          arrow-parser (backend-value backend
                         (p/code-sym (field-value production "arrow-parser")))
          jsx-parser (backend-value backend
                       (p/code-sym (field-value production "jsx-parser")))
          regexp-parser (backend-value backend
                          (p/code-sym (field-value production "regexp-parser")))
          function-expression-keyword (field-value production "function-expression-keyword")
          function-expression-parser (backend-value backend
                                        (p/code-sym
                                          (field-value production
                                            "function-expression-parser")))
          prefix-keywords (field-value production "prefix-keywords")
          prefix-parser (backend-value backend
                          (p/code-sym (field-value production "prefix-parser")))
          state (p/fresh-identifier "state") form-id (p/fresh-identifier "form")
          prefix-byte (p/fresh-identifier "prefix-byte")
          argument-op-id (p/fresh-identifier "argument-op")]
      `(defn ~function-name [(~state (ptr ~state-type))] (-> ~result-type)
         (if (>= (.event-index ~state) (.event-count ~state))
             (~fail-code ~state ~unexpected-error)
           (if (~arrow-predicate ~state) (~arrow-parser ~state)
             (if (and (= (~current-byte-code ~state)
                         (cast u8 ~(cast i64
                           (slice-get (p/code-str function-expression-keyword) 0))))
                      (~current-keyword-code ~state ~function-expression-keyword))
                 (~function-expression-parser ~state)
             (if (let [~prefix-byte (~current-byte-code ~state)]
                   (cond
                     ~@(let [clauses (p/code-list-new) (mut j) 0]
                         (loop
                           (if (>= (load j) (p/code-count prefix-keywords)) (break)
                             (let [keyword-code (p/code-nth prefix-keywords (load j))
                                   keyword-text (p/code-str keyword-code)]
                               (p/code-list-push! clauses
                                 `(= ~prefix-byte
                                     (cast u8 ~(cast i64 (slice-get keyword-text 0)))))
                               (p/code-list-push! clauses
                                 `(~current-keyword-code ~state ~keyword-code))
                               (set! j (+ (load j) 1)))))
                         (p/code-list-done clauses))
                     :else false))
                 (~prefix-parser ~state)
               (let [~form-id (~dispatch-code (~event-kind-code (~current-event-code ~state))
                                            (~current-byte-code ~state))]
             (cond
               (= ~form-id ~(p/code-nth forms 0)) (~word-parser ~state)
               (= ~form-id ~(p/code-nth forms 1))
                 (if (= (~current-byte-code ~state) ~template-quote)
                     (~template-parser ~state) (~string-parser ~state))
               (= ~form-id ~(p/code-nth forms 2))
                 (let [start (~current-position-code ~state)
                       _open (~advance-code ~state)
                       value (~parse-expression-code ~state 0)
                       close-position (~current-position-code ~state)]
                   (if (~consume-code ~state ~group-close)
                       (let [group-end (+ close-position (cast u32 1))
                             arena (.arena (.builder ~state))
                             definition-kind
                               (load (p/index (.value-def-kinds arena)
                                              (cast i64 (.value value))))
                             definition-index
                               (load (p/index (.value-def-indices arena)
                                              (cast i64 (.value value))))
                             grouped-opcode
                               (if (= definition-kind (cast u8 ir/DEF-OP-RESULT))
                                   (load (p/index (.opcodes arena)
                                                  (cast i64 definition-index)))
                                 ir/OP-INVALID)]
                         (if (= grouped-opcode ~unary-op)
                             (let [result (.value-count arena)
                                   operation (builder/add-op! (.builder ~state) (.block ~state)
                                               ~group-op start group-end
                                               start group-end (cast u32 1))]
                               (let [op (~check-build-code ~state operation)
                                     operand (builder/add-operand! (.builder ~state) op
                                                                   (.value value))]
                                 (~check-build-code ~state operand)
                                 (~result-type :value result :start start
                                               :end group-end)))
                           (~result-type :value (.value value) :start start
                                         :end group-end)))
                     (~fail-code ~state ~expected-error)))
               (or ~@(let [checks (p/code-list-new) (mut j) 0]
                       (loop
                         (if (>= (load j) (p/code-count unary-forms)) (break)
                           (do (p/code-list-push! checks
                                 `(= ~form-id ~(p/code-nth unary-forms (load j))))
                               (set! j (+ (load j) 1)))))
                       (p/code-list-done checks)))
                 (let [start (~current-position-code ~state)
                       operator (~current-byte-code ~state)
                       update
                         (and (= (~adjacent-byte-code ~state 1) operator)
                              (or ~@(let [checks (p/code-list-new) (mut j) 0]
                                      (loop
                                        (if (>= (load j) (p/code-count update-forms)) (break)
                                          (do
                                            (p/code-list-push! checks
                                              `(= ~form-id
                                                  ~(p/code-nth update-forms (load j))))
                                            (set! j (+ (load j) 1)))))
                                      (p/code-list-done checks))))
                       _advance (if update (~advance-count-code ~state 2)
                                  (~advance-code ~state))
                       argument (~parse-expression-code ~state ~unary-precedence)
                       arena (.arena (.builder ~state))
                       definition-kind (load (p/index (.value-def-kinds arena)
                                                       (cast i64 (.value argument))))
                       definition-index (load (p/index (.value-def-indices arena)
                                                        (cast i64 (.value argument))))
                       ~argument-op-id (if (= definition-kind (cast u8 ir/DEF-OP-RESULT))
                                         (load (p/index (.opcodes arena)
                                                        (cast i64 definition-index)))
                                       ir/OP-INVALID)
                       valid-update-target
                         (or ~@(let [checks (p/code-list-new) (mut j) 0]
                                (loop
                                  (if (>= (load j) (p/code-count update-target-ops)) (break)
                                    (do
                                      (p/code-list-push! checks
                                        `(= ~argument-op-id
                                            ~(p/code-nth update-target-ops (load j))))
                                      (set! j (+ (load j) 1)))))
                                (p/code-list-done checks)))
                       value (.value-count arena)]
                   (if (and update (not valid-update-target))
                       (~fail-code ~state ~expected-error)
                     (let [operation-result
                             (builder/add-op! (.builder ~state) (.block ~state)
                               (if update ~update-op ~unary-op)
                               (cast u32 0) (cast u32 0) start (.end argument) (cast u32 1))
                           op (~check-build-code ~state operation-result)
                         operand (builder/add-operand! (.builder ~state) op (.value argument))
                         immediate (builder/set-op-immediate! (.builder ~state) op
                                     (if update
                                         (p/ior (cast u64 operator)
                                           (p/ishl (cast u64 operator) (cast u64 8)))
                                       (cast u64 operator)))]
                       (~check-build-code ~state operand)
                       (~check-build-code ~state immediate)
                       (~result-type :value value :start start :end (.end argument)))))
               (= ~form-id ~(p/code-nth forms 3)) (~array-parser ~state)
               (= ~form-id ~(p/code-nth forms 4)) (~object-parser ~state)
               (= ~form-id ~(p/code-nth forms 5)) (~jsx-parser ~state)
               (= ~form-id ~(p/code-nth forms 6)) (~regexp-parser ~state)
               (= ~form-id ~(p/code-nth forms 7)) (~number-parser ~state)
               :else (~fail-code ~state ~unexpected-error)))))))))))

(defn compile-program-root [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 5)
                (generator-form? production "program-root")))
      (generator-fail production "invalid program-root production")
    (let [state-type (backend-value backend "state-type")
          result-type (backend-value backend "direct-result-type")
          scratch-type (backend-value backend "parser-scratch-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          element-parser (backend-value backend
                           (p/code-sym (field-value production "element-parser")))
          check-id-code (backend-value backend "check-build-result-id")
          check-build-code (backend-value backend "check-build")
          fail-code (backend-value backend "fail")
          ok-error (backend-value backend "ok-error")
          builder-error (backend-value backend "builder-error")
          fallthrough-op (field-value production "fallthrough-op")]
      `(defn ~function-name
         [(source (ptr u8)) (source-size i64) (events (ptr u32)) (event-count i64)
          (ir-builder (ptr builder/IrBuilder)) (parser-scratch (ptr ~scratch-type))]
         (-> ~result-type)
         (let [root-region-result (builder/add-region! ir-builder (cast u32 ir/INVALID-ID))
               root-region (~check-id-code root-region-result)
               root-block-result (builder/add-block! ir-builder root-region)
               root-block (~check-id-code root-block-result)
               root-scope-result (builder/add-scope! ir-builder (cast u32 ir/INVALID-ID)
                                   (cast u32 0) (cast u32 source-size))
               root-scope (~check-id-code root-scope-result)
               state (p/alloc-stack ~state-type)
               lookup-valid (p/alloc-stack (array u8 64))
               lookup-hashes (p/alloc-stack (array u64 64))
               lookup-bindings (p/alloc-stack (array u32 64))
               lookup-counts (p/alloc-stack (array u32 64))
               lookup-starts (p/alloc-stack (array u32 64))
               lookup-ends (p/alloc-stack (array u32 64))]
           (let [(mut cache-index) 0]
             (loop
               (if (>= (load cache-index) 64) (break)
                 (do
                   (store! (p/index lookup-valid (load cache-index)) (cast u8 0))
                   (set! cache-index (+ (load cache-index) 1))))))
           (store! state (~state-type :source source :source-size source-size
                          :events events :event-count event-count :event-index 0
                          :builder ir-builder :scratch parser-scratch
                          :lookup-valid (p/cast (ptr u8) lookup-valid)
                          :lookup-hashes (p/cast (ptr u64) lookup-hashes)
                          :lookup-bindings (p/cast (ptr u32) lookup-bindings)
                          :lookup-counts (p/cast (ptr u32) lookup-counts)
                          :lookup-starts (p/cast (ptr u32) lookup-starts)
                          :lookup-ends (p/cast (ptr u32) lookup-ends)
                          :lookup-capacity 64
                          :block root-block :scope root-scope :function-scope root-scope
                          :break-target (cast u32 ir/INVALID-ID)
                          :continue-target (cast u32 ir/INVALID-ID)
                          :error (if (= (.error root-scope-result) builder/BUILD-OK)
                                     ~ok-error ~builder-error)
                          :error-offset (cast u32 0) :terminated false))
           (loop
             (if (or (>= (.event-index state) (.event-count state))
                     (!= (.error state) ~ok-error)) (break)
               (do
                 (if (.terminated state)
                     (let [arena (.arena (.builder state))
                           region (load (p/index (.block-regions arena)
                                                 (cast i64 (.block state))))
                           block-result (builder/add-block! (.builder state) region)
                           block (~check-build-code state block-result)]
                       (set! (.block state) block)
                       (set! (.terminated state) false)) 0)
                 (~element-parser state))))
           (if (and (= (.error state) ~ok-error) (not (.terminated state)))
               (let [unreachable (builder/add-op! ir-builder (.block state) ~fallthrough-op
                                  (cast u32 0) (cast u32 0)
                                  (cast u32 source-size) (cast u32 source-size)
                                  (cast u32 0))]
                 (~check-build-code state unreachable)) 0)
           (if (and (= (.error state) ~ok-error)
                    (!= (builder/finalize-membership! ir-builder) builder/BUILD-OK))
               (do (~fail-code state ~builder-error) 0) 0)
           (~result-type :error (.error state) :error-offset (.error-offset state)
                         :consumed-events (.event-index state)
                         :root-region root-region :root-block root-block))))))

(defn compile-conditional-statement [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 7)
                (generator-form? production "conditional-statement")))
      (generator-fail production "invalid conditional-statement production")
    (let [state-type (backend-value backend "state-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          current-position-code (backend-value backend "current-position")
          advance-code (backend-value backend "advance")
          consume-code (backend-value backend "consume-byte")
          parse-expression-code (backend-value backend "parse-expression")
          parse-statement-code (backend-value backend "parse-statement")
          current-keyword-code (backend-value backend "current-keyword")
          emit-branch-code (backend-value backend "emit-branch")
          check-build-code (backend-value backend "check-build")
          open (field-value production "open") close (field-value production "close")
          else-keyword (field-value production "else-keyword")
          branch-op (field-value production "branch-op")
          state (p/fresh-identifier "state")]
      `(defn ~function-name [(~state (ptr ~state-type))] (-> i64)
         (let [start (~current-position-code ~state) _keyword (~advance-code ~state)]
           (if (not (~consume-code ~state ~open)) 0
             (let [condition (~parse-expression-code ~state 0)]
               (if (not (~consume-code ~state ~close)) 0
                 (let [arena (.arena (.builder ~state)) origin (.block ~state)
                       region (load (p/index (.block-regions arena) (cast i64 origin)))
                       then-result (builder/add-block! (.builder ~state) region)
                       then-block (~check-build-code ~state then-result)
                       else-result (builder/add-block! (.builder ~state) region)
                       else-block (~check-build-code ~state else-result)
                       branch-result (builder/add-op! (.builder ~state) origin ~branch-op
                                      (cast u32 0) (cast u32 0) start
                                      (~current-position-code ~state) (cast u32 0))]
                   (let [branch (~check-build-code ~state branch-result)
                         operand (builder/add-operand! (.builder ~state) branch
                                                       (.value condition))
                         then-successor (builder/add-successor! (.builder ~state) branch
                                                                then-block)
                         else-successor (builder/add-successor! (.builder ~state) branch
                                                                else-block)]
                     (~check-build-code ~state operand)
                     (~check-build-code ~state then-successor)
                     (~check-build-code ~state else-successor))
                   (set! (.block ~state) then-block)
                   (set! (.terminated ~state) false)
                   (~parse-statement-code ~state)
                   (let [then-falls (not (.terminated ~state))]
                     (set! (.block ~state) else-block)
                     (set! (.terminated ~state) false)
                     (if (~current-keyword-code ~state ~else-keyword)
                         (do (~advance-code ~state) (~parse-statement-code ~state)) 0)
                     (let [else-falls (not (.terminated ~state))]
                       (if (or then-falls else-falls)
                           (let [join-result (builder/add-block! (.builder ~state) region)
                                 join-block (~check-build-code ~state join-result)]
                             (if then-falls
                                 (~emit-branch-code ~state then-block join-block) 0)
                             (if else-falls
                                 (~emit-branch-code ~state else-block join-block) 0)
                             (set! (.block ~state) join-block)
                             (set! (.terminated ~state) false))
                         (set! (.terminated ~state) true)))))))))
         0))))

(defn compile-loop-statement [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 6)
                (generator-form? production "loop-statement")))
      (generator-fail production "invalid loop-statement production")
    (let [state-type (backend-value backend "state-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          current-position-code (backend-value backend "current-position")
          advance-code (backend-value backend "advance")
          consume-code (backend-value backend "consume-byte")
          parse-expression-code (backend-value backend "parse-expression")
          parse-statement-code (backend-value backend "parse-statement")
          emit-branch-code (backend-value backend "emit-branch")
          check-build-code (backend-value backend "check-build")
          open (field-value production "open") close (field-value production "close")
          branch-op (field-value production "branch-op")
          state (p/fresh-identifier "state")]
      `(defn ~function-name [(~state (ptr ~state-type))] (-> i64)
         (let [start (~current-position-code ~state) _keyword (~advance-code ~state)]
           (if (not (~consume-code ~state ~open)) 0
             (let [arena (.arena (.builder ~state)) origin (.block ~state)
                   region (load (p/index (.block-regions arena) (cast i64 origin)))
                   header-result (builder/add-block! (.builder ~state) region)
                   header (~check-build-code ~state header-result)
                   body-result (builder/add-block! (.builder ~state) region)
                   body (~check-build-code ~state body-result)
                   exit-result (builder/add-block! (.builder ~state) region)
                   exit-block (~check-build-code ~state exit-result)]
               (~emit-branch-code ~state origin header)
               (set! (.block ~state) header)
               (set! (.terminated ~state) false)
               (let [condition (~parse-expression-code ~state 0)]
                 (if (not (~consume-code ~state ~close)) 0
                   (let [branch-result (builder/add-op! (.builder ~state) header ~branch-op
                                          (cast u32 0) (cast u32 0) start
                                          (~current-position-code ~state) (cast u32 0))]
                     (let [branch (~check-build-code ~state branch-result)
                           operand (builder/add-operand! (.builder ~state) branch
                                                         (.value condition))
                           body-successor (builder/add-successor! (.builder ~state) branch body)
                           exit-successor (builder/add-successor! (.builder ~state) branch
                                                                  exit-block)]
                       (~check-build-code ~state operand)
                       (~check-build-code ~state body-successor)
                       (~check-build-code ~state exit-successor))
                     (let [parent-break-target (.break-target ~state)
                           parent-continue-target (.continue-target ~state)]
                       (set! (.break-target ~state) exit-block)
                       (set! (.continue-target ~state) header)
                       (set! (.block ~state) body)
                       (set! (.terminated ~state) false)
                       (~parse-statement-code ~state)
                       (if (not (.terminated ~state))
                           (~emit-branch-code ~state (.block ~state) header) 0)
                       (set! (.break-target ~state) parent-break-target)
                       (set! (.continue-target ~state) parent-continue-target)
                       (set! (.block ~state) exit-block)
                       (set! (.terminated ~state) false))))))))
         0))))

(defn compile-post-test-loop-statement [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 8)
                (generator-form? production "post-test-loop-statement")))
      (generator-fail production "invalid post-test loop production")
    (let [state-type (backend-value backend "state-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          current-position-code (backend-value backend "current-position")
          current-keyword-code (backend-value backend "current-keyword-fast")
          advance-code (backend-value backend "advance")
          consume-code (backend-value backend "consume-byte")
          parse-expression-code (backend-value backend "parse-expression")
          parse-statement-code (backend-value backend "parse-statement")
          terminator-parser (backend-value backend
                              (p/code-sym (field-value production "terminator-parser")))
          emit-branch-code (backend-value backend "emit-branch")
          check-build-code (backend-value backend "check-build")
          fail-code (backend-value backend "fail")
          expected-error (backend-value backend "expected-error")
          while-keyword (field-value production "while-keyword")
          open (field-value production "open") close (field-value production "close")
          branch-op (field-value production "branch-op")
          state (p/fresh-identifier "state")]
      `(defn ~function-name [(~state (ptr ~state-type))] (-> i64)
         (let [start (~current-position-code ~state) _do (~advance-code ~state)
               arena (.arena (.builder ~state)) origin (.block ~state)
               region (load (p/index (.block-regions arena) (cast i64 origin)))
               body-result (builder/add-block! (.builder ~state) region)
               body (~check-build-code ~state body-result)
               condition-result (builder/add-block! (.builder ~state) region)
               condition-block (~check-build-code ~state condition-result)
               exit-result (builder/add-block! (.builder ~state) region)
               exit-block (~check-build-code ~state exit-result)
               parent-break-target (.break-target ~state)
               parent-continue-target (.continue-target ~state)]
           (~emit-branch-code ~state origin body)
           (set! (.break-target ~state) exit-block)
           (set! (.continue-target ~state) condition-block)
           (set! (.block ~state) body)
           (set! (.terminated ~state) false)
           (~parse-statement-code ~state)
           (if (not (.terminated ~state))
               (~emit-branch-code ~state (.block ~state) condition-block) 0)
           (set! (.break-target ~state) parent-break-target)
           (set! (.continue-target ~state) parent-continue-target)
           (if (not (~current-keyword-code ~state ~while-keyword))
               (do (~fail-code ~state ~expected-error) 0)
             (do
               (~advance-code ~state)
               (if (~consume-code ~state ~open)
                   (do
                     (set! (.block ~state) condition-block)
                     (set! (.terminated ~state) false)
                     (let [condition (~parse-expression-code ~state 0)]
                       (if (~consume-code ~state ~close)
                           (let [branch-result
                                  (builder/add-op! (.builder ~state) condition-block ~branch-op
                                    (cast u32 0) (cast u32 0) start
                                    (~current-position-code ~state) (cast u32 0))]
                             (let [branch (~check-build-code ~state branch-result)
                                   operand (builder/add-operand! (.builder ~state) branch
                                                                 (.value condition))
                                   body-successor (builder/add-successor! (.builder ~state)
                                                    branch body)
                                   exit-successor (builder/add-successor! (.builder ~state)
                                                    branch exit-block)]
                               (~check-build-code ~state operand)
                               (~check-build-code ~state body-successor)
                               (~check-build-code ~state exit-successor))
                             (~terminator-parser ~state (~current-position-code ~state))
                             (set! (.block ~state) exit-block)
                             (set! (.terminated ~state) false)) 0)) 0) 0))))
         0))))

(defn compile-for-kind-lookahead [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 12)
                (generator-form? production "for-kind-lookahead")))
      (generator-fail production "invalid for-kind-lookahead production")
    (let [state-type (backend-value backend "state-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          current-byte-code (backend-value backend "current-byte")
          current-keyword-code (backend-value backend "current-keyword")
          advance-code (backend-value backend "advance")
          for-keyword (field-value production "for-keyword")
          await-keyword (field-value production "await-keyword")
          in-keyword (field-value production "in-keyword")
          of-keyword (field-value production "of-keyword")
          open (field-value production "open") close (field-value production "close")
          nested-opens (field-value production "nested-opens")
          nested-closes (field-value production "nested-closes")
          separator (field-value production "separator")
          state (p/fresh-identifier "state") byte-id (p/fresh-identifier "byte")]
      `(defn ~function-name :inline (Always) [(~state (ptr ~state-type))] (-> i64)
         (let [saved-index (.event-index ~state) (mut kind) 0 (mut depth) 0
               (mut awaiting) false]
           (if (~current-keyword-code ~state ~for-keyword)
               (do
                 (~advance-code ~state)
                 (if (~current-keyword-code ~state ~await-keyword)
                     (do (store! awaiting true) (~advance-code ~state) 0) 0)
                 (if (= (~current-byte-code ~state) ~open)
                     (do
                       (~advance-code ~state)
                       (loop
                         (if (>= (.event-index ~state) (.event-count ~state)) (break)
                           (let [~byte-id (~current-byte-code ~state)]
                             (if (and (= (load depth) 0)
                                      (= ~byte-id ~separator))
                                 (break)
                               (if (and (= (load depth) 0)
                                        (~current-keyword-code ~state ~in-keyword))
                                   (do (if (not (load awaiting)) (store! kind 1) 0) (break))
                                 (if (and (= (load depth) 0)
                                          (~current-keyword-code ~state ~of-keyword))
                                     ;; `for await` remains rejected until async-function context
                                     ;; is represented in parser state. Ordinary `for…of` is kind 2.
                                     (do (if (not (load awaiting)) (store! kind 2) 0) (break))
                                   (if (and (= (load depth) 0) (= ~byte-id ~close))
                                       (break)
                                     (do
                                       (if (or ~@(let [checks (p/code-list-new) (mut j) 0]
                                                    (loop
                                                      (if (>= (load j)
                                                              (p/code-count nested-opens)) (break)
                                                        (do (p/code-list-push! checks
                                                              `(= ~byte-id
                                                                  ~(p/code-nth nested-opens
                                                                     (load j))))
                                                            (set! j (+ (load j) 1)))))
                                                    (p/code-list-done checks)))
                                           (set! depth (+ (load depth) 1))
                                         (if (or ~@(let [checks (p/code-list-new) (mut j) 0]
                                                      (loop
                                                        (if (>= (load j)
                                                                (p/code-count nested-closes)) (break)
                                                          (do (p/code-list-push! checks
                                                                `(= ~byte-id
                                                                    ~(p/code-nth nested-closes
                                                                       (load j))))
                                                              (set! j (+ (load j) 1)))))
                                                      (p/code-list-done checks)))
                                             (if (> (load depth) 0)
                                                 (set! depth (- (load depth) 1)) 0) 0))
                                       (~advance-code ~state)))))))))) 0)) 0)
           (set! (.event-index ~state) saved-index)
           (load kind))))))

(defn compile-for-dispatch [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 6)
                (generator-form? production "for-dispatch")))
      (generator-fail production "invalid for-dispatch production")
    (let [state-type (backend-value backend "state-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          lookahead-code (backend-value backend
                           (p/code-sym (field-value production "lookahead")))
          classic-code (backend-value backend
                         (p/code-sym (field-value production "classic-parser")))
          iterator-code (backend-value backend
                          (p/code-sym (field-value production "iterator-parser")))
          state (p/fresh-identifier "state")]
      `(defn ~function-name [(~state (ptr ~state-type))] (-> i64)
         (if (= (~lookahead-code ~state) 0)
             (~classic-code ~state)
           (~iterator-code ~state))))))

(defn compile-iterator-for-statement [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 20)
                (generator-form? production "iterator-for-statement")))
      (generator-fail production "invalid iterator-for-statement production")
    (let [state-type (backend-value backend "state-type")
          result-type (backend-value backend "expression-result-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          lookahead-code (backend-value backend
                           (p/code-sym (field-value production "lookahead")))
          current-position-code (backend-value backend "current-position")
          current-byte-code (backend-value backend "current-byte")
          current-keyword-code (backend-value backend "current-keyword-fast")
          word-end-code (backend-value backend "word-end")
          advance-code (backend-value backend "advance")
          consume-code (backend-value backend "consume-byte")
          parse-expression-code (backend-value backend "parse-expression")
          parse-statement-code (backend-value backend "parse-statement")
          pattern-parser (backend-value backend
                           (p/code-sym (field-value production "pattern-parser")))
          emit-branch-code (backend-value backend "emit-branch")
          check-build-code (backend-value backend "check-build")
          fail-code (backend-value backend "fail")
          expected-error (backend-value backend "expected-error")
          open (field-value production "open") close (field-value production "close")
          await-keyword (field-value production "await-keyword")
          in-keyword (field-value production "in-keyword")
          of-keyword (field-value production "of-keyword")
          declaration-kinds (field-value production "declaration-kinds")
          equals (field-value production "equals") comma (field-value production "comma")
          target-ops (field-value production "target-ops")
          target-precedence (field-value production "target-precedence")
          declare-op (field-value production "declare-op")
          assign-op (field-value production "assign-op")
          iterator-init-op (field-value production "iterator-init-op")
          iterator-next-op (field-value production "iterator-next-op")
          branch-op (field-value production "branch-op")
          state (p/fresh-identifier "state") target-op-id (p/fresh-identifier "target-op")
          declaration-kind-id (p/fresh-identifier "declaration-kind")]
      `(defn ~function-name [(~state (ptr ~state-type))] (-> i64)
         (let [iterator-kind (~lookahead-code ~state)
               start (~current-position-code ~state) _for (~advance-code ~state)]
           (if (= iterator-kind 3) (do (~advance-code ~state) 0) 0)
           (if (~consume-code ~state ~open)
               (let [parent-scope (.scope ~state)
                     scope-result (builder/add-scope! (.builder ~state) parent-scope start
                                    (cast u32 (.source-size ~state)))
                     loop-scope (~check-build-code ~state scope-result)
                     arena (.arena (.builder ~state)) origin (.block ~state)
                     region (load (p/index (.block-regions arena) (cast i64 origin)))
                     header-result (builder/add-block! (.builder ~state) region)
                     header (~check-build-code ~state header-result)
                     body-result (builder/add-block! (.builder ~state) region)
                     body (~check-build-code ~state body-result)
                     exit-result (builder/add-block! (.builder ~state) region)
                     exit-block (~check-build-code ~state exit-result)
                     target-start (~current-position-code ~state)
                     target-name-end (~word-end-code ~state target-start)
                     (mut ~declaration-kind-id) (cast u64 0)
                     (mut target-value) (cast u32 ir/INVALID-ID)]
                 (set! (.scope ~state) loop-scope)
                 (set! (.block ~state) body)
                 (if (or ~@(let [checks (p/code-list-new) (mut j) 0]
                              (loop
                                (if (>= (load j) (p/code-count declaration-kinds)) (break)
                                  (let [entry (p/code-nth declaration-kinds (load j))]
                                    (p/code-list-push! checks
                                      `(~current-keyword-code ~state ~(p/code-nth entry 0)))
                                    (set! j (+ (load j) 1)))))
                              (p/code-list-done checks)))
                     (do
                       ~(let [clauses (p/code-list-new) (mut j) 0]
                           (loop
                             (if (>= (load j) (p/code-count declaration-kinds)) (break)
                               (let [entry (p/code-nth declaration-kinds (load j))]
                                 (p/code-list-push! clauses
                                   `(~current-keyword-code ~state ~(p/code-nth entry 0)))
                                 (p/code-list-push! clauses
                                   `(store! ~declaration-kind-id ~(p/code-nth entry 1)))
                                 (set! j (+ (load j) 1)))))
                           `(cond ~@(p/code-list-done clauses) :else 0))
                       (~advance-code ~state)
                       (~pattern-parser ~state false ~equals ~comma))
                   (let [target (~parse-expression-code ~state ~target-precedence)
                         definition-kind
                           (load (p/index (.value-def-kinds arena)
                                          (cast i64 (.value target))))
                         definition-index
                           (load (p/index (.value-def-indices arena)
                                          (cast i64 (.value target))))
                         ~target-op-id
                           (if (= definition-kind (cast u8 ir/DEF-OP-RESULT))
                               (load (p/index (.opcodes arena) (cast i64 definition-index)))
                             ir/OP-INVALID)]
                     (if (or ~@(let [checks (p/code-list-new) (mut j) 0]
                                    (loop
                                      (if (>= (load j) (p/code-count target-ops)) (break)
                                        (do (p/code-list-push! checks
                                              `(= ~target-op-id
                                                  ~(p/code-nth target-ops (load j))))
                                            (set! j (+ (load j) 1)))))
                                    (p/code-list-done checks)))
                         (store! target-value (.value target))
                       (do (~fail-code ~state ~expected-error) 0))))
                 (if (if (= iterator-kind 1)
                         (~current-keyword-code ~state ~in-keyword)
                       (~current-keyword-code ~state ~of-keyword))
                     (~advance-code ~state)
                   (do (~fail-code ~state ~expected-error) 0))
                 (set! (.block ~state) origin)
                 (let [iterable (~parse-expression-code ~state 0)]
                   (if (~consume-code ~state ~close)
                       (let [iterator-value (.value-count arena)
                             init-result (builder/add-op! (.builder ~state) origin
                                           ~iterator-init-op (cast u32 0) (cast u32 0)
                                           (.start iterable) (.end iterable) (cast u32 1))
                             init-op (~check-build-code ~state init-result)
                             init-operand (builder/add-operand! (.builder ~state) init-op
                                            (.value iterable))
                             init-kind (builder/set-op-immediate! (.builder ~state) init-op
                                         (cast u64 iterator-kind))]
                         (~check-build-code ~state init-operand)
                         (~check-build-code ~state init-kind)
                         (~emit-branch-code ~state origin header)
                         (set! (.block ~state) header)
                         (set! (.terminated ~state) false)
                         (let [next-value (.value-count arena)
                               next-result (builder/add-op! (.builder ~state) header
                                             ~iterator-next-op (cast u32 0) (cast u32 0)
                                             start (~current-position-code ~state) (cast u32 2))
                               next-op (~check-build-code ~state next-result)
                               next-operand (builder/add-operand! (.builder ~state) next-op
                                              iterator-value)
                               branch-result (builder/add-op! (.builder ~state) header ~branch-op
                                               (cast u32 0) (cast u32 0) start
                                               (~current-position-code ~state) (cast u32 0))
                               branch (~check-build-code ~state branch-result)
                               condition-operand (builder/add-operand! (.builder ~state) branch
                                                   next-value)
                               body-successor (builder/add-successor! (.builder ~state) branch body)
                               exit-successor (builder/add-successor! (.builder ~state) branch
                                                exit-block)]
                           (~check-build-code ~state next-operand)
                           (~check-build-code ~state condition-operand)
                           (~check-build-code ~state body-successor)
                           (~check-build-code ~state exit-successor)
                           (set! (.block ~state) body)
                           (if (!= (load ~declaration-kind-id) (cast u64 0))
                               (let [declaration-result
                                      (builder/add-op! (.builder ~state) body ~declare-op
                                        target-start (~current-position-code ~state)
                                        target-start (~current-position-code ~state) (cast u32 0))
                                     declaration (~check-build-code ~state declaration-result)
                                     operand (builder/add-operand! (.builder ~state) declaration
                                               (+ next-value (cast u32 1)))
                                     kind-result (builder/set-op-immediate! (.builder ~state)
                                                   declaration (load ~declaration-kind-id))]
                                 (~check-build-code ~state operand)
                                 (~check-build-code ~state kind-result))
                             (let [assignment-result
                                    (builder/add-op! (.builder ~state) body ~assign-op
                                      (cast u32 0) (cast u32 0) target-start
                                      (~current-position-code ~state) (cast u32 1))
                                   assignment (~check-build-code ~state assignment-result)
                                   target-operand (builder/add-operand! (.builder ~state)
                                                    assignment (load target-value))
                                   value-operand (builder/add-operand! (.builder ~state)
                                                   assignment (+ next-value (cast u32 1)))]
                               (~check-build-code ~state target-operand)
                               (~check-build-code ~state value-operand)))
                           (let [parent-break-target (.break-target ~state)
                                 parent-continue-target (.continue-target ~state)]
                             (set! (.break-target ~state) exit-block)
                             (set! (.continue-target ~state) header)
                             (set! (.terminated ~state) false)
                             (~parse-statement-code ~state)
                             (if (not (.terminated ~state))
                                 (~emit-branch-code ~state (.block ~state) header) 0)
                             (set! (.break-target ~state) parent-break-target)
                             (set! (.continue-target ~state) parent-continue-target))
                           (let [end (~current-position-code ~state)
                                 scope-end (builder/set-scope-end! (.builder ~state)
                                             loop-scope end)]
                             (~check-build-code ~state scope-end))
                           (set! (.scope ~state) parent-scope)
                           (set! (.block ~state) exit-block)
                           (set! (.terminated ~state) false))) 0) 0))
               (do (~fail-code ~state ~expected-error) 0)))
         0))))

(defn compile-for-statement [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 9)
                (generator-form? production "for-statement")))
      (generator-fail production "invalid for-statement production")
    (let [state-type (backend-value backend "state-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          current-position-code (backend-value backend "current-position")
          current-byte-code (backend-value backend "current-byte")
          current-keyword-code (backend-value backend "current-keyword-fast")
          advance-code (backend-value backend "advance")
          consume-code (backend-value backend "consume-byte")
          parse-expression-code (backend-value backend "parse-expression")
          parse-statement-code (backend-value backend "parse-statement")
          declaration-parser (backend-value backend
                               (p/code-sym (field-value production "declaration-parser")))
          emit-branch-code (backend-value backend "emit-branch")
          check-build-code (backend-value backend "check-build")
          fail-code (backend-value backend "fail")
          expected-error (backend-value backend "expected-error")
          open (field-value production "open") close (field-value production "close")
          separator (field-value production "separator")
          declaration-keywords (field-value production "declaration-keywords")
          branch-op (field-value production "branch-op")
          state (p/fresh-identifier "state")]
      `(defn ~function-name [(~state (ptr ~state-type))] (-> i64)
         (let [start (~current-position-code ~state) _for (~advance-code ~state)
               parent-scope (.scope ~state)]
           (if (~consume-code ~state ~open)
               (let [scope-result (builder/add-scope! (.builder ~state) parent-scope start
                                    (cast u32 (.source-size ~state)))
                     loop-scope (~check-build-code ~state scope-result)]
                 (set! (.scope ~state) loop-scope)
                 (if (= (~current-byte-code ~state) ~separator)
                     (do (~advance-code ~state) 0)
                   (if (or ~@(let [checks (p/code-list-new) (mut j) 0]
                               (loop
                                 (if (>= (load j) (p/code-count declaration-keywords)) (break)
                                   (do
                                     (p/code-list-push! checks
                                       `(~current-keyword-code ~state
                                          ~(p/code-nth declaration-keywords (load j))))
                                     (set! j (+ (load j) 1)))))
                               (p/code-list-done checks)))
                       (~declaration-parser ~state)
                     (do
                       (~parse-expression-code ~state 0)
                       (~consume-code ~state ~separator)
                       0)))
                 (let [arena (.arena (.builder ~state)) origin (.block ~state)
                       region (load (p/index (.block-regions arena) (cast i64 origin)))
                       header-result (builder/add-block! (.builder ~state) region)
                       header (~check-build-code ~state header-result)
                       update-result (builder/add-block! (.builder ~state) region)
                       update-block (~check-build-code ~state update-result)
                       body-result (builder/add-block! (.builder ~state) region)
                       body (~check-build-code ~state body-result)
                       exit-result (builder/add-block! (.builder ~state) region)
                       exit-block (~check-build-code ~state exit-result)]
                   (~emit-branch-code ~state origin header)
                   (set! (.block ~state) header)
                   (set! (.terminated ~state) false)
                   (if (= (~current-byte-code ~state) ~separator)
                       (do
                         (~advance-code ~state)
                         (~emit-branch-code ~state header body))
                     (let [condition (~parse-expression-code ~state 0)]
                       (if (~consume-code ~state ~separator)
                           (let [branch-result
                                  (builder/add-op! (.builder ~state) header ~branch-op
                                    (cast u32 0) (cast u32 0) start
                                    (~current-position-code ~state) (cast u32 0))]
                             (let [branch (~check-build-code ~state branch-result)
                                   operand (builder/add-operand! (.builder ~state) branch
                                                                 (.value condition))
                                   body-successor (builder/add-successor! (.builder ~state)
                                                    branch body)
                                   exit-successor (builder/add-successor! (.builder ~state)
                                                    branch exit-block)]
                               (~check-build-code ~state operand)
                               (~check-build-code ~state body-successor)
                               (~check-build-code ~state exit-successor)
                               0)) 0)))
                   (set! (.block ~state) update-block)
                   (set! (.terminated ~state) false)
                   (if (= (~current-byte-code ~state) ~close) 0
                     (do (~parse-expression-code ~state 0) 0))
                   (if (~consume-code ~state ~close)
                       (do
                         (~emit-branch-code ~state update-block header)
                         (let [parent-break-target (.break-target ~state)
                               parent-continue-target (.continue-target ~state)]
                           (set! (.break-target ~state) exit-block)
                           (set! (.continue-target ~state) update-block)
                           (set! (.block ~state) body)
                           (set! (.terminated ~state) false)
                           (~parse-statement-code ~state)
                           (if (not (.terminated ~state))
                               (~emit-branch-code ~state (.block ~state) update-block) 0)
                           (set! (.break-target ~state) parent-break-target)
                           (set! (.continue-target ~state) parent-continue-target)
                           (let [end (~current-position-code ~state)
                                 scope-end (builder/set-scope-end! (.builder ~state)
                                             loop-scope end)]
                             (~check-build-code ~state scope-end))
                           (set! (.scope ~state) parent-scope)
                           (set! (.block ~state) exit-block)
                           (set! (.terminated ~state) false))
                         0) 0)))
             (do (~fail-code ~state ~expected-error) 0)))
         0))))

(defn compile-function-expression [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 13)
                (generator-form? production "function-expression")))
      (generator-fail production "invalid function-expression production")
    (let [state-type (backend-value backend "state-type")
          result-type (backend-value backend "expression-result-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          current-position-code (backend-value backend "current-position")
          current-byte-code (backend-value backend "current-byte")
          event-position-code (backend-value backend "event-position")
          word-end-code (backend-value backend "word-end")
          advance-code (backend-value backend "advance")
          consume-code (backend-value backend "consume-byte")
          check-build-code (backend-value backend "check-build")
          parse-block-code (backend-value backend "parse-block")
          parse-type-code (backend-value backend
                            (p/code-sym (field-value production "type-parser")))
          parse-type-parameters-code (backend-value backend
              (p/code-sym (field-value production "type-parameters-parser")))
          pattern-parser-code (backend-value backend
              (p/code-sym (field-value production "pattern-parser")))
          ok-error (backend-value backend "ok-error")
          open (field-value production "open") comma (field-value production "separator")
          close (field-value production "close") function-op (field-value production "emit-op")
          type-prefix (field-value production "type-prefix")
          type-parameters-open (field-value production "type-parameters-open")
          return-op (field-value production "fallthrough-op")
          state (p/fresh-identifier "state")]
      `(defn ~function-name [(~state (ptr ~state-type))] (-> ~result-type)
         (let [start (~current-position-code ~state) parent-block (.block ~state)
               parent-scope (.scope ~state) parent-function-scope (.function-scope ~state)
               parent-break-target (.break-target ~state)
               parent-continue-target (.continue-target ~state)
               parent-terminated (.terminated ~state) _keyword (~advance-code ~state)
               name-start (~current-position-code ~state)
               name-end (~word-end-code ~state name-start)
               named (!= name-start name-end)
               _name (if named (~advance-code ~state) 0)
               arena (.arena (.builder ~state)) value (.value-count arena)
               function-result (builder/add-op! (.builder ~state) parent-block
                                 ~function-op
                                 (if named name-start (cast u32 0))
                                 (if named name-end (cast u32 0))
                                 start start (cast u32 1))
               function-op-id (~check-build-code ~state function-result)
               region-result (builder/add-region! (.builder ~state) function-op-id)
               region (~check-build-code ~state region-result)
               attached (builder/add-op-region! (.builder ~state) function-op-id region)
               entry-result (builder/add-block! (.builder ~state) region)
               entry (~check-build-code ~state entry-result)
               scope-result (builder/add-scope! (.builder ~state) parent-scope start
                              (cast u32 (.source-size ~state)))
               function-scope (~check-build-code ~state scope-result)]
           (~check-build-code ~state attached)
           (set! (.scope ~state) function-scope)
           (if named
               (let [binding (builder/add-binding! (.builder ~state) function-scope
                                                    name-start name-end)]
                 (~check-build-code ~state binding)) 0)
           (if (= (~current-byte-code ~state) ~type-parameters-open)
               (~parse-type-parameters-code ~state) 0)
           (if (~consume-code ~state ~open)
               (do
                 (if (= (~current-byte-code ~state) ~close) 0
                   (loop
                     (~pattern-parser-code ~state true ~comma ~close)
                     (if (= (~current-byte-code ~state) ~comma)
                         (do (~advance-code ~state) 0) (break))))
                 (if (~consume-code ~state ~close)
                     (do
                       (if (= (~current-byte-code ~state) ~type-prefix)
                           (~parse-type-code ~state (cast u8 123) (cast u8 123)) 0)
                       (set! (.block ~state) entry)
                       (set! (.scope ~state) function-scope)
                       (set! (.function-scope ~state) function-scope)
                       (set! (.break-target ~state) (cast u32 ir/INVALID-ID))
                       (set! (.continue-target ~state) (cast u32 ir/INVALID-ID))
                       (set! (.terminated ~state) false)
                       (~parse-block-code ~state)
                       (let [end (if (> (.event-index ~state) 0)
                                      (+ (~event-position-code
                                           (load (p/index (.events ~state)
                                                   (- (.event-index ~state) 1))))
                                         (cast u32 1))
                                    (~current-position-code ~state))]
                         (if (and (= (.error ~state) ~ok-error)
                                  (not (.terminated ~state)))
                             (let [return-result (builder/add-op! (.builder ~state)
                                                  (.block ~state) ~return-op
                                                  (cast u32 0) (cast u32 0)
                                                  end end (cast u32 0))]
                               (~check-build-code ~state return-result)) 0)
                         (~check-build-code ~state
                           (builder/set-scope-end! (.builder ~state) function-scope end))
                         (~check-build-code ~state
                           (builder/set-op-span! (.builder ~state) function-op-id start end))
                         (set! (.block ~state) parent-block)
                         (set! (.scope ~state) parent-scope)
                         (set! (.function-scope ~state) parent-function-scope)
                         (set! (.break-target ~state) parent-break-target)
                         (set! (.continue-target ~state) parent-continue-target)
                         (set! (.terminated ~state) parent-terminated)
                         (~result-type :value value :start start :end end)))
                   (~result-type :value value :start start :end start)))
             (~result-type :value value :start start :end start)))))))

(defn compile-function-declaration [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 13)
                (generator-form? production "function-declaration")))
      (generator-fail production "invalid function-declaration production")
    (let [state-type (backend-value backend "state-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          current-position-code (backend-value backend "current-position")
          current-byte-code (backend-value backend "current-byte")
          word-end-code (backend-value backend "word-end")
          advance-code (backend-value backend "advance")
          consume-code (backend-value backend "consume-byte")
          fail-code (backend-value backend "fail")
          check-build-code (backend-value backend "check-build")
          parse-block-code (backend-value backend "parse-block")
          parse-type-code (backend-value backend
                            (p/code-sym (field-value production "type-parser")))
          parse-type-parameters-code (backend-value backend
              (p/code-sym (field-value production "type-parameters-parser")))
          pattern-parser-code (backend-value backend
              (p/code-sym (field-value production "pattern-parser")))
          ok-error (backend-value backend "ok-error")
          expected-error (backend-value backend "expected-error")
          open (field-value production "open") comma (field-value production "separator")
          close (field-value production "close") function-op (field-value production "emit-op")
          type-prefix (field-value production "type-prefix")
          type-parameters-open (field-value production "type-parameters-open")
          return-op (field-value production "fallthrough-op")
          state (p/fresh-identifier "state")]
      `(defn ~function-name [(~state (ptr ~state-type))] (-> i64)
         (let [start (~current-position-code ~state) parent-block (.block ~state)
               parent-scope (.scope ~state) parent-function-scope (.function-scope ~state)
               parent-break-target (.break-target ~state)
               parent-continue-target (.continue-target ~state)
               parent-terminated (.terminated ~state) _keyword (~advance-code ~state)
               name-start (~current-position-code ~state)
               name-end (~word-end-code ~state name-start)]
           (if (= name-start name-end)
               (do (~fail-code ~state ~expected-error) 0)
             (do
               (~advance-code ~state)
               (if (= (~current-byte-code ~state) ~type-parameters-open)
                   (~parse-type-parameters-code ~state) 0)
               (let [binding-result (builder/add-binding! (.builder ~state) parent-scope
                                                           name-start name-end)]
                 (~check-build-code ~state binding-result))
               (let [function-result (builder/add-op! (.builder ~state) parent-block
                                      ~function-op name-start name-end start start
                                      (cast u32 0))
                     function-op-id (~check-build-code ~state function-result)
                     region-result (builder/add-region! (.builder ~state) function-op-id)
                     region (~check-build-code ~state region-result)
                     attached (builder/add-op-region! (.builder ~state) function-op-id region)
                     entry-result (builder/add-block! (.builder ~state) region)
                     entry (~check-build-code ~state entry-result)
                     scope-result (builder/add-scope! (.builder ~state) parent-scope start
                                      (cast u32 (.source-size ~state)))
                     function-scope (~check-build-code ~state scope-result)]
                 (~check-build-code ~state attached)
                 (set! (.scope ~state) function-scope)
                 (if (~consume-code ~state ~open)
                     (do
                       (if (= (~current-byte-code ~state) ~close) 0
                         (loop
                           (~pattern-parser-code ~state true ~comma ~close)
                           (if (= (~current-byte-code ~state) ~comma)
                               (do (~advance-code ~state) 0) (break))))
                       (if (~consume-code ~state ~close)
                           (do
                             (if (= (~current-byte-code ~state) ~type-prefix)
                                 (~parse-type-code ~state
                                   (cast u8 123) (cast u8 123)) 0)
                             (set! (.block ~state) entry)
                             (set! (.scope ~state) function-scope)
                             (set! (.function-scope ~state) function-scope)
                             (set! (.break-target ~state) (cast u32 ir/INVALID-ID))
                             (set! (.continue-target ~state) (cast u32 ir/INVALID-ID))
                             (set! (.terminated ~state) false)
                             (~parse-block-code ~state)
                             (let [end (~current-position-code ~state)]
                               (if (and (= (.error ~state) ~ok-error)
                                        (not (.terminated ~state)))
                                   (let [return-result (builder/add-op! (.builder ~state)
                                                        (.block ~state) ~return-op
                                                        (cast u32 0) (cast u32 0)
                                                        end end (cast u32 0))]
                                     (~check-build-code ~state return-result)) 0)
                               (let [scope-end (builder/set-scope-end! (.builder ~state)
                                                                      function-scope end)
                                     op-end (builder/set-op-span! (.builder ~state)
                                                                  function-op-id start end)]
                                 (~check-build-code ~state scope-end)
                                 (~check-build-code ~state op-end)))
                             (set! (.block ~state) parent-block)
                             (set! (.scope ~state) parent-scope)
                             (set! (.function-scope ~state) parent-function-scope)
                             (set! (.break-target ~state) parent-break-target)
                             (set! (.continue-target ~state) parent-continue-target)
                             (set! (.terminated ~state) parent-terminated)) 0)) 0)))))
         0))))

(defn compile-assignment-condition
  [(operators Code) (index i64) (state Code) (current-byte-code Code)
   (adjacent-byte-code Code)] (-> Code)
  (if (>= index (p/code-count operators)) `0
    (let [operator (p/code-nth operators index) text (p/code-str operator)
          width (len text) (mut byte-index) 0 conditions (p/code-list-new)]
      (if (or (= width 0) (> width 4))
          (do (p/report operator "assignment operator width must be in [1, 4]") `0)
        (do
          (loop
            (if (>= (load byte-index) width) (break)
              (do
                (p/code-list-push! conditions
                  (if (= (load byte-index) 0)
                      `(= (~current-byte-code ~state)
                          (cast u8 ~(cast i64 (slice-get text 0))))
                    `(= (~adjacent-byte-code ~state ~(load byte-index))
                        (cast u8 ~(cast i64 (slice-get text (load byte-index)))))))
                (set! byte-index (+ (load byte-index) 1)))))
          `(if (and ~@(p/code-list-done conditions)) ~width
             ~(compile-assignment-condition operators (+ index 1) state
                current-byte-code adjacent-byte-code)))))))

(defn compile-word-operator-info [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 5)
                (generator-form? production "word-operator-info")))
      (generator-fail production "invalid word-operator-info production")
    (let [state-type (backend-value backend "state-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          current-event-code (backend-value backend "current-event")
          event-kind-code (backend-value backend "event-kind")
          current-position-code (backend-value backend "current-position")
          word-end-code (backend-value backend "word-end")
          span-equals-code (backend-value backend "span-equals")
          word-event (field-value production "word-event")
          word-operators (field-value production "word-operators")
          state (p/fresh-identifier "state")
          start (p/fresh-identifier "word-start")
          end (p/fresh-identifier "word-end")]
      `(defn ~function-name :inline (Never) [(~state (ptr ~state-type))] (-> i64)
         (if (!= (~event-kind-code (~current-event-code ~state))
                 (cast u8 ~word-event)) 0
           (let [~start (~current-position-code ~state)
                 ~end (~word-end-code ~state ~start)]
             (cond
               ~@(let [clauses (p/code-list-new) (mut w) 0]
                   (loop
                     (if (>= (load w) (p/code-count word-operators)) (break)
                       (let [entry (p/code-nth word-operators (load w))]
                         (p/code-list-push! clauses
                           `(~span-equals-code ~state ~start ~end ~(p/code-nth entry 0)))
                         (p/code-list-push! clauses `(+ (* ~(p/code-nth entry 1) 256) 1))
                         (set! w (+ (load w) 1)))))
                   (p/code-list-push! clauses `:else)
                   (p/code-list-push! clauses `0)
                   (p/code-list-done clauses)))))))))

(defn compile-precedence-expression [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 20)
                (generator-form? production "precedence-expression")))
      (generator-fail production "invalid precedence-expression production")
    (let [state-type (backend-value backend "state-type")
          result-type (backend-value backend "expression-result-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          postfix-parser (backend-value backend
                           (p/code-sym (field-value production "operand-parser")))
          current-byte-code (backend-value backend "current-byte")
          adjacent-byte-code (backend-value backend "adjacent-event-byte")
          word-end-code (backend-value backend "word-end")
          lookahead-code (backend-value backend "binary-lookahead")
          info-code (backend-value backend "binary-info")
          advance-count-code (backend-value backend "advance-count")
          advance-code (backend-value backend "advance")
          consume-code (backend-value backend "consume-byte")
          current-position-code (backend-value backend "current-position")
          check-build-code (backend-value backend "check-build")
          emit-branch-arg-code (backend-value backend "emit-branch-arg")
          fail-code (backend-value backend "fail")
          ok-error (backend-value backend "ok-error")
          expected-error (backend-value backend "expected-error")
          binary-op (field-value production "binary-op")
          exponent-first (field-value production "exponent-first")
          exponent-width (field-value production "exponent-width")
          unary-op (field-value production "unary-op")
          update-first-bytes (field-value production "update-first-bytes")
          conditional-max (field-value production "conditional-max-precedence")
          question (field-value production "question") colon (field-value production "colon")
          alternate-precedence (field-value production "alternate-precedence")
          assignment-max (field-value production "assignment-max-precedence")
          assignment-operators (field-value production "assignment-operators")
          assignment-op (field-value production "assignment-op")
          short-circuit-operators (field-value production "short-circuit-operators")
          word-info-function (backend-value backend
                               (p/code-sym (field-value production "word-info-function")))
          nullish-op (field-value production "nullish-op")
          branch-op (field-value production "branch-op")
          state (p/fresh-identifier "state") minimum (p/fresh-identifier "minimum")
          byte0-id (p/fresh-identifier "byte0")
          immediate-id (p/fresh-identifier "immediate")
          operator-start-id (p/fresh-identifier "operator-start")
          operator-end-id (p/fresh-identifier "operator-end")
          word-info-id (p/fresh-identifier "word-info")]
      `(defn ~function-name [(~state (ptr ~state-type)) (~minimum i64)] (-> ~result-type)
         (let [(mut left) (~postfix-parser ~state) (mut logical-family) 0]
           (loop
             (let [~byte0-id (~current-byte-code ~state)
                   ~word-info-id
                     (if (= ~byte0-id (cast u8 105))
                         (~word-info-function ~state)
                       0)
                   lookahead (~lookahead-code ~byte0-id)
                   byte1 (if (> lookahead 1) (~adjacent-byte-code ~state 1) (cast u8 0))
                   byte2 (if (> lookahead 2) (~adjacent-byte-code ~state 2) (cast u8 0))
                   raw-info (if (= (.error ~state) ~ok-error)
                                (if (> ~word-info-id 0) ~word-info-id
                                  (~info-code ~byte0-id byte1 byte2)) 0)
                   raw-meta (% raw-info 256)
                   raw-width (% raw-meta 128)
                   info (if (or (and (= ~word-info-id 0) (> raw-width 0)
                                     (= (~adjacent-byte-code ~state raw-width)
                                        (cast u8 61)))
                                (and (= raw-width 1)
                                  (or ~@(let [checks (p/code-list-new) (mut j) 0]
                                          (loop
                                            (if (>= (load j)
                                                    (p/code-count update-first-bytes)) (break)
                                              (do
                                                (p/code-list-push! checks
                                                  `(= ~byte0-id
                                                      ~(p/code-nth update-first-bytes
                                                         (load j))))
                                                (set! j (+ (load j) 1)))))
                                          (p/code-list-done checks)))
                                  (= (~adjacent-byte-code ~state 1) ~byte0-id)))
                            0 raw-info)
                   precedence (/ info 256)]
               (if (or (= precedence 0) (< precedence ~minimum)) (break)
                 (let [meta (% info 256)
                       width (% meta 128)
                       right-associative (>= meta 128)
                       word-operator (> ~word-info-id 0)
                       ~operator-start-id (if word-operator
                                            (~current-position-code ~state) (cast u32 0))
                       ~operator-end-id (if word-operator
                                          (~word-end-code ~state ~operator-start-id)
                                          (cast u32 0))
                       ~immediate-id (if (> ~word-info-id 0) (cast u64 0)
                         (p/ior (cast u64 ~byte0-id)
                           (p/ior (p/ishl (cast u64 byte1) (cast u64 8))
                                  (p/ishl (cast u64 byte2) (cast u64 16)))))
                       short-mode
                         (cond
                           ~@(let [clauses (p/code-list-new) (mut k) 0]
                               (loop
                                 (if (>= (load k) (p/code-count short-circuit-operators))
                                     (break)
                                   (let [entry (p/code-nth short-circuit-operators (load k))]
                                     (p/code-list-push! clauses
                                       `(= ~immediate-id (cast u64 ~(p/code-nth entry 0))))
                                     (p/code-list-push! clauses (p/code-nth entry 1))
                                     (set! k (+ (load k) 1)))))
                               (p/code-list-push! clauses `:else)
                               (p/code-list-push! clauses `0)
                               (p/code-list-done clauses)))]
                   (let [old-left (load left)
                         arena-before (.arena (.builder ~state))
                         definition-kind (load (p/index (.value-def-kinds arena-before)
                                                        (cast i64 (.value old-left))))
                         definition-index (load (p/index (.value-def-indices arena-before)
                                                         (cast i64 (.value old-left))))
                         left-opcode (if (= definition-kind (cast u8 ir/DEF-OP-RESULT))
                                         (load (p/index (.opcodes arena-before)
                                                        (cast i64 definition-index)))
                                       ir/OP-INVALID)]
                     (if (and (= ~byte0-id ~exponent-first) (= width ~exponent-width)
                              (= left-opcode ~unary-op))
                         (do (~fail-code ~state ~expected-error) (break))
                       0)
                     (~advance-count-code ~state width)
                     (let [family (if (= short-mode 3) 1 (if (> short-mode 0) 2 0))]
                       (if (and (> family 0) (> (load logical-family) 0)
                                (!= family (load logical-family)))
                           (do (~fail-code ~state ~expected-error) (break)) 0)
                       (if (> family 0) (store! logical-family family) 0)
                       (if (> short-mode 0)
                           (let [arena (.arena (.builder ~state)) origin (.block ~state)
                                 region (load (p/index (.block-regions arena)
                                                       (cast i64 origin)))
                                 rhs-result (builder/add-block! (.builder ~state) region)
                                 rhs-block (~check-build-code ~state rhs-result)
                                 join-result (builder/add-block! (.builder ~state) region)
                                 join-block (~check-build-code ~state join-result)
                                 parameter-result (builder/add-block-param! (.builder ~state)
                                                    join-block)
                                 parameter (~check-build-code ~state parameter-result)
                                 condition-value
                                   (if (= short-mode 3)
                                       (let [value (.value-count arena)
                                             test-result
                                               (builder/add-op! (.builder ~state) origin ~nullish-op
                                                 (cast u32 0) (cast u32 0) (.start old-left)
                                                 (.end old-left) (cast u32 1))
                                             test (~check-build-code ~state test-result)
                                             operand (builder/add-operand! (.builder ~state) test
                                                       (.value old-left))]
                                         (~check-build-code ~state operand)
                                         value)
                                     (.value old-left))
                                 rhs-on-true (or (= short-mode 1) (= short-mode 3))
                                 branch-result
                                   (builder/add-op! (.builder ~state) origin ~branch-op
                                     (cast u32 0) (cast u32 0) (.start old-left)
                                     (~current-position-code ~state) (cast u32 0))
                                 branch (~check-build-code ~state branch-result)
                                 condition-operand (builder/add-operand! (.builder ~state) branch
                                                     condition-value)
                                 true-successor (builder/add-successor! (.builder ~state) branch
                                                   (if rhs-on-true rhs-block join-block))
                                 true-edge (~check-build-code ~state true-successor)
                                 false-successor (builder/add-successor! (.builder ~state) branch
                                                    (if rhs-on-true join-block rhs-block))
                                 false-edge (~check-build-code ~state false-successor)
                                 short-edge (if rhs-on-true false-edge true-edge)
                                 short-argument (builder/add-successor-arg! (.builder ~state)
                                                  short-edge (.value old-left))]
                             (~check-build-code ~state condition-operand)
                             (~check-build-code ~state short-argument)
                             (set! (.block ~state) rhs-block)
                             (let [right (~function-name ~state
                                           (if right-associative precedence (+ precedence 1)))
                                   rhs-exit (.block ~state)]
                               (~emit-branch-arg-code ~state rhs-exit join-block (.value right))
                               (set! (.block ~state) join-block)
                               (store! left (~result-type :value parameter :start (.start old-left)
                                                  :end (.end right)))))
                         (let [right (~function-name ~state
                                       (if right-associative precedence (+ precedence 1)))
                               arena (.arena (.builder ~state)) value (.value-count arena)
                               operation (builder/add-op! (.builder ~state) (.block ~state)
                                            ~binary-op
                                            (if (> ~word-info-id 0) ~operator-start-id
                                              (cast u32 0))
                                            (if (> ~word-info-id 0) ~operator-end-id
                                              (cast u32 0))
                                            (.start old-left) (.end right) (cast u32 1))]
                           (let [op (~check-build-code ~state operation)
                                 lhs (builder/add-operand! (.builder ~state) op (.value old-left))
                                 rhs (builder/add-operand! (.builder ~state) op (.value right))
                                 imm (builder/set-op-immediate! (.builder ~state) op ~immediate-id)]
                             (~check-build-code ~state lhs)
                             (~check-build-code ~state rhs)
                             (~check-build-code ~state imm)
                             (store! left (~result-type :value value :start (.start old-left)
                                                        :end (.end right))))))))))))
           (let [completed
                   (if (and (<= ~minimum ~conditional-max)
                            (= (.error ~state) ~ok-error)
                            (= (~current-byte-code ~state) ~question))
                       (let [condition (load left) origin (.block ~state)
                             arena (.arena (.builder ~state))
                             region (load (p/index (.block-regions arena) (cast i64 origin)))
                             _question (~advance-code ~state)
                             then-result (builder/add-block! (.builder ~state) region)
                             then-block (~check-build-code ~state then-result)
                             else-result (builder/add-block! (.builder ~state) region)
                             else-block (~check-build-code ~state else-result)
                             branch-result (builder/add-op! (.builder ~state) origin ir/OP-COND-BR
                                            (cast u32 0) (cast u32 0) (.start condition)
                                            (~current-position-code ~state) (cast u32 0))]
                         (let [branch (~check-build-code ~state branch-result)
                               operand (builder/add-operand! (.builder ~state) branch
                                                             (.value condition))
                               then-successor (builder/add-successor! (.builder ~state) branch
                                                                      then-block)
                               else-successor (builder/add-successor! (.builder ~state) branch
                                                                      else-block)]
                           (~check-build-code ~state operand)
                           (~check-build-code ~state then-successor)
                           (~check-build-code ~state else-successor))
                         (set! (.block ~state) then-block)
                         (let [consequent (~function-name ~state 0) then-exit (.block ~state)]
                           (if (~consume-code ~state ~colon)
                               (do
                                 (set! (.block ~state) else-block)
                                 (let [alternate (~function-name ~state ~alternate-precedence)
                                       else-exit (.block ~state)
                                       join-result (builder/add-block! (.builder ~state) region)
                                       join-block (~check-build-code ~state join-result)
                                       parameter-result (builder/add-block-param! (.builder ~state)
                                                                                  join-block)
                                       parameter (~check-build-code ~state parameter-result)]
                                   (~emit-branch-arg-code ~state then-exit join-block
                                                          (.value consequent))
                                   (~emit-branch-arg-code ~state else-exit join-block
                                                          (.value alternate))
                                   (set! (.block ~state) join-block)
                                   (let [result (p/alloc-stack ~result-type)]
                                     (store! result (~result-type :value parameter
                                                     :start (.start condition)
                                                     :end (.end alternate)))
                                     (load result))))
                             (~fail-code ~state ~expected-error))))
                     (load left))]
             (let [assignment-width
                    (if (and (<= ~minimum ~assignment-max)
                             (= (.error ~state) ~ok-error))
                        ~(compile-assignment-condition assignment-operators 0 state
                           current-byte-code adjacent-byte-code)
                      0)]
               (if (> assignment-width 0)
                 (let [left-value (load completed)
                       byte0 (~current-byte-code ~state)
                       byte1 (if (> assignment-width 1)
                                 (~adjacent-byte-code ~state 1) (cast u8 0))
                       byte2 (if (> assignment-width 2)
                                 (~adjacent-byte-code ~state 2) (cast u8 0))
                       byte3 (if (> assignment-width 3)
                                 (~adjacent-byte-code ~state 3) (cast u8 0))
                       immediate (p/ior (cast u64 byte0)
                                   (p/ior (p/ishl (cast u64 byte1) (cast u64 8))
                                     (p/ior (p/ishl (cast u64 byte2) (cast u64 16))
                                            (p/ishl (cast u64 byte3) (cast u64 24)))))
                       _assignment (~advance-count-code ~state assignment-width)
                       right (~function-name ~state 0)
                       arena (.arena (.builder ~state)) value (.value-count arena)
                       operation-result (builder/add-op! (.builder ~state) (.block ~state)
                                          ~assignment-op (cast u32 0) (cast u32 0)
                                          (.start left-value) (.end right) (cast u32 1))]
                   (let [op (~check-build-code ~state operation-result)
                         lhs (builder/add-operand! (.builder ~state) op (.value left-value))
                         rhs (builder/add-operand! (.builder ~state) op (.value right))
                         immediate-result (builder/set-op-immediate! (.builder ~state) op
                                                                      immediate)]
                     (~check-build-code ~state lhs)
                     (~check-build-code ~state rhs)
                     (~check-build-code ~state immediate-result)
                     (~result-type :value value :start (.start left-value) :end (.end right))))
                 (load completed)))))))))

;; ---------------------------------------------------------------------------
;; Semantic parser DSL specification
;; ---------------------------------------------------------------------------
;; Keep this data-only section at the end of the module. Coil currently expands
;; an imported Code->Code helper as a nested macro too early, so compiler and
;; specification share a module until compile-time library linkage is added.
(defn javascript-reserved-keywords [] (-> Code)
  ;; Word-form binary operators must not fall back to IdentifierReference or
  ;; binding grammar; `default` is also forbidden as a shorthand binding.
  `["in" "default" "instanceof"])

(defn define-frontend-parser [(backend Code)] (-> Code)
  (let [productions
      `[(numeric-value javascript-number
        (function parse-number)
        (digit-function number-digit-value)
        (scan-function scan-number-digits)
        (dot (syntax/terminal-byte syntax/dot))
        (separator 95)
        (exponent-lower 101)
        (exponent-upper 69)
        (plus (syntax/terminal-byte syntax/plus))
        (minus (syntax/terminal-byte syntax/minus))
        (bigint 110)
        (prefixes [[120 88 16] [98 66 2] [111 79 8]])
        (backslash (syntax/terminal-byte syntax/backslash))
        (emit-op ir/OP-JS-NUMBER)
        (bigint-op ir/OP-JS-BIGINT))
      (word-value identifier-or-number
        (event tape/EVENT-WORD)
        (number-parser parse-number)
        (identifier-op ir/OP-JS-IDENTIFIER)
        (keyword-ops [["true" ir/OP-JS-BOOLEAN]
                      ["false" ir/OP-JS-BOOLEAN]
