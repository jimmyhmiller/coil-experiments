(module experiments.react-hir-frontend.parser-generator)

(import "coil.primitive" :as p)
(import "coil.slice" :use [slice-get])
(import "experiments.react-hir-frontend.frontend-spec" :as syntax)
(import "experiments.react-hir-frontend.ir" :as ir)
(import "experiments.react-hir-frontend.tape" :as tape)
(import "experiments.react-hir-frontend.ir-builder" :as builder)

(defn generator-symbol? [(value Code) (name (slice u8))] (-> bool)
  (and (p/code-sym? value) (= (p/code-sym value) name)))

(defn generator-form? [(value Code) (name (slice u8))] (-> bool)
  (and (p/code-list? value) (> (p/code-count value) 0)
       (generator-symbol? (p/code-nth value 0) name)))

(defn generator-fail [(at Code) (message (slice u8))] (-> Code)
  (do (p/report at message) at))

(defn field-value [(production Code) (name (slice u8))] (-> Code)
  (let [(mut i) 2 (mut found) `false (mut present) false]
    (loop
      (if (>= (load i) (p/code-count production)) (break)
        (let [field (p/code-nth production (load i))]
          (if (and (p/code-list? field) (= (p/code-count field) 2)
                   (generator-symbol? (p/code-nth field 0) name))
              (do (store! found (p/code-nth field 1)) (store! present true) (break))
            (set! i (+ (load i) 1))))))
    (if (not (load present))
        (generator-fail production "generated production is missing a required field")
      (load found))))

(defn backend-value [(backend Code) (name (slice u8))] (-> Code)
  (if (not (p/code-vector? backend))
      (generator-fail backend "parser backend must be a vector of (role value) bindings")
    (let [(mut i) 0 (mut found) `false (mut present) false]
      (loop
        (if (>= (load i) (p/code-count backend)) (break)
          (let [binding (p/code-nth backend (load i))]
            (if (and (p/code-list? binding) (= (p/code-count binding) 2)
                     (generator-symbol? (p/code-nth binding 0) name))
                (do (store! found (p/code-nth binding 1)) (store! present true) (break))
              (set! i (+ (load i) 1))))))
      (if (not (load present))
          (generator-fail backend (p/code-str "parser backend is missing role: " name))
        (load found)))))

;; Backend ABI is a vector of `(role value)` bindings. Compilers use named
;; roles so adding a production cannot silently shift every following slot.
;;
;; This compiler owns the repetition, separator, closing-token, scratch-lifetime,
;; and error-control algorithm. The backend supplies only primitive operations.
(defn compile-separated-value [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-vector? backend)
                (p/code-list? production) (= (p/code-count production) 9)
                (generator-form? production "separated-value")
                (p/code-sym? (p/code-nth production 1))))
      (generator-fail production "invalid separated-value production")
    (let [state-type (backend-value backend "state-type")
          result-type (backend-value backend "expression-result-type")
          current-position-code (backend-value backend "current-position")
          current-byte-code (backend-value backend "current-byte")
          advance-code (backend-value backend "advance")
          consume-code (backend-value backend "consume-byte")
          fail-code (backend-value backend "fail")
          push-value-code (backend-value backend "push-scratch-value")
          emit-list-code (backend-value backend "emit-scratch-list-op")
          ok-error (backend-value backend "ok-error")
          expected-error (backend-value backend "expected-error")
          function-role (field-value production "function")
          element-form (field-value production "element")
          function-name (backend-value backend (p/code-sym function-role))
          element-role (p/code-nth element-form 0)
          element-parser (backend-value backend (p/code-sym element-role))
          open (field-value production "open")
          separator (field-value production "separator")
          close (field-value production "close")
          allow-trailing (field-value production "allow-trailing")
          opcode (field-value production "emit-op")
          state (p/fresh-identifier "state")
          element-call
            (if (= (p/code-count element-form) 2)
                `(~element-parser ~state ~(p/code-nth element-form 1))
              `(~element-parser ~state))]
      `(defn ~function-name [(~state (ptr ~state-type))] (-> ~result-type)
         (let [scratch (.scratch ~state) mark (.value-count scratch)
               start (~current-position-code ~state) _open (~advance-code ~state)]
           (if (= (~current-byte-code ~state) ~close) 0
             (loop
               (let [element ~element-call]
                 (~push-value-code ~state (.value element))
                 (if (!= (.error ~state) ~ok-error) (break)
                   (if (= (~current-byte-code ~state) ~separator)
                       (do
                         (~advance-code ~state)
                         (if (and ~(if (generator-symbol? allow-trailing "true") `true `false)
                                  (= (~current-byte-code ~state) ~close))
                             (break) 0))
                     (break))))))
           (let [end-position (~current-position-code ~state)]
             (if (not (~consume-code ~state ~close))
                 (~fail-code ~state ~expected-error)
               (~emit-list-code ~state ~opcode start
                 (+ end-position (cast u32 1)) mark))))))))

(defn compile-word-value [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 5)
                (generator-form? production "word-value")))
      (generator-fail production "invalid word-value production")
    (let [state-type (backend-value backend "state-type")
          result-type (backend-value backend "expression-result-type")
          function-name (backend-value backend "parse-word")
          event-kind-code (backend-value backend "event-kind")
          current-event-code (backend-value backend "current-event")
          current-position-code (backend-value backend "current-position")
          word-end-code (backend-value backend "word-end")
          source-byte-code (backend-value backend "source-byte")
          advance-code (backend-value backend "advance")
          fail-code (backend-value backend "fail")
          emit-code (backend-value backend "emit-value-op")
          find-binding-code (backend-value backend "find-binding")
          check-build-code (backend-value backend "check-build")
          ensure-capture-code (backend-value backend "ensure-capture")
          unexpected-error (backend-value backend "unexpected-error")
          word-event (field-value production "event")
          number-op (field-value production "number-op")
          identifier-op (field-value production "identifier-op")
          state (p/fresh-identifier "state")]
      `(defn ~function-name [(~state (ptr ~state-type))] (-> ~result-type)
         (if (or (>= (.event-index ~state) (.event-count ~state))
                 (!= (~event-kind-code (~current-event-code ~state))
                     (cast u8 ~word-event)))
             (~fail-code ~state ~unexpected-error)
           (let [start (~current-position-code ~state)
                 end (~word-end-code ~state start)
                 first (~source-byte-code ~state start)]
             (~advance-code ~state)
             (if (and (>= first (cast u8 48)) (<= first (cast u8 57)))
                 (~emit-code ~state ~number-op start end)
               (let [result (~emit-code ~state ~identifier-op start end)
                     binding (~find-binding-code ~state start end)]
                 (if (!= binding (cast u32 ir/INVALID-ID))
                     (let [reference (builder/add-reference! (.builder ~state)
                                                              binding start end)]
                       (~check-build-code ~state reference)
                       (~ensure-capture-code ~state binding)) 0)
                 result))))))))

(defn compile-quoted-value [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 3)
                (generator-form? production "quoted-value")))
      (generator-fail production "invalid quoted-value production")
    (let [state-type (backend-value backend "state-type")
          result-type (backend-value backend "expression-result-type")
          function-name (backend-value backend "parse-string")
          current-position-code (backend-value backend "current-position")
          current-byte-code (backend-value backend "current-byte")
          advance-code (backend-value backend "advance")
          fail-code (backend-value backend "fail")
          emit-code (backend-value backend "emit-value-op")
          expected-error (backend-value backend "expected-error")
          opcode (field-value production "emit-op")
          state (p/fresh-identifier "state")]
      `(defn ~function-name [(~state (ptr ~state-type))] (-> ~result-type)
         (let [start (~current-position-code ~state)
               quote (~current-byte-code ~state)
               (mut at) (+ (cast i64 start) 1)
               (mut escaped) false (mut closed) false]
           (loop
             (if (or (>= (load at) (.source-size ~state)) (load closed)) (break)
               (let [byte (load (p/index (.source ~state) (load at)))]
                 (cond (load escaped) (store! escaped false)
                       (= byte (cast u8 92)) (store! escaped true)
                       (= byte quote) (store! closed true)
                       :else 0)
                 (set! at (+ (load at) 1)))))
           (if (not (load closed)) (~fail-code ~state ~expected-error)
             (do
               (loop
                 (if (or (>= (.event-index ~state) (.event-count ~state))
                         (>= (cast i64 (~current-position-code ~state)) (load at)))
                     (break)
                   (~advance-code ~state)))
               (~emit-code ~state ~opcode start (cast u32 (load at))))))))))

;; TypeScript annotations are erased from runtime SSA but retained as checked,
;; source-backed IR markers. This generated recognizer consumes a complete type
;; span while balancing every delimiter family, so commas and closing tokens in
;; nested tuples, object types, function types, and generic arguments do not
;; terminate the outer annotation.
(defn compile-erased-type-span [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 5)
                (generator-form? production "erased-type-span")))
      (generator-fail production "invalid erased-type-span production")
    (let [state-type (backend-value backend "state-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          current-position-code (backend-value backend "current-position")
          current-byte-code (backend-value backend "current-byte")
          advance-code (backend-value backend "advance")
          fail-code (backend-value backend "fail")
          check-build-code (backend-value backend "check-build")
          expected-error (backend-value backend "expected-error")
          prefix (field-value production "prefix")
          opcode (field-value production "emit-op")
          state (p/fresh-identifier "state") stop-a (p/fresh-identifier "stop-a")
          stop-b (p/fresh-identifier "stop-b")]
      `(defn ~function-name
         [(~state (ptr ~state-type)) (~stop-a u8) (~stop-b u8)] (-> i64)
         (let [annotation-start (~current-position-code ~state)]
           (if (!= (~current-byte-code ~state) ~prefix)
               (do (~fail-code ~state ~expected-error) 0)
             (do
               (~advance-code ~state)
               (let [type-start (~current-position-code ~state)
                     (mut consumed) false (mut parens) 0 (mut brackets) 0
                     (mut braces) 0 (mut angles) 0]
                 (loop
                   (if (>= (.event-index ~state) (.event-count ~state)) (break)
                     (let [byte (~current-byte-code ~state)
                           top (and (= (load parens) 0) (= (load brackets) 0)
                                    (= (load braces) 0) (= (load angles) 0))]
                       (if (and top (load consumed)
                                (or (= byte ~stop-a) (= byte ~stop-b))) (break)
                         (do
                           (cond
                             (= byte (cast u8 40)) (set! parens (+ (load parens) 1))
                             (= byte (cast u8 41))
                               (if (> (load parens) 0) (set! parens (- (load parens) 1)) 0)
                             (= byte (cast u8 91)) (set! brackets (+ (load brackets) 1))
                             (= byte (cast u8 93))
                               (if (> (load brackets) 0) (set! brackets (- (load brackets) 1)) 0)
                             (= byte (cast u8 123)) (set! braces (+ (load braces) 1))
                             (= byte (cast u8 125))
                               (if (> (load braces) 0) (set! braces (- (load braces) 1)) 0)
                             (= byte (cast u8 60)) (set! angles (+ (load angles) 1))
                             (= byte (cast u8 62))
                               (if (> (load angles) 0) (set! angles (- (load angles) 1)) 0)
                             :else 0)
                           (store! consumed true)
                           (~advance-code ~state))))))
                 (if (or (not (load consumed)) (!= (load parens) 0)
                         (!= (load brackets) 0) (!= (load braces) 0)
                         (!= (load angles) 0))
                     (do (~fail-code ~state ~expected-error) 0)
                   (let [operation (builder/add-op! (.builder ~state) (.block ~state)
                                      ~opcode type-start (~current-position-code ~state)
                                      annotation-start (~current-position-code ~state)
                                      (cast u32 0))]
                     (~check-build-code ~state operation)))))))
         0))))

(defn compile-erased-type-parameters [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 6)
                (generator-form? production "erased-type-parameters")))
      (generator-fail production "invalid erased-type-parameters production")
    (let [state-type (backend-value backend "state-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          current-position-code (backend-value backend "current-position")
          current-byte-code (backend-value backend "current-byte")
          advance-code (backend-value backend "advance")
          fail-code (backend-value backend "fail")
          check-build-code (backend-value backend "check-build")
          expected-error (backend-value backend "expected-error")
          open (field-value production "open") close (field-value production "close")
          opcode (field-value production "emit-op") state (p/fresh-identifier "state")]
      `(defn ~function-name [(~state (ptr ~state-type))] (-> i64)
         (let [start (~current-position-code ~state)]
           (if (!= (~current-byte-code ~state) ~open)
               (do (~fail-code ~state ~expected-error) 0)
             (do
               (~advance-code ~state)
               (let [(mut depth) 1]
                 (loop
                   (if (or (= (load depth) 0)
                           (>= (.event-index ~state) (.event-count ~state))) (break)
                     (let [byte (~current-byte-code ~state)]
                       (if (= byte ~open) (set! depth (+ (load depth) 1))
                         (if (= byte ~close) (set! depth (- (load depth) 1)) 0))
                       (~advance-code ~state))))
                 (if (!= (load depth) 0)
                     (do (~fail-code ~state ~expected-error) 0)
                   (let [operation (builder/add-op! (.builder ~state) (.block ~state)
                                      ~opcode (+ start (cast u32 1))
                                      (- (~current-position-code ~state) (cast u32 1))
                                      start (~current-position-code ~state) (cast u32 0))]
                     (~check-build-code ~state operation)))))))
         0))))

(defn compile-erased-declaration [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 9)
                (generator-form? production "erased-declaration")))
      (generator-fail production "invalid erased-declaration production")
    (let [state-type (backend-value backend "state-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          current-position-code (backend-value backend "current-position")
          current-byte-code (backend-value backend "current-byte")
          word-end-code (backend-value backend "word-end")
          advance-code (backend-value backend "advance")
          consume-code (backend-value backend "consume-byte")
          fail-code (backend-value backend "fail")
          check-build-code (backend-value backend "check-build")
          type-parser (backend-value backend
                        (p/code-sym (field-value production "type-parser")))
          type-parameters-parser (backend-value backend
              (p/code-sym (field-value production "type-parameters-parser")))
          expected-error (backend-value backend "expected-error")
          prefix (field-value production "prefix")
          type-parameters-open (field-value production "type-parameters-open")
          terminator (field-value production "terminator")
          opcode (field-value production "emit-op") state (p/fresh-identifier "state")]
      `(defn ~function-name [(~state (ptr ~state-type))] (-> i64)
         (let [start (~current-position-code ~state) _keyword (~advance-code ~state)
               name-start (~current-position-code ~state)
               name-end (~word-end-code ~state name-start)]
           (if (= name-start name-end)
               (do (~fail-code ~state ~expected-error) 0)
             (do
               (~advance-code ~state)
               (if (= (~current-byte-code ~state) ~type-parameters-open)
                   (~type-parameters-parser ~state) 0)
               (let [declaration-result
                       (builder/add-op! (.builder ~state) (.block ~state)
                         ~opcode name-start name-end start start (cast u32 0))
                     declaration (~check-build-code ~state declaration-result)]
                 (~type-parser ~state ~terminator ~terminator)
                 (let [end (~current-position-code ~state)]
                   (if (~consume-code ~state ~terminator)
                       (let [updated (builder/set-op-span! (.builder ~state) declaration
                                       start (+ end (cast u32 1)))]
                         (~check-build-code ~state updated)) 0))))))
         0))))

(defn compile-erased-braced-declaration [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 9)
                (generator-form? production "erased-braced-declaration")))
      (generator-fail production "invalid erased braced declaration")
    (let [state-type (backend-value backend "state-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          current-position-code (backend-value backend "current-position")
          current-byte-code (backend-value backend "current-byte")
          current-event-code (backend-value backend "current-event")
          event-kind-code (backend-value backend "event-kind")
          event-position-code (backend-value backend "event-position")
          word-end-code (backend-value backend "word-end")
          advance-code (backend-value backend "advance")
          fail-code (backend-value backend "fail")
          check-build-code (backend-value backend "check-build")
          type-parameters-parser (backend-value backend
              (p/code-sym (field-value production "type-parameters-parser")))
          expected-error (backend-value backend "expected-error")
          type-parameters-open (field-value production "type-parameters-open")
          literal-event (field-value production "literal-event")
          body-open (field-value production "body-open") body-close (field-value production "body-close")
          opcode (field-value production "emit-op") state (p/fresh-identifier "state")]
      `(defn ~function-name [(~state (ptr ~state-type))] (-> i64)
         (let [start (~current-position-code ~state) _keyword (~advance-code ~state)
               name-start (~current-position-code ~state)
               word-name-end (~word-end-code ~state name-start)
               literal-name (= (~event-kind-code (~current-event-code ~state))
                               (cast u8 ~literal-event))
               name-end (if literal-name
                            (+ (~event-position-code (load (p/index (.events ~state)
                                  (+ (.event-index ~state) 1)))) (cast u32 1))
                          word-name-end)]
           (if (and (= name-start word-name-end) (not literal-name))
               (do (~fail-code ~state ~expected-error) 0)
             (do
               (if literal-name (~advance-code ~state) 0)
               (~advance-code ~state)
               (if (= (~current-byte-code ~state) ~type-parameters-open)
                   (do (~type-parameters-parser ~state) 0) 0)
               (loop
                 (if (or (>= (.event-index ~state) (.event-count ~state))
                         (= (~current-byte-code ~state) ~body-open)) (break)
                   (~advance-code ~state)))
               (if (= (~current-byte-code ~state) ~body-open)
                   (do
                     (~advance-code ~state)
                     (let [(mut depth) 1]
                       (loop
                         (if (or (= (load depth) 0)
                                 (>= (.event-index ~state) (.event-count ~state))) (break)
                           (let [byte (~current-byte-code ~state)]
                             (if (= byte ~body-open) (set! depth (+ (load depth) 1))
                               (if (= byte ~body-close) (set! depth (- (load depth) 1)) 0))
                             (~advance-code ~state))))
                       (if (= (load depth) 0)
                           (let [end (~current-position-code ~state)
                                 operation (builder/add-op! (.builder ~state) (.block ~state)
                                              ~opcode name-start name-end start end (cast u32 0))]
                             (~check-build-code ~state operation))
                         (do (~fail-code ~state ~expected-error) 0)))
                     0)
                 (do (~fail-code ~state ~expected-error) 0))))
         0)))))

(defn compile-statement-terminator [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 5)
                (generator-form? production "statement-terminator")))
      (generator-fail production "invalid statement-terminator production")
    (let [state-type (backend-value backend "state-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          current-position-code (backend-value backend "current-position")
          current-byte-code (backend-value backend "current-byte")
          source-byte-code (backend-value backend "source-byte")
          advance-code (backend-value backend "advance")
          fail-code (backend-value backend "fail")
          expected-error (backend-value backend "expected-error")
          explicit (field-value production "explicit")
          close-block (field-value production "close-block")
          state (p/fresh-identifier "state") previous-end (p/fresh-identifier "previous-end")]
      `(defn ~function-name :inline (Always)
         [(~state (ptr ~state-type)) (~previous-end u32)] (-> u32)
         (if (= (~current-byte-code ~state) ~explicit)
             (let [at (~current-position-code ~state)]
               (~advance-code ~state)
               (+ at (cast u32 1)))
           (if (or (>= (.event-index ~state) (.event-count ~state))
                   (= (~current-byte-code ~state) ~close-block))
               ~previous-end
             (let [(mut at) ~previous-end (mut newline) false
                   limit (~current-position-code ~state)]
               (loop
                 (if (or (>= (load at) limit) (load newline)) (break)
                   (let [byte (~source-byte-code ~state (load at))]
                     (if (or (= byte (cast u8 10)) (= byte (cast u8 13)))
                         (store! newline true) 0)
                     (set! at (+ (load at) (cast u32 1))))))
               (if (load newline) ~previous-end
                 (do (~fail-code ~state ~expected-error) ~previous-end)))))))))

(defn compile-import-declaration [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 13)
                (generator-form? production "import-declaration")))
      (generator-fail production "invalid import-declaration production")
    (let [state-type (backend-value backend "state-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          current-position-code (backend-value backend "current-position")
          current-byte-code (backend-value backend "current-byte")
          current-keyword-code (backend-value backend "current-keyword")
          word-end-code (backend-value backend "word-end")
          advance-code (backend-value backend "advance")
          consume-code (backend-value backend "consume-byte")
          fail-code (backend-value backend "fail")
          check-build-code (backend-value backend "check-build")
          parse-string-code (backend-value backend "parse-string")
          terminator-parser (backend-value backend
                              (p/code-sym (field-value production "terminator-parser")))
          ok-error (backend-value backend "ok-error")
          expected-error (backend-value backend "expected-error")
          from-keyword (field-value production "from-keyword")
          as-keyword (field-value production "as-keyword")
          type-keyword (field-value production "type-keyword")
          open (field-value production "open") close (field-value production "close")
          comma (field-value production "separator") star (field-value production "star")
          import-op (field-value production "emit-op")
          specifier-op (field-value production "specifier-op")
          state (p/fresh-identifier "state")]
      `(defn ~function-name [(~state (ptr ~state-type))] (-> i64)
         (let [start (~current-position-code ~state) _import (~advance-code ~state)]
           (if (!= (~current-byte-code ~state) (cast u8 34))
             (if (!= (~current-byte-code ~state) (cast u8 39))
               (do
                 ;; Default import binding.
                 (if (and (!= (~current-byte-code ~state) ~open)
                          (!= (~current-byte-code ~state) ~star))
                     (let [name-start (~current-position-code ~state)
                           name-end (~word-end-code ~state name-start)]
                       (if (= name-start name-end)
                           (do (~fail-code ~state ~expected-error) 0)
                         (do
                           (~advance-code ~state)
                           (let [binding (builder/add-binding! (.builder ~state) (.scope ~state)
                                               name-start name-end)
                                 specifier (builder/add-op! (.builder ~state) (.block ~state)
                                               ~specifier-op name-start name-end
                                               name-start name-end (cast u32 0))]
                             (~check-build-code ~state binding)
                             (~check-build-code ~state specifier))
                           (if (= (~current-byte-code ~state) ~comma)
                               (~advance-code ~state) 0)))) 0)
                 ;; Namespace import: * as local.
                 (if (= (~current-byte-code ~state) ~star)
                     (do
                       (~advance-code ~state)
                       (if (~current-keyword-code ~state ~as-keyword)
                           (~advance-code ~state)
                         (do (~fail-code ~state ~expected-error) 0))
                       (let [name-start (~current-position-code ~state)
                             name-end (~word-end-code ~state name-start)]
                         (if (= name-start name-end)
                           (do (~fail-code ~state ~expected-error) 0)
                           (do
                             (~advance-code ~state)
                             (let [binding (builder/add-binding! (.builder ~state) (.scope ~state)
                                                 name-start name-end)
                                   specifier (builder/add-op! (.builder ~state) (.block ~state)
                                                 ~specifier-op name-start name-end
                                                 name-start name-end (cast u32 0))]
                               (~check-build-code ~state binding)
                               (~check-build-code ~state specifier))))))
                   ;; Named imports, including erased `type` specifiers.
                   (if (= (~current-byte-code ~state) ~open)
                       (do
                         (~advance-code ~state)
                         (loop
                           (if (or (= (~current-byte-code ~state) ~close)
                                   (!= (.error ~state) ~ok-error)) (break)
                             (let [erased (~current-keyword-code ~state ~type-keyword)]
                               (if erased (~advance-code ~state) 0)
                               (let [imported-start (~current-position-code ~state)
                                     imported-end (~word-end-code ~state imported-start)]
                                 (if (= imported-start imported-end)
                                     (do (~fail-code ~state ~expected-error) (break))
                                   (do
                                     (~advance-code ~state)
                                     (let [(mut local-start) imported-start
                                           (mut local-end) imported-end]
                                       (if (~current-keyword-code ~state ~as-keyword)
                                           (do
                                             (~advance-code ~state)
                                             (store! local-start (~current-position-code ~state))
                                             (store! local-end
                                               (~word-end-code ~state (load local-start)))
                                             (if (= (load local-start) (load local-end))
                                                 (do (~fail-code ~state ~expected-error) 0)
                                               (~advance-code ~state))) 0)
                                       (let [specifier (builder/add-op! (.builder ~state)
                                                         (.block ~state) ~specifier-op
                                                         imported-start imported-end
                                                         imported-start (load local-end)
                                                         (cast u32 0))
                                             specifier-id (~check-build-code ~state specifier)
                                             erased-result (builder/set-op-immediate!
                                                               (.builder ~state) specifier-id
                                                               (if erased (cast u64 1)
                                                                 (cast u64 0)))]
                                         (~check-build-code ~state erased-result)
                                         (if (not erased)
                                             (let [binding (builder/add-binding! (.builder ~state)
                                                               (.scope ~state) (load local-start)
                                                               (load local-end))]
                                               (~check-build-code ~state binding)) 0))
                                       (if (= (~current-byte-code ~state) ~comma)
                                           (~advance-code ~state) (break)))))))))
                         (do (~consume-code ~state ~close) 0)) 0))
                 (if (~current-keyword-code ~state ~from-keyword)
                     (~advance-code ~state)
                   (do (~fail-code ~state ~expected-error) 0)))
               0)
             0)
           (if (= (.error ~state) ~ok-error)
               (let [module-value (~parse-string-code ~state)
                     statement-end (~terminator-parser ~state (.end module-value))]
                 (if (= (.error ~state) ~ok-error)
                     (let [operation (builder/add-op! (.builder ~state) (.block ~state)
                                       ~import-op (cast u32 0) (cast u32 0)
                                       start statement-end (cast u32 0))]
                       (let [op (~check-build-code ~state operation)
                             operand (builder/add-operand! (.builder ~state) op
                                       (.value module-value))]
                         (~check-build-code ~state operand))) 0)) 0))
         0))))

(defn compile-terminated-expression [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 8)
                (generator-form? production "terminated-expression")))
      (generator-fail production "invalid terminated-expression production")
    (let [state-type (backend-value backend "state-type")
          function-role (field-value production "function")
          function-name (backend-value backend (p/code-sym function-role))
          current-position-code (backend-value backend "current-position")
          advance-code (backend-value backend "advance")
          parse-expression-code (backend-value backend "parse-expression")
          terminator-parser (backend-value backend
                              (p/code-sym (field-value production "terminator-parser")))
          check-build-code (backend-value backend "check-build")
          ok-error (backend-value backend "ok-error")
          prefix (field-value production "prefix")
          terminator (field-value production "terminator")
          opcode (field-value production "emit-op")
          terminate (field-value production "terminate")
          state (p/fresh-identifier "state")
          start-id (p/fresh-identifier "start")
          value-id (p/fresh-identifier "value")
          end-id (p/fresh-identifier "end-position")
          prefix-action (if (generator-symbol? prefix "true")
                            `(~advance-code ~state) `0)
          operation-start (if (generator-symbol? prefix "true")
                              start-id `(.start ~value-id))
          terminate-action (if (generator-symbol? terminate "true")
                               `(set! (.terminated ~state) true) `0)]
      `(defn ~function-name [(~state (ptr ~state-type))] (-> i64)
         (let [~start-id (~current-position-code ~state)
               _prefix ~prefix-action
               ~value-id (~parse-expression-code ~state 0)
               ~end-id (~current-position-code ~state)]
           (let [statement-end (~terminator-parser ~state (.end ~value-id))]
             (if (= (.error ~state) ~ok-error)
               (let [operation (builder/add-op! (.builder ~state) (.block ~state)
                                  ~opcode (cast u32 0) (cast u32 0)
                                  ~operation-start statement-end
                                  (cast u32 0))]
                 (let [op (~check-build-code ~state operation)
                       operand (builder/add-operand! (.builder ~state) op (.value ~value-id))]
                   (~check-build-code ~state operand)
                   ~terminate-action)) 0)))
         0))))

(defn compile-named-value [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 5)
                (generator-form? production "named-value")))
      (generator-fail production "invalid named-value production")
    (let [state-type (backend-value backend "state-type")
          result-type (backend-value backend "expression-result-type")
          function-role (field-value production "function")
          function-name (backend-value backend (p/code-sym function-role))
          current-position-code (backend-value backend "current-position")
          word-end-code (backend-value backend "word-end")
          advance-code (backend-value backend "advance")
          consume-code (backend-value backend "consume-byte")
          fail-code (backend-value backend "fail")
          parse-expression-code (backend-value backend "parse-expression")
          check-build-code (backend-value backend "check-build")
          expected-error (backend-value backend "expected-error")
          separator (field-value production "separator")
          opcode (field-value production "emit-op")
          state (p/fresh-identifier "state")]
      `(defn ~function-name [(~state (ptr ~state-type))] (-> ~result-type)
         (let [name-start (~current-position-code ~state)
               name-end (~word-end-code ~state name-start)]
           (if (= name-start name-end) (~fail-code ~state ~expected-error)
             (do
               (~advance-code ~state)
               (if (not (~consume-code ~state ~separator))
                   (~fail-code ~state ~expected-error)
                 (let [property-value (~parse-expression-code ~state 0)
                       arena (.arena (.builder ~state)) value (.value-count arena)
                       operation-result
                         (builder/add-op! (.builder ~state) (.block ~state) ~opcode
                           name-start name-end name-start (.end property-value)
                           (cast u32 1))]
                   (let [op (~check-build-code ~state operation-result)
                         operand (builder/add-operand! (.builder ~state) op
                                                       (.value property-value))]
                     (~check-build-code ~state operand)
                     (~result-type :value value :start name-start
                                   :end (.end property-value))))))))))))

(defn compile-postfix-name [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 4)
                (generator-form? production "postfix-name")))
      (generator-fail production "invalid postfix-name production")
    (let [state-type (backend-value backend "state-type")
          result-type (backend-value backend "expression-result-type")
          function-role (field-value production "function")
          function-name (backend-value backend (p/code-sym function-role))
          current-position-code (backend-value backend "current-position")
          word-end-code (backend-value backend "word-end")
          advance-code (backend-value backend "advance")
          fail-code (backend-value backend "fail")
          check-build-code (backend-value backend "check-build")
          expected-error (backend-value backend "expected-error")
          opcode (field-value production "emit-op")
          state (p/fresh-identifier "state")
          input (p/fresh-identifier "input")]
      `(defn ~function-name [(~state (ptr ~state-type)) (~input ~result-type)]
         (-> ~result-type)
         (let [_prefix (~advance-code ~state)
               name-start (~current-position-code ~state)
               name-end (~word-end-code ~state name-start)]
           (if (= name-start name-end) (~fail-code ~state ~expected-error)
             (do
               (~advance-code ~state)
               (let [arena (.arena (.builder ~state)) value (.value-count arena)
                     operation-result
                       (builder/add-op! (.builder ~state) (.block ~state) ~opcode
                         name-start name-end (.start ~input) name-end (cast u32 1))]
                 (let [op (~check-build-code ~state operation-result)
                       operand (builder/add-operand! (.builder ~state) op (.value ~input))]
                   (~check-build-code ~state operand)
                   (~result-type :value value :start (.start ~input) :end name-end))))))))))

(defn compile-postfix-separated [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 7)
                (generator-form? production "postfix-separated")))
      (generator-fail production "invalid postfix-separated production")
    (let [state-type (backend-value backend "state-type")
          result-type (backend-value backend "expression-result-type")
          function-role (field-value production "function")
          function-name (backend-value backend (p/code-sym function-role))
          current-position-code (backend-value backend "current-position")
          current-byte-code (backend-value backend "current-byte")
          advance-code (backend-value backend "advance")
          consume-code (backend-value backend "consume-byte")
          fail-code (backend-value backend "fail")
          parse-expression-code (backend-value backend "parse-expression")
          push-value-code (backend-value backend "push-scratch-value")
          emit-code (backend-value backend "emit-scratch-call-op")
          ok-error (backend-value backend "ok-error")
          expected-error (backend-value backend "expected-error")
          separator (field-value production "separator")
          close (field-value production "close")
          precedence (field-value production "element-precedence")
          opcode (field-value production "emit-op")
          state (p/fresh-identifier "state") input (p/fresh-identifier "input")]
      `(defn ~function-name [(~state (ptr ~state-type)) (~input ~result-type)]
         (-> ~result-type)
         (let [scratch (.scratch ~state) mark (.value-count scratch)
               _open (~advance-code ~state)]
           (if (= (~current-byte-code ~state) ~close) 0
             (loop
               (let [element (~parse-expression-code ~state ~precedence)]
                 (~push-value-code ~state (.value element))
                 (if (!= (.error ~state) ~ok-error) (break)
                   (if (= (~current-byte-code ~state) ~separator)
                       (~advance-code ~state) (break))))))
           (let [end-position (~current-position-code ~state)]
             (if (not (~consume-code ~state ~close))
                 (~fail-code ~state ~expected-error)
               (~emit-code ~state ~opcode ~input
                 (+ end-position (cast u32 1)) mark))))))))

(defn compile-postfix-type-arguments [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 5)
                (generator-form? production "postfix-type-arguments")))
      (generator-fail production "invalid postfix-type-arguments production")
    (let [state-type (backend-value backend "state-type")
          result-type (backend-value backend "expression-result-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          type-parser (backend-value backend
                        (p/code-sym (field-value production "type-parser")))
          current-position-code (backend-value backend "current-position")
          check-build-code (backend-value backend "check-build")
          opcode (field-value production "emit-op")
          state (p/fresh-identifier "state") input (p/fresh-identifier "input")]
      `(defn ~function-name [(~state (ptr ~state-type)) (~input ~result-type)]
         (-> ~result-type)
         (let [_types (~type-parser ~state)
               end (~current-position-code ~state)
               arena (.arena (.builder ~state)) value (.value-count arena)
               operation-result (builder/add-op! (.builder ~state) (.block ~state)
                                  ~opcode (cast u32 0) (cast u32 0)
                                  (.start ~input) end (cast u32 1))]
           (let [op (~check-build-code ~state operation-result)
                 operand (builder/add-operand! (.builder ~state) op (.value ~input))]
             (~check-build-code ~state operand)
             (~result-type :value value :start (.start ~input) :end end)))))))

(defn compile-postfix-lookahead [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 6)
                (generator-form? production "postfix-lookahead")))
      (generator-fail production "invalid postfix-lookahead production")
    (let [state-type (backend-value backend "state-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          event-position-code (backend-value backend "event-position")
          source-byte-code (backend-value backend "source-byte")
          open (field-value production "open") close (field-value production "close")
          follow (field-value production "follow") state (p/fresh-identifier "state")]
      `(defn ~function-name :inline (Always) [(~state (ptr ~state-type))] (-> bool)
         (let [(mut index) (.event-index ~state) (mut depth) 0 (mut closed) false]
           (loop
             (if (or (>= (load index) (.event-count ~state)) (load closed)) (break)
               (let [event (load (p/index (.events ~state) (load index)))
                     byte (~source-byte-code ~state (~event-position-code event))]
                 (if (= byte ~open) (set! depth (+ (load depth) 1))
                   (if (= byte ~close)
                       (do
                         (set! depth (- (load depth) 1))
                         (if (= (load depth) 0) (store! closed true) 0)) 0))
                 (set! index (+ (load index) 1)))))
           (if (and (load closed) (< (load index) (.event-count ~state)))
               (let [event (load (p/index (.events ~state) (load index)))]
                 (= (~source-byte-code ~state (~event-position-code event)) ~follow))
             false))))))

(defn compile-arrow-lookahead [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 9)
                (generator-form? production "arrow-lookahead")))
      (generator-fail production "invalid arrow-lookahead production")
    (let [state-type (backend-value backend "state-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          event-position-code (backend-value backend "event-position")
          event-kind-code (backend-value backend "event-kind")
          current-event-code (backend-value backend "current-event")
          source-byte-code (backend-value backend "source-byte")
          word-event (field-value production "word-event")
          open (field-value production "open") close (field-value production "close")
          colon (field-value production "type-prefix")
          equals (field-value production "equals") greater (field-value production "greater")
          state (p/fresh-identifier "state")]
      `(defn ~function-name :inline (Always) [(~state (ptr ~state-type))] (-> bool)
         (if (>= (.event-index ~state) (.event-count ~state)) false
           (let [first-event (~current-event-code ~state)
                 first-byte (~source-byte-code ~state (~event-position-code first-event))
                 (mut index) (.event-index ~state) (mut candidate) false]
             (if (= (~event-kind-code first-event) (cast u8 ~word-event))
                 (set! index (+ (load index) 1))
               (if (= first-byte ~open)
                   (do
                     (let [(mut depth) 0 (mut closed) false]
                       (loop
                         (if (or (>= (load index) (.event-count ~state)) (load closed)) (break)
                           (let [event (load (p/index (.events ~state) (load index)))
                                 byte (~source-byte-code ~state (~event-position-code event))]
                             (if (= byte ~open) (set! depth (+ (load depth) 1))
                               (if (= byte ~close)
                                   (do (set! depth (- (load depth) 1))
                                       (if (= (load depth) 0) (store! closed true) 0)) 0))
                             (set! index (+ (load index) 1))))))
                     0)
                 0))
             (if (< (+ (load index) 1) (.event-count ~state))
                 (let [equals-event (load (p/index (.events ~state) (load index)))
                       greater-event (load (p/index (.events ~state) (+ (load index) 1)))]
                   (if (and (= (~source-byte-code ~state (~event-position-code equals-event)) ~equals)
                            (= (~source-byte-code ~state (~event-position-code greater-event)) ~greater))
                       true
                     (if (= (~source-byte-code ~state (~event-position-code equals-event)) ~colon)
                         (do
                           (set! index (+ (load index) 1))
                           (loop
                             (if (>= (+ (load index) 1) (.event-count ~state)) (break)
                               (let [left (load (p/index (.events ~state) (load index)))
                                     right (load (p/index (.events ~state) (+ (load index) 1)))]
                                 (if (and (= (~source-byte-code ~state (~event-position-code left)) ~equals)
                                          (= (~source-byte-code ~state (~event-position-code right)) ~greater))
                                     (do (store! candidate true) (break))
                                   (set! index (+ (load index) 1))))))
                           (load candidate))
                       false)))
               false)))))))

(defn compile-binding-pattern [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 14)
                (generator-form? production "binding-pattern")))
      (generator-fail production "invalid binding-pattern production")
    (let [state-type (backend-value backend "state-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          current-position-code (backend-value backend "current-position")
          current-byte-code (backend-value backend "current-byte")
          adjacent-byte-code (backend-value backend "adjacent-event-byte")
          word-end-code (backend-value backend "word-end")
          advance-code (backend-value backend "advance")
          advance-count-code (backend-value backend "advance-count")
          consume-code (backend-value backend "consume-byte")
          fail-code (backend-value backend "fail")
          check-build-code (backend-value backend "check-build")
          parse-expression-code (backend-value backend "parse-expression")
          parse-type-code (backend-value backend
                            (p/code-sym (field-value production "type-parser")))
          expected-error (backend-value backend "expected-error")
          object-open (field-value production "object-open")
          object-close (field-value production "object-close")
          array-open (field-value production "array-open")
          array-close (field-value production "array-close")
          comma (field-value production "separator") colon (field-value production "colon")
          equals (field-value production "equals") question (field-value production "optional")
          dot (field-value production "rest-byte")
          parameter-close (field-value production "parameter-close")
          state (p/fresh-identifier "state")]
      `(defn ~function-name
         [(~state (ptr ~state-type)) (allow-default bool) (pattern-stop-a u8) (pattern-stop-b u8)]
         (-> i64)
         (let [start (~current-position-code ~state) end (~word-end-code ~state start)]
           (if (!= start end)
               (do
                 (~advance-code ~state)
                 (let [binding (builder/add-binding! (.builder ~state) (.scope ~state)
                                                     start end)]
                   (~check-build-code ~state binding))
                 (if (= (~current-byte-code ~state) ~question)
                     (do (~advance-code ~state) 0) 0)
                 (if (= (~current-byte-code ~state) ~colon)
                     (do (~parse-type-code ~state pattern-stop-a pattern-stop-b) 0) 0)
                 (if (and allow-default (= (~current-byte-code ~state) ~equals))
                     (do (~advance-code ~state) (~parse-expression-code ~state 0) 0) 0))
             (if (= (~current-byte-code ~state) ~object-open)
                 (do
                   (~advance-code ~state)
                   (loop
                     (if (= (~current-byte-code ~state) ~object-close) (break)
                       (do
                        (if (and (= (~current-byte-code ~state) ~dot)
                                 (= (~adjacent-byte-code ~state 1) ~dot)
                                 (= (~adjacent-byte-code ~state 2) ~dot))
                             (do (~advance-count-code ~state 3) 0) 0)
                         (let [property-start (~current-position-code ~state)
                               property-end (~word-end-code ~state property-start)]
                           (if (= property-start property-end)
                               (do (~fail-code ~state ~expected-error) (break) 0)
                             (do
                               (~advance-code ~state)
                               (if (= (~current-byte-code ~state) ~colon)
                                   (do (~advance-code ~state)
                                       (~function-name ~state true ~comma ~object-close) 0)
                                 (do
                                   (let [binding (builder/add-binding! (.builder ~state)
                                                     (.scope ~state) property-start property-end)]
                                     (~check-build-code ~state binding))
                                   0))
                               (if (= (~current-byte-code ~state) ~equals)
                                   (do (~advance-code ~state)
                                       (~parse-expression-code ~state 0) 0) 0))))
                        (if (= (~current-byte-code ~state) ~comma)
                             (do (~advance-code ~state) 0) (break)))))
                   (~consume-code ~state ~object-close)
                   (if (= (~current-byte-code ~state) ~question)
                       (do (~advance-code ~state) 0) 0)
                   (if (= (~current-byte-code ~state) ~colon)
                       (do (~parse-type-code ~state pattern-stop-a pattern-stop-b) 0) 0)
                   (if (and allow-default (= (~current-byte-code ~state) ~equals))
                       (do (~advance-code ~state) (~parse-expression-code ~state 0) 0) 0)
                   0)
               (if (= (~current-byte-code ~state) ~array-open)
                   (do
                     (~advance-code ~state)
                     (loop
                       (if (= (~current-byte-code ~state) ~array-close) (break)
                       (if (= (~current-byte-code ~state) ~comma)
                             (do (~advance-code ~state) 0)
                           (do
                             (if (and (= (~current-byte-code ~state) ~dot)
                                      (= (~adjacent-byte-code ~state 1) ~dot)
                                      (= (~adjacent-byte-code ~state 2) ~dot))
                                 (do (~advance-count-code ~state 3) 0) 0)
                             (~function-name ~state true ~comma ~array-close)
                             (if (= (~current-byte-code ~state) ~comma)
                                 (do (~advance-code ~state) 0) (break))))))
                     (~consume-code ~state ~array-close)
                     (if (= (~current-byte-code ~state) ~question)
                         (do (~advance-code ~state) 0) 0)
                     (if (= (~current-byte-code ~state) ~colon)
                         (do (~parse-type-code ~state pattern-stop-a pattern-stop-b) 0) 0)
                     (if (and allow-default (= (~current-byte-code ~state) ~equals))
                         (do (~advance-code ~state) (~parse-expression-code ~state 0) 0) 0)
                     0)
                 (do (~fail-code ~state ~expected-error) 0)))))
         0))))

(defn compile-arrow-expression [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 14)
                (generator-form? production "arrow-expression")))
      (generator-fail production "invalid arrow-expression production")
    (let [state-type (backend-value backend "state-type")
          result-type (backend-value backend "expression-result-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          pattern-parser (backend-value backend
                           (p/code-sym (field-value production "pattern-parser")))
          type-parser (backend-value backend
                        (p/code-sym (field-value production "type-parser")))
          parse-block-code (backend-value backend "parse-block")
          parse-expression-code (backend-value backend "parse-expression")
          current-position-code (backend-value backend "current-position")
          current-byte-code (backend-value backend "current-byte")
          event-position-code (backend-value backend "event-position")
          advance-code (backend-value backend "advance")
          consume-code (backend-value backend "consume-byte")
          fail-code (backend-value backend "fail")
          check-build-code (backend-value backend "check-build")
          ok-error (backend-value backend "ok-error")
          expected-error (backend-value backend "expected-error")
          open (field-value production "open") close (field-value production "close")
          comma (field-value production "separator")
          type-prefix (field-value production "type-prefix")
          equals (field-value production "equals") greater (field-value production "greater")
          body-open (field-value production "body-open") arrow-op (field-value production "emit-op")
          return-op (field-value production "return-op") state (p/fresh-identifier "state")]
      `(defn ~function-name [(~state (ptr ~state-type))] (-> ~result-type)
         (let [start (~current-position-code ~state) parent-block (.block ~state)
               parent-scope (.scope ~state) parent-function-scope (.function-scope ~state)
               parent-terminated (.terminated ~state)
               (mut logical-end) start
               arena (.arena (.builder ~state)) value (.value-count arena)
               arrow-result (builder/add-op! (.builder ~state) parent-block ~arrow-op
                              (cast u32 0) (cast u32 0) start start (cast u32 1))
               arrow (~check-build-code ~state arrow-result)
               region-result (builder/add-region! (.builder ~state) arrow)
               region (~check-build-code ~state region-result)
               attached (builder/add-op-region! (.builder ~state) arrow region)
               entry-result (builder/add-block! (.builder ~state) region)
               entry (~check-build-code ~state entry-result)
               scope-result (builder/add-scope! (.builder ~state) parent-scope start
                              (cast u32 (.source-size ~state)))
               function-scope (~check-build-code ~state scope-result)]
           (~check-build-code ~state attached)
           (set! (.block ~state) entry)
           (set! (.scope ~state) function-scope)
           (set! (.function-scope ~state) function-scope)
           (set! (.terminated ~state) false)
           (if (= (~current-byte-code ~state) ~open)
               (do
                 (~advance-code ~state)
                 (if (= (~current-byte-code ~state) ~close) 0
                   (loop
                     (~pattern-parser ~state true ~comma ~close)
                     (if (= (~current-byte-code ~state) ~comma)
                         (do (~advance-code ~state) 0) (break))))
                 (do (~consume-code ~state ~close) 0))
             (do (~pattern-parser ~state true ~comma ~close) 0))
           (if (= (~current-byte-code ~state) ~type-prefix)
               (~type-parser ~state ~equals ~equals) 0)
           (if (~consume-code ~state ~equals)
               (do (~consume-code ~state ~greater) 0) 0)
           (if (= (.error ~state) ~ok-error)
               (if (= (~current-byte-code ~state) ~body-open)
                 (do
                     (~parse-block-code ~state)
                     (if (> (.event-index ~state) 0)
                         (let [closed-event (load (p/index (.events ~state)
                                                   (- (.event-index ~state) 1)))]
                           (store! logical-end
                             (+ (~event-position-code closed-event) (cast u32 1)))) 0)
                     (if (and (= (.error ~state) ~ok-error) (not (.terminated ~state)))
                         (let [end (~current-position-code ~state)
                               implicit (builder/add-op! (.builder ~state) (.block ~state)
                                          ~return-op (cast u32 0) (cast u32 0)
                                          end end (cast u32 0))]
                           (~check-build-code ~state implicit)) 0)
                     0)
                 (do
                   (let [body (~parse-expression-code ~state 0)
                         returned (builder/add-op! (.builder ~state) (.block ~state)
                                    ~return-op (cast u32 0) (cast u32 0)
                                    (.start body) (.end body) (cast u32 0))]
                     (let [return-id (~check-build-code ~state returned)
                           operand (builder/add-operand! (.builder ~state) return-id (.value body))]
                       (~check-build-code ~state operand)
                       (set! (.terminated ~state) true)
                       (store! logical-end (.end body))))
                   0)) 0)
           (let [end (load logical-end)
                 scope-end (builder/set-scope-end! (.builder ~state) function-scope end)
                 arrow-end (builder/set-op-span! (.builder ~state) arrow start end)]
             (~check-build-code ~state scope-end)
             (~check-build-code ~state arrow-end)
             (set! (.block ~state) parent-block)
             (set! (.scope ~state) parent-scope)
             (set! (.function-scope ~state) parent-function-scope)
             (set! (.terminated ~state) parent-terminated)
             (~result-type :value value :start start :end end)))))))

(defn compile-jsx-element [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 13)
                (generator-form? production "jsx-element")))
      (generator-fail production "invalid jsx-element production")
    (let [state-type (backend-value backend "state-type")
          result-type (backend-value backend "expression-result-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          parse-expression-code (backend-value backend "parse-expression")
          parse-string-code (backend-value backend "parse-string")
          current-position-code (backend-value backend "current-position")
          current-byte-code (backend-value backend "current-byte")
          adjacent-byte-code (backend-value backend "adjacent-event-byte")
          word-end-code (backend-value backend "word-end")
          advance-code (backend-value backend "advance")
          advance-count-code (backend-value backend "advance-count")
          consume-code (backend-value backend "consume-byte")
          fail-code (backend-value backend "fail")
          push-value-code (backend-value backend "push-scratch-value")
          emit-list-code (backend-value backend "emit-scratch-list-op")
          ok-error (backend-value backend "ok-error")
          expected-error (backend-value backend "expected-error")
          open (field-value production "open") close (field-value production "close")
          slash (field-value production "slash") dot (field-value production "dot")
          dash (field-value production "dash")
          expression-open (field-value production "expression-open")
          expression-close (field-value production "expression-close")
          equals (field-value production "equals")
          string-event (field-value production "string-event")
          event-kind-code (backend-value backend "event-kind")
          current-event-code (backend-value backend "current-event")
          opcode (field-value production "emit-op") state (p/fresh-identifier "state")]
      `(defn ~function-name [(~state (ptr ~state-type))] (-> ~result-type)
         (let [scratch (.scratch ~state) mark (.value-count scratch)
               start (~current-position-code ~state) _open (~advance-code ~state)
               (mut fragment) false]
           (if (= (~current-byte-code ~state) ~close)
               (store! fragment true)
             (let [name-start (~current-position-code ~state)
                   name-end (~word-end-code ~state name-start)]
               (if (= name-start name-end) (do (~fail-code ~state ~expected-error) 0)
                 (do
                   (~advance-code ~state)
                   (loop
                     (if (!= (~current-byte-code ~state) ~dot) (break)
                       (do
                         (~advance-code ~state)
                         (let [part-start (~current-position-code ~state)]
                           (if (= part-start (~word-end-code ~state part-start))
                               (do (~fail-code ~state ~expected-error) (break) 0)
                             (~advance-code ~state))))))))))
           (loop
             (if (or (!= (.error ~state) ~ok-error)
                     (= (~current-byte-code ~state) ~close)
                     (= (~current-byte-code ~state) ~slash)) (break)
               (if (= (~current-byte-code ~state) ~expression-open)
                   (do
                     (~advance-code ~state)
                     (if (and (= (~current-byte-code ~state) ~dot)
                              (= (~adjacent-byte-code ~state 1) ~dot)
                              (= (~adjacent-byte-code ~state 2) ~dot))
                         (~advance-count-code ~state 3) 0)
                     (let [value (~parse-expression-code ~state 0)]
                       (~push-value-code ~state (.value value)))
                     (do (~consume-code ~state ~expression-close) 0))
                 (let [attribute-start (~current-position-code ~state)
                       attribute-end (~word-end-code ~state attribute-start)]
                   (if (= attribute-start attribute-end)
                       (do (~fail-code ~state ~expected-error) (break) 0)
                     (do
                       (~advance-code ~state)
                       (loop
                         (if (!= (~current-byte-code ~state) ~dash) (break)
                           (do
                             (~advance-code ~state)
                             (let [part-start (~current-position-code ~state)]
                               (if (= part-start (~word-end-code ~state part-start))
                                   (do (~fail-code ~state ~expected-error) (break) 0)
                                 (~advance-code ~state))))))
                       (if (= (~current-byte-code ~state) ~equals)
                           (do
                             (~advance-code ~state)
                             (if (= (~current-byte-code ~state) ~expression-open)
                                 (do
                                   (~advance-code ~state)
                                   (let [value (~parse-expression-code ~state 0)]
                                     (~push-value-code ~state (.value value)))
                                   (do (~consume-code ~state ~expression-close) 0))
                               (if (= (~event-kind-code (~current-event-code ~state))
                                      (cast u8 ~string-event))
                                   (let [value (~parse-string-code ~state)]
                                     (~push-value-code ~state (.value value)))
                                 (do (~fail-code ~state ~expected-error) 0)))
                             0) 0)))))))
           (if (= (~current-byte-code ~state) ~slash)
               (do
                 (~advance-code ~state)
                 (let [end (~current-position-code ~state)]
                   (~consume-code ~state ~close)
                   (~emit-list-code ~state ~opcode start (+ end (cast u32 1)) mark)))
             (do
               (~consume-code ~state ~close)
               (loop
                 (if (or (!= (.error ~state) ~ok-error)
                         (>= (.event-index ~state) (.event-count ~state))) (break)
                   (if (and (= (~current-byte-code ~state) ~open)
                            (= (~adjacent-byte-code ~state 1) ~slash))
                       (break)
                     (if (= (~current-byte-code ~state) ~open)
                         (let [child (~function-name ~state)]
                           (~push-value-code ~state (.value child)))
                       (if (= (~current-byte-code ~state) ~expression-open)
                           (do
                             (~advance-code ~state)
                             (if (= (~current-byte-code ~state) ~expression-close)
                                 0
                               (let [child (~parse-expression-code ~state 0)]
                                 (~push-value-code ~state (.value child))))
                             (do (~consume-code ~state ~expression-close) 0))
                         (~advance-code ~state))))))
               (~advance-count-code ~state 2)
               (if (not (load fragment))
                   (loop
                     (if (= (~current-byte-code ~state) ~close) (break)
                       (~advance-code ~state))) 0)
               (let [end (~current-position-code ~state)]
                 (~consume-code ~state ~close)
                 (~emit-list-code ~state ~opcode start (+ end (cast u32 1)) mark)))))))))

(defn compile-postfix-type-assertion [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 8)
                (generator-form? production "postfix-type-assertion")))
      (generator-fail production "invalid postfix type assertion")
    (let [state-type (backend-value backend "state-type")
          result-type (backend-value backend "expression-result-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          current-position-code (backend-value backend "current-position")
          current-byte-code (backend-value backend "current-byte")
          advance-code (backend-value backend "advance")
          check-build-code (backend-value backend "check-build")
          keyword (field-value production "keyword") stops (field-value production "stops")
          open (field-value production "open") close (field-value production "close")
          opcode (field-value production "emit-op") state (p/fresh-identifier "state")
          input (p/fresh-identifier "input") byte-id (p/fresh-identifier "byte")]
      `(defn ~function-name [(~state (ptr ~state-type)) (~input ~result-type)] (-> ~result-type)
         (let [assertion-start (~current-position-code ~state) _as (~advance-code ~state)
               type-start (~current-position-code ~state) (mut depth) 0 (mut consumed) false]
           (loop
             (if (>= (.event-index ~state) (.event-count ~state)) (break)
               (let [~byte-id (~current-byte-code ~state)]
                 (if (and (= (load depth) 0) (load consumed)
                          (or ~@(let [checks (p/code-list-new) (mut j) 0]
                                  (loop
                                    (if (>= (load j) (p/code-count stops)) (break)
                                      (do (p/code-list-push! checks
                                            `(= ~byte-id ~(p/code-nth stops (load j))))
                                          (set! j (+ (load j) 1)))))
                                  (p/code-list-done checks))))
                     (break)
                   (do
                     (if (= ~byte-id ~open) (set! depth (+ (load depth) 1))
                       (if (and (= ~byte-id ~close) (> (load depth) 0))
                           (set! depth (- (load depth) 1)) 0))
                     (store! consumed true)
                     (~advance-code ~state))))))
           (let [end (~current-position-code ~state) arena (.arena (.builder ~state))
                 value (.value-count arena)
                 operation (builder/add-op! (.builder ~state) (.block ~state) ~opcode
                              type-start end (.start ~input) end (cast u32 1))]
             (let [op (~check-build-code ~state operation)
                   operand (builder/add-operand! (.builder ~state) op (.value ~input))]
               (~check-build-code ~state operand)
               (~result-type :value value :start (.start ~input) :end end))))))))

(defn compile-postfix-chain [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 8)
                (generator-form? production "postfix-chain")))
      (generator-fail production "invalid postfix-chain production")
    (let [state-type (backend-value backend "state-type")
          result-type (backend-value backend "expression-result-type")
          function-role (field-value production "function")
          function-name (backend-value backend (p/code-sym function-role))
          primary-role (field-value production "primary")
          primary-code (backend-value backend (p/code-sym primary-role))
          dispatch-role (field-value production "dispatch")
          dispatch-code (backend-value backend (p/code-sym dispatch-role))
          current-byte-code (backend-value backend "current-byte")
          current-event-code (backend-value backend "current-event")
          event-kind-code (backend-value backend "event-kind")
          current-keyword-code (backend-value backend "current-keyword")
          ok-error (backend-value backend "ok-error")
          forms (field-value production "forms")
          assertion-keyword (field-value production "assertion-keyword")
          assertion-parser (backend-value backend
                              (p/code-sym (field-value production "assertion-parser")))
          state (p/fresh-identifier "state") value-id (p/fresh-identifier "value")
          form-id (p/fresh-identifier "form")]
      `(defn ~function-name [(~state (ptr ~state-type))] (-> ~result-type)
         (let [(mut ~value-id) (~primary-code ~state)]
           (loop
             (let [~form-id (~dispatch-code
                          (if (< (.event-index ~state) (.event-count ~state))
                              (~event-kind-code (~current-event-code ~state))
                            (cast u8 0))
                          (~current-byte-code ~state))]
               (if (!= (.error ~state) ~ok-error) (break)
                 (if (~current-keyword-code ~state ~assertion-keyword)
                     (store! ~value-id (~assertion-parser ~state (load ~value-id)))
                   (cond
                   ~@(let [clauses (p/code-list-new) (mut j) 0]
                       (loop
                         (if (>= (load j) (p/code-count forms)) (break)
                             (let [entry (p/code-nth forms (load j))
                                 parser-code (backend-value backend
                                               (p/code-sym (p/code-nth entry 1)))
                                 predicate (p/code-nth entry 2)
                                 predicate-code
                                   (if (generator-symbol? predicate "always") `true
                                     (let [predicate-function
                                           (backend-value backend (p/code-sym predicate))]
                                       `(~predicate-function ~state)))]
                             (p/code-list-push! clauses
                               `(and (= ~form-id ~(p/code-nth entry 0)) ~predicate-code))
                             (p/code-list-push! clauses
                               `(store! ~value-id
                                  (~parser-code ~state (load ~value-id))))
                             (set! j (+ (load j) 1)))))
                       (p/code-list-done clauses))
                   :else (break))))))
           (load ~value-id))))))

(defn compile-named-export [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 10)
                (generator-form? production "named-export")))
      (generator-fail production "invalid named-export production")
    (let [state-type (backend-value backend "state-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          current-position-code (backend-value backend "current-position")
          current-byte-code (backend-value backend "current-byte")
          current-keyword-code (backend-value backend "current-keyword")
          word-end-code (backend-value backend "word-end")
          advance-code (backend-value backend "advance")
          consume-code (backend-value backend "consume-byte")
          fail-code (backend-value backend "fail")
          check-build-code (backend-value backend "check-build")
          parse-string-code (backend-value backend "parse-string")
          terminator-parser (backend-value backend
                              (p/code-sym (field-value production "terminator-parser")))
          expected-error (backend-value backend "expected-error")
          open (field-value production "open") close (field-value production "close")
          comma (field-value production "separator") as-keyword (field-value production "as-keyword")
          from-keyword (field-value production "from-keyword") opcode (field-value production "emit-op")
          state (p/fresh-identifier "state")]
      `(defn ~function-name [(~state (ptr ~state-type))] (-> i64)
         (let [start (~current-position-code ~state) _export (~advance-code ~state)]
           (~consume-code ~state ~open)
           (loop
             (if (= (~current-byte-code ~state) ~close) (break)
               (let [name-start (~current-position-code ~state)
                     name-end (~word-end-code ~state name-start)]
                 (if (= name-start name-end)
                     (do (~fail-code ~state ~expected-error) (break) 0)
                   (do
                     (~advance-code ~state)
                     (if (~current-keyword-code ~state ~as-keyword)
                         (do
                           (~advance-code ~state)
                           (let [alias-start (~current-position-code ~state)]
                             (if (= alias-start (~word-end-code ~state alias-start))
                                 (do (~fail-code ~state ~expected-error) 0)
                               (do (~advance-code ~state) 0)))
                           0) 0)
                     (if (= (~current-byte-code ~state) ~comma)
                         (do (~advance-code ~state) 0) (break)))))))
           (~consume-code ~state ~close)
           (if (~current-keyword-code ~state ~from-keyword)
               (do (~advance-code ~state) (~parse-string-code ~state) 0) 0)
           (let [end (~terminator-parser ~state (~current-position-code ~state))
                 operation (builder/add-op! (.builder ~state) (.block ~state) ~opcode
                              (cast u32 0) (cast u32 0) start end (cast u32 0))]
             (~check-build-code ~state operation)))
         0))))

(defn compile-statement-dispatch [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 27)
                (generator-form? production "statement-dispatch")))
      (generator-fail production "invalid statement-dispatch production")
    (let [state-type (backend-value backend "state-type")
          function-role (field-value production "function")
          function-name (backend-value backend (p/code-sym function-role))
          current-byte-code (backend-value backend "current-byte")
          next-event-byte-code (backend-value backend "next-event-byte")
          current-keyword-code (backend-value backend "current-keyword")
          current-position-code (backend-value backend "current-position")
          advance-code (backend-value backend "advance")
          check-build-code (backend-value backend "check-build")
          block-parser (backend-value backend (p/code-sym (field-value production "block-parser")))
          declaration-parser (backend-value backend (p/code-sym (field-value production "declaration-parser")))
          return-parser (backend-value backend (p/code-sym (field-value production "return-parser")))
          if-parser (backend-value backend (p/code-sym (field-value production "if-parser")))
          while-parser (backend-value backend (p/code-sym (field-value production "while-parser")))
          function-parser (backend-value backend (p/code-sym (field-value production "function-parser")))
          type-parser (backend-value backend (p/code-sym (field-value production "type-parser")))
          interface-parser (backend-value backend
                              (p/code-sym (field-value production "interface-parser")))
          import-parser (backend-value backend (p/code-sym (field-value production "import-parser")))
          named-export-parser (backend-value backend
                                (p/code-sym (field-value production "named-export-parser")))
          fallback-parser (backend-value backend (p/code-sym (field-value production "fallback-parser")))
          block-open (field-value production "block-open")
          declaration-keywords (field-value production "declaration-keywords")
          return-keyword (field-value production "return-keyword")
          if-keyword (field-value production "if-keyword")
          while-keyword (field-value production "while-keyword")
          function-keyword (field-value production "function-keyword")
          type-keyword (field-value production "type-keyword")
          interface-keyword (field-value production "interface-keyword")
          module-keyword (field-value production "module-keyword")
          import-keyword (field-value production "import-keyword")
          export-keyword (field-value production "export-keyword")
          modifier-keywords (field-value production "modifier-keywords")
          modifier-op (field-value production "modifier-op")
          state (p/fresh-identifier "state")]
      `(defn ~function-name [(~state (ptr ~state-type))] (-> i64)
         (let [modifier-start (~current-position-code ~state) (mut modifiers) 0]
           (loop
             (if (or (and (~current-keyword-code ~state ~export-keyword)
                          (= (~next-event-byte-code ~state 1) ~block-open))
                     (not (or ~@(let [checks (p/code-list-new) (mut j) 0]
                               (loop
                                 (if (>= (load j) (p/code-count modifier-keywords)) (break)
                                   (do
                                     (p/code-list-push! checks
                                       `(~current-keyword-code ~state
                                          ~(p/code-nth modifier-keywords (load j))))
                                     (set! j (+ (load j) 1)))))
                               (p/code-list-done checks))))) (break)
               (do (~advance-code ~state) (set! modifiers (+ (load modifiers) 1)))))
           (if (> (load modifiers) 0)
               (let [operation (builder/add-op! (.builder ~state) (.block ~state)
                                  ~modifier-op (cast u32 0) (cast u32 0)
                                  modifier-start (~current-position-code ~state)
                                  (cast u32 0))]
                 (~check-build-code ~state operation)) 0)
           (cond
             (and (~current-keyword-code ~state ~export-keyword)
                  (= (~next-event-byte-code ~state 1) ~block-open))
               (~named-export-parser ~state)
             (= (~current-byte-code ~state) ~block-open) (~block-parser ~state)
             (or ~@(let [checks (p/code-list-new) (mut j) 0]
                     (loop
                       (if (>= (load j) (p/code-count declaration-keywords)) (break)
                         (do
                           (p/code-list-push! checks
                             `(~current-keyword-code ~state
                                ~(p/code-nth declaration-keywords (load j))))
                           (set! j (+ (load j) 1)))))
                     (p/code-list-done checks)))
               (~declaration-parser ~state)
             (~current-keyword-code ~state ~return-keyword) (~return-parser ~state)
             (~current-keyword-code ~state ~if-keyword) (~if-parser ~state)
             (~current-keyword-code ~state ~while-keyword) (~while-parser ~state)
             (~current-keyword-code ~state ~function-keyword) (~function-parser ~state)
             (~current-keyword-code ~state ~type-keyword) (~type-parser ~state)
             (~current-keyword-code ~state ~interface-keyword) (~interface-parser ~state)
             (~current-keyword-code ~state ~module-keyword) (~interface-parser ~state)
             (~current-keyword-code ~state ~import-keyword) (~import-parser ~state)
             :else (~fallback-parser ~state)))))))

(defn compile-scoped-repeat [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 7)
                (generator-form? production "scoped-repeat")))
      (generator-fail production "invalid scoped-repeat production")
    (let [state-type (backend-value backend "state-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          current-position-code (backend-value backend "current-position")
          current-byte-code (backend-value backend "current-byte")
          consume-code (backend-value backend "consume-byte")
          fail-code (backend-value backend "fail")
          check-build-code (backend-value backend "check-build")
          element-parser (backend-value backend
                           (p/code-sym (field-value production "element-parser")))
          ok-error (backend-value backend "ok-error")
          after-terminator-error (backend-value backend "after-terminator-error")
          open (field-value production "open") close (field-value production "close")
          state (p/fresh-identifier "state")]
      `(defn ~function-name [(~state (ptr ~state-type))] (-> i64)
         (let [start (~current-position-code ~state) parent-scope (.scope ~state)]
           (if (~consume-code ~state ~open)
               (let [scope-result (builder/add-scope! (.builder ~state) parent-scope start
                                      (cast u32 (.source-size ~state)))
                     scope (~check-build-code ~state scope-result)]
                 (set! (.scope ~state) scope)
                 (loop
                   (if (or (!= (.error ~state) ~ok-error)
                           (>= (.event-index ~state) (.event-count ~state))
                           (= (~current-byte-code ~state) ~close)) (break)
                     (if (.terminated ~state)
                         (do (~fail-code ~state ~after-terminator-error) 0)
                       (~element-parser ~state))))
                 (let [end-position (~current-position-code ~state)]
                   (if (~consume-code ~state ~close)
                       (let [ended (builder/set-scope-end! (.builder ~state) scope
                                      (+ end-position (cast u32 1)))]
                         (~check-build-code ~state ended)) 0))
                 (set! (.scope ~state) parent-scope)) 0))
         0))))

(defn compile-binding-declaration [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 9)
                (generator-form? production "binding-declaration")))
      (generator-fail production "invalid binding-declaration production")
    (let [state-type (backend-value backend "state-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          current-position-code (backend-value backend "current-position")
          current-byte-code (backend-value backend "current-byte")
          word-end-code (backend-value backend "word-end")
          span-equals-code (backend-value backend "span-equals")
          advance-code (backend-value backend "advance")
          consume-code (backend-value backend "consume-byte")
          parse-expression-code (backend-value backend "parse-expression")
          pattern-parser-code (backend-value backend
                                (p/code-sym (field-value production "pattern-parser")))
          terminator-parser (backend-value backend
                              (p/code-sym (field-value production "terminator-parser")))
          check-build-code (backend-value backend "check-build")
          ok-error (backend-value backend "ok-error")
          kinds (field-value production "kinds")
          equals (field-value production "equals")
          terminator (field-value production "terminator")
          opcode (field-value production "emit-op")
          first-kind (p/code-nth kinds 0) second-kind (p/code-nth kinds 1)
          default-kind (p/code-nth kinds 2)
          state (p/fresh-identifier "state")]
      `(defn ~function-name [(~state (ptr ~state-type))] (-> i64)
         (let [start (~current-position-code ~state)
               keyword-end (~word-end-code ~state start)
               declaration-kind
                 (if (~span-equals-code ~state start keyword-end
                       ~(p/code-nth first-kind 0))
                     ~(p/code-nth first-kind 1)
                   (if (~span-equals-code ~state start keyword-end
                         ~(p/code-nth second-kind 0))
                       ~(p/code-nth second-kind 1)
                     ~(p/code-nth default-kind 1)))]
           (~advance-code ~state)
           (let [name-start (~current-position-code ~state)
                 initial-name-end (~word-end-code ~state name-start)]
             (~pattern-parser-code ~state false ~equals ~equals)
             (let [name-end (if (= name-start initial-name-end)
                                (~current-position-code ~state) initial-name-end)]
               (if (~consume-code ~state ~equals)
                   (let [value (~parse-expression-code ~state 0)]
                     (let [statement-end (~terminator-parser ~state (.end value))]
                       (if (= (.error ~state) ~ok-error)
                           (let [operation (builder/add-op! (.builder ~state) (.block ~state)
                                             ~opcode name-start name-end start
                                             statement-end (cast u32 0))]
                             (let [op (~check-build-code ~state operation)
                                   operand (builder/add-operand! (.builder ~state) op
                                                                 (.value value))
                                   kind-result (builder/set-op-immediate! (.builder ~state) op
                                                                          declaration-kind)]
                               (~check-build-code ~state operand)
                               (~check-build-code ~state kind-result)))
                         0)))
                 0))))
         0))))

(defn compile-primary-dispatch [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 13)
                (generator-form? production "primary-dispatch")))
      (generator-fail production "invalid primary-dispatch production")
    (let [state-type (backend-value backend "state-type")
          result-type (backend-value backend "expression-result-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          dispatch-code (backend-value backend
                          (p/code-sym (field-value production "dispatch")))
          current-event-code (backend-value backend "current-event")
          event-kind-code (backend-value backend "event-kind")
          current-byte-code (backend-value backend "current-byte")
          current-position-code (backend-value backend "current-position")
          advance-code (backend-value backend "advance")
          consume-code (backend-value backend "consume-byte")
          fail-code (backend-value backend "fail")
          parse-expression-code (backend-value backend "parse-expression")
          check-build-code (backend-value backend "check-build")
          unexpected-error (backend-value backend "unexpected-error")
          expected-error (backend-value backend "expected-error")
          forms (field-value production "forms") parsers (field-value production "parsers")
          word-parser (backend-value backend (p/code-sym (p/code-nth parsers 0)))
          string-parser (backend-value backend (p/code-sym (p/code-nth parsers 1)))
          array-parser (backend-value backend (p/code-sym (p/code-nth parsers 2)))
          object-parser (backend-value backend (p/code-sym (p/code-nth parsers 3)))
          group-close (field-value production "group-close")
          unary-forms (field-value production "unary-forms")
          unary-precedence (field-value production "unary-precedence")
          unary-op (field-value production "unary-op")
          arrow-predicate (backend-value backend
                            (p/code-sym (field-value production "arrow-predicate")))
          arrow-parser (backend-value backend
                         (p/code-sym (field-value production "arrow-parser")))
          jsx-parser (backend-value backend
                       (p/code-sym (field-value production "jsx-parser")))
          state (p/fresh-identifier "state") form-id (p/fresh-identifier "form")]
      `(defn ~function-name [(~state (ptr ~state-type))] (-> ~result-type)
         (if (>= (.event-index ~state) (.event-count ~state))
             (~fail-code ~state ~unexpected-error)
           (if (~arrow-predicate ~state) (~arrow-parser ~state)
             (let [~form-id (~dispatch-code (~event-kind-code (~current-event-code ~state))
                                            (~current-byte-code ~state))]
             (cond
               (= ~form-id ~(p/code-nth forms 0)) (~word-parser ~state)
               (= ~form-id ~(p/code-nth forms 1)) (~string-parser ~state)
               (= ~form-id ~(p/code-nth forms 2))
                 (do
                   (~advance-code ~state)
                   (let [value (~parse-expression-code ~state 0)]
                     (if (~consume-code ~state ~group-close) value
                       (~fail-code ~state ~expected-error))))
               (or ~@(let [checks (p/code-list-new) (mut j) 0]
                       (loop
                         (if (>= (load j) (p/code-count unary-forms)) (break)
                           (do (p/code-list-push! checks
                                 `(= ~form-id ~(p/code-nth unary-forms (load j))))
                               (set! j (+ (load j) 1)))))
                       (p/code-list-done checks)))
                 (let [start (~current-position-code ~state)
                       operator (~current-byte-code ~state)
                       _advance (~advance-code ~state)
                       argument (~parse-expression-code ~state ~unary-precedence)
                       arena (.arena (.builder ~state)) value (.value-count arena)
                       operation-result
                         (builder/add-op! (.builder ~state) (.block ~state) ~unary-op
                           (cast u32 0) (cast u32 0) start (.end argument) (cast u32 1))]
                   (let [op (~check-build-code ~state operation-result)
                         operand (builder/add-operand! (.builder ~state) op (.value argument))
                         immediate (builder/set-op-immediate! (.builder ~state) op
                                                              (cast u64 operator))]
                     (~check-build-code ~state operand)
                     (~check-build-code ~state immediate)
                     (~result-type :value value :start start :end (.end argument))))
               (= ~form-id ~(p/code-nth forms 3)) (~array-parser ~state)
               (= ~form-id ~(p/code-nth forms 4)) (~object-parser ~state)
               (= ~form-id ~(p/code-nth forms 5)) (~jsx-parser ~state)
               :else (~fail-code ~state ~unexpected-error)))))))))

(defn compile-program-root [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 5)
                (generator-form? production "program-root")))
      (generator-fail production "invalid program-root production")
    (let [state-type (backend-value backend "state-type")
          result-type (backend-value backend "direct-result-type")
          scratch-type (backend-value backend "parser-scratch-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          element-parser (backend-value backend
                           (p/code-sym (field-value production "element-parser")))
          check-id-code (backend-value backend "check-build-result-id")
          check-build-code (backend-value backend "check-build")
          fail-code (backend-value backend "fail")
          ok-error (backend-value backend "ok-error")
          builder-error (backend-value backend "builder-error")
          after-terminator-error (backend-value backend "after-terminator-error")
          fallthrough-op (field-value production "fallthrough-op")]
      `(defn ~function-name
         [(source (ptr u8)) (source-size i64) (events (ptr u32)) (event-count i64)
          (ir-builder (ptr builder/IrBuilder)) (parser-scratch (ptr ~scratch-type))]
         (-> ~result-type)
         (let [root-region-result (builder/add-region! ir-builder (cast u32 ir/INVALID-ID))
               root-region (~check-id-code root-region-result)
               root-block-result (builder/add-block! ir-builder root-region)
               root-block (~check-id-code root-block-result)
               root-scope-result (builder/add-scope! ir-builder (cast u32 ir/INVALID-ID)
                                   (cast u32 0) (cast u32 source-size))
               root-scope (~check-id-code root-scope-result)
               state (p/alloc-stack ~state-type)
               lookup-valid (p/alloc-stack (array u8 64))
               lookup-hashes (p/alloc-stack (array u64 64))
               lookup-bindings (p/alloc-stack (array u32 64))
               lookup-counts (p/alloc-stack (array u32 64))
               lookup-starts (p/alloc-stack (array u32 64))
               lookup-ends (p/alloc-stack (array u32 64))]
           (let [(mut cache-index) 0]
             (loop
               (if (>= (load cache-index) 64) (break)
                 (do
                   (store! (p/index lookup-valid (load cache-index)) (cast u8 0))
                   (set! cache-index (+ (load cache-index) 1))))))
           (store! state (~state-type :source source :source-size source-size
                          :events events :event-count event-count :event-index 0
                          :builder ir-builder :scratch parser-scratch
                          :lookup-valid (p/cast (ptr u8) lookup-valid)
                          :lookup-hashes (p/cast (ptr u64) lookup-hashes)
                          :lookup-bindings (p/cast (ptr u32) lookup-bindings)
                          :lookup-counts (p/cast (ptr u32) lookup-counts)
                          :lookup-starts (p/cast (ptr u32) lookup-starts)
                          :lookup-ends (p/cast (ptr u32) lookup-ends)
                          :lookup-capacity 64
                          :block root-block :scope root-scope :function-scope root-scope
                          :error (if (= (.error root-scope-result) builder/BUILD-OK)
                                     ~ok-error ~builder-error)
                          :error-offset (cast u32 0) :terminated false))
           (loop
             (if (or (>= (.event-index state) (.event-count state))
                     (!= (.error state) ~ok-error)) (break)
               (if (.terminated state)
                   (do (~fail-code state ~after-terminator-error) 0)
                 (~element-parser state))))
           (if (and (= (.error state) ~ok-error) (not (.terminated state)))
               (let [unreachable (builder/add-op! ir-builder root-block ~fallthrough-op
                                  (cast u32 0) (cast u32 0)
                                  (cast u32 source-size) (cast u32 source-size)
                                  (cast u32 0))]
                 (~check-build-code state unreachable)) 0)
           (if (and (= (.error state) ~ok-error)
                    (!= (builder/finalize-membership! ir-builder) builder/BUILD-OK))
               (do (~fail-code state ~builder-error) 0) 0)
           (~result-type :error (.error state) :error-offset (.error-offset state)
                         :consumed-events (.event-index state)
                         :root-region root-region :root-block root-block))))))

(defn compile-conditional-statement [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 7)
                (generator-form? production "conditional-statement")))
      (generator-fail production "invalid conditional-statement production")
    (let [state-type (backend-value backend "state-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          current-position-code (backend-value backend "current-position")
          advance-code (backend-value backend "advance")
          consume-code (backend-value backend "consume-byte")
          parse-expression-code (backend-value backend "parse-expression")
          parse-statement-code (backend-value backend "parse-statement")
          current-keyword-code (backend-value backend "current-keyword")
          emit-branch-code (backend-value backend "emit-branch")
          check-build-code (backend-value backend "check-build")
          open (field-value production "open") close (field-value production "close")
          else-keyword (field-value production "else-keyword")
          branch-op (field-value production "branch-op")
          state (p/fresh-identifier "state")]
      `(defn ~function-name [(~state (ptr ~state-type))] (-> i64)
         (let [start (~current-position-code ~state) _keyword (~advance-code ~state)]
           (if (not (~consume-code ~state ~open)) 0
             (let [condition (~parse-expression-code ~state 0)]
               (if (not (~consume-code ~state ~close)) 0
                 (let [arena (.arena (.builder ~state)) origin (.block ~state)
                       region (load (p/index (.block-regions arena) (cast i64 origin)))
                       then-result (builder/add-block! (.builder ~state) region)
                       then-block (~check-build-code ~state then-result)
                       else-result (builder/add-block! (.builder ~state) region)
                       else-block (~check-build-code ~state else-result)
                       branch-result (builder/add-op! (.builder ~state) origin ~branch-op
                                      (cast u32 0) (cast u32 0) start
                                      (~current-position-code ~state) (cast u32 0))]
                   (let [branch (~check-build-code ~state branch-result)
                         operand (builder/add-operand! (.builder ~state) branch
                                                       (.value condition))
                         then-successor (builder/add-successor! (.builder ~state) branch
                                                                then-block)
                         else-successor (builder/add-successor! (.builder ~state) branch
                                                                else-block)]
                     (~check-build-code ~state operand)
                     (~check-build-code ~state then-successor)
                     (~check-build-code ~state else-successor))
                   (set! (.block ~state) then-block)
                   (set! (.terminated ~state) false)
                   (~parse-statement-code ~state)
                   (let [then-falls (not (.terminated ~state))]
                     (set! (.block ~state) else-block)
                     (set! (.terminated ~state) false)
                     (if (~current-keyword-code ~state ~else-keyword)
                         (do (~advance-code ~state) (~parse-statement-code ~state)) 0)
                     (let [else-falls (not (.terminated ~state))]
                       (if (or then-falls else-falls)
                           (let [join-result (builder/add-block! (.builder ~state) region)
                                 join-block (~check-build-code ~state join-result)]
                             (if then-falls
                                 (~emit-branch-code ~state then-block join-block) 0)
                             (if else-falls
                                 (~emit-branch-code ~state else-block join-block) 0)
                             (set! (.block ~state) join-block)
                             (set! (.terminated ~state) false))
                         (set! (.terminated ~state) true)))))))))
         0))))

(defn compile-loop-statement [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 6)
                (generator-form? production "loop-statement")))
      (generator-fail production "invalid loop-statement production")
    (let [state-type (backend-value backend "state-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          current-position-code (backend-value backend "current-position")
          advance-code (backend-value backend "advance")
          consume-code (backend-value backend "consume-byte")
          parse-expression-code (backend-value backend "parse-expression")
          parse-statement-code (backend-value backend "parse-statement")
          emit-branch-code (backend-value backend "emit-branch")
          check-build-code (backend-value backend "check-build")
          open (field-value production "open") close (field-value production "close")
          branch-op (field-value production "branch-op")
          state (p/fresh-identifier "state")]
      `(defn ~function-name [(~state (ptr ~state-type))] (-> i64)
         (let [start (~current-position-code ~state) _keyword (~advance-code ~state)]
           (if (not (~consume-code ~state ~open)) 0
             (let [arena (.arena (.builder ~state)) origin (.block ~state)
                   region (load (p/index (.block-regions arena) (cast i64 origin)))
                   header-result (builder/add-block! (.builder ~state) region)
                   header (~check-build-code ~state header-result)
                   body-result (builder/add-block! (.builder ~state) region)
                   body (~check-build-code ~state body-result)
                   exit-result (builder/add-block! (.builder ~state) region)
                   exit-block (~check-build-code ~state exit-result)]
               (~emit-branch-code ~state origin header)
               (set! (.block ~state) header)
               (set! (.terminated ~state) false)
               (let [condition (~parse-expression-code ~state 0)]
                 (if (not (~consume-code ~state ~close)) 0
                   (let [branch-result (builder/add-op! (.builder ~state) header ~branch-op
                                          (cast u32 0) (cast u32 0) start
                                          (~current-position-code ~state) (cast u32 0))]
                     (let [branch (~check-build-code ~state branch-result)
                           operand (builder/add-operand! (.builder ~state) branch
                                                         (.value condition))
                           body-successor (builder/add-successor! (.builder ~state) branch body)
                           exit-successor (builder/add-successor! (.builder ~state) branch
                                                                  exit-block)]
                       (~check-build-code ~state operand)
                       (~check-build-code ~state body-successor)
                       (~check-build-code ~state exit-successor))
                     (set! (.block ~state) body)
                     (set! (.terminated ~state) false)
                     (~parse-statement-code ~state)
                     (if (not (.terminated ~state))
                         (~emit-branch-code ~state (.block ~state) header) 0)
                     (set! (.block ~state) exit-block)
                     (set! (.terminated ~state) false)))))))
         0))))

(defn compile-function-declaration [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 13)
                (generator-form? production "function-declaration")))
      (generator-fail production "invalid function-declaration production")
    (let [state-type (backend-value backend "state-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          current-position-code (backend-value backend "current-position")
          current-byte-code (backend-value backend "current-byte")
          word-end-code (backend-value backend "word-end")
          advance-code (backend-value backend "advance")
          consume-code (backend-value backend "consume-byte")
          fail-code (backend-value backend "fail")
          check-build-code (backend-value backend "check-build")
          parse-block-code (backend-value backend "parse-block")
          parse-type-code (backend-value backend
                            (p/code-sym (field-value production "type-parser")))
          parse-type-parameters-code (backend-value backend
              (p/code-sym (field-value production "type-parameters-parser")))
          pattern-parser-code (backend-value backend
              (p/code-sym (field-value production "pattern-parser")))
          ok-error (backend-value backend "ok-error")
          expected-error (backend-value backend "expected-error")
          open (field-value production "open") comma (field-value production "separator")
          close (field-value production "close") function-op (field-value production "emit-op")
          type-prefix (field-value production "type-prefix")
          type-parameters-open (field-value production "type-parameters-open")
          return-op (field-value production "fallthrough-op")
          state (p/fresh-identifier "state")]
      `(defn ~function-name [(~state (ptr ~state-type))] (-> i64)
         (let [start (~current-position-code ~state) parent-block (.block ~state)
               parent-scope (.scope ~state) parent-function-scope (.function-scope ~state)
               parent-terminated (.terminated ~state) _keyword (~advance-code ~state)
               name-start (~current-position-code ~state)
               name-end (~word-end-code ~state name-start)]
           (if (= name-start name-end)
               (do (~fail-code ~state ~expected-error) 0)
             (do
               (~advance-code ~state)
               (if (= (~current-byte-code ~state) ~type-parameters-open)
                   (~parse-type-parameters-code ~state) 0)
               (let [binding-result (builder/add-binding! (.builder ~state) parent-scope
                                                           name-start name-end)]
                 (~check-build-code ~state binding-result))
               (let [function-result (builder/add-op! (.builder ~state) parent-block
                                      ~function-op name-start name-end start start
                                      (cast u32 0))
                     function-op-id (~check-build-code ~state function-result)
                     region-result (builder/add-region! (.builder ~state) function-op-id)
                     region (~check-build-code ~state region-result)
                     attached (builder/add-op-region! (.builder ~state) function-op-id region)
                     entry-result (builder/add-block! (.builder ~state) region)
                     entry (~check-build-code ~state entry-result)
                     scope-result (builder/add-scope! (.builder ~state) parent-scope start
                                      (cast u32 (.source-size ~state)))
                     function-scope (~check-build-code ~state scope-result)]
                 (~check-build-code ~state attached)
                 (set! (.scope ~state) function-scope)
                 (if (~consume-code ~state ~open)
                     (do
                       (if (= (~current-byte-code ~state) ~close) 0
                         (loop
                           (~pattern-parser-code ~state true ~comma ~close)
                           (if (= (~current-byte-code ~state) ~comma)
                               (do (~advance-code ~state) 0) (break))))
                       (if (~consume-code ~state ~close)
                           (do
                             (if (= (~current-byte-code ~state) ~type-prefix)
                                 (~parse-type-code ~state
                                   (cast u8 123) (cast u8 123)) 0)
                             (set! (.block ~state) entry)
                             (set! (.scope ~state) function-scope)
                             (set! (.function-scope ~state) function-scope)
                             (set! (.terminated ~state) false)
                             (~parse-block-code ~state)
                             (let [end (~current-position-code ~state)]
                               (if (and (= (.error ~state) ~ok-error)
                                        (not (.terminated ~state)))
                                   (let [return-result (builder/add-op! (.builder ~state)
                                                        (.block ~state) ~return-op
                                                        (cast u32 0) (cast u32 0)
                                                        end end (cast u32 0))]
                                     (~check-build-code ~state return-result)) 0)
                               (let [scope-end (builder/set-scope-end! (.builder ~state)
                                                                      function-scope end)
                                     op-end (builder/set-op-span! (.builder ~state)
                                                                  function-op-id start end)]
                                 (~check-build-code ~state scope-end)
                                 (~check-build-code ~state op-end)))
                             (set! (.block ~state) parent-block)
                             (set! (.scope ~state) parent-scope)
                             (set! (.function-scope ~state) parent-function-scope)
                             (set! (.terminated ~state) parent-terminated)) 0)) 0)))))
         0))))

(defn compile-assignment-condition
  [(operators Code) (index i64) (state Code) (current-byte-code Code)
   (adjacent-byte-code Code)] (-> Code)
  (if (>= index (p/code-count operators)) `0
    (let [operator (p/code-nth operators index) text (p/code-str operator)
          width (len text) (mut byte-index) 0 conditions (p/code-list-new)]
      (if (or (= width 0) (> width 4))
          (do (p/report operator "assignment operator width must be in [1, 4]") `0)
        (do
          (loop
            (if (>= (load byte-index) width) (break)
              (do
                (p/code-list-push! conditions
                  (if (= (load byte-index) 0)
                      `(= (~current-byte-code ~state)
                          (cast u8 ~(cast i64 (slice-get text 0))))
                    `(= (~adjacent-byte-code ~state ~(load byte-index))
                        (cast u8 ~(cast i64 (slice-get text (load byte-index)))))))
                (set! byte-index (+ (load byte-index) 1)))))
          `(if (and ~@(p/code-list-done conditions)) ~width
             ~(compile-assignment-condition operators (+ index 1) state
                current-byte-code adjacent-byte-code)))))))

(defn compile-precedence-expression [(backend Code) (production Code)] (-> Code)
  (if (not (and (p/code-list? production) (= (p/code-count production) 12)
                (generator-form? production "precedence-expression")))
      (generator-fail production "invalid precedence-expression production")
    (let [state-type (backend-value backend "state-type")
          result-type (backend-value backend "expression-result-type")
          function-name (backend-value backend
                          (p/code-sym (field-value production "function")))
          postfix-parser (backend-value backend
                           (p/code-sym (field-value production "operand-parser")))
          current-byte-code (backend-value backend "current-byte")
          adjacent-byte-code (backend-value backend "adjacent-event-byte")
          lookahead-code (backend-value backend "binary-lookahead")
          info-code (backend-value backend "binary-info")
          advance-count-code (backend-value backend "advance-count")
          advance-code (backend-value backend "advance")
          consume-code (backend-value backend "consume-byte")
          current-position-code (backend-value backend "current-position")
          check-build-code (backend-value backend "check-build")
          emit-branch-arg-code (backend-value backend "emit-branch-arg")
          fail-code (backend-value backend "fail")
          ok-error (backend-value backend "ok-error")
          expected-error (backend-value backend "expected-error")
          binary-op (field-value production "binary-op")
          conditional-max (field-value production "conditional-max-precedence")
          question (field-value production "question") colon (field-value production "colon")
          alternate-precedence (field-value production "alternate-precedence")
          assignment-max (field-value production "assignment-max-precedence")
          assignment-operators (field-value production "assignment-operators")
          assignment-op (field-value production "assignment-op")
          state (p/fresh-identifier "state") minimum (p/fresh-identifier "minimum")]
      `(defn ~function-name [(~state (ptr ~state-type)) (~minimum i64)] (-> ~result-type)
         (let [(mut left) (~postfix-parser ~state)]
           (loop
             (let [byte0 (~current-byte-code ~state)
                   lookahead (~lookahead-code byte0)
                   byte1 (if (> lookahead 1) (~adjacent-byte-code ~state 1) (cast u8 0))
                   byte2 (if (> lookahead 2) (~adjacent-byte-code ~state 2) (cast u8 0))
                   raw-info (if (= (.error ~state) ~ok-error)
                                (~info-code byte0 byte1 byte2) 0)
                   raw-width (% raw-info 256)
                   info (if (and (> raw-width 0)
                                 (= (~adjacent-byte-code ~state raw-width)
                                    (cast u8 61)))
                            0 raw-info)
                   precedence (/ info 256)]
               (if (or (= precedence 0) (< precedence ~minimum)) (break)
                 (let [width (% info 256)
                       immediate (p/ior (cast u64 byte0)
                                   (p/ior (p/ishl (cast u64 byte1) (cast u64 8))
                                          (p/ishl (cast u64 byte2) (cast u64 16))))]
                   (~advance-count-code ~state width)
                   (let [right (~function-name ~state (+ precedence 1))
                         old-left (load left)
                         arena (.arena (.builder ~state)) value (.value-count arena)
                         operation (builder/add-op! (.builder ~state) (.block ~state) ~binary-op
                                      (cast u32 0) (cast u32 0)
                                      (.start old-left) (.end right) (cast u32 1))]
                     (let [op (~check-build-code ~state operation)
                           lhs (builder/add-operand! (.builder ~state) op (.value old-left))
                           rhs (builder/add-operand! (.builder ~state) op (.value right))
                           imm (builder/set-op-immediate! (.builder ~state) op immediate)]
                       (~check-build-code ~state lhs)
                       (~check-build-code ~state rhs)
                       (~check-build-code ~state imm)
                       (store! left (~result-type :value value :start (.start old-left)
                                                  :end (.end right)))))))))
           (let [completed
                   (if (and (<= ~minimum ~conditional-max)
                            (= (.error ~state) ~ok-error)
                            (= (~current-byte-code ~state) ~question))
                       (let [condition (load left) origin (.block ~state)
                             arena (.arena (.builder ~state))
                             region (load (p/index (.block-regions arena) (cast i64 origin)))
                             _question (~advance-code ~state)
                             then-result (builder/add-block! (.builder ~state) region)
                             then-block (~check-build-code ~state then-result)
                             else-result (builder/add-block! (.builder ~state) region)
                             else-block (~check-build-code ~state else-result)
                             branch-result (builder/add-op! (.builder ~state) origin ir/OP-COND-BR
                                            (cast u32 0) (cast u32 0) (.start condition)
                                            (~current-position-code ~state) (cast u32 0))]
                         (let [branch (~check-build-code ~state branch-result)
                               operand (builder/add-operand! (.builder ~state) branch
                                                             (.value condition))
                               then-successor (builder/add-successor! (.builder ~state) branch
                                                                      then-block)
                               else-successor (builder/add-successor! (.builder ~state) branch
                                                                      else-block)]
                           (~check-build-code ~state operand)
                           (~check-build-code ~state then-successor)
                           (~check-build-code ~state else-successor))
                         (set! (.block ~state) then-block)
                         (let [consequent (~function-name ~state 0) then-exit (.block ~state)]
                           (if (~consume-code ~state ~colon)
                               (do
                                 (set! (.block ~state) else-block)
                                 (let [alternate (~function-name ~state ~alternate-precedence)
                                       else-exit (.block ~state)
                                       join-result (builder/add-block! (.builder ~state) region)
                                       join-block (~check-build-code ~state join-result)
                                       parameter-result (builder/add-block-param! (.builder ~state)
                                                                                  join-block)
                                       parameter (~check-build-code ~state parameter-result)]
                                   (~emit-branch-arg-code ~state then-exit join-block
                                                          (.value consequent))
                                   (~emit-branch-arg-code ~state else-exit join-block
                                                          (.value alternate))
                                   (set! (.block ~state) join-block)
                                   (let [result (p/alloc-stack ~result-type)]
                                     (store! result (~result-type :value parameter
                                                     :start (.start condition)
                                                     :end (.end alternate)))
                                     (load result))))
                             (~fail-code ~state ~expected-error))))
                     (load left))]
             (let [assignment-width
                    (if (and (<= ~minimum ~assignment-max)
                             (= (.error ~state) ~ok-error))
                        ~(compile-assignment-condition assignment-operators 0 state
                           current-byte-code adjacent-byte-code)
                      0)]
               (if (> assignment-width 0)
                 (let [left-value (load completed)
                       byte0 (~current-byte-code ~state)
                       byte1 (if (> assignment-width 1)
                                 (~adjacent-byte-code ~state 1) (cast u8 0))
                       byte2 (if (> assignment-width 2)
                                 (~adjacent-byte-code ~state 2) (cast u8 0))
                       byte3 (if (> assignment-width 3)
                                 (~adjacent-byte-code ~state 3) (cast u8 0))
                       immediate (p/ior (cast u64 byte0)
                                   (p/ior (p/ishl (cast u64 byte1) (cast u64 8))
                                     (p/ior (p/ishl (cast u64 byte2) (cast u64 16))
                                            (p/ishl (cast u64 byte3) (cast u64 24)))))
                       _assignment (~advance-count-code ~state assignment-width)
                       right (~function-name ~state 0)
                       arena (.arena (.builder ~state)) value (.value-count arena)
                       operation-result (builder/add-op! (.builder ~state) (.block ~state)
                                          ~assignment-op (cast u32 0) (cast u32 0)
                                          (.start left-value) (.end right) (cast u32 1))]
                   (let [op (~check-build-code ~state operation-result)
                         lhs (builder/add-operand! (.builder ~state) op (.value left-value))
                         rhs (builder/add-operand! (.builder ~state) op (.value right))
                         immediate-result (builder/set-op-immediate! (.builder ~state) op
                                                                      immediate)]
                     (~check-build-code ~state lhs)
                     (~check-build-code ~state rhs)
                     (~check-build-code ~state immediate-result)
                     (~result-type :value value :start (.start left-value) :end (.end right))))
                 (load completed)))))))))

;; ---------------------------------------------------------------------------
;; Semantic parser DSL specification
;; ---------------------------------------------------------------------------
;; Keep this data-only section at the end of the module. Coil currently expands
;; an imported Code->Code helper as a nested macro too early, so compiler and
;; specification share a module until compile-time library linkage is added.
(defn define-frontend-parser [(backend Code)] (-> Code)
  (let [productions
          `[(word-value identifier-or-number
        (event tape/EVENT-WORD)
        (number-op ir/OP-JS-NUMBER)
        (identifier-op ir/OP-JS-IDENTIFIER))
      (quoted-value string-expression
        (emit-op ir/OP-JS-STRING))
      (erased-type-span type-annotation
        (function parse-type-annotation)
        (prefix (syntax/property-production-terminal 1))
        (emit-op ir/OP-TS-TYPE))
      (erased-type-span type-alias-body
        (function parse-type-alias-body)
        (prefix (syntax/assignment-production-terminal 1))
        (emit-op ir/OP-TS-TYPE))
      (erased-type-parameters type-parameters
        (function parse-type-parameters)
        (open (syntax/terminal-byte syntax/less-than))
        (close (syntax/terminal-byte syntax/greater-than))
        (emit-op ir/OP-TS-TYPE))
      (erased-declaration type-alias-declaration
        (function parse-type-alias)
        (prefix (syntax/assignment-production-terminal 1))
        (terminator (syntax/expression-statement-production-terminal 1))
        (type-parser parse-type-alias-body)
        (type-parameters-open (syntax/terminal-byte syntax/less-than))
        (type-parameters-parser parse-type-parameters)
        (emit-op ir/OP-TS-TYPE-ALIAS))
      (erased-braced-declaration interface-declaration
        (function parse-interface)
        (type-parameters-open (syntax/terminal-byte syntax/less-than))
        (type-parameters-parser parse-type-parameters)
        (literal-event tape/EVENT-LITERAL)
        (body-open (syntax/block-production-terminal 0))
        (body-close (syntax/block-production-terminal 2))
        (emit-op ir/OP-TS-INTERFACE))
      (statement-terminator javascript-asi
        (function parse-statement-end)
        (explicit (syntax/expression-statement-production-terminal 1))
        (close-block (syntax/block-production-terminal 2)))
      (import-declaration import-statement
        (function parse-import)
        (from-keyword "from")
        (as-keyword "as")
        (type-keyword "type")
        (open (syntax/object-production-terminal 0))
        (close (syntax/object-production-terminal 2))
        (separator (syntax/object-production-terminal 1))
        (star (syntax/terminal-byte syntax/star))
        (terminator-parser parse-statement-end)
        (emit-op ir/OP-JS-IMPORT)
        (specifier-op ir/OP-JS-IMPORT-SPECIFIER))
      (separated-value array-expression
        (function parse-array)
        (element (parse-expression 0))
        (open (syntax/array-production-terminal 0))
        (separator (syntax/array-production-terminal 1))
        (close (syntax/array-production-terminal 2))
        (allow-trailing true)
        (emit-op ir/OP-JS-ARRAY))
      (separated-value object-expression
        (function parse-object)
        (element (parse-property))
        (open (syntax/object-production-terminal 0))
        (separator (syntax/object-production-terminal 1))
        (close (syntax/object-production-terminal 2))
        (allow-trailing true)
        (emit-op ir/OP-JS-OBJECT))
      (terminated-expression return-statement
        (function parse-return)
        (prefix true)
        (terminator (syntax/return-production-terminal 2))
        (emit-op ir/OP-RETURN)
        (terminator-parser parse-statement-end)
        (terminate true))
      (terminated-expression expression-statement
        (function parse-expression-statement)
        (prefix false)
        (terminator (syntax/expression-statement-production-terminal 1))
        (emit-op ir/OP-JS-EXPRESSION)
        (terminator-parser parse-statement-end)
        (terminate false))
      (named-value object-property
        (function parse-property)
        (separator (syntax/property-production-terminal 1))
        (emit-op ir/OP-JS-PROPERTY))
      (postfix-name member-expression
        (function parse-member)
        (emit-op ir/OP-JS-MEMBER))
      (postfix-separated call-expression
        (function parse-call)
        (separator (syntax/call-production-terminal 1))
        (close (syntax/call-production-terminal 2))
        (element-precedence 0)
        (emit-op ir/OP-JS-CALL))
      (postfix-type-arguments type-argument-instantiation
        (function parse-type-arguments)
        (type-parser parse-type-parameters)
        (emit-op ir/OP-TS-INSTANTIATION))
      (postfix-lookahead type-arguments-before-call
        (function parse-type-arguments-before-call)
        (open (syntax/terminal-byte syntax/less-than))
        (close (syntax/terminal-byte syntax/greater-than))
        (follow (syntax/call-production-terminal 0)))
      (arrow-lookahead arrow-expression-lookahead
        (function parse-arrow-lookahead)
        (word-event tape/EVENT-WORD)
        (open (syntax/group-production-terminal 0))
        (close (syntax/group-production-terminal 2))
        (type-prefix (syntax/property-production-terminal 1))
        (equals (syntax/assignment-production-terminal 1))
        (greater (syntax/terminal-byte syntax/greater-than)))
      (binding-pattern arrow-binding-pattern
        (function parse-binding-pattern)
        (type-parser parse-type-annotation)
        (object-open (syntax/object-production-terminal 0))
        (object-close (syntax/object-production-terminal 2))
        (array-open (syntax/array-production-terminal 0))
        (array-close (syntax/array-production-terminal 2))
        (separator (syntax/object-production-terminal 1))
        (colon (syntax/property-production-terminal 1))
        (equals (syntax/assignment-production-terminal 1))
        (optional (syntax/terminal-byte syntax/question))
        (rest-byte (syntax/terminal-byte syntax/dot))
        (parameter-close (syntax/group-production-terminal 2)))
      (arrow-expression arrow-function
        (function parse-arrow)
        (pattern-parser parse-binding-pattern)
        (type-parser parse-type-annotation)
        (open (syntax/group-production-terminal 0))
        (close (syntax/group-production-terminal 2))
        (separator (syntax/call-production-terminal 1))
        (type-prefix (syntax/property-production-terminal 1))
        (equals (syntax/assignment-production-terminal 1))
        (greater (syntax/terminal-byte syntax/greater-than))
        (body-open (syntax/block-production-terminal 0))
        (emit-op ir/OP-JS-ARROW)
        (return-op ir/OP-RETURN))
      (jsx-element jsx-element-or-fragment
        (function parse-jsx)
        (open (syntax/terminal-byte syntax/less-than))
        (close (syntax/terminal-byte syntax/greater-than))
        (slash (syntax/terminal-byte syntax/slash))
        (dot (syntax/terminal-byte syntax/dot))
        (dash (syntax/terminal-byte syntax/minus))
        (expression-open (syntax/terminal-byte syntax/lbrace))
        (expression-close (syntax/terminal-byte syntax/rbrace))
        (equals (syntax/terminal-byte syntax/equals))
        (string-event tape/EVENT-LITERAL)
        (emit-op ir/OP-JS-JSX-ELEMENT))
      (postfix-type-assertion typescript-as-expression
        (function parse-type-assertion)
        (keyword "as")
        (stops [(syntax/object-production-terminal 1)
                (syntax/group-production-terminal 2)
                (syntax/expression-statement-production-terminal 1)
                (syntax/object-production-terminal 2)
                (syntax/array-production-terminal 2)])
        (open (syntax/terminal-byte syntax/less-than))
        (close (syntax/terminal-byte syntax/greater-than))
        (emit-op ir/OP-TS-INSTANTIATION))
      (postfix-chain postfix-expression
        (function parse-postfix)
        (primary parse-primary)
        (dispatch postfix-form)
        (assertion-keyword "as")
        (assertion-parser parse-type-assertion)
        (forms [[syntax/form-call parse-call always]
                [syntax/form-member parse-member always]
                 [syntax/form-type-arguments parse-type-arguments
                 parse-type-arguments-before-call]]))
      (named-export named-export-statement
        (function parse-named-export)
        (open (syntax/object-production-terminal 0))
        (close (syntax/object-production-terminal 2))
        (separator (syntax/object-production-terminal 1))
        (as-keyword "as")
        (from-keyword "from")
        (terminator-parser parse-statement-end)
        (emit-op ir/OP-JS-EXPORT))
      (statement-dispatch statement
        (function parse-statement)
        (block-open (syntax/block-production-terminal 0))
        (block-parser parse-block)
        (declaration-keywords
          [(syntax/variable-production-keyword 0)
           (syntax/let-production-keyword 0)
           (syntax/var-production-keyword 0)])
        (declaration-parser parse-declaration)
        (return-keyword (syntax/return-production-keyword 0))
        (return-parser parse-return)
        (if-keyword (syntax/if-production-keyword 0))
        (if-parser parse-if)
        (while-keyword (syntax/while-production-keyword 0))
        (while-parser parse-while)
        (function-keyword (syntax/function-production-keyword 0))
        (function-parser parse-function)
        (type-keyword "type")
        (type-parser parse-type-alias)
        (interface-keyword "interface")
        (module-keyword "module")
        (interface-parser parse-interface)
        (import-keyword "import")
        (import-parser parse-import)
        (export-keyword "export")
        (named-export-parser parse-named-export)
        (modifier-keywords ["export" "default" "declare"])
        (modifier-op ir/OP-JS-EXPORT)
        (fallback-parser parse-expression-statement))
      (scoped-repeat block-statement
        (function parse-block)
        (open (syntax/block-production-terminal 0))
        (close (syntax/block-production-terminal 2))
        (element-parser parse-statement)
        (scope true))
      (binding-declaration variable-declaration
        (function parse-declaration)
        (kinds [[(syntax/variable-production-keyword 0) ir/DECL-CONST]
                [(syntax/let-production-keyword 0) ir/DECL-LET]
                [(syntax/var-production-keyword 0) ir/DECL-VAR]])
        (equals (syntax/variable-production-terminal 2))
        (pattern-parser parse-binding-pattern)
        (terminator (syntax/variable-production-terminal 4))
        (terminator-parser parse-statement-end)
        (emit-op ir/OP-JS-DECLARE))
      (primary-dispatch primary-expression
        (function parse-primary)
        (dispatch primary-form)
        (forms [syntax/form-word syntax/form-string syntax/form-group
                syntax/form-array syntax/form-object syntax/form-jsx])
        (parsers [parse-word parse-string parse-array parse-object])
        (group-close (syntax/group-production-terminal 2))
        (unary-forms [syntax/form-unary-bang syntax/form-unary-minus
                      syntax/form-unary-plus syntax/form-unary-tilde])
        (unary-precedence 70)
        (unary-op ir/OP-JS-UNARY)
        (arrow-predicate parse-arrow-lookahead)
        (arrow-parser parse-arrow)
        (jsx-parser parse-jsx))
      (program-root program
        (function parse-direct-program)
        (element-parser parse-statement)
        (fallthrough-op ir/OP-UNREACHABLE))
      (conditional-statement if-statement
        (function parse-if)
        (open (syntax/if-production-terminal 1))
        (close (syntax/if-production-terminal 3))
        (else-keyword (syntax/else-clause-production-keyword 0))
        (branch-op ir/OP-COND-BR))
      (loop-statement while-statement
        (function parse-while)
        (open (syntax/while-production-terminal 1))
        (close (syntax/while-production-terminal 3))
        (branch-op ir/OP-COND-BR))
      (function-declaration function-statement
        (function parse-function)
        (open (syntax/function-production-terminal 2))
        (separator (syntax/function-production-terminal 3))
        (close (syntax/function-production-terminal 4))
        (type-prefix (syntax/property-production-terminal 1))
        (type-parameters-open (syntax/terminal-byte syntax/less-than))
        (type-parser parse-type-annotation)
        (type-parameters-parser parse-type-parameters)
        (pattern-parser parse-binding-pattern)
        (emit-op ir/OP-JS-FUNCTION)
        (fallthrough-op ir/OP-RETURN))
      (precedence-expression expression
        (function parse-expression)
        (operand-parser parse-postfix)
        (binary-op ir/OP-JS-BINARY)
        (conditional-max-precedence 10)
        (question (syntax/conditional-production-terminal 0))
        (colon (syntax/conditional-production-terminal 2))
        (alternate-precedence 10)
        (assignment-max-precedence 5)
        (assignment-operators ["=" "+=" "-=" "*=" "/=" "%=" "&=" "^=" "|="
                               "<<=" ">>=" ">>>=" "**=" "&&=" "||=" "??="])
        (assignment-op ir/OP-JS-ASSIGN))]
        definitions (p/code-list-new) (mut i) 0]
    (loop
      (if (>= (load i) (p/code-count productions)) (break)
        (let [production (p/code-nth productions (load i))]
          (cond
            (generator-form? production "word-value")
              (do (p/code-list-push! definitions
                    (compile-word-value backend production)) 0)
            (generator-form? production "quoted-value")
              (do (p/code-list-push! definitions
                    (compile-quoted-value backend production)) 0)
            (generator-form? production "erased-type-span")
              (do (p/code-list-push! definitions
                    (compile-erased-type-span backend production)) 0)
            (generator-form? production "erased-type-parameters")
              (do (p/code-list-push! definitions
                    (compile-erased-type-parameters backend production)) 0)
            (generator-form? production "erased-declaration")
              (do (p/code-list-push! definitions
                    (compile-erased-declaration backend production)) 0)
            (generator-form? production "erased-braced-declaration")
              (do (p/code-list-push! definitions
                    (compile-erased-braced-declaration backend production)) 0)
            (generator-form? production "statement-terminator")
              (do (p/code-list-push! definitions
                    (compile-statement-terminator backend production)) 0)
            (generator-form? production "import-declaration")
              (do (p/code-list-push! definitions
                    (compile-import-declaration backend production)) 0)
            (generator-form? production "separated-value")
              (do (p/code-list-push! definitions
                    (compile-separated-value backend production)) 0)
            (generator-form? production "terminated-expression")
              (do (p/code-list-push! definitions
                    (compile-terminated-expression backend production)) 0)
            (generator-form? production "named-value")
              (do (p/code-list-push! definitions
                    (compile-named-value backend production)) 0)
            (generator-form? production "postfix-name")
              (do (p/code-list-push! definitions
                    (compile-postfix-name backend production)) 0)
            (generator-form? production "postfix-separated")
              (do (p/code-list-push! definitions
                    (compile-postfix-separated backend production)) 0)
            (generator-form? production "postfix-type-arguments")
              (do (p/code-list-push! definitions
                    (compile-postfix-type-arguments backend production)) 0)
            (generator-form? production "postfix-lookahead")
              (do (p/code-list-push! definitions
                    (compile-postfix-lookahead backend production)) 0)
            (generator-form? production "arrow-lookahead")
              (do (p/code-list-push! definitions
                    (compile-arrow-lookahead backend production)) 0)
            (generator-form? production "binding-pattern")
              (do (p/code-list-push! definitions
                    (compile-binding-pattern backend production)) 0)
            (generator-form? production "arrow-expression")
              (do (p/code-list-push! definitions
                    (compile-arrow-expression backend production)) 0)
            (generator-form? production "jsx-element")
              (do (p/code-list-push! definitions
                    (compile-jsx-element backend production)) 0)
            (generator-form? production "postfix-type-assertion")
              (do (p/code-list-push! definitions
                    (compile-postfix-type-assertion backend production)) 0)
            (generator-form? production "postfix-chain")
              (do (p/code-list-push! definitions
                    (compile-postfix-chain backend production)) 0)
            (generator-form? production "named-export")
              (do (p/code-list-push! definitions
                    (compile-named-export backend production)) 0)
            (generator-form? production "statement-dispatch")
              (do (p/code-list-push! definitions
                    (compile-statement-dispatch backend production)) 0)
            (generator-form? production "scoped-repeat")
              (do (p/code-list-push! definitions
                    (compile-scoped-repeat backend production)) 0)
            (generator-form? production "binding-declaration")
              (do (p/code-list-push! definitions
                    (compile-binding-declaration backend production)) 0)
            (generator-form? production "primary-dispatch")
              (do (p/code-list-push! definitions
                    (compile-primary-dispatch backend production)) 0)
            (generator-form? production "program-root")
              (do (p/code-list-push! definitions
                    (compile-program-root backend production)) 0)
            (generator-form? production "conditional-statement")
              (do (p/code-list-push! definitions
                    (compile-conditional-statement backend production)) 0)
            (generator-form? production "loop-statement")
              (do (p/code-list-push! definitions
                    (compile-loop-statement backend production)) 0)
            (generator-form? production "function-declaration")
              (do (p/code-list-push! definitions
                    (compile-function-declaration backend production)) 0)
            (generator-form? production "precedence-expression")
              (do (p/code-list-push! definitions
                    (compile-precedence-expression backend production)) 0)
            :else
              (do (generator-fail production "unknown generated production kind") 0))
          (set! i (+ (load i) 1)))))
    (let [forms (p/code-list-done definitions)] `(do ~@forms))))
