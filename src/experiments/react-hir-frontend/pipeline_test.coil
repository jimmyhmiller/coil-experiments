(module experiments.react-hir-frontend.pipeline-test)

(import "coil.simd" :as v)
(import "coil.primitive" :as p)
(import "coil.slice" :use [slice-data slice-get])
(import "experiments.react-hir-frontend.frontend" :as frontend)
(import "experiments.react-hir-frontend.pipeline" :as pipeline)
(import "experiments.react-hir-frontend.tape" :as tape)

(defn reference-scan
  [(text (slice u8)) (positions (ptr u32)) (kinds (ptr u8))] (-> pipeline/SourceTape)
  (let [(mut offset) 0 (mut written) 0
        (mut state) (frontend/frontend-initial-state)]
    (loop
      (if (>= (load offset) (len text)) (break)
        (let [remaining (- (len text) (load offset))
              count (if (> remaining 16) 16 remaining)
              bytes (v/vload-partial [u8 16] (p/index (slice-data text) (load offset))
                      count (v/vzero [u8 16]))
              has-next (> remaining 16)
              next (if has-next (slice-get text (+ (load offset) 16)) (cast u8 0))
              chunk (frontend/classify-frontend bytes count next has-next (load state))
              result (tape/write-structural-tape
                       (.code chunk) (cast u32 (+ 1000 (load offset)))
                       (p/index positions (load written)) (p/index kinds (load written)) 16)]
          (store! state (.state chunk))
          (set! written (+ (load written) (.count result)))
          (set! offset (+ (load offset) count)))))
    (pipeline/SourceTape :count (load written) :state (load state))))

(defn test-whole-source-pipeline [] (-> i64)
  (let [text "const x = <X a={42}/>; // comment\nconst y = 'text'; function z(a) { return a?.b ?? `v=${a}`; }"
        positions (p/alloc-stack (array u32 128))
        kinds (p/alloc-stack (array u8 128))
        reference-positions (p/alloc-stack (array u32 128))
        reference-kinds (p/alloc-stack (array u8 128))
        packed-events (p/alloc-stack (array u32 128))
        result (pipeline/scan-source-to-tape64
                 (slice-data text) (len text) (cast u32 1000)
                 (p/cast (ptr u32) positions) (p/cast (ptr u8) kinds)
                 (frontend/frontend-initial-state))
        reference (reference-scan text
                    (p/cast (ptr u32) reference-positions)
                    (p/cast (ptr u8) reference-kinds))
        packed (pipeline/scan-source-to-packed-tape64
                 (slice-data text) (len text) (cast u32 1000)
                 (p/cast (ptr u32) packed-events)
                 (frontend/frontend-initial-state))]
    (assert-eq (.count result) (.count reference))
    (assert-eq (.count packed) (.count reference))
    (assert-eq (.mode (.lexical (.state result)))
               (.mode (.lexical (.state reference))))
    (assert-eq (.previous-code-word (.state result))
               (.previous-code-word (.state reference)))
    (let [(mut i) 0]
      (loop
        (if (>= (load i) (.count result)) (break)
          (do
            (assert-eq (load (p/index positions (load i)))
                       (load (p/index reference-positions (load i))))
            (assert-eq (load (p/index kinds (load i)))
                       (load (p/index reference-kinds (load i))))
            (assert-eq (load (p/index packed-events (load i)))
                       (cast u32 (p/ior
                         (p/ishl
                           (cast u64 (load (p/index reference-positions (load i))))
                           (cast u64 3))
                         (cast u64 (load (p/index reference-kinds (load i)))))))
            (set! i (+ (load i) 1)))))))
  0)

(defn test-empty-source_preserves_state [] (-> i64)
  (let [positions (p/alloc-stack (array u32 1))
        kinds (p/alloc-stack (array u8 1))
        initial (frontend/frontend-initial-state)
        result (pipeline/scan-source-to-tape64
                 (p/cast (ptr u8) 0) 0 (cast u32 0)
                 (p/cast (ptr u32) positions) (p/cast (ptr u8) kinds) initial)]
    (assert-eq (.count result) 0)
    (assert-eq (.mode (.lexical (.state result)))
               (.mode (.lexical initial))))
  0)

(defn test-packed-overflow_is_nonmutating [] (-> i64)
  (let [events (p/alloc-stack (array u32 1))
        initial (frontend/frontend-initial-state)]
    (store! (p/index events 0) (cast u32 99))
    (let [result (pipeline/scan-source-to-packed-tape64
                   (p/cast (ptr u8) 0) 536870912 (cast u32 0)
                   (p/cast (ptr u32) events) initial)]
      (assert-eq (.count result) -1)
      (assert-eq (load (p/index events 0)) (cast u32 99))
      (assert-eq (.mode (.lexical (.state result)))
                 (.mode (.lexical initial)))))
  0)

(defn main [] (-> i64)
  (test-whole-source-pipeline)
  (test-empty-source_preserves_state)
  (test-packed-overflow_is_nonmutating)
  0)
