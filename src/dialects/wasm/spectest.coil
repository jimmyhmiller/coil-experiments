(module experiments.wasm.spectest)

(import "coil.primitive" :as primitive)
(import "experiments.wasm.runtime" :as wasmrt)

;; The official core suite's spectest print imports are observational no-ops.
;; Keeping them in Coil lets imported functions use the same static module path
;; as ordinary host-provided Coil imports.
(export print print_i32 print_i64 print_f32 print_f64 print_i32_f32 print_f64_f64
        __wasm_memory_memory
        __wasm_table_table
        __wasm_global_global_i32 __wasm_global_global_i64
        __wasm_global_global_f32 __wasm_global_global_f64)

(defn print [] (-> void) (do))
(defn print_i32 [(_ i32)] (-> void) (do))
(defn print_i64 [(_ i64)] (-> void) (do))
(defn print_f32 [(_ f32)] (-> void) (do))
(defn print_f64 [(_ f64)] (-> void) (do))
(defn print_i32_f32 [(_ i32) (_ f32)] (-> void) (do))
(defn print_f64_f64 [(_ f64) (_ f64)] (-> void) (do))

(defn __wasm_memory_memory [] (-> (ptr wasmrt/Memory))
  (let [memory (primitive/alloc-static wasmrt/Memory)]
    (wasmrt/memory-init! memory 1 true 2)
    memory))

(defn __wasm_table_table [] (-> (ptr wasmrt/Table))
  (let [table (primitive/alloc-static wasmrt/Table)]
    (wasmrt/table-init! table 10 true 20)
    table))

(defn __wasm_global_global_i32 [] (-> (ptr i32))
  (let [cell (primitive/alloc-static i32)
        initialized (primitive/alloc-static i32)]
    (if (= (load initialized) 0)
        (do (store! cell (primitive/cast i32 666)) (store! initialized 1))
        0)
    cell))

(defn __wasm_global_global_i64 [] (-> (ptr i64))
  (let [cell (primitive/alloc-static i64)
        initialized (primitive/alloc-static i32)]
    (if (= (load initialized) 0)
        (do (store! cell 666) (store! initialized 1))
        0)
    cell))

(defn __wasm_global_global_f32 [] (-> (ptr f32))
  (let [cell (primitive/alloc-static f32)
        initialized (primitive/alloc-static i32)]
    (if (= (load initialized) 0)
        (do (store! cell (primitive/cast f32 666.0)) (store! initialized 1))
        0)
    cell))

(defn __wasm_global_global_f64 [] (-> (ptr f64))
  (let [cell (primitive/alloc-static f64)
        initialized (primitive/alloc-static i32)]
    (if (= (load initialized) 0)
        (do (store! cell 666.0) (store! initialized 1))
        0)
    cell))
