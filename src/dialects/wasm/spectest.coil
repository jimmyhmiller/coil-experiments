(module experiments.wasm.spectest)

;; The official core suite's spectest print imports are observational no-ops.
;; Keeping them in Coil lets imported functions use the same static module path
;; as ordinary host-provided Coil imports.
(export print print_i32 print_i64 print_f32 print_f64)

(defn print [] (-> void) (do))
(defn print_i32 [(_ i32)] (-> void) (do))
(defn print_i64 [(_ i64)] (-> void) (do))
(defn print_f32 [(_ f32)] (-> void) (do))
(defn print_f64 [(_ f64)] (-> void) (do))
