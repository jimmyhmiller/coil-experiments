(module experiments.wasm.decoder)

(import "coil.slice" :as slice)
(import "coil.primitive" :as primitive)

;; The decoder is deliberately independent of the reader and code generator.
;; It is used both at compile time and by focused decoder tests. No host Wasm
;; library or subprocess participates in decoding production input.
(defstruct Cursor
  [(bytes (slice u8))
   (at i64)
   (limit i64)])

(defsum Decode [T]
  (Decoded [(value T)])
  (DecodeError [(at i64) (message (slice u8))]))

(defn cursor [(bytes (slice u8))] (-> Cursor)
  (Cursor :bytes bytes :at 0 :limit (slice/slice-len bytes)))

(defn remaining [(c Cursor)] (-> i64)
  (- (.limit c) (.at c)))

(defn byte! [(c (mut Cursor))] (-> (Decode u8))
  (if (>= (.at c) (.limit c))
      (DecodeError (.at c) "unexpected end of WebAssembly binary")
      (let [at (.at c)
            value (slice/slice-get (.bytes c) at)]
        (set! (.at c) (+ at 1))
        (Decoded value))))

;; Decode the u32 form of unsigned LEB128. The fifth byte may carry only its
;; low four bits, and encodings with redundant terminal zero groups are rejected.
;; WebAssembly requires the representation to fit the target bit width; accepting
;; arbitrary host-sized LEB values would misclassify malformed modules as valid.
(defn u32! [(c (mut Cursor))] (-> (Decode i64))
  (let [(mut result) 0
        (mut shift) 0
        (mut count) 0
        (mut done) false
        (mut failed) false
        (mut failure-at) (.at c)]
    (loop
      (if (or (load done) (load failed))
          (break)
          (match (byte! (mut c))
            (DecodeError [at _]
              (do (store! failed true) (store! failure-at at) 0))
            (Decoded [raw]
              (let [b (primitive/cast i64 raw)
                    payload (& b 0x7f)]
                (if (and (= (load count) 4) (!= (& payload 0x70) 0))
                    (do (store! failed true)
                        (store! failure-at (- (.at c) 1))
                        0)
                    (do
                      (store! result (| (load result) (<< payload (load shift))))
                      (store! count (+ (load count) 1))
                      (if (= (& b 0x80) 0)
                          (store! done true)
                          (if (= (load count) 5)
                              (do (store! failed true)
                                  (store! failure-at (- (.at c) 1))
                                  0)
                              (store! shift (+ (load shift) 7)))))))))))
    (if (load failed)
        (DecodeError (load failure-at) "malformed u32 LEB128")
        (Decoded (load result)))))

(defn expect-byte! [(c (mut Cursor)) (wanted i64) (message (slice u8))]
                    (-> (Decode i64))
  (match (byte! (mut c))
    (DecodeError [at msg] (DecodeError at msg))
    (Decoded [got]
      (if (= (primitive/cast i64 got) wanted)
          (Decoded 0)
          (DecodeError (- (.at c) 1) message)))))

(defn header! [(c (mut Cursor))] (-> (Decode i64))
  (if (< (remaining c) 8)
      (DecodeError (.at c) "unexpected end of WebAssembly binary")
      (let [base (.at c)
            bytes (.bytes c)]
        (cond (or (primitive/icmp-ne (primitive/cast i64 (slice/slice-get bytes base)) 0x00)
                  (primitive/icmp-ne (primitive/cast i64 (slice/slice-get bytes (+ base 1))) 0x61)
                  (primitive/icmp-ne (primitive/cast i64 (slice/slice-get bytes (+ base 2))) 0x73)
                  (primitive/icmp-ne (primitive/cast i64 (slice/slice-get bytes (+ base 3))) 0x6d))
                (DecodeError base "bad WebAssembly magic")
              (or (primitive/icmp-ne (primitive/cast i64 (slice/slice-get bytes (+ base 4))) 0x01)
                  (primitive/icmp-ne (primitive/cast i64 (slice/slice-get bytes (+ base 5))) 0x00)
                  (primitive/icmp-ne (primitive/cast i64 (slice/slice-get bytes (+ base 6))) 0x00)
                  (primitive/icmp-ne (primitive/cast i64 (slice/slice-get bytes (+ base 7))) 0x00))
                (DecodeError (+ base 4) "unsupported WebAssembly version")
              :else
                (do (set! (.at c) (+ base 8)) (Decoded 0))))))

;; Scan the section envelope and enforce the core binary invariants that apply
;; before section-specific decoding: known section ids, strictly increasing
;; non-custom sections, unique non-custom sections, and payload bounds.
(defn section-envelope! [(c (mut Cursor))] (-> (Decode i64))
  (let [(mut previous) 0
        (mut failed) false
        (mut failure-at) 0
        (mut failure) ""]
    (loop
      (if (or (load failed) (= (remaining c) 0))
          (break)
          (match (byte! (mut c))
            (DecodeError [at msg]
              (do (store! failed true) (store! failure-at at) (store! failure msg) 0))
            (Decoded [raw-id]
              (let [id (primitive/cast i64 raw-id)]
                (cond (> id 11)
                        (do (store! failed true)
                            (store! failure-at (- (.at c) 1))
                            (store! failure "unknown WebAssembly section id")
                            0)
                      (and (!= id 0) (<= id (load previous)))
                        (do (store! failed true)
                            (store! failure-at (- (.at c) 1))
                            (store! failure "duplicate or out-of-order WebAssembly section")
                            0)
                      :else
                        (match (u32! (mut c))
                          (DecodeError [at msg]
                            (do (store! failed true) (store! failure-at at)
                                (store! failure msg) 0))
                          (Decoded [size]
                            (if (> size (remaining c))
                                (do (store! failed true)
                                    (store! failure-at (.at c))
                                    (store! failure "WebAssembly section extends past end of file")
                                    0)
                                (do
                                  (if (!= id 0) (store! previous id) 0)
                                  (set! (.at c) (+ (.at c) size))
                                  0))))))))))
    (if (load failed)
        (DecodeError (load failure-at) (load failure))
        (Decoded 0))))

(defn module-envelope [(bytes (slice u8))] (-> (Decode i64))
  (let [(mut c) (cursor bytes)]
    (match (header! (mut c))
      (DecodeError [at msg] (DecodeError at msg))
      (Decoded [_] (section-envelope! (mut c))))))
