(module experiments.wasm.decoder)

(import "coil.slice" :as slice)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)

;; The decoder is deliberately independent of the reader and code generator.
;; It is used both at compile time and by focused decoder tests. No host Wasm
;; library or subprocess participates in decoding production input.
(defstruct Cursor
  [(bytes (slice u8))
   (at i64)
   (limit i64)])

(defsum Decode [T]
  (Decoded [(value T)])
  (DecodeError [(at i64) (message (slice u8))]))

(defsum ValType
  (I32)
  (I64)
  (F32)
  (F64))

(defstruct FuncType
  [(params (al/ArrayList ValType))
   (results (al/ArrayList ValType))])

(defstruct FuncBody
  [(locals (al/ArrayList ValType))
   (expression (slice u8))])

(defstruct Export
  [(name (slice u8))
   (kind i64)
   (index i64)])

(defstruct Import
  [(module-name (slice u8))
   (item-name (slice u8))
   (kind i64)
   (type-index i64)
   (value-kind ValType)
   (mutable bool)
   (minimum i64)
   (has-maximum bool)
   (maximum i64)])

(defstruct Global
  [(kind ValType)
   (mutable bool)
   (initializer-opcode i64)
   (initializer-bits i64)])

(defstruct MemoryType
  [(minimum i64)
   (has-maximum bool)
   (maximum i64)])

(defstruct DataSegment
  [(memory-index i64)
   (offset i64)
   (bytes (slice u8))])

(defstruct TableType
  [(minimum i64)
   (has-maximum bool)
   (maximum i64)])

(defstruct ElementSegment
  [(table-index i64)
   (offset i64)
   (functions (al/ArrayList i64))])

(defn cursor [(bytes (slice u8))] (-> Cursor)
  (Cursor :bytes bytes :at 0 :limit (slice/slice-len bytes)))

(defn remaining [(c Cursor)] (-> i64)
  (- (.limit c) (.at c)))

(defn byte! [(c (mut Cursor))] (-> (Decode u8))
  (if (>= (.at c) (.limit c))
      (DecodeError (.at c) "unexpected end of WebAssembly binary")
      (let [at (.at c)
            value (slice/slice-get (.bytes c) at)]
        (set! (.at c) (+ at 1))
        (Decoded value))))

;; Decode the u32 form of unsigned LEB128. The fifth byte may carry only its
;; low four bits. Padded encodings are accepted, as required by the Wasm binary
;; grammar, provided they fit the five-byte/32-bit bound.
(defn u32! [(c (mut Cursor))] (-> (Decode i64))
  (let [(mut result) 0
        (mut shift) 0
        (mut count) 0
        (mut done) false
        (mut failed) false
        (mut failure-at) (.at c)]
    (loop
      (if (or (load done) (load failed))
          (break)
          (match (byte! (mut c))
            (DecodeError [at _]
              (do (store! failed true) (store! failure-at at) 0))
            (Decoded [raw]
              (let [b (primitive/cast i64 raw)
                    payload (& b 0x7f)]
                (if (and (= (load count) 4) (!= (& payload 0x70) 0))
                    (do (store! failed true)
                        (store! failure-at (- (.at c) 1))
                        0)
                    (do
                      (store! result (| (load result) (<< payload (load shift))))
                      (store! count (+ (load count) 1))
                      (if (= (& b 0x80) 0)
                          (store! done true)
                          (if (= (load count) 5)
                              (do (store! failed true)
                                  (store! failure-at (- (.at c) 1))
                                  0)
                              (store! shift (+ (load shift) 7)))))))))))
    (if (load failed)
        (DecodeError (load failure-at) "malformed u32 LEB128")
        (Decoded (load result)))))

(defn expect-byte! [(c (mut Cursor)) (wanted i64) (message (slice u8))]
                    (-> (Decode i64))
  (match (byte! (mut c))
    (DecodeError [at msg] (DecodeError at msg))
    (Decoded [got]
      (if (= (primitive/cast i64 got) wanted)
          (Decoded 0)
          (DecodeError (- (.at c) 1) message)))))

(defstruct Parser
  [(cursor Cursor)
   (failed bool)
   (failure-at i64)
   (message (slice u8))])

(defn parser [(bytes (slice u8))] (-> Parser)
  (Parser :cursor (cursor bytes) :failed false :failure-at 0 :message ""))

(defn parser-fail! [(p (mut Parser)) (at i64) (message (slice u8))] (-> i64)
  (if (.failed p)
      0
      (do (set! (.failed p) true)
          (set! (.failure-at p) at)
          (set! (.message p) message)
          0)))

(defn parser-u32! [(p (mut Parser))] (-> i64)
  (if (.failed p)
      0
      (match (u32! (mut (.cursor p)))
        (DecodeError [at message]
          (do (parser-fail! (mut p) at message) 0))
        (Decoded [value] value))))

;; Signed LEB128 for i32/i64 immediates. The final byte is checked against the
;; unused-bit rule for the requested width, including the 5-byte s32 and
;; 10-byte s64 edge cases exercised by binary-leb128.wast.
(defn parser-signed! [(p (mut Parser)) (bits i64)] (-> i64)
  (let [max-bytes (primitive/udiv (+ bits 6) 7)
        (mut result) 0
        (mut shift) 0
        (mut count) 0
        (mut final) 0
        (mut done) false]
    (loop
      (if (or (.failed p) (load done))
          (break)
          (let [at (.at (.cursor p))
                b (parser-byte! (mut p))
                payload (& b 0x7f)]
            (store! final payload)
            (if (>= (load shift) 63)
                (store! result (| (load result) (<< (& payload 1) 63)))
                (store! result (| (load result) (<< payload (load shift)))))
            (store! count (+ (load count) 1))
            (if (= (& b 0x80) 0)
                (store! done true)
                (if (>= (load count) max-bytes)
                    (parser-fail! (mut p) at "malformed signed LEB128")
                    (store! shift (+ (load shift) 7)))))))
    (if (and (not (.failed p)) (load done))
        (let [used (- bits (* 7 (- max-bytes 1)))]
          (if (= (load count) max-bytes)
              (let [unused-mask (& 0x7f (^ (- (<< 1 used) 1) 0x7f))
                    signed-mask (| unused-mask (<< 1 (- used 1)))
                    high (& (load final) signed-mask)]
                (if (and (!= high 0) (!= high signed-mask))
                    (parser-fail! (mut p) (- (.at (.cursor p)) 1)
                                  "signed LEB128 does not fit target width")
                    0))
              0)
          (let [actual-shift (* 7 (load count))]
            (if (and (< actual-shift bits) (!= (& (load final) 0x40) 0))
                (store! result (| (load result) (<< -1 actual-shift)))
                0)))
        0)
    (load result)))

(defn parser-fixed-bits! [(p (mut Parser)) (bytes i64)] (-> i64)
  (let [(mut result) 0
        (mut i) 0]
    (loop
      (if (or (.failed p) (>= (load i) bytes))
          (break)
          (do
            (store! result
                    (primitive/ior
                      (load result)
                      (primitive/ishl (parser-byte! (mut p)) (* (load i) 8))))
            (store! i (+ (load i) 1)))))
    (load result)))

(defn parser-byte! [(p (mut Parser))] (-> i64)
  (if (.failed p)
      0
      (match (byte! (mut (.cursor p)))
        (DecodeError [at message]
          (do (parser-fail! (mut p) at message) 0))
        (Decoded [value] (primitive/cast i64 value)))))

(defn parser-valtype! [(p (mut Parser))] (-> ValType)
  (let [at (.at (.cursor p))
        tag (parser-byte! (mut p))]
    (cond (= tag 0x7f) (I32)
          (= tag 0x7e) (I64)
          (= tag 0x7d) (F32)
          (= tag 0x7c) (F64)
          :else (do (parser-fail! (mut p) at "unknown WebAssembly MVP value type")
                    (I32)))))

(defn valtype-vector! [(a (dyn alloc/Allocator)) (p (mut Parser))]
                      (-> (al/ArrayList ValType))
  (let [count (parser-u32! (mut p))
        (mut values) (al/al-new [ValType] a)
        (mut i) 0]
    (loop
      (if (or (.failed p) (>= (load i) count))
          (break)
          (do
            (al/al-push! [ValType] (mut values) (parser-valtype! (mut p)))
            (store! i (+ (load i) 1)))))
    (load values)))

;; Decode the complete MVP type section. This is syntax decoding only; module
;; validation (index bounds, function/code agreement, and instruction typing)
;; is performed by the validator/code generator.
(defn type-section [(a (dyn alloc/Allocator)) (payload (slice u8))]
                   (-> (Decode (al/ArrayList FuncType)))
  (let [(mut p) (parser payload)
        count (parser-u32! (mut p))
        (mut types) (al/al-new [FuncType] a)
        (mut i) 0]
    (loop
      (if (or (.failed p) (>= (load i) count))
          (break)
          (do
            (if (!= (parser-byte! (mut p)) 0x60)
                (parser-fail! (mut p) (- (.at (.cursor p)) 1)
                              "WebAssembly function type is missing 0x60 tag")
                0)
            (let [params (valtype-vector! a (mut p))
                  results (valtype-vector! a (mut p))]
              (if (> (al/al-len results) 1)
                  (parser-fail! (mut p) (.at (.cursor p))
                                "WebAssembly validation: MVP function type has multiple results")
                  0)
              (if (.failed p)
                  0
                  (al/al-push! [FuncType] (mut types)
                               (FuncType :params params :results results))))
            (store! i (+ (load i) 1)))))
    (if (and (not (.failed p)) (!= (remaining (.cursor p)) 0))
        (parser-fail! (mut p) (.at (.cursor p))
                      "trailing bytes in WebAssembly type section")
        0)
    (if (.failed p)
        (DecodeError (.failure-at p) (.message p))
        (Decoded (load types)))))

(defn index-section [(a (dyn alloc/Allocator)) (payload (slice u8))]
                    (-> (Decode (al/ArrayList i64)))
  (let [(mut p) (parser payload)
        count (parser-u32! (mut p))
        (mut values) (al/al-new [i64] a)
        (mut i) 0]
    (loop
      (if (or (.failed p) (>= (load i) count))
          (break)
          (do (al/al-push! [i64] (mut values) (parser-u32! (mut p)))
              (store! i (+ (load i) 1)))))
    (if (and (not (.failed p)) (!= (remaining (.cursor p)) 0))
        (parser-fail! (mut p) (.at (.cursor p))
                      "trailing bytes in WebAssembly index section")
        0)
    (if (.failed p)
        (DecodeError (.failure-at p) (.message p))
        (Decoded (load values)))))

(defn start-section [(payload (slice u8))] (-> (Decode i64))
  (let [(mut p) (parser payload)
        index (parser-u32! (mut p))]
    (if (and (not (.failed p)) (!= (remaining (.cursor p)) 0))
        (parser-fail! (mut p) (.at (.cursor p))
                      "trailing bytes in WebAssembly start section")
        0)
    (if (.failed p)
        (DecodeError (.failure-at p) (.message p))
        (Decoded index))))

(defn import-section [(a (dyn alloc/Allocator)) (payload (slice u8))]
                     (-> (Decode (al/ArrayList Import)))
  (let [(mut p) (parser payload)
        count (parser-u32! (mut p))
        (mut imports) (al/al-new [Import] a)
        (mut i) 0]
    (loop
      (if (or (.failed p) (>= (load i) count))
          (break)
          (let [module-name (parser-name! (mut p))
                item-name (parser-name! (mut p))
                kind (parser-byte! (mut p))
                (mut type-index) 0
                (mut value-kind) (I32)
                (mut is-mutable) false
                (mut minimum-value) 0
                (mut has-maximum-value) false
                (mut maximum-value) 0]
            (cond (= kind 0)
                    (store! type-index (parser-u32! (mut p)))
                  (= kind 1)
                    (let [element-type (parser-byte! (mut p))
                          flags (parser-u32! (mut p))
                          minimum (parser-u32! (mut p))
                          maximum (if (= flags 1) (parser-u32! (mut p)) minimum)]
                      (store! minimum-value minimum)
                      (store! has-maximum-value (= flags 1))
                      (store! maximum-value maximum)
                      (if (!= element-type 0x70)
                          (parser-fail! (mut p) (.at (.cursor p))
                                        "invalid MVP imported table element type")
                          0)
                      (if (or (> flags 1) (> minimum maximum))
                          (parser-fail! (mut p) (.at (.cursor p))
                                        "invalid imported table limits")
                          0))
                  (= kind 2)
                    (let [flags (parser-u32! (mut p))
                          minimum (parser-u32! (mut p))
                          maximum (if (= flags 1) (parser-u32! (mut p)) 65536)]
                      (store! minimum-value minimum)
                      (store! has-maximum-value (= flags 1))
                      (store! maximum-value maximum)
                      (if (or (> flags 1)
                              (or (> minimum 65536)
                                  (or (> maximum 65536) (> minimum maximum))))
                          (parser-fail! (mut p) (.at (.cursor p))
                                        "invalid imported memory limits")
                          0))
                  (= kind 3)
                    (do (store! value-kind (parser-valtype! (mut p)))
                      (let [mutability (parser-byte! (mut p))]
                        (store! is-mutable (= mutability 1))
                        (if (> mutability 1)
                            (parser-fail! (mut p) (.at (.cursor p))
                                          "invalid imported global mutability")
                            0)))
                  :else
                    (parser-fail! (mut p) (- (.at (.cursor p)) 1)
                                  "unknown WebAssembly import kind"))
            (if (.failed p)
                0
                (al/al-push! [Import] (mut imports)
                             (Import :module-name module-name
                                     :item-name item-name
                                     :kind kind
                                     :type-index (load type-index)
                                     :value-kind (load value-kind)
                                     :mutable (load is-mutable)
                                     :minimum (load minimum-value)
                                     :has-maximum (load has-maximum-value)
                                     :maximum (load maximum-value))))
            (store! i (+ (load i) 1)))))
    (if (and (not (.failed p)) (!= (remaining (.cursor p)) 0))
        (parser-fail! (mut p) (.at (.cursor p))
                      "trailing bytes in WebAssembly import section")
        0)
    (if (.failed p)
        (DecodeError (.failure-at p) (.message p))
        (Decoded (load imports)))))

(defn local-vector! [(a (dyn alloc/Allocator)) (p (mut Parser))]
                    (-> (al/ArrayList ValType))
  (let [group-count (parser-u32! (mut p))
        (mut locals) (al/al-new [ValType] a)
        (mut group) 0]
    (loop
      (if (or (.failed p) (>= (load group) group-count))
          (break)
          (let [count (parser-u32! (mut p))
                kind (parser-valtype! (mut p))
                (mut i) 0]
            (if (> count 1000000)
                (parser-fail! (mut p) (.at (.cursor p))
                              "WebAssembly function exceeds implementation local limit")
                0)
            (loop
              (if (or (.failed p) (>= (load i) count))
                  (break)
                  (do (al/al-push! [ValType] (mut locals) kind)
                      (store! i (+ (load i) 1)))))
            (store! group (+ (load group) 1)))))
    (load locals)))

(defn code-section [(a (dyn alloc/Allocator)) (payload (slice u8))]
                   (-> (Decode (al/ArrayList FuncBody)))
  (let [(mut p) (parser payload)
        count (parser-u32! (mut p))
        (mut bodies) (al/al-new [FuncBody] a)
        (mut i) 0]
    (loop
      (if (or (.failed p) (>= (load i) count))
          (break)
          (let [size (parser-u32! (mut p))
                start (.at (.cursor p))]
            (if (> size (remaining (.cursor p)))
                (parser-fail! (mut p) start
                              "WebAssembly function body extends past code section")
                0)
            (if (.failed p)
                0
                (let [body-bytes (slice/subslice payload start (+ start size))
                      (mut body-parser) (parser body-bytes)
                      locals (local-vector! a (mut body-parser))
                      expression-start (.at (.cursor body-parser))]
                  (if (or (.failed body-parser)
                          (= expression-start (slice/slice-len body-bytes)))
                      (parser-fail! (mut p) start "malformed WebAssembly function body")
                      (do
                        (al/al-push!
                          [FuncBody]
                          (mut bodies)
                          (FuncBody
                            :locals locals
                            :expression (slice/subslice body-bytes expression-start
                                                        (slice/slice-len body-bytes))))
                        (set! (.at (.cursor p)) (+ start size))))))
            (store! i (+ (load i) 1)))))
    (if (and (not (.failed p)) (!= (remaining (.cursor p)) 0))
        (parser-fail! (mut p) (.at (.cursor p))
                      "trailing bytes in WebAssembly code section")
        0)
    (if (.failed p)
        (DecodeError (.failure-at p) (.message p))
        (Decoded (load bodies)))))

(defn parser-name! [(p (mut Parser))] (-> (slice u8))
  (let [length (parser-u32! (mut p))
        start (.at (.cursor p))]
    (if (> length (remaining (.cursor p)))
        (do (parser-fail! (mut p) start
                          "WebAssembly name extends past end of section")
            (slice/subslice (.bytes (.cursor p)) start start))
        (let [name (slice/subslice (.bytes (.cursor p)) start (+ start length))]
          (set! (.at (.cursor p)) (+ start length))
          name))))

(defn export-section [(a (dyn alloc/Allocator)) (payload (slice u8))]
                     (-> (Decode (al/ArrayList Export)))
  (let [(mut p) (parser payload)
        count (parser-u32! (mut p))
        (mut exports) (al/al-new [Export] a)
        (mut i) 0]
    (loop
      (if (or (.failed p) (>= (load i) count))
          (break)
          (let [name (parser-name! (mut p))
                kind (parser-byte! (mut p))
                index (parser-u32! (mut p))]
            (if (> kind 3)
                (parser-fail! (mut p) (- (.at (.cursor p)) 1)
                              "unknown WebAssembly export kind")
                0)
            (if (.failed p)
                0
                (al/al-push! [Export] (mut exports)
                             (Export :name name :kind kind :index index)))
            (store! i (+ (load i) 1)))))
    (if (and (not (.failed p)) (!= (remaining (.cursor p)) 0))
        (parser-fail! (mut p) (.at (.cursor p))
                      "trailing bytes in WebAssembly export section")
        0)
    (if (.failed p)
        (DecodeError (.failure-at p) (.message p))
        (Decoded (load exports)))))

(defn global-section [(a (dyn alloc/Allocator)) (payload (slice u8))]
                     (-> (Decode (al/ArrayList Global)))
  (let [(mut p) (parser payload)
        count (parser-u32! (mut p))
        (mut globals) (al/al-new [Global] a)
        (mut i) 0]
    (loop
      (if (or (.failed p) (>= (load i) count))
          (break)
          (let [kind (parser-valtype! (mut p))
                mutability (parser-byte! (mut p))
                opcode (parser-byte! (mut p))
                bits (cond (= opcode 0x41) (parser-signed! (mut p) 32)
                           (= opcode 0x42) (parser-signed! (mut p) 64)
                           (= opcode 0x43) (parser-fixed-bits! (mut p) 4)
                           (= opcode 0x44) (parser-fixed-bits! (mut p) 8)
                           :else (do
                                   (parser-fail! (mut p) (- (.at (.cursor p)) 1)
                                                 "WebAssembly validation: unsupported global initializer")
                                   0))
                end (parser-byte! (mut p))
                wanted (match kind
                         (I32 [] 0x41)
                         (I64 [] 0x42)
                         (F32 [] 0x43)
                         (F64 [] 0x44))]
            (if (> mutability 1)
                (parser-fail! (mut p) (- (.at (.cursor p)) 1)
                              "WebAssembly validation: invalid global mutability")
                0)
            (if (!= opcode wanted)
                (parser-fail! (mut p) (- (.at (.cursor p)) 2)
                              "WebAssembly validation: global initializer type mismatch")
                0)
            (if (!= end 0x0b)
                (parser-fail! (mut p) (- (.at (.cursor p)) 1)
                              "WebAssembly validation: global initializer lacks end opcode")
                0)
            (if (.failed p)
                0
                (al/al-push! [Global] (mut globals)
                             (Global :kind kind
                                     :mutable (= mutability 1)
                                     :initializer-opcode opcode
                                     :initializer-bits bits)))
            (store! i (+ (load i) 1)))))
    (if (and (not (.failed p)) (!= (remaining (.cursor p)) 0))
        (parser-fail! (mut p) (.at (.cursor p))
                      "trailing bytes in WebAssembly global section")
        0)
    (if (.failed p)
        (DecodeError (.failure-at p) (.message p))
        (Decoded (load globals)))))

(defn memory-section [(a (dyn alloc/Allocator)) (payload (slice u8))]
                     (-> (Decode (al/ArrayList MemoryType)))
  (let [(mut p) (parser payload)
        count (parser-u32! (mut p))
        (mut memories) (al/al-new [MemoryType] a)
        (mut i) 0]
    (if (> count 1)
        (parser-fail! (mut p) 0
                      "WebAssembly validation: MVP module has multiple memories")
        0)
    (loop
      (if (or (.failed p) (>= (load i) count))
          (break)
          (let [flags (parser-u32! (mut p))
                minimum (parser-u32! (mut p))
                has-maximum (= flags 1)
                maximum (if has-maximum (parser-u32! (mut p)) 65536)]
            (if (> flags 1)
                (parser-fail! (mut p) (.at (.cursor p))
                              "WebAssembly validation: invalid memory limits")
                0)
            (if (or (> minimum 65536) (> maximum 65536) (> minimum maximum))
                (parser-fail! (mut p) (.at (.cursor p))
                              "WebAssembly validation: invalid memory size")
                0)
            (if (.failed p)
                0
                (al/al-push! [MemoryType] (mut memories)
                             (MemoryType :minimum minimum
                                         :has-maximum has-maximum
                                         :maximum maximum)))
            (store! i (+ (load i) 1)))))
    (if (and (not (.failed p)) (!= (remaining (.cursor p)) 0))
        (parser-fail! (mut p) (.at (.cursor p)) "trailing bytes in memory section")
        0)
    (if (.failed p)
        (DecodeError (.failure-at p) (.message p))
        (Decoded (load memories)))))

(defn data-section [(a (dyn alloc/Allocator)) (payload (slice u8))]
                   (-> (Decode (al/ArrayList DataSegment)))
  (let [(mut p) (parser payload)
        count (parser-u32! (mut p))
        (mut segments) (al/al-new [DataSegment] a)
        (mut i) 0]
    (loop
      (if (or (.failed p) (>= (load i) count))
          (break)
          (let [memory-index (parser-u32! (mut p))
                opcode (parser-byte! (mut p))
                offset (parser-signed! (mut p) 32)
                end (parser-byte! (mut p))
                size (parser-u32! (mut p))
                start (.at (.cursor p))]
            (if (!= memory-index 0)
                (parser-fail! (mut p) start "WebAssembly data segment memory index out of bounds")
                0)
            (if (!= opcode 0x41)
                (parser-fail! (mut p) start "WebAssembly data offset must be i32.const")
                0)
            (if (!= end 0x0b)
                (parser-fail! (mut p) start "WebAssembly data offset lacks end opcode")
                0)
            (if (> size (remaining (.cursor p)))
                (parser-fail! (mut p) start "WebAssembly data segment extends past section")
                0)
            (if (.failed p)
                0
                (do
                  (al/al-push! [DataSegment] (mut segments)
                               (DataSegment
                                 :memory-index memory-index
                                 :offset offset
                                 :bytes (slice/subslice payload start (+ start size))))
                  (set! (.at (.cursor p)) (+ start size))))
            (store! i (+ (load i) 1)))))
    (if (and (not (.failed p)) (!= (remaining (.cursor p)) 0))
        (parser-fail! (mut p) (.at (.cursor p)) "trailing bytes in data section")
        0)
    (if (.failed p)
        (DecodeError (.failure-at p) (.message p))
        (Decoded (load segments)))))

(defn table-section [(a (dyn alloc/Allocator)) (payload (slice u8))]
                    (-> (Decode (al/ArrayList TableType)))
  (let [(mut p) (parser payload)
        count (parser-u32! (mut p))
        (mut tables) (al/al-new [TableType] a)
        (mut i) 0]
    (if (> count 1)
        (parser-fail! (mut p) 0
                      "WebAssembly validation: MVP module has multiple tables")
        0)
    (loop
      (if (or (.failed p) (>= (load i) count))
          (break)
          (let [element-type (parser-byte! (mut p))
                flags (parser-u32! (mut p))
                minimum (parser-u32! (mut p))
                has-maximum (= flags 1)
                maximum (if has-maximum (parser-u32! (mut p)) 0xffffffff)]
            (if (!= element-type 0x70)
                (parser-fail! (mut p) (.at (.cursor p))
                              "WebAssembly validation: invalid MVP table element type")
                0)
            (if (> flags 1)
                (parser-fail! (mut p) (.at (.cursor p))
                              "WebAssembly validation: invalid table limits")
                0)
            (if (> minimum maximum)
                (parser-fail! (mut p) (.at (.cursor p))
                              "WebAssembly validation: invalid table size")
                0)
            (if (.failed p)
                0
                (al/al-push! [TableType] (mut tables)
                             (TableType :minimum minimum
                                        :has-maximum has-maximum
                                        :maximum maximum)))
            (store! i (+ (load i) 1)))))
    (if (and (not (.failed p)) (!= (remaining (.cursor p)) 0))
        (parser-fail! (mut p) (.at (.cursor p)) "trailing bytes in table section")
        0)
    (if (.failed p)
        (DecodeError (.failure-at p) (.message p))
        (Decoded (load tables)))))

(defn element-section [(a (dyn alloc/Allocator)) (payload (slice u8))]
                      (-> (Decode (al/ArrayList ElementSegment)))
  (let [(mut p) (parser payload)
        count (parser-u32! (mut p))
        (mut segments) (al/al-new [ElementSegment] a)
        (mut i) 0]
    (loop
      (if (or (.failed p) (>= (load i) count))
          (break)
          (let [table-index (parser-u32! (mut p))
                opcode (parser-byte! (mut p))]
            (if (!= opcode 0x41)
                (parser-fail! (mut p) (.at (.cursor p))
                              "WebAssembly validation: element offset must be i32.const")
                0)
            (let [offset (parser-signed! (mut p) 32)
                end (parser-byte! (mut p))
                function-count (parser-u32! (mut p))
                (mut functions) (al/al-new [i64] a)
                (mut j) 0]
            (if (!= table-index 0)
                (parser-fail! (mut p) (.at (.cursor p))
                              "WebAssembly validation: element table index out of bounds")
                0)
            (if (!= end 0x0b)
                (parser-fail! (mut p) (.at (.cursor p))
                              "WebAssembly validation: element offset lacks end opcode")
                0)
            (loop
              (if (or (.failed p) (>= (load j) function-count))
                  (break)
                  (do
                    (al/al-push! [i64] (mut functions) (parser-u32! (mut p)))
                    (store! j (+ (load j) 1)))))
            (if (.failed p)
                0
                (al/al-push! [ElementSegment] (mut segments)
                             (ElementSegment :table-index table-index
                                             :offset offset
                                             :functions (load functions))))
            (store! i (+ (load i) 1))))))
    (if (and (not (.failed p)) (!= (remaining (.cursor p)) 0))
        (parser-fail! (mut p) (.at (.cursor p)) "trailing bytes in element section")
        0)
    (if (.failed p)
        (DecodeError (.failure-at p) (.message p))
        (Decoded (load segments)))))

(defn header! [(c (mut Cursor))] (-> (Decode i64))
  (if (< (remaining c) 8)
      (DecodeError (.at c) "unexpected end of WebAssembly binary")
      (let [base (.at c)
            bytes (.bytes c)]
        (cond (or (primitive/icmp-ne (primitive/cast i64 (slice/slice-get bytes base)) 0x00)
                  (primitive/icmp-ne (primitive/cast i64 (slice/slice-get bytes (+ base 1))) 0x61)
                  (primitive/icmp-ne (primitive/cast i64 (slice/slice-get bytes (+ base 2))) 0x73)
                  (primitive/icmp-ne (primitive/cast i64 (slice/slice-get bytes (+ base 3))) 0x6d))
                (DecodeError base "bad WebAssembly magic")
              (or (primitive/icmp-ne (primitive/cast i64 (slice/slice-get bytes (+ base 4))) 0x01)
                  (primitive/icmp-ne (primitive/cast i64 (slice/slice-get bytes (+ base 5))) 0x00)
                  (primitive/icmp-ne (primitive/cast i64 (slice/slice-get bytes (+ base 6))) 0x00)
                  (primitive/icmp-ne (primitive/cast i64 (slice/slice-get bytes (+ base 7))) 0x00))
                (DecodeError (+ base 4) "unsupported WebAssembly version")
              :else
                (do (set! (.at c) (+ base 8)) (Decoded 0))))))

;; Raw payloads for each standard MVP section. Keeping zero-copy slices here
;; separates the binary envelope from the section grammars and lets validation
;; report offsets against the original source bytes.
(defstruct Sections
  [(types (slice u8))
   (imports (slice u8))
   (functions (slice u8))
   (tables (slice u8))
   (memories (slice u8))
   (globals (slice u8))
   (exports (slice u8))
   (start (slice u8))
   (elements (slice u8))
   (codes (slice u8))
   (data (slice u8))])

(defn empty-sections [(bytes (slice u8))] (-> Sections)
  (let [empty (slice/subslice bytes 0 0)]
    (Sections :types empty :imports empty :functions empty :tables empty
              :memories empty :globals empty :exports empty :start empty
              :elements empty :codes empty :data empty)))

(defn put-section! [(sections (mut Sections)) (id i64) (payload (slice u8))]
                    (-> i64)
  (cond (= id 1) (do (set! (.types sections) payload) 0)
        (= id 2) (do (set! (.imports sections) payload) 0)
        (= id 3) (do (set! (.functions sections) payload) 0)
        (= id 4) (do (set! (.tables sections) payload) 0)
        (= id 5) (do (set! (.memories sections) payload) 0)
        (= id 6) (do (set! (.globals sections) payload) 0)
        (= id 7) (do (set! (.exports sections) payload) 0)
        (= id 8) (do (set! (.start sections) payload) 0)
        (= id 9) (do (set! (.elements sections) payload) 0)
        (= id 10) (do (set! (.codes sections) payload) 0)
        (= id 11) (do (set! (.data sections) payload) 0)
        :else 0))

;; Scan the section envelope and enforce the core binary invariants that apply
;; before section-specific decoding: known section ids, strictly increasing
;; non-custom sections, unique non-custom sections, and payload bounds.
(defn sections! [(c (mut Cursor))] (-> (Decode Sections))
  (let [(mut previous) 0
        (mut sections) (empty-sections (.bytes c))
        (mut failed) false
        (mut failure-at) 0
        (mut failure) ""]
    (loop
      (if (or (load failed) (= (remaining c) 0))
          (break)
          (match (byte! (mut c))
            (DecodeError [at msg]
              (do (store! failed true) (store! failure-at at) (store! failure msg) 0))
            (Decoded [raw-id]
              (let [id (primitive/cast i64 raw-id)]
                (cond (> id 11)
                        (do (store! failed true)
                            (store! failure-at (- (.at c) 1))
                            (store! failure "unknown WebAssembly section id")
                            0)
                      (and (!= id 0) (<= id (load previous)))
                        (do (store! failed true)
                            (store! failure-at (- (.at c) 1))
                            (store! failure "duplicate or out-of-order WebAssembly section")
                            0)
                      :else
                        (match (u32! (mut c))
                          (DecodeError [at msg]
                            (do (store! failed true) (store! failure-at at)
                                (store! failure msg) 0))
                          (Decoded [size]
                            (if (> size (remaining c))
                                (do (store! failed true)
                                    (store! failure-at (.at c))
                                    (store! failure "WebAssembly section extends past end of file")
                                    0)
                                (do
                                  (if (!= id 0) (store! previous id) 0)
                                  (if (!= id 0)
                                      (put-section!
                                        (mut sections)
                                        id
                                        (slice/subslice (.bytes c) (.at c) (+ (.at c) size)))
                                      0)
                                  (set! (.at c) (+ (.at c) size))
                                  0))))))))))
    (if (load failed)
        (DecodeError (load failure-at) (load failure))
        (Decoded (load sections)))))

(defn section-envelope! [(c (mut Cursor))] (-> (Decode i64))
  (match (sections! (mut c))
    (DecodeError [at message] (DecodeError at message))
    (Decoded [_] (Decoded 0))))

(defn module-sections [(bytes (slice u8))] (-> (Decode Sections))
  (let [(mut c) (cursor bytes)]
    (match (header! (mut c))
      (DecodeError [at msg] (DecodeError at msg))
      (Decoded [_] (sections! (mut c))))))

(defn module-envelope [(bytes (slice u8))] (-> (Decode i64))
  (match (module-sections bytes)
    (DecodeError [at msg] (DecodeError at msg))
    (Decoded [_] (Decoded 0))))
