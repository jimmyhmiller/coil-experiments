                  (= opcode 0x5b)
                    (runtime-binary! context (mut stack) (wasm/F32) (wasm/I32) "wasmrt/f32-eq")
                  (= opcode 0x5c)
                    (runtime-binary! context (mut stack) (wasm/F32) (wasm/I32) "wasmrt/f32-ne")
                  (= opcode 0x5d)
                    (runtime-binary! context (mut stack) (wasm/F32) (wasm/I32) "wasmrt/f32-lt")
                  (= opcode 0x5e)
                    (runtime-binary! context (mut stack) (wasm/F32) (wasm/I32) "wasmrt/f32-gt")
                  (= opcode 0x5f)
                    (runtime-binary! context (mut stack) (wasm/F32) (wasm/I32) "wasmrt/f32-le")
                  (= opcode 0x60)
                    (runtime-binary! context (mut stack) (wasm/F32) (wasm/I32) "wasmrt/f32-ge")
                  (= opcode 0x61)
                    (runtime-binary! context (mut stack) (wasm/F64) (wasm/I32) "wasmrt/f64-eq")
                  (= opcode 0x62)
                    (runtime-binary! context (mut stack) (wasm/F64) (wasm/I32) "wasmrt/f64-ne")
                  (= opcode 0x63)
                    (runtime-binary! context (mut stack) (wasm/F64) (wasm/I32) "wasmrt/f64-lt")
                  (= opcode 0x64)
                    (runtime-binary! context (mut stack) (wasm/F64) (wasm/I32) "wasmrt/f64-gt")
                  (= opcode 0x65)
                    (runtime-binary! context (mut stack) (wasm/F64) (wasm/I32) "wasmrt/f64-le")
                  (= opcode 0x66)
                    (runtime-binary! context (mut stack) (wasm/F64) (wasm/I32) "wasmrt/f64-ge")
                  (= opcode 0x67)
                    (runtime-unary! context (mut stack) (wasm/I32) (wasm/I32)
                                    "wasmrt/i32-clz")
                  (= opcode 0x68)
                    (runtime-unary! context (mut stack) (wasm/I32) (wasm/I32)
                                    "wasmrt/i32-ctz")
                  (= opcode 0x69)
                    (runtime-unary! context (mut stack) (wasm/I32) (wasm/I32)
                                    "wasmrt/i32-popcnt")
                  (= opcode 0x6a)
                    (integer-binop! (mut stack) (wasm/I32)
                                    (primitive/datum->syntax context "primitive/iadd"))
                  (= opcode 0x6b)
                    (integer-binop! (mut stack) (wasm/I32)
                                    (primitive/datum->syntax context "primitive/isub"))
                  (= opcode 0x6c)
                    (integer-binop! (mut stack) (wasm/I32)
                                    (primitive/datum->syntax context "primitive/imul"))
                  (= opcode 0x6d)
                    (runtime-binary! context (mut stack) (wasm/I32) (wasm/I32)
                                     "wasmrt/i32-div-s")
                  (= opcode 0x6e)
                    (runtime-binary! context (mut stack) (wasm/I32) (wasm/I32)
                                     "wasmrt/i32-div-u")
                  (= opcode 0x6f)
                    (runtime-binary! context (mut stack) (wasm/I32) (wasm/I32)
                                     "wasmrt/i32-rem-s")
                  (= opcode 0x70)
                    (runtime-binary! context (mut stack) (wasm/I32) (wasm/I32)
                                     "wasmrt/i32-rem-u")
                  (= opcode 0x71)
                    (runtime-binary! context (mut stack) (wasm/I32) (wasm/I32)
                                     "wasmrt/i32-and")
                  (= opcode 0x72)
                    (runtime-binary! context (mut stack) (wasm/I32) (wasm/I32)
                                     "wasmrt/i32-or")
                  (= opcode 0x73)
                    (runtime-binary! context (mut stack) (wasm/I32) (wasm/I32)
                                     "wasmrt/i32-xor")
                  (= opcode 0x74)
                    (runtime-binary! context (mut stack) (wasm/I32) (wasm/I32)
                                     "wasmrt/i32-shl")
                  (= opcode 0x75)
                    (runtime-binary! context (mut stack) (wasm/I32) (wasm/I32)
                                     "wasmrt/i32-shr-s")
                  (= opcode 0x76)
                    (runtime-binary! context (mut stack) (wasm/I32) (wasm/I32)
                                     "wasmrt/i32-shr-u")
                  (= opcode 0x77)
                    (runtime-binary! context (mut stack) (wasm/I32) (wasm/I32)
                                     "wasmrt/i32-rotl")
                  (= opcode 0x78)
                    (runtime-binary! context (mut stack) (wasm/I32) (wasm/I32)
                                     "wasmrt/i32-rotr")
                  (= opcode 0x79)
                    (runtime-unary! context (mut stack) (wasm/I64) (wasm/I64)
                                    "wasmrt/i64-clz")
                  (= opcode 0x7a)
                    (runtime-unary! context (mut stack) (wasm/I64) (wasm/I64)
                                    "wasmrt/i64-ctz")
                  (= opcode 0x7b)
                    (runtime-unary! context (mut stack) (wasm/I64) (wasm/I64)
                                    "wasmrt/i64-popcnt")
                  (= opcode 0x7c)
                    (integer-binop! (mut stack) (wasm/I64)
                                    (primitive/datum->syntax context "primitive/iadd"))
                  (= opcode 0x7d)
                    (integer-binop! (mut stack) (wasm/I64)
                                    (primitive/datum->syntax context "primitive/isub"))
                  (= opcode 0x7e)
                    (integer-binop! (mut stack) (wasm/I64)
                                    (primitive/datum->syntax context "primitive/imul"))
                  (= opcode 0x7f)
                    (runtime-binary! context (mut stack) (wasm/I64) (wasm/I64)
                                     "wasmrt/i64-div-s")
                  (= opcode 0x80)
                    (runtime-binary! context (mut stack) (wasm/I64) (wasm/I64)
                                     "wasmrt/i64-div-u")
                  (= opcode 0x81)
                    (runtime-binary! context (mut stack) (wasm/I64) (wasm/I64)
                                     "wasmrt/i64-rem-s")
                  (= opcode 0x82)
                    (runtime-binary! context (mut stack) (wasm/I64) (wasm/I64)
                                     "wasmrt/i64-rem-u")
                  (= opcode 0x83)
                    (runtime-binary! context (mut stack) (wasm/I64) (wasm/I64)
                                     "wasmrt/i64-and")
                  (= opcode 0x84)
                    (runtime-binary! context (mut stack) (wasm/I64) (wasm/I64)
                                     "wasmrt/i64-or")
                  (= opcode 0x85)
                    (runtime-binary! context (mut stack) (wasm/I64) (wasm/I64)
                                     "wasmrt/i64-xor")
                  (= opcode 0x86)
                    (runtime-binary! context (mut stack) (wasm/I64) (wasm/I64)
                                     "wasmrt/i64-shl")
                  (= opcode 0x87)
                    (runtime-binary! context (mut stack) (wasm/I64) (wasm/I64)
                                     "wasmrt/i64-shr-s")
                  (= opcode 0x88)
                    (runtime-binary! context (mut stack) (wasm/I64) (wasm/I64)
                                     "wasmrt/i64-shr-u")
                  (= opcode 0x89)
                    (runtime-binary! context (mut stack) (wasm/I64) (wasm/I64)
                                     "wasmrt/i64-rotl")
                  (= opcode 0x8a)
                    (runtime-binary! context (mut stack) (wasm/I64) (wasm/I64)
                                     "wasmrt/i64-rotr")
                  (= opcode 0x8b)
                    (runtime-unary! context (mut stack) (wasm/F32) (wasm/F32) "wasmrt/f32-abs")
                  (= opcode 0x8c)
                    (runtime-unary! context (mut stack) (wasm/F32) (wasm/F32) "wasmrt/f32-neg")
                  (= opcode 0x8d)
                    (runtime-unary! context (mut stack) (wasm/F32) (wasm/F32) "wasmrt/f32-ceil")
                  (= opcode 0x8e)
                    (runtime-unary! context (mut stack) (wasm/F32) (wasm/F32) "wasmrt/f32-floor")
                  (= opcode 0x8f)
                    (runtime-unary! context (mut stack) (wasm/F32) (wasm/F32) "wasmrt/f32-trunc")
                  (= opcode 0x90)
                    (runtime-unary! context (mut stack) (wasm/F32) (wasm/F32) "wasmrt/f32-nearest")
                  (= opcode 0x91)
                    (runtime-unary! context (mut stack) (wasm/F32) (wasm/F32) "wasmrt/f32-sqrt")
                  (= opcode 0x92)
                    (runtime-binary! context (mut stack) (wasm/F32) (wasm/F32) "wasmrt/f32-add")
                  (= opcode 0x93)
                    (runtime-binary! context (mut stack) (wasm/F32) (wasm/F32) "wasmrt/f32-sub")
                  (= opcode 0x94)
                    (runtime-binary! context (mut stack) (wasm/F32) (wasm/F32) "wasmrt/f32-mul")
                  (= opcode 0x95)
                    (runtime-binary! context (mut stack) (wasm/F32) (wasm/F32) "wasmrt/f32-div")
                  (= opcode 0x96)
                    (runtime-binary! context (mut stack) (wasm/F32) (wasm/F32) "wasmrt/f32-min")
                  (= opcode 0x97)
                    (runtime-binary! context (mut stack) (wasm/F32) (wasm/F32) "wasmrt/f32-max")
                  (= opcode 0x98)
                    (runtime-binary! context (mut stack) (wasm/F32) (wasm/F32) "wasmrt/f32-copysign")
                  (= opcode 0x99)
                    (runtime-unary! context (mut stack) (wasm/F64) (wasm/F64) "wasmrt/f64-abs")
                  (= opcode 0x9a)
                    (runtime-unary! context (mut stack) (wasm/F64) (wasm/F64) "wasmrt/f64-neg")
                  (= opcode 0x9b)
                    (runtime-unary! context (mut stack) (wasm/F64) (wasm/F64) "wasmrt/f64-ceil")
                  (= opcode 0x9c)
                    (runtime-unary! context (mut stack) (wasm/F64) (wasm/F64) "wasmrt/f64-floor")
                  (= opcode 0x9d)
                    (runtime-unary! context (mut stack) (wasm/F64) (wasm/F64) "wasmrt/f64-trunc")
                  (= opcode 0x9e)
                    (runtime-unary! context (mut stack) (wasm/F64) (wasm/F64) "wasmrt/f64-nearest")
                  (= opcode 0x9f)
                    (runtime-unary! context (mut stack) (wasm/F64) (wasm/F64) "wasmrt/f64-sqrt")
                  (= opcode 0xa0)
                    (runtime-binary! context (mut stack) (wasm/F64) (wasm/F64) "wasmrt/f64-add")
                  (= opcode 0xa1)
                    (runtime-binary! context (mut stack) (wasm/F64) (wasm/F64) "wasmrt/f64-sub")
                  (= opcode 0xa2)
                    (runtime-binary! context (mut stack) (wasm/F64) (wasm/F64) "wasmrt/f64-mul")
                  (= opcode 0xa3)
                    (runtime-binary! context (mut stack) (wasm/F64) (wasm/F64) "wasmrt/f64-div")
                  (= opcode 0xa4)
                    (runtime-binary! context (mut stack) (wasm/F64) (wasm/F64) "wasmrt/f64-min")
                  (= opcode 0xa5)
                    (runtime-binary! context (mut stack) (wasm/F64) (wasm/F64) "wasmrt/f64-max")
                  (= opcode 0xa6)
                    (runtime-binary! context (mut stack) (wasm/F64) (wasm/F64) "wasmrt/f64-copysign")
                  (= opcode 0xa7)
                    (runtime-unary! context (mut stack) (wasm/I64) (wasm/I32) "wasmrt/i32-wrap-i64")
                  (= opcode 0xa8)
                    (runtime-unary! context (mut stack) (wasm/F32) (wasm/I32) "wasmrt/i32-trunc-f32-s")
                  (= opcode 0xa9)
                    (runtime-unary! context (mut stack) (wasm/F32) (wasm/I32) "wasmrt/i32-trunc-f32-u")
                  (= opcode 0xaa)
                    (runtime-unary! context (mut stack) (wasm/F64) (wasm/I32) "wasmrt/i32-trunc-f64-s")
                  (= opcode 0xab)
                    (runtime-unary! context (mut stack) (wasm/F64) (wasm/I32) "wasmrt/i32-trunc-f64-u")
                  (= opcode 0xac)
                    (runtime-unary! context (mut stack) (wasm/I32) (wasm/I64) "wasmrt/i64-extend-i32-s")
                  (= opcode 0xad)
                    (runtime-unary! context (mut stack) (wasm/I32) (wasm/I64) "wasmrt/i64-extend-i32-u")
                  (= opcode 0xae)
                    (runtime-unary! context (mut stack) (wasm/F32) (wasm/I64) "wasmrt/i64-trunc-f32-s")
                  (= opcode 0xaf)
                    (runtime-unary! context (mut stack) (wasm/F32) (wasm/I64) "wasmrt/i64-trunc-f32-u")
                  (= opcode 0xb0)
                    (runtime-unary! context (mut stack) (wasm/F64) (wasm/I64) "wasmrt/i64-trunc-f64-s")
                  (= opcode 0xb1)
                    (runtime-unary! context (mut stack) (wasm/F64) (wasm/I64) "wasmrt/i64-trunc-f64-u")
                  (= opcode 0xb2)
                    (runtime-unary! context (mut stack) (wasm/I32) (wasm/F32) "wasmrt/f32-convert-i32-s")
                  (= opcode 0xb3)
                    (runtime-unary! context (mut stack) (wasm/I32) (wasm/F32) "wasmrt/f32-convert-i32-u")
                  (= opcode 0xb4)
                    (runtime-unary! context (mut stack) (wasm/I64) (wasm/F32) "wasmrt/f32-convert-i64-s")
                  (= opcode 0xb5)
                    (runtime-unary! context (mut stack) (wasm/I64) (wasm/F32) "wasmrt/f32-convert-i64-u")
                  (= opcode 0xb6)
                    (runtime-unary! context (mut stack) (wasm/F64) (wasm/F32) "wasmrt/f32-demote-f64")
                  (= opcode 0xb7)
                    (runtime-unary! context (mut stack) (wasm/I32) (wasm/F64) "wasmrt/f64-convert-i32-s")
                  (= opcode 0xb8)
                    (runtime-unary! context (mut stack) (wasm/I32) (wasm/F64) "wasmrt/f64-convert-i32-u")
                  (= opcode 0xb9)
                    (runtime-unary! context (mut stack) (wasm/I64) (wasm/F64) "wasmrt/f64-convert-i64-s")
                  (= opcode 0xba)
                    (runtime-unary! context (mut stack) (wasm/I64) (wasm/F64) "wasmrt/f64-convert-i64-u")
                  (= opcode 0xbb)
                    (runtime-unary! context (mut stack) (wasm/F32) (wasm/F64) "wasmrt/f64-promote-f32")
                  (= opcode 0xbc)
                    (runtime-unary! context (mut stack) (wasm/F32) (wasm/I32) "wasmrt/f32-to-bits")
                  (= opcode 0xbd)
                    (runtime-unary! context (mut stack) (wasm/F64) (wasm/I64) "wasmrt/f64-to-bits")
                  (= opcode 0xbe)
                    (runtime-unary! context (mut stack) (wasm/I32) (wasm/F32) "wasmrt/f32-from-bits")
                  (= opcode 0xbf)
                    (runtime-unary! context (mut stack) (wasm/I64) (wasm/F64) "wasmrt/f64-from-bits")
                  :else
                    (primitive/error "WebAssembly codegen: unsupported MVP opcode")))))
    (if (.failed p) (primitive/error (.message p)) 0)
    (if (not (load ended))
        (primitive/error "WebAssembly expression lacks a final end opcode")
        (load stop-opcode))))

(defn compile-expression [(a (dyn alloc/Allocator)) (context Code)
                          (signature wasm/FuncType) (body wasm/FuncBody)
                          (bindings CodeBuilder)
                          (locals Code) (globals Code) (memory Code) (table Code)
                          (function-names Code)
                          (function-indices (al/ArrayList i64))
                          (types (al/ArrayList wasm/FuncType))] (-> Code)
  (let [b body
        (mut p) (wasm/parser (.expression b))
        (mut stack) `()
        forms-builder (primitive/code-list-new)
        result-tag (if (= (al/al-len (.results signature)) 0)
                       0
                       (kind-tag (al/al-get (.results signature) 0)))
        function-label `:wasm-function
        label-names `(~function-label)
        label-tags `(~result-tag)
        label-loops `(0)
        stop (compile-region! a context (mut p) (mut stack) forms-builder bindings false `() result-tag
                              function-label label-names label-tags label-loops
                              result-tag
                              locals globals memory table function-names function-indices types)]
    (if (and (!= stop 0x0b) (< stop 0x100))
        (primitive/error "WebAssembly function expression ended unexpectedly")
        0)
    (if (!= (wasm/remaining (.cursor p)) 0)
        (primitive/error "WebAssembly function has bytes after final end opcode")
        0)
    (let [sig signature
          result-count (al/al-len (.results sig))
          forms (primitive/code-list-done forms-builder)
          body-code
      (if (= result-count 0)
          (if (or (>= stop 0x100) (= (primitive/code-count (load stack)) 0))
              `(do ~@forms)
              (primitive/error "WebAssembly validation: void function leaves operands"))
          (let [value (pop-node! (mut stack))
                wanted (al/al-get (.results sig) 0)]
            (if (and (< stop 0x100) (!= (primitive/code-count (load stack)) 0))
                (primitive/error "WebAssembly validation: result stack height mismatch")
                (if (!= (node-kind value) (kind-tag wanted))
                    (primitive/error "WebAssembly validation: function result type mismatch")
                    (let [result (primitive/code-nth value 1)]
                      `(do ~@forms ~result))))))
          scope-id (primitive/datum->syntax context "loop")
          break-id (primitive/datum->syntax context "break")]
      (if (= result-count 0)
          `(do (~scope-id ~function-label
                  (~break-id ~function-label (do ~body-code 0))))
          `(~scope-id ~function-label (~break-id ~function-label ~body-code))))))

(defn function-form [(a (dyn alloc/Allocator)) (context Code) (name Code)
                     (signature wasm/FuncType) (body wasm/FuncBody)
                     (globals Code) (memory Code) (table Code) (function-names Code)
                     (function-indices (al/ArrayList i64))
                     (types (al/ArrayList wasm/FuncType))] (-> Code)
  (let [sig signature
        b body
        params (primitive/code-list-new)
        locals (primitive/code-list-new)
        bindings (primitive/code-list-new)
        (mut i) 0]
    (loop
      (if (>= (load i) (al/al-len (.params sig)))
          (break)
          (let [kind (al/al-get (.params sig) (load i))
                id (primitive/fresh-identifier "wasm-param")
                cell (primitive/fresh-identifier "wasm-local")]
            (primitive/code-list-push! params `(~id ~(type-code context kind)))
            (primitive/code-list-push! locals `(~(kind-tag kind) ~cell))
            (primitive/code-list-push! bindings `((mut ~cell) ~id))
            (store! i (+ (load i) 1)))))
    (store! i 0)
    (loop
      (if (>= (load i) (al/al-len (.locals b)))
          (break)
          (let [kind (al/al-get (.locals b) (load i))
                cell (primitive/fresh-identifier "wasm-local")
                cast-id (primitive/datum->syntax context "primitive/cast")
                type (type-code context kind)]
            (primitive/code-list-push! locals `(~(kind-tag kind) ~cell))
            (primitive/code-list-push! bindings
                                       `((mut ~cell) (~cast-id ~type 0)))
            (store! i (+ (load i) 1)))))
    (let [param-code (primitive/code-list-done params)
          local-code (primitive/code-list-done locals)
          body-code (compile-expression a context sig b bindings local-code
                                        globals memory table function-names function-indices types)
          binding-pairs (primitive/code-list-done bindings)
          binding-code (primitive/code-list-new)
          (mut j) 0]
      (loop
        (if (>= (load j) (primitive/code-count binding-pairs))
            (break)
            (let [pair (primitive/code-nth binding-pairs (load j))]
              (primitive/code-list-push! binding-code (primitive/code-nth pair 0))
              (primitive/code-list-push! binding-code (primitive/code-nth pair 1))
              (store! j (+ (load j) 1)))))
      (let [binding-vector (primitive/code-list-done binding-code)
            result-type (if (= (al/al-len (.results sig)) 0)
                            `void
                            (type-code context (al/al-get (.results sig) 0)))
            enter-id (primitive/datum->syntax context "wasmrt/enter-call!")
            leave-id (primitive/datum->syntax context "wasmrt/leave-call!")]
        (if (= (al/al-len (.results sig)) 0)
            `(defn ~name [~@param-code] (-> ~result-type)
               (do (~enter-id)
                   (let [~@binding-vector]
                     (do ~body-code (~leave-id)))))
            (let [result-id (primitive/fresh-identifier "wasm-call-result")]
              `(defn ~name [~@param-code] (-> ~result-type)
                 (do (~enter-id)
                     (let [~@binding-vector
                           ~result-id ~body-code]
                       (do (~leave-id) ~result-id))))))))))

(defn global-initializer [(context Code) (global wasm/Global) (imports Code)] (-> Code)
  (let [g global
        bits (.initializer-bits g)
        cast-id (primitive/datum->syntax context "primitive/cast")]
    (if (= (.initializer-opcode g) 0x23)
        (if (>= bits (primitive/code-count imports))
            (primitive/error "WebAssembly validation: global initializer index out of bounds")
            (let [source (primitive/code-nth imports bits)
                  source-tag (primitive/code-int (primitive/code-nth source 0))
                  source-mutable (primitive/code-int (primitive/code-nth source 1))
                  source-accessor (primitive/code-nth source 2)
                  load-id (primitive/datum->syntax context "load")]
              (if (!= source-mutable 0)
                  (primitive/error
                    "WebAssembly validation: global initializer requires immutable imported global")
                  0)
              (if (!= source-tag (kind-tag (.kind g)))
                  (primitive/error "WebAssembly validation: global initializer type mismatch")
                  0)
              `(~load-id (~source-accessor))))
        (match (.kind g)
          (wasm/I32 [] `(~cast-id i32 ~bits))
          (wasm/I64 [] `~bits)
          (wasm/F32 []
            (let [from (primitive/datum->syntax context "wasmrt/f32-from-bits")]
              `(~from (~cast-id i32 ~bits))))
          (wasm/F64 []
            (let [from (primitive/datum->syntax context "wasmrt/f64-from-bits")]
              `(~from ~bits)))))))

(defn global-accessor-form [(context Code) (name Code) (global wasm/Global)
                            (imports Code)] (-> Code)
  (let [g global
        type (type-code context (.kind g))
        initializer (global-initializer context g imports)
        cell (primitive/fresh-identifier "wasm-global-cell")
        initialized (primitive/fresh-identifier "wasm-global-initialized")
        alloc-static-id (primitive/datum->syntax context "primitive/alloc-static")
        load-id (primitive/datum->syntax context "load")
        store-id (primitive/datum->syntax context "store!")]
    `(defn ~name [] (-> (ptr ~type))
       (let [~cell (~alloc-static-id ~type)
             ~initialized (~alloc-static-id i32)]
         (if (= (~load-id ~initialized) 0)
             (do (~store-id ~cell ~initializer)
                 (~store-id ~initialized 1))
             0)
         ~cell))))

(defn emit-globals! [(context Code) (forms CodeBuilder) (entries CodeBuilder)
                     (globals (al/ArrayList wasm/Global)) (imports Code)] (-> i64)
  (let [(mut i) 0]
    (loop
      (if (>= (load i) (al/al-len globals))
          (break)
          (let [global (al/al-get globals (load i))
                accessor (primitive/fresh-identifier "wasm-global")]
            (primitive/code-list-push! forms
                                       (global-accessor-form context accessor global imports))
            (primitive/code-list-push!
              entries
              `(~(kind-tag (.kind global)) ~(if (.mutable global) 1 0) ~accessor))
            (store! i (+ (load i) 1)))))
    0))

(defn emit-imported-globals! [(context Code) (forms CodeBuilder)
                              (entries CodeBuilder)
                              (imports (al/ArrayList wasm/Import))] (-> i64)
  (let [(mut i) 0]
    (loop
      (if (>= (load i) (al/al-len imports))
          (break)
          (let [entry (al/al-get imports (load i))]
            (if (= (.kind entry) 3)
                (let [alias (primitive/datum->syntax
                              context
                              (primitive/code-symbol "wasm-global-import-" (load i)))
                      module-path (if (= (.module-name entry) "spectest")
                                      "experiments.wasm.spectest"
                                      (.module-name entry))
                      source-prefix (if (.mutable entry)
                                        "/__wasm_global_mut_"
                                        "/__wasm_global_")
                      source (primitive/datum->syntax
                               context
                               (primitive/code-symbol alias source-prefix
                                                      (mapped-export-name
                                                        (.item-name entry))))]
                  (primitive/code-list-push! forms `(import ~module-path :as ~alias))
                  (let [accessor (primitive/fresh-identifier "wasm-imported-global")
                        type (type-code context (.value-kind entry))]
                    (primitive/code-list-push!
                      forms `(defn ~accessor [] (-> (ptr ~type)) (~source)))
                    (primitive/code-list-push!
                      entries
                      `(~(kind-tag (.value-kind entry))
                        ~(if (.mutable entry) 1 0)
                        ~accessor)))
                  0)
                0)
            (store! i (+ (load i) 1)))))
    0))

(defn compile-globals [(a (dyn alloc/Allocator)) (context Code)
                       (payload (slice u8)) (imports (al/ArrayList wasm/Import))
                       (forms CodeBuilder)] (-> Code)
  (let [imported-builder (primitive/code-list-new)]
    (emit-imported-globals! context forms imported-builder imports)
    (let [imported (primitive/code-list-done imported-builder)
          entries (primitive/code-list-new)
          (mut imported-index) 0]
      (loop
        (if (>= (load imported-index) (primitive/code-count imported))
            (break)
            (do
              (primitive/code-list-push!
                entries (primitive/code-nth imported (load imported-index)))
              (store! imported-index (+ (load imported-index) 1)))))
    (if (= (slice-len payload) 0)
        0
        (match (wasm/global-section a payload)
          (wasm/DecodeError [_ message] (primitive/error message))
          (wasm/Decoded [globals]
            (emit-globals! context forms entries globals imported))))
      (primitive/code-list-done entries))))

(defn segment-offset-form [(context Code) (offset-is-global bool) (offset i64)
                           (globals Code)] (-> Code)
  (let [cast-id (primitive/datum->syntax context "primitive/cast")]
    (if offset-is-global
        (if (>= offset (primitive/code-count globals))
            (primitive/error "WebAssembly validation: segment offset global index out of bounds")
            (let [global (primitive/code-nth globals offset)
                  tag (primitive/code-int (primitive/code-nth global 0))
                  mutable (primitive/code-int (primitive/code-nth global 1))
                  accessor (primitive/code-nth global 2)
                  load-id (primitive/datum->syntax context "load")]
              (if (!= tag 1)
                  (primitive/error "WebAssembly validation: segment offset global must be i32")
                  0)
              (if (!= mutable 0)
                  (primitive/error "WebAssembly validation: segment offset global must be immutable")
                  0)
              `(~load-id (~accessor))))
        `(~cast-id i32 ~offset))))

(defn memory-accessor-form [(context Code) (name Code) (memory wasm/MemoryType)
                            (globals Code)
                            (segments (al/ArrayList wasm/DataSegment))]
                           (-> Code)
  (let [m memory
        state (primitive/fresh-identifier "wasm-memory-state")
        data-initialized (primitive/fresh-identifier "wasm-data-initialized")
        memory-type (primitive/datum->syntax context "wasmrt/Memory")
        alloc-static-id (primitive/datum->syntax context "primitive/alloc-static")
        init-id (primitive/datum->syntax context "wasmrt/memory-init!")
        check-id (primitive/datum->syntax context "wasmrt/memory-data-check")
        byte-id (primitive/datum->syntax context "wasmrt/memory-data-byte!")
        cast-id (primitive/datum->syntax context "primitive/cast")
        load-id (primitive/datum->syntax context "load")
        store-id (primitive/datum->syntax context "store!")
        data-forms (primitive/code-list-new)
        (mut i) 0]
    (loop
      (if (>= (load i) (al/al-len segments))
          (break)
          (let [segment (al/al-get segments (load i))
                bytes (.bytes segment)
                offset (segment-offset-form context (.offset-is-global segment)
                                            (.offset segment) globals)
                length (slice-len bytes)
                (mut j) 0]
            (primitive/code-list-push!
              data-forms
              `(~check-id ~state ~offset ~length))
            (loop
              (if (>= (load j) length)
                  (break)
                  (do
                    (primitive/code-list-push!
                      data-forms
                      `(~byte-id ~state
                                 (+ ~offset (~cast-id i32 ~(load j)))
                                 ~(primitive/cast i64 (slice-get bytes (load j)))))
                    (store! j (+ (load j) 1)))))
            (store! i (+ (load i) 1)))))
    (let [initializers (primitive/code-list-done data-forms)]
    `(defn ~name [] (-> (ptr ~memory-type))
       (let [~state (~alloc-static-id ~memory-type)]
         (~init-id ~state ~(.minimum m) ~(.has-maximum m) ~(.maximum m))
         (let [~data-initialized (~alloc-static-id i32)]
           (if (= (~load-id ~data-initialized) 0)
               (do ~@initializers (~store-id ~data-initialized 1))
               0))
         ~state)))))

(defn imported-memory-accessor-form [(context Code) (name Code) (source Code)
                                     (import-type wasm/Import)
                                     (globals Code)
                                     (segments (al/ArrayList wasm/DataSegment))]
                                    (-> Code)
  (let [state (primitive/fresh-identifier "wasm-imported-memory-state")
        data-initialized (primitive/fresh-identifier "wasm-imported-data-initialized")
        memory-type (primitive/datum->syntax context "wasmrt/Memory")
        alloc-static-id (primitive/datum->syntax context "primitive/alloc-static")
        import-check-id (primitive/datum->syntax context "wasmrt/memory-import-check")
        check-id (primitive/datum->syntax context "wasmrt/memory-data-check")
        byte-id (primitive/datum->syntax context "wasmrt/memory-data-byte!")
        cast-id (primitive/datum->syntax context "primitive/cast")
        load-id (primitive/datum->syntax context "load")
        store-id (primitive/datum->syntax context "store!")
        data-forms (primitive/code-list-new)
        (mut i) 0]
    (loop
      (if (>= (load i) (al/al-len segments))
          (break)
          (let [segment (al/al-get segments (load i))
                bytes (.bytes segment)
                offset (segment-offset-form context (.offset-is-global segment)
                                            (.offset segment) globals)
                length (slice-len bytes)
                (mut j) 0]
            (primitive/code-list-push!
              data-forms `(~check-id ~state ~offset ~length))
            (loop
              (if (>= (load j) length)
                  (break)
                  (do
                    (primitive/code-list-push!
                      data-forms
                      `(~byte-id ~state
                                 (+ ~offset (~cast-id i32 ~(load j)))
                                 ~(primitive/cast i64 (slice-get bytes (load j)))))
                    (store! j (+ (load j) 1)))))
            (store! i (+ (load i) 1)))))
    (let [initializers (primitive/code-list-done data-forms)]
      `(defn ~name [] (-> (ptr ~memory-type))
         (let [~state (~source)
               ~data-initialized (~alloc-static-id i32)]
           (~import-check-id ~state ~(.minimum import-type)
                             ~(.has-maximum import-type) ~(.maximum import-type))
           (if (= (~load-id ~data-initialized) 0)
               (do ~@initializers (~store-id ~data-initialized 1))
               0)
           ~state)))))

(defn wasm-import-module-path [(entry wasm/Import)] (-> (slice u8))
  (if (= (.module-name entry) "spectest")
      "experiments.wasm.spectest"
      (.module-name entry)))

(defn compile-memory [(a (dyn alloc/Allocator)) (context Code)
                      (payload (slice u8)) (data-payload (slice u8))
                      (imports (al/ArrayList wasm/Import))
                      (globals Code) (forms CodeBuilder)] (-> Code)
  (let [(mut imported-index) -1
        (mut i) 0]
    (loop
      (if (>= (load i) (al/al-len imports))
          (break)
          (let [entry (al/al-get imports (load i))]
            (if (= (.kind entry) 2) (store! imported-index (load i)) 0)
            (store! i (+ (load i) 1)))))
    (if (>= (load imported-index) 0)
        (let [entry (al/al-get imports (load imported-index))
              alias (primitive/datum->syntax
                      context (primitive/code-symbol "wasm-memory-import-"
                                                     (load imported-index)))
              module-path (wasm-import-module-path entry)
              source (primitive/datum->syntax
                       context
                       (primitive/code-symbol alias "/__wasm_memory_"
                                              (mapped-export-name (.item-name entry))))
              accessor (primitive/fresh-identifier "wasm-memory")]
          (primitive/code-list-push! forms `(import ~module-path :as ~alias))
          (if (= (slice-len data-payload) 0)
              (primitive/code-list-push!
                forms (imported-memory-accessor-form
                        context accessor source entry globals
                        (al/al-new [wasm/DataSegment] a)))
              (match (wasm/data-section a data-payload)
                (wasm/DecodeError [_ message] (primitive/error message))
                (wasm/Decoded [segments]
                  (primitive/code-list-push!
                    forms (imported-memory-accessor-form
                            context accessor source entry globals segments)))))
          `(1 ~accessor))
        (if (= (slice-len payload) 0)
            (if (= (slice-len data-payload) 0)
                `()
                (primitive/error "WebAssembly validation: data segment without memory"))
            (match (wasm/memory-section a payload)
              (wasm/DecodeError [_ message] (primitive/error message))
              (wasm/Decoded [memories]
                (if (= (al/al-len memories) 0)
                    `()
                    (let [accessor (primitive/fresh-identifier "wasm-memory")]
                      (if (= (slice-len data-payload) 0)
                          (do
                            (primitive/code-list-push!
                              forms
                              (memory-accessor-form context accessor
                                                    (al/al-get memories 0)
                                                    globals
                                                    (al/al-new [wasm/DataSegment] a)))
                            `(1 ~accessor))
                          (match (wasm/data-section a data-payload)
                            (wasm/DecodeError [_ message] (primitive/error message))
                            (wasm/Decoded [segments]
                              (do
                                (primitive/code-list-push!
                                  forms
                                  (memory-accessor-form context accessor
                                                        (al/al-get memories 0)
                                                        globals segments))
                                `(1 ~accessor)))))))))))))

(defn table-accessor-form [(context Code) (forms CodeBuilder) (name Code) (source Code)
                           (imported bool) (minimum i64) (has-maximum bool)
                           (maximum i64) (segments (al/ArrayList wasm/ElementSegment))
                           (function-names Code) (function-indices (al/ArrayList i64))
                           (types (al/ArrayList wasm/FuncType)) (globals Code)] (-> Code)
  (let [state (primitive/fresh-identifier "wasm-table-state")
        elements-initialized (primitive/fresh-identifier "wasm-elements-initialized")
        table-type (primitive/datum->syntax context "wasmrt/Table")
        alloc-static-id (primitive/datum->syntax context "primitive/alloc-static")
        init-id (primitive/datum->syntax context "wasmrt/table-init!")
        import-check-id (primitive/datum->syntax context "wasmrt/table-import-check")
        segment-check-id (primitive/datum->syntax context "wasmrt/table-segment-check")
        set-id (primitive/datum->syntax context "wasmrt/table-set-ref!")
        set-byte-id (primitive/datum->syntax context "wasmrt/table-set-signature-byte!")
        fnptr-of-id (primitive/datum->syntax context "primitive/fnptr-of")
        llvm-id (primitive/datum->syntax context "primitive/llvm-ir")
        cast-id (primitive/datum->syntax context "primitive/cast")
        load-id (primitive/datum->syntax context "load")
        store-id (primitive/datum->syntax context "store!")
        element-forms (primitive/code-list-new)
        (mut i) 0]
    (loop
      (if (>= (load i) (al/al-len segments))
          (break)
          (let [segment (al/al-get segments (load i))
                offset (segment-offset-form context (.offset-is-global segment)
                                            (.offset segment) globals)
                (mut j) 0]
            (primitive/code-list-push!
              element-forms
              `(~segment-check-id ~state (~cast-id i64 ~offset)
                                  ~(al/al-len (.functions segment))))
            (loop
                (if (>= (load j) (al/al-len (.functions segment)))
                  (break)
                  (let [function-index (al/al-get (.functions segment) (load j))]
                    (if (>= function-index (primitive/code-count function-names))
                        (primitive/error "WebAssembly validation: element function index out of bounds")
                        (let [type-index (al/al-get function-indices function-index)
                              signature (al/al-get types type-index)
                              callee (primitive/code-nth function-names function-index)
                              signature-length (+ 1 (al/al-len (.params signature)))
                              result-tag (if (= (al/al-len (.results signature)) 0)
                                             0
                                             (kind-tag (al/al-get (.results signature) 0)))
                              table-index `(+ (~cast-id i64 ~offset) ~(load j))
                              address-target
                                (if (= (al/al-len (.results signature)) 0)
                                    (let [adapter (primitive/fresh-identifier
                                                    "wasm-table-void-adapter")
                                          params-builder (primitive/code-list-new)
                                          args-builder (primitive/code-list-new)
                                          (mut p) 0]
                                      (loop
                                        (if (>= (load p) (al/al-len (.params signature)))
                                            (break)
                                            (let [param (primitive/fresh-identifier
                                                          "wasm-table-adapter-param")]
                                              (primitive/code-list-push!
                                                params-builder
                                                `(~param
                                                  ~(type-code
                                                     context
                                                     (al/al-get (.params signature)
                                                                (load p)))))
                                              (primitive/code-list-push! args-builder param)
                                              (store! p (+ (load p) 1)))))
                                      (let [params (primitive/code-list-done params-builder)
                                            args (primitive/code-list-done args-builder)]
                                        (primitive/code-list-push!
                                          forms
                                          `(defn ~adapter [~@params] (-> i64)
                                             (do (~callee ~@args) 0))))
                                      adapter)
                                    callee)
                              (mut k) 0]
                          (primitive/code-list-push!
                            element-forms
                            `(~set-id ~state ~table-index
                                      (~llvm-id i64 [(~fnptr-of-id ~address-target)]
                                        "%r = ptrtoint $t0 $0 to i64\nret i64 %r")
                                      ~signature-length))
                          (primitive/code-list-push!
                            element-forms `(~set-byte-id ~state ~table-index 0 ~result-tag))
                          (loop
                            (if (>= (load k) (al/al-len (.params signature)))
                                (break)
                                (do
                                  (primitive/code-list-push!
                                    element-forms
                                    `(~set-byte-id ~state ~table-index
                                                   ~(+ 1 (load k))
                                                   ~(kind-tag
                                                      (al/al-get (.params signature)
                                                                 (load k)))))
                                  (store! k (+ (load k) 1)))))))
                    (store! j (+ (load j) 1)))))
            (store! i (+ (load i) 1)))))
    (let [initializers (primitive/code-list-done element-forms)
          state-expression (if imported `(~source) `(~alloc-static-id ~table-type))
          prepare (if imported
                      `(~import-check-id ~state ~minimum ~has-maximum ~maximum)
                      `(~init-id ~state ~minimum ~has-maximum ~maximum))]
      `(defn ~name [] (-> (ptr ~table-type))
         (let [~state ~state-expression
               ~elements-initialized (~alloc-static-id i32)]
           ~prepare
           (if (= (~load-id ~elements-initialized) 0)
               (do ~@initializers (~store-id ~elements-initialized 1))
               0)
           ~state)))))

(defn decoded-elements [(a (dyn alloc/Allocator)) (_context Code)
                        (payload (slice u8))]
                       (-> (al/ArrayList wasm/ElementSegment))
  (if (= (slice-len payload) 0)
      (al/al-new [wasm/ElementSegment] a)
      (match (wasm/element-section a payload)
        (wasm/DecodeError [_ message] (primitive/error message))
        (wasm/Decoded [segments] segments))))

(defn table-code [(a (dyn alloc/Allocator)) (context Code)
                  (table-payload (slice u8)) (element-payload (slice u8))
                  (imports (al/ArrayList wasm/Import)) (forms CodeBuilder)
                  (function-names Code) (function-indices (al/ArrayList i64))
                  (types (al/ArrayList wasm/FuncType)) (globals Code)] (-> Code)
  (let [(mut imported-index) -1
        (mut i) 0]
    (loop
      (if (>= (load i) (al/al-len imports))
          (break)
          (let [entry (al/al-get imports (load i))]
            (if (= (.kind entry) 1) (store! imported-index (load i)) 0)
            (store! i (+ (load i) 1)))))
    (if (>= (load imported-index) 0)
        (let [entry (al/al-get imports (load imported-index))
              alias (primitive/datum->syntax
                      context (primitive/code-symbol "wasm-table-import-"
                                                     (load imported-index)))
              module-path (wasm-import-module-path entry)
              source (primitive/datum->syntax
                       context
                       (primitive/code-symbol alias "/__wasm_table_"
                                              (mapped-export-name (.item-name entry))))
              accessor (primitive/fresh-identifier "wasm-table")
              segments (decoded-elements a context element-payload)]
          (primitive/code-list-push! forms `(import ~module-path :as ~alias))
          (primitive/code-list-push!
            forms
            (table-accessor-form context forms accessor source true
                                 (.minimum entry) (.has-maximum entry) (.maximum entry)
                                 segments function-names function-indices types globals))
          `(1 ~accessor))
        (if (= (slice-len table-payload) 0)
            (if (= (slice-len element-payload) 0)
                `()
                (primitive/error "WebAssembly validation: element segment without table"))
            (match (wasm/table-section a table-payload)
              (wasm/DecodeError [_ message] (primitive/error message))
              (wasm/Decoded [tables]
                (if (= (al/al-len tables) 0)
                    `()
                    (let [declared (al/al-get tables 0)
                          accessor (primitive/fresh-identifier "wasm-table")
                          segments (decoded-elements a context element-payload)]
                      (primitive/code-list-push!
                        forms
                        (table-accessor-form context forms accessor `() false
                                             (.minimum declared) (.has-maximum declared)
                                             (.maximum declared) segments
                                             function-names function-indices types globals))
                      `(1 ~accessor)))))))))

(defn export-wrapper-form [(context Code) (export-name (slice u8)) (callee Code)
                           (initializer Code)
                           (signature wasm/FuncType)] (-> Code)
  (let [sig signature
        name-text (mapped-export-name export-name)
        name (primitive/datum->syntax context name-text)
        params (primitive/code-list-new)
        arguments (primitive/code-list-new)
        (mut i) 0]
    (loop
      (if (>= (load i) (al/al-len (.params sig)))
          (break)
          (let [kind (al/al-get (.params sig) (load i))
                id (primitive/fresh-identifier "wasm-export-param")]
            (primitive/code-list-push! params `(~id ~(type-code context kind)))
            (primitive/code-list-push! arguments id)
            (store! i (+ (load i) 1)))))
    (let [param-code (primitive/code-list-done params)
          argument-code (primitive/code-list-done arguments)
          result-type (if (= (al/al-len (.results sig)) 0)
                          `void
                          (type-code context (al/al-get (.results sig) 0)))]
      `((export ~name)
        (defn ~name [~@param-code] (-> ~result-type)
          (do (~initializer) (~callee ~@argument-code)))))))

(defn emit-export-wrappers! [(context Code) (forms CodeBuilder) (names Code)
                             (globals Code) (memory Code) (table Code)
                             (indices (al/ArrayList i64))
                             (types (al/ArrayList wasm/FuncType))
                             (exports (al/ArrayList wasm/Export))] (-> i64)
  (let [initializer (primitive/datum->syntax context "__coil_wasm_instantiate")
        (mut i) 0]
    (loop
      (if (>= (load i) (al/al-len exports))
          (break)
          (let [e (al/al-get exports (load i))]
            (cond (= (.kind e) 0)
                (let [function-index (.index e)]
                  (if (>= function-index (primitive/code-count names))
                      (primitive/error "WebAssembly validation: exported function index out of bounds")
                      (let [type-index (al/al-get indices function-index)
                            signature (al/al-get types type-index)
                            wrapper (export-wrapper-form
                                      context (.name e)
                                      (primitive/code-nth names function-index)
                                      initializer
                                      signature)
                            hidden (primitive/datum->syntax
                                     context
                                     (primitive/code-symbol
                                       "__wasm_function_type_"
                                       (mapped-export-name (.name e))))
                            function-type-type (primitive/datum->syntax
                                                 context "wasmrt/FunctionType")
                            alloc-static-id (primitive/datum->syntax
                                              context "primitive/alloc-static")
                            init-id (primitive/datum->syntax
                                      context "wasmrt/function-type-init!")
                            set-id (primitive/datum->syntax
                                     context "wasmrt/function-type-set!")
                            signature-length (+ 1 (al/al-len (.params signature)))
                            signature-forms-builder (primitive/code-list-new)
                            (mut signature-index) 0]
                        (primitive/code-list-push! forms (primitive/code-nth wrapper 0))
                        (primitive/code-list-push! forms (primitive/code-nth wrapper 1))
                        (primitive/code-list-push! forms `(export ~hidden))
                        (primitive/code-list-push!
                          signature-forms-builder
                          `(~set-id ~hidden ~0
                             ~(if (= (al/al-len (.results signature)) 0)
                                  0
                                  (kind-tag (al/al-get (.results signature) 0)))))
                        (loop
                          (if (>= (load signature-index) (al/al-len (.params signature)))
                              (break)
                              (do
                                (primitive/code-list-push!
                                  signature-forms-builder
                                  `(~set-id ~hidden ~(+ 1 (load signature-index))
                                     ~(kind-tag
                                        (al/al-get (.params signature)
                                                   (load signature-index)))))
                                (store! signature-index (+ (load signature-index) 1)))))
                        (let [signature-forms
                                (primitive/code-list-done signature-forms-builder)]
                          (primitive/code-list-push!
                            forms
                            `(defn ~hidden [] (-> (ptr ~function-type-type))
                               (let [~hidden (~alloc-static-id ~function-type-type)]
                                 (~init-id ~hidden ~signature-length)
                                 ~@signature-forms
                                 ~hidden))))
                        0)))
                  (= (.kind e) 1)
                (if (or (>= (.index e) 1) (= (primitive/code-count table) 0))
                    (primitive/error "WebAssembly validation: exported table index out of bounds")
                    (let [accessor (primitive/code-nth table 1)
                          hidden (primitive/datum->syntax
                                   context
                                   (primitive/code-symbol "__wasm_table_"
                                                          (mapped-export-name (.name e))))
                          table-type (primitive/datum->syntax context "wasmrt/Table")]
                      (primitive/code-list-push! forms `(export ~hidden))
                      (primitive/code-list-push!
                        forms
                        `(defn ~hidden [] (-> (ptr ~table-type))
                           (do (~initializer) (~accessor))))
                      0))
                  (= (.kind e) 2)
                (if (or (>= (.index e) 1) (= (primitive/code-count memory) 0))
                    (primitive/error "WebAssembly validation: exported memory index out of bounds")
                    (let [accessor (primitive/code-nth memory 1)
                          hidden (primitive/datum->syntax
                                   context
                                   (primitive/code-symbol "__wasm_memory_"
                                                          (mapped-export-name (.name e))))
                          memory-type (primitive/datum->syntax context "wasmrt/Memory")]
                      (primitive/code-list-push! forms `(export ~hidden))
                      (primitive/code-list-push!
                        forms
                        `(defn ~hidden [] (-> (ptr ~memory-type))
                           (do (~initializer) (~accessor))))
                      0))
                  (= (.kind e) 3)
                    (let [global-index (.index e)]
                      (if (>= global-index (primitive/code-count globals))
                          (primitive/error "WebAssembly validation: exported global index out of bounds")
                          (let [global (primitive/code-nth globals global-index)
                                tag (primitive/code-int (primitive/code-nth global 0))
                                accessor (primitive/code-nth global 2)
                                name-text (mapped-export-name (.name e))
                                name (primitive/datum->syntax context name-text)
                                hidden-prefix (if (= (primitive/code-int
                                                       (primitive/code-nth global 1)) 1)
                                                  "__wasm_global_mut_"
                                                  "__wasm_global_")
                                hidden (primitive/datum->syntax
                                         context
                                         (primitive/code-symbol
                                           hidden-prefix (mapped-export-name (.name e))))
                                load-id (primitive/datum->syntax context "load")
                                type (cond (= tag 1) `i32
                                           (= tag 2) `i64
                                           (= tag 3) `f32
                                           (= tag 4) `f64
                                           :else (primitive/error "invalid global type tag"))]
                            (primitive/code-list-push! forms `(export ~name))
                            (primitive/code-list-push! forms `(export ~hidden))
                            (primitive/code-list-push!
                              forms
                              `(defn ~name [] (-> ~type)
                                 (do (~initializer) (~load-id (~accessor)))))
                            (primitive/code-list-push!
                              forms
                              `(defn ~hidden [] (-> (ptr ~type))
                                 (do (~initializer) (~accessor))))
                            0)))
                  :else 0)
            (store! i (+ (load i) 1)))))
    0))

(defn emit-start! [(context Code) (forms CodeBuilder) (payload (slice u8))
                   (names Code) (indices (al/ArrayList i64))
                   (types (al/ArrayList wasm/FuncType)) (memory Code) (table Code)
                   (function-import-checks Code)]
                  (-> i64)
  (let [initializer (primitive/datum->syntax context "__coil_wasm_instantiate")
        memory-initializer (if (= (primitive/code-count memory) 0)
                               `0
                               `(~(primitive/code-nth memory 1)))
        table-initializer (if (= (primitive/code-count table) 0)
                              `0
                              `(~(primitive/code-nth table 1)))]
    (if (= (slice-len payload) 0)
        (do
          (primitive/code-list-push! forms `(export ~initializer))
          (primitive/code-list-push!
            forms `(defn ~initializer [] (-> void)
                     (do ~@function-import-checks
                         ~memory-initializer ~table-initializer (do))))
          0)
        (match (wasm/start-section payload)
        (wasm/DecodeError [_ message] (primitive/error message))
        (wasm/Decoded [function-index]
          (if (>= function-index (primitive/code-count names))
              (primitive/error "WebAssembly validation: start function index out of bounds")
              (let [type-index (al/al-get indices function-index)]
                (if (>= type-index (al/al-len types))
                    (primitive/error "WebAssembly validation: start function type index out of bounds")
                    (let [signature (al/al-get types type-index)]
                      (if (or (!= (al/al-len (.params signature)) 0)
                              (!= (al/al-len (.results signature)) 0))
                          (primitive/error "WebAssembly validation: start function must have type [] -> []")
                          (let [initialized (primitive/fresh-identifier
                                              "wasm-start-initialized")
                                alloc-static-id
                                  (primitive/datum->syntax context "primitive/alloc-static")
                                load-id (primitive/datum->syntax context "load")
                                store-id (primitive/datum->syntax context "store!")]
                            (primitive/code-list-push! forms `(export ~initializer))
                            (primitive/code-list-push!
                              forms
                              `(defn ~initializer [] (-> void)
                                 (let [~initialized (~alloc-static-id i32)]
                                   (if (= (~load-id ~initialized) 0)
                                       (do
                                         (~store-id ~initialized 1)
                                         ~@function-import-checks
                                         ~memory-initializer
                                         ~table-initializer
                                         (~(primitive/code-nth names function-index)))
                                       0))))
                            0)))))))))))

(defn decoded-types [(a (dyn alloc/Allocator)) (_context Code) (payload (slice u8))]
                    (-> (al/ArrayList wasm/FuncType))
  (if (= (slice-len payload) 0)
      (al/al-new [wasm/FuncType] a)
      (match (wasm/type-section a payload)
        (wasm/DecodeError [_ message] (primitive/error message))
        (wasm/Decoded [values] values))))

(defn decoded-indices [(a (dyn alloc/Allocator)) (_context Code) (payload (slice u8))]
                      (-> (al/ArrayList i64))
  (if (= (slice-len payload) 0)
      (al/al-new [i64] a)
      (match (wasm/index-section a payload)
        (wasm/DecodeError [_ message] (primitive/error message))
        (wasm/Decoded [values] values))))

(defn decoded-bodies [(a (dyn alloc/Allocator)) (_context Code) (payload (slice u8))]
                     (-> (al/ArrayList wasm/FuncBody))
  (if (= (slice-len payload) 0)
      (al/al-new [wasm/FuncBody] a)
      (match (wasm/code-section a payload)
        (wasm/DecodeError [_ message] (primitive/error message))
        (wasm/Decoded [values] values))))

(defn decoded-imports [(a (dyn alloc/Allocator)) (_context Code) (payload (slice u8))]
                      (-> (al/ArrayList wasm/Import))
  (if (= (slice-len payload) 0)
      (al/al-new [wasm/Import] a)
      (match (wasm/import-section a payload)
        (wasm/DecodeError [_ message] (primitive/error message))
        (wasm/Decoded [values] values))))

(defn validate-imported-memory-count! [(a (dyn alloc/Allocator)) (_context Code)
                                       (imports (al/ArrayList wasm/Import))
                                       (memory-payload (slice u8))] (-> i64)
  (let [(mut imported) 0
        (mut i) 0]
    (loop
      (if (>= (load i) (al/al-len imports))
          (break)
          (let [entry (al/al-get imports (load i))]
            (if (= (.kind entry) 2)
                (store! imported (+ (load imported) 1))
                0)
            (store! i (+ (load i) 1)))))
    (if (> (load imported) 1)
        (primitive/error "WebAssembly validation: MVP module has multiple memories")
        0)
    (if (and (= (load imported) 1) (!= (slice-len memory-payload) 0))
        (match (wasm/memory-section a memory-payload)
          (wasm/DecodeError [_ message] (primitive/error message))
          (wasm/Decoded [memories]
            (if (> (al/al-len memories) 0)
                (primitive/error "WebAssembly validation: MVP module has multiple memories")
                0)))
        0)
    0))

(defn validate-imported-table-count! [(a (dyn alloc/Allocator)) (_context Code)
                                      (imports (al/ArrayList wasm/Import))
                                      (table-payload (slice u8))] (-> i64)
  (let [(mut imported) 0
        (mut i) 0]
    (loop
      (if (>= (load i) (al/al-len imports))
          (break)
          (let [entry (al/al-get imports (load i))]
            (if (= (.kind entry) 1)
                (store! imported (+ (load imported) 1))
                0)
            (store! i (+ (load i) 1)))))
    (if (> (load imported) 1)
        (primitive/error "WebAssembly validation: MVP module has multiple tables")
        0)
    (if (and (= (load imported) 1) (!= (slice-len table-payload) 0))
        (match (wasm/table-section a table-payload)
          (wasm/DecodeError [_ message] (primitive/error message))
          (wasm/Decoded [tables]
            (if (> (al/al-len tables) 0)
                (primitive/error "WebAssembly validation: MVP module has multiple tables")
                0)))
        0)
    0))

(defn emit-function-imports! [(context Code) (forms CodeBuilder)
                              (imports (al/ArrayList wasm/Import))
                              (types (al/ArrayList wasm/FuncType))
                              (names CodeBuilder) (checks CodeBuilder)
                              (indices (mut (al/ArrayList i64)))]
                             (-> i64)
  (let [(mut i) 0]
    (loop
      (if (>= (load i) (al/al-len imports))
          (break)
          (let [entry (al/al-get imports (load i))]
            (if (and (and (!= (.kind entry) 0) (!= (.kind entry) 1))
                     (and (!= (.kind entry) 2) (!= (.kind entry) 3)))
                (primitive/error "WebAssembly codegen: non-function imports are not implemented yet")
                (if (or (= (.kind entry) 1)
                        (or (= (.kind entry) 2) (= (.kind entry) 3)))
                    0
                    (if (>= (.type-index entry) (al/al-len types))
                    (primitive/error "WebAssembly validation: imported function type index out of bounds")
                    (let [alias (primitive/datum->syntax
                                  context
                                  (primitive/code-symbol "wasm-import-" (load i)))
                          module-path (wasm-import-module-path entry)
                          item-name (mapped-export-name (.item-name entry))
                          callee (primitive/datum->syntax
                                   context
                                   (primitive/code-symbol alias "/" item-name))
                          signature (al/al-get types (.type-index entry))
                          hidden (primitive/datum->syntax
                                   context
                                   (primitive/code-symbol
                                     alias "/__wasm_function_type_"
                                     (mapped-export-name (.item-name entry))))
                          type-state (primitive/fresh-identifier "wasm-import-function-type")
                          check-length-id (primitive/datum->syntax
                                            context "wasmrt/function-type-check-length")
                          check-byte-id (primitive/datum->syntax
                                          context "wasmrt/function-type-check-byte")
                          checks-builder (primitive/code-list-new)
                          (mut parameter-index) 0]
                      (primitive/code-list-push! forms `(import ~module-path :as ~alias))
                      (primitive/code-list-push!
                        checks-builder
                        `(~check-length-id ~type-state
                           ~(+ 1 (al/al-len (.params signature)))))
                      (primitive/code-list-push!
                        checks-builder
                        `(~check-byte-id ~type-state 0
                           ~(if (= (al/al-len (.results signature)) 0)
                                0
                                (kind-tag (al/al-get (.results signature) 0)))))
                      (loop
                        (if (>= (load parameter-index)
                                (al/al-len (.params signature)))
                            (break)
                            (do
                              (primitive/code-list-push!
                                checks-builder
                                `(~check-byte-id ~type-state
                                   ~(+ 1 (load parameter-index))
                                   ~(kind-tag
                                      (al/al-get (.params signature)
                                                 (load parameter-index)))))
                              (store! parameter-index (+ (load parameter-index) 1)))))
                      (let [type-checks (primitive/code-list-done checks-builder)]
                        (primitive/code-list-push!
                          checks `(let [~type-state (~hidden)] ~@type-checks 0)))
                      (primitive/code-list-push! names callee)
                      (al/al-push! [i64] (mut indices) (.type-index entry))))))
            (store! i (+ (load i) 1)))))
    0))

(defn compile-defined-functions [(a (dyn alloc/Allocator)) (context Code)
                                 (sections wasm/Sections)] (-> Code)
  (let [s sections
        forms (primitive/code-list-new)
        types (decoded-types a context (.types s))
        defined-indices (decoded-indices a context (.functions s))
        bodies (decoded-bodies a context (.codes s))
        imports (decoded-imports a context (.imports s))
        globals (compile-globals a context (.globals s) imports forms)
        memory (compile-memory a context (.memories s) (.data s) imports globals forms)
        imported-names (primitive/code-list-new)
        function-import-checks-builder (primitive/code-list-new)
        (mut indices) (al/al-new [i64] a)
        (mut i) 0]
    (if (!= (al/al-len defined-indices) (al/al-len bodies))
        (primitive/error "WebAssembly validation: function/code count mismatch")
        0)
    (validate-imported-memory-count! a context imports (.memories s))
    (validate-imported-table-count! a context imports (.tables s))
    (emit-function-imports! context forms imports types imported-names
                            function-import-checks-builder (mut indices))
    (let [imports-code (primitive/code-list-done imported-names)
          function-import-checks
            (primitive/code-list-done function-import-checks-builder)
          names-builder (primitive/code-list-new)
          (mut j) 0]
      (loop
        (if (>= (load j) (primitive/code-count imports-code))
            (break)
            (do
              (primitive/code-list-push!
                names-builder (primitive/code-nth imports-code (load j)))
              (store! j (+ (load j) 1)))))
      (loop
        (if (>= (load i) (al/al-len defined-indices))
            (break)
            (do
              (primitive/code-list-push!
                names-builder (primitive/fresh-identifier "wasm-function"))
              (al/al-push! [i64] (mut indices) (al/al-get defined-indices (load i)))
              (store! i (+ (load i) 1)))))
      (let [names (primitive/code-list-done names-builder)
            imported-count (primitive/code-count imports-code)
            table (table-code a context (.tables s) (.elements s) imports forms
                              names (load indices) types globals)]
        (store! i 0)
        (loop
          (if (>= (load i) (al/al-len defined-indices))
              (break)
              (let [type-index (al/al-get defined-indices (load i))]
                (if (>= type-index (al/al-len types))
                    (primitive/error "WebAssembly validation: type index out of bounds")
                    (primitive/code-list-push!
                      forms
                      (function-form a context
                                     (primitive/code-nth names (+ imported-count (load i)))
                                     (al/al-get types type-index)
                                     (al/al-get bodies (load i))
                                     globals memory table names (load indices) types)))
                (store! i (+ (load i) 1)))))
        (emit-start! context forms (.start s) names (load indices) types memory table
                     function-import-checks)
        (if (= (slice-len (.exports s)) 0)
            0
            (match (wasm/export-section a (.exports s))
              (wasm/DecodeError [_ message] (primitive/error message))
              (wasm/Decoded [exports]
                (emit-export-wrappers! context forms names globals memory table
                                       (load indices) types exports))))
        (primitive/code-list-done forms)))))
