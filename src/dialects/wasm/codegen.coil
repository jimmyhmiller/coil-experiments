(module experiments.wasm.codegen)

(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "coil.slice" :use [slice-len])
(import "experiments.wasm.decoder" :as wasm)

(defn kind-tag [(kind wasm/ValType)] (-> i64)
  (match kind
    (wasm/I32 [] 1)
    (wasm/I64 [] 2)
    (wasm/F32 [] 3)
    (wasm/F64 [] 4)))

(defn type-code [(context Code) (kind wasm/ValType)] (-> Code)
  (match kind
    (wasm/I32 [] `i32)
    (wasm/I64 [] `i64)
    (wasm/F32 [] `f32)
    (wasm/F64 [] `f64)))

;; Compile-time operand stacks are persistent Code triples `(tag expr tail)`.
;; Code has no runtime layout, so it must not be put in an ordinary struct or
;; ArrayList element.
(defn pop-node! [(stack (mut Code))] (-> Code)
  (if (!= (primitive/code-count (load stack)) 3)
      (primitive/error "WebAssembly validation: operand stack underflow")
      (let [node (load stack)]
        (store! stack (primitive/code-nth node 2))
        node)))

(defn push-node! [(stack (mut Code)) (kind wasm/ValType) (expression Code)] (-> i64)
  (do (store! stack `(~(kind-tag kind) ~expression ~(load stack))) 0))

(defn node-kind [(node Code)] (-> i64)
  (if (primitive/code-list? node)
      (primitive/code-int (primitive/code-nth node 0))
      (primitive/error "WebAssembly codegen internal error: operand node is not a list")))

(defn node-expression [(node Code)] (-> Code)
  (primitive/code-nth node 1))

;; MVP block types are either empty (0x40) or a single value type. Type-index
;; block signatures belong to the later multi-value extension and are rejected.
(defn parse-block-tag! [(context Code) (p (mut wasm/Parser))] (-> i64)
  (let [raw (wasm/parser-byte! (mut p))]
    (cond (= raw 0x40) 0
          (= raw 0x7f) 1
          (= raw 0x7e) 2
          (= raw 0x7d) 3
          (= raw 0x7c) 4
          :else (primitive/error "WebAssembly validation: invalid MVP block type"))))

(defn finish-region [(a (dyn alloc/Allocator)) (base Code) (stack (mut Code)) (forms CodeBuilder)
                     (result-tag i64)] (-> Code)
  (let [body-forms (primitive/code-list-done forms)]
    (if (= result-tag 0)
        (if (primitive/code-eq base (load stack))
            `(do ~@body-forms)
            (primitive/error "WebAssembly validation: void block changes stack height"))
        (let [value (pop-node! (mut stack))]
          (if (or (!= (node-kind value) result-tag)
                  (not (primitive/code-eq base (load stack))))
              (primitive/error "WebAssembly validation: block result type mismatch")
              `(do ~@body-forms ~(primitive/code-nth value 1)))))))

(defn integer-binop! [(stack (mut Code)) (kind wasm/ValType) (operator Code)]
                      (-> i64)
  (let [right (pop-node! (mut stack))
        left (pop-node! (mut stack))
        right-expression (primitive/code-nth right 1)
        left-expression (primitive/code-nth left 1)]
    (if (or (!= (node-kind right) (kind-tag kind))
            (!= (node-kind left) (kind-tag kind)))
        (primitive/error "WebAssembly validation: integer operator type mismatch")
        (push-node! (mut stack) kind
                    `(~operator ~left-expression ~right-expression)))))

(defn runtime-unary! [(context Code) (stack (mut Code))
                      (input wasm/ValType) (result wasm/ValType)
                      (name (slice u8))] (-> i64)
  (let [value (pop-node! (mut stack))]
    (if (!= (node-kind value) (kind-tag input))
        (primitive/error "WebAssembly validation: unary operator type mismatch")
        (let [callee (primitive/datum->syntax context name)
              expression (primitive/code-nth value 1)]
          (push-node! (mut stack) result `(~callee ~expression))))))

(defn runtime-binary! [(context Code) (stack (mut Code))
                       (input wasm/ValType) (result wasm/ValType)
                       (name (slice u8))] (-> i64)
  (let [right (pop-node! (mut stack))
        left (pop-node! (mut stack))]
    (if (or (!= (node-kind right) (kind-tag input))
            (!= (node-kind left) (kind-tag input)))
        (primitive/error "WebAssembly validation: binary operator type mismatch")
        (let [callee (primitive/datum->syntax context name)
              l (primitive/code-nth left 1)
              r (primitive/code-nth right 1)]
          (push-node! (mut stack) result `(~callee ~l ~r))))))

(defn compile-region! [(a (dyn alloc/Allocator)) (context Code)
                       (p (mut wasm/Parser)) (stack (mut Code))
                       (forms-builder CodeBuilder) (allow-else bool)
                       (region-base Code) (region-result-tag i64)
                       (locals Code) (function-names Code)
                       (function-indices (al/ArrayList i64))
                       (types (al/ArrayList wasm/FuncType))] (-> i64)
  (let [(mut ended) false
        (mut stop-opcode) 0]
    (loop
      (if (or (.failed p) (load ended))
          (break)
          (let [opcode (wasm/parser-byte! (mut p))]
            (cond (= opcode 0x0b)
                    (do (store! stop-opcode opcode) (store! ended true))
                  (= opcode 0x05)
                    (if allow-else
                        (do (store! stop-opcode opcode) (store! ended true))
                        (primitive/error "WebAssembly validation: else outside if"))
                  (= opcode 0x02)
                    (let [result-tag (parse-block-tag! context (mut p))
                          base (load stack)
                          (mut block-stack) base
                          block-forms (primitive/code-list-new)
                          block-stop (compile-region! a context (mut p) (mut block-stack)
                                                      block-forms false base result-tag
                                                      locals function-names
                                                      function-indices types)]
                      (if (!= block-stop 0x0b)
                          (primitive/error "WebAssembly validation: malformed block")
                          (let [expression
                                  (finish-region a base (mut block-stack)
                                                 block-forms result-tag)]
                            (if (= result-tag 0)
                                (do (primitive/code-list-push! forms-builder expression) 0)
                                (cond (= result-tag 1)
                                        (push-node! (mut stack) (wasm/I32) expression)
                                      (= result-tag 2)
                                        (push-node! (mut stack) (wasm/I64) expression)
                                      (= result-tag 3)
                                        (push-node! (mut stack) (wasm/F32) expression)
                                      (= result-tag 4)
                                        (push-node! (mut stack) (wasm/F64) expression)
                                      :else
                                        (primitive/error "WebAssembly codegen internal error: invalid block result"))))))
                  (= opcode 0x04)
                    (let [result-tag (parse-block-tag! context (mut p))
                          condition (pop-node! (mut stack))]
                      (if (!= (node-kind condition) 1)
                          (primitive/error "WebAssembly validation: if condition must be i32")
                          (let [base (load stack)
                                (mut then-stack) base
                                then-forms (primitive/code-list-new)
                                then-stop (compile-region! a context (mut p) (mut then-stack)
                                                           then-forms true base result-tag
                                                           locals function-names
                                                           function-indices types)
                                then-code (finish-region a base (mut then-stack) then-forms result-tag)
                                (mut else-stack) base
                                else-forms (primitive/code-list-new)
                                else-code (if (= then-stop 0x05)
                                              (let [else-stop
                                                      (compile-region! a context (mut p)
                                                                       (mut else-stack) else-forms
                                                                       false base result-tag
                                                                       locals function-names
                                                                       function-indices types)]
                                                (if (!= else-stop 0x0b)
                                                    (primitive/error "WebAssembly validation: malformed if")
                                                    (finish-region a base (mut else-stack)
                                                                   else-forms result-tag)))
                                              (if (= result-tag 0)
                                                  `(do)
                                                  (primitive/error "WebAssembly validation: result if requires else")))
                                if-id (primitive/datum->syntax context "if")
                                ne-id (primitive/datum->syntax context "primitive/icmp-ne")
                                c (primitive/code-nth condition 1)
                                expression `(~if-id (~ne-id ~c 0) ~then-code ~else-code)]
                            (if (= result-tag 0)
                                (do (primitive/code-list-push! forms-builder expression) 0)
                                (cond (= result-tag 1)
                                        (push-node! (mut stack) (wasm/I32) expression)
                                      (= result-tag 2)
                                        (push-node! (mut stack) (wasm/I64) expression)
                                      (= result-tag 3)
                                        (push-node! (mut stack) (wasm/F32) expression)
                                      (= result-tag 4)
                                        (push-node! (mut stack) (wasm/F64) expression)
                                      :else
                                        (primitive/error "WebAssembly codegen internal error: invalid block result"))))))
                  (= opcode 0x0d)
                    (let [depth (wasm/parser-u32! (mut p))
                          condition (pop-node! (mut stack))]
                      (if (!= depth 0)
                          (primitive/error "WebAssembly codegen: outer br_if is not implemented yet")
                          (if (!= (node-kind condition) 1)
                              (primitive/error "WebAssembly validation: br_if condition must be i32")
                              (let [(mut taken-stack) (load stack)
                                    taken-forms (primitive/code-list-new)
                                    taken-code (finish-region a region-base (mut taken-stack)
                                                              taken-forms region-result-tag)
                                    (mut continue-stack) (load stack)
                                    continue-forms (primitive/code-list-new)
                                    continue-stop
                                      (compile-region! a context (mut p) (mut continue-stack)
                                                       continue-forms false region-base
                                                       region-result-tag locals function-names
                                                       function-indices types)
                                    continue-code
                                      (if (!= continue-stop 0x0b)
                                          (primitive/error "WebAssembly validation: malformed br_if region")
                                          (finish-region a region-base (mut continue-stack)
                                                         continue-forms region-result-tag))
                                    if-id (primitive/datum->syntax context "if")
                                    ne-id (primitive/datum->syntax context "primitive/icmp-ne")
                                    c (primitive/code-nth condition 1)
                                    expression `(~if-id (~ne-id ~c 0) ~taken-code ~continue-code)]
                                (store! stack region-base)
                                (if (= region-result-tag 0)
                                    (do (primitive/code-list-push! forms-builder expression) 0)
                                    (cond (= region-result-tag 1)
                                            (push-node! (mut stack) (wasm/I32) expression)
                                          (= region-result-tag 2)
                                            (push-node! (mut stack) (wasm/I64) expression)
                                          (= region-result-tag 3)
                                            (push-node! (mut stack) (wasm/F32) expression)
                                          (= region-result-tag 4)
                                            (push-node! (mut stack) (wasm/F64) expression)
                                          :else
                                            (primitive/error "WebAssembly codegen internal error: invalid branch result")))
                                (store! stop-opcode 0x0b)
                                (store! ended true)))))
                  (= opcode 0x0c)
                    (let [depth (wasm/parser-u32! (mut p))]
                      (if (!= depth 0)
                          (primitive/error "WebAssembly codegen: outer br is not implemented yet")
                          (let [(mut branch-stack) (load stack)
                                branch-forms (primitive/code-list-new)
                                expression (finish-region a region-base (mut branch-stack)
                                                          branch-forms region-result-tag)
                                next (wasm/parser-byte! (mut p))]
                            (if (!= next 0x0b)
                                (primitive/error "WebAssembly codegen: non-terminal br is not implemented yet")
                                (do
                                  (store! stack region-base)
                                  (if (= region-result-tag 0)
                                      (do (primitive/code-list-push! forms-builder expression) 0)
                                      (cond (= region-result-tag 1)
                                              (push-node! (mut stack) (wasm/I32) expression)
                                            (= region-result-tag 2)
                                              (push-node! (mut stack) (wasm/I64) expression)
                                            (= region-result-tag 3)
                                              (push-node! (mut stack) (wasm/F32) expression)
                                            (= region-result-tag 4)
                                              (push-node! (mut stack) (wasm/F64) expression)
                                            :else
                                              (primitive/error "WebAssembly codegen internal error: invalid branch result")))
                                  (store! stop-opcode 0x0b)
                                  (store! ended true))))))
                  (= opcode 0x0e)
                    (let [count (wasm/parser-u32! (mut p))
                          (mut i) 0]
                      (loop
                        (if (> (load i) count)
                            (break)
                            (let [depth (wasm/parser-u32! (mut p))]
                              (if (!= depth 0)
                                  (primitive/error "WebAssembly codegen: outer br_table is not implemented yet")
                                  (store! i (+ (load i) 1))))))
                      (let [selector (pop-node! (mut stack))]
                        (if (!= (node-kind selector) 1)
                            (primitive/error "WebAssembly validation: br_table selector must be i32")
                            (let [(mut branch-stack) (load stack)
                                  branch-forms (primitive/code-list-new)
                                  value (finish-region a region-base (mut branch-stack)
                                                       branch-forms region-result-tag)
                                  selector-expression (primitive/code-nth selector 1)
                                  expression `(do ~selector-expression ~value)
                                  next (wasm/parser-byte! (mut p))]
                              (if (!= next 0x0b)
                                  (primitive/error "WebAssembly codegen: non-terminal br_table is not implemented yet")
                                  (do
                                    (store! stack region-base)
                                    (if (= region-result-tag 0)
                                        (do (primitive/code-list-push! forms-builder expression) 0)
                                        (cond (= region-result-tag 1)
                                                (push-node! (mut stack) (wasm/I32) expression)
                                              (= region-result-tag 2)
                                                (push-node! (mut stack) (wasm/I64) expression)
                                              (= region-result-tag 3)
                                                (push-node! (mut stack) (wasm/F32) expression)
                                              (= region-result-tag 4)
                                                (push-node! (mut stack) (wasm/F64) expression)
                                              :else
                                                (primitive/error "WebAssembly codegen internal error: invalid branch-table result")))
                                    (store! stop-opcode 0x0b)
                                    (store! ended true)))))))
                  (= opcode 0x20)
                    (let [index (wasm/parser-u32! (mut p))]
                      (if (>= index (primitive/code-count locals))
                          (primitive/error "WebAssembly validation: local index out of bounds")
                          (let [local (primitive/code-nth locals index)]
                            (if (not (primitive/code-list? local))
                                (primitive/error "WebAssembly codegen internal error: local entry is not a list")
                                (do
                                  (let [tag (primitive/code-int (primitive/code-nth local 0))
                                        cell (primitive/code-nth local 1)
                                        load-id (primitive/datum->syntax context "load")]
                                    (store! stack `(~tag (~load-id ~cell) ~(load stack))))
                                  0)))))
                  (or (= opcode 0x21) (= opcode 0x22))
                    (let [index (wasm/parser-u32! (mut p))]
                      (if (>= index (primitive/code-count locals))
                          (primitive/error "WebAssembly validation: local index out of bounds")
                          (let [local (primitive/code-nth locals index)
                                value (pop-node! (mut stack))
                                tag (primitive/code-int (primitive/code-nth local 0))
                                cell (primitive/code-nth local 1)]
                            (if (!= (node-kind value) tag)
                                (primitive/error "WebAssembly validation: local.set type mismatch")
                                (let [store-id (primitive/datum->syntax context "store!")
                                      expression (primitive/code-nth value 1)]
                                  (primitive/code-list-push! forms-builder
                                                             `(~store-id ~cell ~expression))
                                  (if (= opcode 0x22)
                                      (let [load-id (primitive/datum->syntax context "load")]
                                        (store! stack `(~tag (~load-id ~cell) ~(load stack)))
                                        0)
                                      0))))))
                  (= opcode 0x10)
                    (let [index (wasm/parser-u32! (mut p))]
                      (if (>= index (primitive/code-count function-names))
                          (primitive/error "WebAssembly validation: call index out of bounds")
                          (let [type-index (al/al-get function-indices index)
                                callee-type (al/al-get types type-index)
                                callee (primitive/code-nth function-names index)
                                reversed-builder (primitive/code-list-new)
                                (mut argument-index) (al/al-len (.params callee-type))]
                            (loop
                              (if (= (load argument-index) 0)
                                  (break)
                                  (do
                                    (store! argument-index (- (load argument-index) 1))
                                    (let [argument (pop-node! (mut stack))
                                          wanted (al/al-get (.params callee-type)
                                                            (load argument-index))]
                                      (if (!= (node-kind argument) (kind-tag wanted))
                                          (primitive/error "WebAssembly validation: call argument type mismatch")
                                          (primitive/code-list-push!
                                            reversed-builder
                                            (primitive/code-nth argument 1)))))))
                            (let [reversed (primitive/code-list-done reversed-builder)
                                  arguments-builder (primitive/code-list-new)
                                  (mut j) (primitive/code-count reversed)]
                              (loop
                                (if (= (load j) 0)
                                    (break)
                                    (do
                                      (store! j (- (load j) 1))
                                      (primitive/code-list-push!
                                        arguments-builder
                                        (primitive/code-nth reversed (load j))))))
                              (let [arguments (primitive/code-list-done arguments-builder)
                                    result-count (al/al-len (.results callee-type))
                                    call `(~callee ~@arguments)]
                                (if (= result-count 0)
                                    (do (primitive/code-list-push! forms-builder call) 0)
                                    (push-node! (mut stack)
                                                (al/al-get (.results callee-type) 0)
                                                call)))))))
                  (= opcode 0x01)
                    0
                  (= opcode 0x1a)
                    (let [dropped (pop-node! (mut stack))]
                      (primitive/code-list-push! forms-builder
                                                 (primitive/code-nth dropped 1))
                      0)
                  (= opcode 0x1b)
                    (let [condition (pop-node! (mut stack))
                          right (pop-node! (mut stack))
                          left (pop-node! (mut stack))]
                      (if (or (!= (node-kind condition) 1)
                              (!= (node-kind left) (node-kind right)))
                          (primitive/error "WebAssembly validation: select type mismatch")
                          (let [if-id (primitive/datum->syntax context "if")
                                ne-id (primitive/datum->syntax context "primitive/icmp-ne")
                                zero `0
                                c (primitive/code-nth condition 1)
                                l (primitive/code-nth left 1)
                                r (primitive/code-nth right 1)
                                tag (node-kind left)]
                            (store! stack
                                    `(~tag (~if-id (~ne-id ~c ~zero) ~l ~r) ~(load stack)))
                            0)))
                  (= opcode 0x41)
                    (let [value (wasm/parser-signed! (mut p) 32)]
                      (let [literal `~value
                            cast-id (primitive/datum->syntax context "primitive/cast")
                            i32-id `i32]
                        (push-node! (mut stack) (wasm/I32)
                                    `(~cast-id ~i32-id ~literal))))
                  (= opcode 0x42)
                    (let [value (wasm/parser-signed! (mut p) 64)]
                      (push-node! (mut stack) (wasm/I64) `~value))
                  (= opcode 0x43)
                    (let [bits (wasm/parser-fixed-bits! (mut p) 4)
                          literal `~bits
                          cast-id (primitive/datum->syntax context "primitive/cast")
                          callee (primitive/datum->syntax context "wasmrt/f32-from-bits")]
                      (push-node! (mut stack) (wasm/F32)
                                  `(~callee (~cast-id i32 ~literal))))
                  (= opcode 0x44)
                    (let [bits (wasm/parser-fixed-bits! (mut p) 8)
                          literal `~bits
                          callee (primitive/datum->syntax context "wasmrt/f64-from-bits")]
                      (push-node! (mut stack) (wasm/F64) `(~callee ~literal)))
                  (= opcode 0x45)
                    (runtime-unary! context (mut stack) (wasm/I32) (wasm/I32)
                                    "wasmrt/i32-eqz")
                  (= opcode 0x46)
                    (runtime-binary! context (mut stack) (wasm/I32) (wasm/I32)
                                     "wasmrt/i32-eq")
                  (= opcode 0x47)
                    (runtime-binary! context (mut stack) (wasm/I32) (wasm/I32)
                                     "wasmrt/i32-ne")
                  (= opcode 0x48)
                    (runtime-binary! context (mut stack) (wasm/I32) (wasm/I32)
                                     "wasmrt/i32-lt-s")
                  (= opcode 0x49)
                    (runtime-binary! context (mut stack) (wasm/I32) (wasm/I32)
                                     "wasmrt/i32-lt-u")
                  (= opcode 0x4a)
                    (runtime-binary! context (mut stack) (wasm/I32) (wasm/I32)
                                     "wasmrt/i32-gt-s")
                  (= opcode 0x4b)
                    (runtime-binary! context (mut stack) (wasm/I32) (wasm/I32)
                                     "wasmrt/i32-gt-u")
                  (= opcode 0x4c)
                    (runtime-binary! context (mut stack) (wasm/I32) (wasm/I32)
                                     "wasmrt/i32-le-s")
                  (= opcode 0x4d)
                    (runtime-binary! context (mut stack) (wasm/I32) (wasm/I32)
                                     "wasmrt/i32-le-u")
                  (= opcode 0x4e)
                    (runtime-binary! context (mut stack) (wasm/I32) (wasm/I32)
                                     "wasmrt/i32-ge-s")
                  (= opcode 0x4f)
                    (runtime-binary! context (mut stack) (wasm/I32) (wasm/I32)
                                     "wasmrt/i32-ge-u")
                  (= opcode 0x50)
                    (runtime-unary! context (mut stack) (wasm/I64) (wasm/I32)
                                    "wasmrt/i64-eqz")
                  (= opcode 0x51)
                    (runtime-binary! context (mut stack) (wasm/I64) (wasm/I32)
                                     "wasmrt/i64-eq")
                  (= opcode 0x52)
                    (runtime-binary! context (mut stack) (wasm/I64) (wasm/I32)
                                     "wasmrt/i64-ne")
                  (= opcode 0x53)
                    (runtime-binary! context (mut stack) (wasm/I64) (wasm/I32)
                                     "wasmrt/i64-lt-s")
                  (= opcode 0x54)
                    (runtime-binary! context (mut stack) (wasm/I64) (wasm/I32)
                                     "wasmrt/i64-lt-u")
                  (= opcode 0x55)
                    (runtime-binary! context (mut stack) (wasm/I64) (wasm/I32)
                                     "wasmrt/i64-gt-s")
                  (= opcode 0x56)
                    (runtime-binary! context (mut stack) (wasm/I64) (wasm/I32)
                                     "wasmrt/i64-gt-u")
                  (= opcode 0x57)
                    (runtime-binary! context (mut stack) (wasm/I64) (wasm/I32)
                                     "wasmrt/i64-le-s")
                  (= opcode 0x58)
                    (runtime-binary! context (mut stack) (wasm/I64) (wasm/I32)
                                     "wasmrt/i64-le-u")
                  (= opcode 0x59)
                    (runtime-binary! context (mut stack) (wasm/I64) (wasm/I32)
                                     "wasmrt/i64-ge-s")
                  (= opcode 0x5a)
                    (runtime-binary! context (mut stack) (wasm/I64) (wasm/I32)
                                     "wasmrt/i64-ge-u")
                  (= opcode 0x5b)
                    (runtime-binary! context (mut stack) (wasm/F32) (wasm/I32) "wasmrt/f32-eq")
                  (= opcode 0x5c)
                    (runtime-binary! context (mut stack) (wasm/F32) (wasm/I32) "wasmrt/f32-ne")
                  (= opcode 0x5d)
                    (runtime-binary! context (mut stack) (wasm/F32) (wasm/I32) "wasmrt/f32-lt")
                  (= opcode 0x5e)
                    (runtime-binary! context (mut stack) (wasm/F32) (wasm/I32) "wasmrt/f32-gt")
                  (= opcode 0x5f)
                    (runtime-binary! context (mut stack) (wasm/F32) (wasm/I32) "wasmrt/f32-le")
                  (= opcode 0x60)
                    (runtime-binary! context (mut stack) (wasm/F32) (wasm/I32) "wasmrt/f32-ge")
                  (= opcode 0x61)
                    (runtime-binary! context (mut stack) (wasm/F64) (wasm/I32) "wasmrt/f64-eq")
                  (= opcode 0x62)
                    (runtime-binary! context (mut stack) (wasm/F64) (wasm/I32) "wasmrt/f64-ne")
                  (= opcode 0x63)
                    (runtime-binary! context (mut stack) (wasm/F64) (wasm/I32) "wasmrt/f64-lt")
                  (= opcode 0x64)
                    (runtime-binary! context (mut stack) (wasm/F64) (wasm/I32) "wasmrt/f64-gt")
                  (= opcode 0x65)
                    (runtime-binary! context (mut stack) (wasm/F64) (wasm/I32) "wasmrt/f64-le")
                  (= opcode 0x66)
                    (runtime-binary! context (mut stack) (wasm/F64) (wasm/I32) "wasmrt/f64-ge")
                  (= opcode 0x67)
                    (runtime-unary! context (mut stack) (wasm/I32) (wasm/I32)
                                    "wasmrt/i32-clz")
                  (= opcode 0x68)
                    (runtime-unary! context (mut stack) (wasm/I32) (wasm/I32)
                                    "wasmrt/i32-ctz")
                  (= opcode 0x69)
                    (runtime-unary! context (mut stack) (wasm/I32) (wasm/I32)
                                    "wasmrt/i32-popcnt")
                  (= opcode 0x6a)
                    (integer-binop! (mut stack) (wasm/I32)
                                    (primitive/datum->syntax context "primitive/iadd"))
                  (= opcode 0x6b)
                    (integer-binop! (mut stack) (wasm/I32)
                                    (primitive/datum->syntax context "primitive/isub"))
                  (= opcode 0x6c)
                    (integer-binop! (mut stack) (wasm/I32)
                                    (primitive/datum->syntax context "primitive/imul"))
                  (= opcode 0x6d)
                    (runtime-binary! context (mut stack) (wasm/I32) (wasm/I32)
                                     "wasmrt/i32-div-s")
                  (= opcode 0x6e)
                    (runtime-binary! context (mut stack) (wasm/I32) (wasm/I32)
                                     "wasmrt/i32-div-u")
                  (= opcode 0x6f)
                    (runtime-binary! context (mut stack) (wasm/I32) (wasm/I32)
                                     "wasmrt/i32-rem-s")
                  (= opcode 0x70)
                    (runtime-binary! context (mut stack) (wasm/I32) (wasm/I32)
                                     "wasmrt/i32-rem-u")
                  (= opcode 0x71)
                    (runtime-binary! context (mut stack) (wasm/I32) (wasm/I32)
                                     "wasmrt/i32-and")
                  (= opcode 0x72)
                    (runtime-binary! context (mut stack) (wasm/I32) (wasm/I32)
                                     "wasmrt/i32-or")
                  (= opcode 0x73)
                    (runtime-binary! context (mut stack) (wasm/I32) (wasm/I32)
                                     "wasmrt/i32-xor")
                  (= opcode 0x74)
                    (runtime-binary! context (mut stack) (wasm/I32) (wasm/I32)
                                     "wasmrt/i32-shl")
                  (= opcode 0x75)
                    (runtime-binary! context (mut stack) (wasm/I32) (wasm/I32)
                                     "wasmrt/i32-shr-s")
                  (= opcode 0x76)
                    (runtime-binary! context (mut stack) (wasm/I32) (wasm/I32)
                                     "wasmrt/i32-shr-u")
                  (= opcode 0x77)
                    (runtime-binary! context (mut stack) (wasm/I32) (wasm/I32)
                                     "wasmrt/i32-rotl")
                  (= opcode 0x78)
                    (runtime-binary! context (mut stack) (wasm/I32) (wasm/I32)
                                     "wasmrt/i32-rotr")
                  (= opcode 0x79)
                    (runtime-unary! context (mut stack) (wasm/I64) (wasm/I64)
                                    "wasmrt/i64-clz")
                  (= opcode 0x7a)
                    (runtime-unary! context (mut stack) (wasm/I64) (wasm/I64)
                                    "wasmrt/i64-ctz")
                  (= opcode 0x7b)
                    (runtime-unary! context (mut stack) (wasm/I64) (wasm/I64)
                                    "wasmrt/i64-popcnt")
                  (= opcode 0x7c)
                    (integer-binop! (mut stack) (wasm/I64)
                                    (primitive/datum->syntax context "primitive/iadd"))
                  (= opcode 0x7d)
                    (integer-binop! (mut stack) (wasm/I64)
                                    (primitive/datum->syntax context "primitive/isub"))
                  (= opcode 0x7e)
                    (integer-binop! (mut stack) (wasm/I64)
                                    (primitive/datum->syntax context "primitive/imul"))
                  (= opcode 0x7f)
                    (runtime-binary! context (mut stack) (wasm/I64) (wasm/I64)
                                     "wasmrt/i64-div-s")
                  (= opcode 0x80)
                    (runtime-binary! context (mut stack) (wasm/I64) (wasm/I64)
                                     "wasmrt/i64-div-u")
                  (= opcode 0x81)
                    (runtime-binary! context (mut stack) (wasm/I64) (wasm/I64)
                                     "wasmrt/i64-rem-s")
                  (= opcode 0x82)
                    (runtime-binary! context (mut stack) (wasm/I64) (wasm/I64)
                                     "wasmrt/i64-rem-u")
                  (= opcode 0x83)
                    (runtime-binary! context (mut stack) (wasm/I64) (wasm/I64)
                                     "wasmrt/i64-and")
                  (= opcode 0x84)
                    (runtime-binary! context (mut stack) (wasm/I64) (wasm/I64)
                                     "wasmrt/i64-or")
                  (= opcode 0x85)
                    (runtime-binary! context (mut stack) (wasm/I64) (wasm/I64)
                                     "wasmrt/i64-xor")
                  (= opcode 0x86)
                    (runtime-binary! context (mut stack) (wasm/I64) (wasm/I64)
                                     "wasmrt/i64-shl")
                  (= opcode 0x87)
                    (runtime-binary! context (mut stack) (wasm/I64) (wasm/I64)
                                     "wasmrt/i64-shr-s")
                  (= opcode 0x88)
                    (runtime-binary! context (mut stack) (wasm/I64) (wasm/I64)
                                     "wasmrt/i64-shr-u")
                  (= opcode 0x89)
                    (runtime-binary! context (mut stack) (wasm/I64) (wasm/I64)
                                     "wasmrt/i64-rotl")
                  (= opcode 0x8a)
                    (runtime-binary! context (mut stack) (wasm/I64) (wasm/I64)
                                     "wasmrt/i64-rotr")
                  (= opcode 0x92)
                    (runtime-binary! context (mut stack) (wasm/F32) (wasm/F32) "wasmrt/f32-add")
                  (= opcode 0x93)
                    (runtime-binary! context (mut stack) (wasm/F32) (wasm/F32) "wasmrt/f32-sub")
                  (= opcode 0x94)
                    (runtime-binary! context (mut stack) (wasm/F32) (wasm/F32) "wasmrt/f32-mul")
                  (= opcode 0x95)
                    (runtime-binary! context (mut stack) (wasm/F32) (wasm/F32) "wasmrt/f32-div")
                  (= opcode 0xa0)
                    (runtime-binary! context (mut stack) (wasm/F64) (wasm/F64) "wasmrt/f64-add")
                  (= opcode 0xa1)
                    (runtime-binary! context (mut stack) (wasm/F64) (wasm/F64) "wasmrt/f64-sub")
                  (= opcode 0xa2)
                    (runtime-binary! context (mut stack) (wasm/F64) (wasm/F64) "wasmrt/f64-mul")
                  (= opcode 0xa3)
                    (runtime-binary! context (mut stack) (wasm/F64) (wasm/F64) "wasmrt/f64-div")
                  :else
                    (primitive/error "WebAssembly codegen: unsupported MVP opcode")))))
    (if (.failed p) (primitive/error (.message p)) 0)
    (if (not (load ended))
        (primitive/error "WebAssembly expression lacks a final end opcode")
        (load stop-opcode))))

(defn compile-expression [(a (dyn alloc/Allocator)) (context Code)
                          (signature wasm/FuncType) (body wasm/FuncBody)
                          (locals Code) (function-names Code)
                          (function-indices (al/ArrayList i64))
                          (types (al/ArrayList wasm/FuncType))] (-> Code)
  (let [b body
        (mut p) (wasm/parser (.expression b))
        (mut stack) `()
        forms-builder (primitive/code-list-new)
        result-tag (if (= (al/al-len (.results signature)) 0)
                       0
                       (kind-tag (al/al-get (.results signature) 0)))
        stop (compile-region! a context (mut p) (mut stack) forms-builder false `() result-tag
                              locals function-names function-indices types)]
    (if (!= stop 0x0b)
        (primitive/error "WebAssembly function expression ended unexpectedly")
        0)
    (if (!= (wasm/remaining (.cursor p)) 0)
        (primitive/error "WebAssembly function has bytes after final end opcode")
        0)
    (let [sig signature
          result-count (al/al-len (.results sig))
          forms (primitive/code-list-done forms-builder)]
      (if (= result-count 0)
          (if (= (primitive/code-count (load stack)) 0)
              `(do ~@forms)
              (primitive/error "WebAssembly validation: void function leaves operands"))
          (let [value (pop-node! (mut stack))
                wanted (al/al-get (.results sig) 0)]
            (if (!= (primitive/code-count (load stack)) 0)
                (primitive/error "WebAssembly validation: result stack height mismatch")
                (if (!= (node-kind value) (kind-tag wanted))
                    (primitive/error "WebAssembly validation: function result type mismatch")
                    (let [result (primitive/code-nth value 1)]
                      `(do ~@forms ~result)))))))))

(defn function-form [(a (dyn alloc/Allocator)) (context Code) (name Code)
                     (signature wasm/FuncType) (body wasm/FuncBody)
                     (function-names Code) (function-indices (al/ArrayList i64))
                     (types (al/ArrayList wasm/FuncType))] (-> Code)
  (let [sig signature
        b body
        params (primitive/code-list-new)
        locals (primitive/code-list-new)
        bindings (primitive/code-list-new)
        (mut i) 0]
    (loop
      (if (>= (load i) (al/al-len (.params sig)))
          (break)
          (let [kind (al/al-get (.params sig) (load i))
                id (primitive/fresh-identifier "wasm-param")
                cell (primitive/fresh-identifier "wasm-local")]
            (primitive/code-list-push! params `(~id ~(type-code context kind)))
            (primitive/code-list-push! locals `(~(kind-tag kind) ~cell))
            (primitive/code-list-push! bindings `((mut ~cell) ~id))
            (store! i (+ (load i) 1)))))
    (store! i 0)
    (loop
      (if (>= (load i) (al/al-len (.locals b)))
          (break)
          (let [kind (al/al-get (.locals b) (load i))
                cell (primitive/fresh-identifier "wasm-local")
                cast-id (primitive/datum->syntax context "primitive/cast")
                type (type-code context kind)]
            (primitive/code-list-push! locals `(~(kind-tag kind) ~cell))
            (primitive/code-list-push! bindings
                                       `((mut ~cell) (~cast-id ~type 0)))
            (store! i (+ (load i) 1)))))
    (let [param-code (primitive/code-list-done params)
          local-code (primitive/code-list-done locals)
          binding-pairs (primitive/code-list-done bindings)
          binding-code (primitive/code-list-new)
          (mut j) 0]
      (loop
        (if (>= (load j) (primitive/code-count binding-pairs))
            (break)
            (let [pair (primitive/code-nth binding-pairs (load j))]
              (primitive/code-list-push! binding-code (primitive/code-nth pair 0))
              (primitive/code-list-push! binding-code (primitive/code-nth pair 1))
              (store! j (+ (load j) 1)))))
      (let [binding-vector (primitive/code-list-done binding-code)
            body-code (compile-expression a context sig b local-code
                                          function-names function-indices types)
            result-type (if (= (al/al-len (.results sig)) 0)
                            `void
                            (type-code context (al/al-get (.results sig) 0)))]
        `(defn ~name [~@param-code] (-> ~result-type)
           (let [~@binding-vector] ~body-code))))))

(defn export-wrapper-form [(context Code) (export-name (slice u8)) (callee Code)
                           (signature wasm/FuncType)] (-> Code)
  (let [sig signature
        name-text (cond (= export-name "and") "wasm-and"
                        (= export-name "or") "wasm-or"
                        :else export-name)
        name (primitive/datum->syntax context name-text)
        params (primitive/code-list-new)
        arguments (primitive/code-list-new)
        (mut i) 0]
    (loop
      (if (>= (load i) (al/al-len (.params sig)))
          (break)
          (let [kind (al/al-get (.params sig) (load i))
                id (primitive/fresh-identifier "wasm-export-param")]
            (primitive/code-list-push! params `(~id ~(type-code context kind)))
            (primitive/code-list-push! arguments id)
            (store! i (+ (load i) 1)))))
    (let [param-code (primitive/code-list-done params)
          argument-code (primitive/code-list-done arguments)
          result-type (if (= (al/al-len (.results sig)) 0)
                          `void
                          (type-code context (al/al-get (.results sig) 0)))]
      `((export ~name)
        (defn ~name [~@param-code] (-> ~result-type)
          (~callee ~@argument-code))))))

(defn emit-export-wrappers! [(context Code) (forms CodeBuilder) (names Code)
                             (indices (al/ArrayList i64))
                             (types (al/ArrayList wasm/FuncType))
                             (exports (al/ArrayList wasm/Export))] (-> i64)
  (let [(mut i) 0]
    (loop
      (if (>= (load i) (al/al-len exports))
          (break)
          (let [e (al/al-get exports (load i))]
            (if (= (.kind e) 0)
                (let [function-index (.index e)]
                  (if (>= function-index (primitive/code-count names))
                      (primitive/error "WebAssembly validation: exported function index out of bounds")
                      (let [type-index (al/al-get indices function-index)
                            wrapper (export-wrapper-form
                                      context (.name e)
                                      (primitive/code-nth names function-index)
                                      (al/al-get types type-index))]
                        (primitive/code-list-push! forms (primitive/code-nth wrapper 0))
                        (primitive/code-list-push! forms (primitive/code-nth wrapper 1))
                        0)))
                0)
            (store! i (+ (load i) 1)))))
    0))

(defn compile-defined-functions [(a (dyn alloc/Allocator)) (context Code)
                                 (sections wasm/Sections)] (-> Code)
  (let [s sections
        forms (primitive/code-list-new)]
    (if (= (slice-len (.functions s)) 0)
        (primitive/code-list-done forms)
        (match (wasm/type-section a (.types s))
          (wasm/DecodeError [_ message] (primitive/error message))
          (wasm/Decoded [types]
            (match (wasm/index-section a (.functions s))
              (wasm/DecodeError [_ message] (primitive/error message))
              (wasm/Decoded [indices]
                (match (wasm/code-section a (.codes s))
                  (wasm/DecodeError [_ message] (primitive/error message))
                  (wasm/Decoded [bodies]
                    (do
                      (if (!= (slice-len (.imports s)) 0)
                          (primitive/error "WebAssembly codegen: imports are not implemented yet")
                          0)
                      (if (!= (al/al-len indices) (al/al-len bodies))
                          (primitive/error "WebAssembly validation: function/code count mismatch")
                          0)
                      (let [names-builder (primitive/code-list-new)
                            (mut i) 0]
                        (loop
                          (if (>= (load i) (al/al-len indices))
                              (break)
                              (do
                                (primitive/code-list-push!
                                  names-builder
                                  (primitive/fresh-identifier "wasm-function"))
                                (store! i (+ (load i) 1)))))
                        (let [names (primitive/code-list-done names-builder)]
                          (store! i 0)
                          (loop
                            (if (>= (load i) (al/al-len indices))
                                (break)
                                (let [type-index (al/al-get indices (load i))]
                                  (if (>= type-index (al/al-len types))
                                      (primitive/error "WebAssembly validation: type index out of bounds")
                                      (primitive/code-list-push!
                                        forms
                                        (function-form a context
                                                       (primitive/code-nth names (load i))
                                                       (al/al-get types type-index)
                                                       (al/al-get bodies (load i))
                                                       names indices types)))
                                  (store! i (+ (load i) 1)))))
                          (if (= (slice-len (.exports s)) 0)
                              0
                              (match (wasm/export-section a (.exports s))
                                (wasm/DecodeError [_ message] (primitive/error message))
                                (wasm/Decoded [exports]
                                  (emit-export-wrappers! context forms names indices types exports))))))
                      (primitive/code-list-done forms)))))))))))
