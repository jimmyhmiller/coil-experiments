(module experiments.wasm.codegen)

(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "coil.slice" :as slice :use [slice-len slice-get])
(import "experiments.wasm.decoder" :as wasm)

(defn kind-tag [(kind wasm/ValType)] (-> i64)
  (match kind
    (wasm/I32 [] 1)
    (wasm/I64 [] 2)
    (wasm/F32 [] 3)
    (wasm/F64 [] 4)))

(defn type-code [(context Code) (kind wasm/ValType)] (-> Code)
  (match kind
    (wasm/I32 [] `i32)
    (wasm/I64 [] `i64)
    (wasm/F32 [] `f32)
    (wasm/F64 [] `f64)))

(defn export-name-byte-safe? [(byte i64) (first bool)] (-> bool)
  (if first
      (or (and (>= byte 65) (<= byte 90))
          (or (and (>= byte 97) (<= byte 122)) (= byte 95)))
      (or (and (>= byte 48) (<= byte 57))
          (or (and (>= byte 65) (<= byte 90))
              (or (and (>= byte 97) (<= byte 122))
                  (or (= byte 95) (or (= byte 45) (= byte 46))))))))

(defn export-name-hex [(n i64)] (-> u8)
  (primitive/cast u8 (if (< n 10) (+ 48 n) (+ 87 n))))

(defn mapped-export-name [(name (slice u8))] (-> (slice u8))
  (let [length (slice-len name)
        (mut safe) (> length 0)
        (mut i) 0]
    (loop
      (if (or (not (load safe)) (>= (load i) length))
          (break)
          (do
            (if (not (export-name-byte-safe?
                       (primitive/cast i64 (slice-get name (load i)))
                       (= (load i) 0)))
                (store! safe false)
                0)
            (store! i (+ (load i) 1)))))
    (cond (= name "call Mf.call") "wasm-call-Mf-call"
          (= name "call Mt.call") "wasm-call-Mt-call"
          (= name "get memory[0]") "wasm-get-memory-0"
          (= name "get table[0]") "wasm-get-table-0"
          (load safe)
            (cond (= name "and") "wasm-and"
              (= name "or") "wasm-or"
              (= name "load") "wasm-load"
              (= name "while") "wasm-while"
              (= name "for") "wasm-for"
              (= name "block") "wasm-block"
              (= name "if") "wasm-if"
              (= name "return") "wasm-return"
              (= name "loop") "wasm-loop"
              (= name "cast") "wasm-cast"
              (= name "call") "wasm-call"
                  :else name)
          :else
            (let [prefix "__wasm_export_hex_"
              prefix-length (slice-len prefix)
              output-length (+ prefix-length (* length 2))]
          (match (alloc/alloc [u8] (alloc/malloc-allocator) output-length)
            (None [] (do (alloc/abort) name))
            (Some [storage]
              (let [output (alloc/alloc-slice-data storage)
                    (mut j) 0]
                (loop
                  (if (>= (load j) prefix-length)
                      (break)
                      (do
                        (store! (primitive/index output (load j))
                                (slice-get prefix (load j)))
                        (store! j (+ (load j) 1)))))
                (store! j 0)
                (loop
                  (if (>= (load j) length)
                      (break)
                      (let [byte (primitive/cast i64 (slice-get name (load j)))
                            at (+ prefix-length (* (load j) 2))]
                        (store! (primitive/index output at)
                                (export-name-hex (>> byte 4)))
                        (store! (primitive/index output (+ at 1))
                                (export-name-hex (& byte 15)))
                        (store! j (+ (load j) 1)))))
                (slice/slice-new output output-length))))))))

(defn zero-expression [(context Code) (tag i64)] (-> Code)
  (let [cast-id (primitive/datum->syntax context "primitive/cast")]
    (cond (= tag 1) `(~cast-id i32 0)
          (= tag 2) `(~cast-id i64 0)
          (= tag 3) `(~cast-id f32 0)
          (= tag 4) `(~cast-id f64 0)
          :else `0)))

(defn wasm-label [(a (dyn alloc/Allocator)) (serial i64)] (-> Code)
  (match (alloc/alloc [u8] a 28)
    (None [] (primitive/error "WebAssembly codegen: label allocation failed"))
    (Some [storage]
      (let [p (alloc/alloc-slice-data storage)
            prefix ":wasm-label-"
            (mut i) 0]
        (loop
          (if (>= (load i) 12)
              (break)
              (do
                (store! (primitive/index p (load i)) (slice-get prefix (load i)))
                (store! i (+ (load i) 1)))))
        (store! i 0)
        (loop
          (if (>= (load i) 16)
              (break)
              (let [shift (* (- 15 (load i)) 4)
                    nibble (primitive/iand
                             (primitive/ishr serial shift) 15)
                    byte (if (< nibble 10) (+ 48 nibble) (+ 87 nibble))]
                (store! (primitive/index p (+ 12 (load i)))
                        (primitive/cast u8 byte))
                (store! i (+ (load i) 1)))))
        (let [parsed (primitive/code-read (slice/slice-new p 28) `(reader-config))]
          (cond (primitive/code-keyword? parsed) parsed
                (and (primitive/code-list? parsed)
                     (= (primitive/code-count parsed) 1))
                  (primitive/code-nth parsed 0)
                (and (primitive/code-list? parsed)
                     (= (primitive/code-count parsed) 2))
                  (primitive/code-nth parsed 1)
                :else
                  (primitive/error "WebAssembly codegen: generated label did not parse as a keyword")))))))

;; Compile-time operand stacks are persistent Code triples `(tag expr tail)`.
;; Code has no runtime layout, so it must not be put in an ordinary struct or
;; ArrayList element.
(defn pop-node! [(stack (mut Code))] (-> Code)
  (if (!= (primitive/code-count (load stack)) 3)
      (primitive/error "WebAssembly validation: operand stack underflow")
      (let [node (load stack)]
        (store! stack (primitive/code-nth node 2))
        node)))

(defn push-node! [(stack (mut Code)) (kind wasm/ValType) (expression Code)] (-> i64)
  (do (store! stack `(~(kind-tag kind) ~expression ~(load stack))) 0))

(defn node-kind [(node Code)] (-> i64)
  (if (primitive/code-list? node)
      (primitive/code-int (primitive/code-nth node 0))
      (primitive/error "WebAssembly codegen internal error: operand node is not a list")))

(defn node-expression [(node Code)] (-> Code)
  (primitive/code-nth node 1))

;; MVP block types are either empty (0x40) or a single value type. Type-index
;; block signatures belong to the later multi-value extension and are rejected.
(defn parse-block-tag! [(context Code) (p (mut wasm/Parser))] (-> i64)
  (let [raw (wasm/parser-byte! (mut p))]
    (cond (= raw 0x40) 0
          (= raw 0x7f) 1
          (= raw 0x7e) 2
          (= raw 0x7d) 3
          (= raw 0x7c) 4
          :else (primitive/error "WebAssembly validation: invalid MVP block type"))))

;; Abstract operand nodes use the same persistent triple shape as codegen
;; nodes, but only their type tag is significant. Tag zero is the spec's
;; polymorphic unknown type.
(defn validation-push! [(stack (mut Code)) (tag i64)] (-> i64)
  (do (store! stack `(~tag 0 ~(load stack))) 0))

(defn validation-pop! [(stack (mut Code)) (base Code) (unreachable bool)] (-> i64)
  (if (primitive/code-eq (load stack) base)
      (if unreachable
          0
          (primitive/error "WebAssembly validation: operand stack underflow"))
      (let [node (pop-node! (mut stack))]
        (node-kind node))))

(defn validation-expect! [(stack (mut Code)) (base Code) (unreachable bool) (tag i64)]
                          (-> i64)
  (let [actual (validation-pop! (mut stack) base unreachable)]
    (if (or (= actual 0) (= actual tag))
        actual
        (primitive/error "WebAssembly validation: type mismatch in unreachable code"))))

(defn validation-finish! [(stack (mut Code)) (base Code) (unreachable bool) (result-tag i64)]
                          (-> i64)
  (if (= result-tag 0)
      (if (not (primitive/code-eq (load stack) base))
          (primitive/error "WebAssembly validation: unreachable void frame changes stack height")
          0)
      (do
        (validation-expect! (mut stack) base unreachable result-tag)
        (if (not (primitive/code-eq (load stack) base))
            (primitive/error "WebAssembly validation: unreachable result stack height mismatch")
            (validation-push! (mut stack) result-tag)))))

;; Validate a suffix after an unconditional transfer using the core spec's
;; polymorphic operand-stack rule. Nested control instructions get fresh,
;; non-polymorphic frames, so dead code is still structurally type checked.
(defn validate-unreachable-region! [(context Code) (p (mut wasm/Parser))
                                    (stack (mut Code)) (base Code) (allow-else bool)
                                    (initial-unreachable bool)
                                    (region-result-tag i64) (label-tags Code)
                                    (function-result-tag i64)
                                    (locals Code) (globals Code) (memory Code) (table Code)
                                    (function-names Code)
                                    (function-indices (al/ArrayList i64))
                                    (types (al/ArrayList wasm/FuncType))] (-> i64)
  (let [(mut unreachable) initial-unreachable
        (mut ended) false
        (mut delimiter) 0]
    (loop
      (if (or (.failed p) (load ended))
          (break)
          (let [opcode (wasm/parser-byte! (mut p))]
            (cond (= opcode 0x0b)
                    (do
                      (validation-finish! (mut stack) base (load unreachable)
                                          region-result-tag)
                      (store! delimiter opcode)
                      (store! ended true))
                  (= opcode 0x05)
                    (if allow-else
                        (do
                          (validation-finish! (mut stack) base (load unreachable)
                                              region-result-tag)
                          (store! delimiter opcode)
                          (store! ended true))
                        (primitive/error "WebAssembly validation: else outside if"))
                  (= opcode 0x00)
                    (do (store! stack base) (store! unreachable true))
                  (= opcode 0x01) 0
                  (or (= opcode 0x02) (= opcode 0x03))
                    (let [tag (parse-block-tag! context (mut p))
                          child-base (load stack)
                          child-tags `(~(if (= opcode 0x03) 0 tag) ~@label-tags)
                          stop (validate-unreachable-region!
                                 context (mut p) (mut stack) child-base false false tag child-tags
                                 function-result-tag locals globals memory table function-names
                                 function-indices types)]
                      (if (!= stop 0x0b)
                          (primitive/error "WebAssembly validation: malformed unreachable block")
                          0))
                  (= opcode 0x04)
                    (do
                      (validation-expect! (mut stack) base (load unreachable) 1)
                      (let [tag (parse-block-tag! context (mut p))
                            child-base (load stack)
                            child-tags `(~tag ~@label-tags)
                            then-stop (validate-unreachable-region!
                                        context (mut p) (mut stack) child-base true false tag child-tags
                                        function-result-tag locals globals memory table
                                        function-names function-indices types)]
                        (if (= then-stop 0x05)
                            (do
                              (store! stack child-base)
                              (let [else-stop (validate-unreachable-region!
                                                context (mut p) (mut stack) child-base false false tag
                                                child-tags function-result-tag locals globals
                                                memory table function-names function-indices types)]
                                (if (!= else-stop 0x0b)
                                    (primitive/error "WebAssembly validation: malformed unreachable if")
                                    0)))
                            (if (!= then-stop 0x0b)
                                (primitive/error "WebAssembly validation: malformed unreachable if")
                                (if (!= tag 0)
                                    (primitive/error "WebAssembly validation: result if requires else")
                                    0)))))
                  (= opcode 0x0c)
                    (let [depth (wasm/parser-u32! (mut p))]
                      (if (>= depth (primitive/code-count label-tags))
                          (primitive/error "WebAssembly validation: branch depth out of bounds")
                          (let [tag (primitive/code-int (primitive/code-nth label-tags depth))]
                            (if (!= tag 0)
                                (validation-expect! (mut stack) base (load unreachable) tag)
                                0)
                            (store! stack base)
                            (store! unreachable true))))
                  (= opcode 0x0d)
                    (let [depth (wasm/parser-u32! (mut p))]
                      (if (>= depth (primitive/code-count label-tags))
                          (primitive/error "WebAssembly validation: br_if depth out of bounds")
                          (do
                            (validation-expect! (mut stack) base (load unreachable) 1)
                            (let [tag (primitive/code-int (primitive/code-nth label-tags depth))]
                              (if (!= tag 0)
                                  (do
                                    (validation-expect! (mut stack) base (load unreachable) tag)
                                    (validation-push! (mut stack) tag))
                                  0)))))
                  (= opcode 0x0e)
                    (let [count (wasm/parser-u32! (mut p))
                          depths (primitive/code-list-new)
                          (mut i) 0]
                      (loop
                        (if (> (load i) count)
                            (break)
                            (do
                              (primitive/code-list-push! depths `~(wasm/parser-u32! (mut p)))
                              (store! i (+ (load i) 1)))))
                      (validation-expect! (mut stack) base (load unreachable) 1)
                      (let [all-depths (primitive/code-list-done depths)
                            default-depth (primitive/code-int
                                            (primitive/code-nth all-depths count))]
                        (if (>= default-depth (primitive/code-count label-tags))
                            (primitive/error "WebAssembly validation: br_table depth out of bounds")
                            (let [tag (primitive/code-int
                                        (primitive/code-nth label-tags default-depth))]
                              (store! i 0)
                              (loop
                                (if (>= (load i) count)
                                    (break)
                                    (let [depth (primitive/code-int
                                                  (primitive/code-nth all-depths (load i)))]
                                      (if (or (>= depth (primitive/code-count label-tags))
                                              (!= tag (primitive/code-int
                                                        (primitive/code-nth label-tags depth))))
                                          (primitive/error "WebAssembly validation: br_table target mismatch")
                                          (store! i (+ (load i) 1))))))
                              (if (!= tag 0)
                                  (validation-expect! (mut stack) base (load unreachable) tag)
                                  0)
                              (store! stack base)
                              (store! unreachable true)))))
                  (= opcode 0x0f)
                    (do
                      (if (!= function-result-tag 0)
                          (validation-expect! (mut stack) base (load unreachable)
                                              function-result-tag)
                          0)
                      (store! stack base)
                      (store! unreachable true))
                  (= opcode 0x10)
                    (let [index (wasm/parser-u32! (mut p))]
                      (if (>= index (primitive/code-count function-names))
                          (primitive/error "WebAssembly validation: call index out of bounds")
                          (let [signature (al/al-get types (al/al-get function-indices index))
                                (mut i) (al/al-len (.params signature))]
                            (loop
                              (if (= (load i) 0)
                                  (break)
                                  (do
                                    (store! i (- (load i) 1))
                                    (validation-expect!
                                      (mut stack) base (load unreachable)
                                      (kind-tag (al/al-get (.params signature) (load i)))))))
                            (if (= (al/al-len (.results signature)) 1)
                                (validation-push!
                                  (mut stack) (kind-tag (al/al-get (.results signature) 0)))
                                0))))
                  (= opcode 0x11)
                    (let [type-index (wasm/parser-u32! (mut p))
                          zero (wasm/parser-byte! (mut p))]
                      (if (or (!= zero 0) (>= type-index (al/al-len types))
                              (= (primitive/code-count table) 0))
                          (primitive/error "WebAssembly validation: invalid call_indirect")
                          (let [signature (al/al-get types type-index)
                                (mut i) (al/al-len (.params signature))]
                            (validation-expect! (mut stack) base (load unreachable) 1)
                            (loop
                              (if (= (load i) 0)
                                  (break)
                                  (do
                                    (store! i (- (load i) 1))
                                    (validation-expect!
                                      (mut stack) base (load unreachable)
                                      (kind-tag (al/al-get (.params signature) (load i)))))))
                            (if (= (al/al-len (.results signature)) 1)
                                (validation-push!
                                  (mut stack) (kind-tag (al/al-get (.results signature) 0)))
                                0))))
                  (= opcode 0x1a)
                    (do (validation-pop! (mut stack) base (load unreachable)) 0)
                  (= opcode 0x1b)
                    (do
                      (validation-expect! (mut stack) base (load unreachable) 1)
                      (let [right (validation-pop! (mut stack) base (load unreachable))
                            left (validation-pop! (mut stack) base (load unreachable))]
                        (if (and (!= left 0) (and (!= right 0) (!= left right)))
                            (primitive/error "WebAssembly validation: select type mismatch")
                            (validation-push! (mut stack) (if (= left 0) right left)))))
                  (= opcode 0x20)
                    (let [index (wasm/parser-u32! (mut p))]
                      (if (>= index (primitive/code-count locals))
                          (primitive/error "WebAssembly validation: local index out of bounds")
                          (validation-push!
                            (mut stack)
                            (primitive/code-int
                              (primitive/code-nth (primitive/code-nth locals index) 0)))))
                  (or (= opcode 0x21) (= opcode 0x22))
                    (let [index (wasm/parser-u32! (mut p))]
                      (if (>= index (primitive/code-count locals))
                          (primitive/error "WebAssembly validation: local index out of bounds")
                          (let [tag (primitive/code-int
                                      (primitive/code-nth (primitive/code-nth locals index) 0))]
                            (validation-expect! (mut stack) base (load unreachable) tag)
                            (if (= opcode 0x22) (validation-push! (mut stack) tag) 0))))
                  (= opcode 0x23)
                    (let [index (wasm/parser-u32! (mut p))]
                      (if (>= index (primitive/code-count globals))
                          (primitive/error "WebAssembly validation: global index out of bounds")
                          (validation-push!
                            (mut stack)
                            (primitive/code-int
                              (primitive/code-nth (primitive/code-nth globals index) 0)))))
                  (= opcode 0x24)
                    (let [index (wasm/parser-u32! (mut p))]
                      (if (>= index (primitive/code-count globals))
                          (primitive/error "WebAssembly validation: global index out of bounds")
                          (let [global (primitive/code-nth globals index)
                                tag (primitive/code-int (primitive/code-nth global 0))]
                            (if (= (primitive/code-int (primitive/code-nth global 1)) 0)
                                (primitive/error "WebAssembly validation: global.set of immutable global")
                                (validation-expect! (mut stack) base (load unreachable) tag)))))
                  (and (>= opcode 0x28) (<= opcode 0x35))
                    (let [alignment (wasm/parser-u32! (mut p))
                          offset (wasm/parser-u32! (mut p))
                          tag (cond (or (= opcode 0x28)
                                        (and (>= opcode 0x2c) (<= opcode 0x2f))) 1
                                    (or (= opcode 0x29)
                                        (and (>= opcode 0x30) (<= opcode 0x35))) 2
                                    (= opcode 0x2a) 3
                                    :else 4)
                          maximum-alignment
                            (cond (or (= opcode 0x28) (= opcode 0x2a)) 2
                                  (or (= opcode 0x29) (= opcode 0x2b)) 3
                                  (or (= opcode 0x2c) (= opcode 0x2d)) 0
                                  (or (= opcode 0x2e) (= opcode 0x2f)) 1
                                  (or (= opcode 0x30) (= opcode 0x31)) 0
                                  (or (= opcode 0x32) (= opcode 0x33)) 1
                                  :else 2)]
                      (if (or (= (primitive/code-count memory) 0)
                              (> alignment maximum-alignment))
                          (primitive/error "WebAssembly validation: invalid memory load")
                          (do
                            (validation-expect! (mut stack) base (load unreachable) 1)
                            (validation-push! (mut stack) tag))))
                  (and (>= opcode 0x36) (<= opcode 0x3e))
                    (let [alignment (wasm/parser-u32! (mut p))
                          offset (wasm/parser-u32! (mut p))
                          tag (cond (or (= opcode 0x36)
                                        (or (= opcode 0x3a) (= opcode 0x3b))) 1
                                    (or (= opcode 0x37)
                                        (and (>= opcode 0x3c) (<= opcode 0x3e))) 2
                                    (= opcode 0x38) 3
                                    :else 4)
                          maximum-alignment
                            (cond (= opcode 0x36) 2
                                  (= opcode 0x37) 3
                                  (= opcode 0x38) 2
                                  (= opcode 0x39) 3
                                  (= opcode 0x3a) 0
                                  (= opcode 0x3b) 1
                                  (= opcode 0x3c) 0
                                  (= opcode 0x3d) 1
                                  :else 2)]
                      (if (or (= (primitive/code-count memory) 0)
                              (> alignment maximum-alignment))
                          (primitive/error "WebAssembly validation: invalid memory store")
                          (do
                            (validation-expect! (mut stack) base (load unreachable) tag)
                            (validation-expect! (mut stack) base (load unreachable) 1))))
                  (= opcode 0x3f)
                    (let [zero (wasm/parser-byte! (mut p))]
                      (if (or (!= zero 0) (= (primitive/code-count memory) 0))
                          (primitive/error "WebAssembly validation: invalid memory.size")
                          (validation-push! (mut stack) 1)))
                  (= opcode 0x40)
                    (let [zero (wasm/parser-byte! (mut p))]
                      (if (or (!= zero 0) (= (primitive/code-count memory) 0))
                          (primitive/error "WebAssembly validation: invalid memory.grow")
                          (do
                            (validation-expect! (mut stack) base (load unreachable) 1)
                            (validation-push! (mut stack) 1))))
                  (= opcode 0x41)
                    (do (wasm/parser-signed! (mut p) 32)
                        (validation-push! (mut stack) 1))
                  (= opcode 0x42)
                    (do (wasm/parser-signed! (mut p) 64)
                        (validation-push! (mut stack) 2))
                  (= opcode 0x43)
                    (do (wasm/parser-fixed-bits! (mut p) 4)
                        (validation-push! (mut stack) 3))
                  (= opcode 0x44)
                    (do (wasm/parser-fixed-bits! (mut p) 8)
                        (validation-push! (mut stack) 4))
                  (= opcode 0x45)
                    (do (validation-expect! (mut stack) base (load unreachable) 1)
                        (validation-push! (mut stack) 1))
                  (and (>= opcode 0x46) (<= opcode 0x4f))
                    (do (validation-expect! (mut stack) base (load unreachable) 1)
                        (validation-expect! (mut stack) base (load unreachable) 1)
                        (validation-push! (mut stack) 1))
                  (= opcode 0x50)
                    (do (validation-expect! (mut stack) base (load unreachable) 2)
                        (validation-push! (mut stack) 1))
                  (and (>= opcode 0x51) (<= opcode 0x5a))
                    (do (validation-expect! (mut stack) base (load unreachable) 2)
                        (validation-expect! (mut stack) base (load unreachable) 2)
                        (validation-push! (mut stack) 1))
                  (and (>= opcode 0x5b) (<= opcode 0x60))
                    (do (validation-expect! (mut stack) base (load unreachable) 3)
                        (validation-expect! (mut stack) base (load unreachable) 3)
                        (validation-push! (mut stack) 1))
                  (and (>= opcode 0x61) (<= opcode 0x66))
                    (do (validation-expect! (mut stack) base (load unreachable) 4)
                        (validation-expect! (mut stack) base (load unreachable) 4)
                        (validation-push! (mut stack) 1))
                  (and (>= opcode 0x67) (<= opcode 0x69))
                    (do (validation-expect! (mut stack) base (load unreachable) 1)
                        (validation-push! (mut stack) 1))
                  (and (>= opcode 0x6a) (<= opcode 0x78))
                    (do (validation-expect! (mut stack) base (load unreachable) 1)
                        (validation-expect! (mut stack) base (load unreachable) 1)
                        (validation-push! (mut stack) 1))
                  (and (>= opcode 0x79) (<= opcode 0x7b))
                    (do (validation-expect! (mut stack) base (load unreachable) 2)
                        (validation-push! (mut stack) 2))
                  (and (>= opcode 0x7c) (<= opcode 0x8a))
                    (do (validation-expect! (mut stack) base (load unreachable) 2)
                        (validation-expect! (mut stack) base (load unreachable) 2)
                        (validation-push! (mut stack) 2))
                  (and (>= opcode 0x8b) (<= opcode 0x91))
                    (do (validation-expect! (mut stack) base (load unreachable) 3)
                        (validation-push! (mut stack) 3))
                  (and (>= opcode 0x92) (<= opcode 0x98))
                    (do (validation-expect! (mut stack) base (load unreachable) 3)
                        (validation-expect! (mut stack) base (load unreachable) 3)
                        (validation-push! (mut stack) 3))
                  (and (>= opcode 0x99) (<= opcode 0x9f))
                    (do (validation-expect! (mut stack) base (load unreachable) 4)
                        (validation-push! (mut stack) 4))
                  (and (>= opcode 0xa0) (<= opcode 0xa6))
                    (do (validation-expect! (mut stack) base (load unreachable) 4)
                        (validation-expect! (mut stack) base (load unreachable) 4)
                        (validation-push! (mut stack) 4))
                  (= opcode 0xa7)
                    (do (validation-expect! (mut stack) base (load unreachable) 2)
                        (validation-push! (mut stack) 1))
                  (and (>= opcode 0xa8) (<= opcode 0xa9))
                    (do (validation-expect! (mut stack) base (load unreachable) 3)
                        (validation-push! (mut stack) 1))
                  (and (>= opcode 0xaa) (<= opcode 0xab))
                    (do (validation-expect! (mut stack) base (load unreachable) 4)
                        (validation-push! (mut stack) 1))
                  (and (>= opcode 0xac) (<= opcode 0xad))
                    (do (validation-expect! (mut stack) base (load unreachable) 1)
                        (validation-push! (mut stack) 2))
                  (and (>= opcode 0xae) (<= opcode 0xaf))
                    (do (validation-expect! (mut stack) base (load unreachable) 3)
                        (validation-push! (mut stack) 2))
                  (and (>= opcode 0xb0) (<= opcode 0xb1))
                    (do (validation-expect! (mut stack) base (load unreachable) 4)
                        (validation-push! (mut stack) 2))
                  (and (>= opcode 0xb2) (<= opcode 0xb3))
                    (do (validation-expect! (mut stack) base (load unreachable) 1)
                        (validation-push! (mut stack) 3))
                  (and (>= opcode 0xb4) (<= opcode 0xb5))
                    (do (validation-expect! (mut stack) base (load unreachable) 2)
                        (validation-push! (mut stack) 3))
                  (= opcode 0xb6)
                    (do (validation-expect! (mut stack) base (load unreachable) 4)
                        (validation-push! (mut stack) 3))
                  (and (>= opcode 0xb7) (<= opcode 0xb8))
                    (do (validation-expect! (mut stack) base (load unreachable) 1)
                        (validation-push! (mut stack) 4))
                  (and (>= opcode 0xb9) (<= opcode 0xba))
                    (do (validation-expect! (mut stack) base (load unreachable) 2)
                        (validation-push! (mut stack) 4))
                  (= opcode 0xbb)
                    (do (validation-expect! (mut stack) base (load unreachable) 3)
                        (validation-push! (mut stack) 4))
                  (= opcode 0xbc)
                    (do (validation-expect! (mut stack) base (load unreachable) 3)
                        (validation-push! (mut stack) 1))
                  (= opcode 0xbd)
                    (do (validation-expect! (mut stack) base (load unreachable) 4)
                        (validation-push! (mut stack) 2))
                  (= opcode 0xbe)
                    (do (validation-expect! (mut stack) base (load unreachable) 1)
                        (validation-push! (mut stack) 3))
                  (= opcode 0xbf)
                    (do (validation-expect! (mut stack) base (load unreachable) 2)
                        (validation-push! (mut stack) 4))
                  :else
                    (primitive/error "WebAssembly validation: invalid opcode in unreachable code")))))
    (if (.failed p) (primitive/error (.message p)) 0)
    (if (not (load ended))
        (primitive/error "WebAssembly expression lacks a final end opcode")
        (load delimiter))))

(defn validate-unreachable-suffix! [(context Code) (p (mut wasm/Parser))
                                    (allow-else bool) (region-result-tag i64)
                                    (label-tags Code) (function-result-tag i64)
                                    (locals Code) (globals Code) (memory Code) (table Code)
                                    (function-names Code)
                                    (function-indices (al/ArrayList i64))
                                    (types (al/ArrayList wasm/FuncType))] (-> i64)
  (let [(mut stack) `()]
    (validate-unreachable-region! context (mut p) (mut stack) `() allow-else true
                                  region-result-tag label-tags function-result-tag
                                  locals globals memory table function-names
                                  function-indices types)))

(defn finish-region [(a (dyn alloc/Allocator)) (base Code) (stack (mut Code)) (forms CodeBuilder)
                     (result-tag i64)] (-> Code)
  (let [body-forms (primitive/code-list-done forms)]
    (if (= result-tag 0)
        (if (primitive/code-eq base (load stack))
            `(do ~@body-forms 0)
            (primitive/error "WebAssembly validation: void block changes stack height"))
        (let [value (pop-node! (mut stack))]
          (if (or (!= (node-kind value) result-tag)
                  (not (primitive/code-eq base (load stack))))
              (primitive/error "WebAssembly validation: block result type mismatch")
              `(do ~@body-forms ~(primitive/code-nth value 1)))))))

(defn finish-return [(base Code) (stack (mut Code)) (forms CodeBuilder) (result-tag i64)]
                    (-> Code)
  (let [body-forms (primitive/code-list-done forms)]
    (if (= result-tag 0)
        `(do ~@body-forms)
        (if (primitive/code-eq base (load stack))
            (primitive/error "WebAssembly validation: return operand is below current control frame")
            (let [value (pop-node! (mut stack))]
              (if (!= (node-kind value) result-tag)
                  (primitive/error "WebAssembly validation: return type mismatch")
                  `(do ~@body-forms ~(primitive/code-nth value 1))))))))

;; Give an unconditional control transfer the result type of the region it
;; makes unreachable.  Keeping the transfer and its typed dead alternative in
;; one `if` lets core lowering build a valid CFG; appending a dummy value after
;; a bare `break` or `continue` would put instructions after a terminator.
(defn typed-transfer [(context Code) (transfer Code) (result-tag i64)] (-> Code)
  (let [if-id (primitive/datum->syntax context "if")
        ne-id (primitive/datum->syntax context "primitive/icmp-ne")
        cast-id (primitive/datum->syntax context "primitive/cast")]
    `(~if-id (~ne-id (~cast-id i32 1) (~cast-id i32 0))
             ~transfer
             ~(zero-expression context (if (= result-tag 0) 2 result-tag)))))

(defn balanced-table-dispatch [(context Code) (selector Code) (cases Code)
                               (default Code) (low i64) (high i64)] (-> Code)
  (if (>= low high)
      default
      (if (= (+ low 1) high)
          (primitive/code-nth cases low)
          (let [mid (+ low (/ (- high low) 2))
                lt-id (primitive/datum->syntax context "wasmrt/i32-lt-u")
                cast-id (primitive/datum->syntax context "primitive/cast")]
            `(if (~lt-id ~selector (~cast-id i32 ~mid))
                 ~(balanced-table-dispatch context selector cases default low mid)
                 ~(balanced-table-dispatch context selector cases default mid high))))))

(defn integer-binop! [(stack (mut Code)) (kind wasm/ValType) (operator Code)]
                      (-> i64)
  (let [right (pop-node! (mut stack))
        left (pop-node! (mut stack))
        right-expression (primitive/code-nth right 1)
        left-expression (primitive/code-nth left 1)]
    (if (or (!= (node-kind right) (kind-tag kind))
            (!= (node-kind left) (kind-tag kind)))
        (primitive/error "WebAssembly validation: integer operator type mismatch")
        (push-node! (mut stack) kind
                    `(~operator ~left-expression ~right-expression)))))

(defn runtime-unary! [(context Code) (stack (mut Code))
                      (input wasm/ValType) (result wasm/ValType)
                      (name (slice u8))] (-> i64)
  (let [value (pop-node! (mut stack))]
    (if (!= (node-kind value) (kind-tag input))
        (primitive/error "WebAssembly validation: unary operator type mismatch")
        (let [callee (primitive/datum->syntax context name)
              expression (primitive/code-nth value 1)]
          (push-node! (mut stack) result `(~callee ~expression))))))

(defn runtime-binary! [(context Code) (stack (mut Code))
                       (input wasm/ValType) (result wasm/ValType)
                       (name (slice u8))] (-> i64)
  (let [right (pop-node! (mut stack))
        left (pop-node! (mut stack))]
    (if (or (!= (node-kind right) (kind-tag input))
            (!= (node-kind left) (kind-tag input)))
        (primitive/error "WebAssembly validation: binary operator type mismatch")
        (let [callee (primitive/datum->syntax context name)
              l (primitive/code-nth left 1)
              r (primitive/code-nth right 1)]
          (push-node! (mut stack) result `(~callee ~l ~r))))))

(defn memory-load! [(context Code) (p (mut wasm/Parser)) (stack (mut Code))
                    (memory Code) (result wasm/ValType) (name (slice u8))
                    (maximum-alignment i64)] (-> i64)
  (let [alignment (wasm/parser-u32! (mut p))
        offset (wasm/parser-u32! (mut p))
        address (pop-node! (mut stack))]
    (if (= (primitive/code-count memory) 0)
        (primitive/error "WebAssembly validation: memory instruction without memory")
        (if (> alignment maximum-alignment)
            (primitive/error "WebAssembly validation: memory alignment too large")
            (if (!= (node-kind address) 1)
                (primitive/error "WebAssembly validation: memory address must be i32")
                (let [callee (primitive/datum->syntax context name)
                      memory-accessor (primitive/code-nth memory 1)
                      a (primitive/code-nth address 1)]
                  (push-node! (mut stack) result
                              `(~callee (~memory-accessor) ~a ~offset))))))))

(defn memory-store! [(context Code) (p (mut wasm/Parser)) (stack (mut Code))
                     (forms CodeBuilder) (memory Code) (value-kind wasm/ValType)
                     (name (slice u8)) (maximum-alignment i64)] (-> i64)
  (let [alignment (wasm/parser-u32! (mut p))
        offset (wasm/parser-u32! (mut p))
        value (pop-node! (mut stack))
        address (pop-node! (mut stack))]
    (if (= (primitive/code-count memory) 0)
        (primitive/error "WebAssembly validation: memory instruction without memory")
        (if (> alignment maximum-alignment)
            (primitive/error "WebAssembly validation: memory alignment too large")
            (if (or (!= (node-kind address) 1)
                    (!= (node-kind value) (kind-tag value-kind)))
                (primitive/error "WebAssembly validation: memory store type mismatch")
                (let [callee (primitive/datum->syntax context name)
                      memory-accessor (primitive/code-nth memory 1)
                      av (primitive/code-nth address 1)
                      vv (primitive/code-nth value 1)]
                  (primitive/code-list-push!
                    forms `(~callee (~memory-accessor) ~av ~offset ~vv))
                  0))))))

(defn valtype-equal [(left wasm/ValType) (right wasm/ValType)] (-> bool)
  (= (kind-tag left) (kind-tag right)))

(defn function-type-equal [(left wasm/FuncType) (right wasm/FuncType)] (-> bool)
  (let [l left
        r right
        (mut equal) (and (= (al/al-len (.params l)) (al/al-len (.params r)))
                         (= (al/al-len (.results l)) (al/al-len (.results r))))
        (mut i) 0]
    (loop
      (if (or (not (load equal)) (>= (load i) (al/al-len (.params l))))
          (break)
          (do
            (if (not (valtype-equal (al/al-get (.params l) (load i))
                                    (al/al-get (.params r) (load i))))
                (store! equal false)
                0)
            (store! i (+ (load i) 1)))))
    (if (and (load equal) (= (al/al-len (.results l)) 1))
        (valtype-equal (al/al-get (.results l) 0) (al/al-get (.results r) 0))
        (load equal))))

(defn indirect-call! [(a (dyn alloc/Allocator)) (context Code)
                      (p (mut wasm/Parser)) (stack (mut Code)) (forms CodeBuilder)
                      (table Code) (function-names Code)
                      (function-indices (al/ArrayList i64))
                      (types (al/ArrayList wasm/FuncType))] (-> i64)
  (let [wanted-index (wasm/parser-u32! (mut p))
        reserved (wasm/parser-byte! (mut p))]
    (if (or (!= reserved 0) (>= wanted-index (al/al-len types)))
        (primitive/error "WebAssembly validation: invalid call_indirect type")
        (if (= (primitive/code-count table) 0)
            (primitive/error "WebAssembly validation: call_indirect without table")
            (let [wanted (al/al-get types wanted-index)
                  table-index (pop-node! (mut stack))
                  reversed-builder (primitive/code-list-new)
                  (mut argument-index) (al/al-len (.params wanted))]
              (if (!= (node-kind table-index) 1)
                  (primitive/error "WebAssembly validation: call_indirect index must be i32")
                  0)
              (loop
                (if (= (load argument-index) 0)
                    (break)
                    (do
                      (store! argument-index (- (load argument-index) 1))
                      (let [argument (pop-node! (mut stack))
                            parameter (al/al-get (.params wanted) (load argument-index))]
                        (if (!= (node-kind argument) (kind-tag parameter))
                            (primitive/error "WebAssembly validation: call_indirect argument mismatch")
                            (primitive/code-list-push!
                              reversed-builder (primitive/code-nth argument 1)))))))
              (let [reversed (primitive/code-list-done reversed-builder)
                    arguments-builder (primitive/code-list-new)
                    (mut j) (primitive/code-count reversed)]
                (loop
                  (if (= (load j) 0)
                      (break)
                      (do
                        (store! j (- (load j) 1))
                        (primitive/code-list-push!
                          arguments-builder (primitive/code-nth reversed (load j))))))
                (let [arguments (primitive/code-list-done arguments-builder)
                      argument-bindings (primitive/code-list-new)
                      call-arguments-builder (primitive/code-list-new)
                      (mut argument-slot) 0
                      result-count (al/al-len (.results wanted))
                      trap-name (if (= result-count 0)
                                    "wasmrt/trap-void"
                                    (match (al/al-get (.results wanted) 0)
                                      (wasm/I32 [] "wasmrt/trap-i32")
                                      (wasm/I64 [] "wasmrt/trap-i64")
                                      (wasm/F32 [] "wasmrt/trap-f32")
                                      (wasm/F64 [] "wasmrt/trap-f64")))
                      trap-id (primitive/datum->syntax context trap-name)
                      index-id (primitive/fresh-identifier "wasm-table-index")
                      entry-id (primitive/fresh-identifier "wasm-table-entry")
                      table-entry-id (primitive/datum->syntax context "wasmrt/table-entry")
                      address-id (primitive/datum->syntax context "wasmrt/table-entry-address")
                      length-id (primitive/datum->syntax
                                  context "wasmrt/table-entry-signature-length")
                      byte-id (primitive/datum->syntax
                                context "wasmrt/table-entry-signature-byte")
                      call-ptr-id (primitive/datum->syntax context "primitive/call-ptr")
                      llvm-id (primitive/datum->syntax context "primitive/llvm-ir")
                      and-id (primitive/datum->syntax context "and")
                      eq-id (primitive/datum->syntax context "=")
                      table-accessor (primitive/code-nth table 1)
                      parameter-types-builder (primitive/code-list-new)
                      (mut signature-condition)
                        `(~eq-id (~length-id ~entry-id)
                                 ~(+ 1 (al/al-len (.params wanted))))]
                  (loop
                    (if (>= (load argument-slot) (primitive/code-count arguments))
                        (break)
                        (let [id (primitive/fresh-identifier "wasm-indirect-argument")]
                          (primitive/code-list-push! argument-bindings id)
                          (primitive/code-list-push!
                            argument-bindings
                            (primitive/code-nth arguments (load argument-slot)))
                          (primitive/code-list-push! call-arguments-builder id)
                          (store! argument-slot (+ (load argument-slot) 1)))))
                  (let [call-arguments
                          (primitive/code-list-done call-arguments-builder)
                        result-tag (if (= result-count 0)
                                       0
                                       (kind-tag (al/al-get (.results wanted) 0)))]
                  (store! signature-condition
                          `(~and-id ~(load signature-condition)
                                    (~eq-id (~byte-id ~entry-id 0) ~result-tag)))
                  (store! argument-slot 0)
                  (loop
                    (if (>= (load argument-slot) (al/al-len (.params wanted)))
                        (break)
                        (let [parameter (al/al-get (.params wanted) (load argument-slot))]
                          (primitive/code-list-push!
                            parameter-types-builder (type-code context parameter))
                          (store! signature-condition
                                  `(~and-id ~(load signature-condition)
                                    (~eq-id
                                      (~byte-id ~entry-id ~(+ 1 (load argument-slot)))
                                      ~(kind-tag parameter))))
                          (store! argument-slot (+ (load argument-slot) 1)))))
                  (let [bindings-code (primitive/code-list-done argument-bindings)
                        index-expression (primitive/code-nth table-index 1)
                        parameter-types (primitive/code-list-done parameter-types-builder)
                        result-type (if (= result-count 0)
                                        `i64
                                        (type-code context (al/al-get (.results wanted) 0)))
                        fnptr-type `(fnptr c [~@parameter-types] ~result-type)
                        pointer-call
                          `(~call-ptr-id
                             (~llvm-id ~fnptr-type [(~address-id ~entry-id)]
                               "%r = inttoptr i64 $0 to ptr\nret ptr %r")
                             ~@call-arguments)
                        successful-call (if (= result-count 0)
                                            `(do ~pointer-call (do))
                                            pointer-call)
                        call `(let [~@bindings-code
                                    ~index-id ~index-expression
                                    ~entry-id (~table-entry-id (~table-accessor) ~index-id)]
                                (if ~(load signature-condition)
                                    ~successful-call
                                    (~trap-id)))]
                    (if (= result-count 0)
                        (do (primitive/code-list-push! forms call) 0)
                        (push-node! (mut stack) (al/al-get (.results wanted) 0) call)))))))))))

(defn compile-region! [(a (dyn alloc/Allocator)) (context Code)
                       (p (mut wasm/Parser)) (stack (mut Code))
                       (forms-builder CodeBuilder) (bindings CodeBuilder) (allow-else bool)
                       (region-base Code) (region-result-tag i64) (region-label Code)
                       (label-names Code) (label-tags Code) (label-loops Code)
                       (function-result-tag i64)
                       (locals Code) (globals Code) (memory Code) (table Code)
                       (function-names Code)
                       (function-indices (al/ArrayList i64))
                       (types (al/ArrayList wasm/FuncType))] (-> i64)
  (let [(mut ended) false
        (mut stop-opcode) 0]
    (loop
      (if (or (.failed p) (load ended))
          (break)
          (let [opcode (wasm/parser-byte! (mut p))]
            (cond (= opcode 0x0b)
                    (do (store! stop-opcode opcode) (store! ended true))
                  (= opcode 0x00)
                    (let [trap-name (cond (= region-result-tag 0) "wasmrt/trap-void"
                                          (= region-result-tag 1) "wasmrt/trap-i32"
                                          (= region-result-tag 2) "wasmrt/trap-i64"
                                          (= region-result-tag 3) "wasmrt/trap-f32"
                                          (= region-result-tag 4) "wasmrt/trap-f64"
                                          :else
                                            (primitive/error "WebAssembly codegen internal error: invalid unreachable result"))
                          trap-id (primitive/datum->syntax context trap-name)
                          delimiter (validate-unreachable-suffix!
                                      context (mut p) allow-else region-result-tag label-tags
                                      function-result-tag locals globals memory table
                                      function-names function-indices types)]
                      (primitive/code-list-push! forms-builder `(~trap-id))
                      (store! stack region-base)
                      (if (!= region-result-tag 0)
                          (cond (= region-result-tag 1)
                                  (push-node! (mut stack) (wasm/I32)
                                              (zero-expression context 1))
                                (= region-result-tag 2)
                                  (push-node! (mut stack) (wasm/I64)
                                              (zero-expression context 2))
                                (= region-result-tag 3)
                                  (push-node! (mut stack) (wasm/F32)
                                              (zero-expression context 3))
                                (= region-result-tag 4)
                                  (push-node! (mut stack) (wasm/F64)
                                              (zero-expression context 4))
                                :else 0)
                          0)
                      (store! stop-opcode delimiter)
                      (store! ended true))
                  (= opcode 0x05)
                    (if allow-else
                        (do (store! stop-opcode opcode) (store! ended true))
                        (primitive/error "WebAssembly validation: else outside if"))
                  (or (= opcode 0x02) (= opcode 0x03))
                    (let [result-tag (parse-block-tag! context (mut p))
                          base (load stack)
                          label (wasm-label a (.at (.cursor p)))
                          child-names `(~label ~@label-names)
                          child-tags `(~(if (= opcode 0x03) 0 result-tag) ~@label-tags)
                          child-loops `(~(if (= opcode 0x03) 1 0) ~@label-loops)
                          (mut block-stack) base
                          block-forms (primitive/code-list-new)
                          block-stop (compile-region! a context (mut p) (mut block-stack)
                                                      block-forms bindings false base result-tag
                                                      label child-names child-tags child-loops
                                                      function-result-tag
                                                      locals globals memory table function-names
                                                      function-indices types)]
                      (if (>= block-stop 0x100)
                          (let [expression (finish-return base (mut block-stack) block-forms
                                                          function-result-tag)]
                            (store! stack `())
                            (cond (= function-result-tag 0)
                                    (do (primitive/code-list-push! forms-builder expression) 0)
                                  (= function-result-tag 1)
                                    (push-node! (mut stack) (wasm/I32) expression)
                                  (= function-result-tag 2)
                                    (push-node! (mut stack) (wasm/I64) expression)
                                  (= function-result-tag 3)
                                    (push-node! (mut stack) (wasm/F32) expression)
                                  (= function-result-tag 4)
                                    (push-node! (mut stack) (wasm/F64) expression)
                                  :else
                                    (primitive/error "WebAssembly codegen internal error: invalid return result"))
                            (let [delimiter (validate-unreachable-suffix!
                                              context (mut p) allow-else region-result-tag
                                              label-tags function-result-tag locals globals
                                              memory table function-names function-indices types)]
                              (store! stop-opcode (+ 0x100 delimiter)))
                            (store! ended true))
                          (if (!= block-stop 0x0b)
                              (primitive/error "WebAssembly validation: malformed block")
                              (let [body (finish-region a base (mut block-stack)
                                                           block-forms result-tag)
                                    break-value (if (= result-tag 0) `(do ~body 0) body)
                                    expression
                                      `(loop ~label (break ~label ~break-value))]
                            (if (= result-tag 0)
                                (do (primitive/code-list-push! forms-builder expression) 0)
                                (cond (= result-tag 1)
                                        (push-node! (mut stack) (wasm/I32) expression)
                                      (= result-tag 2)
                                        (push-node! (mut stack) (wasm/I64) expression)
                                      (= result-tag 3)
                                        (push-node! (mut stack) (wasm/F32) expression)
                                      (= result-tag 4)
                                        (push-node! (mut stack) (wasm/F64) expression)
                                      :else
                                        (primitive/error "WebAssembly codegen internal error: invalid block result")))))))
                  (= opcode 0x04)
                    (let [result-tag (parse-block-tag! context (mut p))
                          condition (pop-node! (mut stack))]
                      (if (!= (node-kind condition) 1)
                          (primitive/error "WebAssembly validation: if condition must be i32")
                          (let [base (load stack)
                                label (wasm-label a (.at (.cursor p)))
                                child-names `(~label ~@label-names)
                                child-tags `(~result-tag ~@label-tags)
                                child-loops `(0 ~@label-loops)
                                (mut then-stack) base
                                then-forms (primitive/code-list-new)
                                then-stop (compile-region! a context (mut p) (mut then-stack)
                                                           then-forms bindings true base result-tag
                                                           label child-names child-tags child-loops
                                                           function-result-tag
                                                           locals globals memory table function-names
                                                           function-indices types)
                                then-returns (>= then-stop 0x100)
                                then-boundary (if then-returns (- then-stop 0x100) then-stop)
                                then-code (if then-returns
                                              (finish-return base (mut then-stack) then-forms
                                                             function-result-tag)
                                              (finish-region a base (mut then-stack)
                                                             then-forms result-tag))
                                (mut else-stack) base
                                else-forms (primitive/code-list-new)
                                (mut else-returns) false
                                else-code
                                  (if (= then-boundary 0x05)
                                      (let [else-stop
                                              (compile-region! a context (mut p)
                                                               (mut else-stack) else-forms
                                                               bindings false base result-tag
                                                               label child-names child-tags child-loops
                                                               function-result-tag
                                                               locals globals memory table function-names
                                                               function-indices types)]
                                        (if (>= else-stop 0x100)
                                            (do
                                              (store! else-returns true)
                                              (finish-return base (mut else-stack) else-forms
                                                             function-result-tag))
                                            (if (!= else-stop 0x0b)
