(module experiments.wasm.runtime)

(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.mem" :as mem)

(extern malloc :cc c [i64] (-> (ptr u8)))
(extern realloc :cc c [(ptr u8) i64] (-> (ptr u8)))
(extern _setjmp :cc c [(ptr u8)] (-> i32))
(extern _longjmp :cc c [(ptr u8) i32] (-> void))
(extern fork :cc c [] (-> i32))
(extern waitpid :cc c [i32 (ptr i32) i32] (-> i32))
(extern _exit :cc c [i32] (-> void))

(extern sqrtf :cc c [f32] (-> f32))
(extern ceilf :cc c [f32] (-> f32))
(extern floorf :cc c [f32] (-> f32))
(extern truncf :cc c [f32] (-> f32))
(extern nearbyintf :cc c [f32] (-> f32))
(extern sqrt :cc c [f64] (-> f64))
(extern ceil :cc c [f64] (-> f64))
(extern floor :cc c [f64] (-> f64))
(extern trunc :cc c [f64] (-> f64))
(extern nearbyint :cc c [f64] (-> f64))

(defstruct Memory
  [(data (ptr u8))
   (minimum i64)
   (pages i64)
   (has-maximum bool)
   (maximum i64)
   (initialized bool)])

(defstruct TableEntry
  [(address i64)
   (signature (ptr u8))
   (signature-length i64)])

(defstruct FunctionType
  [(signature (ptr u8))
   (length i64)
   (initialized bool)])

(defn function-type-init! [(function-type (ptr FunctionType)) (length i64)] (-> i64)
  (if (.initialized function-type)
      0
      (let [signature (if (= length 0)
                          (primitive/cast (ptr u8) 0)
                          (malloc length))]
        (if (and (> length 0) (= (primitive/cast i64 signature) 0))
            (trap)
            (do
              (if (> length 0) (mem/mem-zero [u8] signature length) 0)
              (set! (.signature function-type) signature)
              (set! (.length function-type) length)
              (set! (.initialized function-type) true)
              0)))))

(defn function-type-set! [(function-type (ptr FunctionType)) (at i64) (tag i64)]
                          (-> i64)
  (if (or (< at 0) (>= at (.length function-type)))
      (trap)
      (do
        (store! (primitive/index (.signature function-type) at) (primitive/cast u8 tag))
        0)))

(defn function-type-check-length [(function-type (ptr FunctionType)) (length i64)]
                                 (-> i64)
  (if (= (.length function-type) length) 0 (trap)))

(defn function-type-check-byte [(function-type (ptr FunctionType)) (at i64) (tag i64)]
                               (-> i64)
  (if (and (>= at 0)
           (and (< at (.length function-type))
                (= (primitive/cast i64
                     (load (primitive/index (.signature function-type) at))) tag)))
      0
      (trap)))

(defstruct Table
  [(entries (ptr TableEntry))
   (minimum i64)
   (size i64)
   (has-maximum bool)
   (maximum i64)
   (initialized bool)])

(defn table-init! [(table (ptr Table)) (minimum i64) (has-maximum bool)
                   (maximum i64)] (-> i64)
  (if (.initialized table)
      0
      (let [bytes (* minimum (primitive/sizeof TableEntry))
            entries (if (= minimum 0)
                        (primitive/cast (ptr TableEntry) 0)
                        (primitive/cast (ptr TableEntry) (malloc bytes)))]
        (if (and (> minimum 0) (= (primitive/cast i64 entries) 0))
            (trap)
            (do
              (if (> bytes 0) (mem/mem-zero [u8] (primitive/cast (ptr u8) entries) bytes) 0)
              (set! (.entries table) entries)
              (set! (.minimum table) minimum)
              (set! (.size table) minimum)
              (set! (.has-maximum table) has-maximum)
              (set! (.maximum table) maximum)
              (set! (.initialized table) true)
              0)))))

(defn table-import-check [(table (ptr Table)) (minimum i64)
                          (has-maximum bool) (maximum i64)] (-> i64)
  (if (or (< (.minimum table) minimum)
          (and has-maximum
               (or (not (.has-maximum table)) (> (.maximum table) maximum))))
      (trap)
      0))

(defn table-segment-check [(table (ptr Table)) (offset i64) (length i64)] (-> i64)
  (if (or (< offset 0) (> offset (.size table)) (> length (- (.size table) offset)))
      (trap)
      0))

(defn table-set-ref! [(table (ptr Table)) (index i64) (address i64)
                      (signature-length i64)] (-> i64)
  (if (or (< index 0) (>= index (.size table)))
      (trap)
      (let [entry (primitive/index (.entries table) index)
            signature (if (= signature-length 0)
                          (primitive/cast (ptr u8) 0)
                          (malloc signature-length))]
        (if (and (> signature-length 0) (= (primitive/cast i64 signature) 0))
            (trap)
            (do
              (set! (.address entry) address)
              (set! (.signature entry) signature)
              (set! (.signature-length entry) signature-length)
              0)))))

(defn table-set-signature-byte! [(table (ptr Table)) (index i64)
                                 (at i64) (value i64)] (-> i64)
  (let [entry (primitive/index (.entries table) index)]
    (if (or (< at 0) (>= at (.signature-length entry)))
        (trap)
        (do (store! (primitive/index (.signature entry) at) (primitive/cast u8 value)) 0))))

(defn table-entry [(table (ptr Table)) (index i32)] (-> (ptr TableEntry))
  (let [at (primitive/cast i64 (primitive/cast u32 index))]
    (if (>= at (.size table))
        (do (trap) (primitive/cast (ptr TableEntry) 0))
        (let [entry (primitive/index (.entries table) at)]
          (if (= (.address entry) 0)
              (do (trap) (primitive/cast (ptr TableEntry) 0))
              entry)))))

(defn table-entry-address [(entry (ptr TableEntry))] (-> i64) (.address entry))
(defn table-entry-signature-length [(entry (ptr TableEntry))] (-> i64)
  (.signature-length entry))
(defn table-entry-signature-byte [(entry (ptr TableEntry)) (at i64)] (-> i64)
  (primitive/cast i64 (load (primitive/index (.signature entry) at))))

(defn memory-init! [(memory (ptr Memory)) (minimum i64) (has-maximum bool)
                    (maximum i64)] (-> i64)
  (if (.initialized memory)
      0
      (let [bytes (* minimum 65536)
            data (if (= bytes 0) (primitive/cast (ptr u8) 0) (malloc bytes))]
        (if (and (> bytes 0) (= (primitive/cast i64 data) 0))
            (trap)
            (do
              (if (> bytes 0) (mem/mem-zero [u8] data bytes) 0)
              (set! (.data memory) data)
              (set! (.minimum memory) minimum)
              (set! (.pages memory) minimum)
              (set! (.has-maximum memory) has-maximum)
              (set! (.maximum memory) maximum)
              (set! (.initialized memory) true)
              0)))))

(defn memory-import-check [(memory (ptr Memory)) (minimum i64)
                           (has-maximum bool) (maximum i64)] (-> i64)
  (if (or (< (.minimum memory) minimum)
          (and has-maximum
               (or (not (.has-maximum memory)) (> (.maximum memory) maximum))))
      (trap)
      0))

(defn memory-size [(memory (ptr Memory))] (-> i32)
  (primitive/cast i32 (.pages memory)))

(defn memory-grow [(memory (ptr Memory)) (delta i32)] (-> i32)
  (let [old (.pages memory)
        amount (primitive/cast i64 (primitive/cast u32 delta))
        new-pages (+ old amount)]
    (if (or (> new-pages (.maximum memory)) (> new-pages 65536))
        (primitive/cast i32 -1)
        (if (= amount 0)
            (primitive/cast i32 old)
            (let [old-bytes (* old 65536)
                  new-bytes (* new-pages 65536)
                  next (if (= old-bytes 0)
                           (malloc new-bytes)
                           (realloc (.data memory) new-bytes))]
              (if (= (primitive/cast i64 next) 0)
                  (primitive/cast i32 -1)
                  (do
                    (mem/mem-zero [u8] (primitive/index next old-bytes)
                                         (- new-bytes old-bytes))
                    (set! (.data memory) next)
                    (set! (.pages memory) new-pages)
                    (primitive/cast i32 old))))))))

(defn memory-address [(memory (ptr Memory)) (address i32) (offset i64) (width i64)]
                     (-> (ptr u8))
  (let [base (primitive/cast u64 (primitive/cast u32 address))
        at (+ base (primitive/cast u64 offset))
        limit (primitive/cast u64 (* (.pages memory) 65536))]
    (if (or (> at limit) (> (primitive/cast u64 width) (- limit at)))
        (do (trap) (primitive/cast (ptr u8) 0))
        (primitive/index (.data memory) (primitive/cast i64 at)))))

(defn memory-load-u8 [(memory (ptr Memory)) (address i32) (offset i64)] (-> i64)
  (primitive/cast i64 (load (memory-address memory address offset 1))))

(defn memory-load-bits [(memory (ptr Memory)) (address i32) (offset i64) (width i64)]
                       (-> i64)
  (let [(mut result) 0
        (mut i) 0]
    (memory-address memory address offset width)
    (loop
      (if (>= (load i) width)
          (break)
          (do
            (store! result
                    (primitive/ior
                      (load result)
                      (primitive/ishl
                        (memory-load-u8 memory address (+ offset (load i)))
                        (* (load i) 8))))
            (store! i (+ (load i) 1)))))
    (load result)))

(defn memory-store-bits [(memory (ptr Memory)) (address i32) (offset i64)
                         (width i64) (value i64)] (-> i64)
  (let [(mut i) 0]
    (memory-address memory address offset width)
    (loop
      (if (>= (load i) width)
          (break)
          (do
            (store! (memory-address memory address (+ offset (load i)) 1)
                    (primitive/cast u8
                      (primitive/iand (primitive/ishr value (* (load i) 8)) 0xff)))
            (store! i (+ (load i) 1)))))
    0))

(defn memory-data-check [(memory (ptr Memory)) (offset i32) (length i64)] (-> i64)
  (do (memory-address memory offset 0 length) 0))

(defn memory-data-byte! [(memory (ptr Memory)) (offset i32) (value i32)] (-> i64)
  (memory-store-bits memory offset 0 1 (primitive/cast i64 value)))

(defn i32-load [(m (ptr Memory)) (a i32) (o i64)] (-> i32)
  (primitive/cast i32 (memory-load-bits m a o 4)))
(defn i64-load [(m (ptr Memory)) (a i32) (o i64)] (-> i64)
  (memory-load-bits m a o 8))
(defn f32-load [(m (ptr Memory)) (a i32) (o i64)] (-> f32)
  (f32-from-bits (i32-load m a o)))
(defn f64-load [(m (ptr Memory)) (a i32) (o i64)] (-> f64)
  (f64-from-bits (i64-load m a o)))
(defn i32-load8-s [(m (ptr Memory)) (a i32) (o i64)] (-> i32)
  (primitive/cast i32 (primitive/cast i8 (memory-load-u8 m a o))))
(defn i32-load8-u [(m (ptr Memory)) (a i32) (o i64)] (-> i32)
  (primitive/cast i32 (memory-load-u8 m a o)))
(defn i32-load16-s [(m (ptr Memory)) (a i32) (o i64)] (-> i32)
  (primitive/cast i32 (primitive/cast i16 (memory-load-bits m a o 2))))
(defn i32-load16-u [(m (ptr Memory)) (a i32) (o i64)] (-> i32)
  (primitive/cast i32 (memory-load-bits m a o 2)))
(defn i64-load8-s [(m (ptr Memory)) (a i32) (o i64)] (-> i64)
  (primitive/cast i64 (primitive/cast i8 (memory-load-u8 m a o))))
(defn i64-load8-u [(m (ptr Memory)) (a i32) (o i64)] (-> i64)
  (memory-load-u8 m a o))
(defn i64-load16-s [(m (ptr Memory)) (a i32) (o i64)] (-> i64)
  (primitive/cast i64 (primitive/cast i16 (memory-load-bits m a o 2))))
(defn i64-load16-u [(m (ptr Memory)) (a i32) (o i64)] (-> i64)
  (memory-load-bits m a o 2))
(defn i64-load32-s [(m (ptr Memory)) (a i32) (o i64)] (-> i64)
  (primitive/cast i64 (primitive/cast i32 (memory-load-bits m a o 4))))
(defn i64-load32-u [(m (ptr Memory)) (a i32) (o i64)] (-> i64)
  (primitive/cast i64 (primitive/cast u32 (memory-load-bits m a o 4))))

(defn i32-store [(m (ptr Memory)) (a i32) (o i64) (v i32)] (-> i64)
  (memory-store-bits m a o 4 (primitive/cast i64 v)))
(defn i64-store [(m (ptr Memory)) (a i32) (o i64) (v i64)] (-> i64)
  (memory-store-bits m a o 8 v))
(defn f32-store [(m (ptr Memory)) (a i32) (o i64) (v f32)] (-> i64)
  (i32-store m a o (f32-to-bits v)))
(defn f64-store [(m (ptr Memory)) (a i32) (o i64) (v f64)] (-> i64)
  (i64-store m a o (f64-to-bits v)))
(defn i32-store8 [(m (ptr Memory)) (a i32) (o i64) (v i32)] (-> i64)
  (memory-store-bits m a o 1 (primitive/cast i64 v)))
(defn i32-store16 [(m (ptr Memory)) (a i32) (o i64) (v i32)] (-> i64)
  (memory-store-bits m a o 2 (primitive/cast i64 v)))
(defn i64-store8 [(m (ptr Memory)) (a i32) (o i64) (v i64)] (-> i64)
  (memory-store-bits m a o 1 v))
(defn i64-store16 [(m (ptr Memory)) (a i32) (o i64) (v i64)] (-> i64)
  (memory-store-bits m a o 2 v))
(defn i64-store32 [(m (ptr Memory)) (a i32) (o i64) (v i64)] (-> i64)
  (memory-store-bits m a o 4 v))

(defn trap-recovery-buffer [] (-> (ptr u8))
  (primitive/cast (ptr u8) (primitive/alloc-static (array u8 512))))

(defn trap-recovery-active [] (-> (ptr i32))
  (primitive/alloc-static i32))

(defn raise-trap [] (-> void)
  (if (!= (load (trap-recovery-active)) (primitive/cast i32 0))
      (_longjmp (trap-recovery-buffer) (primitive/cast i32 1))
      (alloc/abort)))

;; Run a no-argument i64 adapter and report whether it trapped. The recovery
;; frame intentionally encloses the callback invocation so longjmp never targets
;; a returned stack frame. WASM instance mutations completed before the trap are
;; retained, matching host-observable instantiation semantics.
(defn try-i64-0 [(callback (fnptr c [] i64))] (-> bool)
  (let [active (trap-recovery-active)
        buffer (trap-recovery-buffer)]
    (store! active 1)
    (if (= (_setjmp buffer) (primitive/cast i32 0))
        (do
          (primitive/call-ptr callback)
          (store! active 0)
          false)
        (do (store! active 0) true))))

;; Stack exhaustion cannot be recovered safely with the ordinary trap
;; longjmp: the signal arrives while the native stack itself is unavailable.
;; Isolate an invocation in a child process and require the guard-page SIGSEGV
;; observed by the parent. Other traps (for example SIGABRT) do not satisfy an
;; exhaustion assertion.
(defn expect-exhaustion-i32-void [(callback-address i64) (argument i32)] (-> bool)
  (let [pid (fork)]
    (cond (< pid (primitive/cast i32 0)) false
          (= pid (primitive/cast i32 0))
            (do
              (primitive/call-ptr
                (primitive/llvm-ir (fnptr c [i32] i64) [callback-address]
                  "%r = inttoptr i64 $0 to ptr\nret ptr %r")
                argument)
              (_exit (primitive/cast i32 0))
              false)
          :else
            (let [status (primitive/alloc-static i32)]
              (store! status 0)
              (if (!= (waitpid pid status (primitive/cast i32 0)) pid)
                  false
                  (= (primitive/iand (load status) (primitive/cast i32 127))
                     (primitive/cast i32 11)))))))

(defn trap [] (-> i64) (do (raise-trap) 0))
(defn trap-i32 [] (-> i32) (do (raise-trap) (primitive/cast i32 0)))
(defn trap-i64 [] (-> i64) (do (raise-trap) 0))
(defn trap-f32 [] (-> f32) (do (raise-trap) (primitive/cast f32 0)))
(defn trap-f64 [] (-> f64) (do (raise-trap) 0.0))
(defn trap-void [] (-> void) (raise-trap))

(defn b32 [(value bool)] (-> i32)
  (if value (primitive/cast i32 1) (primitive/cast i32 0)))

(defn f32-from-bits [(bits i32)] (-> f32)
  (let [place (primitive/alloc-stack i32)]
    (store! place bits)
    (load (primitive/cast (ptr f32) place))))

(defn f64-from-bits [(bits i64)] (-> f64)
  (let [place (primitive/alloc-stack i64)]
    (store! place bits)
    (load (primitive/cast (ptr f64) place))))

(defn f32-to-bits [(value f32)] (-> i32)
  (let [place (primitive/alloc-stack f32)]
    (store! place value)
    (load (primitive/cast (ptr i32) place))))

(defn f64-to-bits [(value f64)] (-> i64)
  (let [place (primitive/alloc-stack f64)]
    (store! place value)
    (load (primitive/cast (ptr i64) place))))

(defn f32-is-nan [(value f32)] (-> bool)
  (let [bits (f32-to-bits value)]
    (and (= (primitive/iand bits (primitive/cast i32 0x7f800000))
            (primitive/cast i32 0x7f800000))
         (!= (primitive/iand bits (primitive/cast i32 0x007fffff))
             (primitive/cast i32 0)))))
(defn f64-is-nan [(value f64)] (-> bool)
  (let [bits (f64-to-bits value)]
    (and (= (primitive/iand bits 0x7ff0000000000000) 0x7ff0000000000000)
         (!= (primitive/iand bits 0x000fffffffffffff) 0))))

(defn f32-canonical-nan [(value f32)] (-> i32)
  (b32 (= (primitive/iand (f32-to-bits value) (primitive/cast i32 0x7fffffff))
          (primitive/cast i32 0x7fc00000))))
(defn f32-arithmetic-nan [(value f32)] (-> i32)
  (b32 (= (primitive/iand (f32-to-bits value) (primitive/cast i32 0x7fc00000))
          (primitive/cast i32 0x7fc00000))))
(defn f64-canonical-nan [(value f64)] (-> i32)
  (b32 (= (primitive/iand (f64-to-bits value) 0x7fffffffffffffff)
          0x7ff8000000000000)))
(defn f64-arithmetic-nan [(value f64)] (-> i32)
  (b32 (= (primitive/iand (f64-to-bits value) 0x7ff8000000000000)
          0x7ff8000000000000)))

(defn f32-quiet-nan [(value f32)] (-> f32)
  (if (f32-is-nan value)
      (f32-from-bits
        (primitive/ior (f32-to-bits value) (primitive/cast i32 0x00400000)))
      value))
(defn f64-quiet-nan [(value f64)] (-> f64)
  (if (f64-is-nan value)
      (f64-from-bits (primitive/ior (f64-to-bits value) 0x0008000000000000))
      value))

(defn f32-eq [(x f32) (y f32)] (-> i32) (b32 (primitive/fcmp-eq x y)))
(defn f32-ne [(x f32) (y f32)] (-> i32) (b32 (not (primitive/fcmp-eq x y))))
(defn f32-lt [(x f32) (y f32)] (-> i32) (b32 (primitive/fcmp-lt x y)))
(defn f32-gt [(x f32) (y f32)] (-> i32) (b32 (primitive/fcmp-gt x y)))
(defn f32-le [(x f32) (y f32)] (-> i32) (b32 (primitive/fcmp-le x y)))
(defn f32-ge [(x f32) (y f32)] (-> i32) (b32 (primitive/fcmp-ge x y)))
(defn f64-eq [(x f64) (y f64)] (-> i32) (b32 (primitive/fcmp-eq x y)))
(defn f64-ne [(x f64) (y f64)] (-> i32) (b32 (not (primitive/fcmp-eq x y))))
(defn f64-lt [(x f64) (y f64)] (-> i32) (b32 (primitive/fcmp-lt x y)))
(defn f64-gt [(x f64) (y f64)] (-> i32) (b32 (primitive/fcmp-gt x y)))
(defn f64-le [(x f64) (y f64)] (-> i32) (b32 (primitive/fcmp-le x y)))
(defn f64-ge [(x f64) (y f64)] (-> i32) (b32 (primitive/fcmp-ge x y)))

(defn f32-add [(x f32) (y f32)] (-> f32) (f32-quiet-nan (primitive/fadd x y)))
(defn f32-sub [(x f32) (y f32)] (-> f32) (f32-quiet-nan (primitive/fsub x y)))
(defn f32-mul [(x f32) (y f32)] (-> f32) (f32-quiet-nan (primitive/fmul x y)))
(defn f32-div [(x f32) (y f32)] (-> f32) (f32-quiet-nan (primitive/fdiv x y)))
(defn f64-add [(x f64) (y f64)] (-> f64) (f64-quiet-nan (primitive/fadd x y)))
(defn f64-sub [(x f64) (y f64)] (-> f64) (f64-quiet-nan (primitive/fsub x y)))
(defn f64-mul [(x f64) (y f64)] (-> f64) (f64-quiet-nan (primitive/fmul x y)))
(defn f64-div [(x f64) (y f64)] (-> f64) (f64-quiet-nan (primitive/fdiv x y)))

(defn f32-abs [(x f32)] (-> f32)
  (f32-from-bits (primitive/iand (f32-to-bits x) (primitive/cast i32 0x7fffffff))))
(defn f32-neg [(x f32)] (-> f32)
  (f32-from-bits (primitive/ixor (f32-to-bits x) (primitive/cast i32 0x80000000))))
(defn f64-abs [(x f64)] (-> f64)
  (f64-from-bits (primitive/iand (f64-to-bits x) 0x7fffffffffffffff)))
(defn f64-neg [(x f64)] (-> f64)
  (f64-from-bits (primitive/ixor (f64-to-bits x) -9223372036854775808)))

(defn f32-ceil [(x f32)] (-> f32) (ceilf x))
(defn f32-floor [(x f32)] (-> f32) (floorf x))
(defn f32-trunc [(x f32)] (-> f32) (truncf x))
(defn f32-nearest [(x f32)] (-> f32) (nearbyintf x))
(defn f32-sqrt [(x f32)] (-> f32) (f32-quiet-nan (sqrtf x)))
(defn f64-ceil [(x f64)] (-> f64) (ceil x))
(defn f64-floor [(x f64)] (-> f64) (floor x))
(defn f64-trunc [(x f64)] (-> f64) (trunc x))
(defn f64-nearest [(x f64)] (-> f64) (nearbyint x))
(defn f64-sqrt [(x f64)] (-> f64) (f64-quiet-nan (sqrt x)))

(defn f32-min [(x f32) (y f32)] (-> f32)
  (if (f32-is-nan x) (f32-quiet-nan x)
      (if (f32-is-nan y) (f32-quiet-nan y)
          (if (primitive/fcmp-lt x y) x
              (if (primitive/fcmp-gt x y) y
                  (f32-from-bits
                    (primitive/ior (f32-to-bits x) (f32-to-bits y))))))))
(defn f32-max [(x f32) (y f32)] (-> f32)
  (if (f32-is-nan x) (f32-quiet-nan x)
      (if (f32-is-nan y) (f32-quiet-nan y)
          (if (primitive/fcmp-gt x y) x
              (if (primitive/fcmp-lt x y) y
                  (f32-from-bits
                    (primitive/iand (f32-to-bits x) (f32-to-bits y))))))))
(defn f64-min [(x f64) (y f64)] (-> f64)
  (if (f64-is-nan x) (f64-quiet-nan x)
      (if (f64-is-nan y) (f64-quiet-nan y)
          (if (primitive/fcmp-lt x y) x
              (if (primitive/fcmp-gt x y) y
                  (f64-from-bits
                    (primitive/ior (f64-to-bits x) (f64-to-bits y))))))))
(defn f64-max [(x f64) (y f64)] (-> f64)
  (if (f64-is-nan x) (f64-quiet-nan x)
      (if (f64-is-nan y) (f64-quiet-nan y)
          (if (primitive/fcmp-gt x y) x
              (if (primitive/fcmp-lt x y) y
                  (f64-from-bits
                    (primitive/iand (f64-to-bits x) (f64-to-bits y))))))))

(defn f32-copysign [(x f32) (y f32)] (-> f32)
  (f32-from-bits
