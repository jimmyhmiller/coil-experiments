(module experiments.wasm.runtime)

(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)

(extern sqrtf :cc c [f32] (-> f32))
(extern ceilf :cc c [f32] (-> f32))
(extern floorf :cc c [f32] (-> f32))
(extern truncf :cc c [f32] (-> f32))
(extern nearbyintf :cc c [f32] (-> f32))
(extern sqrt :cc c [f64] (-> f64))
(extern ceil :cc c [f64] (-> f64))
(extern floor :cc c [f64] (-> f64))
(extern trunc :cc c [f64] (-> f64))
(extern nearbyint :cc c [f64] (-> f64))

(defn trap [] (-> i64)
  (do (alloc/abort) 0))

(defn b32 [(value bool)] (-> i32)
  (if value (primitive/cast i32 1) (primitive/cast i32 0)))

(defn f32-from-bits [(bits i32)] (-> f32)
  (let [place (primitive/alloc-stack i32)]
    (store! place bits)
    (load (primitive/cast (ptr f32) place))))

(defn f64-from-bits [(bits i64)] (-> f64)
  (let [place (primitive/alloc-stack i64)]
    (store! place bits)
    (load (primitive/cast (ptr f64) place))))

(defn f32-to-bits [(value f32)] (-> i32)
  (let [place (primitive/alloc-stack f32)]
    (store! place value)
    (load (primitive/cast (ptr i32) place))))

(defn f64-to-bits [(value f64)] (-> i64)
  (let [place (primitive/alloc-stack f64)]
    (store! place value)
    (load (primitive/cast (ptr i64) place))))

(defn f32-is-nan [(value f32)] (-> bool)
  (let [bits (f32-to-bits value)]
    (and (= (primitive/iand bits (primitive/cast i32 0x7f800000))
            (primitive/cast i32 0x7f800000))
         (!= (primitive/iand bits (primitive/cast i32 0x007fffff))
             (primitive/cast i32 0)))))
(defn f64-is-nan [(value f64)] (-> bool)
  (let [bits (f64-to-bits value)]
    (and (= (primitive/iand bits 0x7ff0000000000000) 0x7ff0000000000000)
         (!= (primitive/iand bits 0x000fffffffffffff) 0))))

(defn f32-canonical-nan [(value f32)] (-> i32)
  (b32 (= (primitive/iand (f32-to-bits value) (primitive/cast i32 0x7fffffff))
          (primitive/cast i32 0x7fc00000))))
(defn f32-arithmetic-nan [(value f32)] (-> i32)
  (b32 (= (primitive/iand (f32-to-bits value) (primitive/cast i32 0x7fc00000))
          (primitive/cast i32 0x7fc00000))))
(defn f64-canonical-nan [(value f64)] (-> i32)
  (b32 (= (primitive/iand (f64-to-bits value) 0x7fffffffffffffff)
          0x7ff8000000000000)))
(defn f64-arithmetic-nan [(value f64)] (-> i32)
  (b32 (= (primitive/iand (f64-to-bits value) 0x7ff8000000000000)
          0x7ff8000000000000)))

(defn f32-quiet-nan [(value f32)] (-> f32)
  (if (f32-is-nan value)
      (f32-from-bits
        (primitive/ior (f32-to-bits value) (primitive/cast i32 0x00400000)))
      value))
(defn f64-quiet-nan [(value f64)] (-> f64)
  (if (f64-is-nan value)
      (f64-from-bits (primitive/ior (f64-to-bits value) 0x0008000000000000))
      value))

(defn f32-eq [(x f32) (y f32)] (-> i32) (b32 (primitive/fcmp-eq x y)))
(defn f32-ne [(x f32) (y f32)] (-> i32) (b32 (primitive/fcmp-ne x y)))
(defn f32-lt [(x f32) (y f32)] (-> i32) (b32 (primitive/fcmp-lt x y)))
(defn f32-gt [(x f32) (y f32)] (-> i32) (b32 (primitive/fcmp-gt x y)))
(defn f32-le [(x f32) (y f32)] (-> i32) (b32 (primitive/fcmp-le x y)))
(defn f32-ge [(x f32) (y f32)] (-> i32) (b32 (primitive/fcmp-ge x y)))
(defn f64-eq [(x f64) (y f64)] (-> i32) (b32 (primitive/fcmp-eq x y)))
(defn f64-ne [(x f64) (y f64)] (-> i32) (b32 (primitive/fcmp-ne x y)))
(defn f64-lt [(x f64) (y f64)] (-> i32) (b32 (primitive/fcmp-lt x y)))
(defn f64-gt [(x f64) (y f64)] (-> i32) (b32 (primitive/fcmp-gt x y)))
(defn f64-le [(x f64) (y f64)] (-> i32) (b32 (primitive/fcmp-le x y)))
(defn f64-ge [(x f64) (y f64)] (-> i32) (b32 (primitive/fcmp-ge x y)))

(defn f32-add [(x f32) (y f32)] (-> f32) (f32-quiet-nan (primitive/fadd x y)))
(defn f32-sub [(x f32) (y f32)] (-> f32) (f32-quiet-nan (primitive/fsub x y)))
(defn f32-mul [(x f32) (y f32)] (-> f32) (f32-quiet-nan (primitive/fmul x y)))
(defn f32-div [(x f32) (y f32)] (-> f32) (f32-quiet-nan (primitive/fdiv x y)))
(defn f64-add [(x f64) (y f64)] (-> f64) (f64-quiet-nan (primitive/fadd x y)))
(defn f64-sub [(x f64) (y f64)] (-> f64) (f64-quiet-nan (primitive/fsub x y)))
(defn f64-mul [(x f64) (y f64)] (-> f64) (f64-quiet-nan (primitive/fmul x y)))
(defn f64-div [(x f64) (y f64)] (-> f64) (f64-quiet-nan (primitive/fdiv x y)))

(defn f32-abs [(x f32)] (-> f32)
  (f32-from-bits (primitive/iand (f32-to-bits x) (primitive/cast i32 0x7fffffff))))
(defn f32-neg [(x f32)] (-> f32)
  (f32-from-bits (primitive/ixor (f32-to-bits x) (primitive/cast i32 0x80000000))))
(defn f64-abs [(x f64)] (-> f64)
  (f64-from-bits (primitive/iand (f64-to-bits x) 0x7fffffffffffffff)))
(defn f64-neg [(x f64)] (-> f64)
  (f64-from-bits (primitive/ixor (f64-to-bits x) -9223372036854775808)))

(defn f32-ceil [(x f32)] (-> f32) (ceilf x))
(defn f32-floor [(x f32)] (-> f32) (floorf x))
(defn f32-trunc [(x f32)] (-> f32) (truncf x))
(defn f32-nearest [(x f32)] (-> f32) (nearbyintf x))
(defn f32-sqrt [(x f32)] (-> f32) (f32-quiet-nan (sqrtf x)))
(defn f64-ceil [(x f64)] (-> f64) (ceil x))
(defn f64-floor [(x f64)] (-> f64) (floor x))
(defn f64-trunc [(x f64)] (-> f64) (trunc x))
(defn f64-nearest [(x f64)] (-> f64) (nearbyint x))
(defn f64-sqrt [(x f64)] (-> f64) (f64-quiet-nan (sqrt x)))

(defn f32-min [(x f32) (y f32)] (-> f32)
  (if (f32-is-nan x) (f32-quiet-nan x)
      (if (f32-is-nan y) (f32-quiet-nan y)
          (if (primitive/fcmp-lt x y) x
              (if (primitive/fcmp-gt x y) y
                  (f32-from-bits
                    (primitive/ior (f32-to-bits x) (f32-to-bits y))))))))
(defn f32-max [(x f32) (y f32)] (-> f32)
  (if (f32-is-nan x) (f32-quiet-nan x)
      (if (f32-is-nan y) (f32-quiet-nan y)
          (if (primitive/fcmp-gt x y) x
              (if (primitive/fcmp-lt x y) y
                  (f32-from-bits
                    (primitive/iand (f32-to-bits x) (f32-to-bits y))))))))
(defn f64-min [(x f64) (y f64)] (-> f64)
  (if (f64-is-nan x) (f64-quiet-nan x)
      (if (f64-is-nan y) (f64-quiet-nan y)
          (if (primitive/fcmp-lt x y) x
              (if (primitive/fcmp-gt x y) y
                  (f64-from-bits
                    (primitive/ior (f64-to-bits x) (f64-to-bits y))))))))
(defn f64-max [(x f64) (y f64)] (-> f64)
  (if (f64-is-nan x) (f64-quiet-nan x)
      (if (f64-is-nan y) (f64-quiet-nan y)
          (if (primitive/fcmp-gt x y) x
              (if (primitive/fcmp-lt x y) y
                  (f64-from-bits
                    (primitive/iand (f64-to-bits x) (f64-to-bits y))))))))

(defn f32-copysign [(x f32) (y f32)] (-> f32)
  (f32-from-bits
    (primitive/ior
      (primitive/iand (f32-to-bits x) (primitive/cast i32 0x7fffffff))
      (primitive/iand (f32-to-bits y) (primitive/cast i32 0x80000000)))))
(defn f64-copysign [(x f64) (y f64)] (-> f64)
  (f64-from-bits
    (primitive/ior
      (primitive/iand (f64-to-bits x) 0x7fffffffffffffff)
      (primitive/iand (f64-to-bits y) -9223372036854775808))))

(defn i32-eqz [(x i32)] (-> i32) (b32 (= x (primitive/cast i32 0))))
(defn i32-eq [(x i32) (y i32)] (-> i32) (b32 (= x y)))
(defn i32-ne [(x i32) (y i32)] (-> i32) (b32 (!= x y)))
(defn i32-lt-s [(x i32) (y i32)] (-> i32) (b32 (< x y)))
(defn i32-le-s [(x i32) (y i32)] (-> i32) (b32 (<= x y)))
(defn i32-gt-s [(x i32) (y i32)] (-> i32) (b32 (> x y)))
(defn i32-ge-s [(x i32) (y i32)] (-> i32) (b32 (>= x y)))
(defn i32-lt-u [(x i32) (y i32)] (-> i32)
  (b32 (< (primitive/cast u32 x) (primitive/cast u32 y))))
(defn i32-le-u [(x i32) (y i32)] (-> i32)
  (b32 (<= (primitive/cast u32 x) (primitive/cast u32 y))))
(defn i32-gt-u [(x i32) (y i32)] (-> i32)
  (b32 (> (primitive/cast u32 x) (primitive/cast u32 y))))
(defn i32-ge-u [(x i32) (y i32)] (-> i32)
  (b32 (>= (primitive/cast u32 x) (primitive/cast u32 y))))

(defn i64-eqz [(x i64)] (-> i32) (b32 (= x 0)))
(defn i64-eq [(x i64) (y i64)] (-> i32) (b32 (= x y)))
(defn i64-ne [(x i64) (y i64)] (-> i32) (b32 (!= x y)))
(defn i64-lt-s [(x i64) (y i64)] (-> i32) (b32 (< x y)))
(defn i64-le-s [(x i64) (y i64)] (-> i32) (b32 (<= x y)))
(defn i64-gt-s [(x i64) (y i64)] (-> i32) (b32 (> x y)))
(defn i64-ge-s [(x i64) (y i64)] (-> i32) (b32 (>= x y)))
(defn i64-lt-u [(x i64) (y i64)] (-> i32)
  (b32 (< (primitive/cast u64 x) (primitive/cast u64 y))))
(defn i64-le-u [(x i64) (y i64)] (-> i32)
  (b32 (<= (primitive/cast u64 x) (primitive/cast u64 y))))
(defn i64-gt-u [(x i64) (y i64)] (-> i32)
  (b32 (> (primitive/cast u64 x) (primitive/cast u64 y))))
(defn i64-ge-u [(x i64) (y i64)] (-> i32)
  (b32 (>= (primitive/cast u64 x) (primitive/cast u64 y))))

(defn i32-div-s [(x i32) (y i32)] (-> i32)
  (if (or (= y (primitive/cast i32 0))
          (and (= x (primitive/cast i32 -2147483648))
               (= y (primitive/cast i32 -1))))
      (do (trap) (primitive/cast i32 0))
      (primitive/idiv x y)))

(defn i32-div-u [(x i32) (y i32)] (-> i32)
  (if (= y (primitive/cast i32 0))
      (do (trap) (primitive/cast i32 0))
      (primitive/cast i32
        (primitive/udiv (primitive/cast u32 x) (primitive/cast u32 y)))))

(defn i32-rem-s [(x i32) (y i32)] (-> i32)
  (if (= y (primitive/cast i32 0))
      (do (trap) (primitive/cast i32 0))
      (if (and (= x (primitive/cast i32 -2147483648))
               (= y (primitive/cast i32 -1)))
          (primitive/cast i32 0)
          (primitive/irem x y))))

(defn i32-rem-u [(x i32) (y i32)] (-> i32)
  (if (= y (primitive/cast i32 0))
      (do (trap) (primitive/cast i32 0))
      (primitive/cast i32
        (primitive/urem (primitive/cast u32 x) (primitive/cast u32 y)))))

(defn i64-div-s [(x i64) (y i64)] (-> i64)
  (if (or (= y 0) (and (= x -9223372036854775808) (= y -1)))
      (do (trap) 0)
      (primitive/idiv x y)))

(defn i64-div-u [(x i64) (y i64)] (-> i64)
  (if (= y 0)
      (do (trap) 0)
      (primitive/cast i64
        (primitive/udiv (primitive/cast u64 x) (primitive/cast u64 y)))))

(defn i64-rem-s [(x i64) (y i64)] (-> i64)
  (if (= y 0)
      (do (trap) 0)
      (if (and (= x -9223372036854775808) (= y -1))
          0
          (primitive/irem x y))))

(defn i64-rem-u [(x i64) (y i64)] (-> i64)
  (if (= y 0)
      (do (trap) 0)
      (primitive/cast i64
        (primitive/urem (primitive/cast u64 x) (primitive/cast u64 y)))))

(defn i32-and [(x i32) (y i32)] (-> i32) (primitive/iand x y))
(defn i32-or [(x i32) (y i32)] (-> i32) (primitive/ior x y))
(defn i32-xor [(x i32) (y i32)] (-> i32) (primitive/ixor x y))
(defn i64-and [(x i64) (y i64)] (-> i64) (primitive/iand x y))
(defn i64-or [(x i64) (y i64)] (-> i64) (primitive/ior x y))
(defn i64-xor [(x i64) (y i64)] (-> i64) (primitive/ixor x y))

(defn i32-shl [(x i32) (y i32)] (-> i32)
  (primitive/ishl x (primitive/iand y (primitive/cast i32 31))))
(defn i32-shr-s [(x i32) (y i32)] (-> i32)
  (primitive/ishr x (primitive/iand y (primitive/cast i32 31))))
(defn i32-shr-u [(x i32) (y i32)] (-> i32)
  (primitive/cast i32
    (primitive/ishr (primitive/cast u32 x)
                    (primitive/cast u32 (primitive/iand y (primitive/cast i32 31))))))
(defn i64-shl [(x i64) (y i64)] (-> i64)
  (primitive/ishl x (primitive/iand y 63)))
(defn i64-shr-s [(x i64) (y i64)] (-> i64)
  (primitive/ishr x (primitive/iand y 63)))
(defn i64-shr-u [(x i64) (y i64)] (-> i64)
  (primitive/cast i64
    (primitive/ishr (primitive/cast u64 x)
                    (primitive/cast u64 (primitive/iand y 63)))))

(defn i32-rotl [(x i32) (y i32)] (-> i32)
  (let [n (primitive/iand y (primitive/cast i32 31))]
    (if (= n (primitive/cast i32 0))
        x
        (primitive/ior (i32-shl x n)
                       (i32-shr-u x (primitive/isub (primitive/cast i32 32) n))))))
(defn i32-rotr [(x i32) (y i32)] (-> i32)
  (let [n (primitive/iand y (primitive/cast i32 31))]
    (if (= n (primitive/cast i32 0))
        x
        (primitive/ior (i32-shr-u x n)
                       (i32-shl x (primitive/isub (primitive/cast i32 32) n))))))
(defn i64-rotl [(x i64) (y i64)] (-> i64)
  (let [n (primitive/iand y 63)]
    (if (= n 0) x
        (primitive/ior (i64-shl x n) (i64-shr-u x (primitive/isub 64 n))))))
(defn i64-rotr [(x i64) (y i64)] (-> i64)
  (let [n (primitive/iand y 63)]
    (if (= n 0) x
        (primitive/ior (i64-shr-u x n) (i64-shl x (primitive/isub 64 n))))))

(defn i32-clz [(x i32)] (-> i32)
  (let [u (primitive/cast u32 x) (mut n) 0 (mut i) 31 (mut done) false]
    (loop
      (if (load done)
          (break)
          (if (< (load i) 0)
              (store! done true)
              (if (!= (primitive/iand (primitive/ishr u (primitive/cast u32 (load i)))
                                      (primitive/cast u32 1))
                      (primitive/cast u32 0))
                  (store! done true)
                  (do (store! n (+ (load n) 1)) (store! i (- (load i) 1)))))))
    (primitive/cast i32 (load n))))

(defn i32-ctz [(x i32)] (-> i32)
  (let [u (primitive/cast u32 x) (mut n) 0 (mut i) 0 (mut done) false]
    (loop
      (if (load done)
          (break)
          (if (>= (load i) 32)
              (store! done true)
              (if (!= (primitive/iand (primitive/ishr u (primitive/cast u32 (load i)))
                                      (primitive/cast u32 1))
                      (primitive/cast u32 0))
                  (store! done true)
                  (do (store! n (+ (load n) 1)) (store! i (+ (load i) 1)))))))
    (primitive/cast i32 (load n))))

(defn i32-popcnt [(x i32)] (-> i32)
  (let [(mut u) (primitive/cast u32 x) (mut n) 0 (mut i) 0]
    (loop
      (if (>= (load i) 32)
          (break)
          (do
            (store! n (+ (load n)
                         (primitive/cast i64
                           (primitive/iand (load u) (primitive/cast u32 1)))))
            (store! u (primitive/ishr (load u) (primitive/cast u32 1)))
            (store! i (+ (load i) 1)))))
    (primitive/cast i32 (load n))))

(defn i64-clz [(x i64)] (-> i64)
  (let [u (primitive/cast u64 x) (mut n) 0 (mut i) 63 (mut done) false]
    (loop
      (if (load done)
          (break)
          (if (< (load i) 0)
              (store! done true)
              (if (!= (primitive/iand (primitive/ishr u (primitive/cast u64 (load i)))
                                      (primitive/cast u64 1))
                      (primitive/cast u64 0))
                  (store! done true)
                  (do (store! n (+ (load n) 1)) (store! i (- (load i) 1)))))))
    (load n)))

(defn i64-ctz [(x i64)] (-> i64)
  (let [u (primitive/cast u64 x) (mut n) 0 (mut i) 0 (mut done) false]
    (loop
      (if (load done)
          (break)
          (if (>= (load i) 64)
              (store! done true)
              (if (!= (primitive/iand (primitive/ishr u (primitive/cast u64 (load i)))
                                      (primitive/cast u64 1))
                      (primitive/cast u64 0))
                  (store! done true)
                  (do (store! n (+ (load n) 1)) (store! i (+ (load i) 1)))))))
    (load n)))

(defn i64-popcnt [(x i64)] (-> i64)
  (let [(mut u) (primitive/cast u64 x) (mut n) 0 (mut i) 0]
    (loop
      (if (>= (load i) 64)
          (break)
          (do
            (store! n (+ (load n)
                         (primitive/cast i64
                           (primitive/iand (load u) (primitive/cast u64 1)))))
            (store! u (primitive/ishr (load u) (primitive/cast u64 1)))
            (store! i (+ (load i) 1)))))
    (load n)))
