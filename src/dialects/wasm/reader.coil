(module experiments.wasm.reader)

(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.slice" :as slice)
(import "experiments.wasm.decoder" :as decoder)
(import "experiments.wasm.codegen" :as codegen)
(import "experiments.wasm.wat" :as wat)

(defn wasm-binary? [(source (slice u8))] (-> bool)
  (and (>= (slice/slice-len source) 4)
       (= (primitive/cast i64 (slice/slice-get source 0)) 0)
       (= (primitive/cast i64 (slice/slice-get source 1)) 0x61)
       (= (primitive/cast i64 (slice/slice-get source 2)) 0x73)
       (= (primitive/cast i64 (slice/slice-get source 3)) 0x6d)))

(defn suffix? [(text (slice u8)) (suffix (slice u8))] (-> bool)
  (let [n (slice/slice-len text)
        m (slice/slice-len suffix)]
    (if (< n m)
        false
        (let [(mut i) 0
              (mut equal) true]
          (loop
            (if (or (not (load equal)) (>= (load i) m))
                (break)
                (do
                  (if (!= (slice/slice-get text (+ (- n m) (load i)))
                          (slice/slice-get suffix (load i)))
                      (store! equal false)
                      0)
                  (store! i (+ (load i) 1)))))
          (load equal)))))

(defn argument-code [(a (dyn alloc/Allocator)) (text (slice u8))] (-> Code)
  (primitive/code-read text `(reader-config)))

(defn wasm-integer-code [(a (dyn alloc/Allocator)) (context Code)
                         (text (slice u8))] (-> Code)
  (let [n (slice/slice-len text)
        negative (and (> n 0) (= (slice/slice-get text 0) (primitive/cast u8 45)))
        (mut i) (if negative 1 0)
        (mut value) 0]
    (if (>= (load i) n)
        (primitive/error "WASM reader: expected integer bit pattern")
        (loop
          (if (>= (load i) n)
              (break)
              (let [b (primitive/cast i64 (slice/slice-get text (load i)))]
                (if (or (< b 48) (> b 57))
                    (primitive/error "WASM reader: expected integer bit pattern")
                    (do
                      (store! value
                              (primitive/iadd (primitive/imul (load value) 10)
                                              (- b 48)))
                      (store! i (+ (load i) 1))))))))
    (let [signed (if negative (primitive/isub 0 (load value)) (load value))]
      `~signed)))

(defn integer-argument [(a (dyn alloc/Allocator)) (context Code) (cast-id Code)
                        (i32-mode bool) (text (slice u8))] (-> Code)
  (let [raw (wasm-integer-code a context text)]
    (if i32-mode `(~cast-id i32 ~raw) raw)))

(defn decimal-natural [(a (dyn alloc/Allocator)) (context Code)
                       (text (slice u8))] (-> i64)
  (let [(mut value) 0
        (mut i) 0]
    (if (= (slice/slice-len text) 0)
        (primitive/error "WASM reader: expected decimal integer")
        (loop
          (if (>= (load i) (slice/slice-len text))
              (break)
              (let [b (primitive/cast i64 (slice/slice-get text (load i)))]
                (if (or (< b 48) (> b 57))
                    (primitive/error "WASM reader: expected decimal integer")
                    (do (store! value (+ (* (load value) 10) (- b 48)))
                        (store! i (+ (load i) 1))))))))
    (load value)))

(defn coil-export-name [(name (slice u8))] (-> (slice u8))
  (cond (= name "and") "wasm-and"
        (= name "or") "wasm-or"
        (= name "load") "wasm-load"
        (= name "while") "wasm-while"
        (= name "for") "wasm-for"
        (= name "block") "wasm-block"
        (= name "if") "wasm-if"
        (= name "return") "wasm-return"
        (= name "loop") "wasm-loop"
        :else name))

(defn assertion-chain [(a (dyn alloc/Allocator)) (context Code) (args Code)
                       (at i64) (i32-mode bool)] (-> Code)
  (if (>= at (primitive/code-count args))
      `0
      (if (> (+ at 3) (primitive/code-count args))
          (primitive/error "WASM reader: truncated batch assertion")
          (let [callee (primitive/datum->syntax
                         context
                         (coil-export-name
                           (primitive/code-str (primitive/code-nth args at))))
                cast-id (primitive/datum->syntax context "primitive/cast")
                expected (integer-argument
                           a context cast-id i32-mode
                           (primitive/code-str (primitive/code-nth args (+ at 1))))
                arity (decimal-natural a context
                        (primitive/code-str (primitive/code-nth args (+ at 2))))
                next (+ (+ at 3) arity)]
            (if (> next (primitive/code-count args))
                (primitive/error "WASM reader: truncated batch assertion arguments")
                (let [arguments (primitive/code-list-new)
                      (mut i) (+ at 3)]
                  (loop
                    (if (>= (load i) next)
                        (break)
                        (do
                          (primitive/code-list-push!
                            arguments
                            (integer-argument
                              a context cast-id i32-mode
                              (primitive/code-str (primitive/code-nth args (load i)))))
                          (store! i (+ (load i) 1)))))
                  (let [argument-list (primitive/code-list-done arguments)
                        rest (assertion-chain a context args next i32-mode)]
                    `(if (= (~callee ~@argument-list) ~expected) ~rest 1))))))))

(defn float-argument [(a (dyn alloc/Allocator)) (context Code) (cast-id Code)
                      (from-bits Code) (f32-mode bool) (text (slice u8))] (-> Code)
  (let [bits (wasm-integer-code a context text)]
    (if f32-mode
        `(~from-bits (~cast-id i32 ~bits))
        `(~from-bits ~bits))))

(defn float-assertion-chain [(a (dyn alloc/Allocator)) (context Code) (args Code)
                             (at i64) (f32-mode bool)] (-> Code)
  (if (>= at (primitive/code-count args))
      `0
      (if (> (+ at 3) (primitive/code-count args))
          (primitive/error "WASM reader: truncated float batch assertion")
          (let [callee (primitive/datum->syntax
                         context
                         (coil-export-name
                           (primitive/code-str (primitive/code-nth args at))))
                cast-id (primitive/datum->syntax context "primitive/cast")
                from-bits (primitive/datum->syntax
                            context (if f32-mode
                                        "wasmrt/f32-from-bits"
                                        "wasmrt/f64-from-bits"))
                to-bits (primitive/datum->syntax
                          context (if f32-mode
                                      "wasmrt/f32-to-bits"
                                      "wasmrt/f64-to-bits"))
                expected-raw (wasm-integer-code
                               a context
                               (primitive/code-str (primitive/code-nth args (+ at 1))))
                expected (if f32-mode `(~cast-id i32 ~expected-raw) expected-raw)
                arity (decimal-natural a context
                        (primitive/code-str (primitive/code-nth args (+ at 2))))
                next (+ (+ at 3) arity)]
            (if (> next (primitive/code-count args))
                (primitive/error "WASM reader: truncated float batch arguments")
                (let [arguments (primitive/code-list-new)
                      (mut i) (+ at 3)]
                  (loop
                    (if (>= (load i) next)
                        (break)
                        (do
                          (primitive/code-list-push!
                            arguments
                            (float-argument
                              a context cast-id from-bits f32-mode
                              (primitive/code-str (primitive/code-nth args (load i)))))
                          (store! i (+ (load i) 1)))))
                  (let [argument-list (primitive/code-list-done arguments)
                        rest (float-assertion-chain a context args next f32-mode)]
                    `(if (= (~to-bits (~callee ~@argument-list)) ~expected)
                         ~rest
                         1))))))))

(defn float-nan-chain [(a (dyn alloc/Allocator)) (context Code) (args Code)
                       (at i64) (f32-mode bool) (canonical bool)] (-> Code)
  (if (>= at (primitive/code-count args))
      `0
      (if (> (+ at 2) (primitive/code-count args))
          (primitive/error "WASM reader: truncated NaN batch assertion")
          (let [callee (primitive/datum->syntax
                         context
                         (coil-export-name
                           (primitive/code-str (primitive/code-nth args at))))
                cast-id (primitive/datum->syntax context "primitive/cast")
                from-bits (primitive/datum->syntax
                            context (if f32-mode
                                        "wasmrt/f32-from-bits"
                                        "wasmrt/f64-from-bits"))
                predicate (primitive/datum->syntax
                            context
                            (if f32-mode
                                (if canonical
                                    "wasmrt/f32-canonical-nan"
                                    "wasmrt/f32-arithmetic-nan")
                                (if canonical
                                    "wasmrt/f64-canonical-nan"
                                    "wasmrt/f64-arithmetic-nan")))
                arity (decimal-natural a context
                        (primitive/code-str (primitive/code-nth args (+ at 1))))
                next (+ (+ at 2) arity)]
            (if (> next (primitive/code-count args))
                (primitive/error "WASM reader: truncated NaN batch arguments")
                (let [arguments (primitive/code-list-new)
                      (mut i) (+ at 2)]
                  (loop
                    (if (>= (load i) next)
                        (break)
                        (do
                          (primitive/code-list-push!
                            arguments
                            (float-argument
                              a context cast-id from-bits f32-mode
                              (primitive/code-str (primitive/code-nth args (load i)))))
                          (store! i (+ (load i) 1)))))
                  (let [argument-list (primitive/code-list-done arguments)
                        rest (float-nan-chain
                               a context args next f32-mode canonical)]
                    `(if (= (~predicate (~callee ~@argument-list))
                            (~cast-id i32 1))
                         ~rest
                         1))))))))

(defn scalar-argument [(a (dyn alloc/Allocator)) (context Code) (type (slice u8))
                       (text (slice u8))] (-> Code)
  (let [cast-id (primitive/datum->syntax context "primitive/cast")
        bits (wasm-integer-code a context text)]
    (cond (= type "i32") `(~cast-id i32 ~bits)
          (= type "i64") bits
          (= type "f32")
            (let [from (primitive/datum->syntax context "wasmrt/f32-from-bits")]
              `(~from (~cast-id i32 ~bits)))
          (= type "f64")
            (let [from (primitive/datum->syntax context "wasmrt/f64-from-bits")]
              `(~from ~bits))
          :else (primitive/error "WASM reader: unsupported scalar assertion type"))))

(defn scalar-equality [(a (dyn alloc/Allocator)) (context Code)
                       (type (slice u8)) (actual Code) (expected-text (slice u8))]
                       (-> Code)
  (let [cast-id (primitive/datum->syntax context "primitive/cast")
        bits (wasm-integer-code a context expected-text)]
    (cond (= type "i32") `(= ~actual (~cast-id i32 ~bits))
          (= type "i64") `(= ~actual ~bits)
          (= type "void") `(do ~actual true)
          (= type "f32")
            (let [to (primitive/datum->syntax context "wasmrt/f32-to-bits")]
              `(= (~to ~actual) (~cast-id i32 ~bits)))
          (= type "f64")
            (let [to (primitive/datum->syntax context "wasmrt/f64-to-bits")]
              `(= (~to ~actual) ~bits))
          :else (primitive/error "WASM reader: unsupported scalar result type"))))

(defn scalar-assertion-chain [(a (dyn alloc/Allocator)) (context Code) (args Code)
                              (at i64)] (-> Code)
  (let [checks-builder (primitive/code-list-new)
        (mut cursor) at]
    (loop
      (if (>= (load cursor) (primitive/code-count args))
          (break)
          (if (> (+ (load cursor) 4) (primitive/code-count args))
              (primitive/error "WASM reader: truncated scalar batch assertion")
              (let [callee (primitive/datum->syntax
                             context
                             (coil-export-name
                               (primitive/code-str
                                 (primitive/code-nth args (load cursor)))))
                    result-type
                      (primitive/code-str (primitive/code-nth args (+ (load cursor) 1)))
                    expected
                      (primitive/code-str (primitive/code-nth args (+ (load cursor) 2)))
                    arity (decimal-natural
                            a context
                            (primitive/code-str
                              (primitive/code-nth args (+ (load cursor) 3))))
                    next (+ (+ (load cursor) 4) (* arity 2))]
                (if (> next (primitive/code-count args))
                    (primitive/error "WASM reader: truncated scalar batch arguments")
                    (let [arguments (primitive/code-list-new)
                          (mut i) (+ (load cursor) 4)]
                      (loop
                        (if (>= (load i) next)
                            (break)
                            (do
                              (primitive/code-list-push!
                                arguments
                                (scalar-argument
                                  a context
                                  (primitive/code-str
                                    (primitive/code-nth args (load i)))
                                  (primitive/code-str
                                    (primitive/code-nth args (+ (load i) 1)))))
                              (store! i (+ (load i) 2)))))
                      (let [argument-list (primitive/code-list-done arguments)
                            actual `(~callee ~@argument-list)]
                        (primitive/code-list-push!
                          checks-builder
                          (scalar-equality a context result-type actual expected))
                        (store! cursor next))))))))
    (let [checks (primitive/code-list-done checks-builder)
          forms-builder (primitive/code-list-new)
          label `:wasm-scalar-assertions
          (mut i) 0]
      (loop
        (if (>= (load i) (primitive/code-count checks))
            (break)
            (do
              (primitive/code-list-push!
                forms-builder
                `(if ~(primitive/code-nth checks (load i))
                     0
                     (break ~label 1)))
              (store! i (+ (load i) 1)))))
      (let [forms (primitive/code-list-done forms-builder)]
        `(loop ~label (do ~@forms (break ~label 0)))))))

(defn scalar-invoke-main [(a (dyn alloc/Allocator)) (context Code) (args Code)]
                         (-> Code)
  (if (< (primitive/code-count args) 4)
      (primitive/error "WASM reader: expected --invoke-scalar EXPORT ARITY [TYPE VALUE]...")
      (let [callee (primitive/datum->syntax
                     context
                     (coil-export-name
                       (primitive/code-str (primitive/code-nth args 2))))
            arity (decimal-natural a context
                    (primitive/code-str (primitive/code-nth args 3)))
            wanted (+ 4 (* arity 2))]
        (if (!= wanted (primitive/code-count args))
            (primitive/error "WASM reader: scalar invocation argument count mismatch")
            (let [arguments (primitive/code-list-new)
                  (mut i) 4]
              (loop
                (if (>= (load i) wanted)
                    (break)
                    (do
                      (primitive/code-list-push!
                        arguments
                        (scalar-argument
                          a context
                          (primitive/code-str (primitive/code-nth args (load i)))
                          (primitive/code-str (primitive/code-nth args (+ (load i) 1)))))
                      (store! i (+ (load i) 2)))))
              (let [argument-list (primitive/code-list-done arguments)]
                `(do (~callee ~@argument-list) 0)))))))

;; Direct reader invocations can execute an exported integer function. This is
;; both a convenient CLI and the semantic conformance harness entry point:
;;   coil run m.wasm --use experiments.wasm.lang -- --assert-i32 add 42 20 22
;; Arguments after the expected value use the selected integer type.
(defn assertion-main [(a (dyn alloc/Allocator)) (context Code) (args Code)] (-> Code)
  (let [mode (primitive/code-str (primitive/code-nth args 1))
        i32-mode (= mode "--assert-i32")
        i64-mode (= mode "--assert-i64")
        i32-batch (= mode "--assert-i32-batch")
        i64-batch (= mode "--assert-i64-batch")
        f32-batch (= mode "--assert-f32-batch")
        f64-batch (= mode "--assert-f64-batch")
        f32-canonical (= mode "--assert-f32-canonical-nan-batch")
        f64-canonical (= mode "--assert-f64-canonical-nan-batch")
        f32-arithmetic (= mode "--assert-f32-arithmetic-nan-batch")
        f64-arithmetic (= mode "--assert-f64-arithmetic-nan-batch")
        scalar-batch (= mode "--assert-scalar-batch")
        scalar-invoke (= mode "--invoke-scalar")]
    (if scalar-invoke
        (scalar-invoke-main a context args)
        (if scalar-batch
        (scalar-assertion-chain a context args 2)
        (if (or (or f32-canonical f64-canonical)
            (or f32-arithmetic f64-arithmetic))
        (float-nan-chain a context args 2
                         (or f32-canonical f32-arithmetic)
                         (or f32-canonical f64-canonical))
        (if (or f32-batch f64-batch)
        (float-assertion-chain a context args 2 f32-batch)
        (if (or i32-batch i64-batch)
        (assertion-chain a context args 2 i32-batch)
        (if (or (not (or i32-mode i64-mode)) (< (primitive/code-count args) 4))
        (primitive/error "WASM reader: expected --assert-i32|--assert-i64 EXPORT EXPECTED [ARGS...]")
        (let [callee (primitive/datum->syntax
                       context
                       (coil-export-name
                         (primitive/code-str (primitive/code-nth args 2))))
              cast-id (primitive/datum->syntax context "primitive/cast")
              expected-raw (wasm-integer-code
                             a context (primitive/code-str (primitive/code-nth args 3)))
              arguments (primitive/code-list-new)
              (mut i) 4]
          (loop
            (if (>= (load i) (primitive/code-count args))
                (break)
                (let [raw (wasm-integer-code
                            a context
                            (primitive/code-str (primitive/code-nth args (load i))))]
                  (primitive/code-list-push!
                    arguments
                    (if i32-mode `(~cast-id i32 ~raw) raw))
                  (store! i (+ (load i) 1)))))
          (let [argument-list (primitive/code-list-done arguments)
                expected (if i32-mode `(~cast-id i32 ~expected-raw) expected-raw)]
            `(if (= (~callee ~@argument-list) ~expected) 0 1)))))))))))

(defn generated-main [(a (dyn alloc/Allocator)) (context Code)] (-> Code)
  (let [args (primitive/code-nth context 5)]
    (if (> (primitive/code-count args) 1)
        (assertion-main a context args)
        `0)))

;; Initial reader entry. Binary validation is already Coil-native; section
;; decoding and code generation are added feature group by feature group.
(defn read-wasm [(context Code)] (-> Code)
  (let [source (primitive/code-str (primitive/code-nth context 2))
        path (primitive/code-str (primitive/code-nth context 1))
        main-name (primitive/datum->syntax context "main")
        instantiate-name (primitive/datum->syntax context "__coil_wasm_instantiate")
        main-body (generated-main (alloc/malloc-allocator) context)]
    (if (suffix? path ".wat")
        (let [source-code (primitive/code-nth `(source ~source) 1)
              parsed (primitive/code-read source-code `(reader-config))
              functions (wat/compile-wat (alloc/malloc-allocator) context parsed)]
          `(do
             (module wasm-program)
             (import "coil.primitive" :as primitive)
             (import "coil.control" :as control)
             (import "experiments.wasm.runtime" :as wasmrt)
             ~@functions
             (defn ~main-name [] (-> i64) ~main-body)))
        (match (decoder/module-sections source)
          (decoder/DecodeError [at message]
            (primitive/error message))
          (decoder/Decoded [sections]
            (let [functions (codegen/compile-defined-functions
                              (alloc/malloc-allocator) context sections)]
              `(do
                 (module wasm-program)
                 (import "coil.primitive" :as primitive)
                 (import "coil.control" :as control)
                 (import "experiments.wasm.runtime" :as wasmrt)
                 ~@functions
                 (defn ~main-name [] (-> i64)
                   (do (~instantiate-name) ~main-body)))))))))
