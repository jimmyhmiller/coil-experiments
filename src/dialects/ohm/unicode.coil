(module experiments.ohm.unicode)

(import "coil.primitive" :as primitive)
(import "coil.slice" :use [slice-get slice-len])
(import "coil.str" :as str)

;;; Generated from the Unicode 17.0 property escapes exposed by Node 26.5.0.
;;; Each record is an inclusive scalar range encoded as two six-digit hex values.
(const UNICODE-VERSION "17.0")

;;; BMP code units whose JavaScript `toUpperCase()` strings are equal share a
;;; group. Supplementary scalars compare exactly because Ohm iterates UTF-16
;;; code units, so their surrogate pairs are never case-mapped as scalars.
(const UNICODE-CASE-EQUIVALENCE "")

(const UNICODE_CC "00000000001f00007f00009f")
(const UNICODE_CF "0000ad0000ad00060000060500061c00061c0006dd0006dd00070f00070f0008900008910008e20008e200180e00180e00200b00200f00202a00202e00206000206400206600206f00feff00feff00fff900fffb0110bd0110bd0110cd0110cd01343001343f01bca001bca301d17301d17a0e00010e00010e00200e007f")
(const UNICODE_CN "")
(const UNICODE_CO "00e00000f8ff0f00000ffffd10000010fffd")
(const UNICODE_CS "00d80000dfff")
(const UNICODE_LL "")
(const UNICODE_LM "")
(const UNICODE_LO "")
(const UNICODE_LT "0001c50001c50001c80001c80001cb0001cb0001f20001f2001f88001f8f001f98001f9f001fa8001faf001fbc001fbc001fcc001fcc001ffc001ffc")
(const UNICODE_LU "")
(const UNICODE_MC "")
(const UNICODE_ME "000488000489001abe001abe0020dd0020e00020e20020e400a67000a672")
(const UNICODE_MN "")
(const UNICODE_ND "")
(const UNICODE_NL "0016ee0016f000216000218200218500218800300700300700302100302900303800303a00a6e600a6ef01014001017401034101034101034a01034a0103d10103d501240001246e016ff4016ff6")
(const UNICODE_NO "")
(const UNICODE_PC "00005f00005f00203f00204000205400205400fe3300fe3400fe4d00fe4f00ff3f00ff3f")
(const UNICODE_PD "00002d00002d00058a00058a0005be0005be001400001400001806001806002010002015002e17002e17002e1a002e1a002e3a002e3b002e40002e40002e5d002e5d00301c00301c0030300030300030a00030a000fe3100fe3200fe5800fe5800fe6300fe6300ff0d00ff0d010d6e010d6e010ead010ead")
(const UNICODE_PE "")
(const UNICODE_PF "0000bb0000bb00201900201900201d00201d00203a00203a002e03002e03002e05002e05002e0a002e0a002e0d002e0d002e1d002e1d002e21002e21")
(const UNICODE_PI "0000ab0000ab00201800201800201b00201c00201f00201f002039002039002e02002e02002e04002e04002e09002e09002e0c002e0c002e1c002e1c002e20002e20")
(const UNICODE_PO "")
(const UNICODE_PS "")
(const UNICODE_SC "0000240000240000a20000a500058f00058f00060b00060b0007fe0007ff0009f20009f30009fb0009fb000af1000af1000bf9000bf9000e3f000e3f0017db0017db0020a00020c100a83800a83800fdfc00fdfc00fe6900fe6900ff0400ff0400ffe000ffe100ffe500ffe6011fdd011fe001e2ff01e2ff01ecb001ecb0")
(const UNICODE_SK "")
(const UNICODE_SM "")
(const UNICODE_SO "")
(const UNICODE_ZL "002028002028")
(const UNICODE_ZP "002029002029")
(const UNICODE_ZS "0000200000200000a00000a000168000168000200000200a00202f00202f00205f00205f003000003000")
(const UNICODE_LTMO "")
(const UNICODE_XID_START "")
(const UNICODE_XID_CONTINUE "")
(const UNICODE_WHITE_SPACE "00000900000d0000200000200000850000850000a00000a000168000168000200000200a00202800202900202f00202f00205f00205f003000003000")

(defn unicode-hex-digit [(byte u8)] (-> i64)
  (let [value (primitive/cast i64 byte)]
    (cond (and (>= value 48) (<= value 57)) (- value 48)
          (and (>= value 97) (<= value 102)) (+ (- value 97) 10)
          :else (+ (- value 65) 10))))

(defn unicode-hex6 [(ranges (slice u8)) (at i64)] (-> i64)
  (let [(mut value) 0]
    (for [index 0 6]
      (set! value (+ (* (load value) 16)
                     (unicode-hex-digit (slice-get ranges (+ at index))))))
    (load value)))

(defn unicode-in-ranges? [(scalar i64) (ranges (slice u8))] (-> bool)
  (let [(mut low) 0
        (mut high) (/ (slice-len ranges) 12)
        (mut found) false]
    (loop (if (or (load found) (>= (load low) (load high)))
              (break)
              (let [middle (/ (+ (load low) (load high)) 2)
                    at (* middle 12)
                    first (unicode-hex6 ranges at)
                    last (unicode-hex6 ranges (+ at 6))]
                (cond (< scalar first) (set! high middle)
                      (> scalar last) (set! low (+ middle 1))
                      :else (set! found true)))))
    (load found)))

(defn unicode-case-equivalence-group [(scalar i64)] (-> i64)
  (if (> scalar 65535)
      0
      (let [(mut low) 0
            (mut high) (/ (slice-len UNICODE-CASE-EQUIVALENCE) 12)
            (mut group) 0]
        (loop (if (or (> (load group) 0) (>= (load low) (load high)))
                  (break)
                  (let [middle (/ (+ (load low) (load high)) 2)
                        at (* middle 12)
                        candidate (unicode-hex6 UNICODE-CASE-EQUIVALENCE at)]
                    (cond (< scalar candidate) (set! high middle)
                          (> scalar candidate) (set! low (+ middle 1))
                          :else
                            (set! group
                                  (unicode-hex6 UNICODE-CASE-EQUIVALENCE (+ at 6)))))))
        (load group))))

(defn unicode-case-insensitive-eq? [(left i64) (right i64)] (-> bool)
  (if (= left right)
      true
      (let [left-group (unicode-case-equivalence-group left)]
        (and (> left-group 0)
             (= left-group (unicode-case-equivalence-group right))))))

(defn unicode-property? [(scalar i64) (property (slice u8))] (-> bool)
  (cond
    (str/str-eq property "Cc") (unicode-in-ranges? scalar UNICODE_CC)
    (str/str-eq property "Cf") (unicode-in-ranges? scalar UNICODE_CF)
    (str/str-eq property "Cn") (unicode-in-ranges? scalar UNICODE_CN)
    (str/str-eq property "Co") (unicode-in-ranges? scalar UNICODE_CO)
    (str/str-eq property "Cs") (unicode-in-ranges? scalar UNICODE_CS)
    (str/str-eq property "Ll") (unicode-in-ranges? scalar UNICODE_LL)
    (str/str-eq property "Lm") (unicode-in-ranges? scalar UNICODE_LM)
    (str/str-eq property "Lo") (unicode-in-ranges? scalar UNICODE_LO)
    (str/str-eq property "Lt") (unicode-in-ranges? scalar UNICODE_LT)
    (str/str-eq property "Lu") (unicode-in-ranges? scalar UNICODE_LU)
    (str/str-eq property "Mc") (unicode-in-ranges? scalar UNICODE_MC)
    (str/str-eq property "Me") (unicode-in-ranges? scalar UNICODE_ME)
    (str/str-eq property "Mn") (unicode-in-ranges? scalar UNICODE_MN)
    (str/str-eq property "Nd") (unicode-in-ranges? scalar UNICODE_ND)
    (str/str-eq property "Nl") (unicode-in-ranges? scalar UNICODE_NL)
    (str/str-eq property "No") (unicode-in-ranges? scalar UNICODE_NO)
    (str/str-eq property "Pc") (unicode-in-ranges? scalar UNICODE_PC)
    (str/str-eq property "Pd") (unicode-in-ranges? scalar UNICODE_PD)
    (str/str-eq property "Pe") (unicode-in-ranges? scalar UNICODE_PE)
    (str/str-eq property "Pf") (unicode-in-ranges? scalar UNICODE_PF)
    (str/str-eq property "Pi") (unicode-in-ranges? scalar UNICODE_PI)
    (str/str-eq property "Po") (unicode-in-ranges? scalar UNICODE_PO)
    (str/str-eq property "Ps") (unicode-in-ranges? scalar UNICODE_PS)
    (str/str-eq property "Sc") (unicode-in-ranges? scalar UNICODE_SC)
    (str/str-eq property "Sk") (unicode-in-ranges? scalar UNICODE_SK)
    (str/str-eq property "Sm") (unicode-in-ranges? scalar UNICODE_SM)
    (str/str-eq property "So") (unicode-in-ranges? scalar UNICODE_SO)
    (str/str-eq property "Zl") (unicode-in-ranges? scalar UNICODE_ZL)
    (str/str-eq property "Zp") (unicode-in-ranges? scalar UNICODE_ZP)
    (str/str-eq property "Zs") (unicode-in-ranges? scalar UNICODE_ZS)
    (str/str-eq property "Ltmo") (unicode-in-ranges? scalar UNICODE_LTMO)
    (str/str-eq property "XID_Start") (unicode-in-ranges? scalar UNICODE_XID_START)
    (str/str-eq property "XID_Continue") (unicode-in-ranges? scalar UNICODE_XID_CONTINUE)
    (str/str-eq property "White_Space") (unicode-in-ranges? scalar UNICODE_WHITE_SPACE)
    :else false))

(defn unicode-property-ranges [(property (slice u8))] (-> (slice u8))
  (cond
    (str/str-eq property "Cc") UNICODE_CC
    (str/str-eq property "Cf") UNICODE_CF
    (str/str-eq property "Cn") UNICODE_CN
    (str/str-eq property "Co") UNICODE_CO
    (str/str-eq property "Cs") UNICODE_CS
    (str/str-eq property "Ll") UNICODE_LL
    (str/str-eq property "Lm") UNICODE_LM
    (str/str-eq property "Lo") UNICODE_LO
    (str/str-eq property "Lt") UNICODE_LT
    (str/str-eq property "Lu") UNICODE_LU
    (str/str-eq property "Mc") UNICODE_MC
    (str/str-eq property "Me") UNICODE_ME
    (str/str-eq property "Mn") UNICODE_MN
    (str/str-eq property "Nd") UNICODE_ND
    (str/str-eq property "Nl") UNICODE_NL
    (str/str-eq property "No") UNICODE_NO
    (str/str-eq property "Pc") UNICODE_PC
    (str/str-eq property "Pd") UNICODE_PD
    (str/str-eq property "Pe") UNICODE_PE
    (str/str-eq property "Pf") UNICODE_PF
    (str/str-eq property "Pi") UNICODE_PI
    (str/str-eq property "Po") UNICODE_PO
    (str/str-eq property "Ps") UNICODE_PS
    (str/str-eq property "Sc") UNICODE_SC
    (str/str-eq property "Sk") UNICODE_SK
    (str/str-eq property "Sm") UNICODE_SM
    (str/str-eq property "So") UNICODE_SO
    (str/str-eq property "Zl") UNICODE_ZL
    (str/str-eq property "Zp") UNICODE_ZP
    (str/str-eq property "Zs") UNICODE_ZS
    (str/str-eq property "Ltmo") UNICODE_LTMO
    (str/str-eq property "XID_Start") UNICODE_XID_START
    (str/str-eq property "XID_Continue") UNICODE_XID_CONTINUE
    (str/str-eq property "White_Space") UNICODE_WHITE_SPACE
    :else ""))

(defn unicode-lower? [(scalar i64)] (-> bool)
  (unicode-in-ranges? scalar UNICODE_LL))

(defn unicode-upper? [(scalar i64)] (-> bool)
  (unicode-in-ranges? scalar UNICODE_LU))

(defn unicode-ltmo? [(scalar i64)] (-> bool)
  (unicode-in-ranges? scalar UNICODE_LTMO))

(defn unicode-letter? [(scalar i64)] (-> bool)
  (or (unicode-lower? scalar)
      (or (unicode-upper? scalar) (unicode-ltmo? scalar))))
