(module experiments.ohm.pretty-print-reader)

(import "coil.primitive" :as primitive)
(import "experiments.ohm.reader" :as ohm-reader)

(defn read-ohm-pretty-print [(context Code)] (-> Code)
  (let [formatted
          (ohm-reader/pretty-print-ohm-source
            context
            (primitive/code-str (get context 2)))
        value-name
          (primitive/datum->syntax context (primitive/code-symbol "pretty-printed"))
        main-name (primitive/datum->syntax context (primitive/code-symbol "main"))]
    `(do
       (module ohm.pretty-print.generated)
       (import "coil.io" :use [])
       (defn ~value-name [] (-> (slice u8)) ~formatted)
       (defn ~main-name [] (-> i64)
         (coil.io.print-str (coil.io.stdout) (~value-name))
         (coil.io.print-str (coil.io.stdout) "\n")
         0))))
