            (push! (mut parse-from-builder) `[(~input (slice u8)) (~requested-rule (slice u8))])
            (push! (mut parse-from-builder) `(-> bool))
            (push! (mut parse-from-builder) parse-from-body)
            (push! (mut to-ast-builder) (primitive/code-symbol "defn"))
            (push! (mut to-ast-builder) to-ast-name)
            (push! (mut to-ast-builder) `[(~input (slice u8))])
            (push! (mut to-ast-builder) `(-> experiments.ohm.runtime.OhmAst))
            (push! (mut to-ast-builder) to-ast-body)
            (push! (mut to-ast-from-builder) (primitive/code-symbol "defn"))
            (push! (mut to-ast-from-builder) to-ast-from-name)
            (push! (mut to-ast-from-builder)
                   `[(~input (slice u8)) (~requested-rule (slice u8))])
            (push! (mut to-ast-from-builder) `(-> experiments.ohm.runtime.OhmAst))
            (push! (mut to-ast-from-builder) to-ast-from-body)
            (push! (mut semantics-for-to-ast-builder) (primitive/code-symbol "defn"))
            (push! (mut semantics-for-to-ast-builder) semantics-for-to-ast-name)
            (push! (mut semantics-for-to-ast-builder) `[])
            (push! (mut semantics-for-to-ast-builder)
                   `(-> experiments.ohm.runtime.OhmToAstSemantics))
            (push! (mut semantics-for-to-ast-builder)
                   `(experiments.ohm.runtime.new-to-ast-semantics
                      ~(load effective-grammar-name)
                      (~grammar-token-name)))
            (push! (mut to-recipe-builder) (primitive/code-symbol "defn"))
            (push! (mut to-recipe-builder) to-recipe-name)
            (push! (mut to-recipe-builder) `[])
            (push! (mut to-recipe-builder) `(-> (slice u8)))
            (push! (mut to-recipe-builder) `~direct-recipe)
            (push! (mut matcher-builder) (primitive/code-symbol "defn"))
            (push! (mut matcher-builder) matcher-name)
            (push! (mut matcher-builder) `[])
            (push! (mut matcher-builder) `(-> experiments.ohm.runtime.OhmMatcher))
            (push! (mut matcher-builder)
                   `(experiments.ohm.runtime.ohm-grammar-owned-matcher
                      (~grammar-object-name)))
            (push! (mut main-builder) (primitive/code-symbol "defn"))
            (push! (mut main-builder) main-name)
            (push! (mut main-builder) `[])
            (push! (mut main-builder) `(-> i64))
            (push! (mut main-builder) main-body)
            (push! (mut grammar-token-builder) (primitive/code-symbol "defn"))
            (push! (mut grammar-token-builder) grammar-token-name)
            (push! (mut grammar-token-builder) `[])
            (push! (mut grammar-token-builder) `(-> (ptr u8)))
            (push! (mut grammar-token-builder)
                   `(cast (ptr u8) (fnptr-of ~grammar-token-name)))
            (push! (mut grammar-descriptor-builder) (primitive/code-symbol "defn"))
            (push! (mut grammar-descriptor-builder) grammar-descriptor-name)
            (push! (mut grammar-descriptor-builder) `[])
            (push! (mut grammar-descriptor-builder)
                   `(-> experiments.ohm.runtime.OhmGrammarDescriptor))
            (push! (mut grammar-descriptor-builder)
                   `(experiments.ohm.runtime.new-ohm-grammar-descriptor
                      ~(load effective-grammar-name)
                      ~start-rule-text
                      ~(load supergrammar-name)
                      ~grammar-fingerprint-text))
            (push! (mut grammar-pexprs-builder) (primitive/code-symbol "defn"))
            (push! (mut grammar-pexprs-builder) grammar-pexprs-name)
            (push! (mut grammar-pexprs-builder) `[])
            (push! (mut grammar-pexprs-builder)
                   `(-> experiments.ohm.runtime.OhmPExprGrammar))
            (push! (mut grammar-pexprs-builder)
                   `(experiments.ohm.pexprs.ohm-pexprs-from-recipe
                      ~direct-recipe
                      ~source
                      (coil.alloc.malloc-allocator)))
            (push! (mut proto-built-in-token-builder) (primitive/code-symbol "defn"))
            (push! (mut proto-built-in-token-builder) proto-built-in-token-name)
            (push! (mut proto-built-in-token-builder) `[])
            (push! (mut proto-built-in-token-builder) `(-> (ptr u8)))
            (push! (mut proto-built-in-token-builder)
                   `(cast (ptr u8) (fnptr-of ~proto-built-in-token-name)))
            (push! (mut built-in-token-builder) (primitive/code-symbol "defn"))
            (push! (mut built-in-token-builder) built-in-token-name)
            (push! (mut built-in-token-builder) `[])
            (push! (mut built-in-token-builder) `(-> (ptr u8)))
            (push! (mut built-in-token-builder)
                   `(cast (ptr u8) (fnptr-of ~built-in-token-name)))
            (push! (mut proto-built-in-object-builder) (primitive/code-symbol "defn"))
            (push! (mut proto-built-in-object-builder) proto-built-in-object-name)
            (push! (mut proto-built-in-object-builder) `[])
            (push! (mut proto-built-in-object-builder)
                   `(-> experiments.ohm.runtime.OhmGrammar))
            (push! (mut proto-built-in-object-builder)
                   `(let [(mut proto)
                            (experiments.ohm.runtime.new-ohm-grammar
                              (experiments.ohm.runtime.new-ohm-grammar-descriptor
                                "ProtoBuiltInRules" "" "" "ProtoBuiltInRules")
                              (experiments.ohm.pexprs.new-proto-built-in-pexprs
                                (coil.alloc.malloc-allocator))
                              (fnptr-of ~parse-tree-from-name)
                              (fnptr-of ~parse-tree-from-cached-name)
                              "" ""
                              (experiments.ohm.runtime.ohm-proto-built-in-action-dictionary-template)
                              (~proto-built-in-token-name) false
                              (coil.alloc.malloc-allocator))]
                      (experiments.ohm.runtime.set-ohm-grammar-built-in! (mut proto))
                      (load proto)))
            (push! (mut built-in-object-builder) (primitive/code-symbol "defn"))
            (push! (mut built-in-object-builder) built-in-object-name)
            (push! (mut built-in-object-builder) `[])
            (push! (mut built-in-object-builder)
                   `(-> experiments.ohm.runtime.OhmGrammar))
            (push! (mut built-in-object-builder)
                   `(let [(mut built-in)
                            (experiments.ohm.runtime.new-ohm-grammar
                              (experiments.ohm.runtime.new-ohm-grammar-descriptor
                                "BuiltInRules" "" "ProtoBuiltInRules" "BuiltInRules")
                              (experiments.ohm.pexprs.new-built-in-pexprs
                                (coil.alloc.malloc-allocator))
                              (fnptr-of ~parse-tree-from-name)
                              (fnptr-of ~parse-tree-from-cached-name)
                              "" ""
                              (experiments.ohm.runtime.ohm-built-in-action-dictionary-template)
                              (~built-in-token-name) false
                              (coil.alloc.malloc-allocator))]
                      (experiments.ohm.runtime.set-ohm-grammar-supergrammar-factory!
                        (mut built-in)
                        (fnptr-of ~proto-built-in-object-name))
                      (experiments.ohm.runtime.set-ohm-grammar-built-in! (mut built-in))
                      (load built-in)))
            (push! (mut indentation-token-builder) (primitive/code-symbol "defn"))
            (push! (mut indentation-token-builder) indentation-token-name)
            (push! (mut indentation-token-builder) `[])
            (push! (mut indentation-token-builder) `(-> (ptr u8)))
            (push! (mut indentation-token-builder)
                   `(cast (ptr u8) (fnptr-of ~indentation-token-name)))
            (push! (mut indentation-object-builder) (primitive/code-symbol "defn"))
            (push! (mut indentation-object-builder) indentation-object-name)
            (push! (mut indentation-object-builder) `[])
            (push! (mut indentation-object-builder)
                   `(-> experiments.ohm.runtime.OhmGrammar))
            (push! (mut indentation-object-builder)
                   `(let [(mut indentation-grammar)
                            (experiments.ohm.runtime.new-ohm-grammar
                              (experiments.ohm.runtime.new-ohm-grammar-descriptor
                                "IndentationSensitive" "" "BuiltInRules"
                                "IndentationSensitive")
                              (experiments.ohm.pexprs.new-indentation-sensitive-pexprs
                                (coil.alloc.malloc-allocator))
                              (fnptr-of ~parse-tree-from-name)
                              (fnptr-of ~parse-tree-from-cached-name)
                              "" ""
                              (experiments.ohm.runtime.ohm-indentation-action-dictionary-template)
                              (~indentation-token-name) true
                              (coil.alloc.malloc-allocator))]
                      (experiments.ohm.runtime.set-ohm-grammar-supergrammar-factory!
                        (mut indentation-grammar)
                        (fnptr-of ~standalone-built-in-object-name))
                      (load indentation-grammar)))
            (push! (mut grammar-object-builder) (primitive/code-symbol "defn"))
            (push! (mut grammar-object-builder) grammar-object-name)
            (push! (mut grammar-object-builder) `[])
            (push! (mut grammar-object-builder)
                   `(-> experiments.ohm.runtime.OhmGrammar))
            (push! (mut grammar-object-builder)
                   `(let [(mut public-grammar)
                            (experiments.ohm.runtime.new-ohm-grammar
                              (~grammar-descriptor-name)
                              (~grammar-pexprs-name)
                              (fnptr-of ~parse-tree-from-name)
                              (fnptr-of ~parse-tree-from-cached-name)
                              ~direct-recipe
                              ~source
                              ~action-template-text
                              (~grammar-token-name)
                              ~indentation-sensitive
                              (coil.alloc.malloc-allocator))]
                      (experiments.ohm.runtime.set-ohm-grammar-supergrammar-factory!
                        (mut public-grammar)
                        (fnptr-of ~(if (str/str-eq
                                        (load effective-grammar-name)
                                        "BuiltInRules")
                                      proto-built-in-object-name
                                      (if indentation-sensitive
                                          indentation-object-name
                                          standalone-built-in-object-name))))
                      (experiments.ohm.runtime.set-ohm-grammar-built-in-value!
                        (mut public-grammar)
                        ~canonical-built-in)
                      (load public-grammar)))
            (push! (mut action-template-builder) (primitive/code-symbol "defn"))
            (push! (mut action-template-builder) action-template-name)
            (push! (mut action-template-builder) `[])
            (push! (mut action-template-builder) `(-> (slice u8)))
            (push! (mut action-template-builder) `~action-template-text)
            (push! (mut output) (primitive/code-symbol "do"))
            (push! (mut output) `(module ohm.generated))
            (push! (mut output) `(import "coil.primitive" :as primitive))
            (push! (mut output) `(import "coil.primitive" :use [alloc-static fnptr-of cast]))
            (push! (mut output) `(import "coil.alloc" :as alloc))
            (push! (mut output) `(import "coil.arraylist" :as al))
            (push! (mut output) `(import "coil.slice" :use [slice-get slice-len]))
            (push! (mut output) `(import "coil.str" :as str))
            (push! (mut output) `(import "experiments.ohm.runtime" :use []))
            (push! (mut output) `(import "experiments.ohm.pexprs" :use []))
            (for form
              (iter standalone-built-in-forms)
              (push! (mut output) form))
            (for form
              (iter finished-forms)
              (push! (mut output) form))
            (if incremental-attribute-required
                (do
                  (push! (mut output)
                         `(defstruct ~incremental-action-name [(calls (ptr i64))]))
                  (push! (mut output)
                         `(impl experiments.ohm.runtime.OhmLazySemanticAction
                            ~incremental-action-name
                            (semantic-grammar-name
                              [(self (ptr ~incremental-action-name))]
                              (-> (slice u8))
                              ~(load effective-grammar-name))
                            (semantic-grammar-token
                              [(self (ptr ~incremental-action-name))]
                              (-> (ptr u8))
                              (~grammar-token-name))
                            (semantic-formal-count
                              [(self (ptr ~incremental-action-name))]
                              (-> i64)
                              0)
                            (semantic-action-kind
                              [(self (ptr ~incremental-action-name))
                               (result (ptr experiments.ohm.runtime.MatchResult))
                               (node i64)]
                              (-> i64)
                              (let [rule
                                      (experiments.ohm.runtime.node-rule
                                        (load result) node)]
                                (cond (coil.str.str-eq rule "addExp_plus") 1
                                      (coil.str.str-eq rule "addExp_minus") 2
                                      (coil.str.str-eq rule "mulExp_times") 3
                                      (coil.str.str-eq rule "mulExp_divide") 4
                                      (coil.str.str-eq rule "priExp_paren") 5
                                      (coil.str.str-eq rule "number") 6
                                      :else 0)))
                            (apply-lazy-semantic-action
                              [(self (ptr ~incremental-action-name))
                               (evaluation
                                 (mut experiments.ohm.runtime.SemanticEvaluation))
                               (node i64)
                               (action-kind i64)
                               (arguments (slice i64))]
                              (-> i64)
                              (do
                                (store! (.calls self) (+ (load (.calls self)) 1))
                                (cond (= action-kind 1)
                                        (+ (experiments.ohm.runtime.evaluate-semantic-child!
                                             (mut evaluation) node 0 arguments)
                                           (experiments.ohm.runtime.evaluate-semantic-child!
                                             (mut evaluation) node 2 arguments))
                                      (= action-kind 2)
                                        (- (experiments.ohm.runtime.evaluate-semantic-child!
                                             (mut evaluation) node 0 arguments)
                                           (experiments.ohm.runtime.evaluate-semantic-child!
                                             (mut evaluation) node 2 arguments))
                                      (= action-kind 3)
                                        (* (experiments.ohm.runtime.evaluate-semantic-child!
                                             (mut evaluation) node 0 arguments)
                                           (experiments.ohm.runtime.evaluate-semantic-child!
                                             (mut evaluation) node 2 arguments))
                                      (= action-kind 4)
                                        (/ (experiments.ohm.runtime.evaluate-semantic-child!
                                             (mut evaluation) node 0 arguments)
                                           (experiments.ohm.runtime.evaluate-semantic-child!
                                             (mut evaluation) node 2 arguments))
                                      (= action-kind 5)
                                        (experiments.ohm.runtime.evaluate-semantic-child!
                                          (mut evaluation) node 1 arguments)
                                      :else
                                        (let [digits
                                                (experiments.ohm.runtime.node-source-string
                                                  (load (.result evaluation)) node)
                                              (mut value) 0]
                                          (for [index 0 (slice-len digits)]
                                            (set! value
                                                  (+ (* (load value) 10)
                                                     (- (primitive/cast i64
                                                          (slice-get digits index))
                                                        48))))
                                          (load value)))))))
                  0)
                0)
            (push! (mut output) (primitive/code-list-done (load grammar-token-builder)))
            (push! (mut output) (primitive/code-list-done (load grammar-descriptor-builder)))
            (push! (mut output) (primitive/code-list-done (load grammar-pexprs-builder)))
            (push! (mut output)
                   (primitive/code-list-done (load proto-built-in-token-builder)))
            (push! (mut output)
                   (primitive/code-list-done (load built-in-token-builder)))
            (push! (mut output)
                   (primitive/code-list-done (load proto-built-in-object-builder)))
            (push! (mut output)
                   (primitive/code-list-done (load built-in-object-builder)))
            (if indentation-sensitive
                (do
                  (push! (mut output)
                         (primitive/code-list-done (load indentation-token-builder)))
                  (push! (mut output)
                         (primitive/code-list-done (load indentation-object-builder))))
                0)
            (push! (mut output) (primitive/code-list-done (load grammar-object-builder)))
            (push! (mut output) (primitive/code-list-done (load action-template-builder)))
            (push! (mut output)
                   (primitive/code-list-done (load start-expression-dispatch-builder)))
            (push! (mut output) (primitive/code-list-done (load parse-tree-from-internal-builder)))
            (push! (mut output) (primitive/code-list-done (load parse-tree-from-cached-builder)))
            (push! (mut output) (primitive/code-list-done (load parse-tree-from-builder)))
            (push! (mut output) (primitive/code-list-done (load parse-tree-builder)))
            (push! (mut output) (primitive/code-list-done (load trace-from-builder)))
            (push! (mut output) (primitive/code-list-done (load trace-builder)))
            (push! (mut output) (primitive/code-list-done (load parse-from-builder)))
            (push! (mut output) (primitive/code-list-done (load parse-builder)))
            (push! (mut output) (primitive/code-list-done (load to-ast-from-builder)))
            (push! (mut output) (primitive/code-list-done (load to-ast-builder)))
            (push! (mut output)
                   (primitive/code-list-done (load semantics-for-to-ast-builder)))
            (if include-recipe
                (push! (mut output) (primitive/code-list-done (load to-recipe-builder)))
                0)
            (push! (mut output) (primitive/code-list-done (load matcher-builder)))
            (push! (mut output) (primitive/code-list-done (load main-builder)))
            (primitive/code-list-done (load output))))))))

(defn read-ohm [(context Code)] (-> Code)
  (set-single-grammar-mode! false)
  (set-cst-differential-mode! false)
  (set-trace-differential-mode! false)
  (read-ohm-impl context (primitive/code-str (get context 2)) true false))

(defn read-ohm-single [(context Code)] (-> Code)
  (set-single-grammar-mode! true)
  (set-cst-differential-mode! false)
  (set-trace-differential-mode! false)
  (read-ohm-impl context (primitive/code-str (get context 2)) true false))

(defn read-ohm-cst [(context Code)] (-> Code)
  (set-single-grammar-mode! false)
  (set-cst-differential-mode! true)
  (set-trace-differential-mode! false)
  (read-ohm-impl context (primitive/code-str (get context 2)) true false))

(defn read-ohm-trace [(context Code)] (-> Code)
  (set-single-grammar-mode! false)
  (set-cst-differential-mode! false)
  (set-trace-differential-mode! true)
  (read-ohm-impl context (primitive/code-str (get context 2)) true false))
