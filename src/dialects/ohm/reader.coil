(module experiments.ohm.reader)

(import "coil.primitive" :as primitive)
(import "coil.primitive" :use [alloc-static fnptr-of cast])
(import "coil.slice" :use [slice-len slice-get subslice])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :as al)
(import "coil.str" :as str)
(import "experiments.ohm.unicode" :as unicode)


;; The grammar reader is deliberately represented with compile-time Code trees.
;; Expression nodes are (alt ...), (seq ...), (star x), (app name args), etc.
;; They exist only during the reader invocation; generated programs contain
;; direct Coil functions and no grammar interpreter.

(defstruct OhmCase
  [(base (slice u8))
   (label (slice u8))
   (source (slice u8))
   (arity i64)
   (source-start i64)
   (source-end i64)])

(defstruct OhmRuleMeta
  [(name (slice u8))
   (operation i64)
   (description (slice u8))
   (source-start i64)
   (source-end i64)
   (diagnostic-source-start i64)
   (diagnostic-source-end i64)
   (body-start i64)
   (body-end i64)
   (expression-span-start i64)
   (expression-span-count i64)])

(defstruct OhmExpressionSpan [(start i64) (end i64)])

(defstruct OhmReader
  [(source (slice u8))
   (position (ptr i64))
   (source-rule-name (slice u8))
   (cases (al/ArrayList OhmCase))
   (rule-metas (al/ArrayList OhmRuleMeta))
   (expression-spans (al/ArrayList OhmExpressionSpan))
   (last-expression-end i64)
   (last-rule-end i64)
   (template-priority (al/ArrayList (slice u8)))
   (record-template-priority bool)])

(defn template-name-present? [(names (ptr (al/ArrayList (slice u8))))
                              (name (slice u8))] (-> bool)
  (let [(mut present) false]
    (for candidate
      (iter (load names))
      (if (str/str-eq candidate name) (set! present true) 0))
    (load present)))

(defn ch [(r (ptr OhmReader)) (at i64)] (-> i64)
  (let [s (load (field r source))]
    (if (or (< at 0) (>= at (slice-len s)))
        -1
        (primitive/cast i64 (slice-get s at)))))

(defn pos [(r (ptr OhmReader))] (-> i64)
  (load (load (field r position))))
(defn set-pos! [(r (ptr OhmReader)) (p i64)] (-> i64)
  (store! (load (field r position)) p))

(defn note-expression-end! [(r (ptr OhmReader))] (-> i64)
  (store! (field r last-expression-end) (pos r))
  (store! (field r last-rule-end) (pos r)))

(defn record-expression-span! [(r (ptr OhmReader))
                               (start i64)
                               (end i64)] (-> i64)
  (let [(mut span) (primitive/zeroed OhmExpressionSpan)]
    (set! (.start span) start)
    (set! (.end span) end)
    (push! (mut (field r expression-spans)) (load span))
    0))

(defn last-expression-span-start [(r (ptr OhmReader))] (-> i64)
  (let [spans (load (field r expression-spans))]
    (let [span (get spans (- (len spans) 1))]
      (.start span))))

(defn reader-utf8-width [(r (ptr OhmReader)) (at i64)] (-> i64)
  (let [first (ch r at)]
    (cond (< first 0) 0
          (< first 128) 1
          (and (>= first 194)
               (<= first 223)
               (>= (ch r (+ at 1)) 128)
               (<= (ch r (+ at 1)) 191))
            2
          (and (>= first 224)
               (<= first 239)
               (>= (ch r (+ at 1)) 128)
               (<= (ch r (+ at 1)) 191)
               (>= (ch r (+ at 2)) 128)
               (<= (ch r (+ at 2)) 191)
               (or (!= first 224) (>= (ch r (+ at 1)) 160))
               (or (!= first 237) (< (ch r (+ at 1)) 160)))
            3
          (and (>= first 240)
               (<= first 244)
               (>= (ch r (+ at 1)) 128)
               (<= (ch r (+ at 1)) 191)
               (>= (ch r (+ at 2)) 128)
               (<= (ch r (+ at 2)) 191)
               (>= (ch r (+ at 3)) 128)
               (<= (ch r (+ at 3)) 191)
               (or (!= first 240) (>= (ch r (+ at 1)) 144))
               (or (!= first 244) (<= (ch r (+ at 1)) 143)))
            4
          :else 0)))

(defn reader-utf8-value [(r (ptr OhmReader)) (at i64) (width i64)] (-> i64)
  (let [first (ch r at)]
    (cond (= width 1) first
          (= width 2) (+ (* (- first 192) 64) (- (ch r (+ at 1)) 128))
          (= width 3)
            (+ (* (- first 224) 4096)
               (+ (* (- (ch r (+ at 1)) 128) 64)
                  (- (ch r (+ at 2)) 128)))
          (= width 4)
            (+ (* (- first 240) 262144)
               (+ (* (- (ch r (+ at 1)) 128) 4096)
                  (+ (* (- (ch r (+ at 2)) 128) 64)
                     (- (ch r (+ at 3)) 128))))
          :else -1)))

(defn ident-start-width [(r (ptr OhmReader)) (at i64)] (-> i64)
  (let [width (reader-utf8-width r at)
        value (reader-utf8-value r at width)]
    (if (or (= value 95)
            (and (>= value 0) (unicode/unicode-letter? value)))
        width
        0)))

(defn ident-rest-width [(r (ptr OhmReader)) (at i64)] (-> i64)
  (let [first-width (ident-start-width r at)
        value (ch r at)]
    (if (> first-width 0)
        first-width
        (if (and (>= value 48) (<= value 57)) 1 0))))

(defn skip-comment! [(r (ptr OhmReader))] (-> bool)
  (let [p (pos r)]
    (cond (and (= (ch r p) 47) (= (ch r (+ p 1)) 47))
            (do
              (set-pos! r (+ p 2))
              (loop (if (or (< (ch r (pos r)) 0) (= (ch r (pos r)) 10))
                        (break)
                        (set-pos! r (+ (pos r) 1))))
              true)
          (and (= (ch r p) 47) (= (ch r (+ p 1)) 42))
            (do
              (set-pos! r (+ p 2))
              (loop (if (or (< (ch r (pos r)) 0)
                            (and (= (ch r (pos r)) 42)
                                 (= (ch r (+ (pos r) 1)) 47)))
                        (break)
                        (set-pos! r (+ (pos r) 1))))
              (if (>= (ch r (pos r)) 0)
                  (set-pos! r (+ (pos r) 2))
                  (reader-source-error r
                                       p
                                       p
                                       "Expected end of input or an identifier"))
              true)
          :else false)))

(defn ws! [(r (ptr OhmReader))] (-> i64)
  (let [(mut again) true]
    (loop (if (not (load again))
              (break)
              (let [c (ch r (pos r))]
                (if (and (>= c 0) (<= c 32))
                    (set-pos! r (+ (pos r) 1))
                    (if (skip-comment! r) 0 (store! again false))))))
    (pos r)))

(defn reader-source-error [(r (ptr OhmReader))
                           (position i64)
                           (end-position i64)
                           (message (slice u8))] (-> i64)
  (let [source (load (field r source))
        limit (slice-len source)
        bounded-position (cond (< position 0) 0
                               (> position limit) limit
                               :else position)
        (mut line) 1
        (mut previous-line-start) -1
        (mut line-start) 0
        (mut scan) 0]
    (loop (if (>= (load scan) bounded-position)
              (break)
              (if (= (primitive/cast i64 (slice-get source (load scan))) 10)
                  (do
                    (set! previous-line-start (load line-start))
                    (set! line-start (+ (load scan) 1))
                    (set! line (+ (load line) 1))
                    (set! scan (+ (load scan) 1)))
                  (let [width (reader-utf8-width r (load scan))]
                    (set! scan (+ (load scan) (if (> width 0) width 1)))))))
    (let [(mut line-end) (load line-start)
          (mut column) 1
          (mut column-at) (load line-start)]
      (loop (if (or (>= (load line-end) limit)
                    (= (primitive/cast i64 (slice-get source (load line-end))) 10)
                    (= (primitive/cast i64 (slice-get source (load line-end))) 13))
                (break)
                (set! line-end (+ (load line-end) 1))))
      (loop (if (>= (load column-at) bounded-position)
                (break)
                (let [width (reader-utf8-width r (load column-at))]
                  (if (> width 0)
                      (do
                        (set! column
                              (+ (load column)
                                 (if (> (reader-utf8-value r (load column-at) width) 65535)
                                     2
                                     1)))
                        (set! column-at (+ (load column-at) width)))
                      (do
                        (set! column (+ (load column) 1))
                        (set! column-at (+ (load column-at) 1)))))))
      (let [has-previous (>= (load previous-line-start) 0)
            has-next (< (load line-end) limit)
            next-line-number (+ (load line) (if has-next 1 0))
            number-width (reader-decimal-digits next-line-number)
            (mut marker-units) 0
            (mut marker-at) bounded-position
            (mut text) (str/sb-new (malloc-allocator))]
        (loop (if (>= (load marker-at) end-position)
                  (break)
                  (let [width (reader-utf8-width r (load marker-at))]
                    (if (> width 0)
                        (do
                          (set! marker-units
                                (+ (load marker-units)
                                   (if (> (reader-utf8-value r (load marker-at) width) 65535)
                                       2
                                       1)))
                          (set! marker-at (+ (load marker-at) width)))
                        (do
                          (set! marker-units (+ (load marker-units) 1))
                          (set! marker-at (+ (load marker-at) 1)))))))
        (if (= (load marker-units) 0) (set! marker-units 1) 0)
        (str/sb-push-str! (mut text) "Line ")
        (str/sb-push-i64! (mut text) (load line))
        (str/sb-push-str! (mut text) ", col ")
        (str/sb-push-i64! (mut text) (load column))
        (str/sb-push-str! (mut text) ":\n")
        (if has-previous
            (let [(mut previous-end) (load previous-line-start)]
              (loop (if (or (>= (load previous-end) (load line-start))
                            (= (primitive/cast i64 (slice-get source (load previous-end))) 10)
                            (= (primitive/cast i64 (slice-get source (load previous-end))) 13))
                        (break)
                        (set! previous-end (+ (load previous-end) 1))))
              (str/sb-push-str! (mut text) "  ")
              (for [_ (reader-decimal-digits (- (load line) 1)) number-width]
                (str/sb-push-str! (mut text) " "))
              (str/sb-push-i64! (mut text) (- (load line) 1))
              (str/sb-push-str! (mut text) " | ")
              (str/sb-push-str! (mut text)
                                (subslice source (load previous-line-start) (load previous-end)))
              (str/sb-push-str! (mut text) "\n"))
            0)
        (str/sb-push-str! (mut text) "> ")
        (for [_ (reader-decimal-digits (load line)) number-width]
          (str/sb-push-str! (mut text) " "))
        (str/sb-push-i64! (mut text) (load line))
        (str/sb-push-str! (mut text) " | ")
        (str/sb-push-str! (mut text) (subslice source (load line-start) (load line-end)))
        (str/sb-push-str! (mut text) "\n")
        (for [_ 0 (+ (+ number-width 5) (- (load column) 1))]
          (str/sb-push-str! (mut text) " "))
        (str/sb-push-str! (mut text) "^")
        (for [_ 1 (load marker-units)]
          (str/sb-push-str! (mut text) "~"))
        (str/sb-push-str! (mut text) "\n")
        (if has-next
            (let [next-start
                    (+ (load line-end)
                       (if (and (= (primitive/cast i64 (slice-get source (load line-end))) 13)
                                (< (+ (load line-end) 1) limit)
                                (= (primitive/cast i64
                                                   (slice-get source (+ (load line-end) 1)))
                                   10))
                           2
                           1))
                  (mut next-end) next-start]
              (loop (if (or (>= (load next-end) limit)
                            (= (primitive/cast i64 (slice-get source (load next-end))) 10)
                            (= (primitive/cast i64 (slice-get source (load next-end))) 13))
                        (break)
                        (set! next-end (+ (load next-end) 1))))
              (str/sb-push-str! (mut text) "  ")
              (for [_ (reader-decimal-digits (+ (load line) 1)) number-width]
                (str/sb-push-str! (mut text) " "))
              (str/sb-push-i64! (mut text) (+ (load line) 1))
              (str/sb-push-str! (mut text) " | ")
              (str/sb-push-str! (mut text) (subslice source next-start (load next-end)))
              (str/sb-push-str! (mut text) "\n"))
            0)
        (str/sb-push-str! (mut text) message)
        (primitive/error (str/sb-finish! (mut text)))))))

(defn fail [(context Code) (r (ptr OhmReader)) (message (slice u8))] (-> i64)
  (reader-source-error r (pos r) (pos r) message))

(defn source-error-for [(source (slice u8))
                        (start i64)
                        (end i64)
                        (message (slice u8))] (-> i64)
  (let [reader (primitive/alloc-stack OhmReader)]
    (store! (field reader source) source)
    (reader-source-error reader start end message)))

(defn accept-char! [(r (ptr OhmReader)) (wanted i64)] (-> bool)
  (ws! r)
  (if (= (ch r (pos r)) wanted)
      (do (set-pos! r (+ (pos r) 1)) true)
      false))

(defn accept-op! [(r (ptr OhmReader)) (a i64) (b i64)] (-> bool)
  (ws! r)
  (if (and (= (ch r (pos r)) a) (= (ch r (+ (pos r) 1)) b))
      (do (set-pos! r (+ (pos r) 2)) true)
      false))

(defn read-ident [(context Code) (r (ptr OhmReader))] (-> (slice u8))
  (ws! r)
  (let [start (pos r)
        first-width (ident-start-width r (pos r))]
    (if (= first-width 0) (fail context r "expected identifier") 0)
    (set-pos! r (+ start first-width))
    (loop (let [width (ident-rest-width r (pos r))]
            (if (> width 0)
                (set-pos! r (+ (pos r) width))
                (break))))
    (subslice (load (field r source)) start (pos r))))

(defn maybe-ident [(context Code) (r (ptr OhmReader))] (-> (slice u8))
  (ws! r)
  (if (> (ident-start-width r (pos r)) 0)
      (read-ident context r)
      (subslice (load (field r source)) (pos r) (pos r))))

(defn hex-value [(c i64)] (-> i64)
  (cond (and (>= c 48) (<= c 57)) (- c 48)
        (and (>= c 65) (<= c 70)) (+ 10 (- c 65))
        (and (>= c 97) (<= c 102)) (+ 10 (- c 97))
        :else -1))

(defn push-utf8! [(builder (mut str/StrBuf)) (value i64)] (-> i64)
  (if (or (< value 0)
          (> value 1114111))
      (primitive/error "invalid Unicode scalar value")
      0)
  (cond (<= value 127) (str/sb-push-byte! (mut builder) (primitive/cast u8 value))
        (<= value 2047)
          (do
            (str/sb-push-byte! (mut builder)
                               (primitive/cast u8 (+ 192 (/ value 64))))
            (str/sb-push-byte! (mut builder)
                               (primitive/cast u8 (+ 128 (% value 64)))))
        (<= value 65535)
          (do
            (str/sb-push-byte! (mut builder)
                               (primitive/cast u8 (+ 224 (/ value 4096))))
            (str/sb-push-byte! (mut builder)
                               (primitive/cast u8 (+ 128 (% (/ value 64) 64))))
            (str/sb-push-byte! (mut builder)
                               (primitive/cast u8 (+ 128 (% value 64)))))
        :else
          (do
            (str/sb-push-byte! (mut builder)
                               (primitive/cast u8 (+ 240 (/ value 262144))))
            (str/sb-push-byte! (mut builder)
                               (primitive/cast u8 (+ 128 (% (/ value 4096) 64))))
            (str/sb-push-byte! (mut builder)
                               (primitive/cast u8 (+ 128 (% (/ value 64) 64))))
            (str/sb-push-byte! (mut builder)
                               (primitive/cast u8 (+ 128 (% value 64)))))))

(defn utf8-first-scalar [(text (slice u8))] (-> i64)
  (if (= (slice-len text) 0)
      0
      (let [b0 (primitive/cast i64 (slice-get text 0))]
        (cond (< b0 128) b0
              (< b0 224)
                (+ (* (- b0 192) 64)
                   (- (primitive/cast i64 (slice-get text 1)) 128))
              (< b0 240)
                (+ (* (- b0 224) 4096)
                   (+ (* (- (primitive/cast i64 (slice-get text 1)) 128) 64)
                      (- (primitive/cast i64 (slice-get text 2)) 128)))
              :else
                (+ (* (- b0 240) 262144)
                   (+ (* (- (primitive/cast i64 (slice-get text 1)) 128) 4096)
                      (+ (* (- (primitive/cast i64 (slice-get text 2)) 128) 64)
                         (- (primitive/cast i64 (slice-get text 3)) 128))))))))

(defn utf8-single-scalar? [(text (slice u8))] (-> bool)
  (if (= (slice-len text) 0)
      false
      (let [first (primitive/cast i64 (slice-get text 0))
            width
              (cond (< first 128) 1
                    (< first 224) 2
                    (< first 240) 3
                    :else 4)]
        (= (slice-len text) width))))

(defn push-json-string! [(builder (mut str/StrBuf))
                         (value (slice u8))] (-> i64)
  (str/sb-push-byte! (mut builder) 34)
  (let [(mut index) 0]
    (loop (if (>= (load index) (slice-len value))
              (break)
              (let [byte (primitive/cast i64 (slice-get value (load index)))]
                (cond (= byte 34) (str/sb-push-str! (mut builder) "\\\"")
                      (= byte 92) (str/sb-push-str! (mut builder) "\\\\")
                      (= byte 8) (str/sb-push-str! (mut builder) "\\b")
                      (= byte 9) (str/sb-push-str! (mut builder) "\\t")
                      (= byte 10) (str/sb-push-str! (mut builder) "\\n")
                      (= byte 12) (str/sb-push-str! (mut builder) "\\f")
                      (= byte 13) (str/sb-push-str! (mut builder) "\\r")
                      (< byte 32)
                        (do
                          (str/sb-push-str! (mut builder) "\\u00")
                          (let [digits "0123456789abcdef"]
                            (str/sb-push-byte! (mut builder) (slice-get digits (/ byte 16)))
                            (str/sb-push-byte! (mut builder) (slice-get digits (% byte 16)))))
                      (and (= byte 226)
                           (and (< (+ (load index) 2) (slice-len value))
                                (and (= (primitive/cast i64
                                                        (slice-get value (+ (load index) 1)))
                                        128)
                                     (or (= (primitive/cast i64
                                                            (slice-get value (+ (load index) 2)))
                                            168)
                                         (= (primitive/cast i64
                                                            (slice-get value (+ (load index) 2)))
                                            169)))))
                        (do
                          (str/sb-push-str! (mut builder)
                                            (if (= (primitive/cast i64
                                                                   (slice-get value (+ (load index) 2)))
                                                   168)
                                                "\\u2028"
                                                "\\u2029"))
                          (set! index (+ (load index) 2)))
                      :else
                        (str/sb-push-byte! (mut builder) (slice-get value (load index))))
                (set! index (+ (load index) 1))))))
  (str/sb-push-byte! (mut builder) 34)
  0)

(defn source-backed-recipe [(source (slice u8))
                            (grammar-name (slice u8))
                            (start-rule (slice u8))] (-> (slice u8))
  (let [(mut builder) (str/sb-new (malloc-allocator))]
    (str/sb-push-str! (mut builder) "[\"grammar\",{\"source\":")
    (push-json-string! (mut builder) source)
    (str/sb-push-str! (mut builder) "},")
    (push-json-string! (mut builder) grammar-name)
    (str/sb-push-str! (mut builder) ",null,")
    (if (> (slice-len start-rule) 0)
        (push-json-string! (mut builder) start-rule)
        (str/sb-push-str! (mut builder) "null"))
    (str/sb-push-str! (mut builder) ",{}]")
    (str/sb-finish! (mut builder))))

(defn expression-span-node-count [(node Code)] (-> i64)
  (cond (tag? node "case") (+ 1 (expression-span-node-count (get node 2)))
        (or (tag? node "star")
            (or (tag? node "plus")
                (or (tag? node "opt")
                    (or (tag? node "not")
                        (or (tag? node "look")
                            (or (tag? node "lex") (tag? node "splice")))))))
          (+ 1 (expression-span-node-count (get node 1)))
        (tag? node "app")
          (let [(mut count) 1]
            (for child
              (iter (get node 2))
              (set! count (+ (load count) (expression-span-node-count child))))
            (load count))
        (or (tag? node "alt") (tag? node "seq"))
          (let [(mut count) 1]
            (for child
              (iter (get node 1))
              (set! count (+ (load count) (expression-span-node-count child))))
            (load count))
        :else 1))

(defn expression-child-span-base [(children Code)
                                  (index i64)
                                  (base i64)] (-> i64)
  (let [(mut result) base]
    (for [child-index 0 index]
      (set! result (+ (load result)
                      (expression-span-node-count (get children child-index)))))
    (load result)))

(defn append-expression-source-meta! [(builder (mut str/StrBuf))
                                      (spans (al/ArrayList OhmExpressionSpan))
                                      (base i64)
                                      (node Code)] (-> i64)
  (let [root-index (+ base (- (expression-span-node-count node) 1))
        (mut available) (and (>= root-index 0) (< root-index (len spans)))]
    (if (load available)
        (let [span (get spans root-index)]
          (str/sb-push-str! (mut builder) "{\"sourceInterval\":[")
          (str/sb-push-i64! (mut builder) (.start span))
          (str/sb-push-byte! (mut builder) 44)
          (str/sb-push-i64! (mut builder) (.end span))
          (str/sb-push-str! (mut builder) "]}"))
        (str/sb-push-str! (mut builder) "{}")))
  0)

(defn append-expression-recipe! [(builder (mut str/StrBuf))
                                 (node Code)
                                 (formals Code)
                                 (cases (al/ArrayList OhmCase))
                                 (spans (al/ArrayList OhmExpressionSpan))
                                 (span-base i64)] (-> i64)
  (cond (tag? node "terminal")
          (do
            (str/sb-push-str! (mut builder) "[\"terminal\",")
            (append-expression-source-meta! (mut builder) spans span-base node)
            (str/sb-push-byte! (mut builder) 44)
            (push-json-string! (mut builder) (primitive/code-str (get node 1)))
            (str/sb-push-byte! (mut builder) 93))
        (tag? node "range")
          (do
            (str/sb-push-str! (mut builder) "[\"range\",")
            (append-expression-source-meta! (mut builder) spans span-base node)
            (str/sb-push-byte! (mut builder) 44)
            (push-json-string! (mut builder) (primitive/code-str (get node 3)))
            (str/sb-push-byte! (mut builder) 44)
            (push-json-string! (mut builder) (primitive/code-str (get node 4)))
            (str/sb-push-byte! (mut builder) 93))
        (tag? node "super-splice")
          (primitive/error "Ohm recipe serializer: unexpected standalone super splice")
        (tag? node "case")
          (let [case-data (get cases (primitive/code-int (get node 1)))]
            (str/sb-push-str! (mut builder) "[\"app\",")
            (append-expression-source-meta! (mut builder) spans span-base node)
            (str/sb-push-byte! (mut builder) 44)
            (push-json-string! (mut builder) (case-application-display case-data))
            (str/sb-push-str! (mut builder) ",[")
            (for [index 0 (len formals)]
              (do
                (if (> index 0) (str/sb-push-byte! (mut builder) 44) 0)
                (str/sb-push-str! (mut builder) "[\"param\",{},")
                (str/sb-push-i64! (mut builder) index)
                (str/sb-push-byte! (mut builder) 93)))
            (str/sb-push-str! (mut builder) "]]"))
        (tag? node "app")
          (let [name (primitive/code-str (get node 1))
                formal-index (name-index formals name)]
            (if (>= formal-index 0)
                (do
                  (str/sb-push-str! (mut builder) "[\"param\",")
                  (append-expression-source-meta! (mut builder) spans span-base node)
                  (str/sb-push-byte! (mut builder) 44)
                  (str/sb-push-i64! (mut builder) formal-index)
                  (str/sb-push-byte! (mut builder) 93))
                (do
                  (str/sb-push-str! (mut builder) "[\"app\",")
                  (append-expression-source-meta! (mut builder) spans span-base node)
                  (str/sb-push-byte! (mut builder) 44)
                  (push-json-string! (mut builder) name)
                  (str/sb-push-str! (mut builder) ",[")
                  (for [index 0 (len (get node 2))]
                    (do
                      (if (> index 0) (str/sb-push-byte! (mut builder) 44) 0)
                      (append-expression-recipe! (mut builder)
                                                 (get (get node 2) index)
                                                 formals
                                                 cases
                                                 spans
                                                 (expression-child-span-base
                                                   (get node 2)
                                                   index
                                                   span-base))))
                  (str/sb-push-str! (mut builder) "]]"))))
        (or (tag? node "alt") (tag? node "seq"))
          (let [children (get node 1)]
            (if (= (len children) 1)
                (let [child (get children 0)]
                  (if (tag? child "case")
                      (let [case-data
                              (get cases (primitive/code-int (get child 1)))]
                        (str/sb-push-str! (mut builder) "[\"app\",")
                        (append-expression-source-meta! (mut builder) spans span-base node)
                        (str/sb-push-byte! (mut builder) 44)
                        (push-json-string! (mut builder)
                                           (case-application-display case-data))
                        (str/sb-push-str! (mut builder) ",[")
                        (for [index 0 (len formals)]
                          (do
                            (if (> index 0) (str/sb-push-byte! (mut builder) 44) 0)
                            (str/sb-push-str! (mut builder) "[\"param\",{},")
                            (str/sb-push-i64! (mut builder) index)
                            (str/sb-push-byte! (mut builder) 93)))
                        (str/sb-push-str! (mut builder) "]]"))
                      (append-expression-recipe! (mut builder)
                                                 child
                                                 formals
                                                 cases
                                                 spans
                                                 span-base)))
                (do
                  (str/sb-push-str! (mut builder)
                                    (if (tag? node "alt") "[\"alt\"," "[\"seq\","))
                  (append-expression-source-meta! (mut builder) spans span-base node)
                  (for [index 0 (len children)]
                    (do
                      (str/sb-push-byte! (mut builder) 44)
                      (append-expression-recipe! (mut builder)
                                                 (get children index)
                                                 formals
                                                 cases
                                                 spans
                                                 (expression-child-span-base
                                                   children
                                                   index
                                                   span-base))))
                  (str/sb-push-byte! (mut builder) 93))))
        (or (tag? node "star")
            (or (tag? node "plus")
                (or (tag? node "opt")
                    (or (tag? node "not")
                        (or (tag? node "look") (tag? node "lex"))))))
          (do
            (str/sb-push-str! (mut builder) "[\"")
            (str/sb-push-str! (mut builder)
                              (cond (tag? node "look") "lookahead"
                                    (tag? node "not") "not"
                                    (tag? node "lex") "lex"
                                    (tag? node "star") "star"
                                    (tag? node "plus") "plus"
                                    :else "opt"))
            (str/sb-push-str! (mut builder) "\",")
            (append-expression-source-meta! (mut builder) spans span-base node)
            (str/sb-push-byte! (mut builder) 44)
            (append-expression-recipe! (mut builder)
                                       (get node 1)
                                       formals
                                       cases
                                       spans
                                       span-base)
            (str/sb-push-byte! (mut builder) 93))
        (tag? node "splice")
          (let [original (get node 2)
                terms (get original 1)
                (mut expansion) -1]
            (for [index 0 (len terms)]
              (if (contains-super-splice? (get terms index)) (set! expansion index) 0))
            (str/sb-push-str! (mut builder) "[\"splice\",")
            (append-expression-source-meta! (mut builder) spans span-base node)
            (str/sb-push-str! (mut builder) ",[")
            (for [index 0 (if (< (load expansion) 0) (len terms) (load expansion))]
              (do
                (if (> index 0) (str/sb-push-byte! (mut builder) 44) 0)
                (append-expression-recipe! (mut builder)
                                           (get terms index)
                                           formals
                                           cases
                                           spans
                                           (expression-child-span-base terms index span-base))))
            (str/sb-push-str! (mut builder) "],[")
            (if (>= (load expansion) 0)
                (for [index (+ (load expansion) 1) (len terms)]
                  (do
                    (if (> index (+ (load expansion) 1))
                        (str/sb-push-byte! (mut builder) 44)
                        0)
                    (append-expression-recipe! (mut builder)
                                               (get terms index)
                                               formals
                                               cases
                                               spans
                                               (expression-child-span-base
                                                 terms
                                                 index
                                                 span-base))))
                0)
            (str/sb-push-str! (mut builder) "]]"))
        :else (primitive/error "Ohm recipe serializer: unsupported expression"))
  0)

(defn append-recipe-formals! [(builder (mut str/StrBuf)) (formals Code)] (-> i64)
  (str/sb-push-byte! (mut builder) 91)
  (for [index 0 (len formals)]
    (do
      (if (> index 0) (str/sb-push-byte! (mut builder) 44) 0)
      (push-json-string! (mut builder) (primitive/code-sym (get formals index)))))
  (str/sb-push-byte! (mut builder) 93)
  0)

(defn append-source-splice-recipe! [(builder (mut str/StrBuf))
                                    (body Code)
                                    (formals Code)
                                    (cases (al/ArrayList OhmCase))
                                    (spans (al/ArrayList OhmExpressionSpan))
                                    (span-base i64)] (-> i64)
  (let [terms (if (tag? body "alt") (get body 1) (get (get body 1) 1))
        (mut expansion) -1]
    (for [index 0 (len terms)]
      (if (contains-super-splice? (get terms index)) (set! expansion index) 0))
    (str/sb-push-str! (mut builder) "[\"splice\",")
    (append-expression-source-meta! (mut builder) spans span-base body)
    (str/sb-push-str! (mut builder) ",[")
    (for [index 0 (load expansion)]
      (do
        (if (> index 0) (str/sb-push-byte! (mut builder) 44) 0)
        (append-expression-recipe! (mut builder)
                                   (get terms index)
                                   formals
                                   cases
                                   spans
                                   (expression-child-span-base terms index span-base))))
    (str/sb-push-str! (mut builder) "],[")
    (for [index (+ (load expansion) 1) (len terms)]
      (do
        (if (> index (+ (load expansion) 1)) (str/sb-push-byte! (mut builder) 44) 0)
        (append-expression-recipe! (mut builder)
                                   (get terms index)
                                   formals
                                   cases
                                   spans
                                   (expression-child-span-base terms index span-base))))
    (str/sb-push-str! (mut builder) "]]"))
  0)

(defn append-rule-recipe! [(builder (mut str/StrBuf))
                           (name (slice u8))
                           (operation i64)
                           (description (slice u8))
                           (formals Code)
                           (body Code)
                           (cases (al/ArrayList OhmCase))
                           (spans (al/ArrayList OhmExpressionSpan))
                           (span-base i64)
                           (source-start i64)
                           (source-end i64)] (-> i64)
  (push-json-string! (mut builder) name)
  (str/sb-push-str! (mut builder) ":[\"")
  (str/sb-push-str! (mut builder)
                    (cond (= operation 1) "override"
                          (= operation 2) "extend"
                          :else "define"))
  (str/sb-push-str! (mut builder) "\",{\"sourceInterval\":[")
  (str/sb-push-i64! (mut builder) source-start)
  (str/sb-push-byte! (mut builder) 44)
  (str/sb-push-i64! (mut builder) source-end)
  (str/sb-push-str! (mut builder) "]},")
  (if (and (= operation 0) (> (slice-len description) 0))
      (push-json-string! (mut builder) description)
      (str/sb-push-str! (mut builder) "null"))
  (str/sb-push-byte! (mut builder) 44)
  (append-recipe-formals! (mut builder) formals)
  (str/sb-push-byte! (mut builder) 44)
  (if (and (= operation 1) (contains-super-splice? body))
      (append-source-splice-recipe! (mut builder)
                                    body
                                    formals
                                    cases
                                    spans
                                    span-base)
      (append-expression-recipe! (mut builder)
                                 body
                                 formals
                                 cases
                                 spans
                                 span-base))
  (str/sb-push-byte! (mut builder) 93)
  0)

(defn expression-has-case-index? [(node Code) (wanted i64)] (-> bool)
  (cond (tag? node "case")
          (or (= (primitive/code-int (get node 1)) wanted)
              (expression-has-case-index? (get node 2) wanted))
        (or (tag? node "star")
            (or (tag? node "plus")
                (or (tag? node "opt")
                    (or (tag? node "not")
                        (or (tag? node "look")
                            (or (tag? node "lex") (tag? node "splice")))))))
          (expression-has-case-index? (get node 1) wanted)
        (or (tag? node "alt") (tag? node "seq"))
          (let [(mut found) false]
            (for child
              (iter (get node 1))
              (if (expression-has-case-index? child wanted) (set! found true) 0))
            (load found))
        :else false))

(defn validate-lexical-applications [(node Code)
                                     (formals Code)
                                     (lexical bool)
                                     (rule-metas (al/ArrayList OhmRuleMeta))] (-> i64)
  (cond (tag? node "app")
          (let [name (primitive/code-str (get node 1))
                first (primitive/cast i64 (slice-get name 0))]
            (if (and lexical
                     (and (>= first 65)
                          (and (<= first 90)
                               (and (< (name-index formals name) 0)
                                    (or (>= (find-rule-index rule-metas name) 0)
                                        (built-in-rule-name? name))))))
                (let [(mut message) (str/sb-new (malloc-allocator))]
                  (str/sb-push-str! (mut message) "Cannot apply syntactic rule ")
                  (str/sb-push-str! (mut message) name)
                  (str/sb-push-str! (mut message) " from here (inside a lexical context)")
                  (compiler-expression-error node (str/sb-finish! (mut message))))
                0)
            (for argument
              (iter (get node 2))
              (validate-lexical-applications argument
                                             formals
                                             (if (str/str-eq name "applySyntactic")
                                                 false
                                                 lexical)
                                             rule-metas)))
        (tag? node "case")
          (validate-lexical-applications (get node 2) formals lexical rule-metas)
        (tag? node "lex")
          (validate-lexical-applications (get node 1) formals true rule-metas)
        (or (tag? node "star")
            (or (tag? node "plus")
                (or (tag? node "opt")
                    (or (tag? node "not")
                        (or (tag? node "look")
                            (tag? node "splice"))))))
          (validate-lexical-applications (get node 1) formals lexical rule-metas)
        (or (tag? node "alt") (tag? node "seq"))
            (for child
              (iter (get node 1))
              (validate-lexical-applications child formals lexical rule-metas))
        :else 0)
  0)

(defn find-case-body [(node Code) (wanted i64)] (-> Code)
  (cond (and (tag? node "case") (= (primitive/code-int (get node 1)) wanted))
          (get node 2)
        (tag? node "case") (find-case-body (get node 2) wanted)
        (or (tag? node "star")
            (or (tag? node "plus")
                (or (tag? node "opt")
                    (or (tag? node "not")
                        (or (tag? node "look")
                            (or (tag? node "lex") (tag? node "splice")))))))
          (find-case-body (get node 1) wanted)
        (or (tag? node "alt") (tag? node "seq"))
          (let [(mut answer) node]
            (for child
              (iter (get node 1))
              (if (expression-has-case-index? child wanted)
                  (set! answer (find-case-body child wanted))
                  0))
            (load answer))
        :else node))

(defn find-case-span-base [(node Code) (wanted i64) (base i64)] (-> i64)
  (cond (and (tag? node "case") (= (primitive/code-int (get node 1)) wanted)) base
        (tag? node "case") (find-case-span-base (get node 2) wanted base)
        (or (tag? node "star")
            (or (tag? node "plus")
                (or (tag? node "opt")
                    (or (tag? node "not")
                        (or (tag? node "look")
                            (or (tag? node "lex") (tag? node "splice")))))))
          (find-case-span-base (get node 1) wanted base)
        (or (tag? node "alt") (tag? node "seq"))
          (let [children (get node 1)
                (mut answer) base]
            (for [index 0 (len children)]
              (let [child (get children index)]
                (if (expression-has-case-index? child wanted)
                    (set! answer
                          (find-case-span-base child
                                               wanted
                                               (expression-child-span-base
                                                 children
                                                 index
                                                 base)))
                    0)))
            (load answer))
        :else base))

(defn structural-source-recipe [(source (slice u8))
                                (grammar-name (slice u8))
                                (start-rule (slice u8))
                                (rules Code)
                                (metas (al/ArrayList OhmRuleMeta))
                                (cases (al/ArrayList OhmCase))
                                (spans (al/ArrayList OhmExpressionSpan))
                                (super-recipe (slice u8))
                                (case-start i64)
                                (case-end i64)] (-> (slice u8))
  (let [(mut builder) (str/sb-new (malloc-allocator))
        (mut emitted) 0]
    (str/sb-push-str! (mut builder) "[\"grammar\",{\"source\":")
    (push-json-string! (mut builder) source)
    (str/sb-push-str! (mut builder) "},")
    (push-json-string! (mut builder) grammar-name)
    (str/sb-push-byte! (mut builder) 44)
    (if (> (slice-len super-recipe) 0)
        (str/sb-push-str! (mut builder) super-recipe)
        (str/sb-push-str! (mut builder) "null"))
    (str/sb-push-byte! (mut builder) 44)
    (if (> (slice-len start-rule) 0)
        (push-json-string! (mut builder) start-rule)
        (str/sb-push-str! (mut builder) "null"))
    (str/sb-push-str! (mut builder) ",{")
    (for [rule-index 0 (len rules)]
      (let [rule (get rules rule-index)
            meta (get metas rule-index)
            rule-name (primitive/code-str (get rule 1))
            formals (get rule 2)]
        (for [case-index case-start case-end]
          (let [case-data (get cases case-index)]
          (if (str/str-eq (.base case-data) rule-name)
              (do
                (if (> (load emitted) 0) (str/sb-push-byte! (mut builder) 44) 0)
                (append-rule-recipe! (mut builder)
                                     (case-application-display case-data)
                                     0
                                     ""
                                     formals
                                     (find-case-body (get rule 3) case-index)
                                     cases
                                     spans
                                     (find-case-span-base
                                       (get rule 3)
                                       case-index
                                       (.expression-span-start meta))
                                     (.source-start case-data)
                                     (.source-end case-data))
                (set! emitted (+ (load emitted) 1)))
              0)))
        (if (> (load emitted) 0) (str/sb-push-byte! (mut builder) 44) 0)
        (append-rule-recipe! (mut builder)
                             rule-name
                             (.operation meta)
                             (.description meta)
                             formals
                             (get rule 3)
                             cases
                             spans
                             (.expression-span-start meta)
                             (.source-start meta)
                             (.source-end meta))
        (set! emitted (+ (load emitted) 1))))
    (str/sb-push-str! (mut builder) "}]")
    (str/sb-finish! (mut builder))))

(defn source-default-start-rule [(rules Code)
                                 (metas (al/ArrayList OhmRuleMeta))] (-> (slice u8))
  (let [(mut answer) ""
        (mut found) false]
    (for [index 0 (len rules)]
      (let [meta (get metas index)]
        (if (and (not (load found)) (= (.operation meta) 0))
            (do
              (set! answer (primitive/code-str (get (get rules index) 1)))
              (set! found true))
            0)))
    (load answer)))

(defn builder-default-start-in-range [(source (slice u8))
                                      (start i64)
                                      (end i64)] (-> (slice u8))
  (let [prefix "// @ohm-builder-default "
        (mut at) start
        (mut answer) ""]
    (loop (if (> (+ (load at) (slice-len prefix)) end)
              (break)
              (if (slice-at? source (load at) prefix)
                  (let [name-start (+ (load at) (slice-len prefix))
                        (mut name-end) (+ (load at) (slice-len prefix))]
                    (loop (if (or (>= (load name-end) end)
                                  (<= (primitive/cast i64
                                        (slice-get source (load name-end)))
                                      32))
                              (break)
                              (set! name-end (+ (load name-end) 1))))
                    (set! answer (subslice source name-start (load name-end)))
                    (set! at (load name-end)))
                  (set! at (+ (load at) 1)))))
    (load answer)))

(defn recipe-utf16-index [(source (slice u8))
                          (origin i64)
                          (target i64)] (-> i64)
  (let [(mut at) origin
        (mut units) 0]
    (loop (if (>= (load at) target)
              (break)
              (let [first (primitive/cast i64 (slice-get source (load at)))
                    width (cond (< first 128) 1
                                (< first 224) 2
                                (< first 240) 3
                                :else 4)]
                (set! units (+ (load units) (if (= width 4) 2 1)))
                (set! at (+ (load at) width)))))
    (load units)))

(defn normalize-recipe-source-intervals! [(source (slice u8))
                                          (metas (mut (al/ArrayList OhmRuleMeta)))
                                          (cases (mut (al/ArrayList OhmCase)))
                                          (spans (mut (al/ArrayList OhmExpressionSpan)))
                                          (offset i64)
                                          (case-start i64)
                                          (span-start i64)] (-> i64)
  (for [index 0 (len (load metas))]
    (let [meta (al/al-elem [OhmRuleMeta] metas index)]
      (set! (.source-start meta) (recipe-utf16-index source offset (.source-start meta)))
      (set! (.source-end meta) (recipe-utf16-index source offset (.source-end meta)))
      (set! (.body-start meta) (recipe-utf16-index source offset (.body-start meta)))
      (set! (.body-end meta) (recipe-utf16-index source offset (.body-end meta)))))
  (for [index case-start (len (load cases))]
    (let [case-data (al/al-elem [OhmCase] cases index)]
      (set! (.source-start case-data)
            (recipe-utf16-index source offset (.source-start case-data)))
      (set! (.source-end case-data)
            (recipe-utf16-index source offset (.source-end case-data)))))
  (for [index span-start (len (load spans))]
    (let [span (al/al-elem [OhmExpressionSpan] spans index)]
      (set! (.start span) (recipe-utf16-index source offset (.start span)))
      (set! (.end span) (recipe-utf16-index source offset (.end span)))))
  0)

(defn read-terminal [(context Code) (r (ptr OhmReader))] (-> (slice u8))
  (ws! r)
  (if (not (= (ch r (pos r)) 34)) (fail context r "expected terminal") 0)
  (set-pos! r (+ (pos r) 1))
  (let [(mut out) (str/sb-new (malloc-allocator))
        (mut closed) false]
    (loop (let [c (ch r (pos r))]
            (cond (< c 0) (break)
                  (= c 34) (do (set-pos! r (+ (pos r) 1)) (store! closed true) (break))
                  (= c 92)
                    (do
                      (set-pos! r (+ (pos r) 1))
                      (let [e (ch r (pos r))]
                        (cond (= e 110) (str/sb-push-byte! (mut out) (primitive/cast u8 10))
                              (= e 114) (str/sb-push-byte! (mut out) (primitive/cast u8 13))
                              (= e 116) (str/sb-push-byte! (mut out) (primitive/cast u8 9))
                              (= e 98) (str/sb-push-byte! (mut out) (primitive/cast u8 8))
                              (or (= e 92) (= e 34) (= e 39)) (str/sb-push-byte! (mut out) (primitive/cast u8 e))
                              (= e 120)
                                (let [a (hex-value (ch r (+ (pos r) 1)))
                                      b (hex-value (ch r (+ (pos r) 2)))]
                                  (if (or (< a 0) (< b 0)) (fail context r "bad hex escape") 0)
                                  (push-utf8! (mut out) (+ (* a 16) b))
                                  (set-pos! r (+ (pos r) 2)))
                              (= e 117)
                                (let [(mut value) 0
                                      (mut digits) 0
                                      (mut digits-start) (+ (pos r) 1)]
                                  (if (= (ch r (+ (pos r) 1)) 123)
                                      (do
                                        (set-pos! r (+ (pos r) 2))
                                        (set! digits-start (pos r))
                                        (loop (let [h (hex-value (ch r (pos r)))]
                                                (if (< h 0)
                                                    (break)
                                                    (do
                                                      (store! value (+ (* (load value) 16) h))
                                                      (store! digits (+ (load digits) 1))
                                                      (set-pos! r (+ (pos r) 1))))))
                                        (if (> (load digits) 6)
                                            (reader-source-error
                                              r
                                              (- (load digits-start) 3)
                                              (- (load digits-start) 3)
                                              "Expected \"\\\"\", not \"\\\\\", or an escape sequence")
                                            0)
                                        (if (not (= (ch r (pos r)) 125)) (fail context r "bad Unicode escape") 0))
                                      (do
                                        (set-pos! r (+ (pos r) 1))
                                        (for [i 0 4]
                                          (let [h (hex-value (ch r (pos r)))]
                                            (if (< h 0) (fail context r "bad Unicode escape") 0)
                                            (store! value (+ (* (load value) 16) h))
                                            (store! digits (+ (load digits) 1))
                                            (set-pos! r (+ (pos r) 1))))
                                        (set-pos! r (- (pos r) 1))))
                                  (if (= (load digits) 0) (fail context r "empty Unicode escape") 0)
                                  (if (> (load value) 1114111)
                                      (let [(mut message) (str/sb-new (malloc-allocator))]
                                        (str/sb-push-str! (mut message) "U+")
                                        (str/sb-push-str!
                                          (mut message)
                                          (subslice (load (field r source))
                                                    (load digits-start)
                                                    (+ (load digits-start) (load digits))))
                                        (str/sb-push-str! (mut message)
                                                          " is not a valid Unicode code point")
                                        (reader-source-error
                                          r
                                          (load digits-start)
                                          (+ (load digits-start) (load digits))
                                          (str/sb-finish! (mut message))))
                                      0)
                                  (push-utf8! (mut out) (load value)))
                              :else
                                (reader-source-error
                                  r
                                  (- (pos r) 1)
                                  (- (pos r) 1)
                                  "Expected \"\\\"\", not \"\\\\\", or an escape sequence")))
                      (set-pos! r (+ (pos r) 1)))
                  (= c 10) (fail context r "newline in terminal")
                  :else
                    (do
                      (str/sb-push-byte! (mut out) (primitive/cast u8 c))
                      (set-pos! r (+ (pos r) 1))))))
    (if (not (load closed)) (fail context r "unterminated terminal") 0)
    (str/sb-finish! (mut out))))

(defn line-indent [(r (ptr OhmReader)) (at i64)] (-> i64)
  (let [(mut p) (- at 1)]
    (loop (if (or (< (load p) 0) (= (ch r (load p)) 10))
              (break)
              (store! p (- (load p) 1))))
    (let [(mut q) (+ (load p) 1)]
      (loop (if (= (ch r (load q)) 32) (store! q (+ (load q) 1)) (break)))
      (- (load q) (+ (load p) 1)))))

(defn rule-operator-at-current? [(r (ptr OhmReader))] (-> bool)
  (or (= (ch r (pos r)) 61)
      (and (= (ch r (pos r)) 58) (= (ch r (+ (pos r) 1)) 61))
      (and (= (ch r (pos r)) 43) (= (ch r (+ (pos r) 1)) 61))))

(defn at-rule-start? [(context Code) (r (ptr OhmReader))] (-> bool)
  (ws! r)
  (let [saved (pos r)
        (mut declaration) false]
    (if (> (ident-start-width r (pos r)) 0)
        (do
          (read-ident context r)
          (ws! r)
          (if (= (ch r (pos r)) 60) (skip-balanced! context r 60 62) 0)
          (ws! r)
          (if (= (ch r (pos r)) 40)
              (do
                (skip-balanced! context r 40 41)
                (ws! r))
              0)
          (if (rule-operator-at-current? r) (set! declaration true) 0))
        0)
    (set-pos! r saved)
    (load declaration)))

(defn expression-start? [(r (ptr OhmReader))] (-> bool)
  (ws! r)
  (let [c (ch r (pos r))]
    (or (= c 34)
        (= c 40)
        (= c 126)
        (= c 38)
        (= c 35)
        (and (= c 46)
             (= (ch r (+ (pos r) 1)) 46)
             (= (ch r (+ (pos r) 2)) 46))
        (> (ident-start-width r (pos r)) 0))))

(defn read-case-name [(context Code) (r (ptr OhmReader))] (-> (slice u8))
  (set-pos! r (+ (pos r) 2))
  (loop (if (and (>= (ch r (pos r)) 0)
                 (<= (ch r (pos r)) 32)
                 (!= (ch r (pos r)) 10))
            (set-pos! r (+ (pos r) 1))
            (break)))
  (let [label (read-ident context r)]
    label))

(defn parse-expression [(context Code)
                        (raw i64)
                        (rule-indent i64)
                        (mode i64)] (-> Code)
  (let [r (primitive/cast (ptr OhmReader) raw)]
    (ws! r)
    (let [expression-start (pos r)]
    (cond (= mode 0)
            (let [(mut choices) (primitive/code-list-new)]
              (if (= (ch r (pos r)) 124) (set-pos! r (+ (pos r) 1)) 0)
              (ws! r)
              (let [alternation-start (pos r)]
              (loop (let [_ (ws! r)
                          choice-start (pos r)
                          choice (parse-expression context raw rule-indent 1)]
                      (ws! r)
                      (if (and (= (ch r (pos r)) 45) (= (ch r (+ (pos r) 1)) 45))
                          (let [case-index (len (load (field r cases)))
                                (mut case) (primitive/zeroed OhmCase)]
                            (set! (.base case) (load (field r source-rule-name)))
                            (set! (.source case) (load (field r source)))
                            (set! (.source-start case) choice-start)
                            (set! (.label case) (read-case-name context r))
                            (set! (.source-end case) (pos r))
                            (store! (field r last-rule-end) (pos r))
                            (set! (.arity case) (expression-arity choice))
                            (push! (mut (field r cases)) (load case))
                            (let [case-node `(case ~case-index ~choice)]
                              (record-expression-span! r
                                                       choice-start
                                                       (load (field r last-expression-end)))
                              (push! (mut choices) case-node)))
                          (push! (mut choices) choice)))
                (ws! r)
                (if (= (ch r (pos r)) 124) (set-pos! r (+ (pos r) 1)) (break)))
              (let [node `(alt (~@(primitive/code-list-done (load choices)))
                               ~alternation-start
                               ~(load (field r last-rule-end)))]
                (record-expression-span! r
                                         alternation-start
                                         (load (field r last-rule-end)))
                node)))
          (= mode 1)
            (let [(mut items) (primitive/code-list-new)]
              (loop (ws! r)
                (if (or (not (expression-start? r)) (at-rule-start? context r))
                    (break)
                    (push! (mut items)
                           (parse-expression context raw rule-indent 2))))
              (let [node `(seq (~@(primitive/code-list-done (load items)))
                               ~expression-start
                               ~(load (field r last-expression-end)))]
                (if (= (len (get node 1)) 0)
                    (do
                      (store! (field r last-expression-end) expression-start)
                      (store! (field r last-rule-end) expression-start))
                    0)
                (record-expression-span! r
                                         expression-start
                                         (load (field r last-expression-end)))
                node))
          (= mode 2)
            (let [operand-start (pos r)
                  base (parse-expression context raw rule-indent 3)
                  operand-end (pos r)
                  grammar-source (load (field r source))
                  (mut span-start) operand-start
                  (mut span-end) operand-end]
              ;; Parentheses group an expression but are not part of the
              ;; operand interval reported by Ohm's nullable-iteration error.
              (loop (if (and (< (load span-start) (load span-end))
                             (= (ch r (load span-start)) 40)
                             (= (ch r (- (load span-end) 1)) 41))
                        (do
                          (store! span-start (+ (load span-start) 1))
                          (store! span-end (- (load span-end) 1))
                          (loop (if (and (>= (ch r (load span-start)) 0)
                                         (<= (ch r (load span-start)) 32))
                                    (store! span-start (+ (load span-start) 1))
                                    (break)))
                          (loop (if (and (>= (ch r (- (load span-end) 1)) 0)
                                         (<= (ch r (- (load span-end) 1)) 32))
                                    (store! span-end (- (load span-end) 1))
                                    (break))))
                        (break)))
              (ws! r)
              (cond (= (ch r (pos r)) 42)
                      (do
                        (set-pos! r (+ (pos r) 1))
                        (note-expression-end! r)
                        (let [node `(star ~base
                                           ~(load span-start)
                                           ~(load span-end)
                                           ~(primitive/code-symbol grammar-source))]
                          (record-expression-span! r operand-start (pos r))
                          node))
                    (= (ch r (pos r)) 43)
                      (do
                        (set-pos! r (+ (pos r) 1))
                        (note-expression-end! r)
                        (let [node `(plus ~base
                                           ~(load span-start)
                                           ~(load span-end)
                                           ~(primitive/code-symbol grammar-source))]
                          (record-expression-span! r operand-start (pos r))
                          node))
                    (= (ch r (pos r)) 63)
                      (do
                        (set-pos! r (+ (pos r) 1))
                        (note-expression-end! r)
                        (let [node `(opt ~base
                                          ~(load span-start)
                                          ~(load span-end)
                                          ~(primitive/code-symbol grammar-source))]
                          (record-expression-span! r operand-start (pos r))
                          node))
                    :else base))
          (= mode 3)
            (cond (= (ch r (pos r)) 126)
                    (do
                      (set-pos! r (+ (pos r) 1))
                      (let [child (parse-expression context raw rule-indent 3)
                            node `(not ~child)]
                        (record-expression-span! r
                                                 expression-start
                                                 (load (field r last-expression-end)))
                        node))
                  (= (ch r (pos r)) 38)
                    (do
                      (set-pos! r (+ (pos r) 1))
                      (let [child (parse-expression context raw rule-indent 3)
                            node `(look ~child)]
                        (record-expression-span! r
                                                 expression-start
                                                 (load (field r last-expression-end)))
                        node))
                  (= (ch r (pos r)) 35)
                    (do
                      (set-pos! r (+ (pos r) 1))
                      (let [child (parse-expression context raw rule-indent 3)
                            node `(lex ~child)]
                        (record-expression-span! r
                                                 expression-start
                                                 (load (field r last-expression-end)))
                        node))
                  :else (parse-expression context raw rule-indent 4))
          :else
            (let [c (ch r (pos r))]
              (cond (= c 34)
                      (let [literal (read-terminal context r)]
                        (note-expression-end! r)
                        (ws! r)
                        (if (and (= (ch r (pos r)) 46) (= (ch r (+ (pos r) 1)) 46))
                            (let [range-operator-start (pos r)]
                              (set-pos! r (+ (pos r) 2))
                              (ws! r)
                              (let [hi-source-start (pos r)
                                    hi (read-terminal context r)]
                                (note-expression-end! r)
                                (if (not (utf8-single-scalar? literal))
                                    (reader-source-error r
                                                         range-operator-start
                                                         range-operator-start
                                                         "Expected \"}\"")
                                    0)
                                (if (not (utf8-single-scalar? hi))
                                    (let [second-scalar-start
                                            (+ hi-source-start
                                               (+ 1
                                                  (reader-utf8-width r
                                                                     (+ hi-source-start 1))))]
                                      (reader-source-error r
                                                           second-scalar-start
                                                           second-scalar-start
                                                           "Expected \"\\\"\""))
                                    0)
                                (let [node `(range ~(utf8-first-scalar literal)
                                                   ~(utf8-first-scalar hi)
                                                   ~(primitive/code-symbol literal)
                                                   ~(primitive/code-symbol hi))]
                                  (record-expression-span! r
                                                           expression-start
                                                           (load (field r last-expression-end)))
                                  node)))
                            (let [node `(terminal ~(primitive/code-symbol literal))]
                              (record-expression-span! r
                                                       expression-start
                                                       (load (field r last-expression-end)))
                              node)))
                    (and (= c 46)
                         (= (ch r (+ (pos r) 1)) 46)
                         (= (ch r (+ (pos r) 2)) 46))
                      (do
                        (set-pos! r (+ (pos r) 3))
                        (note-expression-end! r)
                        (let [node `(super-splice)]
                          (record-expression-span! r expression-start (pos r))
                          node))
                    (= c 40)
                      (do
                        (set-pos! r (+ (pos r) 1))
                        (let [body (parse-expression context raw rule-indent 0)]
                          (if (not (accept-char! r 41)) (fail context r "expected ')'") 0)
                          (note-expression-end! r)
                          body))
                    (> (ident-start-width r (pos r)) 0)
                      (let [name (read-ident context r)
                            name-end (pos r)
                            (mut application-end) (pos r)
                            (mut args) (primitive/code-list-new)]
                        (if (accept-char! r 60)
                            (do
                              (ws! r)
                              (if (not (= (ch r (pos r)) 62))
                                  (loop (push! (mut args)
                                               (parse-expression context raw rule-indent 1))
                                    (if (accept-char! r 44) 0 (break)))
                                  0)
                              (if (not (accept-char! r 62))
                                  (fail context
                                        r
                                        "Expected \">\", \",\", \"(\", \"\\\"\", an identifier, \"#\", \"&\", \"~\", \"..\", \"?\", \"+\", or \"*\"")
                                  0)
                              (set! application-end (pos r)))
                            0)
                        (store! (field r last-expression-end) (load application-end))
                        (store! (field r last-rule-end) (load application-end))
                        (let [finished-args (primitive/code-list-done (load args))]
                          (let [node `(app ~(primitive/code-symbol name)
                                           (~@finished-args)
                                           ~expression-start
                                           ~(load application-end))]
                            (record-expression-span! r expression-start (load application-end))
                            node)))
                    :else (do (fail context r "expected grammar expression") `())))))))

(defn skip-balanced! [(context Code) (r (ptr OhmReader)) (open i64) (close i64)] (-> i64)
  (if (not (accept-char! r open))
      0
      (let [(mut depth) 1]
        (loop (let [c (ch r (pos r))]
                (cond (< c 0) (fail context r "unterminated rule header")
                      (= c open) (do (store! depth (+ (load depth) 1)) (set-pos! r (+ (pos r) 1)))
                      (= c close)
                        (do
                          (store! depth (- (load depth) 1))
                          (set-pos! r (+ (pos r) 1))
                          (if (= (load depth) 0) (break) 0))
                      (= c 34) (do (read-terminal context r) 0)
                      :else (set-pos! r (+ (pos r) 1)))))
        (pos r))))

(defn read-formals [(context Code)
                    (r (ptr OhmReader))
                    (rule-name (slice u8))] (-> Code)
  (let [(mut formals) (primitive/code-list-new)
        (mut names) (al/al-new [(slice u8)] (malloc-allocator))
        (mut duplicates) (al/al-new [(slice u8)] (malloc-allocator))]
    (if (accept-char! r 60)
        (do
          (ws! r)
          (if (not (= (ch r (pos r)) 62))
              (let [(mut reading) true]
                (loop (if (not (load reading))
                          (break)
                          (let [formal (read-ident context r)
                                (mut duplicate) false]
                            (for existing
                              (iter (load names))
                              (if (str/str-eq existing formal)
                                  (set! duplicate true)
                                  0))
                            (if (load duplicate)
                                (let [(mut already-recorded) false]
                                  (for existing
                                    (iter (load duplicates))
                                    (if (str/str-eq existing formal)
                                        (set! already-recorded true)
                                        0))
                                  (if (not (load already-recorded))
                                      (push! (mut duplicates) formal)
                                      0))
                                (push! (mut names) formal))
                            (push! (mut formals) (primitive/code-symbol formal))
                            (if (accept-char! r 44)
                                0
                                (set! reading false))))))
              0)
          (if (not (accept-char! r 62)) (fail context r "expected '>'") 0)
          0)
        0)
    (let [result (primitive/code-list-done (load formals))]
      (al/al-free! (mut names))
      (al/al-free! (mut duplicates))
      result)))

(defn validate-duplicate-formals [(rule-name (slice u8))
                                  (formals Code)
                                  (source-start i64)
                                  (source-end i64)] (-> i64)
  (let [(mut duplicates) (al/al-new [(slice u8)] (malloc-allocator))]
    (for [index 0 (len formals)]
      (let [wanted (primitive/code-sym (get formals index))
            (mut earlier) false
            (mut recorded) false]
        (for [scan 0 index]
          (if (str/str-eq (primitive/code-sym (get formals scan)) wanted)
              (set! earlier true)
              0))
        (for existing (iter (load duplicates))
          (if (str/str-eq existing wanted) (set! recorded true) 0))
        (if (and (load earlier) (not (load recorded)))
            (push! (mut duplicates) wanted)
            0)))
    (if (> (len (load duplicates)) 0)
        (let [(mut message) (str/sb-new (malloc-allocator))
              (mut index) 0]
          (str/sb-push-str! (mut message) "Duplicate parameter names in rule ")
          (str/sb-push-str! (mut message) rule-name)
          (str/sb-push-str! (mut message) ": ")
          (for duplicate (iter (load duplicates))
            (do
              (if (> (load index) 0) (str/sb-push-str! (mut message) ", ") 0)
              (str/sb-push-str! (mut message) duplicate)
              (set! index (+ (load index) 1))))
          (compiler-source-error source-start source-end (str/sb-finish! (mut message))))
        0)
    (al/al-free! (mut duplicates))
    0))

(defn parse-rules [(context Code) (raw i64)] (-> Code)
  (let [r (primitive/cast (ptr OhmReader) raw)
        (mut rules) (primitive/code-list-new)]
    (loop (ws! r)
      (if (or (< (ch r (pos r)) 0) (= (ch r (pos r)) 125))
          (break)
          (let [start (pos r)
                indent (line-indent r start)
                name (read-ident context r)
                formals (read-formals context r name)
                (mut description) ""]
            (store! (field r source-rule-name) name)
            (ws! r)
            ;; A parenthesized description is present only when followed by a
            ;; rule operator. Save/restore if this was actually the expression.
            (if (= (ch r (pos r)) 40)
                (let [saved (pos r)]
                  (let [after (skip-balanced! context r 40 41)]
                    (set! description (subslice (load (field r source)) (+ saved 1) (- after 1))))
                  (ws! r)
                  (if (not (or (= (ch r (pos r)) 61)
                               (and (= (ch r (pos r)) 58) (= (ch r (+ (pos r) 1)) 61))
                               (and (= (ch r (pos r)) 43) (= (ch r (+ (pos r) 1)) 61))))
                      (do
                        (set-pos! r saved)
                        (set! description ""))
                      0))
                0)
            (ws! r)
            (let [(mut operation) 0]
              (cond (accept-op! r 43 61) (store! operation 2)
                    (accept-op! r 58 61) (store! operation 1)
                    (accept-char! r 61) (store! operation 0)
                    :else (fail context r "expected '=', ':=', or '+='"))
              (ws! r)
              (let [body-start (pos r)
                    expression-span-start (len (load (field r expression-spans)))
                    _ (store! (field r last-expression-end) (pos r))
                    _rule-end (store! (field r last-rule-end) (pos r))
                    body-node (parse-expression context (primitive/cast i64 r) indent 0)]
                (validate-duplicate-formals name
                                            formals
                                            start
                                            (load (field r last-rule-end)))
                (let [(mut meta) (primitive/zeroed OhmRuleMeta)]
                    (set! (.name meta) name)
                    (set! (.operation meta) (load operation))
                    (set! (.description meta) (load description))
                    (set! (.source-start meta) start)
                    (set! (.source-end meta) (load (field r last-rule-end)))
                    (set! (.diagnostic-source-start meta) start)
                    (set! (.diagnostic-source-end meta) (load (field r last-rule-end)))
                    (set! (.body-start meta) body-start)
                    (set! (.body-end meta) (load (field r last-expression-end)))
                    (set! (.expression-span-start meta) expression-span-start)
                    (set! (.expression-span-count meta)
                          (- (len (load (field r expression-spans)))
                             expression-span-start))
                    (push! (mut (field r rule-metas)) (load meta))
                    (if (load (field r record-template-priority))
                        (push! (mut (field r template-priority)) name)
                        0)
                  (push! (mut rules)
                         `(rule ~(primitive/code-symbol name)
                                ~formals
                                ~body-node
                                ~(load operation)))))))))
    (primitive/code-list-done (load rules))))

(defn tag? [(node Code) (name (slice u8))] (-> bool)
  (and (primitive/code-list? node)
       (> (len node) 0)
       (primitive/code-sym? (get node 0))
       (= (primitive/code-sym (get node 0)) name)))

(defn name-index [(names Code) (wanted (slice u8))] (-> i64)
  (let [(mut index) 0
        (mut answer) -1]
    (loop (if (or (>= (load index) (len names)) (>= (load answer) 0))
              (break)
              (do
                (if (str/str-eq (primitive/code-sym (get names (load index))) wanted)
                    (set! answer (load index))
                    0)
                (set! index (+ (load index) 1)))))
    (load answer)))

(defn find-rule-index [(rule-metas (al/ArrayList OhmRuleMeta))
                       (wanted (slice u8))] (-> i64)
  (let [(mut index) 0
        (mut answer) -1]
    (loop (if (or (>= (load index) (len rule-metas)) (>= (load answer) 0))
              (break)
              (let [meta (get rule-metas (load index))]
                (if (str/str-eq (.name meta) wanted)
                    (set! answer (load index))
                    0)
                (set! index (+ (load index) 1)))))
    (load answer)))

(defn expand-expr [(context Code)
                   (node Code)
                   (rules Code)
                   (rule-metas (al/ArrayList OhmRuleMeta))
                   (formals Code)
                   (actuals Code)] (-> Code)
  (cond (tag? node "app")
          (let [name (primitive/code-sym (get node 1))
                formal-index (name-index formals name)]
            (if (>= formal-index 0)
                (do
                  (if (not (= (len (get node 2)) 0))
                      (primitive/error "Ohm compiler: a formal parameter cannot take arguments")
                      0)
                  (expand-expr context (get actuals formal-index) rules rule-metas `() `()))
                (let [target-index (find-rule-index rule-metas name)
                      supplied (get node 2)]
                  (if (< target-index 0)
                      node
                      (let [target (get rules target-index)
                            target-formals (get target 2)]
                        (if (not (= (len supplied) (len target-formals)))
                            (let [(mut message) (str/sb-new (malloc-allocator))]
                              (str/sb-push-str! (mut message) "Wrong number of arguments for rule ")
                              (str/sb-push-str! (mut message) name)
                              (primitive/error (str/sb-finish! (mut message))))
                            0)
                        (if (= (len target-formals) 0)
                            node
                            (let [(mut expanded-actuals) (primitive/code-list-new)]
                              (for actual
                                (iter supplied)
                                (push! (mut expanded-actuals)
                                       (expand-expr context actual rules rule-metas formals actuals)))
                              `(named ~(get target 1)
                                      ~(expand-expr context
                                                    (get target 3)
                                                    rules
                                                    rule-metas
                                                    target-formals
                                                    (primitive/code-list-done (load expanded-actuals)))))))))))
        (or (tag? node "star")
            (tag? node "plus")
            (tag? node "opt")
            (tag? node "not")
            (tag? node "look")
            (tag? node "lex"))
          `(~(primitive/code-symbol (primitive/code-sym (get node 0))) ~(expand-expr context
                                                                                     (get node 1)
                                                                                     rules
                                                                                     rule-metas
                                                                                     formals
                                                                                     actuals))
        (tag? node "splice")
          `(splice ~(expand-expr context
                                 (get node 1)
                                 rules
                                 rule-metas
                                 formals
                                 actuals)
                   ~(get node 2))
        (tag? node "case")
          `(case ~(primitive/code-int (get node 1)) ~(expand-expr context (get node 2) rules rule-metas formals actuals))
        (or (tag? node "alt") (tag? node "seq"))
          (let [(mut children) (primitive/code-list-new)]
            (for child
              (iter (get node 1))
              (push! (mut children)
                     (expand-expr context child rules rule-metas formals actuals)))
            `(~(primitive/code-symbol (primitive/code-sym (get node 0))) (~@(primitive/code-list-done (load children)))))
        :else node))

(defn expression-arity [(node Code)] (-> i64)
  (cond (and (tag? node "app")
             (str/str-eq (primitive/code-str (get node 1)) "__builtin_end"))
          0
        (or (tag? node "terminal")
            (tag? node "range")
            (tag? node "app")
            (tag? node "runtime-arg"))
          1
        (tag? node "not") 0
        (or (tag? node "star")
            (tag? node "plus")
            (tag? node "opt")
            (tag? node "look")
            (tag? node "lex"))
          (expression-arity (get node 1))
        (tag? node "splice") (expression-arity (get node 1))
        ;; An inline case is an implicit nonterminal rule and therefore binds
        ;; one CST node regardless of the arity of its body.
        (tag? node "case") 1
        (tag? node "seq")
          (let [(mut arity) 0]
            (for child
              (iter (get node 1))
              (set! arity (+ (load arity) (expression-arity child))))
            (load arity))
        (tag? node "alt")
          (if (= (len (get node 1)) 0)
              0
              (expression-arity (get (get node 1) 0)))
        :else 0))

(defn append-template-action! [(builder (mut str/StrBuf))
                               (names (mut (al/ArrayList (slice u8))))
                               (first (mut bool))
                               (name (slice u8))
                               (arity i64)] (-> i64)
  (if (template-name-present? names name)
      0
      (do
        (if (load first)
            (store! first false)
            (str/sb-push-str! (mut builder) ","))
        (str/sb-push-str! (mut builder) "\n  ")
        (str/sb-push-str! (mut builder) name)
        (str/sb-push-str! (mut builder) ": function(")
        (for [index 0 arity]
          (do
            (if (> index 0) (str/sb-push-str! (mut builder) ", ") 0)
            (str/sb-push-str! (mut builder) "_")))
        (str/sb-push-str! (mut builder) ") {\n  }")
        (push! (mut names) name)
        0)))

(defn build-action-dictionary-template [(rules Code)
                                        (cases (al/ArrayList OhmCase))
                                        (priority (al/ArrayList (slice u8)))
                                        (indentation-sensitive bool)] (-> (slice u8))
  (let [(mut builder) (str/sb-new (malloc-allocator))
        (mut names) (al/al-new [(slice u8)] (malloc-allocator))
        (mut first) true]
    (str/sb-push-str! (mut builder) "{")
    (for priority-name
      (iter priority)
      (for rule
        (iter rules)
        (if (and (not (tag? rule "bound-rule"))
                 (str/str-eq (primitive/code-str (get rule 1)) priority-name))
            (do
              (for case-value
                (iter cases)
                (let [case-data case-value]
                  (if (str/str-eq (.base case-data) priority-name)
                      (let [(mut case-name) (str/sb-new (malloc-allocator))]
                        (str/sb-push-str! (mut case-name) priority-name)
                        (str/sb-push-str! (mut case-name) "_")
                        (str/sb-push-str! (mut case-name) (.label case-data))
                        (append-template-action! (mut builder)
                                                 (mut names)
                                                 (mut first)
                                                 (str/sb-finish! (mut case-name))
                                                 (.arity case-data)))
                      0)))
              (append-template-action! (mut builder)
                                       (mut names)
                                       (mut first)
                                       priority-name
                                       (expression-arity (get rule 3))))
            0)))
    (for rule
      (iter rules)
      (if (not (tag? rule "bound-rule"))
          (let [rule-name (primitive/code-str (get rule 1))]
            (for case-value
              (iter cases)
              (let [case-data case-value]
                (if (str/str-eq (.base case-data) rule-name)
                    (let [(mut case-name) (str/sb-new (malloc-allocator))]
                      (str/sb-push-str! (mut case-name) rule-name)
                      (str/sb-push-str! (mut case-name) "_")
                      (str/sb-push-str! (mut case-name) (.label case-data))
                      (append-template-action! (mut builder)
                                               (mut names)
                                               (mut first)
                                               (str/sb-finish! (mut case-name))
                                               (.arity case-data)))
                    0)))
            (append-template-action! (mut builder)
                                     (mut names)
                                     (mut first)
                                     rule-name
                                     (expression-arity (get rule 3))))
          0))
    (for builtin-code
      (iter `("alnum" "letter"
                      "digit"
                      "hexDigit"
                      "ListOf"
                      "NonemptyListOf"
                      "EmptyListOf"
                      "listOf"
                      "nonemptyListOf"
                      "emptyListOf"
                      "applySyntactic"
                      "any"
                      "end"
                      "caseInsensitive"
                      "lower"
                      "upper"
                      "unicodeLtmo"
                      "indent"
                      "dedent"
                      "spaces"
                      "space"))
      (let [builtin-name (primitive/code-str builtin-code)
            arity
              (cond (or (str/str-eq builtin-name "EmptyListOf")
                        (str/str-eq builtin-name "emptyListOf"))
                      0
                    (or (str/str-eq builtin-name "NonemptyListOf")
                        (str/str-eq builtin-name "nonemptyListOf"))
                      3
                    :else 1)]
        (if (or indentation-sensitive
                (and (not (str/str-eq builtin-name "indent"))
                     (not (str/str-eq builtin-name "dedent"))))
            (append-template-action! (mut builder)
                                     (mut names)
                                     (mut first)
                                     builtin-name
                                     arity)
            0)))
    (str/sb-push-str! (mut builder) "\n}")
    (al/al-free! (mut names))
    (str/sb-finish! (mut builder))))

(defn inherited-expression-arity [(node Code) (super-expression Code)] (-> i64)
  (cond (tag? node "super-splice") (expression-arity super-expression)
        (tag? node "seq")
          (let [(mut arity) 0]
            (for child
              (iter (get node 1))
              (set! arity
                    (+ (load arity)
                       (inherited-expression-arity child super-expression))))
            (load arity))
        (tag? node "alt")
          (if (= (len (get node 1)) 0)
              0
              (inherited-expression-arity (get (get node 1) 0) super-expression))
        (tag? node "case") 1
        (or (tag? node "star")
            (tag? node "plus")
            (tag? node "opt")
            (tag? node "look")
            (tag? node "lex"))
          (inherited-expression-arity (get node 1) super-expression)
        :else (expression-arity node)))

(defn validate-alternation-arities [(rule-name (slice u8))
                                    (node Code)
                                    (super-expression Code)] (-> i64)
  (cond (tag? node "alt")
          (let [choices (get node 1)]
            (if (> (len choices) 0)
                (let [expected (inherited-expression-arity (get choices 0) super-expression)]
                  (for [index 1 (len choices)]
                    (let [choice (get choices index)
                          actual (inherited-expression-arity choice super-expression)]
                      (if (not (= actual expected))
                          (let [(mut message) (str/sb-new (malloc-allocator))]
                            (str/sb-push-str! (mut message) "Rule ")
                            (str/sb-push-str! (mut message) rule-name)
                            (str/sb-push-str! (mut message)
                                              " involves an alternation which has inconsistent arity (expected ")
                            (str/sb-push-i64! (mut message) expected)
                            (str/sb-push-str! (mut message) ", got ")
                            (str/sb-push-i64! (mut message) actual)
                            (str/sb-push-str! (mut message) ")")
                            (compiler-expression-error choice
                                                       (str/sb-finish! (mut message))))
                          0)))
                  (for choice
                    (iter choices)
                    (validate-alternation-arities rule-name choice super-expression)))
                0))
        (tag? node "seq")
          (for child
            (iter (get node 1))
            (validate-alternation-arities rule-name child super-expression))
        (or (tag? node "star")
            (tag? node "plus")
            (tag? node "opt")
            (tag? node "look"))
          (validate-alternation-arities rule-name (get node 1) super-expression)
        (tag? node "splice")
          (validate-alternation-arities rule-name (get node 1) super-expression)
        (tag? node "case") (validate-alternation-arities rule-name (get node 2) super-expression)
        ;; Ohm deliberately does not inspect alternations hidden by negative
        ;; lookahead, lexicalization, or application arguments here: none of
        ;; their nested bindings are exposed directly in this rule's CST.
        (or (tag? node "not") (tag? node "lex") (tag? node "app")) 0
        :else 0)
  0)

(defn expression-nullable? [(node Code)
                            (rules Code)
                            (rule-metas (al/ArrayList OhmRuleMeta))
                            (formals Code)
                            (actuals Code)
                            (visited (mut (al/ArrayList bool)))] (-> bool)
  (cond (tag? node "terminal") (= (slice-len (primitive/code-str (get node 1))) 0)
        (tag? node "range") false
        (tag? node "super-splice") false
        (tag? node "app")
          (let [name (primitive/code-str (get node 1))
                formal-index (name-index formals name)]
            (if (>= formal-index 0)
                (if (> (len actuals) formal-index)
                    (expression-nullable? (get actuals formal-index)
                                          rules
                                          rule-metas
                                          `()
                                          `()
                                          (mut visited))
                    false)
                (let [target-index (find-rule-index rule-metas name)]
                  (if (< target-index 0)
                      (cond (or (str/str-eq name "end")
                                (str/str-eq name "spaces")
                                (str/str-eq name "ListOf")
                                (str/str-eq name "listOf")
                                (str/str-eq name "EmptyListOf")
                                (str/str-eq name "emptyListOf"))
                              true
                            (or (str/str-eq name "NonemptyListOf")
                                (str/str-eq name "nonemptyListOf"))
                              (if (> (len (get node 2)) 0)
                                  (expression-nullable? (get (get node 2) 0)
                                                        rules
                                                        rule-metas
                                                        formals
                                                        actuals
                                                        (mut visited))
                                  false)
                            :else false)
                      (if (get (load visited) target-index)
                          false
                          (do
                            (store! (al/al-elem [bool] visited target-index) true)
                            (let [target (get rules target-index)
                                  nullable
                                    (expression-nullable? (get target 3)
                                                          rules
                                                          rule-metas
                                                          (get target 2)
                                                          (get node 2)
                                                          (mut visited))]
                              (store! (al/al-elem [bool] visited target-index) false)
                              nullable)))))))
        (tag? node "alt")
          (let [(mut nullable) (= (len (get node 1)) 0)]
            (for child
              (iter (get node 1))
              (if (and (not (load nullable))
                       (expression-nullable? child rules rule-metas formals actuals (mut visited)))
                  (set! nullable true)
                  0))
            (load nullable))
        (tag? node "seq")
          (let [(mut nullable) true]
            (for child
              (iter (get node 1))
              (if (and (load nullable)
                       (not (expression-nullable? child
                                                  rules
                                                  rule-metas
                                                  formals
                                                  actuals
                                                  (mut visited))))
                  (set! nullable false)
                  0))
            (load nullable))
        (or (tag? node "star")
            (tag? node "opt")
            (tag? node "not")
            (tag? node "look"))
          true
        (tag? node "plus") false
        (tag? node "lex") (expression-nullable? (get node 1) rules rule-metas formals actuals (mut visited))
        (tag? node "splice")
          (expression-nullable? (get node 1) rules rule-metas formals actuals (mut visited))
        (tag? node "case") (expression-nullable? (get node 2) rules rule-metas formals actuals (mut visited))
        :else false))

(defn reader-decimal-digits [(value i64)] (-> i64)
  (let [(mut digits) 1
        (mut remaining) value]
    (loop (if (< (load remaining) 10)
              (break)
              (do
                (store! remaining (/ (load remaining) 10))
                (store! digits (+ (load digits) 1)))))
    (load digits)))

(defn nullable-repetition-error [(source (slice u8))
                                 (node Code)
                                 (formals Code)
                                 (actuals Code)] (-> i64)
  (let [start (if (> (len node) 2) (primitive/code-int (get node 2)) 0)
        end (if (> (len node) 3) (primitive/code-int (get node 3)) (+ start 1))
        (mut message) (str/sb-new (malloc-allocator))
        reader (primitive/alloc-stack OhmReader)]
    (str/sb-push-str! (mut message) "Nullable expression ")
    (str/sb-push-str! (mut message) (expression-string (get node 1) formals actuals))
    (str/sb-push-str! (mut message) " is not allowed inside '")
    (str/sb-push-str! (mut message) (if (tag? node "star") "*" "+"))
    (str/sb-push-str! (mut message) "' (possible infinite loop)")
    (store! (field reader source) source)
    (reader-source-error reader start end (str/sb-finish! (mut message)))))

(defn validate-nullable-repetitions [(source (slice u8))
                                     (node Code)
                                     (rules Code)
                                     (rule-metas (al/ArrayList OhmRuleMeta))
                                     (formals Code)
                                     (actuals Code)] (-> i64)
  (cond (or (tag? node "star") (tag? node "plus"))
          (do
            (validate-nullable-repetitions source (get node 1) rules rule-metas formals actuals)
            (let [(mut visited) (al/al-new [bool] (malloc-allocator))]
              (for [_ 0 (len rules)] (push! (mut visited) false))
              (if (expression-nullable? (get node 1)
                                        rules
                                        rule-metas
                                        formals
                                        actuals
                                        (mut visited))
                  (nullable-repetition-error source node formals actuals)
                  0)
              (al/al-free! (mut visited))))
        (or (tag? node "opt")
            (tag? node "not")
            (tag? node "look")
            (tag? node "lex"))
          (validate-nullable-repetitions source (get node 1) rules rule-metas formals actuals)
        (tag? node "splice")
          (validate-nullable-repetitions source (get node 1) rules rule-metas formals actuals)
        (tag? node "case") (validate-nullable-repetitions source (get node 2) rules rule-metas formals actuals)
        (or (tag? node "alt") (tag? node "seq"))
          (for child
            (iter (get node 1))
            (validate-nullable-repetitions source child rules rule-metas formals actuals))
        (tag? node "app")
          (for argument
            (iter (get node 2))
            (validate-nullable-repetitions source argument rules rule-metas formals actuals))
        :else 0)
  0)

(defn expression-applies-name? [(node Code) (wanted (slice u8))] (-> bool)
  (cond (tag? node "app")
          (let [(mut found) (str/str-eq (primitive/code-str (get node 1)) wanted)]
            (for argument
              (iter (get node 2))
              (if (and (not (load found)) (expression-applies-name? argument wanted))
                  (set! found true)
                  0))
            (load found))
        (or (tag? node "star")
            (tag? node "plus")
            (tag? node "opt")
            (tag? node "not")
            (tag? node "look")
            (tag? node "lex"))
          (expression-applies-name? (get node 1) wanted)
        (tag? node "splice") (expression-applies-name? (get node 1) wanted)
        (tag? node "case") (expression-applies-name? (get node 2) wanted)
        (or (tag? node "alt") (tag? node "seq"))
          (let [(mut found) false]
            (for child
              (iter (get node 1))
              (if (and (not (load found)) (expression-applies-name? child wanted))
                  (set! found true)
                  0))
            (load found))
        :else false))

(defn wrong-argument-count [(name (slice u8)) (expected i64) (actual i64)] (-> i64)
  (let [(mut message) (str/sb-new (malloc-allocator))]
    (str/sb-push-str! (mut message) "Wrong number of arguments for rule ")
    (str/sb-push-str! (mut message) name)
    (str/sb-push-str! (mut message) " (expected ")
    (str/sb-push-i64! (mut message) expected)
    (str/sb-push-str! (mut message) ", got ")
    (str/sb-push-i64! (mut message) actual)
    (str/sb-push-str! (mut message) ")")
    (primitive/error (str/sb-finish! (mut message)))))

(defn current-grammar-source-cell [] (-> (ptr (slice u8)))
  (primitive/alloc-static (slice u8)))

(defn set-current-grammar-source! [(source (slice u8))] (-> i64)
  (store! (current-grammar-source-cell) source)
  0)

(defn single-grammar-mode-cell [] (-> (ptr bool))
  (primitive/alloc-static bool))

(defn set-single-grammar-mode! [(enabled bool)] (-> i64)
  (store! (single-grammar-mode-cell) enabled)
  0)

(defn cst-differential-mode-cell [] (-> (ptr bool))
  (primitive/alloc-static bool))

(defn set-cst-differential-mode! [(enabled bool)] (-> i64)
  (store! (cst-differential-mode-cell) enabled)
  0)

(defn trace-differential-mode-cell [] (-> (ptr bool))
  (primitive/alloc-static bool))

(defn set-trace-differential-mode! [(enabled bool)] (-> i64)
  (store! (trace-differential-mode-cell) enabled)
  0)

(defn compiler-expression-error [(node Code) (message (slice u8))] (-> i64)
  (let [(mut start) -1
        (mut end) -1]
    (cond (and (or (tag? node "alt") (tag? node "seq"))
               (> (len node) 3))
            (do
              (set! start (primitive/code-int (get node 2)))
              (set! end (primitive/code-int (get node 3))))
          (and (tag? node "app")
               (> (len node) 4)
               (primitive/code-int? (get node 3)))
            (do
              (set! start (primitive/code-int (get node 3)))
              (set! end (primitive/code-int (get node 4))))
          (and (tag? node "named") (> (len node) 2))
            (compiler-expression-error (get node 2) message)
          (and (or (tag? node "lex")
                   (or (tag? node "not")
                       (or (tag? node "look")
                           (or (tag? node "star")
                               (or (tag? node "plus")
                                   (or (tag? node "opt")
                                       (tag? node "splice")))))))
               (> (len node) 1))
            (compiler-expression-error (get node 1) message)
          (and (tag? node "case") (> (len node) 2))
            (compiler-expression-error (get node 2) message)
          :else 0)
    (if (>= (load start) 0)
        (let [reader (primitive/alloc-stack OhmReader)]
          (store! (field reader source) (load (current-grammar-source-cell)))
          (reader-source-error reader (load start) (load end) message))
        (primitive/error message))))

(defn compiler-source-error [(start i64)
                             (end i64)
                             (message (slice u8))] (-> i64)
  (let [reader (primitive/alloc-stack OhmReader)]
    (store! (field reader source) (load (current-grammar-source-cell)))
    (reader-source-error reader start end message)))

(defn wrong-argument-count-at [(name (slice u8))
                               (expected i64)
                               (actual i64)
                               (node Code)] (-> i64)
  (if (and (> (len node) 4)
           (and (primitive/code-int? (get node 3))
                (primitive/code-int? (get node 4))))
      (let [(mut message) (str/sb-new (malloc-allocator))
            source (load (current-grammar-source-cell))
            reader (primitive/alloc-stack OhmReader)]
        (str/sb-push-str! (mut message) "Wrong number of arguments for rule ")
        (str/sb-push-str! (mut message) name)
        (str/sb-push-str! (mut message) " (expected ")
        (str/sb-push-i64! (mut message) expected)
        (str/sb-push-str! (mut message) ", got ")
        (str/sb-push-i64! (mut message) actual)
        (str/sb-push-str! (mut message) ")")
        (store! (field reader source) source)
        (reader-source-error reader
                             (primitive/code-int (get node 3))
                             (primitive/code-int (get node 4))
                             (str/sb-finish! (mut message))))
      (wrong-argument-count name expected actual)))

(defn wrong-parameter-count [(name (slice u8)) (expected i64) (actual i64)] (-> i64)
  (let [(mut message) (str/sb-new (malloc-allocator))]
    (str/sb-push-str! (mut message) "Wrong number of parameters for rule ")
    (str/sb-push-str! (mut message) name)
    (str/sb-push-str! (mut message) " (expected ")
    (str/sb-push-i64! (mut message) expected)
    (str/sb-push-str! (mut message) ", got ")
    (str/sb-push-i64! (mut message) actual)
    (str/sb-push-str! (mut message) ")")
    (primitive/error (str/sb-finish! (mut message)))))

(defn wrong-parameter-count-at [(name (slice u8))
                                (expected i64)
                                (actual i64)
                                (meta OhmRuleMeta)] (-> i64)
  (let [(mut message) (str/sb-new (malloc-allocator))]
    (str/sb-push-str! (mut message) "Wrong number of parameters for rule ")
    (str/sb-push-str! (mut message) name)
    (str/sb-push-str! (mut message) " (expected ")
    (str/sb-push-i64! (mut message) expected)
    (str/sb-push-str! (mut message) ", got ")
    (str/sb-push-i64! (mut message) actual)
    (str/sb-push-str! (mut message) ")")
    (compiler-source-error (.diagnostic-source-start meta)
                           (.diagnostic-source-end meta)
                           (str/sb-finish! (mut message)))))

(defn inconsistent-extension-arity [(name (slice u8))
                                    (expected i64)
                                    (actual i64)
                                    (expression Code)] (-> i64)
  (let [(mut message) (str/sb-new (malloc-allocator))]
    (str/sb-push-str! (mut message) "Rule ")
    (str/sb-push-str! (mut message) name)
    (str/sb-push-str! (mut message)
                      " involves an alternation which has inconsistent arity (expected ")
    (str/sb-push-i64! (mut message) expected)
    (str/sb-push-str! (mut message) ", got ")
    (str/sb-push-i64! (mut message) actual)
    (str/sb-push-str! (mut message) ")")
    (compiler-expression-error expression (str/sb-finish! (mut message)))))

(defn invalid-parameter [(name (slice u8)) (expression Code) (arity i64)] (-> i64)
  (let [(mut message) (str/sb-new (malloc-allocator))]
    (str/sb-push-str! (mut message) "Invalid parameter to rule ")
    (str/sb-push-str! (mut message) name)
    (str/sb-push-str! (mut message) ": ")
    (str/sb-push-str! (mut message) (expression-string expression `() `()))
    (str/sb-push-str! (mut message) " has arity ")
    (str/sb-push-i64! (mut message) arity)
    (str/sb-push-str! (mut message) ", but parameter expressions must have arity 1")
    (compiler-expression-error expression (str/sb-finish! (mut message)))))

(defn current-grammar-name-cell [] (-> (ptr (slice u8)))
  (primitive/alloc-static (slice u8)))

(defn set-current-grammar-name! [(name (slice u8))] (-> i64)
  (store! (current-grammar-name-cell) name)
  0)

(defn undeclared-rule [(name (slice u8)) (expression Code)] (-> i64)
  (let [(mut message) (str/sb-new (malloc-allocator))]
    (str/sb-push-str! (mut message) "Rule ")
    (str/sb-push-str! (mut message) name)
    (str/sb-push-str! (mut message) " is not declared")
    (let [grammar-name (load (current-grammar-name-cell))]
      (if (> (slice-len grammar-name) 0)
          (do
            (str/sb-push-str! (mut message) " in grammar ")
            (str/sb-push-str! (mut message) grammar-name))
          0))
    (compiler-expression-error expression (str/sb-finish! (mut message)))))

(defn reject-undeclared-application! [(name (slice u8)) (node Code)] (-> i64)
  (cond (tag? node "app")
          (do
            (if (str/str-eq (primitive/code-sym (get node 1)) name)
                (undeclared-rule name node)
                0)
            (for argument (iter (get node 2))
              (reject-undeclared-application! name argument)))
        (or (tag? node "alt") (tag? node "seq"))
          (for child (iter (get node 1))
            (reject-undeclared-application! name child))
        (or (tag? node "lex")
            (or (tag? node "not")
                (or (tag? node "look")
                    (or (tag? node "star")
                        (or (tag? node "plus")
                            (or (tag? node "opt") (tag? node "splice")))))))
          (reject-undeclared-application! name (get node 1))
        (or (tag? node "named") (tag? node "case"))
          (reject-undeclared-application! name (get node 2))
        :else 0)
  0)

(defn expression-reaches-rule? [(node Code)
                                (target i64)
                                (rules Code)
                                (rule-metas (al/ArrayList OhmRuleMeta))
                                (visited (mut (al/ArrayList bool)))] (-> bool)
  (cond (tag? node "app")
          (let [name (primitive/code-str (get node 1))
                index (find-rule-index rule-metas name)]
            (cond (< index 0) false
                  (= index target) true
                  (get (load visited) index) false
                  :else
                    (do
                      (store! (al/al-elem [bool] visited index) true)
                      (expression-reaches-rule? (get (get rules index) 3)
                                                target
                                                rules
                                                rule-metas
                                                (mut visited)))))
        (or (tag? node "star")
            (tag? node "plus")
            (tag? node "opt")
            (tag? node "not")
            (tag? node "look")
            (tag? node "lex"))
          (expression-reaches-rule? (get node 1) target rules rule-metas (mut visited))
        (tag? node "splice")
          (expression-reaches-rule? (get node 1) target rules rule-metas (mut visited))
        (tag? node "case") (expression-reaches-rule? (get node 2) target rules rule-metas (mut visited))
        (or (tag? node "alt") (tag? node "seq"))
          (let [(mut reaches) false]
            (for child
              (iter (get node 1))
              (if (and (not (load reaches))
                       (expression-reaches-rule? child target rules rule-metas (mut visited)))
                  (set! reaches true)
                  0))
            (load reaches))
        :else false))

(defn rule-recursive? [(index i64)
                       (rules Code)
                       (rule-metas (al/ArrayList OhmRuleMeta))] (-> bool)
  (let [(mut visited) (al/al-new [bool] (malloc-allocator))]
    (for [_ 0 (len rules)] (push! (mut visited) false))
    (store! (al/al-elem [bool] (mut visited) index) true)
    (let [answer
            (expression-reaches-rule? (get (get rules index) 3)
                                      index
                                      rules
                                      rule-metas
                                      (mut visited))]
      (al/al-free! (mut visited))
      answer)))

(defn expression-reaches-recursive-rule? [(node Code)
                                          (rules Code)
                                          (rule-metas (al/ArrayList OhmRuleMeta))] (-> bool)
  (let [(mut reaches) false]
    (for [target 0 (len rules)]
      (if (and (not (load reaches)) (rule-recursive? target rules rule-metas))
          (let [(mut visited) (al/al-new [bool] (malloc-allocator))]
            (for [_ 0 (len rules)] (push! (mut visited) false))
            (if (expression-reaches-rule? node
                                          target
                                          rules
                                          rule-metas
                                          (mut visited))
                (set! reaches true)
                0)
            (al/al-free! (mut visited)))
          0))
    (load reaches)))

(defn rule-reaches-recursive-rule? [(index i64)
                                    (rules Code)
                                    (rule-metas (al/ArrayList OhmRuleMeta))] (-> bool)
  (expression-reaches-recursive-rule? (get (get rules index) 3) rules rule-metas))

(defn specialization-name [(counter (ptr i64))] (-> (slice u8))
  (let [(mut name) (str/sb-new (malloc-allocator))]
    (str/sb-push-str! (mut name) "__ohm_parameterized_")
    (str/sb-push-i64! (mut name) (load counter))
    (store! counter (+ (load counter) 1))
    (str/sb-finish! (mut name))))

;; Returns (specialized expression, generated bound rules). Bound rules retain
;; the original parameterized body and actual expressions; emission performs
;; substitution so inline-case syntax remains untouched across `--use`.
(defn specialize-expression [(node Code)
                             (rules Code)
                             (rule-metas (al/ArrayList OhmRuleMeta))
                             (counter (ptr i64))] (-> Code)
  (cond (tag? node "app")
          (let [name (primitive/code-str (get node 1))
                target-index (find-rule-index rule-metas name)]
            (if (and (>= target-index 0)
                     (> (len (get (get rules target-index) 2)) 0))
                (let [target (get rules target-index)
                      supplied (get node 2)
                      generated-name (specialization-name counter)]
                  (if (not (= (len supplied) (len (get target 2))))
                      (wrong-argument-count-at name
                                               (len (get target 2))
                                               (len supplied)
                                               node)
                      0)
                  (for actual
                    (iter supplied)
                    (let [arity (expression-arity actual)]
                      (if (not (= arity 1))
                          (invalid-parameter name actual arity)
                          0)))
                  `((app ~(primitive/code-symbol generated-name) () ~node)
                    ((bound-rule ~(primitive/code-symbol generated-name)
                                 ~target-index
                                 ~supplied))))
                `(~node ())))
        (or (tag? node "star")
            (tag? node "plus")
            (tag? node "opt")
            (tag? node "not")
            (tag? node "look")
            (tag? node "lex"))
          (let [child (specialize-expression (get node 1) rules rule-metas counter)
                generated (get child 1)]
            (if (= (len generated) 0)
                `(~node ())
                `((~(primitive/code-symbol (primitive/code-sym (get node 0))) ~(get child 0)) ~generated)))
        (tag? node "splice")
          (let [child (specialize-expression (get node 1) rules rule-metas counter)
                generated (get child 1)]
            (if (= (len generated) 0)
                `(~node ())
                `((splice ~(get child 0) ~(get node 2)) ~generated)))
        (tag? node "case")
          (let [child (specialize-expression (get node 2) rules rule-metas counter)
                generated (get child 1)]
            (if (= (len generated) 0)
                `(~node ())
                `((case ~(primitive/code-int (get node 1)) ~(get child 0)) ~generated)))
        (or (tag? node "alt") (tag? node "seq"))
          (let [(mut children) (primitive/code-list-new)
                (mut generated) (primitive/code-list-new)
                (mut changed) false]
            (for child
              (iter (get node 1))
              (let [result (specialize-expression child rules rule-metas counter)]
                (push! (mut children) (get result 0))
                (if (> (len (get result 1)) 0)
                    (do
                      (set! changed true)
                      (for generated-rule
                        (iter (get result 1))
                        (push! (mut generated) generated-rule)))
                    0)))
            (let [generated-rules (primitive/code-list-done (load generated))]
              (if (load changed)
                  `((~(primitive/code-symbol (primitive/code-sym (get node 0))) (~@(primitive/code-list-done (load children)))) ~generated-rules)
                  `(~node ~generated-rules))))
        :else `(~node ())))

(defn validate-rule-set-lexical [(rules Code)
                                 (rule-metas (al/ArrayList OhmRuleMeta))] (-> i64)
  (for [index 0 (len rules)]
    (let [rule (get rules index)
          rule-name (primitive/code-str (get rule 1))
          first-byte (primitive/cast i64 (slice-get rule-name 0))]
      (validate-lexical-applications (get rule 3)
                                     (get rule 2)
                                     (and (>= first-byte 97) (<= first-byte 122))
                                     rule-metas)))
  0)

(defn prepare-rules [(rules Code)
                     (rule-metas (al/ArrayList OhmRuleMeta))
                     (output-metas (mut (al/ArrayList OhmRuleMeta)))] (-> Code)
  (let [(mut output) (primitive/code-list-new)
        (mut generated) (primitive/code-list-new)
        counter (primitive/alloc-stack i64)]
    (store! counter 0)
    (for [index 0 (len rules)]
      (let [rule (get rules index)
            meta (get rule-metas index)
            rule-name (primitive/code-str (get rule 1))
            first-byte (primitive/cast i64 (slice-get rule-name 0))]
        (push! (mut output-metas) meta)
        (validate-lexical-applications (get rule 3)
                                       (get rule 2)
                                       (and (>= first-byte 97) (<= first-byte 122))
                                       rule-metas)
        (if (= (len (get rule 2)) 0)
            (let [result (specialize-expression (get rule 3) rules rule-metas counter)]
              (push! (mut output)
                     (if (> (len rule) 5)
                         `(rule ~(get rule 1) () ~(get result 0) 0 ~(get rule 5))
                         `(rule ~(get rule 1) () ~(get result 0))))
              (for generated-rule
                (iter (get result 1))
                (push! (mut generated) generated-rule)))
            (push! (mut output) rule))))
    (for bound-rule
      (iter (primitive/code-list-done (load generated)))
      (let [name (primitive/code-str (get bound-rule 1))
            target-meta (get rule-metas (primitive/code-int (get bound-rule 2)))
            (mut meta) (primitive/zeroed OhmRuleMeta)]
        (set! (.name meta) name)
        (set! (.description meta) (.description target-meta))
        (push! (mut output-metas) (load meta))
        (push! (mut output) bound-rule)))
    (primitive/code-list-done (load output))))

(defn grammar-rule-error [(operation i64)
                          (name (slice u8))
                          (super-name (slice u8))
                          (meta OhmRuleMeta)] (-> i64)
  (let [(mut message) (str/sb-new (malloc-allocator))]
    (str/sb-push-str! (mut message)
                      (if (= operation 1)
                          "Cannot override rule "
                          "Cannot extend rule "))
    (str/sb-push-str! (mut message) name)
    (str/sb-push-str! (mut message) " because it is not declared in ")
    (str/sb-push-str! (mut message) super-name)
    (compiler-source-error (.diagnostic-source-start meta)
                           (.diagnostic-source-end meta)
                           (str/sb-finish! (mut message)))))

(defn duplicate-rule-error [(name (slice u8))
                            (grammar-name (slice u8))
                            (super-name (slice u8))
                            (meta OhmRuleMeta)] (-> i64)
  (let [(mut message) (str/sb-new (malloc-allocator))]
    (str/sb-push-str! (mut message) "Duplicate declaration for rule '")
    (str/sb-push-str! (mut message) name)
    (str/sb-push-str! (mut message) "' in grammar '")
    (str/sb-push-str! (mut message) grammar-name)
    (str/sb-push-str! (mut message) "' (originally declared in '")
    (str/sb-push-str! (mut message) super-name)
    (str/sb-push-str! (mut message) "')")
    (compiler-source-error (.diagnostic-source-start meta)
                           (.diagnostic-source-end meta)
                           (str/sb-finish! (mut message)))))

(defn unicode-property-rule [(name (slice u8))] (-> (slice u8))
  (cond
    (str/str-eq name "__ohm_unicode_Cc") "Cc"
    (str/str-eq name "__ohm_unicode_Cf") "Cf"
    (str/str-eq name "__ohm_unicode_Cn") "Cn"
    (str/str-eq name "__ohm_unicode_Co") "Co"
    (str/str-eq name "__ohm_unicode_Cs") "Cs"
    (str/str-eq name "__ohm_unicode_Ll") "Ll"
    (str/str-eq name "__ohm_unicode_Lm") "Lm"
    (str/str-eq name "__ohm_unicode_Lo") "Lo"
    (str/str-eq name "__ohm_unicode_Lt") "Lt"
    (str/str-eq name "__ohm_unicode_Lu") "Lu"
    (str/str-eq name "__ohm_unicode_Mc") "Mc"
    (str/str-eq name "__ohm_unicode_Me") "Me"
    (str/str-eq name "__ohm_unicode_Mn") "Mn"
    (str/str-eq name "__ohm_unicode_Nd") "Nd"
    (str/str-eq name "__ohm_unicode_Nl") "Nl"
    (str/str-eq name "__ohm_unicode_No") "No"
    (str/str-eq name "__ohm_unicode_Pc") "Pc"
    (str/str-eq name "__ohm_unicode_Pd") "Pd"
    (str/str-eq name "__ohm_unicode_Pe") "Pe"
    (str/str-eq name "__ohm_unicode_Pf") "Pf"
    (str/str-eq name "__ohm_unicode_Pi") "Pi"
    (str/str-eq name "__ohm_unicode_Po") "Po"
    (str/str-eq name "__ohm_unicode_Ps") "Ps"
    (str/str-eq name "__ohm_unicode_Sc") "Sc"
    (str/str-eq name "__ohm_unicode_Sk") "Sk"
    (str/str-eq name "__ohm_unicode_Sm") "Sm"
    (str/str-eq name "__ohm_unicode_So") "So"
    (str/str-eq name "__ohm_unicode_Zl") "Zl"
    (str/str-eq name "__ohm_unicode_Zp") "Zp"
    (str/str-eq name "__ohm_unicode_Zs") "Zs"
    (str/str-eq name "__ohm_unicode_Ltmo") "Ltmo"
    (str/str-eq name "__ohm_unicode_XID_Start") "XID_Start"
    (str/str-eq name "__ohm_unicode_XID_Continue") "XID_Continue"
    (str/str-eq name "__ohm_unicode_White_Space") "White_Space"
    :else ""))

(defn built-in-rule-name? [(name (slice u8))] (-> bool)
  (or (> (slice-len (unicode-property-rule name)) 0)
      (or (str/str-eq name "any")
      (str/str-eq name "end")
      (str/str-eq name "spaces")
      (str/str-eq name "space")
      (str/str-eq name "digit")
      (str/str-eq name "letter")
      (str/str-eq name "lower")
      (str/str-eq name "upper")
      (str/str-eq name "unicodeLtmo")
      (str/str-eq name "indent")
      (str/str-eq name "dedent")
      (str/str-eq name "alnum")
      (str/str-eq name "hexDigit")
      (str/str-eq name "caseInsensitive")
      (str/str-eq name "ListOf")
      (str/str-eq name "NonemptyListOf")
      (str/str-eq name "EmptyListOf")
      (str/str-eq name "listOf")
      (str/str-eq name "nonemptyListOf")
      (str/str-eq name "emptyListOf")
      (str/str-eq name "applySyntactic"))))

(defn built-in-rule-expression [(name (slice u8)) (formals Code)] (-> Code)
  (let [first-formal (if (> (len formals) 0) (get formals 0) (primitive/code-symbol "elem"))
        second-formal (if (> (len formals) 1) (get formals 1) (primitive/code-symbol "sep"))]
    (cond (str/str-eq name "any") `(app "__builtin_any" ())
          (str/str-eq name "end") `(app "__builtin_end" ())
          (str/str-eq name "spaces") `(star (app "__builtin_space_rule" ()))
          (str/str-eq name "space") `(app "__builtin_space" ())
          (str/str-eq name "digit") `(range 48 57 "0" "9")
          (str/str-eq name "letter") `(alt ((app "lower" ()) (app "upper" ()) (app "unicodeLtmo" ())))
          (str/str-eq name "lower") `(app "__builtin_lower_terminal" ())
          (str/str-eq name "upper") `(app "__builtin_upper_terminal" ())
          (str/str-eq name "unicodeLtmo") `(app "__builtin_unicodeLtmo_terminal" ())
          (str/str-eq name "indent") `(app "__builtin_indent" ())
          (str/str-eq name "dedent") `(app "__builtin_dedent" ())
          (str/str-eq name "alnum") `(alt ((app "letter" ()) (app "digit" ())))
          (str/str-eq name "hexDigit") `(alt ((app "digit" ()) (range 97 102 "a" "f") (range 65 70 "A" "F")))
          (str/str-eq name "caseInsensitive") `(app "__builtin_case_insensitive_body" ((app ~first-formal ())))
          (str/str-eq name "applySyntactic") `(app "__builtin_apply_syntactic_body" ((app ~first-formal ())))
          (str/str-eq name "ListOf")
            `(alt ((app "NonemptyListOf" ((app ~first-formal ()) (app ~second-formal ()))) (app "EmptyListOf"
                                                                                                ((app ~first-formal ()) (app ~second-formal
                                                                                                                             ())))))
          (str/str-eq name "listOf")
            `(alt ((app "nonemptyListOf" ((app ~first-formal ()) (app ~second-formal ()))) (app "emptyListOf"
                                                                                                ((app ~first-formal ()) (app ~second-formal
                                                                                                                             ())))))
          (or (str/str-eq name "NonemptyListOf")
              (str/str-eq name "nonemptyListOf"))
            `(seq ((app ~first-formal ()) (star (seq ((app ~second-formal ()) (app ~first-formal ()))))))
          (or (str/str-eq name "EmptyListOf") (str/str-eq name "emptyListOf")) `(seq ())
          :else `())))

(defn built-in-rule-parameter-count [(name (slice u8))] (-> i64)
  (cond (or (str/str-eq name "caseInsensitive")
            (str/str-eq name "applySyntactic"))
          1
        (or (str/str-eq name "ListOf")
            (str/str-eq name "NonemptyListOf")
            (str/str-eq name "EmptyListOf")
            (str/str-eq name "listOf")
            (str/str-eq name "nonemptyListOf")
            (str/str-eq name "emptyListOf"))
          2
        :else 0))

(defn replace-super-splice [(node Code) (super-expression Code)] (-> Code)
  (cond (tag? node "super-splice") super-expression
        (or (tag? node "star")
            (tag? node "plus")
            (tag? node "opt")
            (tag? node "not")
            (tag? node "look")
            (tag? node "lex"))
          `(~(primitive/code-symbol (primitive/code-sym (get node 0))) ~(replace-super-splice (get node 1)
                                                                                              super-expression))
        (tag? node "case")
          `(case ~(primitive/code-int (get node 1)) ~(replace-super-splice (get node 2) super-expression))
        (or (tag? node "alt") (tag? node "seq"))
          (let [(mut children) (primitive/code-list-new)]
            (for child
              (iter (get node 1))
              (push! (mut children) (replace-super-splice child super-expression)))
            `(~(primitive/code-symbol (primitive/code-sym (get node 0))) (~@(primitive/code-list-done (load children)))))
        :else node))

(defn contains-super-splice? [(node Code)] (-> bool)
  (cond (tag? node "super-splice") true
        (or (tag? node "star")
            (tag? node "plus")
            (tag? node "opt")
            (tag? node "not")
            (tag? node "look")
            (tag? node "lex"))
          (contains-super-splice? (get node 1))
        (tag? node "case") (contains-super-splice? (get node 2))
        (or (tag? node "alt") (tag? node "seq"))
          (let [(mut found) false]
            (for child
              (iter (get node 1))
              (if (and (not (load found)) (contains-super-splice? child))
                  (set! found true)
                  0))
            (load found))
        :else false))

(defn inherited-rule-body [(operation i64)
                           (body Code)
                           (super-expression Code)] (-> Code)
  (if (= operation 2)
      `(splice (alt (~body ~super-expression)) (alt (~body (super-splice))))
      (if (contains-super-splice? body)
          `(splice ~(replace-super-splice body super-expression) ~body)
          body)))

(defn resolve-built-in-operations [(rules Code)
                                   (metas (al/ArrayList OhmRuleMeta))
                                   (output-metas (mut (al/ArrayList OhmRuleMeta)))] (-> Code)
  (let [(mut output) (primitive/code-list-new)]
    (for [index 0 (len rules)]
      (let [rule (get rules index)
            meta (get metas index)]
        (if (= (.operation meta) 0)
            (do
              (push! (mut output) rule)
              (push! (mut output-metas) meta))
            (if (built-in-rule-name? (.name meta))
                (let [(mut resolved-meta) (primitive/zeroed OhmRuleMeta)
                      super-expression (built-in-rule-expression (.name meta) (get rule 2))]
                  (if (and (str/str-eq (.name meta) "caseInsensitive")
                           (contains-super-splice? (get rule 3)))
                      (primitive/error
                        "this method introduceParams is abstract! (it has no implementation in class CaseInsensitiveTerminal)")
                      0)
                  (if (not (= (len (get rule 2))
                              (built-in-rule-parameter-count (.name meta))))
                      (wrong-parameter-count-at (.name meta)
                                                (built-in-rule-parameter-count (.name meta))
                                                (len (get rule 2))
                                                meta)
                      0)
                  (if (and (= (.operation meta) 2)
                           (not (= (expression-arity (get rule 3))
                                   (expression-arity super-expression))))
                      (inconsistent-extension-arity (.name meta)
                                                    (expression-arity super-expression)
                                                    (expression-arity (get rule 3))
                                                    (get rule 3))
                      0)
                  (set! (.name resolved-meta) (.name meta))
                  (set! (.operation resolved-meta) 0)
                  (set! (.description resolved-meta) (.description meta))
                  (push! (mut output)
                         `(rule ~(get rule 1)
                                ~(get rule 2)
                                ~(inherited-rule-body (.operation meta)
                                                      (get rule 3)
                                                      super-expression)
                                0
                                ~super-expression))
                  (push! (mut output-metas) (load resolved-meta)))
                (grammar-rule-error (.operation meta)
                                    (.name meta)
                                    "BuiltInRules"
                                    meta)))))
    (primitive/code-list-done (load output))))

(defn merge-rules [(super-rules Code)
                   (super-metas (al/ArrayList OhmRuleMeta))
                   (super-name (slice u8))
                   (child-rules Code)
                   (child-metas (al/ArrayList OhmRuleMeta))
                   (child-name (slice u8))
                   (output-metas (mut (al/ArrayList OhmRuleMeta)))] (-> Code)
  (let [(mut output) (primitive/code-list-new)
        (mut consumed) (al/al-new [bool] (malloc-allocator))]
    (for [_ 0 (len child-rules)] (push! (mut consumed) false))
    (for [super-index 0 (len super-rules)]
      (let [super-rule (get super-rules super-index)
            super-meta (get super-metas super-index)
            child-index (find-rule-index child-metas (.name super-meta))]
        (if (< child-index 0)
            (do
              (push! (mut output) super-rule)
              (push! (mut output-metas) super-meta))
            (let [child-rule (get child-rules child-index)
                  child-meta (get child-metas child-index)]
              (if (= (.operation child-meta) 0)
                  (duplicate-rule-error (.name child-meta)
                                        child-name
                                        super-name
                                        child-meta)
                  0)
              (if (not (= (len (get child-rule 2)) (len (get super-rule 2))))
                  (wrong-parameter-count-at (.name child-meta)
                                            (len (get super-rule 2))
                                            (len (get child-rule 2))
                                            child-meta)
                  0)
              (if (and (= (.operation child-meta) 2)
                       (not (= (expression-arity (get child-rule 3))
                               (expression-arity (get super-rule 3)))))
                  (inconsistent-extension-arity (.name child-meta)
                                                (expression-arity (get super-rule 3))
                                                (expression-arity (get child-rule 3))
                                                (get child-rule 3))
                  0)
              (store! (al/al-elem [bool] (mut consumed) child-index) true)
              (push! (mut output)
                     (if (= (.operation child-meta) 1)
                         `(rule ~(get child-rule 1)
                                ~(get child-rule 2)
                                ~(get child-rule 3)
                                0
                                ~(get super-rule 3))
                         `(rule ~(get child-rule 1)
                                ~(get child-rule 2)
                                ~(inherited-rule-body 2
                                                      (get child-rule 3)
                                                      (get super-rule 3))
                                0)))
              (let [(mut merged-meta) (primitive/zeroed OhmRuleMeta)]
                (set! (.name merged-meta) (.name child-meta))
                (set! (.operation merged-meta) 0)
                (set! (.description merged-meta)
                      (if (> (slice-len (.description child-meta)) 0)
                          (.description child-meta)
                          (.description super-meta)))
                (push! (mut output-metas) (load merged-meta)))))))
    (for [child-index 0 (len child-rules)]
      (if (get (load consumed) child-index)
          0
          (let [child-rule (get child-rules child-index)
                child-meta (get child-metas child-index)]
            (if (= (.operation child-meta) 0)
                (do
                  (push! (mut output) child-rule)
                  (push! (mut output-metas) child-meta))
                (if (built-in-rule-name? (.name child-meta))
                    (let [(mut resolved-meta) (primitive/zeroed OhmRuleMeta)
                          super-expression (built-in-rule-expression (.name child-meta) (get child-rule 2))]
                      (if (not (= (len (get child-rule 2))
                                  (built-in-rule-parameter-count (.name child-meta))))
                          (wrong-parameter-count-at (.name child-meta)
                                                    (built-in-rule-parameter-count (.name child-meta))
                                                    (len (get child-rule 2))
                                                    child-meta)
                          0)
                      (if (and (= (.operation child-meta) 2)
                               (not (= (expression-arity (get child-rule 3))
                                       (expression-arity super-expression))))
                          (inconsistent-extension-arity (.name child-meta)
                                                        (expression-arity super-expression)
                                                        (expression-arity (get child-rule 3))
                                                        (get child-rule 3))
                          0)
                      (set! (.name resolved-meta) (.name child-meta))
                      (set! (.operation resolved-meta) 0)
                      (set! (.description resolved-meta) (.description child-meta))
                      (push! (mut output)
                             `(rule ~(get child-rule 1)
                                    ~(get child-rule 2)
                                    ~(inherited-rule-body (.operation child-meta)
                                                          (get child-rule 3)
                                                          super-expression)
                                    0
                                    ~super-expression))
                      (push! (mut output-metas) (load resolved-meta)))
                    (grammar-rule-error (.operation child-meta)
                                        (.name child-meta)
                                        super-name
                                        child-meta))))))
    (al/al-free! (mut consumed))
    (primitive/code-list-done (load output))))

(defn parse-descendant-grammars [(context Code)
                                 (r (ptr OhmReader))
                                 (current-name (slice u8))
                                 (current-rules Code)
                                 (current-metas (al/ArrayList OhmRuleMeta))
                                 (current-recipe (slice u8))
                                 (current-default (slice u8))
                                 (final-name (mut (slice u8)))
                                 (final-recipe (mut (slice u8)))
                                 (final-default (mut (slice u8)))
                                 (grammar-names (mut (al/ArrayList (slice u8))))
                                 (output-metas (mut (al/ArrayList OhmRuleMeta)))] (-> Code)
  (ws! r)
  (if (< (ch r (pos r)) 0)
      (do
        (for meta
          (iter current-metas)
          (push! (mut output-metas) meta))
        (set! final-name current-name)
        (set! final-recipe current-recipe)
        (set! final-default current-default)
        current-rules)
      (let [child-source-start (pos r)
            _single-grammar-check
              (if (load (single-grammar-mode-cell))
                  (reader-source-error
                    r
                    child-source-start
                    child-source-start
                    "Found more than one grammar definition -- use ohm.grammars() instead.")
                  0)
            child-name (read-ident context r)]
        (push! (mut grammar-names) child-name)
        (if (not (accept-op! r 60 58))
            (fail context r "expected '<:' between successive grammars")
            0)
        (let [super-name (read-ident context r)]
          (if (not (str/str-eq super-name current-name))
              (let [(mut message) (str/sb-new (malloc-allocator))]
                (str/sb-push-str! (mut message) "Grammar ")
                (str/sb-push-str! (mut message) super-name)
                (str/sb-push-str! (mut message)
                                  " is not declared in namespace '[object Object]'")
                (reader-source-error r
                                     (- (pos r) (slice-len super-name))
                                     (pos r)
                                     (str/sb-finish! (mut message))))
              0)
          (if (not (accept-char! r 123)) (fail context r "expected '{'") 0)
          (store! (field r rule-metas) (al/al-new [OhmRuleMeta] (malloc-allocator)))
          (store! (field r record-template-priority) true)
          (set-current-grammar-name! child-name)
          (let [case-start (len (load (field r cases)))
                span-start (len (load (field r expression-spans)))
            child-rules (parse-rules context (primitive/cast i64 r))
            child-metas (load (field r rule-metas))
                _child-lexical (validate-rule-set-lexical child-rules child-metas)
                (mut merged-metas) (al/al-new [OhmRuleMeta] (malloc-allocator))]
            (if (not (accept-char! r 125)) (fail context r "Expected \"}\"") 0)
            (let [child-source-end (pos r)
                  recipe-enabled (> (slice-len current-recipe) 0)
                  _ (normalize-recipe-source-intervals!
                      (load (field r source))
                      (mut (field r rule-metas))
                      (mut (field r cases))
                      (mut (field r expression-spans))
                      (if recipe-enabled child-source-start 0)
                      (if recipe-enabled case-start (len (load (field r cases))))
                      (if recipe-enabled span-start (len (load (field r expression-spans)))))
                  requested-child-default
                    (builder-default-start-in-range
                      (load (field r source)) child-source-start child-source-end)
                  child-default
                    (if (> (slice-len requested-child-default) 0)
                        requested-child-default
                        (if (> (slice-len current-default) 0)
                            current-default
                            (source-default-start-rule child-rules child-metas)))
                  child-recipe
                    (if recipe-enabled
                        (structural-source-recipe
                          (subslice (load (field r source))
                                    child-source-start
                                    child-source-end)
                          child-name
                          child-default
                          child-rules
                          child-metas
                          (load (field r cases))
                          (load (field r expression-spans))
                          current-recipe
                          case-start
                          (len (load (field r cases))))
                        "")
                  merged-rules
                    (merge-rules current-rules
                                 current-metas
                                 current-name
                                 child-rules
                                 child-metas
                                 child-name
                                 (mut merged-metas))]
              (parse-descendant-grammars context
                                         r
                                         child-name
                                         merged-rules
                                         (load merged-metas)
                                         child-recipe
                                         child-default
                                         (mut final-name)
                                         (mut final-recipe)
                                         (mut final-default)
                                         (mut grammar-names)
                                         (mut output-metas))))))))

(defn slice-at? [(source (slice u8)) (at i64) (wanted (slice u8))] (-> bool)
  (let [n (slice-len wanted)
        (mut i) 0
        (mut same) (<= (+ at n) (slice-len source))]
    (loop (if (or (not (load same)) (>= (load i) n))
              (break)
              (if (= (slice-get source (+ at (load i))) (slice-get wanted (load i)))
                  (store! i (+ (load i) 1))
                  (store! same false))))
    (load same)))

(defn source-contains? [(source (slice u8)) (wanted (slice u8))] (-> bool)
  (let [(mut at) 0 (mut found) false]
    (loop (if (or (load found) (> (+ (load at) (slice-len wanted)) (slice-len source)))
              (break)
              (if (slice-at? source (load at) wanted)
                  (set! found true)
                  (set! at (+ (load at) 1)))))
    (load found)))

(const BUILT_IN_RULES_SOURCE
  "BuiltInRules {\n\n  alnum  (an alpha-numeric character)\n    = letter\n    | digit\n\n  letter  (a letter)\n    = lower\n    | upper\n    | unicodeLtmo\n\n  digit  (a digit)\n    = \"0\"..\"9\"\n\n  hexDigit  (a hexadecimal digit)\n    = digit\n    | \"a\"..\"f\"\n    | \"A\"..\"F\"\n\n  ListOf<elem, sep>\n    = NonemptyListOf<elem, sep>\n    | EmptyListOf<elem, sep>\n\n  NonemptyListOf<elem, sep>\n    = elem (sep elem)*\n\n  EmptyListOf<elem, sep>\n    = /* nothing */\n\n  listOf<elem, sep>\n    = nonemptyListOf<elem, sep>\n    | emptyListOf<elem, sep>\n\n  nonemptyListOf<elem, sep>\n    = elem (sep elem)*\n\n  emptyListOf<elem, sep>\n    = /* nothing */\n\n  // Allows a syntactic rule application within a lexical context.\n  applySyntactic<app> = app\n}")

(defn reader-definition-form? [(form Code)] (-> bool)
  (and (primitive/code-list? form)
       (and (> (len form) 1)
            (and (primitive/code-sym? (get form 0))
                 (let [head (primitive/code-sym (get form 0))]
                   (or (str/str-eq head "defn")
                       (or (str/str-eq head "defstruct")
                           (or (str/str-eq head "deftrait")
                               (str/str-eq head "const")))))))))

(defn reader-rewrite-code [(node Code) (old-names Code) (new-names Code)]
                          (-> Code)
  (if (primitive/code-sym? node)
      (let [(mut answer) node]
        (for [index 0 (len old-names)]
          (if (primitive/free-identifier=? node (get old-names index))
              (set! answer (get new-names index))
              0))
        (load answer))
      (if (primitive/code-vector? node)
          node
      (if (primitive/code-list? node)
          (let [rewritten (primitive/code-list-new)]
            (for child (iter node)
              (primitive/code-list-push!
                rewritten
                (reader-rewrite-code child old-names new-names)))
            (primitive/code-list-done rewritten))
          node))))

(defn reader-prefixed-name [(context Code) (name (slice u8))] (-> Code)
  (let [(mut builder) (str/sb-new (malloc-allocator))]
    (str/sb-push-str! (mut builder) "__ohm_standalone_builtin_")
    (str/sb-push-str! (mut builder) name)
    (primitive/datum->syntax
      context
      (primitive/code-symbol (str/sb-finish! (mut builder))))))

(defn compile-standalone-built-in-forms [(context Code)] (-> Code)
  (let [built-in-context (primitive/fresh-identifier "standalone-built-in-context")
        compiled (read-ohm-impl built-in-context BUILT_IN_RULES_SOURCE true true)
        output (primitive/code-list-new)]
    ;; Each reader invocation carries a distinct hygienic definition context,
    ;; so these definitions can retain their readable names without colliding
    ;; with the descendant specialization in the same emitted module.
    (for form (iter compiled)
      (if (reader-definition-form? form)
          (do (primitive/code-list-push! output form) 0)
          0))
    (primitive/code-list-done output)))

(defn reader-find-definition-name [(forms Code)
                                   (wanted (slice u8))
                                   (fallback Code)] (-> Code)
  (let [(mut answer) fallback]
    (for form (iter forms)
      (if (and (reader-definition-form? form)
               (str/str-eq (primitive/code-sym (get form 1)) wanted))
          (set! answer (get form 1))
          0))
    (load answer)))

(defstruct OhmTestCase
  [(expected bool)
   (input (slice u8))
   ;; Empty means that recognition and generic tree invariants are sufficient.
   (required-rule (slice u8))
   ;; Empty selects the grammar's default start rule.
   (start-rule (slice u8))
   (check-iteration bool)
   (iteration-columns i64)
   (iteration-rows i64)
   (iteration-optional bool)
   (check-failure bool)
   (failure-position i64)
   (failure-text (slice u8))])

(defstruct DecimalToken [(value i64) (end i64)])

(defn read-action-template-expectation [(source (slice u8))] (-> (slice u8))
  (let [(mut at) 0
        (mut found) -1]
    (loop (if (>= (load at) (slice-len source))
              (break)
              (do
                (if (slice-at? source (load at) "// @action-template ")
                    (do
                      (set! found (+ (load at) 20))
                      (set! at (slice-len source)))
                    (set! at (+ (load at) 1))))))
    (if (< (load found) 0)
        ""
        (let [(mut end) (load found)
              (mut value) (str/sb-new (malloc-allocator))]
          (loop (if (or (>= (load end) (slice-len source))
                        (= (primitive/cast i64 (slice-get source (load end))) 10)
                        (= (primitive/cast i64 (slice-get source (load end))) 13))
                    (break)
                    (if (and (= (primitive/cast i64 (slice-get source (load end))) 92)
                             (< (+ (load end) 1) (slice-len source))
                             (= (primitive/cast i64
                                                (slice-get source (+ (load end) 1)))
                                110))
                        (do
                          (str/sb-push-byte! (mut value) (primitive/cast u8 10))
                          (set! end (+ (load end) 2)))
                        (do
                          (str/sb-push-byte! (mut value) (slice-get source (load end)))
                          (set! end (+ (load end) 1))))))
          (str/sb-finish! (mut value))))))

(defn read-decimal-token [(source (slice u8)) (start i64) (limit i64)] (-> DecimalToken)
  (let [(mut token) (primitive/zeroed DecimalToken)
        (mut at) start
        (mut value) 0]
    (loop (if (or (>= (load at) limit)
                  (< (primitive/cast i64 (slice-get source (load at))) 48)
                  (> (primitive/cast i64 (slice-get source (load at))) 57))
              (break)
              (do
                (set! value
                      (+ (* (load value) 10)
                         (- (primitive/cast i64 (slice-get source (load at))) 48)))
                (set! at (+ (load at) 1)))))
    (set! (.value token) (load value))
    (set! (.end token) (load at))
    (load token)))

(defn fixture-short-message [(position i64) (expected (slice u8))] (-> (slice u8))
  (let [(mut message) (str/sb-new (malloc-allocator))]
    (str/sb-push-str! (mut message) "Line 1, col ")
    (str/sb-push-i64! (mut message) (+ position 1))
    (str/sb-push-str! (mut message) ": expected ")
    (str/sb-push-str! (mut message) expected)
    (str/sb-finish! (mut message))))

(defn append-fixture-input! [(builder (mut str/StrBuf))
                             (source (slice u8))
                             (start i64)
                             (end i64)
                             (escaped bool)] (-> i64)
  (if (not escaped)
      (str/sb-push-str! (mut builder) (subslice source start end))
      (let [(mut at) start]
        (loop
          (if (>= (load at) end) (break) 0)
          (if (and (= (primitive/cast i64 (slice-get source (load at))) 92)
                   (< (+ (load at) 1) end))
              (let [next (primitive/cast i64 (slice-get source (+ (load at) 1)))]
                (cond (= next 110) (str/sb-push-byte! (mut builder) 10)
                      (= next 114) (str/sb-push-byte! (mut builder) 13)
                      (= next 116) (str/sb-push-byte! (mut builder) 9)
                      (= next 92) (str/sb-push-byte! (mut builder) 92)
                      :else
                        (do
                          (str/sb-push-byte! (mut builder) 92)
                          (str/sb-push-byte! (mut builder) (primitive/cast u8 next))))
                (set! at (+ (load at) 2)))
              (do
                (str/sb-push-byte! (mut builder) (slice-get source (load at)))
                (set! at (+ (load at) 1)))))))
  0)

;; Conformance fixtures remain valid Ohm grammars because cases are comments.
(defn read-test-cases [(source (slice u8))] (-> (al/ArrayList OhmTestCase))
  (let [(mut cases) (al/al-new [OhmTestCase] (malloc-allocator))
        (mut at) 0]
    (loop (if (>= (load at) (slice-len source))
              (break)
              (let [(mut expected) false
                    (mut found) false
                    (mut check-iteration) false
                    (mut check-failure) false
                    (mut check-start-rule) false
                    (mut escaped-input) false
                    (mut start) 0]
                (cond (slice-at? source (load at) "// @accept-escaped-from ")
                        (do
                          (set! expected true)
                          (set! found true)
                          (set! check-start-rule true)
                          (set! escaped-input true)
                          (set! start (+ (load at) 24)))
                      (slice-at? source (load at) "// @accept-escaped ")
                        (do
                          (set! expected true)
                          (set! found true)
                          (set! escaped-input true)
                          (set! start (+ (load at) 19)))
                      (slice-at? source (load at) "// @accept-iter ")
                        (do
                          (set! expected true)
                          (set! found true)
                          (set! check-iteration true)
                          (set! start (+ (load at) 16)))
                      (slice-at? source (load at) "// @reject-error ")
                        (do
                          (set! found true)
                          (set! check-failure true)
                          (set! start (+ (load at) 17)))
                      (slice-at? source (load at) "// @accept-node ")
                        (do
                          (set! expected true)
                          (set! found true)
                          (set! start (+ (load at) 16)))
                      (slice-at? source (load at) "// @accept-from ")
                        (do
                          (set! expected true)
                          (set! found true)
                          (set! check-start-rule true)
                          (set! start (+ (load at) 16)))
                      (slice-at? source (load at) "// @reject-from ")
                        (do
                          (set! found true)
                          (set! check-start-rule true)
                          (set! start (+ (load at) 16)))
                      (slice-at? source (load at) "// @accept ")
                        (do
                          (set! expected true)
                          (set! found true)
                          (set! start (+ (load at) 11)))
                      (slice-at? source (load at) "// @reject ")
                        (do
                          (set! found true)
                          (set! start (+ (load at) 11)))
                      :else 0)
                (if (load found)
                    (let [(mut end) (load start)]
                      (loop (if (or (>= (load end) (slice-len source))
                                    (= (primitive/cast i64 (slice-get source (load end))) 10)
                                    (= (primitive/cast i64 (slice-get source (load end))) 13))
                                (break)
                                (set! end (+ (load end) 1))))
                      (let [(mut split) (load start)
                            (mut input-start) (load start)
                            (mut iteration-columns) 0
                            (mut iteration-rows) 0
                            (mut iteration-optional) false
                            (mut failure-position) 0
                            (mut failure-text-start) (load start)
                            (mut failure-text-end) (load start)]
                        (if (load check-iteration)
                            (let [columns-token (read-decimal-token source (load input-start) (load end))]
                              (set! iteration-columns (.value columns-token))
                              (set! input-start (+ (.end columns-token) 1))
                              (let [rows-token (read-decimal-token source (load input-start) (load end))]
                                (set! iteration-rows (.value rows-token))
                                (set! input-start (+ (.end rows-token) 1))
                                (cond (slice-at? source (load input-start) "true ")
                                        (do
                                          (set! iteration-optional true)
                                          (set! input-start (+ (load input-start) 5)))
                                      (and (= (+ (load input-start) 4) (load end))
                                           (slice-at? source (load input-start) "true"))
                                        (do
                                          (set! iteration-optional true)
                                          (set! input-start (load end)))
                                      (slice-at? source (load input-start) "false ")
                                        (set! input-start (+ (load input-start) 6))
                                      (and (= (+ (load input-start) 5) (load end))
                                           (slice-at? source (load input-start) "false"))
                                        (set! input-start (load end))
                                      :else (primitive/error "Ohm fixture: expected true or false in @accept-iter"))))
                            0)
                        (if (load check-failure)
                            (let [position-token (read-decimal-token source (load input-start) (load end))]
                              (set! failure-position (.value position-token))
                              (set! failure-text-start (+ (.end position-token) 1))
                              (set! failure-text-end (load failure-text-start))
                              (loop (if (or (>= (load failure-text-end) (load end))
                                            (slice-at? source (load failure-text-end) " |"))
                                        (break)
                                        (set! failure-text-end (+ (load failure-text-end) 1))))
                              (if (not (slice-at? source (load failure-text-end) " |"))
                                  (primitive/error "Ohm fixture: @reject-error requires ' |' before input")
                                  0)
                              (set! input-start (+ (load failure-text-end) 2)))
                            0)
                        (if (or (slice-at? source (load at) "// @accept-node ")
                                (load check-start-rule))
                            (loop (if (or (>= (load split) (load end))
                                          (= (primitive/cast i64
                                                             (slice-get source (load split)))
                                             32))
                                      (break)
                                      (set! split (+ (load split) 1))))
                            (set! split (load start)))
                        (let [(mut copied) (str/sb-new (malloc-allocator))
                              (mut copied-rule) (str/sb-new (malloc-allocator))
                              (mut copied-start-rule) (str/sb-new (malloc-allocator))]
                          (append-fixture-input!
                            (mut copied)
                            source
                            (if (load check-iteration)
                                (load input-start)
                                (if (load check-failure)
                                    (load input-start)
                                    (if (> (load split) (load start))
                                        (+ (load split) 1)
                                        (load start))))
                            (load end)
                            (load escaped-input))
                          (if (> (load split) (load start))
                              (if (load check-start-rule)
                                  (str/sb-push-str! (mut copied-start-rule)
                                                    (subslice source
                                                              (load start)
                                                              (load split)))
                                  (str/sb-push-str! (mut copied-rule)
                                                    (subslice source
                                                              (load start)
                                                              (load split))))
                              0)
                          (let [(mut case) (primitive/zeroed OhmTestCase)]
                            (set! (.expected case) (load expected))
                            (set! (.input case) (str/sb-finish! (mut copied)))
                            (set! (.required-rule case)
                                  (str/sb-finish! (mut copied-rule)))
                            (set! (.start-rule case)
                                  (str/sb-finish! (mut copied-start-rule)))
                            (set! (.check-iteration case) (load check-iteration))
                            (set! (.iteration-columns case) (load iteration-columns))
                            (set! (.iteration-rows case) (load iteration-rows))
                            (set! (.iteration-optional case) (load iteration-optional))
                            (set! (.check-failure case) (load check-failure))
                            (set! (.failure-position case) (load failure-position))
                            (if (load check-failure)
                                (let [(mut copied-failure) (str/sb-new (malloc-allocator))]
                                  (str/sb-push-str! (mut copied-failure)
                                                    (subslice source
                                                              (load failure-text-start)
                                                              (load failure-text-end)))
                                  (set! (.failure-text case)
                                        (str/sb-finish! (mut copied-failure))))
                                0)
                            (push! (mut cases) (load case)))
                          0))
                      (set! at (load end)))
                    (set! at (+ (load at) 1))))))
    (load cases)))

(defn emit-seq [(items Code)
                (i i64)
                (state Code)
                (source Code)
                (at Code)
                (lexical bool)
                (rules Code)
                (rule-metas (al/ArrayList OhmRuleMeta))
                (formals Code)
                (actuals Code)
                (self-base (slice u8))
                (self-callee Code)
                (super-expression Code)
                (cases (al/ArrayList OhmCase))
                (expression-spans (al/ArrayList OhmExpressionSpan))
                (span-base i64)
                (context Code)] (-> Code)
  (if (>= i (len items))
      at
      (let [next (primitive/fresh-identifier "next")
            step
              (emit-expr (get items i)
                         state
                         source
                         at
                         lexical
                         rules
                         rule-metas
                         formals
                         actuals
                         self-base
                         self-callee
                         super-expression
                         cases
                         expression-spans
                         (expression-child-span-base items i span-base)
                         context)]
        `(let [~next ~step]
           (if (< ~next 0)
               -1
               ~(emit-seq items
                          (+ i 1)
                          state
                          source
                          next
                          lexical
                          rules
                          rule-metas
                          formals
                          actuals
                          self-base
                          self-callee
                          super-expression
                          cases
                          expression-spans
                          span-base
                          context))))))

(defn append-expression-display! [(builder (mut str/StrBuf))
                                  (node Code)
                                  (formals Code)
                                  (actuals Code)] (-> i64)
  (cond (tag? node "terminal")
          (do
            (str/sb-push-str! (mut builder) "\"")
            (str/sb-push-str! (mut builder) (primitive/code-str (get node 1)))
            (str/sb-push-str! (mut builder) "\""))
        (tag? node "range") (str/sb-push-str! (mut builder) "a character in the expected range")
        (tag? node "app")
          (if (and (> (len node) 3) (primitive/code-list? (get node 3)))
              (append-expression-display! (mut builder) (get node 3) formals actuals)
              (let [name (primitive/code-str (get node 1))
                    formal-index (name-index formals name)]
                (if (>= formal-index 0)
                    (if (> (len actuals) formal-index)
                        (append-expression-display! (mut builder)
                                                    (get actuals formal-index)
                                                    `()
                                                    `())
                        (do
                          (str/sb-push-str! (mut builder) "$" )
                          (str/sb-push-i64! (mut builder) formal-index)))
                    (str/sb-push-str! (mut builder) name))))
        (tag? node "look") (append-expression-display! (mut builder) (get node 1) formals actuals)
        (tag? node "not")
          (do
            (str/sb-push-str! (mut builder) "not ")
            (append-expression-display! (mut builder) (get node 1) formals actuals))
        (or (tag? node "star") (tag? node "plus") (tag? node "opt"))
          (do
            (str/sb-push-str! (mut builder) "(")
            (append-expression-display! (mut builder) (get node 1) formals actuals)
            (str/sb-push-str! (mut builder)
                              (cond (tag? node "star") "*"
                                    (tag? node "plus") "+"
                                    :else "?"))
            (str/sb-push-str! (mut builder) ")"))
        (or (tag? node "alt") (tag? node "seq"))
          (let [children (get node 1)]
            (if (= (len children) 1)
                (append-expression-display! (mut builder)
                                            (get children 0)
                                            formals
                                            actuals)
                (do
                  (str/sb-push-str! (mut builder) "(")
                  (for [index 0 (len children)]
                    (if (> index 0)
                        (str/sb-push-str! (mut builder)
                                          (if (tag? node "alt") " or " " "))
                        0)
                    (append-expression-display! (mut builder)
                                                (get children index)
                                                formals
                                                actuals))
                  (str/sb-push-str! (mut builder) ")"))))
        (tag? node "case") (append-expression-display! (mut builder) (get node 2) formals actuals)
        (tag? node "splice")
          (append-expression-display! (mut builder) (get node 2) formals actuals)
        (tag? node "super-splice") (str/sb-push-str! (mut builder) "...")
        (tag? node "lex") (append-expression-display! (mut builder) (get node 1) formals actuals)
        :else (str/sb-push-str! (mut builder) "expression"))
  0)

(defn negative-expectation [(node Code) (formals Code) (actuals Code)] (-> (slice u8))
  (let [(mut builder) (str/sb-new (malloc-allocator))]
    (str/sb-push-str! (mut builder) "not ")
    (append-expression-display! (mut builder) node formals actuals)
    (str/sb-finish! (mut builder))))

(defn expression-display [(node Code) (formals Code) (actuals Code)] (-> (slice u8))
  (let [(mut builder) (str/sb-new (malloc-allocator))]
    (append-expression-display! (mut builder) node formals actuals)
    (str/sb-finish! (mut builder))))

;; This mirrors pexprs-toString.js. It is deliberately separate from failure
;; expectation display, whose wording uses descriptions such as `not ...`.
(defn append-expression-string! [(builder (mut str/StrBuf))
                                 (node Code)
                                 (formals Code)
                                 (actuals Code)] (-> i64)
  (cond (tag? node "runtime-arg")
          (do
            (str/sb-push-str! (mut builder) "$")
            (str/sb-push-i64! (mut builder) (primitive/code-int (get node 1))))
        (tag? node "terminal")
          (do
            (str/sb-push-str! (mut builder) "\"")
            (str/sb-push-str! (mut builder) (primitive/code-str (get node 1)))
            (str/sb-push-str! (mut builder) "\""))
        (tag? node "range")
          (do
            (str/sb-push-str! (mut builder) "\"")
            (str/sb-push-str! (mut builder) (primitive/code-str (get node 3)))
            (str/sb-push-str! (mut builder) "\"..\"")
            (str/sb-push-str! (mut builder) (primitive/code-str (get node 4)))
            (str/sb-push-str! (mut builder) "\""))
        (tag? node "app")
          (if (and (> (len node) 3) (primitive/code-list? (get node 3)))
              (append-expression-string! (mut builder) (get node 3) formals actuals)
              (let [name (primitive/code-str (get node 1))
                    formal-index (name-index formals name)]
                (if (>= formal-index 0)
                    (if (> (len actuals) formal-index)
                        (append-expression-string! (mut builder)
                                                   (get actuals formal-index)
                                                   `()
                                                   `())
                        (do
                          (str/sb-push-str! (mut builder) "$")
                          (str/sb-push-i64! (mut builder) formal-index)))
                    (do
                      (str/sb-push-str! (mut builder) name)
                      (let [args (get node 2)]
                        (if (> (len args) 0)
                            (do
                              (str/sb-push-str! (mut builder) "<")
                              (for [index 0 (len args)]
                                (do
                                  (if (> index 0) (str/sb-push-str! (mut builder) ",") 0)
                                  (append-expression-string! (mut builder)
                                                             (get args index)
                                                             formals
                                                             actuals)))
                              (str/sb-push-str! (mut builder) ">"))
                            0))))))
        (or (tag? node "alt") (tag? node "seq"))
          (let [children (get node 1)]
            (if (= (len children) 1)
                (append-expression-string! (mut builder) (get children 0) formals actuals)
                (do
                  (str/sb-push-str! (mut builder) "(")
                  (for [index 0 (len children)]
                    (do
                      (if (> index 0)
                          (str/sb-push-str! (mut builder)
                                            (if (tag? node "alt") " | " " "))
                          0)
                      (append-expression-string! (mut builder)
                                                 (get children index)
                                                 formals
                                                 actuals)))
                  (str/sb-push-str! (mut builder) ")"))))
        (or (tag? node "star") (tag? node "plus") (tag? node "opt"))
          (do
            (append-expression-string! (mut builder) (get node 1) formals actuals)
            (str/sb-push-str! (mut builder)
                              (cond (tag? node "star") "*"
                                    (tag? node "plus") "+"
                                    :else "?")))
        (tag? node "not")
          (do
            (str/sb-push-str! (mut builder) "~")
            (append-expression-string! (mut builder) (get node 1) formals actuals))
        (tag? node "look")
          (do
            (str/sb-push-str! (mut builder) "&")
            (append-expression-string! (mut builder) (get node 1) formals actuals))
        (tag? node "lex")
          (do
            (str/sb-push-str! (mut builder) "#(")
            (append-expression-string! (mut builder) (get node 1) formals actuals)
            (str/sb-push-str! (mut builder) ")"))
        (tag? node "case") (append-expression-string! (mut builder) (get node 2) formals actuals)
        (tag? node "splice")
          (append-expression-string! (mut builder) (get node 2) formals actuals)
        (tag? node "super-splice") (str/sb-push-str! (mut builder) "...")
        :else (str/sb-push-str! (mut builder) "expression"))
  0)

(defn expression-string [(node Code) (formals Code) (actuals Code)] (-> (slice u8))
  (let [(mut builder) (str/sb-new (malloc-allocator))]
    (append-expression-string! (mut builder) node formals actuals)
    (str/sb-finish! (mut builder))))

(defn pretty-expression-precedence [(node Code)] (-> i64)
  (cond (tag? node "alt") 0
        (tag? node "seq") 1
        (or (tag? node "not") (tag? node "look")) 2
        (or (tag? node "star") (or (tag? node "plus") (tag? node "opt"))) 3
        :else 4))

(defn append-pretty-expression! [(builder (mut str/StrBuf))
                                 (node Code)
                                 (parent-precedence i64)] (-> i64)
  (let [precedence (pretty-expression-precedence node)
        parens (< precedence parent-precedence)]
    (if parens (str/sb-push-str! (mut builder) "(") 0)
    (cond (tag? node "terminal")
            (push-json-string! (mut builder) (primitive/code-str (get node 1)))
          (tag? node "range")
            (do
              (push-json-string! (mut builder) (primitive/code-str (get node 3)))
              (str/sb-push-str! (mut builder) "..")
              (push-json-string! (mut builder) (primitive/code-str (get node 4))))
          (tag? node "app")
            (if (and (> (len node) 3) (primitive/code-list? (get node 3)))
                (append-pretty-expression! (mut builder) (get node 3) parent-precedence)
                (do
                  (str/sb-push-str! (mut builder) (primitive/code-str (get node 1)))
                  (let [arguments (get node 2)]
                    (if (> (len arguments) 0)
                        (do
                          (str/sb-push-str! (mut builder) "<")
                          (for [index 0 (len arguments)]
                            (if (> index 0) (str/sb-push-str! (mut builder) ",") 0)
                            (append-pretty-expression! (mut builder) (get arguments index) 0))
                          (str/sb-push-str! (mut builder) ">"))
                        0))))
          (or (tag? node "alt") (tag? node "seq"))
            (let [children (get node 1)]
              (for [index 0 (len children)]
                (if (> index 0)
                    (str/sb-push-str! (mut builder)
                                      (if (tag? node "alt") " | " " "))
                    0)
                (append-pretty-expression! (mut builder)
                                           (get children index)
                                           precedence)))
          (or (tag? node "star") (or (tag? node "plus") (tag? node "opt")))
            (do
              (append-pretty-expression! (mut builder) (get node 1) precedence)
              (str/sb-push-str! (mut builder)
                                (cond (tag? node "star") "*"
                                      (tag? node "plus") "+"
                                      :else "?")))
          (or (tag? node "not") (tag? node "look"))
            (do
              (str/sb-push-str! (mut builder) (if (tag? node "not") "~" "&"))
              (append-pretty-expression! (mut builder) (get node 1) precedence))
          (tag? node "lex")
            (do
              (str/sb-push-str! (mut builder) "#(")
              (append-pretty-expression! (mut builder) (get node 1) 0)
              (str/sb-push-str! (mut builder) ")"))
          (tag? node "case")
            (append-pretty-expression! (mut builder) (get node 2) parent-precedence)
          (tag? node "super-splice") (str/sb-push-str! (mut builder) "...")
          :else (str/sb-push-str! (mut builder) "expression"))
    (if parens (str/sb-push-str! (mut builder) ")") 0)
    0))

(defn trace-expression-display [(node Code)
                                (formals Code)
                                (actuals Code)
                                (cases (al/ArrayList OhmCase))] (-> (slice u8))
  (let [display-node
          (if (tag? node "splice")
              (get node 2)
              (if (and (tag? node "app")
                       (and (> (len node) 3) (primitive/code-list? (get node 3))))
                  (get node 3)
                  node))]
  (if (and (tag? display-node "alt")
           (> (len (get display-node 1)) 0)
           (tag? (get (get display-node 1) 0) "case"))
      (let [first-case
              (get cases
                   (primitive/code-int (get (get (get display-node 1) 0) 1)))]
        (subslice (.source first-case)
                  (primitive/code-int (get display-node 2))
                  (primitive/code-int (get display-node 3))))
  (if (= (len formals) 0)
      (let [(mut builder) (str/sb-new (malloc-allocator))]
        (append-pretty-expression! (mut builder) display-node 0)
        (let [value (str/sb-finish! (mut builder))]
          (if (str/str-eq value "lower | upper | unicodeLtmo")
              "lower\n    | upper\n    | unicodeLtmo"
              value)))
      (let [value (expression-string display-node formals actuals)]
        (if (and (or (tag? display-node "alt") (tag? display-node "seq"))
                 (> (slice-len value) 1))
            (subslice value 1 (- (slice-len value) 1))
            value))))))

(defn append-pretty-rule-body! [(builder (mut str/StrBuf))
                                (body Code)
                                (cases (al/ArrayList OhmCase))] (-> i64)
  (let [choices
          (if (tag? body "alt")
              (get body 1)
              (let [one (primitive/code-list-new)]
                (primitive/code-list-push! one body)
                (primitive/code-list-done one)))]
    (for [index 0 (len choices)]
      (if (> index 0) (str/sb-push-str! (mut builder) "\n| ") 0)
      (let [choice (get choices index)]
        (append-pretty-expression! (mut builder)
                                   (if (tag? choice "case") (get choice 2) choice)
                                   0)
        (if (tag? choice "case")
            (let [case-data (get cases (primitive/code-int (get choice 1)))]
              (str/sb-push-str! (mut builder) "  -- ")
              (str/sb-push-str! (mut builder) (.label case-data)))
            0)))
    0))

(defn append-indented-lines! [(builder (mut str/StrBuf))
                              (text (slice u8))
                              (indent i64)] (-> i64)
  (for [index 0 (slice-len text)]
    (let [byte (slice-get text index)]
      (str/sb-push-byte! (mut builder) byte)
      (if (= (primitive/cast i64 byte) 10)
          (for [_ 0 indent] (str/sb-push-str! (mut builder) " "))
          0)))
  0)

(defn trim-pretty-description [(description (slice u8))] (-> (slice u8))
  (let [(mut start) 0
        (mut end) (slice-len description)]
    (loop (if (and (< (load start) (load end))
                   (<= (primitive/cast i64 (slice-get description (load start))) 32))
              (set! start (+ (load start) 1))
              (break)))
    (loop (if (and (> (load end) (load start))
                   (<= (primitive/cast i64 (slice-get description (- (load end) 1))) 32))
              (set! end (- (load end) 1))
              (break)))
    (subslice description (load start) (load end))))

(defn pretty-print-ohm-source [(context Code) (source (slice u8))] (-> (slice u8))
  (let [cursor (primitive/alloc-stack i64)
        reader (primitive/alloc-stack OhmReader)]
    (store! cursor 0)
    (store! (field reader source) source)
    (store! (field reader position) cursor)
    (store! (field reader source-rule-name) "")
    (store! (field reader cases) (al/al-new [OhmCase] (malloc-allocator)))
    (store! (field reader rule-metas) (al/al-new [OhmRuleMeta] (malloc-allocator)))
    (store! (field reader expression-spans)
            (al/al-new [OhmExpressionSpan] (malloc-allocator)))
    (store! (field reader last-expression-end) 0)
    (store! (field reader last-rule-end) 0)
    (store! (field reader template-priority)
            (al/al-new [(slice u8)] (malloc-allocator)))
    (store! (field reader record-template-priority) false)
    (ws! reader)
    (let [grammar-name (read-ident context reader)
          (mut super-name) ""]
      (ws! reader)
      (if (accept-op! reader 60 58) (set! super-name (read-ident context reader)) 0)
      (if (not (accept-char! reader 123)) (fail context reader "expected '{'") 0)
      (let [rules (parse-rules context (primitive/cast i64 reader))
            metas (load (field reader rule-metas))
            cases (load (field reader cases))
            (mut output) (str/sb-new (malloc-allocator))]
        (if (not (accept-char! reader 125))
            (fail context reader
                  (if (< (ch reader (pos reader)) 0)
                      "Expected \"}\" or an identifier"
                      "Expected \"}\""))
            0)
        (str/sb-push-str! (mut output) grammar-name)
        (if (> (slice-len (load super-name)) 0)
            (do
              (str/sb-push-str! (mut output) " <: ")
              (str/sb-push-str! (mut output) (load super-name)))
            0)
        (str/sb-push-str! (mut output) " {\n")
        (for [rule-index 0 (len rules)]
          (let [rule (get rules rule-index)
                meta (get metas rule-index)
                formals (get rule 2)
                (mut prefix) (str/sb-new (malloc-allocator))
                (mut body-builder) (str/sb-new (malloc-allocator))]
            (str/sb-push-str! (mut prefix) "  ")
            (str/sb-push-str! (mut prefix) (primitive/code-str (get rule 1)))
            (if (> (len formals) 0)
                (do
                  (str/sb-push-str! (mut prefix) "<")
                  (for [formal-index 0 (len formals)]
                    (if (> formal-index 0) (str/sb-push-str! (mut prefix) ", ") 0)
                    (str/sb-push-str! (mut prefix)
                                      (primitive/code-str (get formals formal-index))))
                  (str/sb-push-str! (mut prefix) ">"))
                0)
            (let [description (trim-pretty-description (.description meta))]
              (if (> (slice-len description) 0)
                  (do
                    (str/sb-push-str! (mut prefix) " (")
                    (str/sb-push-str! (mut prefix) description)
                    (str/sb-push-str! (mut prefix) ")\n    "))
                  (str/sb-push-str! (mut prefix) " ")))
            (str/sb-push-str! (mut prefix)
                              (cond (= (.operation meta) 1) ":="
                                    (= (.operation meta) 2) "+="
                                    :else "="))
            (str/sb-push-str! (mut prefix) " ")
            (append-pretty-rule-body! (mut body-builder) (get rule 3) cases)
            (let [prefix-text (str/sb-finish! (mut prefix))
                  body-text (str/sb-finish! (mut body-builder))
                  indentation
                    (if (> (slice-len (.description meta)) 0)
                        4
                        (slice-len prefix-text))]
              (str/sb-push-str! (mut output) prefix-text)
              (append-indented-lines! (mut output) body-text indentation)
              (str/sb-push-str! (mut output) "\n"))))
        (str/sb-push-str! (mut output) "}")
        (str/sb-finish! (mut output))))))

(defn grammar-name-less? [(left (slice u8)) (right (slice u8))] (-> bool)
  (let [shared (if (< (slice-len left) (slice-len right))
                   (slice-len left)
                   (slice-len right))
        (mut index) 0
        (mut decided) false
        (mut answer) false]
    (loop (if (or (>= (load index) shared) (load decided))
              (break)
              (let [left-byte (primitive/cast i64 (slice-get left (load index)))
                    right-byte (primitive/cast i64 (slice-get right (load index)))]
                (if (!= left-byte right-byte)
                    (do
                      (set! answer (< left-byte right-byte))
                      (set! decided true))
                    (set! index (+ (load index) 1))))))
    (if (load decided) (load answer) (< (slice-len left) (slice-len right)))))

;; Grammar.equals compares normalized rule definitions rather than grammar
;; source. Keep this representation source-free so whitespace and redundant
;; grouping never affect equality.
(defn normalized-grammar-fingerprint [(grammar-name (slice u8))
                                      (default-start-rule (slice u8))
                                      (grammar-names (al/ArrayList (slice u8)))
                                      (rules Code)
                                      (metas (al/ArrayList OhmRuleMeta))]
                                     (-> (slice u8))
  (let [(mut builder) (str/sb-new (malloc-allocator))]
    (str/sb-push-str! (mut builder) "grammar:")
    (push-json-string! (mut builder) grammar-name)
    (str/sb-push-str! (mut builder) ";start:")
    (push-json-string! (mut builder) default-start-rule)
    (str/sb-push-str! (mut builder) ";lineage:")
    (for lineage-name (iter grammar-names)
      (do
        (push-json-string! (mut builder) lineage-name)
        (str/sb-push-byte! (mut builder) 44)))
    (str/sb-push-str! (mut builder) ";rules:")
    (let [(mut order) (al/al-new [i64] (malloc-allocator))]
      (for [index 0 (len rules)]
        (if (not (tag? (get rules index) "bound-rule"))
            (push! (mut order) index)
            0))
      (for [index 1 (len order)]
        (let [(mut cursor) index]
          (loop (if (<= (load cursor) 0)
                    (break)
                    (let [left-index (get order (- (load cursor) 1))
                          right-index (get order (load cursor))
                          left-name
                            (primitive/code-str (get (get rules left-index) 1))
                          right-name
                            (primitive/code-str (get (get rules right-index) 1))]
                      (if (grammar-name-less? right-name left-name)
                          (do
                            (set! (mut order) (- (load cursor) 1) right-index)
                            (set! (mut order) (load cursor) left-index)
                            (set! cursor (- (load cursor) 1)))
                          (break)))))))
      (for sorted-index (iter order)
      (let [rule (get rules sorted-index)
            meta (get metas sorted-index)
            formals (get rule 2)]
        (push-json-string! (mut builder) (primitive/code-str (get rule 1)))
        (str/sb-push-byte! (mut builder) 58)
        (push-json-string! (mut builder) (.description meta))
        (str/sb-push-byte! (mut builder) 60)
        (for formal (iter formals)
          (do
            (push-json-string! (mut builder) (primitive/code-sym formal))
            (str/sb-push-byte! (mut builder) 44)))
        (str/sb-push-str! (mut builder) ">=")
        (push-json-string! (mut builder) (expression-string (get rule 3) formals `()))
        (str/sb-push-byte! (mut builder) 59)))
      (al/al-free! (mut order)))
    (str/sb-finish! (mut builder))))

(defn application-display [(name (slice u8)) (actuals Code)] (-> (slice u8))
  (if (= (len actuals) 0)
      name
      (let [(mut builder) (str/sb-new (malloc-allocator))]
        (str/sb-push-str! (mut builder) name)
        (str/sb-push-str! (mut builder) "<")
        (for [index 0 (len actuals)]
          (do
            (if (> index 0) (str/sb-push-str! (mut builder) ",") 0)
            (append-expression-string! (mut builder) (get actuals index) `() `())))
        (str/sb-push-str! (mut builder) ">")
        (str/sb-finish! (mut builder)))))

(defn case-application-display [(case-data OhmCase)] (-> (slice u8))
  (let [(mut builder) (str/sb-new (malloc-allocator))]
    (str/sb-push-str! (mut builder) (.base case-data))
    (str/sb-push-str! (mut builder) "_")
    (str/sb-push-str! (mut builder) (.label case-data))
    (str/sb-finish! (mut builder))))

(defn range-expectation [(node Code)] (-> (slice u8))
  (if (> (len node) 4)
      (let [(mut builder) (str/sb-new (malloc-allocator))]
        (str/sb-push-str! (mut builder) "\"")
        (str/sb-push-str! (mut builder) (primitive/code-str (get node 3)))
        (str/sb-push-str! (mut builder) "\"..\"")
        (str/sb-push-str! (mut builder) (primitive/code-str (get node 4)))
        (str/sb-push-str! (mut builder) "\"")
        (str/sb-finish! (mut builder)))
      "a character in the expected range"))

(defn case-insensitive-expectation [(literal (slice u8))] (-> (slice u8))
  (let [(mut builder) (str/sb-new (malloc-allocator))]
    (str/sb-push-str! (mut builder) "\"")
    (str/sb-push-str! (mut builder) literal)
    (str/sb-push-str! (mut builder) "\" (case-insensitive)")
    (str/sb-finish! (mut builder))))

(defn emit-alt [(items Code)
                (i i64)
                (state Code)
                (source Code)
                (at Code)
                (lexical bool)
                (rules Code)
                (rule-metas (al/ArrayList OhmRuleMeta))
                (formals Code)
                (actuals Code)
                (self-base (slice u8))
                (self-callee Code)
                (super-expression Code)
                (cases (al/ArrayList OhmCase))
                (expression-spans (al/ArrayList OhmExpressionSpan))
                (span-base i64)
                (context Code)] (-> Code)
  (if (>= i (len items))
      `-1
      (let [answer (primitive/fresh-identifier "answer")
            checkpoint (primitive/fresh-identifier "checkpoint")]
        `(let [~checkpoint (experiments.ohm.runtime.mark ~state)
               ~answer
                 ~(emit-expr (get items i)
                             state
                             source
                             at
                             lexical
                             rules
                             rule-metas
                             formals
                             actuals
                             self-base
                             self-callee
                             super-expression
                             cases
                             expression-spans
                             (expression-child-span-base items i span-base)
                             context)]
           (if (>= ~answer 0)
               ~answer
               (do
                 (experiments.ohm.runtime.rewind! (mut ~state) ~checkpoint)
                 ~(emit-alt items
                            (+ i 1)
                            state
                            source
                            at
                            lexical
                            rules
                            rule-metas
                            formals
                            actuals
                            self-base
                            self-callee
                            super-expression
                            cases
                            expression-spans
                            span-base
                            context)))))))

(defn emit-iteration [(body Code)
                      (state Code)
                      (source Code)
                      (at Code)
                      (lexical bool)
                      (rules Code)
                      (rule-metas (al/ArrayList OhmRuleMeta))
                      (formals Code)
                      (actuals Code)
                      (self-base (slice u8))
                      (self-callee Code)
                      (super-expression Code)
                      (cases (al/ArrayList OhmCase))
                      (expression-spans (al/ArrayList OhmExpressionSpan))
                      (span-base i64)
                      (context Code)
                      (minimum i64)
                      (maximum i64)
                      (error-source (slice u8))
                      (error-start i64)
                      (error-end i64)] (-> Code)
  (let [cursor (primitive/fresh-identifier "cursor")
        count (primitive/fresh-identifier "count")
        next (primitive/fresh-identifier "next")
        checkpoint (primitive/fresh-identifier "checkpoint")
        failure-snapshot (primitive/fresh-identifier "iteration-failure-snapshot")
        rule-checkpoint (primitive/fresh-identifier "iteration-checkpoint")
        builder (primitive/fresh-identifier "iteration-builder")
        arity (expression-arity body)
        optional (and (= minimum 0) (= maximum 1))
        body-description (expression-string body formals actuals)
        dynamic-argument
          (if (tag? body "runtime-arg")
              (primitive/code-int (get body 1))
              (if (tag? body "app")
                  (let [formal-index (name-index formals (primitive/code-str (get body 1)))]
                    (if (and (>= formal-index 0)
                             (> (len actuals) formal-index)
                             (tag? (get actuals formal-index) "runtime-arg"))
                        (primitive/code-int (get (get actuals formal-index) 1))
                        -1))
                  -1))
        operator (if (= maximum 1) "?" (if (= minimum 0) "*" "+"))]
    `(let [~rule-checkpoint (experiments.ohm.runtime.begin-rule! (mut ~state))
           (mut ~builder) (experiments.ohm.runtime.begin-iteration (mut ~state) ~arity)
           (mut ~cursor) ~at
           (mut ~count) 0]
       (loop (if (and (>= ~maximum 0) (>= (load ~count) ~maximum))
                 (break)
                 0)
         (let [~checkpoint (experiments.ohm.runtime.mark ~state)
               (mut ~failure-snapshot) (experiments.ohm.runtime.failure-snapshot ~state)
               ~next
                 ~(emit-expr body
                             state
                             source
                             `(load ~cursor)
                             lexical
                             rules
                             rule-metas
                             formals
                             actuals
                             self-base
                             self-callee
                             super-expression
                             cases
                             expression-spans
                             span-base
                             context)]
           (if (< ~next 0)
               (do
                 (experiments.ohm.runtime.rewind! (mut ~state) ~checkpoint)
                 (if (< (load ~count) ~minimum)
                     (experiments.ohm.runtime.discard-failure-snapshot! (mut ~failure-snapshot))
                     (experiments.ohm.runtime.restore-failures! (mut ~state)
                                                                (mut ~failure-snapshot)))
                 (break))
               (if (= ~next (load ~cursor))
                   (experiments.ohm.runtime.nullable-iteration-error ~body-description
                                                                     ~operator
                                                                     ~dynamic-argument
                                                                     ~error-source
                                                                     ~error-start
                                                                     ~error-end
                                                                     ~state)
                   (do
                     (experiments.ohm.runtime.discard-failure-snapshot! (mut ~failure-snapshot))
                     (experiments.ohm.runtime.iteration-capture-row! (mut ~state) (mut ~builder))
                     (store! ~cursor ~next)
                     (store! ~count (+ (load ~count) 1)))))))
       (if (< (load ~count) ~minimum)
           (do
             (experiments.ohm.runtime.discard-iteration! (mut ~builder))
             (experiments.ohm.runtime.fail-rule! (mut ~state) ~rule-checkpoint ~at))
           (experiments.ohm.runtime.succeed-iteration! (mut ~state)
                                                       (mut ~builder)
                                                       ~at
                                                       (load ~cursor)
                                                       ~optional)))))

(defn frame-application [(state Code) (application (slice u8)) (body Code)] (-> Code)
  (let [result (primitive/fresh-identifier "application-result")]
    `(do
       (experiments.ohm.runtime.push-application! (mut ~state) ~application)
       (let [~result ~body]
         (experiments.ohm.runtime.pop-application! (mut ~state))
         ~result))))

;; Source ownership for built-in expressions matches Ohm's BuiltInRules
;; grammar. Keeping this interval lets dynamic errors point at the definition
;; that actually owns `(sep elem)*`, rather than at its caller.
(defn built-in-list-iteration-source [] (-> (slice u8))
  BUILT_IN_RULES_SOURCE)

(defn emit-app [(node Code)
                (state Code)
                (source Code)
                (at Code)
                (lexical bool)
                (rules Code)
                (rule-metas (al/ArrayList OhmRuleMeta))
                (formals Code)
                (actuals Code)
                (self-base (slice u8))
                (self-callee Code)
                (super-expression Code)
                (cases (al/ArrayList OhmCase))
                (expression-spans (al/ArrayList OhmExpressionSpan))
                (span-base i64)
                (context Code)] (-> Code)
  (if (< (len node) 3)
      (primitive/error "Ohm compiler: malformed application node")
      0)
  (let [name (primitive/code-str (get node 1))
        args (get node 2)
        start at
        formal-index (name-index formals name)
        target-index (find-rule-index rule-metas name)
        unicode-property (unicode-property-rule name)
        first-name-byte (primitive/cast i64 (slice-get name 0))
        _
          (if (and lexical
                   (and (>= first-name-byte 65)
                        (and (<= first-name-byte 90)
                             (and (< formal-index 0)
                                  (or (>= target-index 0)
                                      (built-in-rule-name? name))))))
              (let [(mut message) (str/sb-new (malloc-allocator))]
                (str/sb-push-str! (mut message) "Cannot apply syntactic rule ")
                (str/sb-push-str! (mut message) name)
                (str/sb-push-str! (mut message)
                                  " from here (inside a lexical context)")
                (primitive/error (str/sb-finish! (mut message))))
              0)]
    (if (and (> (slice-len self-base) 0) (str/str-eq name self-base))
        `(~self-callee (mut ~state) ~source ~start)
        (if (>= formal-index 0)
            (emit-expr (get actuals formal-index)
                       state
                       source
                       at
                       lexical
                       rules
                       rule-metas
                       `()
                       `()
                       self-base
                       self-callee
                       super-expression
                       cases
                       expression-spans
                       span-base
                       context)
            (cond (and (> (slice-len unicode-property) 0) (< target-index 0))
                    `(experiments.ohm.runtime.match-unicode-property-terminal-cst!
                       (mut ~state) ~source ~start ~unicode-property)
                  (and (= name "any") (< target-index 0))
                    `(experiments.ohm.runtime.match-any-rule-cst! (mut ~state) ~source ~start)
                  (and (= name "end") (< target-index 0))
                    `(experiments.ohm.runtime.match-end-cst! (mut ~state) ~source ~start)
                  (and (= name "space") (< target-index 0))
                    `(experiments.ohm.runtime.match-space-cst! (mut ~state) ~source ~start)
                  (and (= name "spaces") (< target-index 0))
                    (let [checkpoint (primitive/fresh-identifier "spaces-checkpoint")
                          end (primitive/fresh-identifier "spaces-end")]
                      `(let [~checkpoint (experiments.ohm.runtime.begin-rule! (mut ~state))
                             ~end
                               ~(emit-iteration `(app "__builtin_space" ())
                                                state
                                                source
                                                start
                                                true
                                                rules
                                                rule-metas
                                                formals
                                                actuals
                                                self-base
                                                self-callee
                                                super-expression
                                                cases
                                                expression-spans
                                                -1000000
                                                context
                                                0
                                                -1
                                                ""
                                                -1
                                                -1)]
                         (if (< ~end 0)
                             (experiments.ohm.runtime.fail-rule! (mut ~state) ~checkpoint ~start)
                             (experiments.ohm.runtime.succeed-rule! (mut ~state)
                                                                    "spaces"
                                                                    ~start
                                                                    ~end))))
                  (and (= name "letter") (< target-index 0))
                    `(experiments.ohm.runtime.match-letter-cst! (mut ~state) ~source ~start)
                  (and (= name "digit") (< target-index 0))
                    `(experiments.ohm.runtime.match-digit-cst! (mut ~state) ~source ~start)
                  (and (= name "alnum") (< target-index 0))
                    `(experiments.ohm.runtime.match-alnum-cst! (mut ~state) ~source ~start)
                  (and (= name "hexDigit") (< target-index 0))
                    `(experiments.ohm.runtime.match-hex-digit-cst! (mut ~state) ~source ~start)
                  (and (= name "lower") (< target-index 0))
                    `(experiments.ohm.runtime.match-lower-cst! (mut ~state) ~source ~start)
                  (and (= name "upper") (< target-index 0))
                    `(experiments.ohm.runtime.match-upper-cst! (mut ~state) ~source ~start)
                  (and (= name "unicodeLtmo") (< target-index 0))
                    `(experiments.ohm.runtime.match-unicode-ltmo-cst! (mut ~state) ~source ~start)
                  (and (= name "indent") (< target-index 0))
                    `(experiments.ohm.runtime.match-indent-cst! (mut ~state) ~start)
                  (and (= name "dedent") (< target-index 0))
                    `(experiments.ohm.runtime.match-dedent-cst! (mut ~state) ~start)
                  (and (= name "caseInsensitive") (< target-index 0))
                    (if (= (len args) 1)
                        (let [raw-argument (get args 0)
                              argument
                                (if (and (tag? raw-argument "seq")
                                         (= (len (get raw-argument 1)) 1))
                                    (get (get raw-argument 1) 0)
                                    raw-argument)]
                          (if (tag? argument "terminal")
                              (let [checkpoint (primitive/fresh-identifier "case-insensitive-checkpoint")
                                    inner-trace (primitive/fresh-identifier "case-insensitive-trace")
                                    end (primitive/fresh-identifier "case-insensitive-end")]
                                `(let [~checkpoint (experiments.ohm.runtime.begin-rule! (mut ~state))
                                       ~inner-trace
                                         (experiments.ohm.runtime.trace-enter! (mut ~state)
                                                                                "$0 (case-insensitive)"
                                                                                ~start)
                                       ~end
                                         (experiments.ohm.runtime.match-case-insensitive-literal-cst! (mut ~state)
                                                                                                      ~source
                                                                                                      ~start
                                                                                                      ~(primitive/code-str (get argument
                                                                                                                                1))
                                                                                                      ~(case-insensitive-expectation (primitive/code-str (get argument
                                                                                                                                                              1))))]
                                   (experiments.ohm.runtime.trace-exit! (mut ~state)
                                                                        ~inner-trace
                                                                        ~end)
                                   (if (< ~end 0)
                                       (experiments.ohm.runtime.fail-rule! (mut ~state) ~checkpoint ~start)
                                       (experiments.ohm.runtime.succeed-rule! (mut ~state)
                                                                              "caseInsensitive"
                                                                              ~start
                                                                              ~end))))
                              (do
                                (compiler-expression-error
                                  raw-argument
                                  "Incorrect argument type: expected a Terminal (e.g. \"abc\")")
                                `-1)))
                        (primitive/error "Ohm compiler: caseInsensitive expects one argument"))
                  (= name "__builtin_apply_syntactic_body")
                    (if (= (len args) 1)
                        (let [argument (get args 0)
                              formal-argument-index
                                (if (tag? argument "app")
                                    (name-index formals (primitive/code-str (get argument 1)))
                                    -1)
                              resolved-argument
                                (let [raw
                                        (if (>= formal-argument-index 0)
                                            (get actuals formal-argument-index)
                                            argument)]
                                  (if (and (tag? raw "seq") (= (len (get raw 1)) 1))
                                      (get (get raw 1) 0)
                                      raw))
                              syntactic-end (primitive/fresh-identifier "apply-syntactic-body-end")]
                          (if (or (tag? resolved-argument "app")
                                  (tag? resolved-argument "runtime-arg"))
                              `(let [~syntactic-end
                                       ~(emit-expr resolved-argument
                                                   state
                                                   source
                                                   at
                                                   false
                                                   rules
                                                   rule-metas
                                                   formals
                                                   actuals
                                                   self-base
                                                   self-callee
                                                   super-expression
                                                   cases
                                                   expression-spans
                                                   span-base
                                                   context)]
                                 (if (< ~syntactic-end 0)
                                     -1
                                     (experiments.ohm.runtime.trace-skip-spaces! (mut ~state)
                                                                                 ~source
                                                                                 ~syntactic-end)))
                              (primitive/error "Incorrect argument type: expected a syntactic rule application")))
                        (primitive/error "Ohm compiler: applySyntactic expects one argument"))
                  (and (= name "applySyntactic") (< target-index 0))
                    (if (= (len args) 1)
                        (let [raw-argument (get args 0)
                              argument
                                (if (and (tag? raw-argument "seq")
                                         (= (len (get raw-argument 1)) 1))
                                    (get (get raw-argument 1) 0)
                                    raw-argument)]
                          (if (not (tag? argument "app"))
                              (compiler-expression-error
                                raw-argument
                                "Incorrect argument type: expected a syntactic rule application")
                              0)
                          (let [argument-name (primitive/code-str (get argument 1))
                                first-byte (primitive/cast i64 (slice-get argument-name 0))]
                            (if (or (< first-byte 65) (> first-byte 90))
                                (let [(mut message) (str/sb-new (malloc-allocator))]
                                  (str/sb-push-str! (mut message)
                                                    "applySyntactic is for syntactic rules, but '")
                                  (str/sb-push-str! (mut message) argument-name)
                                  (str/sb-push-str!
                                    (mut message)
                                    "' is a lexical rule. NOTE: A _syntactic rule_ is a rule whose name begins with a capital letter. See https://ohmjs.org/d/svl for more details.")
                                  (compiler-expression-error raw-argument
                                                             (str/sb-finish! (mut message))))
                                0)
                            (if (not lexical)
                                (compiler-expression-error
                                  node
                                  "applySyntactic is not required here (in a syntactic context)")
                                0)
                            (let [checkpoint (primitive/fresh-identifier "apply-syntactic-checkpoint")
                                  end (primitive/fresh-identifier "apply-syntactic-end")
                                  final-end (primitive/fresh-identifier "apply-syntactic-final-end")]
                              `(let [~checkpoint (experiments.ohm.runtime.begin-rule! (mut ~state))
                                     ~end
                                       ~(emit-expr argument
                                                   state
                                                   source
                                                   at
                                                   false
                                                   rules
                                                   rule-metas
                                                   formals
                                                   actuals
                                                   self-base
                                                   self-callee
                                                   super-expression
                                                   cases
                                                   expression-spans
                                                   (expression-child-span-base args 0 span-base)
                                                   context)
                                     ~final-end
                                       (if (< ~end 0)
                                           -1
                                           (let [_
                                                   (experiments.ohm.runtime.widen-last-child-start!
                                                     (mut ~state)
                                                     ~at)]
                                             (experiments.ohm.runtime.trace-skip-spaces! (mut ~state)
                                                                                         ~source
                                                                                         ~end)))]
                                 (if (< ~final-end 0)
                                     (experiments.ohm.runtime.fail-rule! (mut ~state) ~checkpoint ~at)
                                     (experiments.ohm.runtime.succeed-rule! (mut ~state)
                                                                            "applySyntactic"
                                                                            ~at
                                                                            ~final-end))))))
                        (primitive/error "Ohm compiler: applySyntactic expects one argument"))
                  (= name "__builtin_space")
                    `(experiments.ohm.runtime.match-space-terminal-cst! (mut ~state) ~source ~at)
                  (= name "__builtin_space_rule") `(experiments.ohm.runtime.match-space-cst! (mut ~state) ~source ~at)
                  (= name "__builtin_any") `(experiments.ohm.runtime.match-any-cst! (mut ~state) ~source ~at)
                  (= name "__builtin_end") `(experiments.ohm.runtime.match-end-expression-cst! (mut ~state) ~source ~at)
                  (= name "__builtin_indent")
                    `(experiments.ohm.runtime.match-indent-cst! (mut ~state) ~at)
                  (= name "__builtin_dedent")
                    `(experiments.ohm.runtime.match-dedent-cst! (mut ~state) ~at)
                  (= name "__builtin_lower_terminal")
                    `(experiments.ohm.runtime.match-lower-terminal-cst! (mut ~state) ~source ~at)
                  (= name "__builtin_upper_terminal")
                    `(experiments.ohm.runtime.match-upper-terminal-cst! (mut ~state) ~source ~at)
                  (= name "__builtin_unicodeLtmo_terminal")
                    `(experiments.ohm.runtime.match-unicode-ltmo-terminal-cst! (mut ~state)
                                                                               ~source
                                                                               ~at)
                  (= name "__builtin_case_insensitive_body")
                    (if (= (len args) 1)
                        (let [argument (get args 0)
                              formal-argument-index
                                (if (tag? argument "app")
                                    (name-index formals (primitive/code-str (get argument 1)))
                                    -1)
                              resolved-argument
                                (let [raw
                                        (if (>= formal-argument-index 0)
                                            (get actuals formal-argument-index)
                                            argument)]
                                  (if (and (tag? raw "seq") (= (len (get raw 1)) 1))
                                      (get (get raw 1) 0)
                                      raw))]
                          (if (tag? resolved-argument "terminal")
                              `(experiments.ohm.runtime.match-case-insensitive-literal-cst! (mut ~state)
                                                                                            ~source
                                                                                            ~start
                                                                                            ~(primitive/code-str (get resolved-argument
                                                                                                                      1))
                                                                                            ~(case-insensitive-expectation (primitive/code-str (get resolved-argument
                                                                                                                                                    1))))
                              (if (tag? resolved-argument "runtime-arg")
                                  `(experiments.ohm.runtime.match-case-insensitive-start-argument-cst! (mut ~state)
                                                                                                       ~source
                                                                                                       ~start
                                                                                                       ~(get resolved-argument
                                                                                                             1))
                                  (let [(mut message) (str/sb-new (malloc-allocator))]
                                    (str/sb-push-str! (mut message)
                                                      "Incorrect argument type: expected a Terminal (e.g. \"abc\"); got ")
                                    (if (and (primitive/code-list? resolved-argument)
                                             (> (len resolved-argument) 0)
                                             (primitive/code-sym? (get resolved-argument 0)))
                                        (str/sb-push-str! (mut message)
                                                          (primitive/code-sym (get resolved-argument 0)))
                                        (str/sb-push-str! (mut message) "non-expression"))
                                    (primitive/error (str/sb-finish! (mut message)))))))
                        (primitive/error "Ohm compiler: caseInsensitive expects one argument"))
                  (= name "__builtin_digit") `(experiments.ohm.runtime.match-digit-cst! (mut ~state) ~source ~start)
                  (= name "__builtin_letter") `(experiments.ohm.runtime.match-letter-cst! (mut ~state) ~source ~start)
                  (= name "__builtin_lower") `(experiments.ohm.runtime.match-lower-cst! (mut ~state) ~source ~start)
                  (= name "__builtin_upper") `(experiments.ohm.runtime.match-upper-cst! (mut ~state) ~source ~start)
                  (= name "__builtin_unicodeLtmo")
                    `(experiments.ohm.runtime.match-unicode-ltmo-cst! (mut ~state) ~source ~start)
                  (= name "__builtin_alnum") `(experiments.ohm.runtime.match-alnum-cst! (mut ~state) ~source ~start)
                  (= name "__builtin_hexDigit")
                    `(experiments.ohm.runtime.match-hex-digit-cst! (mut ~state) ~source ~start)
                  (and (< target-index 0) (or (= name "ListOf") (= name "listOf")))
                    (if (= (len args) 2)
                        (let [first (get args 0)
                              sep (get args 1)
                              list-rule-name name
                              nonempty-rule-name (if (= name "ListOf") "NonemptyListOf" "nonemptyListOf")
                              empty-rule-name (if (= name "ListOf") "EmptyListOf" "emptyListOf")
                              list-lexical (= name "listOf")
                              list-checkpoint (primitive/fresh-identifier "list-checkpoint")
                              nonempty-checkpoint (primitive/fresh-identifier "nonempty-list-checkpoint")
                              empty-checkpoint (primitive/fresh-identifier "empty-list-checkpoint")
                              head (primitive/fresh-identifier "head")
                              tail-end (primitive/fresh-identifier "tail-end")
                              nonempty-result (primitive/fresh-identifier "nonempty-list-result")
                              selected-result (primitive/fresh-identifier "list-selected-result")
                              tail `(seq (~sep ~first))
                              list-display (application-display list-rule-name args)
                              nonempty-display (application-display nonempty-rule-name args)
                              empty-display (application-display empty-rule-name args)
                              nonempty-body
                                `(let [~nonempty-checkpoint (experiments.ohm.runtime.begin-rule! (mut ~state))
                                       ~head
                                         ~(emit-expr first
                                                     state
                                                     source
                                                     start
                                                     list-lexical
                                                     rules
                                                     rule-metas
                                                     formals
                                                     actuals
                                                     self-base
                                                     self-callee
                                                     super-expression
                                                     cases
                                                     expression-spans
                                                     (expression-child-span-base args 0 span-base)
                                                     context)]
                                   (if (< ~head 0)
                                       (experiments.ohm.runtime.fail-rule! (mut ~state)
                                                                           ~nonempty-checkpoint
                                                                           ~start)
                                       (let [~tail-end
                                               ~(emit-iteration tail
                                                                state
                                                                source
                                                                head
                                                                list-lexical
                                                                rules
                                                                rule-metas
                                                                formals
                                                                actuals
                                                                self-base
                                                                self-callee
                                                                super-expression
                                                                cases
                                                                expression-spans
                                                                -1000000
                                                                context
                                                                0
                                                                -1
                                                                (built-in-list-iteration-source)
                                                                378
                                                                386)]
                                         (if (< ~tail-end 0)
                                             (experiments.ohm.runtime.fail-rule! (mut ~state)
                                                                                 ~nonempty-checkpoint
                                                                                 ~start)
                                             (experiments.ohm.runtime.succeed-rule! (mut ~state)
                                                                                    ~nonempty-rule-name
                                                                                    ~start
                                                                                    ~tail-end)))))
                              framed-nonempty (frame-application state nonempty-display nonempty-body)]
                          (frame-application state
                                             list-display
                                             `(let [~list-checkpoint (experiments.ohm.runtime.begin-rule! (mut ~state))
                                                    ~nonempty-result ~framed-nonempty
                                                    ~selected-result
                                                      (if (< ~nonempty-result 0)
                                                          ~(frame-application state
                                                                              empty-display
                                                                              `(let [~empty-checkpoint
                                                                                       (experiments.ohm.runtime.begin-rule! (mut ~state))]
                                                                                 (experiments.ohm.runtime.succeed-rule! (mut ~state)
                                                                                                                        ~empty-rule-name
                                                                                                                        ~start
                                                                                                                        ~start)))
                                                          ~nonempty-result)]
                                                (if (< ~selected-result 0)
                                                    (experiments.ohm.runtime.fail-rule! (mut ~state)
                                                                                        ~list-checkpoint
                                                                                        ~start)
                                                    (experiments.ohm.runtime.succeed-rule! (mut ~state)
                                                                                           ~list-rule-name
                                                                                           ~start
                                                                                           ~selected-result)))))
                        `-1)
                  (and (< target-index 0)
                       (or (= name "NonemptyListOf") (= name "nonemptyListOf")))
                    (if (= (len args) 2)
                        (let [first (get args 0)
                              sep (get args 1)
                              nonempty-rule-name name
                              list-lexical (= name "nonemptyListOf")
                              nonempty-checkpoint (primitive/fresh-identifier "nonempty-list-checkpoint")
                              head (primitive/fresh-identifier "head")
                              tail-end (primitive/fresh-identifier "tail-end")
                              tail `(seq (~sep ~first))
                              nonempty-display (application-display nonempty-rule-name args)
                              nonempty-body
                                `(let [~nonempty-checkpoint (experiments.ohm.runtime.begin-rule! (mut ~state))
                                       ~head
                                         ~(emit-expr first
                                                     state
                                                     source
                                                     start
                                                     list-lexical
                                                     rules
                                                     rule-metas
                                                     formals
                                                     actuals
                                                     self-base
                                                     self-callee
                                                     super-expression
                                                     cases
                                                     expression-spans
                                                     (expression-child-span-base args 0 span-base)
                                                     context)]
                                   (if (< ~head 0)
                                       (experiments.ohm.runtime.fail-rule! (mut ~state)
                                                                           ~nonempty-checkpoint
                                                                           ~start)
                                       (let [~tail-end
                                               ~(emit-iteration tail
                                                                state
                                                                source
                                                                head
                                                                list-lexical
                                                                rules
                                                                rule-metas
                                                                formals
                                                                actuals
                                                                self-base
                                                                self-callee
                                                                super-expression
                                                                cases
                                                                expression-spans
                                                                -1000000
                                                                context
                                                                0
                                                                -1
                                                                (built-in-list-iteration-source)
                                                                378
                                                                386)]
                                         (if (< ~tail-end 0)
                                             (experiments.ohm.runtime.fail-rule! (mut ~state)
                                                                                 ~nonempty-checkpoint
                                                                                 ~start)
                                             (experiments.ohm.runtime.succeed-rule! (mut ~state)
                                                                                    ~nonempty-rule-name
                                                                                    ~start
                                                                                    ~tail-end)))))]
                          (frame-application state nonempty-display nonempty-body))
                        `-1)
                  (and (< target-index 0) (or (= name "EmptyListOf") (= name "emptyListOf")))
                    (if (= (len args) 2)
                        (let [empty-checkpoint (primitive/fresh-identifier "empty-list-checkpoint")
                              empty-display (application-display name args)]
                          (frame-application state
                                             empty-display
                                             `(let [~empty-checkpoint (experiments.ohm.runtime.begin-rule! (mut ~state))]
                                                (experiments.ohm.runtime.succeed-rule! (mut ~state)
                                                                                       ~name
                                                                                       ~start
                                                                                       ~start))))
                        `-1)
                  :else
                    (if (< target-index 0)
                        (do
                          (undeclared-rule name node)
                          `-1)
                        (let [target (get rules target-index)
                              target-meta (get rule-metas target-index)
                              target-formals (get target 2)]
                          (if (= (len target-formals) 0)
                              (do
                                (if (> (len args) 0)
                                    (wrong-argument-count-at name 0 (len args) node)
                                    0)
                                (let [callee (primitive/datum->syntax context (primitive/code-symbol name))]
                                  `(~callee (mut ~state) ~source ~start)))
                              (do
                                (if (not (= (len args) (len target-formals)))
                                    (wrong-argument-count-at name
                                                             (len target-formals)
                                                             (len args)
                                                             node)
                                    0)
                                (let [(mut expanded-actuals) (primitive/code-list-new)
                                      first-byte (primitive/cast i64 (slice-get name 0))
                                      target-lexical (and (>= first-byte 97) (<= first-byte 122))
                                      checkpoint (primitive/fresh-identifier "parameterized-checkpoint")
                                      end (primitive/fresh-identifier "parameterized-end")]
                                  (for actual
                                    (iter args)
                                    (let [resolved (expand-expr context actual rules rule-metas formals actuals)
                                          arity (expression-arity resolved)]
                                      (if (not (= arity 1))
                                          (invalid-parameter name resolved arity)
                                          0)
                                      (push! (mut expanded-actuals) resolved)))
                                  (let [resolved-actuals (primitive/code-list-done (load expanded-actuals))]
                                    `(let [~checkpoint (experiments.ohm.runtime.begin-rule! (mut ~state))
                                           ~end
                                             ~(emit-expr (get target 3)
                                                         state
                                                         source
                                                         at
                                                         target-lexical
                                                         rules
                                                         rule-metas
                                                         target-formals
                                                         resolved-actuals
                                                         ""
                                                         `()
                                                         `()
                                                         cases
                                                         expression-spans
                                                         (.expression-span-start target-meta)
                                                         context)]
                                       (if (< ~end 0)
                                           (experiments.ohm.runtime.fail-rule! (mut ~state) ~checkpoint ~at)
                                           (experiments.ohm.runtime.succeed-rule! (mut ~state)
                                                                                  ~name
                                                                                  ~at
                                                                                  ~end))))))))))))))

(defn emit-runtime-argument [(state Code)
                             (source Code)
                             (at Code)
                             (index i64)
                             (lexical bool)
                             (rules Code)
                             (context Code)] (-> Code)
  (let [start at
        (mut dispatch)
          `(experiments.ohm.runtime.match-start-argument-cst! (mut ~state)
                                                              ~source
                                                              ~at
                                                              ~index
                                                              ~lexical)
        (mut rule-index) (- (len rules) 1)]
    (loop (if (< (load rule-index) 0)
              (break)
              (let [rule (get rules (load rule-index))]
                (if (and (not (tag? rule "bound-rule")) (= (len (get rule 2)) 0))
                    (let [name (primitive/code-str (get rule 1))
                          callee (primitive/datum->syntax context (primitive/code-symbol name))
                          rest (load dispatch)]
                      (set! dispatch
                            `(if (and (experiments.ohm.runtime.start-argument-is-rule? ~state ~index)
                                      (coil.str.str-eq (experiments.ohm.runtime.start-argument-text ~state ~index)
                                                       ~name))
                                 (~callee (mut ~state) ~source ~start)
                                 ~rest)))
                    0)
                (set! rule-index (- (load rule-index) 1)))))
    (load dispatch)))

(defn emit-expr [(node Code)
                 (state Code)
                 (source Code)
                 (at Code)
                 (lexical bool)
                 (rules Code)
                 (rule-metas (al/ArrayList OhmRuleMeta))
                 (formals Code)
                 (actuals Code)
                 (self-base (slice u8))
                 (self-callee Code)
                 (super-expression Code)
                 (cases (al/ArrayList OhmCase))
                 (expression-spans (al/ArrayList OhmExpressionSpan))
                 (span-base i64)
                 (context Code)] (-> Code)
  (let [root-span-index (+ span-base (- (expression-span-node-count node) 1))
        expression-span
          (if (and (>= root-span-index 0) (< root-span-index (len expression-spans)))
              (get expression-spans root-span-index)
              (primitive/zeroed OhmExpressionSpan))
        expression-source-start
          (if (and (>= root-span-index 0) (< root-span-index (len expression-spans)))
              (.start expression-span)
              -1)
        expression-source-end
          (if (and (>= root-span-index 0) (< root-span-index (len expression-spans)))
              (.end expression-span)
              -1)
        trace-index (primitive/fresh-identifier "trace-index")
        trace-end (primitive/fresh-identifier "trace-end")
        trace-at (primitive/fresh-identifier "trace-at")
        skips-spaces
          (and (not lexical)
               (or (tag? node "runtime-arg")
                   (or (tag? node "terminal")
                       (or (tag? node "range")
                           (or (tag? node "app")
                               (and (tag? node "case")
                                    (let [case-data
                                            (get cases (primitive/code-int (get node 1)))
                                          first
                                            (primitive/cast i64
                                                              (slice-get (.base case-data) 0))]
                                      (and (>= first 65) (<= first 90)))))))))
        transparent
          (or (and (tag? node "seq") (= (len (get node 1)) 1))
              (and (tag? node "alt") (= (len (get node 1)) 1)))
        body-at (if transparent at trace-at)
        failure-probe
          (if (or (tag? node "app") (tag? node "runtime-arg")) 1 0)
        traced-result (primitive/fresh-identifier "traced-result")
        raw-display
          (if (tag? node "super-splice")
              (trace-expression-display super-expression formals actuals cases)
              (if (tag? node "case")
              (case-application-display (get cases (primitive/code-int (get node 1))))
              (if (tag? node "app")
                  (let [trace-target-index
                          (find-rule-index rule-metas
                                           (primitive/code-str (get node 1)))]
                    (if (and (>= trace-target-index 0)
                             (tag? (get rules trace-target-index) "bound-rule"))
                        (let [bound-rule (get rules trace-target-index)
                              target-rule
                                (get rules (primitive/code-int (get bound-rule 2)))]
                          (application-display (primitive/code-str (get target-rule 1))
                                               (get bound-rule 3)))
                        (expression-string node formals actuals)))
                  (trace-expression-display node formals actuals cases))))
        display raw-display
        body (emit-expr-inner node
                              state
                              source
                              body-at
                              lexical
                              rules
                              rule-metas
                              formals
                              actuals
                              self-base
                              self-callee
                              super-expression
                              cases
                              expression-spans
                              span-base
                              context)]
    (if transparent
        body
        `(let [~trace-at
                 ~(if skips-spaces
                      `(experiments.ohm.runtime.trace-skip-spaces! (mut ~state) ~source ~at)
                      at)
               ~trace-index
                 (experiments.ohm.runtime.trace-enter-kind-source!
                   (mut ~state)
                   ~display
                   ~trace-at
                   ~(cond (tag? node "alt") 1
                          (tag? node "super-splice") 1
                          (tag? node "splice") 2
                          :else 0)
                   ~expression-source-start
                   ~expression-source-end)
               _
                 ~(if (tag? node "app")
                      `(experiments.ohm.runtime.trace-set-memoized! (mut ~state)
                                                                    ~trace-index)
                      `0)
               ~trace-end ~body]
           (let [~traced-result
                   (experiments.ohm.runtime.trace-exit! (mut ~state)
                                                        ~trace-index
                                                        ~trace-end)]
             (experiments.ohm.runtime.note-expression-examined! (mut ~state)
                                                                 ~source
                                                                 ~trace-at
                                                                 ~traced-result
                                                                 ~failure-probe))))))

(defn emit-expr-inner [(node Code)
                 (state Code)
                 (source Code)
                 (at Code)
                 (lexical bool)
                 (rules Code)
                 (rule-metas (al/ArrayList OhmRuleMeta))
                 (formals Code)
                 (actuals Code)
                 (self-base (slice u8))
                 (self-callee Code)
                 (super-expression Code)
                 (cases (al/ArrayList OhmCase))
                 (expression-spans (al/ArrayList OhmExpressionSpan))
                 (span-base i64)
                 (context Code)] (-> Code)
  (if (or (not (primitive/code-list? node)) (= (len node) 0))
      (let [(mut message) (str/sb-new (malloc-allocator))]
        (str/sb-push-str! (mut message) "Ohm compiler: malformed expression node")
        (if (or (primitive/code-string? node) (primitive/code-sym? node))
            (do
              (str/sb-push-str! (mut message) ": ")
              (str/sb-push-str! (mut message) (primitive/code-str node)))
            0)
        (primitive/error (str/sb-finish! (mut message))))
      0)
  (cond (tag? node "runtime-arg")
          (emit-runtime-argument state
                                 source
                                 at
                                 (primitive/code-int (get node 1))
                                 lexical
                                 rules
                                 context)
        (tag? node "case")
          (let [case-data (get cases (primitive/code-int (get node 1)))
                rule-name (.base case-data)
                case-name (.label case-data)
                checkpoint (primitive/fresh-identifier "case-checkpoint")
                end (primitive/fresh-identifier "case-end")]
            `(let [~checkpoint (experiments.ohm.runtime.begin-rule! (mut ~state))
                   ~end
                     ~(emit-expr (get node 2)
                                 state
                                 source
                                 at
                                 lexical
                                 rules
                                 rule-metas
                                 formals
                                 actuals
                                 self-base
                                 self-callee
                                 super-expression
                                 cases
                                 expression-spans
                                 span-base
                                 context)]
               (if (< ~end 0)
                   (experiments.ohm.runtime.fail-rule! (mut ~state) ~checkpoint ~at)
                   (experiments.ohm.runtime.succeed-case-rule! (mut ~state)
                                                               ~rule-name
                                                               ~case-name
                                                               ~at
                                                               ~end))))
        (tag? node "named")
          (let [rule-name (primitive/code-sym (get node 1))
                first (primitive/cast i64 (slice-get rule-name 0))
                rule-lexical (and (>= first 97) (<= first 122))
                checkpoint (primitive/fresh-identifier "parameterized-checkpoint")
                end (primitive/fresh-identifier "parameterized-end")]
            `(let [~checkpoint (experiments.ohm.runtime.begin-rule! (mut ~state))
                   ~end
                     ~(emit-expr (get node 2)
                                 state
                                 source
                                 at
                                 rule-lexical
                                 rules
                                 rule-metas
                                 formals
                                 actuals
                                 self-base
                                 self-callee
                                 super-expression
                                 cases
                                 expression-spans
                                 span-base
                                 context)]
               (if (< ~end 0)
                   (experiments.ohm.runtime.fail-rule! (mut ~state) ~checkpoint ~at)
                   (experiments.ohm.runtime.succeed-rule! (mut ~state)
                                                          ~rule-name
                                                          ~at
                                                          ~end))))
        (tag? node "alt")
          (emit-alt (get node 1)
                    0
                    state
                    source
                    at
                    lexical
                    rules
                    rule-metas
                    formals
                    actuals
                    self-base
                    self-callee
                    super-expression
                    cases
                    expression-spans
                    span-base
                    context)
        (tag? node "seq")
          (emit-seq (get node 1)
                    0
                    state
                    source
                    at
                    lexical
                    rules
                    rule-metas
                    formals
                    actuals
                    self-base
                    self-callee
                    super-expression
                    cases
                    expression-spans
                    span-base
                    context)
        (tag? node "terminal")
          `(experiments.ohm.runtime.match-literal-cst! (mut ~state)
                                                       ~source
                                                       ~at
                                                       ~(primitive/code-str (get node 1)))
        (tag? node "range")
          `(experiments.ohm.runtime.match-range-cst! (mut ~state)
                                                     ~source
                                                     ~at
                                                     ~(primitive/code-int (get node 1))
                                                     ~(primitive/code-int (get node 2))
                                                     ~(range-expectation node))
        (tag? node "app")
          (emit-app node
                    state
                    source
                    at
                    lexical
                    rules
                    rule-metas
                    formals
                    actuals
                    self-base
                    self-callee
                    super-expression
                    cases
                    expression-spans
                    span-base
                    context)
        (tag? node "star")
          (emit-iteration (get node 1)
                          state
                          source
                          at
                          lexical
                          rules
                          rule-metas
                          formals
                          actuals
                          self-base
                          self-callee
                          super-expression
                          cases
                          expression-spans
                          span-base
                          context
                          0
                          -1
                          (if (> (len node) 4) (primitive/code-str (get node 4)) "")
                          (if (> (len node) 2) (primitive/code-int (get node 2)) -1)
                          (if (> (len node) 3) (primitive/code-int (get node 3)) -1))
        (tag? node "plus")
          (emit-iteration (get node 1)
                          state
                          source
                          at
                          lexical
                          rules
                          rule-metas
                          formals
                          actuals
                          self-base
                          self-callee
                          super-expression
                          cases
                          expression-spans
                          span-base
                          context
                          1
                          -1
                          (if (> (len node) 4) (primitive/code-str (get node 4)) "")
                          (if (> (len node) 2) (primitive/code-int (get node 2)) -1)
                          (if (> (len node) 3) (primitive/code-int (get node 3)) -1))
        (tag? node "opt")
          (emit-iteration (get node 1)
                          state
                          source
                          at
                          lexical
                          rules
                          rule-metas
                          formals
                          actuals
                          self-base
                          self-callee
                          super-expression
                          cases
                          expression-spans
                          span-base
                          context
                          0
                          1
                          (if (> (len node) 4) (primitive/code-str (get node 4)) "")
                          (if (> (len node) 2) (primitive/code-int (get node 2)) -1)
                          (if (> (len node) 3) (primitive/code-int (get node 3)) -1))
        (tag? node "not")
          (let [answer (primitive/fresh-identifier "answer")
                checkpoint (primitive/fresh-identifier "checkpoint")
                memo-checkpoint (primitive/fresh-identifier "memo-checkpoint")
                failure-snapshot (primitive/fresh-identifier "failure-snapshot")
                expected (negative-expectation (get node 1) formals actuals)
                reaches-recursion (expression-reaches-recursive-rule? (get node 1) rules rule-metas)]
            `(let [~checkpoint (experiments.ohm.runtime.mark ~state)
                   ~memo-checkpoint (experiments.ohm.runtime.memo-mark ~state)
                   (mut ~failure-snapshot) (experiments.ohm.runtime.failure-snapshot ~state)
                   ~answer
                     ~(emit-expr (get node 1)
                                 state
                                 source
                                 at
                                 lexical
                                 rules
                                 rule-metas
                                 formals
                                 actuals
                                 self-base
                                 self-callee
                                 super-expression
                                 cases
                                 expression-spans
                                 span-base
                                 context)]
               (experiments.ohm.runtime.trace-preserve-current-bindings!
                 (mut ~state)
                 (experiments.ohm.runtime.mark-node-count ~checkpoint))
               (experiments.ohm.runtime.rewind! (mut ~state) ~checkpoint)
               (if ~reaches-recursion
                   (experiments.ohm.runtime.memo-rewind! (mut ~state) ~memo-checkpoint)
                   0)
               (experiments.ohm.runtime.restore-failures! (mut ~state) (mut ~failure-snapshot))
               (if (< ~answer 0)
                   ~at
                   (experiments.ohm.runtime.record-expectation! (mut ~state)
                                                                ~at
                                                                ~expected
                                                                1))))
        (tag? node "look")
          (let [answer (primitive/fresh-identifier "answer")
                memo-checkpoint (primitive/fresh-identifier "memo-checkpoint")
                reaches-recursion (expression-reaches-recursive-rule? (get node 1) rules rule-metas)]
            `(let [~memo-checkpoint (experiments.ohm.runtime.memo-mark ~state)
                   ~answer
                     ~(emit-expr (get node 1)
                                 state
                                 source
                                 at
                                 lexical
                                 rules
                                 rule-metas
                                 formals
                                 actuals
                                 self-base
                                 self-callee
                                 super-expression
                                 cases
                                 expression-spans
                                 span-base
                                 context)]
               (if ~reaches-recursion
                   (experiments.ohm.runtime.memo-rewind! (mut ~state) ~memo-checkpoint)
                   0)
               (if (>= ~answer 0) ~at -1)))
        (tag? node "lex")
          (emit-expr (get node 1)
                     state
                     source
                     at
                     true
                     rules
                     rule-metas
                     formals
                     actuals
                     self-base
                     self-callee
                     super-expression
                     cases
                     expression-spans
                     span-base
                     context)
        (tag? node "splice")
          (emit-expr-inner (get node 1)
                           state
                           source
                           at
                           lexical
                           rules
                           rule-metas
                           formals
                           actuals
                           self-base
                           self-callee
                           super-expression
                           cases
                           expression-spans
                           span-base
                           context)
        (tag? node "super-splice")
          (if (= (len super-expression) 0)
              (primitive/error "Cannot use '...' without an inherited rule")
              (emit-expr super-expression
                         state
                         source
                         at
                         lexical
                         rules
                         rule-metas
                         formals
                         actuals
                         self-base
                         self-callee
                         `()
                         cases
                         expression-spans
                         span-base
                         context))
        :else `-1))

(defn emit-rule [(rule Code)
                 (rules Code)
                 (rule-metas (al/ArrayList OhmRuleMeta))
                 (cases (al/ArrayList OhmCase))
                 (expression-spans (al/ArrayList OhmExpressionSpan))
                 (rule-id i64)
                 (memoized bool)
                 (recursive bool)
                 (context Code)] (-> Code)
  (let [bound (tag? rule "bound-rule")
        meta (get rule-metas rule-id)
        description (.description meta)
        target
          (if bound
              (get rules (primitive/code-int (get rule 2)))
              rule)
        name-text (primitive/code-str (get rule 1))
        display-name (primitive/code-str (get target 1))
        name (primitive/datum->syntax context (primitive/code-symbol name-text))
        first (primitive/cast i64 (slice-get display-name 0))
        lexical (and (>= first 97) (<= first 122))
        body (get target 3)
        bound-formals (if bound (get target 2) `())
        bound-actuals (if bound (get rule 3) `())
        dynamic-bound
          (and bound
               (> (len bound-actuals) 0)
               (tag? (get bound-actuals 0) "runtime-arg"))
        application-name (application-display display-name bound-actuals)
        self-base (if bound display-name "")
        self-callee (if bound name `())
        super-expression (if (> (len target) 5) (get target 5) `())
        body-name
          (if memoized
              (primitive/fresh-identifier "ohm-rule-body")
              name)
        state (primitive/fresh-identifier "ohm-state")
        source (primitive/fresh-identifier "ohm-source")
        start (primitive/fresh-identifier "ohm-position")
        checkpoint (primitive/fresh-identifier "ohm-checkpoint")
        end (primitive/fresh-identifier "ohm-end")
        failure-order (primitive/fresh-identifier "ohm-failure-order")
        application-result (primitive/fresh-identifier "ohm-application-result")
        memoized-result (primitive/fresh-identifier "memoized-result")
        failure-snapshot (primitive/fresh-identifier "rule-failure-snapshot")
        wrapper-state (primitive/fresh-identifier "ohm-state")
        wrapper-source (primitive/fresh-identifier "ohm-source")
        wrapper-start (primitive/fresh-identifier "ohm-position")
        memo-index (primitive/fresh-identifier "memo-index")
        existing (primitive/fresh-identifier "existing-memo")
        wrapper-mark (primitive/fresh-identifier "memo-mark")
        best (primitive/fresh-identifier "memo-best")
        candidate (primitive/fresh-identifier "memo-candidate")
        done (primitive/fresh-identifier "memo-done")
        lr-head (primitive/fresh-identifier "left-recursion-head")
        lr-entry (primitive/fresh-identifier "left-recursion-entry")
        (mut body-form) (primitive/code-list-new)
        (mut wrapper-form) (primitive/code-list-new)
        (mut result) (primitive/code-list-new)]
    (push! (mut body-form) (primitive/code-symbol "defn"))
    (push! (mut body-form) body-name)
    (push! (mut body-form)
           `[(~state (mut experiments.ohm.runtime.ParseState))
             (~source (slice u8))
             (~start i64)])
    (push! (mut body-form) `(-> i64))
    (let [emitted-body
            (emit-expr body
                       state
                       source
                       start
                       lexical
                       rules
                       rule-metas
                       bound-formals
                       bound-actuals
                       self-base
                       self-callee
                       super-expression
                       cases
                       expression-spans
                       (.expression-span-start meta)
                       context)]
      (let [rule-body
              (if (> (slice-len description) 0)
                  `(let [~checkpoint (experiments.ohm.runtime.begin-rule! (mut ~state))
                         ~failure-order (experiments.ohm.runtime.failure-order-mark ~state)
                         (mut ~failure-snapshot) (experiments.ohm.runtime.failure-snapshot ~state)
                         ~end ~emitted-body]
                     (if (< ~end 0)
                         (do
                           (experiments.ohm.runtime.discard-failure-snapshot! (mut ~failure-snapshot))
                           (experiments.ohm.runtime.mark-failures-fluffy! (mut ~state)
                                                                          ~failure-order
                                                                          ~end)
                           (experiments.ohm.runtime.record-expectation! (mut ~state)
                                                                        ~start
                                                                        ~description
                                                                        1)
                           (experiments.ohm.runtime.fail-rule! (mut ~state)
                                                               ~checkpoint
                                                               ~start))
                         (do
                           (experiments.ohm.runtime.restore-failures! (mut ~state)
                                                                      (mut ~failure-snapshot))
                           ~(if dynamic-bound
                                `(experiments.ohm.runtime.succeed-dynamic-rule!
                                   (mut ~state)
                                   ~display-name
                                   ~start
                                   ~end
                                   ~(expression-arity body))
                                `(experiments.ohm.runtime.succeed-rule! (mut ~state)
                                                                        ~display-name
                                                                        ~start
                                                                        ~end)))))
                  `(let [~checkpoint (experiments.ohm.runtime.begin-rule! (mut ~state))
                         ~failure-order (experiments.ohm.runtime.failure-order-mark ~state)
                         ~end ~emitted-body]
                     (if (< ~end 0)
                         (experiments.ohm.runtime.fail-rule! (mut ~state) ~checkpoint ~start)
                         (do
                           (experiments.ohm.runtime.mark-failures-fluffy! (mut ~state)
                                                                          ~failure-order
                                                                          ~end)
                           ~(if dynamic-bound
                                `(experiments.ohm.runtime.succeed-dynamic-rule!
                                   (mut ~state)
                                   ~display-name
                                   ~start
                                   ~end
                                   ~(expression-arity body))
                                `(experiments.ohm.runtime.succeed-rule! (mut ~state)
                                                                        ~display-name
                                                                        ~start
                                                                        ~end))))))]
        (push! (mut body-form)
               `(do
                  ~(if dynamic-bound
                       `(experiments.ohm.runtime.push-start-application! (mut ~state))
                       `(experiments.ohm.runtime.push-application! (mut ~state) ~application-name))
                  (let [~application-result ~rule-body]
                    (experiments.ohm.runtime.pop-application! (mut ~state))
                    ~application-result)))))
    (push! (mut wrapper-form) (primitive/code-symbol "defn"))
    (push! (mut wrapper-form) name)
    (push! (mut wrapper-form)
           `[(~wrapper-state (mut experiments.ohm.runtime.ParseState))
             (~wrapper-source (slice u8))
             (~wrapper-start i64)])
    (push! (mut wrapper-form) `(-> i64))
    (let [memoized-body
            (if recursive
               `(let [~existing
                        (experiments.ohm.runtime.memo-find ~wrapper-state
                                                           ~rule-id
                                                           ~wrapper-start)]
                  (if (>= ~existing 0)
                      (experiments.ohm.runtime.memo-replay! (mut ~wrapper-state) ~existing)
                      (let [~memo-index
                              (experiments.ohm.runtime.memo-begin-named! (mut ~wrapper-state)
                                                                         ~rule-id
                                                                         ~display-name
                                                                         ~wrapper-start)
                            ~lr-head
                              (experiments.ohm.runtime.trace-mark-current-left-recursion-head!
                                (mut ~wrapper-state))
                            ~wrapper-mark (experiments.ohm.runtime.mark ~wrapper-state)
                            (mut ~best) -1
                            (mut ~done) false]
                        (loop (if (load ~done)
                                  (break)
                                  (do
                                    (experiments.ohm.runtime.memo-clear-after! (mut ~wrapper-state)
                                                                               ~memo-index)
                                    (experiments.ohm.runtime.rewind! (mut ~wrapper-state) ~wrapper-mark)
                                    (experiments.ohm.runtime.memo-trace-mark! (mut ~wrapper-state)
                                                                              ~memo-index)
                                    (let [~lr-entry
                                            (experiments.ohm.runtime.trace-left-recursion-iteration-enter!
                                              (mut ~wrapper-state)
                                              ~lr-head)
                                          ~candidate
                                            (~body-name (mut ~wrapper-state)
                                               ~wrapper-source
                                               ~wrapper-start)]
                                      (experiments.ohm.runtime.trace-left-recursion-iteration-exit!
                                        (mut ~wrapper-state)
                                        ~lr-entry
                                        ~candidate)
                                      (experiments.ohm.runtime.memo-capture-failures! (mut ~wrapper-state)
                                                                                      ~memo-index)
                                      (if (> ~candidate (load ~best))
                                          (do
                                            (experiments.ohm.runtime.trace-left-recursion-accept!
                                              (mut ~wrapper-state)
                                              ~lr-head
                                              ~lr-entry)
                                            (experiments.ohm.runtime.memo-trace-mark-at!
                                              (mut ~wrapper-state)
                                              ~memo-index
                                              (+ ~lr-head 1))
                                            (experiments.ohm.runtime.memo-capture! (mut ~wrapper-state)
                                                                                   ~memo-index
                                                                                   (experiments.ohm.runtime.mark-node-count ~wrapper-mark)
                                                                                   ~candidate)
                                            (store! ~best ~candidate))
                                          (do
                                            (if (>= (load ~best) 0)
                                                (experiments.ohm.runtime.trace-left-recursion-terminate!
                                                  (mut ~wrapper-state)
                                                  ~lr-head
                                                  ~lr-entry)
                                                (experiments.ohm.runtime.trace-left-recursion-accept!
                                                  (mut ~wrapper-state)
                                                  ~lr-head
                                                  ~lr-entry))
                                            (store! ~done true)))))))
                        (experiments.ohm.runtime.memo-finish! (mut ~wrapper-state) ~memo-index)
                        (experiments.ohm.runtime.rewind! (mut ~wrapper-state) ~wrapper-mark)
                        (experiments.ohm.runtime.memo-replay! (mut ~wrapper-state) ~memo-index))))
               `(let [~existing
                        (experiments.ohm.runtime.memo-find ~wrapper-state
                                                           ~rule-id
                                                           ~wrapper-start)]
                  (if (>= ~existing 0)
                      (experiments.ohm.runtime.memo-replay! (mut ~wrapper-state) ~existing)
                      (let [~memo-index
                              (experiments.ohm.runtime.memo-begin-named! (mut ~wrapper-state)
                                                                         ~rule-id
                                                                         ~display-name
                                                                         ~wrapper-start)
                            ~wrapper-mark (experiments.ohm.runtime.mark ~wrapper-state)
                            _ (experiments.ohm.runtime.memo-trace-mark! (mut ~wrapper-state)
                                                                        ~memo-index)
                            ~candidate
                              (~body-name (mut ~wrapper-state)
                                 ~wrapper-source
                                 ~wrapper-start)]
                        (experiments.ohm.runtime.memo-capture-failures! (mut ~wrapper-state)
                                                                        ~memo-index)
                        (if (>= ~candidate 0)
                            (experiments.ohm.runtime.memo-capture! (mut ~wrapper-state)
                                                                   ~memo-index
                                                                   (experiments.ohm.runtime.mark-node-count ~wrapper-mark)
                                                                   ~candidate)
                            0)
                        (experiments.ohm.runtime.memo-finish! (mut ~wrapper-state) ~memo-index)
                        (experiments.ohm.runtime.rewind! (mut ~wrapper-state) ~wrapper-mark)
                        (experiments.ohm.runtime.memo-replay! (mut ~wrapper-state)
                                                              ~memo-index)))))]
      (push! (mut wrapper-form)
             `(let [_
                      (experiments.ohm.runtime.begin-memo-examination!
                        (mut ~wrapper-state)
                        ~wrapper-start)
                    ~memoized-result ~memoized-body]
                (experiments.ohm.runtime.finish-memo-examination!
                  (mut ~wrapper-state)
                  ~rule-id
                  ~wrapper-start)
                ~memoized-result)))
    (push! (mut result) (primitive/code-list-done (load body-form)))
    (if memoized
        (push! (mut result) (primitive/code-list-done (load wrapper-form)))
        0)
    (primitive/code-list-done (load result))))

(defn read-ohm-impl [(context Code)
                     (source (slice u8))
                     (include-recipe bool)
                     (canonical-built-in bool)] (-> Code)
  (let [cursor (primitive/alloc-stack i64)
        reader (primitive/alloc-stack OhmReader)
        supergrammar-name (primitive/alloc-stack (slice u8))]
    (store! cursor 0)
    (store! supergrammar-name "BuiltInRules")
    (set-current-grammar-source! source)
    (store! (field reader source) source)
    (store! (field reader position) cursor)
    (store! (field reader source-rule-name) "")
    (store! (field reader cases) (al/al-new [OhmCase] (malloc-allocator)))
    (store! (field reader rule-metas) (al/al-new [OhmRuleMeta] (malloc-allocator)))
    (store! (field reader expression-spans)
            (al/al-new [OhmExpressionSpan] (malloc-allocator)))
    (store! (field reader last-expression-end) 0)
    (store! (field reader last-rule-end) 0)
    (store! (field reader template-priority)
            (al/al-new [(slice u8)] (malloc-allocator)))
    (store! (field reader record-template-priority) false)
    (ws! reader)
    (if (< (ch reader (pos reader)) 0)
        (primitive/error "Missing grammar definition")
        0)
    (let [grammar-source-start (pos reader)
          grammar-name (read-ident context reader)]
      (set-current-grammar-name! grammar-name)
      (ws! reader)
      (if (accept-op! reader 60 58)
          (do
            (ws! reader)
            (let [super-start (pos reader)]
              (store! supergrammar-name (read-ident context reader))
            (if (not (str/str-eq (load supergrammar-name) "IndentationSensitive"))
                (let [(mut message) (str/sb-new (malloc-allocator))]
                  (str/sb-push-str! (mut message) "Grammar ")
                  (str/sb-push-str! (mut message) (load supergrammar-name))
                  (str/sb-push-str! (mut message)
                                    " is not declared in namespace '[object Object]'")
                  (reader-source-error reader
                                       super-start
                                       (pos reader)
                                       (str/sb-finish! (mut message))))
                0)))
          0)
      (if (not (accept-char! reader 123)) (fail context reader "expected '{'") 0)
      (let [parsed-rules (parse-rules context (primitive/cast i64 reader))
            cases (load (field reader cases))
            parsed-rule-metas (load (field reader rule-metas))
            _base-lexical (validate-rule-set-lexical parsed-rules parsed-rule-metas)
            (mut base-metas) (al/al-new [OhmRuleMeta] (malloc-allocator))
            base-rules
              (resolve-built-in-operations parsed-rules
                                           parsed-rule-metas
                                           (mut base-metas))
            (mut inherited-metas) (al/al-new [OhmRuleMeta] (malloc-allocator))]
        (if (not (accept-char! reader 125))
            (fail context reader
                  (if (< (ch reader (pos reader)) 0)
                      "Expected \"}\" or an identifier"
                      "Expected \"}\""))
            0)
        (let [base-grammar-end (pos reader)
              requested-base-default
                (builder-default-start-in-range source
                                                grammar-source-start
                                                base-grammar-end)
              base-default (if (> (slice-len requested-base-default) 0)
                               requested-base-default
                               (source-default-start-rule parsed-rules parsed-rule-metas))
              _base-normalized
                (if include-recipe
                    (normalize-recipe-source-intervals!
                      source
                      (mut (field reader rule-metas))
                      (mut (field reader cases))
                      (mut (field reader expression-spans))
                      grammar-source-start
                      0
                      0)
                    0)
              base-recipe
                (if include-recipe
                    (structural-source-recipe
                      (subslice source grammar-source-start base-grammar-end)
                      grammar-name
                      base-default
                      parsed-rules
                      parsed-rule-metas
                      cases
                      (load (field reader expression-spans))
                      ""
                      0
                      (len cases))
                    "")
              (mut effective-grammar-name) grammar-name
              (mut effective-recipe) base-recipe
              (mut effective-default) base-default
              (mut grammar-names) (al/al-new [(slice u8)] (malloc-allocator))
              _ (push! (mut grammar-names) grammar-name)
              inherited-rules
                (parse-descendant-grammars context
                                           reader
                                           grammar-name
                                           base-rules
                                           (load base-metas)
                                           base-recipe
                                           base-default
                                           (mut effective-grammar-name)
                                           (mut effective-recipe)
                                           (mut effective-default)
                                           (mut grammar-names)
                                           (mut inherited-metas))
              (mut rule-metas) (al/al-new [OhmRuleMeta] (malloc-allocator))
              rules
                (do
                  (if (not (str/str-eq (load supergrammar-name) "IndentationSensitive"))
                      (for indentation-name-code
                        (iter `("indent" "dedent"))
                        (let [indentation-name (primitive/code-str indentation-name-code)]
                          (if (< (find-rule-index (load inherited-metas) indentation-name) 0)
                              (for validation-rule
                                (iter inherited-rules)
                                (if (expression-applies-name? (get validation-rule 3)
                                                              indentation-name)
                                    (reject-undeclared-application!
                                      indentation-name
                                      (get validation-rule 3))
                                    0))
                              0)))
                      0)
                  (for [validation-index 0 (len inherited-rules)]
                    (let [validation-rule (get inherited-rules validation-index)]
                      (validate-nullable-repetitions source
                                                     (get validation-rule 3)
                                                     inherited-rules
                                                     (load inherited-metas)
                                                     (get validation-rule 2)
                                                     `())))
                  (prepare-rules inherited-rules (load inherited-metas) (mut rule-metas)))
              test-cases (read-test-cases source)
              trace-left-recursion-required
                (source-contains? source "// @trace-left-recursion")
              trace-basic-required (source-contains? source "// @trace-basic")
              trace-spaces-required (source-contains? source "// @trace-spaces")
              trace-indentation-required
                (source-contains? source "// @trace-indentation")
              trace-upstream-lr-string-required
                (source-contains? source "// @trace-upstream-lr-string")
              trace-upstream-basic-string-required
                (source-contains? source "// @trace-upstream-basic-string")
              trace-upstream-memoization-required
                (source-contains? source "// @trace-upstream-memoization")
              trace-upstream-parameterized-required
                (source-contains? source "// @trace-upstream-parameterized\n")
              trace-upstream-parameterized-memo-required
                (source-contains? source "// @trace-upstream-parameterized-memo")
              trace-upstream-lr-spaces-required
                (source-contains? source "// @trace-upstream-lr-spaces")
              trace-upstream-case-insensitive-required
                (source-contains? source "// @trace-upstream-case-insensitive")
              trace-upstream-splice-required
                (source-contains? source "// @trace-upstream-splice")
              trace-upstream-bindings-required
                (source-contains? source "// @trace-upstream-bindings")
              trace-upstream-incremental-memo-required
                (source-contains? source "// @trace-upstream-incremental-memo")
              to-ast-upstream-arithmetic-required
                (source-contains? source "// @to-ast-upstream-arithmetic")
              to-ast-upstream-combinations-required
                (source-contains? source "// @to-ast-upstream-combinations")
              to-ast-upstream-list-required
                (source-contains? source "// @to-ast-upstream-list")
              to-ast-upstream-optional-required
                (source-contains? source "// @to-ast-upstream-optional")
              to-ast-upstream-failure-required
                (source-contains? source "// @to-ast-upstream-failure")
              pexpr-upstream-source-required
                (source-contains? source "// @pexpr-upstream-source")
              pexpr-upstream-display-required
                (source-contains? source "// @pexpr-upstream-display")
              pexpr-upstream-string-required
                (source-contains? source "// @pexpr-upstream-string")
              pexpr-upstream-argument-names-required
                (source-contains? source "// @pexpr-upstream-argument-names")
              pexpr-upstream-definition-source-required
                (source-contains? source "// @pexpr-upstream-definition-source")
              incremental-reuse-required
                (source-contains? source "// @incremental-reuse")
              incremental-memo-no-lr-required
                (source-contains? source "// @incremental-memo-no-lr")
              incremental-memo-nonmonotonic-required
                (source-contains? source "// @incremental-memo-nonmonotonic")
              incremental-memo-simple-lr-required
                (source-contains? source "// @incremental-memo-simple-lr")
              incremental-memo-complicated-lr-required
                (source-contains? source "// @incremental-memo-complicated-lr")
              incremental-match-length-required
                (source-contains? source "// @incremental-match-length")
              incremental-basic-required
                (source-contains? source "// @incremental-basic")
              incremental-trickier-required
                (source-contains? source "// @incremental-trickier")
              incremental-binding-lexical-required
                (source-contains? source "// @incremental-binding-lexical")
              incremental-binding-syntactic-required
                (source-contains? source "// @incremental-binding-syntactic")
              incremental-attribute-required
                (source-contains? source "// @incremental-attribute")
              indentation-sensitive
                (str/str-eq (load supergrammar-name) "IndentationSensitive")
              indentation-incremental-rejection
                (source-contains? source "// @indentation-incremental-rejection")
              indentation-dedent-regression-required
                (source-contains? source "// @indentation-dedent-regression")
              target-context context
              standalone-built-in-required
                (not (str/str-eq (load effective-grammar-name) "BuiltInRules"))
              generated-built-in-is-canonical
                (or standalone-built-in-required canonical-built-in)
              standalone-built-in-forms
                (if standalone-built-in-required
                    (compile-standalone-built-in-forms target-context)
                    `())
              _ (set-current-grammar-source! source)
              _ (set-current-grammar-name! (load effective-grammar-name))
              standalone-built-in-object-name
                (reader-find-definition-name
                  standalone-built-in-forms
                  "grammar-object"
                  (reader-prefixed-name target-context "missing-grammar-object"))
              (mut forms) (primitive/code-list-new)]
          (let [(mut rule-index) 0]
            (loop (if (>= (load rule-index) (len rules))
                      (break)
                      (do
                        (let [rule (get rules (load rule-index))]
                          (if (tag? rule "bound-rule")
                              (let [target (get rules (primitive/code-int (get rule 2)))]
                                (validate-alternation-arities (primitive/code-str (get target 1))
                                                              (get target 3)
                                                              (if (> (len target) 5)
                                                                  (get target 5)
                                                                  `())))
                              (validate-alternation-arities (primitive/code-str (get rule 1))
                                                            (get rule 3)
                                                            (if (> (len rule) 5)
                                                                (get rule 5)
                                                                `())))
                          (if (or (tag? rule "bound-rule")
                                  (= (len (get rule 2)) 0))
                              (let [emitted
                                        (let [recursive
                                              (if (tag? rule "bound-rule")
                                                  (rule-recursive?
                                                    (primitive/code-int (get rule 2))
                                                    rules
                                                    rule-metas)
                                                  (rule-recursive? (load rule-index)
                                                                   rules
                                                                   rule-metas))
                                            memoized
                                              (if indentation-sensitive
                                                  false
                                                  (or recursive
                                                      (not (rule-reaches-recursive-rule?
                                                             (load rule-index)
                                                             rules
                                                             rule-metas))))]
                                        (emit-rule rule
                                                   rules
                                                   rule-metas
                                                   cases
                                                   (load (field reader expression-spans))
                                                   (load rule-index)
                                                   memoized
                                                   recursive
                                                   target-context))]
                                (for form
                                  (iter emitted)
                                  (push! (mut forms) form)))
                              (let [(mut dynamic-name-builder) (str/sb-new (malloc-allocator))
                                    (mut runtime-actuals) (primitive/code-list-new)]
                                (str/sb-push-str! (mut dynamic-name-builder) "__ohm_dynamic_")
                                (str/sb-push-str! (mut dynamic-name-builder)
                                                  (primitive/code-str (get rule 1)))
                                (for [formal-index 0 (len (get rule 2))]
                                  (push! (mut runtime-actuals) `(runtime-arg ~formal-index)))
                                (let [dynamic-name (str/sb-finish! (mut dynamic-name-builder))
                                      dynamic-symbol (primitive/code-symbol dynamic-name)
                                      dynamic-rule
                                        `(bound-rule ~dynamic-symbol
                                                     ~(load rule-index)
                                                     (~@(primitive/code-list-done (load runtime-actuals))))
                                      recursive (rule-recursive? (load rule-index) rules rule-metas)
                                      emitted
                                        (emit-rule dynamic-rule
                                                   rules
                                                   rule-metas
                                                   cases
                                                   (load (field reader expression-spans))
                                                   (load rule-index)
                                                   recursive
                                                   recursive
                                                   target-context)]
                                  (for form
                                    (iter emitted)
                                    (push! (mut forms) form))))))
                        (store! rule-index (+ (load rule-index) 1))))))
          (let [finished-forms (primitive/code-list-done (load forms))
                start-rule-text (load effective-default)
                grammar-fingerprint-text
                  (normalized-grammar-fingerprint
                    (load effective-grammar-name)
                    start-rule-text
                    (load grammar-names)
                    rules
                    (load rule-metas))
                start-rule
                  (primitive/datum->syntax target-context
                                           (primitive/code-symbol (if (> (len rules) 0)
                                                                      start-rule-text
                                                                      "__ohm_no_default_start_rule")))
                parse-tree-name (primitive/datum->syntax target-context (primitive/code-symbol "parse-tree"))
                parse-tree-from-name (primitive/datum->syntax target-context (primitive/code-symbol "parse-tree-from"))
                parse-tree-from-internal-name
                  (primitive/datum->syntax target-context
                                           (primitive/code-symbol "__ohm_parse_tree_from"))
                parse-tree-from-cached-name
                  (primitive/datum->syntax target-context
                                           (primitive/code-symbol "__ohm_parse_tree_from_cached"))
                parse-cache (primitive/fresh-identifier "parse-cache")
                cached-trace-enabled (primitive/fresh-identifier "cached-trace-enabled")
                internal-result (primitive/fresh-identifier "internal-result")
                finished-result (primitive/fresh-identifier "finished-result")
                trace-name (primitive/datum->syntax target-context (primitive/code-symbol "trace"))
                trace-from-name (primitive/datum->syntax target-context (primitive/code-symbol "trace-from"))
                trace-enabled (primitive/fresh-identifier "trace-enabled")
                parse-name (primitive/datum->syntax target-context (primitive/code-symbol "parse"))
                parse-from-name (primitive/datum->syntax target-context (primitive/code-symbol "parse-from"))
                to-ast-name (primitive/datum->syntax target-context (primitive/code-symbol "to-ast"))
                to-ast-from-name
                  (primitive/datum->syntax target-context (primitive/code-symbol "to-ast-from"))
                semantics-for-to-ast-name
                  (primitive/datum->syntax target-context
                                           (primitive/code-symbol "semantics-for-to-ast"))
                to-recipe-name
                  (primitive/datum->syntax target-context (primitive/code-symbol "to-recipe"))
                direct-recipe
                  (if include-recipe
                      (load effective-recipe)
                      "")
                matcher-name (primitive/datum->syntax target-context (primitive/code-symbol "matcher"))
                grammar-token-name (primitive/datum->syntax target-context (primitive/code-symbol "grammar-token"))
                grammar-descriptor-name
                  (primitive/datum->syntax target-context (primitive/code-symbol "grammar"))
                grammar-pexprs-name
                  (primitive/datum->syntax target-context (primitive/code-symbol "grammar-pexprs"))
                grammar-object-name
                  (primitive/datum->syntax target-context (primitive/code-symbol "grammar-object"))
                proto-built-in-token-name
                  (primitive/datum->syntax target-context
                                           (primitive/code-symbol "__ohm_proto_builtin_token"))
                proto-built-in-object-name
                  (primitive/datum->syntax target-context
                                           (primitive/code-symbol "proto-built-in-grammar-object"))
                built-in-token-name
                  (primitive/datum->syntax target-context
                                           (primitive/code-symbol "__ohm_builtin_token"))
                built-in-object-name
                  (primitive/datum->syntax target-context
                                           (primitive/code-symbol "built-in-grammar-object"))
                indentation-token-name
                  (primitive/datum->syntax target-context
                                           (primitive/code-symbol "__ohm_indentation_token"))
                indentation-object-name
                  (primitive/datum->syntax
                    target-context
                    (primitive/code-symbol
                      "experimental-indentation-sensitive-grammar-object"))
                action-template-name
                  (primitive/datum->syntax target-context
                                           (primitive/code-symbol "action-dictionary-template"))
                action-template-text
                  (build-action-dictionary-template rules
                                                    cases
                                                    (load (field reader template-priority))
                                                    indentation-sensitive)
                action-template-expected (read-action-template-expectation source)
                _
                  (if (and (> (slice-len action-template-expected) 0)
                           (not (str/str-eq action-template-text
                                            action-template-expected)))
                      (primitive/error action-template-text)
                      0)
                test-body
                  (let [(mut body) `0
                        (mut test-index) (- (len test-cases) 1)]
                    (loop (if (< (load test-index) 0)
                              (break)
                              (let [case (get test-cases (load test-index))
                                    expected (.expected case)
                                    test-input (.input case)
                                    required-rule (.required-rule case)
                                    case-start-rule (.start-rule case)
                                    parse-call
                                      (if (> (slice-len case-start-rule) 0)
                                          `(~parse-from-name ~test-input ~case-start-rule)
                                          `(~parse-name ~test-input))
                                    check-iteration (.check-iteration case)
                                    check-failure (.check-failure case)
                                    failure-short-message
                                      (if check-failure
                                          (fixture-short-message (.failure-position case)
                                                                 (.failure-text case))
                                          "")
                                    rest (load body)
                                    failure (+ (load test-index) 1)]
                                (if expected
                                    (if check-iteration
                                        (set! body
                                              `(let [(mut result) (~parse-tree-name ~test-input)
                                                     ok
                                                       (and (experiments.ohm.runtime.match-succeeded? (load result))
                                                            (experiments.ohm.runtime.match-root-iteration-shape? (load result)
                                                                                                                 ~(.iteration-columns case)
                                                                                                                 ~(.iteration-rows case)
                                                                                                                 ~(.iteration-optional case)))]
                                                 (experiments.ohm.runtime.free-match! (mut result))
                                                 (if ok ~rest ~failure)))
                                        (if (> (slice-len required-rule) 0)
                                            (set! body
                                                  `(let [(mut result) (~parse-tree-name ~test-input)
                                                         ok
                                                           (and (experiments.ohm.runtime.match-succeeded? (load result))
                                                                (experiments.ohm.runtime.match-has-rule? (load result)
                                                                                                         ~required-rule))]
                                                     (experiments.ohm.runtime.free-match! (mut result))
                                                     (if ok ~rest ~failure)))
                                            (set! body
                                                  `(if ~parse-call
                                                       ~rest
                                                       ~failure))))
                                    (if check-failure
                                        (set! body
                                              `(let [(mut result) (~parse-tree-name ~test-input)
                                                     ok
                                                       (and (not (experiments.ohm.runtime.match-succeeded? (load result)))
                                                            (and (= (experiments.ohm.runtime.match-failure-position (load result))
                                                                    ~(.failure-position case))
                                                                 (and (coil.str.str-eq (experiments.ohm.runtime.match-expected-text (load result))
                                                                                       ~(.failure-text case))
                                                                      (and (= (experiments.ohm.runtime.match-failure-line (load result))
                                                                              1)
                                                                           (and (= (experiments.ohm.runtime.match-failure-column (load result))
                                                                                   (+ ~(.failure-position case) 1))
                                                                                (coil.str.str-eq (experiments.ohm.runtime.match-short-message (load result))
                                                                                                 ~failure-short-message))))))]
                                                 (if ok
                                                     (do
                                                       (experiments.ohm.runtime.free-match! (mut result))
                                                       ~rest)
                                                     (do
                                                       (experiments.ohm.runtime.report-fixture-mismatch (load result))
                                                       ~failure))))
                                        (set! body
                                              `(if ~parse-call
                                                   ~failure
                                                   ~rest))))
                                (set! test-index (- (load test-index) 1)))))
                    (load body))
                cst-test-body
                  (let [(mut body) `0
                        (mut test-index) (- (len test-cases) 1)]
                    (loop (if (< (load test-index) 0)
                              (break)
                              (let [case (get test-cases (load test-index))
                                    rest (load body)]
                                (if (.expected case)
                                    (let [case-start-rule (.start-rule case)
                                          test-input (.input case)
                                          parse-tree-call
                                            (if (> (slice-len case-start-rule) 0)
                                                `(~parse-tree-from-name ~test-input ~case-start-rule)
                                                `(~parse-tree-name ~test-input))]
                                      (set! body
                                            `(let [(mut result) ~parse-tree-call]
                                               (experiments.ohm.runtime.print-match-cst-signature
                                                 (load result))
                                               (experiments.ohm.runtime.free-match! (mut result))
                                               ~rest)))
                                    0)
                                (set! test-index (- (load test-index) 1)))))
                    (load body))
                trace-test-body
                  (let [(mut body) `0
                        (mut test-index) (- (len test-cases) 1)]
                    (loop (if (< (load test-index) 0)
                              (break)
                              (let [case (get test-cases (load test-index))
                                    rest (load body)]
                                (if (.expected case)
                                    (let [case-start-rule (.start-rule case)
                                          test-input (.input case)
                                          trace-call
                                            (if (> (slice-len case-start-rule) 0)
                                                `(~trace-from-name ~test-input ~case-start-rule)
                                                `(~trace-name ~test-input))]
                                      (set! body
                                            `(let [(mut result) ~trace-call]
                                               (experiments.ohm.runtime.print-match-trace-signature
                                                 (load result))
                                               (experiments.ohm.runtime.free-match! (mut result))
                                               ~rest)))
                                    0)
                                (set! test-index (- (load test-index) 1)))))
                    (load body))
                main-name (primitive/datum->syntax target-context (primitive/code-symbol "main"))
                input (primitive/fresh-identifier "input")
                state (primitive/fresh-identifier "state")
                match-start (primitive/fresh-identifier "match-start")
                end (primitive/fresh-identifier "end")
                final-end (primitive/fresh-identifier "final-end")
                parse-result (primitive/fresh-identifier "result")
                parse-ok (primitive/fresh-identifier "ok")
                requested-rule (primitive/fresh-identifier "requested-rule")
                trace-start-index (primitive/fresh-identifier "trace-start-index")
                traced-rule-end (primitive/fresh-identifier "traced-rule-end")
                trace-end-index (primitive/fresh-identifier "trace-end-index")
                traced-final-end (primitive/fresh-identifier "traced-final-end")
                start-expression-dispatch-name
                  (primitive/datum->syntax target-context
                                           (primitive/code-symbol "__ohm_start_expression_dispatch"))
                dispatch-state (primitive/fresh-identifier "dynamic-expression-state")
                dispatch-source (primitive/fresh-identifier "dynamic-expression-source")
                dispatch-at (primitive/fresh-identifier "dynamic-expression-position")
                dispatch-expression (primitive/fresh-identifier "dynamic-expression")
                dispatch-lexical (primitive/fresh-identifier "dynamic-expression-lexical")
                grammar-registration-body
                  (let [(mut registration) (primitive/code-list-new)]
                    (push! (mut registration) (primitive/code-symbol "do"))
                    (for registered-name
                      (iter (load grammar-names))
                      (push! (mut registration)
                             `(experiments.ohm.runtime.add-parse-grammar-name! (mut ~state)
                                                                               ~registered-name)))
                    (push! (mut registration)
                           `(experiments.ohm.runtime.set-parse-grammar-token! (mut ~state)
                                                                              (~grammar-token-name)))
                    (for builtin-name-code
                      (iter `("any" "end"
                                    "spaces"
                                    "space"
                                    "letter"
                                    "digit"
                                    "alnum"
                                    "hexDigit"
                                    "lower"
                                    "upper"
                                    "unicodeLtmo"
                                    "indent"
                                    "dedent"
                                    "caseInsensitive"
                                    "applySyntactic"
                                    "ListOf"
                                    "NonemptyListOf"
                                    "EmptyListOf"
                                    "listOf"
                                    "nonemptyListOf"
                                    "emptyListOf"))
                      (let [builtin-name (primitive/code-str builtin-name-code)
                            builtin-arity
                              (cond (or (str/str-eq builtin-name "EmptyListOf")
                                        (str/str-eq builtin-name "emptyListOf"))
                                      0
                                    (or (str/str-eq builtin-name "NonemptyListOf")
                                        (str/str-eq builtin-name "nonemptyListOf"))
                                      3
                                    :else 1)]
                        (if (or indentation-sensitive
                                (and (not (str/str-eq builtin-name "indent"))
                                     (not (str/str-eq builtin-name "dedent"))))
                            (push! (mut registration)
                                   `(experiments.ohm.runtime.add-semantic-rule! (mut ~state)
                                                                                ~builtin-name
                                                                                ~builtin-arity))
                            0)))
                    (for semantic-rule
                      (iter rules)
                      (if (not (tag? semantic-rule "bound-rule"))
                          (push! (mut registration)
                                 `(experiments.ohm.runtime.add-semantic-rule! (mut ~state)
                                                                              ~(primitive/code-str (get semantic-rule 1))
                                                                              ~(expression-arity (get semantic-rule 3))))
                          0))
                    (for semantic-case
                      (iter cases)
                      (let [case-data semantic-case
                            (mut case-name) (str/sb-new (malloc-allocator))]
                        (str/sb-push-str! (mut case-name) (.base case-data))
                        (str/sb-push-str! (mut case-name) "_")
                        (str/sb-push-str! (mut case-name) (.label case-data))
                        (push! (mut registration)
                               `(experiments.ohm.runtime.add-semantic-rule! (mut ~state)
                                                                            ~(str/sb-finish! (mut case-name))
                                                                            ~(.arity case-data)))))
                    (primitive/code-list-done (load registration)))
                start-expression-dispatch-body
                  (let [(mut expression-dispatch) `-1
                        (mut expression-rule-index) (- (len rules) 1)]
                    (loop (if (< (load expression-rule-index) 0)
                              (break)
                              (let [expression-rule (get rules (load expression-rule-index))]
                                (if (not (tag? expression-rule "bound-rule"))
                                    (let [expression-rule-name (primitive/code-str (get expression-rule 1))
                                          expression-rule-arity (len (get expression-rule 2))
                                          expression-rule-callee
                                            (primitive/datum->syntax target-context
                                                                     (primitive/code-symbol (if (= expression-rule-arity
                                                                                                   0)
                                                                                                expression-rule-name
                                                                                                (let [(mut name-builder)
                                                                                                        (str/sb-new (malloc-allocator))]
                                                                                                  (str/sb-push-str! (mut name-builder)
                                                                                                                    "__ohm_dynamic_")
                                                                                                  (str/sb-push-str! (mut name-builder)
                                                                                                                    expression-rule-name)
                                                                                                  (str/sb-finish! (mut name-builder))))))
                                          rest (load expression-dispatch)
                                          call
                                            (if (= expression-rule-arity 0)
                                                `(~expression-rule-callee (mut ~dispatch-state)
                                                    ~dispatch-source
                                                    (if ~dispatch-lexical
                                                        ~dispatch-at
                                                        (experiments.ohm.runtime.trace-skip-spaces! (mut ~dispatch-state)
                                                                                                    ~dispatch-source
                                                                                                    ~dispatch-at)))
                                                `(let [_
                                                         (experiments.ohm.runtime.push-start-argument-frame! (mut ~dispatch-state)
                                                                                                             ~dispatch-expression)
                                                       result
                                                         (~expression-rule-callee (mut ~dispatch-state)
                                                            ~dispatch-source
                                                            (if ~dispatch-lexical
                                                                ~dispatch-at
                                                                (experiments.ohm.runtime.trace-skip-spaces! (mut ~dispatch-state)
                                                                                                            ~dispatch-source
                                                                                                            ~dispatch-at)))]
                                                   (experiments.ohm.runtime.pop-start-argument-frame! (mut ~dispatch-state))
                                                   result))]
                                      (set! expression-dispatch
                                            `(if (and (= (experiments.ohm.runtime.start-expression-child-count ~dispatch-state
                                                                                                               ~dispatch-expression)
                                                         ~expression-rule-arity)
                                                      (coil.str.str-eq (experiments.ohm.runtime.start-expression-text ~dispatch-state
                                                                                                                      ~dispatch-expression)
                                                                       ~expression-rule-name))
                                                 ~call
                                                 ~rest)))
                                    0)
                                (set! expression-rule-index
                                      (- (load expression-rule-index) 1)))))
                    (load expression-dispatch))
                start-dispatch
                  (let [(mut dispatch)
                          (let [(mut built-in-dispatch)
                                  `(experiments.ohm.runtime.match-built-in-start! (mut ~state)
                                                                                  ~input
                                                                                  ~match-start
                                                                                  ~requested-rule)]
                            (for built-in-list-name
                              (iter `("ListOf" "NonemptyListOf"
                                               "EmptyListOf"
                                               "listOf"
                                               "nonemptyListOf"
                                               "emptyListOf"))
                              (let [name (primitive/code-str built-in-list-name)]
                                (if (< (find-rule-index rule-metas name) 0)
                                    (let [rest (load built-in-dispatch)
                                          body
                                            (emit-expr `(app ~built-in-list-name
                                                             ((runtime-arg 0) (runtime-arg 1)))
                                                       state
                                                       input
                                                       match-start
                                                       false
                                                       rules
                                                       rule-metas
                                                       `()
                                                       `()
                                                       ""
                                                       `()
                                                       `()
                                                       cases
                                                       (load (field reader expression-spans))
                                                       -1000000
                                                       target-context)]
                                      (set! built-in-dispatch
                                            `(if (experiments.ohm.runtime.prepare-start-application! (mut ~state)
                                                                                                     ~requested-rule
                                                                                                     ~name
                                                                                                     2)
                                                 ~body
                                                 ~rest)))
                                    0)))
                            (if (< (find-rule-index rule-metas "caseInsensitive") 0)
                                `(if (experiments.ohm.runtime.prepare-start-application! (mut ~state)
                                                                                         ~requested-rule
                                                                                         "caseInsensitive"
                                                                                         1)
                                     (experiments.ohm.runtime.match-start-case-insensitive-cst! (mut ~state)
                                                                                                ~input
                                                                                                ~match-start)
                                     ~(load built-in-dispatch))
                                (load built-in-dispatch)))
                        (mut dispatch-index) (- (len rules) 1)]
                    (loop (if (< (load dispatch-index) 0)
                              (break)
                              (let [dispatch-rule (get rules (load dispatch-index))]
                                (cond (tag? dispatch-rule "bound-rule")
                                        (let [dispatch-target (get rules (primitive/code-int (get dispatch-rule 2)))
                                              dispatch-name
                                                (application-display (primitive/code-str (get dispatch-target 1))
                                                                     (get dispatch-rule 3))
                                              dispatch-callee
                                                (primitive/datum->syntax target-context
                                                                         (primitive/code-symbol (primitive/code-str (get dispatch-rule
                                                                                                                         1))))
                                              rest (load dispatch)]
                                          (set! dispatch
                                                `(if (experiments.ohm.runtime.start-rule-eq? ~requested-rule
                                                                                             ~dispatch-name)
                                                     (~dispatch-callee (mut ~state) ~input ~match-start)
                                                     ~rest)))
                                      (= (len (get dispatch-rule 2)) 0)
                                        (let [dispatch-name (primitive/code-str (get dispatch-rule 1))
                                              dispatch-callee
                                                (primitive/datum->syntax target-context
                                                                         (primitive/code-symbol dispatch-name))
                                              rest (load dispatch)]
                                          (set! dispatch
                                                `(if (experiments.ohm.runtime.start-rule-eq? ~requested-rule
                                                                                             ~dispatch-name)
                                                     (~dispatch-callee (mut ~state) ~input ~match-start)
                                                     ~rest)))
                                      :else
                                        (let [dispatch-name (primitive/code-str (get dispatch-rule 1))
                                              dispatch-meta (get rule-metas (load dispatch-index))
                                              (mut dynamic-name-builder) (str/sb-new (malloc-allocator))
                                              rest (load dispatch)]
                                          (str/sb-push-str! (mut dynamic-name-builder) "__ohm_dynamic_")
                                          (str/sb-push-str! (mut dynamic-name-builder) dispatch-name)
                                          (let [dynamic-callee
                                                  (primitive/datum->syntax target-context
                                                                           (primitive/code-symbol (str/sb-finish! (mut dynamic-name-builder))))]
                                            (set! dispatch
                                                  `(if (experiments.ohm.runtime.start-rule-eq? ~requested-rule
                                                                                               ~dispatch-name)
                                                       (experiments.ohm.runtime.wrong-start-parameter-count ~dispatch-name
                                                                                                            ~(len (get dispatch-rule
                                                                                                                       2))
                                                                                                            0
                                                                                                            ~source
                                                                                                            ~(.diagnostic-source-start
                                                                                                               dispatch-meta)
                                                                                                            ~(.diagnostic-source-end
                                                                                                               dispatch-meta))
                                                       (if (experiments.ohm.runtime.prepare-start-application! (mut ~state)
                                                                                                               ~requested-rule
                                                                                                               ~dispatch-name
                                                                                                               ~(len (get dispatch-rule
                                                                                                                          2)))
                                                           (~dynamic-callee (mut ~state) ~input ~match-start)
                                                           (let [actual-parameter-count
                                                                   (experiments.ohm.runtime.start-application-argument-count
                                                                     ~requested-rule
                                                                     ~dispatch-name)]
                                                             (if (>= actual-parameter-count 0)
                                                                 (experiments.ohm.runtime.wrong-start-parameter-count
                                                                   ~dispatch-name
                                                                   ~(len (get dispatch-rule 2))
                                                                   actual-parameter-count
                                                                   ~source
                                                                   ~(.diagnostic-source-start dispatch-meta)
                                                                   ~(.diagnostic-source-end dispatch-meta))
                                                                 ~rest))))))))
                                (set! dispatch-index (- (load dispatch-index) 1)))))
                    (load dispatch))
                parse-tree-from-internal-body
                  `(let [(mut ~state)
                           (experiments.ohm.runtime.new-parse-state-from-cache! (mut ~parse-cache))
                         _
                           (if ~indentation-sensitive
                               (experiments.ohm.runtime.enable-indentation-sensitive!
                                 (mut ~state)
                                 ~input)
                               0)
                         _ (if ~trace-enabled
                               (experiments.ohm.runtime.enable-tracing! (mut ~state))
                               0)
                         _ ~grammar-registration-body
                         _
                           (experiments.ohm.runtime.set-start-expression-dispatcher! (mut ~state)
                                                                                     (fnptr-of ~start-expression-dispatch-name))
                         ~match-start
                           (if (experiments.ohm.runtime.start-application-syntactic? ~requested-rule)
                               (experiments.ohm.runtime.trace-skip-spaces! (mut ~state) ~input 0)
                               0)
                         ~trace-start-index
                           (experiments.ohm.runtime.trace-enter! (mut ~state)
                                                                  ~requested-rule
                                                                  ~match-start)
                         _
                           (experiments.ohm.runtime.trace-set-memoized!
                             (mut ~state)
                             ~trace-start-index)
                         ~traced-rule-end ~start-dispatch
                         ~end
                           (experiments.ohm.runtime.trace-exit! (mut ~state)
                                                                ~trace-start-index
                                                                ~traced-rule-end)
                         ~final-end
                           (if (>= ~end 0)
                               (let [after-spaces
                                       (if (experiments.ohm.runtime.start-application-syntactic? ~requested-rule)
                                           (experiments.ohm.runtime.trace-skip-spaces! (mut ~state) ~input ~end)
                                           ~end)
                                      ~trace-end-index
                                        (experiments.ohm.runtime.trace-enter! (mut ~state)
                                                                               "end"
                                                                               after-spaces)
                                      ~traced-final-end
                                        (if (and (= after-spaces (experiments.ohm.runtime.source-length ~input))
                                                 (experiments.ohm.runtime.input-visible-at?
                                                   ~state
                                                   after-spaces))
                                            (if (experiments.ohm.runtime.start-application-syntactic?
                                                  ~requested-rule)
                                                (experiments.ohm.runtime.extend-root-end!
                                                  (mut ~state)
                                                  after-spaces)
                                                ~end)
                                            (do
                                              (experiments.ohm.runtime.expect-end! (mut ~state)
                                                                                   after-spaces)
                                              -1))]
                                  (experiments.ohm.runtime.trace-exit! (mut ~state)
                                                                       ~trace-end-index
                                                                       ~traced-final-end))
                               -1)]
                     (let [(mut ~finished-result)
                             (experiments.ohm.runtime.finish-match-cached! (mut ~state)
                                                                           ~input
                                                                           ~final-end
                                                                           (mut ~parse-cache))]
                       (experiments.ohm.runtime.attach-synthetic-trace-end-binding!
                         (mut ~finished-result))
                       (load ~finished-result)))
                parse-tree-from-body
                  `(let [(mut ~parse-cache)
                           (experiments.ohm.runtime.new-parse-cache (coil.alloc.malloc-allocator))
                         (mut ~internal-result)
                           (~parse-tree-from-internal-name ~input
                                                          ~requested-rule
                                                          false
                                                          (mut ~parse-cache))
                         public-result-grammar (~grammar-object-name)]
                     (experiments.ohm.runtime.free-parse-cache! (mut ~parse-cache))
                     (experiments.ohm.runtime.attach-new-owned-match-matcher!
                       (mut ~internal-result)
                       public-result-grammar
                       ~input)
                     (load ~internal-result))
                parse-tree-body
                  (if (> (slice-len start-rule-text) 0)
                      `(~parse-tree-from-name ~input ~start-rule-text)
                      `(do
                         (experiments.ohm.runtime.missing-start-rule)
                         (~parse-tree-from-name ~input ~start-rule-text)))
                trace-from-body
                  `(let [(mut ~parse-cache)
                           (experiments.ohm.runtime.new-parse-cache (coil.alloc.malloc-allocator))
                         (mut ~internal-result)
                           (~parse-tree-from-internal-name ~input
                                                          ~requested-rule
                                                          true
                                                          (mut ~parse-cache))]
                     (experiments.ohm.runtime.free-parse-cache! (mut ~parse-cache))
                     (load ~internal-result))
                parse-tree-from-cached-body
                  `(~parse-tree-from-internal-name ~input
                                                   ~requested-rule
                                                   ~cached-trace-enabled
                                                   (mut ~parse-cache))
                trace-body
                  (if (> (slice-len start-rule-text) 0)
                      `(~trace-from-name ~input ~start-rule-text)
                      `(do
                         (experiments.ohm.runtime.missing-start-rule)
                         (~trace-from-name ~input ~start-rule-text)))
                parse-from-body
                  `(let [(mut ~parse-result) (~parse-tree-from-name ~input ~requested-rule)
                         root (experiments.ohm.runtime.match-root (load ~parse-result))
                         ~parse-ok
                           (and (experiments.ohm.runtime.match-succeeded? (load ~parse-result))
                                (and (coil.str.str-eq (experiments.ohm.runtime.match-grammar-name (load ~parse-result))
                                                      ~(load effective-grammar-name))
                                     (and (= (cast i64
                                                             (experiments.ohm.runtime.match-grammar-token (load ~parse-result)))
                                             (cast i64 (~grammar-token-name)))
                                          (>= root 0))))]
                     (experiments.ohm.runtime.free-match! (mut ~parse-result))
                     ~parse-ok)
                parse-body
                  (if (> (slice-len start-rule-text) 0)
                      `(~parse-from-name ~input ~start-rule-text)
                      `(do
                         (experiments.ohm.runtime.missing-start-rule)
                         (~parse-from-name ~input ~start-rule-text)))
                to-ast-from-body
                  `(let [(mut ast-match) (~parse-tree-from-name ~input ~requested-rule)
                         (mut ast-mapping)
                           (experiments.ohm.runtime.new-ohm-ast-mapping
                             (coil.alloc.malloc-allocator))
                         (mut ast-result)
                           (experiments.ohm.runtime.to-ast
                             (mut ast-match)
                             (mut ast-mapping)
                             (coil.alloc.malloc-allocator))]
                     (experiments.ohm.runtime.free-match! (mut ast-match))
                     (experiments.ohm.runtime.free-ohm-ast-mapping! (mut ast-mapping))
                     (load ast-result))
                to-ast-body
                  (if (> (slice-len start-rule-text) 0)
                      `(~to-ast-from-name ~input ~start-rule-text)
                      `(do
                         (experiments.ohm.runtime.missing-start-rule)
                         (~to-ast-from-name ~input ~start-rule-text)))
                main-body-core
                  (if (load (trace-differential-mode-cell))
                      trace-test-body
                      (if (load (cst-differential-mode-cell))
                          cst-test-body
                      (if (> (len test-cases) 0)
                      test-body
                      (if (source-contains? source "// @expect-matcher-missing-start-rule")
                          `(let [(mut empty-matcher) (~matcher-name)
                                 (mut impossible-result)
                                   (experiments.ohm.runtime.matcher-match (mut empty-matcher))]
                             (experiments.ohm.runtime.free-match! (mut impossible-result))
                             (experiments.ohm.runtime.free-ohm-matcher! (mut empty-matcher))
                             0)
                          (if (source-contains? source "// @expect-param-to-failure")
                              `(let [(mut pexpr-grammar) (~grammar-pexprs-name)
                                     param-rule
                                       (experiments.ohm.pexprs.pexpr-find-rule
                                         (mut pexpr-grammar)
                                         "Foo")
                                     param-node
                                       (experiments.ohm.runtime.ohm-pexpr-rule-body
                                         (mut pexpr-grammar)
                                         param-rule)]
                                 (experiments.ohm.runtime.ohm-pexpr-param-to-failure
                                   (mut pexpr-grammar)
                                   param-node)
                                 (experiments.ohm.runtime.free-ohm-pexpr-grammar!
                                   (mut pexpr-grammar))
                                 0)
                          (if (source-contains? source "// @expect-missing-start-rule")
                          `(do (~parse-name "") 0)
                          (if (str/str-eq (load effective-grammar-name) "Ohm")
                          `(let [(mut result) (~parse-tree-name ~source)
                                 root (experiments.ohm.runtime.match-root (load result))
                                 ok
                                   (and (experiments.ohm.runtime.match-succeeded? (load result))
                                        (and (>= root 0)
                                             (coil.str.str-eq (experiments.ohm.runtime.node-rule (load result) root)
                                                              ~start-rule-text)))]
                             (experiments.ohm.runtime.free-match! (mut result))
                             (if ok 0 1))
                          `0)))))))
                matcher-smoke-case
                  (if (> (len test-cases) 0)
                      (get test-cases 0)
                      (primitive/zeroed OhmTestCase))
                matcher-smoke-input (if (> (len test-cases) 0) (.input matcher-smoke-case) "")
                matcher-smoke-start-rule
                  (if (> (slice-len (.start-rule matcher-smoke-case)) 0)
                      (.start-rule matcher-smoke-case)
                      (if (> (slice-len start-rule-text) 0) start-rule-text "end"))
                generated-matcher-id (primitive/fresh-identifier "generated-matcher")
                generated-repeat-id (primitive/fresh-identifier "generated-repeat-match")
                generated-public-supergrammar-id
                  (primitive/fresh-identifier "generated-public-supergrammar")
                generated-built-in-grammar-id
                  (primitive/fresh-identifier "generated-built-in-grammar")
                incremental-action-name
                  (primitive/datum->syntax target-context
                                           (primitive/code-symbol
                                             "__OhmIncrementalArithmeticAttribute"))
                incremental-number-rule-id (find-rule-index rule-metas "number")
                incremental-edit-check
                  (if incremental-reuse-required
                      `(let [reuse-before
                               (experiments.ohm.runtime.matcher-incremental-reuse-count
                                 ~generated-matcher-id)
                             old-node-id
                               (experiments.ohm.runtime.match-rule-id-at
                                 (load ~generated-repeat-id)
                                 "char"
                                 0)
                             edited
                               (experiments.ohm.runtime.matcher-replace-input-range!
                                 (mut ~generated-matcher-id)
                                 0
                                 0
                                 "x")
                             (mut edited-result)
                               (experiments.ohm.runtime.matcher-match-from
                                 (mut ~generated-matcher-id)
                                 ~matcher-smoke-start-rule)
                             reused
                               (> (experiments.ohm.runtime.matcher-incremental-reuse-count
                                    ~generated-matcher-id)
                                  reuse-before)
                             new-node-id
                               (experiments.ohm.runtime.match-rule-id-at
                                 (load edited-result)
                                 "char"
                                 1)
                             suffix-valid
                               (and edited
                                    (and reused
                                         (and (> old-node-id 0)
                                              (= old-node-id new-node-id))))
                             reset
                               (experiments.ohm.runtime.matcher-set-input!
                                 (mut ~generated-matcher-id)
                                 "ab")
                             (mut prefix-baseline)
                               (experiments.ohm.runtime.matcher-match-from
                                 (mut ~generated-matcher-id)
                                 ~matcher-smoke-start-rule)
                             prefix-old-id
                               (experiments.ohm.runtime.match-rule-id-at
                                 (load prefix-baseline)
                                 "char"
                                 0)
                             prefix-reuse-before
                               (experiments.ohm.runtime.matcher-incremental-reuse-count
                                 ~generated-matcher-id)
                             prefix-edited
                               (experiments.ohm.runtime.matcher-replace-input-range!
                                 (mut ~generated-matcher-id)
                                 1
                                 2
                                 "c")
                             (mut prefix-result)
                               (experiments.ohm.runtime.matcher-match-from
                                 (mut ~generated-matcher-id)
                                 ~matcher-smoke-start-rule)
                             prefix-new-id
                               (experiments.ohm.runtime.match-rule-id-at
                                 (load prefix-result)
                                 "char"
                                 0)
                             prefix-valid
                               (and reset
                                    (and prefix-edited
                                         (and (experiments.ohm.runtime.match-succeeded?
                                                (load prefix-result))
                                              (and (= prefix-old-id prefix-new-id)
                                                   (> (experiments.ohm.runtime.matcher-incremental-reuse-count
                                                        ~generated-matcher-id)
                                                      prefix-reuse-before)))))]
                         (experiments.ohm.runtime.free-match! (mut edited-result))
                         (experiments.ohm.runtime.free-match! (mut prefix-baseline))
                         (experiments.ohm.runtime.free-match! (mut prefix-result))
                         (and suffix-valid prefix-valid))
                      `true)
                incremental-memo-check
                  (if incremental-memo-no-lr-required
                      (let [start-id (find-rule-index rule-metas "start")
                            not-last-id (find-rule-index rule-metas "notLastLetter")]
                        `(let [start-entry
                                 (experiments.ohm.runtime.matcher-memo-find
                                   ~generated-matcher-id ~start-id 0)
                               first-entry
                                 (experiments.ohm.runtime.matcher-memo-find
                                   ~generated-matcher-id ~not-last-id 0)
