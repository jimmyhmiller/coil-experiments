(module experiments.ohm.recover-source-order)

(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "coil.primitive" :as primitive)
(import "coil.slice" :use [slice-get slice-len])
(import "experiments.ohm.runtime" :as ohm)

(defstruct RecoveredSourceOrder
  [(nodes (al/ArrayList i64))
   (allocator (dyn alloc/Allocator))])

(defn source-order-iteration-sibling? [(result ohm/MatchResult)
                                      (reference i64)
                                      (candidate i64)] (-> bool)
  (and (ohm/node-iteration? result candidate)
       (and (= (ohm/node-start result candidate)
               (ohm/node-start result reference))
            (and (= (ohm/node-end result candidate)
                    (ohm/node-end result reference))
                 (= (ohm/node-child-count result candidate)
                    (ohm/node-child-count result reference))))))

(defn recover-source-order-into! [(result ohm/MatchResult)
                                 (nodes (slice i64))
                                 (output (mut (al/ArrayList i64)))] (-> i64)
  (let [(mut index) 0]
    (loop (if (>= (load index) (slice-len nodes))
              (break)
              (let [node (slice-get nodes (load index))]
                (if (not (ohm/node-iteration? result node))
                    (do
                      (push! (mut output) node)
                      (set! index (+ (load index) 1)))
                    (let [(mut group-end) (+ (load index) 1)]
                      (loop (if (and (< (load group-end) (slice-len nodes))
                                     (source-order-iteration-sibling?
                                       result
                                       node
                                       (slice-get nodes (load group-end))))
                                (set! group-end (+ (load group-end) 1))
                                (break)))
                      (let [(mut cousins)
                              (al/al-new [i64] (alloc/malloc-allocator))
                            rows (ohm/node-child-count result node)]
                        (for [row 0 rows]
                          (for [sibling-index (load index) (load group-end)]
                            (push! (mut cousins)
                                   (ohm/node-child
                                     result
                                     (slice-get nodes sibling-index)
                                     row))))
                        (recover-source-order-into!
                          result
                          (al/al-slice [i64] (load cousins))
                          (mut output))
                        (al/al-free! (mut cousins)))
                      (set! index (load group-end)))))))
    0))

(defn recover-source-order [(result ohm/MatchResult)
                            (nodes (slice i64))
                            (a (dyn alloc/Allocator))]
                           (-> RecoveredSourceOrder)
  (let [(mut recovered) (primitive/zeroed RecoveredSourceOrder)]
    (set! (.nodes recovered) (al/al-new [i64] a))
    (set! (.allocator recovered) a)
    (recover-source-order-into! result nodes (mut (.nodes recovered)))
    (load recovered)))

(defn recovered-source-order-count [(recovered (ptr RecoveredSourceOrder))]
                                   (-> i64)
  (len (.nodes recovered)))

(defn recovered-source-order-node [(recovered (ptr RecoveredSourceOrder))
                                   (index i64)] (-> i64)
  (get (.nodes recovered) index))

(defn free-recovered-source-order! [(recovered (mut RecoveredSourceOrder))]
                                   (-> i64)
  (al/al-free! (mut (.nodes recovered)))
  0)
