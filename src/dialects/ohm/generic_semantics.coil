(module experiments.ohm.generic-semantics)

(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "coil.primitive" :as primitive)
(import "coil.slice" :use [slice-len])
(import "coil.str" :as str)
(import "experiments.ohm.runtime" :as ohm)

;;; A function-pointer action table avoids the compiler's currently broken
;;; associated-result and forwarded-trait-bound paths while retaining a fully
;;; typed result. Callbacks can recursively request children through the
;;; evaluation passed to `apply`, so traversal remains lazy and action-directed.
(defstruct OhmGenericSemanticEvaluation [Value]
  [(context (ptr u8))
   (action-kind
     (fnptr c [(ptr u8) (ptr ohm/MatchResult) i64] i64))
   (apply
     (fnptr c
       [(ptr u8)
        (mut (OhmGenericSemanticEvaluation Value))
        i64
        i64
        (slice i64)]
       Value))
   (result (ptr ohm/MatchResult))
   (values (al/ArrayList Value))
   (states (al/ArrayList u8))
   (grammar-name (slice u8))
   (grammar-token (ptr u8))
   (formal-count i64)
   (attribute bool)
   (failed bool)
   (error-kind i64)
   (error-node i64)])

(defn new-generic-semantic-evaluation
  [Value]
  [(context (ptr u8))
   (action-kind (fnptr c [(ptr u8) (ptr ohm/MatchResult) i64] i64))
   (apply
     (fnptr c
       [(ptr u8)
        (mut (OhmGenericSemanticEvaluation Value))
        i64
        i64
        (slice i64)]
       Value))
   (result (ptr ohm/MatchResult))
   (grammar-name (slice u8))
   (grammar-token (ptr u8))
   (formal-count i64)
   (attribute bool)]
  (-> (OhmGenericSemanticEvaluation Value))
  (let [(mut evaluation) (primitive/zeroed (OhmGenericSemanticEvaluation Value))]
    (set! (.context evaluation) context)
    (set! (.action-kind evaluation) action-kind)
    (set! (.apply evaluation) apply)
    (set! (.result evaluation) result)
    (set! (.grammar-name evaluation) grammar-name)
    (set! (.grammar-token evaluation) grammar-token)
    (set! (.formal-count evaluation) formal-count)
    (set! (.attribute evaluation) attribute)
    (set! (.values evaluation) (al/al-new [Value] (.allocator result)))
    (set! (.states evaluation) (al/al-new [u8] (.allocator result)))
    (for [_ 0 (len (.nodes result))]
      (push! (mut (.values evaluation)) (primitive/zeroed Value))
      (push! (mut (.states evaluation)) (primitive/cast u8 0)))
    (set! (.failed evaluation)
          (or (not (.succeeded result))
              (not (and (str/str-eq (.grammar-name result) grammar-name)
                        (= (.grammar-token result) grammar-token)))))
    (set! (.error-kind evaluation) (if (.failed evaluation) 5 0))
    (set! (.error-node evaluation) -1)
    (load evaluation)))

(defn fail-generic-semantic-evaluation!
  [Value]
  [(evaluation (mut (OhmGenericSemanticEvaluation Value)))
   (kind i64)
   (node i64)] (-> Value)
  (set! (.failed evaluation) true)
  (set! (.error-kind evaluation) kind)
  (set! (.error-node evaluation) node)
  (primitive/zeroed Value))

(defn evaluate-generic-semantic-node!
  [Value]
  [(evaluation (mut (OhmGenericSemanticEvaluation Value)))
   (node i64)
   (arguments (slice i64))] (-> Value)
  (if (.failed evaluation)
      (primitive/zeroed Value)
      (let [result (.result evaluation)]
        (if (or (< node 0) (>= node (len (.nodes result))))
            (fail-generic-semantic-evaluation! [Value] (mut evaluation) 4 node)
            (if (!= (slice-len arguments) (.formal-count evaluation))
                (fail-generic-semantic-evaluation! [Value] (mut evaluation) 1 node)
                (let [state (primitive/cast i64 (get (.states evaluation) node))]
                  (if (and (.attribute evaluation) (= state 2))
                      (get (.values evaluation) node)
                      (if (and (.attribute evaluation) (= state 1))
                          (fail-generic-semantic-evaluation! [Value]
                                                             (mut evaluation)
                                                             3
                                                             node)
                          (do
                            (if (.attribute evaluation)
                                (set! (mut (.states evaluation))
                                      node
                                      (primitive/cast u8 1))
                                0)
                            (let [kind
                                    (primitive/call-ptr
                                      (.action-kind evaluation)
                                      (.context evaluation)
                                      result
                                      node)
                                  value
                                    (if (> kind 0)
                                        (primitive/call-ptr
                                          (.apply evaluation)
                                          (.context evaluation)
                                          (mut evaluation)
                                          node
                                          kind
                                          arguments)
                                        (if (and (not (ohm/node-iteration?
                                                        (load result)
                                                        node))
                                                 (= (ohm/node-child-count
                                                      (load result)
                                                      node)
                                                    1))
                                            (evaluate-generic-semantic-node!
                                              [Value]
                                              (mut evaluation)
                                              (ohm/node-child (load result) node 0)
                                              arguments)
                                            (fail-generic-semantic-evaluation!
                                              [Value]
                                              (mut evaluation)
                                              2
                                              node)))]
                              (if (or (.failed evaluation)
                                      (not (.attribute evaluation)))
                                  0
                                  (do
                                    (set! (mut (.values evaluation)) node value)
                                    (set! (mut (.states evaluation))
                                          node
                                          (primitive/cast u8 2))))
                              value))))))))))

(defn evaluate-generic-semantic-child!
  [Value]
  [(evaluation (mut (OhmGenericSemanticEvaluation Value)))
   (node i64)
   (child-index i64)
   (arguments (slice i64))] (-> Value)
  (evaluate-generic-semantic-node!
    [Value]
    (mut evaluation)
    (ohm/node-child (load (.result evaluation)) node child-index)
    arguments))

(defn evaluate-generic-semantic-root!
  [Value]
  [(evaluation (mut (OhmGenericSemanticEvaluation Value)))
   (arguments (slice i64))] (-> Value)
  (evaluate-generic-semantic-node!
    [Value]
    (mut evaluation)
    (ohm/match-root (load (.result evaluation)))
    arguments))

(defn generic-semantic-evaluation-failed?
  [Value]
  [(evaluation (ptr (OhmGenericSemanticEvaluation Value)))] (-> bool)
  (.failed evaluation))

(defn generic-semantic-evaluation-error-kind
  [Value]
  [(evaluation (ptr (OhmGenericSemanticEvaluation Value)))] (-> i64)
  (.error-kind evaluation))

(defn free-generic-semantic-evaluation!
  [Value]
  [(evaluation (mut (OhmGenericSemanticEvaluation Value)))] (-> i64)
  (al/al-free! (mut (.values evaluation)))
  (al/al-free! (mut (.states evaluation)))
  0)
