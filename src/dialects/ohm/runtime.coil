(module experiments.ohm.runtime)

(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "coil.slice" :use [slice-data slice-len slice-get subslice])
(import "coil.str" :as str)
(import "coil.io" :as io)
(import "experiments.ohm.unicode" :as unicode)

(const OHM-VERSION "17.2.1")


;; A match tree is stored in one flat arena. Child and sibling relationships are
;; indices, so callers can retain and traverse a result without pointer-owned
;; recursive allocations.
(defstruct CstNode
  [(id i64)
   (rule (slice u8))
   (start i64)
   (end i64)
   (first-child i64)
   (last-child i64)
   (next-sibling i64)
   (optional bool)])

(defstruct Utf8Scalar [(value i64) (width i64) (valid bool)])

(defstruct IterationBuilder [(roots (al/ArrayList i64)) (arity i64) (rows i64)])

;; type 0 is a quoted string terminal; type 1 is a human-readable description.
(defstruct Expectation [(text (slice u8)) (type i64) (order i64) (fluffy bool)])
(defstruct FailureSnapshot [(expectations (al/ArrayList Expectation)) (farthest i64)])
(defstruct LineColumn
  [(offset i64) (line i64) (column i64) (line-start i64) (line-end i64)])

(defstruct OhmInterval
  [(source (slice u8)) (start i64) (end i64) (valid bool)])

(defstruct OhmInputStream
  [(source (slice u8))
   (position i64)
   (utf16-position i64)
   (examined-length i64)
   (pending-low-surrogate i64)
   (owned-slices (al/ArrayList (slice u8)))
   (allocator (dyn alloc/Allocator))])

(defstruct OhmSourceRange [(start i64) (end i64)])

(defstruct OhmIntervalContentsEntry
  [(source-data (ptr u8))
   (source-length i64)
   (start i64)
   (end i64)
   (contents (slice u8))])

(defstruct OhmIntervalContentsCache
  [(entries (al/ArrayList OhmIntervalContentsEntry)) (initialized bool)])

;; Immutable public identity for a compiled grammar. The fingerprint is built
;; from the normalized rule graph, not source text, so harmless parentheses and
;; whitespace changes compare equal just as they do in Ohm's Grammar.equals.
(defstruct OhmGrammarDescriptor
  [(name (slice u8))
   (default-start-rule (slice u8))
   (supergrammar-fingerprint (slice u8))
   (fingerprint (slice u8))])

(defstruct OhmPExprNode
  [(kind i64)
   (text (slice u8))
   (text2 (slice u8))
   (string-value (slice u8))
   (display-value (slice u8))
   (source (slice u8))
   (source-start i64)
   (source-end i64)
   (children (al/ArrayList i64))])

(defstruct OhmPExprRule
  [(name (slice u8))
   (body i64)
   (formals (al/ArrayList (slice u8)))
   (description (slice u8))
   (has-description bool)
   (operation (slice u8))
   (primitive bool)
   (source (slice u8))
   (source-start i64)
   (source-end i64)])

(defstruct OhmPExprGrammar
  [(source (slice u8))
   (nodes (al/ArrayList OhmPExprNode))
   (rules (al/ArrayList OhmPExprRule))
   (owned-strings (al/ArrayList (slice u8)))
   (valid bool)
   (allocator (dyn alloc/Allocator))])

(defn new-ohm-grammar-descriptor [(name (slice u8))
                                  (default-start-rule (slice u8))
                                  (supergrammar-fingerprint (slice u8))
                                  (fingerprint (slice u8))]
                                 (-> OhmGrammarDescriptor)
  (let [(mut descriptor) (primitive/zeroed OhmGrammarDescriptor)]
    (set! (.name descriptor) name)
    (set! (.default-start-rule descriptor) default-start-rule)
    (set! (.supergrammar-fingerprint descriptor) supergrammar-fingerprint)
    (set! (.fingerprint descriptor) fingerprint)
    (load descriptor)))

(defn grammar-descriptor-name [(grammar (ptr OhmGrammarDescriptor))]
                              (-> (slice u8))
  (.name grammar))

(defn grammar-descriptor-default-start-rule
  [(grammar (ptr OhmGrammarDescriptor))] (-> (slice u8))
  (.default-start-rule grammar))

(defn grammar-descriptor-fingerprint [(grammar (ptr OhmGrammarDescriptor))]
                                     (-> (slice u8))
  (.fingerprint grammar))

(defn grammar-descriptor-supergrammar-name
  [(grammar (ptr OhmGrammarDescriptor))] (-> (slice u8))
  (.supergrammar-fingerprint grammar))

(defn grammar-descriptor-is-built-in? [(grammar (ptr OhmGrammarDescriptor))]
                                      (-> bool)
  (or (str/str-eq (.name grammar) "BuiltInRules")
      (str/str-eq (.name grammar) "ProtoBuiltInRules")))

(defn grammar-equals? [(left (ptr OhmGrammarDescriptor))
                       (right (ptr OhmGrammarDescriptor))] (-> bool)
  (or (= left right)
      (and (str/str-eq (.name left) (.name right))
           (and (str/str-eq (.default-start-rule left)
                            (.default-start-rule right))
                (and (str/str-eq (.supergrammar-fingerprint left)
                                 (.supergrammar-fingerprint right))
                     (str/str-eq (.fingerprint left) (.fingerprint right)))))))

(defn new-ohm-pexpr-grammar [(source (slice u8)) (a (dyn alloc/Allocator))]
                            (-> OhmPExprGrammar)
  (let [(mut grammar) (primitive/zeroed OhmPExprGrammar)]
    (set! (.source grammar) source)
    (set! (.nodes grammar) (al/al-new [OhmPExprNode] a))
    (set! (.rules grammar) (al/al-new [OhmPExprRule] a))
    (set! (.owned-strings grammar) (al/al-new [(slice u8)] a))
    (set! (.valid grammar) true)
    (set! (.allocator grammar) a)
    (load grammar)))

(defn ohm-pexpr-grammar-valid? [(grammar (ptr OhmPExprGrammar))] (-> bool)
  (.valid grammar))

(defn invalidate-ohm-pexpr-grammar! [(grammar (mut OhmPExprGrammar))] (-> i64)
  (set! (.valid grammar) false)
  0)

(defn set-ohm-pexpr-source! [(grammar (mut OhmPExprGrammar))
                             (source (slice u8))] (-> i64)
  (set! (.source grammar) source)
  0)

(defn own-ohm-pexpr-string! [(grammar (mut OhmPExprGrammar))
                             (value (slice u8))] (-> (slice u8))
  (push! (mut (.owned-strings grammar)) value)
  value)

(defn push-ohm-pexpr-node! [(grammar (mut OhmPExprGrammar))
                            (kind i64)
                            (text (slice u8))
                            (text2 (slice u8))
                            (string-value (slice u8))
                            (display-value (slice u8))
                            (source (slice u8))
                            (source-start i64)
                            (source-end i64)] (-> i64)
  (let [(mut node) (primitive/zeroed OhmPExprNode)
        index (len (.nodes grammar))]
    (set! (.kind node) kind)
    (set! (.text node) text)
    (set! (.text2 node) text2)
    (set! (.string-value node) string-value)
    (set! (.display-value node) display-value)
    (set! (.source node) source)
    (set! (.source-start node) source-start)
    (set! (.source-end node) source-end)
    (set! (.children node) (al/al-new [i64] (.allocator grammar)))
    (push! (mut (.nodes grammar)) (load node))
    index))

(defn add-ohm-pexpr-child! [(grammar (mut OhmPExprGrammar))
                            (node i64)
                            (child i64)] (-> i64)
  (push! (mut (.children (al/al-elem [OhmPExprNode]
                                     (mut (.nodes grammar))
                                     node)))
         child)
  child)

(defn add-ohm-pexpr-rule! [(grammar (mut OhmPExprGrammar))
                           (name (slice u8))
                           (body i64)
                           (source (slice u8))
                           (source-start i64)
                           (source-end i64)] (-> i64)
  (let [(mut rule) (primitive/zeroed OhmPExprRule)]
    (set! (.name rule) name)
    (set! (.body rule) body)
    (set! (.formals rule) (al/al-new [(slice u8)] (.allocator grammar)))
    (set! (.description rule) "")
    (set! (.has-description rule) false)
    (set! (.operation rule) "define")
    (set! (.primitive rule) false)
    (set! (.source rule) source)
    (set! (.source-start rule) source-start)
    (set! (.source-end rule) source-end)
    (push! (mut (.rules grammar)) (load rule))
    body))

(defn set-ohm-pexpr-rule-metadata!
  [(grammar (mut OhmPExprGrammar))
   (index i64)
   (formals (slice (slice u8)))
   (description (slice u8))
   (has-description bool)
   (operation (slice u8))
   (primitive bool)] (-> i64)
  (let [rule (al/al-elem [OhmPExprRule] (mut (.rules grammar)) index)]
    (al/al-clear! (mut (.formals rule)))
    (for formal (iter formals) (push! (mut (.formals rule)) formal))
    (set! (.description rule) description)
    (set! (.has-description rule) has-description)
    (set! (.operation rule) operation)
    (set! (.primitive rule) primitive)
    index))

(defn set-ohm-pexpr-rule! [(grammar (mut OhmPExprGrammar))
                           (index i64)
                           (name (slice u8))
                           (body i64)
                           (source (slice u8))
                           (source-start i64)
                           (source-end i64)] (-> i64)
  (let [rule (al/al-elem [OhmPExprRule] (mut (.rules grammar)) index)]
    (set! (.name rule) name)
    (set! (.body rule) body)
    (set! (.source rule) source)
    (set! (.source-start rule) source-start)
    (set! (.source-end rule) source-end)
    body))

(defn ohm-pexpr-rule-count [(grammar (ptr OhmPExprGrammar))] (-> i64)
  (len (.rules grammar)))

(defn ohm-pexpr-rule-name [(grammar (ptr OhmPExprGrammar)) (index i64)]
                          (-> (slice u8))
  (let [rule (get (.rules grammar) index)] (.name rule)))

(defn ohm-pexpr-rule-body [(grammar (ptr OhmPExprGrammar)) (index i64)] (-> i64)
  (let [rule (get (.rules grammar) index)] (.body rule)))

(defn ohm-pexpr-rule-formal-count [(grammar (ptr OhmPExprGrammar)) (index i64)]
                                  (-> i64)
  (let [rule (get (.rules grammar) index)] (len (.formals rule))))

(defn ohm-pexpr-rule-formal [(grammar (ptr OhmPExprGrammar))
                             (index i64)
                             (formal-index i64)] (-> (slice u8))
  (let [rule (get (.rules grammar) index)]
    (get (.formals rule) formal-index)))

(defn ohm-pexpr-rule-description [(grammar (ptr OhmPExprGrammar)) (index i64)]
                                 (-> (slice u8))
  (let [rule (get (.rules grammar) index)] (.description rule)))

(defn ohm-pexpr-rule-has-description? [(grammar (ptr OhmPExprGrammar))
                                       (index i64)] (-> bool)
  (let [rule (get (.rules grammar) index)] (.has-description rule)))

(defn ohm-pexpr-rule-operation [(grammar (ptr OhmPExprGrammar)) (index i64)]
                               (-> (slice u8))
  (let [rule (get (.rules grammar) index)] (.operation rule)))

(defn ohm-pexpr-rule-primitive? [(grammar (ptr OhmPExprGrammar)) (index i64)]
                                (-> bool)
  (let [rule (get (.rules grammar) index)] (.primitive rule)))

(defn ohm-pexpr-rule-source-start [(grammar (ptr OhmPExprGrammar)) (index i64)]
                                  (-> i64)
  (let [rule (get (.rules grammar) index)] (.source-start rule)))

(defn ohm-pexpr-rule-source [(grammar (ptr OhmPExprGrammar)) (index i64)]
                            (-> (slice u8))
  (let [rule (get (.rules grammar) index)] (.source rule)))

(defn ohm-pexpr-rule-source-end [(grammar (ptr OhmPExprGrammar)) (index i64)]
                                (-> i64)
  (let [rule (get (.rules grammar) index)] (.source-end rule)))

(defn ohm-pexpr-kind [(grammar (ptr OhmPExprGrammar)) (node i64)] (-> i64)
  (let [expression (get (.nodes grammar) node)] (.kind expression)))

(defn ohm-pexpr-text [(grammar (ptr OhmPExprGrammar)) (node i64)] (-> (slice u8))
  (let [expression (get (.nodes grammar) node)] (.text expression)))

(defn ohm-pexpr-text2 [(grammar (ptr OhmPExprGrammar)) (node i64)] (-> (slice u8))
  (let [expression (get (.nodes grammar) node)] (.text2 expression)))

(defn ohm-pexpr-to-string [(grammar (ptr OhmPExprGrammar)) (node i64)]
                          (-> (slice u8))
  (let [expression (get (.nodes grammar) node)]
    (if (= (.kind expression) 17)
        (do
          (io/print-str
            (io/stderr)
            "this method toString is abstract! (it has no implementation in class CaseInsensitiveTerminal)\n")
          (alloc/abort)
          "")
        (.string-value expression))))

(defn ohm-pexpr-stored-string [(grammar (ptr OhmPExprGrammar)) (node i64)]
                              (-> (slice u8))
  (let [expression (get (.nodes grammar) node)] (.string-value expression)))

(defn ohm-pexpr-to-display-string [(grammar (ptr OhmPExprGrammar)) (node i64)]
                                  (-> (slice u8))
  (let [expression (get (.nodes grammar) node)] (.display-value expression)))

(defn ohm-pexpr-source-start [(grammar (ptr OhmPExprGrammar)) (node i64)] (-> i64)
  (let [expression (get (.nodes grammar) node)] (.source-start expression)))

(defn ohm-pexpr-source [(grammar (ptr OhmPExprGrammar)) (node i64)] (-> (slice u8))
  (let [expression (get (.nodes grammar) node)] (.source expression)))

(defn ohm-pexpr-source-end [(grammar (ptr OhmPExprGrammar)) (node i64)] (-> i64)
  (let [expression (get (.nodes grammar) node)] (.source-end expression)))

(defn set-ohm-pexpr-node-source! [(grammar (mut OhmPExprGrammar))
                                  (node i64)
                                  (source (slice u8))
                                  (start i64)
                                  (end i64)
                                  (display (slice u8))] (-> i64)
  (let [expression (al/al-elem [OhmPExprNode] (mut (.nodes grammar)) node)]
    (set! (.source expression) source)
    (set! (.source-start expression) start)
    (set! (.source-end expression) end)
    (set! (.display-value expression) display)
    node))

(defn ohm-pexpr-child-count [(grammar (ptr OhmPExprGrammar)) (node i64)] (-> i64)
  (let [expression (get (.nodes grammar) node)] (len (.children expression))))

(defn ohm-pexpr-child [(grammar (ptr OhmPExprGrammar)) (node i64) (index i64)]
                      (-> i64)
  (let [expression (get (.nodes grammar) node)]
    (get (.children expression) index)))

(defn ohm-pexpr-param-to-failure [(grammar (ptr OhmPExprGrammar))
                                  (node i64)] (-> i64)
  (if (!= (ohm-pexpr-kind grammar node) 11)
      (do
        (io/print-str (io/stderr) "Expected a Param parsing expression\n")
        (alloc/abort))
      0)
  (io/print-str
    (io/stderr)
    "this method toFailure is abstract! (it has no implementation in class Param)\n")
  (alloc/abort))

(defn free-ohm-pexpr-grammar! [(grammar (mut OhmPExprGrammar))] (-> i64)
  (for [index 0 (len (.nodes grammar))]
    (al/al-free! (mut (.children (al/al-elem [OhmPExprNode]
                                             (mut (.nodes grammar))
                                             index)))))
  (al/al-free! (mut (.nodes grammar)))
  (for [index 0 (len (.rules grammar))]
    (al/al-free! (mut (.formals (al/al-elem [OhmPExprRule]
                                            (mut (.rules grammar))
                                            index)))))
  (al/al-free! (mut (.rules grammar)))
  (for value (iter (.owned-strings grammar))
    (alloc/free [u8] (.allocator grammar) value))
  (al/al-free! (mut (.owned-strings grammar)))
  0)
(defstruct StartArgument
  [(text (slice u8))
   (text2 (slice u8))
   (kind i64)
   (root i64)])

;; Dynamic start applications use the same parsing-expression shapes as Ohm's
;; `Base_application` grammar. Children are indices in `start-expression-children`.
;; Kinds: terminal, app, range, seq, alt, star, plus, opt, not, look, lex.
(defstruct StartExpression
  [(kind i64)
   (text (slice u8))
   (text2 (slice u8))
   (child-start i64)
   (child-count i64)
   (source-start i64)
   (source-end i64)])

(defstruct SemanticRule [(name (slice u8)) (arity i64)])

(defstruct DecodedStartTerminal
  [(text (slice u8))
   (end i64)
   (valid bool)])

(defstruct IndentationChange [(at i64) (sign i64)])

(defstruct CstFrame
  [(first-child i64)
   (last-child i64)
   (indentation-change-count i64)])

(defstruct CstMark
  [(node-count i64)
   (first-child i64)
   (last-child i64)
   (indentation-change-count i64)])
(defstruct MemoMark
  [(entry-count i64)
   (node-count i64)
   (expectation-count i64)
   (trace-count i64)])

(defstruct MemoEntry
  [(rule-id i64)
   (rule-name (slice u8))
   (generation i64)
   (evaluating bool)
   (start i64)
   (best-end i64)
   (snapshot-start i64)
   (snapshot-count i64)
   (root-offset i64)
   (failure-start i64)
   (failure-count i64)
   (failure-position i64)
   (examined-end i64)
   (trace-source-start i64)
   (trace-snapshot-start i64)
   (trace-snapshot-count i64)])

(defstruct StableNodeIdentity
  [(rule-name (slice u8))
   (start i64)
   (examined-end i64)
   (path i64)
   (snapshot-id i64)
   (id i64)])

(defstruct TraceEvent
  [(display (slice u8))
   (kind i64)
   (start i64)
   (end i64)
   (expression-source-start i64)
   (expression-source-end i64)
   (parent i64)
   (binding i64)
   (first-binding i64)
   (binding-count i64)
   (prior-binding i64)
   (succeeded bool)
   (implicit-spaces bool)
   (memoized bool)
   (head-of-left-recursion bool)
   (terminates-left-recursion bool)
   (trace-only-bindings bool)
   (undefined-child bool)
   (terminating-entry i64)])

(defn copy-trace-event [(source TraceEvent)] (-> TraceEvent)
  (let [(mut event) (primitive/zeroed TraceEvent)]
    (set! (.display event) (.display source))
    (set! (.kind event) (.kind source))
    (set! (.start event) (.start source))
    (set! (.end event) (.end source))
    (set! (.expression-source-start event) (.expression-source-start source))
    (set! (.expression-source-end event) (.expression-source-end source))
    (set! (.parent event) (.parent source))
    (set! (.binding event) (.binding source))
    (set! (.first-binding event) (.first-binding source))
    (set! (.binding-count event) (.binding-count source))
    (set! (.prior-binding event) (.prior-binding source))
    (set! (.succeeded event) (.succeeded source))
    (set! (.implicit-spaces event) (.implicit-spaces source))
    (set! (.memoized event) (.memoized source))
    (set! (.head-of-left-recursion event) (.head-of-left-recursion source))
    (set! (.terminates-left-recursion event) (.terminates-left-recursion source))
    (set! (.trace-only-bindings event) (.trace-only-bindings source))
    (set! (.undefined-child event) (.undefined-child source))
    (set! (.terminating-entry event) (.terminating-entry source))
    (load event)))

(defstruct ParseCache
  [(memo (al/ArrayList MemoEntry))
   (memo-nodes (al/ArrayList CstNode))
   (memo-expectations (al/ArrayList Expectation))
   (memo-trace-events (al/ArrayList TraceEvent))
   (stable-identities (al/ArrayList StableNodeIdentity))
   (allocator (dyn alloc/Allocator))
   (generation i64)
   (reuse-count i64)
   (next-node-id i64)])

(defstruct ParseState
  [(nodes (al/ArrayList CstNode))
   (trace-nodes (al/ArrayList CstNode))
   (frames (al/ArrayList CstFrame))
   (memo (al/ArrayList MemoEntry))
   (memo-nodes (al/ArrayList CstNode))
   (memo-expectations (al/ArrayList Expectation))
   (memo-trace-events (al/ArrayList TraceEvent))
   (stable-identities (al/ArrayList StableNodeIdentity))
   (owned-names (al/ArrayList (slice u8)))
   (applications (al/ArrayList (slice u8)))
   (start-arguments (al/ArrayList StartArgument))
   (start-argument-frame-starts (al/ArrayList i64))
   (grammar-names (al/ArrayList (slice u8)))
   (semantic-rules (al/ArrayList SemanticRule))
   (start-expressions (al/ArrayList StartExpression))
   (start-expression-children (al/ArrayList i64))
   (start-expression-dispatcher (fnptr c [(mut ParseState) (slice u8) i64 i64 bool] i64))
   (start-application (slice u8))
   (grammar-name (slice u8))
   (grammar-token (ptr u8))
   (expectations (al/ArrayList Expectation))
   (trace-events (al/ArrayList TraceEvent))
   (trace-stack (al/ArrayList i64))
   (examined-stack (al/ArrayList i64))
   (failure-examined-stack (al/ArrayList i64))
   (indentation-tokens (al/ArrayList i64))
   (indentation-changes (al/ArrayList IndentationChange))
   (indentation-sensitive bool)
   (tracing bool)
   (cache-generation i64)
   (cache-reuse-count i64)
   (next-node-id i64)
   (allocator (dyn alloc/Allocator))
   (root i64)
   (farthest i64)
   (next-expectation-order i64)])

(defstruct MatchResult
  [(source (slice u8))
   (matcher (ptr u8))
   (owns-matcher bool)
   (nodes (al/ArrayList CstNode))
   (trace-nodes (al/ArrayList CstNode))
   (trace-node-base i64)
   (owned-names (al/ArrayList (slice u8)))
   (failures (al/ArrayList Expectation))
   (trace-events (al/ArrayList TraceEvent))
   (allocator (dyn alloc/Allocator))
   (expected-text (slice u8))
   (short-message (slice u8))
   (message (slice u8))
   (failure-line i64)
   (failure-column i64)
   (grammar-name (slice u8))
   (grammar-token (ptr u8))
   (grammar-names (al/ArrayList (slice u8)))
   (semantic-rules (al/ArrayList SemanticRule))
   (root i64)
   (end i64)
   (succeeded bool)
   (failure-position i64)])

(defstruct SemanticAttribute
  [(values (al/ArrayList i64))
   (root i64)])

;; A typed semantic operation over a CST. Generated grammars retain rule names
;; and exact child order, while the action chooses its result type. A single
;; trait method is sufficient for rule-specific dispatch in Coil: implementations
;; inspect `node-rule`, and receive the already-evaluated children in order.
(deftrait OhmSemanticAction [Self]
  (apply-semantic-node [(self Self)
                        (result (ptr MatchResult))
                        (node i64)
                        (children (slice i64))]
                       (-> i64)))

(deftrait OhmTraceVisitor [Self]
  ;; Return false to implement Trace.SKIP: descendants and the matching exit
  ;; callback are omitted for that event.
  (trace-visitor-enter [(self (mut Self))
                        (result (ptr MatchResult))
                        (event i64)
                        (parent i64)
                        (depth i64)]
                       (-> bool))
  (trace-visitor-exit [(self (mut Self))
                       (result (ptr MatchResult))
                       (event i64)
                       (parent i64)
                       (depth i64)]
                      (-> i64)))

;; Lazy Coil-native counterpart of Ohm's operation/attribute dispatch. Values
;; are i64 so callers may return scalars or handles to arbitrary Coil values.
;; `semantic-action-kind` returns 0 when there is no user action, 1 for an
;; exact ctor action, 2 for `_nonterminal`, or 3 for a user `_default` action.
(deftrait OhmLazySemanticAction [Self]
  (semantic-grammar-name [(self (ptr Self))] (-> (slice u8)))
  (semantic-grammar-token [(self (ptr Self))] (-> (ptr u8)))
  (semantic-formal-count [(self (ptr Self))] (-> i64))
  (semantic-action-kind [(self (ptr Self))
                         (result (ptr MatchResult))
                         (node i64)]
                        (-> i64))
  (apply-lazy-semantic-action [(self (ptr Self))
                               (evaluation (mut SemanticEvaluation))
                               (node i64)
                               (action-kind i64)
                               (arguments (slice i64))]
                              (-> i64)))

(deftrait OhmSemanticActionSchema [Self]
  (semantic-schema-grammar-name [(self (ptr Self))] (-> (slice u8)))
  (semantic-schema-grammar-token [(self (ptr Self))] (-> (ptr u8)))
  (semantic-schema-action-count [(self (ptr Self))] (-> i64))
  (semantic-schema-action-name [(self (ptr Self)) (index i64)] (-> (slice u8)))
  (semantic-schema-action-arity [(self (ptr Self)) (index i64)] (-> i64))
  (semantic-schema-action-rest? [(self (ptr Self)) (index i64)] (-> bool)))

(defstruct SemanticSchemaValidation
  [(valid bool)
   (error-kind i64)
   (action-index i64)
   (expected-arity i64)
   (actual-arity i64)])

(defstruct SemanticSignature
  [(valid bool)
   (name (slice u8))
   (formal-count i64)
   (error-position i64)])

(defstruct SemanticIteration
  [(children (al/ArrayList i64)) (valid bool)])

(defstruct SemanticActionFrame
  [(node i64) (action-name (slice u8)) (explicit bool)])

(defstruct SemanticAttributeCacheEntry [(node-id i64) (value i64)])

(defstruct SemanticAttributeCache
  [(entries (al/ArrayList SemanticAttributeCacheEntry))
   (allocator (dyn alloc/Allocator))
   (hit-count i64)])

(defstruct SemanticEvaluation
  [(action (dyn OhmLazySemanticAction))
   (result (ptr MatchResult))
   (values (al/ArrayList i64))
   (states (al/ArrayList u8))
   (action-stack (al/ArrayList SemanticActionFrame))
   (error-stack (al/ArrayList SemanticActionFrame))
   (attribute bool)
   (failed bool)
   (error-kind i64)
   (error-node i64)
   (expected-arguments i64)
   (actual-arguments i64)
   (action-name (slice u8))
   (error-message (slice u8))
   (owns-error-message bool)
   (attribute-cache SemanticAttributeCache)
   (uses-attribute-cache bool)])

(defstruct SemanticDefinition
  [(name (slice u8))
   (action (dyn OhmLazySemanticAction))
   (attribute bool)
   (inherited bool)
   (extended bool)
   (recipe-preamble (slice u8))
   (recipe-constructor (slice u8))
   (attribute-cache SemanticAttributeCache)
   (owns-attribute-cache bool)])

(defstruct OhmSemantics
  [(name (slice u8))
   (grammar-name (slice u8))
   (grammar-token (ptr u8))
   (grammar-fingerprint (slice u8))
   (grammar-recipe (slice u8))
   (definitions (al/ArrayList SemanticDefinition))
   (allocator (dyn alloc/Allocator))])

(defstruct OhmSemanticsRecipe
  [(name (slice u8))
   (grammar-name (slice u8))
   (grammar-token (ptr u8))
   (grammar-fingerprint (slice u8))
   (grammar-recipe (slice u8))
   (definitions (al/ArrayList SemanticDefinition))
   (allocator (dyn alloc/Allocator))])

;; Coil-native representation of the heterogeneous values produced by Ohm's
;; `extras.toAST`. Nodes and their object properties/array elements live in flat
;; arenas so the result can represent the same strings, booleans, numbers,
;; nulls, objects, and arrays without routing through another language.
;; Kinds: null, string, bool, number, object, array.
(defstruct OhmAstNode
  [(kind i64)
   (text (slice u8))
   (boolean bool)
   (number f64)
   (entry-start i64)
   (entry-count i64)])

(defstruct OhmAstEntry [(name (slice u8)) (value i64)])

(defstruct OhmAst
  [(nodes (al/ArrayList OhmAstNode))
   (entries (al/ArrayList OhmAstEntry))
   (owned-texts (al/ArrayList (slice u8)))
   (allocator (dyn alloc/Allocator))
   (root i64)
   (valid bool)
   (error-message (slice u8))])

;; Rule mapping kinds: template, child forwarding, custom action.
(defstruct OhmAstRuleMapping
  [(name (slice u8))
   (kind i64)
   (value i64)
   (property-start i64)
   (property-count i64)])

;; Property mapping kinds: child, string, bool, null, number, omit, action.
(defstruct OhmAstPropertyMapping
  [(name (slice u8))
   (kind i64)
   (value i64)
   (text (slice u8))
   (boolean bool)
   (number f64)])

(defstruct OhmAstMapping
  [(rules (al/ArrayList OhmAstRuleMapping))
   (properties (al/ArrayList OhmAstPropertyMapping))
   (allocator (dyn alloc/Allocator))])

(defstruct OhmToAstSemantics
  [(grammar-name (slice u8))
   (grammar-token (ptr u8))])

;; Custom rule/property callbacks are the Coil counterpart of function-valued
;; entries in a JavaScript toAST mapping. `children` contains already-converted
;; AST node handles in exact CST child order. Actions may return an existing
;; handle or append values through the public `ast-add-*` helpers.
(deftrait OhmToAstAction [Self]
  (to-ast-rule-action [(self (ptr Self))
                       (ast (mut OhmAst))
                       (result (ptr MatchResult))
                       (cst-node i64)
                       (children (slice i64))
                       (action-id i64)]
                      (-> i64))
  (to-ast-property-action [(self (ptr Self))
                           (ast (mut OhmAst))
                           (result (ptr MatchResult))
                           (cst-node i64)
                           (children (slice i64))
                           (action-id i64)]
                          (-> i64)))

(defstruct NoToAstActions [])

(impl OhmToAstAction NoToAstActions
  (to-ast-rule-action [(self (ptr NoToAstActions))
                       (ast (mut OhmAst))
                       (result (ptr MatchResult))
                       (cst-node i64)
                       (children (slice i64))
                       (action-id i64)] (-> i64)
    -1)
  (to-ast-property-action [(self (ptr NoToAstActions))
                           (ast (mut OhmAst))
                           (result (ptr MatchResult))
                           (cst-node i64)
                           (children (slice i64))
                           (action-id i64)] (-> i64)
    -1))

(defstruct OhmMatcher
  [(input (al/ArrayList u8))
   (grammar (ptr u8))
   (owns-grammar bool)
   (parse (fnptr c [(slice u8) (slice u8)] MatchResult))
   (parse-incremental (fnptr c [(slice u8) (slice u8) bool (mut ParseCache)] MatchResult))
   (cache ParseCache)
   (incremental bool)
   (supports-incremental-parsing bool)
   (has-matched bool)
   (unsupported-incremental-edit bool)
   (cached-start-rule (slice u8))
   (has-cached-start-rule bool)
   (start-rule (slice u8))
   (allocator (dyn alloc/Allocator))])

;; The cohesive public grammar value. Generated grammars supply executable
;; parser entry points as well as the same expression graph exposed in `rules`.
;; Keeping both in one owned value avoids presenting recipe metadata as though
;; it were an executable programmatic grammar.
(defstruct OhmGrammar
  [(descriptor OhmGrammarDescriptor)
   (pexprs OhmPExprGrammar)
   (parse (fnptr c [(slice u8) (slice u8)] MatchResult))
   (parse-incremental
     (fnptr c [(slice u8) (slice u8) bool (mut ParseCache)] MatchResult))
   (recipe (slice u8))
   (source (slice u8))
   (action-template (slice u8))
   (token (ptr u8))
   (supergrammar-factory (fnptr c [] OhmGrammar))
   (has-supergrammar-factory bool)
   (built-in bool)
   (indentation-sensitive bool)
   (allocator (dyn alloc/Allocator))])

(defn new-ohm-grammar [(descriptor OhmGrammarDescriptor)
                       (pexprs OhmPExprGrammar)
                       (parse (fnptr c [(slice u8) (slice u8)] MatchResult))
                       (parse-incremental
                         (fnptr c
                           [(slice u8) (slice u8) bool (mut ParseCache)]
                           MatchResult))
                       (recipe (slice u8))
                       (source (slice u8))
                       (action-template (slice u8))
                       (token (ptr u8))
                       (indentation-sensitive bool)
                       (a (dyn alloc/Allocator))] (-> OhmGrammar)
  (let [(mut grammar) (primitive/zeroed OhmGrammar)]
    (set! (.descriptor grammar) descriptor)
    (set! (.pexprs grammar) pexprs)
    (set! (.parse grammar) parse)
    (set! (.parse-incremental grammar) parse-incremental)
    (set! (.recipe grammar) recipe)
    (set! (.source grammar) source)
    (set! (.action-template grammar) action-template)
    (set! (.token grammar) token)
    (set! (.built-in grammar) false)
    (set! (.indentation-sensitive grammar) indentation-sensitive)
    (set! (.allocator grammar) a)
    (load grammar)))

(defn ohm-grammar-name [(grammar (ptr OhmGrammar))] (-> (slice u8))
  (.name (.descriptor grammar)))

(defn ohm-grammar-default-start-rule [(grammar (ptr OhmGrammar))]
                                     (-> (slice u8))
  (.default-start-rule (.descriptor grammar)))

(defn ohm-grammar-supergrammar-name [(grammar (ptr OhmGrammar))]
                                    (-> (slice u8))
  (.supergrammar-fingerprint (.descriptor grammar)))

(defn set-ohm-grammar-supergrammar-factory!
  [(grammar (mut OhmGrammar)) (factory (fnptr c [] OhmGrammar))] (-> i64)
  (set! (.supergrammar-factory grammar) factory)
  (set! (.has-supergrammar-factory grammar) true)
  0)

(defn ohm-grammar-has-supergrammar? [(grammar (ptr OhmGrammar))] (-> bool)
  (.has-supergrammar-factory grammar))

(defn ohm-grammar-supergrammar [(grammar (ptr OhmGrammar))] (-> OhmGrammar)
  (if (.has-supergrammar-factory grammar)
      (primitive/call-ptr (.supergrammar-factory grammar))
      (primitive/zeroed OhmGrammar)))

(defn ohm-grammar-is-built-in? [(grammar (ptr OhmGrammar))] (-> bool)
  (.built-in grammar))

(defn set-ohm-grammar-built-in! [(grammar (mut OhmGrammar))] (-> i64)
  (set! (.built-in grammar) true)
  0)

(defn set-ohm-grammar-built-in-value! [(grammar (mut OhmGrammar)) (value bool)]
                                      (-> i64)
  (set! (.built-in grammar) value)
  0)

(defn ohm-pexpr-sorted-rule-indices [(grammar (ptr OhmPExprGrammar))]
                                     (-> (al/ArrayList i64))
  (let [(mut indices) (al/al-new [i64] (.allocator grammar))]
    (for [index 0 (len (.rules grammar))] (push! (mut indices) index))
    (for [left 0 (len indices)]
      (let [(mut smallest) left]
        (for [right (+ left 1) (len indices)]
          (let [candidate (get (.rules grammar) (get indices right))
                selected (get (.rules grammar) (get indices (load smallest)))]
            (if (< (str/str-cmp (.name candidate) (.name selected)) 0)
                (set! smallest right)
                0)))
        (if (!= (load smallest) left)
            (let [saved (get indices left)]
              (al/al-set! [i64] (mut indices) left (get indices (load smallest)))
              (al/al-set! [i64] (mut indices) (load smallest) saved))
            0)))
    (load indices)))

(defn ohm-grammar-equals? [(left (ptr OhmGrammar))
                           (right (ptr OhmGrammar))] (-> bool)
  (if (= left right)
      true
      (if (or (= (primitive/cast i64 left) 0)
              (= (primitive/cast i64 right) 0))
          false
          (if (or (not (str/str-eq (ohm-grammar-name left)
                                    (ohm-grammar-name right)))
                  (or (not (str/str-eq (ohm-grammar-default-start-rule left)
                                       (ohm-grammar-default-start-rule right)))
                      (!= (ohm-grammar-has-supergrammar? left)
                          (ohm-grammar-has-supergrammar? right))))
              false
              (let [supergrammars-equal
                      (if (ohm-grammar-has-supergrammar? left)
                          (let [(mut left-super) (ohm-grammar-supergrammar left)
                                (mut right-super) (ohm-grammar-supergrammar right)]
                            (ohm-grammar-equals? (mut left-super) (mut right-super)))
                          true)
                    (mut left-indices) (ohm-pexpr-sorted-rule-indices (field left pexprs))
                    (mut right-indices) (ohm-pexpr-sorted-rule-indices (field right pexprs))
                    (mut equal) (and supergrammars-equal
                                     (= (len left-indices) (len right-indices)))]
                (if (load equal)
                    (for [rank 0 (len left-indices)]
                      (let [left-rule (get (.rules (.pexprs left)) (get left-indices rank))
                            right-rule (get (.rules (.pexprs right)) (get right-indices rank))]
                        (if (or (!= (.has-description left-rule)
                                    (.has-description right-rule))
                                (or (not (str/str-eq (.description left-rule)
                                                     (.description right-rule)))
                                    (or (!= (len (.formals left-rule))
                                            (len (.formals right-rule)))
                                        (not (str/str-eq
                                               (ohm-pexpr-stored-string
                                                 (field left pexprs) (.body left-rule))
                                               (ohm-pexpr-stored-string
                                                 (field right pexprs) (.body right-rule)))))))
                            (set! equal false)
                            (for [formal-index 0 (len (.formals left-rule))]
                              (if (not (str/str-eq (get (.formals left-rule) formal-index)
                                                   (get (.formals right-rule) formal-index)))
                                  (set! equal false)
                                  0)))))
                    0)
                (al/al-free! (mut left-indices))
                (al/al-free! (mut right-indices))
                (load equal))))))

(defn ohm-grammar-set-rule-description! [(grammar (mut OhmGrammar))
                                         (index i64)
                                         (description (slice u8))] (-> i64)
  (let [rule (al/al-elem [OhmPExprRule] (mut (.rules (.pexprs grammar))) index)]
    (set! (.description rule) description)
    (set! (.has-description rule) true)
    0))

(defn ohm-grammar-remove-rule! [(grammar (mut OhmGrammar)) (index i64)] (-> i64)
  (let [count (len (.rules (.pexprs grammar)))]
    (if (or (< index 0) (>= index count))
        0
        (do
          (al/al-free! [(slice u8)]
            (mut (.formals
                   (al/al-elem [OhmPExprRule]
                     (mut (.rules (.pexprs grammar))) index))))
          (for [at index (- count 1)]
            (al/al-set! [OhmPExprRule]
              (mut (.rules (.pexprs grammar))) at
              (get (.rules (.pexprs grammar)) (+ at 1))))
          (al/al-pop! [OhmPExprRule] (mut (.rules (.pexprs grammar))))
          0))))

(defn ohm-grammar-rule-count [(grammar (ptr OhmGrammar))] (-> i64)
  (ohm-pexpr-rule-count (field grammar pexprs)))

(defn ohm-grammar-rule-name [(grammar (ptr OhmGrammar)) (index i64)]
                            (-> (slice u8))
  (ohm-pexpr-rule-name (field grammar pexprs) index))

(defn ohm-grammar-rule-body [(grammar (ptr OhmGrammar)) (index i64)] (-> i64)
  (ohm-pexpr-rule-body (field grammar pexprs) index))

(defn ohm-grammar-rule-formal-count [(grammar (ptr OhmGrammar)) (index i64)]
                                    (-> i64)
  (ohm-pexpr-rule-formal-count (field grammar pexprs) index))

(defn ohm-grammar-rule-formal [(grammar (ptr OhmGrammar))
                               (index i64)
                               (formal-index i64)] (-> (slice u8))
  (ohm-pexpr-rule-formal (field grammar pexprs) index formal-index))

(defn ohm-grammar-rule-description [(grammar (ptr OhmGrammar)) (index i64)]
                                   (-> (slice u8))
  (ohm-pexpr-rule-description (field grammar pexprs) index))

(defn ohm-grammar-rule-has-description? [(grammar (ptr OhmGrammar))
                                         (index i64)] (-> bool)
  (ohm-pexpr-rule-has-description? (field grammar pexprs) index))

(defn ohm-grammar-rule-source [(grammar (ptr OhmGrammar)) (index i64)]
                              (-> OhmInterval)
  (new-ohm-interval (ohm-pexpr-rule-source (field grammar pexprs) index)
                    (ohm-pexpr-rule-source-start (field grammar pexprs) index)
                    (ohm-pexpr-rule-source-end (field grammar pexprs) index)))

;; Namespace compilation specializes each grammar definition independently.
;; Reattach public RuleInfo/PExpr intervals to the complete ohm.grammars source,
;; matching the source identity and absolute offsets exposed by Ohm.
(defn remap-ohm-grammar-pexpr-source! [(grammar (mut OhmGrammar))
                                       (local-source (slice u8))
                                       (namespace-source (slice u8))
                                       (utf16-offset i64)] (-> i64)
  (do
    (for [index 0 (len (.rules (.pexprs grammar)))]
      (let [rule (al/al-elem [OhmPExprRule]
                             (mut (.rules (.pexprs grammar)))
                             index)]
        (if (str/str-eq (.source rule) local-source)
            (do
              (set! (.source-start rule) (+ (.source-start rule) utf16-offset))
              (set! (.source-end rule) (+ (.source-end rule) utf16-offset))
              (set! (.source rule) namespace-source))
            0)))
    (for [index 0 (len (.nodes (.pexprs grammar)))]
      (let [node (al/al-elem [OhmPExprNode]
                             (mut (.nodes (.pexprs grammar)))
                             index)]
        (if (str/str-eq (.source node) local-source)
            (do
              (if (>= (.source-start node) 0)
                  (set! (.source-start node) (+ (.source-start node) utf16-offset))
                  0)
              (if (>= (.source-end node) 0)
                  (set! (.source-end node) (+ (.source-end node) utf16-offset))
                  0)
              (set! (.source node) namespace-source))
            0)))
    (set! (.source (.pexprs grammar)) namespace-source)
    0))

(defn ohm-grammar-recipe [(grammar (ptr OhmGrammar))] (-> (slice u8))
  (cond (str/str-eq (ohm-grammar-name grammar) "ProtoBuiltInRules")
          (do
            (io/print-str
              (io/stderr)
              "this method outputRecipe is abstract! (it has no implementation in class CaseInsensitiveTerminal)\n")
            (alloc/abort)
            "")
        (str/str-eq (ohm-grammar-name grammar) "IndentationSensitive")
          (do
            (io/print-str
              (io/stderr)
              "this method outputRecipe is abstract! (it has no implementation in class Indentation)\n")
            (alloc/abort)
            "")
        :else (.recipe grammar)))

(defn ohm-grammar-source [(grammar (ptr OhmGrammar))] (-> (slice u8))
  (.source grammar))

(defn ohm-grammar-action-dictionary-template [(grammar (ptr OhmGrammar))]
                                             (-> (slice u8))
  (.action-template grammar))

(defn ohm-grammar-operation-action-dictionary-template
  [(grammar (ptr OhmGrammar))] (-> (slice u8))
  (.action-template grammar))

(defn ohm-grammar-attribute-action-dictionary-template
  [(grammar (ptr OhmGrammar))] (-> (slice u8))
  (.action-template grammar))

;; Exact Ohm 17.2.1 templates for the public ancestor grammars. Generated
;; descendants build theirs from declarations, whereas these values are
;; assembled directly by the reader.
(defn ohm-proto-built-in-action-dictionary-template [] (-> (slice u8))
  "{\n  any: function(_) {\n  },\n  end: function(_) {\n  },\n  caseInsensitive: function(_) {\n  },\n  lower: function(_) {\n  },\n  upper: function(_) {\n  },\n  unicodeLtmo: function(_) {\n  },\n  spaces: function(_) {\n  },\n  space: function(_) {\n  }\n}")

(defn ohm-built-in-action-dictionary-template [] (-> (slice u8))
  "{\n  alnum: function(_) {\n  },\n  letter: function(_) {\n  },\n  digit: function(_) {\n  },\n  hexDigit: function(_) {\n  },\n  ListOf: function(_) {\n  },\n  NonemptyListOf: function(_, _, _) {\n  },\n  EmptyListOf: function() {\n  },\n  listOf: function(_) {\n  },\n  nonemptyListOf: function(_, _, _) {\n  },\n  emptyListOf: function() {\n  },\n  applySyntactic: function(_) {\n  },\n  any: function(_) {\n  },\n  end: function(_) {\n  },\n  caseInsensitive: function(_) {\n  },\n  lower: function(_) {\n  },\n  upper: function(_) {\n  },\n  unicodeLtmo: function(_) {\n  },\n  spaces: function(_) {\n  },\n  space: function(_) {\n  }\n}")

(defn ohm-indentation-action-dictionary-template [] (-> (slice u8))
  "{\n  indent: function(_) {\n  },\n  dedent: function(_) {\n  },\n  any: function(_) {\n  },\n  alnum: function(_) {\n  },\n  letter: function(_) {\n  },\n  digit: function(_) {\n  },\n  hexDigit: function(_) {\n  },\n  ListOf: function(_) {\n  },\n  NonemptyListOf: function(_, _, _) {\n  },\n  EmptyListOf: function() {\n  },\n  listOf: function(_) {\n  },\n  nonemptyListOf: function(_, _, _) {\n  },\n  emptyListOf: function() {\n  },\n  applySyntactic: function(_) {\n  },\n  end: function(_) {\n  },\n  caseInsensitive: function(_) {\n  },\n  lower: function(_) {\n  },\n  upper: function(_) {\n  },\n  unicodeLtmo: function(_) {\n  },\n  spaces: function(_) {\n  },\n  space: function(_) {\n  }\n}")

(defn ohm-grammar-create-semantics [(grammar (ptr OhmGrammar))]
                                   (-> OhmSemantics)
  (let [(mut semantics)
          (new-ohm-semantics (.name (.descriptor grammar))
                             (.token grammar)
                             (.allocator grammar))]
    (set! (.grammar-recipe semantics) (.recipe grammar))
    (set! (.grammar-fingerprint semantics) (.fingerprint (.descriptor grammar)))
    (load semantics)))

(defn ohm-grammar-compatible-with-semantics?
  [(grammar (ptr OhmGrammar)) (parent (ptr OhmSemantics))] (-> bool)
  (if (or (= (primitive/cast i64 (.token grammar))
             (primitive/cast i64 (.grammar-token parent)))
          (and (> (slice-len (.grammar-fingerprint parent)) 0)
               (str/str-eq (.fingerprint (.descriptor grammar))
                           (.grammar-fingerprint parent))))
      true
      (if (.has-supergrammar-factory grammar)
          (let [(mut supergrammar) (ohm-grammar-supergrammar grammar)]
            (ohm-grammar-compatible-with-semantics? (mut supergrammar) parent))
          false)))

(defn ohm-grammar-extend-semantics [(grammar (ptr OhmGrammar))
                                    (parent (ptr OhmSemantics))]
                                   (-> OhmSemantics)
  (if (not (ohm-grammar-compatible-with-semantics? grammar parent))
      (let [(mut message) (str/sb-new (.allocator grammar))]
        (str/sb-push-str! (mut message) "Cannot extend a semantics for grammar '")
        (str/sb-push-str! (mut message) (.grammar-name parent))
        (str/sb-push-str! (mut message) "' for use with grammar '")
        (str/sb-push-str! (mut message) (ohm-grammar-name grammar))
        (str/sb-push-str! (mut message) "' (not a sub-grammar)\n")
        (io/print-str (io/stderr) (str/sb-finish! (mut message)))
        (alloc/abort))
      0)
  (let [(mut semantics)
          (extend-ohm-semantics parent
                                (.name (.descriptor grammar))
                                (.token grammar))]
    (set! (.grammar-recipe semantics) (.recipe grammar))
    (set! (.grammar-fingerprint semantics) (.fingerprint (.descriptor grammar)))
    (load semantics)))

(defn ohm-grammar-matcher [(grammar (ptr OhmGrammar))] (-> OhmMatcher)
  (let [(mut matcher)
          (if (.indentation-sensitive grammar)
              (new-indentation-ohm-matcher (.parse-incremental grammar)
                                           (.default-start-rule (.descriptor grammar))
                                           (.allocator grammar))
              (new-incremental-ohm-matcher (.parse-incremental grammar)
                                           (.default-start-rule (.descriptor grammar))
                                           (.allocator grammar)))]
    (set! (.grammar matcher) (primitive/cast (ptr u8) grammar))
    (set! (.owns-grammar matcher) false)
    (load matcher)))

(defn ohm-grammar-owned-matcher [(grammar OhmGrammar)] (-> OhmMatcher)
  (match (alloc/alloc [OhmGrammar] (.allocator grammar) 1)
    (None []
      (do
        (alloc/oom-at c"ohm Grammar matcher owner" (primitive/sizeof OhmGrammar))
        (primitive/zeroed OhmMatcher)))
    (Some [memory]
      (let [grammar-pointer (alloc/alloc-slice-data memory)
            _ (store! grammar-pointer grammar)
            (mut matcher) (ohm-grammar-matcher grammar-pointer)]
        (set! (.owns-grammar matcher) true)
        (load matcher)))))

(defn matcher-grammar [(matcher (ptr OhmMatcher))] (-> (ptr OhmGrammar))
  (primitive/cast (ptr OhmGrammar) (.grammar matcher)))

(defn free-ohm-grammar! [(grammar (mut OhmGrammar))] (-> i64)
  (free-ohm-pexpr-grammar! (mut (.pexprs grammar))))

(defn new-parse-state [(a (dyn alloc/Allocator))] (-> ParseState)
  (let [(mut state) (primitive/zeroed ParseState)]
    (set! (.nodes state) (al/al-new [CstNode] a))
    (set! (.trace-nodes state) (al/al-new [CstNode] a))
    (set! (.frames state) (al/al-new [CstFrame] a))
    (set! (.memo state) (al/al-new [MemoEntry] a))
    (set! (.memo-nodes state) (al/al-new [CstNode] a))
    (set! (.memo-expectations state) (al/al-new [Expectation] a))
    (set! (.memo-trace-events state) (al/al-new [TraceEvent] a))
    (set! (.stable-identities state) (al/al-new [StableNodeIdentity] a))
    (set! (.owned-names state) (al/al-new [(slice u8)] a))
    (set! (.applications state) (al/al-new [(slice u8)] a))
    (set! (.start-arguments state) (al/al-new [StartArgument] a))
    (set! (.start-argument-frame-starts state) (al/al-new [i64] a))
    (set! (.grammar-names state) (al/al-new [(slice u8)] a))
    (set! (.semantic-rules state) (al/al-new [SemanticRule] a))
    (set! (.start-expressions state) (al/al-new [StartExpression] a))
    (set! (.start-expression-children state) (al/al-new [i64] a))
    (set! (.start-application state) "")
    (set! (.grammar-name state) "")
    (set! (.grammar-token state) (primitive/cast (ptr u8) 0))
    (set! (.expectations state) (al/al-new [Expectation] a))
    (set! (.trace-events state) (al/al-new [TraceEvent] a))
    (set! (.trace-stack state) (al/al-new [i64] a))
    (set! (.examined-stack state) (al/al-new [i64] a))
    (set! (.failure-examined-stack state) (al/al-new [i64] a))
    (set! (.indentation-tokens state) (al/al-new [i64] a))
    (set! (.indentation-changes state) (al/al-new [IndentationChange] a))
    (set! (.indentation-sensitive state) false)
    (set! (.tracing state) false)
    (set! (.cache-generation state) 0)
    (set! (.cache-reuse-count state) 0)
    (set! (.next-node-id state) 1)
    (set! (.allocator state) a)
    (set! (.root state) -1)
    (set! (.farthest state) 0)
    (set! (.next-expectation-order state) 0)
    (load state)))

(defn note-examined! [(state (mut ParseState)) (end i64)] (-> i64)
  (for [index 0 (len (.examined-stack state))]
    (if (> end (get (.examined-stack state) index))
        (set! (mut (.examined-stack state)) index end)
        0))
  end)

(defn note-failure-examined! [(state (mut ParseState)) (at i64)] (-> i64)
  (for [index 0 (len (.failure-examined-stack state))]
    (if (> at (get (.failure-examined-stack state) index))
        (set! (mut (.failure-examined-stack state)) index at)
        0))
  at)

(defn indentation-token-at [(state (ptr ParseState)) (at i64)] (-> i64)
  (if (and (.indentation-sensitive state)
           (and (>= at 0) (< at (len (.indentation-tokens state)))))
      (get (.indentation-tokens state) at)
      0))

(defn input-visible-at? [(state (ptr ParseState)) (at i64)] (-> bool)
  (= (indentation-token-at state at) 0))

(defn enable-indentation-sensitive! [(state (mut ParseState))
                                     (source (slice u8))] (-> i64)
  (set! (.indentation-sensitive state) true)
  (loop (if (= (len (.indentation-tokens state)) 0)
            (break)
            (pop! (mut (.indentation-tokens state)))))
  (for [_ 0 (+ (slice-len source) 1)]
    (push! (mut (.indentation-tokens state)) 0))
  (let [(mut stack) (al/al-new [i64] (.allocator state))
        (mut line-start) 0]
    (push! (mut stack) 0)
    (loop (if (>= (load line-start) (slice-len source))
              (break)
              (let [(mut content-start) (load line-start)
                    (mut line-end) (load line-start)]
                (loop (if (or (>= (load content-start) (slice-len source))
                              (not (= (primitive/cast i64
                                                       (slice-get source (load content-start)))
                                      32)))
                          (break)
                          (set! content-start (+ (load content-start) 1))))
                (set! line-end (load content-start))
                (loop (if (or (>= (load line-end) (slice-len source))
                              (= (primitive/cast i64 (slice-get source (load line-end))) 10)
                              (= (primitive/cast i64 (slice-get source (load line-end))) 13))
                          (break)
                          (set! line-end (+ (load line-end) 1))))
                (let [indent-size (- (load content-start) (load line-start))
                      previous (get (load stack) (- (len (load stack)) 1))]
                  (cond (> indent-size previous)
                          (do
                            (push! (mut stack) indent-size)
                            (set! (mut (.indentation-tokens state)) (load content-start) 1))
                        (< indent-size previous)
                          (let [before (len (load stack))]
                            (loop (if (or (= (len (load stack)) 1)
                                          (= (get (load stack) (- (len (load stack)) 1))
                                             indent-size))
                                      (break)
                                      (pop! (mut stack))))
                            (if (= (get (load stack) (- (len (load stack)) 1)) indent-size)
                                (set! (mut (.indentation-tokens state))
                                      (load content-start)
                                      (- (len (load stack)) before))
                                0))
                        :else 0))
                (if (>= (load line-end) (slice-len source))
                    (set! line-start (slice-len source))
                    (if (and (= (primitive/cast i64 (slice-get source (load line-end))) 13)
                             (< (+ (load line-end) 1) (slice-len source))
                             (= (primitive/cast i64
                                                  (slice-get source (+ (load line-end) 1)))
                                10))
                        (set! line-start (+ (load line-end) 2))
                        (set! line-start (+ (load line-end) 1)))))))
    (if (> (len (load stack)) 1)
        (set! (mut (.indentation-tokens state))
              (slice-len source)
              (- 1 (len (load stack))))
        0)
    (al/al-free! (mut stack)))
  0)

(defn consume-indentation-token! [(state (mut ParseState))
                                  (at i64)
                                  (sign i64)] (-> bool)
  (let [count (* (indentation-token-at state at) sign)]
    (if (> count 0)
        (let [(mut change) (primitive/zeroed IndentationChange)]
          (set! (.at change) at)
          (set! (.sign change) sign)
          (push! (mut (.indentation-changes state)) (load change))
          (set! (mut (.indentation-tokens state))
                at
                (- (indentation-token-at state at) sign))
          true)
        false)))

(defn restore-indentation-changes! [(state (mut ParseState))
                                    (count i64)] (-> i64)
  (loop (if (<= (len (.indentation-changes state)) count)
            (break)
            (let [change
                    (get (.indentation-changes state)
                         (- (len (.indentation-changes state)) 1))]
              (set! (mut (.indentation-tokens state))
                    (.at change)
                    (+ (indentation-token-at state (.at change)) (.sign change)))
              (pop! (mut (.indentation-changes state))))))
  0)

(defn begin-memo-examination! [(state (mut ParseState)) (start i64)] (-> i64)
  (push! (mut (.examined-stack state)) start)
  (push! (mut (.failure-examined-stack state)) -1)
  0)

(defn finish-memo-examination! [(state (mut ParseState))
                                (rule-id i64)
                                (start i64)] (-> i64)
  (let [examined (get (.examined-stack state) (- (len (.examined-stack state)) 1))
        failure-examined
          (get (.failure-examined-stack state)
               (- (len (.failure-examined-stack state)) 1))]
    (pop! (mut (.examined-stack state)))
    (pop! (mut (.failure-examined-stack state)))
    (let [index (memo-find-any state rule-id start)]
      (if (>= index 0)
          (let [entry (al/al-elem [MemoEntry] (mut (.memo state)) index)]
            (if (> examined (.examined-end entry))
                (set! (.examined-end entry) examined)
                0)
            (if (> failure-examined (.failure-position entry))
                (set! (.failure-position entry) failure-examined)
                0))
          0))
    (note-examined! (mut state) examined)
    examined))

(defn note-expression-examined! [(state (mut ParseState))
                                 (source (slice u8))
                                 (start i64)
                                 (end i64)
                                 (failure-probe i64)] (-> i64)
  (note-examined! (mut state)
                  (if (>= end 0)
                      end
                      (if (< failure-probe 0)
                          (slice-len source)
                          (+ start failure-probe))))
  end)

(defn literal-examined-end [(source (slice u8))
                            (at i64)
                            (literal (slice u8))] (-> i64)
  (let [(mut offset) 0 (mut done) false]
    (loop (if (or (load done) (>= (load offset) (slice-len literal)))
              (break)
              (let [source-at (+ at (load offset))]
                (if (>= source-at (slice-len source))
                    (do
                      (set! offset (+ (load offset) 1))
                      (set! done true))
                    (if (= (slice-get source source-at) (slice-get literal (load offset)))
                        (set! offset (+ (load offset) 1))
                        (do
                          (set! offset (+ (load offset) 1))
                          (set! done true)))))))
    (let [examined (+ at (load offset))]
      examined)))

(defn new-parse-cache [(a (dyn alloc/Allocator))] (-> ParseCache)
  (let [(mut cache) (primitive/zeroed ParseCache)]
    (set! (.memo cache) (al/al-new [MemoEntry] a))
    (set! (.memo-nodes cache) (al/al-new [CstNode] a))
    (set! (.memo-expectations cache) (al/al-new [Expectation] a))
    (set! (.memo-trace-events cache) (al/al-new [TraceEvent] a))
    (set! (.stable-identities cache) (al/al-new [StableNodeIdentity] a))
    (set! (.allocator cache) a)
    (set! (.generation cache) 0)
    (set! (.reuse-count cache) 0)
    (set! (.next-node-id cache) 1)
    (load cache)))

(defn new-parse-state-from-cache! [(cache (mut ParseCache))] (-> ParseState)
  (let [(mut state) (new-parse-state (.allocator cache))]
    (al/al-free! (mut (.memo state)))
    (al/al-free! (mut (.memo-nodes state)))
    (al/al-free! (mut (.memo-expectations state)))
    (al/al-free! (mut (.memo-trace-events state)))
    (al/al-free! (mut (.stable-identities state)))
    (set! (.memo state) (.memo cache))
    (set! (.memo-nodes state) (.memo-nodes cache))
    (set! (.memo-expectations state) (.memo-expectations cache))
    (set! (.memo-trace-events state) (.memo-trace-events cache))
    (set! (.stable-identities state) (.stable-identities cache))
    (set! (.memo cache) (al/al-new [MemoEntry] (.allocator cache)))
    (set! (.memo-nodes cache) (al/al-new [CstNode] (.allocator cache)))
    (set! (.memo-expectations cache) (al/al-new [Expectation] (.allocator cache)))
    (set! (.memo-trace-events cache) (al/al-new [TraceEvent] (.allocator cache)))
    (set! (.stable-identities cache)
          (al/al-new [StableNodeIdentity] (.allocator cache)))
    (set! (.generation cache) (+ (.generation cache) 1))
    (set! (.cache-generation state) (.generation cache))
    (set! (.next-node-id state) (.next-node-id cache))
    (load state)))

(defn global-node-id-counter [] (-> (ptr i64))
  (let [counter (primitive/alloc-static i64)]
    (if (= (load counter) 0) (store! counter 1) 0)
    counter))

(defn next-node-id! [(state (mut ParseState))] (-> i64)
  (let [counter (global-node-id-counter)
        id (load counter)]
    (store! counter (+ id 1))
    (set! (.next-node-id state) (+ id 1))
    id))

(defn free-parse-cache! [(cache (mut ParseCache))] (-> i64)
  (al/al-free! (mut (.memo cache)))
  (al/al-free! (mut (.memo-nodes cache)))
  (al/al-free! (mut (.memo-expectations cache)))
  (al/al-free! (mut (.memo-trace-events cache)))
  (al/al-free! (mut (.stable-identities cache)))
  0)

(defn enable-tracing! [(state (mut ParseState))] (-> i64)
  (set! (.tracing state) true)
  0)

(defn trace-enter-kind-source! [(state (mut ParseState))
                                (display (slice u8))
                                (start i64)
                                (kind i64)
                                (expression-source-start i64)
                                (expression-source-end i64)] (-> i64)
  (if (not (.tracing state))
      -1
      (let [(mut event) (primitive/zeroed TraceEvent)
            index (len (.trace-events state))]
        (set! (.display event) display)
        (set! (.kind event) kind)
        (set! (.start event) start)
        (set! (.end event) start)
        (set! (.expression-source-start event) expression-source-start)
        (set! (.expression-source-end event) expression-source-end)
        (set! (.parent event)
              (if (= (len (.trace-stack state)) 0)
                  -1
                  (get (.trace-stack state) (- (len (.trace-stack state)) 1))))
        (set! (.binding event) -1)
        (set! (.first-binding event) -1)
        (set! (.binding-count event) 0)
        (set! (.prior-binding event)
              (if (= (len (.frames state)) 0)
                  (.root state)
                  (.last-child (current-frame state))))
        (set! (.terminating-entry event) -1)
        (set! (.succeeded event) false)
        (push! (mut (.trace-events state)) (load event))
        (push! (mut (.trace-stack state)) index)
        index)))

(defn trace-enter-kind! [(state (mut ParseState))
                         (display (slice u8))
                         (start i64)
                         (kind i64)] (-> i64)
  (trace-enter-kind-source! (mut state) display start kind -1 -1))

(defn trace-capture-bindings! [(state (ptr ParseState))
                               (event (mut TraceEvent))] (-> i64)
  (if (.trace-only-bindings event)
      0
      (let [prior (.prior-binding event)
        last
          (if (= (len (.frames state)) 0)
              (.root state)
              (.last-child (current-frame state)))]
    (if (= prior last)
        (do
          (set! (.binding event) -1)
          (set! (.first-binding event) -1)
          (set! (.binding-count event) 0))
        (let [first
                (if (< prior 0)
                    (if (= (len (.frames state)) 0)
                        (.root state)
                        (.first-child (current-frame state)))
                    (let [prior-node (get (.nodes state) prior)]
                      (.next-sibling prior-node)))
              (mut child) first
              (mut count) 0]
          (loop (if (< (load child) 0)
                    (break)
                    (let [node (get (.nodes state) (load child))]
                      (set! count (+ (load count) 1))
                      (if (= (load child) last)
                          (set! child -1)
                          (set! child (.next-sibling node))))))
          (set! (.binding event) last)
          (set! (.first-binding event) first)
          (set! (.binding-count event) (load count))))
        0)))

(defn trace-preserve-current-bindings! [(state (mut ParseState))
                                        (node-start i64)] (-> i64)
  (if (and (.tracing state) (> (len (.trace-stack state)) 0))
      (let [event-index (get (.trace-stack state)
                             (- (len (.trace-stack state)) 1))
            event (al/al-elem [TraceEvent]
                              (mut (.trace-events state))
                              event-index)]
        (trace-capture-bindings! state event)
        (preserve-rewound-trace-bindings! (mut state) node-start))
      0))

(defn trace-enter! [(state (mut ParseState))
                    (display (slice u8))
                    (start i64)] (-> i64)
  (trace-enter-kind! (mut state) display start 0))

(defn trace-normalize-splice! [(state (mut ParseState)) (index i64)] (-> i64)
  (let [(mut child-number) 0
        (mut event-index) (+ index 1)]
    (loop (if (>= (load event-index) (len (.trace-events state)))
              (break)
              (let [child (al/al-elem [TraceEvent]
                                      (mut (.trace-events state))
                                      (load event-index))]
                (if (= (.parent child) index)
                    (do
                      (if (= (load child-number) 1) (set! (.kind child) 1) 0)
                      (set! child-number (+ (load child-number) 1)))
                    0)
                (set! event-index (+ (load event-index) 1)))))
    0))

(defn trace-exit! [(state (mut ParseState)) (index i64) (end i64)] (-> i64)
  (if (< index 0)
      end
      (do
        (pop! (mut (.trace-stack state)))
        (let [event (al/al-elem [TraceEvent] (mut (.trace-events state)) index)]
          (if (and (>= end 0) (= (.kind event) 2))
              (trace-normalize-splice! (mut state) index)
              0)
          (set! (.succeeded event) (>= end 0))
          (set! (.end event)
                (if (>= end 0)
                    end
                    (if (> (.end event) (.start event)) (.end event) (.start event))))
          (if (and (>= end 0) (>= (.terminating-entry event) 0))
              (set! (.end (al/al-elem [TraceEvent]
                                       (mut (.trace-events state))
                                       (.terminating-entry event)))
                    end)
              0)
          (trace-capture-bindings! state event)
          (if (and (< end 0) (> (.binding-count event) 0))
              (let [last-binding
                      (if (.trace-only-bindings event)
                          (get (.trace-nodes state) (.binding event))
                          (get (.nodes state) (.binding event)))]
                (if (> (.end last-binding) (.end event))
                    (set! (.end event) (.end last-binding))
                    0))
              0))
        end)))

(defn trace-note-current-end! [(state (mut ParseState)) (end i64)] (-> i64)
  (if (and (.tracing state) (> (len (.trace-stack state)) 0))
      (let [index (get (.trace-stack state) (- (len (.trace-stack state)) 1))
            event (al/al-elem [TraceEvent] (mut (.trace-events state)) index)]
        (if (> end (.end event)) (set! (.end event) end) 0))
      0)
  end)

(defn trace-exit-failed-at! [(state (mut ParseState))
                             (index i64)
                             (examined-end i64)] (-> i64)
  (if (>= index 0)
      (set! (.end (al/al-elem [TraceEvent] (mut (.trace-events state)) index))
            examined-end)
      0)
  (trace-exit! (mut state) index -1))

(defn trace-set-implicit-spaces! [(state (mut ParseState)) (index i64)] (-> i64)
  (if (>= index 0)
      (set! (.implicit-spaces (al/al-elem [TraceEvent]
                                           (mut (.trace-events state))
                                           index))
            true)
      0)
  index)

(defn trace-set-memoized! [(state (mut ParseState)) (index i64)] (-> i64)
  (if (>= index 0)
      (set! (.memoized (al/al-elem [TraceEvent]
                                    (mut (.trace-events state))
                                    index))
            true)
      0)
  index)

(defn push-trace-only-node! [(state (mut ParseState))
                             (rule (slice u8))
                             (start i64)
                             (end i64)
                             (first-child i64)
                             (last-child i64)] (-> i64)
  (let [(mut node) (primitive/zeroed CstNode)
        index (len (.trace-nodes state))]
    (set! (.id node) (next-node-id! (mut state)))
    (set! (.rule node) rule)
    (set! (.start node) start)
    (set! (.end node) end)
    (set! (.first-child node) first-child)
    (set! (.last-child node) last-child)
    (set! (.next-sibling node) -1)
    (push! (mut (.trace-nodes state)) (load node))
    index))

(defn trace-set-trace-only-binding! [(state (mut ParseState))
                                     (event-index i64)
                                     (node i64)] (-> i64)
  (if (>= event-index 0)
      (let [event (al/al-elem [TraceEvent]
                              (mut (.trace-events state))
                              event-index)]
        (set! (.binding event) node)
        (set! (.first-binding event) node)
        (set! (.binding-count event) 1)
        (set! (.trace-only-bindings event) true))
      0)
  node)

(defn trace-mark-current-left-recursion-head! [(state (mut ParseState))] (-> i64)
  (if (or (not (.tracing state)) (= (len (.trace-stack state)) 0))
      -1
      (let [index (get (.trace-stack state) (- (len (.trace-stack state)) 1))]
        (set! (.head-of-left-recursion (al/al-elem [TraceEvent]
                                                    (mut (.trace-events state))
                                                    index))
              true)
        index)))

(defn trace-left-recursion-iteration-enter! [(state (mut ParseState))
                                             (head i64)] (-> i64)
  (if (< head 0)
      -1
      (let [head-event (get (.trace-events state) head)]
        (trace-enter! (mut state) (.display head-event) (.start head-event)))))

(defn trace-left-recursion-iteration-exit! [(state (mut ParseState))
                                            (entry i64)
                                            (end i64)] (-> i64)
  (trace-exit! (mut state) entry end))

(defn trace-truncate! [(state (mut ParseState)) (count i64)] (-> i64)
  (loop (if (<= (len (.trace-events state)) count)
            (break)
            (pop! (mut (.trace-events state)))))
  0)

(defn trace-left-recursion-accept! [(state (mut ParseState))
                                    (head i64)
                                    (entry i64)] (-> i64)
  (if (< entry 0)
      0
      (let [source-start (+ entry 1)
            source-end (len (.trace-events state))
            destination-start (+ head 1)
            count (- source-end source-start)]
        (for [offset 0 count]
          (let [source-event (get (.trace-events state) (+ source-start offset))
                (mut event) (copy-trace-event source-event)]
            (set! (.parent event)
                  (cond (= (.parent source-event) -2) -2
                        (= (.parent source-event) entry) head
                        (>= (.parent source-event) source-start)
                          (+ destination-start (- (.parent source-event) source-start))
                        :else (.parent source-event)))
            (if (>= (.terminating-entry source-event) source-start)
                (set! (.terminating-entry event)
                      (+ destination-start
                         (- (.terminating-entry source-event) source-start)))
                0)
            (store! (al/al-elem [TraceEvent]
                                (mut (.trace-events state))
                                (+ destination-start offset))
                    (load event))))
        (trace-truncate! (mut state) (+ destination-start count)))))

(defn trace-left-recursion-terminate! [(state (mut ParseState))
                                       (head i64)
                                       (entry i64)] (-> i64)
  (if (or (< head 0) (< entry 0))
      0
      (do
        (set! (.parent (al/al-elem [TraceEvent] (mut (.trace-events state)) entry)) -2)
        (set! (.terminates-left-recursion
                (al/al-elem [TraceEvent] (mut (.trace-events state)) entry))
              true)
        (set! (.succeeded (al/al-elem [TraceEvent] (mut (.trace-events state)) entry))
              false)
        (set! (.terminating-entry
                (al/al-elem [TraceEvent] (mut (.trace-events state)) head))
              entry)
        0)))

;; Record the application of the implicit `spaces` rule without adding its
;; bindings to the user's CST. This mirrors MatchState.maybeSkipSpacesBefore:
;; even a zero-width successful application is observable in a trace.
(defn trace-skip-spaces! [(state (mut ParseState))
                         (source (slice u8))
                         (at i64)] (-> i64)
  (let [spaces-event (trace-enter! (mut state) "spaces" at)
        _ (trace-set-implicit-spaces! (mut state) spaces-event)
        _ (trace-set-memoized! (mut state) spaces-event)
        star-event (trace-enter! (mut state) "space*" at)
        (mut cursor) at
        (mut end) at
        (mut first-space-node) -1
        (mut last-space-node) -1]
    (loop (let [next
                  (if (input-visible-at? state (load end))
                      (match-space source (load end))
                      -1)]
            (if (< next 0)
                (break)
                (set! end next))))
    (loop (if (>= (load cursor) (load end))
              (break)
              (let [space-event (trace-enter! (mut state) "space" (load cursor))
                    _ (trace-set-memoized! (mut state) space-event)
                    primitive-event
                      (trace-enter! (mut state) "\"\\u0000\"..\" \"" (load cursor))
                    next
                      (let [ordinary
                              (if (input-visible-at? state (load cursor))
                                  (match-space source (load cursor))
                                  -1)]
                        (if (>= ordinary 0)
                            ordinary
                            (load end)))]
                (let [terminal-node
                        (push-trace-only-node! (mut state)
                                               "_terminal"
                                               (load cursor)
                                               next
                                               -1
                                               -1)
                      space-node
                        (push-trace-only-node! (mut state)
                                               "space"
                                               (load cursor)
                                               next
                                               terminal-node
                                               terminal-node)]
                  (if (>= (load last-space-node) 0)
                      (set! (.next-sibling
                              (al/al-elem [CstNode]
                                          (mut (.trace-nodes state))
                                          (load last-space-node)))
                            space-node)
                      (set! first-space-node space-node))
                  (set! last-space-node space-node)
                  (trace-exit! (mut state) primitive-event next)
                  (trace-set-trace-only-binding! (mut state)
                                                 primitive-event
                                                 terminal-node)
                  (trace-exit! (mut state) space-event next)
                  (trace-set-trace-only-binding! (mut state) space-event space-node))
                (set! cursor next))))
    ;; Ohm's Star trace includes its final failed probe.
    (let [failed-space (trace-enter! (mut state) "space" (load end))
          _ (trace-set-memoized! (mut state) failed-space)
          failed-primitive (trace-enter! (mut state) "\"\\u0000\"..\" \"" (load end))]
      (trace-exit-failed-at! (mut state) failed-primitive (+ (load end) 1))
      (trace-exit! (mut state) failed-space -1))
    (trace-exit! (mut state) star-event (load end))
    (let [iteration-node
            (push-trace-only-node! (mut state)
                                   "_iter"
                                   at
                                   (load end)
                                   (load first-space-node)
                                   (load last-space-node))
          spaces-node
            (push-trace-only-node! (mut state)
                                   "spaces"
                                   at
                                   (load end)
                                   iteration-node
                                   iteration-node)]
      (trace-set-trace-only-binding! (mut state) star-event iteration-node)
      (trace-exit! (mut state) spaces-event (load end))
      (trace-set-trace-only-binding! (mut state) spaces-event spaces-node)
      (load end))))

(defn record-expectation! [(state (mut ParseState))
                           (at i64)
                           (text (slice u8))
                           (type i64)] (-> i64)
  (note-failure-examined! (mut state) at)
  (if (> at (.farthest state))
      (do
        (set! (.farthest state) at)
        (loop (if (= (len (.expectations state)) 0)
                  (break)
                  (pop! (mut (.expectations state))))))
      0)
  (if (= at (.farthest state))
      (let [(mut found) false]
        (for [index 0 (len (.expectations state))]
          (let [existing (get (.expectations state) index)]
            (if (and (= (.type existing) type)
                     (str/str-eq (.text existing) text))
                (do
                  ;; A real failure subsumes an earlier fluffy copy.
                  (set! (.fluffy (al/al-elem [Expectation] (mut (.expectations state)) index))
                        false)
                  (set! found true))
                0)))
        (if (not (load found))
            (let [(mut expectation) (primitive/zeroed Expectation)]
              (set! (.text expectation) text)
              (set! (.type expectation) type)
              (set! (.order expectation) (.next-expectation-order state))
              (set! (.fluffy expectation) false)
              (set! (.next-expectation-order state) (+ (.next-expectation-order state) 1))
              (push! (mut (.expectations state)) (load expectation)))
            0))
      0)
  -1)

(defn merge-recorded-expectation! [(state (mut ParseState))
                                   (at i64)
                                   (expectation Expectation)] (-> i64)
  (note-failure-examined! (mut state) at)
  (if (> at (.farthest state))
      (do
        (set! (.farthest state) at)
        (loop (if (= (len (.expectations state)) 0)
                  (break)
                  (pop! (mut (.expectations state))))))
      0)
  (if (= at (.farthest state))
      (let [(mut found) false]
        (for [index 0 (len (.expectations state))]
          (let [existing (get (.expectations state) index)]
            (if (and (= (.type existing) (.type expectation))
                     (str/str-eq (.text existing) (.text expectation)))
                (do
                  (if (and (.fluffy existing) (not (.fluffy expectation)))
                      (set! (.fluffy (al/al-elem [Expectation]
                                                 (mut (.expectations state))
                                                 index))
                            false)
                      0)
                  (set! found true))
                0)))
        (if (not (load found))
            (push! (mut (.expectations state)) expectation)
            0))
      0)
  -1)

(defn failure-order-mark [(state (ptr ParseState))] (-> i64)
  (.next-expectation-order state))

(defn mark-failures-fluffy! [(state (mut ParseState)) (order-mark i64) (end i64)] (-> i64)
  (if (= end (.farthest state))
      (for [index 0 (len (.expectations state))]
        (let [expectation (get (.expectations state) index)]
          (set! (.fluffy (al/al-elem [Expectation]
                                     (mut (.expectations state))
                                     index))
                true)))
      0)
  0)

(defn failure-snapshot [(state (ptr ParseState))] (-> FailureSnapshot)
  (let [(mut snapshot) (primitive/zeroed FailureSnapshot)]
    (set! (.expectations snapshot) (al/al-new [Expectation] (.allocator state)))
    (for expectation
      (iter (.expectations state))
      (push! (mut (.expectations snapshot)) expectation))
    (set! (.farthest snapshot) (.farthest state))
    (load snapshot)))

(defn restore-failures! [(state (mut ParseState))
                         (snapshot (mut FailureSnapshot))] (-> i64)
  (loop (if (= (len (.expectations state)) 0)
            (break)
            (pop! (mut (.expectations state)))))
  (for expectation
    (iter (.expectations snapshot))
    (push! (mut (.expectations state)) expectation))
  (set! (.farthest state) (.farthest snapshot))
  (al/al-free! (mut (.expectations snapshot)))
  0)

(defn discard-failure-snapshot! [(snapshot (mut FailureSnapshot))] (-> i64)
  (al/al-free! (mut (.expectations snapshot)))
  0)

(defn current-frame [(state (ptr ParseState))] (-> (ptr CstFrame))
  (al/al-elem [CstFrame] (field state frames) (- (len (.frames state)) 1)))

(defn begin-rule! [(state (mut ParseState))] (-> i64)
  (let [(mut frame) (primitive/zeroed CstFrame)]
    (set! (.first-child frame) -1)
    (set! (.last-child frame) -1)
    (set! (.indentation-change-count frame) (len (.indentation-changes state)))
    (push! (mut (.frames state)) (load frame))
    (len (.nodes state))))

(defn rollback-nodes! [(state (mut ParseState)) (count i64)] (-> i64)
  (loop (if (<= (len (.nodes state)) count)
            (break)
            (pop! (mut (.nodes state)))))
  0)

(defn fail-rule! [(state (mut ParseState)) (checkpoint i64) (at i64)] (-> i64)
  (rollback-nodes! (mut state) checkpoint)
  (let [frame (current-frame state)]
    (restore-indentation-changes! (mut state) (.indentation-change-count frame)))
  (pop! (mut (.frames state)))
  -1)

(defn attach-child! [(state (mut ParseState)) (child i64)] (-> i64)
  (if (= (len (.frames state)) 0)
      (set! (.root state) child)
      (let [frame (current-frame state)]
        (if (< (.last-child frame) 0)
            (set! (.first-child frame) child)
            (set! (.next-sibling (al/al-elem [CstNode]
                                             (field state nodes)
                                             (.last-child frame)))
                  child))
        (set! (.last-child frame) child)))
  child)

(defn succeed-rule! [(state (mut ParseState))
                     (rule (slice u8))
                     (start i64)
                     (end i64)] (-> i64)
  (let [frame (get (.frames state) (- (len (.frames state)) 1))
        (mut node) (primitive/zeroed CstNode)]
    (pop! (mut (.frames state)))
    (set! (.id node) (next-node-id! (mut state)))
    (set! (.rule node) rule)
    (set! (.start node) start)
    (set! (.end node) end)
    (set! (.first-child node) (.first-child frame))
    (set! (.last-child node) (.last-child frame))
    (set! (.next-sibling node) -1)
    (let [index (len (.nodes state))]
      (push! (mut (.nodes state)) (load node))
      (attach-child! (mut state) index)
      end)))

;; Dynamic start parameters can change the runtime binding arity of a rule
;; body. Ohm still removes only the rule body's statically declared arity from
;; its binding stack, leaving any excess bindings before the rule node. The
;; leaked binding becomes the public root, whose source interval is subsequently
;; widened to the complete successful match just like Ohm's Node wrapper.
(defn succeed-dynamic-rule! [(state (mut ParseState))
                             (rule (slice u8))
                             (start i64)
                             (end i64)
                             (static-arity i64)] (-> i64)
  (let [frame-index (- (len (.frames state)) 1)
        frame (get (.frames state) frame-index)
        (mut count) 0
        (mut child) (.first-child frame)]
    (loop (if (< (load child) 0)
              (break)
              (let [node (get (.nodes state) (load child))]
                (set! count (+ (load count) 1))
                (set! child (.next-sibling node)))))
    (if (<= (load count) static-arity)
        (succeed-rule! (mut state) rule start end)
        (let [leaked-count (- (load count) static-arity)
              (mut leaked-last) (.first-child frame)]
          (for [_ 1 leaked-count]
            (let [leaked-node (get (.nodes state) (load leaked-last))]
              (set! leaked-last (.next-sibling leaked-node))))
          (let [leaked-last-node (get (.nodes state) (load leaked-last))
                kept-first (.next-sibling leaked-last-node)
                leaked-first (.first-child frame)
                kept-last (.last-child frame)
                (mut node) (primitive/zeroed CstNode)]
            (set! (.next-sibling (al/al-elem [CstNode]
                                             (field state nodes)
                                             (load leaked-last)))
                  -1)
            (pop! (mut (.frames state)))
            (if (= (len (.frames state)) 0)
                (set! (.root state) leaked-first)
                (let [parent (current-frame state)]
                  (if (< (.last-child parent) 0)
                      (set! (.first-child parent) leaked-first)
                      (set! (.next-sibling (al/al-elem [CstNode]
                                                       (field state nodes)
                                                       (.last-child parent)))
                            leaked-first))
                  (set! (.last-child parent) (load leaked-last))))
            (set! (.id node) (next-node-id! (mut state)))
            (set! (.rule node) rule)
            (set! (.start node) start)
            (set! (.end node) end)
            (set! (.first-child node) kept-first)
            (set! (.last-child node) kept-last)
            (set! (.next-sibling node) -1)
            (let [index (len (.nodes state))]
              (push! (mut (.nodes state)) (load node))
              (if (> (len (.frames state)) 0)
                  (attach-child! (mut state) index)
                  0)
              end))))))

(defn begin-iteration [(state (mut ParseState)) (arity i64)] (-> IterationBuilder)
  (let [(mut builder) (primitive/zeroed IterationBuilder)]
    (set! (.roots builder) (al/al-new [i64] (.allocator state)))
    (set! (.arity builder) arity)
    (set! (.rows builder) 0)
    (load builder)))

(defn iteration-capture-row! [(state (mut ParseState))
                              (builder (mut IterationBuilder))] (-> i64)
  (let [frame (current-frame state)
        (mut child) (.first-child frame)]
    (for [_ 0 (.arity builder)]
      (push! (mut (.roots builder)) (load child))
      (let [child-node (get (.nodes state) (load child))]
        (set! child (.next-sibling child-node))))
    (set! (.first-child frame) -1)
    (set! (.last-child frame) -1)
    (set! (.rows builder) (+ (.rows builder) 1))
    0))

(defn discard-iteration! [(builder (mut IterationBuilder))] (-> i64)
  (al/al-free! (mut (.roots builder)))
  0)

(defn nullable-iteration-error [(expression (slice u8))
                                (operator (slice u8))
                                (dynamic-argument i64)
                                (grammar-source (slice u8))
                                (error-start i64)
                                (error-end i64)
                                (state (ptr ParseState))] (-> i64)
  (if (and (>= error-start 0) (> (slice-len grammar-source) 0))
      (let [interval
              (new-ohm-interval
                grammar-source
                (source-byte-position-to-utf16 grammar-source error-start)
                (source-byte-position-to-utf16 grammar-source error-end))
            excerpt
              (ohm-interval-line-column-message! (.allocator state) interval)]
        (io/print-str (io/stderr) excerpt)
        (alloc/free [u8] (.allocator state) excerpt))
      0)
  (io/print-str (io/stderr) "Nullable expression ")
  (if (>= dynamic-argument 0)
      (let [argument (get (.start-arguments state) dynamic-argument)]
        (if (= (.kind argument) 0)
            (do
              (io/print-str (io/stderr) "\"")
              0)
            0)
        (io/print-str (io/stderr) (.text argument))
        (if (= (.kind argument) 0)
            (do
              (io/print-str (io/stderr) "\"")
              0)
            0)
        0)
      (do
        (io/print-str (io/stderr) expression)
        0))
  (io/print-str (io/stderr) " is not allowed inside '")
  (io/print-str (io/stderr) operator)
  (io/print-str (io/stderr) "' (possible infinite loop)\n")
  (if (> (len (.applications state)) 0)
      (do
        (io/print-str (io/stderr) "Application stack (most recent application last):\n")
        (for application
          (iter (.applications state))
          (do
            (io/print-str (io/stderr) application)
            (io/print-str (io/stderr) "\n"))))
      0)
  (alloc/abort))

(defn push-application! [(state (mut ParseState)) (application (slice u8))] (-> i64)
  (push! (mut (.applications state)) application)
  0)

(defn pop-application! [(state (mut ParseState))] (-> i64)
  (pop! (mut (.applications state)))
  0)

(defn unknown-start-rule [(rule (slice u8))] (-> i64)
  (io/print-str (io/stderr) "Rule ")
  (io/print-str (io/stderr) rule)
  (io/print-str (io/stderr) " is not declared in this grammar\n")
  (alloc/abort))

(defn wrong-start-parameter-count [(rule (slice u8))
                                   (expected i64)
                                   (actual i64)
                                   (grammar-source (slice u8))
                                   (error-start i64)
                                   (error-end i64)] (-> i64)
  (if (and (>= error-start 0) (> (slice-len grammar-source) 0))
      (let [interval
              (new-ohm-interval
                grammar-source
                (source-byte-position-to-utf16 grammar-source error-start)
                (source-byte-position-to-utf16 grammar-source error-end))
            excerpt
              (ohm-interval-line-column-message!
                (alloc/malloc-allocator) interval)]
        (io/print-str (io/stderr) excerpt)
        (alloc/free [u8] (alloc/malloc-allocator) excerpt))
      0)
  (io/print-str (io/stderr) "Wrong number of parameters for rule ")
  (io/print-str (io/stderr) rule)
  (io/print-str (io/stderr) " (expected ")
  (let [(mut count) (str/sb-new (alloc/malloc-allocator))]
    (str/sb-push-i64! (mut count) expected)
    (io/print-str (io/stderr) (str/sb-finish! (mut count))))
  (io/print-str (io/stderr) ", got ")
  (let [(mut count) (str/sb-new (alloc/malloc-allocator))]
    (str/sb-push-i64! (mut count) actual)
    (io/print-str (io/stderr) (str/sb-finish! (mut count))))
  (io/print-str (io/stderr) ")\n")
  (alloc/abort))

(defn start-argument-skip-space [(source (slice u8)) (at i64) (limit i64)] (-> i64)
  (let [(mut cursor) at
        (mut moving) true]
    (loop (if (or (not (load moving)) (>= (load cursor) limit))
              (break)
              (let [value (primitive/cast i64 (slice-get source (load cursor)))]
                (cond (<= value 32) (set! cursor (+ (load cursor) 1))
                      (and (= value 47)
                           (< (+ (load cursor) 1) limit)
                           (= (primitive/cast i64 (slice-get source (+ (load cursor) 1))) 47))
                        (do
                          (set! cursor (+ (load cursor) 2))
                          (loop (if (or (>= (load cursor) limit)
                                        (= (primitive/cast i64 (slice-get source (load cursor))) 10))
                                    (break)
                                    (set! cursor (+ (load cursor) 1)))))
                      (and (= value 47)
                           (< (+ (load cursor) 1) limit)
                           (= (primitive/cast i64 (slice-get source (+ (load cursor) 1))) 42))
                        (let [(mut found) false]
                          (set! cursor (+ (load cursor) 2))
                          (loop (if (>= (+ (load cursor) 1) limit)
                                    (break)
                                    (if (and (= (primitive/cast i64 (slice-get source (load cursor))) 42)
                                             (= (primitive/cast i64
                                                                (slice-get source (+ (load cursor) 1)))
                                                47))
                                        (do
                                          (set! cursor (+ (load cursor) 2))
                                          (set! found true)
                                          (break))
                                        (set! cursor (+ (load cursor) 1)))))
                          (if (not (load found)) (set! cursor (+ limit 1)) 0))
                      :else (set! moving false)))))
    (load cursor)))

(defn start-argument-quote-end [(source (slice u8)) (at i64) (limit i64)] (-> i64)
  (let [(mut cursor) at]
    (loop (if (or (>= (load cursor) limit)
                  (= (primitive/cast i64 (slice-get source (load cursor))) 34)
                  (= (primitive/cast i64 (slice-get source (load cursor))) 92))
              (break)
              (store! cursor (+ (load cursor) 1))))
    (load cursor)))

(defn start-hex-value [(value i64)] (-> i64)
  (cond (and (>= value 48) (<= value 57)) (- value 48)
        (and (>= value 65) (<= value 70)) (+ 10 (- value 65))
        (and (>= value 97) (<= value 102)) (+ 10 (- value 97))
        :else -1))

(defn push-start-utf8! [(builder (mut str/StrBuf)) (value i64)] (-> bool)
  (if (or (< value 0)
          (> value 1114111)
          (and (>= value 55296) (<= value 57343)))
      false
      (do
        (cond (<= value 127) (str/sb-push-byte! (mut builder) (primitive/cast u8 value))
              (<= value 2047)
                (do
                  (str/sb-push-byte! (mut builder)
                                     (primitive/cast u8 (+ 192 (/ value 64))))
                  (str/sb-push-byte! (mut builder)
                                     (primitive/cast u8 (+ 128 (% value 64)))))
              (<= value 65535)
                (do
                  (str/sb-push-byte! (mut builder)
                                     (primitive/cast u8 (+ 224 (/ value 4096))))
                  (str/sb-push-byte! (mut builder)
                                     (primitive/cast u8 (+ 128 (% (/ value 64) 64))))
                  (str/sb-push-byte! (mut builder)
                                     (primitive/cast u8 (+ 128 (% value 64)))))
              :else
                (do
                  (str/sb-push-byte! (mut builder)
                                     (primitive/cast u8 (+ 240 (/ value 262144))))
                  (str/sb-push-byte! (mut builder)
                                     (primitive/cast u8 (+ 128 (% (/ value 4096) 64))))
                  (str/sb-push-byte! (mut builder)
                                     (primitive/cast u8 (+ 128 (% (/ value 64) 64))))
                  (str/sb-push-byte! (mut builder)
                                     (primitive/cast u8 (+ 128 (% value 64))))))
        true)))

(defn decode-start-terminal! [(state (mut ParseState))
                              (source (slice u8))
                              (at i64)
                              (limit i64)] (-> DecodedStartTerminal)
  (let [(mut result) (primitive/zeroed DecodedStartTerminal)
        (mut builder) (str/sb-new (.allocator state))
        (mut cursor) at
        (mut valid) true
        (mut closed) false]
    (loop (if (or (load closed)
                  (not (load valid))
                  (>= (load cursor) limit))
              (break)
              (let [value (primitive/cast i64 (slice-get source (load cursor)))]
                (cond (= value 34)
                        (do
                          (set! cursor (+ (load cursor) 1))
                          (set! closed true))
                      (= value 10) (set! valid false)
                      (= value 92)
                        (if (>= (+ (load cursor) 1) limit)
                            (set! valid false)
                            (let [escape (primitive/cast i64 (slice-get source (+ (load cursor) 1)))]
                              (cond (= escape 98)
                                      (do
                                        (str/sb-push-byte! (mut builder) (primitive/cast u8 8))
                                        (set! cursor (+ (load cursor) 2)))
                                    (= escape 110)
                                      (do
                                        (str/sb-push-byte! (mut builder) (primitive/cast u8 10))
                                        (set! cursor (+ (load cursor) 2)))
                                    (= escape 114)
                                      (do
                                        (str/sb-push-byte! (mut builder) (primitive/cast u8 13))
                                        (set! cursor (+ (load cursor) 2)))
                                    (= escape 116)
                                      (do
                                        (str/sb-push-byte! (mut builder) (primitive/cast u8 9))
                                        (set! cursor (+ (load cursor) 2)))
                                    (or (= escape 92) (= escape 34) (= escape 39))
                                      (do
                                        (str/sb-push-byte! (mut builder) (primitive/cast u8 escape))
                                        (set! cursor (+ (load cursor) 2)))
                                    (= escape 120)
                                      (if (>= (+ (load cursor) 3) limit)
                                          (set! valid false)
                                          (let [a
                                                  (start-hex-value (primitive/cast i64
                                                                                   (slice-get source
                                                                                              (+ (load cursor) 2))))
                                                b
                                                  (start-hex-value (primitive/cast i64
                                                                                   (slice-get source
                                                                                              (+ (load cursor) 3))))]
                                            (if (or (< a 0) (< b 0))
                                                (set! valid false)
                                                (do
                                                  (push-start-utf8! (mut builder) (+ (* a 16) b))
                                                  (set! cursor (+ (load cursor) 4))))))
                                    (= escape 117)
                                      (let [(mut scalar) 0
                                            (mut digits) 0
                                            braced
                                              (and (< (+ (load cursor) 2) limit)
                                                   (= (primitive/cast i64
                                                                      (slice-get source (+ (load cursor) 2)))
                                                      123))
                                            (mut digit-at) (+ (load cursor) (if braced 3 2))
                                            wanted (if braced 6 4)]
                                        (loop (if (or (>= (load digit-at) limit)
                                                      (>= (load digits) wanted))
                                                  (break)
                                                  (let [hex
                                                          (start-hex-value (primitive/cast i64
                                                                                           (slice-get source
                                                                                                      (load digit-at))))]
                                                    (if (< hex 0)
                                                        (break)
                                                        (do
                                                          (set! scalar (+ (* (load scalar) 16) hex))
                                                          (set! digits (+ (load digits) 1))
                                                          (set! digit-at (+ (load digit-at) 1)))))))
                                        (if (or (= (load digits) 0)
                                                (and (not braced) (not (= (load digits) 4)))
                                                (and braced
                                                     (or (>= (load digit-at) limit)
                                                         (not (= (primitive/cast i64
                                                                                 (slice-get source
                                                                                            (load digit-at)))
                                                                 125))))
                                                (not (push-start-utf8! (mut builder) (load scalar))))
                                            (set! valid false)
                                            (set! cursor (+ (load digit-at) (if braced 1 0)))))
                                    :else (set! valid false))))
                      :else
                        (do
                          (str/sb-push-byte! (mut builder) (primitive/cast u8 value))
                          (set! cursor (+ (load cursor) 1)))))))
    (let [text (str/sb-finish! (mut builder))]
      (push! (mut (.owned-names state)) text)
      (set! (.text result) text)
      (set! (.end result) (load cursor))
      (set! (.valid result) (and (load valid) (load closed)))
      (load result))))

(defn start-argument-name-char? [(value i64)] (-> bool)
  (or (= value 95)
      (and (>= value 48) (<= value 57))
      (and (>= value 65) (<= value 90))
      (and (>= value 97) (<= value 122))))

(defn start-argument-name-end [(source (slice u8)) (at i64) (limit i64)] (-> i64)
  (let [(mut cursor) at
        (mut first) true]
    (loop (if (>= (load cursor) limit)
              (break)
              (let [scalar (decode-utf8 source (load cursor))
                    letter
                      (and (.valid scalar)
                           (or (= (.value scalar) 95)
                               (unicode/unicode-letter? (.value scalar))))
                    digit
                      (and (not (load first))
                           (= (.width scalar) 1)
                           (>= (.value scalar) 48)
                           (<= (.value scalar) 57))]
                (if (or letter digit)
                    (do
                      (set! cursor (+ (load cursor) (.width scalar)))
                      (set! first false))
                    (break)))))
    (load cursor)))

(defn push-start-expression! [(state (mut ParseState))
                              (kind i64)
                              (text (slice u8))
                              (text2 (slice u8))
                              (children (slice i64))
                              (source-start i64)
                              (source-end i64)] (-> i64)
  (let [(mut expression) (primitive/zeroed StartExpression)
        child-start (len (.start-expression-children state))
        index (len (.start-expressions state))]
    (for child (iter children) (push! (mut (.start-expression-children state)) child))
    (set! (.kind expression) kind)
    (set! (.text expression) text)
    (set! (.text2 expression) text2)
    (set! (.child-start expression) child-start)
    (set! (.child-count expression) (slice-len children))
    (set! (.source-start expression) source-start)
    (set! (.source-end expression) source-end)
    (push! (mut (.start-expressions state)) (load expression))
    index))

(defn push-start-leaf! [(state (mut ParseState))
                        (kind i64)
                        (text (slice u8))
                        (text2 (slice u8))
                        (source-start i64)
                        (source-end i64)] (-> i64)
  (let [(mut children) (al/al-new [i64] (.allocator state))
        result
          (push-start-expression! (mut state)
                                  kind
                                  text
                                  text2
                                  (al/al-slice [i64] (load children))
                                  source-start
                                  source-end)]
    (al/al-free! (mut children))
    result))

(defn start-expression-child [(state (ptr ParseState))
                              (expression i64)
                              (child i64)] (-> i64)
  (let [node (get (.start-expressions state) expression)]
    (get (.start-expression-children state) (+ (.child-start node) child))))

(defn start-expression-node [(state (ptr ParseState)) (expression i64)] (-> StartExpression)
  (get (.start-expressions state) expression))

(defn start-expression-kind [(state (ptr ParseState)) (expression i64)] (-> i64)
  (let [node (start-expression-node state expression)] (.kind node)))

(defn start-expression-text [(state (ptr ParseState))
                             (expression i64)] (-> (slice u8))
  (let [node (start-expression-node state expression)] (.text node)))

(defn start-expression-child-count [(state (ptr ParseState))
                                    (expression i64)] (-> i64)
  (let [node (start-expression-node state expression)] (.child-count node)))

(defn set-start-expression-dispatcher! [(state (mut ParseState))
                                        (dispatcher (fnptr c
                                                           [(mut ParseState) (slice u8) i64 i64 bool]
                                                           i64))] (-> i64)
  (set! (.start-expression-dispatcher state) dispatcher)
  0)

(defn set-parse-grammar-name! [(state (mut ParseState)) (name (slice u8))] (-> i64)
  (push! (mut (.grammar-names state)) name)
  (set! (.grammar-name state) name)
  0)

(defn add-parse-grammar-name! [(state (mut ParseState)) (name (slice u8))] (-> i64)
  (push! (mut (.grammar-names state)) name)
  (set! (.grammar-name state) name)
  0)

(defn set-parse-grammar-token! [(state (mut ParseState)) (token (ptr u8))] (-> i64)
  (set! (.grammar-token state) token)
  0)

(defn add-semantic-rule! [(state (mut ParseState))
                          (name (slice u8))
                          (arity i64)] (-> i64)
  (let [(mut found) false]
    (for [index 0 (len (.semantic-rules state))]
      (let [rule (get (.semantic-rules state) index)]
        (if (str/str-eq (.name rule) name)
            (do
              (set! (.arity (al/al-elem [SemanticRule]
                                        (field state semantic-rules)
                                        index))
                    arity)
              (set! found true)
              0)
            0)))
    (if (not (load found))
        (let [(mut rule) (primitive/zeroed SemanticRule)]
          (set! (.name rule) name)
          (set! (.arity rule) arity)
          (push! (mut (.semantic-rules state)) (load rule)))
        0)
    0))

(defn parse-start-base! [(state (mut ParseState))
                         (source (slice u8))
                         (cursor (mut i64))
                         (limit i64)] (-> i64)
  (set! cursor (start-argument-skip-space source (load cursor) limit))
  (if (>= (load cursor) limit)
      -1
      (let [start (load cursor)
            value (primitive/cast i64 (slice-get source start))]
        (cond (= value 34)
                (let [first (decode-start-terminal! (mut state) source (+ start 1) limit)]
                  (if (not (.valid first))
                      -1
                      (let [after-first (start-argument-skip-space source (.end first) limit)]
                        (if (and (< (+ after-first 2) limit)
                                 (= (primitive/cast i64 (slice-get source after-first)) 46)
                                 (= (primitive/cast i64 (slice-get source (+ after-first 1))) 46))
                            (let [second-start (start-argument-skip-space source (+ after-first 2) limit)]
                              (if (or (>= second-start limit)
                                      (not (= (primitive/cast i64 (slice-get source second-start)) 34)))
                                  -1
                                  (let [second
                                          (decode-start-terminal! (mut state)
                                                                  source
                                                                  (+ second-start 1)
                                                                  limit)]
                                    (if (not (.valid second))
                                        -1
                                        (do
                                          (set! cursor (.end second))
                                          (push-start-leaf! (mut state)
                                                            2
                                                            (.text first)
                                                            (.text second)
                                                            start
                                                            (.end second)))))))
                            (do
                              (set! cursor (.end first))
                              (push-start-leaf! (mut state)
                                                0
                                                (.text first)
                                                ""
                                                start
                                                (.end first)))))))
              (= value 40)
                (do
                  (set! cursor (+ start 1))
                  (let [body (parse-start-alt! (mut state) source (mut cursor) limit)]
                    (set! cursor (start-argument-skip-space source (load cursor) limit))
                    (if (or (< body 0)
                            (>= (load cursor) limit)
                            (not (= (primitive/cast i64 (slice-get source (load cursor))) 41)))
                        -1
                        (do (set! cursor (+ (load cursor) 1)) body))))
              :else
                (let [name-end (start-argument-name-end source start limit)]
                  (if (= name-end start)
                      -1
                      (let [(mut children) (al/al-new [i64] (.allocator state))]
                        (set! cursor name-end)
                        (set! cursor (start-argument-skip-space source (load cursor) limit))
                        (if (and (< (load cursor) limit)
                                 (= (primitive/cast i64 (slice-get source (load cursor))) 60))
                            (do
                              (set! cursor (+ (load cursor) 1))
                              (set! cursor (start-argument-skip-space source (load cursor) limit))
                              (if (and (< (load cursor) limit)
                                       (not (= (primitive/cast i64 (slice-get source (load cursor))) 62)))
                                  (let [(mut reading) true]
                                    (loop (if (not (load reading))
                                              (break)
                                              (let [argument (parse-start-seq! (mut state) source (mut cursor) limit)]
                                                (if (< argument 0)
                                                    (set! reading false)
                                                    (do
                                                      (push! (mut children) argument)
                                                      (set! cursor
                                                            (start-argument-skip-space source
                                                                                       (load cursor)
                                                                                       limit))
                                                      (if (and (< (load cursor) limit)
                                                               (= (primitive/cast i64
                                                                                  (slice-get source
                                                                                             (load cursor)))
                                                                  44))
                                                          (set! cursor (+ (load cursor) 1))
                                                          (set! reading false))))))))
                                  0)
                              (set! cursor (start-argument-skip-space source (load cursor) limit))
                              (if (and (< (load cursor) limit)
                                       (= (primitive/cast i64 (slice-get source (load cursor))) 62))
                                  (set! cursor (+ (load cursor) 1))
                                  (set! cursor (+ limit 1))))
                            0)
                        (let [end (load cursor)
                              result
                                (if (> end limit)
                                    -1
                                    (push-start-expression! (mut state)
                                                            1
                                                            (subslice source start name-end)
                                                            ""
                                                            (al/al-slice [i64] (load children))
                                                            start
                                                            end))]
                          (al/al-free! (mut children))
                          result))))))))

(defn parse-start-lex! [(state (mut ParseState))
                        (source (slice u8))
                        (cursor (mut i64))
                        (limit i64)] (-> i64)
  (set! cursor (start-argument-skip-space source (load cursor) limit))
  (if (and (< (load cursor) limit)
           (= (primitive/cast i64 (slice-get source (load cursor))) 35))
      (let [start (load cursor)]
        (set! cursor (+ start 1))
        (let [child (parse-start-base! (mut state) source (mut cursor) limit)
              (mut children) (al/al-new [i64] (.allocator state))]
          (if (>= child 0) (push! (mut children) child) 0)
          (let [result
                  (if (< child 0)
                      -1
                      (push-start-expression! (mut state)
                                              10
                                              ""
                                              ""
                                              (al/al-slice [i64] (load children))
                                              start
                                              (load cursor)))]
            (al/al-free! (mut children))
            result)))
      (parse-start-base! (mut state) source (mut cursor) limit)))

(defn parse-start-pred! [(state (mut ParseState))
                         (source (slice u8))
                         (cursor (mut i64))
                         (limit i64)] (-> i64)
  (set! cursor (start-argument-skip-space source (load cursor) limit))
  (if (and (< (load cursor) limit)
           (or (= (primitive/cast i64 (slice-get source (load cursor))) 126)
               (= (primitive/cast i64 (slice-get source (load cursor))) 38)))
      (let [start (load cursor)
            kind (if (= (primitive/cast i64 (slice-get source start)) 126) 8 9)]
        (set! cursor (+ start 1))
        (let [child (parse-start-lex! (mut state) source (mut cursor) limit)
              (mut children) (al/al-new [i64] (.allocator state))]
          (if (>= child 0) (push! (mut children) child) 0)
          (let [result
                  (if (< child 0)
                      -1
                      (push-start-expression! (mut state)
                                              kind
                                              ""
                                              ""
                                              (al/al-slice [i64] (load children))
                                              start
                                              (load cursor)))]
            (al/al-free! (mut children))
            result)))
      (parse-start-lex! (mut state) source (mut cursor) limit)))

(defn parse-start-iter! [(state (mut ParseState))
                         (source (slice u8))
                         (cursor (mut i64))
                         (limit i64)] (-> i64)
  (let [start (load cursor)
        child (parse-start-pred! (mut state) source (mut cursor) limit)]
    (set! cursor (start-argument-skip-space source (load cursor) limit))
    (if (or (< child 0)
            (>= (load cursor) limit)
            (not (or (= (primitive/cast i64 (slice-get source (load cursor))) 42)
                     (= (primitive/cast i64 (slice-get source (load cursor))) 43)
                     (= (primitive/cast i64 (slice-get source (load cursor))) 63))))
        child
        (let [operator (primitive/cast i64 (slice-get source (load cursor)))
              kind (cond (= operator 42) 5 (= operator 43) 6 :else 7)
              (mut children) (al/al-new [i64] (.allocator state))]
          (set! cursor (+ (load cursor) 1))
          (push! (mut children) child)
          (let [result
                  (push-start-expression! (mut state)
                                          kind
                                          ""
                                          ""
                                          (al/al-slice [i64] (load children))
                                          start
                                          (load cursor))]
            (al/al-free! (mut children))
            result)))))

(defn parse-start-seq! [(state (mut ParseState))
                        (source (slice u8))
                        (cursor (mut i64))
                        (limit i64)] (-> i64)
  (let [start (load cursor)
        (mut children) (al/al-new [i64] (.allocator state))
        (mut valid) true
        (mut reading) true]
    (loop (if (or (not (load reading)) (not (load valid)))
              (break)
              (do
                (set! cursor (start-argument-skip-space source (load cursor) limit))
                (if (or (>= (load cursor) limit)
                        (= (primitive/cast i64 (slice-get source (load cursor))) 44)
                        (= (primitive/cast i64 (slice-get source (load cursor))) 62)
                        (= (primitive/cast i64 (slice-get source (load cursor))) 41)
                        (= (primitive/cast i64 (slice-get source (load cursor))) 124))
                    (set! reading false)
                    (let [child (parse-start-iter! (mut state) source (mut cursor) limit)]
                      (if (< child 0)
                          (set! valid false)
                          (push! (mut children) child)))))))
    (let [result
            (if (not (load valid))
                -1
                (push-start-expression! (mut state)
                                        3
                                        ""
                                        ""
                                        (al/al-slice [i64] (load children))
                                        start
                                        (load cursor)))]
      (al/al-free! (mut children))
      result)))

(defn parse-start-alt! [(state (mut ParseState))
                        (source (slice u8))
                        (cursor (mut i64))
                        (limit i64)] (-> i64)
  (let [start (load cursor)
        (mut children) (al/al-new [i64] (.allocator state))
        first (parse-start-seq! (mut state) source (mut cursor) limit)
        (mut valid) (>= first 0)]
    (if (load valid) (push! (mut children) first) 0)
    (loop (set! cursor (start-argument-skip-space source (load cursor) limit))
      (if (or (not (load valid))
              (>= (load cursor) limit)
              (not (= (primitive/cast i64 (slice-get source (load cursor))) 124)))
          (break)
          (do
            (set! cursor (+ (load cursor) 1))
            (let [choice (parse-start-seq! (mut state) source (mut cursor) limit)]
              (if (< choice 0)
                  (set! valid false)
                  (push! (mut children) choice))))))
    (let [result
            (if (not (load valid))
                -1
                (push-start-expression! (mut state)
                                        4
                                        ""
                                        ""
                                        (al/al-slice [i64] (load children))
                                        start
                                        (load cursor)))]
      (al/al-free! (mut children))
      result)))

(defn start-rule-eq? [(requested (slice u8)) (expected (slice u8))] (-> bool)
  (let [limit (slice-len requested)
        start (start-argument-skip-space requested 0 limit)
        after-name (+ start (slice-len expected))]
    (if (or (> start limit) (> after-name limit))
        false
        (let [(mut matches) true]
          (for [index 0 (slice-len expected)]
            (if (not (= (slice-get requested (+ start index))
                        (slice-get expected index)))
                (set! matches false)
                0))
          (and (load matches)
               (= (start-argument-skip-space requested after-name limit) limit))))))

;; Returns -1 when `requested` is not an application of `rule`; otherwise
;; counts its top-level comma-separated actual parameters. Commas inside
;; terminals, nested applications, and parenthesized expressions do not split.
(defn start-application-argument-count [(requested (slice u8))
                                        (rule (slice u8))] (-> i64)
  (let [limit (slice-len requested)
        start (start-argument-skip-space requested 0 limit)
        after-name (+ start (slice-len rule))
        (mut matches) (<= after-name limit)]
    (for [index 0 (slice-len rule)]
      (if (and (load matches)
               (not (= (slice-get requested (+ start index))
                       (slice-get rule index))))
          (set! matches false)
          0))
    (let [open (if (load matches)
                   (start-argument-skip-space requested after-name limit)
                   limit)]
      (if (or (not (load matches))
              (>= open limit)
              (not (= (primitive/cast i64 (slice-get requested open)) 60)))
          -1
          (let [(mut at) (+ open 1)
                (mut count) 0
                (mut angle-depth) 1
                (mut paren-depth) 0
                (mut quoted) false
                (mut escaped) false
                (mut saw-value) false]
            (loop (if (or (>= (load at) limit) (= (load angle-depth) 0))
                      (break)
                      (let [value (primitive/cast i64 (slice-get requested (load at)))]
                        (if (load quoted)
                            (cond (load escaped) (set! escaped false)
                                  (= value 92) (set! escaped true)
                                  (= value 34) (set! quoted false)
                                  :else 0)
                            (cond (= value 34) (do (set! quoted true) (set! saw-value true))
                                  (= value 40) (do (set! paren-depth (+ (load paren-depth) 1))
                                                   (set! saw-value true))
                                  (= value 41) (set! paren-depth (- (load paren-depth) 1))
                                  (= value 60) (do (set! angle-depth (+ (load angle-depth) 1))
                                                   (set! saw-value true))
                                  (= value 62) (set! angle-depth (- (load angle-depth) 1))
                                  (and (= value 44)
                                       (= (load angle-depth) 1)
                                       (= (load paren-depth) 0))
                                    (set! count (+ (load count) 1))
                                  (> value 32) (set! saw-value true)
                                  :else 0))
                        (set! at (+ (load at) 1)))))
            (if (not (load saw-value)) 0 (+ (load count) 1)))))))

(defn prepare-start-application! [(state (mut ParseState))
                                  (requested (slice u8))
                                  (rule (slice u8))
                                  (expected i64)] (-> bool)
  (let [rule-length (slice-len rule)
        requested-length (slice-len requested)
        application-start (start-argument-skip-space requested 0 requested-length)]
    (let [(mut prefix-matches)
            (and (<= application-start requested-length)
                 (>= (- requested-length application-start) (+ rule-length 2)))]
      (for [index 0 rule-length]
        (if (and (load prefix-matches)
                 (not (= (slice-get requested (+ application-start index))
                         (slice-get rule index))))
            (set! prefix-matches false)
            0))
      (if (and (load prefix-matches)
               (= (primitive/cast i64
                                  (slice-get requested (+ application-start rule-length)))
                  60))
          (let [(mut at) (+ (+ application-start rule-length) 1)
                limit requested-length
                (mut valid) true]
            (loop (if (= (len (.start-arguments state)) 0)
                      (break)
                      (pop! (mut (.start-arguments state)))))
            (loop (if (= (len (.start-expressions state)) 0)
                      (break)
                      (pop! (mut (.start-expressions state)))))
            (loop (if (= (len (.start-expression-children state)) 0)
                      (break)
                      (pop! (mut (.start-expression-children state)))))
            (set! (.start-application state) requested)
            (for [index 0 expected]
              (if (load valid)
                  (do
                    (store! at (start-argument-skip-space requested (load at) limit))
                    (if (>= (load at) limit)
                        (set! valid false)
                        (let [root (parse-start-seq! (mut state) requested (mut at) limit)]
                          (if (< root 0)
                              (set! valid false)
                              (let [sequence (start-expression-node state root)
                                    expression
                                      (if (and (= (.kind sequence) 3)
                                               (= (.child-count sequence) 1))
                                          (start-expression-child state root 0)
                                          root)
                                    node (start-expression-node state expression)
                                    (mut argument) (primitive/zeroed StartArgument)]
                                ;; Grammar construction restricts rule arguments to arity one,
                                ;; but Grammar.match's dynamic start application intentionally
                                ;; accepts an arbitrary well-formed parsing expression. In
                                ;; particular, Ohm treats App<"a""b"> as one sequence argument.
                                (if (not (start-expression-well-formed? state expression))
                                    (set! valid false)
                                    (do
                                      (set! (.root argument) expression)
                                      (set! (.text argument) (.text node))
                                      (set! (.text2 argument) (.text2 node))
                                      (set! (.kind argument)
                                            (cond (= (.kind node) 0) 0
                                                  (and (= (.kind node) 1)
                                                       (= (.child-count node) 0))
                                                    1
                                                  (= (.kind node) 2) 2
                                                  :else 3))
                                      (push! (mut (.start-arguments state)) (load argument))
                                      (store! at (start-argument-skip-space requested (load at) limit))
                                      (if (< (+ index 1) expected)
                                          (if (and (< (load at) limit)
                                                   (= (primitive/cast i64
                                                                      (slice-get requested (load at)))
                                                      44))
                                              (store! at (+ (load at) 1))
                                              (set! valid false))
                                          0))))))))
                  0))
            (set! at (start-argument-skip-space requested (load at) limit))
            (and (load valid)
                 (< (load at) limit)
                 (= (primitive/cast i64 (slice-get requested (load at))) 62)
                 (= (start-argument-skip-space requested (+ (load at) 1) limit) limit)
                 (= (len (.start-arguments state)) expected)))
          false))))

(defn start-expression-arity [(state (ptr ParseState)) (expression i64)] (-> i64)
  (let [node (start-expression-node state expression)]
    (cond (or (= (.kind node) 0) (= (.kind node) 1) (= (.kind node) 2)) 1
          (= (.kind node) 8) 0
          (= (.kind node) 3)
            (let [(mut arity) 0]
              (for [child 0 (.child-count node)]
                (set! arity
                      (+ (load arity)
                         (start-expression-arity state
                                                 (start-expression-child state expression child)))))
              (load arity))
          (or (= (.kind node) 4)
              (= (.kind node) 5)
              (= (.kind node) 6)
              (= (.kind node) 7)
              (= (.kind node) 9)
              (= (.kind node) 10))
            (if (= (.child-count node) 0)
                0
                (start-expression-arity state (start-expression-child state expression 0)))
          :else 0)))

(defn start-expression-well-formed? [(state (ptr ParseState))
                                     (expression i64)] (-> bool)
  (let [node (start-expression-node state expression)
        (mut valid) true]
    (if (and (= (.kind node) 4) (> (.child-count node) 0))
        (let [expected (start-expression-arity state (start-expression-child state expression 0))]
          (for [child 0 (.child-count node)]
            (let [child-expression (start-expression-child state expression child)]
              (if (or (not (= (start-expression-arity state child-expression) expected))
                      (not (start-expression-well-formed? state child-expression)))
                  (set! valid false)
                  0))))
        (for [child 0 (.child-count node)]
          (let [child-expression (start-expression-child state expression child)]
            (if (or (and (= (.kind node) 1)
                         (not (= (start-expression-arity state child-expression) 1)))
                    (not (start-expression-well-formed? state child-expression)))
                (set! valid false)
                0))))
    (load valid)))

(defn match-start-expression-range! [(state (mut ParseState))
                                     (source (slice u8))
                                     (at i64)
                                     (node StartExpression)] (-> i64)
  (let [low (decode-utf8 (.text node) 0)
        high (decode-utf8 (.text2 node) 0)
        (mut expectation) (str/sb-new (.allocator state))]
    (if (or (not (.valid low))
            (not (.valid high))
            (not (= (.width low) (slice-len (.text node))))
            (not (= (.width high) (slice-len (.text2 node)))))
        -1
        (do
          (str/sb-push-str! (mut expectation) "\"")
          (str/sb-push-str! (mut expectation) (.text node))
          (str/sb-push-str! (mut expectation) "\"..\"")
          (str/sb-push-str! (mut expectation) (.text2 node))
          (str/sb-push-str! (mut expectation) "\"")
          (let [expected-text (str/sb-finish! (mut expectation))]
            (push! (mut (.owned-names state)) expected-text)
            (match-range-cst! (mut state)
                              source
                              at
                              (.value low)
                              (.value high)
                              expected-text))))))

(defn match-start-expression-application! [(state (mut ParseState))
                                           (source (slice u8))
                                           (at i64)
                                           (expression i64)
                                           (lexical bool)] (-> i64)
  (let [node (start-expression-node state expression)
        start (if lexical at (skip-spaces source at))]
    (if (> (.child-count node) 0)
        (if (and (str/str-eq (.text node) "caseInsensitive")
                 (= (.child-count node) 1))
            (let [argument-index (start-expression-child state expression 0)
                  sequence (start-expression-node state argument-index)
                  argument
                    (if (and (= (.kind sequence) 3) (= (.child-count sequence) 1))
                        (start-expression-child state argument-index 0)
                        argument-index)
                  argument-node (start-expression-node state argument)]
              (if (not (= (.kind argument-node) 0))
                  -1
                  (let [checkpoint (begin-rule! (mut state))
                        (mut expected-builder) (str/sb-new (.allocator state))]
                    (str/sb-push-str! (mut expected-builder) "\"")
                    (str/sb-push-str! (mut expected-builder) (.text argument-node))
                    (str/sb-push-str! (mut expected-builder) "\" (case-insensitive)")
                    (let [expected (str/sb-finish! (mut expected-builder))]
                      (push! (mut (.owned-names state)) expected)
                      (let [end
                              (match-case-insensitive-literal-cst! (mut state)
                                                                   source
                                                                   start
                                                                   (.text argument-node)
                                                                   expected)]
                        (if (< end 0)
                            (fail-rule! (mut state) checkpoint start)
                            (succeed-rule! (mut state) "caseInsensitive" start end)))))))
            (let [dispatcher (.start-expression-dispatcher state)]
              (primitive/call-ptr dispatcher
                                  (mut state)
                                  source
                                  at
                                  expression
                                  lexical)))
        (cond (str/str-eq (.text node) "any") (match-any-rule-cst! (mut state) source start)
              (str/str-eq (.text node) "end") (match-end-cst! (mut state) source start)
              (str/str-eq (.text node) "space") (match-space-cst! (mut state) source start)
              (str/str-eq (.text node) "spaces") (match-spaces-cst! (mut state) source start)
              (str/str-eq (.text node) "letter") (match-letter-cst! (mut state) source start)
              (str/str-eq (.text node) "digit") (match-digit-cst! (mut state) source start)
              (str/str-eq (.text node) "alnum") (match-alnum-cst! (mut state) source start)
              (str/str-eq (.text node) "hexDigit") (match-hex-digit-cst! (mut state) source start)
              (str/str-eq (.text node) "lower") (match-lower-cst! (mut state) source start)
              (str/str-eq (.text node) "upper") (match-upper-cst! (mut state) source start)
              (str/str-eq (.text node) "unicodeLtmo") (match-unicode-ltmo-cst! (mut state) source start)
              :else
                (let [dispatcher (.start-expression-dispatcher state)]
                  (primitive/call-ptr dispatcher
                                      (mut state)
                                      source
                                      at
                                      expression
                                      lexical))))))

(defn push-start-argument-frame! [(state (mut ParseState)) (expression i64)] (-> i64)
  (let [node (start-expression-node state expression)
        frame-start (len (.start-arguments state))]
    (push! (mut (.start-argument-frame-starts state)) frame-start)
    (for [index 0 (.child-count node)]
      (let [sequence-root (start-expression-child state expression index)
            sequence (start-expression-node state sequence-root)
            root
              (if (and (= (.kind sequence) 3) (= (.child-count sequence) 1))
                  (start-expression-child state sequence-root 0)
                  sequence-root)
            argument-node (start-expression-node state root)
            (mut argument) (primitive/zeroed StartArgument)]
        (set! (.root argument) root)
        (set! (.text argument) (.text argument-node))
        (set! (.text2 argument) (.text2 argument-node))
        (set! (.kind argument)
              (cond (= (.kind argument-node) 0) 0
                    (and (= (.kind argument-node) 1)
                         (= (.child-count argument-node) 0))
                      1
                    (= (.kind argument-node) 2) 2
                    :else 3))
        (push! (mut (.start-arguments state)) (load argument))))
    (.child-count node)))

(defn pop-start-argument-frame! [(state (mut ParseState))] (-> i64)
  (let [frame-index (- (len (.start-argument-frame-starts state)) 1)
        frame-start (get (.start-argument-frame-starts state) frame-index)]
    (loop (if (= (len (.start-arguments state)) frame-start)
              (break)
              (pop! (mut (.start-arguments state)))))
    (pop! (mut (.start-argument-frame-starts state)))
    0))

(defn current-start-argument-index [(state (ptr ParseState)) (index i64)] (-> i64)
  (if (= (len (.start-argument-frame-starts state)) 0)
      index
      (+ (get (.start-argument-frame-starts state)
              (- (len (.start-argument-frame-starts state)) 1))
         index)))

(defn match-start-expression-iteration! [(state (mut ParseState))
                                         (source (slice u8))
                                         (at i64)
                                         (expression i64)
                                         (lexical bool)] (-> i64)
  (let [node (start-expression-node state expression)
        child (start-expression-child state expression 0)
        minimum (if (= (.kind node) 6) 1 0)
        maximum (if (= (.kind node) 7) 1 -1)
        optional (= (.kind node) 7)
        arity (start-expression-arity state child)
        rule-checkpoint (begin-rule! (mut state))
        (mut builder) (begin-iteration (mut state) arity)
        (mut cursor) at
        (mut count) 0]
    (loop (if (and (>= maximum 0) (>= (load count) maximum))
              (break)
              0)
      (let [checkpoint (mark state)
            (mut failures) (failure-snapshot state)
            next (match-start-expression-cst! (mut state) source (load cursor) child lexical)]
        (if (< next 0)
            (do
              (rewind! (mut state) checkpoint)
              (if (< (load count) minimum)
                  (discard-failure-snapshot! (mut failures))
                  (restore-failures! (mut state) (mut failures)))
              (break))
            (if (= next (load cursor))
                (nullable-iteration-error (subslice (.start-application state)
                                                    (.source-start node)
                                                    (.source-end node))
                                          (if (= (.kind node) 5) "*" "+")
                                          -1
                                          (.start-application state)
                                          (.source-start node)
                                          (.source-end node)
                                          state)
                (do
                  (discard-failure-snapshot! (mut failures))
                  (iteration-capture-row! (mut state) (mut builder))
                  (set! cursor next)
                  (set! count (+ (load count) 1)))))))
    (if (< (load count) minimum)
        (do
          (discard-iteration! (mut builder))
          (fail-rule! (mut state) rule-checkpoint at))
        (succeed-iteration! (mut state)
                            (mut builder)
                            at
                            (load cursor)
                            optional))))

(defn match-start-expression-cst! [(state (mut ParseState))
                                   (source (slice u8))
                                   (at i64)
                                   (expression i64)
                                   (lexical bool)] (-> i64)
  (let [node (start-expression-node state expression)]
    (cond (= (.kind node) 0)
            (match-literal-cst! (mut state)
                                source
                                (if lexical at (skip-spaces source at))
                                (.text node))
          (= (.kind node) 1) (match-start-expression-application! (mut state) source at expression lexical)
          (= (.kind node) 2)
            (match-start-expression-range! (mut state)
                                           source
                                           (if lexical at (skip-spaces source at))
                                           node)
          (= (.kind node) 3)
            (let [checkpoint (mark state)
                  (mut cursor) at
                  (mut valid) true]
              (for [child 0 (.child-count node)]
                (if (load valid)
                    (let [next
                            (match-start-expression-cst! (mut state)
                                                         source
                                                         (load cursor)
                                                         (start-expression-child state expression child)
                                                         lexical)]
                      (if (< next 0) (set! valid false) (set! cursor next)))
                    0))
              (if (load valid)
                  (load cursor)
                  (do (rewind! (mut state) checkpoint) -1)))
          (= (.kind node) 4)
            (let [(mut answer) -1
                  (mut child) 0]
              (loop (if (or (>= (load answer) 0) (>= (load child) (.child-count node)))
                        (break)
                        (let [checkpoint (mark state)
                              next
                                (match-start-expression-cst! (mut state)
                                                             source
                                                             at
                                                             (start-expression-child state
                                                                                     expression
                                                                                     (load child))
                                                             lexical)]
                          (if (>= next 0)
                              (set! answer next)
                              (do
                                (rewind! (mut state) checkpoint)
                                (set! child (+ (load child) 1)))))))
              (load answer))
          (or (= (.kind node) 5) (= (.kind node) 6) (= (.kind node) 7))
            (match-start-expression-iteration! (mut state) source at expression lexical)
          (= (.kind node) 8)
            (let [checkpoint (mark state)
                  memo-checkpoint (memo-mark state)
                  (mut failures) (failure-snapshot state)
                  answer
                    (match-start-expression-cst! (mut state)
                                                 source
                                                 at
                                                 (start-expression-child state expression 0)
                                                 lexical)]
              (rewind! (mut state) checkpoint)
              (memo-rewind! (mut state) memo-checkpoint)
              (restore-failures! (mut state) (mut failures))
              (if (< answer 0) at -1))
          (= (.kind node) 9)
            (let [memo-checkpoint (memo-mark state)
                  answer
                    (match-start-expression-cst! (mut state)
                                                 source
                                                 at
                                                 (start-expression-child state expression 0)
                                                 lexical)]
              (memo-rewind! (mut state) memo-checkpoint)
              (if (< answer 0) -1 at))
          (= (.kind node) 10)
            (match-start-expression-cst! (mut state)
                                         source
                                         at
                                         (start-expression-child state expression 0)
                                         true)
          :else -1)))

(defn match-start-argument-cst! [(state (mut ParseState))
                                 (source (slice u8))
                                 (at i64)
                                 (index i64)
                                 (lexical bool)] (-> i64)
  (let [index (current-start-argument-index state index)]
    (if (or (< index 0) (>= index (len (.start-arguments state))))
        -1
        (let [argument (get (.start-arguments state) index)
              start (if lexical at (skip-spaces source at))]
          (if (= (.kind argument) 3)
              (match-start-expression-cst! (mut state) source at (.root argument) lexical)
              (if (= (.kind argument) 0)
                  (match-literal-cst! (mut state) source start (.text argument))
                  (if (= (.kind argument) 2)
                      (let [low (decode-utf8 (.text argument) 0)
                            high (decode-utf8 (.text2 argument) 0)
                            (mut expectation) (str/sb-new (.allocator state))]
                        (if (or (not (.valid low))
                                (not (.valid high))
                                (not (= (.width low) (slice-len (.text argument))))
                                (not (= (.width high) (slice-len (.text2 argument)))))
                            -1
                            (do
                              (str/sb-push-str! (mut expectation) "\"")
                              (str/sb-push-str! (mut expectation) (.text argument))
                              (str/sb-push-str! (mut expectation) "\"..\"")
                              (str/sb-push-str! (mut expectation) (.text2 argument))
                              (str/sb-push-str! (mut expectation) "\"")
                              (let [expected-text (str/sb-finish! (mut expectation))]
                                (push! (mut (.owned-names state)) expected-text)
                                (match-range-cst! (mut state)
                                                  source
                                                  start
                                                  (.value low)
                                                  (.value high)
                                                  expected-text)))))
                      (cond (str/str-eq (.text argument) "any") (match-any-rule-cst! (mut state) source start)
                            (str/str-eq (.text argument) "end") (match-end-cst! (mut state) source start)
                            (str/str-eq (.text argument) "space") (match-space-cst! (mut state) source start)
                            (str/str-eq (.text argument) "letter") (match-letter-cst! (mut state) source start)
                            (str/str-eq (.text argument) "digit") (match-digit-cst! (mut state) source start)
                            (str/str-eq (.text argument) "alnum") (match-alnum-cst! (mut state) source start)
                            (str/str-eq (.text argument) "hexDigit") (match-hex-digit-cst! (mut state) source start)
                            (str/str-eq (.text argument) "lower") (match-lower-cst! (mut state) source start)
                            (str/str-eq (.text argument) "upper") (match-upper-cst! (mut state) source start)
                            (str/str-eq (.text argument) "unicodeLtmo")
                              (match-unicode-ltmo-cst! (mut state) source start)
                            :else -1))))))))

(defn start-argument-is-rule? [(state (ptr ParseState)) (index i64)] (-> bool)
  (let [index (current-start-argument-index state index)]
    (and (>= index 0)
         (< index (len (.start-arguments state)))
         (let [argument (get (.start-arguments state) index)]
           (= (.kind argument) 1)))))

(defn start-argument-text [(state (ptr ParseState)) (index i64)] (-> (slice u8))
  (let [argument (get (.start-arguments state) (current-start-argument-index state index))]
    (.text argument)))

(defn match-case-insensitive-start-argument-cst! [(state (mut ParseState))
                                                  (source (slice u8))
                                                  (at i64)
                                                  (index i64)] (-> i64)
  (let [index (current-start-argument-index state index)]
    (if (or (< index 0)
            (>= index (len (.start-arguments state)))
            (let [argument (get (.start-arguments state) index)] (!= (.kind argument) 0)))
        -1
        (let [argument (get (.start-arguments state) index)
              (mut expected-builder) (str/sb-new (.allocator state))]
          (str/sb-push-str! (mut expected-builder) "\"")
          (str/sb-push-str! (mut expected-builder) (.text argument))
          (str/sb-push-str! (mut expected-builder) "\" (case-insensitive)")
          (let [expected (str/sb-finish! (mut expected-builder))]
            (push! (mut (.owned-names state)) expected)
            (let [end
                    (match-case-insensitive-literal-cst! (mut state)
                                                         source
                                                         at
                                                         (.text argument)
                                                         expected)]
              end))))))

(defn match-start-case-insensitive-cst! [(state (mut ParseState))
                                         (source (slice u8))
                                         (at i64)] (-> i64)
  (let [checkpoint (begin-rule! (mut state))
        end (match-case-insensitive-start-argument-cst! (mut state) source at 0)]
    (if (< end 0)
        (fail-rule! (mut state) checkpoint at)
        (succeed-rule! (mut state) "caseInsensitive" at end))))

(defn push-start-application! [(state (mut ParseState))] (-> i64)
  (push! (mut (.applications state)) (.start-application state))
  0)

(defn match-built-in-start! [(state (mut ParseState))
                             (source (slice u8))
                             (at i64)
                             (rule (slice u8))] (-> i64)
  (cond (start-rule-eq? rule "any") (match-any-rule-cst! (mut state) source at)
        (start-rule-eq? rule "end") (match-end-cst! (mut state) source at)
        (start-rule-eq? rule "space") (match-space-cst! (mut state) source at)
        (start-rule-eq? rule "spaces") (match-spaces-cst! (mut state) source at)
        (start-rule-eq? rule "letter") (match-letter-cst! (mut state) source at)
        (start-rule-eq? rule "digit") (match-digit-cst! (mut state) source at)
        (start-rule-eq? rule "alnum") (match-alnum-cst! (mut state) source at)
        (start-rule-eq? rule "hexDigit") (match-hex-digit-cst! (mut state) source at)
        (start-rule-eq? rule "lower") (match-lower-cst! (mut state) source at)
        (start-rule-eq? rule "upper") (match-upper-cst! (mut state) source at)
        (start-rule-eq? rule "unicodeLtmo") (match-unicode-ltmo-cst! (mut state) source at)
        (start-rule-eq? rule "indent") (match-indent-cst! (mut state) at)
        (start-rule-eq? rule "dedent") (match-dedent-cst! (mut state) at)
        :else (unknown-start-rule rule)))

(defn start-application-syntactic? [(requested (slice u8))] (-> bool)
  (let [start (start-argument-skip-space requested 0 (slice-len requested))]
    (and (< start (slice-len requested))
         (let [first (primitive/cast i64 (slice-get requested start))]
           (and (>= first 65) (<= first 90))))))

(defn succeed-iteration! [(state (mut ParseState))
                          (builder (mut IterationBuilder))
                          (at i64)
                          (end i64)
                          (optional bool)] (-> i64)
  (let [arity (.arity builder)
        rows (.rows builder)
        first-node
          (if (> rows 0)
              (get (.nodes state) (get (.roots builder) 0))
              (primitive/zeroed CstNode))
        last-node
          (if (> rows 0)
              (get (.nodes state) (get (.roots builder) (- (* rows arity) 1)))
              (primitive/zeroed CstNode))
        span-start (if (> rows 0) (.start first-node) at)
        span-end (if (> rows 0) (.end last-node) end)]
    (pop! (mut (.frames state)))
    (for [column 0 arity]
      (let [(mut first) -1
            (mut last) -1]
        (for [row 0 rows]
          (let [root (get (.roots builder) (+ (* row arity) column))]
            (if (< (load first) 0) (set! first root) 0)
            (if (>= (load last) 0)
                (set! (.next-sibling (al/al-elem [CstNode]
                                                 (field state nodes)
                                                 (load last)))
                      root)
                0)
            (set! last root)))
        (if (>= (load last) 0)
            (set! (.next-sibling (al/al-elem [CstNode]
                                             (field state nodes)
                                             (load last)))
                  -1)
            0)
        (let [(mut node) (primitive/zeroed CstNode)
              index (len (.nodes state))]
          (set! (.id node) (next-node-id! (mut state)))
          (set! (.rule node) "_iter")
          (set! (.start node) span-start)
          (set! (.end node) span-end)
          (set! (.first-child node) (load first))
          (set! (.last-child node) (load last))
          (set! (.next-sibling node) -1)
          (set! (.optional node) optional)
          (push! (mut (.nodes state)) (load node))
          (attach-child! (mut state) index))))
    (discard-iteration! (mut builder))
    end))

(defn succeed-case-rule! [(state (mut ParseState))
                          (base (slice u8))
                          (label (slice u8))
                          (start i64)
                          (end i64)] (-> i64)
  (let [(mut name) (str/sb-new (.allocator state))]
    (str/sb-push-str! (mut name) base)
    (str/sb-push-str! (mut name) "_")
    (str/sb-push-str! (mut name) label)
    (let [owned (str/sb-finish! (mut name))]
      (push! (mut (.owned-names state)) owned)
      (succeed-rule! (mut state) owned start end))))

(defn mark [(state (ptr ParseState))] (-> CstMark)
  (let [(mut result) (primitive/zeroed CstMark)]
    (set! (.node-count result) (len (.nodes state)))
    (set! (.indentation-change-count result) (len (.indentation-changes state)))
    (if (= (len (.frames state)) 0)
        (do
          (set! (.first-child result) (.root state))
          (set! (.last-child result) (.root state)))
        (let [frame (current-frame state)]
          (set! (.first-child result) (.first-child frame))
          (set! (.last-child result) (.last-child frame))))
    (load result)))

(defn preserve-rewound-trace-bindings! [(state (mut ParseState))
                                        (node-start i64)] (-> i64)
  (if (and (.tracing state) (< node-start (len (.nodes state))))
      (let [destination-start (len (.trace-nodes state))
            source-end (len (.nodes state))]
        (for [source-index node-start source-end]
          (let [source-node (get (.nodes state) source-index)
                (mut node) (primitive/zeroed CstNode)]
            (set! (.id node) (.id source-node))
            (set! (.rule node) (.rule source-node))
            (set! (.start node) (.start source-node))
            (set! (.end node) (.end source-node))
            (set! (.first-child node)
                  (if (>= (.first-child source-node) node-start)
                      (+ destination-start (- (.first-child source-node) node-start))
                      -1))
            (set! (.last-child node)
                  (if (>= (.last-child source-node) node-start)
                      (+ destination-start (- (.last-child source-node) node-start))
                      -1))
            (set! (.next-sibling node)
                  (if (>= (.next-sibling source-node) node-start)
                      (+ destination-start (- (.next-sibling source-node) node-start))
                      -1))
            (set! (.optional node) (.optional source-node))
            (push! (mut (.trace-nodes state)) (load node))))
        (for [event-index 0 (len (.trace-events state))]
          (let [event (al/al-elem [TraceEvent]
                                  (mut (.trace-events state))
                                  event-index)]
            (if (and (not (.trace-only-bindings event))
                     (>= (.first-binding event) node-start))
                (do
                  (set! (.first-binding event)
                        (+ destination-start (- (.first-binding event) node-start)))
                  (set! (.binding event)
                        (+ destination-start (- (.binding event) node-start)))
                  (set! (.trace-only-bindings event) true))
                0))))
      0)
  0)

(defn rewind! [(state (mut ParseState)) (checkpoint CstMark)] (-> i64)
  (rollback-nodes! (mut state) (.node-count checkpoint))
  (restore-indentation-changes! (mut state) (.indentation-change-count checkpoint))
  (if (= (len (.frames state)) 0)
      (set! (.root state) (.first-child checkpoint))
      (let [frame (current-frame state)]
        (set! (.first-child frame) (.first-child checkpoint))
        (set! (.last-child frame) (.last-child checkpoint))
        (if (>= (.last-child frame) 0)
            (set! (.next-sibling (al/al-elem [CstNode]
                                             (field state nodes)
                                             (.last-child frame)))
                  -1)
            0)))
  0)

(defn mark-node-count [(checkpoint CstMark)] (-> i64)
  (.node-count checkpoint))

(defn memo-find [(state (ptr ParseState)) (rule-id i64) (start i64)] (-> i64)
  (let [(mut index) (- (len (.memo state)) 1)
        (mut answer) -1]
    (loop (if (or (< (load index) 0) (>= (load answer) 0))
              (break)
              (let [entry (get (.memo state) (load index))]
                (if (and (= (.rule-id entry) rule-id)
                         (and (= (.start entry) start)
                              (or (not (.tracing state))
                                  (or (= (.generation entry) (.cache-generation state))
                                      (> (.trace-snapshot-count entry) 0)))))
                    (set! answer (load index))
                    (set! index (- (load index) 1))))))
    (load answer)))

(defn memo-find-any [(state (ptr ParseState)) (rule-id i64) (start i64)] (-> i64)
  (let [(mut index) (- (len (.memo state)) 1)
        (mut answer) -1]
    (loop (if (or (< (load index) 0) (>= (load answer) 0))
              (break)
              (let [entry (get (.memo state) (load index))]
                (if (and (= (.rule-id entry) rule-id) (= (.start entry) start))
                    (set! answer (load index))
                    (set! index (- (load index) 1))))))
    (load answer)))

(defn memo-replayed-node-id [(state (ptr ParseState))
                             (rule-name (slice u8))
                             (start i64)
                             (snapshot-id i64)] (-> i64)
  (let [(mut index) 0
        (mut answer) -1
        (mut exact) false]
    (loop (if (or (load exact)
                  (>= (load index) (len (.stable-identities state))))
              (break)
              (let [identity (get (.stable-identities state) (load index))]
                (if (and (= (.start identity) start)
                         (and (= (.snapshot-id identity) snapshot-id)
                              (str/str-eq (.rule-name identity) rule-name)))
                    (if (= (.id identity) snapshot-id)
                        (do
                          (set! answer snapshot-id)
                          (set! exact true))
                        (if (< (load answer) 0)
                            (set! answer (.id identity))
                            0))
                    0)
                (set! index (+ (load index) 1)))))
    (load answer)))

(defn memo-mark [(state (ptr ParseState))] (-> MemoMark)
  (let [(mut checkpoint) (primitive/zeroed MemoMark)]
    (set! (.entry-count checkpoint) (len (.memo state)))
    (set! (.node-count checkpoint) (len (.memo-nodes state)))
    (set! (.expectation-count checkpoint) (len (.memo-expectations state)))
    (set! (.trace-count checkpoint) (len (.memo-trace-events state)))
    (load checkpoint)))

(defn memo-rewind! [(state (mut ParseState)) (checkpoint MemoMark)] (-> i64)
  (loop (if (<= (len (.memo state)) (.entry-count checkpoint))
            (break)
            (pop! (mut (.memo state)))))
  (truncate-memo-nodes! (mut state) (.node-count checkpoint))
  (loop (if (<= (len (.memo-expectations state)) (.expectation-count checkpoint))
            (break)
            (pop! (mut (.memo-expectations state)))))
  (loop (if (<= (len (.memo-trace-events state)) (.trace-count checkpoint))
            (break)
            (pop! (mut (.memo-trace-events state)))))
  0)

(defn memo-begin-named! [(state (mut ParseState))
                         (rule-id i64)
                         (rule-name (slice u8))
                         (start i64)] (-> i64)
  (let [(mut entry) (primitive/zeroed MemoEntry)
        index (len (.memo state))]
    (set! (.rule-id entry) rule-id)
    (set! (.rule-name entry) rule-name)
    (set! (.generation entry) (.cache-generation state))
    (set! (.evaluating entry) true)
    (set! (.start entry) start)
    (set! (.best-end entry) -1)
    (set! (.snapshot-start entry) (len (.memo-nodes state)))
    (set! (.snapshot-count entry) 0)
    (set! (.root-offset entry) -1)
    (set! (.failure-start entry) (len (.memo-expectations state)))
    (set! (.failure-count entry) 0)
    (set! (.failure-position entry) -1)
    (set! (.examined-end entry) start)
    (set! (.trace-source-start entry) (len (.trace-events state)))
    (set! (.trace-snapshot-start entry) (len (.memo-trace-events state)))
    (set! (.trace-snapshot-count entry) 0)
    (push! (mut (.memo state)) (load entry))
    index))

(defn memo-begin! [(state (mut ParseState)) (rule-id i64) (start i64)] (-> i64)
  (memo-begin-named! (mut state) rule-id "" start))

(defn memo-best-end [(state (ptr ParseState)) (index i64)] (-> i64)
  (let [entry (get (.memo state) index)] (.best-end entry)))

(defn memo-finish! [(state (mut ParseState)) (index i64)] (-> i64)
  (set! (.evaluating (al/al-elem [MemoEntry] (mut (.memo state)) index)) false)
  0)

(defn truncate-memo-nodes! [(state (mut ParseState)) (count i64)] (-> i64)
  (loop (if (<= (len (.memo-nodes state)) count)
            (break)
            (pop! (mut (.memo-nodes state)))))
  0)

(defn memo-clear-after! [(state (mut ParseState)) (index i64)] (-> i64)
  (let [entry (get (.memo state) index)
        keep (+ (.snapshot-start entry) (.snapshot-count entry))
        keep-expectations (+ (.failure-start entry) (.failure-count entry))
        keep-traces (+ (.trace-snapshot-start entry) (.trace-snapshot-count entry))]
    (loop (if (<= (len (.memo state)) (+ index 1))
              (break)
              (pop! (mut (.memo state)))))
    (truncate-memo-nodes! (mut state) keep)
    (loop (if (<= (len (.memo-expectations state)) keep-expectations)
              (break)
              (pop! (mut (.memo-expectations state)))))
    (loop (if (<= (len (.memo-trace-events state)) keep-traces)
              (break)
              (pop! (mut (.memo-trace-events state)))))
    0))

(defn memo-trace-mark! [(state (mut ParseState)) (index i64)] (-> i64)
  (set! (.trace-source-start (al/al-elem [MemoEntry] (mut (.memo state)) index))
        (len (.trace-events state)))
  0)

(defn memo-trace-mark-at! [(state (mut ParseState)) (index i64) (at i64)] (-> i64)
  (set! (.trace-source-start (al/al-elem [MemoEntry] (mut (.memo state)) index)) at)
  0)

(defn memo-capture-failures! [(state (mut ParseState)) (index i64)] (-> i64)
  (let [entry (al/al-elem [MemoEntry] (field state memo) index)
        start (len (.memo-expectations state))]
    (set! (.failure-start entry) start)
    (for expectation
      (iter (.expectations state))
      (push! (mut (.memo-expectations state)) expectation))
    (set! (.failure-count entry) (- (len (.memo-expectations state)) start))
    (set! (.failure-position entry) (.farthest state))
    0))

(defn memo-replay-failures! [(state (mut ParseState)) (entry MemoEntry)] (-> i64)
  (if (>= (.failure-position entry) (.farthest state))
      (let [(mut later) (al/al-new [Expectation] (.allocator state))]
        (if (= (.failure-position entry) (.farthest state))
            (for expectation
              (iter (.expectations state))
              (push! (mut later) expectation))
            0)
        (loop (if (= (len (.expectations state)) 0)
                  (break)
                  (pop! (mut (.expectations state)))))
        (set! (.farthest state) (.failure-position entry))
        (for [offset 0 (.failure-count entry)]
          (let [(mut expectation)
                  (get (.memo-expectations state)
                       (+ (.failure-start entry) offset))]
            (if (> (len (load later)) 0)
                (let [first-later (get (load later) 0)]
                  (if (>= (.order first-later) (.failure-count entry))
                      (set! (.order expectation)
                            (+ (- (.order first-later) (.failure-count entry)) offset))
                      0))
                0)
            (merge-recorded-expectation! (mut state)
                                         (.failure-position entry)
                                         (load expectation))))
        (for expectation
          (iter (load later))
          (let [later-expectation expectation]
            (merge-recorded-expectation! (mut state)
                                         (.failure-position entry)
                                         later-expectation)))
        (al/al-free! (mut later)))
      0)
  0)

(defn snapshot-index [(index i64) (source-start i64) (snapshot-start i64)] (-> i64)
  (if (< index 0) -1 (+ snapshot-start (- index source-start))))

(defn memo-capture-trace! [(state (mut ParseState))
                           (index i64)
                           (node-source-start i64)] (-> i64)
  (if (not (.tracing state))
      0
      (let [entry (al/al-elem [MemoEntry] (mut (.memo state)) index)
            trace-source-start (.trace-source-start entry)
            trace-source-end (len (.trace-events state))
            trace-snapshot-start (len (.memo-trace-events state))]
        (set! (.trace-snapshot-start entry) trace-snapshot-start)
        (for [source-index trace-source-start trace-source-end]
          (let [source-event (get (.trace-events state) source-index)
                (mut event) (copy-trace-event source-event)]
            (set! (.parent event)
                  (if (= (.parent source-event) -2)
                      -2
                      (if (>= (.parent source-event) trace-source-start)
                          (+ trace-snapshot-start (- (.parent source-event) trace-source-start))
                          -1)))
            (if (>= (.terminating-entry source-event) trace-source-start)
                (set! (.terminating-entry event)
                      (+ trace-snapshot-start
                         (- (.terminating-entry source-event) trace-source-start)))
                0)
            (set! (.binding event)
                  (if (>= (.binding source-event) node-source-start)
                      (+ (.snapshot-start entry)
                         (- (.binding source-event) node-source-start))
                      -1))
            (set! (.first-binding event)
                  (if (>= (.first-binding source-event) node-source-start)
                      (+ (.snapshot-start entry)
                         (- (.first-binding source-event) node-source-start))
                      -1))
            (set! (.prior-binding event) -1)
            (push! (mut (.memo-trace-events state)) (load event))))
        (set! (.trace-snapshot-count entry) (- trace-source-end trace-source-start))
        0)))

(defn memo-capture! [(state (mut ParseState))
                     (index i64)
                     (source-start i64)
                     (end i64)] (-> i64)
  (let [entry (al/al-elem [MemoEntry] (field state memo) index)
        snapshot-start (len (.memo-nodes state))
        source-end (len (.nodes state))
        count (- source-end source-start)]
    (set! (.snapshot-start entry) snapshot-start)
    (for [source-index source-start source-end]
      (let [source-node (get (.nodes state) source-index)
            (mut node) (primitive/zeroed CstNode)]
        (set! (.rule node) (.rule source-node))
        (set! (.id node) (.id source-node))
        (set! (.start node) (.start source-node))
        (set! (.end node) (.end source-node))
        (set! (.first-child node)
              (snapshot-index (.first-child source-node) source-start snapshot-start))
        (set! (.last-child node)
              (snapshot-index (.last-child source-node) source-start snapshot-start))
        (set! (.next-sibling node)
              (snapshot-index (.next-sibling source-node) source-start snapshot-start))
        (set! (.optional node) (.optional source-node))
        (push! (mut (.memo-nodes state)) (load node))))
    (set! (.best-end entry) end)
    (set! (.snapshot-count entry) count)
    (set! (.root-offset entry) (- count 1))
    (memo-capture-trace! (mut state) index source-start)
    end))

(defn replay-index [(index i64) (snapshot-start i64) (destination-start i64)] (-> i64)
  (if (< index 0) -1 (+ destination-start (- index snapshot-start))))

(defn memo-replay-trace! [(state (mut ParseState))
                          (entry MemoEntry)
                          (node-destination-start i64)] (-> i64)
  (if (or (not (.tracing state)) (= (.trace-snapshot-count entry) 0))
      0
      (let [current
              (if (= (len (.trace-stack state)) 0)
                  -1
                  (get (.trace-stack state) (- (len (.trace-stack state)) 1)))
            (mut has-child) false]
        (for [trace-index 0 (len (.trace-events state))]
          (let [event (get (.trace-events state) trace-index)]
            (if (= (.parent event) current) (set! has-child true) 0)))
        (if (load has-child)
            0
            (let [trace-destination-start (len (.trace-events state))
                  trace-snapshot-end
                    (+ (.trace-snapshot-start entry) (.trace-snapshot-count entry))]
              (if (>= current 0)
                  (set! (.memoized (al/al-elem [TraceEvent]
                                                (mut (.trace-events state))
                                                current))
                        true)
                  0)
              (for [snapshot-index-value (.trace-snapshot-start entry) trace-snapshot-end]
                (let [snapshot-event (get (.memo-trace-events state) snapshot-index-value)
                      (mut event) (copy-trace-event snapshot-event)]
                  (set! (.parent event)
                        (cond (= (.parent snapshot-event) -2) -2
                              (< (.parent snapshot-event) 0) current
                              :else
                                (+ trace-destination-start
                                   (- (.parent snapshot-event) (.trace-snapshot-start entry)))))
                  (if (>= (.terminating-entry snapshot-event) (.trace-snapshot-start entry))
                      (set! (.terminating-entry event)
                            (+ trace-destination-start
                               (- (.terminating-entry snapshot-event)
                                  (.trace-snapshot-start entry))))
                      0)
                  (set! (.binding event)
                        (if (< (.binding snapshot-event) 0)
                            -1
                            (+ node-destination-start
                               (- (.binding snapshot-event) (.snapshot-start entry)))))
                  (set! (.first-binding event)
                        (if (< (.first-binding snapshot-event) 0)
                            -1
                            (+ node-destination-start
                               (- (.first-binding snapshot-event)
                                  (.snapshot-start entry)))))
                  (set! (.prior-binding event) -1)
                  (push! (mut (.trace-events state)) (load event))))
              0)))))

(defn memo-replay! [(state (mut ParseState)) (index i64)] (-> i64)
  (let [entry (get (.memo state) index)]
    (note-examined! (mut state) (.examined-end entry))
    (if (< (.generation entry) (.cache-generation state))
        (set! (.cache-reuse-count state) (+ (.cache-reuse-count state) 1))
        0)
    (if (< (.best-end entry) 0)
        (do
          ;; A recursive application that encounters its still-empty seed is
          ;; represented by Ohm as a non-memoized failed application with one
          ;; `undefined` trace child.
          (if (and (.tracing state)
                   (and (.evaluating entry)
                   (and (= (.snapshot-count entry) 0)
                        (and (= (.trace-snapshot-count entry) 0)
                             (> (len (.trace-stack state)) 0)))))
              (let [event-index (get (.trace-stack state)
                                     (- (len (.trace-stack state)) 1))
                    event (al/al-elem [TraceEvent]
                                      (mut (.trace-events state))
                                      event-index)]
                (set! (.memoized event) false)
                (set! (.undefined-child event) true))
              0)
          (memo-replay-failures! (mut state) entry)
          -1)
        (do
          (memo-replay-failures! (mut state) entry)
          (let [destination-start (len (.nodes state))
                snapshot-end (+ (.snapshot-start entry) (.snapshot-count entry))]
            (for [snapshot-index-value (.snapshot-start entry) snapshot-end]
              (let [snapshot-node (get (.memo-nodes state) snapshot-index-value)
                    (mut node) (primitive/zeroed CstNode)]
                (set! (.rule node) (.rule snapshot-node))
                (let [stable-id
                        (memo-replayed-node-id state
                                               (.rule snapshot-node)
                                               (.start snapshot-node)
                                               (.id snapshot-node))]
                  (set! (.id node)
                        (if (> stable-id 0) stable-id (.id snapshot-node))))
                (set! (.start node) (.start snapshot-node))
                (set! (.end node) (.end snapshot-node))
                (set! (.first-child node)
                      (replay-index (.first-child snapshot-node)
                                    (.snapshot-start entry)
                                    destination-start))
                (set! (.last-child node)
                      (replay-index (.last-child snapshot-node)
                                    (.snapshot-start entry)
                                    destination-start))
                (set! (.next-sibling node)
                      (replay-index (.next-sibling snapshot-node)
                                    (.snapshot-start entry)
                                    destination-start))
                (set! (.optional node) (.optional snapshot-node))
                (push! (mut (.nodes state)) (load node))))
            (memo-replay-trace! (mut state) entry destination-start)
            (attach-child! (mut state) (+ destination-start (.root-offset entry)))
            (.best-end entry))))))

(defn record-terminal! [(state (mut ParseState)) (start i64) (end i64)] (-> i64)
  (let [(mut node) (primitive/zeroed CstNode)
        index (len (.nodes state))]
    (set! (.id node) (next-node-id! (mut state)))
    (set! (.rule node) "_terminal")
    (set! (.start node) start)
    (set! (.end node) end)
    (set! (.first-child node) -1)
    (set! (.last-child node) -1)
    (set! (.next-sibling node) -1)
    (push! (mut (.nodes state)) (load node))
    (attach-child! (mut state) index)
    end))

(defn matched-terminal! [(state (mut ParseState)) (start i64) (end i64)] (-> i64)
  (if (< end 0) -1 (record-terminal! (mut state) start end)))

(defn matched-expected-terminal! [(state (mut ParseState))
                                  (start i64)
                                  (end i64)
                                  (expected (slice u8))
                                  (type i64)] (-> i64)
  (if (< end 0)
      (record-expectation! (mut state) start expected type)
      (record-terminal! (mut state) start end)))

(defn trace-primitive-match! [(state (mut ParseState))
                              (display (slice u8))
                              (at i64)
                              (end i64)] (-> i64)
  (let [event (trace-enter! (mut state) display at)]
    (trace-exit! (mut state) event end)))

(defn primitive-examined-end [(source (slice u8)) (at i64)] (-> i64)
  (if (>= at (slice-len source))
      (+ at 1)
      (let [scalar (decode-utf8 source at)]
        (+ at (if (.valid scalar) (.width scalar) 1)))))

(defn match-traced-builtin-result! [(state (mut ParseState))
                                    (rule (slice u8))
                                    (expected (slice u8))
                                    (display (slice u8))
                                    (start i64)
                                    (end i64)
                                    (examined-end i64)] (-> i64)
  (let [checkpoint (begin-rule! (mut state))
        event (trace-enter! (mut state) display start)]
    (if (< end 0)
        (do
          (trace-exit-failed-at! (mut state) event examined-end)
          (record-expectation! (mut state) start expected 1)
          (fail-rule! (mut state) checkpoint start))
        (do
          (record-terminal! (mut state) start end)
          (trace-exit! (mut state) event end)
          (succeed-rule! (mut state) rule start end)))))

(defn match-traced-expected-terminal! [(state (mut ParseState))
                                       (expected (slice u8))
                                       (display (slice u8))
                                       (start i64)
                                       (end i64)
                                       (examined-end i64)] (-> i64)
  (let [event (trace-enter! (mut state) display start)]
    (if (< end 0)
        (do
          (trace-exit-failed-at! (mut state) event examined-end)
          (record-expectation! (mut state) start expected 1))
        (do
          (record-terminal! (mut state) start end)
          (trace-exit! (mut state) event end)))))

(defn match-literal-cst! [(state (mut ParseState))
                          (source (slice u8))
                          (at i64)
                          (literal (slice u8))] (-> i64)
  (let [end (if (input-visible-at? state at) (match-literal source at literal) -1)]
    (note-examined! (mut state) (literal-examined-end source at literal))
    (trace-note-current-end! (mut state) (literal-examined-end source at literal))
    (matched-expected-terminal! (mut state) at end literal 0)))

(defn match-case-insensitive-literal-cst! [(state (mut ParseState))
                                           (source (slice u8))
                                           (at i64)
                                           (literal (slice u8))
                                           (expected (slice u8))] (-> i64)
  (let [end
          (if (input-visible-at? state at)
              (match-case-insensitive-literal source at literal)
              -1)]
    (note-examined! (mut state)
                    (if (>= end 0)
                        end
                        (literal-examined-end source at literal)))
    (matched-expected-terminal! (mut state) at end expected 1)))

(defn match-range-cst! [(state (mut ParseState))
                        (source (slice u8))
                        (at i64)
                        (lo i64)
                        (hi i64)
                        (expected (slice u8))] (-> i64)
  (let [end (if (input-visible-at? state at) (match-range source at lo hi) -1)]
    (note-examined! (mut state)
                    (if (>= end 0) end (+ at 1)))
    (matched-expected-terminal! (mut state) at end expected 1)))

(defn match-any-cst! [(state (mut ParseState)) (source (slice u8)) (at i64)] (-> i64)
  (let [pending (indentation-token-at state at)
        end (if (= pending 0) (match-any source at) at)
        event (trace-enter! (mut state) "any" at)]
    (note-examined! (mut state)
                    (if (>= end 0) end (+ at 1)))
    (if (= pending 0)
        (if (< end 0)
            (do
              (trace-exit-failed-at! (mut state)
                                     event
                                     (primitive-examined-end source at))
              (record-expectation! (mut state) at "any character" 1))
            (do
              (record-terminal! (mut state) at end)
              (trace-exit! (mut state) event end)))
        (if (consume-indentation-token! (mut state) at (if (> pending 0) 1 -1))
            (let [checkpoint (begin-rule! (mut state))
                  _ (record-terminal! (mut state) at at)
                  result
                    (succeed-rule! (mut state)
                                   (if (> pending 0) "indent" "dedent")
                                   at
                                   at)]
              (trace-exit! (mut state) event result))
            (do
              (trace-exit-failed-at! (mut state) event (+ at 1))
              (record-expectation! (mut state) at "any character" 1))))))

(defn match-builtin-result! [(state (mut ParseState))
                             (rule (slice u8))
                             (expected (slice u8))
                             (start i64)
                             (end i64)] (-> i64)
  (let [checkpoint (begin-rule! (mut state))]
    (if (< end 0)
        (do
          (record-expectation! (mut state) start expected 1)
          (fail-rule! (mut state) checkpoint start))
        (do
          (record-terminal! (mut state) start end)
          (succeed-rule! (mut state) rule start end)))))

(defn match-letter-category-node! [(state (mut ParseState))
                                   (source (slice u8))
                                   (at i64)] (-> i64)
  (let [choice (trace-enter-kind! (mut state)
                                  "lower\n    | upper\n    | unicodeLtmo"
                                  at
                                  1)
        lower-event (trace-enter! (mut state) "lower" at)
        _ (trace-set-memoized! (mut state) lower-event)
        lower-end (match-lower-cst! (mut state) source at)
        _ (trace-exit! (mut state) lower-event lower-end)
        upper-end
          (if (>= lower-end 0)
              -1
              (let [upper-event (trace-enter! (mut state) "upper" at)
                    _ (trace-set-memoized! (mut state) upper-event)
                    result (match-upper-cst! (mut state) source at)]
                (trace-exit! (mut state) upper-event result)))
        unicode-end
          (if (or (>= lower-end 0) (>= upper-end 0))
              -1
              (let [unicode-event (trace-enter! (mut state) "unicodeLtmo" at)
                    _ (trace-set-memoized! (mut state) unicode-event)
                    result (match-unicode-ltmo-cst! (mut state) source at)]
                (trace-exit! (mut state) unicode-event result)))
        end
          (if (>= lower-end 0)
              lower-end
              (if (>= upper-end 0) upper-end unicode-end))]
    (trace-exit! (mut state) choice end)))

(defn match-letter-node! [(state (mut ParseState))
                          (source (slice u8))
                          (at i64)] (-> i64)
  (let [checkpoint (begin-rule! (mut state))
        end (match-letter-category-node! (mut state) source at)]
    (if (< end 0)
        (fail-rule! (mut state) checkpoint at)
        (succeed-rule! (mut state) "letter" at end))))

(defn match-letter-cst! [(state (mut ParseState)) (source (slice u8)) (at i64)] (-> i64)
  (let [checkpoint (begin-rule! (mut state))
        end (match-letter-category-node! (mut state) source at)]
    (if (< end 0)
        (do
          (record-expectation! (mut state) at "a letter" 1)
          (fail-rule! (mut state) checkpoint at))
        (succeed-rule! (mut state) "letter" at end))))

(defn match-space-cst! [(state (mut ParseState)) (source (slice u8)) (at i64)] (-> i64)
  (match-builtin-result! (mut state)
                         "space"
                         "a space"
                         at
                         (if (input-visible-at? state at) (match-space source at) -1)))

(defn match-space-terminal-cst! [(state (mut ParseState))
                                 (source (slice u8))
                                 (at i64)] (-> i64)
  (matched-expected-terminal! (mut state)
                              at
                              (if (input-visible-at? state at) (match-space source at) -1)
                              "a space"
                              1))

(defn match-digit-cst! [(state (mut ParseState)) (source (slice u8)) (at i64)] (-> i64)
  (let [end (if (input-visible-at? state at) (match-digit source at) -1)]
    (match-traced-builtin-result! (mut state)
                                  "digit"
                                  "a digit"
                                  "\"0\"..\"9\""
                                  at
                                  end
                                  (primitive-examined-end source at))))

(defn match-digit-node! [(state (mut ParseState)) (source (slice u8)) (at i64)] (-> i64)
  (let [end (if (input-visible-at? state at) (match-digit source at) -1)]
    (if (< end 0)
        -1
        (let [checkpoint (begin-rule! (mut state))]
          (record-terminal! (mut state) at end)
          (succeed-rule! (mut state) "digit" at end)))))

(defn match-alnum-cst! [(state (mut ParseState)) (source (slice u8)) (at i64)] (-> i64)
  (let [checkpoint (begin-rule! (mut state))
        (mut failure-snapshot) (failure-snapshot state)
        choice (trace-enter-kind! (mut state) "letter\n    | digit" at 1)
        letter-event (trace-enter! (mut state) "letter" at)
        _ (trace-set-memoized! (mut state) letter-event)
        letter-end (match-letter-cst! (mut state) source at)
        _ (trace-exit! (mut state) letter-event letter-end)
        end
          (if (>= letter-end 0)
              letter-end
              (let [digit-event (trace-enter! (mut state) "digit" at)
                    _ (trace-set-memoized! (mut state) digit-event)
                    digit-end (match-digit-cst! (mut state) source at)]
                (trace-exit! (mut state) digit-event digit-end)))
        _ (trace-exit! (mut state) choice end)]
    (if (< end 0)
        (do
          (restore-failures! (mut state) (mut failure-snapshot))
          (record-expectation! (mut state) at "an alpha-numeric character" 1)
          (fail-rule! (mut state) checkpoint at))
        (do
          (discard-failure-snapshot! (mut failure-snapshot))
          (succeed-rule! (mut state) "alnum" at end)))))

(defn match-hex-digit-cst! [(state (mut ParseState))
                            (source (slice u8))
                            (at i64)] (-> i64)
  (let [checkpoint (begin-rule! (mut state))
        digit-end (if (input-visible-at? state at) (match-digit source at) -1)
        range-end
          (if (>= digit-end 0)
              (match-digit-node! (mut state) source at)
              (let [end
                      (if (input-visible-at? state at)
                          (match-hex-digit source at)
                          -1)]
                (if (< end 0)
                    -1
                    (do (record-terminal! (mut state) at end) end))))]
    (if (< range-end 0)
        (do
          (record-expectation! (mut state) at "a hexadecimal digit" 1)
          (fail-rule! (mut state) checkpoint at))
        (succeed-rule! (mut state) "hexDigit" at range-end))))

(defn match-lower-cst! [(state (mut ParseState)) (source (slice u8)) (at i64)] (-> i64)
  (let [end (if (input-visible-at? state at) (match-lower source at) -1)]
    (match-traced-builtin-result! (mut state)
                                  "lower"
                                  "a lowercase letter"
                                  "Unicode [Ll] character"
                                  at
                                  end
                                  (primitive-examined-end source at))))

(defn match-lower-terminal-cst! [(state (mut ParseState))
                                 (source (slice u8))
                                 (at i64)] (-> i64)
  (let [end (if (input-visible-at? state at) (match-lower source at) -1)]
    (match-traced-expected-terminal! (mut state)
                                     "a lowercase letter"
                                     "Unicode [Ll] character"
                                     at
                                     end
                                     (primitive-examined-end source at))))

(defn match-upper-cst! [(state (mut ParseState)) (source (slice u8)) (at i64)] (-> i64)
  (let [end (if (input-visible-at? state at) (match-upper source at) -1)]
    (match-traced-builtin-result! (mut state)
                                  "upper"
                                  "an uppercase letter"
                                  "Unicode [Lu] character"
                                  at
                                  end
                                  (primitive-examined-end source at))))

(defn match-upper-terminal-cst! [(state (mut ParseState))
                                 (source (slice u8))
                                 (at i64)] (-> i64)
  (let [end (if (input-visible-at? state at) (match-upper source at) -1)]
    (match-traced-expected-terminal! (mut state)
                                     "an uppercase letter"
                                     "Unicode [Lu] character"
                                     at
                                     end
                                     (primitive-examined-end source at))))

(defn match-unicode-ltmo-cst! [(state (mut ParseState))
                               (source (slice u8))
                               (at i64)] (-> i64)
  (let [end (if (input-visible-at? state at) (match-unicode-ltmo source at) -1)]
    (match-traced-builtin-result! (mut state)
                                  "unicodeLtmo"
                                  "a Unicode character in Lt, Lm, or Lo"
                                  "Unicode [Ltmo] character"
                                  at
                                  end
                                  (primitive-examined-end source at))))

(defn match-unicode-ltmo-terminal-cst! [(state (mut ParseState))
                                        (source (slice u8))
                                        (at i64)] (-> i64)
  (let [end (if (input-visible-at? state at) (match-unicode-ltmo source at) -1)]
    (match-traced-expected-terminal! (mut state)
                                     "a Unicode character in Lt, Lm, or Lo"
                                     "Unicode [Ltmo] character"
                                     at
                                     end
                                     (primitive-examined-end source at))))

(defn match-unicode-property [(source (slice u8))
                              (at i64)
                              (property (slice u8))] (-> i64)
  (let [scalar (decode-utf8 source at)]
    (if (and (.valid scalar)
             (unicode/unicode-property? (.value scalar) property))
        (+ at (.width scalar))
        -1)))

(defn match-unicode-property-terminal-cst! [(state (mut ParseState))
                                             (source (slice u8))
                                             (at i64)
                                             (property (slice u8))] (-> i64)
  (let [(mut display) (str/sb-new (.allocator state))
        (mut expected) (str/sb-new (.allocator state))]
    (str/sb-push-str! (mut display) "Unicode [")
    (str/sb-push-str! (mut display) property)
    (str/sb-push-str! (mut display) "] character")
    (str/sb-push-str! (mut expected) "a Unicode [")
    (str/sb-push-str! (mut expected) property)
    (str/sb-push-str! (mut expected) "] character")
    (let [display-text (str/sb-finish! (mut display))
          expected-text (str/sb-finish! (mut expected))
          end
            (if (input-visible-at? state at)
                (match-unicode-property source at property)
                -1)]
      (match-traced-expected-terminal! (mut state)
                                       expected-text
                                       display-text
                                       at
                                       end
                                       (primitive-examined-end source at)))))

(defn match-end-cst! [(state (mut ParseState)) (source (slice u8)) (at i64)] (-> i64)
  (let [checkpoint (begin-rule! (mut state))
        end (if (input-visible-at? state at) (match-end source at) -1)]
    (if (< end 0)
        (do
          (record-expectation! (mut state) at "end of input" 1)
          (fail-rule! (mut state) checkpoint at))
        (let [terminal-end (record-terminal! (mut state) at end)]
          (succeed-rule! (mut state) "end" at terminal-end)))))

(defn match-end-expression-cst! [(state (mut ParseState))
                                 (source (slice u8))
                                 (at i64)] (-> i64)
  (let [end (if (input-visible-at? state at) (match-end source at) -1)]
    (if (< end 0)
        (do (record-expectation! (mut state) at "end of input" 1) -1)
        end)))

(defn match-any-rule-cst! [(state (mut ParseState)) (source (slice u8)) (at i64)] (-> i64)
  (let [checkpoint (begin-rule! (mut state))
        end (match-any-cst! (mut state) source at)]
    (if (< end 0)
        (fail-rule! (mut state) checkpoint at)
        (succeed-rule! (mut state) "any" at end))))

(defn match-indentation-cst! [(state (mut ParseState))
                              (at i64)
                              (indent bool)] (-> i64)
  (let [rule (if indent "indent" "dedent")
        expected (if indent "an indented block" "a dedent")
        checkpoint (begin-rule! (mut state))]
    (if (consume-indentation-token! (mut state) at (if indent 1 -1))
        (do
          (record-terminal! (mut state) at at)
          (succeed-rule! (mut state) rule at at))
        (do
          (record-expectation! (mut state) at expected 1)
          (fail-rule! (mut state) checkpoint at)))))

(defn match-indent-cst! [(state (mut ParseState)) (at i64)] (-> i64)
  (match-indentation-cst! (mut state) at true))

(defn match-dedent-cst! [(state (mut ParseState)) (at i64)] (-> i64)
  (match-indentation-cst! (mut state) at false))

(defn match-spaces-cst! [(state (mut ParseState)) (source (slice u8)) (at i64)] (-> i64)
  (let [spaces-checkpoint (begin-rule! (mut state))
        iteration-checkpoint (begin-rule! (mut state))
        (mut builder) (begin-iteration (mut state) 1)
        (mut cursor) at]
    (loop (let [next
                  (if (input-visible-at? state (load cursor))
                      (match-space source (load cursor))
                      -1)]
            (if (< next 0)
                (break)
                (do
                  (match-space-cst! (mut state) source (load cursor))
                  (iteration-capture-row! (mut state) (mut builder))
                  (set! cursor next)))))
    (succeed-iteration! (mut state) (mut builder) at (load cursor) false)
    (succeed-rule! (mut state) "spaces" at (load cursor))))

(defn build-expected-text! [(state (mut ParseState))] (-> (slice u8))
  (let [(mut message) (str/sb-new (.allocator state))
        total (len (.expectations state))
        (mut count) 0
        (mut previous-order) -1]
    (for expectation
      (iter (.expectations state))
      (let [existing expectation]
        (if (not (.fluffy existing)) (set! count (+ (load count) 1)) 0)))
    (for [index 0 (load count)]
      (if (> index 0)
          (str/sb-push-str! (mut message)
                            (if (= index (- (load count) 1))
                                (if (> (load count) 2) ", or " " or ")
                                ", "))
          0)
      (let [(mut chosen) -1
            (mut chosen-order) -1]
        (for [candidate-index 0 total]
          (let [candidate (get (.expectations state) candidate-index)]
            (if (and (not (.fluffy candidate))
                     (> (.order candidate) (load previous-order))
                     (or (< (load chosen) 0)
                         (< (.order candidate) (load chosen-order))))
                (do
                  (set! chosen candidate-index)
                  (set! chosen-order (.order candidate)))
                0)))
        (set! previous-order (load chosen-order))
        (let [expectation (get (.expectations state) (load chosen))]
          (if (= (.type expectation) 0) (str/sb-push-str! (mut message) "\"") 0)
          (str/sb-push-str! (mut message) (.text expectation))
          (if (= (.type expectation) 0) (str/sb-push-str! (mut message) "\"") 0))))
    (let [text (str/sb-finish! (mut message))]
      (push! (mut (.owned-names state)) text)
      text)))

(defn expect-end! [(state (mut ParseState)) (at i64)] (-> i64)
  (record-expectation! (mut state) at "end of input" 1))

(defn failure-line-column [(source (slice u8)) (position i64)] (-> LineColumn)
  (let [(mut info) (primitive/zeroed LineColumn)
        (mut at) 0
        (mut line) 1
        (mut column) 1
        (mut line-start) 0]
    (loop (if (or (>= (load at) position) (>= (load at) (slice-len source)))
              (break)
              (let [scalar (decode-utf8 source (load at))]
                (cond (and (.valid scalar) (= (.value scalar) 13))
                        ;; JavaScript's getLineAndColumn ignores carriage returns
                        ;; for column counting. Only a following LF starts a line.
                        (set! at (+ (load at) (.width scalar)))
                      (and (.valid scalar) (= (.value scalar) 10))
                        (do
                          (set! line (+ (load line) 1))
                          (set! column 1)
                          (set! at (+ (load at) (.width scalar)))
                          (set! line-start (load at)))
                      :else
                        (do
                          (set! column
                                (+ (load column)
                                   (if (and (.valid scalar) (> (.value scalar) 65535))
                                       2
                                       1)))
                          (set! at
                                (+ (load at) (if (.valid scalar) (.width scalar) 1))))))))
    (let [(mut line-end) (load line-start)]
      (loop (if (or (>= (load line-end) (slice-len source))
                    (= (primitive/cast i64 (slice-get source (load line-end))) 10))
                (break)
                (set! line-end (+ (load line-end) 1))))
      ;; Ohm strips a CR only when it terminates the displayed line.
      (if (and (> (load line-end) (load line-start))
               (= (primitive/cast i64 (slice-get source (- (load line-end) 1))) 13))
          (set! line-end (- (load line-end) 1))
          0)
      (set! (.line info) (load line))
      (set! (.offset info) (source-byte-position-to-utf16 source position))
      (set! (.column info) (load column))
      (set! (.line-start info) (load line-start))
      (set! (.line-end info) (load line-end))
      (load info))))

(defn new-ohm-input-stream-with-allocator [(source (slice u8))
                                           (a (dyn alloc/Allocator))]
                                          (-> OhmInputStream)
  (let [(mut stream) (primitive/zeroed OhmInputStream)]
    (set! (.source stream) source)
    (set! (.position stream) 0)
    (set! (.utf16-position stream) 0)
    (set! (.examined-length stream) 0)
    (set! (.pending-low-surrogate stream) -1)
    (set! (.owned-slices stream) (al/al-new [(slice u8)] a))
    (set! (.allocator stream) a)
    (load stream)))

(defn new-ohm-input-stream [(source (slice u8))] (-> OhmInputStream)
  (new-ohm-input-stream-with-allocator source (alloc/malloc-allocator)))

(defn free-ohm-input-stream! [(stream (mut OhmInputStream))] (-> i64)
  (for value (iter (.owned-slices stream))
    (alloc/free [u8] (.allocator stream) value))
  (al/al-free! (mut (.owned-slices stream))))

(defn ohm-input-stream-at-end? [(stream (mut OhmInputStream))] (-> bool)
  (let [answer
          (and (< (.pending-low-surrogate stream) 0)
               (>= (.position stream) (slice-len (.source stream))))
        examined (+ (.utf16-position stream) 1)]
    (if (> examined (.examined-length stream))
        (set! (.examined-length stream) examined)
        0)
    answer))

(defn ohm-input-stream-position [(stream (ptr OhmInputStream))] (-> i64)
  (.utf16-position stream))

(defn ohm-input-stream-examined-length [(stream (ptr OhmInputStream))] (-> i64)
  (.examined-length stream))

(defn ohm-input-stream-note-next! [(stream (mut OhmInputStream))] (-> i64)
  (set! (.utf16-position stream) (+ (.utf16-position stream) 1))
  (if (> (.utf16-position stream) (.examined-length stream))
      (set! (.examined-length stream) (.utf16-position stream))
      0)
  (.utf16-position stream))

;; Returns -1 as Coil's explicit counterpart of JavaScript `undefined`.
(defn ohm-input-stream-next! [(stream (mut OhmInputStream))] (-> i64)
  (if (>= (.pending-low-surrogate stream) 0)
      (let [answer (.pending-low-surrogate stream)]
        (set! (.pending-low-surrogate stream) -1)
        (ohm-input-stream-note-next! (mut stream))
        answer)
      (if (>= (.position stream) (slice-len (.source stream)))
          (do (ohm-input-stream-note-next! (mut stream)) -1)
          (let [scalar (decode-utf8 (.source stream) (.position stream))]
            (set! (.position stream)
                  (+ (.position stream) (if (.valid scalar) (.width scalar) 1)))
            (ohm-input-stream-note-next! (mut stream))
            (if (not (.valid scalar))
                -1
                (if (> (.value scalar) 65535)
                    (let [adjusted (- (.value scalar) 65536)]
                      (set! (.pending-low-surrogate stream)
                            (+ 56320 (% adjusted 1024)))
                      (+ 55296 (/ adjusted 1024)))
                    (.value scalar)))))))

(defn ohm-input-stream-next-char-code! [(stream (mut OhmInputStream))] (-> i64)
  (ohm-input-stream-next! (mut stream)))

(defn ohm-input-stream-next-code-point! [(stream (mut OhmInputStream))] (-> i64)
  (if (>= (.pending-low-surrogate stream) 0)
      (ohm-input-stream-next! (mut stream))
      (if (>= (.position stream) (slice-len (.source stream)))
          (do (ohm-input-stream-note-next! (mut stream)) -1)
          (let [scalar (decode-utf8 (.source stream) (.position stream))]
            (set! (.position stream)
                  (+ (.position stream) (if (.valid scalar) (.width scalar) 1)))
            (ohm-input-stream-note-next! (mut stream))
            (if (and (.valid scalar) (> (.value scalar) 65535))
                (ohm-input-stream-note-next! (mut stream))
                0)
            (if (.valid scalar) (.value scalar) -1)))))

(defn ohm-input-stream-match-string! [(stream (mut OhmInputStream))
                                      (wanted (slice u8))
                                      (ignore-case bool)] (-> bool)
  (let [(mut expected) (new-ohm-input-stream wanted)
        (mut matched) true]
    (loop (if (ohm-input-stream-at-end? (mut expected))
              (break)
              (let [actual-unit (ohm-input-stream-next! (mut stream))
                    expected-unit (ohm-input-stream-next! (mut expected))]
                (if (or (< actual-unit 0)
                        (if ignore-case
                            (not (unicode/unicode-case-insensitive-eq?
                                   actual-unit
                                   expected-unit))
                            (!= actual-unit expected-unit)))
                    (do (set! matched false) (break))
                    0))))
    (let [answer (load matched)]
      (free-ohm-input-stream! (mut expected))
      answer)))

(defn ohm-source-utf16-to-byte [(source (slice u8))
                                (wanted i64)] (-> i64)
  (let [(mut at) 0 (mut units) 0]
    (loop (if (or (>= (load units) wanted) (>= (load at) (slice-len source)))
              (break)
              (let [scalar (decode-utf8 source (load at))]
                (set! units
                      (+ (load units)
                         (if (and (.valid scalar) (> (.value scalar) 65535)) 2 1)))
                (set! at (+ (load at) (if (.valid scalar) (.width scalar) 1))))))
    (load at)))

(defn ohm-source-utf16-length [(source (slice u8))] (-> i64)
  (let [(mut at) 0 (mut units) 0]
    (loop (if (>= (load at) (slice-len source))
              (break)
              (let [scalar (decode-utf8 source (load at))]
                (set! units
                      (+ (load units)
                         (if (and (.valid scalar) (> (.value scalar) 65535)) 2 1)))
                (set! at (+ (load at) (if (.valid scalar) (.width scalar) 1))))))
    (load units)))

(defn push-wtf8-code-unit! [(builder (mut str/StrBuf)) (unit i64)] (-> i64)
  (cond (< unit 128)
          (str/sb-push-byte! (mut builder) (primitive/cast u8 unit))
        (< unit 2048)
          (do
            (str/sb-push-byte! (mut builder)
                               (primitive/cast u8 (+ 192 (/ unit 64))))
            (str/sb-push-byte! (mut builder)
                               (primitive/cast u8 (+ 128 (% unit 64)))))
        :else
          (do
            (str/sb-push-byte! (mut builder)
                               (primitive/cast u8 (+ 224 (/ unit 4096))))
            (str/sb-push-byte! (mut builder)
                               (primitive/cast u8 (+ 128 (% (/ unit 64) 64))))
            (str/sb-push-byte! (mut builder)
                               (primitive/cast u8 (+ 128 (% unit 64))))))
  0)

(defn ohm-input-stream-source-slice [(stream (mut OhmInputStream))
                                     (requested-start i64)
                                     (requested-end i64)] (-> (slice u8))
  (let [length (ohm-source-utf16-length (.source stream))
        start (if (< requested-start 0)
                  (let [adjusted (+ length requested-start)]
                    (if (< adjusted 0) 0 adjusted))
                  (if (> requested-start length) length requested-start))
        normalized-end
          (if (< requested-end 0)
              (let [adjusted (+ length requested-end)]
                (if (< adjusted 0) 0 adjusted))
              (if (> requested-end length) length requested-end))
        end (if (< normalized-end start) start normalized-end)
        (mut builder) (str/sb-new (.allocator stream))
        (mut at) 0
        (mut unit-at) 0]
    (loop (if (>= (load at) (slice-len (.source stream)))
              (break)
              (let [scalar (decode-utf8 (.source stream) (load at))
                    width (if (.valid scalar) (.width scalar) 1)]
                (if (and (.valid scalar) (> (.value scalar) 65535))
                    (let [adjusted (- (.value scalar) 65536)
                          high (+ 55296 (/ adjusted 1024))
                          low (+ 56320 (% adjusted 1024))
                          include-high
                            (and (>= (load unit-at) start) (< (load unit-at) end))
                          include-low
                            (and (>= (+ (load unit-at) 1) start)
                                 (< (+ (load unit-at) 1) end))]
                      (if (and include-high include-low)
                          (for [index 0 width]
                            (str/sb-push-byte!
                              (mut builder)
                              (slice-get (.source stream) (+ (load at) index))))
                          (do
                            (if include-high
                                (push-wtf8-code-unit! (mut builder) high)
                                0)
                            (if include-low
                                (push-wtf8-code-unit! (mut builder) low)
                                0)))
                      (set! unit-at (+ (load unit-at) 2)))
                    (do
                      (if (and (>= (load unit-at) start) (< (load unit-at) end))
                          (for [index 0 width]
                            (str/sb-push-byte!
                              (mut builder)
                              (slice-get (.source stream) (+ (load at) index))))
                          0)
                      (set! unit-at (+ (load unit-at) 1))))
                (set! at (+ (load at) width)))))
    (let [answer (str/sb-finish! (mut builder))]
      (push! (mut (.owned-slices stream)) answer)
      answer)))

(defn ohm-input-stream-interval [(stream (ptr OhmInputStream))
                                 (start i64)
                                 (end i64)] (-> OhmInterval)
  ;; Ohm v17 uses `optEndIdx ? optEndIdx : this.pos`, so an explicit zero
  ;; has the same behavior as an omitted end argument.
  (new-ohm-interval (.source stream)
                    start
                    (if (= end 0) (.utf16-position stream) end)))

(defn ohm-input-stream-interval-from [(stream (ptr OhmInputStream))
                                      (start i64)] (-> OhmInterval)
  (new-ohm-interval (.source stream) start (.utf16-position stream)))

(defn new-ohm-interval [(source (slice u8)) (start i64) (end i64)]
                       (-> OhmInterval)
  (let [(mut interval) (primitive/zeroed OhmInterval)]
    (set! (.source interval) source)
    (set! (.start interval) start)
    (set! (.end interval) end)
    (set! (.valid interval)
          (and (>= start 0)
               (and (>= end start) (<= end (ohm-source-utf16-length source)))))
    (load interval)))

(defn ohm-interval-valid? [(interval OhmInterval)] (-> bool)
  (.valid interval))

(defn ohm-interval-start [(interval OhmInterval)] (-> i64)
  (.start interval))

(defn ohm-interval-end [(interval OhmInterval)] (-> i64)
  (.end interval))

(defn ohm-interval-source [(interval OhmInterval)] (-> (slice u8))
  (.source interval))

(defn ohm-source-utf16-boundary? [(source (slice u8)) (wanted i64)] (-> bool)
  (let [(mut at) 0 (mut units) 0 (mut answer) (= wanted 0)]
    (loop (if (or (load answer) (>= (load at) (slice-len source)))
              (break)
              (let [scalar (decode-utf8 source (load at))]
                (set! units
                      (+ (load units)
                         (if (and (.valid scalar) (> (.value scalar) 65535)) 2 1)))
                (set! at (+ (load at) (if (.valid scalar) (.width scalar) 1)))
                (if (= (load units) wanted) (set! answer true) 0))))
    (load answer)))

(defn ohm-interval-contents-cache [] (-> (ptr OhmIntervalContentsCache))
  (let [cache (primitive/alloc-static OhmIntervalContentsCache)]
    (if (not (.initialized cache))
        (do
          (set! (.entries cache)
                (al/al-new [OhmIntervalContentsEntry] (alloc/malloc-allocator)))
          (set! (.initialized cache) true))
        0)
    cache))

(defn ohm-interval-intern-split-contents! [(interval OhmInterval)]
                                         (-> (slice u8))
  (let [cache (ohm-interval-contents-cache)
        source-data (slice-data (.source interval))
        source-length (slice-len (.source interval))
        (mut found) -1]
    (for [index 0 (len (.entries cache))]
      (let [entry (get (.entries cache) index)]
        (if (and (= (primitive/cast i64 (.source-data entry))
                    (primitive/cast i64 source-data))
                 (and (= (.source-length entry) source-length)
                      (and (= (.start entry) (.start interval))
                           (= (.end entry) (.end interval)))))
            (set! found index)
            0)))
    (if (>= (load found) 0)
        (let [existing (get (.entries cache) (load found))]
          (.contents existing))
        (let [(mut stream) (new-ohm-input-stream (.source interval))
              contents
                (ohm-input-stream-source-slice
                  (mut stream)
                  (.start interval)
                  (.end interval))
              _ (pop! (mut (.owned-slices stream)))
              _ (al/al-free! (mut (.owned-slices stream)))
              (mut entry) (primitive/zeroed OhmIntervalContentsEntry)]
          (set! (.source-data entry) source-data)
          (set! (.source-length entry) source-length)
          (set! (.start entry) (.start interval))
          (set! (.end entry) (.end interval))
          (set! (.contents entry) contents)
          (push! (mut (.entries cache)) (load entry))
          contents))))

(defn ohm-interval-contents [(interval OhmInterval)] (-> (slice u8))
  (if (.valid interval)
      (if (and (ohm-source-utf16-boundary? (.source interval) (.start interval))
               (ohm-source-utf16-boundary? (.source interval) (.end interval)))
          (subslice (.source interval)
                    (ohm-source-utf16-to-byte (.source interval) (.start interval))
                    (ohm-source-utf16-to-byte (.source interval) (.end interval)))
          (ohm-interval-intern-split-contents! interval))
      ""))

(defn ohm-interval-same-source? [(left OhmInterval)
                                 (right OhmInterval)] (-> bool)
  ;; JavaScript strings compare by value even when independently produced.
  (str/str-eq (.source left) (.source right)))

(defn ohm-interval-error [(message (slice u8))] (-> i64)
  (io/print-str (io/stderr) message)
  (io/print-str (io/stderr) "\n")
  (alloc/abort))

(defn ohm-interval-collapsed-left [(interval OhmInterval)] (-> OhmInterval)
  (new-ohm-interval (.source interval) (.start interval) (.start interval)))

(defn ohm-interval-collapsed-right [(interval OhmInterval)] (-> OhmInterval)
  (new-ohm-interval (.source interval) (.end interval) (.end interval)))

(defn ohm-interval-coverage [(intervals (slice OhmInterval))] (-> OhmInterval)
  (if (= (slice-len intervals) 0)
      (new-ohm-interval "" 0 -1)
      (let [first (slice-get intervals 0)
            (mut start) (.start first)
            (mut end) (.end first)
            (mut valid) (.valid first)]
        (for [index 1 (slice-len intervals)]
          (let [interval (slice-get intervals index)]
            (if (or (not (.valid interval))
                    (not (ohm-interval-same-source? first interval)))
                (ohm-interval-error "Interval sources don't match")
                (do
                  (if (< (.start interval) (load start))
                      (set! start (.start interval))
                      0)
                  (if (> (.end interval) (load end))
                      (set! end (.end interval))
                      0)))))
        (let [(mut result)
                (new-ohm-interval (.source first) (load start) (load end))]
          (if (not (load valid)) (set! (.valid result) false) 0)
          (load result)))))

(defn ohm-interval-coverage-with [(interval OhmInterval)
                                  (others (slice OhmInterval))] (-> OhmInterval)
  (let [(mut all)
          (al/al-new [OhmInterval] (alloc/malloc-allocator))]
    (push! (mut all) interval)
    (for other (iter others) (push! (mut all) other))
    (let [result (ohm-interval-coverage (al/al-slice [OhmInterval] (load all)))]
      (al/al-free! (mut all))
      result)))

;; Coil represents JavaScript's array result as an owned ArrayList.
(defn ohm-interval-minus [(interval OhmInterval)
                          (that OhmInterval)] (-> (al/ArrayList OhmInterval))
  (let [(mut result) (al/al-new [OhmInterval] (alloc/malloc-allocator))]
    (if (not (ohm-interval-same-source? interval that))
        (ohm-interval-error "Interval sources don't match")
        0)
    (if (and (.valid interval) (.valid that))
        (cond (and (= (.start interval) (.start that))
                   (= (.end interval) (.end that))) 0
              (and (< (.start interval) (.start that))
                   (< (.end that) (.end interval)))
                (do (push! (mut result)
                            (new-ohm-interval (.source interval)
                                              (.start interval)
                                              (.start that)))
                    (push! (mut result)
                           (new-ohm-interval (.source interval)
                                             (.end that)
                                             (.end interval))))
              (and (< (.start interval) (.end that))
                   (< (.end that) (.end interval)))
                (push! (mut result)
                       (new-ohm-interval (.source interval)
                                         (.end that)
                                         (.end interval)))
              (and (< (.start interval) (.start that))
                   (< (.start that) (.end interval)))
                (push! (mut result)
                       (new-ohm-interval (.source interval)
                                         (.start interval)
                                         (.start that)))
              :else (push! (mut result) interval))
        0)
    (load result)))

(defn ohm-interval-relative-to [(interval OhmInterval)
                                (that OhmInterval)] (-> OhmInterval)
  (if (not (ohm-interval-same-source? interval that))
      (ohm-interval-error "Interval sources don't match")
      0)
  (if (not (and (>= (.start interval) (.start that))
                (<= (.end interval) (.end that))))
      (ohm-interval-error "other interval does not cover this one")
      0)
  (if (and (.valid interval) (.valid that))
      (new-ohm-interval (.source interval)
                        (- (.start interval) (.start that))
                        (- (.end interval) (.start that)))
      (let [(mut invalid) (new-ohm-interval (.source interval) 0 0)]
        (set! (.valid invalid) false)
        (load invalid))))

(defn ohm-js-whitespace? [(scalar i64)] (-> bool)
  (or (= scalar 9)
      (or (= scalar 10)
          (or (= scalar 11)
              (or (= scalar 12)
                  (or (= scalar 13)
                      (or (= scalar 32)
                          (or (= scalar 160)
                              (or (= scalar 65279)
                                  (unicode/unicode-property? scalar "White_Space"))))))))))

(defn ohm-interval-trimmed [(interval OhmInterval)] (-> OhmInterval)
  (if (not (.valid interval))
      interval
      (let [(mut cursor)
              (ohm-source-utf16-to-byte (.source interval) (.start interval))
            byte-end (ohm-source-utf16-to-byte (.source interval) (.end interval))
            (mut units) (.start interval)
            (mut first) (.end interval)
            (mut last) (.start interval)
            (mut seen) false]
        (loop (if (>= (load cursor) byte-end)
                  (break)
                  (let [scalar (decode-utf8 (.source interval) (load cursor))
                        width (if (.valid scalar) (.width scalar) 1)
                        unit-width
                          (if (and (.valid scalar) (> (.value scalar) 65535)) 2 1)
                        next (+ (load cursor) width)]
                    (if (not (ohm-js-whitespace? (.value scalar)))
                        (do
                          (if (not (load seen)) (set! first (load units)) 0)
                          (set! last (+ (load units) unit-width))
                          (set! seen true))
                        0)
                    (set! cursor next)
                    (set! units (+ (load units) unit-width)))))
        (if (load seen)
            (new-ohm-interval (.source interval) (load first) (load last))
            ;; JavaScript's two independent /^\s*/ and /\s*$/ matches cross
            ;; for an all-whitespace interval. Preserve those exact indices.
            (new-ohm-interval (.source interval) (.end interval) (.start interval))))))

(defn ohm-interval-sub-interval [(interval OhmInterval)
                                 (offset i64)
                                 (length i64)] (-> OhmInterval)
  (let [start (+ (.start interval) offset)]
    (new-ohm-interval (.source interval) start (+ start length))))

(defn ohm-interval-line-column [(interval OhmInterval)] (-> LineColumn)
  (failure-line-column
    (.source interval)
    (ohm-source-utf16-to-byte (.source interval) (.start interval))))

(defn line-column-line [(info LineColumn)] (-> i64) (.line info))
(defn line-column-column [(info LineColumn)] (-> i64) (.column info))
(defn line-column-offset [(info LineColumn)] (-> i64) (.offset info))
(defn line-column-line-text [(source (slice u8)) (info LineColumn)] (-> (slice u8))
  (subslice source (.line-start info) (.line-end info)))

(defn line-column-previous-line-text [(source (slice u8))
                                      (info LineColumn)] (-> (slice u8))
  (if (= (.line-start info) 0)
      ""
      (let [(mut end) (- (.line-start info) 1)]
        (if (and (> (load end) 0)
                 (= (primitive/cast i64 (slice-get source (- (load end) 1))) 13))
            (set! end (- (load end) 1))
            0)
        (let [(mut start) (load end)]
          (loop (if (or (= (load start) 0)
                        (= (primitive/cast i64
                                             (slice-get source (- (load start) 1)))
                           10))
                    (break)
                    (set! start (- (load start) 1))))
          (subslice source (load start) (load end))))))

(defn line-column-previous-line [(source (slice u8))
                                 (info LineColumn)] (-> (Option (slice u8)))
  (if (= (.line-start info) 0)
      (None)
      (Some (line-column-previous-line-text source info))))

(defn line-column-next-line-text [(source (slice u8))
                                  (info LineColumn)] (-> (slice u8))
  (let [(mut start) (.line-end info)]
    (if (and (< (load start) (slice-len source))
             (= (primitive/cast i64 (slice-get source (load start))) 13))
        (set! start (+ (load start) 1))
        0)
    (if (and (< (load start) (slice-len source))
             (= (primitive/cast i64 (slice-get source (load start))) 10))
        (set! start (+ (load start) 1))
        0)
    (if (>= (load start) (slice-len source))
        ""
        (let [(mut end) (load start)]
          (loop (if (or (>= (load end) (slice-len source))
                        (= (primitive/cast i64 (slice-get source (load end))) 10))
                    (break)
                    (set! end (+ (load end) 1))))
          (if (and (> (load end) (load start))
                   (= (primitive/cast i64 (slice-get source (- (load end) 1))) 13))
              (set! end (- (load end) 1))
              0)
          (subslice source (load start) (load end))))))

(defn line-column-next-line [(source (slice u8))
                             (info LineColumn)] (-> (Option (slice u8)))
  (let [(mut separator) (.line-end info)]
    (if (and (< (load separator) (slice-len source))
             (= (primitive/cast i64 (slice-get source (load separator))) 13))
        (set! separator (+ (load separator) 1))
        0)
    (if (and (< (load separator) (slice-len source))
             (= (primitive/cast i64 (slice-get source (load separator))) 10))
        (Some (line-column-next-line-text source info))
        (None))))

(defn new-ohm-source-range [(start i64) (end i64)] (-> OhmSourceRange)
  (let [(mut range) (primitive/zeroed OhmSourceRange)]
    (set! (.start range) start)
    (set! (.end range) end)
    (load range)))

(defn source-position-covered? [(ranges (slice OhmSourceRange))
                                (position i64)] (-> bool)
  (let [(mut covered) false]
    (for range
      (iter ranges)
      (let [bound-range range]
        (if (and (< (.start bound-range) (.end bound-range))
                 (and (>= position (.start bound-range))
                      (< position (.end bound-range))))
            (set! covered true)
            0)))
    (load covered)))

(defn get-line-and-column-message! [(a (dyn alloc/Allocator))
                                    (source (slice u8))
                                    (position i64)
                                    (ranges (slice OhmSourceRange))]
                                   (-> (slice u8))
  (let [info (failure-line-column source (ohm-source-utf16-to-byte source position))
        line-start-offset (source-byte-position-to-utf16 source (.line-start info))
        line-end-offset (source-byte-position-to-utf16 source (.line-end info))
        (mut previous-start) (.line-start info)
        (mut previous-end) (.line-start info)
        has-previous (> (.line-start info) 0)
        (mut next-start) (.line-end info)
        (mut next-end) (.line-end info)
        (mut has-next) false]
    (if has-previous
        (do
          (set! previous-end (- (.line-start info) 1))
          (if (and (> (load previous-end) 0)
                   (= (primitive/cast i64
                                        (slice-get source (- (load previous-end) 1)))
                      13))
              (set! previous-end (- (load previous-end) 1))
              0)
          (set! previous-start (load previous-end))
          (loop (if (or (<= (load previous-start) 0)
                        (= (primitive/cast i64
                                             (slice-get source (- (load previous-start) 1)))
                           10))
                    (break)
                    (set! previous-start (- (load previous-start) 1)))))
        0)
    (if (< (load next-start) (slice-len source))
        (do
          (if (= (primitive/cast i64 (slice-get source (load next-start))) 13)
              (set! next-start (+ (load next-start) 1))
              0)
          (if (and (< (load next-start) (slice-len source))
                   (= (primitive/cast i64 (slice-get source (load next-start))) 10))
              (set! next-start (+ (load next-start) 1))
              0)
          (set! has-next true)
          (set! next-end (load next-start))
          (loop (if (or (>= (load next-end) (slice-len source))
                        (= (primitive/cast i64 (slice-get source (load next-end))) 10))
                    (break)
                    (set! next-end (+ (load next-end) 1))))
          (if (and (> (load next-end) (load next-start))
                   (= (primitive/cast i64
                                        (slice-get source (- (load next-end) 1)))
                      13))
              (set! next-end (- (load next-end) 1))
              0))
        0)
    (let [number-width
            (decimal-digits (if (load has-next) (+ (.line info) 1) (.line info)))
          marker-position (- (.column info) 1)
          line-length (- line-end-offset line-start-offset)
          (mut marker-length) (+ marker-position 1)
          (mut builder) (str/sb-new a)]
      (for range
        (iter ranges)
        (let [bound-range range
              clipped-end
                (if (> (.end bound-range) line-end-offset)
                    line-end-offset
                    (.end bound-range))]
          (if (and (< (.start bound-range) (.end bound-range))
                   (> clipped-end line-start-offset))
              (let [relative-end (- clipped-end line-start-offset)]
                (if (> relative-end (load marker-length))
                    (set! marker-length relative-end)
                    0))
              0)))
      (if (> (load marker-length) (+ line-length 1))
          (set! marker-length (+ line-length 1))
          0)
      (if (= (load marker-length) 0) (set! marker-length 1) 0)
      (str/sb-push-str! (mut builder) "Line ")
      (str/sb-push-i64! (mut builder) (.line info))
      (str/sb-push-str! (mut builder) ", col ")
      (str/sb-push-i64! (mut builder) (.column info))
      (str/sb-push-str! (mut builder) ":\n")
      (if has-previous
          (do
            (str/sb-push-str! (mut builder) "  ")
            (push-padded-line-number! (mut builder)
                                      (- (.line info) 1)
                                      number-width)
            (str/sb-push-str! (mut builder) " | ")
            (str/sb-push-str! (mut builder)
                              (subslice source
                                        (load previous-start)
                                        (load previous-end)))
            (str/sb-push-str! (mut builder) "\n"))
          0)
      (str/sb-push-str! (mut builder) "> ")
      (push-padded-line-number! (mut builder) (.line info) number-width)
      (str/sb-push-str! (mut builder) " | ")
      (str/sb-push-str! (mut builder)
                        (subslice source (.line-start info) (.line-end info)))
      (str/sb-push-str! (mut builder) "\n")
      (for [_ 0 (+ 5 number-width)] (str/sb-push-str! (mut builder) " "))
      (for [column 0 (load marker-length)]
        (str/sb-push-byte!
          (mut builder)
          (if (= column marker-position)
              94
              (if (source-position-covered?
                    ranges
                    (+ line-start-offset column))
                  126
                  32))))
      (str/sb-push-str! (mut builder) "\n")
      (if (load has-next)
          (do
            (str/sb-push-str! (mut builder) "  ")
            (push-padded-line-number! (mut builder)
                                      (+ (.line info) 1)
                                      number-width)
            (str/sb-push-str! (mut builder) " | ")
            (str/sb-push-str! (mut builder)
                              (subslice source (load next-start) (load next-end)))
            (str/sb-push-str! (mut builder) "\n"))
          0)
      (str/sb-finish! (mut builder)))))

(defn line-column-to-string! [(a (dyn alloc/Allocator))
                              (source (slice u8))
                              (info LineColumn)
                              (ranges (slice OhmSourceRange))]
                             (-> (slice u8))
  (get-line-and-column-message! a source (.offset info) ranges))

(defn ohm-interval-line-column-message! [(a (dyn alloc/Allocator))
                                         (interval OhmInterval)]
                                        (-> (slice u8))
  (let [(mut ranges) (al/al-new [OhmSourceRange] a)]
    (push! (mut ranges) (new-ohm-source-range (.start interval) (.end interval)))
    (let [message
            (get-line-and-column-message!
              a
              (.source interval)
              (.start interval)
              (al/al-slice [OhmSourceRange] (load ranges)))]
      (al/al-free! (mut ranges))
      message)))

(defn own-result-text! [(state (mut ParseState)) (text (slice u8))] (-> (slice u8))
  (push! (mut (.owned-names state)) text)
  text)

(defn decimal-digits [(value i64)] (-> i64)
  (let [(mut remaining) value
        (mut digits) 1]
    (loop (if (< (load remaining) 10)
              (break)
              (do
                (set! remaining (/ (load remaining) 10))
                (set! digits (+ (load digits) 1)))))
    (load digits)))

(defn push-padded-line-number! [(message (mut str/StrBuf))
                                (number i64)
                                (width i64)] (-> i64)
  (for [_ 0 (- width (decimal-digits number))]
    (str/sb-push-str! (mut message) " "))
  (str/sb-push-i64! (mut message) number)
  0)

(defn build-short-message! [(state (mut ParseState))
                            (info LineColumn)
                            (expected (slice u8))] (-> (slice u8))
  (let [(mut message) (str/sb-new (.allocator state))]
    (str/sb-push-str! (mut message) "Line ")
    (str/sb-push-i64! (mut message) (.line info))
    (str/sb-push-str! (mut message) ", col ")
    (str/sb-push-i64! (mut message) (.column info))
    (str/sb-push-str! (mut message) ": expected ")
    (str/sb-push-str! (mut message) expected)
    (own-result-text! (mut state) (str/sb-finish! (mut message)))))

(defn build-context-message! [(state (mut ParseState))
                              (source (slice u8))
                              (info LineColumn)
                              (expected (slice u8))] (-> (slice u8))
  (let [(mut previous-start) (.line-start info)
        (mut previous-end) (.line-start info)
        has-previous (> (.line-start info) 0)
        (mut next-start) (.line-end info)
        (mut next-end) (.line-end info)
        (mut has-next) false]
    (if has-previous
        (do
          (set! previous-end (- (.line-start info) 1))
          (if (and (> (load previous-end) 0)
                   (= (primitive/cast i64 (slice-get source (- (load previous-end) 1))) 13))
              (set! previous-end (- (load previous-end) 1))
              0)
          (set! previous-start (load previous-end))
          (loop (if (or (<= (load previous-start) 0)
                        (= (primitive/cast i64
                                           (slice-get source (- (load previous-start) 1)))
                           10))
                    (break)
                    (set! previous-start (- (load previous-start) 1))))
          0)
        0)
    (if (< (load next-start) (slice-len source))
        (do
          (if (= (primitive/cast i64 (slice-get source (load next-start))) 13)
              (set! next-start (+ (load next-start) 1))
              0)
          (if (and (< (load next-start) (slice-len source))
                   (= (primitive/cast i64 (slice-get source (load next-start))) 10))
              (set! next-start (+ (load next-start) 1))
              0)
          (set! has-next true)
          (set! next-end (load next-start))
          (loop (if (or (>= (load next-end) (slice-len source))
                        (= (primitive/cast i64 (slice-get source (load next-end))) 10)
                        (= (primitive/cast i64 (slice-get source (load next-end))) 13))
                    (break)
                    (set! next-end (+ (load next-end) 1))))
          0)
        0)
    (let [number-width (decimal-digits (if (load has-next) (+ (.line info) 1) (.line info)))
          (mut message) (str/sb-new (.allocator state))]
      (str/sb-push-str! (mut message) "Line ")
      (str/sb-push-i64! (mut message) (.line info))
      (str/sb-push-str! (mut message) ", col ")
      (str/sb-push-i64! (mut message) (.column info))
      (str/sb-push-str! (mut message) ":\n")
      (if has-previous
          (do
            (str/sb-push-str! (mut message) "  ")
            (push-padded-line-number! (mut message) (- (.line info) 1) number-width)
            (str/sb-push-str! (mut message) " | ")
            (str/sb-push-str! (mut message)
                              (subslice source (load previous-start) (load previous-end)))
            (str/sb-push-str! (mut message) "\n"))
          0)
      (str/sb-push-str! (mut message) "> ")
      (push-padded-line-number! (mut message) (.line info) number-width)
      (str/sb-push-str! (mut message) " | ")
      (str/sb-push-str! (mut message) (subslice source (.line-start info) (.line-end info)))
      (str/sb-push-str! (mut message) "\n")
      (for [_ 0 (+ (+ 5 number-width) (- (.column info) 1))]
        (str/sb-push-str! (mut message) " "))
      (str/sb-push-str! (mut message) "^\n")
      (if (load has-next)
          (do
            (str/sb-push-str! (mut message) "  ")
            (push-padded-line-number! (mut message) (+ (.line info) 1) number-width)
            (str/sb-push-str! (mut message) " | ")
            (str/sb-push-str! (mut message)
                              (subslice source (load next-start) (load next-end)))
            (str/sb-push-str! (mut message) "\n"))
          0)
      (str/sb-push-str! (mut message) "Expected ")
      (str/sb-push-str! (mut message) expected)
      (own-result-text! (mut state) (str/sb-finish! (mut message))))))

(defn finish-match [(state (mut ParseState)) (source (slice u8)) (end i64)] (-> MatchResult)
  (let [expected-text (build-expected-text! (mut state))
        info (failure-line-column source (.farthest state))
        short-message (build-short-message! (mut state) info expected-text)
        message (build-context-message! (mut state) source info expected-text)
        (mut result) (primitive/zeroed MatchResult)
        trace-base (+ (len (.nodes state)) 1)]
    (for [index 0 (len (.trace-nodes state))]
      (let [node (al/al-elem [CstNode] (mut (.trace-nodes state)) index)]
        (if (>= (.first-child node) 0)
            (set! (.first-child node) (+ trace-base (.first-child node)))
            0)
        (if (>= (.last-child node) 0)
            (set! (.last-child node) (+ trace-base (.last-child node)))
            0)
        (if (>= (.next-sibling node) 0)
            (set! (.next-sibling node) (+ trace-base (.next-sibling node)))
            0)))
    (for [index 0 (len (.trace-events state))]
      (let [event (al/al-elem [TraceEvent] (mut (.trace-events state)) index)]
        (if (.trace-only-bindings event)
            (do
              (if (>= (.binding event) 0)
                  (set! (.binding event) (+ trace-base (.binding event)))
                  0)
              (if (>= (.first-binding event) 0)
                  (set! (.first-binding event) (+ trace-base (.first-binding event)))
                  0))
            0)))
    (set! (.source result) source)
    (set! (.nodes result) (.nodes state))
    (set! (.trace-nodes result) (.trace-nodes state))
    (set! (.trace-node-base result) trace-base)
    (set! (.owned-names result) (.owned-names state))
    (set! (.failures result) (.expectations state))
    (set! (.trace-events result) (.trace-events state))
    (set! (.allocator result) (.allocator state))
    (set! (.expected-text result) expected-text)
    (set! (.short-message result) short-message)
    (set! (.message result) message)
    (set! (.failure-line result) (.line info))
    (set! (.failure-column result) (.column info))
    (set! (.grammar-name result) (.grammar-name state))
    (set! (.grammar-token result) (.grammar-token state))
    (set! (.grammar-names result) (.grammar-names state))
    (set! (.semantic-rules result) (.semantic-rules state))
    (set! (.root result) (.root state))
    (set! (.end result) end)
    (set! (.succeeded result) (>= end 0))
    (set! (.failure-position result) (.farthest state))
    (al/al-free! (mut (.frames state)))
    (al/al-free! (mut (.memo state)))
    (al/al-free! (mut (.memo-nodes state)))
    (al/al-free! (mut (.memo-expectations state)))
    (al/al-free! (mut (.memo-trace-events state)))
    (al/al-free! (mut (.stable-identities state)))
    (al/al-free! (mut (.applications state)))
    (al/al-free! (mut (.start-arguments state)))
    (al/al-free! (mut (.start-argument-frame-starts state)))
    (al/al-free! (mut (.start-expressions state)))
    (al/al-free! (mut (.start-expression-children state)))
    (al/al-free! (mut (.trace-stack state)))
    (al/al-free! (mut (.examined-stack state)))
    (al/al-free! (mut (.failure-examined-stack state)))
    (al/al-free! (mut (.indentation-tokens state)))
    (al/al-free! (mut (.indentation-changes state)))
    (load result)))

(defn memo-examined-end-for-rule-name [(state (ptr ParseState))
                                       (rule-name (slice u8))
                                       (start i64)] (-> i64)
  (let [(mut examined-end) -1]
    (for entry
      (iter (.memo state))
      (let [candidate entry]
        (if (and (= (.start candidate) start)
                 (str/str-eq (.rule-name candidate) rule-name))
            (set! examined-end (.examined-end candidate))
            0)))
    (load examined-end)))

(defn compute-parse-state-node-paths! [(state (ptr ParseState))
                                       (paths (mut (al/ArrayList i64)))] (-> i64)
  (let [(mut node-stack) (al/al-new [i64] (.allocator state))
        (mut path-stack) (al/al-new [i64] (.allocator state))]
    (for [_ 0 (len (.nodes state))] (push! (mut paths) -1))
    (if (>= (.root state) 0)
        (do
          (push! (mut node-stack) (.root state))
          (push! (mut path-stack) 1))
        0)
    (loop (if (= (len (load node-stack)) 0)
              (break)
              (let [last (- (len (load node-stack)) 1)
                    node (get (load node-stack) last)
                    path (get (load path-stack) last)]
                (pop! (mut node-stack))
                (pop! (mut path-stack))
                (if (< (get (load paths) node) 0)
                    (do
                      (set! (mut paths) node path)
                      (let [parent-node (get (.nodes state) node)
                            (mut child) (.first-child parent-node)
                            (mut child-index) 0]
                        (loop (if (< (load child) 0)
                                  (break)
                                  (let [child-node (get (.nodes state) (load child))]
                                    (push! (mut node-stack) (load child))
                                    (push! (mut path-stack)
                                           (+ (* path 131) (+ (load child-index) 1)))
                                    (set! child (.next-sibling child-node))
                                    (set! child-index (+ (load child-index) 1)))))))
                    0))))
    (al/al-free! (mut node-stack))
    (al/al-free! (mut path-stack))
    0))

(defn finish-match-cached! [(state (mut ParseState))
                            (source (slice u8))
                            (end i64)
                            (cache (mut ParseCache))] (-> MatchResult)
  (al/al-free! (mut (.memo cache)))
  (al/al-free! (mut (.memo-nodes cache)))
  (al/al-free! (mut (.memo-expectations cache)))
  (al/al-free! (mut (.memo-trace-events cache)))
  (al/al-free! (mut (.stable-identities cache)))
  (set! (.stable-identities cache)
        (al/al-new [StableNodeIdentity] (.allocator cache)))
  (let [(mut paths) (al/al-new [i64] (.allocator state))
        _ (compute-parse-state-node-paths! state (mut paths))]
    (for [node-index 0 (len (.nodes state))]
      (let [path (get (load paths) node-index)]
        (if (>= path 0)
            (let [candidate (get (.nodes state) node-index)
                  (mut stable-id) -1]
              (for old-identity
                (iter (.stable-identities state))
                (let [identity old-identity]
                  (if (and (= (.path identity) path)
                           (and (= (.start identity) (.start candidate))
                                (str/str-eq (.rule-name identity) (.rule candidate))))
                      (set! stable-id (.id identity))
                      0)))
              (if (> (load stable-id) 0)
                  (set! (.id (al/al-elem [CstNode]
                                         (mut (.nodes state))
                                         node-index))
                        (load stable-id))
                  0))
            0)))
    (for [node-index 0 (len (.nodes state))]
      (let [candidate (get (.nodes state) node-index)
            path (get (load paths) node-index)
            (mut retained-examined-end) -1]
        (for old-identity
          (iter (.stable-identities state))
          (let [identity old-identity]
            (if (and (= (.path identity) path)
                     (and (= (.start identity) (.start candidate))
                          (str/str-eq (.rule-name identity) (.rule candidate))))
                (set! retained-examined-end (.examined-end identity))
                0)))
        (let [examined-end
                (if (>= (load retained-examined-end) 0)
                    (load retained-examined-end)
                    (let [memo-examined-end
                            (memo-examined-end-for-rule-name state
                                                             (.rule candidate)
                                                             (.start candidate))]
                      (if (>= memo-examined-end 0)
                          memo-examined-end
                          (+ (.end candidate) 1))))]
        (if (and (>= examined-end 0)
                 (>= path 0))
            (let [(mut identity) (primitive/zeroed StableNodeIdentity)]
              (set! (.rule-name identity) (.rule candidate))
              (set! (.start identity) (.start candidate))
              (set! (.examined-end identity) examined-end)
              (set! (.path identity) path)
              (set! (.snapshot-id identity) (.id candidate))
              (set! (.id identity) (.id candidate))
              (push! (mut (.stable-identities cache)) (load identity)))
            0))))
    (al/al-free! (mut paths)))
  (set! (.memo cache) (.memo state))
  (set! (.memo-nodes cache) (.memo-nodes state))
  (set! (.memo-expectations cache) (.memo-expectations state))
  (set! (.memo-trace-events cache) (.memo-trace-events state))
  (set! (.reuse-count cache) (+ (.reuse-count cache) (.cache-reuse-count state)))
  (set! (.next-node-id cache) (.next-node-id state))
  (set! (.memo state) (al/al-new [MemoEntry] (.allocator state)))
  (set! (.memo-nodes state) (al/al-new [CstNode] (.allocator state)))
  (set! (.memo-expectations state) (al/al-new [Expectation] (.allocator state)))
  (set! (.memo-trace-events state) (al/al-new [TraceEvent] (.allocator state)))
  (finish-match (mut state) source end))

(defn attach-synthetic-trace-end-binding! [(result (mut MatchResult))] (-> i64)
  (let [(mut end-event) -1]
    (for [event-index 0 (len (.trace-events result))]
      (let [event (get (.trace-events result) event-index)]
        (if (and (= (.parent event) -1)
                 (and (.succeeded event) (str/str-eq (.display event) "end")))
            (set! end-event event-index)
            0)))
    (if (< (load end-event) 0)
        0
        (let [terminal-index (len (.nodes result))
              (mut terminal) (primitive/zeroed CstNode)
              event (al/al-elem [TraceEvent]
                                (mut (.trace-events result))
                                (load end-event))]
          (set! (.id terminal) 0)
          (set! (.rule terminal) "_terminal")
          (set! (.start terminal) (.end result))
          (set! (.end terminal) (.end result))
          (set! (.first-child terminal) -1)
          (set! (.last-child terminal) -1)
          (set! (.next-sibling terminal) -1)
          (push! (mut (.nodes result)) (load terminal))
          (set! (.binding event) terminal-index)
          (set! (.first-binding event) terminal-index)
          (set! (.binding-count event) 1)
          0))))

(defn trace-count [(result MatchResult)] (-> i64)
  (len (.trace-events result)))

(defn trace-display [(result MatchResult) (index i64)] (-> (slice u8))
  (let [event (get (.trace-events result) index)] (.display event)))

(defn trace-kind [(result MatchResult) (index i64)] (-> i64)
  (let [event (get (.trace-events result) index)] (.kind event)))

(defn trace-start [(result MatchResult) (index i64)] (-> i64)
  (let [event (get (.trace-events result) index)] (.start event)))

(defn trace-end [(result MatchResult) (index i64)] (-> i64)
  (let [event (get (.trace-events result) index)] (.end event)))

(defn trace-expression-source-start [(result MatchResult) (index i64)] (-> i64)
  (let [event (get (.trace-events result) index)] (.expression-source-start event)))

(defn trace-expression-source-end [(result MatchResult) (index i64)] (-> i64)
  (let [event (get (.trace-events result) index)] (.expression-source-end event)))

(defn trace-parent [(result MatchResult) (index i64)] (-> i64)
  (let [event (get (.trace-events result) index)] (.parent event)))

(defn trace-binding [(result MatchResult) (index i64)] (-> i64)
  (if (>= index 0)
      (let [event (get (.trace-events result) index)] (.binding event))
      (let [(mut binding) -1]
        (for [event-index 0 (len (.trace-events result))]
          (let [event (get (.trace-events result) event-index)]
            (if (and (= (.parent event) -1)
                     (and (.succeeded event) (not (.implicit-spaces event))))
                (set! binding (.binding event))
                0)))
        (load binding))))

(defn trace-binding-count [(result MatchResult) (index i64)] (-> i64)
  (if (>= index 0)
      (let [event (get (.trace-events result) index)] (.binding-count event))
      (let [(mut count) 0]
        (for [event-index 0 (len (.trace-events result))]
          (let [event (get (.trace-events result) event-index)]
            (if (and (= (.parent event) -1)
                     (and (.succeeded event) (not (.implicit-spaces event))))
                (set! count (+ (load count) (.binding-count event)))
                0)))
        (load count))))

(defn trace-binding-at [(result MatchResult)
                        (index i64)
                        (wanted i64)] (-> i64)
  (if (< index 0)
      (let [(mut remaining) wanted
            (mut answer) -1]
        (for [event-index 0 (len (.trace-events result))]
          (let [event (get (.trace-events result) event-index)]
            (if (and (= (.parent event) -1)
                     (and (.succeeded event) (not (.implicit-spaces event))))
                (if (< (load remaining) (.binding-count event))
                    (if (< (load answer) 0)
                        (set! answer (trace-binding-at result event-index (load remaining)))
                        0)
                    (set! remaining (- (load remaining) (.binding-count event))))
                0)))
        (load answer))
      (let [event (get (.trace-events result) index)]
        (if (or (< wanted 0) (>= wanted (.binding-count event)))
            -1
            (let [(mut binding) (.first-binding event)]
              (for [_ 0 wanted]
                (let [node (get (.nodes result) (load binding))]
                  (set! binding (.next-sibling node))))
              (load binding))))))

(defn trace-succeeded? [(result MatchResult) (index i64)] (-> bool)
  (let [event (get (.trace-events result) index)] (.succeeded event)))

(defn trace-implicit-spaces? [(result MatchResult) (index i64)] (-> bool)
  (let [event (get (.trace-events result) index)] (.implicit-spaces event)))

(defn trace-memoized? [(result MatchResult) (index i64)] (-> bool)
  (let [event (get (.trace-events result) index)] (.memoized event)))

(defn trace-left-recursion-head? [(result MatchResult) (index i64)] (-> bool)
  (let [event (get (.trace-events result) index)] (.head-of-left-recursion event)))

(defn trace-terminates-left-recursion? [(result MatchResult) (index i64)] (-> bool)
  (let [event (get (.trace-events result) index)] (.terminates-left-recursion event)))

(defn trace-has-undefined-child? [(result MatchResult) (index i64)] (-> bool)
  (let [event (get (.trace-events result) index)] (.undefined-child event)))

(defn trace-terminating-left-recursion-entry [(result MatchResult) (index i64)] (-> i64)
  (let [event (get (.trace-events result) index)] (.terminating-entry event)))

(defn trace-child-count [(result MatchResult) (parent i64)] (-> i64)
  (let [(mut count) 0]
    (for [index 0 (len (.trace-events result))]
      (let [event (get (.trace-events result) index)]
        (if (= (.parent event) parent)
            (set! count (+ (load count) 1))
            0)))
    (load count)))

(defn trace-child [(result MatchResult) (parent i64) (wanted i64)] (-> i64)
  (let [(mut seen) 0 (mut answer) -1]
    (for [index 0 (len (.trace-events result))]
      (let [event (get (.trace-events result) index)]
        (if (= (.parent event) parent)
            (do
              (if (and (< (load answer) 0) (= (load seen) wanted))
                  (set! answer index)
                  0)
              (set! seen (+ (load seen) 1)))
            0)))
    (load answer)))

(defn trace-valid? [(result MatchResult)] (-> bool)
  (let [(mut valid) (> (len (.trace-events result)) 0)]
    (for [index 0 (len (.trace-events result))]
      (let [event (get (.trace-events result) index)]
        (if (or (< (.start event) 0)
                (or (> (.start event) (len (.source result)))
                    (or (< (.end event) (.start event))
                        (or (> (.end event)
                               (+ (len (.source result))
                                  (if (.succeeded event) 0 1)))
                            (or (>= (.parent event) index)
                                (and (< (.parent event) -1)
                                     (not (and (= (.parent event) -2)
                                               (.terminates-left-recursion event)))))))))
            (set! valid false)
            0)))
    (load valid)))

(defn trace-has-successful-left-recursion? [(result MatchResult)] (-> bool)
  (let [(mut found) false]
    (for [index 0 (len (.trace-events result))]
      (let [event (get (.trace-events result) index)
            termination (.terminating-entry event)]
        (if (and (.head-of-left-recursion event)
                 (and (.succeeded event)
                      (and (>= termination 0)
                           (< termination (len (.trace-events result))))))
            (let [terminating-event (get (.trace-events result) termination)]
              (if (and (.terminates-left-recursion terminating-event)
                       (and (not (.succeeded terminating-event))
                            (and (not (.head-of-left-recursion terminating-event))
                                 (and (= (.start terminating-event) (.start event))
                                      (str/str-eq (.display terminating-event)
                                                  (.display event))))))
                  (set! found true)
                  0))
            0)))
    (load found)))

(defn trace-indentation-compatible? [(result MatchResult)] (-> bool)
  (let [(mut indent-found) false
        (mut dedent-found) false]
    (for [index 0 (len (.trace-events result))]
      (let [event (get (.trace-events result) index)]
        (cond (and (str/str-eq (.display event) "indent")
                   (and (.succeeded event)
                        (and (= (.start event) 2) (= (.end event) 2))))
                (set! indent-found true)
              (and (str/str-eq (.display event) "dedent")
                   (and (.succeeded event)
                        (and (= (.start event) 3) (= (.end event) 3))))
                (set! dedent-found true)
              :else 0)))
    (and (load indent-found) (load dedent-found))))

(defn trace-upstream-left-recursion-string-compatible!
  [(result (mut MatchResult))] (-> bool)
  (str/str-eq
    (trace-to-string! (mut result))
    "a          ✓ start (LR) ⇒  \"a\"\na              ✗ start_rec\na                ✗ start letter\na                  ✗ start\na              ✓ letter ⇒  \"a\"\na                  ✓ lower ⇒  \"a\"\na                    ✓ Unicode [Ll] character ⇒  \"a\"\n           ✓ end ⇒  \"\"\n"))

(defn trace-upstream-basic-string-compatible! [(result (mut MatchResult))] (-> bool)
  (let [actual (trace-to-string! (mut result))
        expected
          "hi         ✓ start ⇒  \"hi\"\nhi             ✗ \"a\"\nhi             ✓ letter* ⇒  \"hi\"\nhi               ✓ letter ⇒  \"h\"\nhi                   ✓ lower ⇒  \"h\"\nhi                     ✓ Unicode [Ll] character ⇒  \"h\"\ni                ✓ letter ⇒  \"i\"\ni                    ✓ lower ⇒  \"i\"\ni                      ✓ Unicode [Ll] character ⇒  \"i\"\n                 ✗ letter\n                     ✗ lower\n                       ✗ Unicode [Ll] character\n                     ✗ upper\n                       ✗ Unicode [Lu] character\n                     ✗ unicodeLtmo\n                       ✗ Unicode [Ltmo] character\n           ✓ end ⇒  \"\"\n"
        same (str/str-eq actual expected)]
    same))

(defn trace-upstream-memoization-string-compatible!
  [(result (mut MatchResult))] (-> bool)
  (str/str-eq
    (trace-to-string! (mut result))
    "⋅aB        ✓ spaces ⇒  \"⋅\"\n⋅aB          ✓ space* ⇒  \"⋅\"\n⋅aB            ✓ space ⇒  \"⋅\"\n⋅aB              ✓ \"\\u0000\"..\" \" ⇒  \"⋅\"\naB             ✗ space\naB               ✗ \"\\u0000\"..\" \"\naB         ✓ Start ⇒  \"aB\"\naB             ✗ letter ~letter\naB               ✓ spaces ⇒  \"\"\naB                 ✓ space* ⇒  \"\"\naB                   ✗ space\naB                     ✗ \"\\u0000\"..\" \"\naB               ✓ letter ⇒  \"a\"\naB                   ✓ lower ⇒  \"a\"\naB                     ✓ Unicode [Ll] character ⇒  \"a\"\nB                ✗ ~letter\nB                  ✓ spaces ⇒  \"\"\nB                    ✓ space* ⇒  \"\"\nB                      ✗ space\nB                        ✗ \"\\u0000\"..\" \"\nB                  ✓ letter ⇒  \"B\"\nB                      ✗ lower\nB                        ✗ Unicode [Ll] character\nB                      ✓ upper ⇒  \"B\"\nB                        ✓ Unicode [Lu] character ⇒  \"B\"\naB             ✓ letter* ⇒  \"aB\"\naB               ✓ spaces ⇒  \"\"\naB                 ✓ space* ⇒  \"\"\naB                   ✗ space\naB                     ✗ \"\\u0000\"..\" \"\naB               ✓ letter ⇒  \"a\"\naB                   ✓ lower ⇒  \"a\"\naB                     ✓ Unicode [Ll] character ⇒  \"a\"\nB                ✓ spaces ⇒  \"\"\nB                  ✓ space* ⇒  \"\"\nB                    ✗ space\nB                      ✗ \"\\u0000\"..\" \"\nB                ✓ letter ⇒  \"B\"\nB                    ✗ lower\nB                      ✗ Unicode [Ll] character\nB                    ✓ upper ⇒  \"B\"\nB                      ✓ Unicode [Lu] character ⇒  \"B\"\n                 ✓ spaces ⇒  \"\"\n                   ✓ space* ⇒  \"\"\n                     ✗ space\n                       ✗ \"\\u0000\"..\" \"\n                 ✗ letter\n                     ✗ lower\n                       ✗ Unicode [Ll] character\n                     ✗ upper\n                       ✗ Unicode [Lu] character\n                     ✗ unicodeLtmo\n                       ✗ Unicode [Ltmo] character\n           ✓ spaces ⇒  \"\"\n             ✓ space* ⇒  \"\"\n               ✗ space\n                 ✗ \"\\u0000\"..\" \"\n           ✓ end ⇒  \"\"\n"))

(defn trace-upstream-parameterized-compatible? [(result MatchResult)] (-> bool)
  (let [start (trace-child result -1 0)
        app (if (>= start 0) (trace-child result start 0) -1)
        alt (if (>= app 0) (trace-child result app 0) -1)
        many (if (>= alt 0) (trace-child result alt 1) -1)
        start-binding (if (>= start 0) (trace-binding result start) -1)
        app-binding (if (>= app 0) (trace-binding result app) -1)
        many-binding (if (>= many 0) (trace-binding result many) -1)
        (mut valid) true]
    (if (or (< start 0)
            (not (str/str-eq (trace-display result start) "start")))
        (set! valid false)
        0)
    (if (or (< start-binding 0)
            (or (not (str/str-eq (node-rule result start-binding) "start"))
                (not (= (node-child-count result start-binding) 1))))
        (set! valid false)
        0)
    (if (or (< app 0)
            (or (not (str/str-eq (trace-display result app) "foo<\"123\">"))
                (not (= (trace-child-count result app) 1))))
        (set! valid false)
        0)
    (if (or (< app-binding 0)
            (or (not (str/str-eq (node-rule result app-binding) "foo"))
                (not (= (node-child-count result app-binding) 1))))
        (set! valid false)
        0)
    (if (or (< alt 0)
            (or (not (str/str-eq (trace-display result alt) "\"a\" | letter*"))
                (not (= (trace-child-count result alt) 2))))
        (set! valid false)
        0)
    (if (or (< many 0) (not (= (trace-child-count result many) 6)))
        (set! valid false)
        0)
    (if (or (< many-binding 0)
            (or (not (node-iteration? result many-binding))
                (not (= (node-child-count result many-binding) 5))))
        (set! valid false)
        0)
    (load valid)))

(defn trace-upstream-bindings-compatible? [(result MatchResult)] (-> bool)
  (let [start (trace-child result -1 0)
        alt (if (>= start 0) (trace-child result start 0) -1)
        first (if (>= alt 0) (trace-binding-at result alt 0) -1)
        second (if (>= alt 0) (trace-binding-at result alt 1) -1)
        first-node (if (>= first 0)
                       (get (.nodes result) first)
                       (primitive/zeroed CstNode))
        second-node (if (>= second 0)
                        (get (.nodes result) second)
                        (primitive/zeroed CstNode))
        first-source (if (>= first 0)
                         (subslice (.source result) (.start first-node) (.end first-node))
                         "")
        second-source (if (>= second 0)
                          (subslice (.source result) (.start second-node) (.end second-node))
                          "")
        root-start (trace-binding-at result -1 0)
        root-end (trace-binding-at result -1 1)
        root-start-node (if (>= root-start 0)
                            (get (.nodes result) root-start)
                            (primitive/zeroed CstNode))
        root-end-node (if (>= root-end 0)
                          (get (.nodes result) root-end)
                          (primitive/zeroed CstNode))]
    (and (= (trace-binding-count result -1) 2)
         (and (str/str-eq (.rule root-start-node) "start")
              (and (= (.start root-start-node) 0)
                   (and (= (.end root-start-node) 2)
                        (and (str/str-eq (.rule root-end-node) "_terminal")
                             (and (= (.start root-end-node) 2)
                                  (and (= (.end root-end-node) 2)
    (and (>= start 0)
         (and (= (trace-binding-count result start) 1)
              (and (>= alt 0)
                   (and (= (trace-binding-count result alt) 2)
                        (and (>= first 0)
                             (and (>= second 0)
                                  (and (str/str-eq (.rule first-node) "_terminal")
                                       (if (str/str-eq first-source "a")
                                           (and (str/str-eq second-source "b")
                                                (str/str-eq (.rule second-node) "_terminal"))
                                           (and (str/str-eq first-source "c")
                                                (and (str/str-eq second-source "d")
                                                     (str/str-eq (.rule second-node) "notX"))))))))))))))))))))

(defn trace-upstream-incremental-memo-compatible? [(result MatchResult)] (-> bool)
  (let [start (trace-child result -1 0)
        seq (if (>= start 0) (trace-child result start 0) -1)
        look (if (>= seq 0) (trace-child result seq 0) -1)
        first-id (if (>= look 0) (trace-child result look 0) -1)
        second-id (if (>= seq 0) (trace-child result seq 1) -1)
        first-binding (if (>= first-id 0) (trace-binding-at result first-id 0) -1)
        second-binding (if (>= second-id 0) (trace-binding-at result second-id 0) -1)
        first-node (if (>= first-binding 0)
                       (get (.nodes result) first-binding)
                       (primitive/zeroed CstNode))
        second-node (if (>= second-binding 0)
                        (get (.nodes result) second-binding)
                        (primitive/zeroed CstNode))]
    (and (>= first-id 0)
         (and (>= second-id 0)
              (and (str/str-eq (trace-display result first-id) "id")
                   (and (str/str-eq (trace-display result second-id) "id")
                        (and (trace-left-recursion-head? result first-id)
                             (and (trace-left-recursion-head? result second-id)
                                  (and (= (trace-expression-source-start result first-id) 15)
                                       (and (= (trace-expression-source-end result first-id) 17)
                                            (and (= (trace-expression-source-start result second-id) 18)
                                                 (and (= (trace-expression-source-end result second-id) 20)
                                                      (and (= (trace-start result first-id) 0)
                                                           (and (= (trace-start result second-id) 0)
                                                                (and (trace-succeeded? result first-id)
                                                                     (and (trace-succeeded? result second-id)
                                                                          (and (str/str-eq (.rule first-node) "id")
                                                                               (and (= (.start first-node) 0)
                                                                                    (and (= (.end first-node) 2)
                                                                                         (and (str/str-eq (.rule second-node) "id")
                                                                                              (and (= (.start second-node) 0)
                                                                                                   (= (.end second-node) 2))))))))))))))))))))))

(defn trace-upstream-parameterized-memo-compatible? [(result (mut MatchResult))] (-> bool)
  (let [actual (trace-to-string! (mut result))
        expected
          "aB         ✓ start ⇒  \"aB\"\naB             ✗ foo<\"123\"> ~foo<\"123\">\naB               ✓ foo<\"123\"> ⇒  \"a\"\naB                 ✓ letter ⇒  \"a\"\naB                     ✓ lower ⇒  \"a\"\naB                       ✓ Unicode [Ll] character ⇒  \"a\"\nB                ✗ ~foo<\"123\">\nB                  ✓ foo<\"123\"> ⇒  \"B\"\nB                    ✓ letter ⇒  \"B\"\nB                        ✗ lower\nB                          ✗ Unicode [Ll] character\nB                        ✓ upper ⇒  \"B\"\nB                          ✓ Unicode [Lu] character ⇒  \"B\"\naB             ✓ foo<\"123\">* ⇒  \"aB\"\naB               ✓ foo<\"123\"> ⇒  \"a\"\naB                 ✓ letter ⇒  \"a\"\naB                     ✓ lower ⇒  \"a\"\naB                       ✓ Unicode [Ll] character ⇒  \"a\"\nB                ✓ foo<\"123\"> ⇒  \"B\"\nB                  ✓ letter ⇒  \"B\"\nB                      ✗ lower\nB                        ✗ Unicode [Ll] character\nB                      ✓ upper ⇒  \"B\"\nB                        ✓ Unicode [Lu] character ⇒  \"B\"\n                 ✗ foo<\"123\">\n                   ✗ letter\n                       ✗ lower\n                         ✗ Unicode [Ll] character\n                       ✗ upper\n                         ✗ Unicode [Lu] character\n                       ✗ unicodeLtmo\n                         ✗ Unicode [Ltmo] character\n           ✓ end ⇒  \"\"\n"]
    (if (not (str/str-eq actual expected))
        (let [_ (io/print-str (io/stderr) actual)] 0)
        0)
    (str/str-eq actual expected)))

(defn trace-upstream-left-recursion-spaces-compatible? [(result MatchResult)] (-> bool)
  (let [foo (trace-child result -1 1)
        alt (if (>= foo 0) (trace-child result foo 0) -1)
        foo-y (if (>= alt 0) (trace-child result alt 3) -1)
        seq (if (>= foo-y 0) (trace-child result foo-y 0) -1)
        nested-foo (if (>= seq 0) (trace-child result seq 1) -1)
        nested-alt (if (>= nested-foo 0) (trace-child result nested-foo 0) -1)
        (mut valid) true]
    (if (or (< foo 0)
            (or (not (trace-left-recursion-head? result foo))
                (not (= (trace-child-count result foo) 1))))
        (set! valid false)
        0)
    (if (or (< alt 0)
            (or (not (= (trace-child-count result alt) 4))
                (or (not (str/str-eq (trace-display result (trace-child result alt 0))
                                     "spaces"))
                    (or (trace-succeeded? result (trace-child result alt 1))
                        (not (trace-succeeded? result (trace-child result alt 3)))))))
        (set! valid false)
        0)
    (if (or (< foo-y 0)
            (or (not (str/str-eq (trace-display result foo-y) "Foo_y"))
                (not (= (trace-child-count result foo-y) 1))))
        (set! valid false)
        0)
    (if (or (< seq 0)
            (or (not (= (trace-child-count result seq) 4))
                (or (not (str/str-eq (trace-display result (trace-child result seq 1))
                                     "Foo"))
                    (not (str/str-eq (trace-display result (trace-child result seq 3))
                                     "\"y\"")))))
        (set! valid false)
        0)
    (if (or (< nested-foo 0)
            (or (trace-left-recursion-head? result nested-foo)
                (not (= (trace-child-count result nested-foo) 1))))
        (set! valid false)
        0)
    (if (or (< nested-alt 0)
            (or (not (= (trace-child-count result nested-alt) 6))
                (not (str/str-eq (trace-display result (trace-child result nested-alt 5))
                                 "\"z\""))))
        (set! valid false)
        0)
    (load valid)))

(defn trace-upstream-case-insensitive-compatible? [(result MatchResult)] (-> bool)
  (let [start (trace-child result -1 0)
        app (if (>= start 0) (trace-child result start 0) -1)
        inner (if (>= app 0) (trace-child result app 0) -1)]
    (and (>= app 0)
         (and (str/str-eq (trace-display result app) "caseInsensitive<\"tk\">")
              (and (= (trace-child-count result app) 1)
                   (and (>= inner 0)
                        (not (str/str-eq (trace-display result inner)
                                         "\"tk\" (case-insensitive)"))))))))

(defn trace-upstream-splice-compatible? [(result MatchResult)] (-> bool)
  (let [letter (trace-child result -1 0)
        splice (if (>= letter 0) (trace-child result letter 0) -1)
        inherited (if (>= splice 0) (trace-child result splice 1) -1)]
    (and (>= splice 0)
         (and (= (trace-kind result splice) 2)
              (and (str/str-eq (trace-display result splice) "\"@\" | ...")
                   (and (= (trace-child-count result splice) 2)
                        (and (>= inherited 0) (= (trace-kind result inherited) 1))))))))

(defn trace-basic-compatible? [(result MatchResult)] (-> bool)
  (let [start (trace-child result -1 0)
        end-event (trace-child result -1 1)
        alt (if (>= start 0) (trace-child result start 0) -1)
        failed (if (>= alt 0) (trace-child result alt 0) -1)
        many (if (>= alt 0) (trace-child result alt 1) -1)
        (mut valid) (= (trace-child-count result -1) 2)]
    (if (or (< start 0)
            (or (not (str/str-eq (trace-display result start) "start"))
                (or (not (trace-succeeded? result start))
                    (not (= (trace-start result start) 0)))))
        (set! valid false)
        0)
    (if (or (< end-event 0)
            (not (str/str-eq (trace-display result end-event) "end")))
        (set! valid false)
        0)
    (if (or (< alt 0)
            (or (not (str/str-eq (trace-display result alt) "\"a\" | letter*"))
                (not (= (trace-child-count result alt) 2))))
        (set! valid false)
        0)
    (if (or (< failed 0) (trace-succeeded? result failed)) (set! valid false) 0)
    (if (or (< many 0)
            (or (not (trace-succeeded? result many))
                (not (= (trace-child-count result many) 6))))
        (set! valid false)
        0)
    (if (and (>= many 0) (= (trace-child-count result many) 6))
        (if (trace-succeeded? result (trace-child result many 5))
            (set! valid false)
            0)
        0)
    (load valid)))

(defn trace-spaces-compatible? [(result MatchResult)] (-> bool)
  (let [leading (trace-child result -1 0)
        start (trace-child result -1 1)
        trailing (trace-child result -1 2)
        end-event (trace-child result -1 3)
        start-leading (if (>= start 0) (trace-child result start 0) -1)
        terminal (if (>= start 0) (trace-child result start 1) -1)]
    (and (= (trace-child-count result -1) 4)
         (and (>= leading 0)
              (and (str/str-eq (trace-display result leading) "spaces")
                   (and (trace-implicit-spaces? result leading)
                        (and (>= start 0)
                             (and (str/str-eq (trace-display result start) "Start")
                                  (and (= (trace-child-count result start) 2)
                                       (and (>= start-leading 0)
                                            (and (trace-implicit-spaces? result start-leading)
                                                 (and (>= terminal 0)
                                                      (and (str/str-eq (trace-display result terminal)
                                                                       "\"a\"")
                                                           (and (= (trace-child-count result terminal) 0)
                                                                (and (>= trailing 0)
                                                                     (and (trace-implicit-spaces?
                                                                            result
                                                                            trailing)
                                                                          (and (>= end-event 0)
                                                                               (str/str-eq
                                                                                 (trace-display result
                                                                                                end-event)
                                                                                 "end"))))))))))))))))))

(defn trace-visible-depth [(result MatchResult) (index i64)] (-> i64)
  (let [initial (get (.trace-events result) index)
        (mut parent) (.parent initial)
        (mut depth) 0
        (mut visible) true]
    (loop (if (< (load parent) 0)
              (break)
              (let [parent-event (get (.trace-events result) (load parent))]
                (set! depth (+ (load depth) 1))
                (set! parent (.parent parent-event)))))
    (if (= (load parent) -2) (set! visible false) 0)
    (if (load visible) (load depth) -1)))

(defn push-visible-scalar! [(builder (mut str/StrBuf))
                            (source (slice u8))
                            (at i64)] (-> i64)
  (let [scalar (decode-utf8 source at)]
    (if (not (.valid scalar))
        (do
          (str/sb-push-byte! (mut builder) (slice-get source at))
          1)
        (do
          (cond (= (.value scalar) 32) (str/sb-push-str! (mut builder) "⋅")
                (= (.value scalar) 9) (str/sb-push-str! (mut builder) "␉")
                (= (.value scalar) 10) (str/sb-push-str! (mut builder) "␊")
                (= (.value scalar) 13) (str/sb-push-str! (mut builder) "␍")
                :else
                  (str/sb-push-str! (mut builder)
                                    (subslice source at (+ at (.width scalar)))))
          (.width scalar)))))

(defn push-visible-source! [(builder (mut str/StrBuf))
                            (source (slice u8))
                            (start i64)
                            (end i64)] (-> i64)
  (let [(mut at) start (mut count) 0]
    (loop (if (>= (load at) end)
              (break)
              (do
                (set! at (+ (load at) (push-visible-scalar! (mut builder) source (load at))))
                (set! count (+ (load count) 1)))))
    (load count)))

(defn push-trace-excerpt! [(builder (mut str/StrBuf))
                           (source (slice u8))
                           (start i64)] (-> i64)
  (let [(mut at) start (mut count) 0]
    (loop (if (or (>= (load at) (slice-len source)) (>= (load count) 10))
              (break)
              (do
                (set! at (+ (load at) (push-visible-scalar! (mut builder) source (load at))))
                (set! count (+ (load count) 1)))))
    (for [_ (load count) 10] (str/sb-push-str! (mut builder) " "))
    0))

(defn trace-to-string! [(result (mut MatchResult))] (-> (slice u8))
  (let [(mut builder) (str/sb-new (.allocator result))]
    (for [index 0 (len (.trace-events result))]
      (let [event (get (.trace-events result) index)
            depth (trace-visible-depth (load result) index)]
        (if (and (>= depth 0) (not (= (.kind event) 1)))
            (do
              (push-trace-excerpt! (mut builder) (.source result) (.start event))
              (for [_ 0 (+ (* depth 2) 1)] (str/sb-push-str! (mut builder) " "))
              (str/sb-push-str! (mut builder) (if (.succeeded event) "✓ " "✗ "))
              (str/sb-push-str! (mut builder) (.display event))
              (if (.head-of-left-recursion event)
                  (str/sb-push-str! (mut builder) " (LR)")
                  0)
              (if (.succeeded event)
                  (do
                    (str/sb-push-str! (mut builder) " ⇒  \"")
                    (push-visible-source! (mut builder)
                                          (.source result)
                                          (.start event)
                                          (.end event))
                    (str/sb-push-str! (mut builder) "\""))
                  0)
              (str/sb-push-str! (mut builder) "\n"))
            0)))
    (let [text (str/sb-finish! (mut builder))]
      (push! (mut (.owned-names result)) text)
      text)))

(defn trace-print! [(result (mut MatchResult))] (-> i64)
  (let [_ (io/print-str (io/stderr) (trace-to-string! (mut result)))] 0))

(defn trace-descends-from-any? [(result MatchResult)
                                (index i64)
                                (roots (al/ArrayList i64))] (-> bool)
  (let [event (get (.trace-events result) index)
        (mut parent) (.parent event)
        (mut found) false]
    (loop (if (or (< (load parent) 0) (load found))
              (break)
              (do
                (for root
                  (iter roots)
                  (if (= root (load parent)) (set! found true) 0))
                (if (not (load found))
                    (let [parent-event (get (.trace-events result) (load parent))]
                      (set! parent (.parent parent-event)))
                    0))))
    (load found)))

(defn trace-walk [(Visitor OhmTraceVisitor)] [(visitor (mut Visitor))
                                               (result (ptr MatchResult))] (-> i64)
  (let [(mut entered) (al/al-new [i64] (.allocator result))
        (mut skipped) (al/al-new [i64] (.allocator result))]
    (for [index 0 (len (.trace-events result))]
      (let [event (get (.trace-events result) index)
            depth (trace-visible-depth (load result) index)]
        (if (>= depth 0)
            (do
              (loop (if (= (len (load entered)) 0)
                        (break)
                        (let [previous (get (load entered) (- (len (load entered)) 1))
                              previous-depth (trace-visible-depth (load result) previous)]
                          (if (< previous-depth depth)
                              (break)
                              (let [previous-event (get (.trace-events result) previous)]
                                (trace-visitor-exit (mut visitor)
                                                    result
                                                    previous
                                                    (.parent previous-event)
                                                    previous-depth)
                                (pop! (mut entered)))))))
              (if (not (trace-descends-from-any? (load result) index (load skipped)))
                  (if (trace-visitor-enter (mut visitor)
                                           result
                                           index
                                           (.parent event)
                                           depth)
                      (push! (mut entered) index)
                      (push! (mut skipped) index))
                  0))
            0)))
    (loop (if (= (len (load entered)) 0)
              (break)
              (let [index (get (load entered) (- (len (load entered)) 1))
                    _ (pop! (mut entered))
                    event (get (.trace-events result) index)]
                (trace-visitor-exit (mut visitor)
                                    result
                                    index
                                    (.parent event)
                                    (trace-visible-depth (load result) index)))))
    (al/al-free! (mut entered))
    (al/al-free! (mut skipped))
    0))

(defn match-succeeded? [(result MatchResult)] (-> bool)
  (.succeeded result))

(defn match-input [(result MatchResult)] (-> (slice u8))
  (.source result))

(defn match-matcher [(result MatchResult)] (-> (ptr OhmMatcher))
  (primitive/cast (ptr OhmMatcher) (.matcher result)))

(defn retain-match-matcher! [(result (mut MatchResult))
                             (matcher (ptr OhmMatcher))] (-> i64)
  (set! (.matcher result) (primitive/cast (ptr u8) matcher))
  0)

(defn retain-owned-match-matcher! [(result (mut MatchResult))
                                   (matcher (ptr OhmMatcher))] (-> i64)
  (retain-match-matcher! (mut result) matcher)
  (set! (.owns-matcher result) true)
  0)

(defn attach-new-owned-match-matcher! [(result (mut MatchResult))
                                       (grammar OhmGrammar)
                                       (input (slice u8))] (-> i64)
  (match (alloc/alloc [OhmMatcher] (.allocator grammar) 1)
    (None []
      (do
        (alloc/oom-at c"ohm MatchResult matcher" (primitive/sizeof OhmMatcher))
        0))
    (Some [memory]
      (let [matcher (alloc/alloc-slice-data memory)
            _ (store! matcher (ohm-grammar-owned-matcher grammar))
            _ (matcher-set-input! matcher input)]
        (retain-owned-match-matcher! (mut result) matcher)))))

(defn match-failed? [(result MatchResult)] (-> bool)
  (not (.succeeded result)))

(defn match-root [(result MatchResult)] (-> i64)
  (.root result))

(defn match-node-count [(result MatchResult)] (-> i64)
  (len (.nodes result)))

(defn result-end [(result MatchResult)] (-> i64)
  (.end result))

(defn match-expected-text [(result MatchResult)] (-> (slice u8))
  (.expected-text result))

(defn match-failure-position [(result MatchResult)] (-> i64)
  (source-byte-position-to-utf16 (.source result) (.failure-position result)))

(defn match-failure-byte-position [(result MatchResult)] (-> i64)
  (.failure-position result))

(defn match-failure-line [(result MatchResult)] (-> i64)
  (.failure-line result))

(defn match-failure-column [(result MatchResult)] (-> i64)
  (.failure-column result))

(defn match-short-message [(result MatchResult)] (-> (slice u8))
  (.short-message result))

(defn match-message [(result MatchResult)] (-> (slice u8))
  (.message result))

(defn match-interval [(result MatchResult)] (-> OhmInterval)
  (let [position (match-failure-position result)]
    (new-ohm-interval (.source result) position position)))

(defn match-to-string! [(result (mut MatchResult))] (-> (slice u8))
  (if (.succeeded result)
      "[match succeeded]"
      (let [(mut builder) (str/sb-new (.allocator result))]
        (str/sb-push-str! (mut builder) "[match failed at position ")
        (str/sb-push-i64! (mut builder) (match-failure-position (load result)))
        (str/sb-push-str! (mut builder) "]")
        (let [value (str/sb-finish! (mut builder))]
          (push! (mut (.owned-names result)) value)
          value))))

(defn new-ohm-matcher [(parse (fnptr c [(slice u8) (slice u8)] MatchResult))
                       (start-rule (slice u8))
                       (a (dyn alloc/Allocator))] (-> OhmMatcher)
  (let [(mut matcher) (primitive/zeroed OhmMatcher)]
    (set! (.input matcher) (al/al-new [u8] a))
    (set! (.parse matcher) parse)
    (set! (.cache matcher) (new-parse-cache a))
    (set! (.incremental matcher) false)
    (set! (.supports-incremental-parsing matcher) true)
    (set! (.has-matched matcher) false)
    (set! (.unsupported-incremental-edit matcher) false)
    (set! (.cached-start-rule matcher) "")
    (set! (.has-cached-start-rule matcher) false)
    (set! (.start-rule matcher) start-rule)
    (set! (.allocator matcher) a)
    (load matcher)))

(defn new-incremental-ohm-matcher
  [(parse (fnptr c [(slice u8) (slice u8) bool (mut ParseCache)] MatchResult))
   (start-rule (slice u8))
   (a (dyn alloc/Allocator))] (-> OhmMatcher)
  (let [(mut matcher) (primitive/zeroed OhmMatcher)]
    (set! (.input matcher) (al/al-new [u8] a))
    (set! (.parse-incremental matcher) parse)
    (set! (.cache matcher) (new-parse-cache a))
    (set! (.incremental matcher) true)
    (set! (.supports-incremental-parsing matcher) true)
    (set! (.has-matched matcher) false)
    (set! (.unsupported-incremental-edit matcher) false)
    (set! (.cached-start-rule matcher) "")
    (set! (.has-cached-start-rule matcher) false)
    (set! (.start-rule matcher) start-rule)
    (set! (.allocator matcher) a)
    (load matcher)))

(defn new-indentation-ohm-matcher
  [(parse (fnptr c [(slice u8) (slice u8) bool (mut ParseCache)] MatchResult))
   (start-rule (slice u8))
   (a (dyn alloc/Allocator))] (-> OhmMatcher)
  (let [(mut matcher) (new-incremental-ohm-matcher parse start-rule a)]
    (set! (.supports-incremental-parsing matcher) false)
    (load matcher)))

(defn clear-parse-cache! [(cache (mut ParseCache))] (-> i64)
  (al/al-free! (mut (.memo cache)))
  (al/al-free! (mut (.memo-nodes cache)))
  (al/al-free! (mut (.memo-expectations cache)))
  (al/al-free! (mut (.memo-trace-events cache)))
  (al/al-free! (mut (.stable-identities cache)))
  (set! (.memo cache) (al/al-new [MemoEntry] (.allocator cache)))
  (set! (.memo-nodes cache) (al/al-new [CstNode] (.allocator cache)))
  (set! (.memo-expectations cache) (al/al-new [Expectation] (.allocator cache)))
  (set! (.memo-trace-events cache) (al/al-new [TraceEvent] (.allocator cache)))
  (set! (.stable-identities cache)
        (al/al-new [StableNodeIdentity] (.allocator cache)))
  0)

(defn copy-memo-entry [(source MemoEntry)] (-> MemoEntry)
  (let [(mut entry) (primitive/zeroed MemoEntry)]
    (set! (.rule-id entry) (.rule-id source))
    (set! (.rule-name entry) (.rule-name source))
    (set! (.generation entry) (.generation source))
    (set! (.start entry) (.start source))
    (set! (.best-end entry) (.best-end source))
    (set! (.snapshot-start entry) (.snapshot-start source))
    (set! (.snapshot-count entry) (.snapshot-count source))
    (set! (.root-offset entry) (.root-offset source))
    (set! (.failure-start entry) (.failure-start source))
    (set! (.failure-count entry) (.failure-count source))
    (set! (.failure-position entry) (.failure-position source))
    (set! (.examined-end entry) (.examined-end source))
    (set! (.trace-source-start entry) (.trace-source-start source))
    (set! (.trace-snapshot-start entry) (.trace-snapshot-start source))
    (set! (.trace-snapshot-count entry) (.trace-snapshot-count source))
    (load entry)))

(defn parse-cache-replace-range! [(cache (mut ParseCache))
                                  (start i64)
                                  (end i64)
                                  (replacement-length i64)] (-> i64)
  (let [delta (- replacement-length (- end start))
        (mut next-memo) (al/al-new [MemoEntry] (.allocator cache))
        (mut next-nodes) (al/al-new [CstNode] (.allocator cache))
        (mut next-expectations) (al/al-new [Expectation] (.allocator cache))
        (mut next-traces) (al/al-new [TraceEvent] (.allocator cache))
        (mut next-identities) (al/al-new [StableNodeIdentity] (.allocator cache))]
    (for old-entry
      (iter (.memo cache))
      (let [old-entry old-entry]
        (if (or (and (< (.start old-entry) start)
                     (<= (.examined-end old-entry) start))
                (>= (.start old-entry) end))
          (let [entry-shift (if (>= (.start old-entry) end) delta 0)
                (mut entry) (copy-memo-entry old-entry)
                node-start (len (load next-nodes))
                expectation-start (len (load next-expectations))
                trace-start (len (load next-traces))]
            (for [offset 0 (.snapshot-count old-entry)]
              (let [old-node
                      (get (.memo-nodes cache) (+ (.snapshot-start old-entry) offset))
                    (mut node) (primitive/zeroed CstNode)]
                (set! (.rule node) (.rule old-node))
                (set! (.id node) (.id old-node))
                (set! (.start node) (+ (.start old-node) entry-shift))
                (set! (.end node) (+ (.end old-node) entry-shift))
                (set! (.first-child node)
                      (replay-index (.first-child old-node)
                                    (.snapshot-start old-entry)
                                    node-start))
                (set! (.last-child node)
                      (replay-index (.last-child old-node)
                                    (.snapshot-start old-entry)
                                    node-start))
                (set! (.next-sibling node)
                      (replay-index (.next-sibling old-node)
                                    (.snapshot-start old-entry)
                                    node-start))
                (set! (.optional node) (.optional old-node))
                (push! (mut next-nodes) (load node))))
            (for [offset 0 (.failure-count old-entry)]
              (push! (mut next-expectations)
                     (get (.memo-expectations cache)
                          (+ (.failure-start old-entry) offset))))
            (for [offset 0 (.trace-snapshot-count old-entry)]
              (let [old-event
                      (get (.memo-trace-events cache)
                           (+ (.trace-snapshot-start old-entry) offset))
                    (mut event) (copy-trace-event old-event)]
                (set! (.start event) (+ (.start old-event) entry-shift))
                (set! (.end event) (+ (.end old-event) entry-shift))
                (set! (.parent event)
                      (cond (= (.parent old-event) -2) -2
                            (< (.parent old-event) 0) -1
                            :else
                              (+ trace-start
                                 (- (.parent old-event)
                                    (.trace-snapshot-start old-entry)))))
                (set! (.binding event)
                      (if (< (.binding old-event) 0)
                          -1
                          (+ node-start
                             (- (.binding old-event) (.snapshot-start old-entry)))))
                (set! (.first-binding event)
                      (if (< (.first-binding old-event) 0)
                          -1
                          (+ node-start
                             (- (.first-binding old-event)
                                (.snapshot-start old-entry)))))
                (set! (.prior-binding event) -1)
                (set! (.terminating-entry event)
                      (if (< (.terminating-entry old-event) 0)
                          -1
                          (+ trace-start
                             (- (.terminating-entry old-event)
                                (.trace-snapshot-start old-entry)))))
                (push! (mut next-traces) (load event))))
            (set! (.start entry) (+ (.start old-entry) entry-shift))
            (if (>= (.best-end old-entry) 0)
                (set! (.best-end entry) (+ (.best-end old-entry) entry-shift))
                0)
            (if (>= (.failure-position old-entry) 0)
                (set! (.failure-position entry)
                      (+ (.failure-position old-entry) entry-shift))
                0)
            (set! (.examined-end entry) (+ (.examined-end old-entry) entry-shift))
            (set! (.snapshot-start entry) node-start)
            (set! (.failure-start entry) expectation-start)
            (set! (.trace-source-start entry) 0)
            (set! (.trace-snapshot-start entry) trace-start)
            (push! (mut next-memo) (load entry)))
            0)))
    (for old-identity
      (iter (.stable-identities cache))
      (let [candidate old-identity]
        (if (or (and (< (.start candidate) start)
                     (<= (.examined-end candidate) start))
                (>= (.start candidate) end))
            (let [identity-shift (if (>= (.start candidate) end) delta 0)
                  (mut identity) (primitive/zeroed StableNodeIdentity)]
              (set! (.rule-name identity) (.rule-name candidate))
              (set! (.start identity) (+ (.start candidate) identity-shift))
              (set! (.examined-end identity)
                    (+ (.examined-end candidate) identity-shift))
              (set! (.path identity) (.path candidate))
              (set! (.snapshot-id identity) (.snapshot-id candidate))
              (set! (.id identity) (.id candidate))
              (push! (mut next-identities) (load identity)))
            0)))
    (al/al-free! (mut (.memo cache)))
    (al/al-free! (mut (.memo-nodes cache)))
    (al/al-free! (mut (.memo-expectations cache)))
    (al/al-free! (mut (.memo-trace-events cache)))
    (al/al-free! (mut (.stable-identities cache)))
    (set! (.memo cache) (load next-memo))
    (set! (.memo-nodes cache) (load next-nodes))
    (set! (.memo-expectations cache) (load next-expectations))
    (set! (.memo-trace-events cache) (load next-traces))
    (set! (.stable-identities cache) (load next-identities))
    0))

(defn parse-cache-ensure-tracing! [(cache (mut ParseCache))] (-> i64)
  (let [(mut complete) true]
    (for entry
      (iter (.memo cache))
      (let [entry entry]
        (if (= (.trace-snapshot-count entry) 0) (set! complete false) 0)))
    (if (load complete) 0 (clear-parse-cache! (mut cache)))))

(defn matcher-input [(matcher (ptr OhmMatcher))] (-> (slice u8))
  (al/al-slice [u8] (.input matcher)))

(defn unsupported-incremental-parsing [] (-> i64)
  (io/print-str (io/stderr) "this grammar does not support incremental parsing\n")
  (alloc/abort))

(defn missing-start-rule [] (-> i64)
  (io/print-str
    (io/stderr)
    "Missing start rule argument -- the grammar has no default start rule.\n")
  (alloc/abort))

(defn unknown-grammar [(name (slice u8))] (-> i64)
  (io/print-str (io/stderr) "Grammar ")
  (io/print-str (io/stderr) name)
  (io/print-str (io/stderr) " is not declared\n")
  (alloc/abort))

(defn matcher-prepare-start! [(matcher (mut OhmMatcher))
                              (start-rule (slice u8))] (-> i64)
  (if (.incremental matcher)
      (if (and (.has-cached-start-rule matcher)
               (not (str/str-eq (.cached-start-rule matcher) start-rule)))
          (clear-parse-cache! (mut (.cache matcher)))
          0)
      0)
  (set! (.cached-start-rule matcher) start-rule)
  (set! (.has-cached-start-rule matcher) true)
  0)

(defn matcher-replace-input-range! [(matcher (mut OhmMatcher))
                                    (start i64)
                                    (end i64)
                                    (replacement (slice u8))] (-> bool)
  (let [old-source (al/al-slice [u8] (.input matcher))
        old-utf16-count (ohm-source-utf16-length old-source)]
    (if (or (< start 0) (or (> end old-utf16-count) (> start end)))
        false
        (let [byte-start (ohm-source-utf16-to-byte old-source start)
              byte-end (ohm-source-utf16-to-byte old-source end)
              start-boundary (ohm-source-utf16-boundary? old-source start)
              end-boundary (ohm-source-utf16-boundary? old-source end)
              (mut slicer)
                (new-ohm-input-stream-with-allocator old-source (.allocator matcher))
              prefix (ohm-input-stream-source-slice (mut slicer) 0 start)
              replaced (ohm-input-stream-source-slice (mut slicer) start end)
              suffix
                (ohm-input-stream-source-slice
                  (mut slicer) end old-utf16-count)
              unchanged (str/str-eq replaced replacement)]
          (if (and (.has-matched matcher)
                   (and (not (.supports-incremental-parsing matcher))
                        (not unchanged)))
              (set! (.unsupported-incremental-edit matcher) true)
              0)
          (let [(mut next) (al/al-new [u8] (.allocator matcher))]
          (for byte (iter prefix) (push! (mut next) byte))
          (for byte
            (iter replacement)
            (push! (mut next) byte))
          (for byte (iter suffix) (push! (mut next) byte))
          (al/al-free! (mut (.input matcher)))
          (set! (.input matcher) (load next))
          (if (.incremental matcher)
              (cond (and start-boundary end-boundary)
                      (parse-cache-replace-range! (mut (.cache matcher))
                                                  byte-start
                                                  byte-end
                                                  (slice-len replacement))
                    :else (clear-parse-cache! (mut (.cache matcher))))
              0)
          (free-ohm-input-stream! (mut slicer))
            true)))))

(defn matcher-set-input! [(matcher (mut OhmMatcher))
                          (input (slice u8))] (-> bool)
  (matcher-replace-input-range!
    (mut matcher)
    0
    (ohm-source-utf16-length (matcher-input matcher))
    input))

;; Public, chainable counterpart of JavaScript Matcher#replaceInputRange.
;; Invalid ranges are retained as a checked `false` result on the bang helper;
;; valid public calls return the same matcher identity, as upstream does.
(defn matcher-replace-input-range [(matcher (mut OhmMatcher))
                                   (start i64)
                                   (end i64)
                                   (replacement (slice u8))]
                                  (-> (mut OhmMatcher))
  (let [length (ohm-source-utf16-length (matcher-input matcher))]
    (if (or (< start 0)
            (or (> start length)
                (or (< end 0) (or (> end length) (> start end)))))
        (let [(mut message) (str/sb-new (.allocator matcher))]
          (str/sb-push-str! (mut message) "Invalid indices: ")
          (str/sb-push-i64! (mut message) start)
          (str/sb-push-str! (mut message) " and ")
          (str/sb-push-i64! (mut message) end)
          (str/sb-push-byte! (mut message) 10)
          (io/print-str (io/stderr) (str/sb-finish! (mut message)))
          (alloc/abort))
        0))
  (matcher-replace-input-range! (mut matcher) start end replacement)
  matcher)

(defn own-match-source! [(result (mut MatchResult))] (-> i64)
  (let [(mut owned) (str/sb-new (.allocator result))]
    (str/sb-push-str! (mut owned) (.source result))
    (let [source (str/sb-finish! (mut owned))]
      (push! (mut (.owned-names result)) source)
      (set! (.source result) source)
      0)))

(defn matcher-match [(matcher (mut OhmMatcher))] (-> MatchResult)
  (if (= (slice-len (.start-rule matcher)) 0)
      (missing-start-rule)
      0)
  (if (.unsupported-incremental-edit matcher)
      (unsupported-incremental-parsing)
      0)
  (let [_ (matcher-prepare-start! (mut matcher) (.start-rule matcher))
        (mut result)
          (if (.incremental matcher)
              (primitive/call-ptr (.parse-incremental matcher)
                                  (matcher-input matcher)
                                  (.start-rule matcher)
                                  false
                                  (mut (.cache matcher)))
              (primitive/call-ptr (.parse matcher)
                                  (matcher-input matcher)
                                  (.start-rule matcher)))]
    (own-match-source! (mut result))
    (retain-match-matcher! (mut result) matcher)
    (set! (.has-matched matcher) true)
    (load result)))

(defn matcher-match-from [(matcher (mut OhmMatcher))
                          (start-rule (slice u8))] (-> MatchResult)
  (if (.unsupported-incremental-edit matcher)
      (unsupported-incremental-parsing)
      0)
  (let [_ (matcher-prepare-start! (mut matcher) start-rule)
        (mut result)
          (if (.incremental matcher)
              (primitive/call-ptr (.parse-incremental matcher)
                                  (matcher-input matcher)
                                  start-rule
                                  false
                                  (mut (.cache matcher)))
              (primitive/call-ptr (.parse matcher)
                                  (matcher-input matcher)
                                  start-rule))]
    (own-match-source! (mut result))
    (retain-match-matcher! (mut result) matcher)
    (set! (.has-matched matcher) true)
    (load result)))

(defn matcher-trace [(matcher (mut OhmMatcher))] (-> MatchResult)
  (if (= (slice-len (.start-rule matcher)) 0)
      (missing-start-rule)
      0)
  (matcher-trace-from (mut matcher) (.start-rule matcher)))

(defn matcher-trace-from [(matcher (mut OhmMatcher))
                          (start-rule (slice u8))] (-> MatchResult)
  (if (.unsupported-incremental-edit matcher)
      (unsupported-incremental-parsing)
      0)
  (matcher-prepare-start! (mut matcher) start-rule)
  (if (not (.incremental matcher))
      (let [(mut result)
              (primitive/call-ptr (.parse matcher)
                                  (matcher-input matcher)
                                  start-rule)]
        (own-match-source! (mut result))
        (retain-match-matcher! (mut result) matcher)
        (set! (.has-matched matcher) true)
        (load result))
      (let [(mut result)
              (do
                (parse-cache-ensure-tracing! (mut (.cache matcher)))
                (primitive/call-ptr (.parse-incremental matcher)
                                    (matcher-input matcher)
                                    start-rule
                                    true
                                    (mut (.cache matcher))))]
        (own-match-source! (mut result))
        (retain-match-matcher! (mut result) matcher)
        (set! (.has-matched matcher) true)
        (load result))))

(defn ohm-grammar-run-owned! [(grammar (ptr OhmGrammar))
                              (input (slice u8))
                              (start-rule (slice u8))
                              (tracing bool)] (-> MatchResult)
  (match (alloc/alloc [OhmMatcher] (.allocator grammar) 1)
    (None []
      (do
        (alloc/oom-at c"ohm Grammar.match matcher" (primitive/sizeof OhmMatcher))
        (primitive/zeroed MatchResult)))
    (Some [memory]
      (let [matcher (alloc/alloc-slice-data memory)
            _ (store! matcher (ohm-grammar-matcher grammar))
            _ (matcher-set-input! matcher input)
            (mut result)
              (if tracing
                  (matcher-trace-from matcher start-rule)
                  (matcher-match-from matcher start-rule))]
        (retain-owned-match-matcher! (mut result) matcher)
        (load result)))))

(defn ohm-grammar-match [(grammar (ptr OhmGrammar))
                         (input (slice u8))] (-> MatchResult)
  (ohm-grammar-run-owned! grammar input (.default-start-rule (.descriptor grammar)) false))

(defn ohm-grammar-match-from [(grammar (ptr OhmGrammar))
                              (input (slice u8))
                              (start-rule (slice u8))] (-> MatchResult)
  (ohm-grammar-run-owned! grammar input start-rule false))

(defn ohm-grammar-trace [(grammar (ptr OhmGrammar))
                         (input (slice u8))] (-> MatchResult)
  (ohm-grammar-run-owned! grammar input (.default-start-rule (.descriptor grammar)) true))

(defn ohm-grammar-trace-from [(grammar (ptr OhmGrammar))
                              (input (slice u8))
                              (start-rule (slice u8))] (-> MatchResult)
  (ohm-grammar-run-owned! grammar input start-rule true))

(defn free-ohm-matcher! [(matcher (mut OhmMatcher))] (-> i64)
  (al/al-free! (mut (.input matcher)))
  (free-parse-cache! (mut (.cache matcher)))
  (if (and (.owns-grammar matcher)
           (!= (primitive/cast i64 (.grammar matcher)) 0))
      (let [grammar (primitive/cast (ptr OhmGrammar) (.grammar matcher))
            a (.allocator grammar)]
        (free-ohm-grammar! grammar)
        (alloc/free [OhmGrammar] a (alloc/alloc-slice-new grammar 1))
        (set! (.grammar matcher) (primitive/cast (ptr u8) 0))
        (set! (.owns-grammar matcher) false))
      0)
  0)

(defn matcher-incremental-reuse-count [(matcher (ptr OhmMatcher))] (-> i64)
  (.reuse-count (.cache matcher)))

(defn matcher-memo-entry-count [(matcher (ptr OhmMatcher))] (-> i64)
  (len (.memo (.cache matcher))))

(defn matcher-stable-node-id [(matcher (ptr OhmMatcher))
                              (rule-name (slice u8))
                              (start i64)] (-> i64)
  (let [(mut found) -1]
    (for identity
      (iter (.stable-identities (.cache matcher)))
      (let [candidate identity]
        (if (and (< (load found) 0)
                 (and (= (.start candidate) start)
                      (str/str-eq (.rule-name candidate) rule-name)))
            (set! found (.id candidate))
            0)))
    (load found)))

(defn matcher-memo-find [(matcher (ptr OhmMatcher))
                         (rule-id i64)
                         (start i64)] (-> i64)
  (let [(mut index) (- (len (.memo (.cache matcher))) 1)
        (mut found) -1]
    (loop (if (or (< (load index) 0) (>= (load found) 0))
              (break)
              (let [entry (get (.memo (.cache matcher)) (load index))]
                (if (and (= (.rule-id entry) rule-id) (= (.start entry) start))
                    (set! found (load index))
                    0)
                (set! index (- (load index) 1)))))
    (load found)))

(defn matcher-memo-rule-id [(matcher (ptr OhmMatcher)) (index i64)] (-> i64)
  (let [entry (get (.memo (.cache matcher)) index)] (.rule-id entry)))

(defn matcher-memo-start [(matcher (ptr OhmMatcher)) (index i64)] (-> i64)
  (let [entry (get (.memo (.cache matcher)) index)] (.start entry)))

(defn matcher-memo-match-length [(matcher (ptr OhmMatcher)) (index i64)] (-> i64)
  (let [entry (get (.memo (.cache matcher)) index)]
    (if (< (.best-end entry) 0) 0 (- (.best-end entry) (.start entry)))))

(defn matcher-memo-examined-length [(matcher (ptr OhmMatcher))
                                    (index i64)] (-> i64)
  (let [entry (get (.memo (.cache matcher)) index)]
    (- (.examined-end entry) (.start entry))))

(defn matcher-memo-rightmost-failure-offset [(matcher (ptr OhmMatcher))
                                              (index i64)] (-> i64)
  (let [entry (get (.memo (.cache matcher)) index)]
    (if (< (.failure-position entry) 0)
        -1
        (- (.failure-position entry) (.start entry)))))

(defn matcher-memo-record-eq? [(matcher (ptr OhmMatcher))
                               (rule-id i64)
                               (start i64)
                               (match-length i64)
                               (examined-length i64)
                               (rightmost-failure-offset i64)] (-> bool)
  (let [index (matcher-memo-find matcher rule-id start)]
    (and (>= index 0)
         (and (or (= match-length -2)
                  (= (matcher-memo-match-length matcher index) match-length))
              (and (or (= examined-length -2)
                       (= (matcher-memo-examined-length matcher index) examined-length))
                   (or (= rightmost-failure-offset -2)
                       (= (matcher-memo-rightmost-failure-offset matcher index)
                          rightmost-failure-offset)))))))

(defn matcher-memo-max-examined-length-at [(matcher (ptr OhmMatcher))
                                           (start i64)] (-> i64)
  (let [(mut maximum) 0]
    (for entry
      (iter (.memo (.cache matcher)))
      (let [candidate entry]
        (if (and (= (.start candidate) start)
                 (> (- (.examined-end candidate) start) (load maximum)))
            (set! maximum (- (.examined-end candidate) start))
            0)))
    (load maximum)))

(defn matcher-memo-max-rightmost-failure-offset-at [(matcher (ptr OhmMatcher))
                                                     (start i64)] (-> i64)
  (let [(mut maximum) -1]
    (for entry
      (iter (.memo (.cache matcher)))
      (let [candidate entry]
        (if (and (= (.start candidate) start)
                 (>= (.failure-position candidate) 0))
            (let [offset (- (.failure-position candidate) start)]
              (if (> offset (load maximum)) (set! maximum offset) 0))
            0)))
    (load maximum)))

(defn match-failure-count [(result MatchResult)] (-> i64)
  (len (.failures result)))

(defn match-failure-at [(result MatchResult) (wanted i64)] (-> Expectation)
  (let [(mut previous-order) -1
        (mut chosen) -1]
    (for [_ 0 (+ wanted 1)]
      (let [(mut chosen-order) -1]
        (set! chosen -1)
        (for [index 0 (len (.failures result))]
          (let [candidate (get (.failures result) index)]
            (if (and (> (.order candidate) (load previous-order))
                     (or (< (load chosen) 0)
                         (< (.order candidate) (load chosen-order))))
                (do
                  (set! chosen index)
                  (set! chosen-order (.order candidate)))
                0)))
        (set! previous-order (load chosen-order))))
    (get (.failures result) (load chosen))))

(defn match-failure-text [(result MatchResult) (index i64)] (-> (slice u8))
  (let [failure (match-failure-at result index)] (.text failure)))

(defn match-failure-type [(result MatchResult) (index i64)] (-> i64)
  (let [failure (match-failure-at result index)] (.type failure)))

(defn match-failure-type-name [(result MatchResult) (index i64)]
                              (-> (slice u8))
  (let [type (match-failure-type result index)]
    (cond (= type 0) "string"
          (= type 1) "description"
          :else "code")))

(defn match-failure-is-string-terminal? [(result MatchResult) (index i64)]
                                        (-> bool)
  (= (match-failure-type result index) 0))

(defn match-failure-is-description? [(result MatchResult) (index i64)]
                                    (-> bool)
  (= (match-failure-type result index) 1))

(defn match-failure-is-code? [(result MatchResult) (index i64)] (-> bool)
  (= (match-failure-type result index) 2))

(defn match-failure-fluffy? [(result MatchResult) (index i64)] (-> bool)
  (let [failure (match-failure-at result index)] (.fluffy failure)))

(defn report-fixture-mismatch [(result MatchResult)] (-> i64)
  (io/print-str (io/stderr) "Ohm fixture mismatch; actual failure was:\n")
  (io/print-str (io/stderr) (.message result))
  (io/print-str (io/stderr) "\n")
  (alloc/abort))

(defn match-node [(result MatchResult) (node i64)] (-> CstNode)
  (if (< node (.trace-node-base result))
      (get (.nodes result) node)
      (get (.trace-nodes result) (- node (.trace-node-base result)))))

(defn node-rule [(result MatchResult) (node i64)] (-> (slice u8))
  (let [value (match-node result node)] (.rule value)))

(defn node-id [(result MatchResult) (node i64)] (-> i64)
  (let [value (match-node result node)] (.id value)))

(defn node-start [(result MatchResult) (node i64)] (-> i64)
  (let [value (match-node result node)] (.start value)))

(defn node-end [(result MatchResult) (node i64)] (-> i64)
  (let [value (match-node result node)] (.end value)))

(defn node-source-string [(result MatchResult) (node i64)] (-> (slice u8))
  (subslice (.source result) (node-start result node) (node-end result node)))

(defn source-byte-position-to-utf16 [(source (slice u8)) (position i64)] (-> i64)
  (let [(mut at) 0
        (mut code-units) 0]
    (loop (if (or (>= (load at) position) (>= (load at) (slice-len source)))
              (break)
              (let [scalar (decode-utf8 source (load at))]
                (set! code-units
                      (+ (load code-units)
                         (if (and (.valid scalar) (> (.value scalar) 65535)) 2 1)))
                (set! at (+ (load at) (if (.valid scalar) (.width scalar) 1))))))
    (+ (load code-units)
       (if (> position (slice-len source)) (- position (slice-len source)) 0))))

(defn node-start-utf16 [(result MatchResult) (node i64)] (-> i64)
  (source-byte-position-to-utf16 (.source result) (node-start result node)))

(defn node-end-utf16 [(result MatchResult) (node i64)] (-> i64)
  (source-byte-position-to-utf16 (.source result) (node-end result node)))

(defn node-source-interval [(result MatchResult) (node i64)] (-> OhmInterval)
  (new-ohm-interval (.source result)
                    (node-start-utf16 result node)
                    (node-end-utf16 result node)))

(defn match-grammar-name [(result MatchResult)] (-> (slice u8))
  (.grammar-name result))

(defn match-grammar-token [(result MatchResult)] (-> (ptr u8))
  (.grammar-token result))

(defn match-grammar-compatible? [(result MatchResult)
                                 (name (slice u8))
                                 (token (ptr u8))] (-> bool)
  (and (str/str-eq (.grammar-name result) name)
       (= (primitive/cast i64 (.grammar-token result))
          (primitive/cast i64 token))))

(defn match-semantic-rule-arity [(result MatchResult) (name (slice u8))] (-> i64)
  (let [(mut arity) -1]
    (for rule
      (iter (.semantic-rules result))
      (let [candidate rule]
        (if (str/str-eq (.name candidate) name)
            (set! arity (.arity candidate))
            0)))
    (load arity)))

(defn match-semantic-rule-count [(result MatchResult)] (-> i64)
  (len (.semantic-rules result)))

(defn match-semantic-rule-name [(result MatchResult) (index i64)] (-> (slice u8))
  (let [rule (get (.semantic-rules result) index)] (.name rule)))

(defn match-semantic-rule-arity-at [(result MatchResult) (index i64)] (-> i64)
  (let [rule (get (.semantic-rules result) index)] (.arity rule)))

(defn match-semantic-metadata-valid? [(result MatchResult)] (-> bool)
  (let [(mut valid) true]
    (for [node 0 (len (.nodes result))]
      (let [name (node-rule result node)]
        (if (or (str/str-eq name "_terminal") (str/str-eq name "_iter"))
            0
            (if (!= (match-semantic-rule-arity result name)
                    (node-child-count result node))
                (set! valid false)
                0))))
    (load valid)))

(defn match-semantic-first-invalid-node [(result MatchResult)] (-> i64)
  (let [(mut invalid) -1]
    (for [node 0 (len (.nodes result))]
      (if (< (load invalid) 0)
          (let [name (node-rule result node)]
            (if (and (not (str/str-eq name "_terminal"))
                     (and (not (str/str-eq name "_iter"))
                          (!= (match-semantic-rule-arity result name)
                              (node-child-count result node))))
                (set! invalid node)
                0))
          0))
    (load invalid)))

(defn validate-semantic-action-schema [(Schema OhmSemanticActionSchema)] [(schema (ptr Schema))
                                                                          (result (ptr MatchResult))] (-> SemanticSchemaValidation)
  (let [(mut validation) (primitive/zeroed SemanticSchemaValidation)]
    (set! (.valid validation)
          (match-grammar-compatible? (load result)
                                     (semantic-schema-grammar-name schema)
                                     (semantic-schema-grammar-token schema)))
    (set! (.error-kind validation) (if (.valid validation) 0 1))
    (set! (.action-index validation) -1)
    (set! (.expected-arity validation) -1)
    (set! (.actual-arity validation) -1)
    (for [index 0 (semantic-schema-action-count schema)]
      (if (.valid validation)
          (let [name (semantic-schema-action-name schema index)
                actual (semantic-schema-action-arity schema index)
                rest? (semantic-schema-action-rest? schema index)
                special-rest?
                  (or (str/str-eq name "_iter")
                      (or (str/str-eq name "_nonterminal")
                          (str/str-eq name "_default")))
                expected
                  (if (str/str-eq name "_terminal")
                      0
                      (if special-rest?
                          0
                          (match-semantic-rule-arity (load result) name)))]
            (for [previous 0 index]
              (if (str/str-eq (semantic-schema-action-name schema previous) name)
                  (do
                    (set! (.valid validation) false)
                    (set! (.error-kind validation) 4)
                    (set! (.action-index validation) index)
                    0)
                  0))
            (if (.valid validation)
                (cond (and (< expected 0) (not special-rest?))
                        (do
                          (set! (.valid validation) false)
                          (set! (.error-kind validation) 2)
                          (set! (.action-index validation) index)
                          0)
                      (and special-rest? (not rest?))
                        (do
                          (set! (.valid validation) false)
                          (set! (.error-kind validation) 3)
                          (set! (.action-index validation) index)
                          0)
                      (and (not special-rest?) (!= actual expected))
                        (do
                          (set! (.valid validation) false)
                          (set! (.error-kind validation) 3)
                          (set! (.action-index validation) index)
                          (set! (.expected-arity validation) expected)
                          (set! (.actual-arity validation) actual)
                          0)
                      :else 0)
                0))
          0))
    (load validation)))

(defn semantic-schema-valid? [(validation SemanticSchemaValidation)] (-> bool)
  (.valid validation))

(defn semantic-schema-error-kind [(validation SemanticSchemaValidation)] (-> i64)
  (.error-kind validation))

(defn semantic-schema-error-action [(validation SemanticSchemaValidation)] (-> i64)
  (.action-index validation))

(defn semantic-schema-expected-arity [(validation SemanticSchemaValidation)] (-> i64)
  (.expected-arity validation))

(defn semantic-schema-actual-arity [(validation SemanticSchemaValidation)] (-> i64)
  (.actual-arity validation))

(defn node-terminal? [(result MatchResult) (node i64)] (-> bool)
  (str/str-eq (node-rule result node) "_terminal"))

(defn node-iteration? [(result MatchResult) (node i64)] (-> bool)
  (str/str-eq (node-rule result node) "_iter"))

(defn node-nonterminal? [(result MatchResult) (node i64)] (-> bool)
  (and (not (node-terminal? result node))
       (not (node-iteration? result node))))

(defn node-syntactic? [(result MatchResult) (node i64)] (-> bool)
  (and (node-nonterminal? result node)
       (let [name (node-rule result node)]
         (and (> (slice-len name) 0)
              (let [first (primitive/cast i64 (slice-get name 0))]
                (and (>= first 65) (<= first 90)))))))

(defn node-lexical? [(result MatchResult) (node i64)] (-> bool)
  (and (node-nonterminal? result node)
       (not (node-syntactic? result node))))

(defn node-optional? [(result MatchResult) (node i64)] (-> bool)
  (let [value (match-node result node)] (.optional value)))

(defn node-child-count [(result MatchResult) (node i64)] (-> i64)
  (let [n (match-node result node)
        (mut child) (.first-child n)
        (mut count) 0]
    (loop (if (< (load child) 0)
              (break)
              (do
                (set! count (+ (load count) 1))
                (let [child-node (match-node result (load child))]
                  (set! child (.next-sibling child-node))))))
    (load count)))

(defn node-shape? [(result MatchResult)
                   (node i64)
                   (rule (slice u8))
                   (child-count i64)] (-> bool)
  (and (>= node 0)
       (and (< node (len (.nodes result)))
            (and (str/str-eq (node-rule result node) rule)
                 (= (node-child-count result node) child-count)))))

(defn node-child-offset [(result MatchResult)
                         (node i64)
                         (child-index i64)] (-> i64)
  (let [child (node-child result node child-index)]
    (if (< child 0) -1 (- (node-start result child) (node-start result node)))))

(defn match-binding-offsets-valid? [(result MatchResult)] (-> bool)
  (let [(mut valid) true]
    (for [node 0 (len (.nodes result))]
      (for [child-index 0 (node-child-count result node)]
        (let [child (node-child result node child-index)]
          (if (or (< child 0)
                  (!= (node-start result child)
                      (+ (node-start result node)
                         (node-child-offset result node child-index))))
              (set! valid false)
              0))))
    (load valid)))

(defn node-child [(result MatchResult) (node i64) (wanted i64)] (-> i64)
  (if (< wanted 0)
      -1
  (let [parent (match-node result node)
        (mut child) (.first-child parent)
        (mut index) 0]
    (loop (if (or (< (load child) 0) (>= (load index) wanted))
              (break)
              (do
                (let [child-node (match-node result (load child))]
                  (set! child (.next-sibling child-node)))
                (set! index (+ (load index) 1)))))
    (load child))))

(defn node-index-of-child [(result MatchResult)
                           (node i64)
                           (wanted-child i64)] (-> i64)
  (let [(mut answer) -1]
    (for [index 0 (node-child-count result node)]
      (if (= (node-child result node index) wanted-child)
          (set! answer index)
          0))
    (load answer)))

(defn node-has-children? [(result MatchResult) (node i64)] (-> bool)
  (> (node-child-count result node) 0))

(defn node-has-no-children? [(result MatchResult) (node i64)] (-> bool)
  (= (node-child-count result node) 0))

;; The JavaScript methods throw when their structural precondition is not met;
;; Coil's typed API uses -1 as its explicit `undefined`/error result.
(defn node-only-child [(result MatchResult) (node i64)] (-> i64)
  (if (= (node-child-count result node) 1) (node-child result node 0) -1))

(defn node-first-child [(result MatchResult) (node i64)] (-> i64)
  (if (node-has-children? result node) (node-child result node 0) -1))

(defn node-last-child [(result MatchResult) (node i64)] (-> i64)
  (let [count (node-child-count result node)]
    (if (> count 0) (node-child result node (- count 1)) -1)))

(defn node-child-before [(result MatchResult)
                         (node i64)
                         (child i64)] (-> i64)
  (let [index (node-index-of-child result node child)]
    (if (> index 0) (node-child result node (- index 1)) -1)))

(defn node-child-after [(result MatchResult)
                        (node i64)
                        (child i64)] (-> i64)
  (let [index (node-index-of-child result node child)
        count (node-child-count result node)]
    (if (and (>= index 0) (< (+ index 1) count))
        (node-child result node (+ index 1))
        -1)))

(defn widen-last-child-start! [(state (mut ParseState)) (start i64)] (-> i64)
  (let [frame (current-frame state)
        child (.last-child frame)]
    (if (>= child 0)
        (set! (.start (al/al-elem [CstNode] (mut (.nodes state)) child)) start)
        0)
    0))

(defn extend-root-end! [(state (mut ParseState)) (end i64)] (-> i64)
  (if (>= (.root state) 0)
      (set! (.end (al/al-elem [CstNode] (mut (.nodes state)) (.root state))) end)
      0)
  end)

(defn cst-signature-hex-byte [(builder (mut str/StrBuf)) (value i64)] (-> i64)
  (let [high (/ value 16)
        low (% value 16)]
    (str/sb-push-byte! (mut builder)
                       (primitive/cast u8 (if (< high 10) (+ 48 high) (+ 87 high))))
    (str/sb-push-byte! (mut builder)
                       (primitive/cast u8 (if (< low 10) (+ 48 low) (+ 87 low))))
    0))

(defn cst-signature-hex! [(builder (mut str/StrBuf)) (value (slice u8))] (-> i64)
  (for [index 0 (slice-len value)]
    (cst-signature-hex-byte (mut builder) (primitive/cast i64 (slice-get value index))))
  0)

(defn append-cst-signature! [(builder (mut str/StrBuf))
                             (result MatchResult)
                             (node i64)] (-> i64)
  (str/sb-push-byte! (mut builder) (primitive/cast u8 40))
  (cst-signature-hex! (mut builder) (node-rule result node))
  (str/sb-push-byte! (mut builder) (primitive/cast u8 58))
  (str/sb-push-i64! (mut builder) (node-start-utf16 result node))
  (str/sb-push-byte! (mut builder) (primitive/cast u8 58))
  (str/sb-push-i64! (mut builder) (node-end-utf16 result node))
  (str/sb-push-byte! (mut builder) (primitive/cast u8 58))
  (cst-signature-hex! (mut builder) (node-source-string result node))
  (for [child-index 0 (node-child-count result node)]
    (str/sb-push-byte! (mut builder) (primitive/cast u8 44))
    (append-cst-signature! (mut builder) result (node-child result node child-index)))
  (str/sb-push-byte! (mut builder) (primitive/cast u8 41))
  0)

(defn print-match-cst-signature [(result MatchResult)] (-> i64)
  (let [(mut builder) (str/sb-new (alloc/malloc-allocator))]
    (if (and (match-succeeded? result) (>= (match-root result) 0))
        (append-cst-signature! (mut builder) result (match-root result))
        (str/sb-push-str! (mut builder) "FAIL"))
    (str/sb-push-str! (mut builder) "\n")
    (io/print-str (io/stdout) (str/sb-finish! (mut builder)))
    0))

(defn append-trace-binding-shape! [(builder (mut str/StrBuf))
                                   (result MatchResult)
                                   (node i64)] (-> i64)
  (str/sb-push-byte! (mut builder) (primitive/cast u8 40))
  (cst-signature-hex! (mut builder) (node-rule result node))
  (str/sb-push-byte! (mut builder) (primitive/cast u8 58))
  (str/sb-push-i64! (mut builder) (- (node-end-utf16 result node)
                                      (node-start-utf16 result node)))
  (for [child-index 0 (node-child-count result node)]
    (let [child (node-child result node child-index)]
      (str/sb-push-byte! (mut builder) (primitive/cast u8 44))
      (str/sb-push-i64! (mut builder) (- (node-start-utf16 result child)
                                          (node-start-utf16 result node)))
      (append-trace-binding-shape! (mut builder) result child)))
  (str/sb-push-byte! (mut builder) (primitive/cast u8 41))
  0)

(defn append-trace-bindings! [(builder (mut str/StrBuf))
                              (result MatchResult)
                              (event i64)] (-> i64)
  (str/sb-push-byte! (mut builder) (primitive/cast u8 91))
  (for [index 0 (trace-binding-count result event)]
    (if (> index 0) (str/sb-push-byte! (mut builder) (primitive/cast u8 44)) 0)
    (append-trace-binding-shape! (mut builder)
                                 result
                                 (trace-binding-at result event index)))
  (str/sb-push-byte! (mut builder) (primitive/cast u8 93))
  0)

(defn append-trace-signature! [(builder (mut str/StrBuf))
                               (result MatchResult)
                               (event i64)] (-> i64)
  (str/sb-push-byte! (mut builder) (primitive/cast u8 40))
  (cst-signature-hex! (mut builder) (trace-display result event))
  (str/sb-push-byte! (mut builder) (primitive/cast u8 58))
  (str/sb-push-i64! (mut builder)
                    (source-byte-position-to-utf16 (.source result) (trace-start result event)))
  (str/sb-push-byte! (mut builder) (primitive/cast u8 58))
  (str/sb-push-i64! (mut builder)
                    (source-byte-position-to-utf16 (.source result) (trace-end result event)))
  (str/sb-push-byte! (mut builder) (primitive/cast u8 58))
  (str/sb-push-i64! (mut builder) (if (trace-succeeded? result event) 1 0))
  (str/sb-push-i64! (mut builder) (if (trace-implicit-spaces? result event) 1 0))
  (str/sb-push-i64! (mut builder) (if (trace-memoized? result event) 1 0))
  (str/sb-push-i64! (mut builder) (if (trace-left-recursion-head? result event) 1 0))
  (str/sb-push-i64! (mut builder) (if (trace-terminates-left-recursion? result event) 1 0))
  (append-trace-bindings! (mut builder) result event)
  (for [child-index 0 (trace-child-count result event)]
    (str/sb-push-byte! (mut builder) (primitive/cast u8 44))
    (append-trace-signature! (mut builder) result (trace-child result event child-index)))
  (if (trace-has-undefined-child? result event)
      (str/sb-push-str! (mut builder) ",U")
      0)
  (let [terminating (trace-terminating-left-recursion-entry result event)]
    (if (>= terminating 0)
        (do
          (str/sb-push-str! (mut builder) ",T")
          (append-trace-signature! (mut builder) result terminating))
        0))
  (str/sb-push-byte! (mut builder) (primitive/cast u8 41))
  0)

(defn print-match-trace-signature [(result MatchResult)] (-> i64)
  (let [(mut builder) (str/sb-new (alloc/malloc-allocator))]
    (str/sb-push-str! (mut builder) "R")
    (append-trace-bindings! (mut builder) result -1)
    (for [child-index 0 (trace-child-count result -1)]
      (str/sb-push-byte! (mut builder) (primitive/cast u8 44))
      (append-trace-signature! (mut builder) result (trace-child result -1 child-index)))
    (str/sb-push-str! (mut builder) "\n")
    (io/print-str (io/stdout) (str/sb-finish! (mut builder)))
    0))

(defn new-semantic-iteration [(evaluation (ptr SemanticEvaluation))
                              (children (slice i64))] (-> SemanticIteration)
  (let [result (.result evaluation)
        (mut iteration) (primitive/zeroed SemanticIteration)
        (mut owned-children) (al/al-new [i64] (.allocator result))]
    (for child
      (iter children)
      (push! (mut owned-children) child))
    (set! (.children iteration) (load owned-children))
    (set! (.valid iteration) true)
    (load iteration)))

(defn semantic-node-as-iteration [(evaluation (ptr SemanticEvaluation))
                                  (node i64)] (-> SemanticIteration)
  (let [result (.result evaluation)
        (mut iteration) (primitive/zeroed SemanticIteration)
        (mut children) (al/al-new [i64] (.allocator result))
        name
          (if (and (>= node 0) (< node (len (.nodes result))))
              (node-rule (load result) node)
              "")]
    (cond (and (>= node 0)
               (< node (len (.nodes result)))
               (node-iteration? (load result) node))
            (for [index 0 (node-child-count (load result) node)]
              (push! (mut children) (node-child (load result) node index)))
          (or (str/str-eq name "EmptyListOf")
              (str/str-eq name "emptyListOf"))
            0
          (or (str/str-eq name "ListOf")
              (str/str-eq name "listOf"))
            (if (= (node-child-count (load result) node) 1)
                (let [(mut nested)
                        (semantic-node-as-iteration evaluation
                                                    (node-child (load result) node 0))]
                  (for child
                    (iter (.children nested))
                    (push! (mut children) child))
                  (set! (.valid iteration) (.valid nested))
                  (al/al-free! (mut (.children nested))))
                (set! (.valid iteration) false))
          (or (str/str-eq name "NonemptyListOf")
              (str/str-eq name "nonemptyListOf"))
            (if (= (node-child-count (load result) node) 3)
                (do
                  (push! (mut children) (node-child (load result) node 0))
                  (let [rest (node-child (load result) node 2)]
                    (for [index 0 (node-child-count (load result) rest)]
                      (push! (mut children)
                             (node-child (load result) rest index))))
                  0)
                (set! (.valid iteration) false))
          :else (set! (.valid iteration) false))
    (if (and (>= node 0)
             (and (< node (len (.nodes result)))
                  (or (node-iteration? (load result) node)
                      (or (str/str-eq name "EmptyListOf")
                          (or (str/str-eq name "emptyListOf")
                              (or (str/str-eq name "NonemptyListOf")
                                  (str/str-eq name "nonemptyListOf")))))))
        (set! (.valid iteration) true)
        0)
    (set! (.children iteration) (load children))
    (load iteration)))

(defn semantic-iteration-valid? [(iteration (ptr SemanticIteration))] (-> bool)
  (.valid iteration))

(defn semantic-iteration-child-count [(iteration (ptr SemanticIteration))] (-> i64)
  (len (.children iteration)))

(defn semantic-iteration-child [(iteration (ptr SemanticIteration))
                                (index i64)] (-> i64)
  (get (.children iteration) index))

(defn reverse-semantic-iteration! [(iteration (mut SemanticIteration))] (-> i64)
  (let [count (len (.children iteration))]
    (for [index 0 (/ count 2)]
      (let [other (- (- count index) 1)
            left (get (.children iteration) index)
            right (get (.children iteration) other)]
        (set! (mut (.children iteration)) index right)
        (set! (mut (.children iteration)) other left)))
    0))

(defn evaluate-semantic-iteration-child! [(evaluation (mut SemanticEvaluation))
                                          (iteration (ptr SemanticIteration))
                                          (index i64)
                                          (arguments (slice i64))] (-> i64)
  (evaluate-semantic-node! (mut evaluation)
                           (semantic-iteration-child iteration index)
                           arguments))

(defn free-semantic-iteration! [(iteration (mut SemanticIteration))] (-> i64)
  (al/al-free! (mut (.children iteration)))
  0)

(defn new-semantic-attribute-cache [(a (dyn alloc/Allocator))]
                                    (-> SemanticAttributeCache)
  (let [(mut cache) (primitive/zeroed SemanticAttributeCache)]
    (set! (.entries cache) (al/al-new [SemanticAttributeCacheEntry] a))
    (set! (.allocator cache) a)
    (set! (.hit-count cache) 0)
    (load cache)))

(defn semantic-attribute-cache-find [(cache (ptr SemanticAttributeCache))
                                     (wanted-id i64)] (-> i64)
  (let [(mut answer) -1 (mut index) 0]
    (loop (if (or (>= (load index) (len (.entries cache))) (>= (load answer) 0))
              (break)
              (let [entry (get (.entries cache) (load index))]
                (if (= (.node-id entry) wanted-id)
                    (set! answer (load index))
                    (set! index (+ (load index) 1))))))
    (load answer)))

(defn semantic-attribute-cache-store! [(cache (mut SemanticAttributeCache))
                                       (node-id-value i64)
                                       (value i64)] (-> i64)
  (let [existing (semantic-attribute-cache-find cache node-id-value)]
    (if (>= existing 0)
        (set! (.value (al/al-elem [SemanticAttributeCacheEntry]
                                   (mut (.entries cache))
                                   existing))
              value)
        (let [(mut entry) (primitive/zeroed SemanticAttributeCacheEntry)]
          (set! (.node-id entry) node-id-value)
          (set! (.value entry) value)
          (push! (mut (.entries cache)) (load entry))))
    value))

(defn semantic-attribute-cache-hit-count [(cache (ptr SemanticAttributeCache))]
                                          (-> i64)
  (.hit-count cache))

(defn semantic-attribute-cache-has-node? [(cache (ptr SemanticAttributeCache))
                                          (node-id-value i64)] (-> bool)
  (>= (semantic-attribute-cache-find cache node-id-value) 0))

(defn semantic-attribute-cache-node-id-at [(cache (ptr SemanticAttributeCache))
                                           (result (ptr MatchResult))
                                           (rule-name (slice u8))
                                           (start i64)] (-> i64)
  (let [(mut found) -1]
    (for [node 0 (len (.nodes result))]
      (if (< (load found) 0)
          (let [candidate (get (.nodes result) node)]
            (if (and (= (.start candidate) start)
                     (and (str/str-eq (.rule candidate) rule-name)
                          (semantic-attribute-cache-has-node? cache (.id candidate))))
                (set! found (.id candidate))
                0))
          0))
    (load found)))

(defn matcher-stable-cached-node-id
  [(matcher (ptr OhmMatcher))
   (cache (ptr SemanticAttributeCache))
   (rule-name (slice u8))
   (start i64)] (-> i64)
  (let [(mut found) -1]
    (for identity
      (iter (.stable-identities (.cache matcher)))
      (let [candidate identity]
        (if (and (= (.start candidate) start)
                 (and (str/str-eq (.rule-name candidate) rule-name)
                      (semantic-attribute-cache-has-node? cache (.id candidate))))
            (set! found (.id candidate))
            0)))
    (load found)))

(defn semantic-attribute-cache-load! [(cache (mut SemanticAttributeCache))
                                      (index i64)] (-> i64)
  (let [entry (get (.entries cache) index)]
    (set! (.hit-count cache) (+ (.hit-count cache) 1))
    (.value entry)))

(defn free-semantic-attribute-cache! [(cache (mut SemanticAttributeCache))] (-> i64)
  (al/al-free! (mut (.entries cache)))
  0)

(defn new-named-semantic-evaluation [(action (dyn OhmLazySemanticAction))
                                     (result (ptr MatchResult))
                                     (attribute bool)
                                     (action-name (slice u8))] (-> SemanticEvaluation)
  (let [(mut evaluation) (primitive/zeroed SemanticEvaluation)
        (mut values) (al/al-new [i64] (.allocator result))
        (mut states) (al/al-new [u8] (.allocator result))
        (mut action-stack) (al/al-new [SemanticActionFrame] (.allocator result))
        (mut error-stack) (al/al-new [SemanticActionFrame] (.allocator result))]
    (for [_ 0 (len (.nodes result))]
      (push! (mut values) 0)
      (push! (mut states) (primitive/cast u8 0)))
    (set! (.action evaluation) action)
    (set! (.result evaluation) result)
    (set! (.values evaluation) (load values))
    (set! (.states evaluation) (load states))
    (set! (.action-stack evaluation) (load action-stack))
    (set! (.error-stack evaluation) (load error-stack))
    (set! (.attribute evaluation) attribute)
    (set! (.failed evaluation) false)
    (set! (.error-kind evaluation) 0)
    (set! (.error-node evaluation) -1)
    (set! (.expected-arguments evaluation) 0)
    (set! (.actual-arguments evaluation) 0)
    (set! (.action-name evaluation) action-name)
    (set! (.error-message evaluation) "")
    (set! (.owns-error-message evaluation) false)
    (set! (.uses-attribute-cache evaluation) false)
    (if (not (.succeeded result))
        (do
          (set! (.failed evaluation) true)
          (set! (.error-kind evaluation) 7)
          (set! (.error-node evaluation) -1)
          0)
        0)
    (if (and (not (.failed evaluation))
             (and attribute (!= (semantic-formal-count action) 0)))
        (do
          (set! (.failed evaluation) true)
          (set! (.error-kind evaluation) 6)
          (set! (.error-node evaluation) (.root result))
          (set! (.expected-arguments evaluation) 0)
          (set! (.actual-arguments evaluation) (semantic-formal-count action))
          0)
        0)
    (if (and (not (.failed evaluation))
             (not (match-grammar-compatible? (load result)
                                             (semantic-grammar-name action)
                                             (semantic-grammar-token action))))
        (do
          (set! (.failed evaluation) true)
          (set! (.error-kind evaluation) 5)
          (set! (.error-node evaluation) (.root result))
          0)
        0)
    (load evaluation)))

(defn new-semantic-evaluation [(action (dyn OhmLazySemanticAction))
                               (result (ptr MatchResult))
                               (attribute bool)] (-> SemanticEvaluation)
  (new-named-semantic-evaluation action result attribute ""))

(defn new-cached-semantic-attribute-evaluation
  [(action (dyn OhmLazySemanticAction))
   (result (ptr MatchResult))
   (action-name (slice u8))
   (cache (mut SemanticAttributeCache))] (-> SemanticEvaluation)
  (let [(mut evaluation)
          (new-named-semantic-evaluation action result true action-name)]
    (set! (.attribute-cache evaluation) (load cache))
    (set! (.entries cache)
          (al/al-new [SemanticAttributeCacheEntry] (.allocator cache)))
    (set! (.hit-count cache) 0)
    (set! (.uses-attribute-cache evaluation) true)
    (load evaluation)))

(defn finish-cached-semantic-attribute-evaluation!
  [(evaluation (mut SemanticEvaluation))
   (cache (mut SemanticAttributeCache))] (-> i64)
  (al/al-free! (mut (.entries cache)))
  (set! (.entries cache) (.entries (.attribute-cache evaluation)))
  (set! (.allocator cache) (.allocator (.attribute-cache evaluation)))
  (set! (.hit-count cache) (.hit-count (.attribute-cache evaluation)))
  (set! (.entries (.attribute-cache evaluation))
        (al/al-new [SemanticAttributeCacheEntry] (.allocator cache)))
  0)

(defn new-ohm-semantics [(grammar-name (slice u8))
                         (grammar-token (ptr u8))
                         (a (dyn alloc/Allocator))] (-> OhmSemantics)
  (let [(mut semantics) (primitive/zeroed OhmSemantics)]
    (set! (.name semantics) "ASemantics")
    (set! (.grammar-name semantics) grammar-name)
    (set! (.grammar-token semantics) grammar-token)
    (set! (.grammar-fingerprint semantics) "")
    (set! (.grammar-recipe semantics) "")
    (set! (.definitions semantics) (al/al-new [SemanticDefinition] a))
    (set! (.allocator semantics) a)
    (load semantics)))

(defn semantics-to-recipe [(semantics (ptr OhmSemantics))] (-> OhmSemanticsRecipe)
  (let [(mut recipe) (primitive/zeroed OhmSemanticsRecipe)]
    (set! (.name recipe) (.name semantics))
    (set! (.grammar-name recipe) (.grammar-name semantics))
    (set! (.grammar-token recipe) (.grammar-token semantics))
    (set! (.grammar-fingerprint recipe) (.grammar-fingerprint semantics))
    (set! (.grammar-recipe recipe) (.grammar-recipe semantics))
    (set! (.definitions recipe)
          (al/al-new [SemanticDefinition] (.allocator semantics)))
    (set! (.allocator recipe) (.allocator semantics))
    (for definition
      (iter (.definitions semantics))
      (let [(mut recipe-definition) definition]
        (set! (.owns-attribute-cache recipe-definition) false)
        (push! (mut (.definitions recipe)) (load recipe-definition))))
    (load recipe)))

(defn make-semantics-from-recipe [(recipe (ptr OhmSemanticsRecipe))] (-> OhmSemantics)
  (let [(mut semantics)
          (new-ohm-semantics (.grammar-name recipe)
                             (.grammar-token recipe)
                             (.allocator recipe))]
    (set! (.name semantics) (.name recipe))
    (set! (.grammar-fingerprint semantics) (.grammar-fingerprint recipe))
    (set! (.grammar-recipe semantics) (.grammar-recipe recipe))
    (for definition
      (iter (.definitions recipe))
      (let [(mut runtime-definition) definition]
        (if (.attribute runtime-definition)
            (do
              (set! (.attribute-cache runtime-definition)
                    (new-semantic-attribute-cache (.allocator semantics)))
              (set! (.owns-attribute-cache runtime-definition) true))
            (set! (.owns-attribute-cache runtime-definition) false))
        (push! (mut (.definitions semantics)) (load runtime-definition))))
    (load semantics)))

(defn free-ohm-semantics-recipe! [(recipe (mut OhmSemanticsRecipe))] (-> i64)
  (al/al-free! (mut (.definitions recipe)))
  0)

(defn semantic-definition-index [(semantics (ptr OhmSemantics))
                                 (name (slice u8))] (-> i64)
  (let [(mut found) -1]
    (for [index 0 (len (.definitions semantics))]
      (let [definition (get (.definitions semantics) index)]
        (if (str/str-eq (.name definition) name) (set! found index) 0)))
    (load found)))

(defn semantics-action-count [(semantics (ptr OhmSemantics))] (-> i64)
  (len (.definitions semantics)))

(defn semantics-operation-count [(semantics (ptr OhmSemantics))] (-> i64)
  (let [(mut count) 0]
    (for definition
      (iter (.definitions semantics))
      (let [candidate definition]
        (if (not (.attribute candidate)) (set! count (+ (load count) 1)) 0)))
    (load count)))

(defn semantics-attribute-count [(semantics (ptr OhmSemantics))] (-> i64)
  (- (semantics-action-count semantics) (semantics-operation-count semantics)))

(defn semantic-definition-filtered-index [(semantics (ptr OhmSemantics))
                                          (wanted i64)
                                          (attribute bool)] (-> i64)
  (let [(mut seen) 0
        (mut found) -1]
    (for [index 0 (len (.definitions semantics))]
      (let [definition (get (.definitions semantics) index)]
        (if (= (.attribute definition) attribute)
            (do
              (if (= (load seen) wanted) (set! found index) 0)
              (set! seen (+ (load seen) 1)))
            0)))
    (load found)))

(defn semantics-operation-name [(semantics (ptr OhmSemantics))
                                (index i64)] (-> (slice u8))
  (let [definition
          (get (.definitions semantics)
               (semantic-definition-filtered-index semantics index false))]
    (.name definition)))

(defn semantics-attribute-name [(semantics (ptr OhmSemantics))
                                (index i64)] (-> (slice u8))
  (let [definition
          (get (.definitions semantics)
               (semantic-definition-filtered-index semantics index true))]
    (.name definition)))

(defn semantics-action-formal-count [(semantics (ptr OhmSemantics))
                                     (index i64)] (-> i64)
  (let [definition (get (.definitions semantics) index)]
    (semantic-formal-count (.action definition))))

(defn semantics-action-inherited? [(semantics (ptr OhmSemantics))
                                   (index i64)] (-> bool)
  (let [definition (get (.definitions semantics) index)] (.inherited definition)))

(defn semantics-action-extended? [(semantics (ptr OhmSemantics))
                                  (index i64)] (-> bool)
  (let [definition (get (.definitions semantics) index)] (.extended definition)))

(defn semantics-name [(semantics (ptr OhmSemantics))] (-> (slice u8))
  (.name semantics))

(defn semantics-grammar-recipe [(semantics (ptr OhmSemantics))] (-> (slice u8))
  (.grammar-recipe semantics))

(defn set-semantics-name! [(semantics (mut OhmSemantics))
                           (name (slice u8))] (-> i64)
  (set! (.name semantics) name)
  0)

(defn set-semantics-grammar-recipe! [(semantics (mut OhmSemantics))
                                     (recipe (slice u8))] (-> i64)
  (set! (.grammar-recipe semantics) recipe)
  0)

(defn set-semantics-action-recipe-source! [(semantics (mut OhmSemantics))
                                           (name (slice u8))
                                           (preamble (slice u8))
                                           (constructor (slice u8))] (-> i64)
  (let [index (semantic-definition-index semantics name)]
    (if (< index 0)
        1
        (let [(mut definition) (get (.definitions semantics) index)]
          (set! (.recipe-preamble definition) preamble)
          (set! (.recipe-constructor definition) constructor)
          (set! (mut (.definitions semantics)) index (load definition))
          0))))

(defn set-semantics-action-history! [(semantics (mut OhmSemantics))
                                     (name (slice u8))
                                     (inherited bool)
                                     (extended bool)] (-> i64)
  (let [index (semantic-definition-index semantics name)]
    (if (< index 0)
        1
        (let [(mut definition) (get (.definitions semantics) index)]
          (set! (.inherited definition) inherited)
          (set! (.extended definition) extended)
          (set! (mut (.definitions semantics)) index (load definition))
          0))))

(defn semantics-persistent-recipe-ready? [(semantics (ptr OhmSemantics))] (-> bool)
  (let [(mut ready) (> (slice-len (.grammar-recipe semantics)) 0)]
    (for definition
      (iter (.definitions semantics))
      (let [bound-definition definition
            constructor (.recipe-constructor bound-definition)]
        (if (= (slice-len constructor) 0)
            (set! ready false)
            0)))
    (load ready)))

(defn push-semantics-recipe-json-string! [(builder (mut str/StrBuf))
                                          (value (slice u8))] (-> i64)
  (str/sb-push-byte! (mut builder) 34)
  (let [(mut index) 0]
    (loop (if (>= (load index) (slice-len value))
              (break)
              (let [byte (primitive/cast i64 (slice-get value (load index)))
                    line-separator
                      (and (= byte 226)
                           (and (< (+ (load index) 2) (slice-len value))
                                (and (= (primitive/cast i64
                                                        (slice-get value (+ (load index) 1)))
                                        128)
                                     (or (= (primitive/cast i64
                                                             (slice-get value (+ (load index) 2)))
                                             168)
                                         (= (primitive/cast i64
                                                             (slice-get value (+ (load index) 2)))
                                             169)))))]
                (if line-separator
                    (do
                      (str/sb-push-str!
                        (mut builder)
                        (if (= (primitive/cast i64
                                                (slice-get value (+ (load index) 2)))
                               168)
                            "\\u2028"
                            "\\u2029"))
                      (set! index (+ (load index) 3)))
                    (do
                      (cond (= byte 34) (str/sb-push-str! (mut builder) "\\\"")
                            (= byte 92) (str/sb-push-str! (mut builder) "\\\\")
                            (= byte 8) (str/sb-push-str! (mut builder) "\\b")
                            (= byte 9) (str/sb-push-str! (mut builder) "\\t")
                            (= byte 10) (str/sb-push-str! (mut builder) "\\n")
                            (= byte 12) (str/sb-push-str! (mut builder) "\\f")
                            (= byte 13) (str/sb-push-str! (mut builder) "\\r")
                            (< byte 32)
                              (do
                                (str/sb-push-str! (mut builder) "\\u00")
                                (let [high (/ byte 16)
                                      low (% byte 16)]
                                  (str/sb-push-byte!
                                    (mut builder)
                                    (primitive/cast u8
                                      (+ (if (< high 10) 48 87) high)))
                                  (str/sb-push-byte!
                                    (mut builder)
                                    (primitive/cast u8
                                      (+ (if (< low 10) 48 87) low)))))
                            :else
                              (str/sb-push-byte! (mut builder)
                                                 (slice-get value (load index))))
                      (set! index (+ (load index) 1))))))))
  (str/sb-push-byte! (mut builder) 34)
  0)

(defn semantics-to-persistent-recipe! [(semantics (ptr OhmSemantics))]
                                       (-> (slice u8))
  (if (not (semantics-persistent-recipe-ready? semantics))
      ""
      (let [(mut builder) (str/sb-new (.allocator semantics))]
    (str/sb-push-str! (mut builder) "[\"coilSemantics\",1,")
    (push-semantics-recipe-json-string! (mut builder) (.name semantics))
    (str/sb-push-byte! (mut builder) 44)
    (push-semantics-recipe-json-string! (mut builder) (.grammar-name semantics))
    (str/sb-push-byte! (mut builder) 44)
    (push-semantics-recipe-json-string! (mut builder) (.grammar-recipe semantics))
    (str/sb-push-str! (mut builder) ",[")
    (for [index 0 (len (.definitions semantics))]
      (let [definition (get (.definitions semantics) index)]
        (if (> index 0) (str/sb-push-byte! (mut builder) 44) 0)
        (str/sb-push-byte! (mut builder) 91)
        (push-semantics-recipe-json-string!
          (mut builder)
          (if (.attribute definition) "attribute" "operation"))
        (str/sb-push-byte! (mut builder) 44)
        (push-semantics-recipe-json-string! (mut builder) (.name definition))
        (str/sb-push-byte! (mut builder) 44)
        (str/sb-push-i64! (mut builder) (semantic-formal-count (.action definition)))
        (str/sb-push-byte! (mut builder) 44)
        (str/sb-push-i64! (mut builder) (if (.inherited definition) 1 0))
        (str/sb-push-byte! (mut builder) 44)
        (str/sb-push-i64! (mut builder) (if (.extended definition) 1 0))
        (str/sb-push-byte! (mut builder) 44)
        (push-semantics-recipe-json-string! (mut builder)
                                             (.recipe-preamble definition))
        (str/sb-push-byte! (mut builder) 44)
        (push-semantics-recipe-json-string! (mut builder)
                                             (.recipe-constructor definition))
        (str/sb-push-byte! (mut builder) 93)))
        (str/sb-push-str! (mut builder) "]]")
        (str/sb-finish! (mut builder)))))

(defn semantics-has-action? [(semantics (ptr OhmSemantics))
                             (name (slice u8))] (-> bool)
  (>= (semantic-definition-index semantics name) 0))

(defn semantic-signature-name-end [(signature (slice u8))
                                   (start i64)] (-> i64)
  (let [first
          (if (= (byte-at signature start) 95)
              (+ start 1)
              (match-letter signature start))]
    (if (< first 0)
        -1
        (let [(mut at) first]
          (loop (let [underscore (= (byte-at signature (load at)) 95)
                      next
                        (if underscore
                            (+ (load at) 1)
                            (match-alnum signature (load at)))]
                  (if (< next 0)
                      (break)
                      (set! at next))))
          (load at)))))

(defn parse-semantic-signature [(signature (slice u8))
                                (attribute bool)] (-> SemanticSignature)
  (let [(mut parsed) (primitive/zeroed SemanticSignature)
        name-start (skip-spaces signature 0)
        name-end (semantic-signature-name-end signature name-start)]
    (set! (.valid parsed) false)
    (set! (.name parsed) "")
    (set! (.formal-count parsed) 0)
    (set! (.error-position parsed) name-start)
    (if (< name-end 0)
        0
        (let [(mut at) (skip-spaces signature name-end)]
          (set! (.name parsed) (subslice signature name-start name-end))
          (if attribute
              (if (= (load at) (slice-len signature))
                  (set! (.valid parsed) true)
                  (set! (.error-position parsed) (load at)))
              (if (= (load at) (slice-len signature))
                  (set! (.valid parsed) true)
                  (if (!= (byte-at signature (load at)) 40)
                      (set! (.error-position parsed) (load at))
                      (do
                        (set! at (skip-spaces signature (+ (load at) 1)))
                        (if (= (byte-at signature (load at)) 41)
                            (do
                              (set! at (skip-spaces signature (+ (load at) 1)))
                              (if (= (load at) (slice-len signature))
                                  (set! (.valid parsed) true)
                                  (set! (.error-position parsed) (load at))))
                            (let [(mut done) false
                                  (mut failed) false]
                              (loop (if (or (load done) (load failed))
                                        (break)
                                        (let [formal-end
                                                (semantic-signature-name-end signature
                                                                             (load at))]
                                          (if (< formal-end 0)
                                              (do
                                                (set! (.error-position parsed) (load at))
                                                (set! failed true))
                                              (do
                                                (set! (.formal-count parsed)
                                                      (+ (.formal-count parsed) 1))
                                                (set! at (skip-spaces signature formal-end))
                                                (cond (= (byte-at signature (load at)) 44)
                                                        (set! at
                                                              (skip-spaces signature
                                                                           (+ (load at) 1)))
                                                      (= (byte-at signature (load at)) 41)
                                                        (do
                                                          (set! at
                                                                (skip-spaces signature
                                                                             (+ (load at) 1)))
                                                          (set! done true))
                                                      :else
                                                        (do
                                                          (set! (.error-position parsed)
                                                                (load at))
                                                          (set! failed true))))))))
                              (if (and (not (load failed))
                                       (load done)
                                       (= (load at) (slice-len signature)))
                                  (set! (.valid parsed) true)
                                  (if (and (not (load failed)) (load done))
                                      (set! (.error-position parsed) (load at))
                                      0))))))))))
    (load parsed)))

(defn semantic-signature-valid? [(signature SemanticSignature)] (-> bool)
  (.valid signature))

(defn semantic-signature-name [(signature SemanticSignature)] (-> (slice u8))
  (.name signature))

(defn semantic-signature-formal-count [(signature SemanticSignature)] (-> i64)
  (.formal-count signature))

(defn semantic-signature-error-position [(signature SemanticSignature)] (-> i64)
  (.error-position signature))

;; Status: 0 added, 1 duplicate name, 2 wrong grammar, 3 attribute arguments.
(defn add-semantics-action! [(semantics (mut OhmSemantics))
                             (name (slice u8))
                             (action (dyn OhmLazySemanticAction))
                             (attribute bool)] (-> i64)
  (cond (semantics-has-action? semantics name) 1
        (not (and (str/str-eq (.grammar-name semantics)
                              (semantic-grammar-name action))
                  (= (primitive/cast i64 (.grammar-token semantics))
                     (primitive/cast i64 (semantic-grammar-token action)))))
          2
        (and attribute (!= (semantic-formal-count action) 0)) 3
        :else
          (let [(mut definition) (primitive/zeroed SemanticDefinition)]
            (set! (.name definition) name)
            (set! (.action definition) action)
            (set! (.attribute definition) attribute)
            (set! (.inherited definition) false)
            (set! (.extended definition) false)
            (set! (.recipe-preamble definition) "")
            (set! (.recipe-constructor definition) "")
            (if attribute
                (do
                  (set! (.attribute-cache definition)
                        (new-semantic-attribute-cache (.allocator semantics)))
                  (set! (.owns-attribute-cache definition) true))
                (set! (.owns-attribute-cache definition) false))
            (push! (mut (.definitions semantics)) (load definition))
            0)))

(defn add-semantics-operation! [(semantics (mut OhmSemantics))
                                (name (slice u8))
                                (action (dyn OhmLazySemanticAction))] (-> i64)
  (add-semantics-action! (mut semantics) name action false))

(defn add-semantics-attribute! [(semantics (mut OhmSemantics))
                                (name (slice u8))
                                (action (dyn OhmLazySemanticAction))] (-> i64)
  (add-semantics-action! (mut semantics) name action true))

;; Signature status extends add-semantics-action!: 4 malformed signature,
;; 5 parsed formal count does not match the typed action.
(defn add-semantics-operation-signature! [(semantics (mut OhmSemantics))
                                          (signature (slice u8))
                                          (action (dyn OhmLazySemanticAction))] (-> i64)
  (let [parsed (parse-semantic-signature signature false)]
    (cond (not (.valid parsed)) 4
          (!= (.formal-count parsed) (semantic-formal-count action)) 5
          :else (add-semantics-operation! (mut semantics) (.name parsed) action))))

(defn add-semantics-attribute-signature! [(semantics (mut OhmSemantics))
                                          (signature (slice u8))
                                          (action (dyn OhmLazySemanticAction))] (-> i64)
  (let [parsed (parse-semantic-signature signature true)]
    (if (not (.valid parsed))
        4
        (add-semantics-attribute! (mut semantics) (.name parsed) action))))

(defn extend-ohm-semantics [(parent (ptr OhmSemantics))
                            (grammar-name (slice u8))
                            (grammar-token (ptr u8))] (-> OhmSemantics)
  (let [(mut semantics) (new-ohm-semantics grammar-name grammar-token (.allocator parent))]
    (for inherited-definition
      (iter (.definitions parent))
      (let [(mut definition) inherited-definition]
        (set! (.inherited definition) true)
        (set! (.extended definition) false)
        (if (.attribute definition)
            (do
              (set! (.attribute-cache definition)
                    (new-semantic-attribute-cache (.allocator semantics)))
              (set! (.owns-attribute-cache definition) true))
            (set! (.owns-attribute-cache definition) false))
        (push! (mut (.definitions semantics)) (load definition))))
    (load semantics)))

;; Status: 0 extended, 1 missing/non-inherited, 2 already extended,
;; 3 operation/attribute kind mismatch, 4 wrong grammar, 5 attribute arguments,
;; 6 inherited formal-count mismatch.
(defn extend-semantics-action! [(semantics (mut OhmSemantics))
                                (name (slice u8))
                                (action (dyn OhmLazySemanticAction))
                                (attribute bool)] (-> i64)
  (let [index (semantic-definition-index semantics name)]
    (if (< index 0)
        1
        (let [(mut definition) (get (.definitions semantics) index)]
          (cond (not (.inherited definition)) 1
                (.extended definition) 2
                (!= (.attribute definition) attribute) 3
                (not (and (str/str-eq (.grammar-name semantics)
                                      (semantic-grammar-name action))
                          (= (primitive/cast i64 (.grammar-token semantics))
                             (primitive/cast i64 (semantic-grammar-token action)))))
                  4
                (and attribute (!= (semantic-formal-count action) 0)) 5
                (!= (semantic-formal-count (.action definition))
                    (semantic-formal-count action))
                  6
                :else
                  (do
                    (set! (.action definition) action)
                    (set! (.extended definition) true)
                    (set! (mut (.definitions semantics)) index (load definition))
                    0))))))

;; Ohm extension APIs accept a bare inherited name, not a fresh signature.
;; Status 7 means the supplied text was not a bare operation/attribute name.
(defn extend-semantics-operation-signature! [(semantics (mut OhmSemantics))
                                             (signature (slice u8))
                                             (action (dyn OhmLazySemanticAction))] (-> i64)
  (let [parsed (parse-semantic-signature signature false)]
    (if (or (not (.valid parsed)) (!= (.formal-count parsed) 0))
        7
        (extend-semantics-action! (mut semantics) (.name parsed) action false))))

(defn extend-semantics-attribute-signature! [(semantics (mut OhmSemantics))
                                             (signature (slice u8))
                                             (action (dyn OhmLazySemanticAction))] (-> i64)
  (let [parsed (parse-semantic-signature signature true)]
    (if (not (.valid parsed))
        7
        (extend-semantics-action! (mut semantics) (.name parsed) action true))))

(defn new-registered-semantic-evaluation [(semantics (mut OhmSemantics))
                                          (index i64)
                                          (result (ptr MatchResult))] (-> SemanticEvaluation)
  (let [definition
          (al/al-elem [SemanticDefinition] (mut (.definitions semantics)) index)]
    (if (.attribute definition)
        (let [(mut evaluation)
                (new-cached-semantic-attribute-evaluation
                  (.action definition)
                  result
                  (.name definition)
                  (mut (.attribute-cache definition)))]
          (load evaluation))
        (new-named-semantic-evaluation (.action definition)
                                       result
                                       false
                                       (.name definition)))))

(defn free-ohm-semantics! [(semantics (mut OhmSemantics))] (-> i64)
  (for [index 0 (len (.definitions semantics))]
    (let [definition
            (al/al-elem [SemanticDefinition] (mut (.definitions semantics)) index)]
    (if (.owns-attribute-cache definition)
        (free-semantic-attribute-cache! (mut (.attribute-cache definition)))
        0)))
  (al/al-free! (mut (.definitions semantics)))
  0)

(defn free-registered-semantic-evaluation!
  [(semantics (mut OhmSemantics))
   (index i64)
   (evaluation (mut SemanticEvaluation))] (-> i64)
  (let [definition
          (al/al-elem [SemanticDefinition] (mut (.definitions semantics)) index)]
    (if (.attribute definition)
        (finish-cached-semantic-attribute-evaluation!
          (mut evaluation)
          (mut (.attribute-cache definition)))
        0)
    (free-semantic-evaluation! (mut evaluation))))

(defn fail-semantic-evaluation! [(evaluation (mut SemanticEvaluation))
                                 (kind i64)
                                 (node i64)] (-> i64)
  (if (not (.failed evaluation))
      (do
        (set! (.failed evaluation) true)
        (set! (.error-kind evaluation) kind)
        (set! (.error-node evaluation) node)
        (for action-frame
          (iter (.action-stack evaluation))
          (push! (mut (.error-stack evaluation)) action-frame))
        0)
      0))

(defn push-semantic-action-frame! [(evaluation (mut SemanticEvaluation))
                                   (node i64)
                                   (explicit bool)] (-> i64)
  (let [(mut frame) (primitive/zeroed SemanticActionFrame)]
    (set! (.node frame) node)
    (set! (.action-name frame) (.action-name evaluation))
    (set! (.explicit frame) explicit)
    (push! (mut (.action-stack evaluation)) (load frame))
    0))

(defn evaluate-semantic-node! [(evaluation (mut SemanticEvaluation))
                               (node i64)
                               (arguments (slice i64))] (-> i64)
  (if (.failed evaluation)
      0
      (let [result (.result evaluation)
            expected (semantic-formal-count (.action evaluation))
            cache-index
              (if (and (>= node 0)
                       (and (< node (len (.nodes result)))
                            (and (.attribute evaluation) (.uses-attribute-cache evaluation))))
                  (semantic-attribute-cache-find (field evaluation attribute-cache)
                                                 (node-id (load result) node))
                  -1)]
        (if (or (< node 0) (>= node (len (.nodes result))))
            (fail-semantic-evaluation! (mut evaluation) 4 node)
            (if (!= expected (slice-len arguments))
                (do
                  (set! (.expected-arguments evaluation) expected)
                  (set! (.actual-arguments evaluation) (slice-len arguments))
                  (fail-semantic-evaluation! (mut evaluation) 1 node))
                (if (>= cache-index 0)
                    (let [cached-value
                            (semantic-attribute-cache-load! (mut (.attribute-cache evaluation))
                                                            cache-index)]
                      (set! (mut (.values evaluation)) node cached-value)
                      (set! (mut (.states evaluation)) node (primitive/cast u8 2))
                      cached-value)
                    (let [state (primitive/cast i64 (get (.states evaluation) node))]
                  (if (and (.attribute evaluation) (= state 2))
                      (get (.values evaluation) node)
                      (if (and (.attribute evaluation) (= state 1))
                          (fail-semantic-evaluation! (mut evaluation) 3 node)
                          (do
                            (if (.attribute evaluation)
                                (set! (mut (.states evaluation))
                                      node
                                      (primitive/cast u8 1))
                                0)
                            (let [action-kind (semantic-action-kind (.action evaluation) result node)
                                  child-count (node-child-count (load result) node)
                                  _
                                    (push-semantic-action-frame! (mut evaluation)
                                                                 node
                                                                 (> action-kind 0))
                                  value
                                    (if (> action-kind 0)
                                        (apply-lazy-semantic-action (.action evaluation)
                                                                    (mut evaluation)
                                                                    node
                                                                    action-kind
                                                                    arguments)
                                        (if (and (not (node-iteration? (load result) node))
                                                 (= child-count 1))
                                            (evaluate-semantic-node! (mut evaluation)
                                                                     (node-child (load result) node 0)
                                                                     arguments)
                                            (fail-semantic-evaluation! (mut evaluation)
                                                                       2
                                                                       node)))]
                              (pop! (mut (.action-stack evaluation)))
                              (if (.failed evaluation)
                                  0
                                  (do
                                    (if (.attribute evaluation)
                                        (do
                                          (set! (mut (.values evaluation)) node value)
                                          (set! (mut (.states evaluation))
                                                node
                                                (primitive/cast u8 2))
                                          (if (.uses-attribute-cache evaluation)
                                              (semantic-attribute-cache-store!
                                                (mut (.attribute-cache evaluation))
                                                (node-id (load result) node)
                                                value)
                                              0)
                                          0)
                                        0)
                                    value)))))))))))))

(defn evaluate-semantic-child! [(evaluation (mut SemanticEvaluation))
                                (node i64)
                                (child-index i64)
                                (arguments (slice i64))] (-> i64)
  (let [result (.result evaluation)
        child (node-child (load result) node child-index)]
    (evaluate-semantic-node! (mut evaluation) child arguments)))

(defn evaluate-semantic-root! [(evaluation (mut SemanticEvaluation))
                               (arguments (slice i64))] (-> i64)
  (let [result (.result evaluation)]
    (if (not (.succeeded result))
        (fail-semantic-evaluation! (mut evaluation) 4 (.root result))
        (evaluate-semantic-node! (mut evaluation) (.root result) arguments))))

;; Invoke another operation or attribute while preserving Ohm's mixed-operation
;; action stack. The nested evaluation owns its memo table, while failures are
;; transferred back to the caller with every frame's original action name.
(defn evaluate-semantic-node-with! [(evaluation (mut SemanticEvaluation))
                                    (action (dyn OhmLazySemanticAction))
                                    (node i64)
                                    (arguments (slice i64))
                                    (attribute bool)
                                    (action-name (slice u8))] (-> i64)
  (let [(mut nested)
          (new-named-semantic-evaluation action
                                         (.result evaluation)
                                         attribute
                                         action-name)]
    (for frame
      (iter (.action-stack evaluation))
      (push! (mut (.action-stack nested)) frame))
    (let [value (evaluate-semantic-node! (mut nested) node arguments)]
      (if (.failed nested)
          (do
            (set! (.failed evaluation) true)
            (set! (.error-kind evaluation) (.error-kind nested))
            (set! (.error-node evaluation) (.error-node nested))
            (set! (.expected-arguments evaluation) (.expected-arguments nested))
            (set! (.actual-arguments evaluation) (.actual-arguments nested))
            (set! (.action-name evaluation) (.action-name nested))
            (for frame
              (iter (.error-stack nested))
              (push! (mut (.error-stack evaluation)) frame))
            0)
          0)
      (free-semantic-evaluation! (mut nested))
      value)))

(defn forget-semantic-attribute-node! [(evaluation (mut SemanticEvaluation))
                                       (node i64)] (-> i64)
  (if (and (>= node 0) (< node (len (.states evaluation))))
      (do
        (set! (mut (.states evaluation)) node (primitive/cast u8 0))
        (let [result (.result evaluation)
              count (node-child-count (load result) node)]
          (for [index 0 count]
            (forget-semantic-attribute-node! (mut evaluation)
                                             (node-child (load result) node index))))
        0)
      0))

(defn forget-semantic-attribute! [(evaluation (mut SemanticEvaluation))] (-> i64)
  (let [result (.result evaluation)]
    (forget-semantic-attribute-node! (mut evaluation) (.root result))))

(defn semantic-evaluation-failed? [(evaluation (ptr SemanticEvaluation))] (-> bool)
  (.failed evaluation))

(defn semantic-evaluation-error-kind [(evaluation (ptr SemanticEvaluation))] (-> i64)
  (.error-kind evaluation))

(defn semantic-evaluation-error-node [(evaluation (ptr SemanticEvaluation))] (-> i64)
  (.error-node evaluation))

(defn semantic-wrapper-to-string! [(evaluation (ptr SemanticEvaluation))]
                                  (-> (slice u8))
  (let [result (.result evaluation)
        (mut builder) (str/sb-new (.allocator result))]
    (str/sb-push-str! (mut builder) "[semantics wrapper for ")
    (str/sb-push-str! (mut builder) (.grammar-name result))
    (str/sb-push-str! (mut builder) "]")
    (str/sb-finish! (mut builder))))

(defn ohm-semantics-to-string! [(semantics (ptr OhmSemantics))] (-> (slice u8))
  (let [(mut builder) (str/sb-new (.allocator semantics))]
    (str/sb-push-str! (mut builder) "[semantics for ")
    (str/sb-push-str! (mut builder) (.grammar-name semantics))
    (str/sb-push-str! (mut builder) "]")
    (str/sb-finish! (mut builder))))

(defn semantic-evaluation-expected-arguments [(evaluation (ptr SemanticEvaluation))] (-> i64)
  (.expected-arguments evaluation))

(defn semantic-evaluation-actual-arguments [(evaluation (ptr SemanticEvaluation))] (-> i64)
  (.actual-arguments evaluation))

(defn semantic-error-node-name [(evaluation (ptr SemanticEvaluation))] (-> (slice u8))
  (let [node (.error-node evaluation)
        result (.result evaluation)]
    (if (or (< node 0) (>= node (len (.nodes result))))
        ""
        (cond (node-terminal? (load result) node) "_terminal"
              (node-iteration? (load result) node) "_iter"
              :else (node-rule (load result) node)))))

(defn semantic-evaluation-message [(evaluation (mut SemanticEvaluation))] (-> (slice u8))
  (if (or (not (.failed evaluation)) (.owns-error-message evaluation))
      (.error-message evaluation)
      (let [result (.result evaluation)
            (mut message) (str/sb-new (.allocator result))
            name (.action-name evaluation)]
        (cond (= (.error-kind evaluation) 1)
                (do
                  (str/sb-push-str! (mut message) "Invalid number of arguments passed to ")
                  (str/sb-push-str! (mut message) name)
                  (str/sb-push-str! (mut message)
                                    (if (.attribute evaluation)
                                        " attribute (expected "
                                        " operation (expected "))
                  (str/sb-push-i64! (mut message) (.expected-arguments evaluation))
                  (str/sb-push-str! (mut message) ", got ")
                  (str/sb-push-i64! (mut message) (.actual-arguments evaluation))
                  (str/sb-push-str! (mut message) ")"))
              (= (.error-kind evaluation) 2)
                (do
                  (str/sb-push-str! (mut message) "Missing semantic action for '")
                  (str/sb-push-str! (mut message) (semantic-error-node-name evaluation))
                  (str/sb-push-str! (mut message) "' in ")
                  (str/sb-push-str! (mut message)
                                    (if (.attribute evaluation)
                                        "attribute '"
                                        "operation '"))
                  (str/sb-push-str! (mut message) name)
                  (str/sb-push-str! (mut message) "'.")
                  (if (str/str-eq (semantic-error-node-name evaluation) "_iter")
                      (str/sb-push-str! (mut message)
                                        "\nNOTE: as of Ohm v16, there is no default action for iteration nodes — see \n  https://ohmjs.org/d/dsa for details.")
                      0)
                  (if (> (len (.error-stack evaluation)) 0)
                      (do
                        (str/sb-push-str! (mut message)
                                          "\nAction stack (most recent call last):")
                        (for [stack-index 0 (len (.error-stack evaluation))]
                          (let [frame (get (.error-stack evaluation) stack-index)
                                stack-node (.node frame)]
                            (str/sb-push-str! (mut message) "\n  ")
                            (str/sb-push-str! (mut message) (.action-name frame))
                            (str/sb-push-str! (mut message) " > ")
                            (cond (= stack-index (- (len (.error-stack evaluation)) 1))
                                    (str/sb-push-str! (mut message)
                                                      (semantic-error-node-name evaluation))
                                  (node-terminal? (load result) stack-node) (str/sb-push-str! (mut message) "_terminal")
                                  (node-iteration? (load result) stack-node) (str/sb-push-str! (mut message) "_iter")
                                  (.explicit frame)
                                    (str/sb-push-str! (mut message)
                                                      (node-rule (load result) stack-node))
                                  :else
                                    (do
                                      (str/sb-push-str! (mut message)
                                                        "default action for '")
                                      (str/sb-push-str! (mut message)
                                                        (node-rule (load result) stack-node))
                                      (str/sb-push-str! (mut message) "'")))))
                        0)
                      0))
              (= (.error-kind evaluation) 3)
                (do
                  (str/sb-push-str! (mut message) "Attribute '")
                  (str/sb-push-str! (mut message) name)
                  (str/sb-push-str! (mut message) "' is circular"))
              (= (.error-kind evaluation) 5)
                (do
                  (str/sb-push-str! (mut message)
                                    "Cannot use a MatchResult from grammar '")
                  (str/sb-push-str! (mut message)
                                    (match-grammar-name (load result)))
                  (str/sb-push-str! (mut message)
                                    "' with a semantics for '")
                  (str/sb-push-str! (mut message)
                                    (semantic-grammar-name (.action evaluation)))
                  (str/sb-push-str! (mut message) "'"))
              (= (.error-kind evaluation) 6)
                (do
                  (str/sb-push-str! (mut message) "Attribute '")
                  (str/sb-push-str! (mut message) name)
                  (str/sb-push-str! (mut message) "' must not declare arguments"))
              (= (.error-kind evaluation) 7)
                (str/sb-push-str! (mut message) "cannot apply Semantics to a failed MatchResult")
              (= (.error-kind evaluation) 8)
                (do
                  (str/sb-push-str! (mut message) "Attribute '")
                  (str/sb-push-str! (mut message) name)
                  (str/sb-push-str! (mut message) "' not initialized"))
              :else (str/sb-push-str! (mut message) "Semantic evaluation failed"))
        (set! (.error-message evaluation) (str/sb-finish! (mut message)))
        (set! (.owns-error-message evaluation) true)
        (.error-message evaluation))))

(defn semantic-evaluation-stack-count [(evaluation (ptr SemanticEvaluation))] (-> i64)
  (len (.error-stack evaluation)))

(defn semantic-evaluation-stack-node [(evaluation (ptr SemanticEvaluation))
                                      (index i64)] (-> i64)
  (let [frame (get (.error-stack evaluation) index)] (.node frame)))

(defn semantic-evaluation-stack-action-name [(evaluation (ptr SemanticEvaluation))
                                             (index i64)] (-> (slice u8))
  (let [frame (get (.error-stack evaluation) index)] (.action-name frame)))

(defn semantic-evaluation-stack-rule [(evaluation (ptr SemanticEvaluation))
                                      (index i64)] (-> (slice u8))
  (node-rule (load (.result evaluation))
             (semantic-evaluation-stack-node evaluation index)))

(defn free-semantic-evaluation! [(evaluation (mut SemanticEvaluation))] (-> i64)
  (if (.owns-error-message evaluation)
      (let [result (.result evaluation)]
        (alloc/free [u8] (.allocator result) (.error-message evaluation)))
      0)
  (al/al-free! (mut (.values evaluation)))
  (al/al-free! (mut (.states evaluation)))
  (al/al-free! (mut (.action-stack evaluation)))
  (al/al-free! (mut (.error-stack evaluation)))
  (if (.uses-attribute-cache evaluation)
      (al/al-free! (mut (.entries (.attribute-cache evaluation))))
      0)
  0)

;; --------------------------------------------------------------------------
;; extras.toAST

(defn to-ast-abort [(message (slice u8))] (-> i64)
  (io/print-str (io/stderr) message)
  (io/print-str (io/stderr) "\n")
  (alloc/abort))

(defn new-ohm-ast [(a (dyn alloc/Allocator))] (-> OhmAst)
  (let [(mut ast) (primitive/zeroed OhmAst)]
    (set! (.nodes ast) (al/al-new [OhmAstNode] a))
    (set! (.entries ast) (al/al-new [OhmAstEntry] a))
    (set! (.owned-texts ast) (al/al-new [(slice u8)] a))
    (set! (.allocator ast) a)
    (set! (.root ast) -1)
    (set! (.valid ast) true)
    (set! (.error-message ast) "")
    (load ast)))

(defn ast-own-text! [(ast (mut OhmAst)) (value (slice u8))] (-> (slice u8))
  (let [(mut builder) (str/sb-new (.allocator ast))]
    (str/sb-push-str! (mut builder) value)
    (let [owned (str/sb-finish! (mut builder))]
      (push! (mut (.owned-texts ast)) owned)
      owned)))

(defn ast-push-node! [(ast (mut OhmAst))
                      (kind i64)
                      (text-value (slice u8))
                      (boolean-value bool)
                      (number-value f64)] (-> i64)
  (let [(mut node) (primitive/zeroed OhmAstNode)
        index (len (.nodes ast))]
    (set! (.kind node) kind)
    (set! (.text node) text-value)
    (set! (.boolean node) boolean-value)
    (set! (.number node) number-value)
    (set! (.entry-start node) (len (.entries ast)))
    (set! (.entry-count node) 0)
    (push! (mut (.nodes ast)) (load node))
    index))

(defn ast-add-null! [(ast (mut OhmAst))] (-> i64)
  (ast-push-node! (mut ast) 0 "" false 0.0))

(defn ast-add-string! [(ast (mut OhmAst)) (value (slice u8))] (-> i64)
  (ast-push-node! (mut ast) 1 (ast-own-text! (mut ast) value) false 0.0))

(defn ast-add-bool! [(ast (mut OhmAst)) (value bool)] (-> i64)
  (ast-push-node! (mut ast) 2 "" value 0.0))

(defn ast-add-number! [(ast (mut OhmAst)) (value f64)] (-> i64)
  (ast-push-node! (mut ast) 3 "" false value))

(defn ast-add-object! [(ast (mut OhmAst))] (-> i64)
  (ast-push-node! (mut ast) 4 "" false 0.0))

(defn ast-add-array! [(ast (mut OhmAst))] (-> i64)
  (ast-push-node! (mut ast) 5 "" false 0.0))

(defn ast-add-entry! [(ast (mut OhmAst))
                      (container i64)
                      (name (slice u8))
                      (value i64)] (-> i64)
  (let [node (get (.nodes ast) container)
        expected (+ (.entry-start node) (.entry-count node))]
    (if (!= expected (len (.entries ast)))
        (to-ast-abort "toAST container entries must be appended contiguously")
        0)
    (let [(mut entry) (primitive/zeroed OhmAstEntry)
          (mut updated) (primitive/zeroed OhmAstNode)]
      (set! (.kind updated) (.kind node))
      (set! (.text updated) (.text node))
      (set! (.boolean updated) (.boolean node))
      (set! (.number updated) (.number node))
      (set! (.entry-start updated) (.entry-start node))
      (set! (.entry-count updated) (.entry-count node))
      (set! (.name entry) (ast-own-text! (mut ast) name))
      (set! (.value entry) value)
      (push! (mut (.entries ast)) (load entry))
      (set! (.entry-count updated) (+ (.entry-count updated) 1))
      (set! (mut (.nodes ast)) container (load updated))
      value)))

(defn ast-add-element! [(ast (mut OhmAst))
                        (array i64)
                        (value i64)] (-> i64)
  (ast-add-entry! (mut ast) array "" value))

(defn ast-valid? [(ast (ptr OhmAst))] (-> bool) (.valid ast))
(defn ast-error-message [(ast (ptr OhmAst))] (-> (slice u8)) (.error-message ast))
(defn ast-root [(ast (ptr OhmAst))] (-> i64) (.root ast))
(defn ast-node-count [(ast (ptr OhmAst))] (-> i64) (len (.nodes ast)))
(defn ast-entry-count [(ast (ptr OhmAst))] (-> i64) (len (.entries ast)))
(defn ast-kind [(ast (ptr OhmAst)) (node i64)] (-> i64)
  (let [value (get (.nodes ast) node)] (.kind value)))
(defn ast-string [(ast (ptr OhmAst)) (node i64)] (-> (slice u8))
  (let [value (get (.nodes ast) node)] (.text value)))
(defn ast-bool [(ast (ptr OhmAst)) (node i64)] (-> bool)
  (let [value (get (.nodes ast) node)] (.boolean value)))
(defn ast-number [(ast (ptr OhmAst)) (node i64)] (-> f64)
  (let [value (get (.nodes ast) node)] (.number value)))
(defn ast-child-count [(ast (ptr OhmAst)) (node i64)] (-> i64)
  (let [value (get (.nodes ast) node)] (.entry-count value)))
(defn ast-child [(ast (ptr OhmAst)) (node i64) (index i64)] (-> i64)
  (let [value (get (.nodes ast) node)
        entry (get (.entries ast) (+ (.entry-start value) index))]
    (.value entry)))
(defn ast-property-name [(ast (ptr OhmAst))
                         (node i64)
                         (index i64)] (-> (slice u8))
  (let [value (get (.nodes ast) node)
        entry (get (.entries ast) (+ (.entry-start value) index))]
    (.name entry)))
(defn ast-property-index [(ast (ptr OhmAst))
                          (node i64)
                          (name (slice u8))] (-> i64)
  (let [value (get (.nodes ast) node)
        (mut found) -1]
    (for [index 0 (.entry-count value)]
      (let [entry (get (.entries ast) (+ (.entry-start value) index))]
        (if (str/str-eq (.name entry) name) (set! found index) 0)))
    (load found)))
(defn ast-property [(ast (ptr OhmAst))
                    (node i64)
                    (name (slice u8))] (-> i64)
  (let [index (ast-property-index ast node name)]
    (if (< index 0) -1 (ast-child ast node index))))

(defn append-ast-public-signature! [(builder (mut str/StrBuf))
                                    (ast (ptr OhmAst))
                                    (node i64)] (-> i64)
  (let [kind (ast-kind ast node)]
    (cond (= kind 0) (str/sb-push-str! (mut builder) "n")
          (= kind 1)
            (do
              (str/sb-push-str! (mut builder) "s")
              (cst-signature-hex! (mut builder) (ast-string ast node)))
          (= kind 2) (str/sb-push-str! (mut builder) (if (ast-bool ast node) "b1" "b0"))
          (= kind 3)
            (do
              (str/sb-push-str! (mut builder) "d")
              (str/sb-push-i64! (mut builder)
                                (primitive/cast i64 (ast-number ast node))))
          (= kind 5)
            (do
              (str/sb-push-str! (mut builder) "a[")
              (for [index 0 (ast-child-count ast node)]
                (if (> index 0) (str/sb-push-str! (mut builder) ",") 0)
                (append-ast-public-signature!
                  (mut builder) ast (ast-child ast node index)))
              (str/sb-push-str! (mut builder) "]"))
          (= kind 4)
            (let [count (ast-child-count ast node)
                  (mut used) (al/al-new [bool] (alloc/malloc-allocator))]
              (for [_ 0 count] (push! (mut used) false))
              (str/sb-push-str! (mut builder) "o{")
              (for [ordinal 0 count]
                (let [(mut selected) -1]
                  (for [candidate 0 count]
                    (if (not (get (load used) candidate))
                        (if (or (< (load selected) 0)
                                (< (str/str-cmp
                                     (ast-property-name ast node candidate)
                                     (ast-property-name ast node (load selected)))
                                   0))
                            (set! selected candidate)
                            0)
                        0))
                  (if (> ordinal 0) (str/sb-push-str! (mut builder) ",") 0)
                  (cst-signature-hex!
                    (mut builder) (ast-property-name ast node (load selected)))
                  (str/sb-push-str! (mut builder) "=")
                  (append-ast-public-signature!
                    (mut builder) ast (ast-child ast node (load selected)))
                  (set! (al/al-elem [bool] (mut used) (load selected)) true)))
              (str/sb-push-str! (mut builder) "}")
              (al/al-free! (mut used)))
          :else (str/sb-push-str! (mut builder) "?")))
  0)

(defn ast-public-signature! [(ast (ptr OhmAst))
                             (a (dyn alloc/Allocator))] (-> (slice u8))
  (let [(mut builder) (str/sb-new a)]
    (if (and (ast-valid? ast) (>= (ast-root ast) 0))
        (append-ast-public-signature! (mut builder) ast (ast-root ast))
        (do
          (str/sb-push-str! (mut builder) "error:")
          (cst-signature-hex! (mut builder) (ast-error-message ast))))
    (str/sb-finish! (mut builder))))

(defn free-ohm-ast! [(ast (mut OhmAst))] (-> i64)
  (for text-value
    (iter (.owned-texts ast))
    (alloc/free [u8] (.allocator ast) text-value))
  (al/al-free! (mut (.owned-texts ast)))
  (al/al-free! (mut (.nodes ast)))
  (al/al-free! (mut (.entries ast)))
  0)

(defn new-ohm-ast-mapping [(a (dyn alloc/Allocator))] (-> OhmAstMapping)
  (let [(mut mapping) (primitive/zeroed OhmAstMapping)]
    (set! (.rules mapping) (al/al-new [OhmAstRuleMapping] a))
    (set! (.properties mapping) (al/al-new [OhmAstPropertyMapping] a))
    (set! (.allocator mapping) a)
    (load mapping)))

(defn ast-mapping-rule-index [(mapping (ptr OhmAstMapping))
                              (name (slice u8))] (-> i64)
  (let [(mut found) -1]
    (for [index 0 (len (.rules mapping))]
      (let [rule (get (.rules mapping) index)]
        (if (str/str-eq (.name rule) name) (set! found index) 0)))
    (load found)))

(defn ast-mapping-add-rule! [(mapping (mut OhmAstMapping))
                             (name (slice u8))
                             (kind i64)
                             (value i64)] (-> i64)
  (if (>= (ast-mapping-rule-index mapping name) 0)
      (to-ast-abort "Duplicate rule in toAST mapping")
      0)
  (let [(mut rule) (primitive/zeroed OhmAstRuleMapping)
        index (len (.rules mapping))]
    (set! (.name rule) name)
    (set! (.kind rule) kind)
    (set! (.value rule) value)
    (set! (.property-start rule) (len (.properties mapping)))
    (set! (.property-count rule) 0)
    (push! (mut (.rules mapping)) (load rule))
    index))

(defn ast-mapping-add-template! [(mapping (mut OhmAstMapping))
                                 (name (slice u8))] (-> i64)
  (ast-mapping-add-rule! (mut mapping) name 0 0))
(defn ast-mapping-add-forward! [(mapping (mut OhmAstMapping))
                                (name (slice u8))
                                (child i64)] (-> i64)
  (ast-mapping-add-rule! (mut mapping) name 1 child))
(defn ast-mapping-add-action! [(mapping (mut OhmAstMapping))
                               (name (slice u8))
                               (action-id i64)] (-> i64)
  (ast-mapping-add-rule! (mut mapping) name 2 action-id))

(defn ast-mapping-add-property! [(mapping (mut OhmAstMapping))
                                 (rule-index i64)
                                 (name (slice u8))
                                 (kind i64)
                                 (value i64)
                                 (text-value (slice u8))
                                 (boolean-value bool)
                                 (number-value f64)] (-> i64)
  (let [rule (get (.rules mapping) rule-index)
        expected (+ (.property-start rule) (.property-count rule))]
    (if (or (!= rule-index (- (len (.rules mapping)) 1))
            (!= expected (len (.properties mapping))))
        (to-ast-abort "toAST template properties must be added before the next rule")
        0)
    (let [(mut property) (primitive/zeroed OhmAstPropertyMapping)
          (mut updated) (primitive/zeroed OhmAstRuleMapping)]
      (set! (.name updated) (.name rule))
      (set! (.kind updated) (.kind rule))
      (set! (.value updated) (.value rule))
      (set! (.property-start updated) (.property-start rule))
      (set! (.property-count updated) (.property-count rule))
      (set! (.name property) name)
      (set! (.kind property) kind)
      (set! (.value property) value)
      (set! (.text property) text-value)
      (set! (.boolean property) boolean-value)
      (set! (.number property) number-value)
      (push! (mut (.properties mapping)) (load property))
      (set! (.property-count updated) (+ (.property-count updated) 1))
      (set! (mut (.rules mapping)) rule-index (load updated))
      (- (.property-count updated) 1))))

(defn ast-mapping-add-child! [(mapping (mut OhmAstMapping))
                              (rule i64)
                              (name (slice u8))
                              (child i64)] (-> i64)
  (ast-mapping-add-property! (mut mapping) rule name 0 child "" false 0.0))
(defn ast-mapping-add-string! [(mapping (mut OhmAstMapping))
                               (rule i64)
                               (name (slice u8))
                               (value (slice u8))] (-> i64)
  (ast-mapping-add-property! (mut mapping) rule name 1 0 value false 0.0))
(defn ast-mapping-add-bool! [(mapping (mut OhmAstMapping))
                             (rule i64)
                             (name (slice u8))
                             (value bool)] (-> i64)
  (ast-mapping-add-property! (mut mapping) rule name 2 0 "" value 0.0))
(defn ast-mapping-add-null! [(mapping (mut OhmAstMapping))
                             (rule i64)
                             (name (slice u8))] (-> i64)
  (ast-mapping-add-property! (mut mapping) rule name 3 0 "" false 0.0))
(defn ast-mapping-add-number! [(mapping (mut OhmAstMapping))
                               (rule i64)
                               (name (slice u8))
                               (value f64)] (-> i64)
  (ast-mapping-add-property! (mut mapping) rule name 4 0 "" false value))
(defn ast-mapping-add-omit! [(mapping (mut OhmAstMapping))
                             (rule i64)
                             (name (slice u8))] (-> i64)
  (ast-mapping-add-property! (mut mapping) rule name 5 0 "" false 0.0))
(defn ast-mapping-add-property-action! [(mapping (mut OhmAstMapping))
                                        (rule i64)
                                        (name (slice u8))
                                        (action-id i64)] (-> i64)
  (ast-mapping-add-property! (mut mapping) rule name 6 action-id "" false 0.0))

(defn free-ohm-ast-mapping! [(mapping (mut OhmAstMapping))] (-> i64)
  (al/al-free! (mut (.rules mapping)))
  (al/al-free! (mut (.properties mapping)))
  0)

(defn ast-rule-is-list-wrapper? [(name (slice u8))] (-> bool)
  (or (str/str-eq name "listOf") (str/str-eq name "ListOf")))
(defn ast-rule-is-empty-list? [(name (slice u8))] (-> bool)
  (or (str/str-eq name "emptyListOf") (str/str-eq name "EmptyListOf")))
(defn ast-rule-is-nonempty-list? [(name (slice u8))] (-> bool)
  (or (str/str-eq name "nonemptyListOf") (str/str-eq name "NonemptyListOf")))

(defn ast-template-has-type? [(mapping (ptr OhmAstMapping))
                              (rule OhmAstRuleMapping)] (-> bool)
  (let [(mut found) false]
    (for [index 0 (.property-count rule)]
      (let [property (get (.properties mapping) (+ (.property-start rule) index))]
        (if (str/str-eq (.name property) "type") (set! found true) 0)))
    (load found)))

(defn ast-add-default-object! [(ast (mut OhmAst))
                               (result (ptr MatchResult))
                               (cst-node i64)
                               (children (slice i64))] (-> i64)
  (let [object (ast-add-object! (mut ast))
        _ (ast-add-entry! (mut ast)
                          object
                          "type"
                          (ast-add-string! (mut ast) (node-rule (load result) cst-node)))]
    (for [index 0 (slice-len children)]
      (let [child (node-child (load result) cst-node index)]
        (if (not (node-terminal? (load result) child))
            (let [(mut key) (str/sb-new (.allocator ast))]
              (str/sb-push-i64! (mut key) index)
              (let [key-text (str/sb-finish! (mut key))]
                (ast-add-entry! (mut ast)
                                object
                                key-text
                                (slice-get children index))
                (alloc/free [u8] (.allocator ast) key-text)))
            0)))
    object))

(defn ast-add-template-object! [(actions (dyn OhmToAstAction))
                                (ast (mut OhmAst))
                                (mapping (ptr OhmAstMapping))
                                (rule OhmAstRuleMapping)
                                (result (ptr MatchResult))
                                (cst-node i64)
                                (children (slice i64))] (-> i64)
  (let [(mut names) (al/al-new [(slice u8)] (.allocator ast))
        (mut values) (al/al-new [i64] (.allocator ast))]
    (if (not (ast-template-has-type? mapping rule))
        (do
          (push! (mut names) "type")
          (push! [i64]
                 (mut values)
                 (ast-add-string! (mut ast) (node-rule (load result) cst-node))))
        0)
    (for [index 0 (.property-count rule)]
      (let [property (get (.properties mapping) (+ (.property-start rule) index))]
        (if (= (.kind property) 5)
            0
            (let [value
                    (cond (= (.kind property) 0)
                            (if (or (< (.value property) 0)
                                    (>= (.value property) (slice-len children)))
                                -1
                                (slice-get children (.value property)))
                          (= (.kind property) 1) (ast-add-string! (mut ast) (.text property))
                          (= (.kind property) 2) (ast-add-bool! (mut ast) (.boolean property))
                          (= (.kind property) 3) (ast-add-null! (mut ast))
                          (= (.kind property) 4) (ast-add-number! (mut ast) (.number property))
                          (= (.kind property) 6)
                            (to-ast-property-action actions
                                                    (mut ast)
                                                    result
                                                    cst-node
                                                    children
                                                    (.value property))
                          :else -1)]
              (if (< value 0)
                  (do
                    (set! (.valid ast) false)
                    (set! (.error-message ast) "Invalid toAST property mapping"))
                  (do
                    (push! (mut names) (.name property))
                    (push! [i64] (mut values) value)))))))
    (let [object (ast-add-object! (mut ast))]
      (for [index 0 (len (load values))]
        (ast-add-entry! (mut ast)
                        object
                        (get (load names) index)
                        (get (load values) index)))
      (al/al-free! (mut names))
      (al/al-free! (mut values))
      object)))

(defn ast-convert-node! [(actions (dyn OhmToAstAction))
                         (ast (mut OhmAst))
                         (mapping (ptr OhmAstMapping))
                         (result (ptr MatchResult))
                         (cst-node i64)
                         (values (slice i64))] (-> i64)
  (let [child-count (node-child-count (load result) cst-node)
        (mut children) (al/al-new [i64] (.allocator ast))]
    (for [index 0 child-count]
      (push! (mut children)
             (slice-get values (node-child (load result) cst-node index))))
    (let [child-values (al/al-slice [i64] (load children))
          name (node-rule (load result) cst-node)
          mapping-index (ast-mapping-rule-index mapping name)
          answer
            (cond (node-terminal? (load result) cst-node)
                    (ast-add-string! (mut ast) (node-source-string (load result) cst-node))
                  (node-iteration? (load result) cst-node)
                    (if (node-optional? (load result) cst-node)
                        (if (= child-count 0)
                            (ast-add-null! (mut ast))
                            (slice-get child-values 0))
                        (let [array (ast-add-array! (mut ast))]
                          (for child
                            (iter child-values)
                            (ast-add-element! (mut ast) array child))
                          array))
                  (>= mapping-index 0)
                    (let [rule (get (.rules mapping) mapping-index)]
                      (cond (= (.kind rule) 1)
                              (if (or (< (.value rule) 0) (>= (.value rule) child-count))
                                  -1
                                  (slice-get child-values (.value rule)))
                            (= (.kind rule) 2)
                              (to-ast-rule-action actions
                                                  (mut ast)
                                                  result
                                                  cst-node
                                                  child-values
                                                  (.value rule))
                            :else
                              (ast-add-template-object! actions
                                                        (mut ast)
                                                        mapping
                                                        rule
                                                        result
                                                        cst-node
                                                        child-values)))
                  (ast-rule-is-list-wrapper? name)
                    (if (= child-count 0) (ast-add-array! (mut ast)) (slice-get child-values 0))
                  (ast-rule-is-empty-list? name) (ast-add-array! (mut ast))
                  (ast-rule-is-nonempty-list? name)
                    (let [array (ast-add-array! (mut ast))]
                      (if (> child-count 0)
                          (ast-add-element! (mut ast) array (slice-get child-values 0))
                          0)
                      (if (> child-count 2)
                          (let [rest (slice-get child-values 2)]
                            (for [index 0 (ast-child-count ast rest)]
                              (ast-add-element! (mut ast) array (ast-child ast rest index))))
                          0)
                      array)
                  (node-lexical? (load result) cst-node)
                    (ast-add-string! (mut ast) (node-source-string (load result) cst-node))
                  :else
                    (let [(mut real-count) 0 (mut real-value) -1]
                      (for [index 0 child-count]
                        (let [child (node-child (load result) cst-node index)]
                          (if (not (node-terminal? (load result) child))
                              (do
                                (set! real-count (+ (load real-count) 1))
                                (set! real-value (slice-get child-values index)))
                              0)))
                      (if (= (load real-count) 1)
                          (load real-value)
                          (ast-add-default-object! (mut ast)
                                                   result
                                                   cst-node
                                                   child-values))))]
      (if (< answer 0)
          (do
            (set! (.valid ast) false)
            (set! (.error-message ast) "Invalid toAST rule mapping"))
          0)
      (al/al-free! (mut children))
      answer)))

(defn to-ast-with-actions [(actions (dyn OhmToAstAction))
                           (result (ptr MatchResult))
                           (mapping (ptr OhmAstMapping))
                           (a (dyn alloc/Allocator))] (-> OhmAst)
  (let [(mut ast) (new-ohm-ast a)]
    (if (not (match-succeeded? (load result)))
        (do
          (set! (.valid ast) false)
          (set! (.error-message ast)
                "toAST() expects a succesful MatchResult as first parameter"))
        (let [(mut values) (al/al-new [i64] a)]
          (for [cst-node 0 (len (.nodes result))]
            (push! [i64] (mut values)
                   (ast-convert-node! actions
                                      (mut ast)
                                      mapping
                                      result
                                      cst-node
                                      (al/al-slice [i64] (load values)))))
          (if (.valid ast)
              (set! (.root ast) (get (load values) (.root result)))
              0)
          (al/al-free! (mut values))))
    (load ast)))

(defn to-ast [(result (ptr MatchResult))
              (mapping (ptr OhmAstMapping))
              (a (dyn alloc/Allocator))] (-> OhmAst)
  (let [actions (primitive/alloc-stack NoToAstActions)]
    (store! actions (primitive/zeroed NoToAstActions))
    (to-ast-with-actions actions result mapping a)))

(defn new-to-ast-semantics [(grammar-name (slice u8))
                            (grammar-token (ptr u8))] (-> OhmToAstSemantics)
  (let [(mut semantics) (primitive/zeroed OhmToAstSemantics)]
    (set! (.grammar-name semantics) grammar-name)
    (set! (.grammar-token semantics) grammar-token)
    (load semantics)))

(defn to-ast-semantics-operation-count [(semantics (ptr OhmToAstSemantics))] (-> i64) 1)
(defn to-ast-semantics-operation-name [(semantics (ptr OhmToAstSemantics))] (-> (slice u8))
  "toAST")
(defn to-ast-semantics-formal-count [(semantics (ptr OhmToAstSemantics))] (-> i64) 1)
(defn to-ast-semantics-apply [(semantics (ptr OhmToAstSemantics))
                              (result (ptr MatchResult))
                              (mapping (ptr OhmAstMapping))
                              (a (dyn alloc/Allocator))] (-> OhmAst)
  (if (match-grammar-compatible? (load result)
                                 (.grammar-name semantics)
                                 (.grammar-token semantics))
      (to-ast result mapping a)
      (let [(mut ast) (new-ohm-ast a)]
        (set! (.valid ast) false)
        (set! (.error-message ast) "Cannot use a MatchResult from an incompatible grammar")
        (load ast))))

(defn ohm-grammar-semantics-for-to-ast [(grammar (ptr OhmGrammar))]
                                       (-> OhmToAstSemantics)
  (new-to-ast-semantics (ohm-grammar-name grammar) (.token grammar)))

(defn ast-string-eq? [(ast (ptr OhmAst))
                      (node i64)
                      (expected (slice u8))] (-> bool)
  (and (>= node 0)
       (and (= (ast-kind ast node) 1)
            (str/str-eq (ast-string ast node) expected))))

(defn ast-property-string-eq? [(ast (ptr OhmAst))
                               (node i64)
                               (name (slice u8))
                               (expected (slice u8))] (-> bool)
  (ast-string-eq? ast (ast-property ast node name) expected))

(defstruct UpstreamToAstTestActions [])

(impl OhmToAstAction UpstreamToAstTestActions
  (to-ast-rule-action [(self (ptr UpstreamToAstTestActions))
                       (ast (mut OhmAst))
                       (result (ptr MatchResult))
                       (cst-node i64)
                       (children (slice i64))
                       (action-id i64)] (-> i64)
    (cond (= action-id 1)
            (let [(mut builder) (str/sb-new (.allocator ast))]
              (str/sb-push-str! (mut builder) "plus(")
              (str/sb-push-str! (mut builder) (ast-string ast (slice-get children 0)))
              (str/sb-push-str! (mut builder) ", ")
              (str/sb-push-str! (mut builder) (ast-string ast (slice-get children 2)))
              (str/sb-push-str! (mut builder) ")")
              (let [temporary (str/sb-finish! (mut builder))
                    value (ast-add-string! (mut ast) temporary)]
                (alloc/free [u8] (.allocator ast) temporary)
                value))
          (= action-id 3) (ast-add-string! (mut ast) "XX")
          (= action-id 4) (ast-add-string! (mut ast) "nix")
          :else -1))
  (to-ast-property-action [(self (ptr UpstreamToAstTestActions))
                           (ast (mut OhmAst))
                           (result (ptr MatchResult))
                           (cst-node i64)
                           (children (slice i64))
                           (action-id i64)] (-> i64)
    (if (= action-id 2)
        (let [(mut builder) (str/sb-new (.allocator ast))]
          (for child
            (iter children)
            (str/sb-push-str! (mut builder) (ast-string ast child)))
          (let [temporary (str/sb-finish! (mut builder))
                value (ast-add-string! (mut ast) temporary)]
            (alloc/free [u8] (.allocator ast) temporary)
            value))
        -1)))

;; Differential gates translated from packages/ohm-js/test/extras/test-toAST.js.
(defn to-ast-upstream-arithmetic-compatible? [(result (ptr MatchResult))] (-> bool)
  (let [(mut empty) (new-ohm-ast-mapping (.allocator result))
        (mut default-ast) (to-ast result (mut empty) (.allocator result))
        default-root (ast-root (mut default-ast))
        default-valid
          (and (ast-valid? (mut default-ast))
               (and (= (ast-kind (mut default-ast) default-root) 4)
                    (and (ast-property-string-eq? (mut default-ast)
                                                  default-root
                                                  "type"
                                                  "AddExp_plus")
                         (and (ast-property-string-eq? (mut default-ast)
                                                       default-root
                                                       "0"
                                                       "10")
                              (ast-property-string-eq? (mut default-ast)
                                                       default-root
                                                       "2"
                                                       "20")))))
        (mut mapped) (new-ohm-ast-mapping (.allocator result))
        template (ast-mapping-add-template! (mut mapped) "AddExp_plus")
        _ (ast-mapping-add-child! (mut mapped) template "expr1" 0)
        _ (ast-mapping-add-child! (mut mapped) template "op" 1)
        _ (ast-mapping-add-child! (mut mapped) template "expr2" 2)
        _ (ast-mapping-add-string! (mut mapped) template "type" "Expression")
        _ (ast-mapping-add-bool! (mut mapped) template "flag" true)
        _ (ast-mapping-add-null! (mut mapped) template "nothing")
        _ (ast-mapping-add-number! (mut mapped) template "answer" 42.0)
        (mut mapped-ast) (to-ast result (mut mapped) (.allocator result))
        mapped-root (ast-root (mut mapped-ast))
        mapped-valid
          (and (ast-valid? (mut mapped-ast))
               (and (ast-property-string-eq? (mut mapped-ast)
                                             mapped-root
                                             "type"
                                             "Expression")
                    (and (ast-property-string-eq? (mut mapped-ast)
                                                  mapped-root
                                                  "expr1"
                                                  "10")
                         (and (ast-property-string-eq? (mut mapped-ast)
                                                       mapped-root
                                                       "op"
                                                       "+")
                              (and (ast-property-string-eq? (mut mapped-ast)
                                                            mapped-root
                                                            "expr2"
                                                            "20")
                                   (and (ast-bool (mut mapped-ast)
                                                  (ast-property (mut mapped-ast)
                                                                mapped-root
                                                                "flag"))
                                        (and (= (ast-kind (mut mapped-ast)
                                                          (ast-property (mut mapped-ast)
                                                                        mapped-root
                                                                        "nothing"))
                                                0)
                                             (let [answer-number
                                                     (ast-number (mut mapped-ast)
                                                                 (ast-property (mut mapped-ast)
                                                                               mapped-root
                                                                               "answer"))]
                                               (and (>= answer-number 42.0)
                                                    (<= answer-number 42.0))))))))))
        (mut forwarded) (new-ohm-ast-mapping (.allocator result))
        _ (ast-mapping-add-forward! (mut forwarded) "AddExp_plus" 2)
        (mut forwarded-ast) (to-ast result (mut forwarded) (.allocator result))
        forwarded-valid
          (ast-string-eq? (mut forwarded-ast) (ast-root (mut forwarded-ast)) "20")
        (mut omitted) (new-ohm-ast-mapping (.allocator result))
        omitted-template (ast-mapping-add-template! (mut omitted) "AddExp_plus")
        _ (ast-mapping-add-child! (mut omitted) omitted-template "0" 0)
        _ (ast-mapping-add-omit! (mut omitted) omitted-template "type")
        (mut omitted-ast) (to-ast result (mut omitted) (.allocator result))
        omitted-root (ast-root (mut omitted-ast))
        omitted-valid
          (and (= (ast-property-index (mut omitted-ast) omitted-root "type") -1)
               (ast-property-string-eq? (mut omitted-ast) omitted-root "0" "10"))
        answer (and default-valid (and mapped-valid (and forwarded-valid omitted-valid)))]
    (free-ohm-ast! (mut default-ast))
    (free-ohm-ast-mapping! (mut empty))
    (free-ohm-ast! (mut mapped-ast))
    (free-ohm-ast-mapping! (mut mapped))
    (free-ohm-ast! (mut forwarded-ast))
    (free-ohm-ast-mapping! (mut forwarded))
    (free-ohm-ast! (mut omitted-ast))
    (free-ohm-ast-mapping! (mut omitted))
    answer))

(defn to-ast-upstream-actions-compatible? [(result (ptr MatchResult))] (-> bool)
  (let [actions (primitive/alloc-stack UpstreamToAstTestActions)
        _ (store! actions (primitive/zeroed UpstreamToAstTestActions))
        (mut rule-mapping) (new-ohm-ast-mapping (.allocator result))
        _ (ast-mapping-add-action! (mut rule-mapping) "AddExp_plus" 1)
        (mut rule-ast)
          (to-ast-with-actions actions
                               result
                               (mut rule-mapping)
                               (.allocator result))
        rule-valid (ast-string-eq? (mut rule-ast) (ast-root (mut rule-ast)) "plus(10, 20)")
        (mut property-mapping) (new-ohm-ast-mapping (.allocator result))
        template (ast-mapping-add-template! (mut property-mapping) "AddExp_plus")
        _ (ast-mapping-add-child! (mut property-mapping) template "expr1" 0)
        _ (ast-mapping-add-child! (mut property-mapping) template "expr2" 2)
        _ (ast-mapping-add-property-action! (mut property-mapping) template "str" 2)
        (mut property-ast)
          (to-ast-with-actions actions
                               result
                               (mut property-mapping)
                               (.allocator result))
        property-valid
          (ast-property-string-eq? (mut property-ast)
                                   (ast-root (mut property-ast))
                                   "str"
                                   "10+20")]
    (free-ohm-ast! (mut rule-ast))
    (free-ohm-ast-mapping! (mut rule-mapping))
    (free-ohm-ast! (mut property-ast))
    (free-ohm-ast-mapping! (mut property-mapping))
    (and rule-valid property-valid)))

(defn to-ast-upstream-combinations-compatible? [(result (ptr MatchResult))] (-> bool)
  (let [(mut mapping) (new-ohm-ast-mapping (.allocator result))
        plus (ast-mapping-add-template! (mut mapping) "AddExp_plus")
        _ (ast-mapping-add-child! (mut mapping) plus "augend" 0)
        _ (ast-mapping-add-child! (mut mapping) plus "addend" 2)
        _ (ast-mapping-add-string! (mut mapping) plus "type" "AddExpression")
        minus (ast-mapping-add-template! (mut mapping) "AddExp_minus")
        _ (ast-mapping-add-child! (mut mapping) minus "minuend" 0)
        _ (ast-mapping-add-child! (mut mapping) minus "subtrahend" 2)
        _ (ast-mapping-add-string! (mut mapping) minus "type" "SubExpression")
        (mut ast) (to-ast result (mut mapping) (.allocator result))
        root (ast-root (mut ast))
        minuend (ast-property (mut ast) root "minuend")
        valid
          (and (ast-property-string-eq? (mut ast) root "type" "SubExpression")
               (and (ast-property-string-eq? (mut ast) root "subtrahend" "30")
                    (and (ast-property-string-eq? (mut ast)
                                                  minuend
                                                  "type"
                                                  "AddExpression")
                         (and (ast-property-string-eq? (mut ast) minuend "augend" "10")
                              (ast-property-string-eq? (mut ast)
                                                       minuend
                                                       "addend"
                                                       "20")))))
        (mut reintroduced) (new-ohm-ast-mapping (.allocator result))
        exp (ast-mapping-add-template! (mut reintroduced) "Exp")
        _ (ast-mapping-add-child! (mut reintroduced) exp "0" 0)
        (mut reintroduced-ast)
          (to-ast result (mut reintroduced) (.allocator result))
        reintroduced-root (ast-root (mut reintroduced-ast))
        reintroduced-valid
          (and (ast-property-string-eq? (mut reintroduced-ast)
                                        reintroduced-root
                                        "type"
                                        "Exp")
               (= (ast-kind (mut reintroduced-ast)
                            (ast-property (mut reintroduced-ast)
                                          reintroduced-root
                                          "0"))
                  4))]
    (free-ohm-ast! (mut ast))
    (free-ohm-ast-mapping! (mut mapping))
    (free-ohm-ast! (mut reintroduced-ast))
    (free-ohm-ast-mapping! (mut reintroduced))
    (and valid reintroduced-valid)))

(defn to-ast-upstream-list-compatible? [(result (ptr MatchResult))] (-> bool)
  (let [(mut mapping) (new-ohm-ast-mapping (.allocator result))
        (mut ast) (to-ast result (mut mapping) (.allocator result))
        root (ast-root (mut ast))
        default-valid
          (and (ast-valid? (mut ast))
               (and (= (ast-kind (mut ast) root) 5)
                    (if (= (slice-len (.source result)) 0)
                        (= (ast-child-count (mut ast) root) 0)
                        (and (= (ast-child-count (mut ast) root) 2)
                             (and (ast-string-eq? (mut ast)
                                                  (ast-child (mut ast) root 0)
                                                  "3")
                                  (ast-string-eq? (mut ast)
                                                  (ast-child (mut ast) root 1)
                                                  "5"))))))
        actions (primitive/alloc-stack UpstreamToAstTestActions)
        _ (store! actions (primitive/zeroed UpstreamToAstTestActions))
        (mut override-mapping) (new-ohm-ast-mapping (.allocator result))
        syntactic-list (or (match-has-rule? (load result) "NonemptyListOf")
                           (match-has-rule? (load result) "EmptyListOf"))
        _ (if (= (slice-len (.source result)) 0)
              (ast-mapping-add-action! (mut override-mapping)
                                       (if syntactic-list "EmptyListOf" "emptyListOf")
                                       4)
              (ast-mapping-add-action! (mut override-mapping)
                                       (if syntactic-list "NonemptyListOf" "nonemptyListOf")
                                       3))
        (mut override-ast)
          (to-ast-with-actions actions
                               result
                               (mut override-mapping)
                               (.allocator result))
        override-valid
          (ast-string-eq? (mut override-ast)
                          (ast-root (mut override-ast))
                          (if (= (slice-len (.source result)) 0) "nix" "XX"))]
    (free-ohm-ast! (mut ast))
    (free-ohm-ast-mapping! (mut mapping))
    (free-ohm-ast! (mut override-ast))
    (free-ohm-ast-mapping! (mut override-mapping))
    (and default-valid override-valid)))

(defn to-ast-upstream-optional-compatible? [(result (ptr MatchResult))] (-> bool)
  (let [(mut mapping) (new-ohm-ast-mapping (.allocator result))
        (mut ast) (to-ast result (mut mapping) (.allocator result))
        root (ast-root (mut ast))
        first-list (ast-property (mut ast) root "1")
        optional (ast-property (mut ast) root "3")
        second-list (ast-property (mut ast) root "4")
        valid
          (and (ast-valid? (mut ast))
               (and (ast-property-string-eq? (mut ast) root "type" "Mix")
                    (and (ast-property-string-eq? (mut ast) root "0" "a")
                         (and (= (ast-kind (mut ast) first-list) 5)
                              (and (= (ast-child-count (mut ast) first-list) 0)
                                   (and (= (ast-kind (mut ast) optional) 0)
                                        (and (= (ast-kind (mut ast) second-list) 5)
                                             (and (= (ast-child-count (mut ast) second-list) 2)
                                                  (and (ast-string-eq? (mut ast)
                                                                       (ast-child (mut ast)
                                                                                  second-list
                                                                                  0)
                                                                       "b")
                                                       (ast-string-eq? (mut ast)
                                                                       (ast-child (mut ast)
                                                                                  second-list
                                                                                  1)
                                                                       "b"))))))))))]
    (free-ohm-ast! (mut ast))
    (free-ohm-ast-mapping! (mut mapping))
    valid))

(defn to-ast-upstream-failure-compatible? [(result (ptr MatchResult))] (-> bool)
  (let [(mut mapping) (new-ohm-ast-mapping (.allocator result))
        (mut ast) (to-ast result (mut mapping) (.allocator result))
        valid
          (and (not (ast-valid? (mut ast)))
               (str/str-eq (ast-error-message (mut ast))
                           "toAST() expects a succesful MatchResult as first parameter"))]
    (free-ohm-ast! (mut ast))
    (free-ohm-ast-mapping! (mut mapping))
    valid))

(defn compute-semantic-attribute [(Action OhmSemanticAction)] [(action Action)
                                                               (result (ptr MatchResult))] (-> SemanticAttribute)
  (let [(mut values) (al/al-new [i64] (.allocator result))]
    ;; CST construction is postorder: a parent is appended only after all of
    ;; its children. Evaluating arena order therefore gives every child value
    ;; before its parent without recursion or an auxiliary node stack.
    (for [node 0 (len (.nodes result))]
      (let [(mut child-values) (al/al-new [i64] (.allocator result))
            child-count (node-child-count (load result) node)]
        (for [index 0 child-count]
          (push! [i64]
                 (mut child-values)
                 (get (load values) (node-child (load result) node index))))
        (push! [i64]
               (mut values)
               (apply-semantic-node action
                                    result
                                    node
                                    (al/al-slice [i64] (load child-values))))
        (al/al-free! (mut child-values))))
    (let [(mut attribute) (primitive/zeroed SemanticAttribute)]
      (set! (.values attribute) (load values))
      (set! (.root attribute) (.root result))
      (load attribute))))

(defn semantic-attribute-value [(attribute (ptr SemanticAttribute)) (node i64)] (-> i64)
  (get (.values attribute) node))

(defn semantic-attribute-root-value [(attribute (ptr SemanticAttribute))] (-> i64)
  (semantic-attribute-value attribute (.root attribute)))

(defn free-semantic-attribute! [(attribute (mut SemanticAttribute))] (-> i64)
  (al/al-free! (mut (.values attribute)))
  0)

(defn evaluate-semantics [(Action OhmSemanticAction)] [(action Action)
                                                       (result (ptr MatchResult))] (-> i64)
  (let [(mut values) (al/al-new [i64] (.allocator result))]
    (for [node 0 (len (.nodes result))]
      (let [(mut child-values) (al/al-new [i64] (.allocator result))
            child-count (node-child-count (load result) node)]
        (for [index 0 child-count]
          (push! [i64]
                 (mut child-values)
                 (get (load values) (node-child (load result) node index))))
        (push! [i64]
               (mut values)
               (apply-semantic-node action
                                    result
                                    node
                                    (al/al-slice [i64] (load child-values))))
        (al/al-free! (mut child-values))))
    (let [value (get (load values) (.root result))]
      (al/al-free! (mut values))
      value)))

(defn match-root-iteration-shape? [(result MatchResult)
                                   (columns i64)
                                   (rows i64)
                                   (optional bool)] (-> bool)
  (let [root (match-root result)
        (mut valid) (and (>= root 0) (= (node-child-count result root) columns))]
    (for [column 0 columns]
      (if (load valid)
          (let [child (node-child result root column)]
            (if (or (< child 0)
                    (not (str/str-eq (node-rule result child) "_iter"))
                    (not (= (node-child-count result child) rows))
                    (not (= (node-optional? result child) optional)))
                (set! valid false)
                0))
          0))
    (load valid)))

(defn match-has-rule? [(result MatchResult) (wanted (slice u8))] (-> bool)
  (let [(mut index) 0
        (mut found) false]
    (loop (if (or (load found) (>= (load index) (len (.nodes result))))
              (break)
              (do
                (if (str/str-eq (node-rule result (load index)) wanted)
                    (set! found true)
                    0)
                (set! index (+ (load index) 1)))))
    (load found)))

(defn match-rule-id-at [(result MatchResult)
                        (wanted (slice u8))
                        (start i64)] (-> i64)
  (let [(mut answer) -1 (mut index) 0]
    (loop (if (or (>= (load index) (len (.nodes result))) (>= (load answer) 0))
              (break)
              (let [node (match-node result (load index))]
                (if (and (= (.start node) start) (str/str-eq (.rule node) wanted))
                    (set! answer (.id node))
                    (set! index (+ (load index) 1))))))
    (load answer)))

(defn match-tree-valid? [(result MatchResult)] (-> bool)
  (let [count (len (.nodes result))
        (mut index) 0
        (mut valid) (and (>= (.root result) 0) (< (.root result) count))]
    (loop (if (or (not (load valid)) (>= (load index) count))
              (break)
              (let [node (match-node result (load index))
                    (mut child) (.first-child node)
                    (mut previous) -1
                    (mut visited) 0]
                (if (or (<= (.id node) 0)
                        (or (< (.start node) 0) (< (.end node) (.start node))))
                    (set! valid false)
                    0)
                (loop (if (or (not (load valid)) (< (load child) 0))
                          (break)
                          (if (or (>= (load child) count) (>= (load visited) count))
                              (set! valid false)
                              (let [child-node (match-node result (load child))]
                                ;; Positive lookahead retains bindings in Ohm. A binding
                                ;; produced at the end of its parent can therefore examine
                                ;; and span input beyond the parent's consumed interval.
                                (if (< (.start child-node) (.start node))
                                    (set! valid false)
                                    0)
                                (set! previous (load child))
                                (set! child (.next-sibling child-node))
                                (set! visited (+ (load visited) 1))))))
                (if (and (load valid) (!= (load previous) (.last-child node)))
                    (set! valid false)
                    0)
                (set! index (+ (load index) 1)))))
    (load valid)))

(defn free-match! [(result (mut MatchResult))] (-> i64)
  (if (and (.owns-matcher result)
           (!= (primitive/cast i64 (.matcher result)) 0))
      (let [matcher (primitive/cast (ptr OhmMatcher) (.matcher result))
            a (.allocator matcher)]
        (free-ohm-matcher! matcher)
        (alloc/free [OhmMatcher] a (alloc/alloc-slice-new matcher 1))
        (set! (.matcher result) (primitive/cast (ptr u8) 0))
        (set! (.owns-matcher result) false))
      0)
  (for name
    (iter (.owned-names result))
    (alloc/free [u8] (.allocator result) name))
  (al/al-free! (mut (.owned-names result)))
  (al/al-free! (mut (.grammar-names result)))
  (al/al-free! (mut (.semantic-rules result)))
  (al/al-free! (mut (.failures result)))
  (al/al-free! (mut (.trace-events result)))
  (al/al-free! (mut (.trace-nodes result)))
  (al/al-free! (mut (.nodes result))))

(defn byte-at [(source (slice u8)) (at i64)] (-> i64)
  (if (or (< at 0) (>= at (slice-len source)))
      -1
      (primitive/cast i64 (slice-get source at))))

(defn source-length [(source (slice u8))] (-> i64) (slice-len source))

(defn utf8-continuation? [(value i64)] (-> bool)
  (and (>= value 128) (<= value 191)))

(defn decode-utf8 [(source (slice u8)) (at i64)] (-> Utf8Scalar)
  (let [(mut result) (primitive/zeroed Utf8Scalar)
        b0 (byte-at source at)]
    (cond (< b0 0) 0
          (< b0 128)
            (do
              (set! (.value result) b0)
              (set! (.width result) 1)
              (set! (.valid result) true))
          (and (>= b0 194) (<= b0 223))
            (let [b1 (byte-at source (+ at 1))]
              (if (utf8-continuation? b1)
                  (do
                    (set! (.value result) (+ (* (- b0 192) 64) (- b1 128)))
                    (set! (.width result) 2)
                    (set! (.valid result) true))
                  0))
          (and (>= b0 224) (<= b0 239))
            (let [b1 (byte-at source (+ at 1))
                  b2 (byte-at source (+ at 2))]
              (if (and (utf8-continuation? b1)
                       (utf8-continuation? b2)
                       (or (!= b0 224) (>= b1 160)))
                  (do
                    (set! (.value result)
                          (+ (* (- b0 224) 4096)
                             (+ (* (- b1 128) 64)
                                (- b2 128))))
                    (set! (.width result) 3)
                    (set! (.valid result) true))
                  0))
          (and (>= b0 240) (<= b0 244))
            (let [b1 (byte-at source (+ at 1))
                  b2 (byte-at source (+ at 2))
                  b3 (byte-at source (+ at 3))]
              (if (and (utf8-continuation? b1)
                       (utf8-continuation? b2)
                       (utf8-continuation? b3)
                       (or (!= b0 240) (>= b1 144))
                       (or (!= b0 244) (<= b1 143)))
                  (do
                    (set! (.value result)
                          (+ (* (- b0 240) 262144)
                             (+ (* (- b1 128) 4096)
                                (+ (* (- b2 128) 64)
                                   (- b3 128)))))
                    (set! (.width result) 4)
                    (set! (.valid result) true))
                  0))
          :else 0)
    (load result)))

(defn match-space [(source (slice u8)) (at i64)] (-> i64)
  (let [scalar (decode-utf8 source at)]
    (if (and (.valid scalar) (>= (.value scalar) 0) (<= (.value scalar) 32))
        (+ at (.width scalar))
        -1)))

(defn skip-block-comment [(source (slice u8)) (at i64)] (-> i64)
  (let [(mut p) (+ at 2)
        (mut done) false]
    (loop (if (or (load done) (>= (+ (load p) 1) (slice-len source)))
              (break)
              (if (and (= (byte-at source (load p)) 42)
                       (= (byte-at source (+ (load p) 1)) 47))
                  (do (store! p (+ (load p) 2)) (store! done true) 0)
                  (store! p (+ (load p) 1)))))
    (if (load done) (load p) -1)))

;; Ohm's syntactic rules implicitly consume `spaces`.  The canonical grammar
;; extends `space` with C-style comments, so the bootstrap runtime recognizes
;; those comments as part of spacing as well.
(defn skip-spaces [(source (slice u8)) (at i64)] (-> i64)
  (let [(mut p) at
        (mut moving) true]
    (loop (if (not (load moving))
              (break)
              (let [c (byte-at source (load p))
                    next-space (match-space source (load p))]
                (cond (>= next-space 0) (store! p next-space)
                      (and (= c 47) (= (byte-at source (+ (load p) 1)) 47))
                        (do
                          (store! p (+ (load p) 2))
                          (loop (if (or (< (byte-at source (load p)) 0)
                                        (= (byte-at source (load p)) 10))
                                    (break)
                                    (store! p (+ (load p) 1)))))
                      (and (= c 47) (= (byte-at source (+ (load p) 1)) 42))
                        (let [next (skip-block-comment source (load p))]
                          (if (< next 0) (store! moving false) (store! p next)))
                      :else (store! moving false)))))
    (load p)))

(defn match-literal [(source (slice u8)) (at i64) (literal (slice u8))] (-> i64)
  (let [n (slice-len literal)
        (mut i) 0
        (mut ok) true]
    (loop (if (or (not (load ok)) (>= (load i) n))
              (break)
              (if (= (byte-at source (+ at (load i)))
                     (primitive/cast i64 (slice-get literal (load i))))
                  (store! i (+ (load i) 1))
                  (store! ok false))))
    (if (load ok) (+ at n) -1)))

(defn match-case-insensitive-literal [(source (slice u8))
                                      (at i64)
                                      (literal (slice u8))] (-> i64)
  (let [(mut source-at) at
        (mut literal-at) 0
        (mut ok) true]
    (loop (if (or (not (load ok)) (>= (load literal-at) (slice-len literal)))
              (break)
              (let [actual (decode-utf8 source (load source-at))
                    expected (decode-utf8 literal (load literal-at))]
                (if (and (.valid actual)
                         (.valid expected)
                         (unicode/unicode-case-insensitive-eq?
                           (.value actual)
                           (.value expected)))
                    (do
                      (store! source-at (+ (load source-at) (.width actual)))
                      (store! literal-at (+ (load literal-at) (.width expected))))
                    (store! ok false)))))
    (if (load ok) (load source-at) -1)))

(defn match-range [(source (slice u8)) (at i64) (lo i64) (hi i64)] (-> i64)
  (let [scalar (decode-utf8 source at)]
    (if (and (.valid scalar)
             (>= (.value scalar) lo)
             (<= (.value scalar) hi))
        (+ at (.width scalar))
        -1)))

(defn match-any [(source (slice u8)) (at i64)] (-> i64)
  (let [scalar (decode-utf8 source at)]
    (if (.valid scalar) (+ at (.width scalar)) -1)))

(defn match-end [(source (slice u8)) (at i64)] (-> i64)
  (if (= at (slice-len source)) at -1))

(defn ascii-letter? [(c i64)] (-> bool)
  (or (and (>= c 65) (<= c 90)) (and (>= c 97) (<= c 122))))

(defn match-letter [(source (slice u8)) (at i64)] (-> i64)
  (let [scalar (decode-utf8 source at)]
    (if (and (.valid scalar)
             (unicode/unicode-letter? (.value scalar)))
        (+ at (.width scalar))
        -1)))

(defn match-lower [(source (slice u8)) (at i64)] (-> i64)
  (let [scalar (decode-utf8 source at)]
    (if (and (.valid scalar)
             (unicode/unicode-lower? (.value scalar)))
        (+ at (.width scalar))
        -1)))

(defn match-upper [(source (slice u8)) (at i64)] (-> i64)
  (let [scalar (decode-utf8 source at)]
    (if (and (.valid scalar)
             (unicode/unicode-upper? (.value scalar)))
        (+ at (.width scalar))
        -1)))

(defn match-unicode-ltmo [(source (slice u8)) (at i64)] (-> i64)
  (let [scalar (decode-utf8 source at)]
    (if (and (.valid scalar)
             (unicode/unicode-ltmo? (.value scalar)))
        (+ at (.width scalar))
        -1)))

(defn match-digit [(source (slice u8)) (at i64)] (-> i64)
  (let [c (byte-at source at)] (if (and (>= c 48) (<= c 57)) (+ at 1) -1)))

(defn match-alnum [(source (slice u8)) (at i64)] (-> i64)
  (let [letter-end (match-letter source at)]
    (if (>= letter-end 0) letter-end (match-digit source at))))

(defn match-hex-digit [(source (slice u8)) (at i64)] (-> i64)
  (let [c (byte-at source at)]
    (if (or (and (>= c 48) (<= c 57))
            (and (>= c 65) (<= c 70))
            (and (>= c 97) (<= c 102)))
        (+ at 1)
        -1)))
