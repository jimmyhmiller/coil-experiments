(module experiments.ohm.generic-stored-attributes)

(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "coil.primitive" :as primitive)
(import "experiments.ohm.runtime" :as ohm)

;;; A typed stored attribute keeps Ohm's stable-CST identity semantics while
;;; allowing arbitrary Coil values rather than only integer handles.
(defstruct OhmGenericStoredAttribute [Value]
  [(node-ids (al/ArrayList i64))
   (values (al/ArrayList Value))
   (allocator (dyn alloc/Allocator))])

(defn new-generic-stored-attribute
  [Value]
  [(a (dyn alloc/Allocator))] (-> (OhmGenericStoredAttribute Value))
  (let [(mut attribute) (primitive/zeroed (OhmGenericStoredAttribute Value))]
    (set! (.node-ids attribute) (al/al-new [i64] a))
    (set! (.values attribute) (al/al-new [Value] a))
    (set! (.allocator attribute) a)
    (load attribute)))

(defn generic-stored-attribute-find
  [Value]
  [(attribute (ptr (OhmGenericStoredAttribute Value)))
   (node-id i64)] (-> i64)
  (let [(mut found) -1]
    (for [index 0 (len (.node-ids attribute))]
      (if (= (get (.node-ids attribute) index) node-id)
          (set! found index)
          0))
    (load found)))

(defn generic-stored-attribute-initialized?
  [Value]
  [(attribute (ptr (OhmGenericStoredAttribute Value)))
   (result ohm/MatchResult)
   (node i64)] (-> bool)
  (>= (generic-stored-attribute-find
        [Value] attribute (ohm/node-id result node))
      0))

(defn set-generic-stored-attribute!
  [Value]
  [(attribute (mut (OhmGenericStoredAttribute Value)))
   (result ohm/MatchResult)
   (node i64)
   (value Value)] (-> i64)
  (let [node-id (ohm/node-id result node)
        index (generic-stored-attribute-find [Value] attribute node-id)]
    (if (>= index 0)
        (set! (mut (.values attribute)) index value)
        (do
          (push! (mut (.node-ids attribute)) node-id)
          (push! (mut (.values attribute)) value)
          0))))

(defn generic-stored-attribute-value
  [Value]
  [(attribute (ptr (OhmGenericStoredAttribute Value)))
   (result ohm/MatchResult)
   (node i64)] (-> (Option Value))
  (let [index
          (generic-stored-attribute-find
            [Value] attribute (ohm/node-id result node))]
    (if (< index 0) (None) (Some (get (.values attribute) index)))))

(defn free-generic-stored-attribute!
  [Value]
  [(attribute (mut (OhmGenericStoredAttribute Value)))] (-> i64)
  (al/al-free! (mut (.node-ids attribute)))
  (al/al-free! (mut (.values attribute)))
  0)
