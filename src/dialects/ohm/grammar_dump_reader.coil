(module experiments.ohm.grammar-dump-reader)

(import "coil.primitive" :as primitive)
(import "coil.str" :as str)
(import "experiments.ohm.reader" :as ohm-reader)

(defn read-ohm-grammar-dump [(context Code)] (-> Code)
  (let [source (primitive/code-str (get context 2))
        generated (ohm-reader/read-ohm-impl context source true false)
        main-name (primitive/datum->syntax context (primitive/code-symbol "main"))
        object-name (primitive/datum->syntax context (primitive/code-symbol "grammar-object"))
        (mut output) (primitive/code-list-new)]
    (for form (iter generated)
      (if (and (primitive/code-list? form)
               (and (> (len form) 1)
                    (and (primitive/code-sym? (get form 0))
                         (and (str/str-eq (primitive/code-sym (get form 0)) "defn")
                              (and (primitive/code-sym? (get form 1))
                                   (str/str-eq (primitive/code-sym (get form 1))
                                               "main"))))))
          0
          (push! (mut output) form)))
    (push! (mut output) `(import "coil.alloc" :as alloc))
    (push! (mut output) `(import "coil.io" :as io))
    (push! (mut output) `(import "coil.str" :as str))
    (push! (mut output)
      `(defn ~main-name [] (-> i64)
         (let [(mut grammar) (~object-name)
               (mut supergrammar)
                 (experiments.ohm.runtime.ohm-grammar-supergrammar (mut grammar))
               (mut text) (coil.str.sb-new (coil.alloc.malloc-allocator))
               _ (coil.str.sb-push-str!
                   (mut text) (experiments.ohm.runtime.ohm-grammar-name (mut grammar)))
               _ (coil.str.sb-push-str! (mut text) "\n")
               _ (coil.str.sb-push-str!
                   (mut text)
                   (experiments.ohm.runtime.ohm-grammar-default-start-rule (mut grammar)))
               _ (coil.str.sb-push-str! (mut text) "\n")
               _ (coil.str.sb-push-str!
                   (mut text) (experiments.ohm.runtime.ohm-grammar-name (mut supergrammar)))
               _ (coil.str.sb-push-str! (mut text) "\n")
               _ (coil.str.sb-push-i64!
                   (mut text) (experiments.ohm.runtime.ohm-grammar-rule-count (mut grammar)))
               _ (coil.str.sb-push-str! (mut text) "\n")
               _ (coil.str.sb-push-i64!
                   (mut text)
                   (if (experiments.ohm.runtime.ohm-grammar-is-built-in? (mut grammar)) 1 0))
               _ (coil.str.sb-push-str! (mut text) "\n")
               rendered (coil.str.sb-finish! (mut text))
               status
                 (match (coil.io.print-str (coil.io.stdout) rendered)
                   (Ok [written] 0)
                   (Err [error] 1))]
           (coil.alloc.free [u8] (coil.alloc.malloc-allocator) rendered)
           (experiments.ohm.runtime.free-ohm-grammar! (mut supergrammar))
           (experiments.ohm.runtime.free-ohm-grammar! (mut grammar))
           status)))
    (primitive/code-list-done (load output))))
