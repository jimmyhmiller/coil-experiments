(module experiments.ohm.pexpr-dump-reader)

(import "coil.primitive" :as primitive)
(import "coil.str" :as str)
(import "experiments.ohm.reader" :as ohm-reader)

(defn read-ohm-pexpr-dump [(context Code)] (-> Code)
  (let [source (primitive/code-str (get context 2))
        generated (ohm-reader/read-ohm-impl context source true false)
        main-name (primitive/datum->syntax context (primitive/code-symbol "main"))
        pexprs-name (primitive/datum->syntax context (primitive/code-symbol "grammar-pexprs"))
        (mut output) (primitive/code-list-new)]
    (for form (iter generated)
      (if (and (primitive/code-list? form)
               (and (> (len form) 1)
                    (and (primitive/code-sym? (get form 0))
                         (and (str/str-eq (primitive/code-sym (get form 0)) "defn")
                              (and (primitive/code-sym? (get form 1))
                                   (str/str-eq (primitive/code-sym (get form 1))
                                               "main"))))))
          0
          (push! (mut output) form)))
    (push! (mut output) `(import "coil.alloc" :as alloc))
    (push! (mut output) `(import "coil.io" :as io))
    (push! (mut output) `(import "experiments.ohm.pexprs" :as pexprs))
    (push! (mut output)
      `(defn ~main-name [] (-> i64)
         (let [(mut graph) (~pexprs-name)
               signature (experiments.ohm.pexprs.pexpr-public-signature! (mut graph))
               status
                 (match (coil.io.print-str (coil.io.stdout) signature)
                   (Ok [written] 0)
                   (Err [error] 1))]
           (coil.alloc.free [u8] (coil.alloc.malloc-allocator) signature)
           (experiments.ohm.runtime.free-ohm-pexpr-grammar! (mut graph))
           status)))
    (primitive/code-list-done (load output))))
