(module experiments.ohm.generic-visitor-family)

(import "coil.arraylist" :as al)
(import "coil.primitive" :as primitive)
(import "coil.slice" :use [slice-get slice-len])
(import "experiments.ohm.visitor-family" :as vf)

;;; VisitorFamily operations may return arbitrary values and accept arbitrary
;;; operation arguments. Typed function pointers retain those types without the
;;; compiler's currently broken forwarded associated-result trait bounds.
(defstruct OhmGenericVisitorEvaluation [Value Argument]
  [(family (ptr vf/OhmVisitorFamily))
   (tree (dyn vf/OhmVisitorTree))
   (context (ptr u8))
   (action-index (fnptr c [(ptr u8) (slice u8)] i64))
   (apply
     (fnptr c
       [(ptr u8)
        (mut (OhmGenericVisitorEvaluation Value Argument))
        i64
        i64
        (slice vf/VisitorArgument)]
       Value))
   (operation-arguments (slice Argument))
   (argument-children (al/ArrayList i64))
   (failed bool)
   (error-kind i64)
   (error-tag (slice u8))])

(defn new-generic-visitor-evaluation
  [Value Argument]
  [(family (ptr vf/OhmVisitorFamily))
   (tree (dyn vf/OhmVisitorTree))
   (context (ptr u8))
   (action-index (fnptr c [(ptr u8) (slice u8)] i64))
   (apply
     (fnptr c
       [(ptr u8)
        (mut (OhmGenericVisitorEvaluation Value Argument))
        i64
        i64
        (slice vf/VisitorArgument)]
       Value))
   (operation-arguments (slice Argument))]
  (-> (OhmGenericVisitorEvaluation Value Argument))
  (let [(mut evaluation)
          (primitive/zeroed (OhmGenericVisitorEvaluation Value Argument))]
    (set! (.family evaluation) family)
    (set! (.tree evaluation) tree)
    (set! (.context evaluation) context)
    (set! (.action-index evaluation) action-index)
    (set! (.apply evaluation) apply)
    (set! (.operation-arguments evaluation) operation-arguments)
    (set! (.argument-children evaluation)
          (al/al-new [i64] (.allocator family)))
    (set! (.failed evaluation) false)
    (set! (.error-kind evaluation) 0)
    (set! (.error-tag evaluation) "")
    (load evaluation)))

(defn fail-generic-visitor!
  [Value Argument]
  [(evaluation (mut (OhmGenericVisitorEvaluation Value Argument)))
   (kind i64)
   (tag (slice u8))] (-> Value)
  (set! (.failed evaluation) true)
  (set! (.error-kind evaluation) kind)
  (set! (.error-tag evaluation) tag)
  (primitive/zeroed Value))

(defn evaluate-generic-visitor-node!
  [Value Argument]
  [(evaluation (mut (OhmGenericVisitorEvaluation Value Argument)))
   (node i64)] (-> Value)
  (if (.failed evaluation)
      (primitive/zeroed Value)
      (let [family (.family evaluation)
            tree (.tree evaluation)
            tag (vf/visitor-tag tree node)
            shape-index (vf/visitor-shape-index family tag)]
        (if (< shape-index 0)
            (fail-generic-visitor! [Value Argument] (mut evaluation) 1 tag)
            (let [action-index
                    (primitive/call-ptr
                      (.action-index evaluation) (.context evaluation) tag)]
              (if (< action-index 0)
                  (fail-generic-visitor! [Value Argument] (mut evaluation) 2 tag)
                  (let [shape (get (.shapes family) shape-index)
                        children-start (len (.argument-children evaluation))
                        (mut arguments)
                          (al/al-new [vf/VisitorArgument] (.allocator family))]
                    (if (.custom shape)
                        (for [argument-index 0
                             (vf/visitor-custom-argument-count tree node)]
                          (let [(mut argument) (primitive/zeroed vf/VisitorArgument)
                                count
                                  (vf/visitor-custom-argument-child-count
                                    tree node argument-index)]
                            (set! (.array argument) (> count 1))
                            (set! (.child-start argument)
                                  (len (.argument-children evaluation)))
                            (set! (.child-count argument) count)
                            (for [child-index 0 count]
                              (push! (mut (.argument-children evaluation))
                                     (vf/visitor-custom-argument-child
                                       tree node argument-index child-index)))
                            (push! (mut arguments) (load argument))))
                        (for [property-index 0 (.property-count shape)]
                          (let [property
                                  (get (.properties family)
                                       (+ (.property-start shape) property-index))
                                (mut argument) (primitive/zeroed vf/VisitorArgument)
                                count
                                  (vf/visitor-property-child-count
                                    tree node (.name property))]
                            (set! (.array argument) (.array property))
                            (set! (.child-start argument)
                                  (len (.argument-children evaluation)))
                            (set! (.child-count argument) count)
                            (for [child-index 0 count]
                              (push! (mut (.argument-children evaluation))
                                     (vf/visitor-property-child
                                       tree node (.name property) child-index)))
                            (push! (mut arguments) (load argument)))))
                    (let [answer
                            (primitive/call-ptr
                              (.apply evaluation)
                              (.context evaluation)
                              (mut evaluation)
                              node
                              action-index
                              (al/al-slice [vf/VisitorArgument] (load arguments)))]
                      (al/al-free! (mut arguments))
                      (loop (if (<= (len (.argument-children evaluation)) children-start)
                                (break)
                                (pop! (mut (.argument-children evaluation)))))
                      answer))))))))

(defn evaluate-generic-visitor-argument!
  [Value Argument]
  [(evaluation (mut (OhmGenericVisitorEvaluation Value Argument)))
   (argument vf/VisitorArgument)
   (index i64)] (-> Value)
  (if (or (< index 0) (>= index (.child-count argument)))
      (fail-generic-visitor! [Value Argument] (mut evaluation) 3 "")
      (evaluate-generic-visitor-node!
        [Value Argument]
        (mut evaluation)
        (get (.argument-children evaluation) (+ (.child-start argument) index)))))

(defn generic-visitor-operation-argument
  [Value Argument]
  [(evaluation (ptr (OhmGenericVisitorEvaluation Value Argument)))
   (index i64)] (-> Argument)
  (if (or (< index 0) (>= index (slice-len (.operation-arguments evaluation))))
      (primitive/zeroed Argument)
      (slice-get (.operation-arguments evaluation) index)))

(defn generic-visitor-failed?
  [Value Argument]
  [(evaluation (ptr (OhmGenericVisitorEvaluation Value Argument)))] (-> bool)
  (.failed evaluation))

(defn generic-visitor-error-kind
  [Value Argument]
  [(evaluation (ptr (OhmGenericVisitorEvaluation Value Argument)))] (-> i64)
  (.error-kind evaluation))

(defn generic-visitor-error-tag
  [Value Argument]
  [(evaluation (ptr (OhmGenericVisitorEvaluation Value Argument)))]
  (-> (slice u8))
  (.error-tag evaluation))

(defn free-generic-visitor-evaluation!
  [Value Argument]
  [(evaluation (mut (OhmGenericVisitorEvaluation Value Argument)))] (-> i64)
  (al/al-free! (mut (.argument-children evaluation)))
  0)
