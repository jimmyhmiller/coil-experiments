(module experiments.ohm.namespace-pexpr-dump-reader)

(import "coil.primitive" :as primitive)
(import "coil.str" :as str)
(import "experiments.ohm.namespace-reader" :as namespace-reader)

(defn read-ohm-namespace-pexpr-dump [(context Code)] (-> Code)
  (let [source (primitive/code-str (get context 2))
        generated (namespace-reader/read-ohm-namespace-impl context source)
        main-name (primitive/datum->syntax context (primitive/code-symbol "main"))
        count-name (primitive/datum->syntax context (primitive/code-symbol "namespace-count"))
        name-name (primitive/datum->syntax context (primitive/code-symbol "namespace-name"))
        object-name
          (primitive/datum->syntax context (primitive/code-symbol "namespace-grammar-object"))
        (mut output) (primitive/code-list-new)]
    (for form (iter generated)
      (if (and (primitive/code-list? form)
               (and (> (len form) 1)
                    (and (primitive/code-sym? (get form 0))
                         (and (str/str-eq (primitive/code-sym (get form 0)) "defn")
                              (and (primitive/code-sym? (get form 1))
                                   (str/str-eq (primitive/code-sym (get form 1))
                                               "main"))))))
          0
          (push! (mut output) form)))
    (push! (mut output) `(import "coil.alloc" :as alloc))
    (push! (mut output) `(import "coil.io" :as io))
    (push! (mut output) `(import "experiments.ohm.pexprs" :as pexprs))
    (push! (mut output)
      `(defn ~main-name [] (-> i64)
         (let [count (~count-name)
               grammar-name (~name-name (- count 1))
               (mut grammar) (~object-name grammar-name)
               signature
                 (experiments.ohm.pexprs.pexpr-public-signature!
                   (mut (.pexprs grammar)))
               status
                 (match (coil.io.print-str (coil.io.stdout) signature)
                   (Ok [written] 0)
                   (Err [error] 1))]
           (coil.alloc.free [u8] (coil.alloc.malloc-allocator) signature)
           (experiments.ohm.runtime.free-ohm-grammar! (mut grammar))
           status)))
    (primitive/code-list-done (load output))))
