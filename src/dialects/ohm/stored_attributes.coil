(module experiments.ohm.stored-attributes)

(import "coil.alloc" :as alloc)
(import "coil.primitive" :as primitive)
(import "experiments.ohm.runtime" :as ohm)

;; Ohm's stored attributes differ from ordinary attributes in one important
;; respect: values are installed explicitly by a separate initialization
;; operation. Reading a node that the operation skipped is an error.
(defstruct StoredAttribute
  [(name (slice u8))
   (grammar-name (slice u8))
   (grammar-token (ptr u8))
   (values ohm/SemanticAttributeCache)])

(defstruct StoredAttributeAction [(attribute (ptr StoredAttribute))])

(defn new-stored-attribute [(name (slice u8))
                            (grammar-name (slice u8))
                            (grammar-token (ptr u8))
                            (a (dyn alloc/Allocator))]
                           (-> StoredAttribute)
  (let [(mut attribute) (primitive/zeroed StoredAttribute)]
    (set! (.name attribute) name)
    (set! (.grammar-name attribute) grammar-name)
    (set! (.grammar-token attribute) grammar-token)
    (set! (.values attribute) (ohm/new-semantic-attribute-cache a))
    (load attribute)))

(defn stored-attribute-name [(attribute (ptr StoredAttribute))] (-> (slice u8))
  (.name attribute))

(defn stored-attribute-grammar-name [(attribute (ptr StoredAttribute))]
                                    (-> (slice u8))
  (.grammar-name attribute))

(defn stored-attribute-grammar-token [(attribute (ptr StoredAttribute))]
                                     (-> (ptr u8))
  (.grammar-token attribute))

(defn stored-attribute-initialized? [(attribute (ptr StoredAttribute))
                                     (result ohm/MatchResult)
                                     (node i64)] (-> bool)
  (>= (ohm/semantic-attribute-cache-find
        (field attribute values)
        (ohm/node-id result node))
      0))

(defn set-stored-attribute! [(attribute (mut StoredAttribute))
                             (result ohm/MatchResult)
                             (node i64)
                             (value i64)] (-> i64)
  (ohm/semantic-attribute-cache-store!
    (mut (.values attribute))
    (ohm/node-id result node)
    value))

(defn stored-attribute-value [(attribute (mut StoredAttribute))
                              (result ohm/MatchResult)
                              (node i64)] (-> i64)
  (let [index
          (ohm/semantic-attribute-cache-find
            (field attribute values)
            (ohm/node-id result node))]
    (if (< index 0)
        0
        (ohm/semantic-attribute-cache-load! (mut (.values attribute)) index))))

(defn new-stored-attribute-action [(attribute (ptr StoredAttribute))]
                                  (-> StoredAttributeAction)
  (let [(mut action) (primitive/zeroed StoredAttributeAction)]
    (set! (.attribute action) attribute)
    (load action)))

(impl ohm/OhmLazySemanticAction StoredAttributeAction
  (semantic-grammar-name [(self (ptr StoredAttributeAction))] (-> (slice u8))
    (stored-attribute-grammar-name (load (field self attribute))))
  (semantic-grammar-token [(self (ptr StoredAttributeAction))] (-> (ptr u8))
    (stored-attribute-grammar-token (load (field self attribute))))
  (semantic-formal-count [(self (ptr StoredAttributeAction))] (-> i64) 0)
  (semantic-action-kind [(self (ptr StoredAttributeAction))
                         (result (ptr ohm/MatchResult))
                         (node i64)] (-> i64)
    1)
  (apply-lazy-semantic-action [(self (ptr StoredAttributeAction))
                               (evaluation (mut ohm/SemanticEvaluation))
                               (node i64)
                               (action-kind i64)
                               (arguments (slice i64))] (-> i64)
    (let [attribute (load (field self attribute))
          result (.result evaluation)
          index
            (ohm/semantic-attribute-cache-find
              (field attribute values)
              (ohm/node-id (load result) node))]
      (if (< index 0)
          (ohm/fail-semantic-evaluation! (mut evaluation) 8 node)
          (ohm/semantic-attribute-cache-load! (mut (.values attribute)) index)))))

(defn free-stored-attribute! [(attribute (mut StoredAttribute))] (-> i64)
  (ohm/free-semantic-attribute-cache! (mut (.values attribute))))
