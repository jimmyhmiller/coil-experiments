(module experiments.carp.graph-test)

(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :as al)
(import "coil.assert" :use *)
(import "experiments.carp.graph" :use *)

(deftest dependency-order
  (let [a (malloc-allocator)
        (mut graph) (int-graph-new a 3)]
    (int-graph-add-edge! (mut graph) 0 1)
    (int-graph-add-edge! (mut graph) 1 2)
    (let [components (int-graph-strong-components (mut graph))]
      (assert-eq (al/al-len [(ptr (al/ArrayList i64))] components) 3)
      (assert-eq (al/al-get [i64]
                            (load (al/al-get [(ptr (al/ArrayList i64))] components 0))
                            0)
                 2)
      (assert-eq (al/al-get [i64]
                            (load (al/al-get [(ptr (al/ArrayList i64))] components 1))
                            0)
                 1)
      (assert-eq (al/al-get [i64]
                            (load (al/al-get [(ptr (al/ArrayList i64))] components 2))
                            0)
                 0))))

(deftest cycle-component
  (let [a (malloc-allocator)
        (mut graph) (int-graph-new a 3)]
    (int-graph-add-edge! (mut graph) 0 1)
    (int-graph-add-edge! (mut graph) 1 0)
    (int-graph-add-edge! (mut graph) 1 2)
    (let [components (int-graph-strong-components (mut graph))]
      (assert-eq (al/al-len [(ptr (al/ArrayList i64))] components) 2)
      (assert-eq (al/al-len [i64]
                            (load (al/al-get [(ptr (al/ArrayList i64))] components 0)))
                 1)
      (assert-eq (al/al-len [i64]
                            (load (al/al-get [(ptr (al/ArrayList i64))] components 1)))
                 2))))

