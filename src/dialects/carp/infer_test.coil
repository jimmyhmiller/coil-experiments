(module experiments.carp.infer-test)

(import "experiments.carp.surface" :as reader)
(import "experiments.carp.forms" :as forms)
(import "experiments.carp.resolve" :as resolve)
(import "experiments.carp.ir" :as ir)
(import "experiments.carp.infer" :as infer)
(import "experiments.carp.types" :as types)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "coil.assert" :use *)

(defn signature-at [(a (dyn alloc/Allocator)) (source (slice u8))]
  (-> ir/ResolvedSignature)
  (let [lowered (forms/lower a "infer-test.carp" (reader/read a source))
        resolved (resolve/resolve a (.module lowered))
        module (resolve/resolved-module resolved)]
    (assert (not (resolve/resolve-failed? resolved)))
    (al/al-get [ir/ResolvedSignature] (.signatures module) 0)))

(deftest declaration-schemes-share-written-type-and-lifetime-variables
  (let [a (alloc/malloc-allocator)
        signature (signature-at a "(register same (Fn [(Ref a q) (Ref a q)] Bool))")
        result (infer/declaration-scheme a (.type signature))]
    (assert (not (infer/scheme-failed? result)))
    (let [scheme (infer/scheme-value result)]
      (assert-eq (al/al-len [i64] (load (.type-variables scheme))) 1)
      (assert-eq (al/al-len [i64] (load (.lifetime-variables scheme))) 1))))

(deftest instantiation-freshens-each-use-but-preserves-sharing-within-a-use
  (let [a (alloc/malloc-allocator)
        signature (signature-at a "(register id (Fn [a] a))")
        result (infer/declaration-scheme a (.type signature))
        scheme (infer/scheme-value result)
        (mut next) 10
        first (infer/instantiate-scheme a scheme (mut next))
        second (infer/instantiate-scheme a scheme (mut next))]
    (match (load first)
      (types/TypeFunction [arguments result-type]
        (match (load (al/al-get [(ptr types/MonoType)] (load arguments) 0))
          (types/TypeVariable [argument-id]
            (match (load result-type)
              (types/TypeVariable [result-id] (assert-eq argument-id result-id))
              (_ (assert false))))
          (_ (assert false))))
      (_ (assert false)))
    (assert (not (types/type-same? first second)))
    (assert-eq (load next) 12)))
