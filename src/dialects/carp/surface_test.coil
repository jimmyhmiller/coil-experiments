(module experiments.carp.surface-test)

(import "experiments.carp.surface" :as surface)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "coil.assert" :use *)
(import "coil.str" :as str)

(defn first [(result surface/ReadResult)] (-> (ptr surface/SurfaceNode))
  (al/al-get [(ptr surface/SurfaceNode)] (.forms result) 0))

(deftest reads-carp-collections-and-preserves-comments
  (let [a (alloc/malloc-allocator)
        result (surface/read a "(a ; note\n [1 2] $[3] {:x true})")
        root (first result)]
    (assert (not (surface/read-failed? result)))
    (assert-eq (surface/node-kind root) surface/KIND-LIST)
    (assert-eq (surface/child-count root) 5)
    (assert-eq (surface/node-kind (surface/child-at root 1)) surface/KIND-COMMENT)
    (assert-eq (surface/node-kind (surface/child-at root 2)) surface/KIND-ARRAY)
    (assert-eq (surface/node-kind (surface/child-at root 3)) surface/KIND-STATIC-ARRAY)
    (assert-eq (surface/node-kind (surface/child-at root 4)) surface/KIND-DICT)))

(deftest classifies-carp-literals
  (let [a (alloc/malloc-allocator)
        result (surface/read a "42 255b -7l 1.5f 1e6 true \\space \"x\" #\"p\"")]
    (assert (not (surface/read-failed? result)))
    (assert-eq (surface/node-kind (al/al-get [(ptr surface/SurfaceNode)] (.forms result) 0)) surface/KIND-INT)
    (assert-eq (surface/node-kind (al/al-get [(ptr surface/SurfaceNode)] (.forms result) 1)) surface/KIND-BYTE)
    (assert-eq (surface/node-kind (al/al-get [(ptr surface/SurfaceNode)] (.forms result) 2)) surface/KIND-LONG)
    (assert-eq (surface/node-kind (al/al-get [(ptr surface/SurfaceNode)] (.forms result) 3)) surface/KIND-FLOAT)
    (assert-eq (surface/node-kind (al/al-get [(ptr surface/SurfaceNode)] (.forms result) 4)) surface/KIND-DOUBLE)
    (assert-eq (surface/node-kind (al/al-get [(ptr surface/SurfaceNode)] (.forms result) 5)) surface/KIND-BOOL)
    (assert-eq (surface/node-kind (al/al-get [(ptr surface/SurfaceNode)] (.forms result) 6)) surface/KIND-CHAR)
    (assert-eq (surface/node-kind (al/al-get [(ptr surface/SurfaceNode)] (.forms result) 7)) surface/KIND-STRING)
    (assert-eq (surface/node-kind (al/al-get [(ptr surface/SurfaceNode)] (.forms result) 8)) surface/KIND-PATTERN)))

(deftest treats-commas-as-space-and-punctuation-as-characters
  (let [a (alloc/malloc-allocator)
        result (surface/read a "[x Int, y Int] \\# \\, \\\\ 0b")]
    (assert (not (surface/read-failed? result)))
    (assert-eq (surface/child-count (first result)) 4)
    (assert-eq (surface/node-kind
                 (al/al-get [(ptr surface/SurfaceNode)] (.forms result) 1))
               surface/KIND-CHAR)
    (assert-eq (surface/node-kind
                 (al/al-get [(ptr surface/SurfaceNode)] (.forms result) 4))
               surface/KIND-BYTE)))

(deftest expands-reader-macros-to-list-forms
  (let [a (alloc/malloc-allocator)
        result (surface/read a "&x ~x @x 'x `x %x %@x")]
    (assert (not (surface/read-failed? result)))
    (assert-eq (al/al-len [(ptr surface/SurfaceNode)] (.forms result)) 7)
    (let [ref-form (first result)]
      (assert-eq (surface/node-kind ref-form) surface/KIND-LIST)
      (assert-eq (surface/child-count ref-form) 2)
      (let [macro-name (surface/child-at ref-form 0)
            macro-start (surface/node-start macro-name)]
        (assert (str/str-eq (surface/node-text macro-name) "ref"))
        (assert-eq (.line macro-start) 0)
        (assert-eq (.column macro-start) 0)))))

(deftest follows-carp-number-boundaries
  (let [a (alloc/malloc-allocator)
        result (surface/read a "1e 1e+ 1-2 0xff 0b101 2f")]
    (assert (not (surface/read-failed? result)))
    ;; Invalid exponents remain separate symbols; signs are only consumed as
    ;; part of a valid exponent or as the leading sign of the next number.
    (assert-eq (al/al-len [(ptr surface/SurfaceNode)] (.forms result)) 9)
    (assert (str/str-eq (surface/node-text
                         (al/al-get [(ptr surface/SurfaceNode)] (.forms result) 0)) "1"))
    (assert (str/str-eq (surface/node-text
                         (al/al-get [(ptr surface/SurfaceNode)] (.forms result) 1)) "e"))
    (assert-eq (surface/node-kind
                 (al/al-get [(ptr surface/SurfaceNode)] (.forms result) 6))
               surface/KIND-INT)
    (assert-eq (surface/node-kind
                 (al/al-get [(ptr surface/SurfaceNode)] (.forms result) 8))
               surface/KIND-FLOAT)))

(deftest reads-qualified-symbols-and-raw-strings
  (let [a (alloc/malloc-allocator)
        result (surface/read a "Foo.Bar.baz r\"a\"\"b\"")]
    (assert (not (surface/read-failed? result)))
    (assert-eq (al/al-len [(ptr surface/SurfaceNode)] (.forms result)) 2)
    (assert (str/str-eq (surface/node-text (first result)) "Foo.Bar.baz"))
    (assert-eq (surface/node-kind
                 (al/al-get [(ptr surface/SurfaceNode)] (.forms result) 1))
               surface/KIND-STRING)))

(deftest tracks-byte-line-and-column-bounds
  (let [a (alloc/malloc-allocator)
        result (surface/read a "\n  (a\n b)")
        root (first result)
        start (surface/node-start root)
        end (surface/node-end root)
        child (surface/node-start (surface/child-at root 1))]
    (assert-eq (.offset start) 3)
    (assert-eq (.line start) 2)
    (assert-eq (.column start) 3)
    (assert-eq (.line child) 3)
    (assert-eq (.column child) 2)
    (assert-eq (.offset end) 9)))

(deftest rejects-unclosed-forms-and-strings
  (let [a (alloc/malloc-allocator)]
    (assert (surface/read-failed? (surface/read a "(")))
    (assert (surface/read-failed? (surface/read a "\"unterminated")))
    (assert (surface/read-failed? (surface/read a "1.")))
    (assert (surface/read-failed? (surface/read a "Foo..bar")))
    (assert (surface/read-failed? (surface/read a "& x")))))
