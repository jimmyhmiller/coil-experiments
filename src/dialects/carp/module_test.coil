(module experiments.carp.module-test)

(import "experiments.carp.module" :as module)
(import "experiments.carp.forms" :as forms)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "coil.assert" :use *)
(import "coil.str" :as str)

(defn symbol-name [(node (ptr forms/CarpNode))] (-> (slice u8))
  (match (forms/form-of node)
    (forms/Symbol [segments] (al/al-get [(slice u8)] (load segments) 0))
    (_ "")))

(deftest recursively-splices-loads-once-and-preserves-source-spans
  (let [a (alloc/malloc-allocator)
        (mut loader) (module/loader-new a)]
    (module/add-source! (mut loader) "main.carp" "/project/main.carp"
                        "(def root 1) (load \"dep.carp\") (load \"dep.carp\")")
    (module/add-source! (mut loader) "dep.carp" "/project/dep.carp" "(def child 2)")
    (let [result (module/load-module (mut loader) "main.carp")
          loaded (.module result)]
      (assert (not (module/load-failed? result)))
      ;; root push, root form, child push/form/pop, root pop
      (assert-eq (forms/module-count loaded) 6)
      (let [child (forms/module-at loaded 3)
            child-span (forms/span-of child)]
        (assert (str/str-eq (.source child-span) "/project/dep.carp"))))))

(deftest load-and-use-inserts-use-all-after-loaded-module
  (let [a (alloc/malloc-allocator)
        (mut loader) (module/loader-new a)]
    (module/add-source! (mut loader) "main.carp" "main.carp" "(load-and-use Math)")
    (module/add-source! (mut loader) "Math.carp" "Math.carp" "(defmodule Math)")
    (let [result (module/load-module (mut loader) "main.carp")
          use-form (forms/module-at (.module result) 4)]
      (assert (not (module/load-failed? result)))
      (match (forms/form-of use-form)
        (forms/ListForm [items]
          (assert (str/str-eq
                    (symbol-name (al/al-get [(ptr forms/CarpNode)] (load items) 0))
                    "use-all")))
        (_ (assert false))))))

(deftest canonical-files-deduplicate-alias-paths
  (let [a (alloc/malloc-allocator)
        (mut loader) (module/loader-new a)]
    (module/add-source! (mut loader) "main.carp" "main.carp"
                        "(load \"a.carp\") (load \"alias.carp\")")
    (module/add-source! (mut loader) "a.carp" "/real/a.carp" "x")
    (module/add-source! (mut loader) "alias.carp" "/real/a.carp" "x")
    (let [result (module/load-module (mut loader) "main.carp")]
      (assert (not (module/load-failed? result)))
      ;; main push/pop plus one child push/x/pop
      (assert-eq (forms/module-count (.module result)) 5))))

(deftest reports-missing-and-recursive-loads
  (let [a (alloc/malloc-allocator)
        (mut missing) (module/loader-new a)
        (mut cyclic) (module/loader-new a)]
    (module/add-source! (mut missing) "main.carp" "main.carp" "(load \"nope.carp\")")
    (module/add-source! (mut cyclic) "a.carp" "a.carp" "(load \"b.carp\")")
    (module/add-source! (mut cyclic) "b.carp" "b.carp" "(load \"a.carp\")")
    (let [missing-result (module/load-module (mut missing) "main.carp")
          cycle-result (module/load-module (mut cyclic) "a.carp")]
      (assert (module/load-failed? missing-result))
      (assert (module/load-failed? cycle-result))
      (assert (str/str-eq (module/error-message (.error cycle-result))
                          "recursive module load")))))
