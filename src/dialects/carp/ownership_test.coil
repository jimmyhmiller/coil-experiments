(module experiments.carp.ownership-test)

(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :as al)
(import "coil.assert" :use *)
(import "experiments.carp.ownership" :use *)

(deftest local-borrow-cannot-escape
  (let [a (malloc-allocator)
        origin (borrow-origin-local a 10)
        (mut state) (borrow-state-new a)]
    (assert (borrow-origin-escapes? origin))
    (assert (not (borrow-valid? (borrow-check-origin origin (mut state) true))))
    (assert (borrow-valid? (borrow-check-origin origin (mut state) false)))))

(deftest parameter-borrow-may-escape
  (let [a (malloc-allocator)
        origin (borrow-origin-parameter a 10)
        (mut state) (borrow-state-new a)]
    (assert (not (borrow-origin-escapes? origin)))
    (assert (borrow-valid? (borrow-check-origin origin (mut state) true)))))

(deftest temporary-borrow-cannot-escape
  (let [a (malloc-allocator)
        origin (borrow-origin-temporary a 99)
        (mut state) (borrow-state-new a)]
    (assert (borrow-origin-escapes? origin))
    (assert (not (borrow-valid? (borrow-check-origin origin (mut state) true))))))

(deftest borrow-after-move-is-rejected
  (let [a (malloc-allocator)
        origin (borrow-origin-local a 10)
        (mut initial) (borrow-state-new a)
        (mut moved) (borrow-state-mark-moved a (mut initial) 10)]
    (assert (not (borrow-valid? (borrow-check-origin origin (mut moved) false))))))

(deftest negative-local-id-borrow-after-move-is-rejected
  (let [a (malloc-allocator)
        origin (borrow-origin-local a -10)
        (mut initial) (borrow-state-new a)
        (mut moved) (borrow-state-mark-moved a (mut initial) -10)]
    (assert (not (borrow-valid? (borrow-check-origin origin (mut moved) false))))))

(deftest borrow-before-move-is-valid
  (let [a (malloc-allocator)
        origin (borrow-origin-local a 10)
        (mut initial) (borrow-state-new a)]
    (assert (borrow-valid? (borrow-check-origin origin (mut initial) false)))))

(deftest branch-join-preserves-possible-move
  (let [a (malloc-allocator)
        origin (borrow-origin-local a 10)
        (mut initial) (borrow-state-new a)
        (mut moved-branch) (borrow-state-mark-moved a (mut initial) 10)
        (mut joined) (borrow-state-join a (mut initial) (mut moved-branch))]
    (assert (borrow-state-moved? (mut joined) 10))
    (assert (not (borrow-valid? (borrow-check-origin origin (mut joined) false))))))

(deftest branch-origin-join-preserves-all-owners
  (let [a (malloc-allocator)
        left-origin (borrow-origin-local a 10)
        right-origin (borrow-origin-local a 20)
        (mut initial) (borrow-state-new a)
        (mut left) (borrow-state-set-origin a (mut initial) 30 left-origin)
        (mut right) (borrow-state-set-origin a (mut initial) 30 right-origin)
        (mut joined) (borrow-state-join a (mut left) (mut right))
        joined-origin (borrow-state-origin (mut joined) 30)]
    (assert-eq (al/al-len [i64] (load (load (field joined-origin locals)))) 2)
    (let [(mut moved) (borrow-state-mark-moved a (mut joined) 20)]
      (assert (not (borrow-valid?
                     (borrow-check-origin joined-origin (mut moved) false)))))))

(deftest mutation-replaces-origin
  (let [a (malloc-allocator)
        parameter-origin (borrow-origin-parameter a 1)
        local-origin (borrow-origin-local a 2)
        (mut initial) (borrow-state-new a)
        (mut parameter-state) (borrow-state-set-origin a (mut initial) 3 parameter-origin)
        (mut local-state) (borrow-state-set-origin a (mut parameter-state) 3 local-origin)
        result (borrow-state-origin (mut local-state) 3)]
    (assert (borrow-origin-escapes? result))))

(deftest reassignment-clears-moved-state
  (let [a (malloc-allocator)
        (mut initial) (borrow-state-new a)
        (mut moved) (borrow-state-mark-moved a (mut initial) 8)
        (mut reassigned) (borrow-state-unmove a (mut moved) 8)]
    (assert (borrow-state-moved? (mut moved) 8))
    (assert (not (borrow-state-moved? (mut reassigned) 8)))))
