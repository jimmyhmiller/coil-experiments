(module experiments.carp.surface)

;; Carp's reader is part of the language: comments survive, reader macros
;; expand to ordinary lists, and every form carries byte/line/column bounds.
;; Literal spellings are retained here; decoding belongs to semantic lowering.

(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "coil.primitive" :as primitive)
(import "coil.slice" :use *)
(import "coil.str" :as str)

(export SurfaceKind SurfaceNode SourceInfo ReadResult read read-failed?
        node-kind node-text node-start node-end node-children child-count child-at
        KIND-INT KIND-BYTE KIND-LONG KIND-FLOAT KIND-DOUBLE KIND-BOOL KIND-CHAR
        KIND-STRING KIND-PATTERN KIND-SYMBOL KIND-LIST KIND-ARRAY KIND-STATIC-ARRAY
        KIND-DICT KIND-COMMENT)

(const KIND-INT 1)
(const KIND-BYTE 2)
(const KIND-LONG 3)
(const KIND-FLOAT 4)
(const KIND-DOUBLE 5)
(const KIND-BOOL 6)
(const KIND-CHAR 7)
(const KIND-STRING 8)
(const KIND-PATTERN 9)
(const KIND-SYMBOL 10)
(const KIND-LIST 11)
(const KIND-ARRAY 12)
(const KIND-STATIC-ARRAY 13)
(const KIND-DICT 14)
(const KIND-COMMENT 15)

(defstruct SourceInfo [(offset i64) (line i64) (column i64)])
(defstruct SurfaceNode
  [(kind i64)
   ;; Exact source spelling. Synthetic reader-macro list/symbol nodes use the
   ;; macro name as their spelling and a zero-width source bound.
   (text (slice u8))
   (start SourceInfo)
   (end SourceInfo)
   (children (ptr (al/ArrayList (ptr SurfaceNode))))])

(defstruct ReadResult
  [(forms (al/ArrayList (ptr SurfaceNode)))
   (failed i64)
   (message (slice u8))
   (at SourceInfo)])

(defstruct Reader
  [(a (dyn alloc/Allocator))
   (source (slice u8))
   (pos i64)
   (line i64)
   (column i64)
   (failed i64)
   (message (slice u8))
   (error-at SourceInfo)])

(defn read-failed? [(result ReadResult)] (-> bool) (!= (.failed result) 0))
(defn node-kind [(node (ptr SurfaceNode))] (-> i64) (load (field node kind)))
(defn node-text [(node (ptr SurfaceNode))] (-> (slice u8)) (load (field node text)))
(defn node-start [(node (ptr SurfaceNode))] (-> SourceInfo) (load (field node start)))
(defn node-end [(node (ptr SurfaceNode))] (-> SourceInfo) (load (field node end)))
(defn node-children [(node (ptr SurfaceNode))]
  (-> (ptr (al/ArrayList (ptr SurfaceNode)))) (load (field node children)))
(defn child-count [(node (ptr SurfaceNode))] (-> i64)
  (al/al-len [(ptr SurfaceNode)] (load (field node children))))
(defn child-at [(node (ptr SurfaceNode)) (index i64)] (-> (ptr SurfaceNode))
  (al/al-get [(ptr SurfaceNode)] (load (field node children)) index))

(defn here [(reader (mut Reader))] (-> SourceInfo)
  (SourceInfo :offset (load (field reader pos))
              :line (load (field reader line))
              :column (load (field reader column))))

(defn byte-at [(reader (mut Reader)) (delta i64)] (-> i64)
  (let [at (+ (load (field reader pos)) delta)
        source (load (field reader source))]
    (if (or (< at 0) (>= at (slice-len source)))
        0
        (primitive/cast i64 (slice-get source at)))))

(defn at-end? [(reader (mut Reader))] (-> bool)
  (>= (load (field reader pos)) (slice-len (load (field reader source)))))

(defn advance! [(reader (mut Reader)) (count i64)] (-> i64)
  (let [(mut i) 0]
    (loop (if (>= (load i) count)
              (break)
              (do
                (if (= (byte-at (mut reader) 0) 10)
                    (do (store! (field reader line) (+ (load (field reader line)) 1))
                        (store! (field reader column) 1))
                    (store! (field reader column) (+ (load (field reader column)) 1)))
                (store! (field reader pos) (+ (load (field reader pos)) 1))
                (store! i (+ (load i) 1))))))
  0)

(defn fail! [(reader (mut Reader)) (message (slice u8))] (-> i64)
  (if (= (load (field reader failed)) 0)
      (do (store! (field reader failed) 1)
          (store! (field reader message) message)
          (store! (field reader error-at) (here (mut reader))))
      0)
  0)

(defn whitespace? [(c i64)] (-> bool)
  (or (= c 44)
      (or (= c 32) (or (= c 9) (or (= c 10) (or (= c 11) (or (= c 12) (= c 13))))))))

(defn skip-space! [(reader (mut Reader))] (-> i64)
  (loop (if (or (at-end? (mut reader)) (not (whitespace? (byte-at (mut reader) 0))))
            (break)
            (advance! (mut reader) 1)))
  0)

(defn children-new [(reader (mut Reader))]
  (-> (ptr (al/ArrayList (ptr SurfaceNode))))
  (alloc/box! (load (field reader a))
              (al/ArrayList (ptr SurfaceNode))
              (al/al-new [(ptr SurfaceNode)] (load (field reader a)))))

(defn empty-children [(reader (mut Reader))]
  (-> (ptr (al/ArrayList (ptr SurfaceNode)))) (children-new (mut reader)))

(defn source-between [(reader (mut Reader)) (from i64) (until i64)] (-> (slice u8))
  (subslice (load (field reader source)) from until))

(defn make-node [(reader (mut Reader)) (kind i64) (from SourceInfo)
                 (text (slice u8))
                 (children (ptr (al/ArrayList (ptr SurfaceNode))))]
  (-> (ptr SurfaceNode))
  (let [end (here (mut reader))]
    (alloc/box! (load (field reader a)) SurfaceNode
                (SurfaceNode :kind kind :text text :start from
                             :end end :children children))))

(defn make-synthetic-node [(reader (mut Reader)) (kind i64) (text (slice u8))]
  (-> (ptr SurfaceNode))
  (let [synthetic (SourceInfo :offset 0 :line 0 :column 0)
        children (empty-children (mut reader))]
    (alloc/box! (load (field reader a)) SurfaceNode
                (SurfaceNode :kind kind :text text :start synthetic :end synthetic
                             :children children))))

(defn digit? [(c i64)] (-> bool) (and (>= c 48) (<= c 57)))
(defn hex-digit? [(c i64)] (-> bool)
  (or (digit? c) (or (and (>= c 65) (<= c 70)) (and (>= c 97) (<= c 102)))))
(defn base-digit? [(c i64) (base i64)] (-> bool)
  (cond
    (= base 2) (or (= c 48) (= c 49))
    (= base 16) (hex-digit? c)
    :else (digit? c)))
(defn alpha? [(c i64)] (-> bool)
  (or (and (>= c 65) (<= c 90)) (and (>= c 97) (<= c 122))))
(defn symbol-byte? [(c i64)] (-> bool)
  (or (alpha? c)
      (or (digit? c)
          (or (>= c 128)
              (or (= c 43) (or (= c 45) (or (= c 42) (or (= c 47)
              (or (= c 63) (or (= c 33) (or (= c 62) (or (= c 60)
              (or (= c 61) (or (= c 95) (= c 58)))))))))))))))

(defn number-kind [(text (slice u8))] (-> i64)
  (let [n (slice-len text)
        (mut i) 0
        (mut period) false
        (mut exponent) false]
    (if (and (> n 0) (= (primitive/cast i64 (slice-get text 0)) 45))
        (store! i 1) 0)
    (let [based (and (< (+ (load i) 2) n)
                     (= (primitive/cast i64 (slice-get text (load i))) 48)
                     (or (= (primitive/cast i64
                              (slice-get text (+ (load i) 1))) 120)
                         (= (primitive/cast i64
                              (slice-get text (+ (load i) 1))) 98)))]
      ;; In a based integer the final `b` or `f` is a digit, never a decimal
      ;; suffix. This distinction cannot be reconstructed from the last byte.
      (if based
          KIND-INT
          (do
            (store! i 0)
            (loop (if (>= (load i) n)
                      (break)
                      (let [c (primitive/cast i64 (slice-get text (load i)))]
                        (if (= c 46) (store! period true) 0)
                        (if (or (= c 101) (= c 69)) (store! exponent true) 0)
                        (store! i (+ (load i) 1)))))
            (if (= n 0)
                KIND-INT
                (let [last (primitive/cast i64 (slice-get text (- n 1)))]
                  (cond (= last 98) KIND-BYTE
                        (= last 108) KIND-LONG
                        (= last 102) KIND-FLOAT
                        (or (load period) (load exponent)) KIND-DOUBLE
                        :else KIND-INT))))))))

(defn parse-delimited [(reader (mut Reader)) (kind i64) (open-count i64) (close i64)]
  (-> (ptr SurfaceNode))
  (let [start (here (mut reader))
        begin (load (field reader pos))
        children (children-new (mut reader))]
    (advance! (mut reader) open-count)
    (loop
      (skip-space! (mut reader))
      (cond
        (!= (load (field reader failed)) 0) (break)
        (at-end? (mut reader)) (do (fail! (mut reader) "unclosed collection") (break))
        (= (byte-at (mut reader) 0) close) (do (advance! (mut reader) 1) (break))
        :else (let [child (parse-form (mut reader))]
                (if (= (primitive/cast i64 child) 0)
                    (break)
                    (al/al-push! [(ptr SurfaceNode)] children child)))))
    (make-node (mut reader) kind start
               (source-between (mut reader) begin (load (field reader pos))) children)))

(defn macro-form [(reader (mut Reader)) (prefix-count i64) (name (slice u8))]
  (-> (ptr SurfaceNode))
  (let [start (here (mut reader))
        children (children-new (mut reader))]
    (advance! (mut reader) prefix-count)
    ;; Reader macros bind to the immediately following form in Carp; whitespace
    ;; here is not silently accepted by the reference reader.
    (if (or (at-end? (mut reader)) (whitespace? (byte-at (mut reader) 0)))
        (fail! (mut reader) "reader macro requires an adjacent form")
        0)
    (let [symbol (make-synthetic-node (mut reader) KIND-SYMBOL name)
          body (parse-form (mut reader))]
      (al/al-push! [(ptr SurfaceNode)] children symbol)
      (if (!= (primitive/cast i64 body) 0)
          (al/al-push! [(ptr SurfaceNode)] children body)
          0)
      (make-node (mut reader) KIND-LIST start name children))))

(defn scan-quoted! [(reader (mut Reader)) (prefix i64) (raw i64)] (-> i64)
  (advance! (mut reader) prefix)
  (let [(mut closed) false]
    (loop
      (if (or (at-end? (mut reader)) (load closed))
          (break)
          (let [c (byte-at (mut reader) 0)]
            (cond
              (= c 34)
                (if (and (!= raw 0) (= (byte-at (mut reader) 1) 34))
                    (advance! (mut reader) 2)
                    (do (advance! (mut reader) 1) (store! closed true)))
              (and (= raw 0) (= c 92) (!= (byte-at (mut reader) 1) 0))
                (advance! (mut reader) 2)
              :else (advance! (mut reader) 1)))))
    (if (not (load closed)) (fail! (mut reader) "unclosed string") 0))
  0)

(defn scan-pattern! [(reader (mut Reader))] (-> i64)
  (advance! (mut reader) 2)
  (loop
    (cond
      (at-end? (mut reader)) (do (fail! (mut reader) "unclosed pattern") (break))
      (= (byte-at (mut reader) 0) 34) (do (advance! (mut reader) 1) (break))
      :else (advance! (mut reader) 1)))
  0)

(defn parse-atom [(reader (mut Reader)) (kind i64) (prefix i64)] (-> (ptr SurfaceNode))
  (let [start (here (mut reader))
        begin (load (field reader pos))]
    (advance! (mut reader) prefix)
    (let [content-start (load (field reader pos))
          (mut after-dot) false]
      (loop
        (let [c (byte-at (mut reader) 0)]
          (cond
            (symbol-byte? c) (do (advance! (mut reader) 1) (store! after-dot false))
            (and (= kind 0) (= c 46))
              (if (load after-dot)
                  (do (fail! (mut reader) "empty qualified-symbol segment") (break))
                  (do (advance! (mut reader) 1) (store! after-dot true)))
            :else (break))))
      ;; A character literal accepts any single byte/codepoint after its
      ;; backslash, including punctuation that cannot occur in symbols.
      (if (and (!= kind 0) (= content-start (load (field reader pos)))
               (not (at-end? (mut reader))))
          (advance! (mut reader) 1)
          0)
      (if (load after-dot) (fail! (mut reader) "empty qualified-symbol segment") 0))
    (let [text (source-between (mut reader) begin (load (field reader pos)))]
      (make-node (mut reader)
                 (if (= kind 0)
                     (cond (str/str-eq text "true") KIND-BOOL
                           (str/str-eq text "false") KIND-BOOL
                           :else KIND-SYMBOL)
                     kind)
                 start text (empty-children (mut reader))))))

(defn parse-number [(reader (mut Reader))] (-> (ptr SurfaceNode))
  (let [start (here (mut reader))
        begin (load (field reader pos))]
    (if (= (byte-at (mut reader) 0) 45) (advance! (mut reader) 1) 0)
    (let [(mut base) 10]
      (if (and (= (byte-at (mut reader) 0) 48)
               (or (and (= (byte-at (mut reader) 1) 120)
                        (hex-digit? (byte-at (mut reader) 2)))
                   (and (= (byte-at (mut reader) 1) 98)
                        (or (= (byte-at (mut reader) 2) 48)
                            (= (byte-at (mut reader) 2) 49)))))
          (do
            (if (= (byte-at (mut reader) 1) 120)
                (store! base 16)
                (store! base 2))
            (advance! (mut reader) 2))
          0)
      (let [digits-start (load (field reader pos))]
        (loop (if (base-digit? (byte-at (mut reader) 0) (load base))
                  (advance! (mut reader) 1)
                  (break)))
        (if (= digits-start (load (field reader pos)))
            (fail! (mut reader) "number requires digits")
            0))
      ;; A decimal point commits to a double/float and must have digits after
      ;; it, matching carp-reader rather than a permissive Lisp number token.
      (if (and (= (load base) 10) (= (byte-at (mut reader) 0) 46))
          (do
            (advance! (mut reader) 1)
            (let [fraction-start (load (field reader pos))]
              (loop (if (digit? (byte-at (mut reader) 0))
                        (advance! (mut reader) 1)
                        (break)))
              (if (= fraction-start (load (field reader pos)))
                  (fail! (mut reader) "fraction requires digits")
                  0)))
          0)
      (if (and (= (load base) 10)
               (or (= (byte-at (mut reader) 0) 101)
                   (= (byte-at (mut reader) 0) 69)))
          (let [(mut look) 1]
            (if (or (= (byte-at (mut reader) (load look)) 43)
                    (= (byte-at (mut reader) (load look)) 45))
                (store! look (+ (load look) 1))
                0)
            ;; An invalid exponent does not consume its marker. The reference
            ;; returns the preceding integer and then reads a symbol.
            (if (digit? (byte-at (mut reader) (load look)))
                (do
                  (advance! (mut reader) (load look))
                  (loop (if (digit? (byte-at (mut reader) 0))
                            (advance! (mut reader) 1)
                            (break))))
                0))
          0)
      (let [suffix (byte-at (mut reader) 0)]
        (if (or (= suffix 98) (or (= suffix 108) (= suffix 102)))
            (advance! (mut reader) 1)
            0)))
    (let [text (source-between (mut reader) begin (load (field reader pos)))]
      (make-node (mut reader) (number-kind text) start text (empty-children (mut reader))))))

(defn parse-form [(reader (mut Reader))] (-> (ptr SurfaceNode))
  (skip-space! (mut reader))
  (if (at-end? (mut reader))
      (primitive/cast (ptr SurfaceNode) 0)
      (let [c (byte-at (mut reader) 0)
            c1 (byte-at (mut reader) 1)]
        (cond
          (= c 40) (parse-delimited (mut reader) KIND-LIST 1 41)
          (= c 91) (parse-delimited (mut reader) KIND-ARRAY 1 93)
          (= c 123) (parse-delimited (mut reader) KIND-DICT 1 125)
          (and (= c 36) (= c1 91)) (parse-delimited (mut reader) KIND-STATIC-ARRAY 2 93)
          (= c 38) (macro-form (mut reader) 1 "ref")
          (= c 126) (macro-form (mut reader) 1 "deref")
          (= c 64) (macro-form (mut reader) 1 "copy")
          (= c 39) (macro-form (mut reader) 1 "quote")
          (= c 96) (macro-form (mut reader) 1 "quasiquote")
          (and (= c 37) (= c1 64)) (macro-form (mut reader) 2 "unquote-splicing")
          (= c 37) (macro-form (mut reader) 1 "unquote")
          (= c 59)
            (let [start (here (mut reader)) begin (load (field reader pos))]
              (loop (if (or (at-end? (mut reader)) (= (byte-at (mut reader) 0) 10))
                        (break) (advance! (mut reader) 1)))
              (make-node (mut reader) KIND-COMMENT start
                         (source-between (mut reader) begin (load (field reader pos)))
                         (empty-children (mut reader))))
          (= c 34)
            (let [start (here (mut reader)) begin (load (field reader pos))]
              (scan-quoted! (mut reader) 1 0)
              (make-node (mut reader) KIND-STRING start
                         (source-between (mut reader) begin (load (field reader pos)))
                         (empty-children (mut reader))))
          (and (= c 114) (= c1 34))
            (let [start (here (mut reader)) begin (load (field reader pos))]
              (scan-quoted! (mut reader) 2 1)
              (make-node (mut reader) KIND-STRING start
                         (source-between (mut reader) begin (load (field reader pos)))
                         (empty-children (mut reader))))
          (and (= c 35) (= c1 34))
            (let [start (here (mut reader)) begin (load (field reader pos))]
              (scan-pattern! (mut reader))
              (make-node (mut reader) KIND-PATTERN start
                         (source-between (mut reader) begin (load (field reader pos)))
                         (empty-children (mut reader))))
          (= c 92) (parse-atom (mut reader) KIND-CHAR 1)
          (or (digit? c) (and (= c 45) (digit? c1))) (parse-number (mut reader))
          (symbol-byte? c) (parse-atom (mut reader) 0 0)
          :else (do (fail! (mut reader) "unexpected byte")
                    (primitive/cast (ptr SurfaceNode) 0))))))

(defn read [(a (dyn alloc/Allocator)) (source (slice u8))] (-> ReadResult)
  (let [(mut reader) (load (Reader :a a :source source :pos 0 :line 1 :column 1
                                  :failed 0 :message "" :error-at (SourceInfo :offset 0 :line 1 :column 1)))
        (mut forms) (al/al-new [(ptr SurfaceNode)] a)]
    (loop
      (skip-space! (mut reader))
      (if (or (at-end? (mut reader)) (!= (load (field reader failed)) 0))
          (break)
          (let [form (parse-form (mut reader))]
            (if (= (primitive/cast i64 form) 0)
                (break)
                (al/al-push! [(ptr SurfaceNode)] (mut forms) form)))))
    (ReadResult :forms (load (mut forms))
                :failed (load (field reader failed))
                :message (load (field reader message))
                :at (load (field reader error-at)))))
