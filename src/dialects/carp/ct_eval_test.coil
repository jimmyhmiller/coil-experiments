(module experiments.carp.ct-eval-test)

(import "experiments.carp.surface" :as reader)
(import "experiments.carp.forms" :as forms)
(import "experiments.carp.ct-eval" :as eval)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "coil.assert" :use *)
(import "coil.str" :as str)

(defn expression [(a (dyn alloc/Allocator)) (source (slice u8))]
  (-> (ptr forms/CarpNode))
  (let [lowered (forms/lower a "test.carp" (reader/read a source))]
    (forms/module-at (.module lowered) 0)))

(defn evaluate [(a (dyn alloc/Allocator)) (source (slice u8))] (-> eval/CtEvalResult)
  (let [(mut evaluator) (eval/evaluator-new a)]
    (eval/eval (mut evaluator) (expression a source))))

(defn symbol-text [(node (ptr forms/CarpNode))] (-> (slice u8))
  (match (forms/form-of node)
    (forms/Symbol [segments]
      (if (= (al/al-len [(slice u8)] (load segments)) 1)
          (al/al-get [(slice u8)] (load segments) 0) ""))
    (_ "")))

(deftest evaluates-scalars-arithmetic-and-conditionals
  (let [a (alloc/malloc-allocator)]
    (match (eval/result-value (evaluate a "(+ 20 22)"))
      (eval/ValueInt [value] (assert-eq value 42)) (_ (assert false)))
    (match (eval/result-value (evaluate a "(if (< 2 3) 7 9)"))
      (eval/ValueInt [value] (assert-eq value 7)) (_ (assert false)))
    (match (eval/result-value (evaluate a "(= (inc 4) (dec 6))"))
      (eval/ValueBool [value] (assert value)) (_ (assert false)))))

(deftest sequential-let-bindings-and-mutation-share-cells
  (let [a (alloc/malloc-allocator)
        result (evaluate a "(let [x 1 y (+ x 2)] (do (set! x (+ x y)) x))")]
    (assert (not (eval/eval-failed? result)))
    (match (eval/result-value result)
      (eval/ValueInt [value] (assert-eq value 4)) (_ (assert false)))))

(deftest closures-capture-stable-lexical-frames
  (let [a (alloc/malloc-allocator)
        result (evaluate a
          "(let [x 0 bump (fn [] (do (set! x (inc x)) x))] (do (bump) (bump)))")]
    (assert (not (eval/eval-failed? result)))
    (match (eval/result-value result)
      (eval/ValueInt [value] (assert-eq value 2)) (_ (assert false)))))

(deftest returned-closures-retain-their-defining-frame
  (let [a (alloc/malloc-allocator)
        result (evaluate a
          "(let [make (fn [x] (fn [ignored] x)) first (make 4)] (first 9))")]
    (match (eval/result-value result)
      (eval/ValueInt [value] (assert-eq value 4)) (_ (assert false)))))

(deftest while-is-fuel-bounded-and-mutates-lexical-state
  (let [a (alloc/malloc-allocator)
        result (evaluate a
          "(let [acc 0 i 0] (do (while (< i 10) (do (set! acc (+ acc i)) (set! i (inc i)))) acc))")]
    (assert (not (eval/eval-failed? result)))
    (match (eval/result-value result)
      (eval/ValueInt [value] (assert-eq value 45)) (_ (assert false)))))

(deftest let-do-for-and-string-helpers-match-core-usage
  (let [a (alloc/malloc-allocator)
        sum (evaluate a
          "(let-do [acc 0] (for [i 0 10] (set! acc (+ acc i))) acc)")
        comparison (evaluate a "(= (String.head \"{\") \"{\")")
        letters (evaluate a "(String.to-list \"hµ\")")]
    (match (eval/result-value sum)
      (eval/ValueInt [value] (assert-eq value 45)) (_ (assert false)))
    (match (eval/result-value comparison)
      (eval/ValueBool [value] (assert value)) (_ (assert false)))
    (match (eval/result-value letters)
      (eval/ValueList [values array]
        (do (assert (not array))
            (assert-eq (al/al-len [eval/CtValue] (load values)) 2)))
      (_ (assert false)))))

(deftest quote-eval-and-parse-use-semantic-syntax
  (let [a (alloc/malloc-allocator)
        quoted (evaluate a "(eval (quote (+ 3 4)))")
        parsed (evaluate a "(eval (parse \"(* 3 4)\"))")]
    (match (eval/result-value quoted)
      (eval/ValueInt [value] (assert-eq value 7)) (_ (assert false)))
    (match (eval/result-value parsed)
      (eval/ValueInt [value] (assert-eq value 12)) (_ (assert false)))))

(deftest case-collections-and-explicit-host-configuration-match-core
  (let [a (alloc/malloc-allocator)
        selected (evaluate a "(case \"native\" \"native\" (caddr (cons 1 [2 3])) missing)")
        (mut evaluator) (eval/evaluator-new a)]
    (match (eval/result-value selected)
      (eval/ValueInt [value] (assert-eq value 3)) (_ (assert false)))
    (eval/evaluator-configure-host! (mut evaluator) "arm64" "macos" "wasm32")
    (match (eval/result-value
             (eval/eval (mut evaluator)
                        (expression a "[(host-arch) (host-os) (Project.get-config \"target\")]")))
      (eval/ValueList [values array]
        (do (assert array)
            (assert-eq (al/al-len [eval/CtValue] (load values)) 3)
            (match (al/al-get [eval/CtValue] (load values) 2)
              (eval/ValueString [value] (assert (str/str-eq value "wasm32")))
              (_ (assert false)))))
      (_ (assert false)))))

(deftest quasiquote-evaluates-unquotes-and-collection-splices-structurally
  (let [a (alloc/malloc-allocator)
        result (evaluate a "(let [x 'b xs '(c d)] `(a %x %@xs z))")]
    (assert (not (eval/eval-failed? result)))
    (match (eval/result-value result)
      (eval/ValueSyntax [syntax]
        (match (forms/form-of syntax)
          (forms/ListForm [items]
            (do (assert-eq (al/al-len [(ptr forms/CarpNode)] (load items)) 5)
                (assert (str/str-eq
                  (symbol-text (al/al-get [(ptr forms/CarpNode)] (load items) 0)) "a"))
                (assert (str/str-eq
                  (symbol-text (al/al-get [(ptr forms/CarpNode)] (load items) 1)) "b"))
                (assert (str/str-eq
                  (symbol-text (al/al-get [(ptr forms/CarpNode)] (load items) 2)) "c"))
                (assert (str/str-eq
                  (symbol-text (al/al-get [(ptr forms/CarpNode)] (load items) 3)) "d"))
                (assert (str/str-eq
                  (symbol-text (al/al-get [(ptr forms/CarpNode)] (load items) 4)) "z"))))
          (_ (assert false))))
      (_ (assert false)))
    (assert (eval/eval-failed? (evaluate a "`%@'(a b)")))
    (assert (eval/eval-failed? (evaluate a "`[a %@'(b c)]")))))

(deftest quasiquote-list-kind-survives-splicing-a-mapped-array
  (let [a (alloc/malloc-allocator)
        result (evaluate a
          "(let [copies ['(copy a) '(copy b)]] `(init %@copies))")]
    (assert (not (eval/eval-failed? result)))
    (match (eval/result-value result)
      (eval/ValueSyntax [syntax]
        (match (forms/form-of syntax)
          (forms/ListForm [items]
            (assert-eq (al/al-len [(ptr forms/CarpNode)] (load items)) 3))
          (_ (assert false))))
      (_ (assert false)))))

(deftest quasiquote-list-kind-survives-splicing-rest-parameters
  (let [a (alloc/malloc-allocator)
        result (evaluate a
          "((fn [name :rest props] `(%name %@props)) 'Pair 'a 'b)")]
    (assert (not (eval/eval-failed? result)))
    (match (eval/result-value result)
      (eval/ValueSyntax [syntax]
        (match (forms/form-of syntax)
          (forms/ListForm [items]
            (assert-eq (al/al-len [(ptr forms/CarpNode)] (load items)) 3))
          (_ (assert false))))
      (_ (assert false)))))

(deftest nested-list-kind-survives-an-array-unquote-sibling
  (let [a (alloc/malloc-allocator)
        result (evaluate a
          "(let [params ['a 'b] copies ['(copy a) '(copy b)]] `(defn f %params (init %@copies)))")]
    (assert (not (eval/eval-failed? result)))
    (match (eval/result-value result)
      (eval/ValueSyntax [syntax]
        (match (forms/form-of syntax)
          (forms/ListForm [outer]
            (match (forms/form-of
                     (al/al-get [(ptr forms/CarpNode)] (load outer) 3))
              (forms/ListForm [_] (assert true))
              (_ (assert false))))
          (_ (assert false))))
      (_ (assert false)))))

(deftest symbol-operations-and-variadic-str-preserve-carp-semantics
  (let [a (alloc/malloc-allocator)
        prefixed (evaluate a "(Symbol.prefix 'Pair 'zero)")
        concatenated (evaluate a "(Symbol.concat ['update- 'member])")
        rendered (evaluate a "(str \"tuple \" 'Pair \" has \" 2 \" fields\")")]
    (match (eval/result-value prefixed)
      (eval/ValueSyntax [node]
        (match (forms/form-of node)
          (forms/Symbol [segments]
            (do (assert-eq (al/al-len [(slice u8)] (load segments)) 2)
                (assert (str/str-eq
                  (al/al-get [(slice u8)] (load segments) 0) "Pair"))
                (assert (str/str-eq
                  (al/al-get [(slice u8)] (load segments) 1) "zero"))))
          (_ (assert false))))
      (_ (assert false)))
    (match (eval/result-value concatenated)
      (eval/ValueSyntax [node]
        (assert (str/str-eq (symbol-text node) "update-member")))
      (_ (assert false)))
    (match (eval/result-value rendered)
      (eval/ValueString [value]
        (assert (str/str-eq value "tuple Pair has 2 fields")))
      (_ (assert false)))))

(deftest string-indexing-and-slicing-use-character-indices
  (let [a (alloc/malloc-allocator)]
    (match (eval/result-value (evaluate a "(String.length \"aµz\")"))
      (eval/ValueInt [value] (assert-eq value 3)) (_ (assert false)))
    (match (eval/result-value (evaluate a "(String.index-of \"aµz\" \\µ)"))
      (eval/ValueInt [value] (assert-eq value 1)) (_ (assert false)))
    (match (eval/result-value (evaluate a "(String.char-at \"aµz\" 1)"))
      (eval/ValueChar [value] (assert-eq value 181)) (_ (assert false)))
    (match (eval/result-value (evaluate a "(String.slice \"aµz\" 1 3)"))
      (eval/ValueString [value] (assert (str/str-eq value "µz")))
      (_ (assert false)))))

(deftest reports-arity-unbound-name-and-division-errors
  (let [a (alloc/malloc-allocator)]
    (assert (eval/eval-failed? (evaluate a "(+ 1)")))
    (assert (eval/eval-failed? (evaluate a "missing")))
    (assert (eval/eval-failed? (evaluate a "(/ 1 0)")))))
