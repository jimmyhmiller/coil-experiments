(module experiments.carp.managed-test)

(import "experiments.carp.surface" :as reader)
(import "experiments.carp.forms" :as forms)
(import "experiments.carp.resolve" :as resolve)
(import "experiments.carp.infer-engine" :as infer)
(import "experiments.carp.specialize" :as specialize)
(import "experiments.carp.managed" :as managed)
(import "experiments.carp.check" :as check)
(import "experiments.carp.borrow-check" :as borrow)
(import "experiments.carp.ownership-plan" :as ownership)
(import "experiments.carp.ir" :as ir)
(import "experiments.carp.types" :as types)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "coil.assert" :use *)

(deftest exact-delete-interface-makes-reached-type-owned
  (let [a (alloc/malloc-allocator)
        source "(register-type A) (defmodule A (register init (Fn [] A)) (register delete (Fn [A] ())) (implements delete A.delete)) (defn main [] (let [a (A.init)] ()))"
        lowered (forms/lower a "managed-test.carp" (reader/read a source))
        resolved-result (resolve/resolve a (.module lowered))]
    (assert (not (resolve/resolve-failed? resolved-result)))
    (let [resolved (alloc/box! a ir/ResolvedModule
                     (resolve/resolved-module resolved-result))
          inferred-result (infer/infer-module a resolved)]
      (assert (not (infer/inference-failed? inferred-result)))
      (let [inferred (alloc/box! a infer/InferredModule
                       (infer/inferred-module inferred-result))
            function (al/al-get [ir/ResolvedFunction]
                       (load (field resolved functions)) 0)
            arguments (types/type-arguments-new a)
            concrete (types/type-named a "A" (types/type-arguments-new a))
            signature (types/type-function a arguments (types/type-unit a))
            roots (alloc/box! a (al/ArrayList specialize/SpecializationRequest)
                    (al/al-new [specialize/SpecializationRequest] a))]
        (al/al-push! [specialize/SpecializationRequest] roots
          (specialize/SpecializationRequest :source (.reference function)
            :signature signature :reference (ir/core-ref 0 "" true)))
        (let [specialized-result (specialize/specialize-module
                                   a resolved inferred roots)]
          (assert (not (specialize/module-specialization-failed? specialized-result)))
          (let [specialized (alloc/box! a ir/SpecializedModule
                              (specialize/specialized-module specialized-result))
                (mut facts) (managed/build-ownership-facts
                              a resolved inferred specialized)]
            (match (borrow/ownership-classify concrete (mut facts))
              (borrow/OwnershipOwned [] (assert true))
              (_ (assert false)))
            (let [checked-result (check/check-module
                                   a resolved inferred specialized)]
              (assert (not (check/check-failed? checked-result)))
              (let [checked (check/checked-module checked-result)
                    function (al/al-get [check/CheckedFunction]
                               (.functions checked) 0)
                    plan (.plan function)
                    actions (field plan actions)]
                (assert-eq (al/al-len [ownership/OwnershipAction]
                             (load actions)) 1)
                (match (al/al-get [ownership/OwnershipAction]
                         (load actions) 0)
                  (ownership/ActionDelete [_ _ deleted-type]
                    (assert (types/type-same-representation?
                              deleted-type concrete)))
                  (_ (assert false)))))))))))
