(module experiments.carp.primitives)

;; Stable primitive identities and call arities shared by resolution and the
;; later typed/lowering registries. IDs mirror metacarp's pinned registry.

(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "coil.str" :as str)

(export PrimitiveBinding bindings binding-count max-id)

(defstruct PrimitiveBinding [(id i64) (name (slice u8)) (arity i64)])

(defn add! [(items (mut (al/ArrayList PrimitiveBinding)))
            (id i64) (name (slice u8)) (arity i64)] (-> i64)
  (al/al-push! [PrimitiveBinding] (mut items)
               (PrimitiveBinding :id id :name name :arity arity)))

(defn generated-name [(a (dyn alloc/Allocator)) (arity i64) (suffix (slice u8))]
  (-> (slice u8))
  (let [(mut out) (str/sb-new a)]
    (str/sb-push-str! (mut out) "Function.Arity")
    (str/sb-push-i64! (mut out) arity)
    (str/sb-push-str! (mut out) suffix)
    (str/sb-finish! (mut out))))

(defn bindings [(a (dyn alloc/Allocator))] (-> (al/ArrayList PrimitiveBinding))
  (let [(mut result) (al/al-new [PrimitiveBinding] a)]
    (add! (mut result) 0 "copy" 1)
    (add! (mut result) 1 "str" -1)
    (add! (mut result) 2 "prn" -1)
    (add! (mut result) 3 "delete" 1)
    (add! (mut result) 4 "Box.unbox" 1)
    (add! (mut result) 5 "ref" 1)
    (add! (mut result) 6 "deref" 1)
    (add! (mut result) 7 "NULL" -1)
    (add! (mut result) 8 "length" 1)
    (add! (mut result) 67 "Box.init" 1)
    (add! (mut result) 68 "Box.peek" 1)
    (add! (mut result) 69 "Box.str" 1)
    (add! (mut result) 9 "Array.length" 1)
    (add! (mut result) 10 "StaticArray.length" 1)
    (add! (mut result) 48 "get-tag" 1)
    (add! (mut result) 49 "field-set!" 4)
    (add! (mut result) 11 "unsafe-nth" 2)
    (add! (mut result) 12 "Array.unsafe-nth" 2)
    (add! (mut result) 13 "StaticArray.unsafe-nth" 2)
    (add! (mut result) 14 "allocate" 1)
    (add! (mut result) 15 "Array.allocate" 1)
    (add! (mut result) 16 "aset-uninitialized!" 3)
    (add! (mut result) 17 "Array.aset-uninitialized!" 3)
    (add! (mut result) 18 "StaticArray.aset-uninitialized!" 3)
    (add! (mut result) 21 "StaticArray.aset!" 3)
    (add! (mut result) 19 "aset!" 3)
    (add! (mut result) 20 "Array.aset!" 3)
    (add! (mut result) 30 "StaticArray.aset" 3)
    (add! (mut result) 29 "Array.aset" 3)
    (add! (mut result) 23 "Array.push-back" 2)
    (add! (mut result) 24 "push-back!" 2)
    (add! (mut result) 25 "Array.push-back!" 2)
    (add! (mut result) 27 "Array.pop-back" 1)
    (add! (mut result) 28 "aset" 3)
    (add! (mut result) 36 "endo-filter" 2)
    (add! (mut result) 37 "Array.endo-filter" 2)
    (add! (mut result) 39 "endo-map" 2)
    (add! (mut result) 40 "Array.endo-map" 2)
    (add! (mut result) 41 "Array.str" 1)
    (add! (mut result) 71 "StaticArray.str" 1)
    (add! (mut result) 50 "pop-back!" 1)
    (add! (mut result) 51 "Array.pop-back!" 1)
    (add! (mut result) 31 "Pair.init-from-refs" 2)
    (add! (mut result) 32 "Pair.a" 1)
    (add! (mut result) 33 "Pair.b" 1)
    (add! (mut result) 34 "Pair.set-b" 2)
    (add! (mut result) 35 "Pair.reverse" 1)
    (add! (mut result) 38 "Pair.init" 2)
    (add! (mut result) 42 "ignore" 1)
    (add! (mut result) 45 "Int.<=" 2)
    (add! (mut result) 46 "Int.>=" 2)
    (add! (mut result) 47 "Int./=" 2)
    (add! (mut result) 52 "Array.copy" 1)
    (add! (mut result) 53 "Box.copy" 1)
    (add! (mut result) 54 "Pointer.copy" 1)
    (add! (mut result) 65 "unsafe-raw" 1)
    (add! (mut result) 70 "Array.raw" 1)
    (add! (mut result) 66 "Pair.copy" 1)
    (add! (mut result) 72 "Array.delete" 1)
    (add! (mut result) 76 "Box.delete" 1)
    (add! (mut result) 73 "add-cflag" 1)
    (add! (mut result) 74 "add-lib" 1)
    (add! (mut result) 75 "add-pkg" 1)
    (let [(mut arity) 0]
      (loop (if (>= (load arity) 10) (break)
                (do (add! (mut result) (+ 55 (load arity))
                           (generated-name a (load arity) ".copy") 1)
                    (add! (mut result) (+ 120 (load arity))
                           (generated-name a (load arity) ".delete") 1)
                    (add! (mut result) (+ 100 (load arity))
                           (generated-name a (load arity) ".str") 1)
                    (add! (mut result) (+ 110 (load arity))
                           (generated-name a (load arity) ".prn") 1)
                    (store! arity (+ (load arity) 1))))))
    (load (mut result))))

(defn binding-count [(a (dyn alloc/Allocator))] (-> i64)
  (al/al-len [PrimitiveBinding] (bindings a)))

(defn max-id [] (-> i64) 129)
