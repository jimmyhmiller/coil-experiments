(module experiments.carp.graph)

;; Strongly connected components shared by Carp's resolver, inference, and
;; specialization phases. An edge points from a node to one of its dependencies;
;; `strong-components` therefore returns dependencies before their consumers.

(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)

(defstruct IntGraph
  [(edges (al/ArrayList (ptr (al/ArrayList i64))))
   (allocator (dyn alloc/Allocator))])

(defn int-graph-new [(a (dyn alloc/Allocator)) (node-count i64)] (-> IntGraph)
  (let [(mut edges) (al/al-new [(ptr (al/ArrayList i64))] a)
        (mut node) 0]
    (loop
      (if (>= (load node) node-count)
          (break)
          (let [neighbors (al/al-new [i64] a)]
            (al/al-push! (mut edges) (alloc/box! a (al/ArrayList i64) neighbors))
            (store! node (+ (load node) 1)))))
    (IntGraph :edges (load edges) :allocator a)))

(defn int-graph-node-count [(graph (ptr IntGraph))] (-> i64)
  (al/al-len [(ptr (al/ArrayList i64))] (load (field graph edges))))

(defn int-graph-add-edge! [(graph (ptr IntGraph)) (source i64) (dependency i64)] (-> i64)
  (let [neighbors (al/al-get [(ptr (al/ArrayList i64))]
                            (load (field graph edges))
                            source)]
    (al/al-push! [i64] neighbors dependency)))

(defn graph-visit-order! [(edges (ptr (al/ArrayList (ptr (al/ArrayList i64)))))
                          (node i64)
                          (visited (ptr (al/ArrayList bool)))
                          (order (ptr (al/ArrayList i64)))] (-> i64)
  (if (al/al-get [bool] (load visited) node)
      0
      (do
        (al/al-set! [bool] visited node true)
        (let [neighbors (al/al-get [(ptr (al/ArrayList i64))] (load edges) node)
              n (al/al-len [i64] (load neighbors))
              (mut i) 0]
          (loop
            (if (>= (load i) n)
                (break)
                (do
                  (graph-visit-order! edges
                                      (al/al-get [i64] (load neighbors) (load i))
                                      visited
                                      order)
                  (store! i (+ (load i) 1))))))
        (al/al-push! order node))))

(defn graph-collect-component!
  [(edges (ptr (al/ArrayList (ptr (al/ArrayList i64)))))
   (node i64)
   (visited (ptr (al/ArrayList bool)))
   (component (ptr (al/ArrayList i64)))] (-> i64)
  (if (al/al-get [bool] (load visited) node)
      0
      (do
        (al/al-set! [bool] visited node true)
        (al/al-push! component node)
        (let [neighbors (al/al-get [(ptr (al/ArrayList i64))] (load edges) node)
              n (al/al-len [i64] (load neighbors))
              (mut i) 0]
          (loop
            (if (>= (load i) n)
                (break)
                (do
                  (graph-collect-component! edges
                                            (al/al-get [i64] (load neighbors) (load i))
                                            visited
                                            component)
                  (store! i (+ (load i) 1))))))
        0)))

(defn graph-transpose [(a (dyn alloc/Allocator))
                       (edges (ptr (al/ArrayList (ptr (al/ArrayList i64)))))]
  (-> (al/ArrayList (ptr (al/ArrayList i64))))
  (let [n (al/al-len [(ptr (al/ArrayList i64))] (load edges))
        (mut result) (al/al-new [(ptr (al/ArrayList i64))] a)
        (mut node) 0]
    (loop
      (if (>= (load node) n)
          (break)
          (let [neighbors (al/al-new [i64] a)]
            (al/al-push! (mut result) (alloc/box! a (al/ArrayList i64) neighbors))
            (store! node (+ (load node) 1)))))
    (store! node 0)
    (loop
      (if (>= (load node) n)
          (break)
          (let [neighbors (al/al-get [(ptr (al/ArrayList i64))] (load edges) (load node))
                m (al/al-len [i64] (load neighbors))
                (mut i) 0]
            (loop
              (if (>= (load i) m)
                  (break)
                  (let [dependency (al/al-get [i64] (load neighbors) (load i))
                        destinations (al/al-get [(ptr (al/ArrayList i64))]
                                                (load result)
                                                dependency)]
                    (al/al-push! [i64] destinations (load node))
                    (store! i (+ (load i) 1)))))
            (store! node (+ (load node) 1)))))
    (load result)))

(defn int-graph-strong-components [(graph (ptr IntGraph))]
  (-> (al/ArrayList (ptr (al/ArrayList i64))))
  (let [a (load (field graph allocator))
        edges (field graph edges)
        n (al/al-len [(ptr (al/ArrayList i64))] (load edges))
        (mut reversed) (graph-transpose a edges)
        (mut visited) (al/al-new [bool] a)
        (mut order) (al/al-new [i64] a)
        (mut components) (al/al-new [(ptr (al/ArrayList i64))] a)
        (mut node) 0]
    (loop
      (if (>= (load node) n)
          (break)
          (do
            (al/al-push! (mut visited) false)
            (store! node (+ (load node) 1)))))
    (store! node 0)
    (loop
      (if (>= (load node) n)
          (break)
          (do
            (graph-visit-order! (mut reversed) (load node) (mut visited) (mut order))
            (store! node (+ (load node) 1)))))
    (store! node 0)
    (loop
      (if (>= (load node) n)
          (break)
          (do
            (al/al-set! [bool] (mut visited) (load node) false)
            (store! node (+ (load node) 1)))))
    (let [(mut offset) 0]
      (loop
        (if (>= (load offset) n)
            (break)
            (let [ordered-node (al/al-get [i64] (load order) (- (- n 1) (load offset)))]
              (if (al/al-get [bool] (load visited) ordered-node)
                  0
                  (let [(mut component) (al/al-new [i64] a)]
                    (graph-collect-component! edges ordered-node (mut visited) (mut component))
                    (al/al-push! (mut components)
                                 (alloc/box! a (al/ArrayList i64) (load component)))))
              (store! offset (+ (load offset) 1))))))
    (load components)))
