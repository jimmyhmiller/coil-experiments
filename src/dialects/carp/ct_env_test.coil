(module experiments.carp.ct-env-test)

(import "experiments.carp.ct-env" :as env)
(import "coil.alloc" :as alloc)
(import "coil.assert" :use *)

(deftest lexical-shadowing-and-mutation-use-stable-cells
  (let [a (alloc/malloc-allocator)
        (mut store) (env/env-new [i64] a)
        root (env/root! [i64] (mut store))
        root-cell (env/define! [i64] (mut store) root "x" 10)
        child (env/child! [i64] (mut store) root)]
    (assert-eq (env/lookup [i64] (mut store) child "x") 10)
    (env/define! [i64] (mut store) child "x" 20)
    (assert-eq (env/lookup [i64] (mut store) child "x") 20)
    (assert-eq (env/read-cell [i64] (mut store) root-cell) 10)
    (assert (env/set! [i64] (mut store) child "x" 21))
    (assert-eq (env/lookup [i64] (mut store) child "x") 21)))

(deftest imports-resolve-and-report-ambiguity
  (let [a (alloc/malloc-allocator)
        (mut store) (env/env-new [i64] a)
        target (env/root! [i64] (mut store))
        left (env/root! [i64] (mut store))
        right (env/root! [i64] (mut store))]
    (env/define! [i64] (mut store) left "value" 1)
    (env/define! [i64] (mut store) right "value" 2)
    (assert (env/add-import! [i64] (mut store) target left))
    (assert-eq (env/lookup [i64] (mut store) target "value") 1)
    (assert (env/add-import! [i64] (mut store) target right))
    (match (env/lookup-status [i64] (mut store) target "value")
      (env/LookupAmbiguous [] (assert true))
      (_ (assert false)))))

(deftest aliases-share-one-mutable-cell
  (let [a (alloc/malloc-allocator)
        (mut store) (env/env-new [i64] a)
        source (env/root! [i64] (mut store))
        target (env/root! [i64] (mut store))
        cell (env/define! [i64] (mut store) source "original" 7)]
    (assert (env/bind-cell! [i64] (mut store) target "alias" cell))
    (assert (env/set! [i64] (mut store) target "alias" 9))
    (assert-eq (env/lookup [i64] (mut store) source "original") 9)))

(deftest invalid-identities-do-not-corrupt-the-store
  (let [a (alloc/malloc-allocator)
        (mut store) (env/env-new [i64] a)
        invalid-frame (env/FrameId :index 99)
        invalid-cell (env/CellId :index 99)]
    (assert (not (env/bind-cell! [i64] (mut store) invalid-frame "x" invalid-cell)))
    (assert-eq (env/frame-count [i64] (mut store)) 0)
    (assert-eq (env/cell-count [i64] (mut store)) 0)))
