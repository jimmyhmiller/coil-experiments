(module experiments.carp.types-test)

(import "coil.alloc" :use [malloc-allocator])
(import "coil.assert" :use *)
(import "experiments.carp.types" :use *)

(defn unary-type [(a (dyn coil.alloc.Allocator))
                  (argument (ptr MonoType))
                  (result (ptr MonoType))] (-> (ptr MonoType))
  (let [arguments (type-arguments-new a)]
    (type-arguments-push! arguments argument)
    (type-function a arguments result)))

(deftest variable-unification
  (let [a (malloc-allocator)
        (mut solver) (type-solver-new a)
        variable (type-variable a 0)
        integer (type-integer a)]
    (assert (unify-success? (type-unify! (mut solver) variable integer)))
    (assert (type-same? (type-resolve (mut solver) variable) integer))))

(deftest symmetric-variable-unification
  (let [a (malloc-allocator)
        (mut solver) (type-solver-new a)
        variable (type-variable a 0)
        integer (type-integer a)]
    (assert (unify-success? (type-unify! (mut solver) integer variable)))
    (assert (type-same? (type-resolve (mut solver) variable) integer))))

(deftest occurs-check
  (let [a (malloc-allocator)
        (mut solver) (type-solver-new a)
        variable (type-variable a 0)
        function (unary-type a variable (type-integer a))]
    (assert (not (unify-success? (type-unify! (mut solver) variable function))))))

(deftest function-unification
  (let [a (malloc-allocator)
        (mut solver) (type-solver-new a)
        variable (type-variable a 0)
        generic (unary-type a variable variable)
        string-type (type-string a)
        concrete (unary-type a string-type string-type)]
    (assert (unify-success? (type-unify! (mut solver) generic concrete)))
    (assert (type-same? (type-resolve (mut solver) variable) string-type))))

(deftest nominal-reference-unification
  (let [a (malloc-allocator)
        generic-arguments (type-arguments-new a)
        concrete-arguments (type-arguments-new a)
        variable (type-variable a 0)
        integer (type-integer a)]
    (type-arguments-push! generic-arguments variable)
    (type-arguments-push! concrete-arguments integer)
    (let [generic (type-reference a
                                  (type-named a "Array" generic-arguments)
                                  (lifetime-variable 1))
          concrete (type-reference a
                                   (type-named a "Array" concrete-arguments)
                                   (lifetime-variable 2))
          (mut solver) (type-solver-new a)]
      (assert (unify-success? (type-unify! (mut solver) generic concrete)))
      (assert (type-same? (type-resolve (mut solver) variable) integer)))))

(deftest lifetimes-affect-identity-not-representation
  (let [a (malloc-allocator)
        left (type-reference a (type-integer a) (lifetime-variable 0))
        right (type-reference a (type-integer a) (lifetime-variable 1))]
    (assert (not (type-same? left right)))
    (assert (type-same-representation? left right))
    (let [(mut solver) (type-solver-new a)]
      (assert (unify-success? (type-unify! (mut solver) left right)))
      (assert (lifetime-same?
                (lifetime-resolve (mut solver) (lifetime-variable 0))
                (lifetime-resolve (mut solver) (lifetime-variable 1)))))))

(deftest constructor-variable-unification
  (let [a (malloc-allocator)
        left-arguments (type-arguments-new a)
        right-arguments (type-arguments-new a)]
    (type-arguments-push! left-arguments (type-integer a))
    (type-arguments-push! right-arguments (type-integer a))
    (let [left (type-named a "f" left-arguments)
          right (type-named a "Array" right-arguments)
          (mut solver) (type-solver-new a)]
      (assert (unify-success? (type-unify! (mut solver) left right)))
      (assert-eq (constructor-resolve (mut solver) "f") "Array"))))

(deftest unit-unification
  (let [a (malloc-allocator)
        (mut solver) (type-solver-new a)]
    (assert (unify-success?
              (type-unify! (mut solver) (type-unit a) (type-unit a))))))

(deftest cloning-through-a-solver-substitutes-nested-types
  (let [a (malloc-allocator)
        variable (type-variable a 17)
        arguments (type-arguments-new a)]
    (type-arguments-push! arguments variable)
    (let [generic-array (type-named a "Array" arguments)
          generic (type-reference a generic-array (lifetime-variable 9))
          concrete-arguments (type-arguments-new a)]
      (type-arguments-push! concrete-arguments (type-string a))
      (let [concrete (type-reference a (type-named a "Array" concrete-arguments)
                                    (lifetime-static))
            (mut solver) (type-solver-new a)]
        (assert (unify-success? (type-unify! (mut solver) generic concrete)))
        (assert (type-same?
                  (type-clone-resolved a (mut solver) generic) concrete))))))
