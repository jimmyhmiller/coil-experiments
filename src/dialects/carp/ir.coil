(module experiments.carp.ir)

;; Typed, specialization-ready expression IR. Every expression and binding has
;; a stable identity; ownership plans key actions by those identities rather
;; than source spelling or array position.

(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "experiments.carp.types" :as types)

(defstruct CoreRef [(id i64) (name (slice u8)) (global bool)])
(defstruct CoreImplementation [(interface CoreRef) (implementation CoreRef)])

(defsum ResolvedType
  (ResolvedTypeName [(name (slice u8))])
  (ResolvedTypeApply [(name (slice u8))
                      (arguments (ptr (al/ArrayList (ptr ResolvedType))))]))

(defsum ResolvedPattern
  (ResolvedPatternIgnore [])
  (ResolvedPatternBind [(binding CoreRef)])
  (ResolvedPatternConstructor
    [(constructor CoreRef)
     (arguments (ptr (al/ArrayList (ptr ResolvedPattern))))])
  (ResolvedPatternInt [(value i64)])
  (ResolvedPatternBool [(value bool)]))

(defstruct ResolvedMatchBranch
  [(pattern (ptr ResolvedPattern))
   (bindings (ptr (al/ArrayList CoreRef)))
   (body (ptr ResolvedExpr))])

;;; Untyped core produced by name resolution. Literal payloads and source-level
;;; control flow are retained until inference; every reference is already a
;;; stable binding identity, so later phases never recover identity from text.
(defsum ResolvedExpr
  (ResolvedInt [(id i64) (value i64)])
  (ResolvedByte [(id i64) (value i64)])
  (ResolvedLong [(id i64) (value i64)])
  (ResolvedFloat [(id i64) (value f64)])
  (ResolvedDouble [(id i64) (value f64)])
  (ResolvedBool [(id i64) (value bool)])
  (ResolvedChar [(id i64) (value i64)])
  (ResolvedString [(id i64) (value (slice u8))])
  (ResolvedPattern [(id i64) (value (slice u8))])
  (ResolvedUnit [(id i64)])
  (ResolvedReference [(id i64) (binding CoreRef)])
  (ResolvedOverload [(id i64)
                     (name (slice u8))
                     (candidates (ptr (al/ArrayList CoreRef)))])
  (ResolvedCall [(id i64)
                 (callee (ptr ResolvedExpr))
                 (arguments (ptr (al/ArrayList (ptr ResolvedExpr))))])
  (ResolvedDo [(id i64)
               (expressions (ptr (al/ArrayList (ptr ResolvedExpr))))])
  (ResolvedIf [(id i64)
               (condition (ptr ResolvedExpr))
               (then-branch (ptr ResolvedExpr))
               (else-branch (ptr ResolvedExpr))])
  (ResolvedLet [(id i64)
                (binding CoreRef)
                (value (ptr ResolvedExpr))
                (body (ptr ResolvedExpr))])
  (ResolvedSet [(id i64) (binding CoreRef) (value (ptr ResolvedExpr))])
  (ResolvedWhile [(id i64)
                  (condition (ptr ResolvedExpr))
                  (body (ptr ResolvedExpr))])
  (ResolvedBreak [(id i64)])
  (ResolvedLambda [(id i64)
                   (parameters (ptr (al/ArrayList CoreRef)))
                   (body (ptr ResolvedExpr))])
  (ResolvedAnnotation [(id i64)
                       (inner (ptr ResolvedExpr))
                       (type (ptr ResolvedType))])
  (ResolvedMatch [(id i64)
                  (by-reference bool)
                  (scrutinee (ptr ResolvedExpr))
                  (branches (ptr (al/ArrayList ResolvedMatchBranch)))])
  (ResolvedArray [(id i64)
                  (items (ptr (al/ArrayList (ptr ResolvedExpr))))
                  (static bool)]))

(defstruct ResolvedFunction
  [(reference CoreRef)
   (parameters (ptr (al/ArrayList CoreRef)))
   (body (ptr ResolvedExpr))])
(defstruct ResolvedValue [(reference CoreRef) (body (ptr ResolvedExpr))])
(defstruct ResolvedConstructor
  [(reference CoreRef) (fields (ptr (al/ArrayList (ptr ResolvedType))))])
(defsum ResolvedTypeShape
  (ResolvedStructShape [(field-names (ptr (al/ArrayList (slice u8))))
                        (constructor CoreRef)])
  (ResolvedSumShape [(constructors (ptr (al/ArrayList ResolvedConstructor)))]))
(defstruct ResolvedTypeDefinition
  [(name (slice u8)) (type (ptr ResolvedType))
   (fields (ptr (al/ArrayList (ptr ResolvedType))))
   (shape ResolvedTypeShape)])
(defsum ResolvedSignatureKind
  (ResolvedBuiltinSignature [])
  (ResolvedConstructorSignature [])
  (ResolvedDefinitionSignature [])
  (ResolvedInterfaceSignature [])
  (ResolvedTemplateSignature []))
(defstruct ResolvedSignature
  [(reference CoreRef)
   (type (ptr ResolvedType))
   (kind ResolvedSignatureKind)])
(defstruct ResolvedModule
  [(functions (al/ArrayList ResolvedFunction))
   (values (al/ArrayList ResolvedValue))
   (types (al/ArrayList ResolvedTypeDefinition))
   (signatures (al/ArrayList ResolvedSignature))
   (implementations (al/ArrayList CoreImplementation))
   (expressions (al/ArrayList (ptr ResolvedExpr)))])

(defn resolved-expression-id [(expression (ptr ResolvedExpr))] (-> i64)
  (match (load expression)
    (ResolvedInt [id _] id)
    (ResolvedByte [id _] id)
    (ResolvedLong [id _] id)
    (ResolvedFloat [id _] id)
    (ResolvedDouble [id _] id)
    (ResolvedBool [id _] id)
    (ResolvedChar [id _] id)
    (ResolvedString [id _] id)
    (ResolvedPattern [id _] id)
    (ResolvedUnit [id] id)
    (ResolvedReference [id _] id)
    (ResolvedOverload [id _ _] id)
    (ResolvedCall [id _ _] id)
    (ResolvedDo [id _] id)
    (ResolvedIf [id _ _ _] id)
    (ResolvedLet [id _ _ _] id)
    (ResolvedSet [id _ _] id)
    (ResolvedWhile [id _ _] id)
    (ResolvedBreak [id] id)
    (ResolvedLambda [id _ _] id)
    (ResolvedAnnotation [id _ _] id)
    (ResolvedMatch [id _ _ _] id)
    (ResolvedArray [id _ _] id)))

(defn resolved-expression-box [(a (dyn alloc/Allocator)) (expression ResolvedExpr)]
  (-> (ptr ResolvedExpr))
  (alloc/box! a ResolvedExpr expression))

(defn resolved-expression-list-new [(a (dyn alloc/Allocator))]
  (-> (ptr (al/ArrayList (ptr ResolvedExpr))))
  (alloc/box! a (al/ArrayList (ptr ResolvedExpr))
              (al/al-new [(ptr ResolvedExpr)] a)))

(defn resolved-type-box [(a (dyn alloc/Allocator)) (type ResolvedType)]
  (-> (ptr ResolvedType))
  (alloc/box! a ResolvedType type))

(defn resolved-type-list-new [(a (dyn alloc/Allocator))]
  (-> (ptr (al/ArrayList (ptr ResolvedType))))
  (alloc/box! a (al/ArrayList (ptr ResolvedType))
              (al/al-new [(ptr ResolvedType)] a)))

(defn resolved-pattern-box [(a (dyn alloc/Allocator)) (pattern ResolvedPattern)]
  (-> (ptr ResolvedPattern))
  (alloc/box! a ResolvedPattern pattern))

(defn resolved-pattern-list-new [(a (dyn alloc/Allocator))]
  (-> (ptr (al/ArrayList (ptr ResolvedPattern))))
  (alloc/box! a (al/ArrayList (ptr ResolvedPattern))
              (al/al-new [(ptr ResolvedPattern)] a)))

(defn resolved-branch-list-new [(a (dyn alloc/Allocator))]
  (-> (ptr (al/ArrayList ResolvedMatchBranch)))
  (alloc/box! a (al/ArrayList ResolvedMatchBranch)
              (al/al-new [ResolvedMatchBranch] a)))

(defsum SpecializedPattern
  (SpecializedPatternIgnore [])
  (SpecializedPatternBind [(binding CoreRef)])
  (SpecializedPatternConstructor
    [(constructor CoreRef)
     (arguments (ptr (al/ArrayList (ptr SpecializedPattern))))])
  (SpecializedPatternInt [(value i64)])
  (SpecializedPatternBool [(value bool)]))

(defstruct SpecializedMatchBranch
  [(pattern (ptr SpecializedPattern))
   (bindings (ptr (al/ArrayList CoreRef)))
   (binding-types (ptr (al/ArrayList (ptr types/MonoType))))
   (body (ptr SpecializedExpr))])

(defsum SpecializedExpr
  (ExprLiteral [(id i64) (type (ptr types/MonoType))])
  (ExprInt [(id i64) (type (ptr types/MonoType)) (value i64)])
  (ExprByte [(id i64) (type (ptr types/MonoType)) (value i64)])
  (ExprLong [(id i64) (type (ptr types/MonoType)) (value i64)])
  (ExprFloat [(id i64) (type (ptr types/MonoType)) (value f64)])
  (ExprDouble [(id i64) (type (ptr types/MonoType)) (value f64)])
  (ExprBool [(id i64) (type (ptr types/MonoType)) (value bool)])
  (ExprChar [(id i64) (type (ptr types/MonoType)) (value i64)])
  (ExprString [(id i64) (type (ptr types/MonoType)) (value (slice u8))])
  (ExprPattern [(id i64) (type (ptr types/MonoType)) (value (slice u8))])
  (ExprUnit [(id i64) (type (ptr types/MonoType))])
  (ExprReference [(id i64) (type (ptr types/MonoType)) (binding CoreRef)])
  (ExprBorrow [(id i64)
               (type (ptr types/MonoType))
               (operand (ptr SpecializedExpr))])
  (ExprGlobalCall [(id i64)
                   (type (ptr types/MonoType))
                   (callee CoreRef)
                   (signature (ptr types/MonoType))
                   (arguments (ptr (al/ArrayList (ptr SpecializedExpr))))])
  (ExprCall [(id i64)
             (type (ptr types/MonoType))
             (callee (ptr SpecializedExpr))
             (arguments (ptr (al/ArrayList (ptr SpecializedExpr))))])
  (ExprDo [(id i64)
           (type (ptr types/MonoType))
           (expressions (ptr (al/ArrayList (ptr SpecializedExpr))))])
  (ExprIf [(id i64)
           (type (ptr types/MonoType))
           (condition (ptr SpecializedExpr))
           (then-branch (ptr SpecializedExpr))
           (else-branch (ptr SpecializedExpr))])
  (ExprLet [(id i64)
            (type (ptr types/MonoType))
            (binding CoreRef)
            (value (ptr SpecializedExpr))
            (body (ptr SpecializedExpr))])
  (ExprSet [(id i64)
            (type (ptr types/MonoType))
            (binding CoreRef)
            (value (ptr SpecializedExpr))])
  (ExprWhile [(id i64)
              (type (ptr types/MonoType))
              (condition (ptr SpecializedExpr))
              (body (ptr SpecializedExpr))])
  (ExprBreak [(id i64) (type (ptr types/MonoType))])
  (ExprLambda [(id i64)
               (type (ptr types/MonoType))
               (parameters (ptr (al/ArrayList CoreRef)))
               (body (ptr SpecializedExpr))])
  (ExprMatch [(id i64)
              (type (ptr types/MonoType))
              (by-reference bool)
              (scrutinee (ptr SpecializedExpr))
              (branches (ptr (al/ArrayList SpecializedMatchBranch)))])
  (ExprAnnotation [(id i64)
                   (type (ptr types/MonoType))
                   (inner (ptr SpecializedExpr))])
  (ExprArray [(id i64)
              (type (ptr types/MonoType))
              (items (ptr (al/ArrayList (ptr SpecializedExpr))))
              (static bool)]))

(defstruct SpecializedFunction
  [(source CoreRef) (reference CoreRef)
   (signature (ptr types/MonoType))
   (parameters (ptr (al/ArrayList CoreRef)))
   (parameter-types (ptr (al/ArrayList (ptr types/MonoType))))
   (body (ptr SpecializedExpr))])

(defstruct SpecializedValue
  [(source CoreRef) (reference CoreRef)
   (type (ptr types/MonoType)) (body (ptr SpecializedExpr))])

(defstruct SpecializedModule
  [(functions (al/ArrayList SpecializedFunction))
   (values (al/ArrayList SpecializedValue))])

(defn core-ref [(id i64) (name (slice u8)) (global bool)] (-> CoreRef)
  (CoreRef :id id :name name :global global))

(defn core-ref-same? [(left CoreRef) (right CoreRef)] (-> bool)
  (and (= (load (field left id)) (load (field right id)))
       (= (load (field left global)) (load (field right global)))))

(defn core-ref-id [(reference CoreRef)] (-> i64)
  (load (field reference id)))

(defn core-ref-global? [(reference CoreRef)] (-> bool)
  (load (field reference global)))

(defn expression-box [(a (dyn alloc/Allocator)) (expression SpecializedExpr)]
  (-> (ptr SpecializedExpr))
  (alloc/box! a SpecializedExpr expression))

(defn expression-list-new [(a (dyn alloc/Allocator))]
  (-> (ptr (al/ArrayList (ptr SpecializedExpr))))
  (alloc/box! a
              (al/ArrayList (ptr SpecializedExpr))
              (al/al-new [(ptr SpecializedExpr)] a)))

(defn expression-list-push! [(expressions (ptr (al/ArrayList (ptr SpecializedExpr))))
                             (expression (ptr SpecializedExpr))] (-> i64)
  (al/al-push! [(ptr SpecializedExpr)] expressions expression))

(defn core-ref-list-new [(a (dyn alloc/Allocator))]
  (-> (ptr (al/ArrayList CoreRef)))
  (alloc/box! a (al/ArrayList CoreRef) (al/al-new [CoreRef] a)))

(defn core-ref-list-push! [(references (ptr (al/ArrayList CoreRef)))
                           (reference CoreRef)] (-> i64)
  (al/al-push! [CoreRef] references reference))

(defn branch-list-new [(a (dyn alloc/Allocator))]
  (-> (ptr (al/ArrayList SpecializedMatchBranch)))
  (alloc/box! a
              (al/ArrayList SpecializedMatchBranch)
              (al/al-new [SpecializedMatchBranch] a)))

(defn branch-list-push! [(branches (ptr (al/ArrayList SpecializedMatchBranch)))
                         (branch SpecializedMatchBranch)] (-> i64)
  (al/al-push! [SpecializedMatchBranch] branches branch))

(defn specialized-pattern-box [(a (dyn alloc/Allocator))
                                (pattern SpecializedPattern)]
  (-> (ptr SpecializedPattern))
  (alloc/box! a SpecializedPattern pattern))

(defn specialized-pattern-list-new [(a (dyn alloc/Allocator))]
  (-> (ptr (al/ArrayList (ptr SpecializedPattern))))
  (alloc/box! a (al/ArrayList (ptr SpecializedPattern))
    (al/al-new [(ptr SpecializedPattern)] a)))

(defn specialized-pattern-list-push!
  [(patterns (ptr (al/ArrayList (ptr SpecializedPattern))))
   (pattern (ptr SpecializedPattern))] (-> i64)
  (al/al-push! [(ptr SpecializedPattern)] patterns pattern))

(defn expression-id [(expression (ptr SpecializedExpr))] (-> i64)
  (match (load expression)
    (ExprLiteral [id _] id)
    (ExprInt [id _ _] id) (ExprByte [id _ _] id)
    (ExprLong [id _ _] id) (ExprFloat [id _ _] id)
    (ExprDouble [id _ _] id) (ExprBool [id _ _] id)
    (ExprChar [id _ _] id) (ExprString [id _ _] id)
    (ExprPattern [id _ _] id) (ExprUnit [id _] id)
    (ExprReference [id _ _] id)
    (ExprBorrow [id _ _] id)
    (ExprGlobalCall [id _ _ _ _] id)
    (ExprCall [id _ _ _] id)
    (ExprDo [id _ _] id)
    (ExprIf [id _ _ _ _] id)
    (ExprLet [id _ _ _ _] id)
    (ExprSet [id _ _ _] id)
    (ExprWhile [id _ _ _] id)
    (ExprBreak [id _] id)
    (ExprLambda [id _ _ _] id)
    (ExprMatch [id _ _ _ _] id)
    (ExprAnnotation [id _ _] id)
    (ExprArray [id _ _ _] id)))

(defn expression-type [(expression (ptr SpecializedExpr))]
  (-> (ptr types/MonoType))
  (match (load expression)
    (ExprLiteral [_ type] type)
    (ExprInt [_ type _] type) (ExprByte [_ type _] type)
    (ExprLong [_ type _] type) (ExprFloat [_ type _] type)
    (ExprDouble [_ type _] type) (ExprBool [_ type _] type)
    (ExprChar [_ type _] type) (ExprString [_ type _] type)
    (ExprPattern [_ type _] type) (ExprUnit [_ type] type)
    (ExprReference [_ type _] type)
    (ExprBorrow [_ type _] type)
    (ExprGlobalCall [_ type _ _ _] type)
    (ExprCall [_ type _ _] type)
    (ExprDo [_ type _] type)
    (ExprIf [_ type _ _ _] type)
    (ExprLet [_ type _ _ _] type)
    (ExprSet [_ type _ _] type)
    (ExprWhile [_ type _ _] type)
    (ExprBreak [_ type] type)
    (ExprLambda [_ type _ _] type)
    (ExprMatch [_ type _ _ _] type)
    (ExprAnnotation [_ type _] type)
    (ExprArray [_ type _ _] type)))

(defn expression-literal [(a (dyn alloc/Allocator))
                          (id i64)
                          (type (ptr types/MonoType))] (-> (ptr SpecializedExpr))
  (expression-box a (ExprLiteral id type)))

(defn expression-reference [(a (dyn alloc/Allocator))
                            (id i64)
                            (type (ptr types/MonoType))
                            (binding CoreRef)] (-> (ptr SpecializedExpr))
  (expression-box a (ExprReference id type binding)))

(defn expression-borrow [(a (dyn alloc/Allocator))
                         (id i64)
                         (type (ptr types/MonoType))
                         (operand (ptr SpecializedExpr))] (-> (ptr SpecializedExpr))
  (expression-box a (ExprBorrow id type operand)))
