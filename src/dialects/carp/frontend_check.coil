(module experiments.carp.frontend-check)

;; Front-end diagnostic entry point used to audit real Carp source trees. This
;; intentionally stops after reading and semantic surface lowering; it is not
;; the compatibility compiler driver and must not be used as one by the corpus
;; outcome harness.

(import "experiments.carp.surface" :as reader)
(import "experiments.carp.forms" :as forms)
(import "coil.alloc" :as alloc)
(import "coil.args" :as args)
(import "coil.fs" :as fs)
(import "coil.io" :use [stderr print-str])
(import "coil.result" :use *)
(import "coil.str" :as str)

(defn check-file [(a (dyn alloc/Allocator)) (path (slice u8))] (-> bool)
  (match (fs/read-file a path)
    (Err [_]
      (do (println "{s}: cannot read" path) false))
    (Ok [source]
      (let [read-result (reader/read a source)]
        (if (reader/read-failed? read-result)
            (do (println "{s}:{d}:{d}: reader: {s}"
                         path (.line (.at read-result)) (.column (.at read-result))
                         (.message read-result))
                false)
            (let [lowered (forms/lower a path read-result)]
              (if (forms/lower-failed? lowered)
                  (do (println "{s}:{d}:{d}: surface: {s}"
                               path (.line (.start (.at lowered)))
                               (.column (.start (.at lowered))) (.message lowered))
                      false)
                  true)))))))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (do
    (args/args-set! argc argv)
    (if (< (args/args-count) 2)
        (do (print-str (stderr) "usage: carp-frontend-check FILE.carp...\n") 2)
        (let [a (alloc/malloc-allocator)
              (mut i) 1
              (mut failed) false]
          (loop (if (>= (load i) (args/args-count))
                    (break)
                    (do (if (not (check-file a (args/args-nth (load i))))
                            (store! failed true) 0)
                        (store! i (+ (load i) 1)))))
          (if (load failed) 1 0)))))
