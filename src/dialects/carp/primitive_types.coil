(module experiments.carp.primitive-types)

;; Compiler-owned type schemes for primitives that have no source `register`
;; declaration in Core. This is inference metadata for the stable identities in
;; primitives.coil, not expression-inference special casing.

(import "experiments.carp.infer" :as infer)
(import "experiments.carp.ir" :as ir)
(import "experiments.carp.types" :as types)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)

(export PrimitiveSchemeBinding bindings)

(defstruct PrimitiveSchemeBinding
  [(reference ir/CoreRef) (scheme infer/TypeScheme)])

(defn ids [(a (dyn alloc/Allocator)) (include bool)] (-> (ptr (al/ArrayList i64)))
  (let [result (alloc/box! a (al/ArrayList i64) (al/al-new [i64] a))]
    (if include (al/al-push! [i64] result -1) 0)
    result))

(defn arguments1 [(a (dyn alloc/Allocator)) (x (ptr types/MonoType))]
  (-> (ptr (al/ArrayList (ptr types/MonoType))))
  (let [result (types/type-arguments-new a)]
    (types/type-arguments-push! result x)
    result))

(defn arguments2 [(a (dyn alloc/Allocator)) (x (ptr types/MonoType))
                  (y (ptr types/MonoType))]
  (-> (ptr (al/ArrayList (ptr types/MonoType))))
  (let [result (types/type-arguments-new a)]
    (types/type-arguments-push! result x)
    (types/type-arguments-push! result y)
    result))

(defn arguments3 [(a (dyn alloc/Allocator)) (x (ptr types/MonoType))
                  (y (ptr types/MonoType)) (z (ptr types/MonoType))]
  (-> (ptr (al/ArrayList (ptr types/MonoType))))
  (let [result (types/type-arguments-new a)]
    (types/type-arguments-push! result x)
    (types/type-arguments-push! result y)
    (types/type-arguments-push! result z)
    result))

(defn named1 [(a (dyn alloc/Allocator)) (name (slice u8))
              (argument (ptr types/MonoType))] (-> (ptr types/MonoType))
  (types/type-named a name (arguments1 a argument)))

(defn variable [(a (dyn alloc/Allocator))] (-> (ptr types/MonoType))
  (types/type-variable a -1))

(defn scheme [(a (dyn alloc/Allocator)) (body (ptr types/MonoType))
              (type-variable bool) (lifetime-variable bool)] (-> infer/TypeScheme)
  (infer/TypeScheme :type-variables (ids a type-variable)
                    :lifetime-variables (ids a lifetime-variable)
                    :body body))

(defn scheme-two-types [(a (dyn alloc/Allocator)) (body (ptr types/MonoType))]
  (-> infer/TypeScheme)
  (let [variables (ids a true)]
    (al/al-push! [i64] variables -2)
    (infer/TypeScheme :type-variables variables
                      :lifetime-variables (ids a false)
                      :body body)))

(defn scheme-two-types-lifetime
  [(a (dyn alloc/Allocator)) (body (ptr types/MonoType))]
  (-> infer/TypeScheme)
  (let [variables (ids a true)]
    (al/al-push! [i64] variables -2)
    (infer/TypeScheme :type-variables variables
                      :lifetime-variables (ids a true)
                      :body body)))

(defn scheme-two-types-two-lifetimes
  [(a (dyn alloc/Allocator)) (body (ptr types/MonoType))]
  (-> infer/TypeScheme)
  (let [variables (ids a true) lifetimes (ids a true)]
    (al/al-push! [i64] variables -2)
    (al/al-push! [i64] lifetimes -2)
    (infer/TypeScheme :type-variables variables
                      :lifetime-variables lifetimes :body body)))

(defn scheme-type-two-lifetimes
  [(a (dyn alloc/Allocator)) (body (ptr types/MonoType))]
  (-> infer/TypeScheme)
  (let [lifetimes (ids a true)]
    (al/al-push! [i64] lifetimes -2)
    (infer/TypeScheme :type-variables (ids a true)
                      :lifetime-variables lifetimes
                      :body body)))

(defn unary [(a (dyn alloc/Allocator)) (id i64) (name (slice u8))
             (argument (ptr types/MonoType)) (result (ptr types/MonoType))
             (quantify-type bool) (quantify-lifetime bool)]
  (-> PrimitiveSchemeBinding)
  (PrimitiveSchemeBinding
    :reference (ir/core-ref id name true)
    :scheme (scheme a (types/type-function a (arguments1 a argument) result)
                    quantify-type quantify-lifetime)))

(defn binary [(a (dyn alloc/Allocator)) (id i64) (name (slice u8))
              (left (ptr types/MonoType)) (right (ptr types/MonoType))
              (result (ptr types/MonoType)) (quantify-type bool)]
  (-> PrimitiveSchemeBinding)
  (PrimitiveSchemeBinding
    :reference (ir/core-ref id name true)
    :scheme (scheme a (types/type-function a (arguments2 a left right) result)
                    quantify-type false)))

(defn unary-two-types [(a (dyn alloc/Allocator)) (id i64) (name (slice u8))]
  (-> PrimitiveSchemeBinding)
  (PrimitiveSchemeBinding
    :reference (ir/core-ref id name true)
    :scheme (scheme-two-types a
              (types/type-function a
                (arguments1 a (types/type-variable a -1))
                (types/type-variable a -2)))))

(defn pair-init-binding [(a (dyn alloc/Allocator)) (id i64)
                         (name (slice u8))] (-> PrimitiveSchemeBinding)
  (let [left (types/type-variable a -1) right (types/type-variable a -2)
        pair-arguments (arguments2 a left right)]
    (PrimitiveSchemeBinding
      :reference (ir/core-ref id name true)
      :scheme (scheme-two-types a
                (types/type-function a (arguments2 a left right)
                  (types/type-named a "Pair" pair-arguments))))))

(defn pair-init-from-refs-binding [(a (dyn alloc/Allocator)) (id i64)
                                   (name (slice u8))]
  (-> PrimitiveSchemeBinding)
  (let [left (types/type-variable a -1) right (types/type-variable a -2)]
    (PrimitiveSchemeBinding
      :reference (ir/core-ref id name true)
      :scheme (scheme-two-types-two-lifetimes a
                (types/type-function a
                  (arguments2 a
                    (types/type-reference a left (types/lifetime-variable -1))
                    (types/type-reference a right (types/lifetime-variable -2)))
                  (types/type-named a "Pair" (arguments2 a left right)))))))

(defn pair-set-b-binding [(a (dyn alloc/Allocator)) (id i64)
                          (name (slice u8))] (-> PrimitiveSchemeBinding)
  (let [left (types/type-variable a -1) right (types/type-variable a -2)
        pair (types/type-named a "Pair" (arguments2 a left right))]
    (PrimitiveSchemeBinding
      :reference (ir/core-ref id name true)
      :scheme (scheme-two-types a
                (types/type-function a (arguments2 a pair right) pair)))))

(defn pair-accessor-binding [(a (dyn alloc/Allocator)) (id i64)
                             (name (slice u8)) (right bool)]
  (-> PrimitiveSchemeBinding)
  (let [left (types/type-variable a -1) right-type (types/type-variable a -2)
        pair (types/type-named a "Pair" (arguments2 a left right-type))
        lifetime (types/lifetime-variable -1)]
    (PrimitiveSchemeBinding
      :reference (ir/core-ref id name true)
      :scheme (scheme-two-types-lifetime a
                (types/type-function a
                  (arguments1 a (types/type-reference a pair lifetime))
                  (types/type-reference a (if right right-type left) lifetime))))))

(defn pair-reverse-binding [(a (dyn alloc/Allocator)) (id i64)
                            (name (slice u8))] (-> PrimitiveSchemeBinding)
  (let [left (types/type-variable a -1) right (types/type-variable a -2)
        pair (types/type-named a "Pair" (arguments2 a left right))]
    (PrimitiveSchemeBinding
      :reference (ir/core-ref id name true)
      :scheme (scheme-two-types-lifetime a
                (types/type-function a
                  (arguments1 a (types/type-reference a pair
                                  (types/lifetime-variable -1)))
                  (types/type-named a "Pair" (arguments2 a right left)))))))

(defn array-endo-filter-binding [(a (dyn alloc/Allocator)) (id i64)
                                 (name (slice u8))]
  (-> PrimitiveSchemeBinding)
  (let [element (types/type-variable a -1)
        array (named1 a "Array" element)
        predicate (types/type-function a
                    (arguments1 a
                      (types/type-reference a element
                                            (types/lifetime-variable -1)))
                    (types/type-boolean a))]
    (PrimitiveSchemeBinding
      :reference (ir/core-ref id name true)
      :scheme (scheme-type-two-lifetimes a
                (types/type-function a
                  (arguments2 a
                    (types/type-reference a predicate
                                          (types/lifetime-variable -2))
                    array)
                  array)))))

(defn array-endo-map-binding [(a (dyn alloc/Allocator)) (id i64)
                              (name (slice u8))]
  (-> PrimitiveSchemeBinding)
  (let [element (types/type-variable a -1)
        array (named1 a "Array" element)
        mapper (types/type-function a (arguments1 a element) element)]
    (PrimitiveSchemeBinding
      :reference (ir/core-ref id name true)
      :scheme (scheme a
                (types/type-function a
                  (arguments2 a
                    (types/type-reference a mapper
                                          (types/lifetime-variable -1))
                    array)
                  array)
                true true))))

(defn collection-ref-to-string-binding
  [(a (dyn alloc/Allocator)) (id i64) (name (slice u8))
   (collection-name (slice u8))]
  (-> PrimitiveSchemeBinding)
  (let [collection (named1 a collection-name (types/type-variable a -1))]
    (PrimitiveSchemeBinding
      :reference (ir/core-ref id name true)
      :scheme (scheme a
                (types/type-function a
                  (arguments1 a
                    (types/type-reference a collection
                                          (types/lifetime-variable -1)))
                  (types/type-string a))
                true true))))

(defn array-pop-back-bang-binding [(a (dyn alloc/Allocator)) (id i64)
                                   (name (slice u8))]
  (-> PrimitiveSchemeBinding)
  (let [element (types/type-variable a -1)
        array (named1 a "Array" element)]
    (PrimitiveSchemeBinding
      :reference (ir/core-ref id name true)
      :scheme (scheme a
                (types/type-function a
                  (arguments1 a
                    (types/type-reference a array (types/lifetime-variable -1)))
                  element)
                true true))))

(defn named-ref-copy-binding [(a (dyn alloc/Allocator)) (id i64)
                              (name (slice u8)) (type-name (slice u8))]
  (-> PrimitiveSchemeBinding)
  (let [value (named1 a type-name (types/type-variable a -1))]
    (PrimitiveSchemeBinding
      :reference (ir/core-ref id name true)
      :scheme (scheme a
                (types/type-function a
                  (arguments1 a
                    (types/type-reference a value (types/lifetime-variable -1)))
                  value)
                true true))))

(defn generic-set-binding [(a (dyn alloc/Allocator)) (id i64)
                           (name (slice u8))] (-> PrimitiveSchemeBinding)
  (let [collection (types/type-variable a -1) element (types/type-variable a -2)]
    (PrimitiveSchemeBinding
      :reference (ir/core-ref id name true)
      :scheme (scheme-two-types a
                (types/type-function a
                  (arguments3 a collection (types/type-integer a) element)
                  (types/type-unit a))))))

(defn indexed-set-binding [(a (dyn alloc/Allocator)) (id i64)
                           (name (slice u8)) (collection-name (slice u8))]
  (-> PrimitiveSchemeBinding)
  (let [element (types/type-variable a -1)
        collection (named1 a collection-name element)]
    (PrimitiveSchemeBinding
      :reference (ir/core-ref id name true)
      :scheme (scheme a
                (types/type-function a
                  (arguments3 a
                    (types/type-reference a collection (types/lifetime-variable -1))
                    (types/type-integer a) element)
                  (types/type-unit a)) true true))))

(defn generic-set-value-binding [(a (dyn alloc/Allocator)) (id i64)
                                 (name (slice u8))] (-> PrimitiveSchemeBinding)
  (let [collection (types/type-variable a -1) element (types/type-variable a -2)]
    (PrimitiveSchemeBinding
      :reference (ir/core-ref id name true)
      :scheme (scheme-two-types a
                (types/type-function a
                  (arguments3 a collection (types/type-integer a) element)
                  collection)))))

(defn indexed-set-value-binding [(a (dyn alloc/Allocator)) (id i64)
                                 (name (slice u8))
                                 (collection-name (slice u8))]
  (-> PrimitiveSchemeBinding)
  (let [element (types/type-variable a -1)
        collection (named1 a collection-name element)]
    (PrimitiveSchemeBinding
      :reference (ir/core-ref id name true)
      :scheme (scheme a
                (types/type-function a
                  (arguments3 a collection (types/type-integer a) element)
                  collection) true false))))

(defn bindings [(a (dyn alloc/Allocator))]
  (-> (al/ArrayList PrimitiveSchemeBinding))
  (let [(mut result) (al/al-new [PrimitiveSchemeBinding] a)]
    (let [a-type (variable a)
          ref-a (types/type-reference a a-type (types/lifetime-variable -1))]
      (al/al-push! [PrimitiveSchemeBinding] (mut result)
        (unary a 0 "copy" ref-a a-type true true)))
    (al/al-push! [PrimitiveSchemeBinding] (mut result)
      (unary a 1 "str" (variable a) (types/type-string a) true false))
    (al/al-push! [PrimitiveSchemeBinding] (mut result)
      (unary a 2 "prn" (variable a) (types/type-string a) true false))
    (al/al-push! [PrimitiveSchemeBinding] (mut result)
      (unary a 3 "delete" (variable a) (types/type-unit a) true false))
    (let [item (types/type-variable a -1)]
      (al/al-push! [PrimitiveSchemeBinding] (mut result)
        (unary a 4 "Box.unbox" (named1 a "Box" item) item true false)))
    (let [a-type (variable a)
          ref-a (types/type-reference a a-type (types/lifetime-variable -1))]
      (al/al-push! [PrimitiveSchemeBinding] (mut result)
        (unary a 5 "ref" a-type ref-a true true)))
    (let [a-type (variable a)
          ref-a (types/type-reference a a-type (types/lifetime-variable -1))]
      (al/al-push! [PrimitiveSchemeBinding] (mut result)
        (unary a 6 "deref" ref-a a-type true true)))
    (let [arguments (types/type-arguments-new a)]
      (types/type-arguments-push! arguments (variable a))
      (al/al-push! [PrimitiveSchemeBinding] (mut result)
        (PrimitiveSchemeBinding
          :reference (ir/core-ref 7 "NULL" true)
          :scheme (scheme a (types/type-named a "Ptr" arguments) true false))))
    (al/al-push! [PrimitiveSchemeBinding] (mut result)
      (unary a 8 "length" (variable a) (types/type-integer a) true false))
    (al/al-push! [PrimitiveSchemeBinding] (mut result)
      (unary a 9 "Array.length" (variable a) (types/type-integer a) true false))
    (al/al-push! [PrimitiveSchemeBinding] (mut result)
      (unary a 10 "StaticArray.length" (variable a) (types/type-integer a)
             true false))
    (let [collection (types/type-variable a -1)
          element (types/type-variable a -2)]
      (al/al-push! [PrimitiveSchemeBinding] (mut result)
        (PrimitiveSchemeBinding
          :reference (ir/core-ref 11 "unsafe-nth" true)
          :scheme (scheme-two-types a
                    (types/type-function a
                      (arguments2 a collection (types/type-integer a)) element)))))
    (let [element (types/type-variable a -1)
          collection (named1 a "Array" element)
          lifetime (types/lifetime-variable -1)]
      (al/al-push! [PrimitiveSchemeBinding] (mut result)
        (PrimitiveSchemeBinding
          :reference (ir/core-ref 12 "Array.unsafe-nth" true)
          :scheme (scheme a
                    (types/type-function a
                      (arguments2 a (types/type-reference a collection lifetime)
                                    (types/type-integer a))
                      (types/type-reference a element lifetime)) true true))))
    (let [element (types/type-variable a -1)
          collection (named1 a "StaticArray" element)
          lifetime (types/lifetime-variable -1)]
      (al/al-push! [PrimitiveSchemeBinding] (mut result)
        (PrimitiveSchemeBinding
          :reference (ir/core-ref 13 "StaticArray.unsafe-nth" true)
          :scheme (scheme a
                    (types/type-function a
                      (arguments2 a (types/type-reference a collection lifetime)
                                    (types/type-integer a))
                      (types/type-reference a element lifetime)) true true))))
    (al/al-push! [PrimitiveSchemeBinding] (mut result)
      (unary a 14 "allocate" (types/type-integer a) (variable a) true false))
    (al/al-push! [PrimitiveSchemeBinding] (mut result)
      (unary a 15 "Array.allocate" (types/type-integer a) (variable a) true false))
    (al/al-push! [PrimitiveSchemeBinding] (mut result)
      (generic-set-binding a 16 "aset-uninitialized!"))
    (al/al-push! [PrimitiveSchemeBinding] (mut result)
      (indexed-set-binding a 17 "Array.aset-uninitialized!" "Array"))
    (al/al-push! [PrimitiveSchemeBinding] (mut result)
      (indexed-set-binding a 18 "StaticArray.aset-uninitialized!" "StaticArray"))
    (al/al-push! [PrimitiveSchemeBinding] (mut result)
      (generic-set-binding a 19 "aset!"))
    (al/al-push! [PrimitiveSchemeBinding] (mut result)
      (indexed-set-binding a 20 "Array.aset!" "Array"))
    (al/al-push! [PrimitiveSchemeBinding] (mut result)
      (indexed-set-binding a 21 "StaticArray.aset!" "StaticArray"))
    (let [collection (types/type-variable a -1) element (types/type-variable a -2)]
      (al/al-push! [PrimitiveSchemeBinding] (mut result)
        (PrimitiveSchemeBinding
          :reference (ir/core-ref 23 "Array.push-back" true)
          :scheme (scheme-two-types a
                    (types/type-function a (arguments2 a collection element)
                                         collection)))))
    (let [collection (types/type-variable a -1) element (types/type-variable a -2)]
      (al/al-push! [PrimitiveSchemeBinding] (mut result)
        (PrimitiveSchemeBinding
          :reference (ir/core-ref 24 "push-back!" true)
          :scheme (scheme-two-types-lifetime a
                    (types/type-function a
                      (arguments2 a
                        (types/type-reference a collection
                                              (types/lifetime-variable -1)) element)
                      (types/type-unit a))))))
    (let [collection (types/type-variable a -1) element (types/type-variable a -2)]
      (al/al-push! [PrimitiveSchemeBinding] (mut result)
        (PrimitiveSchemeBinding
          :reference (ir/core-ref 25 "Array.push-back!" true)
          :scheme (scheme-two-types-lifetime a
                    (types/type-function a
                      (arguments2 a
                        (types/type-reference a collection
                                              (types/lifetime-variable -1)) element)
                      (types/type-unit a))))))
    (let [element (types/type-variable a -1)
          array (named1 a "Array" element)]
      (al/al-push! [PrimitiveSchemeBinding] (mut result)
        (unary a 27 "Array.pop-back" array array true false)))
    (al/al-push! [PrimitiveSchemeBinding] (mut result)
      (generic-set-value-binding a 28 "aset"))
    (al/al-push! [PrimitiveSchemeBinding] (mut result)
      (indexed-set-value-binding a 29 "Array.aset" "Array"))
    (al/al-push! [PrimitiveSchemeBinding] (mut result)
      (indexed-set-value-binding a 30 "StaticArray.aset" "StaticArray"))
    (al/al-push! [PrimitiveSchemeBinding] (mut result)
      (array-endo-filter-binding a 36 "endo-filter"))
    (al/al-push! [PrimitiveSchemeBinding] (mut result)
      (array-endo-filter-binding a 37 "Array.endo-filter"))
    (al/al-push! [PrimitiveSchemeBinding] (mut result)
      (array-endo-map-binding a 39 "endo-map"))
    (al/al-push! [PrimitiveSchemeBinding] (mut result)
      (array-endo-map-binding a 40 "Array.endo-map"))
    (al/al-push! [PrimitiveSchemeBinding] (mut result)
      (collection-ref-to-string-binding a 41 "Array.str" "Array"))
    (al/al-push! [PrimitiveSchemeBinding] (mut result)
      (collection-ref-to-string-binding a 71 "StaticArray.str" "StaticArray"))
    (al/al-push! [PrimitiveSchemeBinding] (mut result)
      (array-pop-back-bang-binding a 50 "pop-back!"))
    (al/al-push! [PrimitiveSchemeBinding] (mut result)
      (array-pop-back-bang-binding a 51 "Array.pop-back!"))
    (al/al-push! [PrimitiveSchemeBinding] (mut result)
      (named-ref-copy-binding a 52 "Array.copy" "Array"))
    (al/al-push! [PrimitiveSchemeBinding] (mut result)
      (binary a 45 "Int.<=" (types/type-integer a) (types/type-integer a)
                            (types/type-boolean a) false))
    (al/al-push! [PrimitiveSchemeBinding] (mut result)
      (binary a 46 "Int.>=" (types/type-integer a) (types/type-integer a)
                            (types/type-boolean a) false))
    (al/al-push! [PrimitiveSchemeBinding] (mut result)
      (binary a 47 "Int./=" (types/type-integer a) (types/type-integer a)
                            (types/type-boolean a) false))
    (al/al-push! [PrimitiveSchemeBinding] (mut result)
      (pair-init-from-refs-binding a 31 "Pair.init-from-refs"))
    (al/al-push! [PrimitiveSchemeBinding] (mut result)
      (pair-accessor-binding a 32 "Pair.a" false))
    (al/al-push! [PrimitiveSchemeBinding] (mut result)
      (pair-accessor-binding a 33 "Pair.b" true))
    (al/al-push! [PrimitiveSchemeBinding] (mut result)
      (pair-set-b-binding a 34 "Pair.set-b"))
    (al/al-push! [PrimitiveSchemeBinding] (mut result)
      (pair-reverse-binding a 35 "Pair.reverse"))
    (al/al-push! [PrimitiveSchemeBinding] (mut result)
      (pair-init-binding a 38 "Pair.init"))
    (al/al-push! [PrimitiveSchemeBinding] (mut result)
      (unary a 42 "ignore" (variable a) (types/type-unit a) true false))
    (al/al-push! [PrimitiveSchemeBinding] (mut result)
      (unary a 48 "get-tag" (variable a) (types/type-integer a) true false))
    (load (mut result))))
