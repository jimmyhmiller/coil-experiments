(module experiments.reader_nested_defn_repro.reader)

(import "coil.primitive" :as primitive)

(defn make-rules [] (-> Code)
  `(defn rules [] (-> i64)
     0))

(defn build-program [(context Code) (source (slice u8))] (-> Code)
  (let [rules (make-rules)
        main-name (primitive/datum->syntax context "main")]
    (if (= (len rules) 0)
        (primitive/error "missing rule")
        `(do
           (module reader-nested-defn-repro.generated)
           (defn ~main-name [] (-> i64)
             (if (= ~source "ok\n") 0 1))))))

(defn read-source [(context Code)] (-> Code)
  (build-program context (primitive/code-str (get context 2))))

(defn read-source-direct [(context Code)] (-> Code)
  (let [rules
          `(defn rules [] (-> i64)
             0)
        source (primitive/code-str (get context 2))
        main-name (primitive/datum->syntax context "main")]
    (if (= (len rules) 0)
        (primitive/error "missing rule")
        `(do
           (module reader-nested-defn-repro.generated)
           (defn ~main-name [] (-> i64)
             (if (= ~source "ok\n") 0 1))))))
