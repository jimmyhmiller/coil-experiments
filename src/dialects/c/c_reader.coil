(module experiments.c.reader)

(import "coil.primitive" :as primitive)
(import "coil.slice" :use [slice-get slice-len])
(import "coil.alloc" :as alloc)
(import "coil.str" :as str)

(extern popen :cc c [(ptr i8) (ptr i8)] (-> (ptr i8)))
(extern pclose :cc c [(ptr i8)] (-> i32))
(extern fread :cc c [(ptr i8) i64 i64 (ptr i8)] (-> i64))

(defn path-shell-safe? [(path (slice u8))] (-> bool)
  (let [(mut i) 0 (mut safe) true]
    (loop
      (if (>= (load i) (slice-len path))
          (break)
          (do
            (if (= (slice-get path (load i)) (primitive/cast u8 #\'))
                (store! safe false)
                0)
            (store! i (+ (load i) 1)))))
    (load safe)))

;; The helper is deliberately a source-to-source frontend. clang preprocesses and
;; type-checks the input and reports its typed AST; it is never asked for LLVM, an
;; object, or an executable. The resulting text is read back as ordinary Coil.
(defn read-c [(context Code)] (-> Code)
  (let [a (alloc/malloc-allocator)
        path (primitive/code-str (primitive/code-nth context 1))]
    (if (not (path-shell-safe? path))
        (primitive/error "C reader: source paths containing a single quote are unsupported")
        (let [(mut command) (str/sb-new a)
              _a (str/sb-push-str! (mut command) "python3 src/dialects/c/c_ast_to_coil.py '")
              _b (str/sb-push-str! (mut command) path)
              _c (str/sb-push-str! (mut command) "'")
              command-str (str/sb-finish! (mut command))
              command-cstr (str/str->cstr a command-str)
              pipe (popen command-cstr c"r")]
          (if (= (primitive/cast i64 pipe) 0)
              (primitive/error "C reader: could not execute typed-AST frontend")
              (let [(mut output) (str/sb-new a)
                    chunk (primitive/alloc-stack (array u8 4096))
                    (mut done) false]
                (loop
                  (if (load done)
                      (break)
                      (let [n (fread (primitive/cast (ptr i8) chunk) 1 4096 pipe)]
                        (if (= n 0)
                            (store! done true)
                            (let [(mut i) 0]
                              (loop
                                (if (>= (load i) n)
                                    (break)
                                    (do
                                      (str/sb-push-byte! (mut output)
                                                         (load (primitive/index chunk (load i))))
                                      (store! i (+ (load i) 1))))))))))
                (let [status (pclose pipe)
                      generated (str/sb-finish! (mut output))]
                  (if (= status 0)
                      (primitive/code-read (primitive/code-nth `(value ~generated) 1)
                                           `(reader-config))
                      (primitive/error "C reader: typed-AST frontend failed")))))))))
