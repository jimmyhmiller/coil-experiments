(module experiments.c.reader)

(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.subprocess" :as subprocess)
(import "coil.time" :as time)
(import "coil.cancellation" :as cancellation)

;; The helper is deliberately a source-to-source frontend. clang preprocesses and
;; type-checks the input and reports its typed AST; it is never asked for LLVM, an
;; object, or an executable. The resulting text is read back as ordinary Coil.
(defn read-c [(context Code)] (-> Code)
  (let [a (alloc/malloc-allocator)
        path (primitive/code-str (primitive/code-nth context 1))
        args ["src/dialects/c/c_ast_to_coil.py" path]
        options (subprocess/run-options "python3" args "" 16777216 1048576
                                        (None) (primitive/cast (ptr cancellation/Cancellation) 0)
                                        (primitive/zeroed time/Duration))
        result (alloc/stack subprocess/RunResult)]
    (match (subprocess/run a result options)
      (Err [_] (primitive/error "C reader: could not execute typed-AST frontend"))
      (Ok [r]
        (match (load (field r status))
          (subprocess/Exited [code]
            (if (= code 0)
                (primitive/code-read (load (field r stdout)) `(reader-config))
                (primitive/error (load (field r stderr)))))
          (subprocess/Signaled [_]
            (primitive/error "C reader: typed-AST frontend was terminated")))))))
