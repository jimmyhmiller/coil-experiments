;; Lowers the typed C AST to ordinary Coil.

;;
;; Two rules shape everything here.
;;
;; A C record is emitted as a blob with C's own size and alignment -- an array
;; whose element type carries the required alignment -- and members are reached
;; by byte offset. Handing records to Coil's struct layout instead would mean
;; two independent sets of layout rules had to agree, which they need not; this
;; way the offsets computed in experiments.c.ctype are the offsets used. It is
;; also what makes bitfields expressible at all.
;;
;; Every expression has two forms: its value, and its address. `emit-addr!`
;; exists for exactly the constructs C calls lvalues, and reading an lvalue is
;; a load from its address. Assignment, `&`, and member access all fall out of
;; that rather than being special-cased.
(module experiments.c.emit)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "coil.hashmap" :as hm)
(import "coil.slice" :use *)
(import "coil.str" :as str)
(import "experiments.c.lex" :as lex)
(import "experiments.c.ctype" :as ct)
(import "experiments.c.node" :as nd)

(extern snprintf :cc c [(ptr i8) i64 (ptr i8) ...] (-> i32))

(export Emitter EmitResult emit-program emit-module)

;; ------------------------------------------ static initialisers, laid down

;;; C initialises an object with static storage before the program runs, not by
;;; running it. Every store whose value is known here is written into the
;;; object's image, and that image is what the object is defined to hold. Only
;;; the stores this compiler has no constant to spell -- the ones whose value is
;;; an address the linker decides -- are left to run at start-up.
(defstruct Image
  [(bytes (slice u8))
   (folded i64)])

;;; An expression either has a value here or it does not, and a value is either
;;; an integer or a floating one. Nothing else can be laid into an image.
(defstruct Value
  [(ok i64)
   (flo i64)
   (i i64)
   (f f64)])

(defstruct Emitter
  [(a (dyn alloc/Allocator))
   (out str/StrBuf)
   (slots (hm/HashMap (slice u8) (slice u8)))
   (defined (hm/HashMap (slice u8) bool))
   (externs (hm/HashMap (slice u8) bool))
   (emitted (hm/HashMap (slice u8) bool))
   ;; Names the program actually mentions. A header declares far more than any
   ;; one program uses, and a declaration that is never referred to must not
   ;; become an `extern`: some of them name types this compiler has no
   ;; arithmetic for, and all of them would be dead weight.
   (used (hm/HashMap (slice u8) bool))
   ;; Names with a definition somewhere in the program, which decides whether a
   ;; global is storage of ours or a symbol somebody else's object file has.
   (defined-data (hm/HashMap (slice u8) bool))
   ;; Which of a name's several declarations is the one to emit storage for.
   ;; A header's `extern char *names[];` and the file that defines
   ;; `char *names[NUM] = {...}` are two objects with one name and two sizes,
   ;; and only the complete one describes the storage.
   (storage (hm/HashMap (slice u8) i64))
   (storage-size (hm/HashMap (slice u8) i64))
   ;; The `defstruct` declared for each C record, by the shape it was declared
   ;; with, and the records and names to declare in order.
   (record-names (hm/HashMap (slice u8) (slice u8)))
   (records (al/ArrayList (ptr ct/Type)))
   (record-decls (al/ArrayList (slice u8)))
   (record-taken (hm/HashMap (slice u8) bool))
   ;; The names already used inside the function being emitted, so that two C
   ;; locals of the same name in different scopes stay apart.
   (names-taken (hm/HashMap (slice u8) bool))
   ;; The locals of the function being emitted whose address is taken, and so
   ;; need storage rather than a binding.
   (addressed (hm/HashMap (slice u8) bool))
   ;; The ones the function assigns to, and the parameters it does neither to,
   ;; which are the argument itself and need nothing of their own.
   (assigned (hm/HashMap (slice u8) bool))
   (direct (hm/HashMap (slice u8) bool))
   ;; What each object with static storage is defined to hold, filled in from
   ;; the start-up stores whose values are constants.
   (images (hm/HashMap (slice u8) (ptr Image)))
   ;; Eight bytes to read an f64's bits through. Coil converts between an f64
   ;; and an i64 by value, so the bits are only reachable through memory.
   (scratch (ptr i64))
   ;; The outgoing argument area each call to a variadic function of this
   ;; program's own writes into, by call site. They are allocated once at the
   ;; top of the function, never inside a loop.
   (va-areas (hm/HashMap (slice u8) (slice u8)))
   ;; The address of the target of the update being emitted, which the
   ;; placeholder standing for its value reads from.
   (target-addrs (al/ArrayList (slice u8)))
   (serial i64)
   (break-labels (al/ArrayList (slice u8)))
   (continue-labels (al/ArrayList (slice u8)))
   (failed i64)
   (message (slice u8))
   (file (slice u8))
   (line i64)])

(defstruct EmitResult
  [(text (slice u8))
   (failed i64)
   (message (slice u8))
   (file (slice u8))
   (line i64)])

(defn put! [(e (mut Emitter)) (s (slice u8))] (-> i64)
  (str/sb-push-str! (mut (field e out)) s)
  0)

(defn put-int! [(e (mut Emitter)) (v i64)] (-> i64)
  (str/sb-push-i64! (mut (field e out)) v)
  0)

;;; Seventeen significant digits in exponential form round-trip an f64 exactly,
;;; and the form always carries a point and an exponent, so Coil reads it back as
;;; the same value rather than as an integer.
(defn put-float! [(e (mut Emitter)) (v f64)] (-> i64)
  (let [buf (primitive/alloc-stack (array u8 48))
        text (primitive/cast (ptr i8) buf)]
    (if (primitive/fcmp-lt v 0.0)
        (do
          (put! (mut e) "(fsub 0.0 ")
          (snprintf text 48 c"%.17e" (primitive/fsub 0.0 v))
          (put! (mut e) (str/cstr->str text))
          (put! (mut e) ")"))
        (do
          (snprintf text 48 c"%.17e" v)
          (put! (mut e) (str/cstr->str text)))))
  0)

(defn fail! [(e (mut Emitter)) (message (slice u8)) (tok lex/Token)] (-> i64)
  (if (!= (load (field e failed)) 0)
      0
      (do
        (store! (field e failed) 1)
        (store! (field e message) message)
        (store! (field e file) (lex/token-file tok))
        (store! (field e line) (lex/token-line tok))
        0)))

(defn fresh [(e (mut Emitter)) (prefix (slice u8))] (-> (slice u8))
  (let [(mut b) (str/sb-new (load (field e a)))]
    (str/sb-push-str! (mut b) prefix)
    (str/sb-push-i64! (mut b) (load (field e serial)))
    (store! (field e serial) (+ (load (field e serial)) 1))
    (str/sb-str (load (mut b)))))

;;; C identifiers are a subset of what Coil accepts, except that a leading dot
;;; appears in the names generated for string literals.
(defn ident [(e (mut Emitter)) (prefix (slice u8)) (name (slice u8))] (-> (slice u8))
  (let [(mut b) (str/sb-new (load (field e a)))
        n (slice-len name)
        (mut i) 0]
    (str/sb-push-str! (mut b) prefix)
    (loop (if (>= (load i) n)
              (break)
              (let [c (primitive/cast i64 (slice-get name (load i)))]
                (str/sb-push-byte! (mut b)
                                   (primitive/cast u8
                                                   (if (or (and (>= c 48) (<= c 57))
                                                           (or (and (>= c 65) (<= c 90))
                                                               (or (and (>= c 97) (<= c 122))
                                                                   (= c 95))))
                                                       c
                                                       95)))
                (store! i (+ (load i) 1)))))
    (str/sb-str (load (mut b)))))

;;; External C data already occupies its linker spelling as a Coil `extern`.
;;; The address-producing wrapper therefore uses a hyphenated suffix that no C
;;; identifier can collide with. Defined globals need no such indirection and
;;; retain their source name exactly.
(defn extern-data-name [(e (mut Emitter)) (name (slice u8))] (-> (slice u8))
  (let [(mut b) (str/sb-new (load (field e a)))]
    (str/sb-push-str! (mut b) (source-name (mut e) name))
    (str/sb-push-str! (mut b) "-address")
    (str/sb-str (load (mut b)))))

;;; Most C identifiers can be preserved verbatim. A small set are parsed as
;;; Coil forms rather than calls and therefore cannot be defined or invoked as
;;; ordinary functions. Only those actual collisions receive a readable suffix;
;;; the common case stays exactly as authored in C.
(defn coil-form-name? [(e (mut Emitter)) (name (slice u8))] (-> bool)
  (let [(mut needle) (str/sb-new (load (field e a)))]
    (str/sb-push-str! (mut needle) "|")
    (str/sb-push-str! (mut needle) name)
    (str/sb-push-str! (mut needle) "|")
    (match (str/str-find "|alias-load|alias-store!|alignof|alloc-heap|alloc-stack|alloc-static|array|binding-of|bit-get|bit-set!|break|bswap|call-ptr|cast|clz|const|continue|def|defannotation|defcc|defdyn-marker|defn|defstruct|defsum|deftrait|delete|do|dyn|error|export|export-c|extern|fence!|field|field-index|fnptr|fnptr-of|for|free|gensym|if|impl|import|index|inot|let|linker-address|lint-param|llvm-ir|load|loop|make-dyn|match|meta|module|mret!|mut|offsetof|popcount|ptr|reader-provider|ref|register-derive|report|return|sizeof|slice|static-assert|store!|struct|suggest|target-arch|target-os|type-of|vec|volatile-load|volatile-store!|warn|wfi!|while|write-register!|zeroed|"
                         (str/sb-str (load (mut needle))))
      (Some [_] true)
      (None [] false))))

(defn source-name [(e (mut Emitter)) (name (slice u8))] (-> (slice u8))
  (let [plain (ident (mut e) "" name)]
    (if (coil-form-name? (mut e) plain)
        (let [(mut b) (str/sb-new (load (field e a)))]
          (str/sb-push-str! (mut b) plain)
          (str/sb-push-str! (mut b) "-from-c")
          (str/sb-str (load (mut b))))
        plain)))

;; --------------------------------------------------------------- types
(defn scalar-name [(t (ptr ct/Type))] (-> (slice u8))
  (let [k (ct/ty-kind t)
        u (ct/ty-unsigned? t)]
    (cond (= k ct/TY-VOID) "i8"
          (= k ct/TY-BOOL) "u8"
          (= k ct/TY-CHAR) (if u "u8" "i8")
          (= k ct/TY-SHORT) (if u "u16" "i16")
          (= k ct/TY-INT) (if u "u32" "i32")
          (= k ct/TY-ENUM) "i32"
          (= k ct/TY-LONG) (if u "u64" "i64")
          (= k ct/TY-FLOAT) "f32"
          (= k ct/TY-DOUBLE) "f64"
          (= k ct/TY-LDOUBLE) "f64"
          :else "")))

;;; A record's storage: an array of the widest unit its alignment allows, so the
;;; blob has exactly C's size and alignment. C guarantees the size is a multiple
;;; of the alignment, so the division is exact.
(defn emit-record-storage! [(e (mut Emitter)) (t (ptr ct/Type))] (-> i64)
  (let [size (ct/ty-size t)
        align (ct/ty-align t)]
    (put! (mut e) "(array ")
    (cond (>= align 8) (do (put! (mut e) "i64 ") (put-int! (mut e) (primitive/idiv size 8)))
          (= align 4) (do (put! (mut e) "i32 ") (put-int! (mut e) (primitive/idiv size 4)))
          (= align 2) (do (put! (mut e) "i16 ") (put-int! (mut e) (primitive/idiv size 2)))
          :else (do (put! (mut e) "u8 ") (put-int! (mut e) (if (= size 0) 1 size))))
    (put! (mut e) ")"))
  0)

(defn emit-type! [(e (mut Emitter)) (t (ptr ct/Type))] (-> i64)
  (if (= (primitive/cast i64 t) 0)
      (put! (mut e) "i64")
      (let [k (ct/ty-kind t)]
        (cond ;; A complete, declarable C record is an ordinary explicit-layout
              ;; Coil struct. Keep raw storage only for records Coil cannot name or
              ;; declare (for example an intentionally opaque/incomplete record).
              ;; Using the semantic type here matters: this function spells local
              ;; values and translated-function parameters as well as storage.
              (ct/record? t)
                (let [name (record-struct (mut e) t)]
                  (if (> (slice-len name) 0)
                      (put! (mut e) name)
                      (emit-record-storage! (mut e) t)))
              ;; Storage only. Anything that computes with one is refused below.
              (= k ct/TY-INT128) (put! (mut e) "(array i64 2)")
              (= k ct/TY-FLOAT16) (put! (mut e) "(array u8 2)")
              ;; A pointer to a function is a function pointer, not a pointer to
              ;; one: Coil's `fnptr` is already the address.
              (and (= k ct/TY-PTR) (= (ct/ty-kind (ct/ty-base t)) ct/TY-FUNC)) (emit-fnptr! (mut e) (ct/ty-base t))
              (= k ct/TY-PTR)
                (do
                  (put! (mut e) "(ptr ")
                  (emit-pointee! (mut e) (ct/ty-base t))
                  (put! (mut e) ")"))
              ;; An array parameter or value is only ever handled through its
              ;; address, so its element type is what matters.
              ;; An array of no stated length is only ever reached through a
              ;; pointer, so one element stands for its storage. Coil has no
              ;; zero-length array type to spell the alternative with.
              (= k ct/TY-ARRAY)
                (do
                  (put! (mut e) "(array ")
                  (emit-type! (mut e) (ct/ty-base t))
                  (put! (mut e) " ")
                  (put-int! (mut e) (if (< (ct/ty-array-len t) 1) 1 (ct/ty-array-len t)))
                  (put! (mut e) ")"))
              (= k ct/TY-FUNC) (emit-fnptr! (mut e) t)
              :else (put! (mut e) (scalar-name t))))))

;;; Every pointer to a record is a `(ptr i8)`, and so is `void *`. The layout is
;;; never needed through the pointer -- a member is reached by casting to bytes
;;; and indexing, and reading the whole record casts to its storage type first --
;;; and insisting on it would mean the same type had to be spelled the same way
;;; in every file. It cannot be: a header that says `typedef struct _MEMFILE
;;; MEMFILE;` gives one file a complete type and every other file an opaque one,
;;; and both must pass the same pointer to the same function.
(defn emit-pointee! [(e (mut Emitter)) (t (ptr ct/Type))] (-> i64)
  (if (= (primitive/cast i64 t) 0)
      (put! (mut e) "i8")
      (let [k (ct/ty-kind t)]
        (cond (= k ct/TY-VOID) (put! (mut e) "i8")
              (ct/record? t) (put! (mut e) "i8")
              :else (emit-type! (mut e) t)))))

(defn emit-fnptr! [(e (mut Emitter)) (t (ptr ct/Type))] (-> i64)
  (let [params (ct/ty-params t)
        n (al/al-len [(ptr ct/Type)] params)
        (mut i) 0]
    (put! (mut e) "(fnptr c [")
    (loop (if (>= (load i) n)
              (break)
              (do
                (if (> (load i) 0) (put! (mut e) " ") 0)
                (emit-param-type! (mut e) (al/al-get [(ptr ct/Type)] params (load i)))
                (store! i (+ (load i) 1)))))
    (if (ct/ty-variadic? t)
        (do (if (> n 0) (put! (mut e) " ") 0) (put! (mut e) "..."))
        0)
    (put! (mut e) "] ")
    (emit-return-type! (mut e) (ct/ty-base t))
    (put! (mut e) ")"))
  0)

;;; An array parameter is a pointer, and a record parameter is passed by
;;; reference here rather than by value.
(defn emit-param-type! [(e (mut Emitter)) (t (ptr ct/Type))] (-> i64)
  (if (= (primitive/cast i64 t) 0)
      (put! (mut e) "i64")
      (let [k (ct/ty-kind t)]
        (cond (= k ct/TY-ARRAY) (do (put! (mut e) "(ptr ") (emit-pointee! (mut e) (ct/ty-base t)) (put! (mut e) ")"))
              (= k ct/TY-FUNC) (emit-fnptr! (mut e) t)
              :else (emit-type! (mut e) t)))))

(defn emit-return-type! [(e (mut Emitter)) (t (ptr ct/Type))] (-> i64)
  (if (= (primitive/cast i64 t) 0)
      (put! (mut e) "i64")
      (if (= (ct/ty-kind t) ct/TY-VOID)
          (put! (mut e) "i64")
          (emit-param-type! (mut e) t))))

;; ------------------------------------------------------------ operations

;;; Coil's own operators, which are trait methods: the type decides what `/` and
;;; `>>` and `<` mean, and every width implements them the way C's target does --
;;; division truncates toward zero, an unsigned right shift is logical and a
;;; signed one arithmetic, an unsigned comparison is unsigned, and everything
;;; wraps rather than trapping. So the emitter stops choosing an operation by
;;; signedness and just says what the C said.
(defn arith-op [(t (ptr ct/Type)) (kind i64)] (-> (slice u8))
  (cond (= kind nd/ND-ADD) "+"
        (= kind nd/ND-SUB) "-"
        (= kind nd/ND-MUL) "*"
        (= kind nd/ND-DIV) "/"
        (= kind nd/ND-MOD) "%"
        (= kind nd/ND-BITAND) "&"
        (= kind nd/ND-BITOR) "|"
        (= kind nd/ND-BITXOR) "^"
        (= kind nd/ND-SHL) "<<"
        (= kind nd/ND-SHR) ">>"
        :else ""))

;;; The one place the type still matters: a float has no `Eq`, because a NaN is
;;; not equal to itself and Coil declines to pretend otherwise. Ordering it has.
(defn compare-op [(t (ptr ct/Type)) (kind i64)] (-> (slice u8))
  (let [f (and (!= (primitive/cast i64 t) 0) (ct/floating? t))]
    (cond (= kind nd/ND-EQ) (if f "fcmp-eq" "=")
          (= kind nd/ND-NE) (if f "fcmp-ne" "!=")
          (= kind nd/ND-LT) "<"
          (= kind nd/ND-LE) "<="
          :else "")))

;; ------------------------------------------------------ records as structs

;; A C record is declared as a `defstruct` whose layout is stated rather than
;; inferred: `:layout explicit` with the byte offset this compiler's own layout
;; pass assigned to every member. Nothing has to agree with anything -- the
;; offsets in the declaration are the offsets `experiments.c.ctype` computed --
;; and the members get their names back, so `ld->flags` is `(.flags ld)` instead
;; of a byte offset into a blob.
;;
;; A complete record is also its value type: it travels between translated
;; functions as this struct rather than as an array of ABI words. Records Coil
;; cannot declare (principally opaque/incomplete ones) retain raw storage, and
;; bitfields or anonymous members still reach their bytes by explicit offset.

;;; Whether this record can be declared at all. An incomplete one has no members
;;; to name, and a zero-sized one has nothing to place them in.
(defn declarable-record? [(t (ptr ct/Type))] (-> bool)
  (and (!= (primitive/cast i64 t) 0)
       (and (ct/record? t)
            (and (ct/ty-complete? t)
                 (and (> (ct/ty-size t) 0)
                      (> (al/al-len [ct/Member] (ct/ty-members t)) 0))))))

;;; Whether one member can be named in the declaration. A bitfield is not
;;; addressable, an anonymous member has no name to use, and a member of no size
;;; -- a flexible array -- has nothing to declare.
(defn declarable-member? [(m ct/Member)] (-> bool)
  (and (not (ct/member-bitfield? m))
       (and (> (slice-len (ct/member-name m)) 0)
            (> (ct/ty-size (ct/member-type m)) 0))))

;;; What tells two records apart. Every translation unit that includes a header
;;; declares the same struct again, and one declaration should serve all of them,
;;; so records are matched on the shape they would be declared with rather than
;;; on which unit produced them.
(defn record-key [(a (dyn alloc/Allocator)) (t (ptr ct/Type))] (-> (slice u8))
  (let [(mut b) (str/sb-new a)
        members (ct/ty-members t)
        count (al/al-len [ct/Member] members)
        (mut i) 0]
    (str/sb-push-str! (mut b) (ct/ty-name t))
    (str/sb-push-str! (mut b) "/")
    (str/sb-push-i64! (mut b) (ct/ty-size t))
    (str/sb-push-str! (mut b) "/")
    (str/sb-push-i64! (mut b) (ct/ty-align t))
    (loop (if (>= (load i) count)
              (break)
              (let [m (al/al-get [ct/Member] members (load i))
                    mt (ct/member-type m)]
                (if (declarable-member? m)
                    (do
                      (str/sb-push-str! (mut b) "|")
                      (str/sb-push-str! (mut b) (ct/member-name m))
                      (str/sb-push-str! (mut b) ":")
                      (str/sb-push-i64! (mut b) (ct/member-offset m))
                      (str/sb-push-str! (mut b) ":")
                      (str/sb-push-i64! (mut b) (ct/ty-kind mt))
                      (str/sb-push-str! (mut b) ":")
                      (str/sb-push-i64! (mut b) (ct/ty-size mt))
                      (str/sb-push-str! (mut b) ":")
                      (str/sb-push-i64! (mut b) (ct/ty-align mt))
                      (str/sb-push-str! (mut b) ":")
                      (str/sb-push-i64! (mut b) (if (ct/ty-unsigned? mt) 1 0))
                      (str/sb-push-str! (mut b) ":")
                      (str/sb-push-i64! (mut b) (member-shape mt))
                      0)
                    0)
                (store! i (+ (load i) 1)))))
    (str/sb-str (load (mut b)))))

;;; Enough of a member's type to tell apart two that would be declared
;;; differently: what a pointer points at, and how long an array is.
(defn member-shape [(t (ptr ct/Type))] (-> i64)
  (let [k (ct/ty-kind t)]
    (cond (= k ct/TY-PTR) (+ 1000 (ct/ty-kind (ct/ty-base t)))
          (= k ct/TY-ARRAY) (+ (+ 2000 (* 16 (ct/ty-array-len t))) (ct/ty-kind (ct/ty-base t)))
          :else 0)))

;;; The `defstruct` for a record, declared once and remembered by the shape it
;;; was declared with.
(defn record-struct [(e (mut Emitter)) (t (ptr ct/Type))] (-> (slice u8))
  (if (not (declarable-record? t))
      ""
      (let [a (load (field e a))
            key (record-key a t)]
        (match (hm/hm-get (load (field e record-names)) key)
          (Some [name] name)
          (None []
                (let [tag (if (> (slice-len (ct/ty-name t)) 0) (ct/ty-name t) "AnonymousRecord")
                      name (numbered (mut e) (source-name (mut e) tag))
                      members (ct/ty-members t)
                      count (al/al-len [ct/Member] members)
                      (mut i) 0]
                  ;; Reserve the name before descending so a self-pointer stops
                  ;; here, but declare by-value member records before their owner.
                  ;; Coil, unlike C, requires a field's value type to have already
                  ;; been declared.
                  (hm/hm-put! [(slice u8) (slice u8)] (mut (field e record-names)) key name)
                  (loop (if (>= (load i) count)
                            (break)
                            (do
                              (collect-type-records! (mut e)
                                                     (ct/member-type (al/al-get [ct/Member] members (load i))))
                              (store! i (+ (load i) 1)))))
                  (al/al-push! [(ptr ct/Type)] (mut (field e records)) t)
                  (al/al-push! [(slice u8)] (mut (field e record-decls)) name)
                  name))))))

;;; A name of this record's own, since two different structs may share a tag.
(defn numbered [(e (mut Emitter)) (stem (slice u8))] (-> (slice u8))
  (if (not (hm/hm-contains? (load (field e record-taken)) stem))
      (do (hm/hm-put! [(slice u8) bool] (mut (field e record-taken)) stem true) stem)
      (let [(mut b) (str/sb-new (load (field e a)))]
        (str/sb-push-str! (mut b) stem)
        (str/sb-push-str! (mut b) "_")
        ;; Dependency-first record discovery can reserve several records before
        ;; any of them is appended to `records`, so the list length is not a
        ;; unique suffix. The emitter serial is.
        (let [name (fresh (mut e) (str/sb-str (load (mut b))))]
          (if (hm/hm-contains? (load (field e record-taken)) name)
              (numbered (mut e) stem)
              (do
                (hm/hm-put! [(slice u8) bool] (mut (field e record-taken)) name true)
                name))))))

(defn emit-record-decls! [(e (mut Emitter))] (-> i64)
  (let [types (load (field e records))
        names (load (field e record-decls))
        count (al/al-len [(ptr ct/Type)] types)
        (mut i) 0]
    (if (> count 0)
        (do
          (put! (mut e) "\n;; C's records, laid out where this compiler put them. The offsets are\n")
          (put! (mut e) ";; stated rather than inferred, so they are the offsets the rest of the\n")
          (put! (mut e) ";; program computes with.\n"))
        0)
    (loop (if (>= (load i) count)
              (break)
              (do
                (emit-record-decl! (mut e)
                                   (al/al-get [(ptr ct/Type)] types (load i))
                                   (al/al-get [(slice u8)] names (load i)))
                (store! i (+ (load i) 1)))))
    (if (> count 0) (put! (mut e) "\n") 0))
  0)

(defn emit-record-decl! [(e (mut Emitter)) (t (ptr ct/Type)) (name (slice u8))] (-> i64)
  (let [members (ct/ty-members t)
        count (al/al-len [ct/Member] members)
        (mut i) 0
        (mut first) 1]
    (put! (mut e) "(defstruct ")
    (put! (mut e) name)
    (put! (mut e) " :layout explicit :size ")
    (put-int! (mut e) (ct/ty-size t))
    (put! (mut e) " :align ")
    (put-int! (mut e) (ct/ty-align t))
    (put! (mut e) "\n  [")
    (loop (if (>= (load i) count)
              (break)
              (let [m (al/al-get [ct/Member] members (load i))]
                (if (declarable-member? m)
                    (do
                      (if (= (load first) 0) (put! (mut e) "\n   ") 0)
                      (store! first 0)
                      (put! (mut e) "(")
                      (put! (mut e) (ct/member-name m))
                      (put! (mut e) " ")
                      (emit-type! (mut e) (ct/member-type m))
                      (put! (mut e) " :at ")
                      (put-int! (mut e) (ct/member-offset m))
                      (put! (mut e) ")"))
                    0)
                (store! i (+ (load i) 1)))))
    (put! (mut e) "])\n"))
  0)

;;; Whether this member access can be written as a field of a declared struct,
;;; which needs the record to be declarable and the member to be one of the ones
;;; the declaration names.
(defn field-access? [(e (mut Emitter)) (n (ptr nd/Node))] (-> bool)
  (and (< (nd/nd-member-bit-width n) 0)
       (and (> (slice-len (nd/nd-member-name n)) 0)
            (> (slice-len (record-struct (mut e) (nd/nd-type (nd/nd-lhs n)))) 0))))

;;; Every record the program reaches a member of gets a declaration. Collected
;;; before anything is written, because the declarations come first.
(defn collect-records! [(e (mut Emitter)) (n (ptr nd/Node))] (-> i64)
  (if (= (primitive/cast i64 n) 0)
      0
      (do
        ;; Locals and expression temporaries can carry records that never
        ;; appear in a global signature. Discover their value types before the
        ;; declaration section is emitted.
        (collect-type-records! (mut e) (nd/nd-type n))
        (if (and (= (nd/nd-kind n) nd/ND-MEMBER) (< (nd/nd-member-bit-width n) 0))
            (do (record-struct (mut e) (nd/nd-type (nd/nd-lhs n))) 0)
            0)
        (collect-records! (mut e) (nd/nd-lhs n))
        (collect-records! (mut e) (nd/nd-rhs n))
        (collect-records! (mut e) (nd/nd-test n))
        (collect-records! (mut e) (nd/nd-then n))
        (collect-records! (mut e) (nd/nd-else n))
        (collect-records! (mut e) (nd/nd-setup n))
        (collect-records! (mut e) (nd/nd-step n))
        (collect-records-list! (mut e) (nd/nd-body n))
        (collect-records-list! (mut e) (nd/nd-args n))
        0)))

(defn collect-records-list! [(e (mut Emitter)) (list (al/ArrayList (ptr nd/Node)))] (-> i64)
  (let [n (al/al-len [(ptr nd/Node)] list)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (collect-records! (mut e) (al/al-get [(ptr nd/Node)] list (load i)))
                (store! i (+ (load i) 1)))))
    0))

;;; A statement with nothing in it: a declaration that only names storage, or a
;;; block of them.
(defn nothing-to-do? [(n (ptr nd/Node))] (-> bool)
  (if (= (primitive/cast i64 n) 0)
      true
      (let [k (nd/nd-kind n)]
        (cond (= k nd/ND-NULL) true
              (= k nd/ND-BLOCK) (all-nothing? (nd/nd-body n))
              :else false))))

(defn all-nothing? [(list (al/ArrayList (ptr nd/Node)))] (-> bool)
  (let [count (al/al-len [(ptr nd/Node)] list)
        (mut i) 0
        (mut empty) true]
    (loop (if (>= (load i) count)
              (break)
              (do
                (if (nothing-to-do? (al/al-get [(ptr nd/Node)] list (load i)))
                    0
                    (store! empty false))
                (store! i (+ (load i) 1)))))
    (load empty)))

;; ------------------------------------------------ which locals need storage

;; C says every local is memory: `&x` is always available, and the compiler
;; works out afterwards which variables never needed an address. Coil says the
;; opposite -- a binding is a value, and `alloc-stack` is the explicit request
;; for memory -- so the frontend has to do that working-out itself.
;;
;; A local is a plain mutable binding unless something wants its address. What
;; wants an address is `&x`, and anything reached through the variable rather
;; than being the variable: a member, an element, a record passed by value. The
;; first is found here; the rest are ruled out by only ever binding scalars.

;;; Whether this local could be a binding at all. An array decays to its address
;;; wherever it is mentioned, and a record is reached through one, so both need
;;; storage whatever else happens to them.
(defn bindable-type? [(t (ptr ct/Type))] (-> bool)
  (if (= (primitive/cast i64 t) 0)
      false
      (let [k (ct/ty-kind t)]
        (and (!= k ct/TY-ARRAY)
             (and (!= k ct/TY-FUNC)
                  (and (not (ct/record? t)) (!= k ct/TY-VLA)))))))

;;; Every local whose address the function takes.
(defn find-addressed! [(e (mut Emitter)) (n (ptr nd/Node))] (-> i64)
  (if (= (primitive/cast i64 n) 0)
      0
      (do
        (if (= (nd/nd-kind n) nd/ND-ADDR) (note-addressed! (mut e) (nd/nd-lhs n)) 0)
        (if (or (= (nd/nd-kind n) nd/ND-ASSIGN)
                (or (= (nd/nd-kind n) nd/ND-COMPOUND)
                    (or (= (nd/nd-kind n) nd/ND-MEMZERO)
                        (or (= (nd/nd-kind n) nd/ND-VA-START)
                            (= (nd/nd-kind n) nd/ND-VA-ARG)))))
            (note-assigned! (mut e) (nd/nd-lhs n))
            0)
        (find-addressed! (mut e) (nd/nd-lhs n))
        (find-addressed! (mut e) (nd/nd-rhs n))
        (find-addressed! (mut e) (nd/nd-test n))
        (find-addressed! (mut e) (nd/nd-then n))
        (find-addressed! (mut e) (nd/nd-else n))
        (find-addressed! (mut e) (nd/nd-setup n))
        (find-addressed! (mut e) (nd/nd-step n))
        (find-addressed-list! (mut e) (nd/nd-body n))
        (find-addressed-list! (mut e) (nd/nd-args n))
        0)))

(defn find-addressed-list! [(e (mut Emitter)) (list (al/ArrayList (ptr nd/Node)))] (-> i64)
  (let [count (al/al-len [(ptr nd/Node)] list)
        (mut i) 0]
    (loop (if (>= (load i) count)
              (break)
              (do
                (find-addressed! (mut e) (al/al-get [(ptr nd/Node)] list (load i)))
                (store! i (+ (load i) 1)))))
    0))

;;; A C parameter that the body never assigns to is the argument: there is
;;; nothing to copy it into, and nothing to load it from. C's parameters are
;;; ordinary locals, so many of them are assigned; most are not.
(defn note-assigned! [(e (mut Emitter)) (n (ptr nd/Node))] (-> i64)
  (if (and (!= (primitive/cast i64 n) 0) (= (nd/nd-kind n) nd/ND-VAR))
      (let [o (nd/nd-obj n)]
        (if (and (!= (primitive/cast i64 o) 0) (nd/obj-local? o))
            (do (hm/hm-put! [(slice u8) bool] (mut (field e assigned)) (obj-key (mut e) o) true) 0)
            0))
      0))

(defn direct-param? [(e (mut Emitter)) (o (ptr nd/Obj))] (-> bool)
  (and (bound-local? (mut e) o)
       (not (hm/hm-contains? (load (field e assigned)) (obj-key (mut e) o)))))

(defn direct-value? [(e (mut Emitter)) (o (ptr nd/Obj))] (-> bool)
  (hm/hm-contains? (load (field e direct)) (obj-key (mut e) o)))

(defn note-addressed! [(e (mut Emitter)) (n (ptr nd/Node))] (-> i64)
  (if (and (!= (primitive/cast i64 n) 0) (= (nd/nd-kind n) nd/ND-VAR))
      (let [o (nd/nd-obj n)]
        (if (and (!= (primitive/cast i64 o) 0) (nd/obj-local? o))
            (do (hm/hm-put! [(slice u8) bool] (mut (field e addressed)) (obj-key (mut e) o) true) 0)
            0))
      0))

(defn bound-local? [(e (mut Emitter)) (o (ptr nd/Obj))] (-> bool)
  (and (bindable-type? (nd/obj-type o))
       (not (hm/hm-contains? (load (field e addressed)) (obj-key (mut e) o)))))

;; --------------------------------------------------------- addresses

;;; Whether an expression is arithmetic whose operands are all constants, so the
;;; value can be written down instead of computed. Only integers: folding a
;;; floating expression would move where the rounding happens.
(defn constant-arithmetic? [(n (ptr nd/Node))] (-> bool)
  (let [k (nd/nd-kind n)
        t (nd/nd-type n)]
    (and (and (!= (primitive/cast i64 t) 0) (ct/integer? t))
         (and (foldable-kind? k)
              (let [v (eval-value n)]
                (and (= (.ok v) 1) (= (.flo v) 0)))))))

(defn foldable-kind? [(k i64)] (-> bool)
  (or (or (= k nd/ND-ADD) (or (= k nd/ND-SUB) (or (= k nd/ND-MUL) (= k nd/ND-DIV))))
      (or (or (= k nd/ND-MOD) (or (= k nd/ND-BITAND) (or (= k nd/ND-BITOR) (= k nd/ND-BITXOR))))
          (or (= k nd/ND-SHL) (or (= k nd/ND-SHR) (or (= k nd/ND-NEG) (= k nd/ND-BITNOT)))))))

;;; Whether `*p` reaches its address through a `c-at` that already names the
;;; type. Pointer arithmetic is lowered that way, and `c-at` spells the pointee
;;; the same way as here except where the type has no useful spelling -- a record
;;; or a void, both of which it writes as bytes.
(defn walks-to? [(e (mut Emitter)) (n (ptr nd/Node))] (-> bool)
  (let [p (nd/nd-lhs n)
        t (nd/nd-type n)]
    (and (and (!= (primitive/cast i64 p) 0) (!= (primitive/cast i64 t) 0))
         (and (or (= (nd/nd-kind p) nd/ND-ADD) (= (nd/nd-kind p) nd/ND-SUB))
              (and (ct/pointer-like? (nd/nd-type p))
                   (and (not (ct/record? t))
                        (and (!= (ct/ty-kind t) ct/TY-VOID)
                             (!= (ct/ty-kind t) ct/TY-ARRAY))))))))

;;; Whether a member is the whole of what it is a member of, which is what an
;;; initialiser produces for an object that is not a record: one leaf, at offset
;;; zero, of the object's own type.
(defn whole-object? [(n (ptr nd/Node))] (-> bool)
  (if (!= (nd/nd-member-offset n) 0)
      false
      (let [base (nd/nd-type (nd/nd-lhs n))
            mine (nd/nd-type n)]
        (and (!= (primitive/cast i64 base) 0)
             (and (!= (primitive/cast i64 mine) 0)
                  (and (not (ct/record? base))
                       (and (!= (ct/ty-kind base) ct/TY-ARRAY)
                            (= (ct/ty-size base) (ct/ty-size mine)))))))))

;;; A pointer to something that is not a function, which is the only kind of
;;; address `c-at` cares about: it reinterprets its base as bytes either way.
(defn data-pointer? [(n (ptr nd/Node))] (-> bool)
  (let [t (nd/nd-type n)]
    (and (!= (primitive/cast i64 t) 0)
         (and (ct/pointer-like? t)
              (!= (ct/ty-kind (ct/ty-base t)) ct/TY-FUNC)))))

;;; The base of a `c-at`. Because `c-at` reinterprets it as bytes, a cast that
;;; only gives an address a type says nothing here, so it is not written: what
;;; goes in is whatever the address already was.
(defn emit-at-base! [(e (mut Emitter)) (n (ptr nd/Node))] (-> i64)
  (let [k (nd/nd-kind n)]
    (cond ;; The address of `*p` is `p`.
          (and (= k nd/ND-DEREF) (data-pointer? (nd/nd-lhs n))) (emit-at-value! (mut e) (nd/nd-lhs n))
          ;; The first member starts where the record does.
          (and (= k nd/ND-MEMBER) (= (nd/nd-member-offset n) 0)) (emit-at-base! (mut e) (nd/nd-lhs n))
          :else (emit-addr! (mut e) n))))

;;; The same, for a pointer that is a value rather than an lvalue.
(defn emit-at-value! [(e (mut Emitter)) (n (ptr nd/Node))] (-> i64)
  (if (and (= (nd/nd-kind n) nd/ND-CAST)
           (and (data-pointer? n) (data-pointer? (nd/nd-lhs n))))
      (emit-at-value! (mut e) (nd/nd-lhs n))
      (emit-expr! (mut e) n)))

;;; The address of an lvalue. Only the constructs C calls lvalues have one, and
;;; every read of an lvalue is a load from here.
(defn emit-addr! [(e (mut Emitter)) (n (ptr nd/Node))] (-> i64)
  (let [k (nd/nd-kind n)]
    (cond ;; A function has no storage to take the address of: its name already
          ;; denotes its address.
          (and (= k nd/ND-VAR) (= (ct/ty-kind (nd/obj-type (nd/nd-obj n))) ct/TY-FUNC))
            (do
              (put! (mut e) "(fnptr-of ")
              (put! (mut e) (callee-name (mut e) (nd/nd-obj n)))
              (put! (mut e) ")"))
          (= k nd/ND-VAR)
            (let [o (nd/nd-obj n)]
              (if (nd/obj-local? o)
                  (put! (mut e) (slot-of (mut e) o))
                  (do (put! (mut e) "(") (put! (mut e) (slot-of (mut e) o)) (put! (mut e) ")"))))
          (= k nd/ND-STMT-EXPR) (emit-compound-literal! (mut e) n true)
          ;; The pointer's own type says nothing about what it points at, so the
          ;; address is retyped here, where the type of the thing being reached is
          ;; known.
          (= k nd/ND-DEREF)
            (cond (= (ct/ty-kind (nd/nd-type n)) ct/TY-FUNC) (emit-expr! (mut e) (nd/nd-lhs n))
                  ;; Walking a pointer is written as `c-at`, which already yields a
                  ;; pointer to what it names; saying the type again adds nothing.
                  (walks-to? (mut e) n) (emit-expr! (mut e) (nd/nd-lhs n))
                  :else
                    (do
                      (put! (mut e) "(cast (ptr ")
                      (emit-type! (mut e) (nd/nd-type n))
                      (put! (mut e) ") ")
                      (emit-expr! (mut e) (nd/nd-lhs n))
                      (put! (mut e) ")")))
          ;; A member is its record's address advanced by the byte offset the
          ;; layout assigned, then reinterpreted.
          ;; The placeholder for an update's target reaches the address the update
          ;; already bound.
          (= k nd/ND-TARGET) (put! (mut e) (top-label (load (field e target-addrs))))
          ;; A member is its record's address advanced by the byte offset the
          ;; layout assigned, then reinterpreted. The first member is not advanced
          ;; at all -- it starts where the record does -- and most members are the
          ;; first of something.
          ;; An initialiser reaches even a scalar through a member at offset zero,
          ;; and there the member is the object: there is nothing to reinterpret.
          (and (= k nd/ND-MEMBER) (whole-object? n)) (emit-addr! (mut e) (nd/nd-lhs n))
          (and (= k nd/ND-MEMBER)
               (and (= (nd/nd-member-offset n) 0) (not (field-access? (mut e) n))))
            (do
              (put! (mut e) "(cast (ptr ")
              (emit-type! (mut e) (nd/nd-type n))
              (put! (mut e) ") ")
              (emit-addr! (mut e) (nd/nd-lhs n))
              (put! (mut e) ")"))
          (field-access? (mut e) n)
            (do
              (put! (mut e) "(field (cast (ptr ")
              (put! (mut e) (record-struct (mut e) (nd/nd-type (nd/nd-lhs n))))
              (put! (mut e) ") ")
              (emit-at-base! (mut e) (nd/nd-lhs n))
              (put! (mut e) ") ")
              (put! (mut e) (nd/nd-member-name n))
              (put! (mut e) ")"))
          (= k nd/ND-MEMBER)
            (do
              (put! (mut e) "(cast (ptr ")
              (emit-type! (mut e) (nd/nd-type n))
              (put! (mut e) ") (index (cast (ptr u8) ")
              (emit-at-base! (mut e) (nd/nd-lhs n))
              (put! (mut e) ") ")
              (put-int! (mut e) (nd/nd-member-offset n))
              (put! (mut e) "))"))
          :else (fail! (mut e) "expression is not an lvalue" (nd/nd-token n)))))

;;; A bitfield is read by loading its storage unit, shifting the field down, and
;;; masking it; a signed one is then sign-extended by shifting up and back. The
;;; unit's address is a parameter, because an update reads and writes the same
;;; unit and must reach it once.
(defn emit-bits-load! [(e (mut Emitter))
                       (t (ptr ct/Type))
                       (offset i64)
                       (width i64)
                       (at (slice u8))] (-> i64)
  (let [bits (* (ct/ty-size t) 8)]
    (if (ct/ty-unsigned? t)
        (do
          (put! (mut e) "(& (>> (load ")
          (put! (mut e) at)
          (put! (mut e) ") ")
          (put-int! (mut e) offset)
          (put! (mut e) ") ")
          (put-int! (mut e) (- (primitive/ishl 1 width) 1))
          (put! (mut e) ")"))
        (do
          (put! (mut e) "(>> (<< (load ")
          (put! (mut e) at)
          (put! (mut e) ") ")
          (put-int! (mut e) (- bits (+ offset width)))
          (put! (mut e) ") ")
          (put-int! (mut e) (- bits width))
          (put! (mut e) ")"))))
  0)

;;; Records named by an API signature must be declared even when no translated
;;; body reaches one of their members. This matters for a generated library:
;;; its callers see the signatures independently of the implementation bodies.
(defn collect-type-records! [(e (mut Emitter)) (t (ptr ct/Type))] (-> i64)
  (if (= (primitive/cast i64 t) 0)
      0
      (let [k (ct/ty-kind t)]
        (cond (ct/record? t) (do (record-struct (mut e) t) 0)
              (or (= k ct/TY-PTR) (= k ct/TY-ARRAY)) (collect-type-records! (mut e) (ct/ty-base t))
              (= k ct/TY-FUNC)
                (do
                  (collect-type-records! (mut e) (ct/ty-base t))
                  (let [params (ct/ty-params t)
                        n (al/al-len [(ptr ct/Type)] params)
                        (mut i) 0]
                    (loop (if (>= (load i) n)
                              (break)
                              (do
                                (collect-type-records! (mut e)
                                                       (al/al-get [(ptr ct/Type)] params (load i)))
                                (store! i (+ (load i) 1)))))))
              :else 0))))

(defn emit-bitfield-load! [(e (mut Emitter)) (n (ptr nd/Node))] (-> i64)
  (let [at (fresh (mut e) "bf")]
    (put! (mut e) "(let [")
    (put! (mut e) at)
    (put! (mut e) " ")
    (emit-addr! (mut e) n)
    (put! (mut e) "] ")
    (emit-bits-load! (mut e) (nd/nd-type n) (nd/nd-member-bit-offset n) (nd/nd-member-bit-width n) at)
    (put! (mut e) ")"))
  0)

;;; Writing a bitfield is read-modify-write: clear the field's bits, then place
;;; the new value into them.
(defn emit-bits-store! [(e (mut Emitter))
                        (t (ptr ct/Type))
                        (offset i64)
                        (width i64)
                        (at (slice u8))
                        (value (ptr nd/Node))] (-> i64)
  (let [mask (primitive/ishl (- (primitive/ishl 1 width) 1) offset)]
    (put! (mut e) "(set! ")
    (put! (mut e) at)
    (put! (mut e) " (cast ")
    (emit-type! (mut e) t)
    (put! (mut e) " (| (& (cast i64 (load ")
    (put! (mut e) at)
    (put! (mut e) ")) ")
    (put-int! (mut e) (primitive/inot mask))
    (put! (mut e) ") (& (<< (cast i64 ")
    (emit-expr! (mut e) value)
    (put! (mut e) ") ")
    (put-int! (mut e) offset)
    (put! (mut e) ") ")
    (put-int! (mut e) mask)
    (put! (mut e) "))))"))
  0)

;;; The store on its own, for a statement that throws the value away.
(defn emit-bitfield-store! [(e (mut Emitter)) (n (ptr nd/Node)) (value (ptr nd/Node))] (-> i64)
  (let [at (fresh (mut e) "bf")]
    (put! (mut e) "(let [")
    (put! (mut e) at)
    (put! (mut e) " ")
    (emit-addr! (mut e) n)
    (put! (mut e) "] ")
    (emit-bits-store! (mut e) (nd/nd-type n) (nd/nd-member-bit-offset n) (nd/nd-member-bit-width n) at value)
    (put! (mut e) ")"))
  0)

;;; And with the value, for an assignment used as an expression: `x.bits = 3`
;;; yields 3 the same as any other assignment does.
(defn emit-bitfield-assign! [(e (mut Emitter)) (n (ptr nd/Node)) (value (ptr nd/Node))] (-> i64)
  (let [at (fresh (mut e) "bf")
        t (nd/nd-type n)
        offset (nd/nd-member-bit-offset n)
        width (nd/nd-member-bit-width n)]
    (put! (mut e) "(let [")
    (put! (mut e) at)
    (put! (mut e) " ")
    (emit-addr! (mut e) n)
    (put! (mut e) "] (do ")
    (emit-bits-store! (mut e) t offset width at value)
    (put! (mut e) " ")
    (emit-bits-load! (mut e) t offset width at)
    (put! (mut e) "))"))
  0)

;;; Reading and writing an update's target, through the address already bound for
;;; it. A bitfield target reaches its storage unit the same way an ordinary one
;;; reaches its object.
(defn emit-target-load! [(e (mut Emitter)) (target (ptr nd/Node)) (at (slice u8))] (-> i64)
  (if (>= (nd/nd-member-bit-width target) 0)
      (emit-bits-load! (mut e)
                       (nd/nd-type target)
                       (nd/nd-member-bit-offset target)
                       (nd/nd-member-bit-width target)
                       at)
      (do (put! (mut e) "(load ") (put! (mut e) at) (put! (mut e) ")"))))

(defn emit-target-store! [(e (mut Emitter))
                          (target (ptr nd/Node))
                          (at (slice u8))
                          (value (ptr nd/Node))] (-> i64)
  (if (>= (nd/nd-member-bit-width target) 0)
      (emit-bits-store! (mut e)
                        (nd/nd-type target)
                        (nd/nd-member-bit-offset target)
                        (nd/nd-member-bit-width target)
                        at
                        value)
      (do
        (put! (mut e) "(set! ")
        (put! (mut e) at)
        (put! (mut e) " ")
        (emit-value! (mut e) value)
        (put! (mut e) ")"))))

;;; `x op= y` and `x++`: the target's address is worked out once, the operation
;;; A variable is its own address: nothing is evaluated to reach it, so `x += 1`
;;; needs no binding to reach it once. Everything else -- `*p++ += 1` above all --
;;; does, which is the whole reason the address is bound.
(defn plain-variable? [(n (ptr nd/Node))] (-> bool)
  (and (!= (primitive/cast i64 n) 0)
       (and (= (nd/nd-kind n) nd/ND-VAR)
            (nd/obj-local? (nd/nd-obj n)))))

;;; reads through it, and the result goes back to it. `value` says whether the
;;; expression's own value is what the target held before the update.
(defn emit-compound! [(e (mut Emitter)) (n (ptr nd/Node))] (-> i64)
  (let [target (nd/nd-lhs n)
        value (nd/nd-rhs n)
        bind (not (plain-variable? target))
        at
          (if (plain-variable? target)
              (slot-of (mut e) (nd/nd-obj target))
              (fresh (mut e) "at"))
        was (fresh (mut e) "was")]
    (if bind
        (do
          (put! (mut e) "(let [")
          (put! (mut e) at)
          (put! (mut e) " ")
          (emit-addr! (mut e) target)
          (put! (mut e) "] "))
        0)
    (al/al-push! [(slice u8)] (mut (field e target-addrs)) at)
    (if (= (nd/nd-value n) 1)
        (do
          (put! (mut e) "(let [")
          (put! (mut e) was)
          (put! (mut e) " ")
          (emit-target-load! (mut e) target at)
          (put! (mut e) "] (do ")
          (emit-target-store! (mut e) target at value)
          (put! (mut e) " ")
          (put! (mut e) was)
          (put! (mut e) "))")
          (if bind (put! (mut e) ")") 0))
        (do
          (put! (mut e) "(do ")
          (emit-target-store! (mut e) target at value)
          (put! (mut e) " ")
          (emit-target-load! (mut e) target at)
          (put! (mut e) ")")
          (if bind (put! (mut e) ")") 0)))
    (al/al-pop! [(slice u8)] (mut (field e target-addrs))))
  0)

;; ------------------------------------------------------------ expressions

;;; A floating value is true when it differs from zero, which converting it to
;;; an integer first would not preserve: 0.5 would round to false.
;;; Coil converts a function pointer to a data pointer and back, but not to an
;;; integer, which C does convert one to. The conversion therefore goes through a
;;; data pointer.
(defn fnptr-type? [(t (ptr ct/Type))] (-> bool)
  (and (!= (primitive/cast i64 t) 0)
       (or (= (ct/ty-kind t) ct/TY-FUNC)
           (and (= (ct/ty-kind t) ct/TY-PTR)
                (= (ct/ty-kind (ct/ty-base t)) ct/TY-FUNC)))))

;;; Two C types that are written the same way in Coil.
(defn same-scalar? [(a (ptr ct/Type)) (b (ptr ct/Type))] (-> bool)
  (and (!= (primitive/cast i64 a) 0)
       (and (!= (primitive/cast i64 b) 0)
            (let [na (scalar-name a)]
              (and (> (slice-len na) 0) (str/str-eq na (scalar-name b)))))))

;;; Whether the lowering writes two types the same way, which is a coarser
;;; question than whether C calls them the same type. Every pointer to a record
;;; and every `void *` is written `(ptr i8)`, so pointers agree with each other
;;; far more often than C would say -- which is the point: a cast between two of
;;; them is a cast from a type to itself, and writes nothing.
(defn opaque-pointee? [(t (ptr ct/Type))] (-> bool)
  (or (= (primitive/cast i64 t) 0)
      (or (= (ct/ty-kind t) ct/TY-VOID) (ct/record? t))))

(defn same-emitted? [(a (ptr ct/Type)) (b (ptr ct/Type))] (-> bool)
  (cond (or (= (primitive/cast i64 a) 0) (= (primitive/cast i64 b) 0)) false
        (and (= (ct/ty-kind a) ct/TY-PTR) (= (ct/ty-kind b) ct/TY-PTR)) (same-pointee? (ct/ty-base a) (ct/ty-base b))
        (!= (ct/ty-kind a) (ct/ty-kind b)) false
        (= (ct/ty-kind a) ct/TY-ARRAY)
          (and (= (ct/ty-array-len a) (ct/ty-array-len b))
               (same-emitted? (ct/ty-base a) (ct/ty-base b)))
        :else (same-scalar? a b)))

(defn same-pointee? [(a (ptr ct/Type)) (b (ptr ct/Type))] (-> bool)
  (if (or (opaque-pointee? a) (opaque-pointee? b))
      (and (opaque-pointee? a) (opaque-pointee? b))
      ;; A pointer to a function is a `fnptr`, not a pointer to one, and two of
      ;; them are left alone.
      (and (!= (ct/ty-kind a) ct/TY-FUNC)
           (and (!= (ct/ty-kind b) ct/TY-FUNC) (same-emitted? a b)))))

;;; Something that already produces exactly the type the cast around it names, so
;;; that naming it again is text and nothing else. The parser materialises every
;;; conversion C performs, and most of them convert a thing to the type it already
;;; has: `int + int` is an `int`, and reading an `int` variable gives one.
;;;
;;; What is left out is what is left out deliberately. A comparison and a logical
;;; operator both emit `(if ... 1 0)`, whose type is the literal's rather than the
;;; `int` C gives the expression. A bitfield is read shifted and masked in a wider
;;; type. A call to a `void` function has no value at all. In each of those the
;;; cast is doing the work, and dropping it would change the type.
;;; Whether an integer this size and signedness can hold this value, which is
;;; what decides whether the conversion around a literal can be done here instead
;;; of at run time. Anything eight bytes wide holds any value the parser produced.
(defn literal-fits? [(v i64) (t (ptr ct/Type))] (-> bool)
  (let [size (ct/ty-size t)]
    (cond (>= size 8) true
          (ct/ty-unsigned? t) (and (>= v 0) (< v (primitive/ishl 1 (* size 8))))
          :else
            (let [limit (primitive/ishl 1 (- (* size 8) 1))]
              (and (>= v (- 0 limit)) (< v limit))))))

;;; A literal converted to another integer type is just a literal of that type.
;;; Floating ones are left alone: narrowing and widening a float is a rounding,
;;; not a relabelling, and doing it here would do it differently.
(defn foldable-literal? [(n (ptr nd/Node)) (target (ptr ct/Type))] (-> bool)
  (and (= (nd/nd-kind n) nd/ND-NUM)
       (and (ct/integer? target)
            (and (not (null-scalar? (nd/nd-type n)))
                 (and (ct/integer? (nd/nd-type n))
                      (literal-fits? (nd/nd-value n) target))))))

(defn null-scalar? [(t (ptr ct/Type))] (-> bool)
  (= (primitive/cast i64 t) 0))

(defn self-typed? [(n (ptr nd/Node)) (target (ptr ct/Type))] (-> bool)
  (and (same-emitted? (nd/nd-type n) target)
       (let [k (nd/nd-kind n)]
         (cond (or (= k nd/ND-NUM) (or (= k nd/ND-VAR) (= k nd/ND-DEREF))) true
               (or (= k nd/ND-COND) (or (= k nd/ND-COMMA) (= k nd/ND-VA-ARG))) true
               (or (= k nd/ND-NEG) (= k nd/ND-BITNOT)) true
               (or (= k nd/ND-ADD) (or (= k nd/ND-SUB) (= k nd/ND-MUL))) true
               (or (= k nd/ND-DIV) (or (= k nd/ND-MOD) (= k nd/ND-SHL))) true
               (or (= k nd/ND-SHR) (or (= k nd/ND-BITAND) (or (= k nd/ND-BITOR) (= k nd/ND-BITXOR)))) true
               ;; A comparison and the logical operators now say what type their
               ;; `int` is, so a cast to that type adds nothing.
               (or (= k nd/ND-EQ) (or (= k nd/ND-NE) (or (= k nd/ND-LT) (= k nd/ND-LE)))) true
               (or (= k nd/ND-NOT) (or (= k nd/ND-LOGAND) (= k nd/ND-LOGOR))) true
               (= k nd/ND-CALL) (!= (ct/ty-kind (nd/nd-type n)) ct/TY-VOID)
               (= k nd/ND-MEMBER) (< (nd/nd-member-bit-width n) 0)
               (or (= k nd/ND-ASSIGN) (= k nd/ND-COMPOUND)) (< (nd/nd-member-bit-width (nd/nd-lhs n)) 0)
               :else false))))

;;; A cast whose operand is already a cast to the same Coil type: the inner one
;;; produced that type, so it adds nothing. They stack up because the parser
;;; materialises every conversion C performs and the lowering then names the type
;;; again. The outer cast is kept -- it may be the one doing real work -- and the
;;; redundant inner ones are dropped.
(defn without-redundant-casts [(n (ptr nd/Node)) (target (ptr ct/Type))] (-> (ptr nd/Node))
  (let [(mut operand) n]
    (loop (if (and (= (nd/nd-kind (load operand)) nd/ND-CAST)
                   (same-emitted? (nd/nd-type (load operand)) target))
              (store! operand (nd/nd-lhs (load operand)))
              (break)))
    (load operand)))

;;; The operand of a cast, with the hop inserted when one side is a function
;;; pointer and the other is not.
(defn emit-cast-operand! [(e (mut Emitter)) (operand (ptr nd/Node)) (target (ptr ct/Type))] (-> i64)
  (let [from (nd/nd-type operand)]
    (cond ;; Array-to-pointer conversion uses the array object's address. This is
          ;; especially important for array compound literals, which are lvalues.
          (= (ct/ty-kind from) ct/TY-ARRAY) (emit-addr! (mut e) operand)
          (and (fnptr-type? target) (not (fnptr-type? from)))
            (do
              (put! (mut e) "(cast (ptr i8) (cast i64 ")
              (emit-expr! (mut e) operand)
              (put! (mut e) "))"))
          (and (fnptr-type? from) (not (fnptr-type? target)))
            (do
              (put! (mut e) "(cast i64 (cast (ptr i8) ")
              (emit-expr! (mut e) operand)
              (put! (mut e) "))"))
          :else (emit-expr! (mut e) operand))))

(defn bool-typed? [(n (ptr nd/Node))] (-> bool)
  (let [t (nd/nd-type n)]
    (and (!= (primitive/cast i64 t) 0) (= (ct/ty-kind t) ct/TY-BOOL))))

;;; A condition, not a value. Most of C's conditions already are conditions --
;;; a comparison is one, and `!`, `&&` and `||` are the ones Coil spells `not`,
;;; `and` and `or`, short-circuiting the same way. Only a plain value has to be
;;; tested against zero, which is what C means by `if (x)`.
(defn emit-truth! [(e (mut Emitter)) (n (ptr nd/Node))] (-> i64)
  (let [k (nd/nd-kind n)
        t (nd/nd-type n)]
    (cond (or (= k nd/ND-EQ) (or (= k nd/ND-NE) (or (= k nd/ND-LT) (= k nd/ND-LE))))
            (emit-binary! (mut e) n (compare-op (nd/nd-type (nd/nd-lhs n)) k))
          (= k nd/ND-NOT)
            (do
              (put! (mut e) "(not ")
              (emit-truth! (mut e) (nd/nd-lhs n))
              (put! (mut e) ")"))
          (= k nd/ND-LOGAND)
            (do
              (put! (mut e) "(and ")
              (emit-truth! (mut e) (nd/nd-lhs n))
              (put! (mut e) " ")
              (emit-truth! (mut e) (nd/nd-rhs n))
              (put! (mut e) ")"))
          (= k nd/ND-LOGOR)
            (do
              (put! (mut e) "(or ")
              (emit-truth! (mut e) (nd/nd-lhs n))
              (put! (mut e) " ")
              (emit-truth! (mut e) (nd/nd-rhs n))
              (put! (mut e) ")"))
          (and (!= (primitive/cast i64 t) 0) (ct/floating? t))
            (do
              (put! (mut e) "(fcmp-ne ")
              (emit-expr! (mut e) n)
              (put! (mut e) " (cast ")
              (emit-type! (mut e) t)
              (put! (mut e) " 0.0))"))
          (fnptr-type? t)
            (do
              (put! (mut e) "(!= (cast i64 (cast (ptr i8) ")
              (emit-expr! (mut e) n)
              (put! (mut e) ")) 0)"))
          :else
            (do
              (put! (mut e) "(!= (cast i64 ")
              (emit-expr! (mut e) n)
              (put! (mut e) ") 0)"))))
  0)

;;; Whether an operand is written down rather than computed.
(defn literal-operand? [(n (ptr nd/Node))] (-> bool)
  (let [v (eval-value n)] (and (= (.ok v) 1) (= (.flo v) 0))))

;;; A literal beside an operand that already has a type does not have to say the
;;; type again: an operator is a trait method, and it resolves from its left
;;; operand, which the literal then takes the type of. Equality is the exception
;;; -- `Eq` is generic in both operands at once, so there is no left operand to
;;; resolve from and a bare literal has nothing to agree with. Ordering, the
;;; arithmetic and the bitwise operators all take one.
(defn bare-literal-rhs? [(n (ptr nd/Node))] (-> bool)
  (let [k (nd/nd-kind n)
        rt (nd/nd-type (nd/nd-rhs n))]
    (and (and (!= k nd/ND-EQ) (!= k nd/ND-NE))
         (and (and (!= (primitive/cast i64 rt) 0) (ct/integer? rt))
              (and (literal-operand? (nd/nd-rhs n))
                   (not (literal-operand? (nd/nd-lhs n))))))))

;;; A value in a place whose type is already declared -- what is being stored
;;; into, what is being returned, what a parameter was declared as. A literal
;;; there takes the declared type, so it does not have to state one.
(defn emit-value! [(e (mut Emitter)) (n (ptr nd/Node))] (-> i64)
  (let [ty (nd/nd-type n)]
    (if (and (and (!= (primitive/cast i64 ty) 0) (ct/integer? ty))
             (literal-operand? n))
        (let [v (eval-value n)]
          (put-int! (mut e) (narrow-to (.i v) (ct/ty-size ty) (ct/ty-unsigned? ty))))
        (emit-expr! (mut e) n))))

(defn emit-atomic! [(e (mut Emitter)) (n (ptr nd/Node))] (-> i64)
  (let [name (nd/nd-label n)
        args (nd/nd-args n)
        count (al/al-len [(ptr nd/Node)] args)]
    (if (str/str-eq name "__asm_aarch64_yield")
        (put! (mut e) "(llvm-ir i32 [] \"call void asm sideeffect \\\"yield\\\", \\\"~{memory}\\\"()\\nret i32 0\")")
        (if (or (str/str-eq name "__builtin_popcount")
                (or (str/str-eq name "__builtin_popcountl")
                    (str/str-eq name "__builtin_popcountll")))
            (do
              (put! (mut e) "(cast i32 (popcount ")
              (emit-expr! (mut e) (al/al-get [(ptr nd/Node)] args 0))
              (put! (mut e) "))"))
        (if (or (str/str-eq name "__builtin_ctz")
                (or (str/str-eq name "__builtin_ctzl")
                    (str/str-eq name "__builtin_ctzll")))
            (let [arg (al/al-get [(ptr nd/Node)] args 0)
                  bits (* (ct/ty-size (nd/nd-type arg)) 8)]
              (put! (mut e) "(llvm-ir i32 [")
              (emit-expr! (mut e) arg)
              (if (= bits 64)
                  (put! (mut e) "] \"%n = call i64 @llvm.cttz.i64(i64 $0, i1 false)\\n%r = trunc i64 %n to i32\\nret i32 %r\")")
                  (put! (mut e) "] \"%n = call i32 @llvm.cttz.i32(i32 $0, i1 false)\\nret i32 %n\")")))
        (if (or (str/str-eq name "__builtin_bswap16")
                (or (str/str-eq name "__builtin_bswap32")
                    (str/str-eq name "__builtin_bswap64")))
            (do
              (put! (mut e) "(bswap ")
              (emit-expr! (mut e) (al/al-get [(ptr nd/Node)] args 0))
              (put! (mut e) ")"))
        (if (str/str-eq name "__builtin_alloca")
        (do
          (put! (mut e) "(llvm-ir (ptr i8) [")
          (emit-expr! (mut e) (al/al-get [(ptr nd/Node)] args 0))
          (put! (mut e) "] \"%p = alloca i8, i64 $0, align 16\\nret ptr %p\")"))
        (emit-sync-atomic! (mut e) n name args count)))))))
  0)

;;; LLVM integer types are signless. Coil distinguishes i32 from u32, but
;;; textual LLVM IR always spells both as i32 (and likewise for other widths).
(defn emit-llvm-int-type! [(e (mut Emitter)) (t (ptr ct/Type))] (-> i64)
  (put! (mut e) "i")
  (put-int! (mut e) (* (ct/ty-size t) 8))
  0)

(defn emit-sync-atomic! [(e (mut Emitter))
                         (n (ptr nd/Node))
                         (name (slice u8))
                         (args (al/ArrayList (ptr nd/Node)))
                         (count i64)] (-> i64)
  (do
    (put! (mut e) "(llvm-ir ")
    (emit-type! (mut e) (nd/nd-type n))
    (put! (mut e) " [")
    (let [(mut i) 0]
      (loop (if (>= (load i) count)
                (break)
                (do
                  (if (> (load i) 0) (put! (mut e) " ") 0)
                  (emit-expr! (mut e) (al/al-get [(ptr nd/Node)] args (load i)))
                  (store! i (+ (load i) 1))))))
    (put! (mut e) "] \"")
    (cond (str/str-eq name "__sync_synchronize") (put! (mut e) "fence seq_cst\\nret i32 0")
          (str/str-eq name "__c11_atomic_load")
            (do
              (put! (mut e) "%value = load atomic ")
              (emit-llvm-int-type! (mut e) (nd/nd-type n))
              (put! (mut e) ", ptr $0 seq_cst, align ")
              (put-int! (mut e) (ct/ty-align (nd/nd-type n)))
              (put! (mut e) "\\nret ")
              (emit-llvm-int-type! (mut e) (nd/nd-type n))
              (put! (mut e) " %value"))
          (str/str-eq name "__c11_atomic_store")
            (do
              (put! (mut e) "store atomic ")
              (emit-llvm-int-type! (mut e) (nd/nd-type n))
              (put! (mut e) " $1, ptr $0 seq_cst, align ")
              (put-int! (mut e) (ct/ty-align (nd/nd-type n)))
              (put! (mut e) "\\nret ")
              (emit-llvm-int-type! (mut e) (nd/nd-type n))
              (put! (mut e) " $1"))
          (str/str-eq name "__sync_val_compare_and_swap")
            (do
              (put! (mut e) "%pair = cmpxchg ptr $0, ")
              (emit-llvm-int-type! (mut e) (nd/nd-type n))
              (put! (mut e) " $1, ")
              (emit-llvm-int-type! (mut e) (nd/nd-type n))
              (put! (mut e) " $2 seq_cst seq_cst\\n%old = extractvalue { ")
              (emit-llvm-int-type! (mut e) (nd/nd-type n))
              (put! (mut e) ", i1 } %pair, 0\\nret ")
              (emit-llvm-int-type! (mut e) (nd/nd-type n))
              (put! (mut e) " %old"))
          :else
            (let [op
                    (cond (str/str-eq name "__sync_lock_test_and_set") "xchg"
                          (str/str-eq name "__sync_fetch_and_add") "add"
                          (str/str-eq name "__sync_fetch_and_sub") "sub"
                          (str/str-eq name "__sync_fetch_and_or") "or"
                          (str/str-eq name "__sync_fetch_and_xor") "xor"
                          :else "and")]
              (put! (mut e) "%old = atomicrmw ")
              (put! (mut e) op)
              (put! (mut e) " ptr $0, ")
              (emit-llvm-int-type! (mut e) (nd/nd-type n))
              (put! (mut e) " $1 seq_cst\\nret ")
              (emit-llvm-int-type! (mut e) (nd/nd-type n))
              (put! (mut e) " %old")))
    (put! (mut e) "\")"))
  0)

(defn emit-binary! [(e (mut Emitter)) (n (ptr nd/Node)) (op (slice u8))] (-> i64)
  (put! (mut e) "(")
  (put! (mut e) op)
  (put! (mut e) " ")
  (emit-expr! (mut e) (nd/nd-lhs n))
  (put! (mut e) " ")
  (if (bare-literal-rhs? n)
      (let [rt (nd/nd-type (nd/nd-rhs n))
            v (eval-value (nd/nd-rhs n))]
        (put-int! (mut e) (narrow-to (.i v) (ct/ty-size rt) (ct/ty-unsigned? rt))))
      (emit-expr! (mut e) (nd/nd-rhs n)))
  (put! (mut e) ")")
  0)

(defn nil-obj [] (-> (ptr nd/Obj))
  (primitive/cast (ptr nd/Obj) 0))

;;; A call site is identified by address, the same way an object is: two calls to
;;; the same function need two argument areas.
(defn node-key [(e (mut Emitter)) (n (ptr nd/Node))] (-> (slice u8))
  (let [(mut b) (str/sb-new (load (field e a)))]
    (str/sb-push-str! (mut b) "n")
    (str/sb-push-i64! (mut b) (primitive/cast i64 n))
    (str/sb-str (load (mut b)))))

;;; The object a call names, when it is a variadic function defined in this
;;; program rather than one the C library provides. Those two are passed
;;; differently: the library's take the platform's variadic convention, which
;;; Coil emits directly, while this program's take a pointer to an area the
;;; caller fills.
(defn variadic-target [(e (mut Emitter)) (n (ptr nd/Node))] (-> (ptr nd/Obj))
  (let [callee (nd/nd-lhs n)]
    (if (not (and (= (nd/nd-kind callee) nd/ND-CAST)
                  (= (nd/nd-kind (nd/nd-lhs callee)) nd/ND-VAR)))
        (nil-obj)
        (let [o (nd/nd-obj (nd/nd-lhs callee))]
          (if (and (= (ct/ty-kind (nd/obj-type o)) ct/TY-FUNC)
                   (and (ct/ty-variadic? (nd/obj-type o))
                        (hm/hm-contains? (load (field e defined)) (nd/obj-name o))))
              o
              (nil-obj))))))

(defn va-area-of [(e (mut Emitter)) (n (ptr nd/Node))] (-> (slice u8))
  (match (hm/hm-get (load (field e va-areas)) (node-key (mut e) n))
    (Some [s] s)
    (None [] "")))

;;; The area is laid out the way the platform lays out variadic arguments on this
;;; target: one eight-byte slot each, in order. That is what lets a `va_list`
;;; taken from it be handed straight to the C library's `vfprintf`.
(defn emit-variadic-call! [(e (mut Emitter)) (n (ptr nd/Node)) (o (ptr nd/Obj))] (-> i64)
  (let [args (nd/nd-args n)
        count (al/al-len [(ptr nd/Node)] args)
        named (al/al-len [(ptr ct/Type)] (ct/ty-params (nd/obj-type o)))
        area (va-area-of (mut e) n)
        (mut i) named]
    (if (= (slice-len area) 0)
        (fail! (mut e) "no argument area for this variadic call" (nd/nd-token n))
        0)
    (put! (mut e) "(do")
    (loop (if (>= (load i) count)
              (break)
              (let [arg (al/al-get [(ptr nd/Node)] args (load i))]
                (put! (mut e) " (set! (cast (ptr ")
                (emit-param-type! (mut e) (nd/nd-type arg))
                (put! (mut e) ") (index (cast (ptr u8) ")
                (put! (mut e) area)
                (put! (mut e) ") ")
                (put-int! (mut e) (* (- (load i) named) 8))
                (put! (mut e) ")) ")
                (emit-value! (mut e) arg)
                (put! (mut e) ")")
                (store! i (+ (load i) 1)))))
    (put! (mut e) " (")
    (put! (mut e) (callee-name (mut e) o))
    (store! i 0)
    (loop (if (>= (load i) named)
              (break)
              (do
                (put! (mut e) " ")
                (emit-expr! (mut e) (al/al-get [(ptr nd/Node)] args (load i)))
                (store! i (+ (load i) 1)))))
    (put! (mut e) " (cast (ptr i8) ")
    (put! (mut e) area)
    (put! (mut e) ")))"))
  0)

(defn emit-call! [(e (mut Emitter)) (n (ptr nd/Node))] (-> i64)
  (let [target (variadic-target (mut e) n)]
    (if (!= (primitive/cast i64 target) 0)
        (emit-variadic-call! (mut e) n target)
        (emit-plain-call! (mut e) n))))

;;; How many of a call's arguments the callee declared a type for. Everything
;;; past a `...` has none, and a literal there would be as wide as it liked --
;;; which for a variadic call decides how many bytes its slot takes. A function
;;; with no prototype declares nothing at all.
(defn declared-arity [(n (ptr nd/Node))] (-> i64)
  (let [callee (nd/nd-lhs n)]
    (if (and (= (nd/nd-kind callee) nd/ND-CAST)
             (and (= (nd/nd-kind (nd/nd-lhs callee)) nd/ND-VAR)
                  (= (ct/ty-kind (nd/obj-type (nd/nd-obj (nd/nd-lhs callee)))) ct/TY-FUNC)))
        (let [ty (nd/obj-type (nd/nd-obj (nd/nd-lhs callee)))]
          (if (and (= (ct/ty-kind ty) ct/TY-FUNC) (ct/ty-prototyped? ty))
              (al/al-len [(ptr ct/Type)] (ct/ty-params ty))
              0))
        0)))

(defn emit-plain-call! [(e (mut Emitter)) (n (ptr nd/Node))] (-> i64)
  (let [callee (nd/nd-lhs n)
        args (nd/nd-args n)
        count (al/al-len [(ptr nd/Node)] args)
        (mut i) 0
        arity (declared-arity n)
        direct
          (and (= (nd/nd-kind callee) nd/ND-CAST)
               (and (= (nd/nd-kind (nd/nd-lhs callee)) nd/ND-VAR)
                    (= (ct/ty-kind (nd/obj-type (nd/nd-obj (nd/nd-lhs callee)))) ct/TY-FUNC)))]
    ;; A call through a name is emitted as a direct call; anything else goes
    ;; through the function pointer it evaluates to.
    (if direct
        (do
          (put! (mut e) "(")
          (put! (mut e) (callee-name (mut e) (nd/nd-obj (nd/nd-lhs callee)))))
        (do
          (put! (mut e) "(call-ptr ")
          (emit-expr! (mut e) callee)))
    (loop (if (>= (load i) count)
              (break)
              (do
                (put! (mut e) " ")
                (if (< (load i) arity)
                    (emit-value! (mut e) (al/al-get [(ptr nd/Node)] args (load i)))
                    (emit-expr! (mut e) (al/al-get [(ptr nd/Node)] args (load i))))
                (store! i (+ (load i) 1)))))
    (put! (mut e) ")"))
  0)

(defn emit-assign! [(e (mut Emitter)) (n (ptr nd/Node))] (-> i64)
  (let [target (nd/nd-lhs n)
        value (nd/nd-rhs n)]
    (if (and (= (nd/nd-kind target) nd/ND-MEMBER) (>= (nd/nd-member-bit-width target) 0))
        (emit-bitfield-assign! (mut e) target value)
        ;; The address is worked out once and bound. An assignment yields the
        ;; value stored, which means reading the target back, and computing its
        ;; address a second time would run the target's own side effects twice:
        ;; `*++p = v` would step the pointer twice. A variable has no address to
        ;; work out, so there is nothing to bind.
        (let [bind (not (plain-variable? target))
              slot
                (if (plain-variable? target)
                    (slot-of (mut e) (nd/nd-obj target))
                    (fresh (mut e) "at"))]
          (if bind
              (do
                (put! (mut e) "(let [")
                (put! (mut e) slot)
                (put! (mut e) " ")
                (emit-addr! (mut e) target)
                (put! (mut e) "] "))
              0)
          (put! (mut e) "(do (set! ")
          (put! (mut e) slot)
          (put! (mut e) " ")
          (emit-value! (mut e) value)
          (put! (mut e) ") (load ")
          (put! (mut e) slot)
          (put! (mut e) "))")
          (if bind (put! (mut e) ")") 0))))
  0)

;;; An assignment or an update evaluated for its effect. Producing the value as
;;; well costs a bound address and a reload at every one, and a program is mostly
;;; assignments whose value nobody reads -- a static initialiser especially, where
;;; every element of every table is one of these.
(defn emit-assign-only! [(e (mut Emitter)) (n (ptr nd/Node))] (-> i64)
  (let [target (nd/nd-lhs n)
        value (nd/nd-rhs n)]
    (if (>= (nd/nd-member-bit-width target) 0)
        (emit-bitfield-store! (mut e) target value)
        (do
          (put! (mut e) "(set! ")
          (emit-addr! (mut e) target)
          (put! (mut e) " ")
          (emit-value! (mut e) value)
          (put! (mut e) ")"))))
  0)

(defn emit-compound-only! [(e (mut Emitter)) (n (ptr nd/Node))] (-> i64)
  (let [target (nd/nd-lhs n)
        value (nd/nd-rhs n)
        bind (not (plain-variable? target))
        at
          (if (plain-variable? target)
              (slot-of (mut e) (nd/nd-obj target))
              (fresh (mut e) "at"))]
    (if bind
        (do
          (put! (mut e) "(let [")
          (put! (mut e) at)
          (put! (mut e) " ")
          (emit-addr! (mut e) target)
          (put! (mut e) "] "))
        0)
    (al/al-push! [(slice u8)] (mut (field e target-addrs)) at)
    (emit-target-store! (mut e) target at value)
    (al/al-pop! [(slice u8)] (mut (field e target-addrs)))
    (if bind (put! (mut e) ")") 0))
  0)

(defn emit-discarded! [(e (mut Emitter)) (n (ptr nd/Node))] (-> i64)
  (let [k (nd/nd-kind n)]
    (cond (= k nd/ND-ASSIGN) (emit-assign-only! (mut e) n)
          (= k nd/ND-COMPOUND) (emit-compound-only! (mut e) n)
          ;; A conditional in statement context preserves which branch executes,
          ;; but not either branch's value. Emitting it through emit-expr! forced
          ;; Coil to unify widths that C deliberately permits to differ here (most
          ;; visibly in Darwin's assert macro, whose failure arm calls a void
          ;; function and whose success arm is `(void)0`).
          (= k nd/ND-COND)
            (do
              (put! (mut e) "(if ")
              (emit-truth! (mut e) (nd/nd-test n))
              (put! (mut e) " (do ")
              (emit-discarded! (mut e) (nd/nd-then n))
              (put! (mut e) " 0) (do ")
              (emit-discarded! (mut e) (nd/nd-else n))
              (put! (mut e) " 0))"))
          ;; The left side is discarded even when the comma expression's eventual
          ;; value is used. Here the whole expression is discarded, so lower both
          ;; sides for effect and give the enclosing form one stable result width.
          (= k nd/ND-COMMA)
            (do
              (put! (mut e) "(do ")
              (emit-discarded! (mut e) (nd/nd-lhs n))
              (put! (mut e) " ")
              (emit-discarded! (mut e) (nd/nd-rhs n))
              (put! (mut e) " 0)"))
          :else (do (put! (mut e) "(do ") (emit-expr! (mut e) n) (put! (mut e) " 0)")))))

(defn callee-name [(e (mut Emitter)) (o (ptr nd/Obj))] (-> (slice u8))
  (if (hm/hm-contains? (load (field e defined)) (nd/obj-name o))
      (if (str/str-eq (nd/obj-name o) "main")
          "c-main"
          (source-name (mut e) (nd/obj-name o)))
      (link-name o)))

(defn allocation-call? [(n (ptr nd/Node))] (-> bool)
  (if (!= (nd/nd-kind n) nd/ND-CALL)
      false
      (let [callee (nd/nd-lhs n)]
        (if (not (and (= (nd/nd-kind callee) nd/ND-CAST)
                      (= (nd/nd-kind (nd/nd-lhs callee)) nd/ND-VAR)))
            false
            (let [name (nd/obj-name (nd/nd-obj (nd/nd-lhs callee)))]
              (or (str/str-eq name "malloc")
                  (or (str/str-eq name "calloc")
                      (or (str/str-eq name "realloc")
                          (str/str-eq name "Z_Malloc")))))))))

(defn typed-allocation-cast? [(n (ptr nd/Node))] (-> bool)
  (let [t (nd/nd-type n)]
    (and (= (nd/nd-kind n) nd/ND-CAST)
         (and (!= (primitive/cast i64 t) 0)
              (and (= (ct/ty-kind t) ct/TY-PTR)
                   (let [base (ct/ty-base t)]
                     (and (!= (primitive/cast i64 base) 0)
                          (and (ct/record? base)
                               (and (> (slice-len (ct/ty-name base)) 0)
                                    (allocation-call? (nd/nd-lhs n)))))))))))

(defn emit-expr! [(e (mut Emitter)) (n (ptr nd/Node))] (-> i64)
  (if (= (primitive/cast i64 n) 0)
      (put! (mut e) "0")
      (let [k (nd/nd-kind n)
            t (nd/nd-type n)]
        (cond ;; Reported rather than narrowed: a 128-bit value silently computed as
              ;; 64 bits would be wrong in a way nothing downstream could catch.
              (and (!= (primitive/cast i64 t) 0) (= (ct/ty-kind t) ct/TY-INT128))
                (fail! (mut e) "128-bit integer arithmetic is not supported" (nd/nd-token n))
              (and (!= (primitive/cast i64 t) 0) (= (ct/ty-kind t) ct/TY-FLOAT16))
                (fail! (mut e) "half-precision arithmetic is not supported" (nd/nd-token n))
              (= k nd/ND-NUM)
                (do
                  (put! (mut e) "(cast ")
                  (emit-type! (mut e) t)
                  (put! (mut e) " ")
                  (if (and (!= (primitive/cast i64 t) 0) (ct/floating? t))
                      (put-float! (mut e) (nd/nd-fvalue n))
                      (put-int! (mut e) (nd/nd-value n)))
                  (put! (mut e) ")"))
              ;; Arithmetic between constants is done here rather than at run time.
              ;; `a[3]` scales its subscript by the element size, and both are
              ;; constants; so is most of what a macro expands to. The value is the
              ;; one the target would compute, narrowed through the type C gives the
              ;; expression, so nothing can tell the difference.
              (constant-arithmetic? n)
                (let [v (eval-value n)]
                  (put! (mut e) "(cast ")
                  (emit-type! (mut e) t)
                  (put! (mut e) " ")
                  (put-int! (mut e) (narrow-to (.i v) (ct/ty-size t) (ct/ty-unsigned? t)))
                  (put! (mut e) ")"))
              ;; An array or a function names its own address; anything else is
              ;; read from it.
              (= k nd/ND-VAR)
                (let [vt (nd/nd-type n)]
                  (cond (= (ct/ty-kind vt) ct/TY-FUNC)
                          (do
                            (put! (mut e) "(fnptr-of ")
                            (put! (mut e) (callee-name (mut e) (nd/nd-obj n)))
                            (put! (mut e) ")"))
                        (= (ct/ty-kind vt) ct/TY-ARRAY) (emit-addr! (mut e) n)
                        (direct-value? (mut e) (nd/nd-obj n)) (put! (mut e) (slot-of (mut e) (nd/nd-obj n)))
                        :else (do (put! (mut e) "(load ") (emit-addr! (mut e) n) (put! (mut e) ")"))))
              (= k nd/ND-STMT-EXPR) (emit-compound-literal! (mut e) n false)
              (= k nd/ND-MEMBER)
                (if (>= (nd/nd-member-bit-width n) 0)
                    (emit-bitfield-load! (mut e) n)
                    (if (= (ct/ty-kind t) ct/TY-ARRAY)
                        (emit-addr! (mut e) n)
                        (do (put! (mut e) "(load ") (emit-addr! (mut e) n) (put! (mut e) ")"))))
              (= k nd/ND-DEREF)
                (if (or (= (ct/ty-kind t) ct/TY-ARRAY) (= (ct/ty-kind t) ct/TY-FUNC))
                    (emit-expr! (mut e) (nd/nd-lhs n))
                    (do (put! (mut e) "(load ") (emit-addr! (mut e) n) (put! (mut e) ")")))
              (= k nd/ND-ADDR) (emit-addr! (mut e) (nd/nd-lhs n))
              (= k nd/ND-ASSIGN) (emit-assign! (mut e) n)
              (= k nd/ND-COMPOUND) (emit-compound! (mut e) n)
              (= k nd/ND-TARGET) (emit-target-load! (mut e) n (top-label (load (field e target-addrs))))
              (= k nd/ND-ATOMIC) (emit-atomic! (mut e) n)
              ;; A record has no cast: the value already has the storage type the
              ;; target wants, and Coil has no conversion between aggregates.
              (and (= k nd/ND-CAST) (ct/record? t)) (emit-expr! (mut e) (nd/nd-lhs n))
              (typed-allocation-cast? n)
                (let [record (ct/ty-base t)]
                  (put! (mut e) "(c-type-hint \"")
                  (put! (mut e) (ct/ty-name record))
                  (put! (mut e) "\" ")
                  (put-int! (mut e) (ct/ty-size record))
                  (put! (mut e) " ")
                  (put-int! (mut e) (ct/ty-align record))
                  (put! (mut e) " ")
                  (emit-expr! (mut e) (nd/nd-lhs n))
                  (put! (mut e) ")"))
              ;; Converting to `_Bool` is a test against zero, not a narrowing: C
              ;; says the result is 1 or 0, and 256 would truncate to neither.
              (and (= k nd/ND-CAST)
                   (and (= (ct/ty-kind t) ct/TY-BOOL) (not (bool-typed? (nd/nd-lhs n)))))
                (do
                  (put! (mut e) "(cast u8 (if ")
                  (emit-truth! (mut e) (nd/nd-lhs n))
                  (put! (mut e) " 1 0))"))
              (= k nd/ND-CAST)
                (let [operand (without-redundant-casts (nd/nd-lhs n) t)]
                  (cond (self-typed? operand t) (emit-expr! (mut e) operand)
                        (foldable-literal? operand t)
                          (do
                            (put! (mut e) "(cast ")
                            (emit-param-type! (mut e) t)
                            (put! (mut e) " ")
                            (put-int! (mut e) (nd/nd-value operand))
                            (put! (mut e) ")"))
                        :else
                          (do
                            (put! (mut e) "(cast ")
                            (emit-param-type! (mut e) t)
                            (put! (mut e) " ")
                            (emit-cast-operand! (mut e) operand t)
                            (put! (mut e) ")"))))
              ;; Clearing an object an initialiser only partly fills.
              (= k nd/ND-MEMZERO)
                (do
                  (put! (mut e) "(set! ")
                  (emit-addr! (mut e) (nd/nd-lhs n))
                  (put! (mut e) " (zeroed ")
                  (emit-type! (mut e) t)
                  (put! (mut e) "))"))
              (= k nd/ND-CALL) (emit-call! (mut e) n)
              ;; `va_start` points the list at the area the caller filled, which
              ;; arrived as the function's last parameter.
              (= k nd/ND-VA-START)
                (do
                  (put! (mut e) "(do (set! ")
                  (emit-addr! (mut e) (nd/nd-lhs n))
                  (put! (mut e) " c_va) 0)"))
              ;; `va_arg` reads the slot the list points at and steps past it.
              (= k nd/ND-VA-ARG)
                (let [slot (fresh (mut e) "va")]
                  (put! (mut e) "(let [")
                  (put! (mut e) slot)
                  (put! (mut e) " (load ")
                  (emit-addr! (mut e) (nd/nd-lhs n))
                  (put! (mut e) ")] (do (set! ")
                  (emit-addr! (mut e) (nd/nd-lhs n))
                  (put! (mut e) " (index ")
                  (put! (mut e) slot)
                  (put! (mut e) " 8)) (load (cast (ptr ")
                  (emit-param-type! (mut e) t)
                  (put! (mut e) ") ")
                  (put! (mut e) slot)
                  ;; closes: cast, load, do, let
                  (put! (mut e) "))))"))
              (= k nd/ND-NEG)
                (do
                  (put! (mut e) "(")
                  (put! (mut e) (if (ct/floating? t) "fsub" "isub"))
                  (put! (mut e) " (cast ")
                  (emit-type! (mut e) t)
                  (put! (mut e) " 0) ")
                  (emit-expr! (mut e) (nd/nd-lhs n))
                  (put! (mut e) ")"))
              (= k nd/ND-BITNOT) (do (put! (mut e) "(inot ") (emit-expr! (mut e) (nd/nd-lhs n)) (put! (mut e) ")"))
              (= k nd/ND-NOT)
                (do
                  (put! (mut e) "(cast ")
                  (emit-type! (mut e) t)
                  (put! (mut e) " (if ")
                  (emit-truth! (mut e) (nd/nd-lhs n))
                  (put! (mut e) " 0 1))"))
              ;; Both operands of && and || must not be evaluated unconditionally.
              (= k nd/ND-LOGAND)
                (do
                  (put! (mut e) "(cast ")
                  (emit-type! (mut e) t)
                  (put! (mut e) " (if (and ")
                  (emit-truth! (mut e) (nd/nd-lhs n))
                  (put! (mut e) " ")
                  (emit-truth! (mut e) (nd/nd-rhs n))
                  (put! (mut e) ") 1 0))"))
              (= k nd/ND-LOGOR)
                (do
                  (put! (mut e) "(cast ")
                  (emit-type! (mut e) t)
                  (put! (mut e) " (if (or ")
                  (emit-truth! (mut e) (nd/nd-lhs n))
                  (put! (mut e) " ")
                  (emit-truth! (mut e) (nd/nd-rhs n))
                  (put! (mut e) ") 1 0))"))
              (or (= k nd/ND-EQ) (or (= k nd/ND-NE) (or (= k nd/ND-LT) (= k nd/ND-LE))))
                (do
                  (put! (mut e) "(cast ")
                  (emit-type! (mut e) t)
                  (put! (mut e) " (if ")
                  (emit-binary! (mut e) n (compare-op (nd/nd-type (nd/nd-lhs n)) k))
                  (put! (mut e) " 1 0))"))
              (= k nd/ND-COND)
                (do
                  (put! (mut e) "(if ")
                  (emit-truth! (mut e) (nd/nd-test n))
                  (put! (mut e) " ")
                  (emit-expr! (mut e) (nd/nd-then n))
                  (put! (mut e) " ")
                  (emit-expr! (mut e) (nd/nd-else n))
                  (put! (mut e) ")"))
              (= k nd/ND-COMMA)
                (do
                  (put! (mut e) "(do ")
                  (emit-expr! (mut e) (nd/nd-lhs n))
                  (put! (mut e) " ")
                  (emit-expr! (mut e) (nd/nd-rhs n))
                  (put! (mut e) ")"))
              ;; The parser has already scaled the operand to bytes, so this walks
              ;; the pointer by bytes and restores its type. Integer addition would
              ;; not typecheck against a pointer, and would be the wrong operation.
              (and (or (= k nd/ND-ADD) (= k nd/ND-SUB)) (ct/pointer-like? t))
                (do
                  (put! (mut e) "(cast (ptr ")
                  (emit-pointee! (mut e) (ct/ty-base t))
                  (put! (mut e) ") (index (cast (ptr u8) ")
                  (emit-at-value! (mut e) (nd/nd-lhs n))
                  (put! (mut e) ") ")
                  (if (= k nd/ND-SUB)
                      (do
                        (put! (mut e) "(- 0 (cast i64 ")
                        (emit-expr! (mut e) (nd/nd-rhs n))
                        (put! (mut e) "))"))
                      (do
                        (put! (mut e) "(cast i64 ")
                        (emit-expr! (mut e) (nd/nd-rhs n))
                        (put! (mut e) ")")))
                  (put! (mut e) "))"))
              ;; A pointer difference is a byte difference; the parser divides it by
              ;; the element size.
              (and (= k nd/ND-SUB)
                   (and (ct/pointer-like? (nd/nd-type (nd/nd-lhs n)))
                        (ct/pointer-like? (nd/nd-type (nd/nd-rhs n)))))
                (do
                  (put! (mut e) "(- (cast i64 ")
                  (emit-expr! (mut e) (nd/nd-lhs n))
                  (put! (mut e) ") (cast i64 ")
                  (emit-expr! (mut e) (nd/nd-rhs n))
                  (put! (mut e) "))"))
              :else (emit-binary! (mut e) n (arith-op t k))))))

;; ------------------------------------------------------------- statements

;;; Objects are identified by address rather than by name, because C lets an
;;; inner scope shadow an outer one and both are live at once.
(defn obj-key [(e (mut Emitter)) (o (ptr nd/Obj))] (-> (slice u8))
  (let [(mut b) (str/sb-new (load (field e a)))]
    (str/sb-push-str! (mut b) "o")
    (str/sb-push-i64! (mut b) (primitive/cast i64 o))
    (str/sb-str (load (mut b)))))

(defn bind-slot! [(e (mut Emitter)) (o (ptr nd/Obj)) (slot (slice u8))] (-> i64)
  (hm/hm-put! [(slice u8) (slice u8)] (mut (field e slots)) (obj-key (mut e) o) slot)
  0)

(defn slot-of [(e (mut Emitter)) (o (ptr nd/Obj))] (-> (slice u8))
  (match (hm/hm-get (load (field e slots)) (obj-key (mut e) o))
    (Some [s] s)
    (None []
          (if (hm/hm-contains? (load (field e defined-data)) (nd/obj-name o))
              (source-name (mut e) (nd/obj-name o))
              (extern-data-name (mut e) (nd/obj-name o))))))

;;; `break` and `continue` name the scope they leave rather than relying on which
;;; construct happens to be innermost, because a `break` inside a switch inside a
;;; loop leaves the switch while a `continue` there leaves the loop body.
(defn push-break! [(e (mut Emitter)) (label (slice u8))] (-> i64)
  (al/al-push! [(slice u8)] (mut (field e break-labels)) label)
  0)

(defn pop-break! [(e (mut Emitter))] (-> i64)
  (al/al-pop! [(slice u8)] (mut (field e break-labels)))
  0)

(defn push-continue! [(e (mut Emitter)) (label (slice u8))] (-> i64)
  (al/al-push! [(slice u8)] (mut (field e continue-labels)) label)
  0)

(defn pop-continue! [(e (mut Emitter))] (-> i64)
  (al/al-pop! [(slice u8)] (mut (field e continue-labels)))
  0)

(defn top-label [(list (al/ArrayList (slice u8)))] (-> (slice u8))
  (let [n (al/al-len [(slice u8)] list)]
    (if (= n 0) "" (al/al-get [(slice u8)] list (- n 1)))))

;;; A case label carries the statement it labels, so `case 1: case 2: f();`
;;; arrives nested. Flattening unwraps those chains into a linear list in which
;;; every case is a marker standing immediately before the statements it
;;; introduces -- the shape the fallthrough lowering below reads.
(defn flatten-case! [(out (mut (al/ArrayList (ptr nd/Node)))) (s (ptr nd/Node))] (-> i64)
  (al/al-push! [(ptr nd/Node)] (mut out) s)
  (if (= (nd/nd-kind s) nd/ND-CASE)
      (flatten-case! (mut out) (nd/nd-then s))
      0))

;;; Which group `default` selects. With no default the answer is one past the
;;; last group, which selects nothing -- exactly what C says an unmatched switch
;;; without a default does.
(defn switch-default-group [(flat (al/ArrayList (ptr nd/Node)))] (-> i64)
  (let [count (al/al-len [(ptr nd/Node)] flat)
        (mut i) 0
        (mut group) 0
        (mut found) -1]
    (loop (if (>= (load i) count)
              (break)
              (let [s (al/al-get [(ptr nd/Node)] flat (load i))]
                (if (= (nd/nd-kind s) nd/ND-CASE)
                    (do
                      (if (and (= (load found) -1) (str/str-eq (nd/nd-label s) "default"))
                          (store! found (load group))
                          0)
                      (store! group (+ (load group) 1)))
                    0)
                (store! i (+ (load i) 1)))))
    (if (= (load found) -1) (load group) (load found))))

;;; Emit a bounded leaf of comparisons that turns the switch value into a group
;;; index. `default` has no comparison; it is supplied as the final fallback.
(defn emit-switch-selector-leaf! [(e (mut Emitter))
                                  (flat (al/ArrayList (ptr nd/Node)))
                                  (value (slice u8))
                                  (from i64)
                                  (until i64)
                                  (fallback i64)] (-> i64)
  (let [count (al/al-len [(ptr nd/Node)] flat)
        (mut i) 0
        (mut group) 0
        (mut opened) 0]
    (loop (if (>= (load i) count)
              (break)
              (let [s (al/al-get [(ptr nd/Node)] flat (load i))]
                (if (= (nd/nd-kind s) nd/ND-CASE)
                    (do
                      (if (or (< (load group) from)
                              (>= (load group) until)
                              (str/str-eq (nd/nd-label s) "default"))
                          0
                          (do
                            (put! (mut e) "(if (= ")
                            (put! (mut e) value)
                            (put! (mut e) " ")
                            (put-int! (mut e) (nd/nd-value s))
                            (put! (mut e) ") ")
                            (put-int! (mut e) (load group))
                            (put! (mut e) " ")
                            (store! opened (+ (load opened) 1))))
                      (store! group (+ (load group) 1)))
                    0)
                (store! i (+ (load i) 1)))))
    (put-int! (mut e) fallback)
    (let [(mut j) 0]
      (loop (if (>= (load j) (load opened))
                (break)
                (do (put! (mut e) ")") (store! j (+ (load j) 1))))))
    0))

;;; Generated parsers can contain hundreds of switch labels. A balanced search
;;; shape prevents those labels from becoming hundreds of nested macro visits.
(defn emit-switch-selector-range! [(e (mut Emitter))
                                   (flat (al/ArrayList (ptr nd/Node)))
                                   (value (slice u8))
                                   (from i64)
                                   (until i64)
                                   (fallback i64)] (-> i64)
  (if (<= (- until from) 16)
      (emit-switch-selector-leaf! (mut e) flat value from until fallback)
      (let [middle (+ from (primitive/idiv (- until from) 2))
            candidate (fresh (mut e) "sc")]
        (put! (mut e) "(let [")
        (put! (mut e) candidate)
        (put! (mut e) " ")
        (emit-switch-selector-range! (mut e) flat value from middle -1)
        (put! (mut e) "] (if (>= ")
        (put! (mut e) candidate)
        (put! (mut e) " 0) ")
        (put! (mut e) candidate)
        (put! (mut e) " ")
        (emit-switch-selector-range! (mut e) flat value middle until fallback)
        (put! (mut e) "))")))
  0)

(defn emit-switch-selector! [(e (mut Emitter))
                             (flat (al/ArrayList (ptr nd/Node)))
                             (value (slice u8))] (-> i64)
  (emit-switch-selector-range! (mut e)
                               flat
                               value
                               0
                               (switch-group-count flat)
                               (switch-default-group flat)))

;;; Emit one guarded case group. Every group from the selected one onward runs,
;;; which implements C fallthrough; a break still exits the surrounding scope.
(defn emit-switch-group! [(e (mut Emitter))
                          (flat (al/ArrayList (ptr nd/Node)))
                          (index (slice u8))
                          (wanted i64)] (-> i64)
  (let [count (al/al-len [(ptr nd/Node)] flat)
        (mut i) 0
        (mut group) -1]
    (put! (mut e) " (if (<= ")
    (put! (mut e) index)
    (put! (mut e) " ")
    (put-int! (mut e) wanted)
    (put! (mut e) ") (do")
    (loop (if (>= (load i) count)
              (break)
              (let [s (al/al-get [(ptr nd/Node)] flat (load i))]
                (if (= (nd/nd-kind s) nd/ND-CASE)
                    (store! group (+ (load group) 1))
                    (if (= (load group) wanted)
                        (do (put! (mut e) " ") (emit-stmt! (mut e) s))
                        0))
                (store! i (+ (load i) 1)))))
    (put! (mut e) " 0) 0)")
    0))

;;; Keep the generated `do` tree shallow even for generated-code switches with
;;; hundreds of labels (GLAD contains several). A flat variadic `do`, or the old
;;; linear nesting of case groups, exceeds Coil's macro expansion guard.
(defn emit-switch-group-range! [(e (mut Emitter))
                                (flat (al/ArrayList (ptr nd/Node)))
                                (index (slice u8))
                                (from i64)
                                (until i64)] (-> i64)
  (if (<= (- until from) 16)
      (let [(mut group) from]
        (loop (if (>= (load group) until)
                  (break)
                  (do
                    (emit-switch-group! (mut e) flat index (load group))
                    (store! group (+ (load group) 1))))))
      (let [middle (+ from (primitive/idiv (- until from) 2))]
        (put! (mut e) " (do")
        (emit-switch-group-range! (mut e) flat index from middle)
        (put! (mut e) " 0)")
        (put! (mut e) " (do")
        (emit-switch-group-range! (mut e) flat index middle until)
        (put! (mut e) " 0)")))
  0)

(defn switch-group-count [(flat (al/ArrayList (ptr nd/Node)))] (-> i64)
  (let [count (al/al-len [(ptr nd/Node)] flat)
        (mut i) 0
        (mut groups) 0]
    (loop (if (>= (load i) count)
              (break)
              (do
                (if (= (nd/nd-kind (al/al-get [(ptr nd/Node)] flat (load i))) nd/ND-CASE)
                    (store! groups (+ (load groups) 1))
                    0)
                (store! i (+ (load i) 1)))))
    (load groups)))

(defn emit-switch-groups! [(e (mut Emitter))
                           (flat (al/ArrayList (ptr nd/Node)))
                           (index (slice u8))] (-> i64)
  (put! (mut e) "(do")
  (emit-switch-group-range! (mut e) flat index 0 (switch-group-count flat))
  (put! (mut e) " 0)")
  0)

(defn emit-switch! [(e (mut Emitter)) (n (ptr nd/Node))] (-> i64)
  (let [body (nd/nd-then n)]
    (if (!= (nd/nd-kind body) nd/ND-BLOCK)
        (fail! (mut e) "a switch body must be a block" (nd/nd-token n))
        (let [(mut flat) (al/al-new [(ptr nd/Node)] (load (field e a)))
              src (nd/nd-body body)
              count (al/al-len [(ptr nd/Node)] src)
              (mut i) 0]
          (loop (if (>= (load i) count)
                    (break)
                    (do
                      (flatten-case! (mut flat) (al/al-get [(ptr nd/Node)] src (load i)))
                      (store! i (+ (load i) 1)))))
          (let [items (load flat)
                brk (fresh (mut e) ":brk")
                value (fresh (mut e) "sw")
                index (fresh (mut e) "sg")]
            (push-break! (mut e) brk)
            (put! (mut e) "(control/block ")
            (put! (mut e) brk)
            (put! (mut e) " (let [")
            (put! (mut e) value)
            (put! (mut e) " (cast i64 ")
            (emit-expr! (mut e) (nd/nd-test n))
            (put! (mut e) ") ")
            (put! (mut e) index)
            (put! (mut e) " ")
            (emit-switch-selector! (mut e) items value)
            (put! (mut e) "] ")
            (emit-switch-groups! (mut e) items index)
            (put! (mut e) "))")
            (pop-break! (mut e))
            0)))))

;;; Coil's `do` is a variadic macro. Feeding it thousands of static initializer
;;; stores makes macro expansion exceed its recursion guard, so long C blocks
;;; are emitted as a balanced tree of bounded `do` forms. Evaluation order is
;;; unchanged and nesting depth grows logarithmically.
(defn emit-block-range! [(e (mut Emitter))
                         (body (al/ArrayList (ptr nd/Node)))
                         (from i64)
                         (until i64)] (-> i64)
  (if (<= (- until from) 32)
      (let [(mut i) from]
        (loop (if (>= (load i) until)
                  (break)
                  (let [s (al/al-get [(ptr nd/Node)] body (load i))]
                    (cond (nothing-to-do? s) 0
                          (= (nd/nd-kind s) nd/ND-BLOCK) (emit-block-body! (mut e) s)
                          :else (do (put! (mut e) " ") (emit-stmt! (mut e) s)))
                    (store! i (+ (load i) 1))))))
      (let [middle (+ from (primitive/idiv (- until from) 2))]
        (put! (mut e) " (do")
        (emit-block-range! (mut e) body from middle)
        (put! (mut e) " 0)")
        (put! (mut e) " (do")
        (emit-block-range! (mut e) body middle until)
        (put! (mut e) " 0)")))
  0)

;;; The statements of a block, and of any block directly inside it. C nests a
;;; block wherever it declares something, and the declarations have already been
;;; hoisted out with names of their own, so the nesting carries nothing.
(defn emit-block-body! [(e (mut Emitter)) (n (ptr nd/Node))] (-> i64)
  (let [body (nd/nd-body n)]
    (emit-block-range! (mut e) body 0 (al/al-len [(ptr nd/Node)] body)))
  0)

(defn emit-stmt! [(e (mut Emitter)) (n (ptr nd/Node))] (-> i64)
  (if (= (primitive/cast i64 n) 0)
      (put! (mut e) "0")
      (let [k (nd/nd-kind n)]
        (cond (= k nd/ND-NULL) (put! (mut e) "0")
              (= k nd/ND-BLOCK)
                (do
                  (put! (mut e) "(do")
                  (emit-block-body! (mut e) n)
                  (put! (mut e) " 0)"))
              ;; The value is discarded, so it is never produced.
              (= k nd/ND-EXPR-STMT) (emit-discarded! (mut e) (nd/nd-lhs n))
              (= k nd/ND-RETURN)
                (do
                  (put! (mut e) "(control/return-from :c-return ")
                  (if (= (primitive/cast i64 (nd/nd-lhs n)) 0)
                      (put! (mut e) "0")
                      (emit-value! (mut e) (nd/nd-lhs n)))
                  (put! (mut e) ")"))
              (= k nd/ND-IF)
                (do
                  (put! (mut e) "(if ")
                  (emit-truth! (mut e) (nd/nd-test n))
                  (put! (mut e) " ")
                  (emit-stmt! (mut e) (nd/nd-then n))
                  (put! (mut e) " ")
                  (if (= (primitive/cast i64 (nd/nd-else n)) 0)
                      (put! (mut e) "0")
                      (emit-stmt! (mut e) (nd/nd-else n)))
                  (put! (mut e) ")"))
              (= k nd/ND-WHILE)
                (let [brk (fresh (mut e) ":brk")
                      cnt (fresh (mut e) ":cnt")]
                  (push-break! (mut e) brk)
                  (push-continue! (mut e) cnt)
                  (put! (mut e) "(control/block ")
                  (put! (mut e) brk)
                  (put! (mut e) " (loop (if ")
                  (emit-truth! (mut e) (nd/nd-test n))
                  (put! (mut e) " (do (control/block ")
                  (put! (mut e) cnt)
                  (put! (mut e) " ")
                  (emit-stmt! (mut e) (nd/nd-then n))
                  (put! (mut e) " ) 0) (break))))")
                  (pop-continue! (mut e))
                  (pop-break! (mut e))
                  0)
              ;; The body runs before the test, so the test guards only the repeat.
              (= k nd/ND-DO)
                (let [brk (fresh (mut e) ":brk")
                      cnt (fresh (mut e) ":cnt")]
                  (push-break! (mut e) brk)
                  (push-continue! (mut e) cnt)
                  (put! (mut e) "(control/block ")
                  (put! (mut e) brk)
                  (put! (mut e) " (loop (do (control/block ")
                  (put! (mut e) cnt)
                  (put! (mut e) " ")
                  (emit-stmt! (mut e) (nd/nd-then n))
                  (put! (mut e) ") (if ")
                  (emit-truth! (mut e) (nd/nd-test n))
                  (put! (mut e) " 0 (break)))))")
                  (pop-continue! (mut e))
                  (pop-break! (mut e))
                  0)
              ;; The initialiser runs once outside the loop; the step runs after the
              ;; body, which is what `continue` has to skip to.
              (= k nd/ND-FOR)
                (let [brk (fresh (mut e) ":brk")
                      cnt (fresh (mut e) ":cnt")]
                  (push-break! (mut e) brk)
                  (push-continue! (mut e) cnt)
                  (put! (mut e) "(do ")
                  (if (= (primitive/cast i64 (nd/nd-setup n)) 0)
                      (put! (mut e) "0")
                      (emit-stmt! (mut e) (nd/nd-setup n)))
                  (put! (mut e) " (control/block ")
                  (put! (mut e) brk)
                  (put! (mut e) " (loop (if ")
                  (if (= (primitive/cast i64 (nd/nd-test n)) 0)
                      (put! (mut e) "true")
                      (emit-truth! (mut e) (nd/nd-test n)))
                  (put! (mut e) " (do (control/block ")
                  (put! (mut e) cnt)
                  (put! (mut e) " ")
                  (emit-stmt! (mut e) (nd/nd-then n))
                  (put! (mut e) ") ")
                  (if (= (primitive/cast i64 (nd/nd-step n)) 0)
                      (put! (mut e) "0")
                      (emit-stmt! (mut e) (nd/nd-step n)))
                  (put! (mut e) ") (break)))))")
                  (pop-continue! (mut e))
                  (pop-break! (mut e))
                  0)
              (= k nd/ND-BREAK)
                (do
                  (put! (mut e) "(control/return-from ")
                  (put! (mut e) (top-label (load (field e break-labels))))
                  (put! (mut e) " 0)"))
              (= k nd/ND-CONTINUE)
                (do
                  (put! (mut e) "(control/return-from ")
                  (put! (mut e) (top-label (load (field e continue-labels))))
                  (put! (mut e) " 0)"))
              (= k nd/ND-SWITCH) (emit-switch! (mut e) n)
              ;; Reached only for a case that is not directly in a switch body.
              (= k nd/ND-CASE) (emit-stmt! (mut e) (nd/nd-then n))
              ;; Not yet lowered. This reports rather than emitting something that
              ;; would silently run the wrong code.
              ;; Only reachable if a label survived into the structured path,
              ;; which the check in emit-function! rules out.
              (= k nd/ND-GOTO) (fail! (mut e) "goto outside a flow graph" (nd/nd-token n))
              (= k nd/ND-LABEL) (fail! (mut e) "label outside a flow graph" (nd/nd-token n))
              :else (emit-discarded! (mut e) n)))))

;; ------------------------------------------------------- unstructured flow

;;; `goto` can leave a loop, enter one, or jump backwards past a declaration, and
;;; no arrangement of Coil's structured forms expresses all of that. A function
;;; containing a label is therefore lowered the way a machine would run it: the
;;; body is cut into straight-line blocks, each ending in a jump, and a loop
;;; around a dispatch runs whichever block a state variable names. Every jump,
;;; including the ones `if` and `while` imply, becomes an assignment to that
;;; variable.
;;;
;;; Functions without a label -- nearly all of them -- keep the structured
;;; lowering above, which is both easier to read and easier for the optimiser.
(const TERM-JUMP 0)

(const TERM-BRANCH 1)

(const TERM-RETURN 2)

(const TERM-END 3)

(const TERM-SWITCH 4)

(defstruct Block
  [(stmts (al/ArrayList (ptr nd/Node)))
   (term i64)
   (test (ptr nd/Node))
   (value (ptr nd/Node))
   (a i64)
   (b i64)
   (cases (al/ArrayList i64))
   (targets (al/ArrayList i64))])

(defstruct Flow
  [(alloc (dyn alloc/Allocator))
   (blocks (al/ArrayList (ptr Block)))
   (current i64)
   ;; A label may be jumped to before it is seen, so its block is created by
   ;; whichever mention comes first.
   (labels (hm/HashMap (slice u8) i64))
   (breaks (al/ArrayList i64))
   (continues (al/ArrayList i64))])

(defn has-label? [(n (ptr nd/Node))] (-> bool)
  (if (= (primitive/cast i64 n) 0)
      false
      (or (= (nd/nd-kind n) nd/ND-LABEL)
          (or (has-label? (nd/nd-lhs n))
              (or (has-label? (nd/nd-then n))
                  (or (has-label? (nd/nd-else n))
                      (or (has-label? (nd/nd-setup n))
                          (or (has-label? (nd/nd-step n))
                              (has-label-list? (nd/nd-body n))))))))))

(defn has-label-list? [(list (al/ArrayList (ptr nd/Node)))] (-> bool)
  (let [n (al/al-len [(ptr nd/Node)] list)
        (mut i) 0
        (mut found) 0]
    (loop (if (or (>= (load i) n) (!= (load found) 0))
              (break)
              (do
                (if (has-label? (al/al-get [(ptr nd/Node)] list (load i)))
                    (store! found 1)
                    0)
                (store! i (+ (load i) 1)))))
    (!= (load found) 0)))

(defn flow-new [(a (dyn alloc/Allocator))] (-> Flow)
  (load (Flow
          :alloc a
          :blocks (al/al-new [(ptr Block)] a)
          :current 0
          :labels (hm/hm-new [(slice u8) i64] a (str/str-keyops))
          :breaks (al/al-new [i64] a)
          :continues (al/al-new [i64] a))))

(defn flow-new-block! [(f (mut Flow))] (-> i64)
  (let [a (load (field f alloc))
        b
          (alloc/box! a
                      Block
                      (load (Block
                              :stmts (al/al-new [(ptr nd/Node)] a)
                              :term TERM-END
                              :test (primitive/cast (ptr nd/Node) 0)
                              :value (primitive/cast (ptr nd/Node) 0)
                              :a 0
                              :b 0
                              :cases (al/al-new [i64] a)
                              :targets (al/al-new [i64] a))))]
    (al/al-push! [(ptr Block)] (mut (field f blocks)) b)
    (- (al/al-len [(ptr Block)] (load (field f blocks))) 1)))

(defn flow-block [(f (mut Flow)) (i i64)] (-> (ptr Block))
  (al/al-get [(ptr Block)] (load (field f blocks)) i))

(defn flow-here [(f (mut Flow))] (-> (ptr Block))
  (flow-block (mut f) (load (field f current))))

(defn flow-push-stmt! [(f (mut Flow)) (n (ptr nd/Node))] (-> i64)
  (let [b (flow-here (mut f))]
    (al/al-push! [(ptr nd/Node)] (mut (field b stmts)) n))
  0)

;;; Initializes the unnamed object represented by a compound literal, then
;;; yields either its value or its address depending on the expression context.
(defn emit-compound-literal! [(e (mut Emitter))
                              (n (ptr nd/Node))
                              (address? bool)] (-> i64)
  (let [o (nd/nd-obj n)]
    (put! (mut e) "(do")
    (emit-block-body! (mut e) (nd/nd-lhs n))
    (put! (mut e) " ")
    (if address?
        (put! (mut e) (slot-of (mut e) o))
        (if (direct-value? (mut e) o)
            (put! (mut e) (slot-of (mut e) o))
            (do
              (put! (mut e) "(load ")
              (put! (mut e) (slot-of (mut e) o))
              (put! (mut e) ")"))))
    (put! (mut e) ")"))
  0)

(defn flow-jump! [(f (mut Flow)) (target i64)] (-> i64)
  (let [b (flow-here (mut f))]
    (store! (field b term) TERM-JUMP)
    (store! (field b a) target))
  0)

(defn flow-branch! [(f (mut Flow)) (test (ptr nd/Node)) (yes i64) (no i64)] (-> i64)
  (let [b (flow-here (mut f))]
    (store! (field b term) TERM-BRANCH)
    (store! (field b test) test)
    (store! (field b a) yes)
    (store! (field b b) no))
  0)

(defn flow-label-block! [(f (mut Flow)) (name (slice u8))] (-> i64)
  (match (hm/hm-get (load (field f labels)) name)
    (Some [i] i)
    (None []
          (let [i (flow-new-block! (mut f))]
            (hm/hm-put! [(slice u8) i64] (mut (field f labels)) name i)
            i))))

(defn flow-top [(list (al/ArrayList i64))] (-> i64)
  (let [n (al/al-len [i64] list)]
    (if (= n 0) 0 (al/al-get [i64] list (- n 1)))))

;;; After a jump, control cannot reach what follows until a label does. A fresh
;;; block collects it: nothing jumps to it, so nothing runs it.
(defn flow-unreachable! [(f (mut Flow))] (-> i64)
  (store! (field f current) (flow-new-block! (mut f)))
  0)

(defn build-flow-list! [(f (mut Flow)) (list (al/ArrayList (ptr nd/Node)))] (-> i64)
  (let [n (al/al-len [(ptr nd/Node)] list)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (build-flow! (mut f) (al/al-get [(ptr nd/Node)] list (load i)))
                (store! i (+ (load i) 1))))))
  0)

(defn build-if! [(f (mut Flow)) (n (ptr nd/Node))] (-> i64)
  (let [yes (flow-new-block! (mut f))
        no (flow-new-block! (mut f))
        join (flow-new-block! (mut f))]
    (flow-branch! (mut f) (nd/nd-test n) yes no)
    (store! (field f current) yes)
    (build-flow! (mut f) (nd/nd-then n))
    (flow-jump! (mut f) join)
    (store! (field f current) no)
    (build-flow! (mut f) (nd/nd-else n))
    (flow-jump! (mut f) join)
    (store! (field f current) join))
  0)

(defn build-while! [(f (mut Flow)) (n (ptr nd/Node))] (-> i64)
  (let [head (flow-new-block! (mut f))
        body (flow-new-block! (mut f))
        exit (flow-new-block! (mut f))]
    (flow-jump! (mut f) head)
    (store! (field f current) head)
    (flow-branch! (mut f) (nd/nd-test n) body exit)
    (al/al-push! [i64] (mut (field f breaks)) exit)
    (al/al-push! [i64] (mut (field f continues)) head)
    (store! (field f current) body)
    (build-flow! (mut f) (nd/nd-then n))
    (flow-jump! (mut f) head)
    (al/al-pop! [i64] (mut (field f breaks)))
    (al/al-pop! [i64] (mut (field f continues)))
    (store! (field f current) exit))
  0)

(defn build-do! [(f (mut Flow)) (n (ptr nd/Node))] (-> i64)
  (let [body (flow-new-block! (mut f))
        test (flow-new-block! (mut f))
        exit (flow-new-block! (mut f))]
    (flow-jump! (mut f) body)
    (store! (field f current) body)
    (al/al-push! [i64] (mut (field f breaks)) exit)
    (al/al-push! [i64] (mut (field f continues)) test)
    (build-flow! (mut f) (nd/nd-then n))
    (flow-jump! (mut f) test)
    (al/al-pop! [i64] (mut (field f breaks)))
    (al/al-pop! [i64] (mut (field f continues)))
    (store! (field f current) test)
    (flow-branch! (mut f) (nd/nd-test n) body exit)
    (store! (field f current) exit))
  0)

;;; `continue` in a `for` goes to the step, not to the test, so the step gets a
;;; block of its own.
(defn build-for! [(f (mut Flow)) (n (ptr nd/Node))] (-> i64)
  (build-flow! (mut f) (nd/nd-setup n))
  (let [head (flow-new-block! (mut f))
        body (flow-new-block! (mut f))
        step (flow-new-block! (mut f))
        exit (flow-new-block! (mut f))]
    (flow-jump! (mut f) head)
    (store! (field f current) head)
    (if (= (primitive/cast i64 (nd/nd-test n)) 0)
        (flow-jump! (mut f) body)
        (flow-branch! (mut f) (nd/nd-test n) body exit))
    (al/al-push! [i64] (mut (field f breaks)) exit)
    (al/al-push! [i64] (mut (field f continues)) step)
    (store! (field f current) body)
    (build-flow! (mut f) (nd/nd-then n))
    (flow-jump! (mut f) step)
    (al/al-pop! [i64] (mut (field f breaks)))
    (al/al-pop! [i64] (mut (field f continues)))
    (store! (field f current) step)
    (build-flow! (mut f) (nd/nd-step n))
    (flow-jump! (mut f) head)
    (store! (field f current) exit))
  0)

(defn build-switch! [(f (mut Flow)) (n (ptr nd/Node))] (-> i64)
  (let [a (load (field f alloc))
        (mut flat) (al/al-new [(ptr nd/Node)] a)
        body (nd/nd-then n)]
    (if (= (nd/nd-kind body) nd/ND-BLOCK)
        (let [src (nd/nd-body body)
              n-src (al/al-len [(ptr nd/Node)] src)
              (mut i) 0]
          (loop (if (>= (load i) n-src)
                    (break)
                    (do
                      (flatten-case! (mut flat) (al/al-get [(ptr nd/Node)] src (load i)))
                      (store! i (+ (load i) 1))))))
        (flatten-case! (mut flat) body))
    (let [items (load flat)
          count (al/al-len [(ptr nd/Node)] items)
          exit (flow-new-block! (mut f))
          head (flow-here (mut f))
          (mut i) 0
          ;; With no `default`, an unmatched value leaves the switch.
          (mut fallback) exit]
      (store! (field head term) TERM-SWITCH)
      (store! (field head test) (nd/nd-test n))
      ;; One block per group, in order, so that falling off the end of a group
      ;; enters the next.
      (loop (if (>= (load i) count)
                (break)
                (let [s (al/al-get [(ptr nd/Node)] items (load i))]
                  (if (= (nd/nd-kind s) nd/ND-CASE)
                      (let [group (flow-new-block! (mut f))]
                        (if (str/str-eq (nd/nd-label s) "default")
                            (store! fallback group)
                            (do
                              (al/al-push! [i64] (mut (field head cases)) (nd/nd-value s))
                              (al/al-push! [i64] (mut (field head targets)) group)
                              0))
                        0)
                      0)
                  (store! i (+ (load i) 1)))))
      (store! (field head a) (load fallback))
      (al/al-push! [i64] (mut (field f breaks)) exit)
      (build-switch-groups! (mut f) items exit)
      (al/al-pop! [i64] (mut (field f breaks)))
      (store! (field f current) exit)))
  0)

;;; Walks the flattened body again, this time filling the group blocks the pass
;;; above created. They were created in the same order, so the nth case marker
;;; owns the nth of them.
(defn build-switch-groups! [(f (mut Flow))
                            (items (al/ArrayList (ptr nd/Node)))
                            (exit i64)] (-> i64)
  (let [count (al/al-len [(ptr nd/Node)] items)
        head (flow-here (mut f))
        (mut i) 0
        (mut group) -1
        (mut first) -1]
    ;; The group blocks are the ones allocated between the head and the first
    ;; statement, so their indices run from just after `exit`.
    (store! first (+ exit 1))
    (loop (if (>= (load i) count)
              (break)
              (let [s (al/al-get [(ptr nd/Node)] items (load i))]
                (if (= (nd/nd-kind s) nd/ND-CASE)
                    (do
                      (if (>= (load group) 0) (flow-jump! (mut f) (+ (load first) (+ (load group) 1))) 0)
                      (store! group (+ (load group) 1))
                      (store! (field f current) (+ (load first) (load group)))
                      0)
                    (if (>= (load group) 0) (build-flow! (mut f) s) 0))
                (store! i (+ (load i) 1)))))
    (if (>= (load group) 0) (flow-jump! (mut f) exit) 0))
  0)

(defn build-flow! [(f (mut Flow)) (n (ptr nd/Node))] (-> i64)
  (if (= (primitive/cast i64 n) 0)
      0
      (let [k (nd/nd-kind n)]
        (cond (= k nd/ND-NULL) 0
              (= k nd/ND-BLOCK) (build-flow-list! (mut f) (nd/nd-body n))
              (= k nd/ND-RETURN)
                (let [b (flow-here (mut f))]
                  (store! (field b term) TERM-RETURN)
                  (store! (field b value) (nd/nd-lhs n))
                  (flow-unreachable! (mut f)))
              (= k nd/ND-IF) (build-if! (mut f) n)
              (= k nd/ND-WHILE) (build-while! (mut f) n)
              (= k nd/ND-DO) (build-do! (mut f) n)
              (= k nd/ND-FOR) (build-for! (mut f) n)
              (= k nd/ND-SWITCH) (build-switch! (mut f) n)
              (= k nd/ND-BREAK)
                (do
                  (flow-jump! (mut f) (flow-top (load (field f breaks))))
                  (flow-unreachable! (mut f)))
              (= k nd/ND-CONTINUE)
                (do
                  (flow-jump! (mut f) (flow-top (load (field f continues))))
                  (flow-unreachable! (mut f)))
              (= k nd/ND-GOTO)
                (do
                  (flow-jump! (mut f) (flow-label-block! (mut f) (nd/nd-label n)))
                  (flow-unreachable! (mut f)))
              (= k nd/ND-LABEL)
                (let [target (flow-label-block! (mut f) (nd/nd-label n))]
                  (flow-jump! (mut f) target)
                  (store! (field f current) target)
                  (build-flow! (mut f) (nd/nd-then n)))
              ;; A case outside any switch body block, which the switch builder
              ;; would otherwise have taken.
              (= k nd/ND-CASE) (build-flow! (mut f) (nd/nd-then n))
              :else (flow-push-stmt! (mut f) n)))))

;; ------------------------------------------------- emitting the flow graph
(defn emit-goto! [(e (mut Emitter)) (state (slice u8)) (target i64)] (-> i64)
  (put! (mut e) "(do (set! ")
  (put! (mut e) state)
  (put! (mut e) " ")
  (put-int! (mut e) target)
  (put! (mut e) ") 0)")
  0)

(defn emit-terminator! [(e (mut Emitter))
                        (f (mut Flow))
                        (b (ptr Block))
                        (state (slice u8))
                        (result (ptr ct/Type))] (-> i64)
  (let [term (load (field b term))]
    (cond (= term TERM-JUMP) (emit-goto! (mut e) state (load (field b a)))
          (= term TERM-BRANCH)
            (do
              (put! (mut e) "(if ")
              (emit-truth! (mut e) (load (field b test)))
              (put! (mut e) " ")
              (emit-goto! (mut e) state (load (field b a)))
              (put! (mut e) " ")
              (emit-goto! (mut e) state (load (field b b)))
              (put! (mut e) ")"))
          (= term TERM-RETURN)
            (do
              (put! (mut e) "(control/return-from :c-return ")
              (if (= (primitive/cast i64 (load (field b value))) 0)
                  (do
                    (put! (mut e) "(zeroed ")
                    (emit-return-type! (mut e) result)
                    (put! (mut e) ")"))
                  (emit-value! (mut e) (load (field b value))))
              (put! (mut e) ")"))
          (= term TERM-SWITCH) (emit-switch-terminator! (mut e) b state)
          ;; Nothing follows this block: leave the dispatch loop.
          :else (put! (mut e) "(break)"))))

(defn emit-switch-terminator! [(e (mut Emitter)) (b (ptr Block)) (state (slice u8))] (-> i64)
  (let [values (load (field b cases))
        targets (load (field b targets))
        count (al/al-len [i64] values)
        value (fresh (mut e) "sw")
        (mut i) 0]
    (put! (mut e) "(let [")
    (put! (mut e) value)
    (put! (mut e) " (cast i64 ")
    (emit-expr! (mut e) (load (field b test)))
    (put! (mut e) ")] ")
    (loop (if (>= (load i) count)
              (break)
              (do
                (put! (mut e) "(if (= ")
                (put! (mut e) value)
                (put! (mut e) " ")
                (put-int! (mut e) (al/al-get [i64] values (load i)))
                (put! (mut e) ") ")
                (emit-goto! (mut e) state (al/al-get [i64] targets (load i)))
                (put! (mut e) " ")
                (store! i (+ (load i) 1)))))
    (emit-goto! (mut e) state (load (field b a)))
    (store! i 0)
    (loop (if (>= (load i) count)
              (break)
              (do (put! (mut e) ")") (store! i (+ (load i) 1)))))
    (put! (mut e) ")"))
  0)

(defn emit-flow-block! [(e (mut Emitter))
                        (f (mut Flow))
                        (index i64)
                        (state (slice u8))
                        (result (ptr ct/Type))] (-> i64)
  (let [b (flow-block (mut f) index)
        stmts (load (field b stmts))
        count (al/al-len [(ptr nd/Node)] stmts)
        (mut i) 0]
    (put! (mut e) "(do")
    (loop (if (>= (load i) count)
              (break)
              (do
                (put! (mut e) " ")
                (emit-stmt! (mut e) (al/al-get [(ptr nd/Node)] stmts (load i)))
                (store! i (+ (load i) 1)))))
    (put! (mut e) " ")
    (emit-terminator! (mut e) (mut f) b state result)
    (put! (mut e) ")"))
  0)

;;; A binary search rather than a chain, so that reaching a block costs the same
;;; wherever it sits in a long function.
(defn emit-dispatch! [(e (mut Emitter))
                      (f (mut Flow))
                      (lo i64)
                      (hi i64)
                      (state (slice u8))
                      (result (ptr ct/Type))] (-> i64)
  (if (>= lo hi)
      (emit-flow-block! (mut e) (mut f) lo state result)
      (let [mid (primitive/idiv (+ lo hi) 2)]
        (put! (mut e) "(if (<= (load ")
        (put! (mut e) state)
        (put! (mut e) ") ")
        (put-int! (mut e) mid)
        (put! (mut e) ") ")
        (emit-dispatch! (mut e) (mut f) lo mid state result)
        (put! (mut e) " ")
        (emit-dispatch! (mut e) (mut f) (+ mid 1) hi state result)
        (put! (mut e) ")"))))

;; ------------------------------------------------------------- top level

;;; Every local gets its own addressable slot, because C can take the address of
;;; any of them. This is the one place a raw stack allocation is the right tool
;;; rather than a mutable binding: it is C's automatic storage, and it is what
;;; makes `&x` mean anything. The slots are declared once at the top of the
;;; function, never inside a loop.
;;; A local is named after the variable it holds. The `v_` keeps it out of the
;;; way of everything Coil already means by a bare name -- `load`, `index`, `not`
;;; -- which a C program is perfectly entitled to use for a variable.
(defn local-name! [(e (mut Emitter)) (o (ptr nd/Obj))] (-> (slice u8))
  (let [name (nd/obj-name o)]
    (if (= (slice-len name) 0)
        (fresh (mut e) "v")
        (let [stem (ident (mut e) "v_" name)]
          (if (not (hm/hm-contains? (load (field e names-taken)) stem))
              (do (hm/hm-put! [(slice u8) bool] (mut (field e names-taken)) stem true) stem)
              ;; The same name in two scopes of one function is two variables.
              (let [(mut b) (str/sb-new (load (field e a)))]
                (str/sb-push-str! (mut b) stem)
                (str/sb-push-str! (mut b) "_")
                (str/sb-push-i64! (mut b) (hm/hm-len [(slice u8) bool] (load (field e names-taken))))
                (let [unique (str/sb-str (load (mut b)))]
                  (hm/hm-put! [(slice u8) bool] (mut (field e names-taken)) unique true)
                  unique)))))))

;;; A parameter the body only reads is the argument itself. Its name is the
;;; variable's, because that is what the body calls it, and it gets neither a
;;; binding of its own nor a copy into one.
(defn claim-direct-params! [(e (mut Emitter)) (f (ptr nd/Obj))] (-> i64)
  (let [params (nd/obj-params f)
        count (al/al-len [(ptr nd/Obj)] params)
        (mut i) 0]
    (loop (if (>= (load i) count)
              (break)
              (let [o (al/al-get [(ptr nd/Obj)] params (load i))]
                (if (and (direct-param? (mut e) o) (> (slice-len (nd/obj-name o)) 0))
                    (do
                      (bind-slot! (mut e) o (local-name! (mut e) o))
                      (hm/hm-put! [(slice u8) bool]
                                  (mut (field e direct))
                                  (obj-key (mut e) o)
                                  true)
                      0)
                    0)
                (store! i (+ (load i) 1)))))
    0))

(defn emit-locals! [(e (mut Emitter)) (f (ptr nd/Obj))] (-> i64)
  (let [locals (nd/obj-locals f)
        count (al/al-len [(ptr nd/Obj)] locals)
        (mut i) 0]
    (loop (if (>= (load i) count)
              (break)
              (let [o (al/al-get [(ptr nd/Obj)] locals (load i))]
                (if (direct-value? (mut e) o)
                    0
                    (emit-local! (mut e) o))
                (store! i (+ (load i) 1))))))
  0)

(defn emit-local! [(e (mut Emitter)) (o (ptr nd/Obj))] (-> i64)
  (let [slot (local-name! (mut e) o)]
    (bind-slot! (mut e) o slot)
    (if (bound-local? (mut e) o)
        (do
          (put! (mut e) " (mut ")
          (put! (mut e) slot)
          (put! (mut e) ") (zeroed ")
          (emit-type! (mut e) (nd/obj-type o))
          (put! (mut e) ")"))
        (do
          (put! (mut e) " ")
          (put! (mut e) slot)
          (put! (mut e) " (alloc-stack ")
          (emit-type! (mut e) (nd/obj-type o))
          (put! (mut e) ")"))))
  0)

;;; Parameters arrive as values and are copied into their slots, so the body can
;;; treat them exactly like any other local.
;;; Walks a function body allocating one outgoing argument area per call to a
;;; variadic function of this program's own. Both jobs are done in one pass: the
;;; binding has to be emitted here, in the function's `let`, and the name has to
;;; be remembered for the call site that will use it.
(defn emit-va-areas! [(e (mut Emitter)) (n (ptr nd/Node))] (-> i64)
  (if (= (primitive/cast i64 n) 0)
      0
      (do
        (if (= (nd/nd-kind n) nd/ND-CALL)
            (let [target (variadic-target (mut e) n)]
              (if (= (primitive/cast i64 target) 0)
                  0
                  (let [named (al/al-len [(ptr ct/Type)] (ct/ty-params (nd/obj-type target)))
                        count (al/al-len [(ptr nd/Node)] (nd/nd-args n))
                        slots (- count named)
                        area (fresh (mut e) "va")]
                    (hm/hm-put! [(slice u8) (slice u8)]
                                (mut (field e va-areas))
                                (node-key (mut e) n)
                                area)
                    (put! (mut e) " ")
                    (put! (mut e) area)
                    (put! (mut e) " (alloc-stack (array u8 ")
                    (put-int! (mut e) (if (<= slots 0) 8 (* slots 8)))
                    (put! (mut e) "))")
                    0)))
            0)
        (emit-va-areas! (mut e) (nd/nd-lhs n))
        (emit-va-areas! (mut e) (nd/nd-rhs n))
        (emit-va-areas! (mut e) (nd/nd-test n))
        (emit-va-areas! (mut e) (nd/nd-then n))
        (emit-va-areas! (mut e) (nd/nd-else n))
        (emit-va-areas! (mut e) (nd/nd-setup n))
        (emit-va-areas! (mut e) (nd/nd-step n))
        (emit-va-areas-list! (mut e) (nd/nd-body n))
        (emit-va-areas-list! (mut e) (nd/nd-args n))
        0)))

(defn emit-va-areas-list! [(e (mut Emitter)) (list (al/ArrayList (ptr nd/Node)))] (-> i64)
  (let [n (al/al-len [(ptr nd/Node)] list)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (emit-va-areas! (mut e) (al/al-get [(ptr nd/Node)] list (load i)))
                (store! i (+ (load i) 1))))))
  0)

;;; The incoming value of a parameter, which the body immediately copies into the
;;; local of the same name. `a_` keeps the two apart.
(defn param-name [(e (mut Emitter)) (o (ptr nd/Obj)) (index i64)] (-> (slice u8))
  (cond ;; A parameter the body only reads is named after the variable: there is no
        ;; second thing to tell it apart from.
        (direct-value? (mut e) o) (slot-of (mut e) o)
        (= (slice-len (nd/obj-name o)) 0)
          (let [(mut b) (str/sb-new (load (field e a)))]
            (str/sb-push-str! (mut b) "a")
            (str/sb-push-i64! (mut b) index)
            (str/sb-str (load (mut b))))
        :else (ident (mut e) "a_" (nd/obj-name o))))

(defn emit-param-copies! [(e (mut Emitter)) (f (ptr nd/Obj))] (-> i64)
  (let [params (nd/obj-params f)
        count (al/al-len [(ptr nd/Obj)] params)
        (mut i) 0]
    (loop (if (>= (load i) count)
              (break)
              (let [o (al/al-get [(ptr nd/Obj)] params (load i))]
                (if (direct-value? (mut e) o)
                    0
                    (do
                      (put! (mut e) " (set! ")
                      (put! (mut e) (slot-of (mut e) o))
                      (put! (mut e) " ")
                      (put! (mut e) (param-name (mut e) o (load i)))
                      (put! (mut e) ")")))
                (store! i (+ (load i) 1))))))
  0)

;;; Builds the flow graph for a function that contains a label, and emits the
;;; dispatch loop that runs it.
(defn emit-flow! [(e (mut Emitter)) (f (ptr nd/Obj)) (state (slice u8))] (-> i64)
  (let [(mut flow) (flow-new (load (field e a)))
        entry (flow-new-block! (mut flow))]
    (store! (field flow current) entry)
    (build-flow! (mut flow) (nd/obj-body f))
    (put! (mut e) "(set! ")
    (put! (mut e) state)
    (put! (mut e) " ")
    (put-int! (mut e) entry)
    (put! (mut e) ") (loop ")
    (emit-dispatch! (mut e)
                    (mut flow)
                    0
                    (- (al/al-len [(ptr Block)] (load (field flow blocks))) 1)
                    state
                    (ct/ty-base (nd/obj-type f)))
    (put! (mut e) ")"))
  0)

(defn emit-function! [(e (mut Emitter)) (f (ptr nd/Obj))] (-> i64)
  (store! (field e names-taken)
          (hm/hm-new [(slice u8) bool] (load (field e a)) (str/str-keyops)))
  (store! (field e addressed)
          (hm/hm-new [(slice u8) bool] (load (field e a)) (str/str-keyops)))
  (store! (field e assigned)
          (hm/hm-new [(slice u8) bool] (load (field e a)) (str/str-keyops)))
  (store! (field e direct)
          (hm/hm-new [(slice u8) bool] (load (field e a)) (str/str-keyops)))
  (find-addressed! (mut e) (nd/obj-body f))
  (claim-direct-params! (mut e) f)
  (let [ty (nd/obj-type f)
        params (nd/obj-params f)
        count (al/al-len [(ptr nd/Obj)] params)
        state (fresh (mut e) "st")
        (mut i) 0]
    (put! (mut e) "(defn ")
    (put! (mut e)
          (if (str/str-eq (nd/obj-name f) "main")
              "c-main"
              (source-name (mut e) (nd/obj-name f))))
    (put! (mut e) " [")
    (loop (if (>= (load i) count)
              (break)
              (do
                (if (> (load i) 0) (put! (mut e) " ") 0)
                (put! (mut e) "(")
                (put! (mut e) (param-name (mut e) (al/al-get [(ptr nd/Obj)] params (load i)) (load i)))
                (put! (mut e) " ")
                (emit-param-type! (mut e) (nd/obj-type (al/al-get [(ptr nd/Obj)] params (load i))))
                (put! (mut e) ")")
                (store! i (+ (load i) 1)))))
    ;; A variadic function of this program's own takes its caller's argument
    ;; area as one more parameter. Nothing in C names it, so it is given a name
    ;; nothing in C can produce.
    (if (ct/ty-variadic? ty)
        (do (if (> count 0) (put! (mut e) " ") 0) (put! (mut e) "(c_va (ptr i8))"))
        0)
    (put! (mut e) "] (-> ")
    (emit-return-type! (mut e) (ct/ty-base ty))
    (put! (mut e) ")\n  (let [")
    (emit-locals! (mut e) f)
    (emit-va-areas! (mut e) (nd/obj-body f))
    (if (has-label? (nd/obj-body f))
        (do (put! (mut e) " ") (put! (mut e) state) (put! (mut e) " (alloc-stack i64)"))
        0)
    (put! (mut e) "]\n    (control/block :c-return (do")
    (emit-param-copies! (mut e) f)
    (if (has-label? (nd/obj-body f))
        (do (put! (mut e) " ") (emit-flow! (mut e) f state))
        ;; The body's own statements go straight into the block the parameter
        ;; copies are already in, rather than into one of their own.
        (emit-block-body! (mut e) (nd/obj-body f)))
    (put! (mut e) " (zeroed ")
    (emit-return-type! (mut e) (ct/ty-base ty))
    ;; closes: zeroed, do, scope, let, defn
    (put! (mut e) ")))))\n"))
  0)

;;; A global is a static cell reached through a zero-argument accessor, which
;;; gives it one address for the whole program.
(defn put-byte! [(e (mut Emitter)) (c i64)] (-> i64)
  (str/sb-push-byte! (mut (field e out)) (primitive/cast u8 c))
  0)

;;; A byte that reads as itself is written as itself: the generated module is
;;; meant to be read, and `c"WIMINUS"` says what a run of escapes only encodes.
;;; The escape is kept for the bytes with no printable spelling; in a `c"..."`
;;; literal it names the byte itself, so every value is expressible.
(defn put-string-byte! [(e (mut Emitter)) (c i64)] (-> i64)
  (cond (= c 34) (put! (mut e) "\\\"")
        (= c 92) (put! (mut e) "\\\\")
        (= c 10) (put! (mut e) "\\n")
        (= c 9) (put! (mut e) "\\t")
        (= c 13) (put! (mut e) "\\r")
        (= c 0) (put! (mut e) "\\0")
        (and (>= c 32) (<= c 126)) (put-byte! (mut e) c)
        :else (do (put! (mut e) "\\x") (put-hex! (mut e) c) (put! (mut e) ";"))))

;;; A C string literal is a C string literal: `c"..."` is byte-exact and already
;;; terminated, which is exactly what the object's type says it holds.
(defn put-coil-string! [(e (mut Emitter)) (bytes (slice u8))] (-> i64)
  (let [n (slice-len bytes)
        (mut i) 0]
    (put! (mut e) "c\"")
    (loop (if (>= (load i) n)
              (break)
              (do
                (put-string-byte! (mut e) (primitive/cast i64 (slice-get bytes (load i))))
                (store! i (+ (load i) 1)))))
    (put! (mut e) "\""))
  0)

(defn put-hex! [(e (mut Emitter)) (v i64)] (-> i64)
  (let [digits "0123456789abcdef"]
    (if (>= v 16)
        (put! (mut e) (subslice digits (primitive/idiv v 16) (+ (primitive/idiv v 16) 1)))
        0)
    (put! (mut e) (subslice digits (primitive/irem v 16) (+ (primitive/irem v 16) 1))))
  0)

(defn no-value [] (-> Value)
  (Value
    :ok 0
    :flo 0
    :i 0
    :f 0.0))

(defn int-value [(v i64)] (-> Value)
  (Value
    :ok 1
    :flo 0
    :i v
    :f 0.0))

(defn float-value [(v f64)] (-> Value)
  (Value
    :ok 1
    :flo 1
    :i 0
    :f v))

(defn value-float [(v Value)] (-> f64)
  (if (= (.flo v) 0) (primitive/cast f64 (.i v)) (.f v)))

(defn value-int [(v Value)] (-> i64)
  (if (= (.flo v) 0) (.i v) (primitive/cast i64 (.f v))))

;;; The value an integer of this width and signedness would hold.
(defn narrow-to [(x i64) (size i64) (unsigned bool)] (-> i64)
  (cond (= size 1)
          (let [m (primitive/iand x 255)]
            (if (or unsigned (< m 128)) m (- m 256)))
        (= size 2)
          (let [m (primitive/iand x 65535)]
            (if (or unsigned (< m 32768)) m (- m 65536)))
        (= size 4)
          (let [m (primitive/iand x 4294967295)]
            (if (or unsigned (< m 2147483648)) m (- m 4294967296)))
        :else x))

;;; An unsigned operand as the i64 whose ordering and division agree with C's.
;;; A 64-bit one above the signed range has no such i64, and folds no further.
(defn as-operand [(v Value) (t (ptr ct/Type))] (-> Value)
  (if (or (= (primitive/cast i64 t) 0) (not (ct/ty-unsigned? t)))
      (int-value (.i v))
      (let [size (ct/ty-size t)]
        (cond (= size 1) (int-value (primitive/iand (.i v) 255))
              (= size 2) (int-value (primitive/iand (.i v) 65535))
              (= size 4) (int-value (primitive/iand (.i v) 4294967295))
              (< (.i v) 0) (no-value)
              :else (int-value (.i v))))))

(defn convert-value [(v Value) (t (ptr ct/Type))] (-> Value)
  (cond (= (primitive/cast i64 t) 0) (no-value)
        (= (ct/ty-kind t) ct/TY-BOOL)
          (int-value (if (= (.flo v) 0)
                         (if (= (.i v) 0) 0 1)
                         (if (primitive/fcmp-eq (.f v) 0.0) 0 1)))
        (ct/floating? t)
          (let [f (value-float v)]
            (if (= (ct/ty-kind t) ct/TY-FLOAT)
                (float-value (primitive/cast f64 (primitive/cast f32 f)))
                (float-value f)))
        (ct/integer? t) (int-value (narrow-to (value-int v) (ct/ty-size t) (ct/ty-unsigned? t)))
        ;; A pointer written as a number -- a null one, or an absolute address -- is
        ;; that number. A pointer written as `&x` never gets this far.
        (= (ct/ty-kind t) ct/TY-PTR) (if (= (.flo v) 0) (int-value (.i v)) (no-value))
        :else (no-value)))

;;; Folds the expressions C allows in a static initialiser and this compiler can
;;; write down. An address is not one of them: `&x` and a function's name mean a
;;; number only the linker knows, so they fold to nothing and stay statements.
(defn eval-value [(n (ptr nd/Node))] (-> Value)
  (if (= (primitive/cast i64 n) 0)
      (no-value)
      (let [k (nd/nd-kind n)
            ty (nd/nd-type n)]
        (cond (= k nd/ND-NUM)
                (if (and (!= (primitive/cast i64 ty) 0) (ct/floating? ty))
                    (float-value (nd/nd-fvalue n))
                    (int-value (nd/nd-value n)))
              (= k nd/ND-CAST)
                (let [v (eval-value (nd/nd-lhs n))]
                  (if (= (.ok v) 0) (no-value) (convert-value v ty)))
              (= k nd/ND-NEG)
                (let [v (eval-value (nd/nd-lhs n))]
                  (cond (= (.ok v) 0) (no-value)
                        (= (.flo v) 1) (float-value (primitive/fsub 0.0 (.f v)))
                        :else (int-value (- 0 (.i v)))))
              (= k nd/ND-BITNOT)
                (let [v (eval-value (nd/nd-lhs n))]
                  (if (or (= (.ok v) 0) (= (.flo v) 1))
                      (no-value)
                      (int-value (primitive/inot (.i v)))))
              (= k nd/ND-NOT)
                (let [v (eval-value (nd/nd-lhs n))]
                  (cond (= (.ok v) 0) (no-value)
                        (= (.flo v) 1) (int-value (if (primitive/fcmp-eq (.f v) 0.0) 1 0))
                        :else (int-value (if (= (.i v) 0) 1 0))))
              (= k nd/ND-COND)
                (let [c (eval-value (nd/nd-test n))]
                  (cond (= (.ok c) 0) (no-value)
                        (= (.flo c) 1)
                          (if (primitive/fcmp-eq (.f c) 0.0)
                              (eval-value (nd/nd-else n))
                              (eval-value (nd/nd-then n)))
                        :else
                          (if (= (.i c) 0)
                              (eval-value (nd/nd-else n))
                              (eval-value (nd/nd-then n)))))
              :else (eval-binop-value k n)))))

(defn eval-binop-value [(k i64) (n (ptr nd/Node))] (-> Value)
  (let [l (eval-value (nd/nd-lhs n))
        r (eval-value (nd/nd-rhs n))]
    (if (or (= (.ok l) 0) (= (.ok r) 0))
        (no-value)
        (if (or (= (.flo l) 1) (= (.flo r) 1))
            (eval-float-binop k (value-float l) (value-float r))
            (eval-int-binop k n (.i l) (.i r))))))

(defn eval-float-binop [(k i64) (x f64) (y f64)] (-> Value)
  (cond (= k nd/ND-ADD) (float-value (primitive/fadd x y))
        (= k nd/ND-SUB) (float-value (primitive/fsub x y))
        (= k nd/ND-MUL) (float-value (primitive/fmul x y))
        (= k nd/ND-DIV) (if (primitive/fcmp-eq y 0.0) (no-value) (float-value (primitive/fdiv x y)))
        (= k nd/ND-EQ) (int-value (if (primitive/fcmp-eq x y) 1 0))
        (= k nd/ND-NE) (int-value (if (primitive/fcmp-ne x y) 1 0))
        (= k nd/ND-LT) (int-value (if (primitive/fcmp-lt x y) 1 0))
        (= k nd/ND-LE) (int-value (if (primitive/fcmp-le x y) 1 0))
        (= k nd/ND-LOGAND)
          (int-value (if (and (not (primitive/fcmp-eq x 0.0))
                              (not (primitive/fcmp-eq y 0.0)))
                         1
                         0))
        (= k nd/ND-LOGOR)
          (int-value (if (or (not (primitive/fcmp-eq x 0.0))
                             (not (primitive/fcmp-eq y 0.0)))
                         1
                         0))
        :else (no-value)))

;;; The operands of a division, a comparison, or a right shift mean different
;;; numbers depending on the signedness C gave them, so each is read back through
;;; its own type before the operation runs.
(defn eval-int-binop [(k i64) (n (ptr nd/Node)) (x i64) (y i64)] (-> Value)
  (let [u (as-operand (int-value x) (nd/nd-type (nd/nd-lhs n)))
        w (as-operand (int-value y) (nd/nd-type (nd/nd-rhs n)))]
    (cond (= k nd/ND-ADD) (int-value (+ x y))
          (= k nd/ND-SUB) (int-value (- x y))
          (= k nd/ND-MUL) (int-value (* x y))
          (= k nd/ND-BITAND) (int-value (primitive/iand x y))
          (= k nd/ND-BITOR) (int-value (primitive/ior x y))
          (= k nd/ND-BITXOR) (int-value (primitive/ixor x y))
          (= k nd/ND-SHL) (if (or (< y 0) (>= y 64)) (no-value) (int-value (primitive/ishl x y)))
          (= k nd/ND-SHR)
            (if (or (or (< y 0) (>= y 64)) (= (.ok u) 0))
                (no-value)
                (int-value (primitive/ishr (.i u) y)))
          (= k nd/ND-DIV)
            (if (or (or (= (.ok u) 0) (= (.ok w) 0)) (= (.i w) 0))
                (no-value)
                (int-value (primitive/idiv (.i u) (.i w))))
          (= k nd/ND-MOD)
            (if (or (or (= (.ok u) 0) (= (.ok w) 0)) (= (.i w) 0))
                (no-value)
                (int-value (primitive/irem (.i u) (.i w))))
          (= k nd/ND-EQ) (int-value (if (= x y) 1 0))
          (= k nd/ND-NE) (int-value (if (!= x y) 1 0))
          (= k nd/ND-LT) (if (or (= (.ok u) 0) (= (.ok w) 0)) (no-value) (int-value (if (< (.i u) (.i w)) 1 0)))
          (= k nd/ND-LE) (if (or (= (.ok u) 0) (= (.ok w) 0)) (no-value) (int-value (if (<= (.i u) (.i w)) 1 0)))
          (= k nd/ND-LOGAND) (int-value (if (and (!= x 0) (!= y 0)) 1 0))
          (= k nd/ND-LOGOR) (int-value (if (or (!= x 0) (!= y 0)) 1 0))
          :else (no-value))))

;;; Coil converts between an f64 and an i64 by value; the bits are reached the
;;; only way that keeps them, through memory.
(defn f64-bits [(e (mut Emitter)) (v f64)] (-> i64)
  (let [p (load (field e scratch))]
    (primitive/store! (primitive/cast (ptr f64) p) v)
    (primitive/load p)))

(defn f64-of-bits [(e (mut Emitter)) (bits i64)] (-> f64)
  (let [p (load (field e scratch))]
    (primitive/store! p bits)
    (primitive/load (primitive/cast (ptr f64) p))))

(defn f32-bits [(e (mut Emitter)) (v f64)] (-> i64)
  (let [p (load (field e scratch))]
    (primitive/store! p 0)
    (primitive/store! (primitive/cast (ptr f32) p) (primitive/cast f32 v))
    (primitive/iand (primitive/load p) 4294967295)))

(defn f32-of-bits [(e (mut Emitter)) (bits i64)] (-> f64)
  (let [p (load (field e scratch))]
    (primitive/store! p bits)
    (primitive/cast f64 (primitive/load (primitive/cast (ptr f32) p)))))

;;; Neither infinity nor a NaN has a literal Coil reads back, so an initialiser
;;; holding one keeps its store.
(defn finite? [(v f64)] (-> bool)
  (and (primitive/fcmp-eq v v)
       (or (primitive/fcmp-eq v 0.0)
           (not (primitive/fcmp-eq (primitive/fmul v 2.0) v)))))

;;; Seventeen significant digits in exponential form round-trip an f64 exactly,
;;; and the form always carries a point and an exponent, so Coil reads it back as
;;; the same value rather than as an integer.
(defn put-float-lit! [(e (mut Emitter)) (v f64)] (-> i64)
  (let [buf (primitive/alloc-stack (array u8 48))
        text (primitive/cast (ptr i8) buf)]
    (snprintf text 48 c"%.17e" v)
    (put! (mut e) (str/cstr->str text))))

(defn image-get [(im (ptr Image)) (offset i64) (size i64)] (-> i64)
  (let [bytes (load (field im bytes))
        (mut v) 0
        (mut k) 0]
    (loop (if (>= (load k) size)
              (break)
              (do
                (store! v
                        (primitive/ior (load v)
                                       (primitive/ishl (primitive/cast i64 (slice-get bytes (+ offset (load k))))
                                                       (* (load k) 8))))
                (store! k (+ (load k) 1)))))
    (load v)))

(defn image-put! [(im (ptr Image)) (offset i64) (size i64) (bits i64)] (-> i64)
  (let [bytes (load (field im bytes))
        (mut k) 0]
    (loop (if (>= (load k) size)
              (break)
              (do
                (slice-set! bytes
                            (+ offset (load k))
                            (primitive/cast u8 (primitive/iand (primitive/ishr bits (* (load k) 8)) 255)))
                (store! k (+ (load k) 1)))))
    0))

;;; The value at an offset as the literal its storage type spells.
(defn image-word [(im (ptr Image)) (offset i64) (size i64) (unsigned bool)] (-> i64)
  (let [raw (image-get im offset size)]
    (if (or unsigned (= size 8)) raw (narrow-to raw size false))))

(defn nil-image [] (-> (ptr Image))
  (primitive/cast (ptr Image) 0))

;;; Whether an object's image can be spelled as a Coil literal at all: every leaf
;;; of its storage has to be a number. A pointer's value is an address, and there
;;; is no constant for one.
(defn bakeable? [(t (ptr ct/Type))] (-> bool)
  (if (= (primitive/cast i64 t) 0)
      false
      (let [k (ct/ty-kind t)]
        (cond (<= (ct/ty-size t) 0) false
              ;; Record values are semantic Coil structs now, not arrays of ABI
              ;; words. Their initializers therefore stay as ordinary startup
              ;; field stores until image emission learns to construct defstruct
              ;; literals (including unions and bitfields) directly.
              (ct/record? t) false
              (= k ct/TY-INT128) true
              (= k ct/TY-FLOAT16) true
              (= k ct/TY-ARRAY) (and (>= (ct/ty-array-len t) 1) (bakeable? (ct/ty-base t)))
              (ct/integer? t) true
              (ct/floating? t) (or (= (ct/ty-size t) 4) (= (ct/ty-size t) 8))
              :else false))))

(defn image-of [(e (mut Emitter)) (name (slice u8))] (-> (ptr Image))
  (match (hm/hm-get (load (field e images)) name)
    (Some [im] im)
    (None [] (nil-image))))

(defn image-for! [(e (mut Emitter)) (name (slice u8)) (size i64)] (-> (ptr Image))
  (let [have (image-of (mut e) name)]
    (if (!= (primitive/cast i64 have) 0)
        have
        (let [a (load (field e a))]
          (match (alloc/alloc-bytes a size 16)
            (Some [bytes]
                  (let [(mut k) 0
                        im (alloc/box! a Image (load (Image :bytes bytes :folded 0)))]
                    (loop (if (>= (load k) size)
                              (break)
                              (do
                                (slice-set! bytes (load k) (primitive/cast u8 0))
                                (store! k (+ (load k) 1)))))
                    (hm/hm-put! [(slice u8) (ptr Image)] (mut (field e images)) name im)
                    im))
            (None [] (nil-image)))))))

;;; One leaf of an initialiser: written into the image if its value is known
;;; here, left as a statement if it is not.
(defn fold-leaf! [(e (mut Emitter))
                  (im (ptr Image))
                  (target (ptr nd/Node))
                  (rhs (ptr nd/Node))] (-> i64)
  (let [ty (nd/nd-type target)
        offset (nd/nd-member-offset target)
        width (nd/nd-member-bit-width target)
        v (eval-value rhs)]
    (cond (= (.ok v) 0) 0
          (= (primitive/cast i64 ty) 0) 0
          (ct/floating? ty)
            (let [size (ct/ty-size ty)
                  f (value-float v)]
              (cond (or (>= width 0) (not (finite? f))) 0
                    (= size 8) (do (image-put! im offset 8 (f64-bits (mut e) f)) 1)
                    (= size 4) (do (image-put! im offset 4 (f32-bits (mut e) f)) 1)
                    :else 0))
          (= (ct/ty-kind ty) ct/TY-PTR)
            (if (or (>= width 0) (= (.flo v) 1))
                0
                (do (image-put! im offset (ct/ty-size ty) (.i v)) 1))
          (ct/integer? ty)
            (let [size (ct/ty-size ty)
                  x (value-int v)]
              (cond (or (< size 1) (> size 8)) 0
                    (< width 0) (do (image-put! im offset size x) 1)
                    (or (= width 0) (>= width 64)) 0
                    :else
                      (let [bit (nd/nd-member-bit-offset target)
                            mask (primitive/ishl (- (primitive/ishl 1 width) 1) bit)
                            old (image-get im offset size)]
                        (image-put! im
                                    offset
                                    size
                                    (primitive/ior (primitive/iand old (primitive/inot mask))
                                                   (primitive/iand (primitive/ishl x bit) mask)))
                        1)))
          :else 0)))

;;; A statement of the start-up block is a store into a static object exactly
;;; when the initialiser that produced it wrote one leaf. Anything else -- and
;;; any store whose value is not a constant -- is left alone.
(defn fold-store! [(e (mut Emitter))
                   (globals (al/ArrayList (ptr nd/Obj)))
                   (s (ptr nd/Node))] (-> i64)
  (if (!= (nd/nd-kind s) nd/ND-EXPR-STMT)
      0
      (let [assign (nd/nd-lhs s)]
        (if (or (= (primitive/cast i64 assign) 0) (!= (nd/nd-kind assign) nd/ND-ASSIGN))
            0
            (let [target (nd/nd-lhs assign)]
              (if (or (= (primitive/cast i64 target) 0) (!= (nd/nd-kind target) nd/ND-MEMBER))
                  0
                  (let [var (nd/nd-lhs target)]
                    (if (or (= (primitive/cast i64 var) 0) (!= (nd/nd-kind var) nd/ND-VAR))
                        0
                        (fold-into-image! (mut e)
                                          globals
                                          (nd/nd-obj var)
                                          target
                                          (nd/nd-rhs assign))))))))))

(defn fold-into-image! [(e (mut Emitter))
                        (globals (al/ArrayList (ptr nd/Obj)))
                        (o (ptr nd/Obj))
                        (target (ptr nd/Node))
                        (rhs (ptr nd/Node))] (-> i64)
  (if (or (= (primitive/cast i64 o) 0) (nd/obj-local? o))
      0
      (let [name (nd/obj-name o)
            index (storage-index (mut e) name)]
        (if (or (not (hm/hm-contains? (load (field e defined-data)) name))
                (or (< index 0) (>= index (al/al-len [(ptr nd/Obj)] globals))))
            0
            (let [storage (nd/obj-type (al/al-get [(ptr nd/Obj)] globals index))]
              (if (not (bakeable? storage))
                  0
                  (let [im (image-for! (mut e) name (ct/ty-size storage))]
                    (if (= (primitive/cast i64 im) 0)
                        0
                        (let [done (fold-leaf! (mut e) im target rhs)]
                          (store! (field im folded) (+ (load (field im folded)) done))
                          done)))))))))

;;; Runs before anything is written out: the start-up block minus every store
;;; that has become part of an object's image.
(defn fold-statics! [(e (mut Emitter))
                     (globals (al/ArrayList (ptr nd/Obj)))
                     (init (ptr nd/Node))] (-> (ptr nd/Node))
  (if (or (= (primitive/cast i64 init) 0) (!= (nd/nd-kind init) nd/ND-BLOCK))
      init
      (let [a (load (field e a))
            kept (nd/node-new a nd/ND-BLOCK (nd/nd-token init))
            body (nd/nd-body init)
            count (al/al-len [(ptr nd/Node)] body)
            (mut i) 0]
        (loop (if (>= (load i) count)
                  (break)
                  (let [s (al/al-get [(ptr nd/Node)] body (load i))]
                    ;; Each translation unit's start-up statements arrive as a
                    ;; block of their own, so the stores are one level down.
                    (if (and (!= (primitive/cast i64 s) 0) (= (nd/nd-kind s) nd/ND-BLOCK))
                        (let [inner (fold-statics! (mut e) globals s)]
                          (if (> (al/al-len [(ptr nd/Node)] (nd/nd-body inner)) 0)
                              (nd/push-body! kept inner)
                              0))
                        (if (= (fold-store! (mut e) globals s) 0)
                            (nd/push-body! kept s)
                            0))
                    (store! i (+ (load i) 1)))))
        kept)))

;;; The image as a literal of the object's storage type -- the same shape
;;; `emit-type!` spells for that type, read back out of the bytes.
(defn put-image! [(e (mut Emitter)) (im (ptr Image)) (t (ptr ct/Type)) (offset i64)] (-> i64)
  (let [k (ct/ty-kind t)]
    (cond (ct/record? t)
            (let [size (ct/ty-size t)
                  align (ct/ty-align t)
                  unit (cond (>= align 8) 8 (= align 4) 4 (= align 2) 2 :else 1)]
              (put-words! (mut e) im offset (primitive/idiv size unit) unit (= unit 1)))
          (= k ct/TY-INT128) (put-words! (mut e) im offset 2 8 false)
          (= k ct/TY-FLOAT16) (put-words! (mut e) im offset 2 1 true)
          (= k ct/TY-ARRAY)
            (let [base (ct/ty-base t)
                  esize (ct/ty-size base)
                  len (ct/ty-array-len t)
                  (mut j) 0]
              (put! (mut e) "[")
              (loop (if (>= (load j) len)
                        (break)
                        (do
                          (if (> (load j) 0) (put! (mut e) " ") 0)
                          (put-image! (mut e) im base (+ offset (* (load j) esize)))
                          (store! j (+ (load j) 1)))))
              (put! (mut e) "]"))
          (ct/floating? t)
            (if (= (ct/ty-size t) 4)
                (put-float-lit! (mut e) (f32-of-bits (mut e) (image-get im offset 4)))
                (put-float-lit! (mut e) (f64-of-bits (mut e) (image-get im offset 8))))
          :else (put-int! (mut e) (image-word im offset (ct/ty-size t) (ct/ty-unsigned? t))))))

(defn put-words! [(e (mut Emitter))
                  (im (ptr Image))
                  (offset i64)
                  (count i64)
                  (unit i64)
                  (unsigned bool)] (-> i64)
  (let [(mut j) 0]
    (put! (mut e) "[")
    (loop (if (>= (load j) count)
              (break)
              (do
                (if (> (load j) 0) (put! (mut e) " ") 0)
                (put-int! (mut e) (image-word im (+ offset (* (load j) unit)) unit unsigned))
                (store! j (+ (load j) 1)))))
    (put! (mut e) "]")))

(defn emit-global! [(e (mut Emitter)) (o (ptr nd/Obj))] (-> i64)
  (if (hm/hm-contains? (load (field e emitted)) (nd/obj-name o))
      0
      (do
        (hm/hm-put! [(slice u8) bool] (mut (field e emitted)) (nd/obj-name o) true)
        (put! (mut e) "(defn ")
        (put! (mut e) (source-name (mut e) (nd/obj-name o)))
        (put! (mut e) " [] (-> (ptr ")
        (emit-type! (mut e) (nd/obj-type o))
        (put! (mut e) ")) ")
        (if (nd/obj-string? o)
            (do
              (put! (mut e) "(cast (ptr ")
              (emit-type! (mut e) (nd/obj-type o))
              (put! (mut e) ") ")
              (put-coil-string! (mut e) (nd/obj-string-data o))
              (put! (mut e) ")"))
            (let [im (image-of (mut e) (nd/obj-name o))]
              (put! (mut e) "(alloc-static ")
              (emit-type! (mut e) (nd/obj-type o))
              (if (= (primitive/cast i64 im) 0)
                  0
                  (do
                    (put! (mut e) " ")
                    (put-image! (mut e) im (nd/obj-type o) 0)))
              (put! (mut e) ")")))
        (put! (mut e) ")\n")
        0)))

(defn emit-extern! [(e (mut Emitter)) (o (ptr nd/Obj))] (-> i64)
  (if (hm/hm-contains? (load (field e externs)) (nd/obj-name o))
      0
      (do
        (hm/hm-put! [(slice u8) bool] (mut (field e externs)) (nd/obj-name o) true)
        (emit-extern-decl! (mut e) o))))

;;; The name the linker knows an object by: its own, unless `__asm` gave it
;;; another.
(defn link-name [(o (ptr nd/Obj))] (-> (slice u8))
  (let [asm (nd/obj-asm-name o)]
    (if (> (slice-len asm) 0) asm (nd/obj-name o))))

(defn emit-extern-decl! [(e (mut Emitter)) (o (ptr nd/Obj))] (-> i64)
  (let [ty (nd/obj-type o)
        params (ct/ty-params ty)
        count (al/al-len [(ptr ct/Type)] params)
        (mut i) 0]
    (put! (mut e) "(extern ")
    (put! (mut e) (link-name o))
    (put! (mut e) " :cc c [")
    (loop (if (>= (load i) count)
              (break)
              (do
                (if (> (load i) 0) (put! (mut e) " ") 0)
                (emit-param-type! (mut e) (al/al-get [(ptr ct/Type)] params (load i)))
                (store! i (+ (load i) 1)))))
    (if (ct/ty-variadic? ty)
        (do (if (> count 0) (put! (mut e) " ") 0) (put! (mut e) "..."))
        0)
    (put! (mut e) "] (-> ")
    (emit-return-type! (mut e) (ct/ty-base ty))
    (put! (mut e) "))\n"))
  0)

;;; Records every name the program mentions, so that only the declarations it
;;; needs become externs.
;;; Only objects with static storage are recorded. A parameter or a block-scoped
;;; variable may share a name with a global the program never touches, and
;;; counting it would declare that global as an external symbol nothing defines.
(defn note-use! [(e (mut Emitter)) (o (ptr nd/Obj))] (-> i64)
  (if (or (= (primitive/cast i64 o) 0) (nd/obj-local? o))
      0
      (do (hm/hm-put! [(slice u8) bool] (mut (field e used)) (nd/obj-name o) true) 0)))

(defn collect-uses! [(e (mut Emitter)) (n (ptr nd/Node))] (-> i64)
  (if (= (primitive/cast i64 n) 0)
      0
      (do
        (if (= (nd/nd-kind n) nd/ND-VAR) (note-use! (mut e) (nd/nd-obj n)) 0)
        (collect-uses! (mut e) (nd/nd-lhs n))
        (collect-uses! (mut e) (nd/nd-rhs n))
        (collect-uses! (mut e) (nd/nd-test n))
        (collect-uses! (mut e) (nd/nd-then n))
        (collect-uses! (mut e) (nd/nd-else n))
        (collect-uses! (mut e) (nd/nd-setup n))
        (collect-uses! (mut e) (nd/nd-step n))
        (collect-uses-list! (mut e) (nd/nd-body n))
        (collect-uses-list! (mut e) (nd/nd-args n))
        0)))

(defn collect-uses-list! [(e (mut Emitter)) (list (al/ArrayList (ptr nd/Node)))] (-> i64)
  (let [n (al/al-len [(ptr nd/Node)] list)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (collect-uses! (mut e) (al/al-get [(ptr nd/Node)] list (load i)))
                (store! i (+ (load i) 1))))))
  0)

(defn used? [(e (mut Emitter)) (o (ptr nd/Obj))] (-> bool)
  (hm/hm-contains? (load (field e used)) (nd/obj-name o)))

(defn mark-used-name! [(e (mut Emitter)) (name (slice u8))] (-> i64)
  (hm/hm-put! [(slice u8) bool] (mut (field e used)) name true)
  0)

;;; A global with no definition anywhere in the program is somebody else's
;;; symbol. Coil has no separate spelling for external data, so the symbol is
;;; declared as a nullary function and its address taken: that is exactly what
;;; the name means to the linker either way.
(defn emit-extern-global! [(e (mut Emitter)) (o (ptr nd/Obj))] (-> i64)
  (put! (mut e) "(extern ")
  (put! (mut e) (link-name o))
  (put! (mut e) " :cc c [] (-> i8))\n(defn ")
  (put! (mut e) (extern-data-name (mut e) (nd/obj-name o)))
  (put! (mut e) " [] (-> (ptr ")
  (emit-type! (mut e) (nd/obj-type o))
  (put! (mut e) ")) (cast (ptr ")
  (emit-type! (mut e) (nd/obj-type o))
  (put! (mut e) ") (fnptr-of ")
  (put! (mut e) (link-name o))
  (put! (mut e) ")))\n")
  0)

;;; Remembers the largest declaration of a name as the one whose type describes
;;; its storage.
(defn choose-storage! [(e (mut Emitter)) (o (ptr nd/Obj)) (index i64)] (-> i64)
  (let [name (nd/obj-name o)
        size (ct/ty-size (nd/obj-type o))
        best
          (match (hm/hm-get (load (field e storage-size)) name)
            (Some [s] s)
            (None [] -1))]
    (if (> size best)
        (do
          (hm/hm-put! [(slice u8) i64] (mut (field e storage)) name index)
          (hm/hm-put! [(slice u8) i64] (mut (field e storage-size)) name size)
          0)
        0)))

(defn storage-index [(e (mut Emitter)) (name (slice u8))] (-> i64)
  (match (hm/hm-get (load (field e storage)) name)
    (Some [i] i)
    (None [] -1)))

;;; `main` may be declared with no parameters or with the argument count and
;;; vector, and the entry point has to match whichever it was.
(defn main-arity [(globals (al/ArrayList (ptr nd/Obj)))] (-> i64)
  (let [count (al/al-len [(ptr nd/Obj)] globals)
        (mut i) 0
        (mut arity) 0]
    (loop (if (>= (load i) count)
              (break)
              (let [o (al/al-get [(ptr nd/Obj)] globals (load i))]
                (if (and (nd/obj-definition? o)
                         (and (nd/obj-function? o) (str/str-eq (nd/obj-name o) "main")))
                    (store! arity (al/al-len [(ptr nd/Obj)] (nd/obj-params o)))
                    0)
                (store! i (+ (load i) 1)))))
    (load arity)))

(defn emit-entry! [(e (mut Emitter)) (globals (al/ArrayList (ptr nd/Obj)))] (-> i64)
  (if (>= (main-arity globals) 2)
      (do
        (put! (mut e) "(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i32)")
        (put! (mut e) " (do (c-init-statics) (cast i32 (c-main argc argv))))\n"))
      (put! (mut e)
            "(defn main [] (-> i32) (do (c-init-statics) (cast i32 (c-main))))\n")))

;;; The order the functions marked `constructor` or `destructor` run in: by the
;;; priority the attribute asked for, and, within one priority, in the order the
;;; program declares them. An insertion sort, because there are rarely more than a
;;; handful and the order among equals has to be the declared one.
(defn ordered-at-start [(e (mut Emitter))
                        (globals (al/ArrayList (ptr nd/Obj)))
                        (kind i64)] (-> (al/ArrayList (ptr nd/Obj)))
  (let [count (al/al-len [(ptr nd/Obj)] globals)
        (mut out) (al/al-new [(ptr nd/Obj)] (load (field e a)))
        (mut i) 0]
    (loop (if (>= (load i) count)
              (break)
              (let [o (al/al-get [(ptr nd/Obj)] globals (load i))]
                (if (and (= (nd/obj-at-start o) kind) (nd/obj-definition? o))
                    (insert-by-priority! (mut out) o)
                    0)
                (store! i (+ (load i) 1)))))
    (load (mut out))))

(defn insert-by-priority! [(out (mut (al/ArrayList (ptr nd/Obj)))) (o (ptr nd/Obj))] (-> i64)
  (let [n (al/al-len [(ptr nd/Obj)] (load out))
        (mut at) n
        (mut i) 0]
    (loop (if (or (>= (load i) n) (< (load at) n))
              (break)
              (do
                (if (> (nd/obj-at-start-priority (al/al-get [(ptr nd/Obj)] (load out) (load i)))
                       (nd/obj-at-start-priority o))
                    (store! at (load i))
                    0)
                (store! i (+ (load i) 1)))))
    ;; Grow by one and shift everything from the insertion point along.
    (al/al-push! [(ptr nd/Obj)] (mut out) o)
    (let [(mut j) n]
      (loop (if (<= (load j) (load at))
                (break)
                (do
                  (al/al-set! [(ptr nd/Obj)]
                              (mut out)
                              (load j)
                              (al/al-get [(ptr nd/Obj)] (load out) (- (load j) 1)))
                  (store! j (- (load j) 1))))))
    (al/al-set! [(ptr nd/Obj)] (mut out) (load at) o))
  0)

;;; A function marked `constructor` runs after the static initialisers and before
;;; `main`; one marked `destructor` runs after `main` returns, or after `exit`,
;;; which is what `atexit` promises. Registering them in constructor order gives
;;; the reverse order on the way out, because `atexit` runs its list backwards.
(defn emit-at-start! [(e (mut Emitter)) (globals (al/ArrayList (ptr nd/Obj)))] (-> i64)
  (let [starts (ordered-at-start (mut e) globals nd/AT-CONSTRUCTOR)
        ends (ordered-at-start (mut e) globals nd/AT-DESTRUCTOR)
        n (al/al-len [(ptr nd/Obj)] starts)
        m (al/al-len [(ptr nd/Obj)] ends)
        (mut i) 0]
    (loop (if (>= (load i) m)
              (break)
              (do
                (put! (mut e) " (atexit (fnptr-of ")
                (put! (mut e) (callee-name (mut e) (al/al-get [(ptr nd/Obj)] ends (load i))))
                (put! (mut e) "))")
                (store! i (+ (load i) 1)))))
    (store! i 0)
    (loop (if (>= (load i) n)
              (break)
              (do
                (put! (mut e) " (")
                (put! (mut e) (callee-name (mut e) (al/al-get [(ptr nd/Obj)] starts (load i))))
                (put! (mut e) ")")
                (store! i (+ (load i) 1)))))
    (if (> m 0)
        (put! (mut e) "")
        0))
  0)

(defn public-name? [(names (al/ArrayList (slice u8))) (wanted (slice u8))] (-> bool)
  (let [n (al/al-len [(slice u8)] names)
        (mut i) 0
        (mut found) false]
    (loop (if (or (>= (load i) n) (load found))
              (break)
              (do
                (if (str/str-eq (al/al-get [(slice u8)] names (load i)) wanted)
                    (store! found true)
                    0)
                (store! i (+ (load i) 1)))))
    (load found)))

(defn emit-library-exports! [(e (mut Emitter))
                             (globals (al/ArrayList (ptr nd/Obj)))
                             (public-names (al/ArrayList (slice u8)))] (-> i64)
  (let [(mut seen) (hm/hm-new [(slice u8) bool] (load (field e a)) (str/str-keyops))
        records (load (field e record-decls))
        rn (al/al-len [(slice u8)] records)
        gn (al/al-len [(ptr nd/Obj)] globals)
        (mut i) 0]
    (put! (mut e) "(export initialize-c-library")
    (loop (if (>= (load i) rn)
              (break)
              (let [name (al/al-get [(slice u8)] records (load i))]
                (if (hm/hm-contains? (load (mut seen)) name)
                    0
                    (do
                      (hm/hm-put! [(slice u8) bool] (mut seen) name true)
                      (put! (mut e) " ")
                      (put! (mut e) name)))
                (store! i (+ (load i) 1)))))
    (store! i 0)
    (loop (if (>= (load i) gn)
              (break)
              (let [o (al/al-get [(ptr nd/Obj)] globals (load i))]
                (if (and (nd/obj-definition? o)
                         (and (not (nd/obj-static? o))
                              (and (not (nd/obj-string? o))
                                   (or (= (al/al-len [(slice u8)] public-names) 0)
                                       (public-name? public-names (nd/obj-name o))))))
                    (let [name
                            (if (and (nd/obj-function? o)
                                     (str/str-eq (nd/obj-name o) "main"))
                                "c-main"
                                (source-name (mut e) (nd/obj-name o)))]
                      (if (hm/hm-contains? (load (mut seen)) name)
                          0
                          (do
                            (hm/hm-put! [(slice u8) bool] (mut seen) name true)
                            (put! (mut e) " ")
                            (put! (mut e) name))))
                    0)
                (store! i (+ (load i) 1)))))
    (put! (mut e) ")\n")
    0))

(defn emit-module [(a (dyn alloc/Allocator))
                   (globals (al/ArrayList (ptr nd/Obj)))
                   (init (ptr nd/Node))
                   (module-name (slice u8))
                   (executable bool)
                   (public-names (al/ArrayList (slice u8)))] (-> EmitResult)
  (let [(mut e)
          (load (Emitter
                  :a a
                  :out (str/sb-new a)
                  :slots (hm/hm-new [(slice u8) (slice u8)] a (str/str-keyops))
                  :defined (hm/hm-new [(slice u8) bool] a (str/str-keyops))
                  :externs (hm/hm-new [(slice u8) bool] a (str/str-keyops))
                  :emitted (hm/hm-new [(slice u8) bool] a (str/str-keyops))
                  :used (hm/hm-new [(slice u8) bool] a (str/str-keyops))
                  :defined-data (hm/hm-new [(slice u8) bool] a (str/str-keyops))
                  :storage (hm/hm-new [(slice u8) i64] a (str/str-keyops))
                  :storage-size (hm/hm-new [(slice u8) i64] a (str/str-keyops))
                  :record-names (hm/hm-new [(slice u8) (slice u8)] a (str/str-keyops))
                  :records (al/al-new [(ptr ct/Type)] a)
                  :record-decls (al/al-new [(slice u8)] a)
                  :record-taken (hm/hm-new [(slice u8) bool] a (str/str-keyops))
                  :names-taken (hm/hm-new [(slice u8) bool] a (str/str-keyops))
                  :addressed (hm/hm-new [(slice u8) bool] a (str/str-keyops))
                  :assigned (hm/hm-new [(slice u8) bool] a (str/str-keyops))
                  :direct (hm/hm-new [(slice u8) bool] a (str/str-keyops))
                  :images (hm/hm-new [(slice u8) (ptr Image)] a (str/str-keyops))
                  :scratch (alloc/box! a i64 0)
                  :va-areas (hm/hm-new [(slice u8) (slice u8)] a (str/str-keyops))
                  :target-addrs (al/al-new [(slice u8)] a)
                  :serial 0
                  :break-labels (al/al-new [(slice u8)] a)
                  :continue-labels (al/al-new [(slice u8)] a)
                  :failed 0
                  :message ""
                  :file ""
                  :line 0))
        count (al/al-len [(ptr nd/Obj)] globals)
        (mut start-up) init
        (mut i) 0]
    ;; What has a definition, and under which of the two kinds.
    (loop (if (>= (load i) count)
              (break)
              (let [o (al/al-get [(ptr nd/Obj)] globals (load i))]
                (if (nd/obj-definition? o)
                    (if (nd/obj-function? o)
                        (do
                          (hm/hm-put! [(slice u8) bool]
                                      (mut (field e defined))
                                      (nd/obj-name o)
                                      true)
                          0)
                        (do
                          (hm/hm-put! [(slice u8) bool]
                                      (mut (field e defined-data))
                                      (nd/obj-name o)
                                      true)
                          (choose-storage! (mut e) o (load i))
                          0))
                    0)
                ;; A string literal has no reference to find it by; its bytes
                ;; are the reason it exists.
                (if (nd/obj-string? o) (note-use! (mut e) o) 0)
                (store! i (+ (load i) 1)))))
    ;; Start from the externally observable roots, then walk only the bodies
    ;; they reach. Scanning every definition made a library header pull all of
    ;; its implementation dependencies into generated Coil—including complete
    ;; embedded codec APIs that no Raylib entry point could call.
    (if executable
        (mark-used-name! (mut e) "main")
        (if (= (al/al-len [(slice u8)] public-names) 0)
            (do
              (for [pi 0 count]
                (let [po (al/al-get [(ptr nd/Obj)] globals pi)]
                  (if (and (nd/obj-definition? po) (not (nd/obj-static? po)))
                      (mark-used-name! (mut e) (nd/obj-name po))
                      0))
                0)
              0)
            (do
              (for [pi 0 (al/al-len [(slice u8)] public-names)]
                (mark-used-name! (mut e) (al/al-get [(slice u8)] public-names pi))
                0)
              0)))
    ;; Constructors are roots even though no C expression calls them.
    (for [ci 0 count]
      (let [co (al/al-get [(ptr nd/Obj)] globals ci)]
        (if (and (nd/obj-definition? co) (!= (nd/obj-at-start co) nd/AT-NONE))
            (mark-used-name! (mut e) (nd/obj-name co))
            0))
      0)
    (collect-uses! (mut e) init)
    (let [(mut scanned) (hm/hm-new [(slice u8) bool] a (str/str-keyops))
          (mut changed) true]
      (loop (if (not (load changed))
                (break)
                (do
                  (store! changed false)
                  (for [wi 0 count]
                    (let [wo (al/al-get [(ptr nd/Obj)] globals wi)
                          wn (nd/obj-name wo)]
                      (if (and (nd/obj-definition? wo)
                               (and (used? (mut e) wo)
                                    (not (hm/hm-contains? (load (mut scanned)) wn))))
                          (do
                            (hm/hm-put! [(slice u8) bool] (mut scanned) wn true)
                            (collect-uses! (mut e) (nd/obj-body wo))
                            (store! changed true))
                          0))
                    0))))
      0)
    (store! i 0)
    (loop (if (>= (load i) count)
              (break)
              (let [o (al/al-get [(ptr nd/Obj)] globals (load i))]
                (if (and (nd/obj-definition? o) (used? (mut e) o))
                    (do
                      (collect-type-records! (mut e) (nd/obj-type o))
                      (collect-records! (mut e) (nd/obj-body o)))
                    0)
                (store! i (+ (load i) 1)))))
    (collect-records! (mut e) init)
    ;; Everything a static initialiser can say now, said now.
    (store! start-up (fold-statics! (mut e) globals init))

    ;; A source-reader result may omit the module form so Coil's loader can
    ;; insert the namespace selected by normal import resolution.
    (if (> (slice-len module-name) 0)
        (do
          (put! (mut e) "(module ")
          (put! (mut e) module-name)
          (put! (mut e) ")\n"))
        0)
    (put! (mut e) "(import \"coil.primitive\" :use *)\n")
    (put! (mut e) "(import \"coil.alloc\" :as alloc)\n")
    (put! (mut e) "(import \"coil.control\" :as control)\n")
    (put! (mut e) "(import \"coil.slice\" :use *)\n")
    (if executable 0 (emit-library-exports! (mut e) globals public-names))
    (emit-record-decls! (mut e))
    (put! (mut e) ";; Allocation type evidence retained for opt-in metaprograms.\n")
    (put! (mut e)
          "(defn c-type-hint [(name (slice u8)) (size i64) (align i64) (value (ptr i8))] (-> (ptr i8)) value)\n\n")
    ;; `destructor` functions are registered here rather than called from the
    ;; end of `main`, so that they still run when the program calls `exit`.
    (put! (mut e) "(extern atexit :cc c [(fnptr c [] i64)] (-> i32))\n")
    ;; Declarations first, so a call can precede the definition it names.
    (store! i 0)
    (loop (if (>= (load i) count)
              (break)
              (let [o (al/al-get [(ptr nd/Obj)] globals (load i))]
                (cond (nd/obj-function? o)
                        (if (and (not (hm/hm-contains? (load (field e defined)) (nd/obj-name o)))
                                 (used? (mut e) o))
                            (emit-extern! (mut e) o)
                            0)
                      (= (ct/ty-kind (nd/obj-type o)) ct/TY-FUNC)
                        (if (and (not (hm/hm-contains? (load (field e defined)) (nd/obj-name o)))
                                 (used? (mut e) o))
                            (emit-extern! (mut e) o)
                            0)
                      (hm/hm-contains? (load (field e defined-data)) (nd/obj-name o))
                        (if (= (storage-index (mut e) (nd/obj-name o)) (load i))
                            (emit-global! (mut e) o)
                            0)
                      (used? (mut e) o)
                        (if (hm/hm-contains? (load (field e emitted)) (nd/obj-name o))
                            0
                            (do
                              (hm/hm-put! [(slice u8) bool]
                                          (mut (field e emitted))
                                          (nd/obj-name o)
                                          true)
                              (emit-extern-global! (mut e) o)))
                      :else 0)
                (store! i (+ (load i) 1)))))
    (store! i 0)
    (loop (if (>= (load i) count)
              (break)
              (let [o (al/al-get [(ptr nd/Obj)] globals (load i))]
                (if (and (nd/obj-function? o)
                         (and (nd/obj-definition? o) (used? (mut e) o)))
                    (emit-function! (mut e) o)
                    0)
                (store! i (+ (load i) 1)))))
    ;; Everything with static storage is initialised once, in source order,
    ;; before the program's own `main` runs.
    (put! (mut e)
          (if executable
              "(defn c-init-statics [] (-> i64) (do "
              "(defn initialize-c-library [] (-> i64) (do "))
    (emit-stmt! (mut e) (load start-up))
    (emit-at-start! (mut e) globals)
    (put! (mut e) " 0))\n")
    ;; Coil's entry point calls the program's, with the arguments it asked for.
    (if executable (emit-entry! (mut e) globals) 0)
    (EmitResult
      :text (str/sb-str (load (mut (field e out))))
      :failed (load (field e failed))
      :message (load (field e message))
      :file (load (field e file))
      :line (load (field e line)))))

(defn emit-program [(a (dyn alloc/Allocator))
                    (globals (al/ArrayList (ptr nd/Obj)))
                    (init (ptr nd/Node))] (-> EmitResult)
  (emit-module a globals init "c_program" true (al/al-new [(slice u8)] a)))
