;; Lowers the typed C AST to ordinary Coil.
;;
;; Two rules shape everything here.
;;
;; A C record is emitted as a blob with C's own size and alignment -- an array
;; whose element type carries the required alignment -- and members are reached
;; by byte offset. Handing records to Coil's struct layout instead would mean
;; two independent sets of layout rules had to agree, which they need not; this
;; way the offsets computed in experiments.c.ctype are the offsets used. It is
;; also what makes bitfields expressible at all.
;;
;; Every expression has two forms: its value, and its address. `emit-addr!`
;; exists for exactly the constructs C calls lvalues, and reading an lvalue is
;; a load from its address. Assignment, `&`, and member access all fall out of
;; that rather than being special-cased.
(module experiments.c.emit)

(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "coil.hashmap" :as hm)
(import "coil.slice" :use *)
(import "coil.str" :as str)
(import "experiments.c.lex" :as lex)
(import "experiments.c.ctype" :as ct)
(import "experiments.c.node" :as nd)

(extern snprintf :cc c [(ptr i8) i64 (ptr i8) ...] (-> i32))

(export Emitter EmitResult emit-program)

(defstruct Emitter
  [(a (dyn alloc/Allocator))
   (out str/StrBuf)
   (slots (hm/HashMap (slice u8) (slice u8)))
   (defined (hm/HashMap (slice u8) bool))
   (externs (hm/HashMap (slice u8) bool))
   (emitted (hm/HashMap (slice u8) bool))
   ;; Names the program actually mentions. A header declares far more than any
   ;; one program uses, and a declaration that is never referred to must not
   ;; become an `extern`: some of them name types this compiler has no
   ;; arithmetic for, and all of them would be dead weight.
   (used (hm/HashMap (slice u8) bool))
   ;; Names with a definition somewhere in the program, which decides whether a
   ;; global is storage of ours or a symbol somebody else's object file has.
   (defined-data (hm/HashMap (slice u8) bool))
   (serial i64)
   (break-labels (al/ArrayList (slice u8)))
   (continue-labels (al/ArrayList (slice u8)))
   (failed i64)
   (message (slice u8))
   (file (slice u8))
   (line i64)])

(defstruct EmitResult
  [(text (slice u8))
   (failed i64)
   (message (slice u8))
   (file (slice u8))
   (line i64)])

(defn put! [(e (mut Emitter)) (s (slice u8))] (-> i64)
  (str/sb-push-str! (mut (field e out)) s) 0)

(defn put-int! [(e (mut Emitter)) (v i64)] (-> i64)
  (str/sb-push-i64! (mut (field e out)) v) 0)

;; Seventeen significant digits in exponential form round-trip an f64 exactly,
;; and the form always carries a point and an exponent, so Coil reads it back as
;; the same value rather than as an integer.
(defn put-float! [(e (mut Emitter)) (v f64)] (-> i64)
  (let [buf (primitive/alloc-stack (array u8 48))
        text (primitive/cast (ptr i8) buf)]
    (if (primitive/fcmp-lt v 0.0)
        (do (put! (mut e) "(primitive/fsub 0.0 ")
            (snprintf text 48 c"%.17e" (primitive/fsub 0.0 v))
            (put! (mut e) (str/cstr->str text))
            (put! (mut e) ")"))
        (do (snprintf text 48 c"%.17e" v)
            (put! (mut e) (str/cstr->str text)))))
  0)

(defn fail! [(e (mut Emitter)) (message (slice u8)) (tok lex/Token)] (-> i64)
  (if (!= (load (field e failed)) 0)
      0
      (do
        (store! (field e failed) 1)
        (store! (field e message) message)
        (store! (field e file) (lex/token-file tok))
        (store! (field e line) (lex/token-line tok))
        0)))

(defn fresh [(e (mut Emitter)) (prefix (slice u8))] (-> (slice u8))
  (let [(mut b) (str/sb-new (load (field e a)))]
    (str/sb-push-str! (mut b) prefix)
    (str/sb-push-i64! (mut b) (load (field e serial)))
    (store! (field e serial) (+ (load (field e serial)) 1))
    (str/sb-str (load (mut b)))))

;; C identifiers are a subset of what Coil accepts, except that a leading dot
;; appears in the names generated for string literals.
(defn ident [(e (mut Emitter)) (prefix (slice u8)) (name (slice u8))] (-> (slice u8))
  (let [(mut b) (str/sb-new (load (field e a)))
        n (slice-len name)
        (mut i) 0]
    (str/sb-push-str! (mut b) prefix)
    (loop (if (>= (load i) n)
              (break)
              (let [c (primitive/cast i64 (slice-get name (load i)))]
                (str/sb-push-byte! (mut b)
                                   (primitive/cast u8
                                                   (if (or (and (>= c 48) (<= c 57))
                                                           (or (and (>= c 65) (<= c 90))
                                                               (or (and (>= c 97) (<= c 122))
                                                                   (= c 95))))
                                                       c
                                                       95)))
                (store! i (+ (load i) 1)))))
    (str/sb-str (load (mut b)))))

;; --------------------------------------------------------------- types

(defn scalar-name [(t (ptr ct/Type))] (-> (slice u8))
  (let [k (ct/ty-kind t)
        u (ct/ty-unsigned? t)]
    (cond
      (= k ct/TY-VOID) "i8"
      (= k ct/TY-BOOL) "u8"
      (= k ct/TY-CHAR) (if u "u8" "i8")
      (= k ct/TY-SHORT) (if u "u16" "i16")
      (= k ct/TY-INT) (if u "u32" "i32")
      (= k ct/TY-ENUM) "i32"
      (= k ct/TY-LONG) (if u "u64" "i64")
      (= k ct/TY-FLOAT) "f32"
      (= k ct/TY-DOUBLE) "f64"
      (= k ct/TY-LDOUBLE) "f64"
      :else "")))

;; A record's storage: an array of the widest unit its alignment allows, so the
;; blob has exactly C's size and alignment. C guarantees the size is a multiple
;; of the alignment, so the division is exact.
(defn emit-record-storage! [(e (mut Emitter)) (t (ptr ct/Type))] (-> i64)
  (let [size (ct/ty-size t)
        align (ct/ty-align t)]
    (put! (mut e) "(array ")
    (cond
      (>= align 8) (do (put! (mut e) "i64 ") (put-int! (mut e) (primitive/idiv size 8)))
      (= align 4) (do (put! (mut e) "i32 ") (put-int! (mut e) (primitive/idiv size 4)))
      (= align 2) (do (put! (mut e) "i16 ") (put-int! (mut e) (primitive/idiv size 2)))
      :else (do (put! (mut e) "u8 ") (put-int! (mut e) (if (= size 0) 1 size))))
    (put! (mut e) ")"))
  0)

(defn emit-type! [(e (mut Emitter)) (t (ptr ct/Type))] (-> i64)
  (if (= (primitive/cast i64 t) 0)
      (put! (mut e) "i64")
      (let [k (ct/ty-kind t)]
        (cond
          (ct/record? t) (emit-record-storage! (mut e) t)
          ;; Storage only. Anything that computes with one is refused below.
          (= k ct/TY-INT128) (put! (mut e) "(array i64 2)")
          (= k ct/TY-FLOAT16) (put! (mut e) "(array u8 2)")
          (= k ct/TY-PTR)
            (do (put! (mut e) "(ptr ")
                (emit-pointee! (mut e) (ct/ty-base t))
                (put! (mut e) ")"))
          ;; An array parameter or value is only ever handled through its
          ;; address, so its element type is what matters.
          (= k ct/TY-ARRAY)
            (do (put! (mut e) "(array ")
                (emit-type! (mut e) (ct/ty-base t))
                (put! (mut e) " ")
                (put-int! (mut e) (if (< (ct/ty-array-len t) 0) 0 (ct/ty-array-len t)))
                (put! (mut e) ")"))
          (= k ct/TY-FUNC) (emit-fnptr! (mut e) t)
          :else (put! (mut e) (scalar-name t))))))

;; `void *` and a pointer to an incomplete record both become `(ptr i8)`: the
;; pointee's layout is never needed through them.
(defn emit-pointee! [(e (mut Emitter)) (t (ptr ct/Type))] (-> i64)
  (if (= (primitive/cast i64 t) 0)
      (put! (mut e) "i8")
      (let [k (ct/ty-kind t)]
        (cond
          (= k ct/TY-VOID) (put! (mut e) "i8")
          (= k ct/TY-FUNC) (emit-fnptr! (mut e) t)
          (and (ct/record? t) (not (ct/ty-complete? t))) (put! (mut e) "i8")
          :else (emit-type! (mut e) t)))))

(defn emit-fnptr! [(e (mut Emitter)) (t (ptr ct/Type))] (-> i64)
  (let [params (ct/ty-params t)
        n (al/al-len [(ptr ct/Type)] params)
        (mut i) 0]
    (put! (mut e) "(fnptr c [")
    (loop (if (>= (load i) n)
              (break)
              (do
                (if (> (load i) 0) (put! (mut e) " ") 0)
                (emit-param-type! (mut e) (al/al-get [(ptr ct/Type)] params (load i)))
                (store! i (+ (load i) 1)))))
    (if (ct/ty-variadic? t)
        (do (if (> n 0) (put! (mut e) " ") 0) (put! (mut e) "..."))
        0)
    (put! (mut e) "] ")
    (emit-return-type! (mut e) (ct/ty-base t))
    (put! (mut e) ")"))
  0)

;; An array parameter is a pointer, and a record parameter is passed by
;; reference here rather than by value.
(defn emit-param-type! [(e (mut Emitter)) (t (ptr ct/Type))] (-> i64)
  (if (= (primitive/cast i64 t) 0)
      (put! (mut e) "i64")
      (let [k (ct/ty-kind t)]
        (cond
          (= k ct/TY-ARRAY)
            (do (put! (mut e) "(ptr ") (emit-pointee! (mut e) (ct/ty-base t)) (put! (mut e) ")"))
          (= k ct/TY-FUNC)
            (do (put! (mut e) "(ptr ") (emit-fnptr! (mut e) t) (put! (mut e) ")"))
          :else (emit-type! (mut e) t)))))

(defn emit-return-type! [(e (mut Emitter)) (t (ptr ct/Type))] (-> i64)
  (if (= (primitive/cast i64 t) 0)
      (put! (mut e) "i64")
      (if (= (ct/ty-kind t) ct/TY-VOID)
          (put! (mut e) "i64")
          (emit-param-type! (mut e) t))))

;; ------------------------------------------------------------ operations

;; Integer operations are chosen by signedness, floating ones by kind, so the
;; distinction C makes between signed and unsigned division and comparison is
;; preserved rather than flattened.
(defn arith-op [(t (ptr ct/Type)) (kind i64)] (-> (slice u8))
  (let [f (and (!= (primitive/cast i64 t) 0) (ct/floating? t))
        u (and (!= (primitive/cast i64 t) 0) (ct/ty-unsigned? t))]
    (cond
      (= kind nd/ND-ADD) (if f "primitive/fadd" "primitive/iadd")
      (= kind nd/ND-SUB) (if f "primitive/fsub" "primitive/isub")
      (= kind nd/ND-MUL) (if f "primitive/fmul" "primitive/imul")
      (= kind nd/ND-DIV) (if f "primitive/fdiv" (if u "primitive/udiv" "primitive/idiv"))
      (= kind nd/ND-MOD) (if u "primitive/urem" "primitive/irem")
      (= kind nd/ND-BITAND) "primitive/iand"
      (= kind nd/ND-BITOR) "primitive/ior"
      (= kind nd/ND-BITXOR) "primitive/ixor"
      (= kind nd/ND-SHL) "primitive/ishl"
      (= kind nd/ND-SHR) "primitive/ishr"
      :else "")))

(defn compare-op [(t (ptr ct/Type)) (kind i64)] (-> (slice u8))
  (let [f (and (!= (primitive/cast i64 t) 0) (ct/floating? t))]
    (cond
      (= kind nd/ND-EQ) (if f "primitive/fcmp-eq" "primitive/icmp-eq")
      (= kind nd/ND-NE) (if f "primitive/fcmp-ne" "primitive/icmp-ne")
      (= kind nd/ND-LT) (if f "primitive/fcmp-lt" "primitive/icmp-lt")
      (= kind nd/ND-LE) (if f "primitive/fcmp-le" "primitive/icmp-le")
      :else "")))

;; --------------------------------------------------------- addresses

;; The address of an lvalue. Only the constructs C calls lvalues have one, and
;; every read of an lvalue is a load from here.
(defn emit-addr! [(e (mut Emitter)) (n (ptr nd/Node))] (-> i64)
  (let [k (nd/nd-kind n)]
    (cond
      (= k nd/ND-VAR)
        (let [o (nd/nd-obj n)]
          (if (nd/obj-local? o)
              (put! (mut e) (slot-of (mut e) o))
              (do (put! (mut e) "(") (put! (mut e) (slot-of (mut e) o)) (put! (mut e) ")"))))
      (= k nd/ND-DEREF) (emit-expr! (mut e) (nd/nd-lhs n))
      ;; A member is its record's address advanced by the byte offset the
      ;; layout assigned, then reinterpreted.
      (= k nd/ND-MEMBER)
        (do
          (put! (mut e) "(primitive/cast (ptr ")
          (emit-type! (mut e) (nd/nd-type n))
          (put! (mut e) ") (primitive/index (primitive/cast (ptr u8) ")
          (emit-addr! (mut e) (nd/nd-lhs n))
          (put! (mut e) ") ")
          (put-int! (mut e) (nd/nd-member-offset n))
          (put! (mut e) "))"))
      :else (fail! (mut e) "expression is not an lvalue" (nd/nd-token n)))))

;; A bitfield is read by loading its storage unit, shifting the field down, and
;; masking it; a signed one is then sign-extended by shifting up and back.
(defn emit-bitfield-load! [(e (mut Emitter)) (n (ptr nd/Node))] (-> i64)
  (let [width (nd/nd-member-bit-width n)
        offset (nd/nd-member-bit-offset n)
        t (nd/nd-type n)
        bits (* (ct/ty-size t) 8)]
    (if (ct/ty-unsigned? t)
        (do
          (put! (mut e) "(primitive/iand (primitive/ishr (primitive/load ")
          (emit-addr! (mut e) n)
          (put! (mut e) ") ")
          (put-int! (mut e) offset)
          (put! (mut e) ") ")
          (put-int! (mut e) (- (primitive/ishl 1 width) 1))
          (put! (mut e) ")"))
        (do
          (put! (mut e) "(primitive/ishr (primitive/ishl (primitive/load ")
          (emit-addr! (mut e) n)
          (put! (mut e) ") ")
          (put-int! (mut e) (- bits (+ offset width)))
          (put! (mut e) ") ")
          (put-int! (mut e) (- bits width))
          (put! (mut e) ")"))))
  0)

;; Writing a bitfield is read-modify-write: clear the field's bits, then place
;; the new value into them.
(defn emit-bitfield-store! [(e (mut Emitter)) (n (ptr nd/Node)) (value (ptr nd/Node))] (-> i64)
  (let [width (nd/nd-member-bit-width n)
        offset (nd/nd-member-bit-offset n)
        mask (primitive/ishl (- (primitive/ishl 1 width) 1) offset)]
    (put! (mut e) "(primitive/store! ")
    (emit-addr! (mut e) n)
    (put! (mut e) " (primitive/cast ")
    (emit-type! (mut e) (nd/nd-type n))
    (put! (mut e) " (primitive/ior (primitive/iand (primitive/cast i64 (primitive/load ")
    (emit-addr! (mut e) n)
    (put! (mut e) ")) ")
    (put-int! (mut e) (primitive/inot mask))
    (put! (mut e) ") (primitive/iand (primitive/ishl (primitive/cast i64 ")
    (emit-expr! (mut e) value)
    (put! (mut e) ") ")
    (put-int! (mut e) offset)
    (put! (mut e) ") ")
    (put-int! (mut e) mask)
    (put! (mut e) "))))"))
  0)

;; ------------------------------------------------------------ expressions

;; A floating value is true when it differs from zero, which converting it to
;; an integer first would not preserve: 0.5 would round to false.
(defn emit-truth! [(e (mut Emitter)) (n (ptr nd/Node))] (-> i64)
  (let [t (nd/nd-type n)]
    (if (and (!= (primitive/cast i64 t) 0) (ct/floating? t))
        (do (put! (mut e) "(primitive/fcmp-ne ")
            (emit-expr! (mut e) n)
            (put! (mut e) " (primitive/cast ")
            (emit-type! (mut e) t)
            (put! (mut e) " 0.0))"))
        (do (put! (mut e) "(primitive/icmp-ne (primitive/cast i64 ")
            (emit-expr! (mut e) n)
            (put! (mut e) ") 0)"))))
  0)

(defn emit-binary! [(e (mut Emitter)) (n (ptr nd/Node)) (op (slice u8))] (-> i64)
  (put! (mut e) "(")
  (put! (mut e) op)
  (put! (mut e) " ")
  (emit-expr! (mut e) (nd/nd-lhs n))
  (put! (mut e) " ")
  (emit-expr! (mut e) (nd/nd-rhs n))
  (put! (mut e) ")")
  0)

(defn emit-call! [(e (mut Emitter)) (n (ptr nd/Node))] (-> i64)
  (let [callee (nd/nd-lhs n)
        args (nd/nd-args n)
        count (al/al-len [(ptr nd/Node)] args)
        (mut i) 0
        direct (and (= (nd/nd-kind callee) nd/ND-CAST)
                    (= (nd/nd-kind (nd/nd-lhs callee)) nd/ND-VAR))]
    ;; A call through a name is emitted as a direct call; anything else goes
    ;; through the function pointer it evaluates to.
    (if direct
        (do (put! (mut e) "(")
            (put! (mut e) (callee-name (mut e) (nd/nd-obj (nd/nd-lhs callee)))))
        (do (put! (mut e) "(primitive/call-ptr ")
            (emit-expr! (mut e) callee)))
    (loop (if (>= (load i) count)
              (break)
              (do
                (put! (mut e) " ")
                (emit-expr! (mut e) (al/al-get [(ptr nd/Node)] args (load i)))
                (store! i (+ (load i) 1)))))
    (put! (mut e) ")"))
  0)

(defn emit-assign! [(e (mut Emitter)) (n (ptr nd/Node))] (-> i64)
  (let [target (nd/nd-lhs n)
        value (nd/nd-rhs n)]
    (if (and (= (nd/nd-kind target) nd/ND-MEMBER) (>= (nd/nd-member-bit-width target) 0))
        (emit-bitfield-store! (mut e) target value)
        (do
          ;; The assignment yields the stored value, so the store is sequenced
          ;; before a reload of the target.
          (put! (mut e) "(do (primitive/store! ")
          (emit-addr! (mut e) target)
          (put! (mut e) " ")
          (emit-expr! (mut e) value)
          (put! (mut e) ") (primitive/load ")
          (emit-addr! (mut e) target)
          (put! (mut e) "))"))))
  0)

(defn callee-name [(e (mut Emitter)) (o (ptr nd/Obj))] (-> (slice u8))
  (if (hm/hm-contains? (load (field e defined)) (nd/obj-name o))
      (ident (mut e) "c_fn_" (nd/obj-name o))
      (link-name o)))

(defn emit-expr! [(e (mut Emitter)) (n (ptr nd/Node))] (-> i64)
  (if (= (primitive/cast i64 n) 0)
      (put! (mut e) "0")
      (let [k (nd/nd-kind n)
            t (nd/nd-type n)]
        (cond
          ;; Reported rather than narrowed: a 128-bit value silently computed as
          ;; 64 bits would be wrong in a way nothing downstream could catch.
          (and (!= (primitive/cast i64 t) 0) (= (ct/ty-kind t) ct/TY-INT128))
            (fail! (mut e) "128-bit integer arithmetic is not supported" (nd/nd-token n))
          (and (!= (primitive/cast i64 t) 0) (= (ct/ty-kind t) ct/TY-FLOAT16))
            (fail! (mut e) "half-precision arithmetic is not supported" (nd/nd-token n))
          (= k nd/ND-NUM)
            (do (put! (mut e) "(primitive/cast ")
                (emit-type! (mut e) t)
                (put! (mut e) " ")
                (if (and (!= (primitive/cast i64 t) 0) (ct/floating? t))
                    (put-float! (mut e) (nd/nd-fvalue n))
                    (put-int! (mut e) (nd/nd-value n)))
                (put! (mut e) ")"))
          ;; An array or a function names its own address; anything else is
          ;; read from it.
          (= k nd/ND-VAR)
            (let [vt (nd/nd-type n)]
              (cond
                (= (ct/ty-kind vt) ct/TY-FUNC)
                  (do (put! (mut e) "(primitive/fnptr-of ")
                      (put! (mut e) (callee-name (mut e) (nd/nd-obj n)))
                      (put! (mut e) ")"))
                (= (ct/ty-kind vt) ct/TY-ARRAY) (emit-addr! (mut e) n)
                :else
                  (do (put! (mut e) "(primitive/load ") (emit-addr! (mut e) n) (put! (mut e) ")"))))
          (= k nd/ND-MEMBER)
            (if (>= (nd/nd-member-bit-width n) 0)
                (emit-bitfield-load! (mut e) n)
                (if (= (ct/ty-kind t) ct/TY-ARRAY)
                    (emit-addr! (mut e) n)
                    (do (put! (mut e) "(primitive/load ") (emit-addr! (mut e) n) (put! (mut e) ")"))))
          (= k nd/ND-DEREF)
            (if (or (= (ct/ty-kind t) ct/TY-ARRAY) (= (ct/ty-kind t) ct/TY-FUNC))
                (emit-expr! (mut e) (nd/nd-lhs n))
                (do (put! (mut e) "(primitive/load ") (emit-addr! (mut e) n) (put! (mut e) ")")))
          (= k nd/ND-ADDR) (emit-addr! (mut e) (nd/nd-lhs n))
          (= k nd/ND-ASSIGN) (emit-assign! (mut e) n)
          ;; A record has no cast: the value already has the storage type the
          ;; target wants, and Coil has no conversion between aggregates.
          (and (= k nd/ND-CAST) (ct/record? t)) (emit-expr! (mut e) (nd/nd-lhs n))
          (= k nd/ND-CAST)
            (do (put! (mut e) "(primitive/cast ")
                (emit-param-type! (mut e) t)
                (put! (mut e) " ")
                (emit-expr! (mut e) (nd/nd-lhs n))
                (put! (mut e) ")"))
          ;; Clearing an object an initialiser only partly fills.
          (= k nd/ND-MEMZERO)
            (do (put! (mut e) "(primitive/store! ")
                (emit-addr! (mut e) (nd/nd-lhs n))
                (put! (mut e) " (primitive/zeroed ")
                (emit-type! (mut e) t)
                (put! (mut e) "))"))
          (= k nd/ND-CALL) (emit-call! (mut e) n)
          (= k nd/ND-NEG)
            (do (put! (mut e) "(")
                (put! (mut e) (if (ct/floating? t) "primitive/fsub" "primitive/isub"))
                (put! (mut e) " (primitive/cast ")
                (emit-type! (mut e) t)
                (put! (mut e) " 0) ")
                (emit-expr! (mut e) (nd/nd-lhs n))
                (put! (mut e) ")"))
          (= k nd/ND-BITNOT)
            (do (put! (mut e) "(primitive/inot ") (emit-expr! (mut e) (nd/nd-lhs n)) (put! (mut e) ")"))
          (= k nd/ND-NOT)
            (do (put! (mut e) "(if ") (emit-truth! (mut e) (nd/nd-lhs n)) (put! (mut e) " 0 1)"))
          ;; Both operands of && and || must not be evaluated unconditionally.
          (= k nd/ND-LOGAND)
            (do (put! (mut e) "(if ")
                (emit-truth! (mut e) (nd/nd-lhs n))
                (put! (mut e) " (if ")
                (emit-truth! (mut e) (nd/nd-rhs n))
                (put! (mut e) " 1 0) 0)"))
          (= k nd/ND-LOGOR)
            (do (put! (mut e) "(if ")
                (emit-truth! (mut e) (nd/nd-lhs n))
                (put! (mut e) " 1 (if ")
                (emit-truth! (mut e) (nd/nd-rhs n))
                (put! (mut e) " 1 0))"))
          (or (= k nd/ND-EQ) (or (= k nd/ND-NE) (or (= k nd/ND-LT) (= k nd/ND-LE))))
            (do (put! (mut e) "(if ")
                (emit-binary! (mut e) n (compare-op (nd/nd-type (nd/nd-lhs n)) k))
                (put! (mut e) " 1 0)"))
          (= k nd/ND-COND)
            (do (put! (mut e) "(if ")
                (emit-truth! (mut e) (nd/nd-test n))
                (put! (mut e) " ")
                (emit-expr! (mut e) (nd/nd-then n))
                (put! (mut e) " ")
                (emit-expr! (mut e) (nd/nd-else n))
                (put! (mut e) ")"))
          (= k nd/ND-COMMA)
            (do (put! (mut e) "(do ")
                (emit-expr! (mut e) (nd/nd-lhs n))
                (put! (mut e) " ")
                (emit-expr! (mut e) (nd/nd-rhs n))
                (put! (mut e) ")"))
          ;; The parser has already scaled the operand to bytes, so this walks
          ;; the pointer by bytes and restores its type. Integer addition would
          ;; not typecheck against a pointer, and would be the wrong operation.
          (and (or (= k nd/ND-ADD) (= k nd/ND-SUB)) (ct/pointer-like? t))
            (do (put! (mut e) "(primitive/cast ")
                (emit-param-type! (mut e) t)
                (put! (mut e) " (primitive/index (primitive/cast (ptr u8) ")
                (emit-expr! (mut e) (nd/nd-lhs n))
                (put! (mut e) ") ")
                (if (= k nd/ND-SUB)
                    (do (put! (mut e) "(primitive/isub 0 (primitive/cast i64 ")
                        (emit-expr! (mut e) (nd/nd-rhs n))
                        (put! (mut e) "))"))
                    (do (put! (mut e) "(primitive/cast i64 ")
                        (emit-expr! (mut e) (nd/nd-rhs n))
                        (put! (mut e) ")")))
                ;; closes: index, cast
                (put! (mut e) "))"))
          ;; A pointer difference is a byte difference; the parser divides it by
          ;; the element size.
          (and (= k nd/ND-SUB)
               (and (ct/pointer-like? (nd/nd-type (nd/nd-lhs n)))
                    (ct/pointer-like? (nd/nd-type (nd/nd-rhs n)))))
            (do (put! (mut e) "(primitive/isub (primitive/cast i64 ")
                (emit-expr! (mut e) (nd/nd-lhs n))
                (put! (mut e) ") (primitive/cast i64 ")
                (emit-expr! (mut e) (nd/nd-rhs n))
                (put! (mut e) "))"))
          :else (emit-binary! (mut e) n (arith-op t k))))))

;; ------------------------------------------------------------- statements

;; Objects are identified by address rather than by name, because C lets an
;; inner scope shadow an outer one and both are live at once.
(defn obj-key [(e (mut Emitter)) (o (ptr nd/Obj))] (-> (slice u8))
  (let [(mut b) (str/sb-new (load (field e a)))]
    (str/sb-push-str! (mut b) "o")
    (str/sb-push-i64! (mut b) (primitive/cast i64 o))
    (str/sb-str (load (mut b)))))

(defn bind-slot! [(e (mut Emitter)) (o (ptr nd/Obj)) (slot (slice u8))] (-> i64)
  (hm/hm-put! [(slice u8) (slice u8)] (mut (field e slots)) (obj-key (mut e) o) slot) 0)

(defn slot-of [(e (mut Emitter)) (o (ptr nd/Obj))] (-> (slice u8))
  (match (hm/hm-get (load (field e slots)) (obj-key (mut e) o))
    (Some [s] s)
    (None [] (ident (mut e) "c_g_" (nd/obj-name o)))))


;; `break` and `continue` name the scope they leave rather than relying on which
;; construct happens to be innermost, because a `break` inside a switch inside a
;; loop leaves the switch while a `continue` there leaves the loop body.
(defn push-break! [(e (mut Emitter)) (label (slice u8))] (-> i64)
  (al/al-push! [(slice u8)] (mut (field e break-labels)) label) 0)
(defn pop-break! [(e (mut Emitter))] (-> i64)
  (al/al-pop! [(slice u8)] (mut (field e break-labels))) 0)
(defn push-continue! [(e (mut Emitter)) (label (slice u8))] (-> i64)
  (al/al-push! [(slice u8)] (mut (field e continue-labels)) label) 0)
(defn pop-continue! [(e (mut Emitter))] (-> i64)
  (al/al-pop! [(slice u8)] (mut (field e continue-labels))) 0)

(defn top-label [(list (al/ArrayList (slice u8)))] (-> (slice u8))
  (let [n (al/al-len [(slice u8)] list)]
    (if (= n 0) "" (al/al-get [(slice u8)] list (- n 1)))))

;; A case label carries the statement it labels, so `case 1: case 2: f();`
;; arrives nested. Flattening unwraps those chains into a linear list in which
;; every case is a marker standing immediately before the statements it
;; introduces -- the shape the fallthrough lowering below reads.
(defn flatten-case! [(out (mut (al/ArrayList (ptr nd/Node)))) (s (ptr nd/Node))] (-> i64)
  (al/al-push! [(ptr nd/Node)] (mut out) s)
  (if (= (nd/nd-kind s) nd/ND-CASE)
      (flatten-case! (mut out) (nd/nd-then s))
      0))

;; Which group `default` selects. With no default the answer is one past the
;; last group, which selects nothing -- exactly what C says an unmatched switch
;; without a default does.
(defn switch-default-group [(flat (al/ArrayList (ptr nd/Node)))] (-> i64)
  (let [count (al/al-len [(ptr nd/Node)] flat)
        (mut i) 0
        (mut group) 0
        (mut found) -1]
    (loop (if (>= (load i) count)
              (break)
              (let [s (al/al-get [(ptr nd/Node)] flat (load i))]
                (if (= (nd/nd-kind s) nd/ND-CASE)
                    (do
                      (if (and (= (load found) -1) (str/str-eq (nd/nd-label s) "default"))
                          (store! found (load group))
                          0)
                      (store! group (+ (load group) 1)))
                    0)
                (store! i (+ (load i) 1)))))
    (if (= (load found) -1) (load group) (load found))))

;; The chain of comparisons that turns the switch value into a group index.
(defn emit-switch-selector! [(e (mut Emitter)) (flat (al/ArrayList (ptr nd/Node)))
                             (value (slice u8))] (-> i64)
  (let [count (al/al-len [(ptr nd/Node)] flat)
        fallback (switch-default-group flat)
        (mut i) 0
        (mut group) 0
        (mut opened) 0]
    (loop (if (>= (load i) count)
              (break)
              (let [s (al/al-get [(ptr nd/Node)] flat (load i))]
                (if (= (nd/nd-kind s) nd/ND-CASE)
                    (do
                      (if (str/str-eq (nd/nd-label s) "default")
                          0
                          (do
                            (put! (mut e) "(if (primitive/icmp-eq ")
                            (put! (mut e) value)
                            (put! (mut e) " ")
                            (put-int! (mut e) (nd/nd-value s))
                            (put! (mut e) ") ")
                            (put-int! (mut e) (load group))
                            (put! (mut e) " ")
                            (store! opened (+ (load opened) 1))))
                      (store! group (+ (load group) 1)))
                    0)
                (store! i (+ (load i) 1)))))
    (put-int! (mut e) fallback)
    (let [(mut j) 0]
      (loop (if (>= (load j) (load opened))
                (break)
                (do (put! (mut e) ")") (store! j (+ (load j) 1))))))
    0))

;; Every group from the selected one onward runs, which is what makes control
;; fall out of one case and into the next without any extra machinery.
(defn emit-switch-groups! [(e (mut Emitter)) (flat (al/ArrayList (ptr nd/Node)))
                           (index (slice u8))] (-> i64)
  (let [count (al/al-len [(ptr nd/Node)] flat)
        (mut i) 0
        (mut group) -1]
    (put! (mut e) "(do")
    (loop (if (>= (load i) count)
              (break)
              (let [s (al/al-get [(ptr nd/Node)] flat (load i))]
                (if (= (nd/nd-kind s) nd/ND-CASE)
                    (do
                      (if (>= (load group) 0) (put! (mut e) " 0) 0)") 0)
                      (store! group (+ (load group) 1))
                      (put! (mut e) " (if (primitive/icmp-le ")
                      (put! (mut e) index)
                      (put! (mut e) " ")
                      (put-int! (mut e) (load group))
                      (put! (mut e) ") (do"))
                    ;; Statements before the first case are unreachable in C.
                    (if (>= (load group) 0)
                        (do (put! (mut e) " ") (emit-stmt! (mut e) s))
                        0))
                (store! i (+ (load i) 1)))))
    (if (>= (load group) 0) (put! (mut e) " 0) 0)") 0)
    (put! (mut e) " 0)")
    0))

(defn emit-switch! [(e (mut Emitter)) (n (ptr nd/Node))] (-> i64)
  (let [body (nd/nd-then n)]
    (if (!= (nd/nd-kind body) nd/ND-BLOCK)
        (fail! (mut e) "a switch body must be a block" (nd/nd-token n))
        (let [(mut flat) (al/al-new [(ptr nd/Node)] (load (field e a)))
              src (nd/nd-body body)
              count (al/al-len [(ptr nd/Node)] src)
              (mut i) 0]
          (loop (if (>= (load i) count)
                    (break)
                    (do (flatten-case! (mut flat) (al/al-get [(ptr nd/Node)] src (load i)))
                        (store! i (+ (load i) 1)))))
          (let [items (load flat)
                brk (fresh (mut e) ":brk")
                value (fresh (mut e) "sw")
                index (fresh (mut e) "sg")]
            (push-break! (mut e) brk)
            (put! (mut e) "(control/scope ")
            (put! (mut e) brk)
            (put! (mut e) " (let [")
            (put! (mut e) value)
            (put! (mut e) " (primitive/cast i64 ")
            (emit-expr! (mut e) (nd/nd-test n))
            (put! (mut e) ") ")
            (put! (mut e) index)
            (put! (mut e) " ")
            (emit-switch-selector! (mut e) items value)
            (put! (mut e) "] ")
            (emit-switch-groups! (mut e) items index)
            (put! (mut e) "))")
            (pop-break! (mut e))
            0)))))

(defn emit-stmt! [(e (mut Emitter)) (n (ptr nd/Node))] (-> i64)
  (if (= (primitive/cast i64 n) 0)
      (put! (mut e) "0")
      (let [k (nd/nd-kind n)]
        (cond
          (= k nd/ND-NULL) (put! (mut e) "0")
          (= k nd/ND-BLOCK)
            (let [body (nd/nd-body n)
                  count (al/al-len [(ptr nd/Node)] body)
                  (mut i) 0]
              (put! (mut e) "(do")
              (loop (if (>= (load i) count)
                        (break)
                        (do
                          (put! (mut e) " ")
                          (emit-stmt! (mut e) (al/al-get [(ptr nd/Node)] body (load i)))
                          (store! i (+ (load i) 1)))))
              (put! (mut e) " 0)"))
          ;; The value is discarded, so it is sequenced and then dropped.
          (= k nd/ND-EXPR-STMT)
            (do (put! (mut e) "(do ")
                (emit-expr! (mut e) (nd/nd-lhs n))
                (put! (mut e) " 0)"))
          (= k nd/ND-RETURN)
            (do (put! (mut e) "(control/return-from :c_return ")
                (if (= (primitive/cast i64 (nd/nd-lhs n)) 0)
                    (put! (mut e) "0")
                    (emit-expr! (mut e) (nd/nd-lhs n)))
                (put! (mut e) ")"))
          (= k nd/ND-IF)
            (do (put! (mut e) "(if ")
                (emit-truth! (mut e) (nd/nd-test n))
                (put! (mut e) " ")
                (emit-stmt! (mut e) (nd/nd-then n))
                (put! (mut e) " ")
                (if (= (primitive/cast i64 (nd/nd-else n)) 0)
                    (put! (mut e) "0")
                    (emit-stmt! (mut e) (nd/nd-else n)))
                (put! (mut e) ")"))
          (= k nd/ND-WHILE)
            (let [brk (fresh (mut e) ":brk") cnt (fresh (mut e) ":cnt")]
              (push-break! (mut e) brk)
              (push-continue! (mut e) cnt)
              (put! (mut e) "(control/scope ")
              (put! (mut e) brk)
              (put! (mut e) " (loop (if ")
              (emit-truth! (mut e) (nd/nd-test n))
              (put! (mut e) " (control/scope ")
              (put! (mut e) cnt)
              (put! (mut e) " ")
              (emit-stmt! (mut e) (nd/nd-then n))
              (put! (mut e) ") (break))))")
              (pop-continue! (mut e))
              (pop-break! (mut e))
              0)
          ;; The body runs before the test, so the test guards only the repeat.
          (= k nd/ND-DO)
            (let [brk (fresh (mut e) ":brk") cnt (fresh (mut e) ":cnt")]
              (push-break! (mut e) brk)
              (push-continue! (mut e) cnt)
              (put! (mut e) "(control/scope ")
              (put! (mut e) brk)
              (put! (mut e) " (loop (do (control/scope ")
              (put! (mut e) cnt)
              (put! (mut e) " ")
              (emit-stmt! (mut e) (nd/nd-then n))
              (put! (mut e) ") (if ")
              (emit-truth! (mut e) (nd/nd-test n))
              (put! (mut e) " 0 (break)))))")
              (pop-continue! (mut e))
              (pop-break! (mut e))
              0)
          ;; The initialiser runs once outside the loop; the step runs after the
          ;; body, which is what `continue` has to skip to.
          (= k nd/ND-FOR)
            (let [brk (fresh (mut e) ":brk") cnt (fresh (mut e) ":cnt")]
              (push-break! (mut e) brk)
              (push-continue! (mut e) cnt)
              (put! (mut e) "(do ")
              (if (= (primitive/cast i64 (nd/nd-setup n)) 0)
                  (put! (mut e) "0")
                  (emit-stmt! (mut e) (nd/nd-setup n)))
              (put! (mut e) " (control/scope ")
              (put! (mut e) brk)
              (put! (mut e) " (loop (if ")
              (if (= (primitive/cast i64 (nd/nd-test n)) 0)
                  (put! (mut e) "true")
                  (emit-truth! (mut e) (nd/nd-test n)))
              (put! (mut e) " (do (control/scope ")
              (put! (mut e) cnt)
              (put! (mut e) " ")
              (emit-stmt! (mut e) (nd/nd-then n))
              (put! (mut e) ") ")
              (if (= (primitive/cast i64 (nd/nd-step n)) 0)
                  (put! (mut e) "0")
                  (emit-stmt! (mut e) (nd/nd-step n)))
              (put! (mut e) ") (break)))))")
              (pop-continue! (mut e))
              (pop-break! (mut e))
              0)
          (= k nd/ND-BREAK)
            (do (put! (mut e) "(control/return-from ")
                (put! (mut e) (top-label (load (field e break-labels))))
                (put! (mut e) " 0)"))
          (= k nd/ND-CONTINUE)
            (do (put! (mut e) "(control/return-from ")
                (put! (mut e) (top-label (load (field e continue-labels))))
                (put! (mut e) " 0)"))
          (= k nd/ND-SWITCH) (emit-switch! (mut e) n)
          ;; Reached only for a case that is not directly in a switch body.
          (= k nd/ND-CASE) (emit-stmt! (mut e) (nd/nd-then n))
          ;; Not yet lowered. This reports rather than emitting something that
          ;; would silently run the wrong code.
          (= k nd/ND-GOTO) (fail! (mut e) "goto is not lowered yet" (nd/nd-token n))
          (= k nd/ND-LABEL) (fail! (mut e) "labels are not lowered yet" (nd/nd-token n))
          :else (do (put! (mut e) "(do ") (emit-expr! (mut e) n) (put! (mut e) " 0)"))))))

;; ------------------------------------------------------------- top level

;; Every local gets its own addressable slot, because C can take the address of
;; any of them. This is the one place a raw stack allocation is the right tool
;; rather than a mutable binding: it is C's automatic storage, and it is what
;; makes `&x` mean anything. The slots are declared once at the top of the
;; function, never inside a loop.
(defn emit-locals! [(e (mut Emitter)) (f (ptr nd/Obj))] (-> i64)
  (let [locals (nd/obj-locals f)
        count (al/al-len [(ptr nd/Obj)] locals)
        (mut i) 0]
    (loop (if (>= (load i) count)
              (break)
              (let [o (al/al-get [(ptr nd/Obj)] locals (load i))
                    slot (fresh (mut e) "v")]
                (bind-slot! (mut e) o slot)
                (put! (mut e) " ")
                (put! (mut e) slot)
                (put! (mut e) " (primitive/alloc-stack ")
                (emit-type! (mut e) (nd/obj-type o))
                (put! (mut e) ")")
                (store! i (+ (load i) 1))))))
  0)

;; Parameters arrive as values and are copied into their slots, so the body can
;; treat them exactly like any other local.
(defn emit-param-copies! [(e (mut Emitter)) (f (ptr nd/Obj))] (-> i64)
  (let [params (nd/obj-params f)
        count (al/al-len [(ptr nd/Obj)] params)
        (mut i) 0]
    (loop (if (>= (load i) count)
              (break)
              (let [o (al/al-get [(ptr nd/Obj)] params (load i))]
                (put! (mut e) " (primitive/store! ")
                (put! (mut e) (slot-of (mut e) o))
                (put! (mut e) " a")
                (put-int! (mut e) (load i))
                (put! (mut e) ")")
                (store! i (+ (load i) 1))))))
  0)

(defn emit-function! [(e (mut Emitter)) (f (ptr nd/Obj))] (-> i64)
  (let [ty (nd/obj-type f)
        params (nd/obj-params f)
        count (al/al-len [(ptr nd/Obj)] params)
        (mut i) 0]
    (put! (mut e) "(defn ")
    (put! (mut e) (ident (mut e) "c_fn_" (nd/obj-name f)))
    (put! (mut e) " [")
    (loop (if (>= (load i) count)
              (break)
              (do
                (if (> (load i) 0) (put! (mut e) " ") 0)
                (put! (mut e) "(a")
                (put-int! (mut e) (load i))
                (put! (mut e) " ")
                (emit-param-type! (mut e) (nd/obj-type (al/al-get [(ptr nd/Obj)] params (load i))))
                (put! (mut e) ")")
                (store! i (+ (load i) 1)))))
    (put! (mut e) "] (-> ")
    (emit-return-type! (mut e) (ct/ty-base ty))
    (put! (mut e) ")\n  (let [")
    (emit-locals! (mut e) f)
    (put! (mut e) "]\n    (control/scope :c_return (do")
    (emit-param-copies! (mut e) f)
    (put! (mut e) " ")
    (emit-stmt! (mut e) (nd/obj-body f))
    ;; A function that runs off its end still has to yield a value of its
    ;; return type.
    (put! (mut e) " (primitive/zeroed ")
    (emit-return-type! (mut e) (ct/ty-base ty))
    ;; closes: zeroed, do, control/scope, let, defn
    (put! (mut e) ")))))\n"))
  0)

;; A global is a static cell reached through a zero-argument accessor, which
;; gives it one address for the whole program.
;; A string literal's bytes are known at compile time, so it is emitted as
;; static data rather than written by the initialiser at start-up. Coil's string
;; escape names a code point rather than a byte, so a literal that is not all
;; ASCII falls back to a cleared array the initialiser fills byte by byte.
(defn ascii-string? [(bytes (slice u8))] (-> bool)
  (let [n (slice-len bytes)
        (mut i) 0
        (mut ok) 1]
    (loop (if (or (>= (load i) n) (= (load ok) 0))
              (break)
              (do (if (>= (primitive/cast i64 (slice-get bytes (load i))) 128)
                      (store! ok 0)
                      0)
                  (store! i (+ (load i) 1)))))
    (!= (load ok) 0)))

(defn put-coil-string! [(e (mut Emitter)) (bytes (slice u8))] (-> i64)
  (let [n (slice-len bytes)
        (mut i) 0]
    (put! (mut e) "\"")
    (loop (if (>= (load i) n)
              (break)
              (let [c (primitive/cast i64 (slice-get bytes (load i)))]
                (put! (mut e) "\\x")
                (put-hex! (mut e) c)
                (put! (mut e) ";")
                (store! i (+ (load i) 1)))))
    ;; C strings are terminated; the array type already has room for it.
    (put! (mut e) "\\x0;\""))
  0)

(defn put-hex! [(e (mut Emitter)) (v i64)] (-> i64)
  (let [digits "0123456789abcdef"]
    (if (>= v 16)
        (put! (mut e) (subslice digits (primitive/idiv v 16) (+ (primitive/idiv v 16) 1)))
        0)
    (put! (mut e) (subslice digits (primitive/irem v 16) (+ (primitive/irem v 16) 1))))
  0)

(defn emit-global! [(e (mut Emitter)) (o (ptr nd/Obj))] (-> i64)
  (if (hm/hm-contains? (load (field e emitted)) (nd/obj-name o))
      0
      (do
        (hm/hm-put! [(slice u8) bool] (mut (field e emitted)) (nd/obj-name o) true)
        (put! (mut e) "(defn ")
        (put! (mut e) (ident (mut e) "c_g_" (nd/obj-name o)))
        (put! (mut e) " [] (-> (ptr ")
        (emit-type! (mut e) (nd/obj-type o))
        (put! (mut e) ")) ")
        (if (and (nd/obj-string? o) (ascii-string? (nd/obj-string-data o)))
            (do (put! (mut e) "(primitive/cast (ptr ")
                (emit-type! (mut e) (nd/obj-type o))
                (put! (mut e) ") (slice/slice-data [u8] ")
                (put-coil-string! (mut e) (nd/obj-string-data o))
                (put! (mut e) "))"))
            (do (put! (mut e) "(primitive/alloc-static ")
                (emit-type! (mut e) (nd/obj-type o))
                (put! (mut e) ")")))
        (put! (mut e) ")\n")
        0)))

;; A string that is not all ASCII gets its bytes written at start-up instead.
(defn emit-string-fill! [(e (mut Emitter)) (o (ptr nd/Obj))] (-> i64)
  (let [bytes (nd/obj-string-data o)
        n (slice-len bytes)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (put! (mut e) " (primitive/store! (primitive/index (primitive/cast (ptr u8) (")
                (put! (mut e) (ident (mut e) "c_g_" (nd/obj-name o)))
                (put! (mut e) ")) ")
                (put-int! (mut e) (load i))
                (put! (mut e) ") (primitive/cast u8 ")
                (put-int! (mut e) (primitive/cast i64 (slice-get bytes (load i))))
                (put! (mut e) "))")
                (store! i (+ (load i) 1))))))
  0)

(defn emit-extern! [(e (mut Emitter)) (o (ptr nd/Obj))] (-> i64)
  (if (hm/hm-contains? (load (field e externs)) (nd/obj-name o))
      0
      (do (hm/hm-put! [(slice u8) bool] (mut (field e externs)) (nd/obj-name o) true)
          (emit-extern-decl! (mut e) o))))

;; The name the linker knows an object by: its own, unless `__asm` gave it
;; another.
(defn link-name [(o (ptr nd/Obj))] (-> (slice u8))
  (let [asm (nd/obj-asm-name o)]
    (if (> (slice-len asm) 0) asm (nd/obj-name o))))

(defn emit-extern-decl! [(e (mut Emitter)) (o (ptr nd/Obj))] (-> i64)
  (let [ty (nd/obj-type o)
        params (ct/ty-params ty)
        count (al/al-len [(ptr ct/Type)] params)
        (mut i) 0]
    (put! (mut e) "(extern ")
    (put! (mut e) (link-name o))
    (put! (mut e) " :cc c [")
    (loop (if (>= (load i) count)
              (break)
              (do
                (if (> (load i) 0) (put! (mut e) " ") 0)
                (emit-param-type! (mut e) (al/al-get [(ptr ct/Type)] params (load i)))
                (store! i (+ (load i) 1)))))
    (if (ct/ty-variadic? ty)
        (do (if (> count 0) (put! (mut e) " ") 0) (put! (mut e) "..."))
        0)
    (put! (mut e) "] (-> ")
    (emit-return-type! (mut e) (ct/ty-base ty))
    (put! (mut e) "))\n"))
  0)

;; Records every name the program mentions, so that only the declarations it
;; needs become externs.
(defn note-use! [(e (mut Emitter)) (o (ptr nd/Obj))] (-> i64)
  (if (= (primitive/cast i64 o) 0)
      0
      (do (hm/hm-put! [(slice u8) bool] (mut (field e used)) (nd/obj-name o) true) 0)))

(defn collect-uses! [(e (mut Emitter)) (n (ptr nd/Node))] (-> i64)
  (if (= (primitive/cast i64 n) 0)
      0
      (do
        (if (= (nd/nd-kind n) nd/ND-VAR) (note-use! (mut e) (nd/nd-obj n)) 0)
        (collect-uses! (mut e) (nd/nd-lhs n))
        (collect-uses! (mut e) (nd/nd-rhs n))
        (collect-uses! (mut e) (nd/nd-test n))
        (collect-uses! (mut e) (nd/nd-then n))
        (collect-uses! (mut e) (nd/nd-else n))
        (collect-uses! (mut e) (nd/nd-setup n))
        (collect-uses! (mut e) (nd/nd-step n))
        (collect-uses-list! (mut e) (nd/nd-body n))
        (collect-uses-list! (mut e) (nd/nd-args n))
        0)))

(defn collect-uses-list! [(e (mut Emitter)) (list (al/ArrayList (ptr nd/Node)))] (-> i64)
  (let [n (al/al-len [(ptr nd/Node)] list)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do (collect-uses! (mut e) (al/al-get [(ptr nd/Node)] list (load i)))
                  (store! i (+ (load i) 1))))))
  0)

(defn used? [(e (mut Emitter)) (o (ptr nd/Obj))] (-> bool)
  (hm/hm-contains? (load (field e used)) (nd/obj-name o)))

;; A global with no definition anywhere in the program is somebody else's
;; symbol. Coil has no separate spelling for external data, so the symbol is
;; declared as a nullary function and its address taken: that is exactly what
;; the name means to the linker either way.
(defn emit-extern-global! [(e (mut Emitter)) (o (ptr nd/Obj))] (-> i64)
  (put! (mut e) "(extern ")
  (put! (mut e) (link-name o))
  (put! (mut e) " :cc c [] (-> i8))\n(defn ")
  (put! (mut e) (ident (mut e) "c_g_" (nd/obj-name o)))
  (put! (mut e) " [] (-> (ptr ")
  (emit-type! (mut e) (nd/obj-type o))
  (put! (mut e) ")) (primitive/cast (ptr ")
  (emit-type! (mut e) (nd/obj-type o))
  (put! (mut e) ") (primitive/fnptr-of ")
  (put! (mut e) (link-name o))
  (put! (mut e) ")))\n")
  0)

(defn emit-program [(a (dyn alloc/Allocator))
                    (globals (al/ArrayList (ptr nd/Obj)))
                    (init (ptr nd/Node))] (-> EmitResult)
  (let [(mut e) (load (Emitter :a a
                        :out (str/sb-new a)
                        :slots (hm/hm-new [(slice u8) (slice u8)] a (str/str-keyops))
                        :defined (hm/hm-new [(slice u8) bool] a (str/str-keyops))
                        :externs (hm/hm-new [(slice u8) bool] a (str/str-keyops))
                        :emitted (hm/hm-new [(slice u8) bool] a (str/str-keyops))
                        :used (hm/hm-new [(slice u8) bool] a (str/str-keyops))
                        :defined-data (hm/hm-new [(slice u8) bool] a (str/str-keyops))
                        :serial 0
                        :break-labels (al/al-new [(slice u8)] a)
                        :continue-labels (al/al-new [(slice u8)] a)
                        :failed 0
                        :message ""
                        :file ""
                        :line 0))
        count (al/al-len [(ptr nd/Obj)] globals)
        (mut i) 0]
    ;; What has a definition, and under which of the two kinds.
    (loop (if (>= (load i) count)
              (break)
              (let [o (al/al-get [(ptr nd/Obj)] globals (load i))]
                (if (nd/obj-definition? o)
                    (if (nd/obj-function? o)
                        (do (hm/hm-put! [(slice u8) bool]
                                        (mut (field e defined))
                                        (nd/obj-name o)
                                        true)
                            0)
                        (do (hm/hm-put! [(slice u8) bool]
                                        (mut (field e defined-data))
                                        (nd/obj-name o)
                                        true)
                            0))
                    0)
                ;; A string literal has no reference to find it by; its bytes
                ;; are the reason it exists.
                (if (nd/obj-string? o) (note-use! (mut e) o) 0)
                (store! i (+ (load i) 1)))))
    ;; What the program mentions.
    (store! i 0)
    (loop (if (>= (load i) count)
              (break)
              (let [o (al/al-get [(ptr nd/Obj)] globals (load i))]
                (if (nd/obj-definition? o) (collect-uses! (mut e) (nd/obj-body o)) 0)
                (store! i (+ (load i) 1)))))
    (collect-uses! (mut e) init)

    (put! (mut e) "(module c_program)\n")
    (put! (mut e) "(import \"coil.primitive\" :as primitive)\n")
    (put! (mut e) "(import \"coil.alloc\" :as alloc)\n")
    (put! (mut e) "(import \"coil.control\" :as control)\n")
    (put! (mut e) "(import \"coil.slice\" :as slice)\n")
    ;; Declarations first, so a call can precede the definition it names.
    (store! i 0)
    (loop (if (>= (load i) count)
              (break)
              (let [o (al/al-get [(ptr nd/Obj)] globals (load i))]
                (cond
                  (nd/obj-function? o)
                    (if (and (not (hm/hm-contains? (load (field e defined)) (nd/obj-name o)))
                             (used? (mut e) o))
                        (emit-extern! (mut e) o)
                        0)
                  (= (ct/ty-kind (nd/obj-type o)) ct/TY-FUNC)
                    (if (and (not (hm/hm-contains? (load (field e defined)) (nd/obj-name o)))
                             (used? (mut e) o))
                        (emit-extern! (mut e) o)
                        0)
                  (hm/hm-contains? (load (field e defined-data)) (nd/obj-name o))
                    (emit-global! (mut e) o)
                  (used? (mut e) o)
                    (if (hm/hm-contains? (load (field e emitted)) (nd/obj-name o))
                        0
                        (do (hm/hm-put! [(slice u8) bool]
                                        (mut (field e emitted))
                                        (nd/obj-name o)
                                        true)
                            (emit-extern-global! (mut e) o)))
                  :else 0)
                (store! i (+ (load i) 1)))))
    (store! i 0)
    (loop (if (>= (load i) count)
              (break)
              (let [o (al/al-get [(ptr nd/Obj)] globals (load i))]
                (if (and (nd/obj-function? o) (nd/obj-definition? o))
                    (emit-function! (mut e) o)
                    0)
                (store! i (+ (load i) 1)))))
    ;; Everything with static storage is initialised once, in source order,
    ;; before the program's own `main` runs.
    (put! (mut e) "(defn c_init_statics [] (-> i64) (do")
    (store! i 0)
    (loop (if (>= (load i) count)
              (break)
              (let [o (al/al-get [(ptr nd/Obj)] globals (load i))]
                (if (and (nd/obj-string? o) (not (ascii-string? (nd/obj-string-data o))))
                    (emit-string-fill! (mut e) o)
                    0)
                (store! i (+ (load i) 1)))))
    (put! (mut e) " ")
    (emit-stmt! (mut e) init)
    (put! (mut e) " 0))\n")
    ;; Coil's entry point calls the program's.
    (put! (mut e) "(defn main [] (-> i32) (do (c_init_statics) (primitive/cast i32 (c_fn_main))))\n")
    (EmitResult :text (str/sb-str (load (mut (field e out))))
      :failed (load (field e failed))
      :message (load (field e message))
      :file (load (field e file))
      :line (load (field e line)))))
