(module experiments.c.type-test)

(import "experiments.c.type" :as ct)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "coil.assert" :use *)

(deftest array-and-pointer-precedence-is-structural
         (let [a (alloc/malloc-allocator)
               array-of-pointers (ct/parse-type a "int *[3]")
               pointer-to-array (ct/parse-type a "int (*)[3]")]
           (assert-eq (ct/type-kind array-of-pointers) ct/CTYPE-ARRAY)
           (assert-eq (ct/type-bound array-of-pointers) 3)
           (assert-eq (ct/type-kind (ct/type-child array-of-pointers)) ct/CTYPE-POINTER)
           (assert-eq (ct/type-kind pointer-to-array) ct/CTYPE-POINTER)
           (assert-eq (ct/type-kind (ct/type-child pointer-to-array)) ct/CTYPE-ARRAY)
           (assert-eq (ct/type-bound (ct/type-child pointer-to-array)) 3)
           (assert (not (ct/type-compatible? array-of-pointers pointer-to-array)))))

(deftest nested-function-pointer-array-retains-every-layer
         (let [a (alloc/malloc-allocator)
               value (ct/parse-type a "int (*[4])(double, char *)")
               pointer (ct/type-child value)
               function (ct/type-child pointer)
               parameters (ct/type-parameters function)]
           (assert-eq (ct/type-kind value) ct/CTYPE-ARRAY)
           (assert-eq (ct/type-bound value) 4)
           (assert-eq (ct/type-kind pointer) ct/CTYPE-POINTER)
           (assert-eq (ct/type-kind function) ct/CTYPE-FUNCTION)
           (assert-eq (ct/type-kind (ct/type-child function)) ct/CTYPE-SIGNED)
           (assert-eq (al/al-len parameters) 2)
           (assert-eq (ct/type-kind (al/al-get parameters 0)) ct/CTYPE-FLOAT)
           (assert-eq (ct/type-kind (al/al-get parameters 1)) ct/CTYPE-POINTER)))

(deftest function-prototypes-compare-parameters-recursively
         (let [a (alloc/malloc-allocator)
               left (ct/parse-type a "int (*)(double, char *)")
               same (ct/parse-type a "int (*)(double, char *)")
               different (ct/parse-type a "int (*)(float, char *)")]
           (assert (ct/type-compatible? left same))
           (assert (not (ct/type-compatible? left different)))))

(deftest incomplete-arrays-are-compatible-with-complete-arrays
         (let [a (alloc/malloc-allocator)
               incomplete (ct/parse-type a "unsigned char []")
               complete (ct/parse-type a "unsigned char [32]")
               other (ct/parse-type a "unsigned char [16]")]
           (assert (ct/type-compatible? incomplete complete))
           (assert (not (ct/type-compatible? complete other)))))
