(module experiments.c.ctype-test)

(import "experiments.c.ctype" :as ct)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "coil.assert" :use *)

(defn member-at [(t (ptr ct/Type)) (i i64)] (-> ct/Member)
  (al/al-get [ct/Member] (ct/ty-members t) i))

;; The case the Clang-based frontend gets wrong: it emits a union as its first
;; member, so this came out as 1 instead of 8.
(deftest a-union-is-as-large-as-its-largest-member
         (let [a (alloc/malloc-allocator)
               u (ct/ty-record a true)]
           (ct/add-member! u "small" (ct/ty-char a) -1)
           (ct/add-member! u "big" (ct/ty-double a) -1)
           (ct/layout-record! u)
           (assert-eq (ct/ty-size u) 8)
           (assert-eq (ct/ty-align u) 8)
           (assert-eq (ct/member-offset (member-at u 0)) 0)
           (assert-eq (ct/member-offset (member-at u 1)) 0)))

(deftest a-union-inside-a-struct-keeps-the-struct-honest
         (let [a (alloc/malloc-allocator)
               u (ct/ty-record a true)]
           (ct/add-member! u "c" (ct/ty-char a) -1)
           (ct/add-member! u "l" (ct/ty-long a) -1)
           (ct/layout-record! u)
           (let [s (ct/ty-record a false)]
             (ct/add-member! s "tag" (ct/ty-int a) -1)
             (ct/add-member! s "v" u -1)
             (ct/layout-record! s)
             ;; tag at 0, union aligned to 8, so 8 + 8.
             (assert-eq (ct/ty-size s) 16)
             (assert-eq (ct/member-offset (member-at s 1)) 8))))

(deftest members-are-aligned-and-the-struct-is-padded
         (let [a (alloc/malloc-allocator)
               s (ct/ty-record a false)]
           (ct/add-member! s "c" (ct/ty-char a) -1)
           (ct/add-member! s "i" (ct/ty-int a) -1)
           (ct/add-member! s "c2" (ct/ty-char a) -1)
           (ct/layout-record! s)
           (assert-eq (ct/member-offset (member-at s 0)) 0)
           (assert-eq (ct/member-offset (member-at s 1)) 4)
           (assert-eq (ct/member-offset (member-at s 2)) 8)
           (assert-eq (ct/ty-size s) 12)
           (assert-eq (ct/ty-align s) 4)))

;; The other case the Clang-based frontend gets wrong: it has no bitfield
;; handling at all, so each of these became a full int and the struct was 12.
(deftest bitfields-pack-into-one-storage-unit
         (let [a (alloc/malloc-allocator)
               s (ct/ty-record a false)]
           (ct/add-member! s "a" (ct/ty-uint a) 3)
           (ct/add-member! s "b" (ct/ty-uint a) 5)
           (ct/add-member! s "c" (ct/ty-uint a) 1)
           (ct/layout-record! s)
           (assert-eq (ct/ty-size s) 4)
           (assert-eq (ct/member-bit-offset (member-at s 0)) 0)
           (assert-eq (ct/member-bit-offset (member-at s 1)) 3)
           (assert-eq (ct/member-bit-offset (member-at s 2)) 8)
           (assert (ct/member-bitfield? (member-at s 0)))))

;; A bitfield may not straddle a storage unit, so the second one starts a new
;; int rather than spanning the boundary.
(deftest a-bitfield-does-not-straddle-a-storage-unit
         (let [a (alloc/malloc-allocator)
               s (ct/ty-record a false)]
           (ct/add-member! s "a" (ct/ty-uint a) 30)
           (ct/add-member! s "b" (ct/ty-uint a) 10)
           (ct/layout-record! s)
           (assert-eq (ct/member-offset (member-at s 0)) 0)
           (assert-eq (ct/member-offset (member-at s 1)) 4)
           (assert-eq (ct/member-bit-offset (member-at s 1)) 0)
           (assert-eq (ct/ty-size s) 8)))

(deftest a-zero-width-bitfield-closes-the-current-unit
         (let [a (alloc/malloc-allocator)
               s (ct/ty-record a false)]
           (ct/add-member! s "a" (ct/ty-uint a) 3)
           (ct/add-member! s "" (ct/ty-uint a) 0)
           (ct/add-member! s "b" (ct/ty-uint a) 3)
           (ct/layout-record! s)
           (assert-eq (ct/member-bit-offset (member-at s 0)) 0)
           (assert-eq (ct/member-offset (member-at s 2)) 4)
           (assert-eq (ct/ty-size s) 8)))

(deftest bitfields-mix-with-ordinary-members
         (let [a (alloc/malloc-allocator)
               s (ct/ty-record a false)]
           (ct/add-member! s "flag" (ct/ty-uint a) 1)
           (ct/add-member! s "value" (ct/ty-int a) -1)
           (ct/layout-record! s)
           (assert-eq (ct/member-offset (member-at s 0)) 0)
           (assert-eq (ct/member-offset (member-at s 1)) 4)
           (assert-eq (ct/ty-size s) 8)))

(deftest an-over-aligned-member-raises-the-record-alignment
         (let [a (alloc/malloc-allocator)
               s (ct/ty-record a false)]
           (ct/add-aligned-member! s "byte" (ct/ty-char a) -1 8)
           (ct/layout-record! s)
           (assert-eq (ct/ty-align s) 8)
           (assert-eq (ct/ty-size s) 8)))

(deftest arrays-and-pointers-have-the-expected-shape
         (let [a (alloc/malloc-allocator)
               arr (ct/ty-array-of a (ct/ty-int a) 5)
               ptr (ct/ty-pointer-to a (ct/ty-char a))
               incomplete (ct/ty-array-of a (ct/ty-int a) -1)]
           (assert-eq (ct/ty-size arr) 20)
           (assert-eq (ct/ty-align arr) 4)
           (assert-eq (ct/ty-size ptr) 8)
           (assert (ct/pointer-like? arr))
           (assert (ct/pointer-like? ptr))
           (assert (not (ct/ty-complete? incomplete)))))

(deftest an-array-of-structs-uses-the-padded-size
         (let [a (alloc/malloc-allocator)
               s (ct/ty-record a false)]
           (ct/add-member! s "c" (ct/ty-char a) -1)
           (ct/add-member! s "i" (ct/ty-int a) -1)
           (ct/layout-record! s)
           (assert-eq (ct/ty-size s) 8)
           (assert-eq (ct/ty-size (ct/ty-array-of a s 3)) 24)))

(deftest type-predicates-classify-correctly
         (let [a (alloc/malloc-allocator)]
           (assert (ct/integer? (ct/ty-int a)))
           (assert (ct/integer? (ct/ty-bool a)))
           (assert (ct/floating? (ct/ty-double a)))
           (assert (ct/numeric? (ct/ty-float a)))
           (assert (not (ct/numeric? (ct/ty-pointer-to a (ct/ty-int a)))))
           (assert (ct/ty-unsigned? (ct/ty-uint a)))
           (assert (not (ct/ty-unsigned? (ct/ty-int a))))))
