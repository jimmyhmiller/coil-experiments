;; C parser and semantic analysis. Ported from chibicc by Rui Ueyama (MIT) --

;; see ATTRIBUTION.md.
;;
;; Types are resolved and the conversions C performs implicitly are inserted
;; here, so what comes out is a typed tree rather than a parse tree.
(module experiments.c.parse)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "coil.hashmap" :as hm)
(import "coil.slice" :use *)
(import "coil.str" :as str)
(import "coil.result" :use *)
(import "experiments.c.lex" :as lex)
(import "experiments.c.ctype" :as ct)
(import "experiments.c.node" :as nd)

;;; Decimal-to-binary rounding is the platform's job; getting it wrong by a
;;; digit would silently change what a program computes.
(extern strtod :cc c [(ptr i8) (ptr (ptr i8))] (-> f64))

(export Parser
        ParseResult
        parse
        parser-new)

;;; A name in scope is exactly one of: an object, a typedef, or an enum
;;; constant.
(defstruct VarScope
  [(name (slice u8))
   (obj (ptr nd/Obj))
   (type-def (ptr ct/Type))
   (enum-value i64)
   (is-enum i64)])

(defstruct Scope
  [(vars (hm/HashMap (slice u8) VarScope))
   (tags (hm/HashMap (slice u8) (ptr ct/Type)))])

(defstruct Parser
  [(a (dyn alloc/Allocator))
   (tokens (al/ArrayList lex/Token))
   (pos i64)
   (scopes (al/ArrayList (ptr Scope)))
   (globals (al/ArrayList (ptr nd/Obj)))
   ;; Global and static initialisers are statements like any other, collected
   ;; here and run once before the program's own `main`.
   (init-block (ptr nd/Node))
   ;; The translation unit's tag, which makes its `static` names its own once
   ;; every unit has been emitted into one module.
   (unit (slice u8))
   ;; What the attributes around the declaration being parsed have asked for.
   (pending Attrs)
   ;; Active `#pragma pack` value and its push/pop stack. Zero means the
   ;; target's natural alignment rules.
   (pack i64)
   (pack-stack (al/ArrayList i64))
   (current-fn (ptr nd/Obj))
   (failed i64)
   (message (slice u8))
   (file (slice u8))
   (line i64)
   (column i64)])

(defstruct ParseResult
  [(globals (al/ArrayList (ptr nd/Obj)))
   (init (ptr nd/Node))
   (failed i64)
   (message (slice u8))
   (file (slice u8))
   (line i64)
   (column i64)])

(defn nil-node [] (-> (ptr nd/Node))
  (primitive/cast (ptr nd/Node) 0))

(defn nil-obj [] (-> (ptr nd/Obj))
  (primitive/cast (ptr nd/Obj) 0))

(defn nil-type [] (-> (ptr ct/Type))
  (primitive/cast (ptr ct/Type) 0))

(defn null-node? [(n (ptr nd/Node))] (-> bool)
  (= (primitive/cast i64 n) 0))

(defn null-type? [(t (ptr ct/Type))] (-> bool)
  (= (primitive/cast i64 t) 0))

(defn null-obj? [(o (ptr nd/Obj))] (-> bool)
  (= (primitive/cast i64 o) 0))

(defn text=? [(x (slice u8)) (y (slice u8))] (-> bool)
  (str/str-eq x y))

(defn consume-pack-markers! [(p (mut Parser))] (-> i64)
  (loop (let [name (lex/token-text (peek (mut p)))]
          (if (or (text=? name "__coil_pack_push")
                  (or (text=? name "__coil_pack_pop")
                      (or (text=? name "__coil_pack_set")
                          (text=? name "__coil_pack_reset"))))
              (do
                (advance! (mut p))
                (cond (text=? name "__coil_pack_push")
                        (do
                          (al/al-push! [i64] (mut (field p pack-stack)) (load (field p pack)))
                          (if (= (lex/token-kind (peek (mut p))) lex/TK-NUMBER)
                              (store! (field p pack) (parse-number-text (lex/token-text (advance! (mut p)))))
                              0))
                      (text=? name "__coil_pack_pop")
                        (let [n (al/al-len [i64] (load (field p pack-stack)))]
                          (if (> n 0)
                              (do
                                (store! (field p pack) (al/al-get [i64] (load (field p pack-stack)) (- n 1)))
                                (al/al-pop! [i64] (mut (field p pack-stack)))
                                0)
                              (store! (field p pack) 0)))
                      (text=? name "__coil_pack_set")
                        (if (= (lex/token-kind (peek (mut p))) lex/TK-NUMBER)
                            (store! (field p pack) (parse-number-text (lex/token-text (advance! (mut p)))))
                            0)
                      :else (store! (field p pack) 0))
                (expect! (mut p) ";"))
              (break))))
  0)

;; ------------------------------------------------------------ token access
(defn peek [(p (mut Parser))] (-> lex/Token)
  (let [n (al/al-len [lex/Token] (load (field p tokens)))
        i (load (field p pos))]
    (al/al-get [lex/Token] (load (field p tokens)) (if (>= i n) (- n 1) i))))

(defn peek-at [(p (mut Parser)) (offset i64)] (-> lex/Token)
  (let [n (al/al-len [lex/Token] (load (field p tokens)))
        i (+ (load (field p pos)) offset)]
    (al/al-get [lex/Token] (load (field p tokens)) (if (>= i n) (- n 1) (if (< i 0) 0 i)))))

(defn at-eof? [(p (mut Parser))] (-> bool)
  (= (lex/token-kind (peek (mut p))) lex/TK-EOF))

(defn advance! [(p (mut Parser))] (-> lex/Token)
  (let [t (peek (mut p))]
    (if (at-eof? (mut p)) 0 (store! (field p pos) (+ (load (field p pos)) 1)))
    t))

;;; The spelling of the offending token goes into the message: a bare "unexpected
;;; token" leaves nothing to search a header for.
(defn fail-at! [(p (mut Parser)) (message (slice u8)) (t lex/Token)] (-> i64)
  (if (!= (load (field p failed)) 0)
      0
      (let [(mut b) (str/sb-new (load (field p a)))]
        (str/sb-push-str! (mut b) message)
        (str/sb-push-str! (mut b) " near `")
        (str/sb-push-str! (mut b) (lex/token-text t))
        (str/sb-push-str! (mut b) "`")
        (store! (field p failed) 1)
        (store! (field p message) (str/sb-str (load (mut b))))
        (store! (field p file) (lex/token-file t))
        (store! (field p line) (lex/token-line t))
        (store! (field p column) (lex/token-column t))
        0)))

(defn fail! [(p (mut Parser)) (message (slice u8))] (-> i64)
  (fail-at! (mut p) message (peek (mut p))))

(defn punct? [(p (mut Parser)) (s (slice u8))] (-> bool)
  (let [t (peek (mut p))]
    (and (= (lex/token-kind t) lex/TK-PUNCT) (text=? (lex/token-text t) s))))

(defn word? [(p (mut Parser)) (s (slice u8))] (-> bool)
  (let [t (peek (mut p))]
    (and (or (= (lex/token-kind t) lex/TK-IDENT) (= (lex/token-kind t) lex/TK-KEYWORD))
         (text=? (lex/token-text t) s))))

(defn eat! [(p (mut Parser)) (s (slice u8))] (-> bool)
  (if (or (punct? (mut p) s) (word? (mut p) s))
      (do (advance! (mut p)) true)
      false))

(defn expect! [(p (mut Parser)) (s (slice u8))] (-> i64)
  (if (eat! (mut p) s)
      0
      (let [(mut b) (str/sb-new (load (field p a)))]
        (str/sb-push-str! (mut b) "expected `")
        (str/sb-push-str! (mut b) s)
        (str/sb-push-str! (mut b) "`")
        (fail! (mut p) (str/sb-str (load (mut b)))))))

;; -------------------------------------------------------------- scopes
(defn scope-new [(p (mut Parser))] (-> (ptr Scope))
  (alloc/box! (load (field p a))
              Scope
              (load (Scope :vars (hm/hm-new [(slice u8) VarScope] (load (field p a)) (str/str-keyops))
                      :tags (hm/hm-new [(slice u8) (ptr ct/Type)] (load (field p a)) (str/str-keyops))))))

(defn enter-scope! [(p (mut Parser))] (-> i64)
  (al/al-push! [(ptr Scope)] (mut (field p scopes)) (scope-new (mut p)))
  0)

(defn leave-scope! [(p (mut Parser))] (-> i64)
  (al/al-pop! [(ptr Scope)] (mut (field p scopes)))
  0)

(defn scope-depth [(p (mut Parser))] (-> i64)
  (al/al-len [(ptr Scope)] (load (field p scopes))))

(defn scope-at [(p (mut Parser)) (i i64)] (-> (ptr Scope))
  (al/al-get [(ptr Scope)] (load (field p scopes)) i))

(defn declare! [(p (mut Parser)) (name (slice u8)) (entry VarScope)] (-> i64)
  (let [top (scope-at (mut p) (- (scope-depth (mut p)) 1))]
    (hm/hm-put! [(slice u8) VarScope] (mut (field top vars)) name entry))
  0)

(defn declare-obj! [(p (mut Parser)) (o (ptr nd/Obj))] (-> i64)
  (declare! (mut p)
            (nd/obj-name o)
            (load (VarScope
                    :name (nd/obj-name o)
                    :obj o
                    :type-def (nil-type)
                    :enum-value 0
                    :is-enum 0))))

(defn declare-obj-as! [(p (mut Parser)) (name (slice u8)) (o (ptr nd/Obj))] (-> i64)
  (declare! (mut p)
            name
            (load (VarScope
                    :name name
                    :obj o
                    :type-def (nil-type)
                    :enum-value 0
                    :is-enum 0)))
  0)

(defn declare-typedef! [(p (mut Parser)) (name (slice u8)) (t (ptr ct/Type))] (-> i64)
  ;; A record declared with no tag takes the name of the typedef that names it.
  ;; `typedef struct { ... } sector_t;` is how most of C names a record, and
  ;; `sector_t` is what the program calls it.
  (if (and (!= (primitive/cast i64 t) 0)
           (and (ct/record? t) (= (slice-len (ct/ty-name t)) 0)))
      (ct/set-name! t name)
      0)
  (declare! (mut p)
            name
            (load (VarScope
                    :name name
                    :obj (nil-obj)
                    :type-def t
                    :enum-value 0
                    :is-enum 0))))

(defn declare-enum! [(p (mut Parser)) (name (slice u8)) (v i64)] (-> i64)
  (declare! (mut p)
            name
            (load (VarScope
                    :name name
                    :obj (nil-obj)
                    :type-def (nil-type)
                    :enum-value v
                    :is-enum 1))))

;;; Innermost scope wins, so the search runs outward.
(defn lookup [(p (mut Parser)) (name (slice u8))] (-> (Option VarScope))
  (let [(mut i) (- (scope-depth (mut p)) 1)
        (mut found) (None [VarScope])]
    (loop (if (or (< (load i) 0) (match (load found) (Some [_] true) (None [] false)))
              (break)
              (do
                (match (hm/hm-get (load (field (scope-at (mut p) (load i)) vars)) name)
                  (Some [e] (store! found (Some e)))
                  (None [] 0))
                (store! i (- (load i) 1)))))
    (load found)))

(defn declare-tag! [(p (mut Parser)) (name (slice u8)) (t (ptr ct/Type))] (-> i64)
  (let [top (scope-at (mut p) (- (scope-depth (mut p)) 1))]
    (hm/hm-put! [(slice u8) (ptr ct/Type)] (mut (field top tags)) name t))
  0)

(defn lookup-tag [(p (mut Parser)) (name (slice u8))] (-> (ptr ct/Type))
  (let [(mut i) (- (scope-depth (mut p)) 1)
        (mut found) (nil-type)]
    (loop (if (or (< (load i) 0) (not (null-type? (load found))))
              (break)
              (do
                (match (hm/hm-get (load (field (scope-at (mut p) (load i)) tags)) name)
                  (Some [t] (store! found t))
                  (None [] 0))
                (store! i (- (load i) 1)))))
    (load found)))

;; ------------------------------------------------------------ type helpers
(defn ty-int-of [(p (mut Parser))] (-> (ptr ct/Type))
  (ct/ty-int (load (field p a))))

(defn ty-long-of [(p (mut Parser))] (-> (ptr ct/Type))
  (ct/ty-long (load (field p a))))

(defn ty-ulong-of [(p (mut Parser))] (-> (ptr ct/Type))
  (ct/ty-ulong (load (field p a))))

(defn ty-char-of [(p (mut Parser))] (-> (ptr ct/Type))
  (ct/ty-char (load (field p a))))

(defn ty-void-of [(p (mut Parser))] (-> (ptr ct/Type))
  (ct/ty-void (load (field p a))))

(defn ty-double-of [(p (mut Parser))] (-> (ptr ct/Type))
  (ct/ty-double (load (field p a))))

;;; An array or a function used as a value becomes a pointer. C does this
;;; everywhere except as the operand of `sizeof` and `&`.
(defn decay [(p (mut Parser)) (n (ptr nd/Node))] (-> (ptr nd/Node))
  (add-type! (mut p) n)
  (let [t (nd/nd-type n)]
    (if (null-type? t)
        n
        (cond (= (ct/ty-kind t) ct/TY-ARRAY)
                (nd/node-cast (load (field p a)) n (ct/ty-pointer-to (load (field p a)) (ct/ty-base t)))
              (= (ct/ty-kind t) ct/TY-FUNC) (nd/node-cast (load (field p a)) n (ct/ty-pointer-to (load (field p a)) t))
              :else n))))

;;; The usual arithmetic conversions: everything narrower than int is promoted to
;;; int, then the wider of the two wins, with unsigned beating signed at equal
;;; width.
;;; The integer promotions: anything narrower than `int` is computed as an
;;; `int`. A shift and the unary operators promote their operand this way on its
;;; own, rather than against another operand as the binary operators do.
(defn integer-promote [(p (mut Parser)) (n (ptr nd/Node))] (-> (ptr nd/Node))
  (let [t (nd/nd-type n)]
    (if (and (not (null-type? t)) (and (ct/integer? t) (< (ct/ty-size t) 4)))
        (nd/node-cast (load (field p a)) n (ty-int-of (mut p)))
        n)))

(defn common-type [(p (mut Parser)) (x (ptr ct/Type)) (y (ptr ct/Type))] (-> (ptr ct/Type))
  (cond (null-type? x) (if (null-type? y) (ty-int-of (mut p)) y)
        (null-type? y) x
        (= (ct/ty-kind x) ct/TY-ARRAY) (ct/ty-pointer-to (load (field p a)) (ct/ty-base x))
        (or (= (ct/ty-kind x) ct/TY-DOUBLE) (= (ct/ty-kind y) ct/TY-DOUBLE)) (ty-double-of (mut p))
        (or (= (ct/ty-kind x) ct/TY-FLOAT) (= (ct/ty-kind y) ct/TY-FLOAT)) (ct/ty-float (load (field p a)))
        :else
          (let [sx (if (< (ct/ty-size x) 4) 4 (ct/ty-size x))
                sy (if (< (ct/ty-size y) 4) 4 (ct/ty-size y))
                size (if (> sx sy) sx sy)
                unsigned
                  (or (and (= sx size) (ct/ty-unsigned? x))
                      (and (= sy size) (ct/ty-unsigned? y)))]
            (if (= size 8)
                (if unsigned (ty-ulong-of (mut p)) (ty-long-of (mut p)))
                (if unsigned (ct/ty-uint (load (field p a))) (ty-int-of (mut p)))))))

;;; Rewrites both operands to their common type, which is what makes the
;;; conversion explicit in the tree rather than implied by the operator.
;;;
;;; Both operands are typed first. An operand whose type is still unknown looks
;;; to `common-type` like no constraint at all, and the other operand's type wins
;;; outright -- which is how `firstline * 56` came to be computed in the 16 bits
;;; `firstline` was declared with.
(defn usual-conversions [(p (mut Parser)) (n (ptr nd/Node))] (-> i64)
  (let [l (nd/nd-lhs n)
        r (nd/nd-rhs n)]
    (if (or (null-node? l) (null-node? r))
        0
        (do
          (add-type! (mut p) l)
          (add-type! (mut p) r)
          (let [t (common-type (mut p) (nd/nd-type l) (nd/nd-type r))]
            (nd/set-lhs! n (nd/node-cast (load (field p a)) l t))
            (nd/set-rhs! n (nd/node-cast (load (field p a)) r t))
            0)))))

;;; `p + n` advances by n elements, not n bytes, so the scaling is made explicit.
(defn new-add [(p (mut Parser)) (lhs (ptr nd/Node)) (rhs (ptr nd/Node)) (tok lex/Token)] (-> (ptr nd/Node))
  (add-type! (mut p) lhs)
  (add-type! (mut p) rhs)
  (let [a (load (field p a))
        l (decay (mut p) lhs)
        r (decay (mut p) rhs)
        lt (nd/nd-type l)
        rt (nd/nd-type r)]
    (cond (or (null-type? lt) (null-type? rt)) (do (fail-at! (mut p) "operand has no type" tok) l)
          (and (ct/numeric? lt) (ct/numeric? rt)) (let [n (nd/node-binary a nd/ND-ADD l r tok)] (add-type! (mut p) n) n)
          (and (ct/pointer-like? lt) (ct/numeric? rt))
            (let [scale
                    (nd/node-binary a
                                    nd/ND-MUL
                                    r
                                    (nd/node-num a (ct/ty-size (ct/ty-base lt)) tok)
                                    tok)
                  n (nd/node-binary a nd/ND-ADD l scale tok)]
              (add-type! (mut p) scale)
              (nd/set-type! n lt)
              n)
          (and (ct/numeric? lt) (ct/pointer-like? rt)) (new-add (mut p) rhs lhs tok)
          :else (do (fail-at! (mut p) "invalid operands to +" tok) l))))

(defn new-sub [(p (mut Parser)) (lhs (ptr nd/Node)) (rhs (ptr nd/Node)) (tok lex/Token)] (-> (ptr nd/Node))
  (add-type! (mut p) lhs)
  (add-type! (mut p) rhs)
  (let [a (load (field p a))
        l (decay (mut p) lhs)
        r (decay (mut p) rhs)
        lt (nd/nd-type l)
        rt (nd/nd-type r)]
    (cond (or (null-type? lt) (null-type? rt)) (do (fail-at! (mut p) "operand has no type" tok) l)
          (and (ct/numeric? lt) (ct/numeric? rt)) (let [n (nd/node-binary a nd/ND-SUB l r tok)] (add-type! (mut p) n) n)
          (and (ct/pointer-like? lt) (ct/numeric? rt))
            (let [scale
                    (nd/node-binary a
                                    nd/ND-MUL
                                    r
                                    (nd/node-num a (ct/ty-size (ct/ty-base lt)) tok)
                                    tok)
                  n (nd/node-binary a nd/ND-SUB l scale tok)]
              (add-type! (mut p) scale)
              (nd/set-type! n lt)
              n)
          ;; Pointer difference counts elements, so the byte difference is divided
          ;; by the element size.
          (and (ct/pointer-like? lt) (ct/pointer-like? rt))
            (let [diff (nd/node-binary a nd/ND-SUB l r tok)
                  n
                    (nd/node-binary a
                                    nd/ND-DIV
                                    diff
                                    (nd/node-num a (ct/ty-size (ct/ty-base lt)) tok)
                                    tok)]
              (nd/set-type! diff (ty-long-of (mut p)))
              (nd/set-type! n (ty-long-of (mut p)))
              n)
          :else (do (fail-at! (mut p) "invalid operands to -" tok) l))))

(defn add-type! [(p (mut Parser)) (n (ptr nd/Node))] (-> i64)
  (if (or (null-node? n) (not (null-type? (nd/nd-type n))))
      0
      (let [k (nd/nd-kind n)
            l (nd/nd-lhs n)
            r (nd/nd-rhs n)]
        (cond (= k nd/ND-NUM)
                (nd/set-type! n
                              (if (or (> (nd/nd-value n) 2147483647) (< (nd/nd-value n) -2147483648))
                                  (ty-long-of (mut p))
                                  (ty-int-of (mut p))))
              (= k nd/ND-VAR) (nd/set-type! n (nd/obj-type (nd/nd-obj n)))
              (or (= k nd/ND-ADD)
                  (or (= k nd/ND-SUB)
                      (or (= k nd/ND-MUL)
                          (or (= k nd/ND-DIV)
                              (or (= k nd/ND-MOD)
                                  (or (= k nd/ND-BITAND)
                                      (or (= k nd/ND-BITOR) (= k nd/ND-BITXOR))))))))
                (do (usual-conversions (mut p) n) (nd/set-type! n (nd/nd-type (nd/nd-lhs n))))
              (or (= k nd/ND-NEG) (= k nd/ND-BITNOT))
                (do
                  (nd/set-lhs! n (integer-promote (mut p) l))
                  (nd/set-type! n (nd/nd-type (nd/nd-lhs n))))
              ;; A shift's value has the type of its promoted left operand; the
              ;; count is converted to it too, because the operation it lowers to
              ;; takes one type.
              (or (= k nd/ND-SHL) (= k nd/ND-SHR))
                (do
                  (nd/set-lhs! n (integer-promote (mut p) l))
                  (nd/set-rhs! n (convert-to (mut p) r (nd/nd-type (nd/nd-lhs n))))
                  (nd/set-type! n (nd/nd-type (nd/nd-lhs n))))
              (or (= k nd/ND-EQ) (or (= k nd/ND-NE) (or (= k nd/ND-LT) (= k nd/ND-LE))))
                (do (usual-conversions (mut p) n) (nd/set-type! n (ty-int-of (mut p))))
              (or (= k nd/ND-LOGAND) (or (= k nd/ND-LOGOR) (= k nd/ND-NOT))) (nd/set-type! n (ty-int-of (mut p)))
              (= k nd/ND-ASSIGN) (nd/set-type! n (nd/nd-type l))
              (= k nd/ND-COMMA) (nd/set-type! n (nd/nd-type r))
              (= k nd/ND-ADDR) (nd/set-type! n (ct/ty-pointer-to (load (field p a)) (nd/nd-type l)))
              (= k nd/ND-DEREF)
                (let [lt (nd/nd-type l)]
                  (if (ct/pointer-like? lt)
                      (nd/set-type! n (ct/ty-base lt))
                      (fail-at! (mut p) "cannot dereference a non-pointer" (nd/nd-token n))))
              ;; Both arms of `?:` produce the one value the expression has, so they
              ;; are brought to a common type the way a binary operator's operands
              ;; are.
              (= k nd/ND-COND)
                (let [then (nd/nd-then n)
                      els (nd/nd-else n)]
                  (add-type! (mut p) then)
                  (add-type! (mut p) els)
                  (let [
                      yes (nd/nd-type then)
                      no (nd/nd-type els)]
                  (cond (and (not (null-type? yes))
                             (and (not (null-type? no))
                                  (and (ct/numeric? yes) (ct/numeric? no))))
                          (let [common (common-type (mut p) yes no)]
                            (nd/set-then! n (convert-to (mut p) then common))
                            (nd/set-else! n (convert-to (mut p) els common))
                            (nd/set-type! n common))
                        (and (ct/pointer-like? yes)
                             (and (ct/integer? no)
                                  (and (constant-node? els) (= (eval-const (mut p) els) 0))))
                          (do
                            (nd/set-else! n (convert-to (mut p) els yes))
                            (nd/set-type! n yes))
                        (and (ct/pointer-like? no)
                             (and (ct/integer? yes)
                                  (and (constant-node? then) (= (eval-const (mut p) then) 0))))
                          (do
                            (nd/set-then! n (convert-to (mut p) then no))
                            (nd/set-type! n no))
                        (and (ct/pointer-like? yes) (ct/pointer-like? no))
                          (let [common
                                  (cond (and (= (ct/ty-kind (ct/ty-base yes)) ct/TY-VOID)
                                             (and (constant-node? then)
                                                  (= (eval-const (mut p) then) 0)))
                                          no
                                        (and (= (ct/ty-kind (ct/ty-base no)) ct/TY-VOID)
                                             (and (constant-node? els)
                                                  (= (eval-const (mut p) els) 0)))
                                          yes
                                        (= (ct/ty-kind (ct/ty-base yes)) ct/TY-VOID) yes
                                        (= (ct/ty-kind (ct/ty-base no)) ct/TY-VOID) no
                                        :else yes)]
                            (nd/set-then! n (convert-to (mut p) then common))
                            (nd/set-else! n (convert-to (mut p) els common))
                            (nd/set-type! n common))
                        :else (nd/set-type! n yes))))
              :else 0))))

;; ------------------------------------------------------------- literals

;;; Decodes a string or character literal's escapes. The lexer deliberately kept
;;; the original spelling so that `#` could stringify it; this is where the
;;; actual bytes are worked out.
(defn decode-escapes [(p (mut Parser)) (text (slice u8)) (quote i64)] (-> (slice u8))
  (let [(mut b) (str/sb-new (load (field p a)))
        n (slice-len text)
        (mut i) 0]
    ;; Skip any encoding prefix and the opening quote.
    (loop (if (or (>= (load i) n)
                  (= (primitive/cast i64 (slice-get text (load i))) quote))
              (break)
              (store! i (+ (load i) 1))))
    (store! i (+ (load i) 1))
    (loop (if (>= (load i) n)
              (break)
              (let [c (primitive/cast i64 (slice-get text (load i)))]
                (cond (= c quote) (break)
                      (!= c 92)
                        (do
                          (str/sb-push-byte! (mut b) (primitive/cast u8 c))
                          (store! i (+ (load i) 1)))
                      :else
                        (let [k
                                (if (< (+ (load i) 1) n)
                                    (primitive/cast i64 (slice-get text (+ (load i) 1)))
                                    0)
                              v
                                (cond (= k 110) 10
                                      (= k 116) 9
                                      (= k 114) 13
                                      (= k 97) 7
                                      (= k 98) 8
                                      (= k 102) 12
                                      (= k 118) 11
                                      (= k 48) 0
                                      (= k 101) 27
                                      :else k)]
                          (str/sb-push-byte! (mut b) (primitive/cast u8 v))
                          (store! i (+ (load i) 2)))))))
    (str/sb-str (load (mut b)))))

;;; Whether a preprocessing number spells a floating constant. A hexadecimal
;;; one needs a point or a binary exponent; a decimal one a point or an exponent.
;;; Testing for `e` unconditionally would misread `0x1e5`.
(defn float-literal? [(text (slice u8))] (-> bool)
  (let [n (slice-len text)
        hex
          (and (>= n 2)
               (and (= (primitive/cast i64 (slice-get text 0)) 48)
                    (or (= (primitive/cast i64 (slice-get text 1)) 120)
                        (= (primitive/cast i64 (slice-get text 1)) 88))))
        (mut i) 0
        (mut found) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [c (primitive/cast i64 (slice-get text (load i)))]
                (if (or (= c 46)
                        (if hex
                            (or (= c 112) (= c 80))
                            (or (= c 101) (= c 69))))
                    (store! found 1)
                    0)
                (store! i (+ (load i) 1)))))
    (!= (load found) 0)))

;;; An `f` suffix makes a floating constant single precision; `l` would make it
;;; long double, which is double here.
(defn number-float-type [(p (mut Parser)) (text (slice u8))] (-> (ptr ct/Type))
  (let [n (slice-len text)
        last (if (= n 0) 0 (primitive/cast i64 (slice-get text (- n 1))))]
    (if (or (= last 102) (= last 70))
        (ct/ty-float (load (field p a)))
        (ty-double-of (mut p)))))

;;; `u` and `l` decide an integer constant's type; without them its magnitude
;;; does. Neither letter can appear in a hexadecimal digit, so scanning the whole
;;; spelling is safe.
(defn number-int-type [(p (mut Parser)) (text (slice u8)) (value i64)] (-> (ptr ct/Type))
  (let [n (slice-len text)
        (mut i) 0
        (mut unsigned) 0
        (mut longs) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [c (primitive/cast i64 (slice-get text (load i)))]
                (cond (or (= c 117) (= c 85)) (store! unsigned 1)
                      (or (= c 108) (= c 76)) (store! longs (+ (load longs) 1))
                      :else 0)
                (store! i (+ (load i) 1)))))
    (let [wide
            (or (> (load longs) 0)
                (if (!= (load unsigned) 0)
                    (> value 4294967295)
                    (or (> value 2147483647) (< value -2147483648))))]
      (if (!= (load unsigned) 0)
          (if wide (ty-ulong-of (mut p)) (ct/ty-uint (load (field p a))))
          (if wide (ty-long-of (mut p)) (ty-int-of (mut p)))))))

(defn parse-number-text [(text (slice u8))] (-> i64)
  (let [n (slice-len text)
        (mut i) 0
        (mut base) 10
        (mut value) 0]
    (if (and (>= n 2)
             (and (= (primitive/cast i64 (slice-get text 0)) 48)
                  (or (= (primitive/cast i64 (slice-get text 1)) 120)
                      (= (primitive/cast i64 (slice-get text 1)) 88))))
        (do (store! base 16) (store! i 2))
        (if (and (>= n 1) (= (primitive/cast i64 (slice-get text 0)) 48))
            (do (store! base 8) (store! i 1))
            0))
    (loop (if (>= (load i) n)
              (break)
              (let [c (primitive/cast i64 (slice-get text (load i)))
                    d
                      (cond (and (>= c 48) (<= c 57)) (- c 48)
                            (and (>= c 97) (<= c 102)) (+ (- c 97) 10)
                            (and (>= c 65) (<= c 70)) (+ (- c 65) 10)
                            :else -1)]
                (if (or (< d 0) (>= d (load base)))
                    (break)
                    (do
                      (store! value (+ (* (load value) (load base)) d))
                      (store! i (+ (load i) 1)))))))
    (load value)))

;;; A string literal becomes an anonymous global holding its bytes, which is what
;;; gives it an address and a lifetime. Literals written next to each other are
;;; one literal, which is how C lets a long message be split across lines.
;;; The bytes of a string literal, and of any literal written next to it: C joins
;;; adjacent literals into one, which is how a long message is split across lines
;;; and how the system headers build a symbol name out of pieces.
(defn read-string-bytes! [(p (mut Parser)) (tok lex/Token)] (-> (slice u8))
  (let [(mut text) (str/sb-new (load (field p a)))]
    (str/sb-push-str! (mut text) (decode-escapes (mut p) (lex/token-text tok) 34))
    (loop (if (!= (lex/token-kind (peek (mut p))) lex/TK-STRING)
              (break)
              (let [next (advance! (mut p))]
                (str/sb-push-str! (mut text) (decode-escapes (mut p) (lex/token-text next) 34))
                0)))
    (str/sb-str (load (mut text)))))

(defn string-literal [(p (mut Parser)) (tok lex/Token)] (-> (ptr nd/Node))
  (string-object (mut p) (read-string-bytes! (mut p) tok) tok))

(defn string-object [(p (mut Parser)) (bytes (slice u8)) (tok lex/Token)] (-> (ptr nd/Node))
  (let [ty (ct/ty-array-of (load (field p a)) (ty-char-of (mut p)) (+ (slice-len bytes) 1))
        (mut name) (str/sb-new (load (field p a)))]
    ;; The unit's tag is part of the name: two files' twelfth string literals
    ;; are two different objects, and the whole program is emitted as one
    ;; module.
    (str/sb-push-str! (mut name) ".Lstr.")
    (str/sb-push-i64! (mut name) (al/al-len [(ptr nd/Obj)] (load (field p globals))))
    (str/sb-push-str! (mut name) "$")
    (str/sb-push-str! (mut name) (load (field p unit)))
    (let [o (nd/obj-new (load (field p a)) (str/sb-str (load (mut name))) ty false)]
      (nd/set-obj-string! o bytes)
      (nd/set-obj-definition! o true)
      (al/al-push! [(ptr nd/Obj)] (mut (field p globals)) o)
      (nd/node-var (load (field p a)) o tok))))

;; ---------------------------------------------------------- expressions
(defn parse-expr [(p (mut Parser))] (-> (ptr nd/Node))
  (let [(mut n) (parse-assign (mut p))]
    (loop (if (punct? (mut p) ",")
              (let [tok (advance! (mut p))
                    r (parse-assign (mut p))
                    c (nd/node-binary (load (field p a)) nd/ND-COMMA (load n) r tok)]
                (add-type! (mut p) c)
                (store! n c))
              (break)))
    (load n)))

;;; `a op= b` is rewritten to `a = a op b`. Evaluating `a` twice is wrong when it
;;; has side effects, but the lowerer sees an assignment either way and this
;;; keeps the tree in one shape.
;;; `x op= y` with the right side already in hand. Prefix `++x` is this with a
;;; literal one, which is why the right side is a parameter rather than something
;;; read from the token stream.
;;; Stands for the target's current value inside the operation, so that the
;;; target expression itself appears once: `*p++ += 1` steps the pointer once.
(defn target-placeholder [(p (mut Parser)) (target (ptr nd/Node))] (-> (ptr nd/Node))
  (let [n (nd/node-new (load (field p a)) nd/ND-TARGET (nd/nd-token target))]
    (nd/set-type! n (nd/nd-type target))
    (nd/set-member-at! n
                       (nd/nd-member-offset target)
                       (nd/nd-member-bit-offset target)
                       (nd/nd-member-bit-width target))
    n))

(defn compound-assign-with [(p (mut Parser))
                            (lhs (ptr nd/Node))
                            (kind i64)
                            (rhs (ptr nd/Node))
                            (tok lex/Token)] (-> (ptr nd/Node))
  (let [a (load (field p a))
        current (target-placeholder (mut p) lhs)
        op
          (if (= kind nd/ND-ADD)
              (new-add (mut p) current rhs tok)
              (if (= kind nd/ND-SUB)
                  (new-sub (mut p) current rhs tok)
                  (let [b (nd/node-binary a kind current (decay (mut p) rhs) tok)]
                    (add-type! (mut p) b)
                    b)))
        ;; The operation happens in the common type of the two operands, and
        ;; the result is then converted back to what is being assigned to --
        ;; `int n; n += strlen(s);` computes in `size_t` and stores an `int`.
        n (nd/node-new a nd/ND-COMPOUND tok)]
    (nd/set-lhs! n lhs)
    (nd/set-rhs! n (convert-to (mut p) op (nd/nd-type lhs)))
    (nd/set-type! n (nd/nd-type lhs))
    n))

(defn compound-assign [(p (mut Parser)) (lhs (ptr nd/Node)) (kind i64) (tok lex/Token)] (-> (ptr nd/Node))
  (compound-assign-with (mut p) lhs kind (parse-assign (mut p)) tok))

(defn parse-assign [(p (mut Parser))] (-> (ptr nd/Node))
  (let [lhs (parse-conditional (mut p))
        t (peek (mut p))]
    (cond (punct? (mut p) "=")
            (let [tok (advance! (mut p))
                  rhs (decay (mut p) (parse-assign (mut p)))
                  n (nd/node-binary (load (field p a)) nd/ND-ASSIGN lhs rhs tok)]
              ;; The right side is converted to the left side's type, which is what
              ;; makes the conversion visible instead of implied.
              (if (null-type? (nd/nd-type lhs))
                  0
                  (nd/set-rhs! n (nd/node-cast (load (field p a)) rhs (nd/nd-type lhs))))
              (add-type! (mut p) n)
              n)
          (punct? (mut p) "+=") (compound-assign (mut p) lhs nd/ND-ADD (advance! (mut p)))
          (punct? (mut p) "-=") (compound-assign (mut p) lhs nd/ND-SUB (advance! (mut p)))
          (punct? (mut p) "*=") (compound-assign (mut p) lhs nd/ND-MUL (advance! (mut p)))
          (punct? (mut p) "/=") (compound-assign (mut p) lhs nd/ND-DIV (advance! (mut p)))
          (punct? (mut p) "%=") (compound-assign (mut p) lhs nd/ND-MOD (advance! (mut p)))
          (punct? (mut p) "&=") (compound-assign (mut p) lhs nd/ND-BITAND (advance! (mut p)))
          (punct? (mut p) "|=") (compound-assign (mut p) lhs nd/ND-BITOR (advance! (mut p)))
          (punct? (mut p) "^=") (compound-assign (mut p) lhs nd/ND-BITXOR (advance! (mut p)))
          (punct? (mut p) "<<=") (compound-assign (mut p) lhs nd/ND-SHL (advance! (mut p)))
          (punct? (mut p) ">>=") (compound-assign (mut p) lhs nd/ND-SHR (advance! (mut p)))
          :else lhs)))

(defn parse-conditional [(p (mut Parser))] (-> (ptr nd/Node))
  (let [c (parse-logor (mut p))]
    (if (not (punct? (mut p) "?"))
        c
        (let [tok (advance! (mut p))
              then (parse-expr (mut p))
              _ (expect! (mut p) ":")
              els (parse-conditional (mut p))
              n (nd/node-new (load (field p a)) nd/ND-COND tok)]
          (nd/set-test! n (decay (mut p) c))
          (nd/set-then! n (decay (mut p) then))
          (nd/set-else! n (decay (mut p) els))
          (add-type! (mut p) n)
          n))))

(defn binary-level [(p (mut Parser))
                    (next-level i64)
                    (n (ptr nd/Node))] (-> (ptr nd/Node))
  n)

(defn parse-logor [(p (mut Parser))] (-> (ptr nd/Node))
  (let [(mut n) (parse-logand (mut p))]
    (loop (if (punct? (mut p) "||")
              (let [tok (advance! (mut p))
                    r (parse-logand (mut p))
                    c (nd/node-binary (load (field p a)) nd/ND-LOGOR (load n) r tok)]
                (add-type! (mut p) c)
                (store! n c))
              (break)))
    (load n)))

(defn parse-logand [(p (mut Parser))] (-> (ptr nd/Node))
  (let [(mut n) (parse-bitor (mut p))]
    (loop (if (punct? (mut p) "&&")
              (let [tok (advance! (mut p))
                    r (parse-bitor (mut p))
                    c (nd/node-binary (load (field p a)) nd/ND-LOGAND (load n) r tok)]
                (add-type! (mut p) c)
                (store! n c))
              (break)))
    (load n)))

(defn parse-bitor [(p (mut Parser))] (-> (ptr nd/Node))
  (let [(mut n) (parse-bitxor (mut p))]
    (loop (if (and (punct? (mut p) "|") true)
              (let [tok (advance! (mut p))
                    r (parse-bitxor (mut p))
                    c (nd/node-binary (load (field p a)) nd/ND-BITOR (decay (mut p) (load n)) (decay (mut p) r) tok)]
                (add-type! (mut p) c)
                (store! n c))
              (break)))
    (load n)))

(defn parse-bitxor [(p (mut Parser))] (-> (ptr nd/Node))
  (let [(mut n) (parse-bitand (mut p))]
    (loop (if (punct? (mut p) "^")
              (let [tok (advance! (mut p))
                    r (parse-bitand (mut p))
                    c (nd/node-binary (load (field p a)) nd/ND-BITXOR (decay (mut p) (load n)) (decay (mut p) r) tok)]
                (add-type! (mut p) c)
                (store! n c))
              (break)))
    (load n)))

(defn parse-bitand [(p (mut Parser))] (-> (ptr nd/Node))
  (let [(mut n) (parse-equality (mut p))]
    (loop (if (punct? (mut p) "&")
              (let [tok (advance! (mut p))
                    r (parse-equality (mut p))
                    c (nd/node-binary (load (field p a)) nd/ND-BITAND (decay (mut p) (load n)) (decay (mut p) r) tok)]
                (add-type! (mut p) c)
                (store! n c))
              (break)))
    (load n)))

(defn parse-equality [(p (mut Parser))] (-> (ptr nd/Node))
  (let [(mut n) (parse-relational (mut p))]
    (loop (cond (punct? (mut p) "==")
                  (let [tok (advance! (mut p))
                        r (parse-relational (mut p))
                        c (nd/node-binary (load (field p a)) nd/ND-EQ (decay (mut p) (load n)) (decay (mut p) r) tok)]
                    (add-type! (mut p) c)
                    (store! n c))
                (punct? (mut p) "!=")
                  (let [tok (advance! (mut p))
                        r (parse-relational (mut p))
                        c (nd/node-binary (load (field p a)) nd/ND-NE (decay (mut p) (load n)) (decay (mut p) r) tok)]
                    (add-type! (mut p) c)
                    (store! n c))
                :else (break)))
    (load n)))

;;; `a > b` is `b < a`, so only two comparison node kinds are needed.
(defn parse-relational [(p (mut Parser))] (-> (ptr nd/Node))
  (let [(mut n) (parse-shift (mut p))]
    (loop (cond (punct? (mut p) "<")
                  (let [tok (advance! (mut p))
                        r (parse-shift (mut p))
                        c (nd/node-binary (load (field p a)) nd/ND-LT (decay (mut p) (load n)) (decay (mut p) r) tok)]
                    (add-type! (mut p) c)
                    (store! n c))
                (punct? (mut p) "<=")
                  (let [tok (advance! (mut p))
                        r (parse-shift (mut p))
                        c (nd/node-binary (load (field p a)) nd/ND-LE (decay (mut p) (load n)) (decay (mut p) r) tok)]
                    (add-type! (mut p) c)
                    (store! n c))
                (punct? (mut p) ">")
                  (let [tok (advance! (mut p))
                        r (parse-shift (mut p))
                        c (nd/node-binary (load (field p a)) nd/ND-LT (decay (mut p) r) (decay (mut p) (load n)) tok)]
                    (add-type! (mut p) c)
                    (store! n c))
                (punct? (mut p) ">=")
                  (let [tok (advance! (mut p))
                        r (parse-shift (mut p))
                        c (nd/node-binary (load (field p a)) nd/ND-LE (decay (mut p) r) (decay (mut p) (load n)) tok)]
                    (add-type! (mut p) c)
                    (store! n c))
                :else (break)))
    (load n)))

(defn parse-shift [(p (mut Parser))] (-> (ptr nd/Node))
  (let [(mut n) (parse-additive (mut p))]
    (loop (cond (punct? (mut p) "<<")
                  (let [tok (advance! (mut p))
                        r (parse-additive (mut p))
                        c (nd/node-binary (load (field p a)) nd/ND-SHL (decay (mut p) (load n)) (decay (mut p) r) tok)]
                    (add-type! (mut p) c)
                    (store! n c))
                (punct? (mut p) ">>")
                  (let [tok (advance! (mut p))
                        r (parse-additive (mut p))
                        c (nd/node-binary (load (field p a)) nd/ND-SHR (decay (mut p) (load n)) (decay (mut p) r) tok)]
                    (add-type! (mut p) c)
                    (store! n c))
                :else (break)))
    (load n)))

(defn parse-additive [(p (mut Parser))] (-> (ptr nd/Node))
  (let [(mut n) (parse-multiplicative (mut p))]
    (loop (cond (punct? (mut p) "+")
                  (let [tok (advance! (mut p))
                        r (parse-multiplicative (mut p))]
                    (store! n (new-add (mut p) (load n) r tok)))
                (punct? (mut p) "-")
                  (let [tok (advance! (mut p))
                        r (parse-multiplicative (mut p))]
                    (store! n (new-sub (mut p) (load n) r tok)))
                :else (break)))
    (load n)))

(defn parse-multiplicative [(p (mut Parser))] (-> (ptr nd/Node))
  (let [(mut n) (parse-cast (mut p))]
    (loop (cond (punct? (mut p) "*")
                  (let [tok (advance! (mut p))
                        r (parse-cast (mut p))
                        c (nd/node-binary (load (field p a)) nd/ND-MUL (decay (mut p) (load n)) (decay (mut p) r) tok)]
                    (add-type! (mut p) c)
                    (store! n c))
                (punct? (mut p) "/")
                  (let [tok (advance! (mut p))
                        r (parse-cast (mut p))
                        c (nd/node-binary (load (field p a)) nd/ND-DIV (decay (mut p) (load n)) (decay (mut p) r) tok)]
                    (add-type! (mut p) c)
                    (store! n c))
                (punct? (mut p) "%")
                  (let [tok (advance! (mut p))
                        r (parse-cast (mut p))
                        c (nd/node-binary (load (field p a)) nd/ND-MOD (decay (mut p) (load n)) (decay (mut p) r) tok)]
                    (add-type! (mut p) c)
                    (store! n c))
                :else (break)))
    (load n)))

;; ---------------------------------------------------------- declarations
(defstruct DeclSpec
  [(ty (ptr ct/Type))
   (is-typedef i64)
   (is-static i64)
   (is-extern i64)
   (alignas i64)])

(defn typedef-type [(p (mut Parser)) (name (slice u8))] (-> (ptr ct/Type))
  (match (lookup (mut p) name)
    (Some [found] (let [e found] (.type-def e)))
    (None [] (nil-type))))

(defn type-keyword? [(w (slice u8))] (-> bool)
  (cond (text=? w "void") true
        (text=? w "_Bool") true
        (text=? w "char") true
        (text=? w "short") true
        (text=? w "int") true
        (text=? w "long") true
        (text=? w "float") true
        (text=? w "double") true
        (text=? w "signed") true
        (text=? w "unsigned") true
        (text=? w "struct") true
        (text=? w "union") true
        (text=? w "enum") true
        (text=? w "const") true
        (text=? w "volatile") true
        (text=? w "static") true
        (text=? w "extern") true
        (text=? w "typedef") true
        (text=? w "register") true
        (text=? w "restrict") true
        (text=? w "__restrict") true
        (text=? w "__restrict__") true
        (text=? w "inline") true
        (text=? w "__inline") true
        (text=? w "_Noreturn") true
        (text=? w "_Atomic") true
        (text=? w "auto") true
        (text=? w "_Thread_local") true
        (text=? w "__signed__") true
        (text=? w "__inline__") true
        (text=? w "__forceinline") true
        (text=? w "__const") true
        (text=? w "__const__") true
        (text=? w "__volatile") true
        (text=? w "__volatile__") true
        (text=? w "__builtin_va_list") true
        (text=? w "_Complex") true
        (text=? w "__int128_t") true
        (text=? w "__uint128_t") true
        (text=? w "__int128") true
        (text=? w "_Float16") true
        (text=? w "_Alignas") true
        :else false))

;;; A name only starts a type if it is a type keyword or a typedef that is
;;; actually in scope, which is the whole reason the parser has to carry a scope
;;; at all. Whether the lexer classified the word as a keyword does not matter:
;;; the reserved spellings a compiler adds, `__builtin_va_list` among them, are
;;; ordinary identifiers to it.
(defn type-start? [(p (mut Parser))] (-> bool)
  (let [t (peek (mut p))
        k (lex/token-kind t)]
    (if (or (= k lex/TK-KEYWORD) (= k lex/TK-IDENT))
        (or (type-keyword? (lex/token-text t))
            (not (null-type? (typedef-type (mut p) (lex/token-text t)))))
        false)))

;;; A GNU attribute, a Microsoft one, and the nullability qualifiers may appear
;;; almost anywhere a declaration may, and none of them changes the program this
;;; compiler generates. They are consumed wherever a declaration can start or
;;; end, rather than being rejected as stray tokens.
(defn attribute-start? [(p (mut Parser))] (-> bool)
  (cond (word? (mut p) "__attribute__") true
        (word? (mut p) "__attribute") true
        (word? (mut p) "__declspec") true
        (word? (mut p) "_Nullable") true
        (word? (mut p) "_Nonnull") true
        (word? (mut p) "_Null_unspecified") true
        (word? (mut p) "__nullable") true
        (word? (mut p) "__nonnull") true
        (word? (mut p) "__null_unspecified") true
        (word? (mut p) "__unsafe_unretained") true
        (word? (mut p) "__kindof") true
        (word? (mut p) "__extension__") true
        :else false))

;;; The two attributes that change what the program means. Everything else an
;;; attribute list can say is advisory here and is consumed without effect.
(defstruct Attrs
  [(packed i64)
   (aligned i64)
   ;; nd/AT-NONE, nd/AT-CONSTRUCTOR, or nd/AT-DESTRUCTOR, with the order the
   ;; attribute asked for.
   (at-start i64)
   (at-start-priority i64)])

(defn no-attrs [] (-> Attrs)
  (load (Attrs
          :packed 0
          :aligned 0
          :at-start nd/AT-NONE
          :at-start-priority nd/DEFAULT-PRIORITY)))

;;; Reads the contents of one `__attribute__((...))` list, which is a
;;; comma-separated sequence of names, each optionally with its own argument
;;; list. Only `packed` and `aligned(n)` are acted on.
;;; `constructor(101)` asks for an order; `constructor` leaves it at the default.
(defn read-priority! [(p (mut Parser)) (out (mut Attrs))] (-> i64)
  (if (punct? (mut p) "(")
      (do
        (advance! (mut p))
        (store! (field out at-start-priority) (parse-const-expr (mut p)))
        (expect! (mut p) ")"))
      0)
  0)

(defn read-attribute-list! [(p (mut Parser)) (out (mut Attrs))] (-> i64)
  (expect! (mut p) "(")
  (expect! (mut p) "(")
  (let [(mut depth) 2]
    (loop (if (or (= (load depth) 0) (or (at-eof? (mut p)) (!= (load (field p failed)) 0)))
              (break)
              (cond (punct? (mut p) "(") (do (store! depth (+ (load depth) 1)) (advance! (mut p)) 0)
                    (punct? (mut p) ")") (do (store! depth (- (load depth) 1)) (advance! (mut p)) 0)
                    (and (= (load depth) 2)
                         (or (word? (mut p) "packed") (word? (mut p) "__packed__")))
                      (do (advance! (mut p)) (store! (field out packed) 1) 0)
                    (and (= (load depth) 2)
                         (or (word? (mut p) "aligned") (word? (mut p) "__aligned__")))
                      (do
                        (advance! (mut p))
                        (if (punct? (mut p) "(")
                            (do
                              (advance! (mut p))
                              (store! (field out aligned) (parse-const-expr (mut p)))
                              (expect! (mut p) ")"))
                            0)
                        0)
                    (and (= (load depth) 2)
                         (or (word? (mut p) "constructor") (word? (mut p) "__constructor__")))
                      (do
                        (advance! (mut p))
                        (store! (field out at-start) nd/AT-CONSTRUCTOR)
                        (read-priority! (mut p) (mut out))
                        0)
                    (and (= (load depth) 2)
                         (or (word? (mut p) "destructor") (word? (mut p) "__destructor__")))
                      (do
                        (advance! (mut p))
                        (store! (field out at-start) nd/AT-DESTRUCTOR)
                        (read-priority! (mut p) (mut out))
                        0)
                    :else (do (advance! (mut p)) 0)))))
  0)

;;; Consumes every attribute at this position, returning what the ones that
;;; matter said.
(defn parse-attributes! [(p (mut Parser))] (-> Attrs)
  (let [(mut out) (no-attrs)]
    (loop (if (not (attribute-start? (mut p)))
              (break)
              (if (or (word? (mut p) "__attribute__") (word? (mut p) "__attribute"))
                  (do (advance! (mut p)) (read-attribute-list! (mut p) (mut out)) 0)
                  (do (advance! (mut p)) (skip-balanced! (mut p)) 0))))
    (load (mut out))))

;;; Consumes a parenthesised group with its nesting, from the `(` to its `)`.
(defn skip-balanced! [(p (mut Parser))] (-> i64)
  (if (not (punct? (mut p) "("))
      0
      (let [(mut depth) 0
            (mut done) 0]
        (loop (if (or (!= (load done) 0) (or (at-eof? (mut p)) (!= (load (field p failed)) 0)))
                  (break)
                  (do
                    (if (punct? (mut p) "(") (store! depth (+ (load depth) 1)) 0)
                    (if (punct? (mut p) ")")
                        (do
                          (store! depth (- (load depth) 1))
                          (if (= (load depth) 0) (store! done 1) 0))
                        0)
                    (advance! (mut p)))))
        0)))

;;; An attribute may stand before a declaration's type, between it and the name,
;;; or after the declarator, and all of those belong to the one declaration. Every
;;; place that consumes attributes therefore records what it found, and the
;;; function or object they describe reads it when the declarator is complete.
(defn note-attributes! [(p (mut Parser)) (found Attrs)] (-> i64)
  (if (!= (.at-start found) nd/AT-NONE)
      (do
        (store! (field (field p pending) at-start) (.at-start found))
        (store! (field (field p pending) at-start-priority) (.at-start-priority found))
        0)
      0))

(defn forget-attributes! [(p (mut Parser))] (-> i64)
  (store! (field p pending) (no-attrs))
  0)

(defn skip-attributes! [(p (mut Parser))] (-> i64)
  (note-attributes! (mut p) (parse-attributes! (mut p)))
  0)

(defn parse-const-expr [(p (mut Parser))] (-> i64)
  (let [n (parse-conditional (mut p))]
    (eval-const (mut p) n)))

(defn constant-node? [(n (ptr nd/Node))] (-> bool)
  (if (null-node? n)
      false
      (let [k (nd/nd-kind n)]
        (cond (= k nd/ND-NUM) true
              (or (= k nd/ND-CAST) (or (= k nd/ND-NEG) (or (= k nd/ND-BITNOT) (= k nd/ND-NOT))))
                (constant-node? (nd/nd-lhs n))
              (= k nd/ND-COND)
                (and (constant-node? (nd/nd-test n))
                     (and (constant-node? (nd/nd-then n)) (constant-node? (nd/nd-else n))))
              (or (= k nd/ND-ADD)
                  (or (= k nd/ND-SUB)
                      (or (= k nd/ND-MUL)
                          (or (= k nd/ND-DIV)
                              (or (= k nd/ND-MOD)
                                  (or (= k nd/ND-BITAND)
                                      (or (= k nd/ND-BITOR)
                                          (or (= k nd/ND-BITXOR)
                                              (or (= k nd/ND-SHL)
                                                  (or (= k nd/ND-SHR)
                                                      (or (= k nd/ND-EQ)
                                                          (or (= k nd/ND-NE)
                                                              (or (= k nd/ND-LT)
                                                                  (or (= k nd/ND-LE)
                                                                      (or (= k nd/ND-LOGAND)
                                                                          (= k nd/ND-LOGOR))))))))))))))))
                (and (constant-node? (nd/nd-lhs n)) (constant-node? (nd/nd-rhs n)))
              :else false))))

;;; Folds the constant expressions C requires to be folded: array bounds, enum
;;; values, case labels, and bitfield widths.
(defn eval-const [(p (mut Parser)) (n (ptr nd/Node))] (-> i64)
  (if (null-node? n)
      0
      (let [k (nd/nd-kind n)
            l (nd/nd-lhs n)
            r (nd/nd-rhs n)]
        (cond (= k nd/ND-NUM) (nd/nd-value n)
              (= k nd/ND-CAST) (eval-const (mut p) l)
              (= k nd/ND-ADD) (+ (eval-const (mut p) l) (eval-const (mut p) r))
              (= k nd/ND-SUB) (- (eval-const (mut p) l) (eval-const (mut p) r))
              (= k nd/ND-MUL) (* (eval-const (mut p) l) (eval-const (mut p) r))
              (= k nd/ND-DIV)
                (let [d (eval-const (mut p) r)]
                  (if (= d 0) 0 (primitive/idiv (eval-const (mut p) l) d)))
              (= k nd/ND-MOD)
                (let [d (eval-const (mut p) r)]
                  (if (= d 0) 0 (primitive/irem (eval-const (mut p) l) d)))
              (= k nd/ND-NEG) (- 0 (eval-const (mut p) l))
              (= k nd/ND-BITNOT) (primitive/inot (eval-const (mut p) l))
              (= k nd/ND-NOT) (if (= (eval-const (mut p) l) 0) 1 0)
              (= k nd/ND-BITAND) (primitive/iand (eval-const (mut p) l) (eval-const (mut p) r))
              (= k nd/ND-BITOR) (primitive/ior (eval-const (mut p) l) (eval-const (mut p) r))
              (= k nd/ND-BITXOR) (primitive/ixor (eval-const (mut p) l) (eval-const (mut p) r))
              (= k nd/ND-SHL) (primitive/ishl (eval-const (mut p) l) (eval-const (mut p) r))
              (= k nd/ND-SHR) (primitive/ishr (eval-const (mut p) l) (eval-const (mut p) r))
              (= k nd/ND-EQ) (if (= (eval-const (mut p) l) (eval-const (mut p) r)) 1 0)
              (= k nd/ND-NE) (if (!= (eval-const (mut p) l) (eval-const (mut p) r)) 1 0)
              (= k nd/ND-LT) (if (< (eval-const (mut p) l) (eval-const (mut p) r)) 1 0)
              (= k nd/ND-LE) (if (<= (eval-const (mut p) l) (eval-const (mut p) r)) 1 0)
              (= k nd/ND-LOGAND) (if (and (!= (eval-const (mut p) l) 0) (!= (eval-const (mut p) r) 0)) 1 0)
              (= k nd/ND-LOGOR) (if (or (!= (eval-const (mut p) l) 0) (!= (eval-const (mut p) r) 0)) 1 0)
              (= k nd/ND-COND)
                (if (!= (eval-const (mut p) (nd/nd-test n)) 0)
                    (eval-const (mut p) (nd/nd-then n))
                    (eval-const (mut p) (nd/nd-else n)))
              :else (do (fail-at! (mut p) "not a constant expression" (nd/nd-token n)) 0)))))

;;; A base type is built from however many specifier keywords appear, in any
;;; order, so they are counted rather than matched in sequence.
;;; The words that qualify a declaration without contributing to its type. The
;;; doubled-underscore spellings exist so that a header can use them without
;;; colliding with a program's own names, and mean exactly what the plain ones
;;; mean.
(defn qualifier-word? [(p (mut Parser))] (-> bool)
  (cond (word? (mut p) "const") true
        (word? (mut p) "volatile") true
        (word? (mut p) "register") true
        (word? (mut p) "restrict") true
        (word? (mut p) "__restrict") true
        (word? (mut p) "__restrict__") true
        (word? (mut p) "inline") true
        (word? (mut p) "__inline") true
        (word? (mut p) "__inline__") true
        (word? (mut p) "__forceinline") true
        (word? (mut p) "__const") true
        (word? (mut p) "__const__") true
        (word? (mut p) "__volatile") true
        (word? (mut p) "__volatile__") true
        (word? (mut p) "_Noreturn") true
        (word? (mut p) "auto") true
        (word? (mut p) "_Thread_local") true
        :else false))

(defn parse-declspec [(p (mut Parser))] (-> DeclSpec)
  (let [a (load (field p a))
        (mut ty) (nil-type)
        (mut signed) 0
        (mut unsigned) 0
        (mut longs) 0
        (mut shorts) 0
        (mut ints) 0
        (mut chars) 0
        (mut voids) 0
        (mut bools) 0
        (mut floats) 0
        (mut doubles) 0
        (mut is-typedef) 0
        (mut is-static) 0
        (mut is-extern) 0
        (mut requested-align) 0
        (mut done) 0]
    (loop (if (!= (load done) 0)
              (break)
              (let [t (peek (mut p))
                    w (lex/token-text t)]
                (cond (attribute-start? (mut p)) (skip-attributes! (mut p))
                      (not (type-start? (mut p))) (store! done 1)
                      (word? (mut p) "typedef") (do (advance! (mut p)) (store! is-typedef 1))
                      (word? (mut p) "static") (do (advance! (mut p)) (store! is-static 1))
                      (word? (mut p) "extern") (do (advance! (mut p)) (store! is-extern 1))
                      (and (word? (mut p) "_Atomic")
                           (text=? (lex/token-text (peek-at (mut p) 1)) "("))
                        (do
                          (advance! (mut p))
                          (expect! (mut p) "(")
                          (store! ty (parse-typename (mut p)))
                          (expect! (mut p) ")"))
                      (qualifier-word? (mut p)) (do (advance! (mut p)) 0)
                      (word? (mut p) "_Alignas")
                        (do
                          (advance! (mut p))
                          (expect! (mut p) "(")
                          (store! requested-align (parse-const-expr (mut p)))
                          (expect! (mut p) ")"))
                      ;; On this target a `va_list` is a plain `char *`; the calling
                      ;; convention puts the variadic arguments in a contiguous area and
                      ;; the pointer walks it.
                      (word? (mut p) "__builtin_va_list")
                        (do
                          (advance! (mut p))
                          (store! ty (ct/ty-pointer-to a (ct/ty-char a))))
                      (word? (mut p) "_Complex") (do (advance! (mut p)) 0)
                      (word? (mut p) "_Float16") (do (advance! (mut p)) (store! ty (ct/ty-float16 a)))
                      (or (word? (mut p) "__int128_t") (word? (mut p) "__int128"))
                        (do
                          (advance! (mut p))
                          (store! ty (ct/ty-int128 a (!= (load unsigned) 0))))
                      (word? (mut p) "__uint128_t") (do (advance! (mut p)) (store! ty (ct/ty-int128 a true)))
                      (word? (mut p) "void") (do (advance! (mut p)) (store! voids (+ (load voids) 1)))
                      (word? (mut p) "_Bool") (do (advance! (mut p)) (store! bools (+ (load bools) 1)))
                      (word? (mut p) "char") (do (advance! (mut p)) (store! chars (+ (load chars) 1)))
                      (word? (mut p) "short") (do (advance! (mut p)) (store! shorts (+ (load shorts) 1)))
                      (word? (mut p) "int") (do (advance! (mut p)) (store! ints (+ (load ints) 1)))
                      (word? (mut p) "long") (do (advance! (mut p)) (store! longs (+ (load longs) 1)))
                      (word? (mut p) "float") (do (advance! (mut p)) (store! floats (+ (load floats) 1)))
                      (word? (mut p) "double") (do (advance! (mut p)) (store! doubles (+ (load doubles) 1)))
                      (or (word? (mut p) "signed") (word? (mut p) "__signed__"))
                        (do (advance! (mut p)) (store! signed 1))
                      (word? (mut p) "unsigned") (do (advance! (mut p)) (store! unsigned 1))
                      (or (word? (mut p) "struct") (word? (mut p) "union"))
                        (store! ty (parse-record (mut p) (word? (mut p) "union")))
                      (word? (mut p) "enum") (store! ty (parse-enum (mut p)))
                      :else
                      ;; A typedef name supplies one base type. Once a base type has
                      ;; already been supplied, the same spelling starts the
                      ;; declarator instead. This is what makes
                      ;; `typedef T sample; U sample;` redeclare `sample` as an
                      ;; object in the inner scope instead of treating it as a
                      ;; second type specifier.
                      (let [named (typedef-type (mut p) (lex/token-text t))]
                        (if (or (null-type? named)
                                (or (not (null-type? (load ty)))
                                    (or (!= (load signed) 0)
                                        (or (!= (load unsigned) 0)
                                            (or (> (load longs) 0)
                                                (or (> (load shorts) 0)
                                                    (or (> (load ints) 0)
                                                        (or (> (load chars) 0)
                                                            (or (> (load voids) 0)
                                                                (or (> (load bools) 0)
                                                                    (or (> (load floats) 0)
                                                                        (> (load doubles) 0))))))))))))
                            (store! done 1)
                            (do (advance! (mut p)) (store! ty named))))))))
    (if (null-type? (load ty))
        (store! ty
                (cond (> (load voids) 0) (ct/ty-void a)
                      (> (load bools) 0) (ct/ty-bool a)
                      (> (load floats) 0) (ct/ty-float a)
                      (> (load doubles) 0) (ct/ty-double a)
                      (> (load chars) 0) (if (!= (load unsigned) 0) (ct/ty-uchar a) (ct/ty-char a))
                      (> (load shorts) 0) (if (!= (load unsigned) 0) (ct/ty-ushort a) (ct/ty-short a))
                      (> (load longs) 0) (if (!= (load unsigned) 0) (ct/ty-ulong a) (ct/ty-long a))
                      :else (if (!= (load unsigned) 0) (ct/ty-uint a) (ct/ty-int a))))
        0)
    (load (DeclSpec
            :ty (load ty)
            :is-typedef (load is-typedef)
            :is-static (load is-static)
            :is-extern (load is-extern)
            :alignas (load requested-align)))))

(defn validate-decl-align! [(p (mut Parser)) (spec DeclSpec) (ty (ptr ct/Type))] (-> i64)
  ;; Alignment applies to the completed declarator (`_Alignas(8) T *p` aligns
  ;; the pointer, not T), so validation belongs after pointer/array suffixes.
  (if (and (> (.alignas spec) 0) (> (.alignas spec) (ct/ty-align ty)))
      (fail! (mut p) "over-aligned objects are unsupported")
      0))

(defn skip-qualifiers! [(p (mut Parser))] (-> i64)
  (loop (do
          (skip-attributes! (mut p))
          (if (or (qualifier-word? (mut p)) (word? (mut p) "_Atomic"))
              (do (advance! (mut p)) 0)
              (break))))
  0)

(defn parse-pointers [(p (mut Parser)) (base (ptr ct/Type))] (-> (ptr ct/Type))
  (let [(mut t) base]
    (loop (if (or (punct? (mut p) "*") (punct? (mut p) "^"))
              (do
                (advance! (mut p))
                (store! t (ct/ty-pointer-to (load (field p a)) (load t)))
                (skip-qualifiers! (mut p)))
              (break)))
    (load t)))

;;; `[3][4]` is an array of 3 arrays of 4, so the suffixes are applied from the
;;; inside out -- the recursion does that naturally.
(defn parse-type-suffix [(p (mut Parser)) (base (ptr ct/Type))] (-> (ptr ct/Type))
  (cond (punct? (mut p) "(")
          (do
            (advance! (mut p))
            (let [f (ct/ty-func-of (load (field p a)) base)]
              (parse-params! (mut p) f)
              f))
        (punct? (mut p) "[")
          (do
            (advance! (mut p))
            (skip-qualifiers! (mut p))
            (if (punct? (mut p) "]")
                (do
                  (advance! (mut p))
                  (ct/ty-array-of (load (field p a)) (parse-type-suffix (mut p) base) -1))
                (let [len (parse-const-expr (mut p))]
                  (expect! (mut p) "]")
                  (ct/ty-array-of (load (field p a)) (parse-type-suffix (mut p) base) len))))
        :else base))

(defn parse-params! [(p (mut Parser)) (f (ptr ct/Type))] (-> i64)
  (if (punct? (mut p) ")")
      ;; `f()` promises nothing about the arguments; only `f(void)` says there
      ;; are none.
      (do (advance! (mut p)) 0)
      (if (and (word? (mut p) "void") (is-punct-at? (mut p) 1 ")"))
          (do (advance! (mut p)) (advance! (mut p)) (ct/set-prototyped! f) 0)
          (let [(mut go) 1]
            (loop (if (= (load go) 0)
                      (break)
                      (if (punct? (mut p) "...")
                          (do (advance! (mut p)) (ct/set-variadic! f true) (store! go 0))
                          (let [spec (parse-declspec (mut p))
                                d (parse-declarator (mut p) (.ty spec))]
                            (validate-decl-align! (mut p) spec (.ty d))
                            (ct/set-prototyped! f)
                            ;; A parameter declared as an array or a function is a
                            ;; pointer, and is one here too: the caller passes an
                            ;; address and the body reads one.
                            (ct/add-param! f (.name d) (param-target-type (mut p) (.ty d)))
                            (if (punct? (mut p) ",") (do (advance! (mut p)) 0) (store! go 0))))))
            (expect! (mut p) ")")
            0))))

(defn is-punct-at? [(p (mut Parser)) (offset i64) (s (slice u8))] (-> bool)
  (let [t (peek-at (mut p) offset)]
    (and (= (lex/token-kind t) lex/TK-PUNCT) (text=? (lex/token-text t) s))))

;;; `asm-name` is the symbol a declaration is really called, from
;;; `__asm("_name")`. Ignoring it would emit a call to a name the linker does not
;;; have.
(defstruct Declared
  [(name (slice u8))
   (ty (ptr ct/Type))
   (asm-name (slice u8))
   (tok lex/Token)])

;;; Skips a balanced parenthesised group, used to reach the type suffix before
;;; re-parsing the group against it.
(defn skip-group! [(p (mut Parser))] (-> i64)
  (let [(mut depth) 0
        (mut go) 1]
    (loop (if (or (= (load go) 0) (at-eof? (mut p)))
              (break)
              (do
                (if (punct? (mut p) "(") (store! depth (+ (load depth) 1)) 0)
                (if (punct? (mut p) ")")
                    (do
                      (store! depth (- (load depth) 1))
                      (if (= (load depth) 0) (store! go 0) 0))
                    0)
                (advance! (mut p)))))
    0))

;;; `__asm("_name")` after a declarator renames the symbol. The spelling is a
;;; string literal whose quotes and any leading underscore the assembler adds are
;;; stripped here, so what comes out is the name as C would have written it.
(defn parse-asm-name! [(p (mut Parser))] (-> (slice u8))
  (skip-attributes! (mut p))
  (if (not (or (word? (mut p) "__asm") (or (word? (mut p) "__asm__") (word? (mut p) "asm"))))
      ""
      (do
        (advance! (mut p))
        (if (not (punct? (mut p) "("))
            ""
            (do
              (advance! (mut p))
              (let [t (peek (mut p))]
                (if (!= (lex/token-kind t) lex/TK-STRING)
                    (do (skip-to-close! (mut p)) "")
                    (let [text (read-string-bytes! (mut p) (advance! (mut p)))]
                      (skip-to-close! (mut p))
                      (if (and (> (slice-len text) 1)
                               (= (primitive/cast i64 (slice-get text 0)) 95))
                          (subslice text 1 (slice-len text))
                          text)))))))))

;;; Consumes the rest of a group whose `(` has already been taken.
(defn skip-to-close! [(p (mut Parser))] (-> i64)
  (let [(mut depth) 1]
    (loop (if (or (= (load depth) 0) (or (at-eof? (mut p)) (!= (load (field p failed)) 0)))
              (break)
              (do
                (if (punct? (mut p) "(") (store! depth (+ (load depth) 1)) 0)
                (if (punct? (mut p) ")") (store! depth (- (load depth) 1)) 0)
                (advance! (mut p)))))
    0))

;;; `(*f)(int)` binds the pointer to the function, not to the return type. The
;;; group is skipped, the suffix after it gives the outer type, and only then is
;;; the group re-parsed against that -- which is what makes the precedence come
;;; out right.
(defn parse-declarator [(p (mut Parser)) (base (ptr ct/Type))] (-> Declared)
  (skip-attributes! (mut p))
  (let [ty0 (parse-pointers (mut p) base)]
    (if (punct? (mut p) "(")
        (let [start (load (field p pos))]
          (skip-group! (mut p))
          (let [outer (parse-type-suffix (mut p) ty0)
                after (load (field p pos))]
            (store! (field p pos) (+ start 1))
            (let [inner (parse-declarator (mut p) outer)]
              (store! (field p pos) after)
              inner)))
        (let [t (peek (mut p))]
          (if (and (or (= (lex/token-kind t) lex/TK-IDENT) (= (lex/token-kind t) lex/TK-KEYWORD))
                   (not (attribute-start? (mut p))))
              (do
                (advance! (mut p))
                (let [suffixed (parse-type-suffix (mut p) ty0)
                      asm-name (parse-asm-name! (mut p))]
                  (skip-attributes! (mut p))
                  (load (Declared
                          :name (lex/token-text t)
                          :ty suffixed
                          :asm-name asm-name
                          :tok t))))
              (let [suffixed (parse-type-suffix (mut p) ty0)
                    asm-name (parse-asm-name! (mut p))]
                (skip-attributes! (mut p))
                (load (Declared
                        :name ""
                        :ty suffixed
                        :asm-name asm-name
                        :tok t))))))))

(defn parse-declarator-type [(p (mut Parser)) (base (ptr ct/Type))] (-> (ptr ct/Type))
  (let [d (parse-declarator (mut p) base)] (.ty d)))

(defn parse-typename [(p (mut Parser))] (-> (ptr ct/Type))
  (let [spec (parse-declspec (mut p))]
    (parse-declarator-type (mut p) (.ty spec))))

;;; A tag names the same type everywhere it appears, so a reference to one
;;; already declared reuses it rather than making a new one. That is what lets a
;;; record contain a pointer to itself.
(defn parse-record [(p (mut Parser)) (union? bool)] (-> (ptr ct/Type))
  (advance! (mut p))
  ;; `struct __attribute__((packed)) s { ... }` puts the attribute here.
  (let [leading (parse-attributes! (mut p))
        t (peek (mut p))
        named (or (= (lex/token-kind t) lex/TK-IDENT) (= (lex/token-kind t) lex/TK-KEYWORD))
        tag (if named (lex/token-text t) "")]
    (if named (do (advance! (mut p)) 0) 0)
    (if (not (punct? (mut p) "{"))
        (let [existing (if named (lookup-tag (mut p) tag) (nil-type))]
          (if (null-type? existing)
              (let [fresh (ct/ty-record (load (field p a)) union?)]
                (ct/set-name! fresh tag)
                (if named (declare-tag! (mut p) tag fresh) 0)
                fresh)
              existing))
        (let [existing (if named (lookup-tag (mut p) tag) (nil-type))
              ty (if (null-type? existing) (ct/ty-record (load (field p a)) union?) existing)]
          (ct/set-name! ty tag)
          (if named (declare-tag! (mut p) tag ty) 0)
          (advance! (mut p))
          (loop (consume-pack-markers! (mut p))
            (if (or (!= (load (field p failed)) 0)
                    (or (punct? (mut p) "}") (at-eof? (mut p))))
                (break)
                (let [spec (parse-declspec (mut p))
                      (mut more) 1]
                  (if (punct? (mut p) ";")
                      (do
                        (if (ct/record? (.ty spec))
                            (ct/add-member! ty "" (.ty spec) -1)
                            0)
                        (advance! (mut p))
                        (store! more 0))
                      0)
                  (loop (if (= (load more) 0)
                            (break)
                            (let [d (parse-declarator (mut p) (.ty spec))
                                  width
                                    (if (punct? (mut p) ":")
                                        (do (advance! (mut p)) (parse-const-expr (mut p)))
                                        -1)]
                              (validate-decl-align! (mut p) spec (.ty d))
                              (ct/add-member! ty (.name d) (.ty d) width)
                              (if (punct? (mut p) ",")
                                  (do (advance! (mut p)) 0)
                                  (do (expect! (mut p) ";") (store! more 0)))))))))
          (expect! (mut p) "}")
          ;; `struct { ... } __attribute__((packed)) name;` puts it here
          ;; instead, so both positions are collected before the layout runs.
          (let [trailing (parse-attributes! (mut p))]
            (if (or (!= (.packed leading) 0) (!= (.packed trailing) 0))
                (ct/set-packed! ty)
                0)
            (if (> (.aligned leading) 0) (ct/set-align-override! ty (.aligned leading)) 0)
            (if (> (.aligned trailing) 0) (ct/set-align-override! ty (.aligned trailing)) 0))
          (ct/set-pack! ty (load (field p pack)))
          (ct/layout-record! ty)
          ty))))

(defn parse-enum [(p (mut Parser))] (-> (ptr ct/Type))
  (advance! (mut p))
  (let [t (peek (mut p))
        named (or (= (lex/token-kind t) lex/TK-IDENT) (= (lex/token-kind t) lex/TK-KEYWORD))
        tag (if named (lex/token-text t) "")]
    (if named (do (advance! (mut p)) 0) 0)
    (if (not (punct? (mut p) "{"))
        (let [existing (if named (lookup-tag (mut p) tag) (nil-type))]
          (if (null-type? existing) (ty-int-of (mut p)) existing))
        (let [ty (ct/ty-new (load (field p a)) ct/TY-ENUM 4 4)
              (mut next-value) 0]
          (ct/set-name! ty tag)
          (if named (declare-tag! (mut p) tag ty) 0)
          (advance! (mut p))
          (loop (if (or (punct? (mut p) "}") (at-eof? (mut p)))
                    (break)
                    (let [nt (advance! (mut p))]
                      (if (punct? (mut p) "=")
                          (do (advance! (mut p)) (store! next-value (parse-const-expr (mut p))))
                          0)
                      (declare-enum! (mut p) (lex/token-text nt) (load next-value))
                      (store! next-value (+ (load next-value) 1))
                      (if (punct? (mut p) ",") (do (advance! (mut p)) 0) 0))))
          (expect! (mut p) "}")
          ty))))

;;; `(int)x` is a cast, `(x)` is a parenthesised expression, and only a type name
;;; after the paren tells them apart.
(defn parse-cast [(p (mut Parser))] (-> (ptr nd/Node))
  (if (and (punct? (mut p) "(") (type-start-at? (mut p) 1))
      (let [tok (advance! (mut p))
            ty (parse-typename (mut p))]
        (expect! (mut p) ")")
        (if (punct? (mut p) "{")
            (parse-postfix-tail (mut p) (parse-compound-literal (mut p) ty tok))
            (nd/node-cast (load (field p a)) (decay (mut p) (parse-cast (mut p))) ty)))
      (parse-unary (mut p))))

(defn type-start-at? [(p (mut Parser)) (offset i64)] (-> bool)
  (let [saved (load (field p pos))]
    (store! (field p pos) (+ saved offset))
    (let [answer (type-start? (mut p))]
      (store! (field p pos) saved)
      answer)))

(defn parse-unary [(p (mut Parser))] (-> (ptr nd/Node))
  (let [a (load (field p a))]
    (cond ;; GNU's marker only suppresses pedantic diagnostics for the expression
          ;; that follows; it has no run-time semantics.
          (word? (mut p) "__extension__") (do (advance! (mut p)) (parse-cast (mut p)))
          (punct? (mut p) "+") (do (advance! (mut p)) (parse-cast (mut p)))
          (punct? (mut p) "-")
            (let [tok (advance! (mut p))
                  n (nd/node-unary a nd/ND-NEG (decay (mut p) (parse-cast (mut p))) tok)]
              (add-type! (mut p) n)
              n)
          (punct? (mut p) "!")
            (let [tok (advance! (mut p))
                  n (nd/node-unary a nd/ND-NOT (decay (mut p) (parse-cast (mut p))) tok)]
              (add-type! (mut p) n)
              n)
          (punct? (mut p) "~")
            (let [tok (advance! (mut p))
                  n (nd/node-unary a nd/ND-BITNOT (decay (mut p) (parse-cast (mut p))) tok)]
              (add-type! (mut p) n)
              n)
          ;; `&` is one of the two places an array does not decay.
          (punct? (mut p) "&")
            (let [tok (advance! (mut p))
                  n (nd/node-unary a nd/ND-ADDR (parse-cast (mut p)) tok)]
              (add-type! (mut p) n)
              n)
          (punct? (mut p) "*")
            (let [tok (advance! (mut p))
                  n (nd/node-unary a nd/ND-DEREF (decay (mut p) (parse-cast (mut p))) tok)]
              (add-type! (mut p) n)
              n)
          ;; `++x` is `x += 1`, which keeps one assignment shape in the tree.
          (punct? (mut p) "++")
            (let [tok (advance! (mut p))
                  target (parse-unary (mut p))
                  one (nd/node-num a 1 tok)]
              (add-type! (mut p) one)
              (compound-assign-with (mut p) target nd/ND-ADD one tok))
          (punct? (mut p) "--")
            (let [tok (advance! (mut p))
                  target (parse-unary (mut p))
                  one (nd/node-num a 1 tok)]
              (add-type! (mut p) one)
              (compound-assign-with (mut p) target nd/ND-SUB one tok))
          :else (parse-postfix (mut p)))))

(defn parse-postfix-tail [(p (mut Parser)) (initial (ptr nd/Node))] (-> (ptr nd/Node))
  (let [a (load (field p a))
        (mut n) initial]
    (loop (cond ;; `x[i]` is `*(x + i)`.
                (punct? (mut p) "[")
                  (let [tok (advance! (mut p))
                        idx (parse-expr (mut p))]
                    (expect! (mut p) "]")
                    (let [sum (new-add (mut p) (load n) idx tok)
                          d (nd/node-unary a nd/ND-DEREF sum tok)]
                      (add-type! (mut p) d)
                      (store! n d)))
                (punct? (mut p) ".")
                  (let [tok (advance! (mut p))]
                    (store! n (member-access (mut p) (load n) (advance! (mut p)) tok)))
                ;; `x->y` is `(*x).y`.
                (punct? (mut p) "->")
                  (let [tok (advance! (mut p))
                        d (nd/node-unary a nd/ND-DEREF (decay (mut p) (load n)) tok)]
                    (add-type! (mut p) d)
                    (store! n (member-access (mut p) d (advance! (mut p)) tok)))
                (punct? (mut p) "(") (store! n (parse-call (mut p) (load n)))
                (punct? (mut p) "++")
                  (let [tok (advance! (mut p))]
                    (store! n (post-increment (mut p) (load n) nd/ND-ADD tok)))
                (punct? (mut p) "--")
                  (let [tok (advance! (mut p))]
                    (store! n (post-increment (mut p) (load n) nd/ND-SUB tok)))
                :else (break)))
    (load n)))

(defn parse-postfix [(p (mut Parser))] (-> (ptr nd/Node))
  (parse-postfix-tail (mut p) (parse-primary (mut p))))

;;; `x++` yields the old value, so it is `(x += 1) - 1` with the arithmetic done
;;; in the value's own type.
;;; `x++` is `x += 1` that yields what `x` was, which the update node records
;;; rather than the caller recovering it by stepping the new value back.
(defn post-increment [(p (mut Parser)) (n (ptr nd/Node)) (kind i64) (tok lex/Token)] (-> (ptr nd/Node))
  (let [one (nd/node-num (load (field p a)) 1 tok)]
    (add-type! (mut p) one)
    (let [c (compound-assign-with (mut p) n kind one tok)]
      (nd/set-value! c 1)
      c)))

(defn member-access-find [(p (mut Parser))
                          (base (ptr nd/Node))
                          (name-tok lex/Token)
                          (tok lex/Token)] (-> (ptr nd/Node))
  (let [ty (nd/nd-type base)]
    (if (or (null-type? ty) (not (ct/record? ty)))
        (nil-node)
        (let [members (ct/ty-members ty)
              n (al/al-len [ct/Member] members)
              (mut i) 0
              (mut found) -1]
          (loop (if (or (>= (load found) 0) (>= (load i) n))
                    (break)
                    (do
                      (if (text=? (ct/member-name (al/al-get [ct/Member] members (load i)))
                                  (lex/token-text name-tok))
                          (store! found (load i))
                          0)
                      (store! i (+ (load i) 1)))))
          (if (>= (load found) 0)
              (let [node (nd/node-unary (load (field p a)) nd/ND-MEMBER base tok)]
                (nd/set-member! node (al/al-get [ct/Member] members (load found)))
                node)
              ;; An unnamed struct or union member promotes all of its members
              ;; into the containing record's member namespace.
              (let [(mut j) 0
                    (mut nested) (nil-node)]
                (loop (if (or (>= (load j) n) (not (null-node? (load nested))))
                          (break)
                          (let [m (al/al-get [ct/Member] members (load j))]
                            (if (and (= (slice-len (ct/member-name m)) 0)
                                     (ct/record? (ct/member-type m)))
                                (let [through (nd/node-unary (load (field p a)) nd/ND-MEMBER base tok)]
                                  (nd/set-member! through m)
                                  (store! nested (member-access-find (mut p) through name-tok tok)))
                                0)
                            (store! j (+ (load j) 1)))))
                (load nested)))))))

(defn c-lvalue? [(n (ptr nd/Node))] (-> bool)
  (let [k (nd/nd-kind n)]
    (or (= k nd/ND-VAR)
        (or (= k nd/ND-MEMBER) (or (= k nd/ND-DEREF) (= k nd/ND-STMT-EXPR))))))

(defn materialize-record-value [(p (mut Parser))
                                (value (ptr nd/Node))
                                (tok lex/Token)] (-> (ptr nd/Node))
  (let [a (load (field p a))
        f (load (field p current-fn))
        (mut name) (str/sb-new a)]
    (str/sb-push-str! (mut name) ".Lrecord-value.")
    (str/sb-push-i64! (mut name) (al/al-len [(ptr nd/Obj)] (nd/obj-locals f)))
    (str/sb-push-str! (mut name) "$")
    (str/sb-push-str! (mut name) (load (field p unit)))
    (let [o (nd/obj-new a (str/sb-str (load (mut name))) (nd/nd-type value) true)
          block (nd/node-new a nd/ND-BLOCK tok)
          assign (nd/node-binary a nd/ND-ASSIGN (nd/node-var a o tok) value tok)
          n (nd/node-new a nd/ND-STMT-EXPR tok)]
      (nd/push-local! f o)
      (nd/set-type! assign (nd/nd-type value))
      (nd/push-body! block (nd/node-unary a nd/ND-EXPR-STMT assign tok))
      (nd/set-lhs! n block)
      (nd/set-obj! n o)
      (nd/set-type! n (nd/nd-type value))
      n)))

(defn member-access [(p (mut Parser)) (base (ptr nd/Node)) (name-tok lex/Token) (tok lex/Token)] (-> (ptr nd/Node))
  (let [object
          (if (and (not (null-type? (nd/nd-type base)))
                   (and (ct/record? (nd/nd-type base)) (not (c-lvalue? base))))
              (materialize-record-value (mut p) base tok)
              base)
        found (member-access-find (mut p) object name-tok tok)]
    (if (null-node? found)
        (do
          (fail-at! (mut p) "no such member" name-tok)
          base)
        found)))

;;; What a parameter of this declared type actually receives. An array or a
;;; function parameter is a pointer, the same way an argument of either type is.
(defn param-target-type [(p (mut Parser)) (t (ptr ct/Type))] (-> (ptr ct/Type))
  (if (null-type? t)
      t
      (cond (= (ct/ty-kind t) ct/TY-ARRAY) (ct/ty-pointer-to (load (field p a)) (ct/ty-base t))
            (= (ct/ty-kind t) ct/TY-FUNC) (ct/ty-pointer-to (load (field p a)) t)
            :else t)))

;;; A value is converted to the type it is being handed to. Leaving this out
;;; means the receiver reads a different width than the sender wrote.
(defn convert-to [(p (mut Parser)) (n (ptr nd/Node)) (target (ptr ct/Type))] (-> (ptr nd/Node))
  (if (or (null-type? target)
          (or (null-type? (nd/nd-type n)) (= (ct/ty-kind target) ct/TY-VOID)))
      n
      (nd/node-cast (load (field p a)) n target)))

;;; The default argument promotions. A variadic argument has no parameter to be
;;; converted to, so C promotes it: anything narrower than `int` becomes one, and
;;; a `float` becomes a `double`. Both sides of the call have to agree, so this is
;;; made explicit here rather than left to whoever reads the argument.
(defn default-promote [(p (mut Parser)) (n (ptr nd/Node))] (-> (ptr nd/Node))
  (let [t (nd/nd-type n)]
    (if (null-type? t)
        n
        (cond (= (ct/ty-kind t) ct/TY-FLOAT) (nd/node-cast (load (field p a)) n (ty-double-of (mut p)))
              (and (ct/integer? t) (< (ct/ty-size t) 4)) (nd/node-cast (load (field p a)) n (ty-int-of (mut p)))
              :else n))))

(defn parse-call [(p (mut Parser)) (callee (ptr nd/Node))] (-> (ptr nd/Node))
  (let [a (load (field p a))
        tok (advance! (mut p))
        n (nd/node-new a nd/ND-CALL tok)
        fty (nd/nd-type callee)]
    (nd/set-lhs! n (decay (mut p) callee))
    (loop (if (or (punct? (mut p) ")") (at-eof? (mut p)))
              (break)
              (let [arg (decay (mut p) (parse-assign (mut p)))
                    params (call-params (mut p) fty)
                    named (al/al-len [(ptr ct/Type)] params)
                    at (al/al-len [(ptr nd/Node)] (nd/nd-args n))]
                (nd/push-arg! n
                              (if (>= at named)
                                  (default-promote (mut p) arg)
                                  (convert-to (mut p)
                                              arg
                                              (param-target-type (mut p)
                                                                 (al/al-get [(ptr ct/Type)] params at)))))
                (if (punct? (mut p) ",") (do (advance! (mut p)) 0) (break)))))
    (expect! (mut p) ")")
    ;; The call's type is the function's return type, reached through the
    ;; pointer the callee decayed to.
    (let [ft
            (if (and (not (null-type? fty)) (= (ct/ty-kind fty) ct/TY-PTR))
                (ct/ty-base fty)
                fty)]
      ;; A function declared without a prototype takes whatever the call passes,
      ;; after the default promotions. Recording it here is what lets the
      ;; declaration this generates name the right argument types.
      (if (and (not (null-type? ft))
               (and (= (ct/ty-kind ft) ct/TY-FUNC)
                    (and (not (ct/ty-prototyped? ft))
                         (= (al/al-len [(ptr ct/Type)] (ct/ty-params ft)) 0))))
          (let [args (nd/nd-args n)
                count (al/al-len [(ptr nd/Node)] args)
                (mut i) 0]
            (loop (if (>= (load i) count)
                      (break)
                      (do
                        (ct/add-param! ft
                                       ""
                                       (nd/nd-type (al/al-get [(ptr nd/Node)] args (load i))))
                        (store! i (+ (load i) 1)))))
            (ct/set-prototyped! ft))
          0)
      (nd/set-type! n
                    (if (and (not (null-type? ft)) (= (ct/ty-kind ft) ct/TY-FUNC))
                        (ct/ty-base ft)
                        (ty-int-of (mut p)))))
    n))

(defn sync-builtin? [(name (slice u8))] (-> bool)
  (or (text=? name "__sync_synchronize")
      (or (text=? name "__sync_lock_test_and_set")
          (or (text=? name "__sync_val_compare_and_swap")
              (or (text=? name "__sync_fetch_and_add")
                  (or (text=? name "__sync_fetch_and_sub")
                      (or (text=? name "__sync_fetch_and_or")
                          (or (text=? name "__sync_fetch_and_xor")
                              (text=? name "__sync_fetch_and_and")))))))))

(defn c11-atomic-builtin? [(name (slice u8))] (-> bool)
  (or (text=? name "__c11_atomic_exchange")
      (or (text=? name "__c11_atomic_load")
          (text=? name "__c11_atomic_store"))))

(defn parse-sync-builtin [(p (mut Parser))] (-> (ptr nd/Node))
  (let [a (load (field p a))
        tok (advance! (mut p))
        name (lex/token-text tok)
        n (nd/node-new a nd/ND-ATOMIC tok)]
    (nd/set-label! n name)
    (expect! (mut p) "(")
    (loop (if (or (punct? (mut p) ")") (at-eof? (mut p)))
              (break)
              (do
                (nd/push-arg! n (decay (mut p) (parse-assign (mut p))))
                (if (punct? (mut p) ",") (advance! (mut p)) (break)))))
    (expect! (mut p) ")")
    (let [args (nd/nd-args n)]
      (if (= (al/al-len [(ptr nd/Node)] args) 0)
          (nd/set-type! n (ty-int-of (mut p)))
          (let [pointer-type (nd/nd-type (al/al-get [(ptr nd/Node)] args 0))]
            (if (and (not (null-type? pointer-type)) (= (ct/ty-kind pointer-type) ct/TY-PTR))
                (let [value-type (ct/ty-base pointer-type)
                      count (al/al-len [(ptr nd/Node)] args)
                      (mut i) 1]
                  (nd/set-type! n value-type)
                  ;; LLVM's atomic instruction operands have exactly the
                  ;; pointee width; C converts each value argument accordingly.
                  (loop (if (>= (load i) count)
                            (break)
                            (do
                              (al/al-set! [(ptr nd/Node)]
                                          (mut (field n args))
                                          (load i)
                                          (convert-to (mut p)
                                                      (al/al-get [(ptr nd/Node)] args (load i))
                                                      value-type))
                              (store! i (+ (load i) 1))))))
                (do
                  (fail-at! (mut p) "atomic builtin requires a pointer" tok)
                  (nd/set-type! n (ty-int-of (mut p))))))))
    n))

(defn parse-c11-atomic-builtin [(p (mut Parser))] (-> (ptr nd/Node))
  (let [n (parse-sync-builtin (mut p))
        name (nd/nd-label n)]
    ;; The final memory-order argument controls ordering, not the stored value's
    ;; width. Emission currently uses seq_cst, which is valid for weaker requests.
    (when (> (al/al-len [(ptr nd/Node)] (nd/nd-args n)) 1)
      (al/al-pop! [(ptr nd/Node)] (mut (field n args)))
      0)
    (cond (text=? name "__c11_atomic_exchange") (nd/set-label! n "__sync_lock_test_and_set")
          (text=? name "__c11_atomic_load") (nd/set-label! n "__c11_atomic_load")
          :else (nd/set-label! n "__c11_atomic_store"))
    n))

(defn parse-builtin-alloca [(p (mut Parser))] (-> (ptr nd/Node))
  (let [a (load (field p a))
        tok (advance! (mut p))
        n (nd/node-new a nd/ND-ATOMIC tok)]
    (expect! (mut p) "(")
    (nd/push-arg! n (convert-to (mut p) (decay (mut p) (parse-assign (mut p))) (ty-ulong-of (mut p))))
    (expect! (mut p) ")")
    (nd/set-label! n "__builtin_alloca")
    (nd/set-type! n (ct/ty-pointer-to a (ty-void-of (mut p))))
    n))

(defn parse-builtin-bit-count [(p (mut Parser))] (-> (ptr nd/Node))
  (let [a (load (field p a))
        tok (advance! (mut p))
        n (nd/node-new a nd/ND-ATOMIC tok)]
    (expect! (mut p) "(")
    (let [operand (decay (mut p) (parse-assign (mut p)))]
      (nd/push-arg! n operand)
      (nd/set-type! n
                    (if (or (text=? (lex/token-text tok) "__builtin_bswap16")
                            (or (text=? (lex/token-text tok) "__builtin_bswap32")
                                (text=? (lex/token-text tok) "__builtin_bswap64")))
                        (nd/nd-type operand)
                        (ty-int-of (mut p)))))
    (expect! (mut p) ")")
    (nd/set-label! n (lex/token-text tok))
    n))

;;; `va_start(ap, last)` points `ap` at the caller's variadic arguments. The
;;; named parameter it is given exists only to say where they begin, which the
;;; lowerer knows from the function it is emitting, so it is parsed and dropped.
(defn parse-va-start [(p (mut Parser))] (-> (ptr nd/Node))
  (let [a (load (field p a))
        tok (advance! (mut p))]
    (expect! (mut p) "(")
    (let [ap (parse-assign (mut p))]
      (loop (if (punct? (mut p) ",")
                (do (advance! (mut p)) (parse-assign (mut p)) 0)
                (break)))
      (expect! (mut p) ")")
      (let [n (nd/node-unary a nd/ND-VA-START ap tok)]
        (nd/set-type! n (ty-int-of (mut p)))
        n))))

;;; The parameter list of whatever a call expression names, for deciding which
;;; arguments are the variadic ones.
(defn call-params [(p (mut Parser)) (fty (ptr ct/Type))] (-> (al/ArrayList (ptr ct/Type)))
  (let [ft
          (if (and (not (null-type? fty)) (= (ct/ty-kind fty) ct/TY-PTR))
              (ct/ty-base fty)
              fty)]
    (if (and (not (null-type? ft)) (= (ct/ty-kind ft) ct/TY-FUNC))
        (ct/ty-params ft)
        (al/al-new [(ptr ct/Type)] (load (field p a))))))

(defn parse-primary [(p (mut Parser))] (-> (ptr nd/Node))
  (let [a (load (field p a))
        t (peek (mut p))]
    (cond (punct? (mut p) "(")
            (do
              (advance! (mut p))
              (let [n (parse-expr (mut p))] (expect! (mut p) ")") n))
          ;; `sizeof` takes either a type name in parentheses or an expression, and
          ;; its operand is never evaluated -- so an array does not decay here.
          (word? (mut p) "sizeof")
            (let [tok (advance! (mut p))]
              (if (and (punct? (mut p) "(") (type-start-at? (mut p) 1))
                  (do
                    (advance! (mut p))
                    (let [ty (parse-typename (mut p))]
                      (expect! (mut p) ")")
                      (let [n (nd/node-num a (ct/ty-size ty) tok)]
                        (nd/set-type! n (ty-ulong-of (mut p)))
                        n)))
                  (let [operand (parse-unary (mut p))
                        ty (nd/nd-type operand)
                        n (nd/node-num a (if (null-type? ty) 0 (ct/ty-size ty)) tok)]
                    (nd/set-type! n (ty-ulong-of (mut p)))
                    n)))
          (= (lex/token-kind t) lex/TK-NUMBER)
            (let [tok (advance! (mut p))
                  text (lex/token-text tok)]
              (if (float-literal? text)
                  (let [v (strtod (str/str->cstr a text) (primitive/cast (ptr (ptr i8)) 0))
                        n (nd/node-float a v tok)]
                    (nd/set-type! n (number-float-type (mut p) text))
                    n)
                  (let [v (parse-number-text text)
                        n (nd/node-num a v tok)]
                    (nd/set-type! n (number-int-type (mut p) text v))
                    n)))
          (= (lex/token-kind t) lex/TK-CHARACTER)
            (let [tok (advance! (mut p))
                  bytes (decode-escapes (mut p) (lex/token-text tok) 39)
                  v (if (> (slice-len bytes) 0) (primitive/cast i64 (slice-get bytes 0)) 0)
                  n (nd/node-num a v tok)]
              (add-type! (mut p) n)
              n)
          (= (lex/token-kind t) lex/TK-STRING) (let [tok (advance! (mut p))] (string-literal (mut p) tok))
          ;; The variadic access builtins are forms, not calls: `va_arg` takes a
          ;; type where an expression would go, and `va_start` needs the callee's
          ;; own argument area, which no C expression names.
          (word? (mut p) "__builtin_va_start") (parse-va-start (mut p))
          (word? (mut p) "__builtin_c23_va_start") (parse-va-start (mut p))
          (word? (mut p) "__builtin_va_end")
            (let [tok (advance! (mut p))]
              (expect! (mut p) "(")
              (parse-assign (mut p))
              (expect! (mut p) ")")
              (let [n (nd/node-num a 0 tok)] (add-type! (mut p) n) n))
          (word? (mut p) "__builtin_va_copy")
            (let [tok (advance! (mut p))]
              (expect! (mut p) "(")
              (let [dst (parse-assign (mut p))]
                (if (not (eat! (mut p) ",")) (fail! (mut p) "expected `,` in va_copy") 0)
                (let [src (decay (mut p) (parse-assign (mut p)))
                      n (nd/node-binary a nd/ND-ASSIGN dst src tok)]
                  (expect! (mut p) ")")
                  (add-type! (mut p) n)
                  n)))
          (word? (mut p) "__builtin_va_arg")
            (let [tok (advance! (mut p))]
              (expect! (mut p) "(")
              (let [ap (parse-assign (mut p))]
                (if (not (eat! (mut p) ",")) (fail! (mut p) "expected `,` in va_arg") 0)
                (let [ty (parse-typename (mut p))
                      n (nd/node-unary a nd/ND-VA-ARG ap tok)]
                  (expect! (mut p) ")")
                  (nd/set-type! n ty)
                  n)))
          (word? (mut p) "__builtin_constant_p")
            (let [tok (advance! (mut p))]
              (expect! (mut p) "(")
              (let [operand (parse-assign (mut p))]
                (expect! (mut p) ")")
                (let [n (nd/node-num a (if (constant-node? operand) 1 0) tok)]
                  (add-type! (mut p) n)
                  n)))
          (sync-builtin? (lex/token-text t)) (parse-sync-builtin (mut p))
          (c11-atomic-builtin? (lex/token-text t)) (parse-c11-atomic-builtin (mut p))
          (word? (mut p) "__builtin_alloca") (parse-builtin-alloca (mut p))
          (or (word? (mut p) "__builtin_popcount")
              (or (word? (mut p) "__builtin_popcountl")
                  (word? (mut p) "__builtin_popcountll")))
            (parse-builtin-bit-count (mut p))
          (or (word? (mut p) "__builtin_ctz")
              (or (word? (mut p) "__builtin_ctzl")
                  (word? (mut p) "__builtin_ctzll")))
            (parse-builtin-bit-count (mut p))
          (or (word? (mut p) "__builtin_bswap16")
              (or (word? (mut p) "__builtin_bswap32")
                  (word? (mut p) "__builtin_bswap64")))
            (parse-builtin-bit-count (mut p))
          (or (word? (mut p) "__func__") (word? (mut p) "__FUNCTION__"))
            (let [tok (advance! (mut p))
                  f (load (field p current-fn))]
              (if (null-obj? f)
                  (do
                    (fail-at! (mut p) "function-name identifier outside a function" tok)
                    (string-object (mut p) "" tok))
                  (string-object (mut p) (nd/obj-name f) tok)))
          (or (= (lex/token-kind t) lex/TK-IDENT) (= (lex/token-kind t) lex/TK-KEYWORD))
            (let [tok (advance! (mut p))]
              (match (lookup (mut p) (lex/token-text tok))
                (Some [found]
                      (let [e found]
                        (if (!= (.is-enum e) 0)
                            (let [n (nd/node-num a (.enum-value e) tok)] (add-type! (mut p) n) n)
                            (if (null-obj? (.obj e))
                                (do (fail-at! (mut p) "not a value" tok) (nd/node-num a 0 tok))
                                (nd/node-var a (.obj e) tok)))))
                (None []
                      (do (fail-at! (mut p) "undeclared identifier" tok) (nd/node-num a 0 tok)))))
          :else (do (fail-at! (mut p) "expected an expression" t) (advance! (mut p)) (nd/node-num a 0 t)))))

;; ---------------------------------------------------------- initializers

;;; An initialiser mirrors the shape of the type it initialises: one child per
;;; array element or record member, with an expression at the leaves. Building
;;; the whole tree before generating anything is what makes `{1, 2}` and
;;; `{{1}, {2}}` mean the same thing, and what lets the parts no initialiser
;;; mentions be zeroed rather than left holding whatever was there.
(defstruct Init
  [(ty (ptr ct/Type))
   (expr (ptr nd/Node))
   ;; Byte offset within the parent, and the bit position for a bitfield.
   (offset i64)
   (bit-offset i64)
   (bit-width i64)
   (children (al/ArrayList (ptr Init)))])

(defn nil-init [] (-> (ptr Init))
  (primitive/cast (ptr Init) 0))

(defn init-push-element! [(p (mut Parser)) (n (ptr Init)) (index i64)] (-> (ptr Init))
  (let [base (ct/ty-base (load (field n ty)))
        c (init-new (mut p) base)]
    (store! (field c offset) (* index (ct/ty-size base)))
    (al/al-push! [(ptr Init)] (mut (field n children)) c)
    c))

(defn init-new [(p (mut Parser)) (ty (ptr ct/Type))] (-> (ptr Init))
  (let [a (load (field p a))
        n
          (alloc/box! a
                      Init
                      (load (Init
                              :ty ty
                              :expr (nil-node)
                              :offset 0
                              :bit-offset 0
                              :bit-width -1
                              :children (al/al-new [(ptr Init)] a))))]
    (cond (= (ct/ty-kind ty) ct/TY-ARRAY)
            (let [len (ct/ty-array-len ty)
                  (mut i) 0]
              (loop (if (>= (load i) len)
                        (break)
                        (do
                          (init-push-element! (mut p) n (load i))
                          (store! i (+ (load i) 1))))))
          ;; A union's members all start at offset zero, so initialising one of
          ;; them is the same operation as initialising a struct's first.
          (ct/record? ty)
            (let [ms (ct/ty-members ty)
                  count (al/al-len [ct/Member] ms)
                  (mut i) 0]
              (loop (if (>= (load i) count)
                        (break)
                        (let [m (al/al-get [ct/Member] ms (load i))
                              c (init-new (mut p) (ct/member-type m))]
                          (store! (field c offset) (ct/member-offset m))
                          (store! (field c bit-offset) (ct/member-bit-offset m))
                          (store! (field c bit-width) (ct/member-bit-width m))
                          (al/al-push! [(ptr Init)] (mut (field n children)) c)
                          (store! i (+ (load i) 1))))))
          :else 0)
    n))

;;; The part at `index`. An array declared `[]` grows to fit whatever the
;;; initialiser names; an index past the end of a fixed-length one is an error in
;;; C, and is parsed into a throwaway so the tokens are still consumed and
;;; nothing is written out of bounds.
(defn init-child [(p (mut Parser)) (n (ptr Init)) (index i64)] (-> (ptr Init))
  (let [kids (load (field n children))
        len (al/al-len [(ptr Init)] kids)
        ty (load (field n ty))]
    (cond (< index len) (al/al-get [(ptr Init)] kids index)
          (and (= (ct/ty-kind ty) ct/TY-ARRAY) (< (ct/ty-array-len ty) 0))
            (let [(mut i) len
                  (mut last) (nil-init)]
              (loop (if (> (load i) index)
                        (break)
                        (do
                          (store! last (init-push-element! (mut p) n (load i)))
                          (store! i (+ (load i) 1)))))
              (load last))
          (= (ct/ty-kind ty) ct/TY-ARRAY) (init-new (mut p) (ct/ty-base ty))
          :else (init-new (mut p) (ty-int-of (mut p))))))

(defn at-init-end? [(p (mut Parser))] (-> bool)
  (or (punct? (mut p) "}")
      (and (punct? (mut p) ",") (is-punct-at? (mut p) 1 "}"))))

;;; Consumes the `}` that closes a list, allowing the trailing comma C permits.
(defn eat-init-end! [(p (mut Parser))] (-> bool)
  (cond (punct? (mut p) "}") (do (advance! (mut p)) true)
        (and (punct? (mut p) ",") (is-punct-at? (mut p) 1 "}")) (do (advance! (mut p)) (advance! (mut p)) true)
        :else false))

(defn member-index [(t (ptr ct/Type)) (name (slice u8))] (-> i64)
  (let [ms (ct/ty-members t)
        count (al/al-len [ct/Member] ms)
        (mut i) 0
        (mut found) -1]
    (loop (if (or (>= (load i) count) (>= (load found) 0))
              (break)
              (let [m (al/al-get [ct/Member] ms (load i))]
                (if (str/str-eq (ct/member-name m) name) (store! found (load i)) 0)
                (store! i (+ (load i) 1)))))
    (load found)))

;;; `char greeting[8] = "hi";` writes the bytes and then the terminator, and
;;; leaves the rest zero.
(defn string-initializer! [(p (mut Parser)) (n (ptr Init))] (-> i64)
  (let [tok (advance! (mut p))
        bytes (read-string-bytes! (mut p) tok)
        declared (ct/ty-array-len (load (field n ty)))
        limit (if (< declared 0) (+ (slice-len bytes) 1) declared)
        (mut i) 0]
    (loop (if (>= (load i) limit)
              (break)
              (let [c (init-child (mut p) n (load i))
                    v
                      (if (< (load i) (slice-len bytes))
                          (primitive/cast i64 (slice-get bytes (load i)))
                          0)
                    e (nd/node-num (load (field p a)) v tok)]
                (add-type! (mut p) e)
                (store! (field c expr) e)
                (store! i (+ (load i) 1))))))
  0)

(defn array-initializer1! [(p (mut Parser)) (n (ptr Init))] (-> i64)
  (expect! (mut p) "{")
  (let [(mut i) 0
        (mut first) 1
        (mut done) 0]
    (if (eat-init-end! (mut p)) (store! done 1) 0)
    (loop (if (or (!= (load done) 0) (or (at-eof? (mut p)) (!= (load (field p failed)) 0)))
              (break)
              (do
                (if (= (load first) 0)
                    (if (not (eat! (mut p) ",")) (fail! (mut p) "expected `,` in braced array initializer") 0)
                    0)
                (store! first 0)
                ;; `[2] = v` moves the cursor.
                (if (punct? (mut p) "[")
                    (do
                      (advance! (mut p))
                      (store! i (parse-const-expr (mut p)))
                      (expect! (mut p) "]")
                      (expect! (mut p) "="))
                    0)
                (parse-initializer2! (mut p) (init-child (mut p) n (load i)))
                (store! i (+ (load i) 1))
                (if (eat-init-end! (mut p)) (store! done 1) 0)))))
  0)

;;; The inner lists of `int a[2][3] = {1, 2, 3, 4, 5, 6}` have no braces of their
;;; own, so each takes as many elements as its length allows.
(defn array-initializer2! [(p (mut Parser)) (n (ptr Init))] (-> i64)
  (let [len (ct/ty-array-len (load (field n ty)))
        (mut i) 0]
    (loop (if (or (>= (load i) len)
                  (or (at-init-end? (mut p))
                      (or (at-eof? (mut p)) (!= (load (field p failed)) 0))))
              (break)
              (do
                (if (> (load i) 0)
                    (if (not (eat! (mut p) ",")) (fail! (mut p) "expected `,` in unbraced array initializer") 0)
                    0)
                (parse-initializer2! (mut p) (init-child (mut p) n (load i)))
                (store! i (+ (load i) 1))))))
  0)

(defn record-initializer1! [(p (mut Parser)) (n (ptr Init))] (-> i64)
  (expect! (mut p) "{")
  (let [ty (load (field n ty))
        count (al/al-len [ct/Member] (ct/ty-members ty))
        (mut i) 0
        (mut first) 1
        (mut done) 0]
    (if (eat-init-end! (mut p)) (store! done 1) 0)
    (loop (if (or (!= (load done) 0) (or (at-eof? (mut p)) (!= (load (field p failed)) 0)))
              (break)
              (let [(mut target) (nil-init)]
                (if (= (load first) 0)
                    (if (not (eat! (mut p) ",")) (fail! (mut p) "expected `,` in braced record initializer") 0)
                    0)
                (store! first 0)
                ;; A designator-list can walk through any number of nested record
                ;; members and array elements: `.touch.points[2].x = value`.
                (if (punct? (mut p) ".")
                    (do
                      (advance! (mut p))
                      (let [found (member-index ty (lex/token-text (advance! (mut p))))]
                        (if (< found 0)
                            (fail! (mut p) "no such member")
                            (do
                              (store! i found)
                              (store! target (init-child (mut p) n found)))))
                      (loop (cond (punct? (mut p) ".")
                                    (do
                                      (advance! (mut p))
                                      (let [target-ty (load (field (load target) ty))
                                            found (member-index target-ty (lex/token-text (advance! (mut p))))]
                                        (if (< found 0)
                                            (do (fail! (mut p) "no such member") (break))
                                            (store! target (init-child (mut p) (load target) found)))))
                                  (punct? (mut p) "[")
                                    (do
                                      (advance! (mut p))
                                      (let [index (parse-const-expr (mut p))]
                                        (expect! (mut p) "]")
                                        (store! target (init-child (mut p) (load target) index))))
                                  :else (break)))
                      (expect! (mut p) "="))
                    (store! target (init-child (mut p) n (load i))))
                (if (>= (load i) count)
                    (fail! (mut p) "too many initialisers for this type")
                    (parse-initializer2! (mut p) (load target)))
                (store! i (+ (load i) 1))
                (if (eat-init-end! (mut p)) (store! done 1) 0)))))
  0)

(defn record-initializer2! [(p (mut Parser)) (n (ptr Init))] (-> i64)
  (let [count (al/al-len [ct/Member] (ct/ty-members (load (field n ty))))
        (mut i) 0]
    (loop (if (or (>= (load i) count)
                  (or (at-init-end? (mut p))
                      (or (at-eof? (mut p)) (!= (load (field p failed)) 0))))
              (break)
              (do
                (if (> (load i) 0)
                    (if (not (eat! (mut p) ",")) (fail! (mut p) "expected `,` in unbraced record initializer") 0)
                    0)
                (parse-initializer2! (mut p) (init-child (mut p) n (load i)))
                (store! i (+ (load i) 1))))))
  0)

(defn parse-initializer2! [(p (mut Parser)) (n (ptr Init))] (-> i64)
  (let [ty (load (field n ty))
        k (ct/ty-kind ty)]
    (cond (and (= k ct/TY-ARRAY) (= (lex/token-kind (peek (mut p))) lex/TK-STRING)) (string-initializer! (mut p) n)
          (= k ct/TY-ARRAY)
            (if (punct? (mut p) "{")
                (array-initializer1! (mut p) n)
                (array-initializer2! (mut p) n))
          (ct/record? ty)
            (if (punct? (mut p) "{")
                (record-initializer1! (mut p) n)
                ;; `struct S a = b;` copies the whole object. Telling that apart
                ;; from a brace-less member list takes parsing the expression and
                ;; looking at its type, so the position is restored if it is not.
                (let [save (load (field p pos))
                      e (decay (mut p) (parse-assign (mut p)))]
                  (if (and (not (null-type? (nd/nd-type e))) (ct/record? (nd/nd-type e)))
                      (do (store! (field n expr) e) 0)
                      (do (store! (field p pos) save) (record-initializer2! (mut p) n)))))
          ;; `int x = {1};` is allowed.
          (punct? (mut p) "{")
            (do
              (advance! (mut p))
              (parse-initializer2! (mut p) n)
              (if (eat-init-end! (mut p)) 0 (expect! (mut p) "}"))
              0)
          :else (do (store! (field n expr) (decay (mut p) (parse-assign (mut p)))) 0))))

;;; Each leaf becomes an assignment to a synthetic member at a byte offset --
;;; exactly what `a.b[2].c = v` already lowers to, so the emitter learns nothing
;;; new.
(defn init-stores! [(p (mut Parser))
                    (block (ptr nd/Node))
                    (base (ptr nd/Obj))
                    (offset i64)
                    (n (ptr Init))
                    (tok lex/Token)] (-> i64)
  (let [a (load (field p a))
        expr (load (field n expr))]
    (if (not (null-node? expr))
        (let [target (nd/node-new a nd/ND-MEMBER tok)
              assign (nd/node-new a nd/ND-ASSIGN tok)]
          (nd/set-lhs! target (nd/node-var a base tok))
          (nd/set-type! target (load (field n ty)))
          (nd/set-member-at! target offset (load (field n bit-offset)) (load (field n bit-width)))
          (nd/set-lhs! assign target)
          (nd/set-rhs! assign (nd/node-cast a expr (load (field n ty))))
          (nd/set-type! assign (load (field n ty)))
          (nd/push-body! block (nd/node-unary a nd/ND-EXPR-STMT assign tok))
          0)
        (let [kids (load (field n children))
              count (al/al-len [(ptr Init)] kids)
              (mut i) 0]
          (loop (if (>= (load i) count)
                    (break)
                    (let [c (al/al-get [(ptr Init)] kids (load i))]
                      (init-stores! (mut p) block base (+ offset (load (field c offset))) c tok)
                      (store! i (+ (load i) 1)))))
          0))))

;;; An initialiser is a sequence of statements, not a value: the object is zeroed
;;; and then the parts the initialiser names are written. Objects with static
;;; storage start out zero already, so only automatic ones need the clear.
(defn parse-init-into! [(p (mut Parser))
                        (block (ptr nd/Node))
                        (o (ptr nd/Obj))] (-> i64)
  (let [a (load (field p a))
        tok (peek (mut p))
        n (init-new (mut p) (nd/obj-type o))]
    (parse-initializer2! (mut p) n)
    (let [ty (nd/obj-type o)]
      (if (and (= (ct/ty-kind ty) ct/TY-ARRAY) (< (ct/ty-array-len ty) 0))
          (ct/set-array-len! ty (al/al-len [(ptr Init)] (load (field n children))))
          0))
    (if (nd/obj-local? o)
        (let [zero (nd/node-unary a nd/ND-MEMZERO (nd/node-var a o tok) tok)]
          (nd/set-type! zero (nd/obj-type o))
          (nd/push-body! block (nd/node-unary a nd/ND-EXPR-STMT zero tok)))
        0)
    (init-stores! (mut p) block o 0 n tok)
    0))

;;; A compound literal denotes an unnamed object, not a temporary value. At
;;; file scope it has static storage; in a function it has automatic storage and
;;; its initializer runs whenever evaluation reaches the literal.
(defn parse-compound-literal [(p (mut Parser))
                              (ty (ptr ct/Type))
                              (tok lex/Token)] (-> (ptr nd/Node))
  (let [a (load (field p a))
        f (load (field p current-fn))
        file-scope (null-obj? f)
        index
          (if file-scope
              (al/al-len [(ptr nd/Obj)] (load (field p globals)))
              (al/al-len [(ptr nd/Obj)] (nd/obj-locals f)))
        (mut name-builder) (str/sb-new a)]
    (str/sb-push-str! (mut name-builder) ".Lcompound.")
    (str/sb-push-i64! (mut name-builder) index)
    (str/sb-push-str! (mut name-builder) "$")
    (str/sb-push-str! (mut name-builder) (load (field p unit)))
    (let [o (nd/obj-new a (str/sb-str (load (mut name-builder))) ty (not file-scope))
          block (if file-scope (load (field p init-block)) (nd/node-new a nd/ND-BLOCK tok))]
      (if file-scope
          (do
            (nd/set-obj-static! o true)
            (nd/set-obj-definition! o true)
            (al/al-push! [(ptr nd/Obj)] (mut (field p globals)) o))
          (nd/push-local! f o))
      (parse-init-into! (mut p) block o)
      (if file-scope
          (nd/node-var a o tok)
          (let [n (nd/node-new a nd/ND-STMT-EXPR tok)]
            (nd/set-lhs! n block)
            (nd/set-obj! n o)
            (nd/set-type! n ty)
            n)))))

;; ------------------------------------------------------------- statements
(defn new-local! [(p (mut Parser)) (name (slice u8)) (ty (ptr ct/Type))] (-> (ptr nd/Obj))
  (let [o (nd/obj-new (load (field p a)) name ty true)]
    (declare-obj! (mut p) o)
    (if (null-obj? (load (field p current-fn)))
        0
        (nd/push-local! (load (field p current-fn)) o))
    o))

;;; A `static` name belongs to one translation unit. The whole program is
;;; emitted into a single module, so the unit's tag is appended to keep two
;;; files' `static int count` apart, while the source name stays bound in scope.
(defn unit-name [(p (mut Parser)) (name (slice u8))] (-> (slice u8))
  (let [(mut b) (str/sb-new (load (field p a)))]
    (str/sb-push-str! (mut b) name)
    (str/sb-push-str! (mut b) "$")
    (str/sb-push-str! (mut b) (load (field p unit)))
    (str/sb-str (load (mut b)))))

(defn new-global! [(p (mut Parser)) (name (slice u8)) (ty (ptr ct/Type))] (-> (ptr nd/Obj))
  (let [o (nd/obj-new (load (field p a)) name ty false)]
    (declare-obj! (mut p) o)
    (al/al-push! [(ptr nd/Obj)] (mut (field p globals)) o)
    o))

(defn existing-object [(p (mut Parser)) (name (slice u8))] (-> (ptr nd/Obj))
  (match (lookup (mut p) name)
    (Some [found] (let [entry found] (.obj entry)))
    (None [] (nil-obj))))

(defn new-global-of! [(p (mut Parser))
                      (name (slice u8))
                      (ty (ptr ct/Type))
                      (static? bool)] (-> (ptr nd/Obj))
  (let [prior (existing-object (mut p) name)]
    ;; All file-scope declarations of one C identifier denote the same object.
    ;; In particular, calls parsed after a static prototype must point at the
    ;; object whose body is filled in by the later definition.
    (if (not (null-obj? prior))
        prior
        (if (not static?)
            (new-global! (mut p) name ty)
            (let [o (nd/obj-new (load (field p a)) (unit-name (mut p) name) ty false)]
              (nd/set-obj-static! o true)
              (declare-obj-as! (mut p) name o)
              (al/al-push! [(ptr nd/Obj)] (mut (field p globals)) o)
              o)))))

;;; A `static` local has static storage but local scope, so it becomes a global
;;; under a name nothing else can collide with, while the name the source used
;;; stays bound in the block.
(defn new-static-local! [(p (mut Parser)) (name (slice u8)) (ty (ptr ct/Type))] (-> (ptr nd/Obj))
  (let [a (load (field p a))
        (mut b) (str/sb-new a)]
    (str/sb-push-str! (mut b) name)
    (str/sb-push-str! (mut b) ".")
    (str/sb-push-i64! (mut b) (al/al-len [(ptr nd/Obj)] (load (field p globals))))
    (str/sb-push-str! (mut b) "$")
    (str/sb-push-str! (mut b) (load (field p unit)))
    (let [o (nd/obj-new a (str/sb-str (load (mut b))) ty false)]
      (nd/set-obj-static! o true)
      (nd/set-obj-definition! o true)
      (al/al-push! [(ptr nd/Obj)] (mut (field p globals)) o)
      (declare-obj-as! (mut p) name o)
      o)))

;;; A declaration statement becomes a block of assignments, one per initialised
;;; declarator, so the rest of the tree only has to know about expressions.
(defn parse-declaration [(p (mut Parser)) (spec DeclSpec)] (-> (ptr nd/Node))
  (let [a (load (field p a))
        block (nd/node-new a nd/ND-BLOCK (peek (mut p)))
        (mut more) 1]
    (if (punct? (mut p) ";")
        (do (advance! (mut p)) (store! more 0))
        0)
    (loop (if (= (load more) 0)
              (break)
              (let [d (parse-declarator (mut p) (.ty spec))]
                (validate-decl-align! (mut p) spec (.ty d))
                (cond (!= (.is-typedef spec) 0) (declare-typedef! (mut p) (.name d) (.ty d))
                      (!= (.is-extern spec) 0) (do (new-global! (mut p) (.name d) (.ty d)) 0)
                      (!= (.is-static spec) 0)
                        (let [o (new-static-local! (mut p) (.name d) (.ty d))]
                          (if (punct? (mut p) "=")
                              (do
                                (advance! (mut p))
                                (parse-init-into! (mut p) (load (field p init-block)) o))
                              0))
                      :else
                        (let [o (new-local! (mut p) (.name d) (.ty d))]
                          (if (punct? (mut p) "=")
                              (do (advance! (mut p)) (parse-init-into! (mut p) block o))
                              0)))
                (if (punct? (mut p) ",")
                    (do (advance! (mut p)) 0)
                    (do (expect! (mut p) ";") (store! more 0))))))
    block))

;;; `_Static_assert(expr, "message")` declares nothing; it only has to hold.
(defn static-assert? [(p (mut Parser))] (-> bool)
  (or (word? (mut p) "_Static_assert") (word? (mut p) "static_assert")))

(defn parse-static-assert! [(p (mut Parser))] (-> i64)
  (let [tok (advance! (mut p))]
    (expect! (mut p) "(")
    (let [value (parse-const-expr (mut p))]
      (if (punct? (mut p) ",") (do (advance! (mut p)) 0) 0)
      (loop (if (= (lex/token-kind (peek (mut p))) lex/TK-STRING)
                (do (advance! (mut p)) 0)
                (break)))
      (expect! (mut p) ")")
      (expect! (mut p) ";")
      (if (= value 0) (fail-at! (mut p) "static assertion failed" tok) 0))))

(defn parse-compound [(p (mut Parser))] (-> (ptr nd/Node))
  (let [a (load (field p a))
        tok (peek (mut p))
        block (nd/node-new a nd/ND-BLOCK tok)]
    (expect! (mut p) "{")
    (enter-scope! (mut p))
    (loop (if (or (punct? (mut p) "}") (or (at-eof? (mut p)) (!= (load (field p failed)) 0)))
              (break)
              (cond (static-assert? (mut p))
                      (do
                        (parse-static-assert! (mut p))
                        (nd/push-body! block (nd/node-new a nd/ND-NULL (peek (mut p)))))
                    (type-start? (mut p))
                      (let [spec (parse-declspec (mut p))]
                        (nd/push-body! block (parse-declaration (mut p) spec)))
                    :else (nd/push-body! block (parse-stmt (mut p))))))
    (leave-scope! (mut p))
    (expect! (mut p) "}")
    block))

(defn parse-expr-stmt [(p (mut Parser))] (-> (ptr nd/Node))
  (let [a (load (field p a))
        tok (peek (mut p))]
    (if (punct? (mut p) ";")
        (do (advance! (mut p)) (nd/node-new a nd/ND-NULL tok))
        (let [e (parse-expr (mut p))]
          (expect! (mut p) ";")
          (nd/node-unary a nd/ND-EXPR-STMT e tok)))))

;;; Empty GNU asm templates are compiler barriers or optimization hints. They
;;; contain no target instruction and therefore lower to an empty statement.
;;; Nonempty templates remain an explicit error rather than being discarded.
(defn parse-empty-asm-stmt [(p (mut Parser))] (-> (ptr nd/Node))
  (let [a (load (field p a))
        tok (advance! (mut p))
        (mut nonempty) false
        (mut template) ""
        (mut depth) 0]
    (loop (if (or (word? (mut p) "volatile") (word? (mut p) "__volatile__"))
              (advance! (mut p))
              (break)))
    (expect! (mut p) "(")
    (store! depth 1)
    (if (= (lex/token-kind (peek (mut p))) lex/TK-STRING)
        (do
          (store! template (read-string-bytes! (mut p) (advance! (mut p))))
          (if (> (slice-len (load template)) 0) (store! nonempty true) 0))
        (store! nonempty true))
    (loop (if (or (= (load depth) 0) (at-eof? (mut p)))
              (break)
              (do
                (if (punct? (mut p) "(") (store! depth (+ (load depth) 1)) 0)
                (if (punct? (mut p) ")") (store! depth (- (load depth) 1)) 0)
                (advance! (mut p)))))
    (expect! (mut p) ";")
    (if (not (load nonempty))
        (nd/node-new a nd/ND-NULL tok)
        (if (text=? (load template) "yield")
            (let [n (nd/node-new a nd/ND-ATOMIC tok)]
              (nd/set-label! n "__asm_aarch64_yield")
              (nd/set-type! n (ty-int-of (mut p)))
              n)
            (do
              (fail-at! (mut p) "unsupported inline assembly template" tok)
              (nd/node-new a nd/ND-NULL tok))))))

(defn return-type [(p (mut Parser))] (-> (ptr ct/Type))
  (let [f (load (field p current-fn))]
    (if (null-obj? f)
        (nil-type)
        (param-target-type (mut p) (ct/ty-base (nd/obj-type f))))))

(defn parse-stmt [(p (mut Parser))] (-> (ptr nd/Node))
  (let [a (load (field p a))]
    (cond (punct? (mut p) "{") (parse-compound (mut p))
          (or (word? (mut p) "asm") (or (word? (mut p) "__asm") (word? (mut p) "__asm__")))
            (parse-empty-asm-stmt (mut p))
          ;; The returned value is converted to the function's return type, the same
          ;; conversion an assignment to a variable of that type would make.
          (word? (mut p) "return")
            (let [tok (advance! (mut p))]
              (if (punct? (mut p) ";")
                  (do (advance! (mut p)) (nd/node-new a nd/ND-RETURN tok))
                  (let [e
                          (convert-to (mut p)
                                      (decay (mut p) (parse-expr (mut p)))
                                      (return-type (mut p)))]
                    (expect! (mut p) ";")
                    (nd/node-unary a nd/ND-RETURN e tok))))
          (word? (mut p) "if")
            (let [tok (advance! (mut p))
                  n (nd/node-new a nd/ND-IF tok)]
              (expect! (mut p) "(")
              (nd/set-test! n (decay (mut p) (parse-expr (mut p))))
              (expect! (mut p) ")")
              (nd/set-then! n (parse-stmt (mut p)))
              (if (word? (mut p) "else")
                  (do (advance! (mut p)) (nd/set-else! n (parse-stmt (mut p))))
                  0)
              n)
          (word? (mut p) "while")
            (let [tok (advance! (mut p))
                  n (nd/node-new a nd/ND-WHILE tok)]
              (expect! (mut p) "(")
              (nd/set-test! n (decay (mut p) (parse-expr (mut p))))
              (expect! (mut p) ")")
              (nd/set-then! n (parse-stmt (mut p)))
              n)
          (word? (mut p) "do")
            (let [tok (advance! (mut p))
                  n (nd/node-new a nd/ND-DO tok)]
              (nd/set-then! n (parse-stmt (mut p)))
              (expect! (mut p) "while")
              (expect! (mut p) "(")
              (nd/set-test! n (decay (mut p) (parse-expr (mut p))))
              (expect! (mut p) ")")
              (expect! (mut p) ";")
              n)
          ;; The initialiser may declare, so a `for` gets its own scope.
          (word? (mut p) "for")
            (let [tok (advance! (mut p))
                  n (nd/node-new a nd/ND-FOR tok)]
              (expect! (mut p) "(")
              (enter-scope! (mut p))
              (if (type-start? (mut p))
                  (let [spec (parse-declspec (mut p))]
                    (nd/set-setup! n (parse-declaration (mut p) spec)))
                  (nd/set-setup! n (parse-expr-stmt (mut p))))
              (if (punct? (mut p) ";")
                  0
                  (nd/set-test! n (decay (mut p) (parse-expr (mut p)))))
              (expect! (mut p) ";")
              (if (punct? (mut p) ")")
                  0
                  (nd/set-step! n (nd/node-unary a nd/ND-EXPR-STMT (parse-expr (mut p)) tok)))
              (expect! (mut p) ")")
              (nd/set-then! n (parse-stmt (mut p)))
              (leave-scope! (mut p))
              n)
          (word? (mut p) "switch")
            (let [tok (advance! (mut p))
                  n (nd/node-new a nd/ND-SWITCH tok)]
              (expect! (mut p) "(")
              (nd/set-test! n (decay (mut p) (parse-expr (mut p))))
              (expect! (mut p) ")")
              (nd/set-then! n (parse-stmt (mut p)))
              n)
          (word? (mut p) "case")
            (let [tok (advance! (mut p))
                  v (parse-const-expr (mut p))
                  n (nd/node-new a nd/ND-CASE tok)]
              (expect! (mut p) ":")
              (nd/set-value! n v)
              (nd/set-then! n (parse-stmt (mut p)))
              n)
          (word? (mut p) "default")
            (let [tok (advance! (mut p))
                  n (nd/node-new a nd/ND-CASE tok)]
              (expect! (mut p) ":")
              (nd/set-value! n 0)
              (nd/set-label! n "default")
              (nd/set-then! n (parse-stmt (mut p)))
              n)
          (word? (mut p) "break") (let [tok (advance! (mut p))] (expect! (mut p) ";") (nd/node-new a nd/ND-BREAK tok))
          (word? (mut p) "continue")
            (let [tok (advance! (mut p))] (expect! (mut p) ";") (nd/node-new a nd/ND-CONTINUE tok))
          (word? (mut p) "goto")
            (let [tok (advance! (mut p))
                  target (advance! (mut p))
                  n (nd/node-new a nd/ND-GOTO tok)]
              (expect! (mut p) ";")
              (nd/set-label! n (lex/token-text target))
              n)
          ;; A label is an identifier followed by a colon, which needs two tokens of
          ;; lookahead to tell from an expression statement.
          (and (or (= (lex/token-kind (peek (mut p))) lex/TK-IDENT)
                   (= (lex/token-kind (peek (mut p))) lex/TK-KEYWORD))
               (is-punct-at? (mut p) 1 ":"))
            (let [tok (advance! (mut p))
                  n (nd/node-new a nd/ND-LABEL tok)]
              (advance! (mut p))
              (nd/set-label! n (lex/token-text tok))
              (nd/set-then! n (parse-stmt (mut p)))
              n)
          :else (parse-expr-stmt (mut p)))))

;; ---------------------------------------------------------------- top level

;;; Parameter names travel on the function type beside their types, so the
;;; body can refer to them.
(defn param-name [(p (mut Parser)) (ty (ptr ct/Type)) (index i64)] (-> (slice u8))
  (let [names (ct/ty-param-names ty)]
    (if (< index (al/al-len [(slice u8)] names))
        (al/al-get [(slice u8)] names index)
        "")))

(defn parse-function! [(p (mut Parser)) (spec DeclSpec) (d Declared)] (-> i64)
  (let [o (new-global-of! (mut p) (.name d) (.ty d) (!= (.is-static spec) 0))
        around (load (field p pending))]
    (nd/set-obj-asm-name! o (.asm-name d))
    (if (!= (.at-start around) nd/AT-NONE)
        (nd/set-obj-at-start! o (.at-start around) (.at-start-priority around))
        0)
    (if (punct? (mut p) "{")
        (do
          (store! (field p current-fn) o)
          (enter-scope! (mut p))
          ;; A prototype describes parameter types but owns no parameter
          ;; objects. Create those only for the definition, otherwise a later
          ;; definition of the same function would receive every parameter
          ;; twice when the declarations are correctly unified.
          (let [ptypes (ct/ty-params (.ty d))
                n (al/al-len [(ptr ct/Type)] ptypes)
                (mut i) 0]
            (loop (if (>= (load i) n)
                      (break)
                      (do
                        (nd/push-param! o
                                        (new-local! (mut p)
                                                    (param-name (mut p) (.ty d) (load i))
                                                    (al/al-get [(ptr ct/Type)] ptypes (load i))))
                        (store! i (+ (load i) 1))))))
          (nd/set-obj-body! o (parse-compound (mut p)))
          (leave-scope! (mut p))
          (store! (field p current-fn) (nil-obj)))
        ;; A function declarator is either a definition followed by a body or a
        ;; declaration followed by a semicolon. Consuming an arbitrary token
        ;; here used to turn declarator/preprocessor mistakes into silently
        ;; missing functions far downstream at link time.
        (expect! (mut p) ";")))
  0)

(defn parse-toplevel! [(p (mut Parser))] (-> i64)
  (consume-pack-markers! (mut p))
  (if (at-eof? (mut p))
      0
      (if (static-assert? (mut p))
          (parse-static-assert! (mut p))
          (parse-declaration-toplevel! (mut p)))))

(defn parse-declaration-toplevel! [(p (mut Parser))] (-> i64)
  (forget-attributes! (mut p))
  (let [spec (parse-declspec (mut p))]
    (if (punct? (mut p) ";")
        (do (advance! (mut p)) 0)
        (let [(mut more) 1]
          (loop (if (or (= (load more) 0) (!= (load (field p failed)) 0))
                    (break)
                    (let [d (parse-declarator (mut p) (.ty spec))]
                      (validate-decl-align! (mut p) spec (.ty d))
                      (cond (!= (.is-typedef spec) 0)
                              (do
                                (declare-typedef! (mut p) (.name d) (.ty d))
                                (if (punct? (mut p) ",")
                                    (do (advance! (mut p)) 0)
                                    (do (expect! (mut p) ";") (store! more 0))))
                            (= (ct/ty-kind (.ty d)) ct/TY-FUNC)
                              (if (punct? (mut p) "{")
                                  (do (parse-function! (mut p) spec d) (store! more 0))
                                  (let [f (new-global-of! (mut p)
                                                          (.name d)
                                                          (.ty d)
                                                          (!= (.is-static spec) 0))]
                                    (nd/set-obj-asm-name! f (.asm-name d))
                                    (if (punct? (mut p) ",")
                                        (do (advance! (mut p)) 0)
                                        (do (expect! (mut p) ";") (store! more 0)))))
                            :else
                              (let [g (new-global-of! (mut p) (.name d) (.ty d) (!= (.is-static spec) 0))]
                                (nd/set-obj-asm-name! g (.asm-name d))
                                ;; `extern T x;` names an object defined elsewhere; every
                                ;; other file-scope declaration defines one here.
                                ;; A later `extern` declaration does not undo an
                                ;; earlier definition of the same object.
                                (nd/set-obj-definition! g
                                                        (or (nd/obj-definition? g)
                                                            (= (.is-extern spec) 0)))
                                (if (punct? (mut p) "=")
                                    (do
                                      (advance! (mut p))
                                      (parse-init-into! (mut p) (load (field p init-block)) g))
                                    0)
                                (if (punct? (mut p) ",")
                                    (do (advance! (mut p)) 0)
                                    (do (expect! (mut p) ";") (store! more 0))))))))
          0))))

(defn parser-new [(a (dyn alloc/Allocator))
                  (tokens (al/ArrayList lex/Token))
                  (unit (slice u8))] (-> Parser)
  (Parser
    :a a
    :tokens tokens
    :pos 0
    :scopes (al/al-new [(ptr Scope)] a)
    :globals (al/al-new [(ptr nd/Obj)] a)
    :init-block (nd/node-new a nd/ND-BLOCK (lex/token-none))
    :unit unit
    :pending
      (load (Attrs
              :packed 0
              :aligned 0
              :at-start nd/AT-NONE
              :at-start-priority nd/DEFAULT-PRIORITY))
    :pack 0
    :pack-stack (al/al-new [i64] a)
    :current-fn (primitive/cast (ptr nd/Obj) 0)
    :failed 0
    :message ""
    :file ""
    :line 0
    :column 0))

(defn parse [(p (mut Parser))] (-> ParseResult)
  (enter-scope! (mut p))
  (loop (if (or (at-eof? (mut p)) (!= (load (field p failed)) 0))
            (break)
            (parse-toplevel! (mut p))))
  (leave-scope! (mut p))
  (ParseResult
    :globals (load (field p globals))
    :init (load (field p init-block))
    :failed (load (field p failed))
    :message (load (field p message))
    :file (load (field p file))
    :line (load (field p line))
    :column (load (field p column))))
