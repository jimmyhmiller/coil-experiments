;; The typed AST the parser builds. Ported from chibicc by Rui Ueyama (MIT) --
;; see ATTRIBUTION.md.
;;
;; Every expression node carries its type, and the conversions C performs
;; implicitly -- array to pointer, function to pointer, the usual arithmetic
;; conversions -- are materialised as explicit ND-CAST nodes by the parser. That
;; is the same shape the existing lowerer already consumes from Clang, which is
;; what lets it be reused unchanged.
(module experiments.c.node)

(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "coil.slice" :use *)
(import "experiments.c.lex" :as lex)
(import "experiments.c.ctype" :as ct)

(export Node Obj
        ND-NUM ND-VAR ND-ADD ND-SUB ND-MUL ND-DIV ND-MOD ND-NEG
        ND-EQ ND-NE ND-LT ND-LE ND-BITAND ND-BITOR ND-BITXOR ND-BITNOT
        ND-SHL ND-SHR ND-LOGAND ND-LOGOR ND-NOT ND-COND ND-COMMA
        ND-ASSIGN ND-ADDR ND-DEREF ND-MEMBER ND-CAST ND-CALL
        ND-RETURN ND-IF ND-FOR ND-WHILE ND-DO ND-BLOCK ND-EXPR-STMT
        ND-BREAK ND-CONTINUE ND-GOTO ND-LABEL ND-SWITCH ND-CASE
        ND-STMT-EXPR ND-NULL ND-MEMZERO ND-VA-START ND-VA-ARG
        node-new node-num node-float node-unary node-binary node-cast node-var
        nd-kind nd-type nd-token nd-lhs nd-rhs nd-test nd-then nd-else
        nd-setup nd-step nd-body nd-args nd-obj nd-value nd-fvalue nd-member-name
        nd-member-offset nd-member-bit-offset nd-member-bit-width nd-label
        set-type! set-lhs! set-rhs! set-test! set-then! set-else!
        set-setup! set-step! set-value! set-obj! set-label!
        set-member! set-member-at! push-body! push-arg!
        obj-new obj-name obj-type obj-local? obj-function? obj-definition?
        obj-static? obj-params obj-locals obj-body obj-offset
        obj-string? obj-string-data set-obj-string!
        obj-asm-name set-obj-asm-name!
        set-obj-body! set-obj-offset! set-obj-definition! set-obj-static!
        push-param! push-local!)

(const ND-NUM 0)
(const ND-VAR 1)
(const ND-ADD 2)
(const ND-SUB 3)
(const ND-MUL 4)
(const ND-DIV 5)
(const ND-MOD 6)
(const ND-NEG 7)
(const ND-EQ 8)
(const ND-NE 9)
(const ND-LT 10)
(const ND-LE 11)
(const ND-BITAND 12)
(const ND-BITOR 13)
(const ND-BITXOR 14)
(const ND-BITNOT 15)
(const ND-SHL 16)
(const ND-SHR 17)
(const ND-LOGAND 18)
(const ND-LOGOR 19)
(const ND-NOT 20)
(const ND-COND 21)
(const ND-COMMA 22)
(const ND-ASSIGN 23)
(const ND-ADDR 24)
(const ND-DEREF 25)
(const ND-MEMBER 26)
(const ND-CAST 27)
(const ND-CALL 28)
(const ND-RETURN 29)
(const ND-IF 30)
(const ND-FOR 31)
(const ND-WHILE 32)
(const ND-DO 33)
(const ND-BLOCK 34)
(const ND-EXPR-STMT 35)
(const ND-BREAK 36)
(const ND-CONTINUE 37)
(const ND-GOTO 38)
(const ND-LABEL 39)
(const ND-SWITCH 40)
(const ND-CASE 41)
(const ND-STMT-EXPR 42)
(const ND-NULL 43)
(const ND-MEMZERO 44)
(const ND-VA-START 45)
(const ND-VA-ARG 46)

;; A variable or a function. `locals` is what a function body accumulates, and
;; is what the lowerer turns into stack slots.
(defstruct Obj
  [(name (slice u8))
   (ty (ptr ct/Type))
   ;; i64 rather than bool throughout: see tests/coil-bugs/.
   (is-local i64)
   (is-function i64)
   (is-definition i64)
   (is-static i64)
   ;; A string literal is a global whose bytes are known here rather than
   ;; written by any statement, so it carries them itself.
   (is-string i64)
   (string-data (slice u8))
   ;; The symbol the linker knows this by, when `__asm("_name")` gave it one
   ;; other than its C name.
   (asm-name (slice u8))
   (offset i64)
   (params (al/ArrayList (ptr Obj)))
   (locals (al/ArrayList (ptr Obj)))
   (body (ptr Node))])

(defstruct Node
  [(kind i64)
   (ty (ptr ct/Type))
   (tok lex/Token)
   (lhs (ptr Node))
   (rhs (ptr Node))
   (test (ptr Node))
   (conseq (ptr Node))
   (alt (ptr Node))
   (setup (ptr Node))
   (step (ptr Node))
   (body (al/ArrayList (ptr Node)))
   (args (al/ArrayList (ptr Node)))
   (obj (ptr Obj))
   (value i64)
   ;; A floating constant keeps its value here; `value` stays the integer one.
   (fvalue f64)
   (member-name (slice u8))
   (member-offset i64)
   (member-bit-offset i64)
   (member-bit-width i64)
   (label (slice u8))])

(defn nil-node [] (-> (ptr Node)) (primitive/cast (ptr Node) 0))
(defn nil-obj [] (-> (ptr Obj)) (primitive/cast (ptr Obj) 0))
(defn nil-type [] (-> (ptr ct/Type)) (primitive/cast (ptr ct/Type) 0))

(defn node-new [(a (dyn alloc/Allocator)) (kind i64) (tok lex/Token)] (-> (ptr Node))
  (alloc/box! a
              Node
              (load (Node :kind kind
                      :ty (nil-type)
                      :tok tok
                      :lhs (nil-node)
                      :rhs (nil-node)
                      :test (nil-node)
                      :conseq (nil-node)
                      :alt (nil-node)
                      :setup (nil-node)
                      :step (nil-node)
                      :body (al/al-new [(ptr Node)] a)
                      :args (al/al-new [(ptr Node)] a)
                      :obj (nil-obj)
                      :value 0
                      :fvalue 0.0
                      :member-name ""
                      :member-offset 0
                      :member-bit-offset 0
                      :member-bit-width -1
                      :label ""))))

(defn node-num [(a (dyn alloc/Allocator)) (v i64) (tok lex/Token)] (-> (ptr Node))
  (let [n (node-new a ND-NUM tok)]
    (store! (field n value) v)
    n))

(defn node-float [(a (dyn alloc/Allocator)) (v f64) (tok lex/Token)] (-> (ptr Node))
  (let [n (node-new a ND-NUM tok)]
    (store! (field n fvalue) v)
    n))

(defn node-unary [(a (dyn alloc/Allocator)) (kind i64) (lhs (ptr Node)) (tok lex/Token)] (-> (ptr Node))
  (let [n (node-new a kind tok)]
    (store! (field n lhs) lhs)
    n))

(defn node-binary [(a (dyn alloc/Allocator))
                   (kind i64)
                   (lhs (ptr Node))
                   (rhs (ptr Node))
                   (tok lex/Token)] (-> (ptr Node))
  (let [n (node-new a kind tok)]
    (store! (field n lhs) lhs)
    (store! (field n rhs) rhs)
    n))

(defn node-cast [(a (dyn alloc/Allocator)) (expr (ptr Node)) (ty (ptr ct/Type))] (-> (ptr Node))
  (let [n (node-new a ND-CAST (load (field expr tok)))]
    (store! (field n lhs) expr)
    (store! (field n ty) ty)
    n))

(defn node-var [(a (dyn alloc/Allocator)) (obj (ptr Obj)) (tok lex/Token)] (-> (ptr Node))
  (let [n (node-new a ND-VAR tok)]
    (store! (field n obj) obj)
    (store! (field n ty) (load (field obj ty)))
    n))

(defn nd-kind [(n (ptr Node))] (-> i64) (load (field n kind)))
(defn nd-type [(n (ptr Node))] (-> (ptr ct/Type)) (load (field n ty)))
(defn nd-token [(n (ptr Node))] (-> lex/Token) (load (field n tok)))
(defn nd-lhs [(n (ptr Node))] (-> (ptr Node)) (load (field n lhs)))
(defn nd-rhs [(n (ptr Node))] (-> (ptr Node)) (load (field n rhs)))
(defn nd-test [(n (ptr Node))] (-> (ptr Node)) (load (field n test)))
(defn nd-then [(n (ptr Node))] (-> (ptr Node)) (load (field n conseq)))
(defn nd-else [(n (ptr Node))] (-> (ptr Node)) (load (field n alt)))
(defn nd-setup [(n (ptr Node))] (-> (ptr Node)) (load (field n setup)))
(defn nd-step [(n (ptr Node))] (-> (ptr Node)) (load (field n step)))
(defn nd-body [(n (ptr Node))] (-> (al/ArrayList (ptr Node))) (load (field n body)))
(defn nd-args [(n (ptr Node))] (-> (al/ArrayList (ptr Node))) (load (field n args)))
(defn nd-obj [(n (ptr Node))] (-> (ptr Obj)) (load (field n obj)))
(defn nd-value [(n (ptr Node))] (-> i64) (load (field n value)))
(defn nd-fvalue [(n (ptr Node))] (-> f64) (load (field n fvalue)))
(defn nd-member-name [(n (ptr Node))] (-> (slice u8)) (load (field n member-name)))
(defn nd-member-offset [(n (ptr Node))] (-> i64) (load (field n member-offset)))
(defn nd-member-bit-offset [(n (ptr Node))] (-> i64) (load (field n member-bit-offset)))
(defn nd-member-bit-width [(n (ptr Node))] (-> i64) (load (field n member-bit-width)))
(defn nd-label [(n (ptr Node))] (-> (slice u8)) (load (field n label)))

(defn set-type! [(n (ptr Node)) (t (ptr ct/Type))] (-> i64) (store! (field n ty) t) 0)
(defn set-lhs! [(n (ptr Node)) (v (ptr Node))] (-> i64) (store! (field n lhs) v) 0)
(defn set-rhs! [(n (ptr Node)) (v (ptr Node))] (-> i64) (store! (field n rhs) v) 0)
(defn set-test! [(n (ptr Node)) (v (ptr Node))] (-> i64) (store! (field n test) v) 0)
(defn set-then! [(n (ptr Node)) (v (ptr Node))] (-> i64) (store! (field n conseq) v) 0)
(defn set-else! [(n (ptr Node)) (v (ptr Node))] (-> i64) (store! (field n alt) v) 0)
(defn set-setup! [(n (ptr Node)) (v (ptr Node))] (-> i64) (store! (field n setup) v) 0)
(defn set-step! [(n (ptr Node)) (v (ptr Node))] (-> i64) (store! (field n step) v) 0)
(defn set-value! [(n (ptr Node)) (v i64)] (-> i64) (store! (field n value) v) 0)
(defn set-obj! [(n (ptr Node)) (v (ptr Obj))] (-> i64) (store! (field n obj) v) 0)
(defn set-label! [(n (ptr Node)) (v (slice u8))] (-> i64) (store! (field n label) v) 0)

(defn set-member! [(n (ptr Node)) (m ct/Member)] (-> i64)
  (store! (field n member-name) (ct/member-name m))
  (store! (field n member-offset) (ct/member-offset m))
  (store! (field n member-bit-offset) (ct/member-bit-offset m))
  (store! (field n member-bit-width) (ct/member-bit-width m))
  (store! (field n ty) (ct/member-type m))
  0)

;; A synthetic member: an initialiser reaches an object's parts by offset
;; without there being any `.` in the source to hang a member on.
(defn set-member-at! [(n (ptr Node)) (offset i64) (bit-offset i64) (bit-width i64)] (-> i64)
  (store! (field n member-offset) offset)
  (store! (field n member-bit-offset) bit-offset)
  (store! (field n member-bit-width) bit-width)
  0)

(defn push-body! [(n (ptr Node)) (v (ptr Node))] (-> i64)
  (al/al-push! [(ptr Node)] (mut (field n body)) v) 0)
(defn push-arg! [(n (ptr Node)) (v (ptr Node))] (-> i64)
  (al/al-push! [(ptr Node)] (mut (field n args)) v) 0)

(defn obj-new [(a (dyn alloc/Allocator))
               (name (slice u8))
               (ty (ptr ct/Type))
               (local? bool)] (-> (ptr Obj))
  (alloc/box! a
              Obj
              (load (Obj :name name
                      :ty ty
                      :is-local (if local? 1 0)
                      :is-function 0
                      :is-definition 0
                      :is-static 0
                      :is-string 0
                      :string-data ""
                      :asm-name ""
                      :offset 0
                      :params (al/al-new [(ptr Obj)] a)
                      :locals (al/al-new [(ptr Obj)] a)
                      :body (nil-node)))))

(defn obj-name [(o (ptr Obj))] (-> (slice u8)) (load (field o name)))
(defn obj-type [(o (ptr Obj))] (-> (ptr ct/Type)) (load (field o ty)))
(defn obj-local? [(o (ptr Obj))] (-> bool) (!= (load (field o is-local)) 0))
(defn obj-function? [(o (ptr Obj))] (-> bool) (!= (load (field o is-function)) 0))
(defn obj-definition? [(o (ptr Obj))] (-> bool) (!= (load (field o is-definition)) 0))
(defn obj-static? [(o (ptr Obj))] (-> bool) (!= (load (field o is-static)) 0))
(defn obj-params [(o (ptr Obj))] (-> (al/ArrayList (ptr Obj))) (load (field o params)))
(defn obj-locals [(o (ptr Obj))] (-> (al/ArrayList (ptr Obj))) (load (field o locals)))
(defn obj-body [(o (ptr Obj))] (-> (ptr Node)) (load (field o body)))
(defn obj-offset [(o (ptr Obj))] (-> i64) (load (field o offset)))
(defn obj-asm-name [(o (ptr Obj))] (-> (slice u8)) (load (field o asm-name)))
(defn set-obj-asm-name! [(o (ptr Obj)) (n (slice u8))] (-> i64)
  (if (> (slice-len n) 0) (store! (field o asm-name) n) 0)
  0)
(defn obj-string? [(o (ptr Obj))] (-> bool) (!= (load (field o is-string)) 0))
(defn obj-string-data [(o (ptr Obj))] (-> (slice u8)) (load (field o string-data)))
(defn set-obj-string! [(o (ptr Obj)) (bytes (slice u8))] (-> i64)
  (store! (field o is-string) 1)
  (store! (field o string-data) bytes)
  0)

(defn set-obj-body! [(o (ptr Obj)) (n (ptr Node))] (-> i64)
  (store! (field o body) n)
  (store! (field o is-function) 1)
  (store! (field o is-definition) 1)
  0)
(defn set-obj-offset! [(o (ptr Obj)) (v i64)] (-> i64) (store! (field o offset) v) 0)
(defn set-obj-definition! [(o (ptr Obj)) (v bool)] (-> i64)
  (store! (field o is-definition) (if v 1 0)) 0)
(defn set-obj-static! [(o (ptr Obj)) (v bool)] (-> i64)
  (store! (field o is-static) (if v 1 0)) 0)
(defn push-param! [(o (ptr Obj)) (v (ptr Obj))] (-> i64)
  (al/al-push! [(ptr Obj)] (mut (field o params)) v) 0)
(defn push-local! [(o (ptr Obj)) (v (ptr Obj))] (-> i64)
  (al/al-push! [(ptr Obj)] (mut (field o locals)) v) 0)
