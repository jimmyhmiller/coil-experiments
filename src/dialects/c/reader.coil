(module experiments.c.reader)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "coil.slice" :use *)
(import "coil.str" :as str)
(import "coil.fs" :as fs)
(import "coil.result" :use *)
(import "coil.meta" :use [expansion-allocator read-context-manifest])
(import "experiments.c.cc" :as cc)
(import "experiments.c.pp" :as pp)

(reader-provider "experiments.c.reader" read-c-module)

(extern getenv :cc c [(ptr i8)] (-> (ptr i8)))

(defstruct CModuleConfig
  [(sources (al/ArrayList (slice u8)))
   (includes (al/ArrayList (slice u8)))
   (defines (al/ArrayList (slice u8)))
   (header-defines (al/ArrayList (slice u8)))
   (has-header-defines bool)
   (generated-modules bool)
   (prefixes (al/ArrayList (slice u8)))
   (module-names (al/ArrayList (slice u8)))])

(defn trim [(s (slice u8))] (-> (slice u8))
  (let [(mut lo) 0
        (mut hi) (slice-len s)]
    (loop (if (and (< (load lo) (load hi))
                   (or (= (primitive/cast i64 (slice-get s (load lo))) 32)
                       (= (primitive/cast i64 (slice-get s (load lo))) 9)))
              (store! lo (+ (load lo) 1))
              (break)))
    (loop (if (and (> (load hi) (load lo))
                   (or (= (primitive/cast i64 (slice-get s (- (load hi) 1))) 32)
                       (= (primitive/cast i64 (slice-get s (- (load hi) 1))) 9)))
              (store! hi (- (load hi) 1))
              (break)))
    (subslice s (load lo) (load hi))))

(defn byte-index [(s (slice u8)) (wanted i64)] (-> i64)
  (let [(mut i) 0
        (mut found) -1]
    (loop (if (>= (load i) (slice-len s))
              (break)
              (if (= (primitive/cast i64 (slice-get s (load i))) wanted)
                  (do (store! found (load i)) (break))
                  (store! i (+ (load i) 1)))))
    (load found)))

(defn basename-without-extension [(path (slice u8))] (-> (slice u8))
  (let [n (slice-len path)
        (mut start) 0
        (mut end) n
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [c (primitive/cast i64 (slice-get path (load i)))]
                (if (= c 47) (do (store! start (+ (load i) 1)) (store! end n)) 0)
                (if (= c 46) (store! end (load i)) 0)
                (store! i (+ (load i) 1)))))
    (subslice path (load start) (load end))))

(defn quoted-values! [(line (slice u8))
                      (target (mut (al/ArrayList (slice u8))))] (-> i64)
  (let [n (slice-len line)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (if (= (primitive/cast i64 (slice-get line (load i))) 34)
                  (let [start (+ (load i) 1)
                        (mut j) start]
                    (loop (if (or (>= (load j) n)
                                  (= (primitive/cast i64 (slice-get line (load j))) 34))
                              (break)
                              (store! j (+ (load j) 1))))
                    (if (< (load j) n)
                        (do
                          (al/al-push! [(slice u8)] (mut target) (subslice line start (load j)))
                          (store! i (+ (load j) 1)))
                        (store! i n)))
                  (store! i (+ (load i) 1)))))
    0))

(defn parse-config [(a (dyn alloc/Allocator))
                    (text (slice u8))
                    (name (slice u8))] (-> CModuleConfig)
  (let [(mut sources) (al/al-new [(slice u8)] a)
        (mut includes) (al/al-new [(slice u8)] a)
        (mut defines) (al/al-new [(slice u8)] a)
        (mut header-defines) (al/al-new [(slice u8)] a)
        (mut has-header-defines) false
        (mut generated-modules) false
        (mut prefixes) (al/al-new [(slice u8)] a)
        (mut module-names) (al/al-new [(slice u8)] a)
        lines (str/str-split a text "\n")
        (mut active) false
        (mut collecting) 0
        (mut i) 0
        (mut header) (str/sb-new a)]
    (str/sb-push-str! (mut header) "c.")
    (str/sb-push-str! (mut header) name)
    (let [wanted (str/sb-str (load (mut header)))]
      (loop (if (>= (load i) (al/al-len [(slice u8)] lines))
                (break)
                (let [line (trim (al/al-get [(slice u8)] lines (load i)))]
                  (if (and (> (slice-len line) 1)
                           (= (primitive/cast i64 (slice-get line 0)) 91))
                      (let [close (byte-index line 93)]
                        (store! active
                                (and (> close 1)
                                     (str/str-eq (trim (subslice line 1 close)) wanted)))
                        (store! collecting 0))
                      (if (load active)
                          (let [eq (byte-index line 61)]
                            ;; An '=' inside a quoted array element belongs to
                            ;; that value (notably NAME=value compiler defines),
                            ;; not to a new TOML key.
                            (if (and (>= eq 0) (= (load collecting) 0))
                                (let [key (trim (subslice line 0 eq))]
                                  (cond (str/str-eq key "sources") (store! collecting 1)
                                        (str/str-eq key "include-paths") (store! collecting 2)
                                        (str/str-eq key "defines") (store! collecting 3)
                                        (str/str-eq key "prefixes") (store! collecting 4)
                                        (str/str-eq key "module-name") (store! collecting 6)
                                        (str/str-eq key "header-defines")
                                          (do (store! collecting 5) (store! has-header-defines true))
                                        (str/str-eq key "generated-modules")
                                          (store! generated-modules
                                            (str/str-eq (trim (subslice line (+ eq 1) (slice-len line))) "true"))
                                        :else (store! collecting 0)))
                                0)
                            (cond (= (load collecting) 1) (quoted-values! line (mut sources))
                                  (= (load collecting) 2) (quoted-values! line (mut includes))
                                  (= (load collecting) 3) (quoted-values! line (mut defines))
                                  (= (load collecting) 4) (quoted-values! line (mut prefixes))
                                  (= (load collecting) 5) (quoted-values! line (mut header-defines))
                                  (= (load collecting) 6) (quoted-values! line (mut module-names))
                                  :else 0)
                            ;; module-name is a scalar: its value is on its own
                            ;; line, and no `]` ends it.
                            (if (or (>= (byte-index line 93) 0) (= (load collecting) 6))
                                (store! collecting 0)
                                0))
                          0))
                  (store! i (+ (load i) 1)))))
      (if (= (al/al-len [(slice u8)] (load (mut sources))) 0)
          (primitive/error "C manifest module has no sources")
          0)
      (load (CModuleConfig
              :sources (load (mut sources))
              :includes (load (mut includes))
              :defines (load (mut defines))
              :header-defines (load (mut header-defines))
              :has-header-defines (load has-header-defines)
              :generated-modules (load generated-modules)
              :prefixes (load (mut prefixes))
              :module-names (load (mut module-names)))))))

;;; A manifest path relative to the manifest's own directory, as Cargo and
;;; every other build tool reads one: the same Coil.toml means the same files
;;; whether its package is built on its own or read from inside a consumer.
(defn anchor-path [(a (dyn alloc/Allocator)) (base (slice u8)) (path (slice u8))] (-> (slice u8))
  (if (or (= (slice-len path) 0) (= (primitive/cast i64 (slice-get path 0)) 47))
      path
      (let [(mut b) (str/sb-new a)]
        (str/sb-push-str! (mut b) base)
        (str/sb-push-str! (mut b) "/")
        (str/sb-push-str! (mut b) path)
        (str/sb-str (load (mut b))))))

(defn anchor-paths [(a (dyn alloc/Allocator)) (base (slice u8)) (paths (al/ArrayList (slice u8)))]
  (-> (al/ArrayList (slice u8)))
  (let [(mut out) (al/al-new [(slice u8)] a)]
    (for [i 0 (al/al-len [(slice u8)] paths)]
      (al/al-push! [(slice u8)] (mut out) (anchor-path a base (al/al-get [(slice u8)] paths i)))
      0)
    (load (mut out))))

;;; The directory holding `manifest` ("." for a bare file name).
(defn manifest-dir [(manifest (slice u8))] (-> (slice u8))
  (let [(mut cut) -1]
    (for [i 0 (slice-len manifest)]
      (when (= (primitive/cast i64 (slice-get manifest i)) 47) (store! cut i) 0)
      0)
    (if (< (load cut) 0) "." (subslice manifest 0 (load cut)))))

(defn read-c-module [(context Code)] (-> Code)
  (let [a (expansion-allocator)
        path (primitive/code-str (primitive/code-nth context 1))
        ;; The manifest of the package that owns this header: a dependency's own
        ;; Coil.toml even when a consumer imports it from source. Older compilers
        ;; pass no package; they only ever built this from the package's own
        ;; directory, where COIL_MANIFEST_PATH named it.
        owned (read-context-manifest context)
        env (getenv c"COIL_MANIFEST_PATH")
        manifest-path (cond (> (slice-len owned) 0) owned
                            (!= (primitive/cast i64 env) 0) (str/cstr->str env)
                            :else "")]
    (if (= (slice-len manifest-path) 0)
        (primitive/error "C reader requires a Coil.toml manifest")
        (let [manifest
                (match (fs/read-file a manifest-path)
                  (Ok [text] text)
                  (Err [_] (primitive/error "C reader cannot read Coil.toml")))
              base (manifest-dir manifest-path)
              parsed (parse-config a manifest (basename-without-extension path))
              config (load (CModuleConfig
                       :sources (anchor-paths a base (.sources parsed))
                       :includes (anchor-paths a base (.includes parsed))
                       :defines (.defines parsed)
                       :header-defines (.header-defines parsed)
                       :has-header-defines (.has-header-defines parsed)
                       :generated-modules (.generated-modules parsed)
                       :prefixes (anchor-paths a base (.prefixes parsed))
                       :module-names (.module-names parsed)))
              opts
                (load (cc/Options
                        :inputs (.sources config)
                        :output ""
                        :includes (.includes config)
                        :defines (.defines config)
                        :prefixes (.prefixes config)
                        :public-header path
                        :library true
                        :module-name
                          (if (> (al/al-len [(slice u8)] (.module-names config)) 0)
                              (al/al-get [(slice u8)] (.module-names config) 0)
                              "")))
              _log (pp/input-log-start!)
              generated
                (if (.generated-modules config)
                    (cc/lower-partitioned-with-header-defines a opts
                      (.header-defines config) (.has-header-defines config))
                    (cc/lower-text-with-header-defines a
                                                   opts
                                                   (.header-defines config)
                                                   (.has-header-defines config)))
              ;; Everything the lowering read -- the package manifest, the sources,
              ;; every header -- is this module's input: Coil keys a prebuilt unit
              ;; on it, so editing any of them rebuilds the unit.
              inputs (pp/input-log-take!)
              (mut text) (str/sb-new a)]
          (str/sb-push-str! (mut text) generated)
          ;; A compiler that passes the package manifest knows `depends-on`; an
          ;; older one would reject the form.
          (when (> (slice-len owned) 0)
            (str/sb-push-str! (mut text) "\n(depends-on ")
            (push-string-literal! (mut text) manifest-path)
            (for [i 0 (al/al-len [(slice u8)] inputs)]
              (str/sb-push-str! (mut text) " ")
              (push-string-literal! (mut text) (al/al-get [(slice u8)] inputs i))
              0)
            (str/sb-push-str! (mut text) ")\n")
            0)
          (primitive/code-read (str/sb-str (load (mut text))) `(reader-config))))))

(defn push-string-literal! [(b (mut str/StrBuf)) (s (slice u8))] (-> i64)
  (str/sb-push-str! (mut b) "\"")
  (for [i 0 (slice-len s)]
    (let [c (primitive/cast i64 (slice-get s i))]
      (when (or (= c 34) (= c 92)) (str/sb-push-str! (mut b) "\\") 0)
      (str/sb-push-byte! (mut b) (primitive/cast u8 c)))
    0)
  (str/sb-push-str! (mut b) "\"")
  0)
