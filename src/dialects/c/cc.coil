;; The native C compiler driver: tokenize, preprocess, parse, lower.
;;
;;   coil run src/dialects/c/cc.coil -- -o out.coil a.c b.c ... \
;;     [--library --module NAME] \
;;     [-Ipath ...] [-Fpath ...] [-Dname[=value] ...] [-include path ...]
;;
;; Every translation unit is preprocessed and parsed on its own -- a macro
;; defined in one file means nothing in the next -- and then all of them are
;; lowered together into a single Coil module. That is what lets a call in one
;; file reach a definition in another without a linker of our own: the whole
;; program is one module, and a `static` name carries its unit's tag so that two
;; files may each have their own.
;;
;; The target's predefined macros live in a header of their own
;; (src/dialects/c/target/), which the caller force-includes with -include.
;;
;; Clang is not involved at any point. The result is ordinary Coil, which
;; `coil build` turns into an executable.
(module experiments.c.cc)
(import "coil.compiler.trace" :as tr)
(import "experiments.c.profile" :as prof)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "coil.slice" :use *)
(import "coil.str" :as str)
(import "coil.fs" :as fs)
(import "coil.io" :as io)
(import "coil.os" :as os)
(import "coil.result" :use *)
(import "coil.scratch" :as scratch)
(import "coil.meta" :as meta)
(import "experiments.c.lex" :as lex)
(import "experiments.c.node" :as nd)
(import "experiments.c.ctype" :as ct)
(import "experiments.c.pp" :as pp)
(import "experiments.c.parse" :as ps)
(import "experiments.c.emit" :as em)
(import "experiments.c.partition" :as part)

(export Options setup-pp! compile-unit! lower-text lower-text-with-header-defines
        lower-partitioned-with-header-defines run-cli)

(defstruct Options
  [(inputs (al/ArrayList (slice u8)))
   (output (slice u8))
   (includes (al/ArrayList (slice u8)))
   (defines (al/ArrayList (slice u8)))
   ;; Headers read ahead of every translation unit, as `-include` does. This is
   ;; how the target description reaches the preprocessor.
   (prefixes (al/ArrayList (slice u8)))
   ;; When present, declarations in this header define a generated library's
   ;; public functions and data. The implementation sources still supply bodies.
   (public-header (slice u8))
   (library bool)
   (module-name (slice u8))])

(defn report [(stage (slice u8))
              (message (slice u8))
              (file (slice u8))
              (line i64)] (-> i64)
  (println "{s}:{d}: {s}: {s}" file line stage message)
  0)

;;; The part of a path that names the file, without directories or extension.
;;; This becomes the tag on the unit's `static` names, so it has to be the same
;;; every time the same file is compiled and different for different files.
(defn unit-tag [(path (slice u8))] (-> (slice u8))
  (let [n (slice-len path)
        (mut start) 0
        (mut end) n
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (if (= (primitive/cast i64 (slice-get path (load i))) 47)
                    (store! start (+ (load i) 1))
                    0)
                (if (= (primitive/cast i64 (slice-get path (load i))) 46)
                    (store! end (load i))
                    0)
                (store! i (+ (load i) 1)))))
    (if (<= (load end) (load start))
        (subslice path (load start) n)
        (subslice path (load start) (load end)))))

;;; Reads each prefix header through the same preprocessor the unit will use, so
;;; its definitions are in scope by the time the first real line is read.
(defn read-prefixes! [(p (mut pp/PP))
                      (a (dyn alloc/Allocator))
                      (prefixes (al/ArrayList (slice u8)))] (-> i64)
  (let [n (al/al-len [(slice u8)] prefixes)
        (mut i) 0
        (mut bad) 0]
    (loop (if (or (>= (load i) n) (!= (load bad) 0))
              (break)
              (let [path (al/al-get [(slice u8)] prefixes (load i))]
                (match (fs/read-file a path)
                  (Err [_] (do (println "cannot read {s}" path) (store! bad 1)))
                  (Ok [text]
                      (let [pre (pp/pp-read-prefix (mut p) path text)]
                        (if (!= (.failed pre) 0)
                            (do
                              (report "preprocessor" (.message pre) (.file pre) (.line pre))
                              (store! bad 1))
                            0))))
                (store! i (+ (load i) 1)))))
    (load bad)))

(defn setup-pp-with-defines! [(p (mut pp/PP))
                              (a (dyn alloc/Allocator))
                              (opts Options)
                              (defines (al/ArrayList (slice u8)))] (-> i64)
  (let [includes (.includes opts)
        n (al/al-len [(slice u8)] includes)
        dn (al/al-len [(slice u8)] defines)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (pp/pp-add-include-path (mut p) (al/al-get [(slice u8)] includes (load i)))
                (store! i (+ (load i) 1)))))
    (store! i 0)
    (loop (if (>= (load i) dn)
              (break)
              (do
                (pp/pp-define-text (mut p) (al/al-get [(slice u8)] defines (load i)))
                (store! i (+ (load i) 1)))))
    (read-prefixes! (mut p) a (.prefixes opts))))

(defn setup-pp! [(p (mut pp/PP)) (a (dyn alloc/Allocator)) (opts Options)] (-> i64)
  (setup-pp-with-defines! (mut p) a opts (.defines opts)))

;;; Parses one unit and appends what it declared to the whole program.
(defn compile-unit! [(a (dyn alloc/Allocator))
                     (opts Options)
                     (defines (al/ArrayList (slice u8)))
                     (path (slice u8))
                     (globals (mut (al/ArrayList (ptr nd/Obj))))
                     (init (ptr nd/Node))] (-> i64)
  (compile-unit-tag! a opts defines path (unit-tag path) (mut globals) init))

(defn compile-unit-tag! [(a (dyn alloc/Allocator)) (opts Options)
                         (defines (al/ArrayList (slice u8))) (path (slice u8))
                         (tag (slice u8)) (globals (mut (al/ArrayList (ptr nd/Obj))))
                         (init (ptr nd/Node))] (-> i64)
  (match (fs/read-file a path)
    (Err [_] (do (println "cannot read {s}" path) 1))
    (Ok [source]
        (let [(mut p) (pp/pp-new a)
              setup-span (tr/span-begin "c.prefix")
              setup-result (setup-pp-with-defines! (mut p) a opts defines)
              _setup-end (tr/span-end setup-span)]
          (if (!= setup-result 0)
              1
              (let [pp-span (tr/span-begin "c.preprocess")
                    pre (pp/preprocess (mut p) path source)
                    _pp-end (tr/span-end pp-span)
                    _token-count (tr/count "c.preprocessed-tokens" (al/al-len [lex/Token] (.tokens pre)))]
                (if (!= (.failed pre) 0)
                    (do (report "preprocessor" (.message pre) (.file pre) (.line pre)) 1)
                    (let [parse-span (tr/span-begin "c.parse")
                          (mut parser) (ps/parser-new a (.tokens pre) tag)
                          parsed (ps/parse (mut parser))
                          _parse-end (tr/span-end parse-span)]
                      (if (!= (.failed parsed) 0)
                          (do (report "error" (.message parsed) (.file parsed) (.line parsed)) 1)
                          (let [own (.globals parsed)
                                n (al/al-len [(ptr nd/Obj)] own)
                                (mut i) 0]
                            (loop (if (>= (load i) n)
                                      (break)
                                      (do
                                        (al/al-push! [(ptr nd/Obj)]
                                                     (mut globals)
                                                     (al/al-get [(ptr nd/Obj)] own (load i)))
                                        (store! i (+ (load i) 1)))))
                            (nd/push-body! init (.init parsed))
                            0))))))))))

(defn compile [(a (dyn alloc/Allocator)) (opts Options)] (-> i64)
  (let [(mut globals) (al/al-new [(ptr nd/Obj)] a)
        init (nd/node-new a nd/ND-BLOCK (lex/token-none))
        inputs (.inputs opts)
        n (al/al-len [(slice u8)] inputs)
        (mut i) 0
        (mut bad) 0]
    (loop (if (or (>= (load i) n) (!= (load bad) 0))
              (break)
              (do
                (store! bad
                        (compile-unit! a
                                       opts
                                       (.defines opts)
                                       (al/al-get [(slice u8)] inputs (load i))
                                       (mut globals)
                                       init))
                (store! i (+ (load i) 1)))))
    (if (!= (load bad) 0)
        1
        (let [emitted
                (em/emit-module a
                                (load (mut globals))
                                init
                                (.module-name opts)
                                (not (.library opts))
                                (al/al-new [(slice u8)] a))]
          (if (!= (.failed emitted) 0)
              (do (report "error" (.message emitted) (.file emitted) (.line emitted)) 1)
              (match (fs/write-file a (.output opts) (.text emitted))
                (Err [_] (do (println "cannot write {s}" (.output opts)) 1))
                (Ok [_] 0)))))))

;;; In-memory entry used by source readers. It is the same multi-translation-unit
;;; pipeline as the command-line driver, without materializing generated Coil.
(defn lower-text-with-header-defines [(a (dyn alloc/Allocator))
                                      (opts Options)
                                      (header-defines (al/ArrayList (slice u8)))
                                      (has-header-defines bool)] (-> (slice u8))
  (let [(mut globals) (al/al-new [(ptr nd/Obj)] a)
        (mut public-names) (al/al-new [(slice u8)] a)
        init (nd/node-new a nd/ND-BLOCK (lex/token-none))
        inputs (.inputs opts)
        n (al/al-len [(slice u8)] inputs)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (if (!= (compile-unit! a
                                       opts
                                       (.defines opts)
                                       (al/al-get [(slice u8)] inputs (load i))
                                       (mut globals)
                                       init)
                        0)
                    (primitive/error "C module compilation failed")
                    0)
                (store! i (+ (load i) 1)))))
    (if (> (slice-len (.public-header opts)) 0)
        (let [(mut declarations) (al/al-new [(ptr nd/Obj)] a)
              header-init (nd/node-new a nd/ND-BLOCK (lex/token-none))]
          (if (!= (compile-unit! a
                                 opts
                                 (if has-header-defines header-defines (.defines opts))
                                 (.public-header opts)
                                 (mut declarations)
                                 header-init)
                  0)
              (primitive/error "C public header compilation failed")
              0)
          (for [di 0 (al/al-len [(ptr nd/Obj)] (load (mut declarations)))]
            (let [decl (al/al-get [(ptr nd/Obj)] (load (mut declarations)) di)]
              (if (and (not (nd/obj-static? decl)) (not (nd/obj-string? decl)))
                  (al/al-push! [(slice u8)] (mut public-names) (nd/obj-name decl))
                  0))
            0))
        0)
    (let [emitted
            (em/emit-module a
                            (load (mut globals))
                            init
                            (.module-name opts)
                            (not (.library opts))
                            (load (mut public-names)))]
      (if (!= (.failed emitted) 0)
          (primitive/error (.message emitted))
          (.text emitted)))))

(defn lower-text [(a (dyn alloc/Allocator)) (opts Options)] (-> (slice u8))
  (lower-text-with-header-defines a opts (.defines opts) false))

;; Only this opt-in path partitions a C program. Pass one retains copied linkage
;; names and scalar ownership metadata; pass two submits each source immediately.
;; Every token, C type, AST node and generated body lives in one resettable arena.
(defn lower-partitioned-with-header-defines [(a (dyn alloc/Allocator)) (opts Options)
                                            (header-defines (al/ArrayList (slice u8)))
                                            (has-header-defines bool)] (-> (slice u8))
  (let [(mut plan) (part/plan-new a (.public-header opts))
        inputs (.inputs opts) n (al/al-len [(slice u8)] inputs)
        arena (primitive/alloc-stack scratch/ScratchArena)
        ignored (scratch/scratch-init-with-cap arena (alloc/malloc-allocator) 65536)
        sa (scratch/scratch-allocator arena)
        stats (primitive/alloc-stack prof/Stats)
        (mut facade) (str/sb-new a)]
    (tr/count "c.sizeof.Node" (primitive/sizeof nd/Node))
    (tr/count "c.sizeof.Type" (primitive/sizeof ct/Type))
    (tr/count "c.sizeof.Obj" (primitive/sizeof nd/Obj))
    (tr/count "c.sizeof.Token" (primitive/sizeof lex/Token))
    (for [i 0 n]
      (al/al-push! [(slice u8)] (mut (.units (mut plan))) (part/unit-name (mut plan) i)) 0)
    (for [i 0 n]
      (prof/open! stats (al/al-get [(slice u8)] inputs i) "ownership" arena)
      (let [(mut globals) (al/al-new [(ptr nd/Obj)] sa)
            init (nd/node-new sa nd/ND-BLOCK (lex/token-none))]
        (when (!= (compile-unit-tag! sa opts (.defines opts)
                    (al/al-get [(slice u8)] inputs i)
                    (al/al-get [(slice u8)] (.units plan) i) (mut globals) init) 0)
          (scratch/scratch-close! arena)
          (primitive/error "C partition ownership pass failed") 0)
        (let [span (tr/span-begin "c.ownership")]
          (part/record-unit! (mut plan) i (load (mut globals)))
          (em/record-partition-types! sa (load (mut globals)) (mut plan) i)
          (tr/span-end span)))
      (prof/close! stats)
      (scratch/scratch-reset! arena) 0)
    (let [(mut body) (str/sb-new sa)]
      (str/sb-push-str! (mut body) "(module ")
      (str/sb-push-str! (mut body) (part/type-module-name (mut plan)))
      (str/sb-push-str! (mut body) ")\n")
      (meta/generated-unit! (part/type-module-name (mut plan))
        (em/emit-type-interface sa (mut plan)) (str/sb-str (load (mut body)))))
    (scratch/scratch-reset! arena)
    (for [i 0 n]
      (prof/open! stats (al/al-get [(slice u8)] inputs i) "implementation" arena)
      (let [(mut globals) (al/al-new [(ptr nd/Obj)] sa)
            init (nd/node-new sa nd/ND-BLOCK (lex/token-none))
            (mut interface) (str/sb-new sa)]
        (when (!= (compile-unit-tag! sa opts (.defines opts)
                    (al/al-get [(slice u8)] inputs i)
                    (al/al-get [(slice u8)] (.units plan) i) (mut globals) init) 0)
          (scratch/scratch-close! arena)
          (primitive/error "C partition implementation pass failed") 0)
        (let [emit-span (tr/span-begin "c.emit-coil")
              emitted (em/emit-partition sa (load (mut globals)) init (mut plan) i (mut interface))
              _emit-end (tr/span-end emit-span)]
          (when (!= (.failed emitted) 0)
            (report "error" (.message emitted) (.file emitted) (.line emitted))
            (scratch/scratch-close! arena)
            (primitive/error "C partition lowering failed") 0)
          (tr/count "c.interface-bytes" (slice-len (str/sb-str (load (mut interface)))))
          (tr/count "c.body-bytes" (slice-len (.text emitted)))
          (let [registration-span (tr/span-begin "c.register-interface")]
            (meta/generated-unit! (al/al-get [(slice u8)] (.units plan) i)
                                  (str/sb-str (load (mut interface))) (.text emitted))
            (tr/span-end registration-span))))
      (prof/close! stats)
      (scratch/scratch-reset! arena) 0)
    (str/sb-push-str! (mut facade) "(import \"coil.primitive\" :use *)\n")
    (for [i 0 n]
      (str/sb-push-str! (mut facade) "(import \"")
      (str/sb-push-str! (mut facade) (al/al-get [(slice u8)] (.units plan) i))
      (str/sb-push-str! (mut facade) "\" :as u") (str/sb-push-i64! (mut facade) i)
      (str/sb-push-str! (mut facade) ")\n") 0)
    (let [(mut declarations) (al/al-new [(ptr nd/Obj)] sa)
          init (nd/node-new sa nd/ND-BLOCK (lex/token-none))]
      (when (!= (compile-unit! sa opts
                  (if has-header-defines header-defines (.defines opts))
                  (.public-header opts) (mut declarations) init) 0)
        (scratch/scratch-close! arena)
        (primitive/error "C partition public header compilation failed") 0)
      (for [i 0 (al/al-len [(ptr nd/Obj)] (load (mut declarations)))]
        (let [o (al/al-get [(ptr nd/Obj)] (load (mut declarations)) i)
              owner (part/function-owner (mut plan) (nd/obj-name o))]
          (when (and (not (nd/obj-static? o)) (not (nd/obj-string? o)))
            (when (!= (ct/ty-kind (nd/obj-type o)) ct/TY-FUNC)
              (println "C partition public data: {s}" (nd/obj-name o))
              (primitive/error "C partition public data requires an explicit accessor function") 0)
            (when (< owner 0)
              (primitive/error "C partition public function has no implementation owner") 0)
            (str/sb-push-str! (mut facade) (em/emit-public-wrapper sa o owner)) 0)) 0))
    (scratch/scratch-close! arena)
    (str/sb-push-str! (mut facade) "(export initialize-c-library)\n(extern atexit :cc c [(fnptr c [] void)] (-> i32))\n(defn initialize-c-library [] (-> i64) (do")
    (for [i 0 n]
      (str/sb-push-str! (mut facade) " (u") (str/sb-push-i64! (mut facade) i)
      (str/sb-push-str! (mut facade) "/")
      (str/sb-push-str! (mut facade) (part/initializer-name (mut plan) i))
      (str/sb-push-str! (mut facade) ")") 0)
    ;; All static initialization precedes any constructor. Destructors register
    ;; in priority order, matching the existing frontend's reverse atexit order.
    (for [kind nd/AT-CONSTRUCTOR (+ nd/AT-DESTRUCTOR 1)]
      (let [wanted (if (= kind nd/AT-CONSTRUCTOR) nd/AT-DESTRUCTOR nd/AT-CONSTRUCTOR)]
        (for [i 0 (al/al-len [part/Startup] (.starts plan))]
          (let [entry (al/al-elem [part/Startup] (field (mut plan) starts) i)]
            (when (= (.kind entry) wanted)
              (str/sb-push-str! (mut facade) (if (= wanted nd/AT-DESTRUCTOR) " (atexit (fnptr-of u" " (u"))
              (str/sb-push-i64! (mut facade) (.unit entry))
              (str/sb-push-str! (mut facade) "/")
              (str/sb-push-str! (mut facade) (em/partition-function-name a (.name entry)))
              (str/sb-push-str! (mut facade) (if (= wanted nd/AT-DESTRUCTOR) "))" ")")) 0)) 0)) 0)
    (str/sb-push-str! (mut facade) " 0))\n")
    (str/sb-str (load (mut facade)))))

;;; True when `arg` begins with the one-letter flag `letter`, which is how the C
;;; compiler flags that take an attached value are spelled.
(defn flag? [(arg (slice u8)) (letter i64)] (-> bool)
  (and (>= (slice-len arg) 2)
       (and (= (primitive/cast i64 (slice-get arg 0)) 45)
            (= (primitive/cast i64 (slice-get arg 1)) letter))))

(defn flag-value [(arg (slice u8))] (-> (slice u8))
  (subslice arg 2 (slice-len arg)))

(defn arg-at [(argv (ptr (ptr i8))) (i i64)] (-> (slice u8))
  (str/cstr->str (load (primitive/index argv i))))

(defn run-cli [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [a (alloc/malloc-allocator)
        (mut inputs) (al/al-new [(slice u8)] a)
        (mut includes) (al/al-new [(slice u8)] a)
        (mut defines) (al/al-new [(slice u8)] a)
        (mut prefixes) (al/al-new [(slice u8)] a)
        (mut output) ""
        (mut library) false
        (mut module-name) "c_program"
        (mut i) 1
        n (primitive/cast i64 argc)]
    (loop (if (>= (load i) n)
              (break)
              (let [arg (arg-at argv (load i))]
                (cond (str/str-eq arg "-include")
                        (do
                          (store! i (+ (load i) 1))
                          (if (< (load i) n)
                              (al/al-push! [(slice u8)] (mut prefixes) (arg-at argv (load i)))
                              0))
                      (str/str-eq arg "-o")
                        (do
                          (store! i (+ (load i) 1))
                          (if (< (load i) n) (store! output (arg-at argv (load i))) 0))
                      (str/str-eq arg "--library") (store! library true)
                      (str/str-eq arg "--module")
                        (do
                          (store! i (+ (load i) 1))
                          (if (< (load i) n) (store! module-name (arg-at argv (load i))) 0))
                      (flag? arg 73) (al/al-push! [(slice u8)] (mut includes) (flag-value arg))
                      (flag? arg 70) (al/al-push! [(slice u8)] (mut includes) (flag-value arg))
                      (flag? arg 68) (al/al-push! [(slice u8)] (mut defines) (flag-value arg))
                      :else (al/al-push! [(slice u8)] (mut inputs) arg))
                (store! i (+ (load i) 1)))))
    (if (or (= (al/al-len [(slice u8)] (load (mut inputs))) 0)
            (= (slice-len (load output)) 0))
        (do
          (println "usage: cc -o OUT.coil IN.c... [--library --module NAME] [-Ipath] [-Fpath] [-Dname=value] [-include path]")
          2)
        (compile a
                 (load (Options
                         :inputs (load (mut inputs))
                         :output (load output)
                         :includes (load (mut includes))
                         :defines (load (mut defines))
                         :prefixes (load (mut prefixes))
                         :public-header ""
                         :library (load library)
                         :module-name (load module-name)))))))
