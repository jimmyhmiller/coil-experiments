;; The native C compiler driver: tokenize, preprocess, parse, lower.
;;
;;   coil run src/dialects/c/cc.coil -- input.c output.coil [-Ipath ...]
;;
;; Clang is not involved at any point. The result is ordinary Coil, which
;; `coil build` turns into an executable.
(module experiments.c.cc)

(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "coil.slice" :use *)
(import "coil.str" :as str)
(import "coil.fs" :as fs)
(import "coil.io" :as io)
(import "coil.os" :as os)
(import "coil.result" :use *)
(import "experiments.c.pp" :as pp)
(import "experiments.c.parse" :as ps)
(import "experiments.c.emit" :as em)

(extern strlen :cc c [(ptr i8)] (-> i64))

(defn report [(stage (slice u8))
              (message (slice u8))
              (file (slice u8))
              (line i64)] (-> i64)
  (println "{s}:{d}: {s}: {s}" file line stage message)
  0)

(defn compile-file [(a (dyn alloc/Allocator))
                    (input (slice u8))
                    (output (slice u8))
                    (includes (al/ArrayList (slice u8)))] (-> i64)
  (match (fs/read-file a input)
    (Err [_] (do (println "cannot read {s}" input) 1))
    (Ok [source]
        (let [(mut p) (pp/pp-new a)
              (mut i) 0
              n (al/al-len [(slice u8)] includes)]
          (loop (if (>= (load i) n)
                    (break)
                    (do
                      (pp/pp-add-include-path (mut p) (al/al-get [(slice u8)] includes (load i)))
                      (store! i (+ (load i) 1)))))
          (let [pre (pp/preprocess (mut p) input source)]
            (if (!= (.failed pre) 0)
                (do (report "preprocessor" (.message pre) (.file pre) (.line pre)) 1)
                (let [(mut parser) (ps/parser-new a (.tokens pre))
                      parsed (ps/parse (mut parser))]
                  (if (!= (.failed parsed) 0)
                      (do (report "error" (.message parsed) (.file parsed) (.line parsed)) 1)
                      (let [emitted (em/emit-program a (.globals parsed))]
                        (if (!= (.failed emitted) 0)
                            (do (report "error" (.message emitted) (.file emitted) (.line emitted)) 1)
                            (match (fs/write-file a output (.text emitted))
                              (Err [_] (do (println "cannot write {s}" output) 1))
                              (Ok [_] 0))))))))))))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [a (alloc/malloc-allocator)
        (mut includes) (al/al-new [(slice u8)] a)
        (mut input) ""
        (mut output) ""
        (mut i) 1
        n (primitive/cast i64 argc)]
    (loop
      (if (>= (load i) n)
          (break)
          (let [arg (str/cstr->str (load (primitive/index argv (load i))))]
            (cond
              (and (>= (slice-len arg) 2)
                   (and (= (primitive/cast i64 (slice-get arg 0)) 45)
                        (= (primitive/cast i64 (slice-get arg 1)) 73)))
                (al/al-push! [(slice u8)] (mut includes) (subslice arg 2 (slice-len arg)))
              (= (slice-len (load input)) 0) (store! input arg)
              :else (store! output arg))
            (store! i (+ (load i) 1)))))
    (if (or (= (slice-len (load input)) 0) (= (slice-len (load output)) 0))
        (do (println "usage: cc INPUT.c OUTPUT.coil [-Ipath ...]") 2)
        (compile-file a (load input) (load output) (load (mut includes))))))
