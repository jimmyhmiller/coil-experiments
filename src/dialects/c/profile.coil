(module experiments.c.profile)
(import "coil.primitive" :as primitive)
(import "coil.scratch" :as scratch)
(import "coil.compiler.trace" :as tr)
(import "coil.compiler.mtrace" :as mt)

;; Development observations only. Each C source/pass binds a stack-owned record;
;; nesting restores the previous record and the previous allocator meter.
(defstruct Stats
  [(prior (ptr Stats)) (prior-meter mt/MtraceUnitState) (on bool)
   (path (slice u8)) (pass (slice u8)) (arena (ptr scratch/ScratchArena))
   (started i64) (nodes i64) (types i64) (objects i64) (initializers i64)
   (typed-bytes i64) (initializer-bytes i64)])
(defn active [] (-> (ptr (ptr Stats))) (primitive/alloc-static (ptr Stats)))
(defn retained-now [] (-> i64)
  (let [s (load (active))]
    (if (or (= (primitive/cast i64 s) 0) (= (primitive/cast i64 (.arena s)) 0))
      0 (scratch/scratch-total (.arena s)))))
(defn memory-now [(raw (ptr i8))] (-> i64)
  (scratch/scratch-total (primitive/cast (ptr scratch/ScratchArena) raw)))
(defn open! [(s (ptr Stats)) (path (slice u8)) (pass (slice u8))
              (arena (ptr scratch/ScratchArena))] (-> i64)
  (set! s (primitive/zeroed Stats))
  (set! (.on s) (tr/trace-enabled?))
  (set! (.prior s) (load (active)))
  (set! (.prior-meter s) (load (mt/mtrace-unit-state)))
  (set! (.path s) path) (set! (.pass s) pass) (set! (.arena s) arena)
  (set! (.started s) (tr/trace-now-ms))
  (when (.on s)
    (set! (active) s)
    (mt/mtrace-mem-bind! (primitive/cast (ptr i8) arena) (primitive/fnptr-of memory-now))
    (set! (.profile_arena (mt/mtrace-unit-state)) arena)
    (tr/profile-event "c.begin" path (.started s))
    (tr/profile-event "c.pass" pass 0) 0)
  0)
(defn close! [(s (ptr Stats))] (-> i64)
  (when (.on s)
    (tr/count "c.Node.count" (.nodes s)) (tr/count "c.Type.count" (.types s))
    (tr/count "c.Obj.count" (.objects s)) (tr/count "c.Init.count" (.initializers s))
    (tr/count "c.typed-allocation-bytes" (.typed-bytes s))
    (tr/count "c.Init.bytes" (.initializer-bytes s))
    (tr/arena-snapshot (.path s) (.arena s))
    (tr/profile-event "c.end" (.path s) (- (tr/trace-now-ms) (.started s)))
    (set! (active) (.prior s))
    (set! (mt/mtrace-unit-state) (.prior-meter s)) 0)
  0)
(defn allocation! [(kind i64) (bytes i64)] (-> i64)
  (let [s (load (active))]
    (unless (= (primitive/cast i64 s) 0)
      (set! (.typed-bytes s) (+ (.typed-bytes s) bytes))
      (cond (= kind 0) (set! (.nodes s) (+ (.nodes s) 1))
            (= kind 1) (set! (.types s) (+ (.types s) 1))
            (= kind 2) (set! (.objects s) (+ (.objects s) 1))
            :else (do (set! (.initializers s) (+ (.initializers s) 1))
                      (set! (.initializer-bytes s) (+ (.initializer-bytes s) bytes)))) 0))
  0)
