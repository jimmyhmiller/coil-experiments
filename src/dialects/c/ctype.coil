;; C types and record layout. Ported from chibicc by Rui Ueyama (MIT) -- see
;; ATTRIBUTION.md.
;;
;; Layout is computed here rather than inferred downstream, which is the whole
;; point of the exercise: the Clang-based frontend emits a union as its first
;; member and has no bitfield handling at all, so it silently gets both sizes
;; wrong. Offsets, sizes, alignments, bit offsets, and bit widths are all
;; decided in `layout-record!` below and carried on the type.
(module experiments.c.ctype)

(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "coil.slice" :use *)
(import "coil.str" :as str)

(export Type
        Member
        TY-VOID TY-BOOL TY-CHAR TY-SHORT TY-INT TY-LONG TY-FLOAT TY-DOUBLE
        TY-LDOUBLE TY-ENUM TY-PTR TY-FUNC TY-ARRAY TY-VLA TY-STRUCT TY-UNION
        TY-INT128 ty-int128
        ty-new ty-void ty-bool ty-char ty-short ty-int ty-long ty-uchar ty-ushort
        ty-uint ty-ulong ty-float ty-double
        ty-pointer-to ty-array-of ty-func-of ty-record
        ty-kind ty-size ty-align ty-unsigned? ty-base ty-array-len ty-name
        ty-members ty-params ty-param-names add-param! ty-variadic? ty-complete?
        integer? floating? numeric? pointer-like? record?
        add-member! layout-record! set-variadic! set-complete! set-name!
        set-array-len!
        member-name member-type member-offset member-bit-offset member-bit-width
        member-bitfield?
        align-to)

(const TY-VOID 0)
(const TY-BOOL 1)
(const TY-CHAR 2)
(const TY-SHORT 3)
(const TY-INT 4)
(const TY-LONG 5)
(const TY-FLOAT 6)
(const TY-DOUBLE 7)
(const TY-LDOUBLE 8)
(const TY-ENUM 9)
(const TY-PTR 10)
(const TY-FUNC 11)
(const TY-ARRAY 12)
(const TY-VLA 13)
(const TY-STRUCT 14)
(const TY-UNION 15)
;; A 128-bit integer exists so that system headers which declare one lay out
;; correctly. No arithmetic on it is generated: the lowerer reports it rather
;; than emitting something narrower.
(const TY-INT128 16)

;; `bit-width` is -1 for an ordinary member. A bitfield's `offset` names the
;; storage unit it lives in and `bit-offset` its position inside that unit.
(defstruct Member
  [(name (slice u8))
   (ty (ptr Type))
   (offset i64)
   (bit-offset i64)
   (bit-width i64)])

(defstruct Type
  [(kind i64)
   (size i64)
   (align i64)
   ;; i64 rather than bool: a bool struct field read back out of an ArrayList is
   ;; silently false at -O1 and above. See tests/coil-bugs/.
   (unsigned i64)
   (base (ptr Type))
   (array-len i64)
   (name (slice u8))
   (members (al/ArrayList Member))
   (params (al/ArrayList (ptr Type)))
   (param-names (al/ArrayList (slice u8)))
   (variadic i64)
   (complete i64)])

(defn ty-kind [(t (ptr Type))] (-> i64) (load (field t kind)))
(defn ty-size [(t (ptr Type))] (-> i64) (load (field t size)))
(defn ty-align [(t (ptr Type))] (-> i64) (load (field t align)))
(defn ty-unsigned? [(t (ptr Type))] (-> bool) (!= (load (field t unsigned)) 0))
(defn ty-base [(t (ptr Type))] (-> (ptr Type)) (load (field t base)))
(defn ty-array-len [(t (ptr Type))] (-> i64) (load (field t array-len)))
(defn ty-name [(t (ptr Type))] (-> (slice u8)) (load (field t name)))
(defn ty-members [(t (ptr Type))] (-> (al/ArrayList Member)) (load (field t members)))
(defn ty-params [(t (ptr Type))] (-> (al/ArrayList (ptr Type))) (load (field t params)))
(defn ty-param-names [(t (ptr Type))] (-> (al/ArrayList (slice u8))) (load (field t param-names)))
(defn add-param! [(t (ptr Type)) (name (slice u8)) (ty (ptr Type))] (-> i64)
  (al/al-push! [(ptr Type)] (mut (field t params)) ty)
  (al/al-push! [(slice u8)] (mut (field t param-names)) name)
  0)
(defn ty-variadic? [(t (ptr Type))] (-> bool) (!= (load (field t variadic)) 0))
(defn ty-complete? [(t (ptr Type))] (-> bool) (!= (load (field t complete)) 0))

(defn member-name [(m Member)] (-> (slice u8)) (.name m))
(defn member-type [(m Member)] (-> (ptr Type)) (.ty m))
(defn member-offset [(m Member)] (-> i64) (.offset m))
(defn member-bit-offset [(m Member)] (-> i64) (.bit-offset m))
(defn member-bit-width [(m Member)] (-> i64) (.bit-width m))
(defn member-bitfield? [(m Member)] (-> bool) (>= (.bit-width m) 0))

(defn integer? [(t (ptr Type))] (-> bool)
  (let [k (ty-kind t)]
    (or (= k TY-BOOL) (or (= k TY-CHAR) (or (= k TY-SHORT)
        (or (= k TY-INT) (or (= k TY-LONG) (= k TY-ENUM))))))))

(defn floating? [(t (ptr Type))] (-> bool)
  (let [k (ty-kind t)]
    (or (= k TY-FLOAT) (or (= k TY-DOUBLE) (= k TY-LDOUBLE)))))

(defn numeric? [(t (ptr Type))] (-> bool)
  (or (integer? t) (floating? t)))

(defn pointer-like? [(t (ptr Type))] (-> bool)
  (let [k (ty-kind t)]
    (or (= k TY-PTR) (or (= k TY-ARRAY) (= k TY-VLA)))))

(defn record? [(t (ptr Type))] (-> bool)
  (let [k (ty-kind t)]
    (or (= k TY-STRUCT) (= k TY-UNION))))

(defn align-to [(n i64) (align i64)] (-> i64)
  (if (<= align 1)
      n
      (* (primitive/idiv (+ n (- align 1)) align) align)))

(defn ty-new [(a (dyn alloc/Allocator)) (kind i64) (size i64) (align i64)] (-> (ptr Type))
  (alloc/box! a
              Type
              (load (Type :kind kind
                      :size size
                      :align align
                      :unsigned 0
                      :base (primitive/cast (ptr Type) 0)
                      :array-len -1
                      :name ""
                      :members (al/al-new [Member] a)
                      :params (al/al-new [(ptr Type)] a)
                      :param-names (al/al-new [(slice u8)] a)
                      :variadic 0
                      :complete 1))))

(defn ty-unsigned-new [(a (dyn alloc/Allocator)) (kind i64) (size i64)] (-> (ptr Type))
  (let [t (ty-new a kind size size)]
    (store! (field t unsigned) 1)
    t))

(defn ty-void [(a (dyn alloc/Allocator))] (-> (ptr Type)) (ty-new a TY-VOID 1 1))
(defn ty-bool [(a (dyn alloc/Allocator))] (-> (ptr Type)) (ty-new a TY-BOOL 1 1))
(defn ty-char [(a (dyn alloc/Allocator))] (-> (ptr Type)) (ty-new a TY-CHAR 1 1))
(defn ty-short [(a (dyn alloc/Allocator))] (-> (ptr Type)) (ty-new a TY-SHORT 2 2))
(defn ty-int [(a (dyn alloc/Allocator))] (-> (ptr Type)) (ty-new a TY-INT 4 4))
(defn ty-long [(a (dyn alloc/Allocator))] (-> (ptr Type)) (ty-new a TY-LONG 8 8))
(defn ty-uchar [(a (dyn alloc/Allocator))] (-> (ptr Type)) (ty-unsigned-new a TY-CHAR 1))
(defn ty-ushort [(a (dyn alloc/Allocator))] (-> (ptr Type)) (ty-unsigned-new a TY-SHORT 2))
(defn ty-uint [(a (dyn alloc/Allocator))] (-> (ptr Type)) (ty-unsigned-new a TY-INT 4))
(defn ty-ulong [(a (dyn alloc/Allocator))] (-> (ptr Type)) (ty-unsigned-new a TY-LONG 8))
(defn ty-int128 [(a (dyn alloc/Allocator)) (unsigned? bool)] (-> (ptr Type))
  (let [t (ty-new a TY-INT128 16 16)]
    (store! (field t unsigned) (if unsigned? 1 0))
    t))
(defn ty-float [(a (dyn alloc/Allocator))] (-> (ptr Type)) (ty-new a TY-FLOAT 4 4))
(defn ty-double [(a (dyn alloc/Allocator))] (-> (ptr Type)) (ty-new a TY-DOUBLE 8 8))

(defn ty-pointer-to [(a (dyn alloc/Allocator)) (base (ptr Type))] (-> (ptr Type))
  (let [t (ty-new a TY-PTR 8 8)]
    (store! (field t base) base)
    (store! (field t unsigned) 1)
    t))

;; A length of -1 leaves the array incomplete, which is what a flexible member
;; or an `extern int x[];` needs.
(defn ty-array-of [(a (dyn alloc/Allocator)) (base (ptr Type)) (len i64)] (-> (ptr Type))
  (let [t (ty-new a TY-ARRAY (if (< len 0) 0 (* (ty-size base) len)) (ty-align base))]
    (store! (field t base) base)
    (store! (field t array-len) len)
    (store! (field t complete) (if (< len 0) 0 1))
    t))

(defn ty-func-of [(a (dyn alloc/Allocator)) (ret (ptr Type))] (-> (ptr Type))
  (let [t (ty-new a TY-FUNC 1 1)]
    (store! (field t base) ret)
    t))

(defn ty-record [(a (dyn alloc/Allocator)) (union? bool)] (-> (ptr Type))
  (let [t (ty-new a (if union? TY-UNION TY-STRUCT) 0 1)]
    (store! (field t complete) 0)
    t))

;; An array declared `[]` has no length until its initialiser supplies one.
(defn set-array-len! [(t (ptr Type)) (len i64)] (-> i64)
  (store! (field t array-len) len)
  (store! (field t size) (* (ty-size (load (field t base))) len))
  (store! (field t complete) 1)
  0)

(defn set-variadic! [(t (ptr Type)) (v bool)] (-> i64)
  (store! (field t variadic) (if v 1 0)) 0)
(defn set-complete! [(t (ptr Type)) (v bool)] (-> i64)
  (store! (field t complete) (if v 1 0)) 0)
(defn set-name! [(t (ptr Type)) (n (slice u8))] (-> i64)
  (store! (field t name) n) 0)

;; `bit-width` of -1 means an ordinary member.
(defn add-member! [(t (ptr Type)) (name (slice u8)) (ty (ptr Type)) (bit-width i64)] (-> i64)
  (al/al-push! [Member]
               (mut (field t members))
               (load (Member :name name :ty ty :offset 0 :bit-offset 0 :bit-width bit-width)))
  0)

;; Places one struct member and returns the new bit cursor.
;;
;; A bitfield may not straddle a storage unit of its declared type, so one that
;; would is pushed to the start of the next unit. A zero-width bitfield closes
;; the current unit and contributes no member.
(defn place-member [(m (ptr Member)) (bits i64)] (-> i64)
  (let [mty (load (field m ty))
        msize (ty-size mty)
        malign (ty-align mty)
        width (load (field m bit-width))]
    (cond
      (= width 0) (align-to bits (* malign 8))
      (> width 0)
        (let [unit (* msize 8)
              start (primitive/idiv bits unit)
              end (primitive/idiv (+ bits (- width 1)) unit)
              at (if (= start end) bits (align-to bits unit))
              base (* (primitive/idiv at unit) msize)]
          (store! (field m offset) base)
          (store! (field m bit-offset) (- at (* base 8)))
          (+ at width))
      :else
        (let [at (align-to bits (* malign 8))]
          (store! (field m offset) (primitive/idiv at 8))
          (store! (field m bit-offset) 0)
          (+ at (* msize 8))))))

;; Assigns every member an offset and gives the record its size and alignment.
;;
;; A union puts every member at zero and takes the largest size and the
;; strictest alignment -- not the first member's, which is the bug this
;; replaces.
(defn layout-record! [(t (ptr Type))] (-> i64)
  (let [(mut bits) 0
        (mut align) 1
        (mut i) 0
        n (al/al-len [Member] (load (field t members)))
        union? (= (ty-kind t) TY-UNION)]
    (loop
      (if (>= (load i) n)
          (break)
          (let [m (al/al-elem [Member] (mut (field t members)) (load i))
                malign (ty-align (load (field m ty)))
                msize (ty-size (load (field m ty)))]
            (if (> malign (load align)) (store! align malign) 0)
            (if union?
                (do
                  (store! (field m offset) 0)
                  (store! (field m bit-offset) 0)
                  (if (> (* msize 8) (load bits)) (store! bits (* msize 8)) 0))
                (store! bits (place-member m (load bits))))
            (store! i (+ (load i) 1)))))
    (store! (field t align) (load align))
    (store! (field t size) (primitive/idiv (align-to (load bits) (* (load align) 8)) 8))
    (store! (field t complete) 1))
  0)
