;; C preprocessor. Ported from chibicc by Rui Ueyama (MIT) -- see ATTRIBUTION.md.
;;
;; Takes the token stream from `experiments.c.lex` and returns one with
;; directives executed, includes inlined, conditionals resolved, and macros
;; expanded. The result is what the parser sees.
;;
;; Recursion is stopped with a stack of macros currently being expanded rather
;; than with per-token hide sets. See `expand-call!` for what that costs.
(module experiments.c.pp)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "coil.hashmap" :as hm)
(import "coil.slice" :use *)
(import "coil.str" :as str)
(import "coil.fs" :as fs)
(import "coil.result" :use *)
(import "coil.scratch" :as scratch)
(import "coil.compiler.trace" :as tr)
(import "experiments.c.profile" :as prof)
(import "experiments.c.lex" :as lex)

(export Macro
        PP
        PPResult
        own-result
        preprocess
        pp-new
        pp-new-with-storage
        pp-define-text
        pp-read-prefix
        pp-add-include-path)

(defstruct Macro
  [(name (slice u8))
   ;; i64 rather than bool throughout: a bool struct field read back out of an
   ;; ArrayList is silently false at -O1 and above. o3repro.coil is the case.
   (function-like i64)
   (variadic i64)
   (params (al/ArrayList (slice u8)))
   (body (al/ArrayList lex/Token))])

;;; `outer` is whether the group containing this `#if` is itself being emitted.
;;; Without it a later `#else` or `#elif` would judge its branch on its own
;;; condition alone and switch a skipped region back on.
(defstruct Conditional
  [(active i64)  ; this branch is being emitted
   (outer i64)  ; the enclosing group is being emitted
   (taken i64)  ; some branch of this #if has already been taken
   (seen-else i64)])

(defstruct PP
  [(a (dyn alloc/Allocator))
   ;; Lexical token vectors and per-file run buffers are owned containers,
   ;; never spelling storage. Their allocator must support individual free.
   ;; No container returned to the caller or retained in a macro uses it.
   (containers (dyn alloc/Allocator))
   ;; Allocation-policy switch for development equivalence/retention tests.
   ;; Both modes execute the same expansion semantics; normal clients use true.
   (bounded-expansion bool)
   (temporary-total i64) (temporary-peak i64)
   (macros (hm/HashMap (slice u8) Macro))
   (include-paths (al/ArrayList (slice u8)))
   (once (hm/HashMap (slice u8) bool))
   (expanding (al/ArrayList (slice u8)))
   (conditionals (al/ArrayList Conditional))
   (out (al/ArrayList lex/Token))
   (depth i64)
   (counter i64)
   (failed i64)
   (message (slice u8))
   (file (slice u8))
   (line i64)])

(defstruct PPResult
  [(tokens (al/ArrayList lex/Token))
   (failed i64)
   (message (slice u8))
   (file (slice u8))
   (line i64)])

;; Completed preprocessing has a single ownership boundary. Neither the parser
;; nor a staged declaration index needs macro bodies, include lex buffers, or
;; expansion readers. Copy the final token vector exactly once and intern its
;; spelling/provenance bytes by content. The temporary index borrows PP strings
;; only until this function returns; every resulting slice belongs to `a`.
(defn own-text [(a (dyn alloc/Allocator))
                (strings (mut (hm/HashMap (slice u8) (slice u8))))
                (text (slice u8))] (-> (slice u8))
  (if (= (slice-len text) 0) ""
    (match (hm/hm-get (load strings) text)
      (Some [owned] owned)
      (None []
        (let [owned (match (str/str-concat a text "")
                (Some [bytes] bytes)
                (None [] (alloc/oom-at c"C token ownership" (slice-len text)) ""))]
          (hm/hm-put! (mut strings) text owned) owned)))))

(defn own-result [(a (dyn alloc/Allocator)) (input PPResult)] (-> PPResult)
  (let [temporary (primitive/alloc-stack scratch/ScratchArena)]
    (scratch/scratch-init-with-cap temporary (alloc/malloc-allocator) 16384)
    (let [(mut strings) (hm/hm-new [(slice u8) (slice u8)]
            (scratch/scratch-allocator temporary) (str/str-keyops-borrowed))
          (mut tokens) (al/al-new [lex/Token] a)
          count (al/al-len (.tokens input))]
      (al/al-reserve! (mut tokens) count)
      (for [i 0 count]
        (let [original (al/al-get (.tokens input) i)
              text (own-text a (mut strings) (lex/token-text original))
              file (own-text a (mut strings) (lex/token-file original))]
          (al/al-push! (mut tokens) (lex/Token :kind (lex/token-kind original)
            :text text :file file :line (lex/token-line original) :column (lex/token-column original)
            :at-line-start (.at-line-start original) :preceded-by-space (.preceded-by-space original)))) 0)
      (let [message (own-text a (mut strings) (.message input))
            file (own-text a (mut strings) (.file input))
            result (PPResult :tokens (load tokens) :failed (.failed input)
              :message message :file file :line (.line input))]
        (scratch/scratch-close! temporary) result))))

(const MAX-INCLUDE-DEPTH 200)

(defn container-storage [(p (mut PP))] (-> (dyn alloc/Allocator))
  (if (load (field p bounded-expansion)) (load (field p containers)) (load (field p a))))

(defn release-tokens! [(p (mut PP)) (tokens (mut (al/ArrayList lex/Token)))] (-> i64)
  (when (load (field p bounded-expansion)) (al/al-free! (mut tokens)) 0) 0)

(defn text=? [(x (slice u8)) (y (slice u8))] (-> bool)
  (str/str-eq x y))

(defn fail! [(p (mut PP)) (message (slice u8)) (t lex/Token)] (-> i64)
  (if (!= (load (field p failed)) 0)
      0
      (do
        (store! (field p failed) 1)
        (store! (field p message) message)
        (store! (field p file) (lex/token-file t))
        (store! (field p line) (lex/token-line t))
        0)))

(defn copy-text [(p (mut PP)) (value (slice u8))] (-> (slice u8))
  (let [(mut b) (str/sb-new (load (field p a)))]
    (str/sb-push-str! (mut b) value)
    (str/sb-str (load (mut b)))))

;; ---------------------------------------------------------------- token help
(defn tok-at [(list (al/ArrayList lex/Token)) (i i64)] (-> lex/Token)
  (al/al-get [lex/Token] list i))

(defn tok-count [(list (al/ArrayList lex/Token))] (-> i64)
  (al/al-len [lex/Token] list))

(defn is-punct? [(t lex/Token) (s (slice u8))] (-> bool)
  (and (= (lex/token-kind t) lex/TK-PUNCT) (text=? (lex/token-text t) s)))

(defn is-word? [(t lex/Token) (s (slice u8))] (-> bool)
  (and (or (= (lex/token-kind t) lex/TK-IDENT)
           (= (lex/token-kind t) lex/TK-KEYWORD))
       (text=? (lex/token-text t) s)))

(defn name-like? [(t lex/Token)] (-> bool)
  (or (= (lex/token-kind t) lex/TK-IDENT) (= (lex/token-kind t) lex/TK-KEYWORD)))

;;; A synthesized token borrows its position from the one that produced it, so
;;; an error inside a macro expansion still points at the use site.
(defn retext [(t lex/Token) (kind i64) (text (slice u8))] (-> lex/Token)
  (lex/Token
    :kind kind
    :text text
    :file (lex/token-file t)
    :line (lex/token-line t)
    :column (lex/token-column t)
    :at-line-start 0
    :preceded-by-space (if (lex/token-preceded-by-space? t) 1 0)))

(defn at-pos [(t lex/Token) (at lex/Token)] (-> lex/Token)
  (lex/Token
    :kind (lex/token-kind t)
    :text (lex/token-text t)
    :file (lex/token-file at)
    :line (lex/token-line at)
    :column (lex/token-column at)
    :at-line-start 0
    :preceded-by-space (if (lex/token-preceded-by-space? t) 1 0)))

(defn number-token [(t lex/Token) (value i64) (p (mut PP))] (-> lex/Token)
  (let [(mut b) (str/sb-new (load (field p a)))]
    (str/sb-push-i64! (mut b) value)
    (retext t lex/TK-NUMBER (str/sb-str (load (mut b))))))

;; ------------------------------------------------------------- macro storage
(defn macro-of [(p (mut PP)) (name (slice u8))] (-> (Option Macro))
  (hm/hm-get (load (field p macros)) name))

(defn expanding? [(p (mut PP)) (name (slice u8))] (-> bool)
  (let [(mut i) 0
        n (al/al-len [(slice u8)] (load (field p expanding)))
        (mut found) false]
    (loop (if (or (load found) (>= (load i) n))
              (break)
              (do
                (if (text=? (al/al-get [(slice u8)] (load (field p expanding)) (load i)) name)
                    (store! found true)
                    0)
                (store! i (+ (load i) 1)))))
    (load found)))

;; --------------------------------------------------------- #if expression

;;; Parses the integer constant expression of an `#if`, over an already
;;; macro-expanded token run in which `defined` has been resolved and every
;;; surviving identifier stands for 0.
(defstruct ExprParser
  [(tokens (al/ArrayList lex/Token))
   (pos i64)])

(defn e-peek [(e (mut ExprParser))] (-> lex/Token)
  (let [n (tok-count (load (field e tokens)))
        i (load (field e pos))]
    (tok-at (load (field e tokens)) (if (>= i n) (- n 1) i))))

(defn e-done? [(e (mut ExprParser))] (-> bool)
  (>= (load (field e pos)) (tok-count (load (field e tokens)))))

(defn e-take [(e (mut ExprParser))] (-> lex/Token)
  (let [t (e-peek (mut e))]
    (store! (field e pos) (+ (load (field e pos)) 1))
    t))

(defn e-accept [(e (mut ExprParser)) (s (slice u8))] (-> bool)
  (if (and (not (e-done? (mut e))) (is-punct? (e-peek (mut e)) s))
      (do (e-take (mut e)) true)
      false))

;;; Decimal, hex, octal, and binary, with any mix of u/l suffixes.
(defn parse-int-text [(text (slice u8))] (-> i64)
  (let [n (slice-len text)
        (mut i) 0
        (mut base) 10
        (mut value) 0]
    (if (and (>= n 2)
             (= (primitive/cast i64 (slice-get text 0)) 48)
             (or (= (primitive/cast i64 (slice-get text 1)) 120)
                 (= (primitive/cast i64 (slice-get text 1)) 88)))
        (do (store! base 16) (store! i 2))
        (if (and (>= n 2)
                 (= (primitive/cast i64 (slice-get text 0)) 48)
                 (or (= (primitive/cast i64 (slice-get text 1)) 98)
                     (= (primitive/cast i64 (slice-get text 1)) 66)))
            (do (store! base 2) (store! i 2))
            (if (and (>= n 1) (= (primitive/cast i64 (slice-get text 0)) 48))
                (do (store! base 8) (store! i 1))
                0)))
    (loop (if (>= (load i) n)
              (break)
              (let [c (primitive/cast i64 (slice-get text (load i)))
                    d
                      (cond (and (>= c 48) (<= c 57)) (- c 48)
                            (and (>= c 97) (<= c 102)) (+ (- c 97) 10)
                            (and (>= c 65) (<= c 70)) (+ (- c 65) 10)
                            :else -1)]
                (if (or (< d 0) (>= d (load base)))
                    (break)
                    (do
                      (store! value (+ (* (load value) (load base)) d))
                      (store! i (+ (load i) 1)))))))
    (load value)))

;;; The preprocessor and ordinary character constants share escape semantics.
(defn parse-char-text [(text (slice u8))] (-> lex/ByteEscape)
  (let [n (slice-len text)
        (mut i) 0]
    (loop (if (or (>= (load i) n)
                  (= (primitive/cast i64 (slice-get text (load i))) 39))
              (break)
              (store! i (+ (load i) 1))))
    (store! i (+ (load i) 1))
    (if (>= (load i) n)
        (lex/ByteEscape :value 0 :next (load i) :message "empty character constant")
        (let [c (primitive/cast i64 (slice-get text (load i)))]
          (if (!= c 92)
              (lex/ByteEscape :value c :next (+ (load i) 1) :message "")
              (lex/decode-byte-escape text (+ (load i) 1)))))))

(defn e-primary [(e (mut ExprParser))] (-> i64)
  (if (e-done? (mut e))
      0
      (let [t (e-take (mut e))]
        (cond (is-punct? t "(") (let [v (e-ternary (mut e))] (e-accept (mut e) ")") v)
              (= (lex/token-kind t) lex/TK-NUMBER) (parse-int-text (lex/token-text t))
              (= (lex/token-kind t) lex/TK-CHARACTER)
                (let [escaped (parse-char-text (lex/token-text t))] (.value escaped))
              ;; Every identifier that survived expansion is 0, as the standard says.
              :else 0))))

(defn e-unary [(e (mut ExprParser))] (-> i64)
  (cond (e-accept (mut e) "!") (if (= (e-unary (mut e)) 0) 1 0)
        (e-accept (mut e) "-") (- 0 (e-unary (mut e)))
        (e-accept (mut e) "+") (e-unary (mut e))
        (e-accept (mut e) "~") (primitive/inot (e-unary (mut e)))
        :else (e-primary (mut e))))

(defn e-mul [(e (mut ExprParser))] (-> i64)
  (let [(mut v) (e-unary (mut e))]
    (loop (cond (e-accept (mut e) "*") (store! v (* (load v) (e-unary (mut e))))
                (e-accept (mut e) "/")
                  (let [d (e-unary (mut e))]
                    (store! v (if (= d 0) 0 (/ (load v) d))))
                (e-accept (mut e) "%")
                  (let [d (e-unary (mut e))]
                    (store! v (if (= d 0) 0 (primitive/irem (load v) d))))
                :else (break)))
    (load v)))

(defn e-add [(e (mut ExprParser))] (-> i64)
  (let [(mut v) (e-mul (mut e))]
    (loop (cond (e-accept (mut e) "+") (store! v (+ (load v) (e-mul (mut e))))
                (e-accept (mut e) "-") (store! v (- (load v) (e-mul (mut e))))
                :else (break)))
    (load v)))

(defn e-shift [(e (mut ExprParser))] (-> i64)
  (let [(mut v) (e-add (mut e))]
    (loop (cond (e-accept (mut e) "<<") (store! v (primitive/ishl (load v) (e-add (mut e))))
                (e-accept (mut e) ">>") (store! v (primitive/ishr (load v) (e-add (mut e))))
                :else (break)))
    (load v)))

(defn e-relational [(e (mut ExprParser))] (-> i64)
  (let [(mut v) (e-shift (mut e))]
    (loop (cond (e-accept (mut e) "<=") (store! v (if (<= (load v) (e-shift (mut e))) 1 0))
                (e-accept (mut e) ">=") (store! v (if (>= (load v) (e-shift (mut e))) 1 0))
                (e-accept (mut e) "<") (store! v (if (< (load v) (e-shift (mut e))) 1 0))
                (e-accept (mut e) ">") (store! v (if (> (load v) (e-shift (mut e))) 1 0))
                :else (break)))
    (load v)))

(defn e-equality [(e (mut ExprParser))] (-> i64)
  (let [(mut v) (e-relational (mut e))]
    (loop (cond (e-accept (mut e) "==") (store! v (if (= (load v) (e-relational (mut e))) 1 0))
                (e-accept (mut e) "!=") (store! v (if (!= (load v) (e-relational (mut e))) 1 0))
                :else (break)))
    (load v)))

(defn e-band [(e (mut ExprParser))] (-> i64)
  (let [(mut v) (e-equality (mut e))]
    (loop (if (e-accept (mut e) "&") (store! v (primitive/iand (load v) (e-equality (mut e)))) (break)))
    (load v)))

(defn e-bxor [(e (mut ExprParser))] (-> i64)
  (let [(mut v) (e-band (mut e))]
    (loop (if (e-accept (mut e) "^") (store! v (primitive/ixor (load v) (e-band (mut e)))) (break)))
    (load v)))

(defn e-bor [(e (mut ExprParser))] (-> i64)
  (let [(mut v) (e-bxor (mut e))]
    (loop (if (e-accept (mut e) "|") (store! v (primitive/ior (load v) (e-bxor (mut e)))) (break)))
    (load v)))

(defn e-and [(e (mut ExprParser))] (-> i64)
  (let [(mut v) (e-bor (mut e))]
    (loop (if (e-accept (mut e) "&&")
              (let [r (e-bor (mut e))] (store! v (if (and (!= (load v) 0) (!= r 0)) 1 0)))
              (break)))
    (load v)))

(defn e-or [(e (mut ExprParser))] (-> i64)
  (let [(mut v) (e-and (mut e))]
    (loop (if (e-accept (mut e) "||")
              (let [r (e-and (mut e))] (store! v (if (or (!= (load v) 0) (!= r 0)) 1 0)))
              (break)))
    (load v)))

(defn e-ternary [(e (mut ExprParser))] (-> i64)
  (let [c (e-or (mut e))]
    (if (e-accept (mut e) "?")
        (let [a (e-ternary (mut e))
              _ (e-accept (mut e) ":")
              b (e-ternary (mut e))]
          (if (!= c 0) a b))
        c)))

(defn eval-condition [(tokens (al/ArrayList lex/Token))] (-> i64)
  (let [(mut e) (load (ExprParser :tokens tokens :pos 0))]
    (e-ternary (mut e))))

;; ------------------------------------------------------------------- reader

;;; Tokens are read through a pushback buffer so a macro expansion can be
;;; rescanned in place. That is what lets an expansion ending in a
;;; function-like macro name pick up the `(` that follows it in the source.
(defstruct Reader
  [(tokens (al/ArrayList lex/Token))
   (pos i64)
   (limit i64)
   (pending (al/ArrayList lex/Token))
   (pending-pos i64)])

(defn r-pending-left [(r (mut Reader))] (-> i64)
  (- (tok-count (load (field r pending))) (load (field r pending-pos))))

(defn r-done? [(r (mut Reader))] (-> bool)
  (and (<= (r-pending-left (mut r)) 0)
       (>= (load (field r pos)) (load (field r limit)))))

;;; Reads `tokens` between `from` and `until`, so a run of ordinary code can be
;;; expanded without copying it out of the file's token list first.
(defn make-reader [(a (dyn alloc/Allocator))
                   (tokens (al/ArrayList lex/Token))
                   (from i64)
                   (until i64)] (-> Reader)
  (Reader
    :tokens tokens
    :pos from
    :limit until
    :pending (al/al-new [lex/Token] a)
    :pending-pos 0))

(defn r-peek [(r (mut Reader))] (-> lex/Token)
  (if (> (r-pending-left (mut r)) 0)
      (tok-at (load (field r pending)) (load (field r pending-pos)))
      (tok-at (load (field r tokens)) (load (field r pos)))))

(defn r-next [(r (mut Reader))] (-> lex/Token)
  (let [t (r-peek (mut r))]
    (if (> (r-pending-left (mut r)) 0)
        (store! (field r pending-pos) (+ (load (field r pending-pos)) 1))
        (store! (field r pos) (+ (load (field r pos)) 1)))
    t))

;;; Puts `extra` in front of whatever is still buffered.
(defn r-pushback! [(r (mut Reader)) (a (dyn alloc/Allocator)) (extra (al/ArrayList lex/Token))] (-> i64)
  (let [(mut fresh) (al/al-new [lex/Token] a)
        (mut i) 0
        n (tok-count extra)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al/al-push! [lex/Token] (mut fresh) (tok-at extra (load i)))
                (store! i (+ (load i) 1)))))
    (store! i (load (field r pending-pos)))
    (loop (if (>= (load i) (tok-count (load (field r pending))))
              (break)
              (do
                (al/al-push! [lex/Token] (mut fresh) (tok-at (load (field r pending)) (load i)))
                (store! i (+ (load i) 1)))))
    (store! (field r pending) (load (mut fresh)))
    (store! (field r pending-pos) 0))
  0)

;; -------------------------------------------------------------- stringify
(defn stringify [(p (mut PP)) (arg (al/ArrayList lex/Token)) (at lex/Token)] (-> lex/Token)
  (let [(mut b) (str/sb-new (load (field p a)))
        (mut i) 0
        n (tok-count arg)]
    (str/sb-push-byte! (mut b) (primitive/cast u8 34))
    (loop (if (>= (load i) n)
              (break)
              (let [t (tok-at arg (load i))
                    text (lex/token-text t)
                    (mut j) 0]
                (if (and (> (load i) 0) (lex/token-preceded-by-space? t))
                    (str/sb-push-byte! (mut b) (primitive/cast u8 32))
                    0)
                (loop (if (>= (load j) (slice-len text))
                          (break)
                          (let [c (slice-get text (load j))]
                            (if (or (= (primitive/cast i64 c) 34)
                                    (= (primitive/cast i64 c) 92))
                                (str/sb-push-byte! (mut b) (primitive/cast u8 92))
                                0)
                            (str/sb-push-byte! (mut b) c)
                            (store! j (+ (load j) 1)))))
                (store! i (+ (load i) 1)))))
    (str/sb-push-byte! (mut b) (primitive/cast u8 34))
    (retext at lex/TK-STRING (str/sb-str (load (mut b))))))

;;; `##` joins two spellings and the result is re-tokenized, so `a ## b` is one
;;; identifier while `+ ## +` becomes the single operator `++`.
(defn paste [(p (mut PP)) (left lex/Token) (right lex/Token)] (-> lex/Token)
  (let [(mut b) (str/sb-new (load (field p a)))]
    (str/sb-push-str! (mut b) (lex/token-text left))
    (str/sb-push-str! (mut b) (lex/token-text right))
    (let [joined (str/sb-str (load (mut b)))
          result (lex/lex (load (field p a)) (lex/token-file left) joined)]
      (if (or (.failed result) (< (tok-count (.tokens result)) 2))
          (do
            (fail! (mut p) "pasting does not produce a valid token" left)
            (retext left lex/TK-IDENT joined))
          (retext left (lex/token-kind (tok-at (.tokens result) 0)) joined)))))

;; ----------------------------------------------------------------- expansion
(defn param-index [(m Macro) (name (slice u8))] (-> i64)
  (let [(mut i) 0
        n (al/al-len [(slice u8)] (.params m))
        (mut found) -1]
    (loop (if (or (>= (load found) 0) (>= (load i) n))
              (break)
              (do
                (if (text=? (al/al-get [(slice u8)] (.params m) (load i)) name)
                    (store! found (load i))
                    0)
                (store! i (+ (load i) 1)))))
    (load found)))

(defn append-all! [(dst (mut (al/ArrayList lex/Token))) (src (al/ArrayList lex/Token))] (-> i64)
  (let [(mut i) 0
        n (tok-count src)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al/al-push! [lex/Token] (mut dst) (tok-at src (load i)))
                (store! i (+ (load i) 1))))))
  0)

;;; Builds the replacement list: parameters give way to arguments, `#`
;;; stringifies the argument as written, and `##` joins across the boundary.
;;; An argument is macro-expanded before substitution unless it is an operand of
;;; `#` or `##`, which is why both forms are kept.
(defn substitute [(p (mut PP))
                  (m Macro)
                  (raw (al/ArrayList (al/ArrayList lex/Token)))
                  (done (al/ArrayList (al/ArrayList lex/Token)))
                  (at lex/Token)] (-> (al/ArrayList lex/Token))
  (let [(mut out) (al/al-new [lex/Token] (load (field p a)))
        body (.body m)
        n (tok-count body)
        (mut i) 0
        arg-count (al/al-len [(al/ArrayList lex/Token)] raw)]
    (loop (if (>= (load i) n)
              (break)
              (let [t (tok-at body (load i))
                    next-is-paste (and (< (+ (load i) 1) n) (is-punct? (tok-at body (+ (load i) 1)) "##"))]
                (cond ;; `#param`
                      (and (is-punct? t "#")
                           (and (< (+ (load i) 1) n)
                                (>= (param-index m (lex/token-text (tok-at body (+ (load i) 1)))) 0)))
                        (let [k (param-index m (lex/token-text (tok-at body (+ (load i) 1))))]
                          (al/al-push! [lex/Token]
                                       (mut out)
                                       (stringify (mut p) (al/al-get [(al/ArrayList lex/Token)] raw k) t))
                          (store! i (+ (load i) 2)))
                      ;; `## x` -- join with whatever was emitted last.
                      (is-punct? t "##")
                        (if (>= (+ (load i) 1) n)
                            (do (fail! (mut p) "'##' at the end of a macro body" t) (store! i (+ (load i) 1)))
                            (let [rhs (tok-at body (+ (load i) 1))
                                  k (param-index m (lex/token-text rhs))
                                  piece
                                    (if (>= k 0)
                                        (al/al-get [(al/ArrayList lex/Token)] raw k)
                                        (al/al-new [lex/Token] (load (field p a))))
                                  empty-vararg (and (>= k 0) (= (tok-count piece) 0))
                                  emitted (al/al-len [lex/Token] (mut out))]
                              ;; GNU comma swallowing: `, ## __VA_ARGS__` with no
                              ;; variadic arguments drops the comma.
                              (if (and empty-vararg
                                       (and (> emitted 0)
                                            (is-punct? (tok-at (load (mut out)) (- emitted 1)) ",")))
                                  (al/al-pop! [lex/Token] (mut out))
                                  (if (= emitted 0)
                                      (None [lex/Token])
                                      (if (>= k 0)
                                          (if (= (tok-count piece) 0)
                                              (None [lex/Token])
                                              (let [joined
                                                      (paste (mut p)
                                                             (tok-at (load (mut out)) (- emitted 1))
                                                             (tok-at piece 0))]
                                                (al/al-set! [lex/Token] (mut out) (- emitted 1) joined)
                                                (let [(mut j) 1]
                                                  (loop (if (>= (load j) (tok-count piece))
                                                            (break)
                                                            (do
                                                              (al/al-push! [lex/Token]
                                                                           (mut out)
                                                                           (tok-at piece (load j)))
                                                              (store! j (+ (load j) 1))))))
                                                (None [lex/Token])))
                                          (let [joined (paste (mut p) (tok-at (load (mut out)) (- emitted 1)) rhs)]
                                            (al/al-set! [lex/Token] (mut out) (- emitted 1) joined)
                                            (None [lex/Token])))))
                              (store! i (+ (load i) 2))))
                      ;; A parameter adjacent to `##` keeps its unexpanded form.
                      (and (>= (param-index m (lex/token-text t)) 0) next-is-paste)
                        (do
                          (append-all! (mut out)
                                       (al/al-get [(al/ArrayList lex/Token)] raw (param-index m (lex/token-text t))))
                          (store! i (+ (load i) 1)))
                      (>= (param-index m (lex/token-text t)) 0)
                        (do
                          (append-all! (mut out)
                                       (al/al-get [(al/ArrayList lex/Token)] done (param-index m (lex/token-text t))))
                          (store! i (+ (load i) 1)))
                      :else
                        (do
                          (al/al-push! [lex/Token] (mut out) (at-pos t at))
                          (store! i (+ (load i) 1)))))))
    (load (mut out))))

;;; Reads one argument list, splitting on commas that are not nested. A variadic
;;; macro folds every argument past the named ones into a single group, commas
;;; included, which is exactly what `__VA_ARGS__` stands for.
(defn read-arguments [(p (mut PP)) (r (mut Reader)) (m Macro)] (-> (al/ArrayList (al/ArrayList lex/Token)))
  (let [(mut args) (al/al-new [(al/ArrayList lex/Token)] (load (field p a)))
        (mut current) (al/al-new [lex/Token] (load (field p a)))
        (mut depth) 0
        (mut fixed) (al/al-len [(slice u8)] (.params m))
        (mut closed) false]
    (r-next (mut r))  ; the '('
    (loop (if (or (load closed) (r-done? (mut r)))
              (break)
              (let [t (r-next (mut r))]
                (cond (and (is-punct? t ")") (= (load depth) 0)) (store! closed true)
                      (and (and (is-punct? t ",") (= (load depth) 0))
                           (or (= (.variadic m) 0)
                               (< (al/al-len [(al/ArrayList lex/Token)] (mut args)) (- (load fixed) 1))))
                        (do
                          (al/al-push! [(al/ArrayList lex/Token)] (mut args) (load (mut current)))
                          (store! current (al/al-new [lex/Token] (load (field p a)))))
                      :else
                        (do
                          (if (or (is-punct? t "(") (or (is-punct? t "[") (is-punct? t "{")))
                              (store! depth (+ (load depth) 1))
                              (if (or (is-punct? t ")") (or (is-punct? t "]") (is-punct? t "}")))
                                  (store! depth (- (load depth) 1))
                                  0))
                          (al/al-push! [lex/Token] (mut current) t))))))
    (al/al-push! [(al/ArrayList lex/Token)] (mut args) (load (mut current)))
    ;; A macro with parameters called with nothing between the parentheses has
    ;; one empty argument, not zero.
    (loop (if (>= (al/al-len [(al/ArrayList lex/Token)] (mut args))
                  (+ (load fixed) (.variadic m)))
              (break)
              (al/al-push! [(al/ArrayList lex/Token)] (mut args) (al/al-new [lex/Token] (load (field p a))))))
    (load (mut args))))

;; ------------------------------------------------------- expansion driver
(defn builtin-value [(p (mut PP)) (t lex/Token)] (-> (Option lex/Token))
  (let [name (lex/token-text t)]
    (cond (text=? name "__LINE__") (Some (number-token t (lex/token-line t) (mut p)))
          (text=? name "__COUNTER__")
            (let [v (load (field p counter))]
              (store! (field p counter) (+ v 1))
              (Some (number-token t v (mut p))))
          (text=? name "__FILE__")
            (let [(mut b) (str/sb-new (load (field p a)))]
              (str/sb-push-byte! (mut b) (primitive/cast u8 34))
              (str/sb-push-str! (mut b) (lex/token-file t))
              (str/sb-push-byte! (mut b) (primitive/cast u8 34))
              (Some (retext t lex/TK-STRING (str/sb-str (load (mut b))))))
          :else (None [lex/Token]))))

;;; Expands one invocation and appends the result. The replacement is rescanned
;;; while this macro remains disabled, which gives recursive definitions their
;;; required stopping point. If that rescan ends in a function-like macro name,
;;; the following `(` in the containing reader belongs to the same rescan. It is
;;; consumed here, before the current macro is enabled again. This is the common
;;; `#define public_allocator configured_allocator` alias pattern.
(defn expand-call! [(p (mut PP))
                    (r (mut Reader))
                    (t lex/Token)
                    (m Macro)
                    (out (mut (al/ArrayList lex/Token)))] (-> i64)
  (let [raw
          (if (!= (.function-like m) 0)
              (read-arguments (mut p) (mut r) m)
              (al/al-new [(al/ArrayList lex/Token)] (load (field p a))))
        (mut done) (al/al-new [(al/ArrayList lex/Token)] (load (field p a)))
        (mut i) 0]
    (loop (if (>= (load i) (al/al-len [(al/ArrayList lex/Token)] raw))
              (break)
              (let [piece (al/al-get [(al/ArrayList lex/Token)] raw (load i))
                    (mut acc) (al/al-new [lex/Token] (load (field p a)))
                    (mut sub) (make-reader (load (field p a)) piece 0 (tok-count piece))]
                (expand-into! (mut p) (mut sub) (mut acc))
                (al/al-push! [(al/ArrayList lex/Token)] (mut done) (load (mut acc)))
                (store! i (+ (load i) 1)))))
    (let [replacement (substitute (mut p) m raw (load (mut done)) t)
          (mut acc) (al/al-new [lex/Token] (load (field p a)))
          (mut inner) (make-reader (load (field p a)) replacement 0 (tok-count replacement))]
      (al/al-push! [(slice u8)] (mut (field p expanding)) (.name m))
      (expand-into! (mut p) (mut inner) (mut acc))
      (let [count (al/al-len [lex/Token] (mut acc))]
        (if (and (> count 0)
                 (and (not (r-done? (mut r))) (is-punct? (r-peek (mut r)) "(")))
            (let [last (al/al-get [lex/Token] (load (mut acc)) (- count 1))]
              (match (macro-of (mut p) (lex/token-text last))
                (Some [next]
                      (let [next-macro next]
                        (if (and (!= (.function-like next-macro) 0)
                                 (not (expanding? (mut p) (.name next-macro))))
                            (do
                              (al/al-pop! [lex/Token] (mut acc))
                              (expand-call! (mut p) (mut r) last next-macro (mut acc)))
                            0)))
                (None [] 0)))
            0))
      (al/al-pop! [(slice u8)] (mut (field p expanding)))
      (append-all! (mut out) (load (mut acc)))))
  0)

(defn expandable [(p (mut PP)) (r (mut Reader)) (t lex/Token)] (-> (Option Macro))
  (if (or (not (name-like? t)) (expanding? (mut p) (lex/token-text t)))
      (None [Macro])
      (match (macro-of (mut p) (lex/token-text t))
        (None [] (None [Macro]))
        (Some [found]
              (let [m found]
                ;; A function-like macro not followed by `(` is just an identifier.
                (if (and (!= (.function-like m) 0)
                         (not (and (not (r-done? (mut r))) (is-punct? (r-peek (mut r)) "("))))
                    (None [Macro])
                    (Some m)))))))

;;; `_Pragma("...")` is a directive written as an expression, so that a macro can
;;; contain one. Every pragma this compiler understands is a `#pragma`, and the
;;; rest are ignored, so the operator and its argument are simply consumed --
;;; leaving them in the stream would put them in front of the parser.
(defn drop-pragma! [(p (mut PP)) (r (mut Reader))] (-> i64)
  (if (or (r-done? (mut r)) (not (is-punct? (r-peek (mut r)) "(")))
      0
      (let [(mut depth) 0
            (mut done) 0]
        (loop (if (or (!= (load done) 0) (r-done? (mut r)))
                  (break)
                  (let [t (r-next (mut r))]
                    (cond (is-punct? t "(") (store! depth (+ (load depth) 1))
                          (is-punct? t ")")
                            (do
                              (store! depth (- (load depth) 1))
                              (if (= (load depth) 0) (store! done 1) 0))
                          :else 0))))
        0)))

(defn expand-one! [(p (mut PP)) (r (mut Reader)) (t lex/Token) (out (mut (al/ArrayList lex/Token)))] (-> i64)
  ;; Shared by recursive rescanning and the lifetime-bounded outer stream.
  (if (= (lex/token-kind t) lex/TK-EOF) 0
    (if (or (is-word? t "_Pragma") (is-word? t "__pragma"))
      (drop-pragma! (mut p) (mut r))
      (match (builtin-value (mut p) t)
        (Some [v] (al/al-push! [lex/Token] (mut out) v))
        (None [] (match (expandable (mut p) (mut r) t)
          (Some [found] (let [m found] (expand-call! (mut p) (mut r) t m (mut out))))
          (None [] (al/al-push! [lex/Token] (mut out) t))))))) 0)

(defn expand-into! [(p (mut PP)) (r (mut Reader)) (out (mut (al/ArrayList lex/Token)))] (-> i64)
  (loop (if (or (!= (load (field p failed)) 0) (r-done? (mut r)))
            (break)
            (let [t (r-next (mut r))]
              (expand-one! (mut p) (mut r) t (mut out)))))
  0)

;; Only generated spellings can point into an expansion arena. Original source,
;; macro definitions and input token arrays remain in the translation-unit arena.
;; Promote generated text and diagnostics before recycling; recursive rescans,
;; argument expansion and alias-followed-by-call share the same transient scope.
(defn promote-text [(p (mut PP)) (arena (ptr scratch/ScratchArena)) (text (slice u8))] (-> (slice u8))
  (if (and (> (slice-len text) 0)
    (scratch/scratch-owns-address? arena (primitive/cast (ptr i8) (slice-data text))))
    (copy-text (mut p) text) text))
(defn promote-token [(p (mut PP)) (arena (ptr scratch/ScratchArena)) (token lex/Token)] (-> lex/Token)
  (let [text (promote-text (mut p) arena (lex/token-text token))
        file (promote-text (mut p) arena (lex/token-file token))]
    (lex/Token :kind (lex/token-kind token) :text text :file file :line (lex/token-line token)
      :column (lex/token-column token) :at-line-start (if (lex/token-at-line-start? token) 1 0)
      :preceded-by-space (if (lex/token-preceded-by-space? token) 1 0))))
(defn promote-error! [(p (mut PP)) (arena (ptr scratch/ScratchArena))] (-> i64)
  (store! (field p message) (promote-text (mut p) arena (load (field p message))))
  (store! (field p file) (promote-text (mut p) arena (load (field p file)))) 0)
(defn temporary-peak! [(p (mut PP)) (arena (ptr scratch/ScratchArena))] (-> i64)
  (when (> (scratch/scratch-peak arena) (load (field p temporary-peak)))
    (store! (field p temporary-peak) (scratch/scratch-peak arena)) 0) 0)

(defn expand-stream! [(p (mut PP)) (r (mut Reader)) (out (mut (al/ArrayList lex/Token)))] (-> i64)
  (let [arena (primitive/alloc-stack scratch/ScratchArena) permanent (load (field p a))]
    (scratch/scratch-init-with-cap arena (alloc/malloc-allocator) 65536)
    (loop
      (if (or (!= (load (field p failed)) 0) (r-done? (mut r))) (break) 0)
      (let [token (r-next (mut r)) name (lex/token-text token)]
        (if (and (name-like? token)
          (or (hm/hm-contains? (load (field p macros)) name)
            (or (text=? name "__LINE__") (or (text=? name "__COUNTER__")
              (or (text=? name "__FILE__") (or (text=? name "_Pragma") (text=? name "__pragma")))))))
          (let [temporary (scratch/scratch-allocator arena)
                (mut expanded) (al/al-new [lex/Token] temporary)]
            (store! (field p a) temporary)
            (expand-one! (mut p) (mut r) token (mut expanded))
            (store! (field p a) permanent)
            (for [i 0 (tok-count (load expanded))]
              (al/al-push! [lex/Token] (mut out) (promote-token (mut p) arena (tok-at (load expanded) i))) 0)
            ;; The current reader consumes input directly. Promote any future
            ;; pushback implementation too, rather than relying on that detail.
            (let [(mut pending) (al/al-new [lex/Token] permanent)]
              (for [i (load (field r pending-pos)) (tok-count (load (field r pending)))]
                (al/al-push! [lex/Token] (mut pending)
                  (promote-token (mut p) arena (tok-at (load (field r pending)) i))) 0)
              (store! (field r pending) (load pending)) (store! (field r pending-pos) 0))
            (promote-error! (mut p) arena) (temporary-peak! (mut p) arena) (scratch/scratch-recycle! arena))
          (if (= (lex/token-kind token) lex/TK-EOF) 0 (al/al-push! [lex/Token] (mut out) token)))))
    (store! (field p temporary-total) (+ (load (field p temporary-total)) (scratch/scratch-total arena)))
    (scratch/scratch-close! arena)) 0)

(defn expand-run [(p (mut PP)) (in (al/ArrayList lex/Token))] (-> (al/ArrayList lex/Token))
  (let [(mut out) (al/al-new [lex/Token] (load (field p a)))
        (mut r) (make-reader (load (field p a)) in 0 (tok-count in))]
    (expand-into! (mut p) (mut r) (mut out))
    (load (mut out))))

;; --------------------------------------------------------------- directives
(defn dirname [(path (slice u8))] (-> (slice u8))
  (let [n (slice-len path)
        (mut i) n
        (mut cut) -1]
    (loop (if (<= (load i) 0)
              (break)
              (do
                (store! i (- (load i) 1))
                (if (and (< (load cut) 0) (= (primitive/cast i64 (slice-get path (load i))) 47))
                    (store! cut (load i))
                    0))))
    (if (< (load cut) 0) "." (subslice path 0 (load cut)))))

(defn join-path [(p (mut PP)) (dir (slice u8)) (name (slice u8))] (-> (slice u8))
  (let [(mut b) (str/sb-new (load (field p a)))]
    (str/sb-push-str! (mut b) dir)
    (str/sb-push-byte! (mut b) (primitive/cast u8 47))
    (str/sb-push-str! (mut b) name)
    (str/sb-str (load (mut b)))))

(defn file-exists? [(p (mut PP)) (path (slice u8))] (-> bool)
  (match (fs/read-file (load (field p a)) path)
    (Ok [_] true)
    (Err [_] false)))

;;; Framework includes spell `<CoreAudio/CoreAudio.h>`, while the file lives at
;;; `CoreAudio.framework/Headers/CoreAudio.h` beneath a framework search root.
(defn framework-path [(p (mut PP))
                      (root (slice u8))
                      (name (slice u8))] (-> (slice u8))
  (let [n (slice-len name)
        (mut slash) -1
        (mut i) 0]
    (loop (if (or (>= (load i) n) (>= (load slash) 0))
              (break)
              (do
                (if (= (primitive/cast i64 (slice-get name (load i))) 47)
                    (store! slash (load i))
                    0)
                (store! i (+ (load i) 1)))))
    (if (< (load slash) 1)
        ""
        (let [(mut b) (str/sb-new (load (field p a)))]
          (str/sb-push-str! (mut b) root)
          (str/sb-push-byte! (mut b) (primitive/cast u8 47))
          (str/sb-push-str! (mut b) (subslice name 0 (load slash)))
          (str/sb-push-str! (mut b) ".framework/Headers/")
          (str/sb-push-str! (mut b) (subslice name (+ (load slash) 1) n))
          (str/sb-str (load (mut b)))))))

;;; The index returned is the include path the file was found in, which is what
;;; `#include_next` needs in order to resume the search past it.
(defstruct Found [(ok i64) (path (slice u8)) (index i64)])

(defn search-include [(p (mut PP))
                      (name (slice u8))
                      (angled bool)
                      (current-dir (slice u8))
                      (start i64)] (-> Found)
  (let [(mut result)
          (load (Found
                  :ok 0
                  :path ""
                  :index -1))]
    (if (and (not angled) (< start 0))
        (let [candidate (join-path (mut p) current-dir name)]
          (if (file-exists? (mut p) candidate)
              (store! result
                      (Found
                        :ok 1
                        :path candidate
                        :index -1))
              0))
        0)
    (if (!= (load (field result ok)) 0)
        0
        (let [(mut i) (if (< start 0) 0 start)
              n (al/al-len [(slice u8)] (load (field p include-paths)))]
          (loop (if (or (!= (load (field result ok)) 0) (>= (load i) n))
                    (break)
                    (let [root (al/al-get [(slice u8)] (load (field p include-paths)) (load i))
                          candidate (join-path (mut p) root name)
                          framework (framework-path (mut p) root name)]
                      (if (file-exists? (mut p) candidate)
                          (store! result
                                  (Found
                                    :ok 1
                                    :path candidate
                                    :index (load i)))
                          (if (and (> (slice-len framework) 0) (file-exists? (mut p) framework))
                              (store! result
                                      (Found
                                        :ok 1
                                        :path framework
                                        :index (load i)))
                              0))
                      (store! i (+ (load i) 1)))))
          0))
    (load result)))

;;; `#include <a/b.h>` arrives as separate tokens, so the name is rebuilt from
;;; their spellings rather than read as one.
(defn header-name [(p (mut PP)) (tokens (al/ArrayList lex/Token)) (from i64) (until i64)] (-> (slice u8))
  (let [(mut b) (str/sb-new (load (field p a)))
        (mut i) from]
    (loop (if (>= (load i) until)
              (break)
              (do
                (str/sb-push-str! (mut b) (lex/token-text (tok-at tokens (load i))))
                (store! i (+ (load i) 1)))))
    (str/sb-str (load (mut b)))))

(defn unquote-header [(text (slice u8))] (-> (slice u8))
  (let [n (slice-len text)]
    (if (< n 2) text (subslice text 1 (- n 1)))))

(defn active? [(p (mut PP))] (-> bool)
  (let [n (al/al-len [Conditional] (load (field p conditionals)))]
    (if (= n 0)
        true
        (let [top (al/al-get [Conditional] (load (field p conditionals)) (- n 1))]
          (!= (.active top) 0)))))

(defn push-conditional! [(p (mut PP)) (taken bool)] (-> i64)
  (let [outer (active? (mut p))
        live (if (and outer taken) 1 0)
        entry
          (Conditional
            :active live
            :outer (if outer 1 0)
            :taken live
            :seen-else 0)]
    (al/al-push! [Conditional] (mut (field p conditionals)) entry))
  0)

;;; A directive runs to the next token that begins a line.
(defn line-end [(tokens (al/ArrayList lex/Token)) (from i64)] (-> i64)
  (let [n (tok-count tokens)
        (mut i) from]
    (loop (if (or (>= (load i) n)
                  (or (lex/token-at-line-start? (tok-at tokens (load i)))
                      (= (lex/token-kind (tok-at tokens (load i))) lex/TK-EOF)))
              (break)
              (store! i (+ (load i) 1))))
    (load i)))

(defn next-directive [(tokens (al/ArrayList lex/Token)) (from i64)] (-> i64)
  (let [n (tok-count tokens)
        (mut i) from]
    (loop (if (or (>= (load i) n)
                  (and (lex/token-at-line-start? (tok-at tokens (load i)))
                       (is-punct? (tok-at tokens (load i)) "#")))
              (break)
              (store! i (+ (load i) 1))))
    (load i)))

(defn slice-tokens [(p (mut PP)) (tokens (al/ArrayList lex/Token)) (from i64) (until i64)] (-> (al/ArrayList lex/Token))
  (let [(mut out) (al/al-new [lex/Token] (load (field p a)))
        (mut i) from]
    (loop (if (>= (load i) until)
              (break)
              (do
                (al/al-push! [lex/Token] (mut out) (tok-at tokens (load i)))
                (store! i (+ (load i) 1)))))
    (load (mut out))))

;;; `#define NAME(a, b) body` -- the parenthesis must touch the name, otherwise
;;; it is an object-like macro whose body happens to start with one.
(defn define! [(p (mut PP)) (tokens (al/ArrayList lex/Token)) (from i64) (until i64)] (-> i64)
  (if (>= from until)
      (fail! (mut p) "#define needs a name" (tok-at tokens (- from 1)))
      (let [name-token (tok-at tokens from)
            name (copy-text (mut p) (lex/token-text name-token))
            (mut i) (+ from 1)
            (mut params) (al/al-new [(slice u8)] (load (field p a)))
            (mut variadic) 0
            (mut function-like) 0]
        (if (and (< (load i) until)
                 (and (is-punct? (tok-at tokens (load i)) "(")
                      (not (lex/token-preceded-by-space? (tok-at tokens (load i))))))
            (do
              (store! function-like 1)
              (store! i (+ (load i) 1))
              (loop (if (>= (load i) until)
                        (break)
                        (let [t (tok-at tokens (load i))]
                          (cond (is-punct? t ")") (do (store! i (+ (load i) 1)) (break))
                                (is-punct? t ",") (store! i (+ (load i) 1))
                                (is-punct? t "...")
                                  (do
                                    (store! variadic 1)
                                    (al/al-push! [(slice u8)] (mut params) (copy-text (mut p) "__VA_ARGS__"))
                                    (store! i (+ (load i) 1)))
                                :else
                                  (do
                                    ;; GNU named variadic: `#define m(args...)`
                                    (if (and (< (+ (load i) 1) until)
                                             (is-punct? (tok-at tokens (+ (load i) 1)) "..."))
                                        (do (store! variadic 1) (store! i (+ (load i) 1)))
                                        0)
                                    (al/al-push! [(slice u8)] (mut params) (copy-text (mut p) (lex/token-text t)))
                                    (store! i (+ (load i) 1))))))))
            0)
        ;; A variadic macro's parameter list holds the named parameters; the
        ;; group standing for `__VA_ARGS__` is the one past them.
        (let [fixed
                (if (!= (load variadic) 0)
                    (- (al/al-len [(slice u8)] (mut params)) 1)
                    (al/al-len [(slice u8)] (mut params)))
              body-tokens (slice-tokens (mut p) tokens (load i) until)]
          (hm/hm-put! [(slice u8) Macro]
                      (mut (field p macros))
                      name
                      (Macro
                        :name name
                        :function-like (load function-like)
                        :variadic (load variadic)
                        :params (load (mut params))
                        :body body-tokens))
          fixed)))
  0)

;;; The `__has_*` family looks like a function-like macro but is answered by the
;;; preprocessor itself, so `defined(__has_include)` has to be true even though
;;; none of them is in the macro table.
(defn builtin-test? [(name (slice u8))] (-> bool)
  (or (text=? name "__has_include")
      (or (text=? name "__has_include_next")
          (or (text=? name "__has_feature")
              (or (text=? name "__has_extension")
                  (or (text=? name "__has_attribute")
                      (or (text=? name "__has_declspec_attribute")
                          (or (text=? name "__has_builtin")
                              (or (text=? name "__has_warning")
                                  (or (text=? name "__has_c_attribute")
                                      (or (text=? name "__has_cpp_attribute")
                                          (or (text=? name "__is_identifier")
                                              (text=? name "__building_module")))))))))))))

(defn definition-known? [(p (mut PP)) (name (slice u8))] (-> bool)
  (or (hm/hm-contains? (load (field p macros)) name) (builtin-test? name)))

(defn path-prefix? [(path (slice u8)) (root (slice u8))] (-> bool)
  (let [pn (slice-len path)
        rn (slice-len root)
        (mut i) 0
        (mut same) (>= pn rn)]
    (loop (if (or (not (load same)) (>= (load i) rn))
              (break)
              (do
                (if (!= (slice-get path (load i)) (slice-get root (load i)))
                    (store! same false)
                    0)
                (store! i (+ (load i) 1)))))
    (and (load same)
         (or (= pn rn)
             (or (= (slice-get root (- rn 1)) (primitive/cast u8 47))
                 (= (slice-get path rn) (primitive/cast u8 47)))))))

;;; The include-search entry which owns `file`. Use the longest matching root so
;;; nested include directories do not accidentally select an earlier parent.
(defn include-owner-index [(p (mut PP)) (file (slice u8))] (-> i64)
  (let [paths (load (field p include-paths))
        n (al/al-len [(slice u8)] paths)
        (mut best) -1
        (mut best-len) -1
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [root (al/al-get [(slice u8)] paths (load i))]
                (if (and (path-prefix? file root) (> (slice-len root) (load best-len)))
                    (do (store! best (load i)) (store! best-len (slice-len root)))
                    0)
                (store! i (+ (load i) 1)))))
    (load best)))

;;; The index just past the `)` that closes the argument list starting at `open`.
(defn skip-parens [(in (al/ArrayList lex/Token)) (open i64)] (-> i64)
  (let [n (tok-count in)
        (mut i) open
        (mut depth) 0
        (mut done) 0]
    (loop (if (or (!= (load done) 0) (>= (load i) n))
              (break)
              (let [t (tok-at in (load i))]
                (cond (is-punct? t "(") (store! depth (+ (load depth) 1))
                      (is-punct? t ")")
                        (do
                          (store! depth (- (load depth) 1))
                          (if (= (load depth) 0) (store! done 1) 0))
                      :else 0)
                (store! i (+ (load i) 1)))))
    (load i)))

;;; Answers `__has_include(<a/b.h>)` by running the same search a real `#include`
;;; would. Every other member of the family answers zero: a header that asks
;;; whether an extension exists gets told it does not, and takes the portable
;;; path, which is the one this compiler implements.
(defn builtin-test-value [(p (mut PP))
                          (in (al/ArrayList lex/Token))
                          (name (slice u8))
                          (open i64)
                          (close i64)
                          (at lex/Token)] (-> i64)
  (if (text=? name "__is_identifier")
      1
      (if (not (or (text=? name "__has_include") (text=? name "__has_include_next")))
          0
          (let [head (tok-at in (+ open 1))
                angled (is-punct? head "<")
                header
                  (if angled
                      (header-name (mut p) in (+ open 2) (- close 1))
                      (unquote-header (lex/token-text head)))
                next? (text=? name "__has_include_next")
                owner (if next? (include-owner-index (mut p) (lex/token-file at)) -1)
                found
                  (search-include (mut p)
                                  header
                                  angled
                                  (dirname (lex/token-file at))
                                  (if next? (+ owner 1) (if angled 0 -1)))]
            (.ok found)))))

;;; `defined X`, `defined(X)`, and the `__has_*` tests are resolved before
;;; expansion, because their operands must not themselves be expanded.
(defn resolve-defined [(p (mut PP)) (in (al/ArrayList lex/Token))] (-> (al/ArrayList lex/Token))
  (let [(mut out) (al/al-new [lex/Token] (load (field p a)))
        n (tok-count in)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [t (tok-at in (load i))]
                (cond (builtin-test? (lex/token-text t))
                        (if (or (>= (+ (load i) 1) n) (not (is-punct? (tok-at in (+ (load i) 1)) "(")))
                            (do (fail! (mut p) "this test needs an argument list" t) (store! i n))
                            (let [close (- (skip-parens in (+ (load i) 1)) 1)
                                  v (builtin-test-value (mut p) in (lex/token-text t) (+ (load i) 1) close t)]
                              (al/al-push! [lex/Token] (mut out) (number-token t v (mut p)))
                              (store! i (+ close 1))))
                      (not (is-word? t "defined")) (do (al/al-push! [lex/Token] (mut out) t) (store! i (+ (load i) 1)))
                      :else
                        (let [paren (and (< (+ (load i) 1) n) (is-punct? (tok-at in (+ (load i) 1)) "("))
                              at (+ (load i) (if paren 2 1))]
                          (if (>= at n)
                              (do (fail! (mut p) "#if defined needs a name" t) (store! i n))
                              (let [word (lex/token-text (tok-at in at))
                                    known (definition-known? (mut p) word)]
                                (al/al-push! [lex/Token] (mut out) (number-token t (if known 1 0) (mut p)))
                                (store! i (+ at (if paren 2 1))))))))))
    (load (mut out))))

(defn condition-value-inner [(p (mut PP)) (tokens (al/ArrayList lex/Token)) (from i64) (until i64)] (-> bool)
  (let [raw (slice-tokens (mut p) tokens from until)
        resolved (resolve-defined (mut p) raw)
        expanded (expand-run (mut p) resolved)
        ;; Feature-test operators can arrive through an object-like macro, as
        ;; gnulib's `_GL_HAS_BUILTIN_ADD_OVERFLOW` does. Resolve again after
        ;; expansion so the operator is answered by this frontend rather than
        ;; falling through to the integer-expression evaluator as an identifier.
        tested (resolve-defined (mut p) expanded)]
    (for [i 0 (tok-count tested)]
      (let [t (tok-at tested i)]
        (if (= (lex/token-kind t) lex/TK-CHARACTER)
            (let [escaped (parse-char-text (lex/token-text t))]
              (if (> (slice-len (.message escaped)) 0)
                  (fail! (mut p) (.message escaped) t) 0)) 0)))
    (!= (eval-condition tested) 0)))

(defn condition-value [(p (mut PP)) (tokens (al/ArrayList lex/Token)) (from i64) (until i64)] (-> bool)
  (if (not (load (field p bounded-expansion))) (condition-value-inner (mut p) tokens from until)
  (let [arena (primitive/alloc-stack scratch/ScratchArena) permanent (load (field p a))]
    (scratch/scratch-init-with-cap arena (alloc/malloc-allocator) 16384)
    (store! (field p a) (scratch/scratch-allocator arena))
    (let [value (condition-value-inner (mut p) tokens from until)]
      (store! (field p a) permanent) (promote-error! (mut p) arena)
      (temporary-peak! (mut p) arena)
      (store! (field p temporary-total) (+ (load (field p temporary-total)) (scratch/scratch-total arena)))
      (scratch/scratch-close! arena) value))))

(defn include-file! [(p (mut PP)) (found Found) (at lex/Token)] (-> i64)
  (if (hm/hm-contains? (load (field p once)) (.path found))
      0
      (if (>= (load (field p depth)) MAX-INCLUDE-DEPTH)
          (fail! (mut p) "#include nested too deeply" at)
          (match (fs/read-file (load (field p a)) (.path found))
            (Err [_] (fail! (mut p) "cannot read included file" at))
            (Ok [text]
                (let [(mut result) (lex/lex (container-storage (mut p)) (.path found) text)
                      conditional-depth (al/al-len [Conditional] (load (field p conditionals)))]
                  (if (lex/lex-failed? result)
                      (fail! (mut p) (.message result) at)
                      (do
                        (store! (field p depth) (+ (load (field p depth)) 1))
                        (process-tokens! (mut p) (.tokens result) (.path found) (.index found))
                        (store! (field p depth) (- (load (field p depth)) 1))
                        (if (and (= (load (field p failed)) 0)
                                 (!= (al/al-len [Conditional] (load (field p conditionals)))
                                     conditional-depth))
                            (fail! (mut p) "included file has an unbalanced conditional" at)
                            0)
                        0))
                  (release-tokens! (mut p) (mut (.tokens result)))))))))

(defn do-include! [(p (mut PP))
                   (tokens (al/ArrayList lex/Token))
                   (from i64)
                   (until i64)
                   (file (slice u8))
                   (from-path i64)
                   (next? bool)] (-> i64)
  (if (>= from until)
      (fail! (mut p) "#include needs a header name" (tok-at tokens (- from 1)))
      (let [first (tok-at tokens from)
            ;; `#include MACRO` is legal, so anything that is not already a
            ;; string or a `<` run is expanded first.
            direct (or (= (lex/token-kind first) lex/TK-STRING) (is-punct? first "<"))
            run
              (if direct
                  (slice-tokens (mut p) tokens from until)
                  (expand-run (mut p) (slice-tokens (mut p) tokens from until)))
            head (tok-at run 0)
            angled (is-punct? head "<")
            name
              (if angled
                  (header-name (mut p) run 1 (- (tok-count run) 1))
                  (unquote-header (lex/token-text head)))
            start (if next? (+ from-path 1) (if angled 0 -1))
            found (search-include (mut p) name angled (dirname file) start)]
        (if (= (.ok found) 0)
            (fail! (mut p) "cannot find included file" head)
            (include-file! (mut p) found head)))))

(defn directive! [(p (mut PP))
                  (tokens (al/ArrayList lex/Token))
                  (from i64)
                  (until i64)
                  (file (slice u8))
                  (from-path i64)] (-> i64)
  (if (>= from until)
      0  ; a bare `#` is a null directive
      (let [head (tok-at tokens from)
            name (lex/token-text head)
            body (+ from 1)
            live (active? (mut p))
            depth (al/al-len [Conditional] (load (field p conditionals)))]
        (cond ;; A conditional inside a skipped group is still tracked, so that its
              ;; `#endif` closes the right one, but its condition is never
              ;; evaluated: the tokens there may not even be a valid expression.
              (text=? name "ifdef")
                (push-conditional! (mut p)
                                   (and live
                                        (and (< body until)
                                             (definition-known? (mut p) (lex/token-text (tok-at tokens body))))))
              (text=? name "ifndef")
                (push-conditional! (mut p)
                                   (and live
                                        (and (< body until)
                                             (not (definition-known? (mut p) (lex/token-text (tok-at tokens body)))))))
              (text=? name "if") (push-conditional! (mut p) (and live (condition-value (mut p) tokens body until)))
              (text=? name "elif")
                (if (= depth 0)
                    (fail! (mut p) "#elif outside a conditional" head)
                    (let [top (al/al-elem [Conditional] (mut (field p conditionals)) (- depth 1))]
                      (if (!= (load (field top seen-else)) 0)
                          (fail! (mut p) "#elif after #else" head)
                          (if (or (= (load (field top outer)) 0) (!= (load (field top taken)) 0))
                              (store! (field top active) 0)
                              (let [now (if (condition-value (mut p) tokens body until) 1 0)]
                                (store! (field top active) now)
                                (store! (field top taken) now)
                                0)))))
              (text=? name "else")
                (if (= depth 0)
                    (fail! (mut p) "#else outside a conditional" head)
                    (let [top (al/al-elem [Conditional] (mut (field p conditionals)) (- depth 1))]
                      (store! (field top seen-else) 1)
                      (store! (field top active)
                              (if (and (!= (load (field top outer)) 0) (= (load (field top taken)) 0)) 1 0))
                      (store! (field top taken) 1)
                      0))
              (text=? name "endif")
                (if (= depth 0)
                    (fail! (mut p) "#endif without #if" head)
                    (do (al/al-pop! [Conditional] (mut (field p conditionals))) 0))
              ;; Everything below only runs in a live branch.
              (not live) 0
              (text=? name "define") (define! (mut p) tokens body until)
              (text=? name "undef")
                (if (>= body until)
                    (fail! (mut p) "#undef needs a name" head)
                    (do (hm/hm-remove! (mut (field p macros)) (lex/token-text (tok-at tokens body))) 0))
              (text=? name "include") (do-include! (mut p) tokens body until file from-path false)
              (text=? name "include_next") (do-include! (mut p) tokens body until file from-path true)
              (text=? name "error") (fail! (mut p) "#error" head)
              (text=? name "warning") 0
              (text=? name "line") 0
              (text=? name "pragma")
                (if (and (< body until) (is-word? (tok-at tokens body) "once"))
                    (do (hm/hm-put! (mut (field p once)) (copy-text (mut p) file) true) 0)
                    ;; Preserve packing directives in the token stream. Packing is
                    ;; lexical parser state, so dropping the directive here loses
                    ;; which later record declarations it governs.
                    (if (and (< (+ body 2) until)
                             (and (is-word? (tok-at tokens body) "pack")
                                  (is-punct? (tok-at tokens (+ body 1)) "(")))
                        (let [op (tok-at tokens (+ body 2))
                              marker
                                (cond (is-word? op "push") "__coil_pack_push"
                                      (is-word? op "pop") "__coil_pack_pop"
                                      (= (lex/token-kind op) lex/TK-NUMBER) "__coil_pack_set"
                                      (is-punct? op ")") "__coil_pack_reset"
                                      :else "")]
                          (if (> (slice-len marker) 0)
                              (do
                                (al/al-push! [lex/Token] (mut (field p out)) (retext head lex/TK-IDENT marker))
                                (let [(mut i) (+ body 3)]
                                  (if (= (lex/token-kind op) lex/TK-NUMBER)
                                      (al/al-push! [lex/Token] (mut (field p out)) op)
                                      (loop (if (>= (load i) until)
                                                (break)
                                                (let [candidate (tok-at tokens (load i))]
                                                  (if (= (lex/token-kind candidate) lex/TK-NUMBER)
                                                      (do
                                                        (al/al-push! [lex/Token] (mut (field p out)) candidate)
                                                        (break))
                                                      (store! i (+ (load i) 1))))))))
                                (al/al-push! [lex/Token] (mut (field p out)) (retext head lex/TK-PUNCT ";"))
                                0)
                              0))
                        0))
              :else (fail! (mut p) "unknown preprocessing directive" head)))))

(defn conditional-directive? [(tokens (al/ArrayList lex/Token))
                              (from i64)
                              (until i64)] (-> bool)
  (if (>= from until)
      false
      (let [name (lex/token-text (tok-at tokens from))]
        (or (text=? name "if")
            (or (text=? name "ifdef")
                (or (text=? name "ifndef")
                    (or (text=? name "elif")
                        (or (text=? name "else") (text=? name "endif")))))))))

(defn flush-run! [(p (mut PP)) (run (mut (al/ArrayList lex/Token)))] (-> i64)
  (let [count (tok-count (load run)) before (prof/retained-now)]
    (if (> count 0)
        (let [(mut r) (make-reader (load (field p a)) (load run) 0 count)]
          (if (load (field p bounded-expansion))
            (expand-stream! (mut p) (mut r) (mut (field p out)))
            (expand-into! (mut p) (mut r) (mut (field p out)))))
        0)
    (tr/count "c.pp.expand.retained-bytes" (- (prof/retained-now) before))
    (if (load (field p bounded-expansion))
      (al/al-clear! (mut run))
      (store! run (al/al-new [lex/Token] (load (field p a))))))
  0)

(defn process-tokens! [(p (mut PP))
                       (tokens (al/ArrayList lex/Token))
                       (file (slice u8))
                       (from-path i64)] (-> i64)
  (let [n (tok-count tokens)
        (mut run) (al/al-new [lex/Token] (container-storage (mut p)))
        (mut i) 0 (mut run-bytes) 0]
    (loop (if (or (!= (load (field p failed)) 0) (>= (load i) n))
              (break)
              (let [t (tok-at tokens (load i))]
                (cond ;; An included file's end-of-input is not the program's.
                      (= (lex/token-kind t) lex/TK-EOF) (store! i (+ (load i) 1))
                      (and (lex/token-at-line-start? t) (is-punct? t "#"))
                        (let [stop (line-end tokens (+ (load i) 1))]
                          (if (conditional-directive? tokens (+ (load i) 1) stop)
                              0
                              (flush-run! (mut p) (mut run)))
                          (directive! (mut p) tokens (+ (load i) 1) stop file from-path)
                          (store! i stop))
                      :else
                        (let [stop (next-directive tokens (load i))]
                          (if (active? (mut p))
                              (let [(mut j) (load i) before (prof/retained-now)]
                                (loop (if (>= (load j) stop)
                                          (break)
                                          (do
                                            (al/al-push! [lex/Token] (mut run) (tok-at tokens (load j)))
                                            (store! j (+ (load j) 1)))))
                                (store! run-bytes (+ (load run-bytes) (- (prof/retained-now) before))))
                              0)
                          (store! i stop))))))
    (flush-run! (mut p) (mut run))
    (release-tokens! (mut p) (mut run))
    (tr/profile-event "c.pp.run-retained-bytes" file (load run-bytes))))

;; ------------------------------------------------------------------- driver
(defn pp-new-with-storage [(a (dyn alloc/Allocator)) (containers (dyn alloc/Allocator))] (-> PP)
  (PP
    :a a
    :containers containers
    :bounded-expansion true
    :temporary-total 0 :temporary-peak 0
    :macros (hm/hm-new [(slice u8) Macro] a (str/str-keyops))
    :include-paths (al/al-new [(slice u8)] a)
    :once (hm/hm-new [(slice u8) bool] a (str/str-keyops))
    :expanding (al/al-new [(slice u8)] a)
    :conditionals (al/al-new [Conditional] a)
    :out (al/al-new [lex/Token] a)
    :depth 0
    :counter 0
    :failed 0
    :message ""
    :file ""
    :line 0))

;; Persistent source bytes, macro definitions and final output belong to `a`.
;; Temporary lexical/run vectors have explicit frees on both success and error.
(defn pp-new [(a (dyn alloc/Allocator))] (-> PP)
  (pp-new-with-storage a (alloc/malloc-allocator)))

(defn pp-add-include-path [(p (mut PP)) (path (slice u8))] (-> i64)
  (al/al-push! [(slice u8)] (mut (field p include-paths)) (copy-text (mut p) path))
  0)

;;; Defines a macro from source text, as `-D` does: `NAME`, `NAME=value`, or a
;;; full `NAME(args) body`. This is how the target's predefined macros are set.
(defn pp-define-text [(p (mut PP)) (text (slice u8))] (-> i64)
  (let [(mut b) (str/sb-new (load (field p a)))
        n (slice-len text)
        (mut i) 0
        (mut cut) -1]
    (loop (if (or (>= (load i) n) (>= (load cut) 0))
              (break)
              (do
                (if (= (primitive/cast i64 (slice-get text (load i))) 61)
                    (store! cut (load i))
                    0)
                (store! i (+ (load i) 1)))))
    (if (< (load cut) 0)
        (do (str/sb-push-str! (mut b) text) (str/sb-push-str! (mut b) " 1"))
        (do
          (str/sb-push-str! (mut b) (subslice text 0 (load cut)))
          (str/sb-push-byte! (mut b) (primitive/cast u8 32))
          (str/sb-push-str! (mut b) (subslice text (+ (load cut) 1) n))))
    (let [source (str/sb-str (load (mut b)))
          (mut result) (lex/lex (container-storage (mut p)) "<command line>" source)]
      (if (lex/lex-failed? result)
          (fail! (mut p) "invalid -D definition" (tok-at (.tokens result) 0))
          (define! (mut p) (.tokens result) 0 (- (tok-count (.tokens result)) 1)))
      (release-tokens! (mut p) (mut (.tokens result)))))
  0)

(defn pp-result [(p (mut PP))] (-> PPResult)
  (PPResult
    :tokens (load (field p out))
    :failed (load (field p failed))
    :message (load (field p message))
    :file (load (field p file))
    :line (load (field p line))))

;;; Reads one source file into the token stream, leaving the stream open.
(defn pp-read [(p (mut PP)) (file (slice u8)) (source (slice u8))] (-> PPResult)
  (let [(mut result) (lex/lex (container-storage (mut p)) file source)
        output (if (lex/lex-failed? result)
        (PPResult
          :tokens (load (field p out))
          :failed 1
          :message (.message result)
          :file (.file result)
          :line (.line result))
        (do
          (process-tokens! (mut p) (.tokens result) file -1)
          (if (and (= (load (field p failed)) 0)
                   (> (al/al-len [Conditional] (load (field p conditionals))) 0))
              (fail! (mut p) "unterminated #if" (tok-at (.tokens result) 0))
              0)
          (pp-result (mut p))))]
    (release-tokens! (mut p) (mut (.tokens result))) output))

;;; A header read ahead of the translation unit, as `-include` does. The end
;;; marker is deliberately not appended: the stream is not finished until the
;;; program itself has been read, and an early one would stop the parser at the
;;; end of the prefix.
(defn pp-read-prefix [(p (mut PP)) (file (slice u8)) (source (slice u8))] (-> PPResult)
  (pp-read (mut p) file source))

(defn preprocess [(p (mut PP)) (file (slice u8)) (source (slice u8))] (-> PPResult)
  (let [r (pp-read (mut p) file source)]
    (if (!= (.failed r) 0)
        r
        (do
          (al/al-push! [lex/Token]
                       (mut (field p out))
                       (lex/Token
                         :kind lex/TK-EOF
                         :text ""
                         :file file
                         :line 0
                         :column 1
                         :at-line-start 1
                         :preceded-by-space 0))
          (pp-result (mut p))))))
