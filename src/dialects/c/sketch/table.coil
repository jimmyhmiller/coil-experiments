;; A sketch, not wired in: what a generated module's static tables could say.
;;
;; Doom's info.c is 52 KB of initialised tables. The frontend currently emits one
;; store per member per element -- 36,171 of them, 44% of the whole generated
;; module -- because `alloc-static` gives zeroed storage and there is no way to
;; say what is in it. Those stores are correct and unreadable.
;;
;; This is the same work said once. Run it with:
;;   coil run src/dialects/c/sketch/table.coil
(module experiments.c.sketch-table)

(import "coil.primitive" :as primitive)

;; The address `offset` bytes into `base`, seen as a `ty`.
(defn c_at [(ty Code) (base Code) (offset Code)] (-> Code)
  `(primitive/cast (ptr ~ty) (primitive/index (primitive/cast (ptr u8) ~base) ~offset)))

;; The store one column of one row makes. A bare name is a function's address --
;; C's tables of handlers are the reason -- and `nil` is a null of the column's
;; own type.
(defn c_column [(base Code) (ty Code) (at i64) (value Code)] (-> Code)
  (if (primitive/code-sym? value)
      (if (primitive/code-eq value (primitive/datum->syntax base "nil"))
          `(set! (c_at ~ty ~base ~at) (primitive/zeroed ~ty))
          `(set! (c_at ~ty ~base ~at) (primitive/fnptr-of ~value)))
      `(set! (c_at ~ty ~base ~at) ~value)))

;; A zero is what the storage already holds, so writing it is work that changes
;; nothing. 22% of the stores the frontend emits today are this.
(defn c_zero? [(value Code)] (-> bool)
  (and (primitive/code-int? value) (= (primitive/code-int value) 0)))

;; A table of records: the shape once, then the rows.
;;
;;   (c_table (c_g_states) 40
;;            [(sprite i32 0) (frame i32 4) (tics i32 8)
;;             (action (fnptr c [] i64) 16) (nextstate i32 24) (misc1 i32 28)]
;;     [14  32768  -1  nil            0  0]
;;     [15      0   4  c_fn_A_Light0  2  0])
;;
;; A column names a member, the type it is stored as, and its offset within one
;; record; `stride` is the size of one. Both come from the layout the frontend
;; already computes, so nothing here is guessed.
;;
;; What comes out is the same stores. What changes is that the source says what
;; the C said.
(defn c_table [(base Code) (stride Code) (shape Code) & (rows Code)] (-> Code)
  (let [forms (primitive/code-list-new)
        span (primitive/code-int stride)
        columns (primitive/code-count shape)
        n (primitive/code-count rows)
        (mut r) 0]
    (loop
      (if (>= (load r) n)
          (break)
          (let [row (primitive/code-nth rows (load r))
                (mut c) 0]
            (loop
              (if (>= (load c) columns)
                  (break)
                  (let [column (primitive/code-nth shape (load c))
                        value (primitive/code-nth row (load c))
                        at (+ (* (load r) span)
                              (primitive/code-int (primitive/code-nth column 2)))]
                    (if (c_zero? value)
                        0
                        (do (primitive/code-list-push!
                              forms
                              (c_column base (primitive/code-nth column 1) at value))
                            0))
                    (store! c (+ (load c) 1)))))
            (store! r (+ (load r) 1)))))
    `(do ~@forms 0)))

;; ---------------------------------------------------------------------------
;; What a generated module would then contain, for three entries of Doom's
;; states[]. The C reads:
;;
;;   state_t states[NUMSTATES] = {
;;     {SPR_TROO, 32768, -1, NULL,       S_NULL,  0, 0},
;;     {SPR_SHTG,     0,  4, A_Light0,   S_LIGHT, 0, 0},
;;     {SPR_PUNG,     1, 10, A_Look,     S_NULL,  7, 0},
;;   };

(defn c_g_states [] (-> (ptr (array i64 15))) (primitive/alloc-static (array i64 15)))

(defn c_fn_A_Light0 [] (-> i64) 0)
(defn c_fn_A_Look [] (-> i64) 0)

(defn c_init_statics [] (-> i64)
  (c_table (c_g_states) 40
           [(sprite i32 0) (frame i32 4) (tics i32 8)
            (action (fnptr c [] i64) 16) (nextstate i32 24) (misc1 i32 28)]
    [14  32768  -1  nil            0  0]
    [15      0   4  c_fn_A_Light0  2  0]
    [16      1  10  c_fn_A_Look    0  7]))

(defn main [] (-> i32)
  (c_init_statics)
  (let [p (primitive/cast (ptr i32) (c_g_states))
        (mut i) 0]
    (loop (if (>= (load i) 30)
              (break)
              (do (print "{d} " (primitive/cast i64 (load (primitive/index p (load i)))))
                  (store! i (+ (load i) 1))))))
  (println "")
  (println "states[1].action is set: {d}"
           (if (primitive/icmp-ne
                 (primitive/cast i64
                   (primitive/cast (ptr i8)
                     (load (primitive/cast (ptr (fnptr c [] i64))
                             (primitive/index (primitive/cast (ptr u8) (c_g_states)) 56)))))
                 0)
               1
               0))
  0)
