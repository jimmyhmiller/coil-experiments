(module experiments.c.pp-test)
(import "experiments.c.lex" :as lex)
(import "experiments.c.pp" :as pp)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "coil.slice" :use *)
(import "coil.str" :as str)
(import "coil.fs" :as fs)
(import "coil.assert" :use *)
(import "coil.scratch" :as scratch)
(import "coil.guardalloc" :as guard)
(import "coil.hashmap" :as hm)
(import "experiments.c.parse" :as ps)
(import "coil.result" :use *)

;; The independent container allocator makes the lifetime contract executable.
;; Under --debug it protects every freed vector, including growth replacements.
(defstruct ContainerMeter [(inner (dyn alloc/Allocator)) (live i64) (freed i64)])
(impl alloc/Allocator ContainerMeter
  (allocate [(self (ptr ContainerMeter)) (request (ref alloc/AllocRequest))]
    (-> (Option (ptr i8)))
    (match (alloc/raw-alloc (.inner self) request)
      (None [] (None))
      (Some [memory] (set! (.live self) (+ (.live self) 1)) (Some memory))))
  (resize [(self (ptr ContainerMeter)) (memory (ptr i8))
           (old (ref alloc/AllocRequest)) (next (ref alloc/AllocRequest))] (-> bool) false)
  (remap [(self (ptr ContainerMeter)) (memory (ptr i8))
          (old (ref alloc/AllocRequest)) (next (ref alloc/AllocRequest))] (-> (Option (ptr i8))) (None))
  (deallocate [(self (ptr ContainerMeter)) (memory (ptr i8)) (request (ref alloc/AllocRequest))] (-> i64)
    (assert (> (.live self) 0))
    (set! (.live self) (- (.live self) 1)) (set! (.freed self) (+ (.freed self) 1))
    (alloc/raw-free (.inner self) memory request)))

(defn same-tokens! [(left (al/ArrayList lex/Token)) (right (al/ArrayList lex/Token))] (-> i64)
  (assert-eq (al/al-len left) (al/al-len right))
  (for [i 0 (al/al-len left)]
    (let [l (al/al-get left i) r (al/al-get right i)]
      (assert-eq (lex/token-kind l) (lex/token-kind r))
      (assert (str/str-eq (lex/token-text l) (lex/token-text r)))
      (assert (str/str-eq (lex/token-file l) (lex/token-file r)))
      (assert-eq (lex/token-line l) (lex/token-line r))
      (assert-eq (lex/token-column l) (lex/token-column r))
      (assert-eq (lex/token-at-line-start? l) (lex/token-at-line-start? r))
      (assert-eq (lex/token-preceded-by-space? l) (lex/token-preceded-by-space? r))) 0) 0)

(deftest freed-nested-file-containers-preserve-macros-output-and-provenance
  (let [a (alloc/malloc-allocator) meter (primitive/alloc-stack ContainerMeter)
        _init (set! meter (ContainerMeter :inner (guard/guard-allocator a) :live 0 :freed 0))
        (mut bounded) (pp/pp-new-with-storage a (primitive/make-dyn alloc/Allocator meter))
        (mut retained) (pp/pp-new a)
        _retain (set! (.bounded-expansion retained) false)
        path "tests/c/pp-fixtures/lifetime/parent.c"
        source (match (fs/read-file a path) (Ok [text] text) (Err [_] (assert false) ""))]
    (pp/pp-define-text (mut bounded) "COMMAND=7")
    (pp/pp-define-text (mut retained) "COMMAND=7")
    (let [result (pp/preprocess (mut bounded) path source)
          expected (pp/preprocess (mut retained) path source)]
      (assert-eq (.live meter) 0) (assert (> (.freed meter) 10))
      (assert-eq (.failed result) 0) (assert-eq (.failed expected) 0)
      (same-tokens! (.tokens expected) (.tokens result))
      (let [(mut parser) (ps/parser-new a (.tokens result) "nested") parsed (ps/parse (mut parser))]
        (assert-eq (.failed parsed) 0))
      ;; The PP remains usable after all lexical vectors have been protected.
      ;; Macro spellings from the child, parent, and command line still belong
      ;; to the persistent allocator, not to a dead container.
      (let [again (pp/preprocess (mut bounded) "later.c" "int next = OUTER(COMMAND);\n")
            reference (pp/preprocess (mut retained) "later.c" "int next = OUTER(COMMAND);\n")]
        (assert-eq (.failed again) 0) (same-tokens! (.tokens reference) (.tokens again))
        (assert-eq (.live meter) 0)))))

(deftest nested-lexical-and-directive-errors-release-every-container
  (let [a (alloc/malloc-allocator) meter (primitive/alloc-stack ContainerMeter)]
    (for [kind 0 3]
      (set! meter (ContainerMeter :inner (guard/guard-allocator a) :live 0 :freed 0))
      (let [(mut preprocessor) (pp/pp-new-with-storage a (primitive/make-dyn alloc/Allocator meter))
            source (cond (= kind 0) "#include \"error.h\"\n"
                         (= kind 1) "#include \"unbalanced.h\"\n"
                         :else "#include \"lexical.h\"\n")
            result (pp/preprocess (mut preprocessor) "tests/c/pp-fixtures/lifetime/errors.c" source)]
        (assert-eq (.failed result) 1) (assert-eq (.live meter) 0)
        (assert (> (.freed meter) 0)) (assert (> (slice-len (.message result)) 0))
        (assert (> (slice-len (.file result)) 0)) (assert (> (.line result) 0))) 0)))

;;; Preprocess `source` and render the result as space-separated spellings, which
;;; is the most direct way to assert on what a macro actually produced.
(defn expand [(source (slice u8))] (-> (slice u8))
  (let [a (alloc/malloc-allocator)
        (mut p) (pp/pp-new a)]
    (let [result (pp/preprocess (mut p) "t.c" source)
          (mut b) (str/sb-new a)
          (mut i) 0
          n (al/al-len [lex/Token] (.tokens result))]
      (assert (= (.failed result) 0))
      (loop (if (>= (load i) n)
                (break)
                (let [t (al/al-get [lex/Token] (.tokens result) (load i))]
                  (if (!= (lex/token-kind t) lex/TK-EOF)
                      (do
                        (if (> (slice-len (str/sb-str (load (mut b)))) 0)
                            (str/sb-push-byte! (mut b) (primitive/cast u8 32))
                            0)
                        (str/sb-push-str! (mut b) (lex/token-text t)))
                      0)
                  (store! i (+ (load i) 1)))))
      (str/sb-str (load (mut b))))))

(defn failed? [(source (slice u8))] (-> bool)
  (let [a (alloc/malloc-allocator)
        (mut p) (pp/pp-new a)]
    (let [result (pp/preprocess (mut p) "t.c" source)]
      (!= (.failed result) 0))))

(defn expand-file [(path (slice u8)) (include-path (slice u8))] (-> (slice u8))
  (let [a (alloc/malloc-allocator)]
    (match (fs/read-file a path)
      (Err [_] "")
      (Ok [source]
          (let [(mut p) (pp/pp-new a)]
            (pp/pp-add-include-path (mut p) include-path)
            (let [result (pp/preprocess (mut p) path source)
                  (mut b) (str/sb-new a)
                  tokens (.tokens result)
                  n (al/al-len [lex/Token] tokens)
                  (mut i) 0]
              (assert (= (.failed result) 0))
              (loop (if (>= (load i) n)
                        (break)
                        (let [t (al/al-get [lex/Token] tokens (load i))]
                          (if (!= (lex/token-kind t) lex/TK-EOF)
                              (do
                                (if (> (slice-len (str/sb-str (load (mut b)))) 0)
                                    (str/sb-push-byte! (mut b) (primitive/cast u8 32))
                                    0)
                                (str/sb-push-str! (mut b) (lex/token-text t)))
                              0)
                          (store! i (+ (load i) 1)))))
              (str/sb-str (load (mut b)))))))))

(deftest object-like-macros-expand
         (assert (str/str-eq (expand "#define N 42\nint x = N;") "int x = 42 ;")))

(deftest numeric-character-escapes-work-in-conditionals
  (assert (str/str-eq
    (expand "#if '\\x41' == 65 && '\\101' == 65 && '\\0' == 0\nYES\n#else\nNO\n#endif") "YES")))

(deftest invalid-character-escapes-in-conditionals-are-diagnosed
  (assert (failed? "#if '\\x'\nYES\n#endif"))
  (assert (failed? "#if '\\x100'\nYES\n#endif")))

(deftest macros-expand-inside-macros
         (assert (str/str-eq (expand "#define A 1\n#define B A + A\nB") "1 + 1")))

(deftest function-like-macros-take-arguments
         (assert (str/str-eq (expand "#define ADD(a, b) ((a) + (b))\nADD(1, 2)")
                             "( ( 1 ) + ( 2 ) )")))

(deftest arguments-are-expanded-before-substitution
         (assert (str/str-eq (expand "#define N 5\n#define ID(x) x\nID(N)") "5")))

;; The recursion rule is what stops this being an infinite loop.
(deftest a-macro-does-not-expand-inside-itself
         (assert (str/str-eq (expand "#define X X\nX") "X"))
         (assert (str/str-eq (expand "#define A B\n#define B A\nA") "A")))

(deftest a-function-like-macro-without-parens-is-just-a-name
         (assert (str/str-eq (expand "#define F(x) x\nF") "F"))
         (assert (str/str-eq (expand "#define F(x) x\nF + 1") "F + 1")))

;; The operand of `#` is stringified as written, without being expanded.
(deftest stringify-uses-the-argument-as-written
         (assert (str/str-eq (expand "#define N 7\n#define S(x) #x\nS(N)") "\"N\""))
         (assert (str/str-eq (expand "#define S(x) #x\nS(a + b)") "\"a + b\"")))

(deftest paste-joins-tokens
         (assert (str/str-eq (expand "#define CAT(a, b) a##b\nCAT(foo, bar)") "foobar"))
         (assert (str/str-eq (expand "#define CAT(a, b) a##b\nCAT(1, 2)") "12")))

(deftest variadic-macros-collect-the-rest
         (assert (str/str-eq (expand "#define P(f, ...) g(f, __VA_ARGS__)\nP(1, 2, 3)")
                             "g ( 1 , 2 , 3 )")))

;; The GNU comma swallow: with no variadic arguments the comma before
;; `__VA_ARGS__` disappears rather than leaving `g(1,)`.
(deftest an-empty-variadic-tail-drops-the-comma
         (assert (str/str-eq (expand "#define P(f, ...) g(f, ##__VA_ARGS__)\nP(1)")
                             "g ( 1 )")))

(deftest undef-removes-a-macro
         (assert (str/str-eq (expand "#define N 1\n#undef N\nN") "N")))

(deftest conditionals-select-a-branch
         (assert (str/str-eq (expand "#if 1\nyes\n#else\nno\n#endif") "yes"))
         (assert (str/str-eq (expand "#if 0\nyes\n#else\nno\n#endif") "no")))

(deftest ifdef-and-ifndef-test-definedness
         (assert (str/str-eq (expand "#define N 1\n#ifdef N\nyes\n#endif") "yes"))
         (assert (str/str-eq (expand "#ifndef N\nyes\n#endif") "yes"))
         (assert (str/str-eq (expand "#define N 1\n#ifndef N\nyes\n#endif") "")))

(deftest defined-works-with-and-without-parentheses
         (assert (str/str-eq (expand "#define N 1\n#if defined N\nyes\n#endif") "yes"))
         (assert (str/str-eq (expand "#define N 1\n#if defined(N)\nyes\n#endif") "yes"))
         (assert (str/str-eq (expand "#if defined(NOPE)\nyes\n#else\nno\n#endif") "no")))

(deftest elif-chains-take-the-first-true-branch
         (assert (str/str-eq (expand "#if 0\na\n#elif 1\nb\n#elif 1\nc\n#else\nd\n#endif") "b")))

;; An undefined identifier in `#if` is 0, so this must take the else branch.
(deftest unknown-identifiers-are-zero-in-conditionals
         (assert (str/str-eq (expand "#if SOMETHING_UNSET\nyes\n#else\nno\n#endif") "no")))

(deftest conditional-arithmetic-respects-precedence
         (assert (str/str-eq (expand "#if 2 + 3 * 4 == 14\nyes\n#endif") "yes"))
         (assert (str/str-eq (expand "#if (1 << 4) == 16\nyes\n#endif") "yes"))
         (assert (str/str-eq (expand "#if 0x10 == 16 && 010 == 8\nyes\n#endif") "yes"))
         (assert (str/str-eq (expand "#if 1 ? 0 : 1\nyes\n#else\nno\n#endif") "no")))

(deftest macros-are-expanded-in-conditionals
         (assert (str/str-eq (expand "#define V 3\n#if V > 2\nyes\n#endif") "yes")))

;; GNU C permits conditional directives between the tokens of a macro
;; invocation. Emacs uses this to assemble a flag argument to EV_SET.
(deftest conditionals-may-appear-inside-macro-arguments
         (assert (str/str-eq (expand "#define FLAGS(x) use(x)\nFLAGS((1\n#ifdef EXTRA\n| 2\n#endif\n| 4))")
                             "use ( ( 1 | 4 ) )"))
         (assert (str/str-eq (expand "#define EXTRA 1\n#define FLAGS(x) use(x)\nFLAGS((1\n#ifdef EXTRA\n| 2\n#endif\n| 4))")
                             "use ( ( 1 | 2 | 4 ) )")))

(deftest builtin-feature-tests-produced-by-macros-are-resolved
         (assert (str/str-eq (expand "#define HAS_OVERFLOW __has_builtin(__builtin_add_overflow)\n#if HAS_OVERFLOW\ncompiler\n#else\nportable\n#endif")
                             "portable")))

(deftest intrinsic-operators-have-consistent-definedness
  (assert (str/str-eq
    (expand "#ifdef __has_builtin\nIFDEF\n#endif\n#ifndef __has_builtin\nWRONG\n#endif\n#if defined __has_builtin\nDEFINED\n#endif\n#ifdef __has_include\nINCLUDE\n#endif\n#ifndef ordinary_missing\nMISSING\n#endif")
    "IFDEF DEFINED INCLUDE MISSING")))

;; A nested conditional inside a dead branch must stay dead, and its #endif
;; must not close the outer one.
(deftest nested-conditionals-inside-a-dead-branch-stay-dead
         (assert (str/str-eq (expand "#if 0\n#if 1\na\n#endif\nb\n#else\nc\n#endif") "c")))

(deftest builtin-line-and-file-are-available
         (assert (str/str-eq (expand "#define L __LINE__\nL") "2"))
         (assert (str/str-eq (expand "__FILE__") "\"t.c\"")))

;; Rescanning includes the tokens following an object-like replacement. This is
;; the ordinary alias pattern used by configurable libraries such as raylib.
(deftest an-object-like-alias-can-become-a-function-like-call
         (assert (str/str-eq (expand "#define F(x) [x]\n#define G F\nG(1)") "[ 1 ]"))
         (assert (str/str-eq (expand "#define F(x) [x]\n#define G F\n#define H G\nH(2)")
                             "[ 2 ]")))

(deftest preprocessing-resumes-after-an-included-files-eof
         (assert (str/str-eq (expand-file "tests/c/pp-fixtures/parent.c" "tests/c/pp-fixtures")
                             "before ; inside ; after ;")))

(deftest has-include-next-resumes-after-the-owning-include-directory
         (let [a (alloc/malloc-allocator)
               source
                 (match (fs/read-file a "tests/c/pp-fixtures/next-parent.c")
                   (Ok [text] text)
                   (Err [_] ""))
               (mut p) (pp/pp-new a)
               _first (pp/pp-add-include-path (mut p) "tests/c/pp-fixtures/next-first")
               _second (pp/pp-add-include-path (mut p) "tests/c/pp-fixtures/next-second")
               result (pp/preprocess (mut p) "tests/c/pp-fixtures/next-parent.c" source)]
           (assert (= (.failed result) 0))
           (assert (str/str-eq (lex/token-text (al/al-get [lex/Token] (.tokens result) 0))
                               "next"))))

(deftest unbalanced-conditionals-are-reported
         (assert (failed? "#if 1\nyes"))
         (assert (failed? "#endif"))
         (assert (failed? "#else")))

(deftest an-unknown-directive-is-reported
         (assert (failed? "#nonsense")))

(deftest expansion-scratch-preserves-token-values-and-positions
  (let [a (alloc/malloc-allocator) (mut source) (str/sb-new a)
        old-arena (primitive/alloc-stack scratch/ScratchArena)
        new-arena (primitive/alloc-stack scratch/ScratchArena)]
    (str/sb-push-str! (mut source) "#define CAT(a,b) a##b\n#define STR(a) #a\n#define F(a,b) CAT(a,b) STR(b) __COUNTER__ __FILE__ __LINE__\n")
    (for [i 0 2000]
      (str/sb-push-str! (mut source) "F(item,") (str/sb-push-i64! (mut source) i)
      (str/sb-push-str! (mut source) ")\n") 0)
    (scratch/scratch-init old-arena a) (scratch/scratch-init new-arena a)
    (let [(mut retained) (pp/pp-new (scratch/scratch-allocator old-arena))
          (mut bounded) (pp/pp-new (scratch/scratch-allocator new-arena))
          _policy (set! (.bounded-expansion retained) false)
          old (pp/preprocess (mut retained) "lifetime.c" (str/sb-str (load source)))
          new (pp/preprocess (mut bounded) "lifetime.c" (str/sb-str (load source)))]
      (assert-eq (.failed old) 0) (assert-eq (.failed new) 0)
      (assert-eq (al/al-len (.tokens old)) (al/al-len (.tokens new)))
      (for [i 0 (al/al-len (.tokens old))]
        (let [left (al/al-get (.tokens old) i) right (al/al-get (.tokens new) i)]
          (assert-eq (lex/token-kind left) (lex/token-kind right))
          (assert (str/str-eq (lex/token-text left) (lex/token-text right)))
          (assert (str/str-eq (lex/token-file left) (lex/token-file right)))
          (assert-eq (lex/token-line left) (lex/token-line right))
          (assert-eq (lex/token-column left) (lex/token-column right))
          (assert-eq (lex/token-at-line-start? left) (lex/token-at-line-start? right))
          (assert-eq (lex/token-preceded-by-space? left) (lex/token-preceded-by-space? right))) 0)
      (assert (< (scratch/scratch-live new-arena) (primitive/idiv (scratch/scratch-live old-arena) 2))))
    (scratch/scratch-close! old-arena) (scratch/scratch-close! new-arena)))

(deftest completed-tokens-own-spelling-and-provenance-after-preprocessor-release
  (let [a (alloc/malloc-allocator) arena (primitive/alloc-stack scratch/ScratchArena)]
    (scratch/scratch-init-with-cap arena (guard/guard-allocator a) 1048576)
    (let [temporary (scratch/scratch-allocator arena)
          (mut text) (str/sb-new temporary) (mut file) (str/sb-new temporary)]
      (str/sb-push-str! (mut file) "owned-input.c")
      (str/sb-push-str! (mut text) "#define CAT(a,b) a##b\n#define NUM(a) CAT(a,2)\n#define STR(a) #a\nint answer = NUM(4); char *name = STR(owned); int main(void) { return answer; }\n")
      (let [(mut preprocessor) (pp/pp-new temporary)
            borrowed (pp/preprocess (mut preprocessor) (str/sb-str (load file)) (str/sb-str (load text)))
            owned (pp/own-result a borrowed)]
        (assert-eq (.failed owned) 0)
        (scratch/scratch-close! arena)
        ;; With --debug, freed PP pages are protected rather than merely reused.
        (assert (str/str-eq (lex/token-file (al/al-get (.tokens owned) 0)) "owned-input.c"))
        (let [(mut parser) (ps/parser-new a (.tokens owned) "owned") result (ps/parse (mut parser))]
          (assert-eq (.failed result) 0))))))

(deftest completed-preprocessor-diagnostics-survive-protected-release
  (let [a (alloc/malloc-allocator) arena (primitive/alloc-stack scratch/ScratchArena)]
    (scratch/scratch-init-with-cap arena (guard/guard-allocator a) 1048576)
    (let [temporary (scratch/scratch-allocator arena)
          (mut file) (str/sb-new temporary) (mut source) (str/sb-new temporary)]
      (str/sb-push-str! (mut file) "owned-error.c") (str/sb-push-str! (mut source) "#error fresh diagnostic\n")
      (let [(mut preprocessor) (pp/pp-new temporary)
            borrowed (pp/preprocess (mut preprocessor) (str/sb-str (load file)) (str/sb-str (load source)))
            owned (pp/own-result a borrowed)]
        (scratch/scratch-close! arena)
        (assert-eq (.failed owned) 1) (assert (> (slice-len (.message owned)) 0))
        (assert (str/str-eq (.file owned) "owned-error.c")) (assert-eq (.line owned) 1)))))
