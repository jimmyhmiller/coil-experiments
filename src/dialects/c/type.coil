(module experiments.c.type)

(import "experiments.c.ast" :as ast)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as arraylist)
(import "coil.slice" :as slice)
(import "coil.str" :as str)

(export CType
        CTYPE-INVALID
        CTYPE-VOID
        CTYPE-BOOL
        CTYPE-SIGNED
        CTYPE-UNSIGNED
        CTYPE-FLOAT
        CTYPE-NAMED
        CTYPE-RECORD
        CTYPE-UNION
        CTYPE-ENUM
        CTYPE-POINTER
        CTYPE-ARRAY
        CTYPE-FUNCTION
        parse-type
        type-kind
        type-bits
        type-name
        type-child
        type-bound
        type-parameters
        type-variadic?
        type-prototype?
        type-compatible?)

(const CTYPE-INVALID 0)
(const CTYPE-VOID 1)
(const CTYPE-BOOL 2)
(const CTYPE-SIGNED 3)
(const CTYPE-UNSIGNED 4)
(const CTYPE-FLOAT 5)
(const CTYPE-NAMED 6)
(const CTYPE-RECORD 7)
(const CTYPE-UNION 8)
(const CTYPE-ENUM 9)
(const CTYPE-POINTER 10)
(const CTYPE-ARRAY 11)
(const CTYPE-FUNCTION 12)

;; A structural C type. Nodes live in the caller's arena. Arrays and functions
;; retain their actual declarator nesting; callers never compare canonicalized
;; strings. `bound = -1` denotes an incomplete/VLA array.
(defstruct CType
  [(kind i64)
   (bits i64)
   (name (slice u8))
   (child (ptr CType))
   (bound i64)
   (parameters (arraylist/ArrayList (ptr CType)))
   (variadic bool)
   (prototype bool)])

(const DECL-POINTER CTYPE-POINTER)
(const DECL-ARRAY CTYPE-ARRAY)
(const DECL-FUNCTION CTYPE-FUNCTION)
(defstruct DeclaratorOp
  [(kind i64)
   (bound i64)
   (parameters (arraylist/ArrayList (ptr CType)))
   (variadic bool)
   (prototype bool)])
(defstruct TypeParser
  [(allocator (dyn alloc/Allocator))
   (tokens (arraylist/ArrayList (slice u8)))
   (position i64)
   (failed bool)])

(defn type-kind [(t (ptr CType))] (-> i64)
  (load (field t kind)))
(defn type-bits [(t (ptr CType))] (-> i64)
  (load (field t bits)))
(defn type-name [(t (ptr CType))] (-> (slice u8))
  (load (field t name)))
(defn type-child [(t (ptr CType))] (-> (ptr CType))
  (load (field t child)))
(defn type-bound [(t (ptr CType))] (-> i64)
  (load (field t bound)))
(defn type-parameters [(t (ptr CType))] (-> (arraylist/ArrayList (ptr CType)))
  (load (field t parameters)))
(defn type-variadic? [(t (ptr CType))] (-> bool)
  (load (field t variadic)))
(defn type-prototype? [(t (ptr CType))] (-> bool)
  (load (field t prototype)))

(defn new-type [(p (ptr TypeParser)) (kind i64)] (-> (ptr CType))
  (match (alloc/box (load (field p allocator)) CType (primitive/zeroed CType))
    (None []
          (do
            (store! (field p failed) true)
            (primitive/cast (ptr CType) 0)))
    (Some [node]
          (do
            (store! (field node kind) kind)
            (store! (field node bound) -1)
            (store! (field node parameters)
                    (arraylist/al-new [(ptr CType)] (load (field p allocator))))
            node))))

(defn parser-length [(p (ptr TypeParser))] (-> i64)
  (arraylist/al-len (field p tokens)))
(defn parser-token [(p (ptr TypeParser)) (offset i64)] (-> (slice u8))
  (let [at (+ (load (field p position)) offset)]
    (if (or (< at 0) (>= at (parser-length p)))
        ""
        (arraylist/al-get [(slice u8)] (load (field p tokens)) at))))
(defn parser-take [(p (ptr TypeParser))] (-> (slice u8))
  (let [token (parser-token p 0)]
    (if (> (slice/slice-len token) 0)
        (store! (field p position) (+ (load (field p position)) 1))
        0)
    token))
(defn parser-accept [(p (ptr TypeParser)) (token (slice u8))] (-> bool)
  (if (str/str-eq (parser-token p 0) token)
      (do (parser-take p) true)
      false))
(defn parser-expect [(p (ptr TypeParser)) (token (slice u8))] (-> bool)
  (if (parser-accept p token)
      true
      (do (store! (field p failed) true) false)))

(defn qualifier? [(token (slice u8))] (-> bool)
  (or (str/str-eq token "const")
      (or (str/str-eq token "volatile")
          (or (str/str-eq token "restrict")
              (or (str/str-eq token "_Atomic")
                  (or (str/str-eq token "__cdecl")
                      (or (str/str-eq token "__stdcall")
                          (str/str-eq token "__fastcall"))))))))

(defn skip-qualifiers! [(p (ptr TypeParser))] (-> i64)
  (loop (if (qualifier? (parser-token p 0)) (parser-take p) (break)))
  0)

(defn decimal [(token (slice u8))] (-> i64)
  (let [(mut value) 0
        (mut i) 0
        (mut valid) (> (slice/slice-len token) 0)]
    (loop (if (>= (load i) (slice/slice-len token))
              (break)
              (let [byte (slice/slice-get token (load i))]
                (if (and (>= byte (primitive/cast u8 #\0)) (<= byte (primitive/cast u8 #\9)))
                    (do
                      (store! value
                              (+ (* (load value) 10)
                                 (- (primitive/cast i64 byte) (primitive/cast i64 #\0))))
                      (store! i (+ (load i) 1)))
                    (do (store! valid false) (break))))))
    (if (load valid) (load value) -1)))

(defn base-type [(p (ptr TypeParser))] (-> (ptr CType))
  (let [(mut signed) false
        (mut unsigned) false
        (mut shorts) 0
        (mut longs) 0
        (mut base) ""
        (mut tag-kind) 0
        (mut tag-name) ""
        (mut consumed) false]
    (loop (let [token (parser-token p 0)]
            (cond (qualifier? token) (do (parser-take p) (store! consumed true))
                  (str/str-eq token "signed") (do (parser-take p) (store! signed true) (store! consumed true))
                  (str/str-eq token "unsigned") (do (parser-take p) (store! unsigned true) (store! consumed true))
                  (str/str-eq token "short")
                    (do (parser-take p) (store! shorts (+ (load shorts) 1)) (store! consumed true))
                  (str/str-eq token "long")
                    (do (parser-take p) (store! longs (+ (load longs) 1)) (store! consumed true))
                  (or (str/str-eq token "void")
                      (or (str/str-eq token "_Bool")
                          (or (str/str-eq token "char")
                              (or (str/str-eq token "int")
                                  (or (str/str-eq token "float")
                                      (str/str-eq token "double"))))))
                    (do (store! base (parser-take p)) (store! consumed true))
                  (or (str/str-eq token "struct")
                      (or (str/str-eq token "union") (str/str-eq token "enum")))
                    (do
                      (store! tag-kind
                              (if (str/str-eq token "struct")
                                  CTYPE-RECORD
                                  (if (str/str-eq token "union") CTYPE-UNION CTYPE-ENUM)))
                      (parser-take p)
                      (store! tag-name (parser-take p))
                      (store! consumed true))
                  :else (break))))
    (if (= (load tag-kind) 0)
        ;; Qualifiers may precede a typedef name (`const cJSON`). They do not
        ;; themselves make the base an implicit `int`; only scalar specifiers do.
        (if (and (= (slice/slice-len (load base)) 0)
                 (and (not (load signed))
                      (and (not (load unsigned))
                           (and (= (load shorts) 0) (= (load longs) 0)))))
            (let [name (parser-take p)
                  node (new-type p CTYPE-NAMED)]
              (if (= (slice/slice-len name) 0) (store! (field p failed) true) 0)
              (if (!= (primitive/cast i64 node) 0) (store! (field node name) name) 0)
              node)
            (let [kind
                    (cond (str/str-eq (load base) "void") CTYPE-VOID
                          (str/str-eq (load base) "_Bool") CTYPE-BOOL
                          (or (str/str-eq (load base) "float")
                              (str/str-eq (load base) "double"))
                            CTYPE-FLOAT
                          (load unsigned) CTYPE-UNSIGNED
                          :else CTYPE-SIGNED)
                  bits
                    (cond (= kind CTYPE-VOID) 0
                          (= kind CTYPE-BOOL) 1
                          (str/str-eq (load base) "char") 8
                          (> (load shorts) 0) 16
                          (= kind CTYPE-FLOAT) (if (str/str-eq (load base) "float") 32 64)
                          (> (load longs) 0) 64
                          :else 32)
                  node (new-type p kind)]
              (if (!= (primitive/cast i64 node) 0) (store! (field node bits) bits) 0)
              node))
        (let [node (new-type p (load tag-kind))]
          (if (!= (primitive/cast i64 node) 0) (store! (field node name) (load tag-name)) 0)
          node))))

(defn new-op [(p (ptr TypeParser)) (kind i64)] (-> DeclaratorOp)
  (let [op (primitive/alloc-stack DeclaratorOp)]
    (store! op (primitive/zeroed DeclaratorOp))
    (store! (field op kind) kind)
    (store! (field op bound) -1)
    (store! (field op parameters)
            (arraylist/al-new [(ptr CType)] (load (field p allocator))))
    (load op)))

(defn parse-type-inner [(p (ptr TypeParser))] (-> (ptr CType))
  (let [base (base-type p)
        (mut ops) (arraylist/al-new [DeclaratorOp] (load (field p allocator)))]
    (parse-declarator p (mut ops))
    (let [(mut result) base
          (mut i) (- (arraylist/al-len (mut ops)) 1)]
      (loop (if (< (load i) 0)
                (break)
                (let [op (arraylist/al-get [DeclaratorOp] (load ops) (load i))
                      node (new-type p (load (field op kind)))]
                  (if (!= (primitive/cast i64 node) 0)
                      (do
                        (store! (field node child) (load result))
                        (store! (field node bound) (load (field op bound)))
                        (store! (field node parameters) (load (field op parameters)))
                        (store! (field node variadic) (load (field op variadic)))
                        (store! (field node prototype) (load (field op prototype))))
                      0)
                  (store! result node)
                  (store! i (- (load i) 1)))))
      (load result))))

(defn grouped-declarator? [(p (ptr TypeParser))] (-> bool)
  (and (str/str-eq (parser-token p 0) "(")
       (let [next (parser-token p 1)]
         (or (str/str-eq next "*")
             (or (str/str-eq next "(") (str/str-eq next "["))))))

(defn parse-parameters [(p (ptr TypeParser)) (op (ptr DeclaratorOp))] (-> i64)
  (if (parser-accept p ")")
      0
      (if (and (str/str-eq (parser-token p 0) "void")
               (str/str-eq (parser-token p 1) ")"))
          (do
            (store! (field op prototype) true)
            (parser-take p)
            (parser-take p)
            0)
          (do
            (store! (field op prototype) true)
            (loop (if (parser-accept p "...")
                      (do (store! (field op variadic) true) (break))
                      (arraylist/al-push! (mut (field op parameters)) (parse-type-inner p)))
              (if (parser-accept p ",")
                  0
                  (break)))
            (parser-expect p ")")
            0))))

;; Produce operators in identifier-outward order. Reversing them onto the base
;; implements C precedence exactly: `*[3]` becomes array-of-pointer while
;; `(*)[3]` becomes pointer-to-array.
(defn parse-declarator [(p (ptr TypeParser))
                        (ops (mut (arraylist/ArrayList DeclaratorOp)))] (-> i64)
  (let [(mut pointers) 0]
    (loop (if (parser-accept p "*")
              (do (store! pointers (+ (load pointers) 1)) (skip-qualifiers! p))
              (break)))
    (if (grouped-declarator? p)
        (do
          (parser-take p)
          (parse-declarator p (mut ops))
          (parser-expect p ")")
          0)
        0)
    (loop (cond (parser-accept p "[")
                  (let [(mut op) (new-op p DECL-ARRAY)
                        token (parser-token p 0)]
                    (if (not (str/str-eq token "]"))
                        (store! (field op bound) (decimal (parser-take p)))
                        0)
                    (parser-expect p "]")
                    (arraylist/al-push! (mut ops) (load op)))
                (parser-accept p "(")
                  (let [(mut op) (new-op p DECL-FUNCTION)]
                    (parse-parameters p (mut op))
                    (arraylist/al-push! (mut ops) (load op)))
                :else (break)))
    (let [(mut i) 0]
      (loop (if (>= (load i) (load pointers))
                (break)
                (do
                  (arraylist/al-push! (mut ops) (new-op p DECL-POINTER))
                  (store! i (+ (load i) 1))))))
    0))

(defn skip-trailing-attributes! [(p (ptr TypeParser))] (-> i64)
  (loop (let [token (parser-token p 0)]
          (if (or (str/str-eq token "__attribute__")
                  (str/str-eq token "__attribute"))
              (do
                (parser-take p)
                (if (parser-accept p "(")
                    (let [(mut depth) 1]
                      (loop (if (= (load depth) 0)
                                (break)
                                (let [part (parser-take p)]
                                  (if (= (slice/slice-len part) 0)
                                      (do (store! (field p failed) true) (break))
                                      (if (str/str-eq part "(")
                                          (store! depth (+ (load depth) 1))
                                          (if (str/str-eq part ")")
                                              (store! depth (- (load depth) 1))
                                              0)))))))
                    (store! (field p failed) true))
                0)
              (break))))
  0)

(defn parse-type [(a (dyn alloc/Allocator)) (spelling (slice u8))] (-> (ptr CType))
  (let [(mut lexer) (ast/c-type-lexer spelling)
        p (primitive/alloc-stack TypeParser)]
    (store! p (primitive/zeroed TypeParser))
    (store! (field p allocator) a)
    (store! (field p tokens) (arraylist/al-new [(slice u8)] a))
    (loop (let [token (ast/c-type-next (mut lexer))]
            (if (= (slice/slice-len token) 0)
                (break)
                (arraylist/al-push! (mut (field p tokens)) token))))
    (let [result (parse-type-inner p)]
      (skip-trailing-attributes! p)
      (if (or (load (field p failed))
              (!= (load (field p position)) (parser-length p)))
          (do
            (if (!= (primitive/cast i64 result) 0)
                (store! (field result kind) CTYPE-INVALID)
                0)
            result)
          result))))

(defn type-parameters-compatible? [(left (ptr CType)) (right (ptr CType))] (-> bool)
  (let [a (type-parameters left)
        b (type-parameters right)
        count (arraylist/al-len a)
        (mut compatible) (= count (arraylist/al-len b))
        (mut i) 0]
    (loop (if (or (not (load compatible)) (>= (load i) count))
              (break)
              (do
                (if (not (type-compatible? (arraylist/al-get [(ptr CType)] a (load i))
                                           (arraylist/al-get [(ptr CType)] b (load i))))
                    (store! compatible false)
                    0)
                (store! i (+ (load i) 1)))))
    (load compatible)))

;; C linkage compatibility over resolved structural types. An incomplete array
;; is compatible with a completed bound, and an old-style function declaration
;; contributes only its return type. Typedef aliases must be resolved by the AST
;; index before this comparison.
(defn type-compatible? [(left (ptr CType)) (right (ptr CType))] (-> bool)
  (if (or (= (primitive/cast i64 left) 0) (= (primitive/cast i64 right) 0))
      false
      (let [kind (type-kind left)]
        (if (!= kind (type-kind right))
            false
            (cond (or (= kind CTYPE-VOID) (= kind CTYPE-BOOL)) true
                  (or (= kind CTYPE-SIGNED)
                      (or (= kind CTYPE-UNSIGNED) (= kind CTYPE-FLOAT)))
                    (= (type-bits left) (type-bits right))
                  (or (= kind CTYPE-NAMED)
                      (or (= kind CTYPE-RECORD)
                          (or (= kind CTYPE-UNION) (= kind CTYPE-ENUM))))
                    (str/str-eq (type-name left) (type-name right))
                  (= kind CTYPE-POINTER) (type-compatible? (type-child left) (type-child right))
                  (= kind CTYPE-ARRAY)
                    (and (or (= (type-bound left) (type-bound right))
                             (or (< (type-bound left) 0) (< (type-bound right) 0)))
                         (type-compatible? (type-child left) (type-child right)))
                  (= kind CTYPE-FUNCTION)
                    (and (type-compatible? (type-child left) (type-child right))
                         (or (not (type-prototype? left))
                             (or (not (type-prototype? right))
                                 (and (= (type-variadic? left) (type-variadic? right))
                                      (type-parameters-compatible? left right)))))
                  :else false)))))
