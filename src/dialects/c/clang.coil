(module experiments.c.clang)

(import "experiments.c.ast" :as ast)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as arraylist)
(import "coil.cancellation" :as cancellation)
(import "coil.slice" :as slice)
(import "coil.subprocess" :as subprocess)
(import "coil.time" :as time)

(export ClangUnit
        ClangError
        ClangExecuteFailed
        ClangOutputTooLarge
        ClangRejected
        ClangInvalidJson
        clang-unit
        clang-unit-ast
        clang-unit-free!)

;; Owns both Clang's captured JSON bytes and the zero-copy token tape over them.
;; The native builder retains units for one serial index/lower build, then frees
;; each unit immediately after its fragment has been produced.
(defstruct ClangUnit [(process subprocess/RunResult) (tree ast/Ast)])
(defsum ClangError
  (ClangExecuteFailed)
  (ClangOutputTooLarge)
  (ClangRejected)
  (ClangInvalidJson))

(defn clang-status-ok? [(status subprocess/ExitStatus)] (-> bool)
  (match status
    (subprocess/Exited [code] (= code 0))
    (subprocess/Signaled [_] false)))

(defn append-arg! [(args (mut (arraylist/ArrayList (slice u8))))
                   (value (slice u8))] (-> i64)
  (arraylist/al-push! (mut args) value))

;; Execute Clang directly with argv. It performs preprocessing and semantic
;; analysis only; LLVM IR, object, assembly, and executable output are forbidden
;; from this boundary.
(defn clang-unit [(a (dyn alloc/Allocator))
                  (path (slice u8))
                  (flags (slice (slice u8)))] (-> (Result ClangUnit ClangError))
  (let [(mut args) (arraylist/al-new [(slice u8)] a)]
    (append-arg! (mut args) "-std=gnu11")
    (append-arg! (mut args) "-fsyntax-only")
    (append-arg! (mut args) "-Wno-everything")
    (let [(mut i) 0]
      (loop (if (>= (load i) (slice/slice-len flags))
                (break)
                (do
                  (append-arg! (mut args) (slice/slice-get flags (load i)))
                  (store! i (+ (load i) 1))))))
    (append-arg! (mut args) "-Xclang")
    (append-arg! (mut args) "-ast-dump=json")
    (append-arg! (mut args) path)
    (let [result (primitive/alloc-stack subprocess/RunResult)
          grace (primitive/zeroed time/Duration)
          options
            (subprocess/run-options "clang"
                                    (slice/slice-new [(slice u8)]
                                                     (load (field args data))
                                                     (arraylist/al-len (mut args)))
                                    ""
                                    ;; A typed AST is far larger than the source
                                    ;; that produced it, and the headers a unit
                                    ;; includes dominate: 25 lines over SDL.h
                                    ;; and SDL_mixer.h dump 148MB of JSON. The
                                    ;; capture is bounded only to keep a runaway
                                    ;; from exhausting memory, and one unit is
                                    ;; freed before the next is parsed.
                                    (* (* 1024 1024) 1024)
                                    (* 1024 1024)
                                    (None [time/Instant])
                                    (primitive/cast (ptr cancellation/Cancellation) 0)
                                    grace)]
      (match (subprocess/run a result options)
        (Err [_]
             (do
               (arraylist/al-free! (mut args))
               (Err (ClangExecuteFailed))))
        (Ok [_]
            (do
              (arraylist/al-free! (mut args))
              (if (load (field result stdout-truncated))
                  (do
                    (subprocess/run-result-free a result)
                    (Err (ClangOutputTooLarge)))
                  (if (not (clang-status-ok? (load (field result status))))
                      (do
                        (subprocess/run-result-free a result)
                        (Err (ClangRejected)))
                      (match (ast/ast-parse a (load (field result stdout)))
                        (Err [_]
                             (do
                               (subprocess/run-result-free a result)
                               (Err (ClangInvalidJson))))
                        (Ok [tree]
                            (let [unit (primitive/alloc-stack ClangUnit)]
                              (store! (field unit process) (load result))
                              (store! (field unit tree) tree)
                              (Ok (load unit)))))))))))))

(defn clang-unit-ast [(unit ClangUnit)] (-> ast/Ast)
  (load (field unit tree)))

(defn clang-unit-free! [(a (dyn alloc/Allocator)) (unit (mut ClangUnit))] (-> i64)
  (ast/ast-free! (mut (field unit tree)))
  (subprocess/run-result-free a (field unit process)))
