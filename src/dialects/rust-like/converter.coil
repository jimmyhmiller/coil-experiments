              (nc-skip-node! p) 0)
          (if (not (nc-simple-params? p)) (store! yes false)
              (nc-skip-node! p))
          (nc-skip! p)
          (if (not (nc-form-head? p "->")) (store! yes false)
              (nc-skip-node! p))
          (nc-skip! p)
          (if (or (= (nc-byte p) 41) (= (nc-byte p) -1)) (store! yes false)
