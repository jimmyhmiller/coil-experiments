    (nc-skip! p)
    (if (= (nc-byte p) 91) (nc-skip-node! p) 0)
    (nc-skip-node! p)
    (nc-skip! p)
    (if (and (not (= (nc-byte p) 41)) (not (nc-raw-method-renderable? p)))
        (do (nc-skip-node! p) (nc-skip! p)) 0)
    (loop
      (nc-skip! p)
      (if (or (not (load yes)) (= (nc-byte p) 41)) (break)
          (if (not (nc-raw-method-renderable? p)) (store! yes false)
              (nc-skip-node! p))))
    (set! (.at p) saved)
    (load yes)))

(defn render-raw-impl-method! [(p (ptr NativeCursor))
                               (out (mut str/StrBuf))] (-> i64)
  (do
    (nc-skip! p) (nc-step! p)
    (str/sb-push-str! (mut out) "    fn ")
    (render-raw-name! (nc-read-atom! p) (mut out))
    (if (nc-vector-followed-by-vector? p) (render-raw-generics! p (mut out)) 0)
    (render-raw-params! p (mut out))
    (str/sb-push-str! (mut out) " -> ")
    (render-raw-return! p (mut out))
    (str/sb-push-str! (mut out) " {\n        ")
    (render-surface-expr! p (mut out))
    (str/sb-push-str! (mut out) "\n    }")
    (nc-skip! p)
    (if (not (= (nc-byte p) 41))
        (converter-fail "rust-like converter: malformed impl method\n") 0)
    (nc-step! p)
    (str/sb-push-byte! (mut out) (primitive/cast u8 10))))

(defn render-raw-impl! [(p (ptr NativeCursor)) (out (mut str/StrBuf))] (-> i64)
  (do
    (nc-skip! p) (nc-step! p) (nc-read-atom! p)
    (str/sb-push-str! (mut out) "impl")
    (nc-skip! p)
    (if (= (nc-byte p) 91) (render-raw-generics! p (mut out)) 0)
    (str/sb-push-byte! (mut out) (primitive/cast u8 32))
    (let [first-start (.at p)]
      (nc-skip-node! p)
      (nc-skip! p)
      (let [inherent (or (= (nc-byte p) 41) (nc-raw-method-renderable? p))]
        (set! (.at p) first-start)
        (render-native-node! p (mut out))
