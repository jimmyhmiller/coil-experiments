      (render-raw-params! p (mut out))
      (str/sb-push-str! (mut out) " -> ")
      (render-raw-return! p (mut out))
      (str/sb-push-str! (mut out) " {\n    ")
      (render-surface-expr! p (mut out))
      (str/sb-push-str! (mut out) "\n}\n\n")
      (nc-skip! p)
