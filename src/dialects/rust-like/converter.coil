    (nc-skip! p) (nc-step! p) (nc-read-atom! p)
    (str/sb-push-str! (mut out) spelling)
    (str/sb-push-byte! (mut out) (primitive/cast u8 32))
    (render-raw-name! (nc-read-atom! p) (mut out))
    (nc-skip! p)
    (if (= (nc-byte p) 41) 0
        (do
          (let [phase (nc-read-atom! p) value (nc-read-atom! p)]
            (if (and (= phase ":phase") (= value "before-expand"))
                (str/sb-push-str! (mut out) " before_expand")
                (converter-fail "rust-like converter: unsupported registration clause\n")))
          (nc-skip! p)))
    (if (not (= (nc-byte p) 41))
        (converter-fail "rust-like converter: malformed registration\n") 0)
    (nc-step! p)
    (str/sb-push-str! (mut out) ";\n\n")))

(defn render-raw-meta! [(p (ptr NativeCursor)) (out (mut str/StrBuf))] (-> i64)
