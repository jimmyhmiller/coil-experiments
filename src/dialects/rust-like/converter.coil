(defn render-raw-import! [(p (ptr NativeCursor)) (out (mut str/StrBuf))] (-> i64)
  (do
    (nc-skip! p) (nc-step! p)
    (nc-read-atom! p)
    (nc-skip! p)
    (let [module-start (.at p)]
      (if (= (nc-byte p) 34) (nc-string-end! p false)
          (converter-fail "rust-like converter: import path must be a string\n"))
      (str/sb-push-str! (mut out) "use ")
      (str/sb-push-str! (mut out)
        (slice/subslice (.source p) module-start (.at p)))
      (nc-skip! p)
      (if (= (nc-byte p) 41)
          (do (nc-step! p) (str/sb-push-str! (mut out) ";\n\n"))
          (do
            (str/sb-push-str! (mut out) " with {\n")
            (loop
              (nc-skip! p)
              (if (= (nc-byte p) 41) (break)
                  (let [key (nc-read-atom! p)]
                    (if (or (= (slice/slice-len key) 0)
                            (not (= (slice/slice-get key 0) (primitive/cast u8 58))))
                        (converter-fail "rust-like converter: malformed import clause\n") 0)
                    (str/sb-push-str! (mut out) "    ")
                    (str/sb-push-str! (mut out)
                      (slice/subslice key 1 (slice/slice-len key)))
                    (str/sb-push-str! (mut out) ": ")
                    (nc-skip! p)
                    (if (= key ":reexport")
                        (str/sb-push-str! (mut out) "true")
                        (if (and (= key ":use")
                                 (nc-prefix? p "*"))
                            (do (nc-step! p) (str/sb-push-byte! (mut out) (primitive/cast u8 42)))
                            (render-native-node! p (mut out))))
                    (str/sb-push-str! (mut out) ",\n"))))
            (nc-step! p)
            (str/sb-push-str! (mut out) "};\n\n"))))))

(defn render-raw-export! [(p (ptr NativeCursor)) (out (mut str/StrBuf))] (-> i64)
  (do
    (nc-skip! p) (nc-step! p) (nc-read-atom! p)
    (str/sb-push-str! (mut out) "export { ")
    (let [(mut first) true]
      (loop
