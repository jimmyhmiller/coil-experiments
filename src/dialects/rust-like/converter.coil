    (nc-read-atom! p)
    (let [name (nc-read-atom! p)]
      (nc-skip! p)
      (str/sb-push-str! (mut out) "extern")
      (if (= (nc-byte p) 91)
          0
          (do
            (nc-read-atom! p)
            (str/sb-push-byte! (mut out) (primitive/cast u8 32))
            (json-string! (mut out) (nc-read-atom! p))))
      (str/sb-push-str! (mut out) " {\n    fn ")
      (render-raw-name! name (mut out)))
    (nc-skip! p)
    (nc-step! p)
    (str/sb-push-byte! (mut out) (primitive/cast u8 40))
    (let [(mut first) true]
      (loop (nc-skip! p)
        (if (= (nc-byte p) 93)
            (break)
            (do
              (if (load first)
                  (store! first false)
                  (str/sb-push-str! (mut out) ", "))
              (str/sb-push-str! (mut out) "_arg")
              (str/sb-push-str! (mut out) ": ")
              (render-raw-type! p (mut out))))))
    (nc-step! p)
    (str/sb-push-str! (mut out) ") -> ")
    (nc-skip! p)
    (nc-step! p)
    (nc-read-atom! p)
    (render-raw-type! p (mut out))
    (nc-skip! p)
    (if (not (= (nc-byte p) 41))
        (converter-fail "rust-like converter: malformed extern return\n")
        0)
    (nc-step! p)
    (nc-skip! p)
    (if (not (= (nc-byte p) 41))
        (converter-fail "rust-like converter: malformed extern declaration\n")
        0)
    (nc-step! p)
    (str/sb-push-str! (mut out) ";\n}\n\n")))

(defn nc-string-end! [(p (ptr NativeCursor)) (c-prefix bool)] (-> i64)
  (do
    (if c-prefix (nc-step! p) 0)
    (if (not (= (nc-byte p) 34)) (converter-fail "rust-like converter: expected string\n") 0)
    (nc-step! p)
    (let [(mut escaped) false
          (mut done) false]
      (loop (if (load done)
                (break)
                (let [c (nc-byte p)]
                  (cond (= c -1) (converter-fail "rust-like converter: unterminated string\n")
                        (load escaped) (do (store! escaped false) (nc-step! p))
                        (= c 92) (do (store! escaped true) (nc-step! p))
                        (= c 34) (do (nc-step! p) (store! done true))
                        :else (nc-step! p)))))
      0)))

(defn render-native-prefix-list! [(p (ptr NativeCursor))
                                  (out (mut str/StrBuf))
                                  (spelling (slice u8))] (-> i64)
  (do
    (nc-skip! p)
    (nc-step! p)
    (nc-read-atom! p)
    (str/sb-push-str! (mut out) spelling)
    (str/sb-push-byte! (mut out) (primitive/cast u8 40))
    (render-native-node! p (mut out))
    (nc-skip! p)
    (if (not (= (nc-byte p) 41))
        (converter-fail "rust-like converter: malformed quote form\n")
        0)
    (nc-step! p)
    (str/sb-push-byte! (mut out) (primitive/cast u8 41))))

(defn render-native-node! [(p (ptr NativeCursor))
                           (out (mut str/StrBuf))] (-> i64)
  (do
    (nc-skip! p)
    (let [c (nc-byte p)]
      (cond (nc-prefix? p "#(")
              (do
                (nc-step! p)
                (nc-step! p)
                (str/sb-push-byte! (mut out) (primitive/cast u8 91))
                (nc-skip! p)
                (let [(mut first) true]
                  (loop (if (= (nc-byte p) 41)
                            (break)
                            (do
                              (if (load first)
                                  (store! first false)
                                  (str/sb-push-str! (mut out) ", "))
                              (render-native-node! p (mut out))
                              (nc-skip! p)))))
                (if (not (= (nc-byte p) 41))
                    (converter-fail "rust-like converter: unclosed vector list\n")
                    0)
                (nc-step! p)
                (str/sb-push-byte! (mut out) (primitive/cast u8 93)))
            (and (nc-form-head? p "quote") (nc-list-arity? p 2)) (render-native-prefix-list! p (mut out) "quote")
            (and (nc-form-head? p "quasiquote") (nc-list-arity? p 2))
              (render-native-prefix-list! p (mut out) "quasiquote")
            (and (nc-form-head? p "unquote") (nc-list-arity? p 2)) (render-native-prefix-list! p (mut out) "unquote")
            (and (nc-form-head? p "unquote-splicing") (nc-list-arity? p 2))
              (render-native-prefix-list! p (mut out) "splice")
            (= c 40)
              (do
                (nc-step! p)
                (nc-skip! p)
                (if (= (nc-byte p) 41)
                    (do
                      (nc-step! p)
                      (str/sb-push-str! (mut out) "()"))
                    (do
                      (let [head-complex
                              (or (= (nc-byte p) 40)
                                  (or (= (nc-byte p) 91)
                                      (or (= (nc-byte p) 39)
                                          (or (= (nc-byte p) 96)
                                              (= (nc-byte p) 126)))))]
                        (if head-complex
                            (str/sb-push-byte! (mut out) (primitive/cast u8 40))
                            0)
                        (render-native-node! p (mut out))
                        (if head-complex
                            (str/sb-push-byte! (mut out) (primitive/cast u8 41))
                            0))
                      (str/sb-push-byte! (mut out) (primitive/cast u8 40))
                      (let [(mut first) true]
                        (loop (nc-skip! p)
                          (if (= (nc-byte p) 41)
                              (break)
                              (do
                                (if (load first)
                                    (store! first false)
                                    (str/sb-push-str! (mut out) ", "))
                                (render-native-node! p (mut out))))))
                      (if (not (= (nc-byte p) 41))
                          (converter-fail "rust-like converter: unclosed list\n")
                          0)
                      (nc-step! p)
                      (str/sb-push-byte! (mut out) (primitive/cast u8 41)))))
            (= c 91)
              (do
                (nc-step! p)
                (str/sb-push-byte! (mut out) (primitive/cast u8 91))
                (nc-skip! p)
                (let [(mut first) true]
                  (loop (if (= (nc-byte p) 93)
                            (break)
                            (do
                              (if (load first)
                                  (store! first false)
                                  (str/sb-push-str! (mut out) ", "))
                              (render-native-node! p (mut out))
                              (nc-skip! p)))))
                (if (not (= (nc-byte p) 93)) (converter-fail "rust-like converter: unclosed vector\n") 0)
                (nc-step! p)
                (str/sb-push-byte! (mut out) (primitive/cast u8 93)))
            (= c 39)
              (do
                (nc-step! p)
                (str/sb-push-str! (mut out) "quote(")
                (render-native-node! p (mut out))
                (str/sb-push-byte! (mut out) (primitive/cast u8 41)))
            (= c 96)
              (do
                (nc-step! p)
                (str/sb-push-str! (mut out) "quasiquote(")
                (render-native-node! p (mut out))
                (str/sb-push-byte! (mut out) (primitive/cast u8 41)))
            (= c 126)
              (do
                (nc-step! p)
                (if (= (nc-byte p) 64)
                    (do (nc-step! p) (str/sb-push-str! (mut out) "splice("))
                    (str/sb-push-str! (mut out) "unquote("))
                (render-native-node! p (mut out))
                (str/sb-push-byte! (mut out) (primitive/cast u8 41)))
            :else
              (let [start (.at p)
                    (mut character) false]
                (cond (= c 34) (nc-string-end! p false)
                      (and (= c 99) (nc-prefix? p "c\"")) (nc-string-end! p true)
                      (nc-prefix? p "#\\")
                        (do
                          (nc-step! p)
                          (nc-step! p)
                          (if (= (nc-byte p) -1)
                              (converter-fail "rust-like converter: incomplete character\n")
                              (nc-step! p))
                          (if (not (nc-delim? (nc-byte p)))
                              (loop (if (nc-delim? (nc-byte p)) (break) (nc-step! p)))
                              0))
                      (= c 92)
                        (do
                          (store! character true)
                          (nc-step! p)
                          (if (= (nc-byte p) -1)
                              (converter-fail "rust-like converter: incomplete legacy character\n")
                              (nc-step! p))
                          (if (not (nc-delim? (nc-byte p)))
                              (loop (if (nc-delim? (nc-byte p)) (break) (nc-step! p)))
                              0))
                      :else (loop (if (nc-delim? (nc-byte p)) (break) (nc-step! p))))
                (if (= start (.at p))
                    (do
                      (io/print-str (io/stderr) "rust-like converter: unexpected delimiter at byte ")
                      (io/print-int (io/stderr) (.at p))
                      (io/print-str (io/stderr) "\n")
                      (abort)
                      0)
                    0)
                (if (and (= c 35) (not (load character)))
                    (render-raw-name! (slice/subslice (.source p) start (.at p)) (mut out))
                    (if (load character)
                        (do
                          (str/sb-push-byte! (mut out) (primitive/cast u8 39))
                          (let [body
                                  (if (= c 92)
                                      (slice/subslice (.source p) (+ start 1) (.at p))
                                      (slice/subslice (.source p) (+ start 2) (.at p)))]
                            (cond (= body "'") (str/sb-push-str! (mut out) "\\'")
                                  (= body "\\") (str/sb-push-str! (mut out) "\\\\")
                                  :else (str/sb-push-str! (mut out) body)))
                          (str/sb-push-byte! (mut out) (primitive/cast u8 39)))
                        (if (or (= c 34)
                                (and (= c 99)
                                     (and (< (+ start 1) (slice/slice-len (.source p)))
                                          (= (slice/slice-get (.source p) (+ start 1))
                                             (primitive/cast u8 34)))))
                            (str/sb-push-str! (mut out)
                                              (slice/subslice (.source p) start (.at p)))
                            (let [atom (slice/subslice (.source p) start (.at p))]
                              (if (and (> (slice/slice-len atom) 1)
                                       (= (slice/slice-get atom 0) (primitive/cast u8 58)))
                                  (do
                                    (str/sb-push-byte! (mut out) (primitive/cast u8 58))
                                    (render-raw-name! (slice/subslice atom 1 (slice/slice-len atom))
                                                      (mut out)))
                                  (if (or (raw-atom-number? atom)
                                          (or (= atom "true") (= atom "false")))
                                      (str/sb-push-str! (mut out) atom)
                                      (render-raw-name! atom (mut out)))))))))))
    0))

(defn native-to-rust-like [(source (slice u8))] (-> (slice u8))
  (let [a (alloc/malloc-allocator)
        p (primitive/alloc-stack NativeCursor)
        (mut out) (str/sb-new a)]
    (set! (.source p) source)
    (set! (.at p) 0)
    (set! (.indent p) 0)
    (loop (nc-skip! p)
      (if (= (nc-byte p) -1)
          (break)
          (cond (nc-form-head? p "module") (render-raw-module! p (mut out))
                (nc-form-head? p "import") (render-raw-import! p (mut out))
                (nc-form-head? p "export") (render-raw-export! p (mut out))
                (and (nc-form-head? p "cimport")
                     (nc-raw-cimport-renderable? p))
                  (render-raw-cimport! p (mut out))
                (nc-form-head? p "export-c") (render-raw-export-c! p (mut out))
                (and (nc-form-head? p "meta") (nc-list-arity? p 2)) (render-raw-meta! p (mut out))
                (and (nc-form-head? p "extern")
                     (nc-raw-extern-renderable? p))
                  (render-raw-extern! p (mut out))
                (or (nc-form-head? p "checker")
                    (or (nc-form-head? p "transform")
                        (nc-form-head? p "transform-once")))
                  (let [saved (.at p)]
                    (nc-skip! p)
                    (nc-step! p)
                    (let [head (nc-read-atom! p)]
                      (set! (.at p) saved)
                      (cond (= head "checker") (render-raw-registration! p (mut out) "checker")
                            (= head "transform") (render-raw-registration! p (mut out) "transform")
                            :else (render-raw-registration! p (mut out) "transform_once"))))
                (and (nc-form-head? p "const") (nc-list-arity? p 3)) (render-raw-const! p (mut out))
                (and (nc-form-head? p "def") (nc-list-arity? p 3)) (render-raw-def! p (mut out))
                (and (nc-form-head? p "defstruct")
                     (nc-raw-defstruct-renderable? p))
                  (render-raw-defstruct! p (mut out))
                (and (nc-form-head? p "defsum")
                     (nc-raw-defsum-renderable? p))
                  (render-raw-defsum! p (mut out))
                (and (nc-form-head? p "deftrait")
                     (nc-raw-deftrait-renderable? p))
                  (render-raw-deftrait! p (mut out))
                (and (nc-form-head? p "defn") (nc-raw-defn-renderable? p)) (render-raw-defn! p (mut out))
                (and (nc-form-head? p "impl") (nc-raw-impl-renderable? p)) (render-raw-impl! p (mut out))
                :else
                  (do
                    (str/sb-push-str! (mut out) "item ")
                    (render-native-node! p (mut out))
                    (str/sb-push-str! (mut out) ";\n\n")))))
    (str/sb-finish! (mut out))))

;;; Reader-provider mode turns native Coil input into a tiny executable which
;;; prints its Rust-like spelling. The converter itself is compiled Coil.
(defn read-native-as-rust-like [(context Code)] (-> Code)
  (let [a (alloc/malloc-allocator)
        output (native-to-rust-like (primitive/code-str (primitive/code-nth context 2)))
        (mut program) (str/sb-new a)]
    (str/sb-push-str! (mut program)
                      "(module rust-like-converter-output)\n(import \"coil.io\")\n(defn main [] (-> i64) (do (coil.io.print-str (coil.io.stdout) ")
    (json-string! (mut program) output)
    (str/sb-push-str! (mut program) ") 0))\n")
    (primitive/code-read (str/sb-finish! (mut program)) `(reader-config))))
