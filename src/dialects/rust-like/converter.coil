(module experiments.rust-like.converter)

(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.slice" :as slice)
(import "coil.str" :as str)
(import "coil.io" :as io)

(extern abort :cc c [] (-> i64))

(defn converter-fail [(message (slice u8))] (-> i64)
  (do (io/print-str (io/stderr) message) (abort) 0))

(defn hex-digit [(value i64)] (-> u8)
  (primitive/cast u8 (if (< value 10) (+ 48 value) (+ 87 value))))

(defn json-string! [(out (mut str/StrBuf)) (value (slice u8))] (-> i64)
  (do
    (str/sb-push-byte! (mut out) (primitive/cast u8 34))
    (let [(mut i) 0]
      (loop (if (>= (load i) (slice/slice-len value))
                (break)
                (let [byte (primitive/cast i64 (slice/slice-get value (load i)))]
                  (cond (= byte 34) (str/sb-push-str! (mut out) "\\\"")
                        (= byte 92) (str/sb-push-str! (mut out) "\\\\")
                        (= byte 10) (str/sb-push-str! (mut out) "\\n")
                        (= byte 13) (str/sb-push-str! (mut out) "\\r")
                        (= byte 9) (str/sb-push-str! (mut out) "\\t")
                        (< byte 32)
                          (do
                            (str/sb-push-str! (mut out) "\\u00")
                            (str/sb-push-byte! (mut out) (hex-digit (/ byte 16)))
                            (str/sb-push-byte! (mut out) (hex-digit (% byte 16))))
                        :else (str/sb-push-byte! (mut out) (primitive/cast u8 byte)))
                  (store! i (+ (load i) 1))))))
    (str/sb-push-byte! (mut out) (primitive/cast u8 34))))

(defstruct NativeCursor [(source (slice u8)) (at i64) (indent i64)])

(defn converter-fail-at [(p (ptr NativeCursor))
                         (message (slice u8))] (-> i64)
  (do
    (io/print-str (io/stderr) message)
    (io/print-str (io/stderr) " at byte ")
    (io/print-int (io/stderr) (.at p))
    (io/print-str (io/stderr) "\n")
    (abort)
    0))

(defn render-indent! [(p (ptr NativeCursor))
                      (out (mut str/StrBuf))] (-> i64)
  (let [(mut i) 0]
    (loop (if (>= (load i) (.indent p))
              (break)
              (do
                (str/sb-push-str! (mut out) "    ")
                (store! i (+ (load i) 1)))))
    0))

(defn render-line! [(p (ptr NativeCursor))
                    (out (mut str/StrBuf))] (-> i64)
  (do
    (str/sb-push-byte! (mut out) (primitive/cast u8 10))
    (render-indent! p (mut out))))

(defn nc-byte [(p (ptr NativeCursor))] (-> i64)
  (if (>= (.at p) (slice/slice-len (.source p)))
      -1
      (primitive/cast i64 (slice/slice-get (.source p) (.at p)))))

(defn nc-step! [(p (ptr NativeCursor))] (-> i64)
  (set! (.at p) (+ (.at p) 1)))

(defn nc-prefix? [(p (ptr NativeCursor)) (text (slice u8))] (-> bool)
  (let [n (slice/slice-len text)
        (mut i) 0
        (mut yes) (<= n (- (slice/slice-len (.source p)) (.at p)))]
    (loop (if (or (not (load yes)) (>= (load i) n))
              (break)
              (do
                (if (not (= (slice/slice-get (.source p) (+ (.at p) (load i)))
                            (slice/slice-get text (load i))))
                    (store! yes false)
                    0)
                (store! i (+ (load i) 1)))))
    (load yes)))

(defn nc-skip! [(p (ptr NativeCursor))] (-> i64)
  (let [(mut more) true]
    (loop (if (not (load more))
              (break)
              (let [c (nc-byte p)]
                (if (or (= c 32) (or (= c 9) (or (= c 10) (= c 13))))
                    (nc-step! p)
                    (if (= c 59)
                        (loop (if (or (= (nc-byte p) -1) (= (nc-byte p) 10))
                                  (break)
                                  (nc-step! p)))
                        (store! more false))))))
    0))

(defn nc-delim? [(c i64)] (-> bool)
  (or (= c -1)
      (or (= c 32)
          (or (= c 9)
              (or (= c 10)
                  (or (= c 13)
                      (or (= c 40) (or (= c 41) (or (= c 91) (or (= c 93) (= c 59)))))))))))

(defn nc-read-atom! [(p (ptr NativeCursor))] (-> (slice u8))
  (do
    (nc-skip! p)
    (let [start (.at p)]
      (loop (if (nc-delim? (nc-byte p)) (break) (nc-step! p)))
      (slice/subslice (.source p) start (.at p)))))

(defn nc-form-head? [(p (ptr NativeCursor)) (name (slice u8))] (-> bool)
  (let [saved (.at p)
        (mut yes) false]
    (nc-skip! p)
    (if (= (nc-byte p) 40)
        (do
          (nc-step! p)
          (if (= (nc-read-atom! p) name) (store! yes true) 0))
        0)
    (set! (.at p) saved)
    (load yes)))

(defn nc-skip-node! [(p (ptr NativeCursor))] (-> i64)
  (do
    (nc-skip! p)
    (let [c (nc-byte p)]
      (cond (nc-prefix? p "#(")
              (do
                (nc-step! p)
                (nc-step! p)
                (loop (nc-skip! p)
                  (if (= (nc-byte p) 41) (break) (nc-skip-node! p)))
                (nc-step! p))
            (= c 40)
              (do
                (nc-step! p)
                (loop (nc-skip! p)
                  (if (= (nc-byte p) 41) (break) (nc-skip-node! p)))
                (nc-step! p))
            (= c 91)
              (do
                (nc-step! p)
                (loop (nc-skip! p)
                  (if (= (nc-byte p) 93) (break) (nc-skip-node! p)))
                (nc-step! p))
            (or (= c 39) (or (= c 96) (= c 126)))
              (do
                (nc-step! p)
                (if (and (= c 126) (= (nc-byte p) 64)) (nc-step! p) 0)
                (nc-skip-node! p))
            (= c 34) (nc-string-end! p false)
            (and (= c 99) (nc-prefix? p "c\"")) (nc-string-end! p true)
            (nc-prefix? p "#\\")
              (do
                (nc-step! p)
                (nc-step! p)
                (if (= (nc-byte p) -1)
                    (converter-fail "rust-like converter: incomplete character\n")
                    (nc-step! p))
                (if (not (nc-delim? (nc-byte p)))
                    (loop (if (nc-delim? (nc-byte p)) (break) (nc-step! p)))
                    0))
            (= c 92)
              (do
                (nc-step! p)
                (if (= (nc-byte p) -1)
                    (converter-fail "rust-like converter: incomplete legacy character\n")
                    (nc-step! p))
                (if (not (nc-delim? (nc-byte p)))
                    (loop (if (nc-delim? (nc-byte p)) (break) (nc-step! p)))
                    0))
            :else
              (do
                (if (nc-delim? c)
                    (converter-fail "rust-like converter: unexpected delimiter while scanning\n")
                    0)
                (loop (if (nc-delim? (nc-byte p)) (break) (nc-step! p))))))
    0))

(defn nc-list-arity? [(p (ptr NativeCursor)) (arity i64)] (-> bool)
  (let [saved (.at p)
        (mut count) 0
        (mut valid) true]
    (nc-skip! p)
    (if (not (= (nc-byte p) 40))
        (store! valid false)
        (do
          (nc-step! p)
          (loop (nc-skip! p)
            (if (= (nc-byte p) 41)
                (break)
                (if (= (nc-byte p) -1)
                    (do (store! valid false) (break))
                    (do
                      (nc-skip-node! p)
                      (store! count (+ (load count) 1))))))))
    (set! (.at p) saved)
    (and (load valid) (= (load count) arity))))

(defn raw-number-start? [(p (ptr NativeCursor))] (-> bool)
  (let [c (nc-byte p)]
    (or (and (>= c 48) (<= c 57))
        (and (= c 45)
             (let [next (+ (.at p) 1)]
               (and (< next (slice/slice-len (.source p)))
                    (let [n (primitive/cast i64 (slice/slice-get (.source p) next))]
                      (and (>= n 48) (<= n 57)))))))))

(defn raw-atom-number? [(atom (slice u8))] (-> bool)
  (and (> (slice/slice-len atom) 0)
       (let [c (primitive/cast i64 (slice/slice-get atom 0))]
         (or (and (>= c 48) (<= c 57))
             (and (= c 45)
                  (and (> (slice/slice-len atom) 1)
                       (let [n (primitive/cast i64 (slice/slice-get atom 1))]
                         (and (>= n 48) (<= n 57)))))))))

(defn surface-binary-head? [(head (slice u8))] (-> bool)
  (or (= head "+")
      (or (= head "-")
          (or (= head "*")
              (or (= head "/")
                  (or (= head "%")
                      (or (= head "=")
                          (or (= head "!=")
                              (or (= head "<")
                                  (or (= head "<=")
                                      (or (= head ">")
                                          (or (= head ">=")
                                              (or (= head "&")
                                                  (or (= head "|")
                                                      (or (= head "^")
                                                          (or (= head "<<")
                                                              (or (= head ">>") (or (= head "and") (= head "or")))))))))))))))))))

(defn raw-field-head? [(head (slice u8))] (-> bool)
  (and (> (slice/slice-len head) 1)
       (= (slice/slice-get head 0) (primitive/cast u8 46))))

(defn nc-keyword-call? [(p (ptr NativeCursor))] (-> bool)
  (let [saved (.at p)
        (mut yes) true
        (mut any) false]
    (nc-skip! p)
    (nc-step! p)
    (nc-read-atom! p)
    (loop (nc-skip! p)
      (if (or (not (load yes)) (= (nc-byte p) 41))
          (break)
          (let [key (nc-read-atom! p)]
            (if (or (= (slice/slice-len key) 0)
                    (not (= (slice/slice-get key 0) (primitive/cast u8 58))))
                (store! yes false)
                (do
                  (store! any true)
                  (nc-skip! p)
                  (if (= (nc-byte p) 41)
                      (store! yes false)
                      (nc-skip-node! p)))))))
    (set! (.at p) saved)
    (and (load yes) (load any))))

(defn render-surface-form-body! [(p (ptr NativeCursor))
                                 (out (mut str/StrBuf))] (-> i64)
  (do
    (str/sb-push-byte! (mut out) (primitive/cast u8 123))
    (set! (.indent p) (+ (.indent p) 1))
    (loop (nc-skip! p)
      (if (= (nc-byte p) 41)
          (break)
          (do
            (render-line! p (mut out))
            (render-surface-expr! p (mut out))
            (str/sb-push-byte! (mut out) (primitive/cast u8 59)))))
    (set! (.indent p) (- (.indent p) 1))
    (render-line! p (mut out))
    (str/sb-push-byte! (mut out) (primitive/cast u8 125))
    0))

(defn render-surface-conditioned-block! [(p (ptr NativeCursor))
                                         (out (mut str/StrBuf))
                                         (spelling (slice u8))] (-> i64)
  (do
    (nc-step! p)
    (nc-read-atom! p)
    (str/sb-push-str! (mut out) spelling)
    (str/sb-push-byte! (mut out) (primitive/cast u8 32))
    (render-surface-expr! p (mut out))
    (str/sb-push-byte! (mut out) (primitive/cast u8 32))
    (render-surface-form-body! p (mut out))
    (nc-step! p)))

(defn render-surface-block-call! [(p (ptr NativeCursor))
                                  (out (mut str/StrBuf))
                                  (spelling (slice u8))] (-> i64)
  (do
    (nc-step! p)
    (nc-read-atom! p)
    (str/sb-push-str! (mut out) spelling)
    (str/sb-push-byte! (mut out) (primitive/cast u8 32))
    (render-surface-form-body! p (mut out))
    (nc-step! p)))

(defn render-surface-let! [(p (ptr NativeCursor))
                           (out (mut str/StrBuf))] (-> i64)
  (do
    (nc-step! p)
    (nc-read-atom! p)
    (nc-skip! p)
    (if (not (= (nc-byte p) 91))
        (converter-fail "rust-like converter: malformed let bindings\n")
        0)
    (nc-step! p)
    (str/sb-push-byte! (mut out) (primitive/cast u8 123))
    (set! (.indent p) (+ (.indent p) 1))
    (loop (nc-skip! p)
      (if (= (nc-byte p) 93)
          (break)
          (do
            (render-line! p (mut out))
            (str/sb-push-str! (mut out) "let ")
            (if (nc-form-head? p "mut")
                (do
                  (nc-step! p)
                  (nc-read-atom! p)
                  (str/sb-push-str! (mut out) "mut ")
                  (render-raw-name! (nc-read-atom! p) (mut out))
                  (nc-skip! p)
                  (nc-step! p))
                (render-raw-name! (nc-read-atom! p) (mut out)))
            (str/sb-push-str! (mut out) " = ")
            (render-surface-expr! p (mut out))
            (str/sb-push-byte! (mut out) (primitive/cast u8 59)))))
    (nc-step! p)
    (loop (nc-skip! p)
      (if (= (nc-byte p) 41)
          (break)
          (do
            (render-line! p (mut out))
            (render-surface-expr! p (mut out))
            (str/sb-push-byte! (mut out) (primitive/cast u8 59)))))
    (nc-step! p)
    (set! (.indent p) (- (.indent p) 1))
    (render-line! p (mut out))
    (str/sb-push-byte! (mut out) (primitive/cast u8 125))
    0))

(defn nc-surface-let? [(p (ptr NativeCursor))] (-> bool)
  (let [saved (.at p)
        (mut count) 0
        (mut valid) true]
    (nc-step! p)
    (nc-read-atom! p)
    (nc-skip! p)
    (if (not (= (nc-byte p) 91))
        (store! valid false)
        (do
          (nc-step! p)
          (loop (nc-skip! p)
            (if (= (nc-byte p) 93)
                (break)
                (do
                  (nc-skip-node! p)
                  (store! count (+ (load count) 1)))))))
    (set! (.at p) saved)
    (and (load valid)
         (and (> (load count) 0) (= (% (load count) 2) 0)))))

(defn render-surface-unary! [(p (ptr NativeCursor))
                             (out (mut str/StrBuf))
                             (prefix (slice u8))] (-> i64)
  (do
    (nc-step! p)
    (nc-read-atom! p)
    (str/sb-push-str! (mut out) prefix)
    (render-surface-expr! p (mut out))
    (nc-skip! p)
    (nc-step! p)))

(defn render-surface-expression-block! [(p (ptr NativeCursor))
                                        (out (mut str/StrBuf))] (-> i64)
  (do
    (str/sb-push-byte! (mut out) (primitive/cast u8 123))
    (set! (.indent p) (+ (.indent p) 1))
    (render-line! p (mut out))
    (render-surface-expr! p (mut out))
    (str/sb-push-byte! (mut out) (primitive/cast u8 59))
    (set! (.indent p) (- (.indent p) 1))
    (render-line! p (mut out))
    (str/sb-push-byte! (mut out) (primitive/cast u8 125))))

(defn render-surface-assignment! [(p (ptr NativeCursor))
                                  (out (mut str/StrBuf))
                                  (store bool)] (-> i64)
  (do
    (nc-step! p)
    (nc-read-atom! p)
    (if store (str/sb-push-byte! (mut out) (primitive/cast u8 42)) 0)
    (render-surface-expr! p (mut out))
    (str/sb-push-str! (mut out) " = ")
    (render-surface-expr! p (mut out))
    (nc-skip! p)
    (nc-step! p)))

(defn nc-surface-set-place? [(p (ptr NativeCursor))] (-> bool)
  (let [saved (.at p)]
    (nc-step! p)
    (nc-read-atom! p)
    (nc-skip! p)
    (let [yes
            (if (= (nc-byte p) 40)
                (let [inner-saved (.at p)]
                  (nc-step! p)
                  (let [head (nc-read-atom! p)]
                    (set! (.at p) inner-saved)
                    (raw-field-head? head)))
                (not (or (= (nc-byte p) 91)
                         (or (= (nc-byte p) 34) (= (nc-byte p) 39)))))]
      (set! (.at p) saved)
      yes)))

(defn render-surface-for! [(p (ptr NativeCursor))
                           (out (mut str/StrBuf))] (-> i64)
  (do
    (nc-step! p)
    (nc-read-atom! p)
    (nc-skip! p)
    (if (not (= (nc-byte p) 91))
        (converter-fail "rust-like converter: malformed for binding\n")
        0)
    (nc-step! p)
    (str/sb-push-str! (mut out) "for ")
    (render-raw-name! (nc-read-atom! p) (mut out))
    (str/sb-push-str! (mut out) " in ")
    (render-surface-expr! p (mut out))
    (str/sb-push-str! (mut out) "..")
    (render-surface-expr! p (mut out))
    (nc-skip! p)
    (if (not (= (nc-byte p) 93))
        (converter-fail "rust-like converter: malformed for range\n")
        0)
    (nc-step! p)
    (str/sb-push-byte! (mut out) (primitive/cast u8 32))
    (render-surface-form-body! p (mut out))
    (nc-step! p)))

(defn nc-surface-for? [(p (ptr NativeCursor))] (-> bool)
  (let [saved (.at p)
        (mut count) 0
        (mut yes) true]
    (nc-step! p)
    (nc-read-atom! p)
    (nc-skip! p)
    (if (not (= (nc-byte p) 91))
        (store! yes false)
        (do
          (nc-step! p)
          (loop (nc-skip! p)
            (if (= (nc-byte p) 93)
                (break)
                (do
                  (nc-skip-node! p)
                  (store! count (+ (load count) 1)))))
          (nc-step! p)))
    (set! (.at p) saved)
    (and (load yes) (= (load count) 3))))

(defn render-surface-match! [(p (ptr NativeCursor))
                             (out (mut str/StrBuf))] (-> i64)
  (do
    (nc-step! p)
    (nc-read-atom! p)
    (str/sb-push-str! (mut out) "match ")
    (render-surface-expr! p (mut out))
    (str/sb-push-str! (mut out) " {")
    (set! (.indent p) (+ (.indent p) 1))
    (loop (nc-skip! p)
      (if (= (nc-byte p) 41)
          (break)
          (do
            (if (not (= (nc-byte p) 40))
                (converter-fail "rust-like converter: malformed match arm\n")
                0)
            (nc-step! p)
            (render-line! p (mut out))
            (render-raw-name! (nc-read-atom! p) (mut out))
            (nc-skip! p)
            (if (= (nc-byte p) 91) (render-native-node! p (mut out)) 0)
            (str/sb-push-str! (mut out) " => ")
            (render-surface-form-body! p (mut out))
            (nc-step! p)
            (str/sb-push-byte! (mut out) (primitive/cast u8 44)))))
    (nc-step! p)
    (set! (.indent p) (- (.indent p) 1))
    (render-line! p (mut out))
    (str/sb-push-byte! (mut out) (primitive/cast u8 125))))

(defn nc-surface-match? [(p (ptr NativeCursor))] (-> bool)
  (let [saved (.at p)
        (mut valid) true]
    (nc-step! p)
    (nc-read-atom! p)
    (nc-skip-node! p)
    (loop (nc-skip! p)
      (if (or (not (load valid)) (= (nc-byte p) 41))
          (break)
          (if (not (= (nc-byte p) 40))
              (store! valid false)
              (do
                (nc-step! p)
                (nc-skip-node! p)
                (nc-skip! p)
                (if (not (= (nc-byte p) 91))
                    (store! valid false)
                    (do
                      (nc-skip-node! p)
                      (loop (nc-skip! p)
                        (if (= (nc-byte p) 41)
                            (break)
                            (nc-skip-node! p)))
                      (nc-step! p)))))))
    (set! (.at p) saved)
    (load valid)))

(defn nc-one-node-left? [(p (ptr NativeCursor))] (-> bool)
  (let [saved (.at p)]
    (nc-skip-node! p)
    (nc-skip! p)
    (let [yes (= (nc-byte p) 41)]
      (set! (.at p) saved)
      yes)))

(defn render-surface-clauses! [(p (ptr NativeCursor))
                               (out (mut str/StrBuf))
                               (spelling (slice u8))
                               (has-scrutinee bool)] (-> i64)
  (do
    (nc-step! p)
    (nc-read-atom! p)
    (str/sb-push-str! (mut out) spelling)
    (if has-scrutinee
        (do
          (str/sb-push-byte! (mut out) (primitive/cast u8 32))
          (render-surface-expr! p (mut out)))
        0)
    (str/sb-push-str! (mut out) " {")
    (set! (.indent p) (+ (.indent p) 1))
    (loop (nc-skip! p)
      (if (= (nc-byte p) 41)
          (break)
          (do
            (render-line! p (mut out))
            (if (nc-one-node-left? p)
                (str/sb-push-str! (mut out) "else")
                (render-surface-expr! p (mut out)))
            (str/sb-push-str! (mut out) " => ")
            (render-surface-expr! p (mut out))
            (str/sb-push-byte! (mut out) (primitive/cast u8 44)))))
    (nc-step! p)
    (set! (.indent p) (- (.indent p) 1))
    (render-line! p (mut out))
    (str/sb-push-byte! (mut out) (primitive/cast u8 125))))

(defn render-surface-block! [(p (ptr NativeCursor))
                             (out (mut str/StrBuf))] (-> i64)
  (do
    (nc-step! p)
    (nc-read-atom! p)
    (str/sb-push-str! (mut out) "block ")
    (str/sb-push-str! (mut out) (nc-read-atom! p))
    (str/sb-push-byte! (mut out) (primitive/cast u8 32))
    (render-surface-form-body! p (mut out))
    (nc-step! p)))

(defn render-surface-return-from! [(p (ptr NativeCursor))
                                   (out (mut str/StrBuf))] (-> i64)
  (do
    (nc-step! p)
    (nc-read-atom! p)
    (str/sb-push-str! (mut out) "return_from ")
    (str/sb-push-str! (mut out) (nc-read-atom! p))
    (str/sb-push-str! (mut out) ", ")
    (render-surface-expr! p (mut out))
    (nc-skip! p)
    (nc-step! p)))

(defn render-surface-expr! [(p (ptr NativeCursor))
                            (out (mut str/StrBuf))] (-> i64)
  (do
    (nc-skip! p)
    (let [c (nc-byte p)]
      (cond (nc-prefix? p "#(") (render-native-node! p (mut out))
            (= c 91)
              (do
                (nc-step! p)
                (str/sb-push-byte! (mut out) (primitive/cast u8 91))
                (let [(mut first) true]
                  (loop (nc-skip! p)
                    (if (= (nc-byte p) 93)
                        (break)
                        (do
                          (if (load first)
                              (store! first false)
                              (str/sb-push-str! (mut out) ", "))
                          (render-surface-expr! p (mut out))))))
                (nc-step! p)
                (str/sb-push-byte! (mut out) (primitive/cast u8 93)))
            (= c 40)
              (let [saved (.at p)]
                (nc-step! p)
                (let [head (nc-read-atom! p)]
                  (set! (.at p) saved)
                  (if (= (slice/slice-len head) 0)
                      (render-native-node! p (mut out))
                      (cond (and (= head "quote") (nc-list-arity? p 2)) (render-native-prefix-list! p (mut out) "quote")
                            (and (= head "quasiquote") (nc-list-arity? p 2))
                              (render-native-prefix-list! p (mut out) "quasiquote")
                            (and (= head "unquote") (nc-list-arity? p 2))
                              (render-native-prefix-list! p (mut out) "unquote")
                            (and (= head "unquote-splicing") (nc-list-arity? p 2))
                              (render-native-prefix-list! p (mut out) "splice")
                            (= head "do") (render-surface-block-call! p (mut out) "do")
                            (and (= head "let") (nc-surface-let? p)) (render-surface-let! p (mut out))
                            (and (= head "load") (nc-list-arity? p 2)) (render-surface-unary! p (mut out) "*")
                            (and (= head "mut") (nc-list-arity? p 2)) (render-surface-unary! p (mut out) "mut ")
                            (and (and (= head "set!") (nc-list-arity? p 3))
                                 (nc-surface-set-place? p))
                              (render-surface-assignment! p (mut out) false)
                            (and (= head "store!") (nc-list-arity? p 3)) (render-surface-assignment! p (mut out) true)
                            (= head "loop")
                              (do
                                (nc-step! p)
                                (nc-read-atom! p)
                                (str/sb-push-str! (mut out) "loop ")
                                (render-surface-form-body! p (mut out))
                                (nc-step! p))
                            (= head "when") (render-surface-conditioned-block! p (mut out) "when")
                            (= head "unless") (render-surface-conditioned-block! p (mut out) "unless")
                            (= head "while") (render-surface-conditioned-block! p (mut out) "while")
                            (and (= head "for") (nc-surface-for? p)) (render-surface-for! p (mut out))
                            (and (= head "match") (nc-surface-match? p)) (render-surface-match! p (mut out))
                            (= head "cond") (render-surface-clauses! p (mut out) "cond" false)
                            (= head "case") (render-surface-clauses! p (mut out) "case" true)
                            (= head "block") (render-surface-block! p (mut out))
                            (= head "return-from") (render-surface-return-from! p (mut out))
                            (= head "try") (render-surface-block-call! p (mut out) "try")
                            (= head "meta") (render-surface-block-call! p (mut out) "meta")
                            (= head "comptime") (render-surface-block-call! p (mut out) "comptime")
                            (= head "break")
                              (do
                                (nc-step! p)
                                (nc-read-atom! p)
                                (str/sb-push-str! (mut out) "break")
                                (nc-skip! p)
                                (let [(mut first) true]
                                  (loop (nc-skip! p)
                                    (if (= (nc-byte p) 41)
                                        (break)
                                        (do
                                          (if (load first)
                                              (do
                                                (store! first false)
                                                (str/sb-push-byte! (mut out)
                                                                   (primitive/cast u8 32)))
                                              (str/sb-push-str! (mut out) ", "))
                                          (render-surface-expr! p (mut out))))))
                                (nc-skip! p)
                                (nc-step! p))
                            (and (= head "continue") (nc-list-arity? p 1))
                              (do
                                (nc-step! p)
                                (nc-read-atom! p)
                                (nc-skip! p)
                                (nc-step! p)
                                (str/sb-push-str! (mut out) "continue"))
                            (and (raw-field-head? head) (nc-list-arity? p 2))
                              (do
                                (nc-step! p)
                                (nc-read-atom! p)
                                (nc-skip! p)
                                (let [complex (= (nc-byte p) 40)]
                                  (if complex
                                      (str/sb-push-byte! (mut out) (primitive/cast u8 40))
                                      0)
                                  (render-surface-expr! p (mut out))
                                  (if complex
                                      (str/sb-push-byte! (mut out) (primitive/cast u8 41))
                                      0))
                                (str/sb-push-byte! (mut out) (primitive/cast u8 46))
                                (render-raw-name! (slice/subslice head 1 (slice/slice-len head))
                                                  (mut out))
                                (nc-skip! p)
                                (nc-step! p))
                            (nc-keyword-call? p)
                              (do
                                (nc-step! p)
                                (render-raw-name! (nc-read-atom! p) (mut out))
                                (str/sb-push-str! (mut out) " { ")
                                (let [(mut first) true]
                                  (loop (nc-skip! p)
                                    (if (= (nc-byte p) 41)
                                        (break)
                                        (let [key (nc-read-atom! p)]
                                          (if (load first)
                                              (store! first false)
                                              (str/sb-push-str! (mut out) ", "))
                                          (render-raw-name! (slice/subslice key 1 (slice/slice-len key))
                                                            (mut out))
                                          (str/sb-push-str! (mut out) ": ")
                                          (render-surface-expr! p (mut out))))))
                                (nc-step! p)
                                (str/sb-push-str! (mut out) " }"))
                            (and (nc-list-arity? p 3) (surface-binary-head? head))
                              (do
                                (nc-step! p)
                                (nc-read-atom! p)
                                (str/sb-push-byte! (mut out) (primitive/cast u8 40))
                                (render-surface-expr! p (mut out))
                                (str/sb-push-byte! (mut out) (primitive/cast u8 32))
                                (cond (= head "=") (str/sb-push-str! (mut out) "==")
                                      (= head "and") (str/sb-push-str! (mut out) "&&")
                                      (= head "or") (str/sb-push-str! (mut out) "||")
                                      :else (str/sb-push-str! (mut out) head))
                                (str/sb-push-byte! (mut out) (primitive/cast u8 32))
                                (render-surface-expr! p (mut out))
                                (nc-skip! p)
                                (nc-step! p)
                                (str/sb-push-byte! (mut out) (primitive/cast u8 41)))
                            (and (= head "not") (nc-list-arity? p 2))
                              (do
                                (nc-step! p)
                                (nc-read-atom! p)
                                (str/sb-push-str! (mut out) "(!")
                                (render-surface-expr! p (mut out))
                                (nc-skip! p)
                                (nc-step! p)
                                (str/sb-push-byte! (mut out) (primitive/cast u8 41)))
                            (and (= head "if") (nc-list-arity? p 4))
                              (do
                                (nc-step! p)
                                (nc-read-atom! p)
                                (str/sb-push-str! (mut out) "if ")
                                (render-surface-expr! p (mut out))
                                (str/sb-push-byte! (mut out) (primitive/cast u8 32))
                                (render-surface-expression-block! p (mut out))
                                (str/sb-push-str! (mut out) " else ")
                                (render-surface-expression-block! p (mut out))
                                (nc-skip! p)
                                (nc-step! p))
                            :else
                              (do
                                (nc-step! p)
                                (render-raw-name! (nc-read-atom! p) (mut out))
                                (nc-skip! p)
                                (if (= (nc-byte p) 91)
                                    (do
                                      (nc-step! p)
                                      (str/sb-push-str! (mut out) "::<")
                                      (let [(mut first-type) true]
                                        (loop (nc-skip! p)
                                          (if (= (nc-byte p) 93)
                                              (break)
                                              (do
                                                (if (load first-type)
                                                    (store! first-type false)
                                                    (str/sb-push-str! (mut out) ", "))
                                                (render-raw-type! p (mut out))))))
                                      (nc-step! p)
                                      (str/sb-push-str! (mut out) ">("))
                                    (str/sb-push-byte! (mut out) (primitive/cast u8 40)))
                                (let [(mut first) true]
                                  (loop (nc-skip! p)
                                    (if (= (nc-byte p) 41)
                                        (break)
                                        (do
                                          (if (load first)
                                              (store! first false)
                                              (str/sb-push-str! (mut out) ", "))
                                          (render-surface-expr! p (mut out))))))
                                (nc-step! p)
                                (str/sb-push-byte! (mut out) (primitive/cast u8 41)))))))
            (or (= c 39) (or (= c 96) (= c 126))) (render-native-node! p (mut out))
            (= c 34)
              (let [start (.at p)]
                (nc-string-end! p false)
                (str/sb-push-str! (mut out) (slice/subslice (.source p) start (.at p))))
            (and (= c 99) (nc-prefix? p "c\""))
              (let [start (.at p)]
                (nc-string-end! p true)
                (str/sb-push-str! (mut out) (slice/subslice (.source p) start (.at p))))
            (or (nc-prefix? p "#\\") (= c 92)) (render-native-node! p (mut out))
            :else
              (let [atom (nc-read-atom! p)]
                (if (or (raw-atom-number? atom)
                        (or (= atom "true") (= atom "false")))
                    (str/sb-push-str! (mut out) atom)
                    (if (and (> (slice/slice-len atom) 1)
                             (= (slice/slice-get atom 0) (primitive/cast u8 58)))
                        (do
                          (str/sb-push-byte! (mut out) (primitive/cast u8 58))
                          (render-raw-name! (slice/subslice atom 1 (slice/slice-len atom))
                                            (mut out)))
                        (render-raw-name! atom (mut out)))))))
    0))

(defn raw-ident-start? [(c i64)] (-> bool)
  (or (and (>= c 65) (<= c 90))
      (or (and (>= c 97) (<= c 122)) (= c 95))))

(defn raw-ident-part? [(c i64)] (-> bool)
  (or (raw-ident-start? c)
      (or (and (>= c 48) (<= c 57))
          (or (= c 45) (or (= c 63) (= c 33))))))

(defn raw-reserved-name? [(name (slice u8))] (-> bool)
  (cond (= name "if") true
        (= name "when") true
        (= name "unless") true
        (= name "match") true
        (= name "cond") true
        (= name "case") true
        (= name "loop") true
        (= name "while") true
        (= name "for") true
        (= name "break") true
        (= name "continue") true
        (= name "try") true
        (= name "meta") true
        (= name "comptime") true
        (= name "do") true
        (= name "block") true
        (= name "return_from") true
        (= name "return-from") true
        (= name "quote") true
        (= name "quasiquote") true
        (= name "unquote") true
        (= name "splice") true
        (= name "let") true
        (= name "mut") true
        :else false))

(defn raw-surface-name? [(name (slice u8))] (-> bool)
  (let [n (slice/slice-len name)
        (mut i) 0
        (mut segment-start) true
        (mut valid) (> n 0)]
    (loop (if (or (not (load valid)) (>= (load i) n))
              (break)
              (let [c (primitive/cast i64 (slice/slice-get name (load i)))]
                (if (= c 46)
                    (if (and (not (load segment-start))
                             (and (= (+ (load i) 3) n)
                                  (and (= (slice/slice-get name (+ (load i) 1))
                                          (primitive/cast u8 46))
                                       (= (slice/slice-get name (+ (load i) 2))
                                          (primitive/cast u8 46)))))
                        (store! i n)
                        (store! valid false))
                    (if (= c 47)
                        (if (load segment-start)
                            (store! valid false)
                            (store! segment-start true))
                        (if (load segment-start)
                            (if (raw-ident-start? c)
                                (store! segment-start false)
                                (store! valid false))
                            (if (not (or (raw-ident-part? c)
                                         (and (= c 62)
                                              (and (> (load i) 0)
                                                   (and (= (slice/slice-get name (- (load i) 1))
                                                           (primitive/cast u8 45))
                                                        (and (< (+ (load i) 1) n)
                                                             (raw-ident-start? (primitive/cast i64
                                                                                               (slice/slice-get name
                                                                                                                (+ (load i)
                                                                                                                   1))))))))))
                                (store! valid false)
                                0))))
                (store! i (+ (load i) 1)))))
    (and (load valid) (not (load segment-start)))))

(defn render-raw-name! [(name (slice u8)) (out (mut str/StrBuf))] (-> i64)
  (if (and (raw-surface-name? name) (not (raw-reserved-name? name)))
      (let [(mut i) 0]
        (loop (if (>= (load i) (slice/slice-len name))
                  (break)
                  (do
                    (if (= (slice/slice-get name (load i)) (primitive/cast u8 47))
                        (str/sb-push-str! (mut out) "::")
                        (str/sb-push-byte! (mut out) (slice/slice-get name (load i))))
                    (store! i (+ (load i) 1))))))
      (do
        (str/sb-push-byte! (mut out) (primitive/cast u8 96))
        (str/sb-push-str! (mut out) name)
        (str/sb-push-byte! (mut out) (primitive/cast u8 96)))))

(defn render-raw-module! [(p (ptr NativeCursor)) (out (mut str/StrBuf))] (-> i64)
  (do
    (nc-skip! p)
    (nc-step! p)
    (nc-read-atom! p)
    (let [name (nc-read-atom! p)]
      (str/sb-push-str! (mut out) "module ")
      (let [(mut i) 0]
        (loop (if (>= (load i) (slice/slice-len name))
                  (break)
                  (do
                    (if (= (slice/slice-get name (load i)) (primitive/cast u8 46))
                        (str/sb-push-str! (mut out) "::")
                        (str/sb-push-byte! (mut out) (slice/slice-get name (load i))))
                    (store! i (+ (load i) 1))))))
      (nc-skip! p)
      (if (not (= (nc-byte p) 41))
          (converter-fail "rust-like converter: malformed module form\n")
          0)
      (nc-step! p)
      (str/sb-push-str! (mut out) ";\n\n"))))

(defn render-raw-const! [(p (ptr NativeCursor)) (out (mut str/StrBuf))] (-> i64)
  (do
    (nc-skip! p)
    (nc-step! p)
    (nc-read-atom! p)
    (let [name (nc-read-atom! p)]
      (str/sb-push-str! (mut out) "const ")
      (render-raw-name! name (mut out))
      (str/sb-push-str! (mut out) " = ")
      (render-surface-expr! p (mut out))
      (nc-skip! p)
      (if (not (= (nc-byte p) 41))
          (converter-fail "rust-like converter: malformed const form\n")
          0)
      (nc-step! p)
      (str/sb-push-str! (mut out) ";\n\n"))))

(defn render-raw-def! [(p (ptr NativeCursor)) (out (mut str/StrBuf))] (-> i64)
  (do
    (nc-skip! p)
    (nc-step! p)
    (nc-read-atom! p)
    (str/sb-push-str! (mut out) "alias ")
    (render-raw-name! (nc-read-atom! p) (mut out))
    (str/sb-push-str! (mut out) " = ")
    (render-surface-expr! p (mut out))
    (nc-skip! p)
    (if (not (= (nc-byte p) 41))
        (converter-fail "rust-like converter: malformed def alias\n")
        0)
    (nc-step! p)
    (str/sb-push-str! (mut out) ";\n\n")))

(defn nc-vector-is-fields? [(p (ptr NativeCursor))] (-> bool)
  (let [saved (.at p)]
    (nc-skip! p)
    (if (= (nc-byte p) 91) (nc-step! p) 0)
    (nc-skip! p)
    (let [result (or (= (nc-byte p) 40) (= (nc-byte p) 93))]
      (set! (.at p) saved)
      result)))

(defn render-raw-generics! [(p (ptr NativeCursor)) (out (mut str/StrBuf))] (-> i64)
  (do
    (nc-skip! p)
    (if (not (= (nc-byte p) 91))
        (converter-fail "rust-like converter: expected generic vector\n")
        0)
    (nc-step! p)
    (str/sb-push-byte! (mut out) (primitive/cast u8 60))
    (let [(mut first) true]
      (loop (nc-skip! p)
        (if (= (nc-byte p) 93)
            (break)
            (do
              (if (load first)
                  (store! first false)
                  (str/sb-push-str! (mut out) ", "))
              (if (= (nc-byte p) 40)
                  (do
                    (nc-step! p)
                    (render-raw-name! (nc-read-atom! p) (mut out))
                    (nc-skip! p)
                    (if (not (= (nc-byte p) 41))
                        (do
                          (str/sb-push-str! (mut out) ": ")
                          (let [(mut first-bound) true]
                            (loop (nc-skip! p)
                              (if (= (nc-byte p) 41)
                                  (break)
                                  (do
                                    (if (load first-bound)
                                        (store! first-bound false)
                                        (str/sb-push-str! (mut out) " + "))
                                    (render-raw-name! (nc-read-atom! p) (mut out)))))))
                        0)
                    (nc-step! p))
                  (render-raw-name! (nc-read-atom! p) (mut out)))))))
    (nc-step! p)
    (str/sb-push-byte! (mut out) (primitive/cast u8 62))))

(defn render-raw-type-name! [(name (slice u8))
                             (out (mut str/StrBuf))] (-> i64)
  (if (= name "mut")
      (str/sb-push-str! (mut out) name)
      (render-raw-name! name (mut out))))

(defn render-raw-type! [(p (ptr NativeCursor)) (out (mut str/StrBuf))] (-> i64)
  (do
    (nc-skip! p)
    (let [c (nc-byte p)]
      (cond (= c 40)
              (do
                (nc-step! p)
                (render-raw-type-name! (nc-read-atom! p) (mut out))
                (str/sb-push-byte! (mut out) (primitive/cast u8 60))
                (let [(mut first) true]
                  (loop (nc-skip! p)
                    (if (= (nc-byte p) 41)
                        (break)
                        (do
                          (if (load first)
                              (store! first false)
                              (str/sb-push-str! (mut out) ", "))
                          (render-raw-type! p (mut out))))))
                (nc-step! p)
                (str/sb-push-byte! (mut out) (primitive/cast u8 62)))
            (= c 91)
              (do
                (nc-step! p)
                (str/sb-push-byte! (mut out) (primitive/cast u8 91))
                (let [(mut first) true]
                  (loop (nc-skip! p)
                    (if (= (nc-byte p) 93)
                        (break)
                        (do
                          (if (load first)
                              (store! first false)
                              (str/sb-push-str! (mut out) ", "))
                          (render-raw-type! p (mut out))))))
                (nc-step! p)
                (str/sb-push-byte! (mut out) (primitive/cast u8 93)))
            :else (render-raw-type-name! (nc-read-atom! p) (mut out))))
    0))

(defn render-raw-fields! [(p (ptr NativeCursor)) (out (mut str/StrBuf))] (-> i64)
  (do
    (nc-skip! p)
    (if (not (= (nc-byte p) 91))
        (converter-fail "rust-like converter: expected field vector\n")
        0)
    (nc-step! p)
    (loop (nc-skip! p)
      (if (= (nc-byte p) 93)
          (break)
          (do
            (if (not (= (nc-byte p) 40))
                (converter-fail "rust-like converter: expected field form\n")
                0)
            (nc-step! p)
            (str/sb-push-str! (mut out) "    ")
            (render-raw-name! (nc-read-atom! p) (mut out))
            (str/sb-push-str! (mut out) ": ")
            (render-raw-type! p (mut out))
            (nc-skip! p)
            (if (not (= (nc-byte p) 41))
                (converter-fail "rust-like converter: malformed field\n")
                0)
            (nc-step! p)
            (str/sb-push-str! (mut out) ",\n"))))
    (nc-step! p)))

(defn render-raw-defstruct! [(p (ptr NativeCursor)) (out (mut str/StrBuf))] (-> i64)
  (do
    (nc-skip! p)
    (nc-step! p)
    (nc-read-atom! p)
    (let [name (nc-read-atom! p)]
      (str/sb-push-str! (mut out) "struct ")
      (render-raw-name! name (mut out))
      (if (not (nc-vector-is-fields? p)) (render-raw-generics! p (mut out)) 0)
      (str/sb-push-str! (mut out) " {\n")
      (render-raw-fields! p (mut out))
      (str/sb-push-str! (mut out) "}\n\n")
      (nc-skip! p)
      (if (not (= (nc-byte p) 41))
          (converter-fail "rust-like converter: malformed defstruct form\n")
          0)
      (nc-step! p))))

(defn nc-raw-defsum-renderable? [(p (ptr NativeCursor))] (-> bool)
  (let [saved (.at p)
        (mut yes) true]
    (nc-skip! p)
    (nc-step! p)
    (nc-read-atom! p)
    (nc-read-atom! p)
    (nc-skip! p)
    (if (= (nc-byte p) 91) (nc-skip-node! p) 0)
    (loop (nc-skip! p)
      (if (or (not (load yes)) (= (nc-byte p) 41))
          (break)
          (if (not (= (nc-byte p) 40))
              (store! yes false)
              (do
                (nc-step! p)
                (nc-read-atom! p)
                (nc-skip! p)
                (if (= (nc-byte p) 91)
                    (do (nc-skip-node! p) (nc-skip! p))
                    0)
                (if (= (nc-byte p) 41) (nc-step! p) (store! yes false))))))
    (set! (.at p) saved)
    (load yes)))

(defn render-raw-defsum! [(p (ptr NativeCursor)) (out (mut str/StrBuf))] (-> i64)
  (do
    (nc-skip! p)
    (nc-step! p)
    (nc-read-atom! p)
    (str/sb-push-str! (mut out) "enum ")
    (render-raw-name! (nc-read-atom! p) (mut out))
    (nc-skip! p)
    (if (= (nc-byte p) 91) (render-raw-generics! p (mut out)) 0)
    (str/sb-push-str! (mut out) " {\n")
    (loop (nc-skip! p)
      (if (= (nc-byte p) 41)
          (break)
          (do
            (nc-step! p)
            (str/sb-push-str! (mut out) "    ")
            (render-raw-name! (nc-read-atom! p) (mut out))
            (nc-skip! p)
            (if (= (nc-byte p) 91)
                (do
                  (str/sb-push-str! (mut out) " {\n")
                  (render-raw-fields! p (mut out))
                  (str/sb-push-str! (mut out) "    }"))
                0)
            (nc-skip! p)
            (nc-step! p)
            (str/sb-push-str! (mut out) ",\n"))))
    (nc-step! p)
    (str/sb-push-str! (mut out) "}\n\n")))

(defn nc-annotation-prefix? [(p (ptr NativeCursor))] (-> bool)
  (let [saved (.at p)]
    (nc-skip! p)
    (let [yes (= (nc-byte p) 58)]
      (set! (.at p) saved)
      yes)))

(defn nc-skip-annotations! [(p (ptr NativeCursor))] (-> i64)
  (do
    (loop (if (not (nc-annotation-prefix? p))
              (break)
              (do (nc-read-atom! p) (nc-skip-node! p))))
    0))

(defn render-raw-annotation! [(p (ptr NativeCursor))
                              (out (mut str/StrBuf))
                              (indent (slice u8))] (-> i64)
  (let [key (nc-read-atom! p)]
    (str/sb-push-str! (mut out) "#[")
    (render-raw-name! (slice/subslice key 1 (slice/slice-len key)) (mut out))
    (str/sb-push-byte! (mut out) (primitive/cast u8 40))
    (render-surface-expr! p (mut out))
    (str/sb-push-str! (mut out) ")]\n")
    (str/sb-push-str! (mut out) indent)))

(defn render-raw-annotations! [(p (ptr NativeCursor))
                               (out (mut str/StrBuf))
                               (indent (slice u8))] (-> i64)
  (do
