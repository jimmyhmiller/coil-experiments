(module experiments.rust-like.audit-reader)

(import "coil.primitive" :as primitive)
(import "experiments.rust-like.converter" :use [native-to-rust-like])
(import "experiments.rust-like.reader" :use [parse-program])

(defn audit-native-roundtrip [(context Code)] (-> Code)
  (let [source (primitive/code-str (primitive/code-nth context 2))
        original (primitive/code-read source `(reader-config))
        converted (native-to-rust-like source)
        restored (parse-program context converted)]
    (if (primitive/code-eq original restored)
        `(do
           (module rust-like-roundtrip-audit-output)
           (defn main [] (-> i64)
             0))
        (primitive/error (primitive/code-str "rust-like exact syntax-tree round trip failed for "
                                             (primitive/code-str (primitive/code-nth context 1)))))))
