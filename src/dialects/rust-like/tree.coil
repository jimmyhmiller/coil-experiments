(module experiments.rust-like.tree)

(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use [malloc-allocator])
(import "coil.slice" :as slice)
(import "coil.str" :as str)
(import "coil.fs" :as fs)
(import "coil.args" :as args)
(import "coil.io" :use [stderr print-str])
(import "experiments.rust-like.converter" :use [native-to-rust-like json-string! converter-fail])

(extern opendir :cc c [(ptr i8)] (-> (ptr i8)))
(extern readdir :cc c [(ptr i8)] (-> (ptr i8)))
(extern closedir :cc c [(ptr i8)] (-> i32))
(extern mkdir :cc c [(ptr i8) i32] (-> i32))
(extern strlen :cc c [(ptr i8)] (-> isize))

(defn tree-cstr->slice [(p (ptr i8))] (-> (slice u8))
  (slice/slice-new (primitive/cast (ptr u8) p) (primitive/cast i64 (strlen p))))

(defn tree-os-pick [(linux Code) (darwin Code)] (-> Code)
  (if (primitive/code-eq (primitive/target-os) `linux) linux darwin))
(defn tree-public-name [(name Code)] (-> Code) (primitive/syntax->datum name))
(defn tree-layout [] (-> Code)
  `(do (const ~(tree-public-name `TREE-DIRENT-TYPE) ~(tree-os-pick `18 `20))
       (const ~(tree-public-name `TREE-DIRENT-NAME) ~(tree-os-pick `19 `21))))
(meta (tree-layout))
(const TREE-DT-DIR 4)
(const TREE-DT-REG 8)

(defn path-join [(a (dyn alloc/Allocator)) (left (slice u8))
                 (right (slice u8))] (-> (slice u8))
  (let [(mut out) (str/sb-new a)]
    (str/sb-push-str! (mut out) left)
    (if (and (> (slice/slice-len left) 0)
             (not (= (slice/slice-get left (- (slice/slice-len left) 1))
                     (primitive/cast u8 47))))
        (str/sb-push-byte! (mut out) (primitive/cast u8 47)) 0)
    (str/sb-push-str! (mut out) right)
    (str/sb-finish! (mut out))))

(defn suffix? [(value (slice u8)) (suffix (slice u8))] (-> bool)
  (let [n (slice/slice-len value) m (slice/slice-len suffix)]
    (and (>= n m) (= (slice/subslice value (- n m) n) suffix))))

(defn joined-text [(a (dyn alloc/Allocator)) (left (slice u8))
                   (middle (slice u8)) (right (slice u8))] (-> (slice u8))
  (let [(mut out) (str/sb-new a)]
    (str/sb-push-str! (mut out) left)
    (str/sb-push-str! (mut out) middle)
    (str/sb-push-str! (mut out) right)
    (str/sb-finish! (mut out))))

(defn ignored-dir? [(name (slice u8))] (-> bool)
  (or (= name ".git") (or (= name ".coil") (or (= name ".claude")
      (or (= name ".agents") (or (= name "build") (or (= name "builds")
          (or (= name "target") (= name "__pycache__")))))))))

(defn malformed-source-data? [(path (slice u8))] (-> bool)
  (or (suffix? path "/tests/balance/cases/mismatched-bracket.coil")
  (or (suffix? path "/tests/balance/cases/stray-close-column0.coil")
  (or (suffix? path "/tests/balance/cases/stray-close-inline.coil")
  (or (suffix? path "/tests/balance/cases/two-damaged-forms.coil")
  (or (suffix? path "/tests/balance/cases/typecheck-timeout.coil")
  (or (suffix? path "/tests/compiler/features/terminated_hex_escape_c_byte_rejected.coil")
  (or (suffix? path "/tests/compiler/features/terminated_hex_escape_empty_rejected.coil")
  (or (suffix? path "/tests/compiler/features/terminated_hex_escape_missing_terminator_rejected.coil")
  (or (suffix? path "/tests/compiler/features/terminated_hex_escape_range_rejected.coil")
  (or (suffix? path "/tests/compiler/features/terminated_hex_escape_surrogate_rejected.coil")
  (or (suffix? path "/tests/compiler/oracle/diag/inputs/01-parse-unclosed.coil")
  (or (suffix? path "/tests/compiler/oracle/negative/lone-prefix.coil")
  (or (suffix? path "/tests/compiler/oracle/negative/mismatched-delims.coil")
  (or (suffix? path "/tests/compiler/oracle/negative/prefix-edges.coil")
  (or (suffix? path "/tests/compiler/oracle/negative/unclosed-bracket.coil")
  (or (suffix? path "/tests/compiler/oracle/negative/unclosed-paren.coil")
  (or (suffix? path "/tests/compiler/oracle/negative/unexpected-close.coil")
  (or (suffix? path "/tests/compiler/oracle/negative/unterminated-cstr.coil")
  (or (suffix? path "/tests/compiler/oracle/negative/unterminated-escape.coil")
  (or (suffix? path "/tests/compiler/oracle/negative/unterminated-string.coil")
      (suffix? path "/tests/repro/paredit-balance-coil/input.coil"))))))))))))))))))))))

(defn read-required [(a (dyn alloc/Allocator)) (path (slice u8))] (-> (slice u8))
  (match (fs/read-file a path)
    (Ok [text] text)
    (Err [_] (do (converter-fail (joined-text a "rust-like tree: cannot read " path "\n")) ""))))

(defn write-required [(a (dyn alloc/Allocator)) (path (slice u8))
                      (text (slice u8))] (-> i64)
  (match (fs/write-file a path text)
    (Ok [_] 0)
    (Err [_] (converter-fail (joined-text a "rust-like tree: cannot write " path "\n")))))

(defn module-name [(source (slice u8))] (-> (slice u8))
  (let [n (slice/slice-len source) (mut i) 0 (mut start) -1 (mut stop) -1]
    (loop
      (if (>= (+ (load i) 7) n) (break)
          (if (and (= (slice/slice-get source (load i)) (primitive/cast u8 40))
                   (= (slice/subslice source (+ (load i) 1) (+ (load i) 7)) "module"))
              (do (store! i (+ (load i) 7))
                  (loop (if (or (>= (load i) n)
                                (not (or (= (slice/slice-get source (load i)) (primitive/cast u8 32))
                                         (= (slice/slice-get source (load i)) (primitive/cast u8 10)))))
                            (break) (store! i (+ (load i) 1))))
                  (store! start (load i))
                  (loop (if (or (>= (load i) n)
                                (= (slice/slice-get source (load i)) (primitive/cast u8 41))
                                (= (slice/slice-get source (load i)) (primitive/cast u8 32)))
                            (break) (store! i (+ (load i) 1))))
                  (store! stop (load i))
                  (break))
              (store! i (+ (load i) 1)))))
    (if (< (load start) 0)
        ""
        (slice/subslice source (load start) (load stop)))))

(defn stub-source [(a (dyn alloc/Allocator)) (module (slice u8))
                   (rust-like (slice u8))] (-> (slice u8))
  (let [(mut out) (str/sb-new a)]
    (if (> (slice/slice-len module) 0)
        (do
          (str/sb-push-str! (mut out) "(module ")
          (str/sb-push-str! (mut out) module)
          (str/sb-push-str! (mut out) ")\n")) 0)
    (str/sb-push-str! (mut out)
      "(import \"experiments.rust-like.reader\" :use [rust-like-items])\n(rust-like-items ")
    (json-string! (mut out) rust-like)
    (str/sb-push-str! (mut out) ")\n")
    (str/sb-finish! (mut out))))

(defn convert-file! [(a (dyn alloc/Allocator)) (source-path (slice u8))
                     (destination-path (slice u8))] (-> i64)
  (let [native (read-required a source-path)
        rust-like (native-to-rust-like native)
        rust-like-path (joined-text a destination-path "rs" "")
        module (module-name native)
        stub (stub-source a module rust-like)]
    (write-required a rust-like-path rust-like)
    (write-required a destination-path stub)
    (alloc/free [u8] a stub)
    (alloc/free [u8] a rust-like)
    (alloc/free [u8] a native)
    (alloc/free [u8] a rust-like-path)))

(defn copy-file! [(a (dyn alloc/Allocator)) (source (slice u8))
                  (destination (slice u8))] (-> i64)
  (let [contents (read-required a source)]
    (write-required a destination contents)
    (alloc/free [u8] a contents)))

(defn convert-dir! [(a (dyn alloc/Allocator)) (source (slice u8))
                    (destination (slice u8))] (-> i64)
  (do
    (if (not (= (mkdir (str/str->cstr a destination) (primitive/cast i32 493)) 0))
        (converter-fail (joined-text a "rust-like tree: cannot create " destination "\n")) 0)
    (let [stream (opendir (str/str->cstr a source))]
      (if (= (primitive/cast i64 stream) 0)
          (converter-fail (joined-text a "rust-like tree: cannot open " source "\n"))
          (do
            (loop
              (let [entry (readdir stream)]
                (if (= (primitive/cast i64 entry) 0) (break)
                    (let [name (tree-cstr->slice (primitive/index entry TREE-DIRENT-NAME))
                          kind (primitive/cast i64
                                 (load (primitive/index entry TREE-DIRENT-TYPE)))]
                      (unless (or (= name ".") (= name ".."))
                        (let [from (path-join a source name) to (path-join a destination name)]
                          (cond (= kind TREE-DT-DIR)
                                  (if (ignored-dir? name) 0 (convert-dir! a from to))
                                (= kind TREE-DT-REG)
                                  (if (suffix? name ".coil")
                                      (if (malformed-source-data? from)
                                          (copy-file! a from to)
                                          (convert-file! a from to))
                                      (copy-file! a from to))
                                :else 0)))))))
            (closedir stream)
            0)))))

(defn install-reader! [(a (dyn alloc/Allocator)) (destination (slice u8))] (-> i64)
  (let [dialects (path-join a destination "src/dialects")
        target (path-join a dialects "rust-like")]
    (mkdir (str/str->cstr a dialects) (primitive/cast i32 493))
    (if (not (= (mkdir (str/str->cstr a target) (primitive/cast i32 493)) 0))
        (converter-fail "rust-like tree: cannot install reader package\n") 0)
    (copy-file! a "src/dialects/rust-like/Coil.toml" (path-join a target "Coil.toml"))
    (copy-file! a "src/dialects/rust-like/rust.coil" (path-join a target "rust.coil"))
    (copy-file! a "src/dialects/rust-like/reader.coil" (path-join a target "reader.coil"))
    (copy-file! a "src/dialects/rust-like/converter.coil" (path-join a target "converter.coil"))
    (copy-file! a "src/dialects/rust-like/convert.coil" (path-join a target "convert.coil"))
    0))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (do
    (args/args-set! argc argv)
    (if (not (= (args/args-count) 3))
        (do (print-str (stderr) "usage: coil run experiments.rust-like.tree SOURCE DESTINATION\n") 2)
        (let [a (malloc-allocator) destination (args/args-nth 2)]
          (convert-dir! a (args/args-nth 1) destination)
          (install-reader! a destination)
          0))))
