(module experiments.forth.reader)

(reader-provider "experiments.forth.reader" read-forth)

(import "coil.primitive" :as primitive)
(import "coil.slice" :use [slice-len slice-get])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.str" :as str)
(import "coil.arraylist" :use [ArrayList al-new al-push! al-len al-get])

;; A token is a source byte range plus a line number. Keeping original byte
;; ranges avoids allocating one string per token and gives exact diagnostics.
(defstruct Token [(kind i64) (start i64) (end i64) (line i64)])

;; Token kinds: word, integer, definition, end-definition, variable, array.
(const TOKEN-WORD 0)
(const TOKEN-INT 1)
(const TOKEN-COLON 2)
(const TOKEN-SEMICOLON 3)
(const TOKEN-VARIABLE 4)
(const TOKEN-ARRAY 5)

;; A user word is identified by its source spelling and exact stack effect.
;; Bodies are stored as native Code lists so no Forth runtime is emitted.
(defstruct Definition [(effect i64) (name (slice u8)) (index i64)])

;; The compiler state is explicit and immutable across recursive calls. This
;; makes control-flow compilation easier to reason about than hidden globals.

(defn whitespace? [(c i64)] (-> bool)
  (or (= c 32) (and (>= c 9) (<= c 13))))

(defn digit? [(c i64)] (-> bool)
  (and (>= c 48) (<= c 57)))

(defn identifier-byte? [(c i64)] (-> bool)
  (and (not (whitespace? c))
       (and (!= c 40) (!= c 41))))

(defn token-text [(source (slice u8)) (token Token)] (-> (slice u8))
  (let [(mut bytes) (str/sb-new (malloc-allocator))
        cursor (field token start)
        end (field token end)
        (mut offset) 0]
    (loop
      (when (>= (+ cursor (load offset)) end) (break) 0)
      (do (str/sb-push-byte! (mut bytes)
                             (primitive/cast u8
                               (slice-get source (+ cursor (load offset)))))
          (store! offset (+ (load offset) 1))))
    (str/sb-finish! (mut bytes))))

(defn text-eq [(source (slice u8)) (token Token) (text (slice u8))] (-> bool)
  (let [length (- (field token end) (field token start))]
    (and (= length (slice-len text))
         (let [(mut equal) true
               (mut i) 0]
           (loop
             (when (or (not (load equal)) (>= (load i) length)) (break) 0)
             (do (store! equal
                         (= (primitive/cast i64
                              (slice-get source (+ (field token start) (load i))))
                            (primitive/cast i64 (slice-get text (load i)))))
                 (store! i (+ (load i) 1))))
           (load equal)))))

;; Scan once into source-backed tokens. Parenthesized and backslash comments are
;; consumed by the scanner, so compilation sees executable words only.
(defn scan-tokens [(source (slice u8))] (-> (ArrayList Token))
  (let [(mut tokens) (al-new [Token] (malloc-allocator))
        (mut cursor) 0
        (mut line) 1
        count (slice-len source)]
    (loop
      (when (>= (load cursor) count) (break) 0)
      (let [c (primitive/cast i64 (slice-get source (load cursor)))]
        (cond (= c 10)
                (do (store! line (+ (load line) 1))
                    (store! cursor (+ (load cursor) 1))
                    0)
              (whitespace? c)
                (do (store! cursor (+ (load cursor) 1)) 0)
              (= c 92)
                (do
                  (loop
                    (when (or (>= (load cursor) count)
                              (= (primitive/cast i64
                                   (slice-get source (load cursor))) 10))
                      (break)
                      (do (store! cursor (+ (load cursor) 1)) 0)))
                  0)
              :else
                (let [start (load cursor)]
                  (loop
                    (when (or (>= (load cursor) count)
                              (not (identifier-byte?
                                    (primitive/cast i64
                                      (slice-get source (load cursor))))))
                      (break)
                      (do (store! cursor (+ (load cursor) 1)))))
                  (al-push! [Token] (mut tokens)
                            (Token :kind TOKEN-WORD :start start
                                   :end (load cursor) :line (load line)))))))
    tokens))

;; A compile-time diagnostic includes the source line so malformed programs fail
;; before any generated Coil is typechecked.
(defn error-at [(line i64) (message (slice u8))] (-> Code)
  (let [(mut text) (str/sb-new (malloc-allocator))]
    (str/sb-push-str! (mut text) "forth reader: ")
    (str/sb-push-str! (mut text) message)
    (str/sb-push-str! (mut text) " at line ")
    (str/sb-push-i64! (mut text) line)
    (primitive/error (str/sb-finish! (mut text)))))

;; Compile a complete source program. The current slice validates the scanner
;; and emits the generated module boundary; the full compiler pass is not yet
;; implemented.
(defn read-forth [(context Code)] (-> Code)
  (let [source (primitive/code-str (primitive/code-nth context 2))]
    `(do
       (module forth-program)
       0)))

