(module wasm-reader-import-poc.main)

(import "coil.primitive" :as primitive)
(import "poc.wasm.math" :as math)

(defn main [] (-> i64)
  (let [answer (math/add (primitive/cast i32 20)
                         (primitive/cast i32 22))]
    (if (= answer (primitive/cast i32 42))
        0
        1)))
