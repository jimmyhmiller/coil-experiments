(module wasm-reader-import-poc.main)

(import "coil.primitive" :as primitive)
(import "coil.io" :use *)
(import "coil.fmt" :use *)
(import "poc.wasm.rust" :as rust)

(defn main [] (-> i64)
  ;; "COIL" packed little-endian. Rust walks the four bytes and encodes the
  ;; uppercase, vowel, and digit counts into one result.
  (let [analysis (rust/analyze_ascii (primitive/cast i32 1279872835))]
    (fmt (stdout) "Rust/WASM analysis of COIL: {d} (4 uppercase, 2 vowels, 0 digits)\n"
         (primitive/cast i64 analysis))
    (if (= analysis (primitive/cast i32 262656))
        0
        1)))
