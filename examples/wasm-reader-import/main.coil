(module wasm-reader-import-poc.main)

(import "coil.primitive" :as primitive)
(import "coil.io" :use *)
(import "coil.fmt" :use *)
(import "poc.wasm.checksum" :as wasm)

(defn main [] (-> i64)
  (let [checksum (wasm/checksum (primitive/cast i32 67)
                                (primitive/cast i32 79)
                                (primitive/cast i32 73)
                                (primitive/cast i32 76))]
    (fmt (stdout) "WASM checksum for COIL: {d}\n" (primitive/cast i64 checksum))
    (if (= checksum (primitive/cast i32 2074255))
        0
        1)))
