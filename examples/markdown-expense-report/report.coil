(module experiments.expense-report.report)

(import "coil.alloc" :as alloc)
(import "coil.str" :as str)
(import "experiments.expense-report.ledger" :as ledger)

(export render)

(defn render [(summary ledger/Summary) (allocator (dyn alloc/Allocator))] (-> (slice u8))
  (let [(mut output) (str/sb-new allocator)]
    (str/sb-push-str! (mut output) "Expense report\n")
    (str/sb-push-str! (mut output) "Accepted: ")
    (str/sb-push-i64! (mut output) (ledger/accepted-count summary))
    (str/sb-push-str! (mut output) "\nRejected: ")
    (str/sb-push-i64! (mut output) (ledger/rejected-count summary))
    (str/sb-push-str! (mut output) "\nTravel: ")
    (str/sb-push-i64! (mut output) (ledger/travel-cents summary))
    (str/sb-push-str! (mut output) " cents\nMeals: ")
    (str/sb-push-i64! (mut output) (ledger/meals-cents summary))
    (str/sb-push-str! (mut output) " cents\nSoftware: ")
    (str/sb-push-i64! (mut output) (ledger/software-cents summary))
    (str/sb-push-str! (mut output) " cents\nOther: ")
    (str/sb-push-i64! (mut output) (ledger/other-cents summary))
    (str/sb-push-str! (mut output) " cents\nTotal: ")
    (str/sb-push-i64! (mut output) (ledger/total-cents summary))
    (str/sb-push-str! (mut output) " cents\n")
    (str/sb-finish! (mut output))))
