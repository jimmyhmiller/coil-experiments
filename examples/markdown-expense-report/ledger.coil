(module experiments.expense-report.ledger)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [al-free! al-get al-len])
(import "coil.str" :as str)

(defstruct Summary
  [(accepted i64)
   (rejected i64)
   (total i64)
   (travel i64)
   (meals i64)
   (software i64)
   (other i64)])

(export Summary summarize accepted-count rejected-count total-cents travel-cents meals-cents software-cents other-cents)

(defn accepted-count [(summary Summary)] (-> i64)
  (.accepted summary))

(defn rejected-count [(summary Summary)] (-> i64)
  (.rejected summary))

(defn total-cents [(summary Summary)] (-> i64)
  (.total summary))

(defn travel-cents [(summary Summary)] (-> i64)
  (.travel summary))

(defn meals-cents [(summary Summary)] (-> i64)
  (.meals summary))

(defn software-cents [(summary Summary)] (-> i64)
  (.software summary))

(defn other-cents [(summary Summary)] (-> i64)
  (.other summary))

(defn summarize [(source (slice u8))] (-> Summary)
  (let [a (malloc-allocator)
        (mut lines) (str/str-split a source "\n")
        (mut accepted) 0
        (mut rejected) 0
        (mut total) 0
        (mut travel) 0
        (mut meals) 0
        (mut software) 0
        (mut other) 0
        (mut first-nonempty) true
        line-count (al-len [(slice u8)] lines)
        (mut i) 0]
    (loop (if (>= (load i) line-count)
              (break)
              (let [line (al-get [(slice u8)] lines (load i))]
                (store! i (+ (load i) 1))
                (if (= line "")
                    0
                    (if (load first-nonempty)
                        (do
                          (store! first-nonempty false)
                          (if (= line "date,category,description,amount_cents")
                              0
                              (let [(mut fields) (str/str-split a line ",")
                                    field-count (al-len [(slice u8)] fields)]
                                (if (= field-count 4)
                                    (let [date (al-get [(slice u8)] fields 0)
                                          category (al-get [(slice u8)] fields 1)
                                          description (al-get [(slice u8)] fields 2)
                                          amount-text (al-get [(slice u8)] fields 3)]
                                      (match (str/str-parse-int amount-text)
                                        (None [] (store! rejected (+ (load rejected) 1)))
                                        (Some [amount]
                                              (if (or (= date "")
                                                      (or (= category "")
                                                          (or (= description "") (< amount 0))))
                                                  (store! rejected (+ (load rejected) 1))
                                                  (do
                                                    (store! accepted (+ (load accepted) 1))
                                                    (store! total (+ (load total) amount))
                                                    (if (= category "travel")
                                                        (store! travel (+ (load travel) amount))
                                                        (if (= category "meals")
                                                            (store! meals (+ (load meals) amount))
                                                            (if (= category "software")
                                                                (store! software (+ (load software) amount))
                                                                (store! other (+ (load other) amount))))))))))
                                    (store! rejected (+ (load rejected) 1)))
                                (al-free! [(slice u8)] (mut fields)))))
                        (let [(mut fields) (str/str-split a line ",")
                              field-count (al-len [(slice u8)] fields)]
                          (if (= field-count 4)
                              (let [date (al-get [(slice u8)] fields 0)
                                    category (al-get [(slice u8)] fields 1)
                                    description (al-get [(slice u8)] fields 2)
                                    amount-text (al-get [(slice u8)] fields 3)]
                                (match (str/str-parse-int amount-text)
                                  (None [] (store! rejected (+ (load rejected) 1)))
                                  (Some [amount]
                                        (if (or (= date "")
                                                (or (= category "")
                                                    (or (= description "") (< amount 0))))
                                            (store! rejected (+ (load rejected) 1))
                                            (do
                                              (store! accepted (+ (load accepted) 1))
                                              (store! total (+ (load total) amount))
                                              (if (= category "travel")
                                                  (store! travel (+ (load travel) amount))
                                                  (if (= category "meals")
                                                      (store! meals (+ (load meals) amount))
                                                      (if (= category "software")
                                                          (store! software (+ (load software) amount))
                                                          (store! other (+ (load other) amount))))))))))
                              (store! rejected (+ (load rejected) 1)))
                          (al-free! [(slice u8)] (mut fields))))))))
    (al-free! [(slice u8)] (mut lines))
    (Summary
      :accepted (load accepted)
      :rejected (load rejected)
      :total (load total)
      :travel (load travel)
      :meals (load meals)
      :software (load software)
      :other (load other))))
