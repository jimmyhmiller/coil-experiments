(module experiments.expense-report.report-contract)

(import "coil.alloc" :use [malloc-allocator])
(import "experiments.expense-report.ledger" :as ledger)
(import "experiments.expense-report.report" :as report)

(defn main [] (-> i64)
  (let [source "date,category,description,amount_cents\n2026-08-01,travel,Train,12500\n2026-08-02,meals,Dinner,7800\n2026-08-03,software,Editor,4999\n2026-08-04,office,Paper,1200\nbroken,row\n2026-08-05,travel,Refund,-50\n"
        summary (ledger/summarize source)
        rendered (report/render summary (malloc-allocator))]
    (if (= rendered "Expense report\nAccepted: 4\nRejected: 2\nTravel: 12500 cents\nMeals: 7800 cents\nSoftware: 4999 cents\nOther: 1200 cents\nTotal: 26499 cents\n")
        0
        1)))
