(module experiments.expense-report.ledger-contract)

(import "experiments.expense-report.ledger" :as ledger)

(defn main [] (-> i64)
  (let [source "date,category,description,amount_cents\n2026-08-01,travel,Train,12500\n2026-08-02,meals,Dinner,7800\n2026-08-03,software,Editor,4999\n2026-08-04,office,Paper,1200\nbroken,row\n2026-08-05,travel,Refund,-50\n"
        summary (ledger/summarize source)]
    (if (and (= (ledger/accepted-count summary) 4)
             (and (= (ledger/rejected-count summary) 2)
                  (and (= (ledger/travel-cents summary) 12500)
                       (and (= (ledger/meals-cents summary) 7800)
                            (and (= (ledger/software-cents summary) 4999)
                                 (and (= (ledger/other-cents summary) 1200)
                                      (= (ledger/total-cents summary) 26499)))))))
        0
        1)))
