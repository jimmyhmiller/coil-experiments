(module experiments.expense-report.main)

(import "experiments.expense-report.ledger" :as ledger)
(import "experiments.expense-report.report" :as report)
(import "coil.alloc" :use [malloc-allocator free])
(import "coil.fs" :use [read-file])
(import "coil.io" :use [strlen print-str write-line stdout stderr])
(import "coil.primitive" :as primitive)
(import "coil.slice" :use [slice-new])

(defn main [(argc :i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [a (malloc-allocator)
        count (primitive/cast i64 argc)]
    (if (not (= count 2))
        (do
          (write-line (stderr) "usage: expense-report FILE.csv")
          64)
        (let [path (load (primitive/index argv 1))
              path-bytes (slice-new (primitive/cast (ptr u8) path)
                                    (primitive/cast i64 (strlen path)))]
          (match (read-file a path-bytes)
            (Err [_]
              (do
                (print-str (stderr) "expense-report: cannot read ")
                (write-line (stderr) path-bytes)
                66))
            (Ok [source]
              (let [summary (ledger/summarize source)
                    rendered (report/render summary a)]
                (print-str (stdout) rendered)
                (free [u8] a source)
                (free [u8] a rendered)
                0)))))))
