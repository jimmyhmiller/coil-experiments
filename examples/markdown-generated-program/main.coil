(module experiments.markdown-demo.main)

(import "experiments.markdown-demo.training" :as training)
(import "coil.io" :as io)
(import "coil.fmt" :use [fmt])

(defn main [] (-> i64)
  (let [total (training/weekly-total 15 3 6)]
    (do
      (fmt (io/stdout) "Six-week total: {d} miles\n" total)
      (if (= total 135) 0 1))))
