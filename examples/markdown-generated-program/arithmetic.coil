(module experiments.markdown-demo.arithmetic)

(export clamp ceil-div)

(defn clamp [(value i64) (minimum i64) (maximum i64)] (-> i64)
  (if (< value minimum)
      minimum
      (if (> value maximum)
          maximum
          value)))

(defn ceil-div [(numerator i64) (denominator i64)] (-> i64)
  (if (= (% numerator denominator) 0)
      (/ numerator denominator)
      (+ (/ numerator denominator) 1)))
