(module experiments.markdown-demo.training)

(import "experiments.markdown-demo.arithmetic" :as arithmetic)

(export weekly-total)

(defn weekly-total [(start i64) (increase i64) (weeks i64)] (-> i64)
  (let [(mut total) 0
        (mut current) (arithmetic/clamp start 0 9223372036854775807)
        step (arithmetic/clamp increase 0 9223372036854775807)
        count (arithmetic/clamp weeks 0 9223372036854775807)
        (mut index) 0]
    (loop (if (>= (load index) count)
              (break)
              (do
                (set! total (+ (load total) (load current)))
                (set! current (+ (load current) step))
                (set! index (+ (load index) 1)))))
    (load total)))
