(module experiments.markdown-demo.training-contract)

(import "experiments.markdown-demo.training" :as training)

(defn main [] (-> i64)
  (if (and (= (training/weekly-total 15 3 6) 135)
           (and (= (training/weekly-total -5 3 2) 3)
                (= (training/weekly-total 10 -2 -4) 0)))
      0
      1))
