(module experiments.markdown-demo.arithmetic-contract)

(import "experiments.markdown-demo.arithmetic" :as arithmetic)

(defn main [] (-> i64)
  (if (and (= (arithmetic/clamp -3 0 10) 0)
           (and (= (arithmetic/clamp 14 0 10) 10)
                (and (= (arithmetic/clamp 7 0 10) 7)
                     (and (= (arithmetic/ceil-div 0 4) 0)
                          (and (= (arithmetic/ceil-div 8 4) 2)
                               (= (arithmetic/ceil-div 9 4) 3))))))
      0
      1))
