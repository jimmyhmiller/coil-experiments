(module dependent-negative-out-of-bounds)
(import "experiments.dependent.lang" :use [dependent])

(dependent
  ;; fzero 0 inhabits Fin 1, never Fin 2. There is no unchecked integer index
  ;; constructor that could manufacture the requested proof.
  (check (fzero 0) (Fin 2)))

(defn main [] (-> i64) 0)

