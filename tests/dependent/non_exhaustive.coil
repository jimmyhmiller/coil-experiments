(module dependent-negative-non-exhaustive)
(import "experiments.dependent.lang" :use [dependent])

(dependent
  (data Choice [(Left [(value Nat)]) (Right [(value Nat)])])
  (check
    (dcase (ctor Left 1)
      (fn choice Choice Nat)
      [(Left [value] value)])
    Nat))

(defn main [] (-> i64) 0)

