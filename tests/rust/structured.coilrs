module tests::rust::structured;

use coil::primitive as primitive;

struct Point {
    x: i64,
    y: i64,
}

/// Add the coordinates of a point.
fn add(p: Point) -> i64 {
    p.x + p.y
}

fn main() -> i64 {
    let p = Point { x: 19, y: 22 };
    let pointer = primitive::alloc-stack(i64);
    *pointer = 1;
    if add(p) + *pointer == 42 { 0 } else { 1 }
}
