(module tests.rust.syntax-assertions)

(import "coil.primitive" :as primitive)
(import "experiments.rust-like.reader" :use [parse-program])

(defn assert-rust-like [(source (slice u8)) (expected Code)] (-> i64)
  (let [actual (parse-program expected source)]
    (if (primitive/code-eq actual expected)
        0
        (do
          (primitive/error (primitive/code-str "unexpected Rust-like lowering: " source))
          0))))

(meta (do
        (assert-rust-like "module syntax::imports; use coil::io::{stdout, print_str}; use coil::alloc as alloc; use coil::str::* except { sb-new }; pub use coil::slice::{slice-len as rust_like_slice_len};"
                          `(do
                             (module syntax.imports)
                             (import "coil.io" :use [stdout print_str])
                             (import "coil.alloc" :as alloc)
                             (import "coil.str" :use * :exclude [sb-new])
                             (import "coil.slice"
                                     :use
                                     [slice-len]
                                     :rename
                                     [[slice-len rust_like_slice_len]]
                                     :reexport)))
        (assert-rust-like "module syntax::places; fn assign(object: Object, pointer: ptr<i64>, value: i64) -> i64 { object.field = value; *pointer = value; 0 }"
                          `(do
                             (module syntax.places)
                             (defn assign [(object Object) (pointer (ptr i64)) (value i64)] (-> i64)
                               (set! (.field object) value)
                               (store! pointer value)
                               0)))
        (assert-rust-like "module syntax::foreign; export { main, helper }; cimport \"sys/ioctl.h\" { ioctl }; export_c { main as \"entry\" };"
                          `(do
                             (module syntax.foreign)
                             (export main helper)
                             (cimport "sys/ioctl.h" ioctl)
                             (export-c [main :as "entry"])))
        (assert-rust-like "module syntax::registrations; checker lint; checker early before_expand; transform lower; transform_once once; meta { generate() }"
                          `(do
                             (module syntax.registrations)
                             (checker lint)
                             (checker early :phase before-expand)
                             (transform lower)
                             (transform-once once)
                             (meta (generate))))
        (assert-rust-like "module syntax::packs; fn consume<Args...>(args...: Args...) -> i64 { 0 } extern \"c\" { fn printf(format: ptr<i8>, ...) -> i32; }"
                          `(do
                             (module syntax.packs)
                             (defn consume [Args...] [(args... Args...)] (-> i64)
                               0)
                             (extern printf :cc c [(ptr i8) ...] (-> i32))))
        (assert-rust-like "module syntax::attributes; #[derive(Serialize(rename_all(:camelCase)), Deserialize(rename_all(:camelCase)))] struct User { user_id: i64 } #[inline(Always)] #[http::route(Get(\"/users\"))] fn users() -> i64 { 0 }"
                          `(do
                             (module syntax.attributes)
                             (defstruct User [(user_id i64)])
                             (derive (Serialize (rename_all :camelCase))
                                     (Deserialize (rename_all :camelCase))
                                     User)
                             (defn users :inline (Always) :http/route ((Get "/users")) [] (-> i64)
                               0)))
        (assert-rust-like "module syntax::control; fn flow() -> i64 { loop { break 1; }; while false { continue; }; 0 }"
                          `(do
                             (module syntax.control)
                             (defn flow [] (-> i64)
                               (loop (break 1))
                               (while false (continue))
                               0)))
        (assert-rust-like "module syntax::literals; item values(0, -9223372036854775808, 3.5, true, \"text\\n\", c\"bytes\\0\", 'x', '\\n', :ready, [1, 2, 3]);"
                          (primitive/code-read "(module syntax.literals) (values 0 -9223372036854775808 3.5 true \"text\\n\" c\"bytes\\0\" \\x \\newline :ready [1 2 3])"
                                               `(reader-config)))
        (assert-rust-like "module syntax::types; fn types(a: i64, b: ptr<i64>, c: mut<ArrayList<u8>>, d: slice<u8>, e: dyn<Allocator>, f: Result<i64, Error>, g: [i64, bool], h: fnptr<c, [i64], i64>) -> i64 { generic::<T, U>(a, b) }"
                          (primitive/code-read "(module syntax.types) (defn types [(a i64) (b (ptr i64)) (c (mut (ArrayList u8))) (d (slice u8)) (e (dyn Allocator)) (f (Result i64 Error)) (g [i64 bool]) (h (fnptr c [i64] i64))] (-> i64) (generic [T U] a b))"
                                               `(reader-config)))
        (assert-rust-like "module syntax::expressions; item flow(if condition { yes() } else { no() }, when condition { action(); 0 }, unless condition { action(); 0 }, loop { break :outer, 42; }, while condition { continue; }, for i in 0..count { visit(i); }, block :done { return_from :done, result; fallback }, match value { Some[x] => use-value(x), None[] => 0 }, cond { first => one(), else => zero() }, case value { 1 => one(), else => zero() });"
                          (primitive/code-read "(module syntax.expressions) (flow (if condition (yes) (no)) (when condition (action) 0) (unless condition (action) 0) (loop (break :outer 42)) (while condition (continue)) (for [i 0 count] (visit i)) (block :done (return-from :done result) fallback) (match value (Some [x] (use-value x)) (None [] 0)) (cond first (one) (zero)) (case value 1 (one) (zero)))"
                                               `(reader-config)))
        (assert-rust-like "module syntax::meta_forms; item forms(try { operation() }, comptime { 40 + 2 }, quote(value), quasiquote(template(unquote(value), splice(rest))), custom-form!(value, option)); item defprimitive(code-count, :code-count); item `match`(value, arm);"
                          (primitive/code-read "(module syntax.meta_forms) (forms (try (operation)) (comptime (+ 40 2)) (quote value) (quasiquote (template (unquote value) (unquote-splicing rest))) (custom-form! value option)) (defprimitive code-count :code-count) (match value arm)"
                                               `(reader-config)))
        `(do)))

(defn main [] (-> i64)
  0)
