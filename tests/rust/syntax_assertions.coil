(module tests.rust.syntax-assertions)

(import "coil.primitive" :as primitive)
(import "experiments.rust-like.reader" :use [parse-program])

(defn assert-rust-like [(source (slice u8)) (expected Code)] (-> i64)
  (let [actual (parse-program expected source)]
    (if (primitive/code-eq actual expected) 0
        (do
          (primitive/error (primitive/code-str "unexpected Rust-like lowering: " source))
          0))))

(meta
  (do
    (assert-rust-like
      "module syntax::imports; use coil::io::{stdout, print_str}; use coil::alloc as alloc; use coil::str::* except { sb-new }; pub use coil::slice::{slice-len as rust_like_slice_len};"
      `(do
         (module syntax.imports)
         (import "coil.io" :use [stdout print_str])
         (import "coil.alloc" :as alloc)
         (import "coil.str" :use * :exclude [sb-new])
         (import "coil.slice" :use [slice-len]
           :rename [[slice-len rust_like_slice_len]] :reexport)))
    (assert-rust-like
      "module syntax::places; fn assign(object: Object, pointer: ptr<i64>, value: i64) -> i64 { object.field = value; *pointer = value; 0 }"
      `(do
         (module syntax.places)
         (defn assign [(object Object) (pointer (ptr i64)) (value i64)] (-> i64)
           (do (set! (.field object) value) (do (store! pointer value) 0)))))
    (assert-rust-like
      "module syntax::foreign; export { main, helper }; cimport \"sys/ioctl.h\" { ioctl }; export_c { main as \"entry\" };"
      `(do
         (module syntax.foreign)
         (export main helper)
         (cimport "sys/ioctl.h" ioctl)
         (export-c [main :as "entry"])))
    (assert-rust-like
      "module syntax::registrations; checker lint; checker early before_expand; transform lower; transform_once once; meta { generate() }"
      `(do
         (module syntax.registrations)
         (checker lint)
         (checker early :phase before-expand)
         (transform lower)
         (transform-once once)
         (meta (generate))))
    (assert-rust-like
      "module syntax::packs; fn consume<Args...>(args...: Args...) -> i64 { 0 } extern \"c\" { fn printf(format: ptr<i8>, ...) -> i32; }"
      `(do
         (module syntax.packs)
         (defn consume [Args...] [(args... Args...)] (-> i64) 0)
         (extern printf :cc c [(ptr i8) ...] (-> i32))))
    (assert-rust-like
      "module syntax::attributes; #[derive(Serialize(rename_all(:camelCase)), Deserialize(rename_all(:camelCase)))] struct User { user_id: i64 } #[inline(Always)] #[http::route(Get(\"/users\"))] fn users() -> i64 { 0 }"
      `(do
         (module syntax.attributes)
         (defstruct User [(user_id i64)])
         (derive (Serialize (rename_all :camelCase))
           (Deserialize (rename_all :camelCase)) User)
         (defn users :inline (Always) :http/route ((Get "/users"))
           [] (-> i64) 0)))
    (assert-rust-like
      "module syntax::control; fn flow() -> i64 { loop { break 1; }; while false { continue; }; 0 }"
      `(do
         (module syntax.control)
         (defn flow [] (-> i64)
           (do (loop (do (break 1) 0))
             (do (while false (do (continue) 0)) 0)))))
    (assert-rust-like
      "module syntax::structural; item form!(symbol!(\"const\"), symbol!(\"ANSWER\"), int!(42)); item [atom!(\"vector-symbol\"), string!(\"text\"), float!(3.5)]; item quote(atom!(\"quoted\"));"
      `(do
         (module syntax.structural)
         (const ANSWER 42)
         [vector-symbol "text" 3.5]
         'quoted))
    `(do)))

(defn main [] (-> i64) 0)
