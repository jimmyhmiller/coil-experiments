module tests::rust::control;

fn main() -> i64 {
    let mut total = 0;
    for i in 0..3 {
        total += i;
    };
    while load(total) < 5 {
        total += 1;
    };
    when load(total) == 5 {
        total += 1;
    };
    unless false {
        total += 1;
    };
    let values = [10, 20, 30];
    if load(total) == 7 { 0 } else { 1 }
}
