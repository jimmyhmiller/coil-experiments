(module tests.rust.native-roundtrip)

;; This deliberately exercises braces in strings/comments and syntax that a
;; Rust-like pretty layer must never prevent from passing through unchanged.
(defstruct Pair [(left i64) (right i64)])

(defn main [] (-> i64)
  (let [text "a } brace"
        value (Pair :left 20 :right 22)]
    ;; } inside a native comment must not close the CoilRS escape.
    (if (= (+ (.left value) (.right value)) 42) 0 1)))
