(module tests.rust.native-roundtrip)

(import "coil.alloc" :as alloc :use *)

;;; This deliberately exercises braces in strings/comments and syntax that a
;;; Rust-like pretty layer must never prevent from passing through unchanged.
(defstruct Pair [(left i64) (right i64)])
(defsum RoundtripSum [T] (Empty) (Value [(value T)]))
(deftrait RoundtripTrait [Self T]
  (roundtrip-method [(self Self) (value T)] (-> T)))
(impl RoundtripTrait Pair
  (roundtrip-method [(self Pair) (value i64)] (-> i64) value))
(impl Pair
  (roundtrip-sum [(self Pair)] (-> i64) (+ (.left self) (.right self))))

(const QUOTED '(alpha [beta "gamma"]))
(const TEMPLATE `(alpha ~beta ~@rest))
(export main Pair)
(cimport "roundtrip-only.h" roundtrip-symbol)
(checker roundtrip-checker)
(transform roundtrip-transform :phase before-expand)
(transform-once roundtrip-transform-once)
(meta (roundtrip-generate))
(extern roundtrip-printf :cc c [(ptr i8) ...] (-> i32))

(defn main [] (-> i64)
  (let [text "a } brace"
        value (Pair :left 20 :right 22)]
    ;; } inside a native comment must not close the CoilRS escape.
    (if (= (+ (.left value) (.right value)) 42) 0 1)))
