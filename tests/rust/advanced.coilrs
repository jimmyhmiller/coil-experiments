module tests::rust::advanced;

use coil::derive::*;

extern "c" {
    fn labs(x: i64) -> i64;
}

trait Value<Self> {
    fn value(x: Self) -> i64;
}

#[derive(Eq)]
struct Boxed {
    value: i64,
}

enum Maybe {
    None,
    Some { value: i64 },
}

impl Value for Boxed {
    fn value(x: Boxed) -> i64 {
        x.value
    }
}

fn unwrap(x: Maybe) -> i64 {
    match x {
        Some[value] => value,
        None => 0,
    }
}

#[inline(Always)]
fn classified(x: i64) -> i64 {
    cond {
        x < 0 => 1,
        x == 0 => 2,
        else => case x { 42 => 3, else => 4 },
    }
}

#[test]
fn classification-test() -> i64 {
    assert-eq(classified(42), 3);
    0
}

fn main() -> i64 {
    let b = Boxed { value: 42 };
    if value(b) == unwrap(Maybe::Some { value: 42 }) && classified(42) == 3 && labs(-42) == 42 {
        0
    } else {
        1
    }
}
