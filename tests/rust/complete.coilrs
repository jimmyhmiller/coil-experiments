module tests::rust::complete;

use coil::io::{stdout, print-int, print-str};

struct Point {
    x: i64,
    y: i64,
}

impl Point {
    fn sum(p: Point) -> i64 {
        p.x + p.y
    }
}

fn main() -> i64 {
    let mut total = 0;
    for i in 0..10 {
        let p = Point { x: i, y: i * 2 };
        total = total + sum(p);
    };
    print-int(stdout(), load(total));
    print-str(stdout(), "\n");
    if load(total) == 135 { 0 } else { 1 }
}
