module tests::rust::surface;

const ANSWER: i64 = 42;

struct Box<T> {
    value: T,
}

fn identity<T>(value: T) -> T {
    value
}

impl<T> Box<T> {
    fn get(boxed: Box<T>) -> T {
        boxed.value
    }
}

fn main() -> i64 {
    let compiled = comptime { 40 + 2 };
    let mut total = 0;
    total += get(Box { value: identity::<i64>(compiled) });
    block :done {
        return_from :done, if load(total) == 42 { 0 } else { 1 };
        2
    }
}
