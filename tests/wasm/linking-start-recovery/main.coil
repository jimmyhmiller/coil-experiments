(module wasm-linking-start-recovery.main)

(import "coil.primitive" :as primitive)
(import "experiments.wasm.runtime" :as wasmrt)
(import "Ms" :as ms)
(import "linking.failed-start" :as failed-start)

(defn instantiate-failed-start [] (-> i64)
  (failed-start/__coil_wasm_instantiate)
  0)

(defn main [] (-> i64)
  (ms/__coil_wasm_instantiate)
  (if (not (wasmrt/try-i64-0 (primitive/fnptr-of instantiate-failed-start)))
      1
      (if (or (primitive/icmp-ne (ms/wasm-get-memory-0) (primitive/cast i32 104))
              (primitive/icmp-ne (ms/wasm-get-table-0) (primitive/cast i32 57005)))
          1
          0)))
