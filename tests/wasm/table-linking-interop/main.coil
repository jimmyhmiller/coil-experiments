(module wasm-table-linking-interop.main)

(import "coil.primitive" :as primitive)
(import "module1" :as module1)
(import "module2" :as module2)
(import "module3" :as module3)

(defn main [] (-> i64)
  (module1/__coil_wasm_instantiate)
  (if (or (primitive/icmp-ne (module1/call-8) (primitive/cast i32 65))
          (primitive/icmp-ne (module1/call-9) (primitive/cast i32 66)))
      1
      (do
        (module2/__coil_wasm_instantiate)
        (if (or (primitive/icmp-ne (module1/call-7) (primitive/cast i32 67))
                (or (primitive/icmp-ne (module1/call-8) (primitive/cast i32 68))
                    (primitive/icmp-ne (module1/call-9) (primitive/cast i32 66))))
            1
            (do
              (module3/__coil_wasm_instantiate)
              (if (or (primitive/icmp-ne (module1/call-7) (primitive/cast i32 67))
                      (or (primitive/icmp-ne (module1/call-8) (primitive/cast i32 69))
                          (primitive/icmp-ne (module1/call-9) (primitive/cast i32 70))))
                  1
                  0))))))
