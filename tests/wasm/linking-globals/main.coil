(module wasm-linking-globals.main)

(import "coil.primitive" :as primitive)
(import "Mg" :as mg)
(import "Ng" :as ng)
(import "G1" :as g1)
(import "G2" :as g2)

(defn ne [(actual i32) (expected i64)] (-> bool)
  (primitive/icmp-ne actual (primitive/cast i32 expected)))

(defn main [] (-> i64)
  (mg/__coil_wasm_instantiate)
  (ng/__coil_wasm_instantiate)
  (g1/__coil_wasm_instantiate)
  (g2/__coil_wasm_instantiate)
  (if (ne (g2/g) 5)
      1
      (if (or (ne (mg/glob) 42)
          (or (ne (ng/Mg.glob) 42)
              (or (ne (ng/glob) 43)
                  (or (ne (mg/get) 42)
                      (or (ne (ng/Mg.get) 42)
                          (or (ne (ng/get) 43)
                              (or (ne (mg/mut_glob) 142)
                                  (or (ne (ng/Mg.mut_glob) 142)
                                      (or (ne (mg/get_mut) 142)
                                          (ne (ng/Mg.get_mut) 142))))))))))
      1
      (do
        (mg/set_mut (primitive/cast i32 241))
        (if (or (ne (mg/mut_glob) 241)
                (or (ne (ng/Mg.mut_glob) 241)
                    (or (ne (mg/get_mut) 241)
                        (ne (ng/Mg.get_mut) 241))))
            1
            0)))))
