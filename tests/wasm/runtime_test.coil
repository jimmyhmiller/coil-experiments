(module tests.wasm.runtime-test)

(import "experiments.wasm.runtime" :as wasm)
(import "coil.primitive" :as primitive)

(deftest integer-comparisons
  (assert-eq (wasm/i32-eqz (primitive/cast i32 0)) (primitive/cast i32 1))
  (assert-eq (wasm/i32-lt-s (primitive/cast i32 -1) (primitive/cast i32 0))
             (primitive/cast i32 1))
  (assert-eq (wasm/i32-lt-u (primitive/cast i32 -1) (primitive/cast i32 0))
             (primitive/cast i32 0))
  (assert-eq (wasm/i64-gt-u -1 0) (primitive/cast i32 1)))

(deftest integer-div-rem
  (assert-eq (wasm/i32-div-s (primitive/cast i32 -7) (primitive/cast i32 3))
             (primitive/cast i32 -2))
  (assert-eq (wasm/i32-rem-s (primitive/cast i32 -7) (primitive/cast i32 3))
             (primitive/cast i32 -1))
  (assert-eq (wasm/i32-div-u (primitive/cast i32 -1) (primitive/cast i32 2))
             (primitive/cast i32 2147483647))
  (assert-eq (wasm/i64-rem-s -9223372036854775808 -1) 0))

(deftest masked-shifts-and-rotations
  (assert-eq (wasm/i32-shl (primitive/cast i32 1) (primitive/cast i32 32))
             (primitive/cast i32 1))
  (assert-eq (wasm/i32-shr-u (primitive/cast i32 -1) (primitive/cast i32 1))
             (primitive/cast i32 2147483647))
  (assert-eq (wasm/i32-rotl (primitive/cast i32 1) (primitive/cast i32 1))
             (primitive/cast i32 2))
  (assert-eq (wasm/i32-rotr (primitive/cast i32 1) (primitive/cast i32 1))
             (primitive/cast i32 -2147483648))
  (assert-eq (wasm/i64-rotl 1 64) 1))

(deftest integer-bit-counts
  (assert-eq (wasm/i32-clz (primitive/cast i32 0)) (primitive/cast i32 32))
  (assert-eq (wasm/i32-clz (primitive/cast i32 1)) (primitive/cast i32 31))
  (assert-eq (wasm/i32-ctz (primitive/cast i32 8)) (primitive/cast i32 3))
  (assert-eq (wasm/i32-popcnt (primitive/cast i32 -1)) (primitive/cast i32 32))
  (assert-eq (wasm/i64-clz 1) 63)
  (assert-eq (wasm/i64-ctz 8) 3)
  (assert-eq (wasm/i64-popcnt -1) 64))

(deftest float-bit-constructors
  (assert (primitive/fcmp-eq (wasm/f32-from-bits (primitive/cast i32 0x3f800000))
                             (primitive/cast f32 1)))
  (assert (primitive/fcmp-eq (wasm/f64-from-bits 0x3ff0000000000000) 1.0)))

(deftest float-arithmetic-and-comparisons
  (assert-eq (wasm/f32-lt (primitive/cast f32 1) (primitive/cast f32 2))
             (primitive/cast i32 1))
  (assert-eq (wasm/f64-ge 2.0 3.0) (primitive/cast i32 0))
  (assert-eq (wasm/f32-ne (primitive/cast f32 0)
                          (wasm/f32-from-bits (primitive/cast i32 0xffc00000)))
             (primitive/cast i32 1))
  (assert-eq (wasm/f64-ne 0.0 (wasm/f64-from-bits -2251799813685248))
             (primitive/cast i32 1))
  (assert (primitive/fcmp-eq
            (wasm/f32-mul (primitive/cast f32 6) (primitive/cast f32 7))
            (primitive/cast f32 42)))
  (assert (primitive/fcmp-eq (wasm/f64-div 84.0 2.0) 42.0)))

(deftest float-nan-classes
  (let [f32-snan (wasm/f32-from-bits (primitive/cast i32 0xffa00000))
        f64-snan (wasm/f64-from-bits -2251799813685248)]
    (assert-eq (wasm/f32-arithmetic-nan
                 (wasm/f32-add (wasm/f32-from-bits (primitive/cast i32 0x80000000))
                               f32-snan))
               (primitive/cast i32 1))
    (assert-eq (wasm/f64-arithmetic-nan
                 (wasm/f64-add (wasm/f64-from-bits -9223372036854775808)
                               f64-snan))
               (primitive/cast i32 1))
    (assert-eq (wasm/f32-canonical-nan
                 (wasm/f32-from-bits (primitive/cast i32 0x7fc00000)))
               (primitive/cast i32 1))))

(deftest numeric-conversions
  (assert-eq (wasm/i32-wrap-i64 4294967297) (primitive/cast i32 1))
  (assert-eq (wasm/i64-extend-i32-u (primitive/cast i32 -1)) 4294967295)
  (assert-eq (wasm/i32-trunc-f64-s -42.9) (primitive/cast i32 -42))
  (assert-eq (wasm/i32-trunc-f64-u 4294967295.0) (primitive/cast i32 -1))
  (assert-eq (wasm/i64-trunc-f64-s -42.9) -42)
  (assert (primitive/fcmp-eq (wasm/f64-convert-i64-u -1)
                             18446744073709551616.0)))

(deftest linear-memory-load-store-and-grow
  (let [memory (primitive/alloc-stack wasm/Memory)]
    (store! memory (primitive/zeroed wasm/Memory))
    (wasm/memory-init! memory 1 true 2)
    (assert-eq (wasm/memory-size memory) (primitive/cast i32 1))
    (wasm/i32-store memory (primitive/cast i32 3) 0 (primitive/cast i32 0x78563412))
    (assert-eq (wasm/i32-load memory (primitive/cast i32 3) 0)
               (primitive/cast i32 0x78563412))
    (assert-eq (wasm/i32-load8-u memory (primitive/cast i32 3) 0)
               (primitive/cast i32 0x12))
    (assert-eq (wasm/i32-load16-u memory (primitive/cast i32 4) 0)
               (primitive/cast i32 0x5634))
    (assert-eq (wasm/memory-grow memory (primitive/cast i32 1))
               (primitive/cast i32 1))
    (assert-eq (wasm/memory-size memory) (primitive/cast i32 2))
    (assert-eq (wasm/i32-load memory (primitive/cast i32 65536) 0)
               (primitive/cast i32 0))
    (assert-eq (wasm/memory-grow memory (primitive/cast i32 1))
               (primitive/cast i32 -1))))

(deftest runtime-table-initialization-and-lookup
  (let [table (primitive/alloc-stack wasm/Table)]
    (store! table (primitive/zeroed wasm/Table))
    (wasm/table-init! table 3 true 5)
    (assert-eq (.minimum table) 3)
    (assert-eq (.size table) 3)
    (assert (.has-maximum table))
    (assert-eq (.maximum table) 5)
    (wasm/table-set-ref! table 1 42 2)
    (wasm/table-set-signature-byte! table 1 0 1)
    (wasm/table-set-signature-byte! table 1 1 4)
    (let [entry (wasm/table-entry table (primitive/cast i32 1))]
      (assert-eq (wasm/table-entry-address entry) 42)
      (assert-eq (wasm/table-entry-signature-length entry) 2)
      (assert-eq (wasm/table-entry-signature-byte entry 0) 1)
      (assert-eq (wasm/table-entry-signature-byte entry 1) 4))))

(defn trapped-adapter [] (-> i64)
  (wasm/trap))

(defn successful-adapter [] (-> i64)
  42)

(deftest recoverable-trap-boundary
  (assert (wasm/try-i64-0 (primitive/fnptr-of trapped-adapter)))
  (assert (not (wasm/try-i64-0 (primitive/fnptr-of successful-adapter)))))

(defn non-exhausting-i32-adapter [(value i32)] (-> i64)
  (primitive/cast i64 value))

(defn aborting-i32-adapter [(_value i32)] (-> i64)
  (wasm/trap))

(defn i32-adapter-address [(callback (fnptr c [i32] i64))] (-> i64)
  (primitive/llvm-ir i64 [callback]
    "%r = ptrtoint $t0 $0 to i64\nret i64 %r"))

(deftest exhaustion-boundary-rejects-returns-and-ordinary-traps
  (assert
    (not
      (wasm/expect-exhaustion-i32-void
        (i32-adapter-address (primitive/fnptr-of non-exhausting-i32-adapter))
        (primitive/cast i32 42))))
  (assert
    (not
      (wasm/expect-exhaustion-i32-void
        (i32-adapter-address (primitive/fnptr-of aborting-i32-adapter))
        (primitive/cast i32 0)))))
