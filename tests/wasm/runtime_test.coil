(module tests.wasm.runtime-test)

(import "experiments.wasm.runtime" :as wasm)
(import "coil.primitive" :as primitive)

(deftest integer-comparisons
  (assert-eq (wasm/i32-eqz (primitive/cast i32 0)) (primitive/cast i32 1))
  (assert-eq (wasm/i32-lt-s (primitive/cast i32 -1) (primitive/cast i32 0))
             (primitive/cast i32 1))
  (assert-eq (wasm/i32-lt-u (primitive/cast i32 -1) (primitive/cast i32 0))
             (primitive/cast i32 0))
  (assert-eq (wasm/i64-gt-u -1 0) (primitive/cast i32 1)))

(deftest integer-div-rem
  (assert-eq (wasm/i32-div-s (primitive/cast i32 -7) (primitive/cast i32 3))
             (primitive/cast i32 -2))
  (assert-eq (wasm/i32-rem-s (primitive/cast i32 -7) (primitive/cast i32 3))
             (primitive/cast i32 -1))
  (assert-eq (wasm/i32-div-u (primitive/cast i32 -1) (primitive/cast i32 2))
             (primitive/cast i32 2147483647))
  (assert-eq (wasm/i64-rem-s -9223372036854775808 -1) 0))

(deftest masked-shifts-and-rotations
  (assert-eq (wasm/i32-shl (primitive/cast i32 1) (primitive/cast i32 32))
             (primitive/cast i32 1))
  (assert-eq (wasm/i32-shr-u (primitive/cast i32 -1) (primitive/cast i32 1))
             (primitive/cast i32 2147483647))
  (assert-eq (wasm/i32-rotl (primitive/cast i32 1) (primitive/cast i32 1))
             (primitive/cast i32 2))
  (assert-eq (wasm/i32-rotr (primitive/cast i32 1) (primitive/cast i32 1))
             (primitive/cast i32 -2147483648))
  (assert-eq (wasm/i64-rotl 1 64) 1))

(deftest integer-bit-counts
  (assert-eq (wasm/i32-clz (primitive/cast i32 0)) (primitive/cast i32 32))
  (assert-eq (wasm/i32-clz (primitive/cast i32 1)) (primitive/cast i32 31))
  (assert-eq (wasm/i32-ctz (primitive/cast i32 8)) (primitive/cast i32 3))
  (assert-eq (wasm/i32-popcnt (primitive/cast i32 -1)) (primitive/cast i32 32))
  (assert-eq (wasm/i64-clz 1) 63)
  (assert-eq (wasm/i64-ctz 8) 3)
  (assert-eq (wasm/i64-popcnt -1) 64))

(deftest float-bit-constructors
  (assert (primitive/fcmp-eq (wasm/f32-from-bits (primitive/cast i32 0x3f800000))
                             (primitive/cast f32 1)))
  (assert (primitive/fcmp-eq (wasm/f64-from-bits 0x3ff0000000000000) 1.0)))

(deftest float-arithmetic-and-comparisons
  (assert-eq (wasm/f32-lt (primitive/cast f32 1) (primitive/cast f32 2))
             (primitive/cast i32 1))
  (assert-eq (wasm/f64-ge 2.0 3.0) (primitive/cast i32 0))
  (assert (primitive/fcmp-eq
            (wasm/f32-mul (primitive/cast f32 6) (primitive/cast f32 7))
            (primitive/cast f32 42)))
  (assert (primitive/fcmp-eq (wasm/f64-div 84.0 2.0) 42.0)))
