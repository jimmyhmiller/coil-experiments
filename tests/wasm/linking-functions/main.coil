(module wasm-linking-functions.main)

(import "coil.primitive" :as primitive)
(import "Mf" :as mf)
(import "Nf" :as nf)

(defn main [] (-> i64)
  (if (or (primitive/icmp-ne (mf/wasm-call) (primitive/cast i32 2))
          (or (primitive/icmp-ne (nf/Mf.call) (primitive/cast i32 2))
              (or (primitive/icmp-ne (nf/wasm-call) (primitive/cast i32 3))
                  (primitive/icmp-ne (nf/wasm-call-Mf-call)
                                     (primitive/cast i32 2)))))
      1
      0))
