(module tests.wasm.decoder-test)

(import "experiments.wasm.decoder" :as wasm)
(import "coil.slice" :as slice)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :as al)

(defn bytes8 [(p (ptr u8))] (-> (slice u8)) (slice/slice-new p 8))

(deftest accepts-empty-module
  (let [p (primitive/alloc-stack (array u8 8))]
    (store! (primitive/index p 0) (primitive/cast u8 0x00))
    (store! (primitive/index p 1) (primitive/cast u8 0x61))
    (store! (primitive/index p 2) (primitive/cast u8 0x73))
    (store! (primitive/index p 3) (primitive/cast u8 0x6d))
    (store! (primitive/index p 4) (primitive/cast u8 0x01))
    (store! (primitive/index p 5) (primitive/cast u8 0x00))
    (store! (primitive/index p 6) (primitive/cast u8 0x00))
    (store! (primitive/index p 7) (primitive/cast u8 0x00))
    (match (wasm/module-envelope (bytes8 (primitive/cast (ptr u8) p)))
      (wasm/Decoded [_] (assert true))
      (wasm/DecodeError [_ _] (assert false)))))

(deftest rejects-bad-magic
  (let [p (primitive/alloc-stack (array u8 8))]
    (store! (primitive/index p 0) (primitive/cast u8 0x01))
    (match (wasm/module-envelope (bytes8 (primitive/cast (ptr u8) p)))
      (wasm/DecodeError [at _] (assert-eq at 0))
      (wasm/Decoded [_] (assert false)))))

(deftest captures-type-section-payload
  ;; magic/version, section id 1, payload size 1, empty type vector
  (let [p (primitive/alloc-stack (array u8 11))]
    (store! (primitive/index p 0) (primitive/cast u8 0x00))
    (store! (primitive/index p 1) (primitive/cast u8 0x61))
    (store! (primitive/index p 2) (primitive/cast u8 0x73))
    (store! (primitive/index p 3) (primitive/cast u8 0x6d))
    (store! (primitive/index p 4) (primitive/cast u8 0x01))
    (store! (primitive/index p 5) (primitive/cast u8 0x00))
    (store! (primitive/index p 6) (primitive/cast u8 0x00))
    (store! (primitive/index p 7) (primitive/cast u8 0x00))
    (store! (primitive/index p 8) (primitive/cast u8 0x01))
    (store! (primitive/index p 9) (primitive/cast u8 0x01))
    (store! (primitive/index p 10) (primitive/cast u8 0x00))
    (match (wasm/module-sections
             (slice/slice-new (primitive/cast (ptr u8) p) 11))
      (wasm/DecodeError [_ _] (assert false))
      (wasm/Decoded [sections]
        (let [s sections]
          (assert-eq (slice/slice-len [u8] (.types s)) 1)
          (assert-eq (primitive/cast i64 (slice/slice-get [u8] (.types s) 0)) 0))))))

(deftest decodes-mvp-function-types
  ;; vec[1], 0x60, params vec[i32,i64], results vec[f32]
  (let [p (primitive/alloc-stack (array u8 7))]
    (store! (primitive/index p 0) (primitive/cast u8 1))
    (store! (primitive/index p 1) (primitive/cast u8 0x60))
    (store! (primitive/index p 2) (primitive/cast u8 2))
    (store! (primitive/index p 3) (primitive/cast u8 0x7f))
    (store! (primitive/index p 4) (primitive/cast u8 0x7e))
    (store! (primitive/index p 5) (primitive/cast u8 1))
    (store! (primitive/index p 6) (primitive/cast u8 0x7d))
    (match (wasm/type-section
             (malloc-allocator)
             (slice/slice-new (primitive/cast (ptr u8) p) 7))
      (wasm/DecodeError [_ _] (assert false))
      (wasm/Decoded [types]
        (do
          (assert-eq (al/al-len types) 1)
          (let [ft (al/al-get types 0)]
            (assert-eq (al/al-len (.params ft)) 2)
            (assert-eq (al/al-len (.results ft)) 1)
            (match (al/al-get (.params ft) 0)
              (wasm/I32 [] (assert true))
              (_ (assert false)))
            (match (al/al-get (.params ft) 1)
              (wasm/I64 [] (assert true))
              (_ (assert false)))
            (match (al/al-get (.results ft) 0)
              (wasm/F32 [] (assert true))
              (_ (assert false)))))))))

(deftest decodes-function-and-code-sections
  ;; function section: one type index 0
  (let [fp (primitive/alloc-stack (array u8 2))
        ;; code section: one 4-byte body, one i32 local, expression end
        cp (primitive/alloc-stack (array u8 6))]
    (store! (primitive/index fp 0) (primitive/cast u8 1))
    (store! (primitive/index fp 1) (primitive/cast u8 0))
    (store! (primitive/index cp 0) (primitive/cast u8 1))
    (store! (primitive/index cp 1) (primitive/cast u8 4))
    (store! (primitive/index cp 2) (primitive/cast u8 1))
    (store! (primitive/index cp 3) (primitive/cast u8 1))
    (store! (primitive/index cp 4) (primitive/cast u8 0x7f))
    (store! (primitive/index cp 5) (primitive/cast u8 0x0b))
    (match (wasm/index-section
             (malloc-allocator)
             (slice/slice-new (primitive/cast (ptr u8) fp) 2))
      (wasm/DecodeError [_ _] (assert false))
      (wasm/Decoded [indices]
        (do (assert-eq (al/al-len indices) 1)
            (assert-eq (al/al-get indices 0) 0))))
    (match (wasm/code-section
             (malloc-allocator)
             (slice/slice-new (primitive/cast (ptr u8) cp) 6))
      (wasm/DecodeError [_ _] (assert false))
      (wasm/Decoded [bodies]
        (do
          (assert-eq (al/al-len bodies) 1)
          (let [body (al/al-get bodies 0)]
            (assert-eq (al/al-len (.locals body)) 1)
            (assert-eq (slice/slice-len [u8] (.expression body)) 1)
            (assert-eq
              (primitive/cast i64 (slice/slice-get [u8] (.expression body) 0))
              0x0b)))))))

(deftest decodes-function-export
  ;; vec[1], name "add", function kind, index 0
  (let [p (primitive/alloc-stack (array u8 7))]
    (store! (primitive/index p 0) (primitive/cast u8 1))
    (store! (primitive/index p 1) (primitive/cast u8 3))
    (store! (primitive/index p 2) (primitive/cast u8 #\a))
    (store! (primitive/index p 3) (primitive/cast u8 #\d))
    (store! (primitive/index p 4) (primitive/cast u8 #\d))
    (store! (primitive/index p 5) (primitive/cast u8 0))
    (store! (primitive/index p 6) (primitive/cast u8 0))
    (match (wasm/export-section
             (malloc-allocator)
             (slice/slice-new (primitive/cast (ptr u8) p) 7))
      (wasm/DecodeError [_ _] (assert false))
      (wasm/Decoded [exports]
        (do
          (assert-eq (al/al-len exports) 1)
          (let [e (al/al-get exports 0)]
            (assert-eq (.name e) "add")
            (assert-eq (.kind e) 0)
            (assert-eq (.index e) 0)))))))

(deftest decodes-global-section
  ;; vec[1], mutable i32, i32.const 42, end
  (let [p (primitive/alloc-stack (array u8 6))]
    (store! (primitive/index p 0) (primitive/cast u8 1))
    (store! (primitive/index p 1) (primitive/cast u8 0x7f))
    (store! (primitive/index p 2) (primitive/cast u8 1))
    (store! (primitive/index p 3) (primitive/cast u8 0x41))
    (store! (primitive/index p 4) (primitive/cast u8 42))
    (store! (primitive/index p 5) (primitive/cast u8 0x0b))
    (match (wasm/global-section
             (malloc-allocator)
             (slice/slice-new (primitive/cast (ptr u8) p) 6))
      (wasm/DecodeError [_ _] (assert false))
      (wasm/Decoded [globals]
        (do
          (assert-eq (al/al-len globals) 1)
          (let [g (al/al-get globals 0)]
            (assert (.mutable g))
            (assert-eq (.initializer-opcode g) 0x41)
            (assert-eq (.initializer-bits g) 42)
            (match (.kind g)
              (wasm/I32 [] (assert true))
              (_ (assert false)))))))))

(deftest decodes-memory-and-data-sections
  (let [mp (primitive/alloc-stack (array u8 4))
        dp (primitive/alloc-stack (array u8 8))]
    ;; one memory, min 1, max 2
    (store! (primitive/index mp 0) (primitive/cast u8 1))
    (store! (primitive/index mp 1) (primitive/cast u8 1))
    (store! (primitive/index mp 2) (primitive/cast u8 1))
    (store! (primitive/index mp 3) (primitive/cast u8 2))
    ;; one segment, memory 0, i32.const 8, two bytes
    (store! (primitive/index dp 0) (primitive/cast u8 1))
    (store! (primitive/index dp 1) (primitive/cast u8 0))
    (store! (primitive/index dp 2) (primitive/cast u8 0x41))
    (store! (primitive/index dp 3) (primitive/cast u8 8))
    (store! (primitive/index dp 4) (primitive/cast u8 0x0b))
    (store! (primitive/index dp 5) (primitive/cast u8 2))
    (store! (primitive/index dp 6) (primitive/cast u8 0xaa))
    (store! (primitive/index dp 7) (primitive/cast u8 0xbb))
    (match (wasm/memory-section
             (malloc-allocator)
             (slice/slice-new (primitive/cast (ptr u8) mp) 4))
      (wasm/DecodeError [_ _] (assert false))
      (wasm/Decoded [memories]
        (let [m (al/al-get memories 0)]
          (assert-eq (.minimum m) 1)
          (assert (.has-maximum m))
          (assert-eq (.maximum m) 2))))
    (match (wasm/data-section
             (malloc-allocator)
             (slice/slice-new (primitive/cast (ptr u8) dp) 8))
      (wasm/DecodeError [_ _] (assert false))
      (wasm/Decoded [segments]
        (let [segment (al/al-get segments 0)]
          (assert-eq (.offset segment) 8)
          (assert-eq (slice/slice-len [u8] (.bytes segment)) 2)
          (assert-eq (primitive/cast i64
                       (slice/slice-get [u8] (.bytes segment) 1))
                     0xbb))))))
