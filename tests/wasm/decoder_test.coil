(module tests.wasm.decoder-test)

(import "experiments.wasm.decoder" :as wasm)
(import "coil.slice" :as slice)
(import "coil.primitive" :as primitive)

(defn bytes8 [(p (ptr u8))] (-> (slice u8)) (slice/slice-new p 8))

(deftest accepts-empty-module
  (let [p (primitive/alloc-stack (array u8 8))]
    (store! (primitive/index p 0) (primitive/cast u8 0x00))
    (store! (primitive/index p 1) (primitive/cast u8 0x61))
    (store! (primitive/index p 2) (primitive/cast u8 0x73))
    (store! (primitive/index p 3) (primitive/cast u8 0x6d))
    (store! (primitive/index p 4) (primitive/cast u8 0x01))
    (store! (primitive/index p 5) (primitive/cast u8 0x00))
    (store! (primitive/index p 6) (primitive/cast u8 0x00))
    (store! (primitive/index p 7) (primitive/cast u8 0x00))
    (match (wasm/module-envelope (bytes8 (primitive/cast (ptr u8) p)))
      (wasm/Decoded [_] (assert true))
      (wasm/DecodeError [_ _] (assert false)))))

(deftest rejects-bad-magic
  (let [p (primitive/alloc-stack (array u8 8))]
    (store! (primitive/index p 0) (primitive/cast u8 0x01))
    (match (wasm/module-envelope (bytes8 (primitive/cast (ptr u8) p)))
      (wasm/DecodeError [at _] (assert-eq at 0))
      (wasm/Decoded [_] (assert false)))))
