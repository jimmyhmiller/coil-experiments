(module wasm-linking-memory.main)

(import "coil.primitive" :as primitive)
(import "Mm" :as mm)
(import "Nm" :as nm)
(import "Om" :as om)
(import "Pm" :as pm)
(import "linking.valid22" :as valid22)

(defn ne [(actual i32) (expected i64)] (-> bool)
  (primitive/icmp-ne actual (primitive/cast i32 expected)))

(defn main [] (-> i64)
  (let [(mut failed) false]
    (mm/__coil_wasm_instantiate)
    (nm/__coil_wasm_instantiate)
    (if (ne (mm/wasm-load (primitive/cast i32 12)) 2) (store! failed true) 0)
    (if (ne (nm/Mm.load (primitive/cast i32 12)) 2) (store! failed true) 0)
    (if (ne (nm/wasm-load (primitive/cast i32 12)) 242) (store! failed true) 0)
    (om/__coil_wasm_instantiate)
    (if (ne (mm/wasm-load (primitive/cast i32 12)) 167) (store! failed true) 0)
    (if (ne (nm/Mm.load (primitive/cast i32 12)) 167) (store! failed true) 0)
    (if (ne (nm/wasm-load (primitive/cast i32 12)) 242) (store! failed true) 0)
    (if (ne (om/wasm-load (primitive/cast i32 12)) 167) (store! failed true) 0)
    (valid22/__coil_wasm_instantiate)
    (pm/__coil_wasm_instantiate)
    (if (ne (pm/grow (primitive/cast i32 0)) 1) (store! failed true) 0)
    (if (ne (pm/grow (primitive/cast i32 2)) 1) (store! failed true) 0)
    (if (ne (pm/grow (primitive/cast i32 0)) 3) (store! failed true) 0)
    (if (ne (pm/grow (primitive/cast i32 1)) 3) (store! failed true) 0)
    (if (ne (pm/grow (primitive/cast i32 1)) 4) (store! failed true) 0)
    (if (ne (pm/grow (primitive/cast i32 0)) 5) (store! failed true) 0)
    (if (ne (pm/grow (primitive/cast i32 1)) 4294967295) (store! failed true) 0)
    (if (ne (pm/grow (primitive/cast i32 0)) 5) (store! failed true) 0)
    (if (ne (mm/wasm-load (primitive/cast i32 0)) 0) (store! failed true) 0)
    (if (ne (mm/wasm-load (primitive/cast i32 0)) 0) (store! failed true) 0)
    (if (ne (mm/wasm-load (primitive/cast i32 0)) 0) (store! failed true) 0)
    (if (load failed) 1 0)))
