(module wasm-linking-tables.main)

(import "coil.primitive" :as primitive)
(import "Mt" :as mt)
(import "Nt" :as nt)
(import "Ot" :as ot)

(defn ne [(actual i32) (expected i64)] (-> bool)
  (primitive/icmp-ne actual (primitive/cast i32 expected)))

(defn main [] (-> i64)
  (let [(mut failed) false]
    (mt/__coil_wasm_instantiate)
    (nt/__coil_wasm_instantiate)
    (if (ne (mt/wasm-call (primitive/cast i32 2)) 4) (store! failed true) 0)
    (if (ne (nt/Mt.call (primitive/cast i32 2)) 4) (store! failed true) 0)
    (if (ne (nt/wasm-call (primitive/cast i32 2)) 5) (store! failed true) 0)
    (if (ne (nt/wasm-call-Mt-call (primitive/cast i32 2)) 4)
        (store! failed true) 0)
    (if (ne (nt/wasm-call (primitive/cast i32 1)) 5) (store! failed true) 0)
    (if (ne (nt/wasm-call (primitive/cast i32 0)) 5) (store! failed true) 0)
    (if (ne (nt/wasm-call (primitive/cast i32 3)) 4294967292)
        (store! failed true) 0)
    (ot/__coil_wasm_instantiate)
    (if (ne (mt/wasm-call (primitive/cast i32 3)) 4) (store! failed true) 0)
    (if (ne (nt/Mt.call (primitive/cast i32 3)) 4) (store! failed true) 0)
    (if (ne (nt/wasm-call-Mt-call (primitive/cast i32 3)) 4)
        (store! failed true) 0)
    (if (ne (ot/wasm-call (primitive/cast i32 3)) 4) (store! failed true) 0)
    (if (ne (mt/wasm-call (primitive/cast i32 2)) 4294967292)
        (store! failed true) 0)
    (if (ne (nt/Mt.call (primitive/cast i32 2)) 4294967292)
        (store! failed true) 0)
    (if (ne (nt/wasm-call (primitive/cast i32 2)) 5) (store! failed true) 0)
    (if (ne (nt/wasm-call-Mt-call (primitive/cast i32 2)) 4294967292)
        (store! failed true) 0)
    (if (ne (ot/wasm-call (primitive/cast i32 2)) 4294967292)
        (store! failed true) 0)
    (if (ne (mt/wasm-call (primitive/cast i32 1)) 6) (store! failed true) 0)
    (if (ne (nt/Mt.call (primitive/cast i32 1)) 6) (store! failed true) 0)
    (if (ne (nt/wasm-call (primitive/cast i32 1)) 5) (store! failed true) 0)
    (if (ne (nt/wasm-call-Mt-call (primitive/cast i32 1)) 6)
        (store! failed true) 0)
    (if (ne (ot/wasm-call (primitive/cast i32 1)) 6) (store! failed true) 0)
    (if (ne (nt/wasm-call (primitive/cast i32 0)) 5) (store! failed true) 0)
    (if (load failed) 1 0)))
