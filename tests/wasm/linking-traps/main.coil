(module wasm-linking-traps.main)

(import "coil.primitive" :as primitive)
(import "Mt" :as mt)
(import "Nt" :as nt)
(import "Ot" :as ot)

(extern atoi :cc c [(ptr i8)] (-> i32))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (if (primitive/icmp-ne argc (primitive/cast i32 2))
      2
      (let [mode (primitive/cast i64 (atoi (load (primitive/index argv 1))))]
        (mt/__coil_wasm_instantiate)
        (nt/__coil_wasm_instantiate)
        (if (and (>= mode 12) (<= mode 16))
            (do (ot/__coil_wasm_instantiate) 0)
            0)
        (cond (= mode 1) (primitive/cast i64 (mt/wasm-call 1))
              (= mode 2) (primitive/cast i64 (nt/Mt.call 1))
              (= mode 3) (primitive/cast i64 (nt/wasm-call-Mt-call 1))
              (= mode 4) (primitive/cast i64 (mt/wasm-call 0))
              (= mode 5) (primitive/cast i64 (nt/Mt.call 0))
              (= mode 6) (primitive/cast i64 (nt/wasm-call-Mt-call 0))
              (= mode 7) (primitive/cast i64 (mt/wasm-call 20))
              (= mode 8) (primitive/cast i64 (nt/Mt.call 20))
              (= mode 9) (primitive/cast i64 (nt/wasm-call 7))
              (= mode 10) (primitive/cast i64 (nt/wasm-call-Mt-call 20))
              (= mode 11) (primitive/cast i64 (nt/wasm-call 4))
              (= mode 12) (primitive/cast i64 (mt/wasm-call 0))
              (= mode 13) (primitive/cast i64 (nt/Mt.call 0))
              (= mode 14) (primitive/cast i64 (nt/wasm-call-Mt-call 0))
              (= mode 15) (primitive/cast i64 (ot/wasm-call 0))
              (= mode 16) (primitive/cast i64 (ot/wasm-call 20))
              (or (= mode 17) (or (= mode 18) (= mode 19)))
                (primitive/cast i64 (mt/wasm-call 7))
              :else 2))))
