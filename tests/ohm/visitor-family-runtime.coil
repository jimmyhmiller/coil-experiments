(module tests.ohm.visitor-family-runtime)

(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "coil.primitive" :as primitive)
(import "coil.slice" :use [slice-len slice-get])
(import "coil.str" :as str)
(import "experiments.ohm.visitor-family" :as vf)

(defstruct TestNode
  [(leaf bool)
   (left i64)
   (right i64)
   (children-start i64)
   (children-count i64)
   (extra i64)])

(defstruct TestTree
  [(nodes (al/ArrayList TestNode))
   (children (al/ArrayList i64))
   (forced-tag (slice u8))
   (force-tag bool)
   (custom-node i64)
   (allocator (dyn alloc/Allocator))])

(defn new-test-tree [] (-> TestTree)
  (let [a (alloc/malloc-allocator)
        (mut tree) (primitive/zeroed TestTree)]
    (set! (.nodes tree) (al/al-new [TestNode] a))
    (set! (.children tree) (al/al-new [i64] a))
    (set! (.forced-tag tree) "")
    (set! (.force-tag tree) false)
    (set! (.custom-node tree) -1)
    (set! (.allocator tree) a)
    (load tree)))

(defn test-add-node! [(tree (mut TestTree))
                      (leaf bool)
                      (left i64)
                      (right i64)
                      (extra i64)] (-> i64)
  (let [(mut node) (primitive/zeroed TestNode)
        index (len (.nodes tree))]
    (set! (.leaf node) leaf)
    (set! (.left node) left)
    (set! (.right node) right)
    (set! (.children-start node) (len (.children tree)))
    (set! (.children-count node) 0)
    (set! (.extra node) extra)
    (push! (mut (.nodes tree)) (load node))
    index))

(defn test-add-children! [(tree (mut TestTree))
                          (node-index i64)
                          (children (slice i64))] (-> i64)
  (let [node (get (.nodes tree) node-index)
        (mut updated) (primitive/zeroed TestNode)]
    (set! (.leaf updated) (.leaf node))
    (set! (.left updated) (.left node))
    (set! (.right updated) (.right node))
    (set! (.children-start updated) (len (.children tree)))
    (set! (.children-count updated) (slice-len children))
    (set! (.extra updated) (.extra node))
    (for child
      (iter children)
      (push! (mut (.children tree)) child))
    (set! (mut (.nodes tree)) node-index (load updated))
    node-index))

(impl vf/OhmVisitorTree TestTree
  (visitor-tag [(self (ptr TestTree)) (node i64)] (-> (slice u8))
    (if (.force-tag self)
        (.forced-tag self)
        (if (= node (.custom-node self))
            "custom"
            (let [value (get (.nodes self) node)] (if (.leaf value) "leaf" "tree")))))
  (visitor-property-child-count [(self (ptr TestTree))
                                 (node i64)
                                 (property (slice u8))] (-> i64)
    (let [value (get (.nodes self) node)]
      (if (str/str-eq property "children") (.children-count value) 1)))
  (visitor-property-child [(self (ptr TestTree))
                           (node i64)
                           (property (slice u8))
                           (index i64)] (-> i64)
    (let [value (get (.nodes self) node)]
      (cond (str/str-eq property "l") (.left value)
            (str/str-eq property "r") (.right value)
            (str/str-eq property "extra") (.extra value)
            :else (get (.children self) (+ (.children-start value) index)))))
  (visitor-custom-argument-count [(self (ptr TestTree)) (node i64)] (-> i64)
    (let [value (get (.nodes self) node)] (.children-count value)))
  (visitor-custom-argument-child-count [(self (ptr TestTree))
                                        (node i64)
                                        (argument i64)] (-> i64) 1)
  (visitor-custom-argument-child [(self (ptr TestTree))
                                  (node i64)
                                  (argument i64)
                                  (index i64)] (-> i64)
    (let [value (get (.nodes self) node)]
      (get (.children self) (+ (.children-start value) argument)))))

;; Modes: 0 fixed binary tree, 1 array properties, 2 operation arguments.
(defstruct TestActions [(mode i64) (tree-arity i64)])

(impl vf/OhmVisitorActions TestActions
  (visitor-action-count [(self (ptr TestActions))] (-> i64)
    (if (= (.mode self) 2) 1 2))
  (visitor-action-name [(self (ptr TestActions)) (index i64)] (-> (slice u8))
    (if (= index 0) "leaf" "tree"))
  (visitor-action-arity [(self (ptr TestActions)) (index i64)] (-> i64)
    (if (= index 0) 0 (.tree-arity self)))
  (apply-visitor-action [(self (ptr TestActions))
                         (evaluation (mut vf/VisitorEvaluation))
                         (node i64)
                         (action-index i64)
                         (arguments (slice vf/VisitorArgument))] (-> i64)
    (if (= action-index 0)
        (if (= (.mode self) 2)
            (+ (vf/visitor-operation-argument-by-name evaluation "n") node)
            node)
        (let [(mut answer) 0]
          (for [argument-index 0 (slice-len arguments)]
            (let [argument (slice-get arguments argument-index)]
              (for [child-index 0 (vf/visitor-argument-child-count argument)]
                (set! answer
                      (+ (* (load answer) 10)
                         (vf/visitor-evaluate-argument! (mut evaluation)
                                                        argument
                                                        child-index))))))
          (load answer)))))

(defstruct ConfigActions [(kind i64)])

(impl vf/OhmVisitorActions ConfigActions
  (visitor-action-count [(self (ptr ConfigActions))] (-> i64)
    (if (= (.kind self) 1) 2 1))
  (visitor-action-name [(self (ptr ConfigActions)) (index i64)] (-> (slice u8))
    (cond (= (.kind self) 2) "z"
          (= (.kind self) 3) "toString"
          (= index 0) "x"
          :else "y"))
  (visitor-action-arity [(self (ptr ConfigActions)) (index i64)] (-> i64)
    (cond (= (.kind self) 0) 0
          (= (.kind self) 1) (if (= index 0) 1 0)
          :else 0))
  (apply-visitor-action [(self (ptr ConfigActions))
                         (evaluation (mut vf/VisitorEvaluation))
                         (node i64)
                         (action-index i64)
                         (arguments (slice vf/VisitorArgument))] (-> i64)
    0))

(defstruct EmptyActions [])
(impl vf/OhmVisitorActions EmptyActions
  (visitor-action-count [(self (ptr EmptyActions))] (-> i64) 0)
  (visitor-action-name [(self (ptr EmptyActions)) (index i64)] (-> (slice u8)) "")
  (visitor-action-arity [(self (ptr EmptyActions)) (index i64)] (-> i64) 0)
  (apply-visitor-action [(self (ptr EmptyActions))
                         (evaluation (mut vf/VisitorEvaluation))
                         (node i64)
                         (action-index i64)
                         (arguments (slice vf/VisitorArgument))] (-> i64) 0))

(defstruct CustomActions [])
(impl vf/OhmVisitorActions CustomActions
  (visitor-action-count [(self (ptr CustomActions))] (-> i64) 3)
  (visitor-action-name [(self (ptr CustomActions)) (index i64)] (-> (slice u8))
    (cond (= index 0) "leaf" (= index 1) "tree" :else "custom"))
  (visitor-action-arity [(self (ptr CustomActions)) (index i64)] (-> i64)
    (if (= index 2) 99 (if (= index 0) 0 2)))
  (apply-visitor-action [(self (ptr CustomActions))
                         (evaluation (mut vf/VisitorEvaluation))
                         (node i64)
                         (action-index i64)
                         (arguments (slice vf/VisitorArgument))] (-> i64)
    (if (= action-index 0)
        node
        (let [(mut value) 0]
          (for [index 0 (slice-len arguments)]
            (set! value
                  (+ (* (load value) 10)
                     (vf/visitor-evaluate-argument! (mut evaluation)
                                                    (slice-get arguments index)
                                                    0))))
          (load value)))))

(defn free-test-tree! [(tree (mut TestTree))] (-> i64)
  (al/al-free! (mut (.nodes tree)))
  (al/al-free! (mut (.children tree)))
  0)

(defn basic-value [] (-> i64)
  (let [(mut tree) (new-test-tree)
        _ (test-add-node! (mut tree) true -1 -1 -1)
        one (test-add-node! (mut tree) true -1 -1 -1)
        two (test-add-node! (mut tree) true -1 -1 -1)
        three (test-add-node! (mut tree) true -1 -1 -1)
        right (test-add-node! (mut tree) false two three -1)
        root (test-add-node! (mut tree) false one right -1)
        (mut family) (vf/new-visitor-family (alloc/malloc-allocator))
        _ (vf/visitor-family-add-fixed-shape! (mut family) "leaf")
        tree-shape (vf/visitor-family-add-fixed-shape! (mut family) "tree")
        _ (vf/visitor-family-add-property! (mut family) tree-shape "l" false)
        _ (vf/visitor-family-add-property! (mut family) tree-shape "r" false)
        actions (primitive/alloc-stack TestActions)
        _ (store! (field actions mode) 0)
        _ (store! (field actions tree-arity) 2)
        validation (vf/visitor-family-add-operation! (mut family) "visit()" actions)
        (mut no-args) (al/al-new [i64] (alloc/malloc-allocator))
        tree-provider (primitive/alloc-stack TestTree)
        _ (store! tree-provider (load tree))
        (mut adapter) (vf/visitor-family-wrap (mut family) tree-provider root)
        value (vf/visitor-adapter-apply (mut adapter)
                                        "visit"
                                        (al/al-slice [i64] (load no-args)))
        valid (vf/visitor-validation-valid? validation)]
    (al/al-free! (mut no-args))
    (vf/free-visitor-family! (mut family))
    (free-test-tree! (mut tree))
    (if valid value -1)))

(defn basic-test [] (-> bool) (= (basic-value) 33))

(defn array-value [(with-extra bool)] (-> i64)
  (let [(mut tree) (new-test-tree)
        _ (test-add-node! (mut tree) true -1 -1 -1)
        a (test-add-node! (mut tree) true -1 -1 -1)
        b (test-add-node! (mut tree) true -1 -1 -1)
        c (test-add-node! (mut tree) true -1 -1 -1)
        d (test-add-node! (mut tree) true -1 -1 -1)
        e (test-add-node! (mut tree) true -1 -1 -1)
        inner (test-add-node! (mut tree) false -1 -1 (if with-extra d -1))
        (mut inner-children) (al/al-new [i64] (alloc/malloc-allocator))
        _ (push! (mut inner-children) b)
        _ (push! (mut inner-children) c)
        _ (test-add-children! (mut tree)
                              inner
                              (al/al-slice [i64] (load inner-children)))
        root (test-add-node! (mut tree) false -1 -1 (if with-extra e -1))
        (mut root-children) (al/al-new [i64] (alloc/malloc-allocator))
        _ (push! (mut root-children) a)
        _ (push! (mut root-children) inner)
        _ (if with-extra 0 (push! (mut root-children) d))
        _ (test-add-children! (mut tree) root (al/al-slice [i64] (load root-children)))
        (mut family) (vf/new-visitor-family (alloc/malloc-allocator))
        _ (vf/visitor-family-add-fixed-shape! (mut family) "leaf")
        tree-shape (vf/visitor-family-add-fixed-shape! (mut family) "tree")
        _ (vf/visitor-family-add-property! (mut family) tree-shape "children" true)
        _ (if with-extra
              (vf/visitor-family-add-property! (mut family) tree-shape "extra" false)
              0)
        actions (primitive/alloc-stack TestActions)
        _ (store! (field actions mode) 1)
        _ (store! (field actions tree-arity) (if with-extra 2 1))
        validation (vf/visitor-family-add-operation! (mut family) "visit()" actions)
        (mut no-args) (al/al-new [i64] (alloc/malloc-allocator))
        tree-provider (primitive/alloc-stack TestTree)
        _ (store! tree-provider (load tree))
        value (vf/visitor-evaluate (mut family)
                                   tree-provider
                                   "visit"
                                   root
                                   (al/al-slice [i64] (load no-args)))
        valid (vf/visitor-validation-valid? validation)]
    (al/al-free! (mut root-children))
    (al/al-free! (mut inner-children))
    (al/al-free! (mut no-args))
    (vf/free-visitor-family! (mut family))
    (free-test-tree! (mut tree))
    (if valid value -1)))

(defn array-test [(with-extra bool)] (-> bool)
  (= (array-value with-extra) (if with-extra 2445 334)))

(defn validation-test [] (-> bool)
  (let [(mut family) (vf/new-visitor-family (alloc/malloc-allocator))
        x (vf/visitor-family-add-fixed-shape! (mut family) "x")
        _ (vf/visitor-family-add-property! (mut family) x "a" false)
        y (vf/visitor-family-add-fixed-shape! (mut family) "y")
        _ (vf/visitor-family-add-property! (mut family) y "a" false)
        _ (vf/visitor-family-add-property! (mut family) y "b" false)
        wrong-x (primitive/alloc-stack ConfigActions)
        _ (store! (field wrong-x kind) 0)
        vx (vf/visitor-family-add-operation! (mut family) "foo()" wrong-x)
        mx (vf/visitor-validation-message! vx wrong-x "foo()" (alloc/malloc-allocator))
        wrong-y (primitive/alloc-stack ConfigActions)
        _ (store! (field wrong-y kind) 1)
        vy (vf/visitor-family-add-operation! (mut family) "foo()" wrong-y)
        my (vf/visitor-validation-message! vy wrong-y "foo()" (alloc/malloc-allocator))
        unknown (primitive/alloc-stack ConfigActions)
        _ (store! (field unknown kind) 2)
        vz (vf/visitor-family-add-operation! (mut family) "foo()" unknown)
        mz (vf/visitor-validation-message! vz unknown "foo()" (alloc/malloc-allocator))
        inherited-name (primitive/alloc-stack ConfigActions)
        _ (store! (field inherited-name kind) 3)
        vt (vf/visitor-family-add-operation! (mut family) "foo()" inherited-name)
        mt (vf/visitor-validation-message! vt
                                           inherited-name
                                           "foo()"
                                           (alloc/malloc-allocator))
        valid
          (and (str/str-eq mx "Action 'x' has the wrong arity: expected 1, got 0")
               (and (str/str-eq my "Action 'y' has the wrong arity: expected 2, got 0")
                    (and (str/str-eq mz "Unrecognized action name 'z'")
                         (str/str-eq mt "Unrecognized action name 'toString'"))))]
    (alloc/free [u8] (alloc/malloc-allocator) mx)
    (alloc/free [u8] (alloc/malloc-allocator) my)
    (alloc/free [u8] (alloc/malloc-allocator) mz)
    (alloc/free [u8] (alloc/malloc-allocator) mt)
    (vf/free-visitor-family! (mut family))
    valid))

(defn unrecognized-tag-test [(tag (slice u8))] (-> bool)
  (let [(mut tree) (new-test-tree)
        _ (set! (.force-tag tree) true)
        _ (set! (.forced-tag tree) tag)
        (mut family) (vf/new-visitor-family (alloc/malloc-allocator))
        actions (primitive/alloc-stack EmptyActions)
        _ (store! actions (primitive/zeroed EmptyActions))
        validation (vf/visitor-family-add-operation! (mut family) "foo()" actions)
        (mut no-args) (al/al-new [i64] (alloc/malloc-allocator))
        operation (vf/visitor-validation-operation-index validation)
        tree-provider (primitive/alloc-stack TestTree)
        _ (store! tree-provider (load tree))
        (mut evaluation)
          (vf/visitor-new-evaluation (mut family)
                                     tree-provider
                                     operation
                                     (al/al-slice [i64] (load no-args)))
        _ (vf/visitor-evaluate-node! (mut evaluation) 0)
        message (vf/visitor-evaluation-error-message! (mut evaluation))
        (mut expected) (str/sb-new (alloc/malloc-allocator))
        _ (str/sb-push-str! (mut expected) "getTag returned unrecognized tag '")
        _ (str/sb-push-str! (mut expected) tag)
        _ (str/sb-push-str! (mut expected) "'")
        expected-text (str/sb-finish! (mut expected))
        valid (and (vf/visitor-evaluation-failed? (mut evaluation))
                   (str/str-eq message expected-text))]
    (alloc/free [u8] (alloc/malloc-allocator) message)
    (alloc/free [u8] (alloc/malloc-allocator) expected-text)
    (al/al-free! (mut no-args))
    (vf/free-visitor-evaluation! (mut evaluation))
    (vf/free-visitor-family! (mut family))
    (free-test-tree! (mut tree))
    valid))

(defn operation-arguments-value [] (-> i64)
  (let [(mut tree) (new-test-tree)
        _ (test-add-node! (mut tree) true -1 -1 -1)
        root (test-add-node! (mut tree) true -1 -1 -1)
        (mut family) (vf/new-visitor-family (alloc/malloc-allocator))
        _ (vf/visitor-family-add-fixed-shape! (mut family) "leaf")
        actions (primitive/alloc-stack TestActions)
        _ (store! (field actions mode) 2)
        _ (store! (field actions tree-arity) 0)
        validation (vf/visitor-family-add-operation! (mut family) "greet(n)" actions)
        (mut arguments) (al/al-new [i64] (alloc/malloc-allocator))
        _ (push! (mut arguments) 100)
        tree-provider (primitive/alloc-stack TestTree)
        _ (store! tree-provider (load tree))
        value (vf/visitor-evaluate (mut family)
                                   tree-provider
                                   "greet"
                                   root
                                   (al/al-slice [i64] (load arguments)))
        valid
          (and (vf/visitor-validation-valid? validation)
               (= (vf/visitor-family-operation-formal-count (mut family) 0) 1))]
    (al/al-free! (mut arguments))
    (vf/free-visitor-family! (mut family))
    (free-test-tree! (mut tree))
    (if valid value -1)))

(defn operation-arguments-test [] (-> bool)
  (= (operation-arguments-value) 101))

(defn custom-shape-test [] (-> bool)
  (let [(mut tree) (new-test-tree)
        _ (test-add-node! (mut tree) true -1 -1 -1)
        a (test-add-node! (mut tree) true -1 -1 -1)
        b (test-add-node! (mut tree) true -1 -1 -1)
        root (test-add-node! (mut tree) false -1 -1 -1)
        (mut children) (al/al-new [i64] (alloc/malloc-allocator))
        _ (push! (mut children) a)
        _ (push! (mut children) b)
        _ (test-add-children! (mut tree) root (al/al-slice [i64] (load children)))
        _ (set! (.custom-node tree) root)
        (mut family) (vf/new-visitor-family (alloc/malloc-allocator))
        _ (vf/visitor-family-add-fixed-shape! (mut family) "leaf")
        tree-shape (vf/visitor-family-add-fixed-shape! (mut family) "tree")
        _ (vf/visitor-family-add-property! (mut family) tree-shape "l" false)
        _ (vf/visitor-family-add-property! (mut family) tree-shape "r" false)
        _ (vf/visitor-family-add-custom-shape! (mut family) "custom")
        actions (primitive/alloc-stack CustomActions)
        _ (store! actions (primitive/zeroed CustomActions))
        validation (vf/visitor-family-add-operation! (mut family) "visit()" actions)
        (mut no-args) (al/al-new [i64] (alloc/malloc-allocator))
        tree-provider (primitive/alloc-stack TestTree)
        _ (store! tree-provider (load tree))
        value (vf/visitor-evaluate (mut family)
                                   tree-provider
                                   "visit"
                                   root
                                   (al/al-slice [i64] (load no-args)))
        valid (and (vf/visitor-validation-valid? validation) (= value 12))]
    (al/al-free! (mut no-args))
    (al/al-free! (mut children))
    (vf/free-visitor-family! (mut family))
    (free-test-tree! (mut tree))
    valid))

(defn missing-action-test [] (-> bool)
  (let [(mut tree) (new-test-tree)
        _ (test-add-node! (mut tree) true -1 -1 -1)
        root (test-add-node! (mut tree) true -1 -1 -1)
        (mut family) (vf/new-visitor-family (alloc/malloc-allocator))
        _ (vf/visitor-family-add-fixed-shape! (mut family) "leaf")
        actions (primitive/alloc-stack EmptyActions)
        _ (store! actions (primitive/zeroed EmptyActions))
        validation (vf/visitor-family-add-operation! (mut family) "visit()" actions)
        (mut no-args) (al/al-new [i64] (alloc/malloc-allocator))
        tree-provider (primitive/alloc-stack TestTree)
        _ (store! tree-provider (load tree))
        operation (vf/visitor-validation-operation-index validation)
        (mut evaluation)
          (vf/visitor-new-evaluation (mut family)
                                     tree-provider
                                     operation
                                     (al/al-slice [i64] (load no-args)))
        _ (vf/visitor-evaluate-node! (mut evaluation) root)
        message (vf/visitor-evaluation-error-message! (mut evaluation))
        valid
          (str/str-eq message "No action for 'leaf' in operation 'visit'")]
    (alloc/free [u8] (alloc/malloc-allocator) message)
    (al/al-free! (mut no-args))
    (vf/free-visitor-evaluation! (mut evaluation))
    (vf/free-visitor-family! (mut family))
    (free-test-tree! (mut tree))
    valid))

(defn main [] (-> i64)
  (cond (not (basic-test)) 1
        (not (array-test false)) 2
        (not (array-test true)) 3
        (not (validation-test)) 4
        (not (unrecognized-tag-test "bad")) 5
        (not (unrecognized-tag-test "toString")) 6
        (not (operation-arguments-test)) 7
        (not (custom-shape-test)) 8
        (not (missing-action-test)) 9
        :else 0))
