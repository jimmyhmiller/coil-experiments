(module tests.ohm.lazy-semantic-dyn-repro)

(import "coil.primitive" :as primitive)

(deftrait LazyAction [Self]
  (apply-lazy [(self (ptr Self)) (context (mut LazyContext)) (value i64)] (-> i64)))

(defstruct LazyContext [(action (dyn LazyAction))])

(defn recurse [(context (mut LazyContext)) (value i64)] (-> i64)
  (if (= value 0)
      1
      (+ value (apply-lazy (.action context) (mut context) (- value 1)))))

(defstruct SumAction [])

(impl LazyAction SumAction
  (apply-lazy [(self (ptr SumAction)) (context (mut LazyContext)) (value i64)] (-> i64)
    (recurse (mut context) value)))

(defn main [] (-> i64)
  (let [action (primitive/alloc-stack SumAction)
        (mut context) (primitive/zeroed LazyContext)]
    (set! (.action context) action)
    (if (= (recurse (mut context) 3) 7) 0 1)))
