(module tests.ohm.extract-examples-runtime)

(import "coil.alloc" :as alloc)
(import "coil.str" :as str)
(import "experiments.ohm.extract-examples" :as examples)

(defn example-eq? [(items (ptr examples/OhmExamples))
                   (index i64)
                   (grammar (slice u8))
                   (rule (slice u8))
                   (text (slice u8))
                   (should-match bool)] (-> bool)
  (and (str/str-eq (examples/ohm-example-grammar items index) grammar)
       (and (str/str-eq (examples/ohm-example-rule items index) rule)
            (and (str/str-eq (examples/ohm-example-text items index) text)
                 (= (examples/ohm-example-should-match? items index)
                    should-match)))))

(defn main [] (-> i64)
  (let [(mut empty)
          (examples/extract-ohm-examples "" (alloc/malloc-allocator))
        (mut no-examples)
          (examples/extract-ohm-examples "G { }" (alloc/malloc-allocator))
        (mut simple)
          (examples/extract-ohm-examples
            "G {\n  //+ \"x\"\n  start = \"x\"\n}"
            (alloc/malloc-allocator))
        (mut multiple)
          (examples/extract-ohm-examples
            "G {\n //+ \"\"\n start = \"\"\n //+ \"x\"\n other = \"\"\n}"
            (alloc/malloc-allocator))
        (mut default-rule)
          (examples/extract-ohm-examples
            "//+ \"ignored\"\nG {\n //+ \"\"\n start = \"\"\n //+ \"hey\"\n}"
            (alloc/malloc-allocator))
        (mut whitespace)
          (examples/extract-ohm-examples
            "G{  //+ \"\" \n}"
            (alloc/malloc-allocator))
        (mut signs)
          (examples/extract-ohm-examples
            "G {\n //+ \"blah\"\n //- \"wooo\"\n // - \"ignored\"\n start = \"\"\n}"
            (alloc/malloc-allocator))
        (mut corner)
          (examples/extract-ohm-examples
            "G {\n //+ \"\", \"\"\n //- \"\"\n\n start = \"\"\n}"
            (alloc/malloc-allocator))
        (mut unicode)
          (examples/extract-ohm-examples
            "G {\n //+ \"\\u0078\", \"\\uD83D\\uDE00\"\n start = any*\n}"
            (alloc/malloc-allocator))
        unicode-valid
          (and (= (examples/ohm-example-count (mut unicode)) 2)
               (and (example-eq? (mut unicode) 0 "G" "start" "x" true)
                    (example-eq? (mut unicode) 1 "G" "start" "😀" true)))
        valid
          (and unicode-valid
               (and (= (examples/ohm-example-count (mut empty)) 0)
                    (and (= (examples/ohm-example-count (mut no-examples)) 0)
                         (and (and (= (examples/ohm-example-count (mut simple)) 1)
                                   (example-eq? (mut simple) 0 "G" "start" "x" true))
                              (and (and (= (examples/ohm-example-count (mut multiple)) 2)
                                        (and (example-eq? (mut multiple) 0 "G" "start" "" true)
                                             (example-eq? (mut multiple) 1 "G" "other" "x" true)))
                                   (and (and (= (examples/ohm-example-count (mut default-rule)) 2)
                                             (and (example-eq? (mut default-rule) 0 "G" "start" "" true)
                                                  (example-eq? (mut default-rule) 1 "G" "" "hey" true)))
                                        (and (and (= (examples/ohm-example-count (mut whitespace)) 1)
                                                  (example-eq? (mut whitespace) 0 "G" "" "" true))
                                             (and (and (= (examples/ohm-example-count (mut signs)) 2)
                                                       (and (example-eq? (mut signs) 0 "G" "start" "blah" true)
                                                            (example-eq? (mut signs) 1 "G" "start" "wooo" false)))
                                                  (and (= (examples/ohm-example-count (mut corner)) 3)
                                                       (and (example-eq? (mut corner) 0 "G" "start" "" true)
                                                            (and (example-eq? (mut corner) 1 "G" "start" "" true)
                                                                 (example-eq? (mut corner) 2 "G" "start" "" false))))))))))))]
    (examples/free-ohm-examples! (mut empty))
    (examples/free-ohm-examples! (mut no-examples))
    (examples/free-ohm-examples! (mut simple))
    (examples/free-ohm-examples! (mut multiple))
    (examples/free-ohm-examples! (mut default-rule))
    (examples/free-ohm-examples! (mut whitespace))
    (examples/free-ohm-examples! (mut signs))
    (examples/free-ohm-examples! (mut corner))
    (examples/free-ohm-examples! (mut unicode))
    (if valid 0 1)))
