(module tests.ohm.generic-builder-semantic-runtime)

(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "coil.primitive" :as primitive)
(import "coil.slice" :use [slice-get])
(import "coil.str" :as str)
(import "experiments.ohm.generic-semantics" :as generic)
(import "experiments.ohm.runtime" :as ohm)

(build-ohm-grammar
  (grammars
    (grammar PairGrammar
      (withDefaultStartRule pair)
      (define pair [] (seq (app digit) (app digit))))))

(defstruct PairValue [(left i64) (right i64) (total i64) (kind (slice u8))])

(defn pair-action-kind [(context (ptr u8))
                        (result (ptr ohm/MatchResult))
                        (node i64)] (-> i64)
  (let [name (ohm/node-rule (load result) node)]
    (if (or (str/str-eq name "pair") (str/str-eq name "digit")) 1 0)))

(defn apply-pair-action
  [(context (ptr u8))
   (evaluation (mut (generic/OhmGenericSemanticEvaluation PairValue)))
   (node i64)
   (kind i64)
   (arguments (slice i64))] (-> PairValue)
  (let [(mut value) (primitive/zeroed PairValue)
        result (.result evaluation)
        name (ohm/node-rule (load result) node)]
    (if (str/str-eq name "digit")
        (let [number (- (primitive/cast i64
                          (slice-get (ohm/node-source-string (load result) node) 0))
                        48)]
          (set! (.left value) number)
          (set! (.right value) number)
          (set! (.total value) number)
          (set! (.kind value) "digit"))
        (let [left (generic/evaluate-generic-semantic-child!
                     [PairValue] (mut evaluation) node 0 arguments)
              right (generic/evaluate-generic-semantic-child!
                      [PairValue] (mut evaluation) node 1 arguments)]
          (set! (.left value) (.total left))
          (set! (.right value) (.total right))
          (set! (.total value) (+ (.total left) (.total right)))
          (set! (.kind value) "pair")))
    (load value)))

(defn main [] (-> i64)
  (let [(mut match) (parse-tree "47")
        (mut arguments) (al/al-new [i64] (alloc/malloc-allocator))
        (mut evaluation)
          (generic/new-generic-semantic-evaluation
            [PairValue]
            (primitive/cast (ptr u8) 0)
            (primitive/fnptr-of pair-action-kind)
            (primitive/fnptr-of apply-pair-action)
            (mut match)
            "PairGrammar"
            (ohm/match-grammar-token (load match))
            0
            true)
        value (generic/evaluate-generic-semantic-root!
                [PairValue]
                (mut evaluation)
                (al/al-slice [i64] (load arguments)))
        again (generic/evaluate-generic-semantic-root!
                [PairValue]
                (mut evaluation)
                (al/al-slice [i64] (load arguments)))
        valid (and (ohm/match-succeeded? (load match))
                   (and (not (generic/generic-semantic-evaluation-failed?
                               [PairValue] (mut evaluation)))
                        (and (= (.left value) 4)
                             (and (= (.right value) 7)
                                  (and (= (.total value) 11)
                                       (and (str/str-eq (.kind value) "pair")
                                            (= (.total again) 11)))))))]
    (generic/free-generic-semantic-evaluation! [PairValue] (mut evaluation))
    (al/al-free! (mut arguments))
    (ohm/free-match! (mut match))
    (if valid 0 1)))
