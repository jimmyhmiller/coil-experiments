    (set! valid
          (and (load valid)
               (and (unicode/unicode-property? 41 "Pe")
                    (not (unicode/unicode-property? 0 "Pe")))))
    (set! valid
          (and (load valid)
               (and (unicode/unicode-property? 187 "Pf")
                    (not (unicode/unicode-property? 0 "Pf")))))
    (set! valid
          (and (load valid)
               (and (unicode/unicode-property? 171 "Pi")
                    (not (unicode/unicode-property? 0 "Pi")))))
    (set! valid
          (and (load valid)
               (and (unicode/unicode-property? 33 "Po")
                    (not (unicode/unicode-property? 0 "Po")))))
    (set! valid
