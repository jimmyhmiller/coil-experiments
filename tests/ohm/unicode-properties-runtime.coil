               (and (unicode/unicode-property? 2307 "Mc")
                    (not (unicode/unicode-property? 0 "Mc")))))
    (set! valid
          (and (load valid)
               (and (unicode/unicode-property? 1160 "Me")
                    (not (unicode/unicode-property? 0 "Me")))))
    (set! valid
          (and (load valid)
               (and (unicode/unicode-property? 768 "Mn")
                    (not (unicode/unicode-property? 0 "Mn")))))
    (set! valid
          (and (load valid)
               (and (unicode/unicode-property? 48 "Nd")
                    (not (unicode/unicode-property? 0 "Nd")))))
    (set! valid
          (and (load valid)
               (and (unicode/unicode-property? 5870 "Nl")
                    (not (unicode/unicode-property? 0 "Nl")))))
    (set! valid
          (and (load valid)
               (and (unicode/unicode-property? 178 "No")
