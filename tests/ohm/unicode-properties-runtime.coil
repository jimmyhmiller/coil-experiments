    (set! valid
          (and (load valid)
               (and (unicode/unicode-property? 8232 "Zl")
                    (not (unicode/unicode-property? 0 "Zl")))))
    (set! valid
          (and (load valid)
               (and (unicode/unicode-property? 8233 "Zp")
