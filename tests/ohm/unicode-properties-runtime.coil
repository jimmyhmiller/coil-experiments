(module tests.ohm.unicode-properties-runtime)

(import "coil.str" :as str)
(import "experiments.ohm.unicode" :as unicode)

(defn main [] (-> i64)
  (let [(mut valid) (str/str-eq unicode/UNICODE-VERSION "17.0")]
    (set! valid
          (and (load valid)
               (and (unicode/unicode-property? 0 "Cc")
                    (not (unicode/unicode-property? 32 "Cc")))))
    (set! valid
          (and (load valid)
               (and (unicode/unicode-property? 173 "Cf")
                    (not (unicode/unicode-property? 0 "Cf")))))
    (set! valid
          (and (load valid)
               (and (unicode/unicode-property? 888 "Cn")
                    (not (unicode/unicode-property? 0 "Cn")))))
    (set! valid
          (and (load valid)
               (and (unicode/unicode-property? 57344 "Co")
                    (not (unicode/unicode-property? 0 "Co")))))
    (set! valid
          (and (load valid)
               (and (unicode/unicode-property? 55296 "Cs")
                    (not (unicode/unicode-property? 0 "Cs")))))
    (set! valid
          (and (load valid)
               (and (unicode/unicode-property? 97 "Ll")
                    (not (unicode/unicode-property? 0 "Ll")))))
    (set! valid
          (and (load valid)
               (and (unicode/unicode-property? 688 "Lm")
                    (not (unicode/unicode-property? 0 "Lm")))))
    (set! valid
          (and (load valid)
