(module tests.ohm.grammar-extend-semantics-error)

(import "coil.alloc" :as alloc)
(import "coil.primitive" :as primitive)
(import "coil.primitive" :use [fnptr-of])
(import "experiments.ohm.runtime" :as ohm)

(defn dummy-parse [(input (slice u8)) (rule (slice u8))]
                  (-> ohm/MatchResult)
  (primitive/zeroed ohm/MatchResult))

(defn dummy-cached-parse [(input (slice u8))
                         (rule (slice u8))
                         (trace bool)
                         (cache (mut ohm/ParseCache))]
                        (-> ohm/MatchResult)
  (primitive/zeroed ohm/MatchResult))

(defn token-g [] (-> (ptr u8)) (primitive/cast (ptr u8) (fnptr-of token-g)))
(defn token-g2 [] (-> (ptr u8)) (primitive/cast (ptr u8) (fnptr-of token-g2)))

(defn make-grammar [(name (slice u8)) (fingerprint (slice u8)) (token (ptr u8))]
                   (-> ohm/OhmGrammar)
  (ohm/new-ohm-grammar
    (ohm/new-ohm-grammar-descriptor name "" "" fingerprint)
    (ohm/new-ohm-pexpr-grammar "" (alloc/malloc-allocator))
    (fnptr-of dummy-parse) (fnptr-of dummy-cached-parse)
    "" "" "" token false (alloc/malloc-allocator)))

(defn main [] (-> i64)
  (let [(mut g) (make-grammar "G" "g-fingerprint" (token-g))
        (mut g2) (make-grammar "G2" "g2-fingerprint" (token-g2))
        (mut semantics) (ohm/ohm-grammar-create-semantics (mut g))]
    (ohm/ohm-grammar-extend-semantics (mut g2) (mut semantics))
    1))
