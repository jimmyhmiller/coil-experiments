(module tests.ohm.interval-dump-runtime)

(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "coil.io" :as io)
(import "experiments.ohm.runtime" :as ohm)

(defn emit-field [(text (slice u8))] (-> i64)
  (io/print-str (io/stdout) text)
  (io/print-str (io/stdout) "|")
  0)

(defn emit-interval [(label (slice u8)) (interval ohm/OhmInterval)] (-> i64)
  (emit-field label)
  (io/print-int (io/stdout) (ohm/ohm-interval-start interval))
  (io/print-str (io/stdout) "|")
  (io/print-int (io/stdout) (ohm/ohm-interval-end interval))
  (io/print-str (io/stdout) "|")
  (emit-field (ohm/ohm-interval-source interval))
  (io/write-line (io/stdout) (ohm/ohm-interval-contents interval))
  0)

(defn emit-optional-text [(value (Option (slice u8)))] (-> i64)
  (match value
    (Some [text] (do (io/print-str (io/stdout) "some:") (emit-field text)))
    (None [] (emit-field "none"))))

(defn emit-line [(label (slice u8))
                 (source (slice u8))
                 (offset i64)] (-> i64)
  (let [info (ohm/ohm-interval-line-column
               (ohm/new-ohm-interval source offset offset))]
    (emit-field label)
    (io/print-int (io/stdout) (ohm/line-column-offset info))
    (io/print-str (io/stdout) "|")
    (io/print-int (io/stdout) (ohm/line-column-line info))
    (io/print-str (io/stdout) "|")
    (io/print-int (io/stdout) (ohm/line-column-column info))
    (io/print-str (io/stdout) "|")
    (emit-field (ohm/line-column-line-text source info))
    (emit-optional-text (ohm/line-column-previous-line source info))
    (emit-optional-text (ohm/line-column-next-line source info))
    (io/write-line (io/stdout) "")
    0))

(defn main [] (-> i64)
  (let [source "hello world"
        interval (ohm/new-ohm-interval source 0 5)
        first (ohm/new-ohm-interval source 2 5)
        second (ohm/new-ohm-interval source 0 2)
        (mut adjacent) (al/al-new [ohm/OhmInterval] (alloc/malloc-allocator))
        _ (push! (mut adjacent) first)
        _ (push! (mut adjacent) second)
        (mut more) (al/al-new [ohm/OhmInterval] (alloc/malloc-allocator))
        _ (push! (mut more) (ohm/new-ohm-interval source 0 2))
        _ (push! (mut more) (ohm/new-ohm-interval source 3 4))
        _ (push! (mut more) (ohm/new-ohm-interval source 6 10))]
    (emit-interval "original" interval)
    (emit-interval "left" (ohm/ohm-interval-collapsed-left interval))
    (emit-interval "right" (ohm/ohm-interval-collapsed-right interval))
    (emit-interval "adjacent"
                   (ohm/ohm-interval-coverage
                     (al/al-slice [ohm/OhmInterval] (load adjacent))))
    (emit-interval "more"
                   (ohm/ohm-interval-coverage
                     (al/al-slice [ohm/OhmInterval] (load more))))
    (emit-interval "coverageWith"
                   (ohm/ohm-interval-coverage-with
                     (ohm/new-ohm-interval source 0 2)
                     (al/al-slice [ohm/OhmInterval] (load more))))
    (emit-interval "trimmed"
                   (ohm/ohm-interval-trimmed
                     (ohm/new-ohm-interval "xx \t hello \n yy" 2 13)))
    (emit-interval "sub"
                   (ohm/ohm-interval-sub-interval
                     (ohm/new-ohm-interval "0123456789" 2 8) 2 3))
    (emit-line "ordinary" "blah\n3 + 4" 5)
    (emit-line "empty-next" "line\n" 0)
    (emit-line "standalone-cr" "a\rb" 2)
    (emit-line "crlf" "a\r\nb" 3)
    (emit-line "utf16" "😀\nx" 3)
    (al/al-free! (mut adjacent))
    (al/al-free! (mut more))
    0))
