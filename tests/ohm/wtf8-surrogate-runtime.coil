(module tests.ohm.wtf8-surrogate-runtime)

(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "coil.primitive" :as primitive)
(import "experiments.ohm.runtime" :as ohm)

(defn main [] (-> i64)
  (let [(mut bytes) (al/al-new [u8] (alloc/malloc-allocator))]
    ;; WTF-8 encoding of the lone high surrogate U+D800. Coil's byte-string
    ;; API uses this lossless representation for JavaScript lone surrogates.
    (push! (mut bytes) (primitive/cast u8 237))
    (push! (mut bytes) (primitive/cast u8 160))
    (push! (mut bytes) (primitive/cast u8 128))
    (let [source (al/al-slice [u8] (load bytes))
          valid
            (and (= (ohm/match-any source 0) 3)
                 (= (ohm/match-unicode-property source 0 "Cs") 3))]
      (al/al-free! (mut bytes))
      (if valid 0 1))))
