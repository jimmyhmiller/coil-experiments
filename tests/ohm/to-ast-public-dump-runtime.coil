(module tests.ohm.to-ast-public-dump-runtime)

(import "coil.alloc" :as alloc)
(import "coil.io" :as io)
(import "coil.primitive" :as primitive)
(import "experiments.ohm.runtime" :as ohm)

(build-ohm-grammar
  (grammars
    (grammar G
      (withDefaultStartRule Start)
      (define Start [] (app AddExp))
      (define AddExp []
        (alt (app AddExp_plus) (app AddExp_minus) (app PriExp)))
      (define AddExp_plus []
        (seq (app AddExp) (terminal "+") (app PriExp)))
      (define AddExp_minus []
        (seq (app AddExp) (terminal "-") (app PriExp)))
      (define PriExp []
        (alt (app PriExp_paren) (app number)))
      (define PriExp_paren []
        (seq (terminal "(") (app Start) (terminal ")")))
      (define number [] (plus (app digit)))
      (define Mix []
        (seq (opt (app a)) (star (app b)) (terminal "|")
             (opt (app a)) (star (app b))))
      (define a [] (terminal "a"))
      (define b [] (terminal "b"))
      (define LexList [] (app listOf (app digit) (terminal "+")))
      (define SynList [] (app ListOf (app digit) (terminal "+"))))))

(defn emit-ast [(label (slice u8)) (ast (mut ohm/OhmAst))] (-> i64)
  (let [signature
          (ohm/ast-public-signature! (mut ast) (alloc/malloc-allocator))]
    (io/print-str (io/stdout) label)
    (io/print-str (io/stdout) "|")
    (io/write-line (io/stdout) signature)
    (alloc/free [u8] (alloc/malloc-allocator) signature)
    0))

(defn main [] (-> i64)
  (let [(mut short) (parse-tree "10 + 20")
        (mut long) (parse-tree "10 + 20 - 30")
        (mut optional) (parse-tree-from "a|bb" "Mix")
        (mut list) (parse-tree-from "3+5" "LexList")
        (mut empty-list) (parse-tree-from "" "LexList")
        (mut syntactic-list) (parse-tree-from "3 + 5" "SynList")
        (mut syntactic-empty) (parse-tree-from "" "SynList")
        actions (primitive/alloc-stack ohm/UpstreamToAstTestActions)
        _ (store! actions (primitive/zeroed ohm/UpstreamToAstTestActions))

        (mut default-map) (ohm/new-ohm-ast-mapping (alloc/malloc-allocator))
        (mut default-ast)
          (ohm/to-ast (mut short) (mut default-map) (alloc/malloc-allocator))
        _ (emit-ast "default" (mut default-ast))

        (mut optional-map) (ohm/new-ohm-ast-mapping (alloc/malloc-allocator))
        (mut optional-ast)
          (ohm/to-ast (mut optional) (mut optional-map) (alloc/malloc-allocator))
        _ (emit-ast "optional" (mut optional-ast))

        (mut renamed-map) (ohm/new-ohm-ast-mapping (alloc/malloc-allocator))
        renamed-rule (ohm/ast-mapping-add-template! (mut renamed-map) "AddExp_plus")
        _ (ohm/ast-mapping-add-child! (mut renamed-map) renamed-rule "expr1" 0)
        _ (ohm/ast-mapping-add-child! (mut renamed-map) renamed-rule "expr2" 2)
        (mut renamed-ast)
          (ohm/to-ast (mut short) (mut renamed-map) (alloc/malloc-allocator))
        _ (emit-ast "renamed" (mut renamed-ast))

        (mut operator-map) (ohm/new-ohm-ast-mapping (alloc/malloc-allocator))
        operator-rule (ohm/ast-mapping-add-template! (mut operator-map) "AddExp_plus")
        _ (ohm/ast-mapping-add-child! (mut operator-map) operator-rule "expr1" 0)
        _ (ohm/ast-mapping-add-child! (mut operator-map) operator-rule "op" 1)
        _ (ohm/ast-mapping-add-child! (mut operator-map) operator-rule "expr2" 2)
        (mut operator-ast)
          (ohm/to-ast (mut short) (mut operator-map) (alloc/malloc-allocator))
        _ (emit-ast "operator" (mut operator-ast))

        (mut removed-map) (ohm/new-ohm-ast-mapping (alloc/malloc-allocator))
        removed-rule (ohm/ast-mapping-add-template! (mut removed-map) "AddExp_plus")
        _ (ohm/ast-mapping-add-child! (mut removed-map) removed-rule "0" 0)
        (mut removed-ast)
          (ohm/to-ast (mut short) (mut removed-map) (alloc/malloc-allocator))
        _ (emit-ast "removed" (mut removed-ast))

        (mut no-type-map) (ohm/new-ohm-ast-mapping (alloc/malloc-allocator))
        no-type-rule (ohm/ast-mapping-add-template! (mut no-type-map) "AddExp_plus")
        _ (ohm/ast-mapping-add-child! (mut no-type-map) no-type-rule "0" 0)
        _ (ohm/ast-mapping-add-omit! (mut no-type-map) no-type-rule "type")
        (mut no-type-ast)
          (ohm/to-ast (mut short) (mut no-type-map) (alloc/malloc-allocator))
        _ (emit-ast "no-type" (mut no-type-ast))

        (mut static-map) (ohm/new-ohm-ast-mapping (alloc/malloc-allocator))
        static-rule (ohm/ast-mapping-add-template! (mut static-map) "AddExp_plus")
        _ (ohm/ast-mapping-add-child! (mut static-map) static-rule "expr1" 0)
        _ (ohm/ast-mapping-add-string! (mut static-map) static-rule "op" "plus")
        _ (ohm/ast-mapping-add-child! (mut static-map) static-rule "expr2" 2)
        (mut static-ast)
          (ohm/to-ast (mut short) (mut static-map) (alloc/malloc-allocator))
        _ (emit-ast "static" (mut static-ast))

        (mut boxed-map) (ohm/new-ohm-ast-mapping (alloc/malloc-allocator))
        boxed-rule (ohm/ast-mapping-add-template! (mut boxed-map) "AddExp_plus")
        _ (ohm/ast-mapping-add-number! (mut boxed-map) boxed-rule "expr1" 0.0)
        _ (ohm/ast-mapping-add-string! (mut boxed-map) boxed-rule "op" "plus")
        _ (ohm/ast-mapping-add-number! (mut boxed-map) boxed-rule "expr2" 2.0)
        (mut boxed-ast)
          (ohm/to-ast (mut short) (mut boxed-map) (alloc/malloc-allocator))
        _ (emit-ast "boxed" (mut boxed-ast))

        (mut computed-property-map)
          (ohm/new-ohm-ast-mapping (alloc/malloc-allocator))
        computed-property-rule
          (ohm/ast-mapping-add-template! (mut computed-property-map) "AddExp_plus")
        _ (ohm/ast-mapping-add-child!
            (mut computed-property-map) computed-property-rule "expr1" 0)
        _ (ohm/ast-mapping-add-child!
            (mut computed-property-map) computed-property-rule "expr2" 2)
        _ (ohm/ast-mapping-add-property-action!
            (mut computed-property-map) computed-property-rule "str" 2)
        (mut computed-property-ast)
          (ohm/to-ast-with-actions actions
                                   (mut short)
                                   (mut computed-property-map)
                                   (alloc/malloc-allocator))
        _ (emit-ast "computed-property" (mut computed-property-ast))

        (mut forward-map) (ohm/new-ohm-ast-mapping (alloc/malloc-allocator))
        _ (ohm/ast-mapping-add-forward! (mut forward-map) "AddExp_plus" 2)
        (mut forward-ast)
          (ohm/to-ast (mut long) (mut forward-map) (alloc/malloc-allocator))
        _ (emit-ast "forward" (mut forward-ast))

        (mut action-map) (ohm/new-ohm-ast-mapping (alloc/malloc-allocator))
        _ (ohm/ast-mapping-add-action! (mut action-map) "AddExp_plus" 1)
        (mut action-ast)
          (ohm/to-ast-with-actions actions
                                   (mut long)
                                   (mut action-map)
                                   (alloc/malloc-allocator))
        _ (emit-ast "action" (mut action-ast))

        (mut reintroduced-map) (ohm/new-ohm-ast-mapping (alloc/malloc-allocator))
        reintroduced-rule
          (ohm/ast-mapping-add-template! (mut reintroduced-map) "Start")
        _ (ohm/ast-mapping-add-child! (mut reintroduced-map) reintroduced-rule "0" 0)
        (mut reintroduced-ast)
          (ohm/to-ast (mut long) (mut reintroduced-map) (alloc/malloc-allocator))
        _ (emit-ast "reintroduced" (mut reintroduced-ast))

        (mut combo-map) (ohm/new-ohm-ast-mapping (alloc/malloc-allocator))
        combo-plus (ohm/ast-mapping-add-template! (mut combo-map) "AddExp_plus")
        _ (ohm/ast-mapping-add-child! (mut combo-map) combo-plus "augend" 0)
        _ (ohm/ast-mapping-add-child! (mut combo-map) combo-plus "addend" 2)
        _ (ohm/ast-mapping-add-string!
            (mut combo-map) combo-plus "type" "AddExpression")
        combo-minus (ohm/ast-mapping-add-template! (mut combo-map) "AddExp_minus")
        _ (ohm/ast-mapping-add-child! (mut combo-map) combo-minus "minuend" 0)
        _ (ohm/ast-mapping-add-child! (mut combo-map) combo-minus "subtrahend" 2)
        _ (ohm/ast-mapping-add-string!
            (mut combo-map) combo-minus "type" "SubExpression")
        (mut combo-ast)
          (ohm/to-ast (mut long) (mut combo-map) (alloc/malloc-allocator))
        _ (emit-ast "combo" (mut combo-ast))

        (mut list-map) (ohm/new-ohm-ast-mapping (alloc/malloc-allocator))
        (mut list-ast)
          (ohm/to-ast (mut list) (mut list-map) (alloc/malloc-allocator))
        _ (emit-ast "list" (mut list-ast))
        (mut empty-list-ast)
          (ohm/to-ast (mut empty-list) (mut list-map) (alloc/malloc-allocator))
        _ (emit-ast "list-empty" (mut empty-list-ast))
        (mut syntactic-list-ast)
          (ohm/to-ast (mut syntactic-list) (mut list-map) (alloc/malloc-allocator))
        _ (emit-ast "syntactic-list" (mut syntactic-list-ast))
        (mut syntactic-empty-ast)
          (ohm/to-ast (mut syntactic-empty) (mut list-map) (alloc/malloc-allocator))
        _ (emit-ast "syntactic-empty" (mut syntactic-empty-ast))

        (mut override-map) (ohm/new-ohm-ast-mapping (alloc/malloc-allocator))
        _ (ohm/ast-mapping-add-action! (mut override-map) "nonemptyListOf" 3)
        (mut override-ast)
          (ohm/to-ast-with-actions actions
                                   (mut list)
                                   (mut override-map)
                                   (alloc/malloc-allocator))
        _ (emit-ast "list-action" (mut override-ast))

        (mut list-forward-map) (ohm/new-ohm-ast-mapping (alloc/malloc-allocator))
        _ (ohm/ast-mapping-add-forward! (mut list-forward-map) "nonemptyListOf" 0)
        (mut list-forward-ast)
          (ohm/to-ast (mut list) (mut list-forward-map) (alloc/malloc-allocator))
        _ (emit-ast "list-forward" (mut list-forward-ast))

        (mut empty-action-map) (ohm/new-ohm-ast-mapping (alloc/malloc-allocator))
        _ (ohm/ast-mapping-add-action! (mut empty-action-map) "emptyListOf" 4)
        (mut empty-action-ast)
          (ohm/to-ast-with-actions actions
                                   (mut empty-list)
                                   (mut empty-action-map)
                                   (alloc/malloc-allocator))
        _ (emit-ast "empty-action" (mut empty-action-ast))

        (mut ast-semantics) (semantics-for-to-ast)
        _ (io/print-str (io/stdout) "semantics-meta|")
        _ (io/print-int
            (io/stdout) (ohm/to-ast-semantics-operation-count (mut ast-semantics)))
        _ (io/print-str (io/stdout) "|")
        _ (io/print-str
            (io/stdout) (ohm/to-ast-semantics-operation-name (mut ast-semantics)))
        _ (io/print-str (io/stdout) "|")
        _ (io/print-int
            (io/stdout) (ohm/to-ast-semantics-formal-count (mut ast-semantics)))
        _ (io/write-line (io/stdout) "")
        (mut semantics-map) (ohm/new-ohm-ast-mapping (alloc/malloc-allocator))
        (mut semantics-ast)
          (ohm/to-ast-semantics-apply (mut ast-semantics)
                                      (mut short)
                                      (mut semantics-map)
                                      (alloc/malloc-allocator))
        _ (emit-ast "semantics-apply" (mut semantics-ast))]
    (ohm/free-ohm-ast! (mut default-ast))
    (ohm/free-ohm-ast! (mut optional-ast))
    (ohm/free-ohm-ast! (mut renamed-ast))
    (ohm/free-ohm-ast! (mut operator-ast))
    (ohm/free-ohm-ast! (mut removed-ast))
    (ohm/free-ohm-ast! (mut no-type-ast))
    (ohm/free-ohm-ast! (mut static-ast))
    (ohm/free-ohm-ast! (mut boxed-ast))
    (ohm/free-ohm-ast! (mut computed-property-ast))
    (ohm/free-ohm-ast! (mut forward-ast))
    (ohm/free-ohm-ast! (mut action-ast))
    (ohm/free-ohm-ast! (mut reintroduced-ast))
    (ohm/free-ohm-ast! (mut combo-ast))
    (ohm/free-ohm-ast! (mut list-ast))
    (ohm/free-ohm-ast! (mut empty-list-ast))
    (ohm/free-ohm-ast! (mut syntactic-list-ast))
    (ohm/free-ohm-ast! (mut syntactic-empty-ast))
    (ohm/free-ohm-ast! (mut override-ast))
    (ohm/free-ohm-ast! (mut list-forward-ast))
    (ohm/free-ohm-ast! (mut empty-action-ast))
    (ohm/free-ohm-ast! (mut semantics-ast))
    (ohm/free-ohm-ast-mapping! (mut default-map))
    (ohm/free-ohm-ast-mapping! (mut optional-map))
    (ohm/free-ohm-ast-mapping! (mut renamed-map))
    (ohm/free-ohm-ast-mapping! (mut operator-map))
    (ohm/free-ohm-ast-mapping! (mut removed-map))
    (ohm/free-ohm-ast-mapping! (mut no-type-map))
    (ohm/free-ohm-ast-mapping! (mut static-map))
    (ohm/free-ohm-ast-mapping! (mut boxed-map))
    (ohm/free-ohm-ast-mapping! (mut computed-property-map))
    (ohm/free-ohm-ast-mapping! (mut forward-map))
    (ohm/free-ohm-ast-mapping! (mut action-map))
    (ohm/free-ohm-ast-mapping! (mut reintroduced-map))
    (ohm/free-ohm-ast-mapping! (mut combo-map))
    (ohm/free-ohm-ast-mapping! (mut list-map))
    (ohm/free-ohm-ast-mapping! (mut override-map))
    (ohm/free-ohm-ast-mapping! (mut list-forward-map))
    (ohm/free-ohm-ast-mapping! (mut empty-action-map))
    (ohm/free-ohm-ast-mapping! (mut semantics-map))
    (ohm/free-match! (mut short))
    (ohm/free-match! (mut long))
    (ohm/free-match! (mut optional))
    (ohm/free-match! (mut list))
    (ohm/free-match! (mut empty-list))
    (ohm/free-match! (mut syntactic-list))
    (ohm/free-match! (mut syntactic-empty))
    0))
