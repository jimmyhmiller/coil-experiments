(module tests.ohm.match-node-public-dump-runtime)

(import "coil.alloc" :as alloc)
(import "coil.io" :as io)
(import "coil.str" :as str)
(import "experiments.ohm.runtime" :as ohm)

(build-ohm-grammar
  (grammars
    (grammar G
      (withDefaultStartRule Start)
      (define Start [] (seq (plus (app item)) (opt (app ending))))
      (define item [] (alt (app letter) (app digit)))
      (define ending [] (terminal "!")))))

(defn append-node-api! [(builder (mut str/StrBuf))
                        (result ohm/MatchResult)
                        (node i64)] (-> i64)
  (str/sb-push-str! (mut builder) "(")
  (ohm/cst-signature-hex! (mut builder) (ohm/node-rule result node))
  (str/sb-push-str! (mut builder) ":")
  (str/sb-push-i64! (mut builder) (ohm/node-start-utf16 result node))
  (str/sb-push-str! (mut builder) ":")
  (str/sb-push-i64! (mut builder) (ohm/node-end-utf16 result node))
  (str/sb-push-str! (mut builder) ":")
  (ohm/cst-signature-hex! (mut builder) (ohm/node-source-string result node))
  (str/sb-push-str! (mut builder) ":")
  (str/sb-push-str! (mut builder) (if (ohm/node-terminal? result node) "t" "-"))
  (str/sb-push-str! (mut builder) (if (ohm/node-iteration? result node) "i" "-"))
  (str/sb-push-str! (mut builder) (if (ohm/node-optional? result node) "o" "-"))
  (str/sb-push-str! (mut builder) ":")
  (str/sb-push-i64! (mut builder) (ohm/node-child-count result node))
  (for [index 0 (ohm/node-child-count result node)]
    (str/sb-push-str! (mut builder) ",")
    (append-node-api! (mut builder) result (ohm/node-child result node index)))
  (str/sb-push-str! (mut builder) ")")
  0)

(defn emit-success [(label (slice u8)) (input (slice u8))] (-> i64)
  (let [(mut result) (parse-tree input)
        matcher (ohm/match-matcher (load result))
        (mut nodes) (str/sb-new (alloc/malloc-allocator))
        _ (append-node-api! (mut nodes) (load result) (ohm/match-root (load result)))
        node-signature (str/sb-finish! (mut nodes))]
    (io/print-str (io/stdout) label)
    (io/print-str (io/stdout) "|")
    (io/print-str (io/stdout) input)
    (io/print-str (io/stdout) "|")
    (io/print-str (io/stdout) (if (ohm/match-succeeded? (load result)) "1|0|" "0|1|"))
    (io/print-str (io/stdout) (ohm/match-to-string! (mut result)))
    (io/print-str (io/stdout) "|")
    (io/print-str (io/stdout) (ohm/matcher-input matcher))
    (io/print-str (io/stdout) "|")
    (io/print-str (io/stdout)
                  (ohm/ohm-grammar-name (ohm/matcher-grammar matcher)))
    (io/print-str (io/stdout) "|")
    (io/write-line (io/stdout) node-signature)
    (alloc/free [u8] (alloc/malloc-allocator) node-signature)
    (ohm/free-match! (mut result))
    0))

(defn emit-failure [(label (slice u8)) (input (slice u8))] (-> i64)
  (let [(mut result) (parse-tree input)
        interval (ohm/match-interval (load result))
        (mut builder) (str/sb-new (alloc/malloc-allocator))]
    (str/sb-push-str! (mut builder) label)
    (str/sb-push-str! (mut builder) "|")
    (ohm/cst-signature-hex! (mut builder) (ohm/match-input (load result)))
    (str/sb-push-str! (mut builder) "|0|1|")
    (str/sb-push-i64! (mut builder) (ohm/match-failure-position (load result)))
    (str/sb-push-str! (mut builder) "|")
    (ohm/cst-signature-hex! (mut builder) (ohm/match-expected-text (load result)))
    (str/sb-push-str! (mut builder) "|")
    (ohm/cst-signature-hex! (mut builder) (ohm/match-short-message (load result)))
    (str/sb-push-str! (mut builder) "|")
    (ohm/cst-signature-hex! (mut builder) (ohm/match-message (load result)))
    (str/sb-push-str! (mut builder) "|")
    (ohm/cst-signature-hex! (mut builder) (ohm/match-to-string! (mut result)))
    (str/sb-push-str! (mut builder) "|")
    (str/sb-push-i64! (mut builder) (ohm/ohm-interval-start interval))
    (str/sb-push-str! (mut builder) "|")
    (str/sb-push-i64! (mut builder) (ohm/ohm-interval-end interval))
    (str/sb-push-str! (mut builder) "\n")
    (let [line (str/sb-finish! (mut builder))]
      (io/print-str (io/stdout) line)
      (alloc/free [u8] (alloc/malloc-allocator) line))
    (ohm/free-match! (mut result))
    0))

(defn main [] (-> i64)
  (emit-success "absent" "a2")
  (emit-success "present" "a2!")
  (emit-failure "unicode-failure" "a😀")
  (emit-failure "initial-failure" "!")
  0)
