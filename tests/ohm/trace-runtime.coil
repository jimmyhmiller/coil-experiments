(module tests.ohm.trace-runtime)

(import "coil.alloc" :as alloc)
(import "coil.primitive" :as primitive)
(import "coil.str" :as str)
(import "experiments.ohm.runtime" :as ohm)

(defstruct CountingVisitor [(enters i64) (exits i64)])

(impl ohm/OhmTraceVisitor CountingVisitor
  (trace-visitor-enter [(self (mut CountingVisitor))
                        (result (ptr ohm/MatchResult))
                        (event i64)
                        (parent i64)
                        (depth i64)] (-> bool)
    (set! (.enters self) (+ (.enters self) 1))
    (not (str/str-eq (ohm/trace-display (load result) event) "\"a\"")))
  (trace-visitor-exit [(self (mut CountingVisitor))
                       (result (ptr ohm/MatchResult))
                       (event i64)
                       (parent i64)
                       (depth i64)] (-> i64)
    (set! (.exits self) (+ (.exits self) 1))
    0))

(defn memo-trace-test [] (-> i64)
  (let [(mut state) (ohm/new-parse-state (alloc/malloc-allocator))
        _ (ohm/enable-tracing! (mut state))
        first-event (ohm/trace-enter! (mut state) "letter" 0)
        memo-index (ohm/memo-begin! (mut state) 0 0)
        checkpoint (ohm/mark state)
        _ (ohm/memo-trace-mark! (mut state) memo-index)
        body-event (ohm/trace-enter! (mut state) "lower" 0)
        body-end (ohm/match-literal-cst! (mut state) "a" 0 "a")
        _ (ohm/trace-exit! (mut state) body-event body-end)
        _ (ohm/memo-capture! (mut state)
                             memo-index
                             (ohm/mark-node-count checkpoint)
                             body-end)
        _ (ohm/rewind! (mut state) checkpoint)
        first-end (ohm/memo-replay! (mut state) memo-index)
        _ (ohm/trace-exit! (mut state) first-event first-end)
        second-event (ohm/trace-enter! (mut state) "letter" 0)
        second-end (ohm/memo-replay! (mut state) memo-index)
        _ (ohm/trace-exit! (mut state) second-event second-end)
        (mut result) (ohm/finish-match (mut state) "a" second-end)
        answer
          (cond (not (= (ohm/trace-count (load result)) 4)) 31
                (ohm/trace-memoized? (load result) first-event) 32
                (not (ohm/trace-memoized? (load result) second-event)) 33
                (not (= (ohm/trace-child-count (load result) second-event) 1)) 34
                (not (str/str-eq (ohm/trace-display (load result) 3) "lower")) 35
                (not (= (ohm/trace-binding (load result) 3) 1)) 36
                :else 0)]
    (ohm/free-match! (mut result))
    answer))

(defn main [] (-> i64)
  (let [(mut state) (ohm/new-parse-state (alloc/malloc-allocator))
        _ (ohm/enable-tracing! (mut state))
        outer (ohm/trace-enter! (mut state) "start" 0)
        failed (ohm/trace-enter! (mut state) "\"a\"" 0)
        _ (ohm/trace-exit! (mut state) failed -1)
        succeeded (ohm/trace-enter! (mut state) "letter*" 0)
        _ (ohm/trace-exit! (mut state) succeeded 5)
        _ (ohm/trace-exit! (mut state) outer 5)
        (mut result) (ohm/finish-match (mut state) "hallo" 5)
        rendered (ohm/trace-to-string! (mut result))
        (mut visitor) (primitive/zeroed CountingVisitor)
        _ (ohm/trace-walk (mut visitor) result)
        valid
          (and (str/str-eq rendered
                           "hallo      ✓ start ⇒  \"hallo\"\nhallo        ✗ \"a\"\nhallo        ✓ letter* ⇒  \"hallo\"\n")
               (and (= (.enters visitor) 3)
                    (and (= (.exits visitor) 2)
                         (and (ohm/trace-valid? (load result))
               (and (= (ohm/trace-count (load result)) 3)
                    (and (= (ohm/trace-child-count (load result) outer) 2)
                         (and (= (ohm/trace-child (load result) outer 0) failed)
                              (and (= (ohm/trace-child (load result) outer 1) succeeded)
                                   (and (str/str-eq (ohm/trace-display (load result) outer)
                                                    "start")
                                        (and (not (ohm/trace-succeeded? (load result) failed))
                                             (and (ohm/trace-succeeded? (load result) succeeded)
                                                  (= (ohm/trace-end (load result) succeeded)
                                                     5))))))))))))]
    (let [answer
            (cond (not (ohm/trace-valid? (load result))) 11
                  (not (= (ohm/trace-count (load result)) 3)) 12
                  (not (= (ohm/trace-child-count (load result) outer) 2)) 13
                  (not (= (ohm/trace-child (load result) outer 0) failed)) 14
                  (not (= (ohm/trace-child (load result) outer 1) succeeded)) 15
                  (not (str/str-eq (ohm/trace-display (load result) outer) "start")) 16
                  (ohm/trace-succeeded? (load result) failed) 17
                  (not (ohm/trace-succeeded? (load result) succeeded)) 18
                  (not (= (ohm/trace-end (load result) succeeded) 5)) 19
                  (not valid) 20
                  :else 0)]
      (ohm/free-match! (mut result))
      (if (not (= answer 0))
          answer
          (let [(mut spaces-state) (ohm/new-parse-state (alloc/malloc-allocator))
                _ (ohm/enable-tracing! (mut spaces-state))
                spaces-end (ohm/trace-skip-spaces! (mut spaces-state) " a" 0)
                (mut spaces-result) (ohm/finish-match (mut spaces-state) " a" spaces-end)
                spaces-answer
                  (cond (not (= spaces-end 1)) 21
                        (not (ohm/trace-valid? (load spaces-result))) 22
                        (not (= (ohm/trace-count (load spaces-result)) 6)) 23
                        (not (ohm/trace-implicit-spaces? (load spaces-result) 0)) 24
                        (not (str/str-eq (ohm/trace-display (load spaces-result) 0)
                                         "spaces")) 25
                        (not (= (ohm/trace-parent (load spaces-result) 1) 0)) 26
                        (not (str/str-eq (ohm/trace-display (load spaces-result) 1)
                                         "space*")) 27
                        (not (ohm/trace-succeeded? (load spaces-result) 2)) 28
                        (ohm/trace-succeeded? (load spaces-result) 4) 29
                        :else 0)]
            (ohm/free-match! (mut spaces-result))
            (if (= spaces-answer 0) (memo-trace-test) spaces-answer))))))
