(module tests.ohm.recover-source-order-dump-runtime)

(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "coil.io" :as io)
(import "experiments.ohm.recover-source-order" :as recover)
(import "experiments.ohm.runtime" :as ohm)

(build-ohm-grammar
  (grammars
    (grammar G
      (withDefaultStartRule test1)
      (define test1 []
        (seq (plus (seq (app a) (app b))) (star (app c))))
      (define test2 []
        (seq (opt (seq (app a) (app b))) (opt (app c)) (terminal ".")))
      (define test3 []
        (plus (seq (star (seq (app a) (app b))) (app c))))
      (define test4 []
        (star (seq (opt (app c))
                   (plus (seq (app a) (star (app b)))))))
      (define a [] (terminal "a"))
      (define b [] (terminal "b"))
      (define c [] (terminal "c")))))

(defn emit-case [(label (slice u8))
                 (input (slice u8))
                 (rule (slice u8))] (-> i64)
  (let [(mut result) (parse-tree-from input rule)
        root (ohm/match-root (load result))
        (mut children) (al/al-new [i64] (alloc/malloc-allocator))
        _ (for [index 0 (ohm/node-child-count (load result) root)]
            (push! (mut children) (ohm/node-child (load result) root index)))
        (mut ordered)
          (recover/recover-source-order
            (load result)
            (al/al-slice [i64] (load children))
            (alloc/malloc-allocator))]
    (io/print-str (io/stdout) label)
    (io/print-str (io/stdout) "|")
    (for [index 0 (recover/recovered-source-order-count (mut ordered))]
      (if (> index 0) (do (io/print-str (io/stdout) " ") 0) 0)
      (let [node (recover/recovered-source-order-node (mut ordered) index)]
        (io/print-str (io/stdout) (ohm/node-rule (load result) node))
        (io/print-str (io/stdout) "[")
        (io/print-int (io/stdout) (ohm/node-start-utf16 (load result) node))
        (io/print-str (io/stdout) "..")
        (io/print-int (io/stdout) (ohm/node-end-utf16 (load result) node))
        (io/print-str (io/stdout) "]")))
    (io/write-line (io/stdout) "")
    (recover/free-recovered-source-order! (mut ordered))
    (al/al-free! (mut children))
    (ohm/free-match! (mut result))
    0))

(defn main [] (-> i64)
  (emit-case "test1" "abc" "test1")
  (emit-case "test2-empty" "." "test2")
  (emit-case "test2-full" "ab." "test2")
  (emit-case "test3" "ababcabc" "test3")
  (emit-case "test4" "abbabab" "test4")
  0)
