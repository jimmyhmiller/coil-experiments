(module tests.ohm.extract-examples-dump-runtime)

(import "coil.alloc" :as alloc)
(import "coil.io" :as io)
(import "coil.slice" :use [slice-len])
(import "experiments.ohm.extract-examples" :as examples)

(defn emit-text [(text (slice u8))] (-> i64)
  (io/print-int (io/stdout) (slice-len text))
  (io/print-str (io/stdout) ":")
  (io/print-str (io/stdout) text)
  0)

(defn emit-case [(label (slice u8)) (source (slice u8))] (-> i64)
  (let [(mut found)
          (examples/extract-ohm-examples source (alloc/malloc-allocator))]
    (io/print-str (io/stdout) label)
    (io/print-str (io/stdout) "|")
    (io/print-int (io/stdout) (examples/ohm-example-count (mut found)))
    (io/write-line (io/stdout) "")
    (for [index 0 (examples/ohm-example-count (mut found))]
      (emit-text (examples/ohm-example-grammar (mut found) index))
      (io/print-str (io/stdout) "|")
      (emit-text (examples/ohm-example-rule (mut found) index))
      (io/print-str (io/stdout) "|")
      (emit-text (examples/ohm-example-text (mut found) index))
      (io/print-str (io/stdout) "|")
      (io/write-line
        (io/stdout)
        (if (examples/ohm-example-should-match? (mut found) index) "1" "0")))
    (examples/free-ohm-examples! (mut found))
    0))

(defn main [] (-> i64)
  (emit-case "empty" "")
  (emit-case "none" "G { }")
  (emit-case "simple" "\nG {\n //+ \"x\"\n start = \"x\"\n}")
  (emit-case "two-rules"
             "G {\n //+ \"\"\n start = \"\"\n //+ \"x\"\n other = \"\"\n}")
  (emit-case "default"
             "G {\n //+ \"\"\n start = \"\"\n //+ \"hey\"\n}")
  (emit-case "outside" "//+ \"\"\nG {\n start = \"\"\n //+ \"hey\"\n}")
  (emit-case "whitespace-1" "G{  //+ \"\"\n  }")
  (emit-case "whitespace-2" "G{  //+ \"\" \n}")
  (emit-case "whitespace-3" "G{\n\n//+ \"\"\n\n}")
  (emit-case "negative"
             "G { //+ \"blah\"\n //- \"wooo\"\n // - \"x\"\n start = \"\"\n}")
  (emit-case "blank" "G { //+ \"blah\"\n\n\n start = \"\"\n}")
  (emit-case "leading" "G { //+ \"blah\"\n //+    \"wooo\"\n start = \"\"\n}")
  (emit-case "contradictory" "G { //+ \"\"\n //- \"\"\n start = \"\"\n}")
  (emit-case "duplicate" "G { //+ \"\"\n //+ \"\"\n start = \"\"\n}")
  (emit-case "json-and-many"
             "G {\n //+ \"a\\n\", \"\\uD83D\\uDE00\", \"\\u0078\"\n start = any*\n}")
  (emit-case "multiple-grammars"
             "A {\n //+ \"a\"\n start = \"a\"\n}\nB {\n //- \"b\"\n other = \"a\"\n}")
  0)
