(module tests.ohm.pexpr-case-insensitive-tostring-error)

(import "coil.alloc" :as alloc)
(import "experiments.ohm.pexprs" :as pexprs)
(import "experiments.ohm.runtime" :as ohm)

(defn main [] (-> i64)
  (let [(mut proto) (pexprs/new-proto-built-in-pexprs (alloc/malloc-allocator))
        body (ohm/ohm-pexpr-rule-body (mut proto) 2)]
    (ohm/ohm-pexpr-to-string (mut proto) body)
    (ohm/free-ohm-pexpr-grammar! (mut proto))
    1))
