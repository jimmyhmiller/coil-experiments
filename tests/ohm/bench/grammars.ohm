Bench {
  Start = Arithmetic | Csv | Json
  Arithmetic = number ("+" number)*
  number = digit+

  Csv = #csv
  csv = row ("\n" row)* "\n"?
  row = csvField ("," csvField)*
  csvField = (~("," | "\n") any)*

  Json = value
  value = object | array | string | numberValue | "true" | "false" | "null"
  object = "{" pairList? "}"
  pairList = pair ("," pair)*
  pair = string ":" value
  array = "[" valueList? "]"
  valueList = value ("," value)*
  string = "\"" stringChar* "\""
  stringChar = escape | normalChar
  escape = "\\" any
  normalChar = ~"\"" any
  numberValue = "-"? digit+ ("." digit+)?
}
