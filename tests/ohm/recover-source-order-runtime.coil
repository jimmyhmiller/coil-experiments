(module tests.ohm.recover-source-order-runtime)

(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "coil.str" :as str)
(import "experiments.ohm.recover-source-order" :as recover)
(import "experiments.ohm.runtime" :as ohm)

(defn main [] (-> i64)
  (let [(mut state) (ohm/new-parse-state (alloc/malloc-allocator))
        outer (ohm/begin-rule! (mut state))
        first-iteration-frame (ohm/begin-rule! (mut state))
        (mut first-iteration) (ohm/begin-iteration (mut state) 2)
        a-frame (ohm/begin-rule! (mut state))
        a-terminal-end (ohm/match-literal-cst! (mut state) "abc" 0 "a")
        a-end (ohm/succeed-rule! (mut state) "a" 0 a-terminal-end)
        b-frame (ohm/begin-rule! (mut state))
        b-terminal-end (ohm/match-literal-cst! (mut state) "abc" a-end "b")
        b-end (ohm/succeed-rule! (mut state) "b" a-end b-terminal-end)
        _ (ohm/iteration-capture-row! (mut state) (mut first-iteration))
        first-end
          (ohm/succeed-iteration! (mut state) (mut first-iteration) 0 b-end false)
        second-iteration-frame (ohm/begin-rule! (mut state))
        (mut second-iteration) (ohm/begin-iteration (mut state) 1)
        c-frame (ohm/begin-rule! (mut state))
        c-terminal-end (ohm/match-literal-cst! (mut state) "abc" first-end "c")
        c-end (ohm/succeed-rule! (mut state) "c" first-end c-terminal-end)
        _ (ohm/iteration-capture-row! (mut state) (mut second-iteration))
        second-end
          (ohm/succeed-iteration! (mut state) (mut second-iteration) first-end c-end false)
        final-end (ohm/succeed-rule! (mut state) "test1" 0 second-end)
        (mut result) (ohm/finish-match (mut state) "abc" final-end)
        root (ohm/match-root (load result))
        (mut children) (al/al-new [i64] (alloc/malloc-allocator))
        _ (for [index 0 (ohm/node-child-count (load result) root)]
            (push! (mut children) (ohm/node-child (load result) root index)))
        (mut ordered)
          (recover/recover-source-order
            (load result)
            (al/al-slice [i64] (load children))
            (alloc/malloc-allocator))
        first (recover/recovered-source-order-node (mut ordered) 0)
        second (recover/recovered-source-order-node (mut ordered) 1)
        third (recover/recovered-source-order-node (mut ordered) 2)
        valid
          (and (= (recover/recovered-source-order-count (mut ordered)) 3)
               (and (str/str-eq (ohm/node-rule (load result) first) "a")
                    (and (= (ohm/node-start (load result) first) 0)
                         (and (= (ohm/node-end (load result) first) 1)
                              (and (str/str-eq (ohm/node-rule (load result) second) "b")
                                   (and (= (ohm/node-start (load result) second) 1)
                                        (and (= (ohm/node-end (load result) second) 2)
                                             (and (str/str-eq (ohm/node-rule (load result) third) "c")
                                                  (and (= (ohm/node-start (load result) third) 2)
                                                       (= (ohm/node-end (load result) third) 3))))))))))]
    (recover/free-recovered-source-order! (mut ordered))
    (al/al-free! (mut children))
    (ohm/free-match! (mut result))
    (if valid 0 1)))
