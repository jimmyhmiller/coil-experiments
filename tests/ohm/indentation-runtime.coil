(module tests.ohm.indentation-runtime)

(import "coil.alloc" :as alloc)
(import "experiments.ohm.runtime" :as ohm)

(defn no-token [(state (ptr ohm/ParseState)) (at i64)] (-> bool)
  (= (ohm/indentation-token-at state at) 0))

(defn main [] (-> i64)
  (let [(mut state) (ohm/new-parse-state (alloc/malloc-allocator))
        _ (ohm/enable-indentation-sensitive! (mut state) "")
        empty (no-token state 0)
        _ (ohm/enable-indentation-sensitive! (mut state) "  x")
        single
          (and (= (ohm/indentation-token-at state 2) 1)
               (= (ohm/indentation-token-at state 3) -1))
        _ (ohm/enable-indentation-sensitive! (mut state) "  x\n  y")
        same-indent
          (and (= (ohm/indentation-token-at state 2) 1)
               (and (no-token state 6)
                    (= (ohm/indentation-token-at state 7) -1)))
        _ (ohm/enable-indentation-sensitive! (mut state) "  x\n   y")
        nested-eof
          (and (= (ohm/indentation-token-at state 2) 1)
               (and (= (ohm/indentation-token-at state 7) 1)
                    (= (ohm/indentation-token-at state 8) -2)))
        _ (ohm/enable-indentation-sensitive! (mut state) "  x\n   y\nz")
        nested-dedent
          (and (= (ohm/indentation-token-at state 2) 1)
               (and (= (ohm/indentation-token-at state 7) 1)
                    (= (ohm/indentation-token-at state 9) -2)))
        _ (ohm/enable-indentation-sensitive! (mut state) "\n   y\n")
        leading-empty
          (and (= (ohm/indentation-token-at state 4) 1)
               (= (ohm/indentation-token-at state 6) -1))
        valid
          (and empty
               (and single
                    (and same-indent
                         (and nested-eof
                              (and nested-dedent leading-empty)))))
        (mut result) (ohm/finish-match (mut state) "\n   y\n" -1)]
    (ohm/free-match! (mut result))
    (if valid 0 1)))
