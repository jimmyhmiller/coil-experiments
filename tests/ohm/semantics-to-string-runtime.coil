(module tests.ohm.semantics-to-string-runtime)

(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "coil.primitive" :as primitive)
(import "coil.str" :as str)
(import "experiments.ohm.runtime" :as ohm)

(defn grammar-token [] (-> (ptr u8))
  (primitive/alloc-static u8))

(defstruct EmptyAction [])

(impl ohm/OhmLazySemanticAction EmptyAction
  (semantic-grammar-name [(self (ptr EmptyAction))] (-> (slice u8)) "G")
  (semantic-grammar-token [(self (ptr EmptyAction))] (-> (ptr u8)) (grammar-token))
  (semantic-formal-count [(self (ptr EmptyAction))] (-> i64) 0)
  (semantic-action-kind [(self (ptr EmptyAction))
                         (result (ptr ohm/MatchResult))
                         (node i64)] (-> i64) 0)
  (apply-lazy-semantic-action [(self (ptr EmptyAction))
                               (evaluation (mut ohm/SemanticEvaluation))
                               (node i64)
                               (action-kind i64)
                               (arguments (slice i64))] (-> i64) 0))

(defstruct InnerStringAction [(valid (ptr bool))])

(impl ohm/OhmLazySemanticAction InnerStringAction
  (semantic-grammar-name [(self (ptr InnerStringAction))] (-> (slice u8)) "G")
  (semantic-grammar-token [(self (ptr InnerStringAction))] (-> (ptr u8)) (grammar-token))
  (semantic-formal-count [(self (ptr InnerStringAction))] (-> i64) 0)
  (semantic-action-kind [(self (ptr InnerStringAction))
                         (result (ptr ohm/MatchResult))
                         (node i64)] (-> i64)
    (if (str/str-eq (ohm/node-rule (load result) node) "letter") 1 0))
  (apply-lazy-semantic-action [(self (ptr InnerStringAction))
                               (evaluation (mut ohm/SemanticEvaluation))
                               (node i64)
                               (action-kind i64)
                               (arguments (slice i64))] (-> i64)
    (let [text (ohm/semantic-wrapper-to-string! (mut evaluation))]
      (store! (.valid self) (str/str-eq text "[semantics wrapper for G]"))
      (alloc/free [u8] (alloc/malloc-allocator) text)
      0)))

(defn main [] (-> i64)
  (let [(mut state) (ohm/new-parse-state (alloc/malloc-allocator))
        _ (ohm/set-parse-grammar-name! (mut state) "G")
        _ (ohm/set-parse-grammar-token! (mut state) (grammar-token))
        outer (ohm/begin-rule! (mut state))
        inner (ohm/begin-rule! (mut state))
        end (ohm/match-literal-cst! (mut state) "x" 0 "x")
        letter-end (ohm/succeed-rule! (mut state) "letter" 0 end)
        final-end (ohm/succeed-rule! (mut state) "Start" 0 letter-end)
        (mut result) (ohm/finish-match (mut state) "x" final-end)
        action (primitive/alloc-stack EmptyAction)
        (mut evaluation) (ohm/new-semantic-evaluation action (mut result) false)
        wrapper-text (ohm/semantic-wrapper-to-string! (mut evaluation))
        inner-valid (primitive/alloc-stack bool)
        _ (store! inner-valid false)
        inner-action (primitive/alloc-stack InnerStringAction)
        _ (store! (field inner-action valid) inner-valid)
        (mut no-arguments) (al/al-new [i64] (alloc/malloc-allocator))
        (mut inner-evaluation) (ohm/new-semantic-evaluation inner-action (mut result) false)
        _ (ohm/evaluate-semantic-root! (mut inner-evaluation)
                                       (al/al-slice [i64] (load no-arguments)))
        (mut semantics)
          (ohm/new-ohm-semantics "G" (grammar-token) (alloc/malloc-allocator))
        semantics-text (ohm/ohm-semantics-to-string! (mut semantics))
        valid
          (and (str/str-eq wrapper-text "[semantics wrapper for G]")
               (and (load inner-valid)
                    (str/str-eq semantics-text "[semantics for G]")))]
    (alloc/free [u8] (alloc/malloc-allocator) wrapper-text)
    (alloc/free [u8] (alloc/malloc-allocator) semantics-text)
    (ohm/free-ohm-semantics! (mut semantics))
    (ohm/free-semantic-evaluation! (mut inner-evaluation))
    (al/al-free! (mut no-arguments))
    (ohm/free-semantic-evaluation! (mut evaluation))
    (ohm/free-match! (mut result))
    (if valid 0 1)))
