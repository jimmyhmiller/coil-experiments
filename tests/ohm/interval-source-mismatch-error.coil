(module tests.ohm.interval-source-mismatch-error)

(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "experiments.ohm.runtime" :as ohm)

(defn main [] (-> i64)
  (let [(mut intervals)
          (al/al-new [ohm/OhmInterval] (alloc/malloc-allocator))]
    (push! (mut intervals) (ohm/new-ohm-interval "abc" 0 3))
    (push! (mut intervals) (ohm/new-ohm-interval "xyz" 1 2))
    (ohm/ohm-interval-coverage
      (al/al-slice [ohm/OhmInterval] (load intervals)))
    1))
