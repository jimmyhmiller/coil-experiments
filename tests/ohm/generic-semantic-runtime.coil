(module tests.ohm.generic-semantic-runtime)

(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "coil.primitive" :as primitive)
(import "coil.slice" :use [slice-get])
(import "coil.str" :as str)
(import "experiments.ohm.generic-semantics" :as generic)
(import "experiments.ohm.runtime" :as ohm)

(defstruct SemanticValue [(number i64) (label (slice u8))])
(defstruct ActionContext [(terminal-label (slice u8))])

(defn grammar-token [] (-> (ptr u8))
  (primitive/alloc-static u8))

(defn action-kind [(context (ptr u8))
                   (result (ptr ohm/MatchResult))
                   (node i64)] (-> i64)
  (if (or (ohm/node-terminal? (load result) node)
          (str/str-eq (ohm/node-rule (load result) node) "pair"))
      1
      0))

(defn apply-action
  [(context (ptr u8))
   (evaluation (mut (generic/OhmGenericSemanticEvaluation SemanticValue)))
   (node i64)
   (kind i64)
   (arguments (slice i64))] (-> SemanticValue)
  (let [(mut value) (primitive/zeroed SemanticValue)
        result (.result evaluation)]
    (if (ohm/node-terminal? (load result) node)
        (do
          (set! (.number value)
                (- (primitive/cast i64
                     (slice-get (ohm/node-source-string (load result) node) 0))
                   48))
          (set! (.label value) (.terminal-label (primitive/cast (ptr ActionContext) context))))
        (let [left
                (generic/evaluate-generic-semantic-child!
                  [SemanticValue] (mut evaluation) node 0 arguments)
              right
                (generic/evaluate-generic-semantic-child!
                  [SemanticValue] (mut evaluation) node 1 arguments)]
          (set! (.number value) (+ (.number left) (.number right)))
          (set! (.label value) "pair")))
    (load value)))

(defn main [] (-> i64)
  (let [(mut state) (ohm/new-parse-state (alloc/malloc-allocator))
        _ (ohm/set-parse-grammar-name! (mut state) "G")
        _ (ohm/set-parse-grammar-token! (mut state) (grammar-token))
        outer (ohm/begin-rule! (mut state))
        first-end (ohm/match-literal-cst! (mut state) "12" 0 "1")
        second-end (ohm/match-literal-cst! (mut state) "12" first-end "2")
        final-end (ohm/succeed-rule! (mut state) "pair" 0 second-end)
        (mut result) (ohm/finish-match (mut state) "12" final-end)
        context (primitive/alloc-stack ActionContext)
        _ (store! (field context terminal-label) "digit")
        (mut evaluation)
          (generic/new-generic-semantic-evaluation
            [SemanticValue]
            (primitive/cast (ptr u8) context)
            (primitive/fnptr-of action-kind)
            (primitive/fnptr-of apply-action)
            (mut result)
            "G"
            (grammar-token)
            0
            false)
        (mut no-arguments) (al/al-new [i64] (alloc/malloc-allocator))
        value
          (generic/evaluate-generic-semantic-root!
            [SemanticValue]
            (mut evaluation)
            (al/al-slice [i64] (load no-arguments)))
        valid
          (and (not (generic/generic-semantic-evaluation-failed?
                      [SemanticValue] (mut evaluation)))
               (and (= (.number value) 3) (str/str-eq (.label value) "pair")))]
    (al/al-free! (mut no-arguments))
    (generic/free-generic-semantic-evaluation! [SemanticValue] (mut evaluation))
    (ohm/free-match! (mut result))
    (if valid 0 1)))
