(module tests.ohm.grammar-extend-semantics-runtime)

(import "coil.alloc" :as alloc)
(import "coil.primitive" :as primitive)
(import "coil.primitive" :use [fnptr-of])
(import "coil.str" :as str)
(import "experiments.ohm.runtime" :as ohm)

(defn dummy-parse [(input (slice u8)) (rule (slice u8))]
                  (-> ohm/MatchResult)
  (primitive/zeroed ohm/MatchResult))

(defn dummy-cached-parse [(input (slice u8))
                         (rule (slice u8))
                         (trace bool)
                         (cache (mut ohm/ParseCache))]
                        (-> ohm/MatchResult)
  (primitive/zeroed ohm/MatchResult))

(defn token-a [] (-> (ptr u8)) (primitive/cast (ptr u8) (fnptr-of token-a)))
(defn token-b [] (-> (ptr u8)) (primitive/cast (ptr u8) (fnptr-of token-b)))
(defn token-child [] (-> (ptr u8)) (primitive/cast (ptr u8) (fnptr-of token-child)))

(defn make-grammar [(name (slice u8))
                    (fingerprint (slice u8))
                    (token (ptr u8))] (-> ohm/OhmGrammar)
  (ohm/new-ohm-grammar
    (ohm/new-ohm-grammar-descriptor name "" "" fingerprint)
    (ohm/new-ohm-pexpr-grammar "" (alloc/malloc-allocator))
    (fnptr-of dummy-parse)
    (fnptr-of dummy-cached-parse)
    "" "" "" token false (alloc/malloc-allocator)))

(defn equivalent-parent [] (-> ohm/OhmGrammar)
  (make-grammar "G" "same-structural-fingerprint" (token-b)))

(defn main [] (-> i64)
  (let [(mut parent-a)
          (make-grammar "G" "same-structural-fingerprint" (token-a))
        (mut parent-b) (equivalent-parent)
        (mut parent-semantics) (ohm/ohm-grammar-create-semantics (mut parent-a))
        (mut equivalent-extension)
          (ohm/ohm-grammar-extend-semantics (mut parent-b) (mut parent-semantics))
        (mut child)
          (make-grammar "Child" "child-structural-fingerprint" (token-child))
        _ (ohm/set-ohm-grammar-supergrammar-factory!
            (mut child) (fnptr-of equivalent-parent))
        (mut child-extension)
          (ohm/ohm-grammar-extend-semantics (mut child) (mut parent-semantics))
        valid
          (and (str/str-eq (.grammar-name equivalent-extension) "G")
               (str/str-eq (.grammar-name child-extension) "Child"))]
    (ohm/free-ohm-semantics! (mut parent-semantics))
    (ohm/free-ohm-semantics! (mut equivalent-extension))
    (ohm/free-ohm-semantics! (mut child-extension))
    (ohm/free-ohm-grammar! (mut parent-a))
    (ohm/free-ohm-grammar! (mut parent-b))
    (ohm/free-ohm-grammar! (mut child))
    (if valid 0 1)))
