(module tests.ohm.generic-visitor-family-runtime)

(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "coil.primitive" :as primitive)
(import "coil.slice" :use [slice-len slice-get])
(import "coil.str" :as str)
(import "experiments.ohm.generic-visitor-family" :as generic)
(import "experiments.ohm.visitor-family" :as vf)

(defstruct GenericNode [(leaf bool) (left i64) (right i64)])
(defstruct GenericTree
  [(nodes (al/ArrayList GenericNode)) (allocator (dyn alloc/Allocator))])

(defn new-generic-tree [] (-> GenericTree)
  (let [(mut tree) (primitive/zeroed GenericTree)]
    (set! (.allocator tree) (alloc/malloc-allocator))
    (set! (.nodes tree) (al/al-new [GenericNode] (.allocator tree)))
    (load tree)))

(defn add-node! [(tree (mut GenericTree))
                 (leaf bool)
                 (left i64)
                 (right i64)] (-> i64)
  (let [(mut node) (primitive/zeroed GenericNode)
        index (len (.nodes tree))]
    (set! (.leaf node) leaf)
    (set! (.left node) left)
    (set! (.right node) right)
    (push! (mut (.nodes tree)) (load node))
    index))

(impl vf/OhmVisitorTree GenericTree
  (visitor-tag [(self (ptr GenericTree)) (node i64)] (-> (slice u8))
    (let [value (get (.nodes self) node)]
      (if (.leaf value) "leaf" "tree")))
  (visitor-property-child-count [(self (ptr GenericTree))
                                 (node i64)
                                 (property (slice u8))] (-> i64) 1)
  (visitor-property-child [(self (ptr GenericTree))
                           (node i64)
                           (property (slice u8))
                           (index i64)] (-> i64)
    (let [value (get (.nodes self) node)]
      (if (str/str-eq property "l") (.left value) (.right value))))
  (visitor-custom-argument-count [(self (ptr GenericTree)) (node i64)] (-> i64) 0)
  (visitor-custom-argument-child-count [(self (ptr GenericTree))
                                        (node i64)
                                        (argument i64)] (-> i64) 0)
  (visitor-custom-argument-child [(self (ptr GenericTree))
                                  (node i64)
                                  (argument i64)
                                  (index i64)] (-> i64) -1))

(defstruct VisitValue [(sum i64) (depth i64) (label (slice u8))])
(defstruct VisitArgument [(bias i64)])
(defstruct VisitContext [])

(defn action-index [(context (ptr u8)) (tag (slice u8))] (-> i64)
  (cond (str/str-eq tag "leaf") 0
        (str/str-eq tag "tree") 1
        :else -1))

(defn apply-action
  [(context (ptr u8))
   (evaluation
     (mut (generic/OhmGenericVisitorEvaluation VisitValue VisitArgument)))
   (node i64)
   (action i64)
   (arguments (slice vf/VisitorArgument))] (-> VisitValue)
  (let [(mut value) (primitive/zeroed VisitValue)]
    (if (= action 0)
        (let [operation-argument
                (generic/generic-visitor-operation-argument
                  [VisitValue VisitArgument] evaluation 0)]
          (set! (.sum value) (+ node (.bias operation-argument)))
          (set! (.depth value) 0)
          (set! (.label value) "leaf"))
        (do
          (for [argument-index 0 (slice-len arguments)]
            (let [argument (slice-get arguments argument-index)]
              (for [child-index 0 (vf/visitor-argument-child-count argument)]
                (let [child
                        (generic/evaluate-generic-visitor-argument!
                          [VisitValue VisitArgument]
                          (mut evaluation)
                          argument
                          child-index)]
                  (set! (.sum value) (+ (.sum value) (.sum child)))
                  (if (>= (.depth child) (.depth value))
                      (set! (.depth value) (+ (.depth child) 1))
                      0)))))
          (set! (.label value) "tree")))
    (load value)))

(defn new-visit-evaluation
  [(family (ptr vf/OhmVisitorFamily))
   (tree (dyn vf/OhmVisitorTree))
   (context (ptr u8))
   (arguments (slice VisitArgument))]
  (-> (generic/OhmGenericVisitorEvaluation VisitValue VisitArgument))
  (generic/new-generic-visitor-evaluation
    [VisitValue VisitArgument]
    family
    tree
    context
    (primitive/fnptr-of action-index)
    (primitive/fnptr-of apply-action)
    arguments))

(defn generic-visitor-example [] (-> VisitValue)
  (let [(mut tree) (new-generic-tree)
        _ (add-node! (mut tree) true -1 -1)
        one (add-node! (mut tree) true -1 -1)
        two (add-node! (mut tree) true -1 -1)
        three (add-node! (mut tree) true -1 -1)
        right (add-node! (mut tree) false two three)
        root (add-node! (mut tree) false one right)
        (mut family) (vf/new-visitor-family (alloc/malloc-allocator))
        _ (vf/visitor-family-add-fixed-shape! (mut family) "leaf")
        tree-shape (vf/visitor-family-add-fixed-shape! (mut family) "tree")
        _ (vf/visitor-family-add-property! (mut family) tree-shape "l" false)
        _ (vf/visitor-family-add-property! (mut family) tree-shape "r" false)
        tree-provider (primitive/alloc-stack GenericTree)
        _ (store! tree-provider (load tree))
        context (primitive/alloc-stack VisitContext)
        _ (store! context (primitive/zeroed VisitContext))
        (mut operation-arguments) (al/al-new [VisitArgument] (alloc/malloc-allocator))
        (mut bias) (primitive/zeroed VisitArgument)
        _ (set! (.bias bias) 10)
        _ (push! (mut operation-arguments) (load bias))
        (mut evaluation)
          (new-visit-evaluation
            (mut family)
            tree-provider
            (primitive/cast (ptr u8) context)
            (al/al-slice [VisitArgument] (load operation-arguments)))
        value
          (generic/evaluate-generic-visitor-node!
            [VisitValue VisitArgument] (mut evaluation) root)
        valid
          (and (not (generic/generic-visitor-failed?
                      [VisitValue VisitArgument] (mut evaluation)))
               (and (= (.sum value) 36)
                    (and (= (.depth value) 2)
                         (str/str-eq (.label value) "tree"))))]
    (generic/free-generic-visitor-evaluation!
      [VisitValue VisitArgument] (mut evaluation))
    (al/al-free! (mut operation-arguments))
    (vf/free-visitor-family! (mut family))
    (al/al-free! (mut (.nodes tree)))
    (if valid value (primitive/zeroed VisitValue))))

(defn main [] (-> i64)
  (let [value (generic-visitor-example)]
    (if (and (= (.sum value) 36)
             (and (= (.depth value) 2) (str/str-eq (.label value) "tree")))
        0
        1)))
