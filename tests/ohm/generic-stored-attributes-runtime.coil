(module tests.ohm.generic-stored-attributes-runtime)

(import "coil.alloc" :as alloc)
(import "coil.io" :as io)
(import "coil.primitive" :as primitive)
(import "coil.str" :as str)
(import "experiments.ohm.generic-stored-attributes" :as stored)
(import "experiments.ohm.runtime" :as ohm)

(build-ohm-grammar
  (grammars
    (grammar Arithmetic
      (withDefaultStartRule Exp)
      (define Exp [] (app AddExp))
      (define AddExp []
        (alt (app AddExp_plus) (app AddExp_minus) (app number)))
      (define AddExp_plus []
        (seq (app AddExp) (terminal "+") (app number)))
      (define AddExp_minus []
        (seq (app AddExp) (terminal "-") (app number)))
      (define number [] (plus (app digit))))))

(defstruct Polarity [(text (slice u8)) (rank i64)])
(defstruct StoredExample
  [(root Polarity)
   (add Polarity)
   (minus Polarity)
   (left-add Polarity)
   (plus Polarity)
   (operator-initialized bool)])

(defn polarity [(text (slice u8)) (rank i64)] (-> Polarity)
  (let [(mut value) (primitive/zeroed Polarity)]
    (set! (.text value) text)
    (set! (.rank value) rank)
    (load value)))

(defn value-eq? [(value (Option Polarity))
                 (text (slice u8))
                 (rank i64)] (-> bool)
  (match value
    (Some [stored-value]
      (let [bound stored-value]
        (and (str/str-eq (.text bound) text) (= (.rank bound) rank))))
    (None [] false)))

(defn option-polarity [(value (Option Polarity))] (-> Polarity)
  (match value (Some [stored-value] stored-value) (None [] (primitive/zeroed Polarity))))

(defn generic-stored-attributes-example [] (-> StoredExample)
  (let [(mut result) (parse-tree "3 + 4 - 1")
        root (ohm/match-root (load result))
        add (ohm/node-child (load result) root 0)
        minus (ohm/node-child (load result) add 0)
        left-add (ohm/node-child (load result) minus 0)
        plus (ohm/node-child (load result) left-add 0)
        operator (ohm/node-child (load result) minus 1)
        (mut attribute)
          (stored/new-generic-stored-attribute
            [Polarity] (alloc/malloc-allocator))
        _ (stored/set-generic-stored-attribute!
            [Polarity] (mut attribute) (load result) root (polarity "=" 0))
        _ (stored/set-generic-stored-attribute!
            [Polarity] (mut attribute) (load result) add (polarity "=" 0))
        _ (stored/set-generic-stored-attribute!
            [Polarity] (mut attribute) (load result) minus (polarity "-" 1))
        _ (stored/set-generic-stored-attribute!
            [Polarity] (mut attribute) (load result) left-add (polarity "-" 1))
        _ (stored/set-generic-stored-attribute!
            [Polarity] (mut attribute) (load result) plus (polarity "+" 2))
        (mut example) (primitive/zeroed StoredExample)
        _ (set! (.root example)
                (option-polarity
                  (stored/generic-stored-attribute-value
                    [Polarity] (mut attribute) (load result) root)))
        _ (set! (.add example)
                (option-polarity
                  (stored/generic-stored-attribute-value
                    [Polarity] (mut attribute) (load result) add)))
        _ (set! (.minus example)
                (option-polarity
                  (stored/generic-stored-attribute-value
                    [Polarity] (mut attribute) (load result) minus)))
        _ (set! (.left-add example)
                (option-polarity
                  (stored/generic-stored-attribute-value
                    [Polarity] (mut attribute) (load result) left-add)))
        _ (set! (.plus example)
                (option-polarity
                  (stored/generic-stored-attribute-value
                    [Polarity] (mut attribute) (load result) plus)))
        _ (set! (.operator-initialized example)
                (stored/generic-stored-attribute-initialized?
                  [Polarity] (mut attribute) (load result) operator))]
    (stored/free-generic-stored-attribute! [Polarity] (mut attribute))
    (ohm/free-match! (mut result))
    (load example)))

(defn polarity-eq? [(value Polarity) (text (slice u8)) (rank i64)] (-> bool)
  (and (str/str-eq (.text value) text) (= (.rank value) rank)))

(defn emit-polarity [(value Polarity)] (-> i64)
  (io/print-str (io/stdout) (.text value))
  (io/print-int (io/stdout) (.rank value))
  0)

(defn main [] (-> i64)
  (let [example (generic-stored-attributes-example)]
    (emit-polarity (.root example))
    (io/print-str (io/stdout) "|")
    (emit-polarity (.add example))
    (io/print-str (io/stdout) "|")
    (emit-polarity (.minus example))
    (io/print-str (io/stdout) "|")
    (emit-polarity (.left-add example))
    (io/print-str (io/stdout) "|")
    (emit-polarity (.plus example))
    (io/print-str (io/stdout) "|")
    (io/write-line (io/stdout) (if (.operator-initialized example) "initialized" "none"))
    (if (and (polarity-eq? (.root example) "=" 0)
             (and (polarity-eq? (.add example) "=" 0)
                  (and (polarity-eq? (.minus example) "-" 1)
                       (and (polarity-eq? (.left-add example) "-" 1)
                            (and (polarity-eq? (.plus example) "+" 2)
                                 (not (.operator-initialized example)))))))
        0
        1)))
