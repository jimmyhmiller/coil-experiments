(module tests.ohm.matcher-invalid-indices-error)

(import "coil.alloc" :as alloc)
(import "coil.primitive" :as primitive)
(import "experiments.ohm.runtime" :as ohm)

(defn dummy-parse [(input (slice u8)) (rule (slice u8))]
                  (-> ohm/MatchResult)
  (primitive/zeroed ohm/MatchResult))

(defn main [] (-> i64)
  (let [(mut matcher)
          (ohm/new-ohm-matcher (primitive/fnptr-of dummy-parse)
                               "start"
                               (alloc/malloc-allocator))]
    (ohm/matcher-replace-input-range (mut matcher) -1 2 "x")
    1))
