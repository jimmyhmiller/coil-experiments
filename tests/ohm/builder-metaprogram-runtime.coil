(module tests.ohm.builder-metaprogram-runtime)

(import "coil.str" :as str)
(import "experiments.ohm.runtime" :as ohm)

(build-ohm-grammar
  (grammars
    (grammar Base
      (define token [] (alt (terminal "a") (terminal "b"))))
    (grammar G (super Base)
      (withDefaultStartRule start)
      (override token [] (splice [(terminal "x")] [(terminal "y")]))
      (define start [] "the start rule" (seq (app token) (terminal "!")))
      (define parameterized [x] (param 0))
      (define unicodeDigit [] (unicodeChar Nd))
      (define insensitive [] (caseInsensitive (terminal "ok"))))))

(defn main [] (-> i64)
  (let [(mut accepted) (parse-tree "a!")
        (mut spliced) (parse-tree-from "y" "token")
        (mut rejected) (parse-tree "c!")
        (mut public) (grammar-object)
        start-index 1
        valid
          (and (ohm/match-succeeded? (load accepted))
               (and (ohm/match-succeeded? (load spliced))
               (and (ohm/match-failed? (load rejected))
                    (and (str/str-eq (ohm/ohm-grammar-name (mut public)) "G")
                         (and (> (ohm/ohm-grammar-rule-count (mut public)) 0)
                              (and (str/str-eq
                                     (ohm/ohm-grammar-rule-description
                                       (mut public)
                                       start-index)
                                     "the start rule")
                                   (ohm/ohm-grammar-rule-has-description?
                                     (mut public)
                                     start-index)))))))]
    (ohm/free-match! (mut accepted))
    (ohm/free-match! (mut spliced))
    (ohm/free-match! (mut rejected))
    (ohm/free-ohm-grammar! (mut public))
    (if valid 0 1)))
