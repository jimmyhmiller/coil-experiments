(module tests.ohm.matcher-runtime)

(import "coil.alloc" :as alloc)
(import "coil.primitive" :as primitive)
(import "coil.slice" :use [slice-get slice-len])
(import "coil.str" :as str)
(import "experiments.ohm.runtime" :as ohm)

(defn grammar-token [] (-> (ptr u8))
  (primitive/alloc-static u8))

(defn parse-sequence [(source (slice u8))
                      (start-rule (slice u8))] (-> ohm/MatchResult)
  (let [(mut state) (ohm/new-parse-state (alloc/malloc-allocator))
        _ (ohm/set-parse-grammar-name! (mut state) "MatcherGrammar")
        _ (ohm/set-parse-grammar-token! (mut state) (grammar-token))
        _ (ohm/add-semantic-rule! (mut state) "start" 4)
        checkpoint (ohm/begin-rule! (mut state))
        a (ohm/match-literal-cst! (mut state) source 0 "a")
        b (if (>= a 0) (ohm/match-literal-cst! (mut state) source a "b") -1)
        c (if (>= b 0) (ohm/match-literal-cst! (mut state) source b "c") -1)
        d (if (>= c 0) (ohm/match-literal-cst! (mut state) source c "d") -1)
        root-end
          (if (>= d 0)
              (ohm/succeed-rule! (mut state) "start" 0 d)
              (ohm/fail-rule! (mut state) checkpoint 0))
        final-end
          (if (and (>= root-end 0) (= root-end (slice-len source)))
              root-end
              (if (>= root-end 0)
                  (do (ohm/expect-end! (mut state) root-end) -1)
                  -1))]
    (ohm/finish-match (mut state) source final-end)))

(defn main [] (-> i64)
  (let [(mut matcher)
          (ohm/new-ohm-matcher (primitive/fnptr-of parse-sequence)
                               "start"
                               (alloc/malloc-allocator))
        first-edit (ohm/matcher-replace-input-range! (mut matcher) 0 0 "ab")
        (mut first) (ohm/matcher-match (mut matcher))
        second-edit (ohm/matcher-replace-input-range! (mut matcher) 0 2 "abcde")
        (mut second) (ohm/matcher-match (mut matcher))
        third-edit (ohm/matcher-replace-input-range! (mut matcher) 4 5 "")
        (mut third) (ohm/matcher-match (mut matcher))
        invalid-edit (ohm/matcher-replace-input-range! (mut matcher) 9 10 "x")
        (mut unicode-matcher)
          (ohm/new-ohm-matcher (primitive/fnptr-of parse-sequence)
                               "start"
                               (alloc/malloc-allocator))
        unicode-insert
          (ohm/matcher-replace-input-range! (mut unicode-matcher) 0 0 "A😀B")
        unicode-replace
          (ohm/matcher-replace-input-range! (mut unicode-matcher) 1 3 "X")
        _
          (ohm/matcher-replace-input-range (mut unicode-matcher) 0 0 "")
        unicode-edit-valid
          (and unicode-insert
               (and unicode-replace
                    (str/str-eq (ohm/matcher-input (mut unicode-matcher)) "AXB")))
        unicode-reset (ohm/matcher-set-input! (mut unicode-matcher) "A😀B")
        split-surrogate-edit
          (ohm/matcher-replace-input-range! (mut unicode-matcher) 1 2 "X")
        split-source (ohm/matcher-input (mut unicode-matcher))
        split-surrogate-valid
          (and unicode-reset
               (and split-surrogate-edit
                    (and (= (slice-len split-source) 6)
                         (and (= (slice-get split-source 0) 65)
                              (and (= (slice-get split-source 1) 88)
                                   (and (= (slice-get split-source 2) 237)
                                        (and (= (slice-get split-source 3) 184)
                                             (and (= (slice-get split-source 4) 128)
                                                  (= (slice-get split-source 5) 66)))))))))
        first-interval (ohm/match-interval (load first))
        root (ohm/match-root (load third))
        child0 (ohm/node-child (load third) root 0)
        child1 (ohm/node-child (load third) root 1)
        child3 (ohm/node-child (load third) root 3)
        (mut valid) true]
    (if (not first-edit) (set! valid false) 0)
    (if (not (= (ohm/match-matcher (load first)) matcher)) (set! valid false) 0)
    (if (not (= (ohm/match-matcher (load second)) matcher)) (set! valid false) 0)
    (if (not (= (ohm/match-matcher (load third)) matcher)) (set! valid false) 0)
    (if (not second-edit) (set! valid false) 0)
    (if (not third-edit) (set! valid false) 0)
    (if invalid-edit (set! valid false) 0)
    (if (not unicode-edit-valid) (set! valid false) 0)
    (if (not split-surrogate-valid) (set! valid false) 0)
    (if (ohm/match-succeeded? (load first)) (set! valid false) 0)
    (if (!= (ohm/match-failure-position (load first)) 2) (set! valid false) 0)
    (if (not (str/str-eq (ohm/match-failure-type-name (load first) 0) "string"))
        (set! valid false)
        0)
    (if (not (ohm/match-failure-is-string-terminal? (load first) 0))
        (set! valid false)
        0)
    (if (ohm/match-failure-is-description? (load first) 0) (set! valid false) 0)
    (if (ohm/match-failure-is-code? (load first) 0) (set! valid false) 0)
    (if (not (str/str-eq (ohm/match-to-string! (mut first))
                         "[match failed at position 2]"))
        (set! valid false)
        0)
    (if (!= (ohm/ohm-interval-start first-interval) 2) (set! valid false) 0)
    (if (!= (ohm/ohm-interval-end first-interval) 2) (set! valid false) 0)
    (if (not (str/str-eq (ohm/match-message (load first))
                         "Line 1, col 3:\n> 1 | ab\n        ^\nExpected \"c\""))
        (set! valid false)
        0)
    (if (ohm/match-succeeded? (load second)) (set! valid false) 0)
    (if (!= (ohm/match-failure-position (load second)) 4) (set! valid false) 0)
    (if (not (str/str-eq (ohm/match-message (load second))
                         "Line 1, col 5:\n> 1 | abcde\n          ^\nExpected end of input"))
        (set! valid false)
        0)
    (if (not (ohm/match-succeeded? (load third))) (set! valid false) 0)
    (if (not (str/str-eq (ohm/match-to-string! (mut third)) "[match succeeded]"))
        (set! valid false)
        0)
    (if (not (ohm/node-has-children? (load third) root)) (set! valid false) 0)
    (if (ohm/node-has-no-children? (load third) root) (set! valid false) 0)
    (if (!= (ohm/node-first-child (load third) root) child0) (set! valid false) 0)
    (if (!= (ohm/node-last-child (load third) root) child3) (set! valid false) 0)
    (if (!= (ohm/node-index-of-child (load third) root child1) 1) (set! valid false) 0)
    (if (!= (ohm/node-child-before (load third) root child1) child0) (set! valid false) 0)
    (if (!= (ohm/node-child-after (load third) root child1)
            (ohm/node-child (load third) root 2))
        (set! valid false)
        0)
    (if (!= (ohm/node-only-child (load third) root) -1) (set! valid false) 0)
    (if (!= (ohm/node-only-child (load third) child0) -1) (set! valid false) 0)
    (ohm/free-match! (mut first))
    (ohm/free-match! (mut second))
    (ohm/free-match! (mut third))
    (ohm/free-ohm-matcher! (mut matcher))
    (ohm/free-ohm-matcher! (mut unicode-matcher))
    (if (load valid) 0 1)))
