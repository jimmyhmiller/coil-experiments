(module tests.ohm.start-application-runtime)

(import "coil.alloc" :as alloc)
(import "coil.str" :as str)
(import "experiments.ohm.runtime" :as ohm)

(defn main [] (-> i64)
  (let [(mut state) (ohm/new-parse-state (alloc/malloc-allocator))
        prepared
          (ohm/prepare-start-application! (mut state)
                                          " /* leading */ App< /* arg */ \"\\x61\" /* end arg */ > // trailing\n"
                                          "App"
                                          1)
        valid
          (and prepared
               (and (ohm/start-rule-eq? " /* before */ Start // after\n" "Start")
                    (and (not (ohm/start-rule-eq? " Startx " "Start"))
                         (and (not (ohm/start-application-syntactic? " app<\"a\"> "))
                              (and (ohm/start-application-syntactic? " Start ")
                                   (str/str-eq (ohm/start-argument-text (mut state) 0) "a"))))))]
    (let [(mut result) (ohm/finish-match (mut state) "" -1)]
      (ohm/free-match! (mut result))
      (if valid 0 1))))
