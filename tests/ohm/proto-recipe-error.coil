(module tests.ohm.proto-recipe-error)

(import "coil.alloc" :as alloc)
(import "coil.primitive" :as primitive)
(import "coil.primitive" :use [fnptr-of cast])
(import "experiments.ohm.pexprs" :as pexprs)
(import "experiments.ohm.runtime" :as ohm)

(defn dummy-parse [(input (slice u8)) (start-rule (slice u8))]
                  (-> ohm/MatchResult)
  (primitive/zeroed ohm/MatchResult))

(defn dummy-incremental-parse [(input (slice u8))
                              (start-rule (slice u8))
                              (trace bool)
                              (cache (mut ohm/ParseCache))]
                              (-> ohm/MatchResult)
  (primitive/zeroed ohm/MatchResult))

(defn grammar-token [] (-> (ptr u8))
  (cast (ptr u8) (fnptr-of grammar-token)))

(defn main [] (-> i64)
  (let [(mut grammar)
          (ohm/new-ohm-grammar
            (ohm/new-ohm-grammar-descriptor
              "ProtoBuiltInRules" "" "" "ProtoBuiltInRules")
            (pexprs/new-proto-built-in-pexprs (alloc/malloc-allocator))
            (fnptr-of dummy-parse)
            (fnptr-of dummy-incremental-parse)
            "" "" (ohm/ohm-proto-built-in-action-dictionary-template)
            (grammar-token) false (alloc/malloc-allocator))]
    (ohm/ohm-grammar-recipe (mut grammar))
    1))
