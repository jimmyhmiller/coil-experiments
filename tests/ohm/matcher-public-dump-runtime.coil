(module tests.ohm.matcher-public-dump-runtime)

(import "coil.io" :as io)
(import "experiments.ohm.runtime" :as ohm)

(build-ohm-grammar
  (grammars
    (grammar G
      (withDefaultStartRule basic)
      (define basic [] (seq (star (app notLastLetter)) (app letter)))
      (define notLastLetter [] (seq (app letter) (lookahead (app letter))))
      (define tricky []
        (alt (seq (app tricky) (app letter))
             (seq (app lookaheadRule) (terminal ""))
             (seq (terminal "a") (terminal ""))))
      (define lookaheadRule []
        (seq (lookahead (terminal "ac")) (terminal "a"))))))

(defn emit [(label (slice u8))
            (matcher (mut ohm/OhmMatcher))
            (result (mut ohm/MatchResult))] (-> i64)
  (io/print-str (io/stdout) label)
  (io/print-str (io/stdout) "|")
  (io/print-str (io/stdout) (ohm/matcher-input matcher))
  (io/print-str (io/stdout) "|")
  (io/print-str (io/stdout)
                (if (ohm/match-succeeded? (load result)) "ok|" "fail|"))
  (if (ohm/match-succeeded? (load result))
      (ohm/print-match-cst-signature (load result))
      (do
        (io/print-int (io/stdout) (ohm/match-failure-position (load result)))
        (io/print-str (io/stdout) "|")
        (io/write-line (io/stdout) (ohm/match-expected-text (load result)))
        0))
  0)

(defn main [] (-> i64)
  (let [(mut grammar) (grammar-object)
        (mut matcher) (ohm/ohm-grammar-matcher (mut grammar))
        _ (ohm/matcher-replace-input-range (mut matcher) 0 0 "helloworld")
        _ (ohm/matcher-replace-input-range (mut matcher) 3 5 "X")
        (mut first) (ohm/matcher-match (mut matcher))
        _ (emit "basic-1" (mut matcher) (mut first))
        _ (ohm/matcher-replace-input-range (mut matcher) 0 4 "")
        (mut second) (ohm/matcher-match-from (mut matcher) "basic")
        _ (emit "basic-2" (mut matcher) (mut second))
        _ (ohm/matcher-replace-input-range (mut matcher) 3 4 " ")
        (mut third) (ohm/matcher-match (mut matcher))
        _ (emit "basic-3" (mut matcher) (mut third))
        _ (ohm/matcher-replace-input-range (mut matcher) 0 4 "aa")
        (mut fourth) (ohm/matcher-match (mut matcher))
        _ (emit "basic-4" (mut matcher) (mut fourth))
        _ (ohm/matcher-replace-input-range (mut matcher) 1 2 "9")
        (mut fifth) (ohm/matcher-match (mut matcher))
        _ (emit "basic-5" (mut matcher) (mut fifth))
        _ (ohm/matcher-set-input! (mut matcher) "ab")
        (mut tricky-one) (ohm/matcher-match-from (mut matcher) "tricky")
        _ (emit "tricky-1" (mut matcher) (mut tricky-one))
        _ (ohm/matcher-replace-input-range (mut matcher) 1 2 "c")
        (mut tricky-two) (ohm/matcher-match-from (mut matcher) "tricky")
        _ (emit "tricky-2" (mut matcher) (mut tricky-two))]
    (ohm/free-match! (mut first))
    (ohm/free-match! (mut second))
    (ohm/free-match! (mut third))
    (ohm/free-match! (mut fourth))
    (ohm/free-match! (mut fifth))
    (ohm/free-match! (mut tricky-one))
    (ohm/free-match! (mut tricky-two))
    (ohm/free-ohm-matcher! (mut matcher))
    (ohm/free-ohm-grammar! (mut grammar))
    0))
