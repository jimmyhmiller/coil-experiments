(module tests.ohm.line-column-runtime)

(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "coil.str" :as str)
(import "experiments.ohm.runtime" :as ohm)

(defn message-eq? [(source (slice u8))
                   (position i64)
                   (ranges (slice ohm/OhmSourceRange))
                   (expected (slice u8))] (-> bool)
  (str/str-eq
    (ohm/get-line-and-column-message!
      (alloc/malloc-allocator) source position ranges)
    expected))

(defn main [] (-> i64)
  (let [(mut none) (al/al-new [ohm/OhmSourceRange] (alloc/malloc-allocator))
        (mut one) (al/al-new [ohm/OhmSourceRange] (alloc/malloc-allocator))
        _ (push! (mut one) (ohm/new-ohm-source-range 0 1))
        (mut two) (al/al-new [ohm/OhmSourceRange] (alloc/malloc-allocator))
        _ (push! (mut two) (ohm/new-ohm-source-range 0 1))
        _ (push! (mut two) (ohm/new-ohm-source-range 4 5))
        (mut wide) (al/al-new [ohm/OhmSourceRange] (alloc/malloc-allocator))
        _ (push! (mut wide) (ohm/new-ohm-source-range 0 100))
        (mut empty-range) (al/al-new [ohm/OhmSourceRange] (alloc/malloc-allocator))
        _ (push! (mut empty-range) (ohm/new-ohm-source-range 0 0))
        (mut overlap) (al/al-new [ohm/OhmSourceRange] (alloc/malloc-allocator))
        _ (push! (mut overlap) (ohm/new-ohm-source-range 0 3))
        _ (push! (mut overlap) (ohm/new-ohm-source-range 1 5))
        (mut second-line) (al/al-new [ohm/OhmSourceRange] (alloc/malloc-allocator))
        _ (push! (mut second-line) (ohm/new-ohm-source-range 5 6))
        (mut crossing) (al/al-new [ohm/OhmSourceRange] (alloc/malloc-allocator))
        _ (push! (mut crossing) (ohm/new-ohm-source-range 0 6))
        (mut crossing-wide)
          (al/al-new [ohm/OhmSourceRange] (alloc/malloc-allocator))
        _ (push! (mut crossing-wide) (ohm/new-ohm-source-range 0 50))
        (mut interval-ranges)
          (al/al-new [ohm/OhmSourceRange] (alloc/malloc-allocator))
        _ (push! (mut interval-ranges) (ohm/new-ohm-source-range 7 8))
        _ (push! (mut interval-ranges) (ohm/new-ohm-source-range 9 10))
        (mut astral-range) (al/al-new [ohm/OhmSourceRange] (alloc/malloc-allocator))
        _ (push! (mut astral-range) (ohm/new-ohm-source-range 0 2))
        (mut many-lines) (str/sb-new (alloc/malloc-allocator))
        _ (for [_ 0 98] (str/sb-push-str! (mut many-lines) "\n"))
        _ (str/sb-push-str! (mut many-lines) "hi!\n")
        many-lines-source (str/sb-finish! (mut many-lines))
        valid
          (and (message-eq? ""
                            0
                            (al/al-slice [ohm/OhmSourceRange] (load none))
                            "Line 1, col 1:\n> 1 | \n      ^\n")
               (and (message-eq? "3 + 4"
                                 2
                                 (al/al-slice [ohm/OhmSourceRange] (load two))
                                 "Line 1, col 3:\n> 1 | 3 + 4\n      ~ ^ ~\n")
                    (and (message-eq? "\r\n"
                                      1
                                      (al/al-slice [ohm/OhmSourceRange] (load none))
                                      "Line 1, col 1:\n> 1 | \n      ^\n  2 | \n")
                         (and (message-eq? "3 + 4"
                                           2
                                           (al/al-slice [ohm/OhmSourceRange] (load one))
                                           "Line 1, col 3:\n> 1 | 3 + 4\n      ~ ^\n")
                              (and (message-eq? "3 + 4"
                                                2
                                                (al/al-slice [ohm/OhmSourceRange]
                                                  (load wide))
                                                "Line 1, col 3:\n> 1 | 3 + 4\n      ~~^~~\n")
                                   (and (message-eq? "3 + 4"
                                                     2
                                                     (al/al-slice [ohm/OhmSourceRange]
                                                       (load empty-range))
                                                     "Line 1, col 3:\n> 1 | 3 + 4\n        ^\n")
                                        (and (message-eq? "3 + 4"
                                                          0
                                                          (al/al-slice [ohm/OhmSourceRange]
                                                            (load overlap))
                                                          "Line 1, col 1:\n> 1 | 3 + 4\n      ^~~~~\n")
                                             (and (message-eq? "blah\n3 + 4"
                                                               7
                                                               (al/al-slice [ohm/OhmSourceRange]
                                                                 (load second-line))
                                                               "Line 2, col 3:\n  1 | blah\n> 2 | 3 + 4\n      ~ ^\n")
                                                  (and (message-eq? "blah\n3 + 4"
                                                                    7
                                                                    (al/al-slice [ohm/OhmSourceRange]
                                                                      (load crossing))
                                                                    "Line 2, col 3:\n  1 | blah\n> 2 | 3 + 4\n      ~ ^\n")
                                                       (and (message-eq? "blah\n3 + 4"
                                                                         7
                                                                         (al/al-slice [ohm/OhmSourceRange]
                                                                           (load crossing-wide))
                                                                         "Line 2, col 3:\n  1 | blah\n> 2 | 3 + 4\n      ~~^~~\n")
                                                            (message-eq? "blah\n3 + 4"
                                                                         5
                                                                         (al/al-slice [ohm/OhmSourceRange]
                                                                           (load interval-ranges))
                                                                         "Line 2, col 1:\n  1 | blah\n> 2 | 3 + 4\n      ^ ~ ~\n")))))))))))
        diagnostic
          (cond (not (message-eq? "" 0
                                   (al/al-slice [ohm/OhmSourceRange] (load none))
                                   "Line 1, col 1:\n> 1 | \n      ^\n")) 1
                (not (message-eq? "3 + 4" 2
                                   (al/al-slice [ohm/OhmSourceRange] (load two))
                                   "Line 1, col 3:\n> 1 | 3 + 4\n      ~ ^ ~\n")) 2
                (not (message-eq? "\r\n" 1
                                   (al/al-slice [ohm/OhmSourceRange] (load none))
                                   "Line 1, col 1:\n> 1 | \n      ^\n  2 | \n")) 3
                (not valid) 99
                :else 0)
        context-valid
          (and (message-eq? "a\nfoo\n"
                            2
                            (al/al-slice [ohm/OhmSourceRange] (load none))
                            "Line 2, col 1:\n  1 | a\n> 2 | foo\n      ^\n  3 | \n")
               (and (message-eq? "a\r\nfoo\r\n"
                                 3
                                 (al/al-slice [ohm/OhmSourceRange] (load none))
                                 "Line 2, col 1:\n  1 | a\n> 2 | foo\n      ^\n  3 | \n")
                    (and (message-eq? "\n"
                                      1
                                      (al/al-slice [ohm/OhmSourceRange] (load none))
                                      "Line 2, col 1:\n  1 | \n> 2 | \n      ^\n")
                         (and (message-eq? "a\n\n"
                                           0
                                           (al/al-slice [ohm/OhmSourceRange] (load none))
                                           "Line 1, col 1:\n> 1 | a\n      ^\n  2 | \n")
                              (and (message-eq? "\n\n\n\n\n\n\n\na\nhi!\nb"
                                                10
                                                (al/al-slice [ohm/OhmSourceRange] (load none))
                                                "Line 10, col 1:\n   9 | a\n> 10 | hi!\n       ^\n  11 | b\n")
                                   (and (message-eq? many-lines-source
                                                     98
                                                     (al/al-slice [ohm/OhmSourceRange] (load none))
                                                     "Line 99, col 1:\n   98 | \n>  99 | hi!\n        ^\n  100 | \n")
                                        (message-eq? "x"
                                                     0
                                                     (al/al-slice [ohm/OhmSourceRange] (load none))
                                                     "Line 1, col 1:\n> 1 | x\n      ^\n")))))))
        astral-valid
          (and (message-eq? "😀x"
                            2
                            (al/al-slice [ohm/OhmSourceRange] (load none))
                            "Line 1, col 3:\n> 1 | 😀x\n        ^\n")
               (message-eq? "😀x"
                            2
                            (al/al-slice [ohm/OhmSourceRange] (load astral-range))
                            "Line 1, col 3:\n> 1 | 😀x\n      ~~^\n"))
        context-diagnostic
          (cond (not (message-eq? "a\nfoo\n" 2
                                   (al/al-slice [ohm/OhmSourceRange] (load none))
                                   "Line 2, col 1:\n  1 | a\n> 2 | foo\n      ^\n  3 | \n")) 11
                (not (message-eq? "a\r\nfoo\r\n" 3
                                   (al/al-slice [ohm/OhmSourceRange] (load none))
                                   "Line 2, col 1:\n  1 | a\n> 2 | foo\n      ^\n  3 | \n")) 12
                (not (message-eq? "\n" 1
                                   (al/al-slice [ohm/OhmSourceRange] (load none))
                                   "Line 2, col 1:\n  1 | \n> 2 | \n      ^\n")) 13
                (not (message-eq? "a\n\n" 0
                                   (al/al-slice [ohm/OhmSourceRange] (load none))
                                   "Line 1, col 1:\n> 1 | a\n      ^\n  2 | \n")) 14
                (not (message-eq? "\n\n\n\n\n\n\n\na\nhi!\nb" 10
                                   (al/al-slice [ohm/OhmSourceRange] (load none))
                                   "Line 10, col 1:\n   9 | a\n> 10 | hi!\n       ^\n  11 | b\n")) 15
                (not (message-eq? many-lines-source 98
                                   (al/al-slice [ohm/OhmSourceRange] (load none))
                                   "Line 99, col 1:\n   98 | \n>  99 | hi!\n        ^\n  100 | \n")) 16
                (not (message-eq? "x" 0
                                   (al/al-slice [ohm/OhmSourceRange] (load none))
                                   "Line 1, col 1:\n> 1 | x\n      ^\n")) 17
                :else 0)]
    (al/al-free! (mut none))
    (al/al-free! (mut one))
    (al/al-free! (mut two))
    (al/al-free! (mut wide))
    (al/al-free! (mut empty-range))
    (al/al-free! (mut overlap))
    (al/al-free! (mut second-line))
    (al/al-free! (mut crossing))
    (al/al-free! (mut crossing-wide))
    (al/al-free! (mut interval-ranges))
    (al/al-free! (mut astral-range))
    (if (not astral-valid) 18
        (if (not context-valid) context-diagnostic diagnostic))))
