(module tests.ohm.example-math-semantics-runtime)

(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "coil.primitive" :as primitive)
(import "coil.slice" :use [slice-get slice-len])
(import "coil.str" :as str)
(import "experiments.ohm.runtime" :as ohm)

(build-ohm-grammar
  (grammars
    (grammar Arithmetic
      (withDefaultStartRule Exp)
      (define Exp [] (app AddExp))
      (define AddExp_plus [] (seq (app AddExp) (terminal "+") (app MulExp)))
      (define AddExp_minus [] (seq (app AddExp) (terminal "-") (app MulExp)))
      (define AddExp [] (alt (app AddExp_plus) (app AddExp_minus) (app MulExp)))
      (define MulExp_times [] (seq (app MulExp) (terminal "*") (app ExpExp)))
      (define MulExp_divide [] (seq (app MulExp) (terminal "/") (app ExpExp)))
      (define MulExp [] (alt (app MulExp_times) (app MulExp_divide) (app ExpExp)))
      (define ExpExp_power [] (seq (app PriExp) (terminal "^") (app ExpExp)))
      (define ExpExp [] (alt (app ExpExp_power) (app PriExp)))
      (define PriExp_paren [] (seq (terminal "(") (app Exp) (terminal ")")))
      (define PriExp_pos [] (seq (terminal "+") (app PriExp)))
      (define PriExp_neg [] (seq (terminal "-") (app PriExp)))
      (define PriExp [] (alt (app PriExp_paren) (app PriExp_pos) (app PriExp_neg)
                             (app ident) (app number)))
      (define ident [] "an identifier" (seq (app letter) (star (app alnum))))
      (define number_fract [] (seq (star (app digit)) (terminal ".") (plus (app digit))))
      (define number_whole [] (plus (app digit)))
      (define number [] "a number" (alt (app number_fract) (app number_whole))))))

(defn decimal-node [(result (ptr ohm/MatchResult)) (node i64)] (-> i64)
  (let [text (ohm/node-source-string (load result) node)
        (mut value) 0]
    (for [index 0 (slice-len text)]
      (let [byte (primitive/cast i64 (slice-get text index))]
        (if (and (>= byte 48) (<= byte 57))
            (set! value (+ (* (load value) 10) (- byte 48)))
            0)))
    (load value)))

(defn integer-power [(base i64) (exponent i64)] (-> i64)
  (let [(mut result) 1]
    (for [_ 0 exponent] (set! result (* (load result) base)))
    (load result)))

(defn semantic-child [(evaluation (mut ohm/SemanticEvaluation))
                      (node i64)
                      (index i64)
                      (arguments (slice i64))] (-> i64)
  (ohm/evaluate-semantic-child! (mut evaluation) node index arguments))

(defstruct MathInterpretAction [(token (ptr u8))])

(impl ohm/OhmLazySemanticAction MathInterpretAction
  (semantic-grammar-name [(self (ptr MathInterpretAction))] (-> (slice u8)) "Arithmetic")
  (semantic-grammar-token [(self (ptr MathInterpretAction))] (-> (ptr u8)) (.token self))
  (semantic-formal-count [(self (ptr MathInterpretAction))] (-> i64) 0)
  (semantic-action-kind [(self (ptr MathInterpretAction))
                         (result (ptr ohm/MatchResult))
                         (node i64)] (-> i64)
    (let [name (ohm/node-rule (load result) node)]
      (if (or (str/str-eq name "AddExp_plus")
              (or (str/str-eq name "AddExp_minus")
                  (or (str/str-eq name "MulExp_times")
                      (or (str/str-eq name "MulExp_divide")
                          (or (str/str-eq name "ExpExp_power")
                              (or (str/str-eq name "PriExp_paren")
                                  (or (str/str-eq name "PriExp_pos")
                                      (or (str/str-eq name "PriExp_neg")
                                          (str/str-eq name "number")))))))))
          1
          0)))
  (apply-lazy-semantic-action [(self (ptr MathInterpretAction))
                               (evaluation (mut ohm/SemanticEvaluation))
                               (node i64)
                               (kind i64)
                               (arguments (slice i64))] (-> i64)
    (let [result (.result evaluation)
          name (ohm/node-rule (load result) node)]
      (cond (str/str-eq name "AddExp_plus")
              (+ (semantic-child (mut evaluation) node 0 arguments)
                 (semantic-child (mut evaluation) node 2 arguments))
            (str/str-eq name "AddExp_minus")
              (- (semantic-child (mut evaluation) node 0 arguments)
                 (semantic-child (mut evaluation) node 2 arguments))
            (str/str-eq name "MulExp_times")
              (* (semantic-child (mut evaluation) node 0 arguments)
                 (semantic-child (mut evaluation) node 2 arguments))
            (str/str-eq name "MulExp_divide")
              (/ (semantic-child (mut evaluation) node 0 arguments)
                 (semantic-child (mut evaluation) node 2 arguments))
            (str/str-eq name "ExpExp_power")
              (integer-power (semantic-child (mut evaluation) node 0 arguments)
                             (semantic-child (mut evaluation) node 2 arguments))
            (str/str-eq name "PriExp_paren")
              (semantic-child (mut evaluation) node 1 arguments)
            (str/str-eq name "PriExp_pos")
              (semantic-child (mut evaluation) node 1 arguments)
            (str/str-eq name "PriExp_neg")
              (- 0 (semantic-child (mut evaluation) node 1 arguments))
            :else (decimal-node result node)))))

(defn lisp-node [(opcode i64) (left i64) (right i64)] (-> i64)
  (+ (* opcode 100000000) (+ (* left 10000) right)))

(defstruct MathLispAttribute [(calls (ptr i64)) (token (ptr u8))])

(impl ohm/OhmLazySemanticAction MathLispAttribute
  (semantic-grammar-name [(self (ptr MathLispAttribute))] (-> (slice u8)) "Arithmetic")
  (semantic-grammar-token [(self (ptr MathLispAttribute))] (-> (ptr u8)) (.token self))
  (semantic-formal-count [(self (ptr MathLispAttribute))] (-> i64) 0)
  (semantic-action-kind [(self (ptr MathLispAttribute))
                         (result (ptr ohm/MatchResult))
                         (node i64)] (-> i64)
    (let [name (ohm/node-rule (load result) node)]
      (if (or (str/str-eq name "AddExp_plus")
              (or (str/str-eq name "MulExp_times") (str/str-eq name "number")))
          1
          0)))
  (apply-lazy-semantic-action [(self (ptr MathLispAttribute))
                               (evaluation (mut ohm/SemanticEvaluation))
                               (node i64)
                               (kind i64)
                               (arguments (slice i64))] (-> i64)
    (do
      (store! (.calls self) (+ (load (.calls self)) 1))
      (let [result (.result evaluation)
            name (ohm/node-rule (load result) node)]
        (cond (str/str-eq name "AddExp_plus")
                (lisp-node 1
                           (semantic-child (mut evaluation) node 0 arguments)
                           (semantic-child (mut evaluation) node 2 arguments))
              (str/str-eq name "MulExp_times")
                (lisp-node 2
                           (semantic-child (mut evaluation) node 0 arguments)
                           (semantic-child (mut evaluation) node 2 arguments))
              :else (+ 1000 (decimal-node result node)))))))

(defn main [] (-> i64)
  (let [(mut match) (parse-tree "33 * 5 + 100")
        interpret (primitive/alloc-stack MathInterpretAction)
        _ (store! (field interpret token) (ohm/match-grammar-token (load match)))
        calls (primitive/alloc-stack i64)
        _ (store! calls 0)
        lisp (primitive/alloc-stack MathLispAttribute)
        _ (store! (field lisp calls) calls)
        _ (store! (field lisp token) (ohm/match-grammar-token (load match)))
        (mut no-arguments) (al/al-new [i64] (alloc/malloc-allocator))
        (mut interpret-evaluation) (ohm/new-semantic-evaluation interpret (mut match) false)
        value (ohm/evaluate-semantic-root! (mut interpret-evaluation)
                                            (al/al-slice [i64] (load no-arguments)))
        (mut lisp-evaluation) (ohm/new-semantic-evaluation lisp (mut match) true)
        lisp-value (ohm/evaluate-semantic-root! (mut lisp-evaluation)
                                                 (al/al-slice [i64] (load no-arguments)))
        calls-after-first (load calls)
        lisp-again (ohm/evaluate-semantic-root! (mut lisp-evaluation)
                                                 (al/al-slice [i64] (load no-arguments)))
        expected-lisp (lisp-node 1 (lisp-node 2 1033 1005) 1100)
        valid (and (ohm/match-succeeded? (load match))
                   (and (= value 265)
                        (and (= lisp-value expected-lisp)
                             (and (= lisp-again expected-lisp)
                                  (= calls-after-first (load calls))))))]
    (ohm/free-semantic-evaluation! (mut interpret-evaluation))
    (ohm/free-semantic-evaluation! (mut lisp-evaluation))
    (al/al-free! (mut no-arguments))
    (ohm/free-match! (mut match))
    (if valid 0 1)))
