(module tests.ohm.interval-input-runtime)

(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "coil.primitive" :as primitive)
(import "coil.slice" :use [slice-get slice-len])
(import "coil.str" :as str)
(import "experiments.ohm.runtime" :as ohm)

(defn interval-eq? [(interval ohm/OhmInterval)
                    (start i64)
                    (end i64)
                    (contents (slice u8))] (-> bool)
  (and (ohm/ohm-interval-valid? interval)
       (and (= (ohm/ohm-interval-start interval) start)
            (and (= (ohm/ohm-interval-end interval) end)
                 (str/str-eq (ohm/ohm-interval-contents interval) contents)))))

(defn interval-at-eq? [(intervals (ptr (al/ArrayList ohm/OhmInterval)))
                       (index i64)
                       (start i64)
                       (end i64)
                       (contents (slice u8))] (-> bool)
  (and (< index (len (load intervals)))
       (interval-eq? (get (load intervals) index) start end contents)))

(defn optional-text-eq? [(value (Option (slice u8)))
                         (expected (slice u8))] (-> bool)
  (match value
    (Some [text] (str/str-eq text expected))
    (None [] false)))

(defn optional-text-empty? [(value (Option (slice u8)))] (-> bool)
  (match value (Some [_] false) (None [] true)))

(defn main [] (-> i64)
  (let [(mut stream) (ohm/new-ohm-input-stream "")
        hello-source "hello world"
        stream-valid
          (and (ohm/ohm-input-stream-at-end? (mut stream))
               (and (= (ohm/ohm-input-stream-next! (mut stream)) -1)
                    (and (ohm/ohm-input-stream-at-end? (mut stream))
                         (and (= (ohm/ohm-input-stream-position (mut stream)) 1)
                              (= (ohm/ohm-input-stream-examined-length (mut stream)) 2)))))
        (mut units) (ohm/new-ohm-input-stream "😀")
        high (ohm/ohm-input-stream-next! (mut units))
        between-end (ohm/ohm-input-stream-at-end? (mut units))
        low (ohm/ohm-input-stream-next-char-code! (mut units))
        units-end (ohm/ohm-input-stream-at-end? (mut units))
        (mut points) (ohm/new-ohm-input-stream "😀")
        point (ohm/ohm-input-stream-next-code-point! (mut points))
        point-end (ohm/ohm-input-stream-at-end? (mut points))
        unicode-stream-valid
          (and (= high 55357)
               (and (not between-end)
                    (and (= low 56832)
                         (and units-end
                              (and (= point 128512)
                                   (and point-end
                                        (= (ohm/ohm-input-stream-position (mut points))
                                           2)))))))
        (mut string-stream) (ohm/new-ohm-input-stream "Ab😀z")
        string-first (ohm/ohm-input-stream-match-string! (mut string-stream) "aB" true)
        string-second (ohm/ohm-input-stream-match-string! (mut string-stream) "😀" false)
        string-slice (ohm/ohm-input-stream-source-slice (mut string-stream) 2 4)
        high-slice (ohm/ohm-input-stream-source-slice (mut string-stream) 2 3)
        low-slice (ohm/ohm-input-stream-source-slice (mut string-stream) 3 4)
        negative-slice (ohm/ohm-input-stream-source-slice (mut string-stream) -3 -1)
        string-interval (ohm/ohm-input-stream-interval-from (mut string-stream) 2)
        truthy-end-interval (ohm/ohm-input-stream-interval (mut string-stream) 1 0)
        high-slice-valid
          (and (= (slice-len high-slice) 3)
               (and (= (primitive/cast i64 (slice-get high-slice 0)) 237)
                    (and (= (primitive/cast i64 (slice-get high-slice 1)) 160)
                         (= (primitive/cast i64 (slice-get high-slice 2)) 189))))
        low-slice-valid
          (and (= (slice-len low-slice) 3)
               (and (= (primitive/cast i64 (slice-get low-slice 0)) 237)
                    (and (= (primitive/cast i64 (slice-get low-slice 1)) 184)
                         (= (primitive/cast i64 (slice-get low-slice 2)) 128))))
        interval-high-contents
          (ohm/ohm-interval-contents (ohm/new-ohm-interval "😀" 0 1))
        interval-low-contents
          (ohm/ohm-interval-contents (ohm/new-ohm-interval "😀" 1 2))
        interval-split-valid
          (and (= (slice-len interval-high-contents) 3)
               (and (= (primitive/cast i64 (slice-get interval-high-contents 0)) 237)
                    (and (= (primitive/cast i64 (slice-get interval-high-contents 1)) 160)
                         (and (= (primitive/cast i64 (slice-get interval-high-contents 2)) 189)
                              (and (= (slice-len interval-low-contents) 3)
                                   (and (= (primitive/cast i64
                                             (slice-get interval-low-contents 0))
                                           237)
                                        (and (= (primitive/cast i64
                                                  (slice-get interval-low-contents 1))
                                                184)
                                             (= (primitive/cast i64
                                                  (slice-get interval-low-contents 2))
                                                128))))))))
        string-stream-valid
          (and string-first
               (and string-second
                    (and (str/str-eq string-slice "😀")
                         (and high-slice-valid
                              (and low-slice-valid
                                   (and interval-split-valid
                                   (and (= (ohm/ohm-interval-end truthy-end-interval) 4)
                                   (and (str/str-eq negative-slice "😀")
                                        (and (= (ohm/ohm-interval-start string-interval) 2)
                                             (and (= (ohm/ohm-interval-end string-interval) 4)
                                                  (str/str-eq
                                                    (ohm/ohm-interval-contents string-interval)
                                                    "😀")))))))))))
        interval (ohm/new-ohm-interval hello-source 0 5)
        collapsed-left (ohm/ohm-interval-collapsed-left interval)
        collapsed-right (ohm/ohm-interval-collapsed-right interval)
        original-valid (interval-eq? interval 0 5 "hello")
        collapsed-valid
          (and (interval-eq? collapsed-left 0 0 "")
               (interval-eq? collapsed-right 5 5 ""))
        (mut one) (al/al-new [ohm/OhmInterval] (alloc/malloc-allocator))
        _ (push! (mut one) interval)
        coverage-one
          (ohm/ohm-interval-coverage (al/al-slice [ohm/OhmInterval] (load one)))
        (mut adjacent) (al/al-new [ohm/OhmInterval] (alloc/malloc-allocator))
        _ (push! (mut adjacent) (ohm/new-ohm-interval hello-source 2 5))
        _ (push! (mut adjacent) (ohm/new-ohm-interval hello-source 0 2))
        coverage-adjacent
          (ohm/ohm-interval-coverage
            (al/al-slice [ohm/OhmInterval] (load adjacent)))
        (mut non-adjacent)
          (al/al-new [ohm/OhmInterval] (alloc/malloc-allocator))
        _ (push! (mut non-adjacent) (ohm/new-ohm-interval hello-source 0 2))
        _ (push! (mut non-adjacent) (ohm/new-ohm-interval hello-source 4 5))
        coverage-non-adjacent
          (ohm/ohm-interval-coverage
            (al/al-slice [ohm/OhmInterval] (load non-adjacent)))
        (mut nested) (al/al-new [ohm/OhmInterval] (alloc/malloc-allocator))
        _ (push! (mut nested) interval)
        _ (push! (mut nested) (ohm/new-ohm-interval hello-source 3 4))
        coverage-nested
          (ohm/ohm-interval-coverage
            (al/al-slice [ohm/OhmInterval] (load nested)))
        (mut more) (al/al-new [ohm/OhmInterval] (alloc/malloc-allocator))
        _ (push! (mut more) (ohm/new-ohm-interval hello-source 0 2))
        _ (push! (mut more) (ohm/new-ohm-interval hello-source 3 4))
        _ (push! (mut more) (ohm/new-ohm-interval hello-source 6 10))
        coverage-more
          (ohm/ohm-interval-coverage
            (al/al-slice [ohm/OhmInterval] (load more)))
        coverage-with
          (ohm/ohm-interval-coverage-with
            (ohm/new-ohm-interval hello-source 0 2)
            (al/al-slice [ohm/OhmInterval] (load more)))
        (mut equal-source-builder) (str/sb-new (alloc/malloc-allocator))
        _ (str/sb-push-str! (mut equal-source-builder) "abc")
        equal-source-copy (str/sb-finish! (mut equal-source-builder))
        (mut equal-sources)
          (al/al-new [ohm/OhmInterval] (alloc/malloc-allocator))
        _ (push! (mut equal-sources) (ohm/new-ohm-interval "abc" 0 1))
        _ (push! (mut equal-sources)
                 (ohm/new-ohm-interval equal-source-copy 1 3))
        equal-source-coverage
          (ohm/ohm-interval-coverage
            (al/al-slice [ohm/OhmInterval] (load equal-sources)))
        line-interval (ohm/new-ohm-interval "blah\n3 + 4" 5 6)
        line-info (ohm/ohm-interval-line-column line-interval)
        interval-line-message
          (ohm/ohm-interval-line-column-message!
            (alloc/malloc-allocator)
            line-interval)
        empty-next-info
          (ohm/ohm-interval-line-column
            (ohm/new-ohm-interval "line\n" 0 0))
        carriage-info
          (ohm/ohm-interval-line-column
            (ohm/new-ohm-interval "a\rb" 2 2))
        line-option-valid
          (and (optional-text-eq?
                 (ohm/line-column-previous-line "blah\n3 + 4" line-info)
                 "blah")
               (and (optional-text-empty?
                      (ohm/line-column-next-line "blah\n3 + 4" line-info))
                    (and (optional-text-empty?
                           (ohm/line-column-previous-line "line\n" empty-next-info))
                         (and (optional-text-eq?
                                (ohm/line-column-next-line "line\n" empty-next-info)
                                "")
                              (and (= (ohm/line-column-line carriage-info) 1)
                                   (and (= (ohm/line-column-column carriage-info) 2)
                                        (str/str-eq
                                          (ohm/line-column-line-text
                                            "a\rb"
                                            carriage-info)
                                          "a\rb")))))))
        line-valid
          (and (= (ohm/line-column-line line-info) 2)
               (and (= (ohm/line-column-column line-info) 1)
                    (and (= (ohm/line-column-offset line-info) 5)
                         (and (str/str-eq
                                (ohm/line-column-line-text "blah\n3 + 4" line-info)
                                "3 + 4")
                              (and (str/str-eq
                                     (ohm/line-column-previous-line-text
                                       "blah\n3 + 4"
                                       line-info)
                                     "blah")
                                   (and (str/str-eq
                                          (ohm/line-column-next-line-text
                                            "blah\n3 + 4"
                                            line-info)
                                          "")
                                        (str/str-eq
                                          interval-line-message
                                          "Line 2, col 1:\n  1 | blah\n> 2 | 3 + 4\n      ^\n")))))))
        shared-source "0123456789"
        (mut minus-equal)
          (ohm/ohm-interval-minus (ohm/new-ohm-interval shared-source 2 8)
                                   (ohm/new-ohm-interval shared-source 2 8))
        (mut minus-split)
          (ohm/ohm-interval-minus (ohm/new-ohm-interval shared-source 2 8)
                                   (ohm/new-ohm-interval shared-source 4 6))
        (mut minus-prefix)
          (ohm/ohm-interval-minus (ohm/new-ohm-interval shared-source 2 8)
                                   (ohm/new-ohm-interval shared-source 0 5))
        (mut minus-suffix)
          (ohm/ohm-interval-minus (ohm/new-ohm-interval shared-source 2 8)
                                   (ohm/new-ohm-interval shared-source 6 10))
        (mut minus-disjoint)
          (ohm/ohm-interval-minus (ohm/new-ohm-interval shared-source 2 5)
                                   (ohm/new-ohm-interval shared-source 5 8))
        minus-valid
          (and (= (len (load minus-equal)) 0)
               (and (= (len (load minus-split)) 2)
                    (and (interval-at-eq? (mut minus-split) 0 2 4 "23")
                         (and (interval-at-eq? (mut minus-split) 1 6 8 "67")
                              (and (interval-at-eq? (mut minus-prefix) 0 5 8 "567")
                                   (and (interval-at-eq? (mut minus-suffix) 0 2 6 "2345")
                                        (interval-at-eq? (mut minus-disjoint)
                                                         0
                                                         2
                                                         5
                                                         "234")))))))
        relative
          (ohm/ohm-interval-relative-to
            (ohm/new-ohm-interval shared-source 4 6)
            (ohm/new-ohm-interval shared-source 2 8))
        trimmed (ohm/ohm-interval-trimmed
                  (ohm/new-ohm-interval "xx \t hello \n yy" 2 13))
        trimmed-empty (ohm/ohm-interval-trimmed
                        (ohm/new-ohm-interval "xx \t\n yy" 2 5))
        sub (ohm/ohm-interval-sub-interval
              (ohm/new-ohm-interval shared-source 2 8)
              2
              3)
        new-methods-valid
          (and minus-valid
               (and (interval-eq? relative 2 4 "23")
                    (and (interval-eq? trimmed 5 10 "hello")
                              (and (and (= (ohm/ohm-interval-start trimmed-empty) 5)
                                        (= (ohm/ohm-interval-end trimmed-empty) 2))
                                   (interval-eq? sub 4 7 "456")))))
        coverage-valid
          (and (interval-eq? coverage-one 0 5 "hello")
               (and (interval-eq? coverage-adjacent 0 5 "hello")
                    (and (interval-eq? coverage-non-adjacent 0 5 "hello")
                         (and (interval-eq? coverage-nested 0 5 "hello")
                              (and (interval-eq? coverage-more 0 10 "hello worl")
                                   (and (interval-eq? coverage-with 0 10 "hello worl")
                                        (interval-eq? equal-source-coverage
                                                      0 3 "abc")))))))
        valid
          (and stream-valid
               (and original-valid
                    (and collapsed-valid
                         (and coverage-valid
                              (and line-valid
                                   (and line-option-valid new-methods-valid))))))]
    (al/al-free! (mut one))
    (al/al-free! (mut adjacent))
    (al/al-free! (mut non-adjacent))
    (al/al-free! (mut nested))
    (al/al-free! (mut more))
    (al/al-free! (mut equal-sources))
    (alloc/free [u8] (alloc/malloc-allocator) equal-source-copy)
    (al/al-free! (mut minus-equal))
    (al/al-free! (mut minus-split))
    (al/al-free! (mut minus-prefix))
    (al/al-free! (mut minus-suffix))
    (al/al-free! (mut minus-disjoint))
    (ohm/free-ohm-input-stream! (mut stream))
    (ohm/free-ohm-input-stream! (mut units))
    (ohm/free-ohm-input-stream! (mut points))
    (ohm/free-ohm-input-stream! (mut string-stream))
    (alloc/free [u8] (alloc/malloc-allocator) interval-line-message)
    (cond (not stream-valid) 1
          (not unicode-stream-valid) 13
          (not string-stream-valid) 14
          (not original-valid) 2
          (not collapsed-valid) 3
          (not coverage-valid) 4
          (not line-valid) 5
          (not line-option-valid) 15
          (not minus-valid) 6
          (not (interval-eq? relative 2 4 "23")) 7
          (not (interval-eq? trimmed 5 10 "hello")) 9
          (not (and (= (ohm/ohm-interval-start trimmed-empty) 5)
                    (= (ohm/ohm-interval-end trimmed-empty) 2))) 10
          (not (interval-eq? sub 4 7 "456")) 11
          (not valid) 12
          :else 0)))
