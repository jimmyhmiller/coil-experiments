(impl ohm/OhmLazySemanticAction EmptyAction
  (semantic-grammar-name [(self (ptr EmptyAction))] (-> (slice u8)) "TestGrammar")
  (semantic-grammar-token [(self (ptr EmptyAction))] (-> (ptr u8)) (test-grammar-token))
  (semantic-formal-count [(self (ptr EmptyAction))] (-> i64) 0)
