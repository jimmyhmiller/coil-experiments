                               (arguments (slice i64))]
                              (-> i64)
                              0))

(defstruct CallsOtherOperation [(nested (dyn ohm/OhmLazySemanticAction))])

(impl ohm/OhmLazySemanticAction CallsOtherOperation
  (semantic-grammar-name [(self (ptr CallsOtherOperation))] (-> (slice u8)) "TestGrammar")
  (semantic-grammar-token [(self (ptr CallsOtherOperation))]
                          (-> (ptr u8))
                          (test-grammar-token))
  (semantic-formal-count [(self (ptr CallsOtherOperation))] (-> i64) 0)
  (semantic-action-kind [(self (ptr CallsOtherOperation))
                         (result (ptr ohm/MatchResult))
                         (node i64)]
                        (-> i64)
                        (if (str/str-eq (ohm/node-rule (load result) node) "start") 1 0))
  (apply-lazy-semantic-action [(self (ptr CallsOtherOperation))
                               (evaluation (mut ohm/SemanticEvaluation))
                               (node i64)
                               (action-kind i64)
                               (arguments (slice i64))]
                              (-> i64)
                              (ohm/evaluate-semantic-node-with! (mut evaluation)
                                                                (.nested self)
                                                                (ohm/node-child (load (.result evaluation))
                                                                                node
                                                                                0)
                                                                arguments
                                                                false
                                                                "oops")))

(defstruct CyclicAttribute [])

(impl ohm/OhmLazySemanticAction CyclicAttribute
  (semantic-grammar-name [(self (ptr CyclicAttribute))] (-> (slice u8)) "TestGrammar")
