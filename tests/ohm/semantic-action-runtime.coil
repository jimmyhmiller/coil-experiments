                        (-> i64)
                        0)
  (apply-lazy-semantic-action [(self (ptr MissingIterationAction))
                               (evaluation (mut ohm/SemanticEvaluation))
                               (node i64)
                               (action-kind i64)
                               (arguments (slice i64))]
                              (-> i64)
                              0))

