(defstruct TestActionSchema [(mode i64)])

(impl ohm/OhmSemanticActionSchema TestActionSchema
  (semantic-schema-grammar-name [(self (ptr TestActionSchema))]
                                (-> (slice u8))
                                (if (= (.mode self) 4) "OtherGrammar" "TestGrammar"))
  (semantic-schema-grammar-token [(self (ptr TestActionSchema))]
                                 (-> (ptr u8))
                                 (if (= (.mode self) 4)
                                     (other-grammar-token)
                                     (test-grammar-token)))
  (semantic-schema-action-count [(self (ptr TestActionSchema))]
                                (-> i64)
                                (cond (= (.mode self) 0) 4
                                      (= (.mode self) 5) 2
                                      :else 1))
  (semantic-schema-action-name [(self (ptr TestActionSchema))
                                (index i64)]
                               (-> (slice u8))
                               (if (= (.mode self) 0)
                                   (cond (= index 0) "pair"
                                         (= index 1) "_terminal"
                                         (= index 2) "_nonterminal"
                                         :else "digit")
                                   (cond (= (.mode self) 1) "unknown"
                                         (= (.mode self) 2) "pair"
                                         (= (.mode self) 3) "_iter"
                                         :else "pair")))
  (semantic-schema-action-arity [(self (ptr TestActionSchema)) (index i64)]
                                (-> i64)
                                (if (= (.mode self) 0)
                                    (cond (= index 0) 2
                                          (= index 1) 0
                                          (= index 2) 0
                                          :else 1)
                                    (cond (= (.mode self) 2) 1
                                          (= (.mode self) 5) 2
                                          :else 0)))
  (semantic-schema-action-rest? [(self (ptr TestActionSchema)) (index i64)]
                                (-> bool)
                                (and (= (.mode self) 0) (= index 2))))

(defn legacy-test [] (-> bool)
  (let [(mut state) (ohm/new-parse-state (alloc/malloc-allocator))
        _ (ohm/set-parse-grammar-name! (mut state) "TestGrammar")
        _ (ohm/set-parse-grammar-token! (mut state) (test-grammar-token))
        checkpoint (ohm/begin-rule! (mut state))
        end (ohm/match-literal-cst! (mut state) "abc" 0 "abc")
        final-end (ohm/succeed-rule! (mut state) "start" 0 end)
        (mut result) (ohm/finish-match (mut state) "abc" final-end)
        action (primitive/zeroed SourceLengthAction)
        (mut attribute) (ohm/compute-semantic-attribute action (mut result))
        first (ohm/semantic-attribute-root-value (mut attribute))
        second (ohm/semantic-attribute-root-value (mut attribute))
        value (ohm/evaluate-semantics action (mut result))]
    (ohm/free-semantic-attribute! (mut attribute))
    (ohm/free-match! (mut result))
    (and (= first 3) (and (= second 3) (= value 3)))))

(defn lazy-test [] (-> bool)
  (let [(mut state) (ohm/new-parse-state (alloc/malloc-allocator))
        _ (ohm/set-parse-grammar-name! (mut state) "TestGrammar")
        _ (ohm/set-parse-grammar-token! (mut state) (test-grammar-token))
        outer (ohm/begin-rule! (mut state))
        pair-checkpoint (ohm/begin-rule! (mut state))
        first-end (ohm/match-literal-cst! (mut state) "12" 0 "1")
        second-end (ohm/match-literal-cst! (mut state) "12" first-end "2")
        pair-end (ohm/succeed-rule! (mut state) "pair" 0 second-end)
        final-end (ohm/succeed-rule! (mut state) "start" 0 pair-end)
        (mut result) (ohm/finish-match (mut state) "12" final-end)
        operation (primitive/alloc-stack AddOffsetOperation)
        (mut operation-evaluation) (ohm/new-semantic-evaluation operation (mut result) false)
        (mut operation-arguments) (al/al-new [i64] (alloc/malloc-allocator))
        _ (push! (mut operation-arguments) 10)
        operation-value
          (ohm/evaluate-semantic-root! (mut operation-evaluation)
                                       (al/al-slice [i64] (load operation-arguments)))
        extended-operation (primitive/alloc-stack ExtendedOperation)
        _ (store! (field extended-operation parent) operation)
        (mut child-state) (ohm/new-parse-state (alloc/malloc-allocator))
        _ (ohm/set-parse-grammar-name! (mut child-state) "TestGrammar")
        _ (ohm/add-parse-grammar-name! (mut child-state) "ChildGrammar")
        _ (ohm/set-parse-grammar-token! (mut child-state) (child-grammar-token))
        child-outer (ohm/begin-rule! (mut child-state))
        child-pair-checkpoint (ohm/begin-rule! (mut child-state))
        child-first-end (ohm/match-literal-cst! (mut child-state) "12" 0 "1")
        child-second-end (ohm/match-literal-cst! (mut child-state) "12" child-first-end "2")
        child-pair-end (ohm/succeed-rule! (mut child-state) "pair" 0 child-second-end)
        child-final-end (ohm/succeed-rule! (mut child-state) "start" 0 child-pair-end)
        (mut child-result) (ohm/finish-match (mut child-state) "12" child-final-end)
        (mut incompatible-parent) (ohm/new-semantic-evaluation operation (mut child-result) false)
        (mut extended-evaluation) (ohm/new-semantic-evaluation extended-operation (mut child-result) false)
        extended-value
          (ohm/evaluate-semantic-root! (mut extended-evaluation)
                                       (al/al-slice [i64] (load operation-arguments)))
        calls (primitive/alloc-stack i64)
        _ (store! calls 0)
        attribute (primitive/alloc-stack CountingAttribute)
        _ (store! (field attribute calls) calls)
        (mut attribute-evaluation) (ohm/new-semantic-evaluation attribute (mut result) true)
        (mut no-arguments) (al/al-new [i64] (alloc/malloc-allocator))
        first-value
          (ohm/evaluate-semantic-root! (mut attribute-evaluation)
                                       (al/al-slice [i64] (load no-arguments)))
        second-value
          (ohm/evaluate-semantic-root! (mut attribute-evaluation)
                                       (al/al-slice [i64] (load no-arguments)))
        calls-before-forget (load calls)
        _ (ohm/forget-semantic-attribute! (mut attribute-evaluation))
        third-value
          (ohm/evaluate-semantic-root! (mut attribute-evaluation)
                                       (al/al-slice [i64] (load no-arguments)))
        calls-after-forget (load calls)
        other-calls (primitive/alloc-stack i64)
        _ (store! other-calls 0)
        other-attribute (primitive/alloc-stack CountingAttribute)
        _ (store! (field other-attribute calls) other-calls)
        (mut other-attribute-evaluation) (ohm/new-semantic-evaluation other-attribute (mut result) true)
        other-first-value
          (ohm/evaluate-semantic-root! (mut other-attribute-evaluation)
                                       (al/al-slice [i64] (load no-arguments)))
        other-second-value
          (ohm/evaluate-semantic-root! (mut other-attribute-evaluation)
                                       (al/al-slice [i64] (load no-arguments)))
        (mut incremental-cache)
          (ohm/new-semantic-attribute-cache (alloc/malloc-allocator))
        (mut cached-first-evaluation)
          (ohm/new-cached-semantic-attribute-evaluation attribute
                                                        (mut result)
                                                        "value"
                                                        (mut incremental-cache))
        cached-first-value
          (ohm/evaluate-semantic-root! (mut cached-first-evaluation)
                                       (al/al-slice [i64] (load no-arguments)))
        _
          (ohm/finish-cached-semantic-attribute-evaluation! (mut cached-first-evaluation)
                                                             (mut incremental-cache))
        _ (ohm/free-semantic-evaluation! (mut cached-first-evaluation))
        cached-calls-after-first (load calls)
        (mut cached-second-evaluation)
          (ohm/new-cached-semantic-attribute-evaluation attribute
                                                        (mut result)
                                                        "value"
                                                        (mut incremental-cache))
        cached-second-value
          (ohm/evaluate-semantic-root! (mut cached-second-evaluation)
                                       (al/al-slice [i64] (load no-arguments)))
        _
          (ohm/finish-cached-semantic-attribute-evaluation! (mut cached-second-evaluation)
                                                             (mut incremental-cache))
        cached-calls-after-second (load calls)
        cached-hit-count
          (ohm/semantic-attribute-cache-hit-count (mut incremental-cache))
        base-valid
          (and (= operation-value 23)
               (and (= extended-value 132)
                    (and (not (ohm/semantic-evaluation-failed? (mut operation-evaluation)))
                         (and (= (ohm/semantic-evaluation-error-kind (mut incompatible-parent))
                                 5)
                              (and (= first-value 3)
                                   (and (= second-value 3)
                                        (and (= third-value 3)
                                             (and (= calls-before-forget 3)
                                                  (and (= calls-after-forget 6)
                                                       (and (= other-first-value 3)
                                                            (and (= other-second-value 3)
                                                                 (= (load other-calls)
                                                                    3))))))))))))
        cached-valid
          (and (= cached-first-value 3)
               (and (= cached-second-value 3)
                    (and (= cached-calls-after-first cached-calls-after-second)
                         (> cached-hit-count 0))))
        valid (and base-valid cached-valid)]
    (al/al-free! (mut operation-arguments))
    (al/al-free! (mut no-arguments))
    (ohm/free-semantic-evaluation! (mut operation-evaluation))
    (ohm/free-semantic-evaluation! (mut extended-evaluation))
    (ohm/free-semantic-evaluation! (mut incompatible-parent))
    (ohm/free-semantic-evaluation! (mut attribute-evaluation))
    (ohm/free-semantic-evaluation! (mut other-attribute-evaluation))
    (ohm/free-semantic-attribute-cache! (mut incremental-cache))
    (ohm/free-match! (mut result))
    (ohm/free-match! (mut child-result))
    valid))

(defn semantic-error-test [] (-> bool)
  (let [(mut state) (ohm/new-parse-state (alloc/malloc-allocator))
        _ (ohm/set-parse-grammar-name! (mut state) "TestGrammar")
        _ (ohm/set-parse-grammar-token! (mut state) (test-grammar-token))
        outer (ohm/begin-rule! (mut state))
        pair-checkpoint (ohm/begin-rule! (mut state))
        first-end (ohm/match-literal-cst! (mut state) "12" 0 "1")
        second-end (ohm/match-literal-cst! (mut state) "12" first-end "2")
        pair-end (ohm/succeed-rule! (mut state) "pair" 0 second-end)
        final-end (ohm/succeed-rule! (mut state) "start" 0 pair-end)
        (mut result) (ohm/finish-match (mut state) "12" final-end)
        (mut no-arguments) (al/al-new [i64] (alloc/malloc-allocator))
        operation (primitive/alloc-stack AddOffsetOperation)
        (mut wrong-arguments) (ohm/new-named-semantic-evaluation operation (mut result) false "addOffset")
        (mut invalid-attribute) (ohm/new-semantic-evaluation operation (mut result) true)
        _
          (ohm/evaluate-semantic-root! (mut wrong-arguments)
                                       (al/al-slice [i64] (load no-arguments)))
        wrong-arguments-message (ohm/semantic-evaluation-message (mut wrong-arguments))
        empty (primitive/alloc-stack EmptyAction)
        (mut missing-action) (ohm/new-named-semantic-evaluation empty (mut result) false "empty")
        _
          (ohm/evaluate-semantic-root! (mut missing-action)
                                       (al/al-slice [i64] (load no-arguments)))
        missing-message (ohm/semantic-evaluation-message (mut missing-action))
        cyclic (primitive/alloc-stack CyclicAttribute)
        (mut cycle) (ohm/new-semantic-evaluation cyclic (mut result) true)
        _
          (ohm/evaluate-semantic-root! (mut cycle)
                                       (al/al-slice [i64] (load no-arguments)))
        wrong-grammar-action (primitive/alloc-stack WrongGrammarAction)
        (mut wrong-grammar) (ohm/new-semantic-evaluation wrong-grammar-action (mut result) false)
        wrong-grammar-message (ohm/semantic-evaluation-message (mut wrong-grammar))
        wrong-grammar-message-valid
          (str/str-eq
            wrong-grammar-message
            "Cannot use a MatchResult from grammar 'TestGrammar' with a semantics for 'OtherGrammar'")
        same-name-wrong-action (primitive/alloc-stack SameNameWrongGrammarAction)
        (mut same-name-wrong) (ohm/new-semantic-evaluation same-name-wrong-action (mut result) false)
        (mut failed-state) (ohm/new-parse-state (alloc/malloc-allocator))
        _ (ohm/set-parse-grammar-name! (mut failed-state) "TestGrammar")
        _ (ohm/set-parse-grammar-token! (mut failed-state) (test-grammar-token))
        (mut failed-result) (ohm/finish-match (mut failed-state) "x" -1)
        (mut failed-match) (ohm/new-semantic-evaluation operation (mut failed-result) false)
        (mut terminal-state) (ohm/new-parse-state (alloc/malloc-allocator))
        _ (ohm/set-parse-grammar-name! (mut terminal-state) "TestGrammar")
        _ (ohm/set-parse-grammar-token! (mut terminal-state) (test-grammar-token))
        terminal-start-checkpoint (ohm/begin-rule! (mut terminal-state))
        digit-checkpoint (ohm/begin-rule! (mut terminal-state))
        terminal-end (ohm/match-literal-cst! (mut terminal-state) "9" 0 "9")
        digit-end (ohm/succeed-rule! (mut terminal-state) "digit" 0 terminal-end)
        terminal-final-end (ohm/succeed-rule! (mut terminal-state) "start" 0 digit-end)
        (mut terminal-result) (ohm/finish-match (mut terminal-state) "9" terminal-final-end)
        (mut terminal-missing) (ohm/new-named-semantic-evaluation empty (mut terminal-result) false "oops")
        _
          (ohm/evaluate-semantic-root! (mut terminal-missing)
                                       (al/al-slice [i64] (load no-arguments)))
        terminal-message (ohm/semantic-evaluation-message (mut terminal-missing))
        calls-other (primitive/alloc-stack CallsOtherOperation)
        _ (store! (field calls-other nested) empty)
        (mut cross-operation) (ohm/new-named-semantic-evaluation calls-other (mut terminal-result) false "op2")
        _
          (ohm/evaluate-semantic-root! (mut cross-operation)
                                       (al/al-slice [i64] (load no-arguments)))
        cross-operation-message (ohm/semantic-evaluation-message (mut cross-operation))
        missing-stack-valid
          (and (= (ohm/semantic-evaluation-stack-count (mut missing-action)) 2)
               (and (str/str-eq (ohm/semantic-evaluation-stack-rule (mut missing-action) 0)
                                "start")
                    (str/str-eq (ohm/semantic-evaluation-stack-rule (mut missing-action) 1)
                                "pair")))
        cycle-stack-valid
          (and (= (ohm/semantic-evaluation-stack-count (mut cycle)) 1)
               (str/str-eq (ohm/semantic-evaluation-stack-rule (mut cycle) 0)
                           "start"))
        valid
          (and (ohm/semantic-evaluation-failed? (mut wrong-arguments))
               (and (= (ohm/semantic-evaluation-error-kind (mut invalid-attribute)) 6)
                    (and (= (ohm/semantic-evaluation-error-kind (mut wrong-arguments)) 1)
                         (and (= (ohm/semantic-evaluation-expected-arguments (mut wrong-arguments))
                                 1)
                              (and (= (ohm/semantic-evaluation-actual-arguments (mut wrong-arguments))
                                      0)
                                   (and (= (ohm/semantic-evaluation-error-kind (mut missing-action))
                                           2)
                                        (and (str/str-eq wrong-arguments-message
                                                         "Invalid number of arguments passed to addOffset operation (expected 1, got 0)")
                                             (and (str/str-eq missing-message
                                                              "Missing semantic action for 'pair' in operation 'empty'.\nAction stack (most recent call last):\n  empty > default action for 'start'\n  empty > pair")
                                                  (and (= (ohm/semantic-evaluation-error-kind (mut cycle))
                                                          3)
                                                       (and (and (= (ohm/semantic-evaluation-error-kind (mut wrong-grammar))
                                                                    5)
                                                                 wrong-grammar-message-valid)
                                                            (and (= (ohm/semantic-evaluation-error-kind (mut same-name-wrong))
                                                                    5)
                                                                 (and (= (ohm/semantic-evaluation-error-kind (mut failed-match))
                                                                         7)
                                                                      (and (str/str-eq terminal-message
                                                                                       "Missing semantic action for '_terminal' in operation 'oops'.\nAction stack (most recent call last):\n  oops > default action for 'start'\n  oops > default action for 'digit'\n  oops > _terminal")
                                                                           (and (str/str-eq cross-operation-message
                                                                                            "Missing semantic action for '_terminal' in operation 'oops'.\nAction stack (most recent call last):\n  op2 > start\n  oops > default action for 'digit'\n  oops > _terminal")
                                                                                (and missing-stack-valid
                                                                                     cycle-stack-valid)))))))))))))))]
    (ohm/free-semantic-evaluation! (mut wrong-arguments))
    (ohm/free-semantic-evaluation! (mut invalid-attribute))
    (ohm/free-semantic-evaluation! (mut missing-action))
    (ohm/free-semantic-evaluation! (mut cycle))
    (ohm/free-semantic-evaluation! (mut wrong-grammar))
    (ohm/free-semantic-evaluation! (mut same-name-wrong))
    (ohm/free-semantic-evaluation! (mut failed-match))
    (ohm/free-semantic-evaluation! (mut terminal-missing))
    (ohm/free-semantic-evaluation! (mut cross-operation))
    (al/al-free! (mut no-arguments))
    (ohm/free-match! (mut result))
    (ohm/free-match! (mut failed-result))
    (ohm/free-match! (mut terminal-result))
    valid))

(defn semantic-schema-test [] (-> bool)
  (let [(mut state) (ohm/new-parse-state (alloc/malloc-allocator))
        _ (ohm/set-parse-grammar-name! (mut state) "TestGrammar")
        _ (ohm/set-parse-grammar-token! (mut state) (test-grammar-token))
        _ (ohm/add-semantic-rule! (mut state) "pair" 2)
        _ (ohm/add-semantic-rule! (mut state) "digit" 1)
        checkpoint (ohm/begin-rule! (mut state))
        end (ohm/match-literal-cst! (mut state) "1" 0 "1")
        final-end (ohm/succeed-rule! (mut state) "pair" 0 end)
        (mut result) (ohm/finish-match (mut state) "1" final-end)
        schema (primitive/alloc-stack TestActionSchema)
        _ (store! (field schema mode) 0)
        valid-schema (ohm/validate-semantic-action-schema schema (mut result))
        _ (store! (field schema mode) 1)
        unknown-schema (ohm/validate-semantic-action-schema schema (mut result))
        _ (store! (field schema mode) 2)
        wrong-arity-schema (ohm/validate-semantic-action-schema schema (mut result))
        _ (store! (field schema mode) 3)
        wrong-rest-schema (ohm/validate-semantic-action-schema schema (mut result))
        _ (store! (field schema mode) 4)
        wrong-grammar-schema (ohm/validate-semantic-action-schema schema (mut result))
        _ (store! (field schema mode) 5)
        duplicate-schema (ohm/validate-semantic-action-schema schema (mut result))
        valid
          (and (ohm/semantic-schema-valid? valid-schema)
               (and (= (ohm/semantic-schema-error-kind unknown-schema) 2)
                    (and (= (ohm/semantic-schema-error-kind wrong-arity-schema) 3)
                         (and (= (ohm/semantic-schema-expected-arity wrong-arity-schema)
                                 2)
                              (and (= (ohm/semantic-schema-actual-arity wrong-arity-schema)
                                      1)
                                   (and (= (ohm/semantic-schema-error-kind wrong-rest-schema)
                                           3)
                                        (and (= (ohm/semantic-schema-error-kind wrong-grammar-schema)
                                                1)
                                             (= (ohm/semantic-schema-error-kind duplicate-schema)
                                                4))))))))]
    (ohm/free-match! (mut result))
    valid))

(defn semantics-registry-test [] (-> bool)
  (let [(mut state) (ohm/new-parse-state (alloc/malloc-allocator))
        _ (ohm/set-parse-grammar-name! (mut state) "TestGrammar")
        _ (ohm/set-parse-grammar-token! (mut state) (test-grammar-token))
        outer (ohm/begin-rule! (mut state))
        pair-checkpoint (ohm/begin-rule! (mut state))
        first-end (ohm/match-literal-cst! (mut state) "12" 0 "1")
        second-end (ohm/match-literal-cst! (mut state) "12" first-end "2")
        pair-end (ohm/succeed-rule! (mut state) "pair" 0 second-end)
        final-end (ohm/succeed-rule! (mut state) "start" 0 pair-end)
        (mut result) (ohm/finish-match (mut state) "12" final-end)
        operation (primitive/alloc-stack AddOffsetOperation)
        calls (primitive/alloc-stack i64)
        _ (store! calls 0)
        attribute (primitive/alloc-stack CountingAttribute)
        _ (store! (field attribute calls) calls)
        wrong (primitive/alloc-stack WrongGrammarAction)
        (mut semantics)
          (ohm/new-ohm-semantics "TestGrammar"
                                 (test-grammar-token)
                                 (alloc/malloc-allocator))
        parsed-signature (ohm/parse-semantic-signature "_op(α, b2)" false)
        invalid-attribute-signature (ohm/parse-semantic-signature "attr()" true)
        add-operation
          (ohm/add-semantics-operation-signature! (mut semantics)
                                                  " value ( amount ) "
                                                  operation)
        add-attribute (ohm/add-semantics-attribute-signature! (mut semantics) " memo " attribute)
        duplicate (ohm/add-semantics-operation! (mut semantics) "value" operation)
        wrong-grammar (ohm/add-semantics-operation! (mut semantics) "wrong" wrong)
        attribute-arguments (ohm/add-semantics-attribute! (mut semantics) "badAttribute" operation)
        malformed-attribute
          (ohm/add-semantics-attribute-signature! (mut semantics)
                                                  "badAttribute(x)"
                                                  attribute)
        signature-arity-mismatch (ohm/add-semantics-operation-signature! (mut semantics) "wrong()" operation)
        operation-index (ohm/semantic-definition-index (mut semantics) "value")
        (mut evaluation)
          (ohm/new-registered-semantic-evaluation (mut semantics)
                                                  operation-index
                                                  (mut result))
        (mut arguments) (al/al-new [i64] (alloc/malloc-allocator))
        _ (push! (mut arguments) 10)
        value
          (ohm/evaluate-semantic-root! (mut evaluation)
                                       (al/al-slice [i64] (load arguments)))
        attribute-index (ohm/semantic-definition-index (mut semantics) "memo")
        (mut no-arguments) (al/al-new [i64] (alloc/malloc-allocator))
        (mut first-registered-attribute)
          (ohm/new-registered-semantic-evaluation (mut semantics)
                                                  attribute-index
                                                  (mut result))
        first-registered-value
          (ohm/evaluate-semantic-root! (mut first-registered-attribute)
                                       (al/al-slice [i64] (load no-arguments)))
        _ (ohm/free-registered-semantic-evaluation!
            (mut semantics) attribute-index (mut first-registered-attribute))
        calls-after-first-registered (load calls)
        (mut second-registered-attribute)
          (ohm/new-registered-semantic-evaluation (mut semantics)
                                                  attribute-index
                                                  (mut result))
        second-registered-value
          (ohm/evaluate-semantic-root! (mut second-registered-attribute)
                                       (al/al-slice [i64] (load no-arguments)))
        _ (ohm/free-registered-semantic-evaluation!
            (mut semantics) attribute-index (mut second-registered-attribute))
        calls-after-second-registered (load calls)
        (mut unrelated-state) (ohm/new-parse-state (alloc/malloc-allocator))
        _ (ohm/set-parse-grammar-name! (mut unrelated-state) "TestGrammar")
        _ (ohm/set-parse-grammar-token! (mut unrelated-state) (test-grammar-token))
        unrelated-outer (ohm/begin-rule! (mut unrelated-state))
        unrelated-pair (ohm/begin-rule! (mut unrelated-state))
        unrelated-first
          (ohm/match-literal-cst! (mut unrelated-state) "12" 0 "1")
        unrelated-second
          (ohm/match-literal-cst! (mut unrelated-state) "12" unrelated-first "2")
        unrelated-pair-end
          (ohm/succeed-rule! (mut unrelated-state) "pair" 0 unrelated-second)
        unrelated-final-end
          (ohm/succeed-rule! (mut unrelated-state) "start" 0 unrelated-pair-end)
        (mut unrelated-result)
          (ohm/finish-match (mut unrelated-state) "12" unrelated-final-end)
        (mut unrelated-evaluation)
          (ohm/new-registered-semantic-evaluation (mut semantics)
                                                  attribute-index
                                                  (mut unrelated-result))
        unrelated-value
          (ohm/evaluate-semantic-root! (mut unrelated-evaluation)
                                       (al/al-slice [i64] (load no-arguments)))
        _ (ohm/free-registered-semantic-evaluation!
            (mut semantics) attribute-index (mut unrelated-evaluation))
        calls-after-unrelated (load calls)
        registered-cache-valid
          (and (= first-registered-value 3)
               (and (= second-registered-value 3)
                    (and (= unrelated-value 3)
                         (and (= calls-after-first-registered 3)
                              (and (= calls-after-second-registered 3)
                                   (= calls-after-unrelated 6))))))
        (mut child-semantics)
          (ohm/extend-ohm-semantics (mut semantics)
                                    "ChildGrammar"
                                    (child-grammar-token))
        extended (primitive/alloc-stack ExtendedOperation)
        _ (store! (field extended parent) operation)
        rejected-extension-signature
          (ohm/extend-semantics-operation-signature! (mut child-semantics)
                                                     "value(x)"
                                                     extended)
        extend-value
          (ohm/extend-semantics-operation-signature! (mut child-semantics)
                                                     " value "
                                                     extended)
        extend-again
          (ohm/extend-semantics-operation-signature! (mut child-semantics)
                                                     "value"
                                                     extended)
        extend-missing (ohm/extend-semantics-action! (mut child-semantics) "missing" extended false)
        extend-kind-mismatch (ohm/extend-semantics-action! (mut child-semantics) "memo" extended false)
        (mut recipe) (ohm/semantics-to-recipe (mut child-semantics))
        (mut reconstructed) (ohm/make-semantics-from-recipe (mut recipe))
        _ (ohm/free-ohm-semantics-recipe! (mut recipe))
        _ (set! (.grammar-name result) "ChildGrammar")
        _ (set! (.grammar-token result) (child-grammar-token))
        reconstructed-operation-index
          (ohm/semantic-definition-index (mut reconstructed) "value")
        (mut reconstructed-evaluation)
          (ohm/new-registered-semantic-evaluation (mut reconstructed)
                                                  reconstructed-operation-index
                                                  (mut result))
        reconstructed-value
          (ohm/evaluate-semantic-root! (mut reconstructed-evaluation)
                                       (al/al-slice [i64] (load arguments)))
        signature-valid
          (and (ohm/semantic-signature-valid? parsed-signature)
               (and (str/str-eq (ohm/semantic-signature-name parsed-signature) "_op")
                    (and (= (ohm/semantic-signature-formal-count parsed-signature) 2)
                         (not (ohm/semantic-signature-valid? invalid-attribute-signature)))))
        registry-valid
          (and (= add-operation 0)
               (and (= add-attribute 0)
                    (and (= duplicate 1)
                         (and (= wrong-grammar 2)
                              (and (= attribute-arguments 3)
                                   (and (= malformed-attribute 4)
                                        (and (= signature-arity-mismatch 5)
                                             (and (= (ohm/semantics-action-count (mut semantics)) 2)
                                                  (and (= (ohm/semantics-operation-count (mut semantics)) 1)
                                                       (and (= (ohm/semantics-attribute-count (mut semantics))
                                                               1)
                                                            (and (str/str-eq (ohm/semantics-operation-name (mut semantics)
                                                                                                           0)
                                                                             "value")
                                                                 (and (str/str-eq (ohm/semantics-attribute-name (mut semantics)
                                                                                                                0)
                                                                                  "memo")
                                                                      (and (= (ohm/semantics-action-formal-count (mut semantics)
                                                                                                                 operation-index)
                                                                              1)
                                                                           (and (ohm/semantics-has-action? (mut semantics)
                                                                                                           "memo")
                                                                                (and (= value 23)
                                                                                     registered-cache-valid)))))))))))))))
        extension-valid
          (and (= rejected-extension-signature 7)
               (and (= extend-value 0)
                    (and (ohm/semantics-action-inherited? (mut child-semantics) 0)
                         (and (ohm/semantics-action-extended? (mut child-semantics) 0)
                              (and (= extend-again 2)
                                   (and (= extend-missing 1)
                                        (= extend-kind-mismatch 3)))))))
        recipe-valid
          (and (= (ohm/semantics-action-count (mut reconstructed)) 2)
               (and (= (ohm/semantics-operation-count (mut reconstructed)) 1)
                    (and (= (ohm/semantics-attribute-count (mut reconstructed)) 1)
                         (and (ohm/semantics-action-inherited? (mut reconstructed) 0)
                              (and (ohm/semantics-action-extended? (mut reconstructed) 0)
                                   (and (str/str-eq (ohm/semantics-operation-name (mut reconstructed)
                                                                                0)
                                                    "value")
                                        (and (str/str-eq (ohm/semantics-attribute-name (mut reconstructed)
                                                                                     0)
                                                         "memo")
                                             (= reconstructed-value 132))))))))
        (mut escaped-recipe-string) (str/sb-new (alloc/malloc-allocator))
        _ (ohm/push-semantics-recipe-json-string!
            (mut escaped-recipe-string) "A  Semantics")
        escaped-recipe-text (str/sb-finish! (mut escaped-recipe-string))
        separator-escape-valid
          (str/str-eq escaped-recipe-text "\"A\\u2028\\u2029Semantics\"")
        valid
          (and signature-valid
               (and registry-valid
                    (and extension-valid
                         (and recipe-valid separator-escape-valid))))]
    (al/al-free! (mut arguments))
    (al/al-free! (mut no-arguments))
    (ohm/free-semantic-evaluation! (mut evaluation))
    (ohm/free-semantic-evaluation! (mut reconstructed-evaluation))
    (ohm/free-ohm-semantics! (mut reconstructed))
    (ohm/free-ohm-semantics! (mut child-semantics))
    (ohm/free-ohm-semantics! (mut semantics))
    (ohm/free-match! (mut unrelated-result))
    (ohm/free-match! (mut result))
    valid))

(defn iteration-semantics-test [] (-> bool)
  (let [(mut state) (ohm/new-parse-state (alloc/malloc-allocator))
        _ (ohm/set-parse-grammar-name! (mut state) "IterationGrammar")
        _ (ohm/set-parse-grammar-token! (mut state) (iteration-grammar-token))
        outer (ohm/begin-rule! (mut state))
        iteration-checkpoint (ohm/begin-rule! (mut state))
        (mut builder) (ohm/begin-iteration (mut state) 1)
        first-end (ohm/match-literal-cst! (mut state) "12" 0 "1")
        _ (ohm/iteration-capture-row! (mut state) (mut builder))
        second-end (ohm/match-literal-cst! (mut state) "12" first-end "2")
        _ (ohm/iteration-capture-row! (mut state) (mut builder))
        iteration-end (ohm/succeed-iteration! (mut state) (mut builder) 0 second-end false)
        final-end (ohm/succeed-rule! (mut state) "letters" 0 iteration-end)
        (mut result) (ohm/finish-match (mut state) "12" final-end)
        (mut no-arguments) (al/al-new [i64] (alloc/malloc-allocator))
        action (primitive/alloc-stack IterationOperation)
        (mut evaluation) (ohm/new-semantic-evaluation action (mut result) false)
        value
          (ohm/evaluate-semantic-root! (mut evaluation)
                                       (al/al-slice [i64] (load no-arguments)))
        missing (primitive/alloc-stack MissingIterationAction)
        (mut missing-evaluation) (ohm/new-named-semantic-evaluation missing (mut result) false "missing")
        _
          (ohm/evaluate-semantic-root! (mut missing-evaluation)
                                       (al/al-slice [i64] (load no-arguments)))
        missing-iteration-message (ohm/semantic-evaluation-message (mut missing-evaluation))
        (mut optional-state) (ohm/new-parse-state (alloc/malloc-allocator))
        _ (ohm/set-parse-grammar-name! (mut optional-state) "IterationGrammar")
        _ (ohm/set-parse-grammar-token! (mut optional-state) (iteration-grammar-token))
        optional-outer (ohm/begin-rule! (mut optional-state))
        optional-checkpoint (ohm/begin-rule! (mut optional-state))
        (mut optional-builder) (ohm/begin-iteration (mut optional-state) 1)
        optional-end
          (ohm/succeed-iteration! (mut optional-state)
                                  (mut optional-builder)
                                  0
                                  0
                                  true)
        optional-final (ohm/succeed-rule! (mut optional-state) "optionalLetter" 0 optional-end)
        (mut optional-result) (ohm/finish-match (mut optional-state) "" optional-final)
        (mut optional-evaluation) (ohm/new-semantic-evaluation action (mut optional-result) false)
        optional-value
          (ohm/evaluate-semantic-root! (mut optional-evaluation)
                                       (al/al-slice [i64] (load no-arguments)))
        root (ohm/match-root (load result))
        iteration (ohm/node-child (load result) root 0)
        terminal (ohm/node-child (load result) iteration 0)
        (mut direct-iteration) (ohm/semantic-node-as-iteration (mut evaluation) iteration)
        optional-root (ohm/match-root (load optional-result))
        optional-iteration-node (ohm/node-child (load optional-result) optional-root 0)
        (mut empty-iteration)
          (ohm/semantic-node-as-iteration (mut optional-evaluation)
                                          optional-iteration-node)
        valid
          (and (= value 3)
               (and (= optional-value 100)
                    (and (= (ohm/semantic-evaluation-error-kind (mut missing-evaluation))
                            2)
                         (and (str/str-eq missing-iteration-message
                                          "Missing semantic action for '_iter' in operation 'missing'.\nNOTE: as of Ohm v16, there is no default action for iteration nodes — see \n  https://ohmjs.org/d/dsa for details.\nAction stack (most recent call last):\n  missing > default action for 'letters'\n  missing > _iter")
                              (and (ohm/node-lexical? (load result) root)
                                   (and (ohm/node-iteration? (load result) iteration)
                                        (and (ohm/node-terminal? (load result) terminal)
                                             (and (not (ohm/node-nonterminal? (load result)
                                                                              terminal))
                                                  (and (= (ohm/semantic-iteration-child-count (mut direct-iteration))
                                                          2)
                                                       (= (ohm/semantic-iteration-child-count (mut empty-iteration))
                                                          0))))))))))]
    (ohm/free-semantic-evaluation! (mut evaluation))
    (ohm/free-semantic-evaluation! (mut missing-evaluation))
    (ohm/free-semantic-evaluation! (mut optional-evaluation))
    (ohm/free-semantic-iteration! (mut direct-iteration))
    (ohm/free-semantic-iteration! (mut empty-iteration))
    (al/al-free! (mut no-arguments))
    (ohm/free-match! (mut result))
    (ohm/free-match! (mut optional-result))
    valid))

(defn as-iteration-test [] (-> bool)
  (let [(mut state) (ohm/new-parse-state (alloc/malloc-allocator))
        _ (ohm/set-parse-grammar-name! (mut state) "IterationGrammar")
        _ (ohm/set-parse-grammar-token! (mut state) (iteration-grammar-token))
        start-checkpoint (ohm/begin-rule! (mut state))
        list-checkpoint (ohm/begin-rule! (mut state))
        nonempty-checkpoint (ohm/begin-rule! (mut state))
        head-end (ohm/match-literal-cst! (mut state) "1,2" 0 "1")
        tail-checkpoint (ohm/begin-rule! (mut state))
        (mut tail-builder) (ohm/begin-iteration (mut state) 2)
        separator-end (ohm/match-literal-cst! (mut state) "1,2" head-end ",")
        element-end (ohm/match-literal-cst! (mut state) "1,2" separator-end "2")
        _ (ohm/iteration-capture-row! (mut state) (mut tail-builder))
        tail-end
          (ohm/succeed-iteration! (mut state)
                                  (mut tail-builder)
                                  head-end
                                  element-end
                                  false)
        nonempty-end (ohm/succeed-rule! (mut state) "NonemptyListOf" 0 tail-end)
        list-end (ohm/succeed-rule! (mut state) "ListOf" 0 nonempty-end)
        final-end (ohm/succeed-rule! (mut state) "Start" 0 list-end)
        (mut result) (ohm/finish-match (mut state) "1,2" final-end)
        action (primitive/alloc-stack IterationOperation)
        (mut evaluation) (ohm/new-semantic-evaluation action (mut result) false)
        (mut no-arguments) (al/al-new [i64] (alloc/malloc-allocator))
        root (ohm/match-root (load result))
        list-node (ohm/node-child (load result) root 0)
        (mut list-iteration) (ohm/semantic-node-as-iteration (mut evaluation) list-node)
        first
          (ohm/evaluate-semantic-iteration-child! (mut evaluation)
                                                  (mut list-iteration)
                                                  0
                                                  (al/al-slice [i64] (load no-arguments)))
        second
          (ohm/evaluate-semantic-iteration-child! (mut evaluation)
                                                  (mut list-iteration)
                                                  1
                                                  (al/al-slice [i64] (load no-arguments)))
        (mut synthetic)
          (ohm/new-semantic-iteration (mut evaluation)
                                      (al/al-slice [i64] (.children list-iteration)))
        _ (ohm/reverse-semantic-iteration! (mut synthetic))
        reversed-first
          (ohm/evaluate-semantic-iteration-child! (mut evaluation)
                                                  (mut synthetic)
                                                  0
                                                  (al/al-slice [i64] (load no-arguments)))
        reversed-second
          (ohm/evaluate-semantic-iteration-child! (mut evaluation)
                                                  (mut synthetic)
                                                  1
                                                  (al/al-slice [i64] (load no-arguments)))
        (mut empty-state) (ohm/new-parse-state (alloc/malloc-allocator))
        _ (ohm/set-parse-grammar-name! (mut empty-state) "IterationGrammar")
        _ (ohm/set-parse-grammar-token! (mut empty-state) (iteration-grammar-token))
        empty-start-checkpoint (ohm/begin-rule! (mut empty-state))
        empty-list-checkpoint (ohm/begin-rule! (mut empty-state))
        empty-rule-checkpoint (ohm/begin-rule! (mut empty-state))
        empty-rule-end (ohm/succeed-rule! (mut empty-state) "EmptyListOf" 0 0)
        empty-list-end (ohm/succeed-rule! (mut empty-state) "ListOf" 0 empty-rule-end)
        empty-final-end (ohm/succeed-rule! (mut empty-state) "Start" 0 empty-list-end)
        (mut empty-result) (ohm/finish-match (mut empty-state) "" empty-final-end)
        (mut empty-evaluation) (ohm/new-semantic-evaluation action (mut empty-result) false)
        empty-root (ohm/match-root (load empty-result))
        empty-list-node (ohm/node-child (load empty-result) empty-root 0)
        (mut built-in-empty) (ohm/semantic-node-as-iteration (mut empty-evaluation) empty-list-node)
        valid
          (and (ohm/semantic-iteration-valid? (mut list-iteration))
               (and (= (ohm/semantic-iteration-child-count (mut list-iteration)) 2)
                    (and (= first 1)
                         (and (= second 2)
                              (and (= reversed-first 2)
                                   (and (= reversed-second 1)
                                        (and (ohm/semantic-iteration-valid? (mut built-in-empty))
                                             (= (ohm/semantic-iteration-child-count (mut built-in-empty))
                                                0))))))))]
    (ohm/free-semantic-iteration! (mut list-iteration))
    (ohm/free-semantic-iteration! (mut synthetic))
    (ohm/free-semantic-iteration! (mut built-in-empty))
    (al/al-free! (mut no-arguments))
    (ohm/free-semantic-evaluation! (mut evaluation))
    (ohm/free-semantic-evaluation! (mut empty-evaluation))
    (ohm/free-match! (mut result))
    (ohm/free-match! (mut empty-result))
    valid))

(defn source-string-test [] (-> bool)
  (let [(mut state) (ohm/new-parse-state (alloc/malloc-allocator))
        _ (ohm/set-parse-grammar-name! (mut state) "SourceGrammar")
        _ (ohm/set-parse-grammar-token! (mut state) (source-grammar-token))
        start-checkpoint (ohm/begin-rule! (mut state))
        first-num-checkpoint (ohm/begin-rule! (mut state))
        first-iter-checkpoint (ohm/begin-rule! (mut state))
        (mut first-builder) (ohm/begin-iteration (mut state) 1)
        first-digit-end (ohm/match-literal-cst! (mut state) "1 22" 0 "1")
        _ (ohm/iteration-capture-row! (mut state) (mut first-builder))
        first-iter-end (ohm/succeed-iteration! (mut state) (mut first-builder) 0 first-digit-end false)
        first-num-end (ohm/succeed-rule! (mut state) "num" 0 first-iter-end)
        second-num-checkpoint (ohm/begin-rule! (mut state))
        second-iter-checkpoint (ohm/begin-rule! (mut state))
        (mut second-builder) (ohm/begin-iteration (mut state) 1)
        second-first-end (ohm/match-literal-cst! (mut state) "1 22" 2 "2")
        _ (ohm/iteration-capture-row! (mut state) (mut second-builder))
        second-second-end (ohm/match-literal-cst! (mut state) "1 22" second-first-end "2")
        _ (ohm/iteration-capture-row! (mut state) (mut second-builder))
        second-iter-end
          (ohm/succeed-iteration! (mut state)
                                  (mut second-builder)
                                  2
                                  second-second-end
                                  false)
        second-num-end (ohm/succeed-rule! (mut state) "num" 2 second-iter-end)
        final-end (ohm/succeed-rule! (mut state) "Start" 0 second-num-end)
        (mut result) (ohm/finish-match (mut state) "1 22" final-end)
        root (ohm/match-root (load result))
        first-num (ohm/node-child (load result) root 0)
        second-num (ohm/node-child (load result) root 1)
        first-digits (ohm/node-child (load result) first-num 0)
        second-digits (ohm/node-child (load result) second-num 0)
        valid
          (and (str/str-eq (ohm/node-source-string (load result) root) "1 22")
               (and (str/str-eq (ohm/node-source-string (load result) first-num) "1")
                    (and (str/str-eq (ohm/node-source-string (load result) second-num) "22")
                         (and (str/str-eq (ohm/node-source-string (load result) first-digits)
                                          "1")
                              (str/str-eq (ohm/node-source-string (load result) second-digits)
                                          "22")))))]
    (ohm/free-match! (mut result))
    valid))

(defn context-message-test [] (-> bool)
  (let [(mut state) (ohm/new-parse-state (alloc/malloc-allocator))
        _ (ohm/record-expectation! (mut state) 8 "x" 0)
        (mut result) (ohm/finish-match (mut state) "before\nbad\nafter" -1)
        valid
          (and (str/str-eq (ohm/match-short-message (load result))
                           "Line 2, col 2: expected \"x\"")
               (str/str-eq (ohm/match-message (load result))
                           "Line 2, col 2:\n  1 | before\n> 2 | bad\n       ^\n  3 | after\nExpected \"x\""))]
    (ohm/free-match! (mut result))
    valid))

(defn main [] (-> i64)
  (cond (not (legacy-test)) 11
        (not (lazy-test)) 12
        (not (semantic-error-test)) 13
        (not (semantic-schema-test)) 14
        (not (semantics-registry-test)) 15
        (not (iteration-semantics-test)) 16
        (not (as-iteration-test)) 17
        (not (source-string-test)) 18
        (not (context-message-test)) 19
        :else 0))
