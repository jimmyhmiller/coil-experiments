(module tests.ohm.semantic-action-runtime)

(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "coil.primitive" :as primitive)
(import "coil.slice" :use [slice-get slice-len])
(import "coil.str" :as str)
(import "experiments.ohm.runtime" :as ohm)

(defn test-grammar-token [] (-> (ptr u8))
  (primitive/alloc-static u8))
(defn child-grammar-token [] (-> (ptr u8))
  (primitive/alloc-static u8))
(defn iteration-grammar-token [] (-> (ptr u8))
  (primitive/alloc-static u8))
(defn other-grammar-token [] (-> (ptr u8))
  (primitive/alloc-static u8))
(defn source-grammar-token [] (-> (ptr u8))
  (primitive/alloc-static u8))

(defstruct SourceLengthAction [])

(impl ohm/OhmSemanticAction SourceLengthAction
  (apply-semantic-node [(self SourceLengthAction)
                        (result (ptr ohm/MatchResult))
                        (node i64)
                        (children (slice i64))]
                       (-> i64)
                       (if (ohm/node-terminal? (load result) node)
                           (slice-len (ohm/node-source-string (load result) node))
                           (let [(mut total) 0]
                             (for child (iter children) (set! total (+ (load total) child)))
                             (load total)))))

(defstruct AddOffsetOperation [])

(impl ohm/OhmLazySemanticAction AddOffsetOperation
  (semantic-grammar-name [(self (ptr AddOffsetOperation))] (-> (slice u8)) "TestGrammar")
  (semantic-grammar-token [(self (ptr AddOffsetOperation))] (-> (ptr u8)) (test-grammar-token))
  (semantic-formal-count [(self (ptr AddOffsetOperation))] (-> i64) 1)
  (semantic-action-kind [(self (ptr AddOffsetOperation))
                         (result (ptr ohm/MatchResult))
                         (node i64)]
                        (-> i64)
                        (if (or (ohm/node-terminal? (load result) node)
                                (str/str-eq (ohm/node-rule (load result) node) "pair"))
                            1
                            0))
  (apply-lazy-semantic-action [(self (ptr AddOffsetOperation))
                               (evaluation (mut ohm/SemanticEvaluation))
                               (node i64)
                               (action-kind i64)
                               (arguments (slice i64))]
                              (-> i64)
                              (let [result (.result evaluation)]
                                (if (ohm/node-terminal? (load result) node)
                                    (+ (- (primitive/cast i64
                                                          (slice-get (ohm/node-source-string (load result)
                                                                                             node)
                                                                     0))
                                          48)
                                       (slice-get arguments 0))
                                    (+ (ohm/evaluate-semantic-child! (mut evaluation)
                                                                     node
                                                                     0
                                                                     arguments)
                                       (ohm/evaluate-semantic-child! (mut evaluation)
                                                                     node
                                                                     1
                                                                     arguments))))))

(defstruct ExtendedOperation [(parent (dyn ohm/OhmLazySemanticAction))])

(impl ohm/OhmLazySemanticAction ExtendedOperation
  (semantic-grammar-name [(self (ptr ExtendedOperation))] (-> (slice u8)) "ChildGrammar")
  (semantic-grammar-token [(self (ptr ExtendedOperation))] (-> (ptr u8)) (child-grammar-token))
  (semantic-formal-count [(self (ptr ExtendedOperation))]
                         (-> i64)
                         (ohm/semantic-formal-count (.parent self)))
  (semantic-action-kind [(self (ptr ExtendedOperation))
                         (result (ptr ohm/MatchResult))
                         (node i64)]
                        (-> i64)
                        (if (str/str-eq (ohm/node-rule (load result) node) "pair")
                            4
                            (ohm/semantic-action-kind (.parent self) result node)))
  (apply-lazy-semantic-action [(self (ptr ExtendedOperation))
                               (evaluation (mut ohm/SemanticEvaluation))
                               (node i64)
                               (action-kind i64)
                               (arguments (slice i64))]
                              (-> i64)
                              (if (= action-kind 4)
                                  (* (ohm/evaluate-semantic-child! (mut evaluation)
                                                                   node
                                                                   0
                                                                   arguments)
                                     (ohm/evaluate-semantic-child! (mut evaluation)
                                                                   node
                                                                   1
                                                                   arguments))
                                  (ohm/apply-lazy-semantic-action (.parent self)
                                                                  (mut evaluation)
                                                                  node
                                                                  action-kind
                                                                  arguments))))

(defstruct CountingAttribute [(calls (ptr i64))])

(impl ohm/OhmLazySemanticAction CountingAttribute
  (semantic-grammar-name [(self (ptr CountingAttribute))] (-> (slice u8)) "TestGrammar")
  (semantic-grammar-token [(self (ptr CountingAttribute))] (-> (ptr u8)) (test-grammar-token))
  (semantic-formal-count [(self (ptr CountingAttribute))] (-> i64) 0)
  (semantic-action-kind [(self (ptr CountingAttribute))
                         (result (ptr ohm/MatchResult))
                         (node i64)]
                        (-> i64)
                        (if (or (ohm/node-terminal? (load result) node)
                                (str/str-eq (ohm/node-rule (load result) node) "pair"))
                            1
                            0))
  (apply-lazy-semantic-action [(self (ptr CountingAttribute))
                               (evaluation (mut ohm/SemanticEvaluation))
                               (node i64)
                               (action-kind i64)
                               (arguments (slice i64))]
                              (-> i64)
                              (do
                                (store! (.calls self) (+ (load (.calls self)) 1))
                                (let [result (.result evaluation)]
                                  (if (ohm/node-terminal? (load result) node)
                                      (- (primitive/cast i64
                                                         (slice-get (ohm/node-source-string (load result)
                                                                                            node)
                                                                    0))
                                         48)
                                      (+ (ohm/evaluate-semantic-child! (mut evaluation)
                                                                       node
                                                                       0
                                                                       arguments)
                                         (ohm/evaluate-semantic-child! (mut evaluation)
                                                                       node
                                                                       1
                                                                       arguments)))))))

(defstruct IterationOperation [])

(impl ohm/OhmLazySemanticAction IterationOperation
  (semantic-grammar-name [(self (ptr IterationOperation))] (-> (slice u8)) "IterationGrammar")
  (semantic-grammar-token [(self (ptr IterationOperation))]
                          (-> (ptr u8))
                          (iteration-grammar-token))
  (semantic-formal-count [(self (ptr IterationOperation))] (-> i64) 0)
  (semantic-action-kind [(self (ptr IterationOperation))
                         (result (ptr ohm/MatchResult))
                         (node i64)]
                        (-> i64)
                        (if (or (ohm/node-terminal? (load result) node)
                                (ohm/node-iteration? (load result) node))
                            1
                            0))
  (apply-lazy-semantic-action [(self (ptr IterationOperation))
                               (evaluation (mut ohm/SemanticEvaluation))
                               (node i64)
                               (action-kind i64)
                               (arguments (slice i64))]
                              (-> i64)
                              (let [result (.result evaluation)]
                                (if (ohm/node-terminal? (load result) node)
                                    (- (primitive/cast i64
                                                       (slice-get (ohm/node-source-string (load result)
                                                                                          node)
                                                                  0))
                                       48)
                                    (if (ohm/node-optional? (load result) node)
                                        100
                                        (let [(mut total) 0
                                              count
                                                (ohm/node-child-count (load result)
                                                                      node)]
                                          (for [index 0 count]
                                            (set! total
                                                  (+ (load total)
                                                     (ohm/evaluate-semantic-child! (mut evaluation)
                                                                                   node
                                                                                   index
                                                                                   arguments))))
                                          (load total)))))))

