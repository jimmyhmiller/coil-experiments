(module tests.ohm.visitor-family-dump-runtime)

(import "coil.io" :as io)
(import "tests.ohm.generic-visitor-family-runtime" :as generic)
(import "tests.ohm.visitor-family-runtime" :as fixture)

(defn emit-value [(label (slice u8)) (value i64)] (-> i64)
  (io/print-str (io/stdout) label)
  (io/print-str (io/stdout) "|")
  (io/print-int (io/stdout) value)
  (io/write-line (io/stdout) "")
  0)

(defn main [] (-> i64)
  (emit-value "basic" (fixture/basic-value))
  (emit-value "array" (fixture/array-value false))
  (emit-value "array-extra" (fixture/array-value true))
  (emit-value "arguments" (fixture/operation-arguments-value))
  (emit-value "arity-and-actions" (if (fixture/validation-test) 1 0))
  (emit-value "bad-tag" (if (fixture/unrecognized-tag-test "bad") 1 0))
  (emit-value "prototype-tag"
              (if (fixture/unrecognized-tag-test "toString") 1 0))
  (let [value (generic/generic-visitor-example)]
    (io/print-str (io/stdout) "generic-struct|")
    (io/print-int (io/stdout) (.sum value))
    (io/print-str (io/stdout) "|")
    (io/print-int (io/stdout) (.depth value))
    (io/print-str (io/stdout) "|")
    (io/write-line (io/stdout) (.label value)))
  0)
