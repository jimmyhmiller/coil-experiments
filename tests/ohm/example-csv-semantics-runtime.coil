(module tests.ohm.example-csv-semantics-runtime)

(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "coil.primitive" :as primitive)
(import "coil.slice" :use [slice-get slice-len])
(import "coil.str" :as str)
(import "experiments.ohm.runtime" :as ohm)

(build-ohm-grammar
  (grammars
    (grammar CSV
      (withDefaultStartRule csv)
      (define csv [] (seq (app row)
                          (star (seq (app eol) (not (app end)) (app row)))
                          (opt (app eol))))
      (define row [] (seq (app col) (star (seq (terminal ",") (app col)))))
      (define col [] (star (app colChar)))
      (define colChar [] (seq (not (alt (app eol) (terminal ","))) (app any)))
      (define eol [] (seq (opt (terminal "\r")) (terminal "\n"))))))

(defn text-hash [(text (slice u8))] (-> i64)
  (let [(mut value) 7]
    (for [index 0 (slice-len text)]
      (set! value (+ (* (load value) 131)
                     (primitive/cast i64 (slice-get text index)))))
    (load value)))

(defn append-value [(aggregate i64) (value i64)] (-> i64)
  (+ (* aggregate 1000003) value))

(defstruct CsvValueAction [(token (ptr u8))])

(impl ohm/OhmLazySemanticAction CsvValueAction
  (semantic-grammar-name [(self (ptr CsvValueAction))] (-> (slice u8)) "CSV")
  (semantic-grammar-token [(self (ptr CsvValueAction))] (-> (ptr u8)) (.token self))
  (semantic-formal-count [(self (ptr CsvValueAction))] (-> i64) 0)
  (semantic-action-kind [(self (ptr CsvValueAction))
                         (result (ptr ohm/MatchResult))
                         (node i64)] (-> i64)
    (let [name (ohm/node-rule (load result) node)]
      (if (or (str/str-eq name "csv")
              (or (str/str-eq name "row") (str/str-eq name "col")))
          1
          0)))
  (apply-lazy-semantic-action [(self (ptr CsvValueAction))
                               (evaluation (mut ohm/SemanticEvaluation))
                               (node i64)
                               (kind i64)
                               (arguments (slice i64))] (-> i64)
    (let [result (.result evaluation)
          name (ohm/node-rule (load result) node)]
      (cond (str/str-eq name "col")
              (text-hash (ohm/node-source-string (load result) node))
            (str/str-eq name "row")
              (let [(mut value) (append-value 17
                                  (ohm/evaluate-semantic-child!
                                    (mut evaluation) node 0 arguments))
                    rest (ohm/node-child (load result) node 2)]
                (for [index 0 (ohm/node-child-count (load result) rest)]
                  (set! value
                    (append-value
                      (load value)
                      (ohm/evaluate-semantic-node!
                        (mut evaluation)
                        (ohm/node-child (load result) rest index)
                        arguments))))
                (load value))
            :else
              (let [(mut value) (append-value 23
                                  (ohm/evaluate-semantic-child!
                                    (mut evaluation) node 0 arguments))
                    rows (ohm/node-child (load result) node 2)]
                (for [index 0 (ohm/node-child-count (load result) rows)]
                  (set! value
                    (append-value
                      (load value)
                      (ohm/evaluate-semantic-node!
                        (mut evaluation)
                        (ohm/node-child (load result) rows index)
                        arguments))))
                (load value))))))

(defn expected-row-1 [] (-> i64)
  (append-value (append-value (append-value 17 (text-hash "foo"))
                              (text-hash "bar"))
                (text-hash "baz")))

(defn expected-csv [] (-> i64)
  (let [row-2 (append-value (append-value 17 (text-hash "foo")) (text-hash "bar"))
        row-3 (append-value 17 (text-hash ""))
        row-4 (append-value (append-value (append-value 17 (text-hash "foo"))
                                         (text-hash ""))
                            (text-hash "baz"))
        row-5 (append-value (append-value (append-value 17 (text-hash ""))
                                         (text-hash "bar"))
                            (text-hash "baz"))
        row-6 (append-value 17 (text-hash "foo"))]
    (append-value
      (append-value
        (append-value
          (append-value
            (append-value
              (append-value 23 (expected-row-1))
              row-2)
            row-3)
          row-4)
        row-5)
      row-6)))

(defn evaluate-csv [(input (slice u8))] (-> i64)
  (let [(mut match) (parse-tree input)
        action (primitive/alloc-stack CsvValueAction)
        _ (store! (field action token) (ohm/match-grammar-token (load match)))
        (mut arguments) (al/al-new [i64] (alloc/malloc-allocator))
        (mut evaluation) (ohm/new-semantic-evaluation action (mut match) false)
        value (ohm/evaluate-semantic-root! (mut evaluation)
                                           (al/al-slice [i64] (load arguments)))
        valid (and (ohm/match-succeeded? (load match))
                   (not (ohm/semantic-evaluation-failed? (mut evaluation))))]
    (ohm/free-semantic-evaluation! (mut evaluation))
    (al/al-free! (mut arguments))
    (ohm/free-match! (mut match))
    (if valid value -1)))

(defn main [] (-> i64)
  (let [input "foo,bar,baz\nfoo,bar\n\nfoo,,baz\n,bar,baz\nfoo"
        wanted (expected-csv)
        without-final-eol (evaluate-csv input)
        with-final-eol
          (evaluate-csv "foo,bar,baz\nfoo,bar\n\nfoo,,baz\n,bar,baz\nfoo\n")]
    (if (and (= without-final-eol wanted) (= with-final-eol wanted)) 0 1)))
