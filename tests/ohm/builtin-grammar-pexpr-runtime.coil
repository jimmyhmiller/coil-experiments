(module tests.ohm.builtin-grammar-pexpr-runtime)

(import "coil.alloc" :as alloc)
(import "coil.str" :as str)
(import "experiments.ohm.pexprs" :as pexprs)
(import "experiments.ohm.runtime" :as ohm)

(defn rule-names-match? [(grammar (ptr ohm/OhmPExprGrammar))
                         (names (slice (slice u8)))] (-> bool)
  (if (!= (ohm/ohm-pexpr-rule-count grammar) (len names))
      false
      (let [(mut valid) true]
        (for [index 0 (len names)]
          (if (not (str/str-eq (ohm/ohm-pexpr-rule-name grammar index)
                               (get names index)))
              (set! valid false)
              0))
        (load valid))))

(defn rule-exact? [(grammar (ptr ohm/OhmPExprGrammar))
                   (index i64)
                   (name (slice u8))
                   (body-string (slice u8))
                   (display-string (slice u8))
                   (start i64)
                   (end i64)] (-> bool)
  (let [body (ohm/ohm-pexpr-rule-body grammar index)]
    (and (str/str-eq (ohm/ohm-pexpr-rule-name grammar index) name)
         (and (str/str-eq (ohm/ohm-pexpr-to-string grammar body) body-string)
              (and (str/str-eq (ohm/ohm-pexpr-to-display-string grammar body)
                               display-string)
                   (and (= (ohm/ohm-pexpr-rule-source-start grammar index) start)
                        (= (ohm/ohm-pexpr-rule-source-end grammar index) end)))))))

(defn main [] (-> i64)
  (let [(mut proto) (pexprs/new-proto-built-in-pexprs (alloc/malloc-allocator))
        (mut builtins) (pexprs/new-built-in-pexprs (alloc/malloc-allocator))
        (mut indentation)
          (pexprs/new-indentation-sensitive-pexprs (alloc/malloc-allocator))
        (mut valid) true]
    (if (!= (ohm/ohm-pexpr-rule-count (mut proto)) 8) (set! valid false) 0)
    (if (not (str/str-eq (ohm/ohm-pexpr-rule-name (mut proto) 0) "any"))
        (set! valid false) 0)
    (if (not (str/str-eq (ohm/ohm-pexpr-rule-name (mut proto) 7) "space"))
        (set! valid false) 0)
    (if (!= (ohm/ohm-pexpr-rule-count (mut builtins)) 11) (set! valid false) 0)
    (if (not (str/str-eq (ohm/ohm-pexpr-rule-name (mut builtins) 0) "alnum"))
        (set! valid false) 0)
    (if (not (str/str-eq (ohm/ohm-pexpr-rule-name (mut builtins) 10)
                         "applySyntactic"))
        (set! valid false) 0)
    (if (not (ohm/ohm-pexpr-rule-primitive? (mut proto) 0)) (set! valid false) 0)
    (if (!= (ohm/ohm-pexpr-rule-formal-count (mut proto) 2) 1) (set! valid false) 0)
    (if (!= (ohm/ohm-pexpr-rule-formal-count (mut builtins) 4) 2)
        (set! valid false) 0)
    (if (!= (ohm/ohm-pexpr-rule-count (mut indentation)) 3) (set! valid false) 0)
    (if (not (rule-exact? (mut indentation) 0 "indent" "indent" "indent" -1 -1))
        (set! valid false) 0)
    (if (not (rule-exact? (mut indentation) 1 "dedent" "dedent" "dedent" -1 -1))
        (set! valid false) 0)
    (if (not (rule-exact? (mut indentation) 2 "any"
                          "((indent | dedent | any) | any)" "[Extend]" -1 -1))
        (set! valid false) 0)
    (if (not (rule-exact? (mut proto) 0 "any" "any" "any" -1 -1))
        (set! valid false) 0)
    (if (not (rule-exact? (mut proto) 1 "end" "end" "end" -1 -1))
        (set! valid false) 0)
    (let [case-body (ohm/ohm-pexpr-rule-body (mut proto) 2)]
      (if (or (!= (ohm/ohm-pexpr-kind (mut proto) case-body) 17)
              (not (str/str-eq
                     (ohm/ohm-pexpr-to-display-string (mut proto) case-body)
                     "$0 (case-insensitive)")))
          (set! valid false) 0))
    (if (not (rule-exact? (mut proto) 3 "lower" "\\p{Ll}"
                          "Unicode [Ll] character" -1 -1)) (set! valid false) 0)
    (if (not (rule-exact? (mut proto) 4 "upper" "\\p{Lu}"
                          "Unicode [Lu] character" -1 -1)) (set! valid false) 0)
    (if (not (rule-exact? (mut proto) 5 "unicodeLtmo" "\\p{Ltmo}"
                          "Unicode [Ltmo] character" -1 -1)) (set! valid false) 0)
    (if (not (rule-exact? (mut proto) 6 "spaces" "space*" "space*" -1 -1))
        (set! valid false) 0)
    (if (not (rule-exact? (mut proto) 7 "space" "\"\\u0000\"..\" \""
                          "\"\\u0000\"..\" \"" -1 -1))
        (set! valid false) 0)
    (if (not (rule-exact? (mut builtins) 0 "alnum" "(letter | digit)"
                          "letter\n    | digit" 18 78)) (set! valid false) 0)
    (if (not (rule-exact? (mut builtins) 1 "letter"
                          "(lower | upper | unicodeLtmo)"
                          "lower\n    | upper\n    | unicodeLtmo" 82 142))
        (set! valid false) 0)
    (if (not (rule-exact? (mut builtins) 2 "digit" "\"0\"..\"9\""
                          "\"0\"..\"9\"" 146 177)) (set! valid false) 0)
    (if (not (rule-exact? (mut builtins) 3 "hexDigit"
                          "(digit | \"a\"..\"f\" | \"A\"..\"F\")"
                          "digit\n    | \"a\"..\"f\"\n    | \"A\"..\"F\""
                          181 254)) (set! valid false) 0)
    (if (not (rule-exact? (mut builtins) 4 "ListOf"
                          "(NonemptyListOf<$0,$1> | EmptyListOf<$0,$1>)"
                          "NonemptyListOf<elem, sep>\n    | EmptyListOf<elem, sep>"
                          258 336)) (set! valid false) 0)
    (if (not (rule-exact? (mut builtins) 5 "NonemptyListOf" "($0 ($1 $0)*)"
                          "elem (sep elem)*" 340 388)) (set! valid false) 0)
    (if (not (rule-exact? (mut builtins) 6 "EmptyListOf" "()" "" 392 434))
        (set! valid false) 0)
    (if (not (rule-exact? (mut builtins) 7 "listOf"
                          "(nonemptyListOf<$0,$1> | emptyListOf<$0,$1>)"
                          "nonemptyListOf<elem, sep>\n    | emptyListOf<elem, sep>"
                          438 516)) (set! valid false) 0)
    (if (not (rule-exact? (mut builtins) 8 "nonemptyListOf" "($0 ($1 $0)*)"
                          "elem (sep elem)*" 520 568)) (set! valid false) 0)
    (if (not (rule-exact? (mut builtins) 9 "emptyListOf" "()" "" 572 682))
        (set! valid false) 0)
    (if (not (rule-exact? (mut builtins) 10 "applySyntactic" "$0" "$0"
                          685 710)) (set! valid false) 0)
    (ohm/free-ohm-pexpr-grammar! (mut proto))
    (ohm/free-ohm-pexpr-grammar! (mut builtins))
    (ohm/free-ohm-pexpr-grammar! (mut indentation))
    (if (load valid) 0 1)))
