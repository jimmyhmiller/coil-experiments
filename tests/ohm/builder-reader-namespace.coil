(module tests.ohm.builder-reader-namespace)

(import "coil.primitive" :as primitive)
(import "experiments.ohm.pexprs" :use [])
(import "experiments.ohm.runtime" :use [])

(build-ohm-grammar
  (grammars
    (grammar Base
      (define token [] (terminal "a")))
    (grammar G (super Base)
      (withDefaultStartRule start)
      (define start [] (seq (app token) (terminal "b"))))))

(defn main [] (-> i64)
  (if (parse "ab") 0 1))
