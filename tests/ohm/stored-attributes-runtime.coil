(module tests.ohm.stored-attributes-runtime)

(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "coil.primitive" :as primitive)
(import "coil.slice" :use [slice-get])
(import "coil.str" :as str)
(import "experiments.ohm.runtime" :as ohm)
(import "experiments.ohm.stored-attributes" :as stored)

(defn grammar-token [] (-> (ptr u8))
  (primitive/alloc-static u8))

(defstruct InitializePolarity [(attribute (mut stored/StoredAttribute))])

(impl ohm/OhmLazySemanticAction InitializePolarity
  (semantic-grammar-name [(self (ptr InitializePolarity))] (-> (slice u8))
    "Arithmetic")
  (semantic-grammar-token [(self (ptr InitializePolarity))] (-> (ptr u8))
    (grammar-token))
  (semantic-formal-count [(self (ptr InitializePolarity))] (-> i64) 1)
  (semantic-action-kind [(self (ptr InitializePolarity))
                         (result (ptr ohm/MatchResult))
                         (node i64)] (-> i64)
    1)
  (apply-lazy-semantic-action [(self (ptr InitializePolarity))
                               (evaluation (mut ohm/SemanticEvaluation))
                               (node i64)
                               (action-kind i64)
                               (arguments (slice i64))] (-> i64)
    (let [result (.result evaluation)
          inherited (slice-get arguments 0)
          rule (ohm/node-rule (load result) node)
          polarity (if (str/str-eq rule "AddExp_minus") 45 inherited)
          _ (stored/set-stored-attribute!
              (mut (load (field self attribute)))
              (load result)
              node
              polarity)]
      (if (str/str-eq rule "AddExp_minus")
          (let [(mut child-arguments) (al/al-new [i64] (alloc/malloc-allocator))
                _ (push! (mut child-arguments) polarity)
                _ (ohm/evaluate-semantic-child!
                    (mut evaluation)
                    node
                    0
                    (al/al-slice [i64] (load child-arguments)))
                _ (ohm/evaluate-semantic-child!
                    (mut evaluation)
                    node
                    2
                    (al/al-slice [i64] (load child-arguments)))]
            (al/al-free! (mut child-arguments))
            polarity)
          (do
            (for [index 0 (ohm/node-child-count (load result) node)]
              (ohm/evaluate-semantic-child! (mut evaluation) node index arguments))
            polarity)))))

(defn main [] (-> i64)
  (let [(mut state) (ohm/new-parse-state (alloc/malloc-allocator))
        _ (ohm/set-parse-grammar-name! (mut state) "Arithmetic")
        _ (ohm/set-parse-grammar-token! (mut state) (grammar-token))
        exp-frame (ohm/begin-rule! (mut state))
        add-frame (ohm/begin-rule! (mut state))
        minus-frame (ohm/begin-rule! (mut state))
        left-frame (ohm/begin-rule! (mut state))
        left-end (ohm/match-literal-cst! (mut state) "3-1" 0 "3")
        left-rule-end (ohm/succeed-rule! (mut state) "number" 0 left-end)
        operator-end (ohm/match-literal-cst! (mut state) "3-1" left-rule-end "-")
        right-frame (ohm/begin-rule! (mut state))
        right-end (ohm/match-literal-cst! (mut state) "3-1" operator-end "1")
        right-rule-end (ohm/succeed-rule! (mut state) "number" operator-end right-end)
        minus-end (ohm/succeed-rule! (mut state) "AddExp_minus" 0 right-rule-end)
        add-end (ohm/succeed-rule! (mut state) "AddExp" 0 minus-end)
        exp-end (ohm/succeed-rule! (mut state) "Exp" 0 add-end)
        (mut result) (ohm/finish-match (mut state) "3-1" exp-end)
        root (ohm/match-root (load result))
        add-node (ohm/node-child (load result) root 0)
        minus-node (ohm/node-child (load result) add-node 0)
        left-node (ohm/node-child (load result) minus-node 0)
        operator-node (ohm/node-child (load result) minus-node 1)
        (mut attribute)
          (stored/new-stored-attribute
            "polarity"
            "Arithmetic"
            (grammar-token)
            (alloc/malloc-allocator))
        initializer (primitive/alloc-stack InitializePolarity)
        _ (store! (field initializer attribute) (mut attribute))
        (mut init-evaluation)
          (ohm/new-named-semantic-evaluation initializer (mut result) false "initPolarity")
        (mut init-arguments) (al/al-new [i64] (alloc/malloc-allocator))
        _ (push! (mut init-arguments) 61)
        _ (ohm/evaluate-semantic-root!
            (mut init-evaluation)
            (al/al-slice [i64] (load init-arguments)))
        attribute-action-value (stored/new-stored-attribute-action (mut attribute))
        attribute-action (primitive/alloc-stack stored/StoredAttributeAction)
        _ (store! attribute-action attribute-action-value)
        (mut no-arguments) (al/al-new [i64] (alloc/malloc-allocator))
        (mut root-read)
          (ohm/new-named-semantic-evaluation
            attribute-action
            (mut result)
            true
            "polarity")
        root-value
          (ohm/evaluate-semantic-node!
            (mut root-read)
            root
            (al/al-slice [i64] (load no-arguments)))
        (mut add-read)
          (ohm/new-named-semantic-evaluation attribute-action (mut result) true "polarity")
        add-value
          (ohm/evaluate-semantic-node!
            (mut add-read)
            add-node
            (al/al-slice [i64] (load no-arguments)))
        (mut minus-read)
          (ohm/new-named-semantic-evaluation attribute-action (mut result) true "polarity")
        minus-value
          (ohm/evaluate-semantic-node!
            (mut minus-read)
            minus-node
            (al/al-slice [i64] (load no-arguments)))
        (mut left-read)
          (ohm/new-named-semantic-evaluation attribute-action (mut result) true "polarity")
        left-value
          (ohm/evaluate-semantic-node!
            (mut left-read)
            left-node
            (al/al-slice [i64] (load no-arguments)))
        (mut operator-read)
          (ohm/new-named-semantic-evaluation attribute-action (mut result) true "polarity")
        _ (ohm/evaluate-semantic-node!
            (mut operator-read)
            operator-node
            (al/al-slice [i64] (load no-arguments)))
        operator-message (ohm/semantic-evaluation-message (mut operator-read))
        valid
          (and (not (ohm/semantic-evaluation-failed? (mut init-evaluation)))
               (and (= root-value 61)
                    (and (= add-value 61)
                         (and (= minus-value 45)
                              (and (= left-value 45)
                                   (and (ohm/semantic-evaluation-failed? (mut operator-read))
                                        (str/str-eq
                                          operator-message
                                          "Attribute 'polarity' not initialized")))))))]
    (ohm/free-semantic-evaluation! (mut operator-read))
    (ohm/free-semantic-evaluation! (mut left-read))
    (ohm/free-semantic-evaluation! (mut minus-read))
    (ohm/free-semantic-evaluation! (mut add-read))
    (ohm/free-semantic-evaluation! (mut root-read))
    (al/al-free! (mut no-arguments))
    (al/al-free! (mut init-arguments))
    (ohm/free-semantic-evaluation! (mut init-evaluation))
    (stored/free-stored-attribute! (mut attribute))
    (ohm/free-match! (mut result))
    (if valid 0 1)))
