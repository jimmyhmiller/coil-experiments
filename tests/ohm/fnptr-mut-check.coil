(module tests.ohm.fnptr-mut-check)

(import "coil.primitive" :as primitive)
(import "experiments.ohm.runtime" :as ohm)

(defn callback [(state (mut ohm/ParseState))
                (source (slice u8))
                (at i64)
                (expression i64)
                (lexical bool)] (-> i64)
  at)

(defn pointer [] (-> (fnptr c [(mut ohm/ParseState) (slice u8) i64 i64 bool] i64))
  (primitive/fnptr-of callback))
