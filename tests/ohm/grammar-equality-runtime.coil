(module tests.ohm.grammar-equality-runtime)

(import "coil.alloc" :as alloc)
(import "coil.primitive" :as primitive)
(import "coil.primitive" :use [fnptr-of])
(import "experiments.ohm.pexprs" :as pexprs)
(import "experiments.ohm.runtime" :as ohm)

(defn equality-parse [(input (slice u8)) (rule (slice u8))]
                     (-> ohm/MatchResult)
  (primitive/zeroed ohm/MatchResult))

(defn equality-parse-cached [(input (slice u8))
                             (rule (slice u8))
                             (trace bool)
                             (cache (mut ohm/ParseCache))]
                            (-> ohm/MatchResult)
  (primitive/zeroed ohm/MatchResult))

(defn equality-token [] (-> (ptr u8))
  (primitive/cast (ptr u8) (fnptr-of equality-token)))

(defn make-equality-grammar [(name (slice u8)) (start (slice u8))]
                            (-> ohm/OhmGrammar)
  (ohm/new-ohm-grammar
    (ohm/new-ohm-grammar-descriptor name start "ProtoBuiltInRules" "ignored")
    (pexprs/new-built-in-pexprs (alloc/malloc-allocator))
    (fnptr-of equality-parse)
    (fnptr-of equality-parse-cached)
    "" "" "" (equality-token) false (alloc/malloc-allocator)))

(defn equal-parent-a [] (-> ohm/OhmGrammar)
  (make-equality-grammar "BuiltInRules" ""))

(defn equal-parent-b [] (-> ohm/OhmGrammar)
  (make-equality-grammar "BuiltInRules" ""))

(defn different-parent [] (-> ohm/OhmGrammar)
  (make-equality-grammar "DifferentParent" ""))

(defn make-child-a [] (-> ohm/OhmGrammar)
  (let [(mut grammar) (make-equality-grammar "Child" "digit")]
    (ohm/set-ohm-grammar-supergrammar-factory! (mut grammar) (fnptr-of equal-parent-a))
    (load grammar)))

(defn make-child-b [] (-> ohm/OhmGrammar)
  (let [(mut grammar) (make-equality-grammar "Child" "digit")]
    (ohm/set-ohm-grammar-supergrammar-factory! (mut grammar) (fnptr-of equal-parent-b))
    (load grammar)))

(defn make-child-with-different-parent [] (-> ohm/OhmGrammar)
  (let [(mut grammar) (make-equality-grammar "Child" "digit")]
    (ohm/set-ohm-grammar-supergrammar-factory!
      (mut grammar) (fnptr-of different-parent))
    (load grammar)))

(defn main [] (-> i64)
  (let [(mut left) (make-equality-grammar "BuiltInRules" "")
        (mut right) (make-equality-grammar "BuiltInRules" "")
        initially-equal (ohm/ohm-grammar-equals? (mut left) (mut right))
        named-template-methods-match
          (and (= (ohm/ohm-grammar-operation-action-dictionary-template (mut left))
                  (ohm/ohm-grammar-action-dictionary-template (mut left)))
               (= (ohm/ohm-grammar-attribute-action-dictionary-template (mut left))
                  (ohm/ohm-grammar-action-dictionary-template (mut left))))
        merely-named-built-in-is-not-built-in
          (not (ohm/ohm-grammar-is-built-in? (mut left)))
        _ (ohm/ohm-grammar-set-rule-description! (mut left) 0 "changed")
        description-differs (not (ohm/ohm-grammar-equals? (mut left) (mut right)))
        _ (ohm/ohm-grammar-set-rule-description!
            (mut left) 0 "an alpha-numeric character")
        restored (ohm/ohm-grammar-equals? (mut left) (mut right))
        _ (ohm/ohm-grammar-remove-rule! (mut left) 0)
        removed-differs (not (ohm/ohm-grammar-equals? (mut left) (mut right)))
        (mut other-name) (make-equality-grammar "Other" "")
        name-differs (not (ohm/ohm-grammar-equals? (mut right) (mut other-name)))
        (mut child-a) (make-child-a)
        (mut child-b) (make-child-b)
        (mut child-different-parent) (make-child-with-different-parent)
        structurally-equal-parents
          (ohm/ohm-grammar-equals? (mut child-a) (mut child-b))
        structurally-different-parents
          (not (ohm/ohm-grammar-equals? (mut child-a) (mut child-different-parent)))
        valid (and initially-equal
                   (and named-template-methods-match
                   (and merely-named-built-in-is-not-built-in
                   (and description-differs
                        (and restored
                             (and removed-differs
                                  (and name-differs
                                       (and structurally-equal-parents
                                            structurally-different-parents))))))))]
    (ohm/free-ohm-grammar! (mut left))
    (ohm/free-ohm-grammar! (mut right))
    (ohm/free-ohm-grammar! (mut other-name))
    (ohm/free-ohm-grammar! (mut child-a))
    (ohm/free-ohm-grammar! (mut child-b))
    (ohm/free-ohm-grammar! (mut child-different-parent))
    (if valid 0 1)))
