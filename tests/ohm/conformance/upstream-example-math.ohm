// Exact language from examples/math/index.html and examples/viz/index.html.
// The first two cases are the browser example's recognition calls; the third
// is its final semantic input (whose CST is checked by the CST differential).
// @accept 1+2*3
// @reject I CAN HAS CHEEZBURGER?
// @accept-from PriExp  (  	123   ) 
// @accept 33 * 5 + 100
// Exercise every inline case name asserted by the visualization example.
// @accept-node AddExp_plus 1+2
// @accept-node AddExp_minus 2-1
// @accept-node MulExp_times 2*3
// @accept-node MulExp_divide 6/3
// @accept-node ExpExp_power 2^3
// @accept-node PriExp_paren (1)
// @accept-node PriExp_pos +1
// @accept-node PriExp_neg -1
// @accept-node number_fract 1.5
// @accept-node number_whole 15
Arithmetic {
  Exp
    = AddExp

  AddExp
    = AddExp "+" MulExp  -- plus
    | AddExp "-" MulExp  -- minus
    | MulExp

  MulExp
    = MulExp "*" ExpExp  -- times
    | MulExp "/" ExpExp  -- divide
    | ExpExp

  ExpExp
    = PriExp "^" ExpExp  -- power
    | PriExp

  PriExp
    = "(" Exp ")"  -- paren
    | "+" PriExp   -- pos
    | "-" PriExp   -- neg
    | ident
    | number

  ident  (an identifier)
    = letter alnum*

  number  (a number)
    = digit* "." digit+  -- fract
    | digit+             -- whole
}
