// Exact grammar and both successful inputs from examples/csv.
// @accept-escaped foo,bar,baz\nfoo,bar\n\nfoo,,baz\n,bar,baz\nfoo
// @accept-escaped foo,bar,baz\nfoo,bar\n\nfoo,,baz\n,bar,baz\nfoo\n
// @accept-escaped-from eol \n
// @accept-node row 
// @accept-node col 
// @accept-node row ,
CSV {
  csv = row (eol ~end row)* eol?
  row = col ("," col)*
  col = colChar*
  colChar = ~(eol | ",") any
  eol = "\r"? "\n"
}
