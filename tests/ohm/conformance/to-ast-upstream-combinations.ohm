// Ported from real examples and explicit node reintroduction in test-toAST.js.
// @to-ast-upstream-combinations
// @accept 10 + 20 - 30
Arithmetic {
  Exp = AddExp
  AddExp
    = AddExp "+" PriExp  -- plus
    | AddExp "-" PriExp  -- minus
    | PriExp
  PriExp
    = "(" Exp ")"  -- paren
    | number
  number = digit+
}
