// Ported from the nested and indirect left recursion section.
// @accept-node addExpRec 7+8*9+0
// @accept 1
// @accept 2+3
// @accept 5*6
// @reject 4+
LeftRecursionNestedIndirect {
  addExp = a | c
  a = b
  b = addExpRec
  addExpRec = addExp "+" mulExp
  c = d
  d = mulExp
  mulExp = e | g
  e = f
  f = mulExpRec
  g = h
  h = priExp
  mulExpRec = mulExp "*" priExp
  priExp = "0".."9"
}
