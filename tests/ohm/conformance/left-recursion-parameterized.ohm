// Ported from the left recursion case in test-parameterized-rules.js.
// @accept-node LeftAssoc_rec 1 + 2 + 3
// @accept-node LeftAssoc_base 7
// @reject 1+
// @accept-from LeftAssoc<digit,"+"> 4+5+6
// @reject-from LeftAssoc<digit,"+"> 4+
LeftRecursionParameterized {
  Start = LeftAssoc<digit, "+">

  LeftAssoc<expr, op>
    = LeftAssoc<expr, op> op expr  -- rec
    | expr                         -- base
}
