// Ported from packages/ohm-js/test/test-parameterized-rules.js.
// @accept-node Pair (1,2)
// @accept-node two 42
// @accept-node List_some x, x,x
// @accept-node List_none 
// @reject (1,x)
// @reject 45
ParameterizedRules {
  Start
    = Pair<digit>
    | two<~"5" digit>
    | List<"x", ",">

  Pair<elem> = "(" elem "," elem ")"
  two<x> = x x

  List<elem, sep>
    = elem (sep elem)*  -- some
    |                   -- none
}
