// Ported from packages/ohm-js/test/test-incremental.js:
// "incremental parsing + attributes = incremental computation".
// @accept (1+2)*3-4
// @incremental-attribute
Arithmetic {
  exp = addExp

  addExp = addExp "+" mulExp  -- plus
         | addExp "-" mulExp  -- minus
         | mulExp

  mulExp = mulExp "*" priExp  -- times
         | mulExp "/" priExp  -- divide
         | priExp

  priExp = "(" exp ")"  -- paren
         | number

  number (a number) = number digit  -- rec
                    | digit
}
