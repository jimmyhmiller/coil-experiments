// Ported from the complex-parameter behavior in test-parameterized-rules.js.
// @accept-from two<~"5"digit> 42
// @reject-from two<~"5"digit> 45
// @accept-from App<("a"|"b")> a
// @accept-from App<("a"|"b")> b
// @reject-from App<("a"|"b")> c
// @accept-from App<"a"+> aaa
// @reject-from App<"a"+> 
// @accept-from App<"a"?> a
// @accept-from App<"a"?> 
// @accept-from one<&"a"> a
// @reject-from one<&"a"> b
DynamicCompoundExpressionStart {
  two<x> = x x
  one<x> = x "a"
  App<x> = x
}
