// Ported from the nested left recursion section of test-ohm-syntax.js.
// @accept-node addExpRec 7+8*9+0
// @accept-node mulExpRec 2*3
// @reject 1+
LeftRecursionNested {
  addExp = addExpRec | mulExp
  addExpRec = addExp "+" mulExp
  mulExp = mulExpRec | priExp
  mulExpRec = mulExp "*" priExp
  priExp = "0".."9"
}
