// Ported from test-errors.js: non-fluffy failures subsume fluffy failures.
// @reject-error 2 ")" |(1
ArithmeticFailureFluffy {
  exp = addExp
  addExp = addExp "+" mulExp -- plus
         | addExp "-" mulExp -- minus
         | mulExp
  mulExp = mulExp "*" priExp -- times
         | mulExp "/" priExp -- divide
         | priExp
  priExp = "(" exp ")" -- paren
         | number
  number (a number) = number digit -- rec
                    | digit
}
