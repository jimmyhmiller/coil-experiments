// Ported from the complex-parameter behavior in test-parameterized-rules.js.
// @accept-from App<(foo|"x")> f
// @accept-from App<(foo|"x")> x
// @reject-from App<(foo|"x")> y
// @accept-from App<pair<"a","b">> ab
// @reject-from App<pair<"a","b">> aa
// @accept-from App<pair<wrap<"a">,"b">> (a)b
// @reject-from App<pair<wrap<"a">,"b">> ab
DynamicNestedUserRuleStart {
  App<x> = x
  pair<x, y> = x y
  wrap<x> = "(" x ")"
  foo = "f"
}
