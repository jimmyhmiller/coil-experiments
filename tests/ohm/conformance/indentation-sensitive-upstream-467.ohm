// Ported from upstream's skipped `#467 - dedent not working` regression.
// @indentation-dedent-regression
G <: IndentationSensitive {
  IfExpr = "if" Expr ":" Block
  Block = indent Expr+ dedent
  Expr = IfExpr
       | "True2"
       | "True3"
       | "True"
       | "False"
       | number
  number = digit+
}
