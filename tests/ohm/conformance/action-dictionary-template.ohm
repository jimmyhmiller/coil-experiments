// @accept-from qux 100
G1 {
  foo = bar
  bar = baz baz baz
  baz = qux
  qux = quux "123"
  quux = "42"
  aaa = "duh"
  bbb = ~aaa qux  -- blah
}
G2 <: G1 {
  qux := "100"
}
