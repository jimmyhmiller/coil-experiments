// Ported from packages/ohm-js/test/test-indentation-sensitive.js.
// @accept-from WithDedent   x
// @reject-from WithoutDedent   x
// @reject-from Literal   x
// @reject-from Range   x
// @reject-from CaseInsensitive   x
// @reject-from Lower   x
// @accept-from AnyBefore   x
// @accept-from AnyAfter   x
// @reject-from DoubleIndent   x
// @accept-from Backtracking   x
G <: IndentationSensitive {
  WithDedent = indent "x" dedent
  WithoutDedent = indent "x"
  Literal = "x"
  Range = "a".."z"
  CaseInsensitive = caseInsensitive<"x">
  Lower = lower
  AnyBefore = any "x" dedent
  AnyAfter = indent "x" any
  DoubleIndent = indent indent "x" dedent
  Backtracking = (indent "y" | indent "x") dedent
}
