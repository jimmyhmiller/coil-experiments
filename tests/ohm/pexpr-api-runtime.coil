(module tests.ohm.pexpr-api-runtime)

(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "coil.str" :as str)
(import "experiments.ohm.pexprs" :as pexprs)
(import "experiments.ohm.runtime" :as ohm)

(const RECIPE
  "[\"grammar\",{},\"G\",null,\"empty\",{\"empty\":[\"define\",{},null,[],[\"terminal\",{},\"\"]],\"pair\":[\"define\",{},null,[],[\"seq\",{},[\"terminal\",{},\"\"],[\"terminal\",{},\"x\"]]],\"choice\":[\"define\",{},null,[],[\"alt\",{},[\"terminal\",{},\"x\"],[\"terminal\",{},\"\"]]],\"many\":[\"define\",{},null,[],[\"star\",{},[\"terminal\",{},\"x\"]]],\"someEmpty\":[\"define\",{},null,[],[\"plus\",{},[\"terminal\",{},\"\"]]],\"negative\":[\"define\",{},null,[],[\"not\",{},[\"terminal\",{},\"x\"]]],\"ahead\":[\"define\",{},null,[],[\"lookahead\",{},[\"terminal\",{},\"x\"]]],\"lexEmpty\":[\"define\",{},null,[],[\"lex\",{},[\"terminal\",{},\"\"]]],\"recursive\":[\"define\",{},null,[],[\"alt\",{},[\"app\",{},\"recursive\",[]],[\"terminal\",{},\"\"]]],\"parameterized\":[\"define\",{},\"parameterized desc\",[\"x\"],[\"param\",{},0]],\"useParam\":[\"define\",{},null,[],[\"app\",{},\"parameterized\",[[\"terminal\",{},\"\"]]]],\"finish\":[\"define\",{},null,[],[\"end\",{}]]}]")

(defn rule-body [(grammar (ptr ohm/OhmPExprGrammar))
                 (name (slice u8))] (-> i64)
  (ohm/ohm-pexpr-rule-body grammar (pexprs/pexpr-find-rule grammar name)))

(defn main [] (-> i64)
  (let [(mut grammar)
          (pexprs/ohm-pexprs-from-recipe RECIPE "" (alloc/malloc-allocator))
        empty (rule-body (mut grammar) "empty")
        pair (rule-body (mut grammar) "pair")
        choice (rule-body (mut grammar) "choice")
        many (rule-body (mut grammar) "many")
        some-empty (rule-body (mut grammar) "someEmpty")
        negative (rule-body (mut grammar) "negative")
        ahead (rule-body (mut grammar) "ahead")
        lex-empty (rule-body (mut grammar) "lexEmpty")
        recursive (rule-body (mut grammar) "recursive")
        use-param (rule-body (mut grammar) "useParam")
        parameterized-index (pexprs/pexpr-find-rule (mut grammar) "parameterized")
        finish (rule-body (mut grammar) "finish")
        (mut valid) true]
    (if (!= (pexprs/pexpr-get-arity (mut grammar) empty) 1) (set! valid false) 0)
    (if (not (pexprs/pexpr-is-nullable? (mut grammar) empty)) (set! valid false) 0)
    (if (!= (pexprs/pexpr-get-arity (mut grammar) pair) 2) (set! valid false) 0)
    (if (pexprs/pexpr-is-nullable? (mut grammar) pair) (set! valid false) 0)
    (if (!= (pexprs/pexpr-get-arity (mut grammar) choice) 1) (set! valid false) 0)
    (if (not (pexprs/pexpr-is-nullable? (mut grammar) choice)) (set! valid false) 0)
    (if (!= (pexprs/pexpr-get-arity (mut grammar) many) 1) (set! valid false) 0)
    (if (not (pexprs/pexpr-is-nullable? (mut grammar) many)) (set! valid false) 0)
    (if (pexprs/pexpr-is-nullable? (mut grammar) some-empty) (set! valid false) 0)
    (if (!= (pexprs/pexpr-get-arity (mut grammar) negative) 0) (set! valid false) 0)
    (if (not (pexprs/pexpr-is-nullable? (mut grammar) negative)) (set! valid false) 0)
    (if (!= (pexprs/pexpr-get-arity (mut grammar) ahead) 1) (set! valid false) 0)
    (if (not (pexprs/pexpr-is-nullable? (mut grammar) ahead)) (set! valid false) 0)
    (if (not (pexprs/pexpr-is-nullable? (mut grammar) lex-empty)) (set! valid false) 0)
    (if (not (pexprs/pexpr-is-nullable? (mut grammar) recursive)) (set! valid false) 0)
    (if (not (pexprs/pexpr-is-nullable? (mut grammar) use-param)) (set! valid false) 0)
    (if (!= (ohm/ohm-pexpr-rule-formal-count (mut grammar) parameterized-index) 1)
        (set! valid false)
        0)
    (if (not (str/str-eq
               (ohm/ohm-pexpr-rule-formal (mut grammar) parameterized-index 0)
               "x"))
        (set! valid false)
        0)
    (if (not (ohm/ohm-pexpr-rule-has-description?
               (mut grammar)
               parameterized-index))
        (set! valid false)
        0)
    (if (not (str/str-eq
               (ohm/ohm-pexpr-rule-description (mut grammar) parameterized-index)
               "parameterized desc"))
        (set! valid false)
        0)
    (if (not (pexprs/pexpr-is-nullable? (mut grammar) finish)) (set! valid false) 0)
    (let [a (pexprs/pexpr-new-terminal! (mut grammar) "a")
          b (pexprs/pexpr-new-terminal! (mut grammar) "b")
          (mut no-args) (al/al-new [i64] (alloc/malloc-allocator))
          c (pexprs/pexpr-new-apply! (mut grammar)
                                     "c"
                                     (al/al-slice [i64] (load no-args)))
          lexical-c (pexprs/pexpr-new-unary! (mut grammar) 10 c)
          optional-c (pexprs/pexpr-new-unary! (mut grammar) 7 lexical-c)
          (mut alternatives) (al/al-new [i64] (alloc/malloc-allocator))
          _ (push! (mut alternatives) b)
          _ (push! (mut alternatives) optional-c)
          alternative
            (pexprs/pexpr-new-alt! (mut grammar)
                                   (al/al-slice [i64] (load alternatives)))
          negative (pexprs/pexpr-new-unary! (mut grammar) 8 alternative)
          ahead-a (pexprs/pexpr-new-unary! (mut grammar) 9 a)
          range (pexprs/pexpr-new-range! (mut grammar) "a" "z")
          (mut factors) (al/al-new [i64] (alloc/malloc-allocator))
          _ (push! (mut factors) ahead-a)
          _ (push! (mut factors) negative)
          _ (push! (mut factors) range)
          sequence
            (pexprs/pexpr-new-seq! (mut grammar)
                                   (al/al-slice [i64] (load factors)))
          unicode (pexprs/pexpr-new-unicode-char! (mut grammar) "Nd")
          any (pexprs/pexpr-new-any! (mut grammar))
          end (pexprs/pexpr-new-end! (mut grammar))
          param (pexprs/pexpr-new-param! (mut grammar) 0)
          case-insensitive
            (pexprs/pexpr-new-case-insensitive-terminal! (mut grammar) param)
          sourced-alt (pexprs/pexpr-new-alt! (mut grammar)
                                              (al/al-slice [i64] (load alternatives)))
          _ (pexprs/pexpr-with-source!
              (mut grammar)
              sourced-alt
              (ohm/new-ohm-interval "xx  a | b  yy" 2 11))
          (mut nested-alt-arguments) (al/al-new [i64] (alloc/malloc-allocator))
          _ (push! (mut nested-alt-arguments) alternative)
          _ (push! (mut nested-alt-arguments) a)
          flattened-alt
            (pexprs/pexpr-builder-alt!
              (mut grammar)
              (al/al-slice [i64] (load nested-alt-arguments)))
          (mut one-argument) (al/al-new [i64] (alloc/malloc-allocator))
          _ (push! (mut one-argument) a)
          sole (pexprs/pexpr-builder-seq!
                 (mut grammar)
                 (al/al-slice [i64] (load one-argument)))]
      (if (not (str/str-eq (ohm/ohm-pexpr-to-string (mut grammar) sequence)
                           "(&\"a\" ~(\"b\" | #(c)?) \"a\"..\"z\")"))
          (set! valid false)
          0)
      (if (not (str/str-eq (ohm/ohm-pexpr-to-display-string
                             (mut grammar)
                             sequence)
                           "[Seq]"))
          (set! valid false)
          0)
      (if (!= (pexprs/pexpr-get-arity (mut grammar) sequence) 2)
          (set! valid false)
          0)
      (if (not (str/str-eq (ohm/ohm-pexpr-to-string (mut grammar) unicode)
                           "\\p{Nd}"))
          (set! valid false)
          0)
      (if (not (str/str-eq (ohm/ohm-pexpr-to-display-string
                             (mut grammar)
                             unicode)
                           "Unicode [Nd] character"))
          (set! valid false)
          0)
      (if (not (str/str-eq (ohm/ohm-pexpr-to-string (mut grammar) any) "any"))
          (set! valid false)
          0)
    (if (not (str/str-eq (ohm/ohm-pexpr-to-string (mut grammar) end) "end"))
        (set! valid false)
        0)
    (if (not (str/str-eq
               (ohm/ohm-pexpr-to-display-string (mut grammar) case-insensitive)
               "$0 (case-insensitive)"))
        (set! valid false)
        0)
    (if (!= (pexprs/pexpr-get-arity (mut grammar) case-insensitive) 1)
        (set! valid false)
        0)
    (if (pexprs/pexpr-is-nullable? (mut grammar) case-insensitive)
        (set! valid false)
        0)
    (if (not (str/str-eq
               (ohm/ohm-pexpr-to-display-string (mut grammar) sourced-alt)
               "a | b"))
        (set! valid false)
        0)
    (if (!= (ohm/ohm-pexpr-child-count (mut grammar) flattened-alt) 3)
        (set! valid false)
        0)
    (if (!= sole a) (set! valid false) 0)
    (al/al-free! (mut nested-alt-arguments))
    (al/al-free! (mut one-argument))
      (al/al-free! (mut no-args))
      (al/al-free! (mut alternatives))
      (al/al-free! (mut factors)))
    (ohm/free-ohm-pexpr-grammar! (mut grammar))
    (if (load valid) 0 1)))
