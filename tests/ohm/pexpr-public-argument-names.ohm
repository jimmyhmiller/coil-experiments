// @pexpr-upstream-argument-names
G {
 Start = &((foo bars foo)+)
 foo = "ab" | letter* | "a".."z"
 MoreAlt = "a" "b" | "c" "c"
 bars = ~"a" (letter "b" | digit "b") foo? "+"
 MoreSeq = &(foo "a" foo) foo "a" foo
 plus = foo "+" bars
 MoreOpts = ("+" Start)?
 ranges = "1".."9" | "!".."@"
 Pair<elem> = "(" elem "," elem ")"
}
