(module tests.borrow-checker.conflicting-borrow)
(import "experiments.borrow-checker.borrow-checker" :use *)
(defstruct Item [(value i64)])
(defn main [] (-> i64)
  (let [(mut item) (box-new (Item :value 42))]
    (with-box-ref [shared item]
      (with-box-mut [exclusive item]
        (set! (.value exclusive) 0))
      (.value shared))))
