(module tests.borrow-checker.named-owned-sum-match)
(import "coil.result" :use *)
(import "experiments.borrow-checker.borrow-checker" :use *)
(defstruct Item [(value i64)])
(defn main [] (-> i64)
  (let [optional (Some (box-new (Item :value 42)))]
    (match optional
      (Some [item] 0)
      (None [] 1))))
