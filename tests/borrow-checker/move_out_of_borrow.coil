(module tests.borrow-checker.move-out-of-borrow)
(import "experiments.borrow-checker.borrow-checker" :use *)
(defstruct Child [(value i64)])
(defstruct Parent [(child (Box Child))])
(defn main [] (-> i64)
  (let [owner (box-new (Parent :child (box-new (Child :value 42))))]
    (with-box-ref [view owner]
      (let [stolen (load view)] 0))))
