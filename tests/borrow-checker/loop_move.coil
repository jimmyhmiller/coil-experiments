(module tests.borrow-checker.loop-move)
(import "experiments.borrow-checker.borrow-checker" :use *)
(defstruct Item [(value i64)])
(defn consume [(item (Box Item))] (-> i64) (.value (box-borrow [Item] item)))
(defn main [] (-> i64)
  (let [item (box-new (Item :value 42))]
    (loop (consume item))
    0))
