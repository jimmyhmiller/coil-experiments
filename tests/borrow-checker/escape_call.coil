(module tests.borrow-checker.escape-call)
(import "experiments.borrow-checker.borrow-checker" :use *)
(defstruct Item [(value i64)])
(defn retain [(pointer (ptr Item))] (-> i64) 0)
(defn attempt [(item (ref (Box Item)))] (-> i64)
  (with-box-ref [view item] (retain view)))
(defn main [] (-> i64) 0)
