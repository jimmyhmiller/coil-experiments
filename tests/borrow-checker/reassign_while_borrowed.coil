(module tests.borrow-checker.reassign-while-borrowed)
(import "experiments.borrow-checker.borrow-checker" :use *)
(defstruct Item [(value i64)])
(defn main [] (-> i64)
  (let [(mut item) (box-new (Item :value 1))]
    (with-box-ref [view item]
      (set! item (box-new (Item :value 2)))
      (.value view))))
