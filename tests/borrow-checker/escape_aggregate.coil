(module tests.borrow-checker.escape-aggregate)
(import "experiments.borrow-checker.borrow-checker" :use *)
(defstruct Item [(value i64)])
(defstruct View [(pointer (ptr Item))])
(defn escape [(item (ref (Box Item)))] (-> View)
  (with-box-ref [view item] (View :pointer view)))
(defn main [] (-> i64) 0)
