(module tests.borrow-checker.unsafe-boundary)
(import "experiments.borrow-checker.borrow-checker" :use *)
(extern strlen :cc c [(ptr i8)] (-> i64))
(defstruct Item [(value i64)])
(defn inspect-foreign [(pointer (ptr Item))] (-> i64) (.value pointer))
(defn main [] (-> i64)
  (let [item (box-new (Item :value 42))]
    (with-box-ref [view item]
      (if (and (= (unsafe-borrow (inspect-foreign view)) 42)
               (= (unsafe-borrow (strlen c"coil")) 4))
          0
          1))))
