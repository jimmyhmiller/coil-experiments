(module experiments.c.o3repro)

;; A `bool` struct field read back out of an ArrayList is wrong at -O1 and
;; above, and correct at -O0. The same struct with `i64` in place of `bool` is
;; correct at every level.
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)

(defstruct WithBool [(flag bool)])
(defstruct WithInt  [(flag i64)])

(defn push-bool [(l (mut (al/ArrayList WithBool))) (v bool)] (-> i64)
  (al/al-push! [WithBool] (mut l) (load (WithBool :flag v)))
  0)

(defn push-int [(l (mut (al/ArrayList WithInt))) (v i64)] (-> i64)
  (al/al-push! [WithInt] (mut l) (load (WithInt :flag v)))
  0)

(defn main [] (-> i64)
  (let [a (alloc/malloc-allocator)
        (mut lb) (al/al-new [WithBool] a)
        (mut li) (al/al-new [WithInt] a)]
    (push-bool (mut lb) true)
    (push-int (mut li) 1)
    (let [b (al/al-get [WithBool] (load (mut lb)) 0)
          i (al/al-get [WithInt] (load (mut li)) 0)]
      (println "bool field: got {d}, want 1" (if (.flag b) 1 0))
      (println "i64  field: got {d}, want 1" (.flag i))))
  0)
