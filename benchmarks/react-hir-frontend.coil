(module react-hir-frontend-benchmark)

(import "coil.simd" :as v)
(import "coil.primitive" :as p)
(import "coil.slice" :use [slice-data slice-get])
(import "experiments.react-hir-frontend.structural" :as structural)
(import "experiments.react-hir-frontend.lexical" :as lexical)
(import "experiments.react-hir-frontend.frontend" :as frontend)
(import "experiments.react-hir-frontend.tape" :as tape)

(extern malloc :cc c [i64] (-> (ptr u8)))
(extern free :cc c [(ptr u8)] (-> i64))
(extern fopen :cc c [(ptr i8) (ptr i8)] (-> (ptr i8)))
(extern fseek :cc c [(ptr i8) i64 i32] (-> i32))
(extern ftell :cc c [(ptr i8)] (-> i64))
(extern rewind :cc c [(ptr i8)] (-> void))
(extern fread :cc c [(ptr i8) i64 i64 (ptr i8)] (-> i64))
(extern fclose :cc c [(ptr i8)] (-> i32))
(extern memset :cc c [(ptr i8) i32 i64] (-> (ptr i8)))
(extern clock_gettime :cc c [i32 (ptr Timespec)] (-> i32))
(extern printf :cc c [(ptr i8) ...] (-> i32))

(defstruct Timespec [(seconds i64) (nanos i64)])
(defstruct Measurement [(elapsed i64) (checksum u64)])
(defstruct Input [(data (ptr u8)) (size i64)])

(defn empty-input [] (-> Input)
  (Input :data (p/cast (ptr u8) 0) :size 0))

(defn load-input [(path (ptr i8))] (-> Input)
  (let [file (fopen path c"rb")]
    (if (= (p/cast i64 file) 0)
        (Input :data (p/cast (ptr u8) 0) :size 0)
        (do
          (fseek file 0 (cast i32 2))
          (let [size (ftell file)
                buffer (malloc (+ size 64))]
            (rewind file)
            (let [read (fread (p/cast (ptr i8) buffer) 1 size file)]
              (fclose file)
              (memset (p/cast (ptr i8) (p/index buffer read)) 0 64)
              (Input :data buffer :size read)))))))

(defn structural-checksum [(chunk structural/StructuralChunk)] (-> u64)
  (p/ixor (.word-bits chunk)
    (p/ixor (.word-start-bits chunk)
      (p/ixor (.whitespace-bits chunk)
        (p/ixor (.punctuation-bits chunk)
          (p/ixor (.operator-bits chunk)
            (p/ixor (.operator-adjacent-bits chunk)
              (p/ixor (.quote-bits chunk)
                (p/ixor (.slash-bits chunk)
                  (p/ixor (.backtick-bits chunk)
                    (p/ixor (.delimiter-bits chunk) (.jsx-marker-bits chunk))))))))))))

(defn lexical-checksum [(chunk lexical/LexicalChunk)] (-> u64)
  (p/ixor (.code-bits chunk)
    (p/ixor (.string-bits chunk)
      (p/ixor (.comment-bits chunk)
        (p/ixor (.newline-bits chunk) (cast u64 (.mode (.state chunk))))))))

(defn monotonic-nanos [] (-> i64)
  (let [time (p/alloc-stack Timespec)]
    (clock_gettime 6 time)
    (+ (* (load (field time seconds)) 1000000000)
       (load (field time nanos)))))

(defn fill-source! [(buffer (ptr u8)) (size i64)] (-> i64)
  (let [pattern "const node = flag ? <X a={42}/> : 'text'; // comment\n"
        (mut i) 0]
    (loop
      (if (>= (load i) size) (break)
        (do
          (store! (p/index buffer (load i))
                  (slice-get pattern (% (load i) (len pattern))))
          (set! i (+ (load i) 1)))))
    size))

(defn measure-structural :inline (Never) [N] [(buffer (ptr u8)) (size i64) (rounds i64)] (-> Measurement)
  (let [width (v/vlanes (v/vzero [u8 N]))
        start (monotonic-nanos)
        (mut checksum) (cast u64 0)
        (mut round) 0]
    (loop
      (if (>= (load round) rounds) (break)
        (let [(mut offset) 0]
          (loop
            (if (>= (load offset) size) (break)
              (let [bytes (v/vloadu [u8 N] (p/index buffer (load offset)))
                    chunk (structural/classify-structural bytes width false)]
                (store! checksum (p/ixor (load checksum) (structural-checksum chunk)))
                (set! offset (+ (load offset) width)))))
          (set! round (+ (load round) 1)))))
    (Measurement :elapsed (- (monotonic-nanos) start) :checksum (load checksum))))

(defn measure-lexical :inline (Never) [(buffer (ptr u8)) (size i64) (rounds i64)] (-> Measurement)
  (let [start (monotonic-nanos)
        (mut checksum) (cast u64 0)
        (mut round) 0]
    (loop
      (if (>= (load round) rounds) (break)
        (let [(mut offset) 0
              (mut state) (lexical/lexical-initial-state)]
          (loop
            (if (>= (load offset) size) (break)
              (let [bytes (v/vloadu [u8 (const 32)] (p/index buffer (load offset)))
                    has-next (< (+ (load offset) 32) size)
                    next (if has-next (load (p/index buffer (+ (load offset) 32))) (cast u8 0))
                    chunk (lexical/classify-lexical bytes 32 next has-next (load state))]
                (store! state (.state chunk))
                (store! checksum (p/ixor (load checksum) (lexical-checksum chunk)))
                (set! offset (+ (load offset) 32)))))
          (set! round (+ (load round) 1)))))
    (Measurement :elapsed (- (monotonic-nanos) start) :checksum (load checksum))))

(defn measure-frontend :inline (Never) [N] [(buffer (ptr u8)) (size i64) (rounds i64)] (-> Measurement)
  (let [width (v/vlanes (v/vzero [u8 N]))
        start (monotonic-nanos)
        (mut checksum) (cast u64 0)
        (mut round) 0]
    (loop
      (if (>= (load round) rounds) (break)
        (let [(mut offset) 0
              (mut state) (frontend/frontend-initial-state)]
          (loop
            (if (>= (load offset) size) (break)
              (let [bytes (v/vloadu [u8 N] (p/index buffer (load offset)))
                    has-next (< (+ (load offset) width) size)
                    next (if has-next (load (p/index buffer (+ (load offset) width))) (cast u8 0))
                    chunk (frontend/classify-frontend bytes width next has-next (load state))]
                (store! state (.state chunk))
                (store! checksum
                        (p/ixor (load checksum)
                          (p/ixor (structural-checksum (.raw chunk))
                            (p/ixor (structural-checksum (.code chunk))
                                    (lexical-checksum (.lexical chunk))))))
                (set! offset (+ (load offset) width)))))
          (set! round (+ (load round) 1)))))
    (Measurement :elapsed (- (monotonic-nanos) start) :checksum (load checksum))))

(defn measure-frontend-pair32 :inline (Never)
  [(buffer (ptr u8)) (size i64) (rounds i64)] (-> Measurement)
  (let [start (monotonic-nanos) (mut checksum) (cast u64 0) (mut round) 0]
    (loop
      (if (>= (load round) rounds) (break)
        (let [(mut offset) 0 (mut state) (frontend/frontend-initial-state)]
          (loop
            (if (>= (load offset) size) (break)
              (let [low (v/vloadu [u8 32] (p/index buffer (load offset)))
                    high (v/vloadu [u8 32] (p/index buffer (+ (load offset) 32)))
                    has-next (< (+ (load offset) 64) size)
                    next (if has-next (load (p/index buffer (+ (load offset) 64))) (cast u8 0))
                    chunk (frontend/classify-frontend-pair32
                            low high 64 next has-next (load state))]
                (store! state (.state chunk))
                (store! checksum
                        (p/ixor (load checksum)
                          (p/ixor (structural-checksum (.raw chunk))
                            (p/ixor (structural-checksum (.code chunk))
                                    (lexical-checksum (.lexical chunk))))))
                (set! offset (+ (load offset) 64)))))
          (set! round (+ (load round) 1)))))
    (Measurement :elapsed (- (monotonic-nanos) start) :checksum (load checksum))))

(defn measure-tape :inline (Never) [N] [(buffer (ptr u8)) (size i64) (rounds i64)] (-> Measurement)
  (let [width (v/vlanes (v/vzero [u8 N]))
        positions (p/alloc-stack (array u32 64))
        kinds (p/alloc-stack (array u8 64))
        start (monotonic-nanos)
        (mut checksum) (cast u64 0)
        (mut round) 0]
    (loop
      (if (>= (load round) rounds) (break)
        (let [(mut offset) 0
              (mut state) (frontend/frontend-initial-state)]
          (loop
            (if (>= (load offset) size) (break)
              (let [bytes (v/vloadu [u8 N] (p/index buffer (load offset)))
                    has-next (< (+ (load offset) width) size)
                    next (if has-next (load (p/index buffer (+ (load offset) width))) (cast u8 0))
                    chunk (frontend/classify-frontend bytes width next has-next (load state))
                    written (tape/write-structural-tape
                              (.code chunk) (cast u32 (load offset))
                              (p/cast (ptr u32) positions) (p/cast (ptr u8) kinds) 64)]
                (store! state (.state chunk))
                (store! checksum (p/ixor (load checksum) (cast u64 (.count written))))
                (set! offset (+ (load offset) width)))))
          (set! round (+ (load round) 1)))))
    (Measurement :elapsed (- (monotonic-nanos) start) :checksum (load checksum))))

(defn measure-tape-simd :inline (Never) [N] [(buffer (ptr u8)) (size i64) (rounds i64)] (-> Measurement)
  (let [width (v/vlanes (v/vzero [u8 N]))
        positions (p/alloc-stack (array u32 64))
        kinds (p/alloc-stack (array u8 64))
        start (monotonic-nanos)
        (mut checksum) (cast u64 0)
        (mut round) 0]
    (loop
      (if (>= (load round) rounds) (break)
        (let [(mut offset) 0
              (mut state) (frontend/frontend-initial-state)]
          (loop
            (if (>= (load offset) size) (break)
              (let [bytes (v/vloadu [u8 N] (p/index buffer (load offset)))
                    has-next (< (+ (load offset) width) size)
                    next (if has-next (load (p/index buffer (+ (load offset) width))) (cast u8 0))
                    chunk (frontend/classify-frontend bytes width next has-next (load state))
                    written (tape/write-structural-tape-simd [N]
                              (.code chunk) (cast u32 (load offset))
                              (p/cast (ptr u32) positions) (p/cast (ptr u8) kinds) 64)]
                (store! state (.state chunk))
                (store! checksum (p/ixor (load checksum) (cast u64 (.count written))))
                (set! offset (+ (load offset) width)))))
          (set! round (+ (load round) 1)))))
    (Measurement :elapsed (- (monotonic-nanos) start) :checksum (load checksum))))

(defn measure-tape32-scalar :inline (Never) [(buffer (ptr u8)) (size i64) (rounds i64)] (-> Measurement)
  (let [positions (p/alloc-stack (array u32 64))
        kinds (p/alloc-stack (array u8 64))
        start (monotonic-nanos)
        (mut checksum) (cast u64 0)
        (mut round) 0]
    (loop
      (if (>= (load round) rounds) (break)
        (let [(mut offset) 0
              (mut state) (frontend/frontend-initial-state)]
          (loop
            (if (>= (load offset) size) (break)
              (let [bytes (v/vloadu [u8 (const 32)] (p/index buffer (load offset)))
                    has-next (< (+ (load offset) 32) size)
                    next (if has-next (load (p/index buffer (+ (load offset) 32))) (cast u8 0))
                    chunk (frontend/classify-frontend bytes 32 next has-next (load state))
                    written (tape/write-structural-tape
                              (.code chunk) (cast u32 (load offset))
                              (p/cast (ptr u32) positions) (p/cast (ptr u8) kinds) 64)]
                (store! state (.state chunk))
                (store! checksum (p/ixor (load checksum) (cast u64 (.count written))))
                (set! offset (+ (load offset) 32)))))
          (set! round (+ (load round) 1)))))
    (Measurement :elapsed (- (monotonic-nanos) start) :checksum (load checksum))))

(defn measure-pair32-tape64 :inline (Never)
  [(buffer (ptr u8)) (size i64) (rounds i64)] (-> Measurement)
  (let [positions (p/alloc-stack (array u32 64))
        kinds (p/alloc-stack (array u8 64))
        start (monotonic-nanos) (mut checksum) (cast u64 0) (mut round) 0]
    (loop
      (if (>= (load round) rounds) (break)
        (let [(mut offset) 0 (mut state) (frontend/frontend-initial-state)]
          (loop
            (if (>= (load offset) size) (break)
              (let [low (v/vloadu [u8 32] (p/index buffer (load offset)))
                    high (v/vloadu [u8 32] (p/index buffer (+ (load offset) 32)))
                    has-next (< (+ (load offset) 64) size)
                    next (if has-next (load (p/index buffer (+ (load offset) 64))) (cast u8 0))
                    chunk (frontend/classify-frontend-pair32
                            low high 64 next has-next (load state))
                    written (tape/write-structural-tape64
                              (.code chunk) (cast u32 (load offset))
                              (p/cast (ptr u32) positions) (p/cast (ptr u8) kinds) 64)]
                (store! state (.state chunk))
                (store! checksum (p/ixor (load checksum) (cast u64 (.count written))))
                (set! offset (+ (load offset) 64)))))
          (set! round (+ (load round) 1)))))
    (Measurement :elapsed (- (monotonic-nanos) start) :checksum (load checksum))))

(defn report [(name (ptr i8)) (bytes i64) (measurement Measurement)] (-> i64)
  (let [gbps (/ (cast f64 bytes) (cast f64 (.elapsed measurement)))]
    (printf c"%-12s %8.3f GB/s  %10lld ns  checksum=%llu\n"
            name gbps (.elapsed measurement) (.checksum measurement)))
  0)

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [file-input (if (> argc 1) (load-input (load (p/index argv 1)))
                     (empty-input))
        raw-size (if (> argc 1) (.size file-input) (* 1024 1024))
        ;; Benchmark the common full-width bulk path. A production driver runs
        ;; the at-most-63-byte tail once, outside this loop.
        size (- raw-size (% raw-size 64))
        ;; Keep the total near 255 MiB and odd so XOR checksums stay observable.
        estimated (if (= size 0) 1 (/ (* (* 255 1024) 1024) size))
        rounds (let [r (if (< estimated 1) 1 estimated)]
                 (if (= (% r 2) 0) (+ r 1) r))
        bytes (* size rounds)
        buffer (if (> argc 1) (.data file-input) (malloc (+ size 64)))]
    (if (> argc 1) 0 (do (fill-source! buffer size)
                          (memset (p/cast (ptr i8) (p/index buffer size)) 0 64)
                          0))
    (printf c"hot-cache kernel benchmark: %lld MiB per stage; widths are compile-time-specialized\n"
            (/ bytes (* 1024 1024)))
    (report c"structural16" bytes (measure-structural [(const 16)] buffer size rounds))
    (report c"structural32" bytes (measure-structural [(const 32)] buffer size rounds))
    (report c"structural64" bytes (measure-structural [(const 64)] buffer size rounds))
    (report c"lexical32" bytes (measure-lexical buffer size rounds))
    (report c"frontend16" bytes (measure-frontend [(const 16)] buffer size rounds))
    (report c"frontend32" bytes (measure-frontend [(const 32)] buffer size rounds))
    (report c"frontend64" bytes (measure-frontend [(const 64)] buffer size rounds))
    (report c"frontend2x32" bytes (measure-frontend-pair32 buffer size rounds))
    (report c"+ scalar-tape32" bytes (measure-tape32-scalar buffer size rounds))
    (report c"+ simd-tape32" bytes (measure-tape-simd [(const 32)] buffer size rounds))
    (report c"+ simd-tape64" bytes (measure-tape-simd [(const 64)] buffer size rounds))
    (report c"+ 2x32-tape64" bytes (measure-pair32-tape64 buffer size rounds))
    (free buffer)
    0))
