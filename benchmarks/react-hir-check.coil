(module react-hir-check)

(import "coil.primitive" :as p)
(import "experiments.react-hir-frontend.frontend" :as frontend)
(import "experiments.react-hir-frontend.pipeline" :as pipeline)
(import "experiments.react-hir-frontend.ir" :as ir)
(import "experiments.react-hir-frontend.ir-builder" :as builder)
(import "experiments.react-hir-frontend.ir-storage" :as storage)
(import "experiments.react-hir-frontend.direct-parser" :as parser)

(extern malloc :cc c [i64] (-> (ptr u8)))
(extern free :cc c [(ptr u8)] (-> i64))
(extern fopen :cc c [(ptr i8) (ptr i8)] (-> (ptr i8)))
(extern fseek :cc c [(ptr i8) i64 i32] (-> i32))
(extern ftell :cc c [(ptr i8)] (-> i64))
(extern rewind :cc c [(ptr i8)] (-> void))
(extern fread :cc c [(ptr i8) i64 i64 (ptr i8)] (-> i64))
(extern fclose :cc c [(ptr i8)] (-> i32))
(extern printf :cc c [(ptr i8) ...] (-> i32))

(defstruct Input [(data (ptr u8)) (size i64) (ok bool)])

(defn load-input [(path (ptr i8))] (-> Input)
  (let [file (fopen path c"rb")]
    (if (= (p/cast i64 file) 0)
        (Input :data (p/cast (ptr u8) 0) :size 0 :ok false)
      (do
        (fseek file 0 (cast i32 2))
        (let [size (ftell file)]
          (rewind file)
          (let [buffer (malloc (+ size 64))
                read (fread (p/cast (ptr i8) buffer) 1 size file)]
            (fclose file)
            (Input :data buffer :size read :ok (= read size))))))))

(defn capacities [(size i64)] (-> builder/BuilderCapacities)
  (let [n (cast u32 (+ size 16))]
    (builder/BuilderCapacities
      :regions n :region-block-refs (* n (cast u32 2))
      :blocks n :block-op-refs (* n (cast u32 2))
      :ops n :op-region-refs n
      :values n :operands (* n (cast u32 3))
      :successors n :successor-args n
      :scopes n :bindings n :references n :captures n)))

(defn check-input [(input Input) (dump-ir bool)] (-> i64)
  (let [size (.size input)
        caps (capacities size)
        memory-size (storage/required-bytes caps)
        memory (malloc memory-size)
        events (p/cast (ptr u32) (malloc (* (+ size 1) 4)))
        parser-values (p/cast (ptr u32) (malloc (* (+ size 1) 4)))
        arena (p/alloc-stack ir/IrArena)
        builder-scratch (p/alloc-stack builder/BuilderScratch)
        ir-builder (p/alloc-stack builder/IrBuilder)
        parser-scratch (p/alloc-stack parser/DirectParserScratch)
        (mut outcome) 70
        initialized (storage/initialize! arena builder-scratch ir-builder memory memory-size
                      (cast u32 size) caps)
        scanned (pipeline/scan-source-to-parse-tape64
                  (.data input) size (cast u32 0) events
                  (frontend/frontend-initial-state))]
    (store! outcome
      (if (!= (.error initialized) storage/STORAGE-OK)
        (do (printf c"storage error=%lld\n" (.error initialized)) 70)
      (do
        (store! parser-scratch (parser/DirectParserScratch
          :values parser-values :value-capacity (+ size 1) :value-count 0))
        (let [parsed (parser/parse-direct-program!
                       (.data input) size events (.count scanned)
                       ir-builder parser-scratch)]
          (if (!= (.error parsed) parser/DIRECT-PARSE-OK)
              (do
                (printf c"parse error=%lld offset=%u events=%lld/%lld\n"
                        (.error parsed) (.error-offset parsed)
                        (.consumed-events parsed) (.count scanned))
                1)
            (let [words (p/idiv (+ (cast i64 (.block-count arena)) 63) 64)
                  dom-capacity (* words (cast i64 (.block-count arena)))
                  dom-bytes (* (if (> dom-capacity 0) dom-capacity 1) 8)
                  dom-memory (p/cast (ptr u64) (malloc dom-bytes))
                  verify-scratch (p/alloc-stack ir/VerifyScratch)]
              (store! verify-scratch (ir/VerifyScratch
                :dominators dom-memory
                :dominator-word-capacity (if (> dom-capacity 0) dom-capacity 1)))
              (let [verified (ir/verify-ir arena verify-scratch)]
                (free (p/cast (ptr u8) dom-memory))
                (if (!= (.error verified) ir/VERIFY-OK)
                    (do
                      (printf c"verify error=%lld region=%u block=%u op=%u index=%u opcode=%u operands=%u immediate=%llu\n"
                              (.error verified) (.region verified) (.block verified)
                              (.op verified) (.index verified)
                              (load (p/index (.opcodes arena) (cast i64 (.op verified))))
                              (load (p/index (.op-operand-counts arena)
                                      (cast i64 (.op verified))))
                              (load (p/index (.op-immediates arena)
                                      (cast i64 (.op verified)))))
                      2)
                  (if dump-ir
                      (let [print-capacity (+ (* size 256) 65536)
                            print-memory (malloc print-capacity)
                            printed (ir/print-ir! arena (.data input) print-memory print-capacity)]
                        (if (!= (.error printed) ir/PRINT-OK)
                            (do
                              (printf c"print error=%lld capacity=%lld\n"
                                      (.error printed) print-capacity)
                              (free print-memory)
                              3)
                          (do
                            (printf c"%.*s" (cast i32 (.count printed))
                                    (p/cast (ptr i8) print-memory))
                            (free print-memory)
                            0)))
                    (do
                      (printf c"ok bytes=%lld events=%lld ops=%u blocks=%u scopes=%u bindings=%u references=%u\n"
                              size (.count scanned) (.op-count arena) (.block-count arena)
                              (.scope-count arena) (.binding-count arena)
                              (.reference-count arena))
                      0))))))))))
    (free memory)
    (free (p/cast (ptr u8) events))
    (free (p/cast (ptr u8) parser-values))
    (load outcome)))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (if (or (< argc (cast i32 2)) (> argc (cast i32 3)))
      (do (printf c"usage: react-hir-check FILE [--dump-ir]\n") 64)
    (let [input (load-input (load (p/index argv 1)))]
      (if (not (.ok input))
          (do (printf c"could not read input\n") 66)
        (let [result (check-input input (= argc (cast i32 3)))]
          (free (.data input))
          result)))))
