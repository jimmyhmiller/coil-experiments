(module jsir-differential-coil)

(import "coil.primitive" :as p)
(import "coil.slice" :use [slice-data])
(import "experiments.react-hir-frontend.frontend" :as frontend)
(import "experiments.react-hir-frontend.pipeline" :as pipeline)
(import "experiments.react-hir-frontend.ir" :as ir)
(import "experiments.react-hir-frontend.ir-builder" :as builder)
(import "experiments.react-hir-frontend.ir-storage" :as storage)
(import "experiments.react-hir-frontend.direct-parser" :as parser)

(extern printf :cc c [(ptr i8) ...] (-> i32))

(defn print-source-span [(source (ptr u8)) (start u32) (end u32)] (-> i64)
  (printf c"%.*s" (cast i32 (- end start)) (p/index source (cast i64 start)))
  0)

(defn print-op-source-list [(arena (ptr ir/IrArena)) (source (ptr u8))
                            (opcode u16)] (-> i64)
  (let [(mut op) (cast u32 0) (mut first) true]
    (loop
      (if (>= (load op) (.op-count arena)) (break)
        (do
          (if (= (load (p/index (.opcodes arena) (cast i64 (load op)))) opcode)
              (do
                (if (load first) (do (store! first false) 0)
                  (do (printf c",") 0))
                (printf c"\"")
                (print-source-span source
                  (load (p/index (.op-starts arena) (cast i64 (load op))))
                  (load (p/index (.op-ends arena) (cast i64 (load op)))))
                (printf c"\"")) 0)
          (set! op (+ (load op) (cast u32 1))))))
  0))

(defn print-operator-list [(arena (ptr ir/IrArena)) (opcode u16)] (-> i64)
  (let [(mut op) (cast u32 0) (mut first) true]
    (loop
      (if (>= (load op) (.op-count arena)) (break)
        (do
          (if (= (load (p/index (.opcodes arena) (cast i64 (load op)))) opcode)
              (do
                (if (load first) (do (store! first false) 0)
                  (do (printf c",") 0))
                (printf c"\"%c\""
                  (cast i32 (load (p/index (.op-immediates arena) (cast i64 (load op))))))) 0)
          (set! op (+ (load op) (cast u32 1))))))
  0))

(defn assignment-target? [(arena (ptr ir/IrArena)) (value u32)] (-> bool)
  (let [(mut op) (cast u32 0) (mut target) false]
    (loop
      (if (or (>= (load op) (.op-count arena)) (load target)) (break)
        (do
          (if (= (load (p/index (.opcodes arena) (cast i64 (load op)))) ir/OP-JS-ASSIGN)
              (let [first (load (p/index (.op-first-operands arena) (cast i64 (load op))))]
                (if (= (load (p/index (.operands arena) (cast i64 first))) value)
                    (store! target true) 0)) 0)
          (set! op (+ (load op) (cast u32 1))))))
    (load target)))

(defn print-read-identifiers [(arena (ptr ir/IrArena)) (source (ptr u8))] (-> i64)
  (let [(mut op) (cast u32 0) (mut first) true]
    (loop
      (if (>= (load op) (.op-count arena)) (break)
        (do
          (if (and (= (load (p/index (.opcodes arena) (cast i64 (load op))))
                       ir/OP-JS-IDENTIFIER)
                   (not (assignment-target? arena
                          (load (p/index (.op-first-results arena) (cast i64 (load op)))))))
              (do
                (if (load first) (do (store! first false) 0) (do (printf c",") 0))
                (printf c"\"")
                (print-source-span source
                  (load (p/index (.op-starts arena) (cast i64 (load op))))
                  (load (p/index (.op-ends arena) (cast i64 (load op)))))
                (printf c"\"")) 0)
          (set! op (+ (load op) (cast u32 1))))))
  0))

(defn count-opcode [(arena (ptr ir/IrArena)) (opcode u16)] (-> i64)
  (let [(mut op) (cast u32 0) (mut count) 0]
    (loop
      (if (>= (load op) (.op-count arena)) (break)
        (do
          (if (= (load (p/index (.opcodes arena) (cast i64 (load op)))) opcode)
              (set! count (+ (load count) 1)) 0)
          (set! op (+ (load op) (cast u32 1))))))
    (load count)))

(defn count-cfg-backedges [(arena (ptr ir/IrArena))] (-> i64)
  (let [(mut successor) (cast u32 0) (mut count) 0]
    (loop
      (if (>= (load successor) (.successor-count arena)) (break)
        (let [(mut op) (cast u32 0) (mut owner) (cast u32 ir/INVALID-ID)]
          (loop
            (if (or (>= (load op) (.op-count arena))
                    (!= (load owner) (cast u32 ir/INVALID-ID))) (break)
              (let [first (load (p/index (.op-first-successors arena)
                                          (cast i64 (load op))))
                    width (load (p/index (.op-successor-counts arena)
                                          (cast i64 (load op))))]
                (if (and (>= (load successor) first)
                         (< (load successor) (+ first width)))
                    (store! owner (ir/find-op-block arena (load op))) 0)
                (set! op (+ (load op) (cast u32 1))))))
          (if (and (!= (load owner) (cast u32 ir/INVALID-ID))
                   (<= (load (p/index (.successor-blocks arena)
                                      (cast i64 (load successor)))) (load owner)))
              (set! count (+ (load count) 1)) 0)
          (set! successor (+ (load successor) (cast u32 1))))))
    (load count)))

(defn main [] (-> i64)
  (let [source "let x = 3; while (x) { x = x - 1; } foo.state(x);"
        events (p/alloc-stack (array u32 128))
        memory (p/alloc-stack (array u64 4096))
        arena (p/alloc-stack ir/IrArena)
        scratch (p/alloc-stack builder/BuilderScratch)
        ir-builder (p/alloc-stack builder/IrBuilder)
        parser-values (p/alloc-stack (array u32 64))
        parser-scratch (p/alloc-stack parser/DirectParserScratch)
        caps (builder/BuilderCapacities
          :regions (cast u32 2) :region-block-refs (cast u32 4)
          :blocks (cast u32 8) :block-op-refs (cast u32 64)
          :ops (cast u32 64) :op-region-refs (cast u32 2)
          :values (cast u32 64) :operands (cast u32 128)
          :successors (cast u32 8) :successor-args (cast u32 8)
          :scopes (cast u32 8) :bindings (cast u32 8)
          :references (cast u32 32) :captures (cast u32 4))
        initialized (storage/initialize! arena scratch ir-builder
                      (p/cast (ptr u8) memory) 32768 (cast u32 (len source)) caps)
        tape-result (pipeline/scan-source-to-parse-tape64
          (slice-data source) (len source) (cast u32 0) (p/cast (ptr u32) events)
          (frontend/frontend-initial-state))]
    (if (!= (.error initialized) storage/STORAGE-OK) 2
      (do
        (store! parser-scratch (parser/DirectParserScratch
          :values (p/cast (ptr u32) parser-values) :value-capacity 64 :value-count 0))
      (let [parsed (parser/parse-direct-program! (slice-data source) (len source)
                     (p/cast (ptr u32) events) (.count tape-result)
                     ir-builder parser-scratch)]
        (if (!= (.error parsed) parser/DIRECT-PARSE-OK) 3
          (do
            (printf c"{\"declarations\":[\"let:")
            (print-source-span (slice-data source)
              (load (p/index (.binding-name-starts arena) 0))
              (load (p/index (.binding-name-ends arena) 0)))
            (printf c"\"],\"numbers\":[")
            (print-op-source-list arena (slice-data source) ir/OP-JS-NUMBER)
            (printf c"],\"strings\":[],\"binaries\":[")
            (print-operator-list arena ir/OP-JS-BINARY)
            (printf c"],\"unaries\":[")
            (print-operator-list arena ir/OP-JS-UNARY)
            (printf c"],\"identifiers\":[")
            (print-read-identifiers arena (slice-data source))
            (printf c"],\"assignments\":[")
            (print-operator-list arena ir/OP-JS-ASSIGN)
            (printf c"],\"calls\":%lld,\"members\":%lld,\"expression_statements\":%lld,\"while_statements\":%lld}\n"
              (count-opcode arena ir/OP-JS-CALL)
              (count-opcode arena ir/OP-JS-MEMBER)
              (count-opcode arena ir/OP-JS-EXPRESSION)
              (count-cfg-backedges arena))
            0)))))))
