(module jsir-differential-coil)

(import "coil.primitive" :as p)
(import "coil.slice" :use [slice-data])
(import "experiments.react-hir-frontend.frontend" :as frontend)
(import "experiments.react-hir-frontend.pipeline" :as pipeline)
(import "experiments.react-hir-frontend.ir" :as ir)
(import "experiments.react-hir-frontend.ir-builder" :as builder)
(import "experiments.react-hir-frontend.ir-storage" :as storage)
(import "experiments.react-hir-frontend.direct-parser" :as parser)

(extern printf :cc c [(ptr i8) ...] (-> i32))

(defn print-source-span [(source (ptr u8)) (start u32) (end u32)] (-> i64)
  (printf c"%.*s" (cast i32 (- end start)) (p/index source (cast i64 start)))
  0)

(defn print-op-source-list [(arena (ptr ir/IrArena)) (source (ptr u8))
                            (opcode u16)] (-> i64)
  (let [(mut op) (cast u32 0) (mut first) true]
    (loop
      (if (>= (load op) (.op-count arena)) (break)
        (do
          (if (= (load (p/index (.opcodes arena) (cast i64 (load op)))) opcode)
              (do
                (if (load first) (do (store! first false) 0)
                  (do (printf c",") 0))
                (printf c"\"")
                (print-source-span source
                  (load (p/index (.op-starts arena) (cast i64 (load op))))
                  (load (p/index (.op-ends arena) (cast i64 (load op)))))
                (printf c"\"")) 0)
          (set! op (+ (load op) (cast u32 1))))))
  0))

(defn print-binary-list [(arena (ptr ir/IrArena))] (-> i64)
  (let [(mut op) (cast u32 0) (mut first) true]
    (loop
      (if (>= (load op) (.op-count arena)) (break)
        (do
          (if (= (load (p/index (.opcodes arena) (cast i64 (load op)))) ir/OP-JS-BINARY)
              (do
                (if (load first) (do (store! first false) 0)
                  (do (printf c",") 0))
                (printf c"\"%c\""
                  (cast i32 (load (p/index (.op-immediates arena) (cast i64 (load op))))))) 0)
          (set! op (+ (load op) (cast u32 1))))))
  0))

(defn main [] (-> i64)
  (let [source "const x = 1 + 2; x;"
        events (p/alloc-stack (array u32 64))
        memory (p/alloc-stack (array u64 2048))
        arena (p/alloc-stack ir/IrArena)
        scratch (p/alloc-stack builder/BuilderScratch)
        ir-builder (p/alloc-stack builder/IrBuilder)
        caps (builder/BuilderCapacities
          :regions (cast u32 2) :region-block-refs (cast u32 4)
          :blocks (cast u32 4) :block-op-refs (cast u32 32)
          :ops (cast u32 32) :op-region-refs (cast u32 2)
          :values (cast u32 32) :operands (cast u32 64)
          :successors (cast u32 8) :successor-args (cast u32 8)
          :scopes (cast u32 4) :bindings (cast u32 8)
          :references (cast u32 16) :captures (cast u32 4))
        initialized (storage/initialize! arena scratch ir-builder
                      (p/cast (ptr u8) memory) 16384 (cast u32 (len source)) caps)
        tape-result (pipeline/scan-source-to-parse-tape64
          (slice-data source) (len source) (cast u32 0) (p/cast (ptr u32) events)
          (frontend/frontend-initial-state))]
    (if (!= (.error initialized) storage/STORAGE-OK) 2
      (let [parsed (parser/parse-direct-program! (slice-data source) (len source)
                     (p/cast (ptr u32) events) (.count tape-result) ir-builder)]
        (if (!= (.error parsed) parser/DIRECT-PARSE-OK) 3
          (do
            (printf c"{\"declarations\":[\"const:")
            (print-source-span (slice-data source)
              (load (p/index (.binding-name-starts arena) 0))
              (load (p/index (.binding-name-ends arena) 0)))
            (printf c"\"],\"numbers\":[")
            (print-op-source-list arena (slice-data source) ir/OP-JS-NUMBER)
            (printf c"],\"strings\":[],\"binaries\":[")
            (print-binary-list arena)
            (printf c"],\"unaries\":[],\"identifiers\":[")
            (print-op-source-list arena (slice-data source) ir/OP-JS-IDENTIFIER)
            (printf c"],\"expression_statements\":1}\n")
            0))))))
