(module harness-markdown-agent)

(import "coil.primitive" :as primitive)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.fs" :as fs)
(import "coil.io" :use [println])
(import "coil.match" :use *)
(import "coil.os" :as os)
(import "coil.result" :use *)
(import "coil.slice" :use [slice-len])
(import "coil.str" :as str)
(import "harness-event" :use *)
(import "harness-json" :use *)
(import "harness-model" :use *)
(import "harness-tool" :use *)
(import "harness-filesystem-tools" :use *)
(import "harness-bash-tool" :use *)
(import "harness-search-tool" :use *)
(import "codex-direct" :use *)
(import "harness-agent-runner" :use *)

(defn arg-at [(argv (ptr (ptr i8))) (at i64)] (-> (slice u8))
  (str/cstr->str (load (primitive/index argv at))))

(defn make-request [(allocator (dyn Allocator))
                    (model (slice u8))
                    (prompt (slice u8))
                    (registry (ptr ToolRegistry))] (-> ModelRequest)
  (let [request (primitive/alloc-stack ModelRequest)
        messages (box! allocator (ArrayList Message) (al-new [Message] allocator))
        message (primitive/alloc-stack Message)]
    (set! request (zeroed ModelRequest))
    (set! (.role message) (UserRole))
    (set! (.content message) prompt)
    (al-push! [Message] messages (load message))
    (set! (.run-id request) "markdown-materialization")
    (set! (.operation-id request) "generate")
    (set! (.model request) model)
    (set! (.instructions request) "Work only within the current repository. This is an execution task, not a question. You must use the provided repository tools to inspect what you need and write the requested artifact to disk. Do not merely describe or print the implementation. Finish only after the requested file exists.")
    (set! (.messages request) messages)
    (set! (.tools request) registry)
    (set! (.tool-choice request) (ToolsAuto))
    (set! (.parallel-tool-calls request) true)
    (set! (.reasoning request) "medium")
    (set! (.max-output-tokens request) 4096)
    (set! (.timeout-ms request) 600000)
    (set! (.previous-output (.continuation request)) (JsonNull))
    (load request)))

(defn execute [(allocator (dyn Allocator))
               (model (slice u8))
               (prompt (slice u8))
               (cwd (slice u8))] (-> i64)
  (let [registry (box! allocator ToolRegistry (tool-registry-new allocator))
        provider (box! allocator CodexDirectContext (codex-direct-context allocator))
        sequence (box! allocator i64 1)
        sink (primitive/alloc-stack NoopEventSink)
        emitter (box! allocator EventEmitter (zeroed EventEmitter))
        policy (primitive/alloc-stack AgentRunPolicy)]
    (register-filesystem-tools! registry allocator cwd)
    (register-search-text-tool! registry allocator cwd)
    (register-bash-tool! registry allocator cwd)
    (event-emitter-init! emitter allocator sink sequence)
    (set! (.max-model-turns policy) 0)
    (set! (.max-parallel-tools policy) 8)
    (let [request (box! allocator ModelRequest (make-request allocator model prompt registry))
          result (match (run-agent allocator provider request emitter (load policy))
                   (ModelOk [response]
                     (let [success response]
                       (when (> (slice-len (.output-text success)) 0)
                         (println "{s}" (.output-text success))
                         0)
                       0))
                   (ModelErr [failure]
                     (let [failed failure]
                       (println "markdown-agent: Codex failed: {s}" (.message failed))
                       1)))]
      result)))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (if (!= (primitive/cast i64 argc) 3)
      (do (println "usage: markdown-agent-runner MODEL REQUEST.md") 64)
      (let [allocator (malloc-allocator)
            model (arg-at argv 1)
            request-path (arg-at argv 2)]
        (match (fs/read-file allocator request-path)
          (Err [_] (do (println "markdown-agent: cannot read request {s}" request-path) 66))
          (Ok [prompt]
            (match (os/current-dir allocator)
              (Err [_] (do (println "markdown-agent: cannot determine current directory") 71))
              (Ok [cwd] (execute allocator model prompt (os/owned-string-slice cwd)))))))))
