#!/usr/bin/env bash
set -euo pipefail

install_system_dependencies() {
  local -a packages=()
  command -v cc >/dev/null 2>&1 || packages+=(build-essential)
  command -v git >/dev/null 2>&1 || packages+=(git)
  command -v python3 >/dev/null 2>&1 || packages+=(python3)
  command -v wget >/dev/null 2>&1 || packages+=(wget ca-certificates)
  if ((${#packages[@]})); then
    sudo apt-get update
    sudo DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${packages[@]}"
  fi

  if ! dpkg-query -W -f='${Status}\n' llvm-21 llvm-21-dev clang-21 libclang-rt-21-dev lld-21 2>/dev/null \
      | awk '$0 == "install ok installed" { installed++ } END { exit installed != 5 }'; then
    wget -qO- https://apt.llvm.org/llvm-snapshot.gpg.key \
      | sudo tee /etc/apt/trusted.gpg.d/apt.llvm.org.asc >/dev/null
    echo "deb http://apt.llvm.org/bookworm/ llvm-toolchain-bookworm-21 main" \
      | sudo tee /etc/apt/sources.list.d/llvm-21.list >/dev/null
    sudo apt-get update -o Acquire::Retries=3
    sudo DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      llvm-21 llvm-21-dev clang-21 libclang-rt-21-dev lld-21
  fi
  sudo update-alternatives --install /usr/bin/llvm-config llvm-config /usr/bin/llvm-config-21 210
  sudo update-alternatives --set llvm-config /usr/bin/llvm-config-21
  sudo update-alternatives --install /usr/bin/clang clang /usr/bin/clang-21 210
  sudo update-alternatives --set clang /usr/bin/clang-21
}

install_coil_main() {
  local checkout="$HOME/.cache/amp/coil-main"
  # Keep the full compiler separate from aot-kit-gradual's LLVM-free cache.
  local build="$HOME/.cache/amp/coil-build/coil-full"
  local marker="$HOME/.cache/amp/coil-build/full-main-commit"
  local library="$HOME/.local/lib/coil/prelude.coil"
  local rebuilt=0

  mkdir -p "$(dirname "$checkout")" "$(dirname "$build")" "$HOME/.local/bin"
  if [[ ! -e "$checkout" ]]; then
    git clone --filter=blob:none --branch main --single-branch \
      https://github.com/jimmyhmiller/coil.git "$checkout"
  fi
  git -C "$checkout" fetch --depth 1 origin main
  git -C "$checkout" checkout --detach --force FETCH_HEAD

  local commit
  commit=$(git -C "$checkout" rev-parse HEAD)
  if [[ ! -x "$build" ]] || [[ ! -f "$marker" ]] || [[ $(<"$marker") != "$commit" ]]; then
    python3 "$checkout/scripts/dev.py" build full --output "$build"
    printf '%s\n' "$commit" > "$marker"
    rebuilt=1
  fi
  if [[ ! -x "$HOME/.local/bin/coil" ]] || [[ ! -f "$library" ]] \
      || ((rebuilt)); then
    python3 "$checkout/scripts/dev.py" install --source "$build" --dest "$HOME/.local/bin/coil"
  fi
  "$HOME/.local/bin/coil" --version
}

install_system_dependencies
install_coil_main
